//@ run-pass
// O passo que sustenta a proposicao de rigidez: o INTERIOR e mesmo uma PCS?
//
// A proposicao (AXIOMS.md §6.2) diz que o grupo de automorfismos e trivial, e o passo (iii) —
// que carrega tudo — afirma que a restricao a X* = X \ {z}, com a operacao restrita as
// composicoes que caem em X*, e uma positive concatenation structure no sentido de
// Narens & Luce (1976, Def 2.1). Se esse passo cair, a unicidade cai junto.
//
// A sutileza esta em "definido": na estrutura restrita, x∘y so conta como DEFINIDO se o
// resultado tambem esta em X*, isto e, se e estritamente menor que o teto. Isso muda os axiomas
// 3, 5 e 7, e e exatamente onde um erro passaria despercebido.
//
// Verifica os SETE axiomas da Def 2.1 sobre o modelo testemunha, com essa nocao de definido.

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn op(a: f64, b: f64, eps: f64) -> f64 with Div, Panic { a + b + eps * a * b / (a + b) }
// "definido em X*" = resultado estritamente abaixo do teto
fn def_em_estrela(a: f64, b: f64, eps: f64) -> bool with Div, Panic { op(a, b, eps) < 1.0 }

fn main() -> i64 with IO, Mut, Div, Panic {
    let eps: f64 = 1.0
    var falhas: i64 = 0

    // Ax 1 e 2 (ordem fraca, nao-trivialidade): imediatos, a ordem e >= nos reais.
    print("AX1_AX2_ORDEM "); print_int(1)

    // Ax 3 — DEFINIBILIDADE LOCAL com a nocao restrita: se x∘y esta definido em X*, e w <= x,
    //        u <= y, entao w∘u tambem esta definido em X*.
    var viol3: i64 = 0
    var i: i64 = 1
    while i < 60 {
        var j: i64 = 1
        while j < 60 {
            let x = (i as f64) / 100.0
            let y = (j as f64) / 100.0
            if def_em_estrela(x, y, eps) {
                var p: i64 = 1
                while p <= i {
                    var q: i64 = 1
                    while q <= j {
                        let w = (p as f64) / 100.0
                        let u = (q as f64) / 100.0
                        if !def_em_estrela(w, u, eps) { viol3 = viol3 + 1 }
                        q = q + 20
                    }
                    p = p + 20
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    print("AX3_DEFINIBILIDADE_LOCAL_VIOLACOES "); print_int(viol3)
    if viol3 != 0 { falhas = falhas + 1 }

    // Ax 4 — MONOTONICIDADE, bicondicional, com ambos definidos em X*.
    var viol4: i64 = 0
    i = 1
    while i < 50 {
        var j2: i64 = 1
        while j2 < 50 {
            var k: i64 = 1
            while k < 50 {
                let x = (i as f64) / 100.0
                let y = (j2 as f64) / 100.0
                let c = (k as f64) / 100.0
                if def_em_estrela(x, c, eps) && def_em_estrela(y, c, eps) {
                    let lado_esq = x >= y
                    let lado_dir = op(x, c, eps) >= op(y, c, eps)
                    if lado_esq != lado_dir { viol4 = viol4 + 1 }
                }
                k = k + 7
            }
            j2 = j2 + 3
        }
        i = i + 3
    }
    print("AX4_MONOTONICIDADE_VIOLACOES "); print_int(viol4)
    if viol4 != 0 { falhas = falhas + 1 }

    // Ax 5 — SOLVABILIDADE RESTRITA: se x > y entao existe u com x > y∘u, e y∘u em X*.
    var viol5: i64 = 0
    i = 2
    while i < 60 {
        var j3: i64 = 1
        while j3 < i {
            let x = (i as f64) / 100.0
            let y = (j3 as f64) / 100.0
            var achou: bool = false
            var m: i64 = 1
            while m < 40 {
                let u = (m as f64) / 1000.0
                if def_em_estrela(y, u, eps) && op(y, u, eps) < x { achou = true }
                m = m + 1
            }
            if !achou { viol5 = viol5 + 1 }
            j3 = j3 + 5
        }
        i = i + 5
    }
    print("AX5_SOLVABILIDADE_VIOLACOES "); print_int(viol5)
    if viol5 != 0 { falhas = falhas + 1 }

    // Ax 6 — POSITIVIDADE: x∘y > x e x∘y > y, quando definido em X*.
    var viol6: i64 = 0
    i = 1
    while i < 60 {
        var j4: i64 = 1
        while j4 < 60 {
            let x = (i as f64) / 100.0
            let y = (j4 as f64) / 100.0
            if def_em_estrela(x, y, eps) {
                let v = op(x, y, eps)
                if !(v > x) { viol6 = viol6 + 1 }
                if !(v > y) { viol6 = viol6 + 1 }
            }
            j4 = j4 + 1
        }
        i = i + 1
    }
    print("AX6_POSITIVIDADE_VIOLACOES "); print_int(viol6)
    if viol6 != 0 { falhas = falhas + 1 }

    // Ax 7 — ARQUIMEDIANA: para cada x existe n com nx indefinido em X* ou nx >= y.
    //        Basta mostrar que a sequencia padrao SAI de X* em passos finitos.
    var viol7: i64 = 0
    i = 1
    while i < 60 {
        let x = (i as f64) / 100.0
        var acc = x
        var n: i64 = 1
        var saiu: bool = false
        while n < 500 {
            if !def_em_estrela(acc, x, eps) { saiu = true; n = 500 }
            else { acc = op(acc, x, eps); n = n + 1 }
        }
        if !saiu { viol7 = viol7 + 1 }
        i = i + 1
    }
    print("AX7_ARQUIMEDIANA_VIOLACOES "); print_int(viol7)
    if viol7 != 0 { falhas = falhas + 1 }

    if falhas == 0 { println("interior e PCS: PASS") } else { println("interior e PCS: FAIL") }
    falhas
}
