//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-4 obligation seed receipt

fn child4_obligation_seed_check(
    child3_discharge_preflight_fp: i64,
    child3_discharge_preflight_audit_fp: i64,
    child3_validation_core_fp: i64,
    child3_validation_core_audit_fp: i64,
    child_index: i64,
    slot_x: i64,
    slot_y: i64,
    slot_z: i64,
    global_flowpipe_claim_mask: i64,
    seed_status: i64) -> i64 {
    if child3_discharge_preflight_fp != 57643306 { return 0 - 1 }
    if child3_discharge_preflight_audit_fp != 784781218 { return 0 - 1 }
    if child3_validation_core_fp != 686090643 { return 0 - 1 }
    if child3_validation_core_audit_fp != 159869521 { return 0 - 1 }
    if child_index != 4 { return 0 - 1 }
    if slot_x != 0 { return 0 - 1 }
    if slot_y != 0 { return 0 - 1 }
    if slot_z != 1 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if seed_status != 72 { return 0 - 1 }
    return 17166205
}

fn main() -> i64 {
    let artifact = child4_obligation_seed_check(
        57643306, 784781218, 686090643, 159869521, 4, 0, 0, 1, 0, 72)
    if artifact != 17166205 { return 1 }

    let audit_fp: i64 = 78794130
    let instance_fp: i64 = 75459241
    let certificate_fp: i64 = 224045073
    let selected_child_mask: i64 = 16
    let prior_child_validated_mask: i64 = 15
    let pending_child_validation_mask: i64 = 16
    let local_flowpipe_proof_mask: i64 = 0
    let child_validated_mask: i64 = 0
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0
    let seed_status: i64 = 72
    let ok_mask: i64 = 255

    if audit_fp != 78794130 { return 2 }
    if instance_fp != 75459241 { return 3 }
    if certificate_fp != 224045073 { return 4 }
    if selected_child_mask != 16 { return 5 }
    if prior_child_validated_mask != 15 { return 6 }
    if pending_child_validation_mask != 16 { return 7 }
    if local_flowpipe_proof_mask != 0 { return 8 }
    if child_validated_mask != 0 { return 9 }
    if child_discharge_mask != 0 { return 10 }
    if global_cover_certificate_mask != 0 { return 11 }
    if global_flowpipe_claim_mask != 0 { return 12 }
    if seed_status != 72 { return 13 }
    if ok_mask != 255 { return 14 }

    let wrong_child = child4_obligation_seed_check(
        57643306, 784781218, 686090643, 159869521, 3, 0, 0, 1, 0, 72)
    if wrong_child != 0 - 1 { return 15 }

    let wrong_slot = child4_obligation_seed_check(
        57643306, 784781218, 686090643, 159869521, 4, 1, 0, 0, 0, 72)
    if wrong_slot != 0 - 1 { return 16 }

    let overclaim = child4_obligation_seed_check(
        57643306, 784781218, 686090643, 159869521, 4, 0, 0, 1, 1, 72)
    if overclaim != 0 - 1 { return 17 }

    return 0
}
