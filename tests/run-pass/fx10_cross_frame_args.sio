//@ run-pass
//@ requires: madaros
//@ expect-stdout: 42
//@ description: FX-2/FX-9 perform forwarded to an outer handler frame carries its arguments and resume value across frames (SIO-417)
//@ semantic-lane: SPEC-07-7.4-FX-9

effect A { fn a(x: i64) -> i64 }
effect B { fn b() -> i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<A> {
        handle<B> { perform A.a(30) + perform B.b() } with { on b() -> resume(12) }
    } with {
        on a(v) -> resume(v + 0)
    }
    println(r)
    0
}
