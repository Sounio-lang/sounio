//@ run-pass
//@ description: Tiny portfolio v38 smoke for Lorenz i256 projection dependency-DAG entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var audit_fp: i64 = 401
    audit_fp = mix(audit_fp, 713010204, 2729)
    audit_fp = mix(audit_fp, 77888110, 2729)
    audit_fp = mix(audit_fp, 245178976, 2729)
    audit_fp = mix(audit_fp, 214180161, 2729)
    audit_fp = mix(audit_fp, 63872871, 2729)
    audit_fp = mix(audit_fp, 547731575, 2729)
    audit_fp = mix(audit_fp, 916832909, 2729)
    audit_fp = mix(audit_fp, 116461241, 2729)
    audit_fp = mix(audit_fp, 775818863, 2729)
    audit_fp = mix(audit_fp, 585753742, 2729)
    audit_fp = mix(audit_fp, 44126209, 2729)
    audit_fp = mix(audit_fp, 297819393, 2729)
    audit_fp = mix(audit_fp, 189652817, 2729)
    audit_fp = mix(audit_fp, 836439604, 2729)
    audit_fp = mix(audit_fp, 127, 2729)
    if audit_fp != 725222703 { return 1 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 41, 1103)
    entry_fp = mix(entry_fp, 713010204, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 41, 1103)
    if entry_fp != 389121447 { return 2 }

    if audit_fp == 725222704 { return 3 }
    return 0
}
