//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: IMPORTED 6.000000 0.160000 1.000000
//@ expect-stdout-contains: LITERAL 6.000000 0.160000 1.000000
//
// Positive control: a literal module-level constant from another module is
// an exact factor (x = 3 +- 0.2, variance 0.04 -> 4 * 0.04).
use fixtures::knowledge_scale_const::{KSCALE}

fn main() -> i64 with IO, Epistemic {
    let x: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    let r: Knowledge<f64> = x * KSCALE
    print("IMPORTED "); print_f64(r.value); print(" ")
    print_f64(r.variance); print(" "); print_f64(r.confidence); print("\n")
    // A plain literal in a program that imports a module: the multi-module
    // path, where a checker span table does not reach the lowerer (SIGSEGV
    // before the syntactic recognition).
    let l: Knowledge<f64> = x * 2.0
    print("LITERAL "); print_f64(l.value); print(" ")
    print_f64(l.variance); print(" "); print_f64(l.confidence); print("\n")
    0
}
