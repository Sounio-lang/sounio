//@ run-pass
//@ requires: madaros
//@ expect-stdout: PHANTOM_LITERAL_OK

// A generic struct whose parameters no field uses (a marker or phantom
// parameter) is built with its arguments on the literal. The two orders are
// two different types: the value of each is read back through its own
// instance, not through a placeholder name.
trait Lj { fn lj(self) -> f64 }
struct Na { pub z: i64 }
struct Cl { pub z: i64 }
impl Lj for Na { fn lj(self) -> f64 { 0.2 } }
impl Lj for Cl { fn lj(self) -> f64 { 0.4 } }
struct Pair<A, B> { pub d: f64 }
fn mix<A: Lj, B: Lj>(p: Pair<A, B>, a: A, b: B) -> f64 { a.lj() + b.lj() * 2.0 + p.d }

fn main() -> i32 with IO {
    let p: Pair<Na, Cl> = Pair::<Na, Cl> { d: 3.0 }
    let q: Pair<Cl, Na> = Pair::<Cl, Na> { d: 3.0 }
    let x = mix::<Na, Cl>(p, Na { z: 0 }, Cl { z: 0 })
    let y = mix::<Cl, Na>(q, Cl { z: 0 }, Na { z: 0 })
    if x == 4.0 && y == 3.8 { print("PHANTOM_LITERAL_OK\n") }
    return 0
}
