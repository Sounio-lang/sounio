//@ run-pass
//@ expect-stdout: ALL PASS
//
// L0 acceptance for the AssociatorField artifact (stdlib/algebra/associator_field.sio).
//
// Validates all seven windows against verified octonion facts:
//   Fano triple (e1,e2,e3): associator = 0  ⇒ coboundary, zero entropy, zero GUM aug.
//   Non-Fano   (e1,e2,e4): ‖associator‖² = 4 ⇒ non-trivial class, g2_residual = 2,
//                          entropy = ln 2, GUM augmentation = κ·4.

use algebra::associator_field::{
    OctAssociatorField, assoc_field_basis, af_augmented_variance, af_ln2
}

fn approx(x: f64, y: f64) -> bool {
    let d = if x > y { x - y } else { y - x }
    d < 0.0001
}

fn main() with Mut, Div, Panic, NonAssoc {
    var ok = true
    let kappa = 1.0

    // --- Fano line (1,2,3): associative triple, associator vanishes ---
    let fano = assoc_field_basis(1, 2, 3, kappa)
    if fano.is_coboundary { print("W1 fano coboundary: PASS") }
    else { print("W1 fano coboundary: FAIL"); ok = false }
    if approx(fano.norm_sq, 0.0) { print("W5 fano norm_sq=0: PASS") }
    else { print("W5 fano norm_sq=0: FAIL"); ok = false }
    if approx(fano.order_entropy, 0.0) { print("W6 fano entropy=0: PASS") }
    else { print("W6 fano entropy=0: FAIL"); ok = false }
    if approx(fano.gum_augmentation, 0.0) { print("W7 fano gum_aug=0: PASS") }
    else { print("W7 fano gum_aug=0: FAIL"); ok = false }

    // --- Non-Fano (1,2,4): non-associative triple, ‖associator‖² = 4 ---
    let nf = assoc_field_basis(1, 2, 4, kappa)
    if nf.is_coboundary { print("W1 nonfano class: FAIL"); ok = false }
    else { print("W1 nonfano class nontrivial: PASS") }
    if approx(nf.norm_sq, 4.0) { print("W5 nonfano norm_sq=4: PASS") }
    else { print("W5 nonfano norm_sq=4: FAIL"); ok = false }
    if approx(nf.g2_residual, 2.0) { print("W3 nonfano g2_residual=2: PASS") }
    else { print("W3 nonfano g2_residual=2: FAIL"); ok = false }
    if approx(nf.pentagon_witness, 4.0) { print("W4 nonfano pentagon=4: PASS") }
    else { print("W4 nonfano pentagon=4: FAIL"); ok = false }
    if approx(nf.order_entropy, af_ln2()) { print("W6 nonfano entropy=ln2: PASS") }
    else { print("W6 nonfano entropy=ln2: FAIL"); ok = false }
    if approx(nf.gum_augmentation, 4.0) { print("W7 nonfano gum_aug=4: PASS") }
    else { print("W7 nonfano gum_aug=4: FAIL"); ok = false }

    // --- Window 7 end-to-end: augmenting a measured variance ---
    // base GUM variance 0.25 on a measurement whose computation crossed a
    // non-associative triple ⇒ structural term adds κ·4 = 4.0 ⇒ total 4.25.
    let total = af_augmented_variance(0.25, &nf)
    if approx(total, 4.25) { print("W7 augmented variance=4.25: PASS") }
    else { print("W7 augmented variance: FAIL"); ok = false }

    // Associative path adds nothing.
    let total_fano = af_augmented_variance(0.25, &fano)
    if approx(total_fano, 0.25) { print("W7 fano variance unchanged: PASS") }
    else { print("W7 fano variance: FAIL"); ok = false }

    if ok { print("ALL PASS") } else { print("SOME FAIL") }
}
