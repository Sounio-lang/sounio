//@ run-pass
//@ expect-stdout-contains: BYTECOMPARE PASS
// NOTE: this test requires the mono-mangle separator fix ("name__mg_type"): with a
// bare "_" separator, instantiating cd_zero_exact::<i64> collided with the hand-
// monomorphized sibling cd_zero_exact_i64 in the concrete engine (arity mismatch
// across the whole bundle).
// Byte-compare acceptance test: the GENERIC exact Cayley-Dickson engine
// (stdlib/algebra/cayley_dickson_exact.sio, turbofish-instantiated at <i64>) vs the
// CONCRETE i64 exact engine (stdlib/algebra/cayley_dickson_exact_i64.sio) must agree
// component-for-component on the same inputs.
//
// Inputs (k=4, dimension 16): a = e_3 + e_10, b = e_6 - e_15.
// Products compared: a*b, e_1*e_1, e_1*e_2 — all 16 components, pairwise ==.
//
// Both engines store coefficients in a fixed [_; 2048] array behind a `c` field
// (CDElementExact<i64>.c for the generic engine, CDElementExactI64.c for the
// concrete engine), so component-by-component indexed reads are directly
// comparable — no adapter/conversion needed.
//
// Expected output (once the compiler defect above is fixed):
//   MUL_AB MATCH
//   SQ_E1 MATCH
//   E1E2 MATCH
//   BYTECOMPARE PASS

use algebra::cayley_dickson_exact::{
    cd_basis_exact, cd_add_exact, cd_sub_exact, cd_mul_exact,
}
use algebra::cayley_dickson_exact_i64::{
    cd_basis_exact_i64, cd_add_exact_i64, cd_sub_exact_i64, cd_mul_exact_i64,
}

fn main() with IO, Mut, Panic, Div {
    let k: i32 = 4
    let zero: i64 = 0
    let one: i64 = 1

    // ---- GENERIC engine (CDElementExact<i64> via turbofish) ----
    let g_e3 = cd_basis_exact::<i64>(k, 3, zero, one)
    let g_e10 = cd_basis_exact::<i64>(k, 10, zero, one)
    let g_a = cd_add_exact::<i64>(g_e3, g_e10, zero)

    let g_e6 = cd_basis_exact::<i64>(k, 6, zero, one)
    let g_e15 = cd_basis_exact::<i64>(k, 15, zero, one)
    let g_b = cd_sub_exact::<i64>(g_e6, g_e15, zero)

    let g_mul_ab = cd_mul_exact::<i64>(g_a, g_b, zero)

    let g_e1 = cd_basis_exact::<i64>(k, 1, zero, one)
    let g_e2 = cd_basis_exact::<i64>(k, 2, zero, one)
    let g_sq_e1 = cd_mul_exact::<i64>(g_e1, g_e1, zero)
    let g_e1e2 = cd_mul_exact::<i64>(g_e1, g_e2, zero)

    // ---- CONCRETE engine (CDElementExactI64, no generics) ----
    let c_e3 = cd_basis_exact_i64(k, 3)
    let c_e10 = cd_basis_exact_i64(k, 10)
    let c_a = cd_add_exact_i64(c_e3, c_e10)

    let c_e6 = cd_basis_exact_i64(k, 6)
    let c_e15 = cd_basis_exact_i64(k, 15)
    let c_b = cd_sub_exact_i64(c_e6, c_e15)

    let c_mul_ab = cd_mul_exact_i64(c_a, c_b)

    let c_e1 = cd_basis_exact_i64(k, 1)
    let c_e2 = cd_basis_exact_i64(k, 2)
    let c_sq_e1 = cd_mul_exact_i64(c_e1, c_e1)
    let c_e1e2 = cd_mul_exact_i64(c_e1, c_e2)

    // ---- Component-by-component comparison, all 16 components ----
    let n: i32 = 16

    var i: i32 = 0
    var mul_ab_match = true
    while i < n {
        if g_mul_ab.c[i as usize] != c_mul_ab.c[i as usize] { mul_ab_match = false }
        i = i + 1
    }
    if mul_ab_match { println("MUL_AB MATCH") } else { println("MUL_AB DIFF") }

    i = 0
    var sq_e1_match = true
    while i < n {
        if g_sq_e1.c[i as usize] != c_sq_e1.c[i as usize] { sq_e1_match = false }
        i = i + 1
    }
    if sq_e1_match { println("SQ_E1 MATCH") } else { println("SQ_E1 DIFF") }

    i = 0
    var e1e2_match = true
    while i < n {
        if g_e1e2.c[i as usize] != c_e1e2.c[i as usize] { e1e2_match = false }
        i = i + 1
    }
    if e1e2_match { println("E1E2 MATCH") } else { println("E1E2 DIFF") }

    if mul_ab_match && sq_e1_match && e1e2_match {
        println("BYTECOMPARE PASS")
    } else {
        println("BYTECOMPARE FAIL")
    }
}
