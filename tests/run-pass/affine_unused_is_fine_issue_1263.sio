//@ run-pass
//@ description: #1263 — an affine value may be dropped unused (at most once, not exactly once); no E040 on either engine
//@ expect-stdout: affine unused OK

affine struct Permit {
    id: i64,
}

fn main() -> i32 with IO {
    let permit = Permit { id: 5 }
    print("affine unused OK\n")
    0
}
