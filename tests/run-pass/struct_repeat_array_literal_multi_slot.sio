//@ run-pass
//@ expect-stdout: t0=77 t3=77 b37=8 two=6,9 w1=5 w2=77 r2=7,42
//@ description: `[StructLit; N]` with a struct wider than one qword (#2190)
//
// lean_single reserved and addressed rep_count*nslots frame slots for this
// expression although the array is pointer-per-slot, so the returned base was
// nslots-1 slots past element 0: every access to a > 1-qword element read a
// stray frame word as a pointer (SIGSEGV, or garbage). One-qword structs
// matched by accident. Also checks the elements are distinct copies.
struct Inner { tag: i64, bits: [i64; 8] }
struct Two { tag: i64, other: i64 }
struct Rec { tag: i64, val: i64 }

fn main() -> i64 with IO, Mut, Panic, Div {
    var arr = [Inner { tag: 77, bits: [1, 2, 3, 4, 5, 6, 7, 8] }; 4]
    let twos = [Two { tag: 6, other: 9 }; 3]
    arr[1].tag = 5
    var recs = [Rec { tag: 1, val: 2 }; 4]
    recs[2] = Rec { tag: 7, val: 42 }
    print("t0=")
    print_int(arr[0].tag)
    print(" t3=")
    print_int(arr[3].tag)
    print(" b37=")
    print_int(arr[3].bits[7])
    print(" two=")
    print_int(twos[2].tag)
    print(",")
    print_int(twos[2].other)
    print(" w1=")
    print_int(arr[1].tag)
    print(" w2=")
    print_int(arr[2].tag)
    print(" r2=")
    print_int(recs[2].tag)
    print(",")
    print_int(recs[2].val)
    print("\n")
    if arr[2].tag != 77 { return 1 }
    if recs[1].val != 2 { return 1 }
    0
}
