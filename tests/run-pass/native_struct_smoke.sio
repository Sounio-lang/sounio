//@ run-pass
// Sprint 223: Native struct smoke test — validates struct codegen through lean driver
// Tests: struct definition, literal creation, field access, f64 arithmetic, mutation

struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

fn vec3_dot(a: Vec3, b: Vec3) -> f64 {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

fn vec3_length_sq(v: Vec3) -> f64 {
    return vec3_dot(v, v)
}

fn f64_to_int_x1000(v: f64) -> i64 {
    return (v * 1000.0) as i64
}

fn main() -> i64 {
    // T1: struct creation + field access
    let a = Vec3 { x: 3.0, y: 4.0, z: 0.0 }
    let ax_i = f64_to_int_x1000(a.x)
    print("T1_ax=")
    print_int(ax_i)
    print("\n")

    // T2: struct passed to function + f64 arithmetic
    let dot_aa = vec3_dot(a, a)
    let dot_i = f64_to_int_x1000(dot_aa)
    print("T2_dot=")
    print_int(dot_i)
    print("\n")

    // T3: different struct values + dot product
    let b = Vec3 { x: 1.0, y: 2.0, z: 3.0 }
    let dot_ab = vec3_dot(a, b)
    let dot_ab_i = f64_to_int_x1000(dot_ab)
    print("T3_dot_ab=")
    print_int(dot_ab_i)
    print("\n")

    // T4: struct mutation via var
    var c = Vec3 { x: 10.0, y: 20.0, z: 30.0 }
    c.x = 100.0
    let cx_i = f64_to_int_x1000(c.x)
    print("T4_cx=")
    print_int(cx_i)
    print("\n")

    // T5: length squared (compound expression)
    let len_sq = vec3_length_sq(b)
    let len_sq_i = f64_to_int_x1000(len_sq)
    print("T5_len_sq=")
    print_int(len_sq_i)
    print("\n")

    // T6: struct returned from function call chain
    let d = Vec3 { x: 0.5, y: 0.25, z: 0.125 }
    let sum_d = d.x + d.y + d.z
    let sum_d_i = f64_to_int_x1000(sum_d)
    print("T6_sum=")
    print_int(sum_d_i)
    print("\n")

    0
}
