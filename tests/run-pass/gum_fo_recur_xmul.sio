//@ run-pass
//@ requires: madaros
//@ expect-stdout: p0 0.090000
//@ expect-stdout: p1 9.000000
//@ expect-stdout: p2 506.250000
//@ expect-stdout: p12 906586647033691392.000000
//@ expect-stdout: pneg 0.090000
//@ expect-stdout: RECUR_XMUL_OK
// a = 5 +- 0.3, var = 0.09.
// powx(a, n) = a^(n+1) for n >= 0. Derivative (n+1) a^n.
// n = 1 is 10^2 * 0.09. n = 2 is 75^2 * 0.09.
// n = 12 is (13 * 5^12)^2 * 0.09.

fn powx(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        x * powx(x, n - 1)
    }
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let p0 = variance_of(powx(a, 0))
    let p1 = variance_of(powx(a, 1))
    let p2 = variance_of(powx(a, 2))
    let p12 = variance_of(powx(a, 12))
    let pneg = variance_of(powx(a, 0 - 2))
    print("p0 ")
    print_f64(p0)
    println("")
    print("p1 ")
    print_f64(p1)
    println("")
    print("p2 ")
    print_f64(p2)
    println("")
    print("p12 ")
    print_f64(p12)
    println("")
    print("pneg ")
    print_f64(pneg)
    println("")
    var fails: i64 = 0
    if p0 < 0.089999 || p0 > 0.090001 { fails = fails + 1 }
    if p1 < 8.999999 || p1 > 9.000001 { fails = fails + 1 }
    if p2 < 506.249999 || p2 > 506.250001 { fails = fails + 1 }
    if p12 < 906586647033691000.0 || p12 > 906586647033692000.0 { fails = fails + 1 }
    if pneg < 0.089999 || pneg > 0.090001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_XMUL_OK")
        0
    } else {
        println("RECUR_XMUL_FAIL")
        1
    }
}
