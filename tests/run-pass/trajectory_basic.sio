//@ run-pass
//
// M2a smoke — `Trajectory` push + iteration over flat-array layout.
//
// Pins these contracts of `stdlib/dialogue/trajectory.sio`:
//   1. `traj_empty()` returns a zero-length trajectory.
//   2. `traj_push(&t, speaker, hash, affect, rupture, dim)` increments len
//      and stores the right values at the right column index.
//   3. Read helpers (`traj_hash`, `traj_speaker`, `traj_payload_at`) recover
//      the per-utterance fields by dynamic index.
//   4. Speaker / rupture aggregates count correctly.
//
// What this proves about the compiler today: the flat-array layout
// workaround for the broken array-of-struct dynamic indexing path lets us
// build the dialogue trajectory object the homology functor F operates on
// without any compiler changes.

use stdlib::dialogue::trajectory::*

fn main() -> i64 with IO, Mut {
    var t: Trajectory = traj_empty()

    // Three-utterance dyadic exchange: A → B → A
    //   u0: speaker=0 (A), hash=100, affect=1, rupture=0, dim=8
    //   u1: speaker=1 (B), hash=200, affect=2, rupture=1, dim=8   (repair marker)
    //   u2: speaker=0 (A), hash=300, affect=1, rupture=0, dim=8
    let n0: i64 = traj_push(&t, 0, 100, 1, 0, 8)
    let n1: i64 = traj_push(&t, 1, 200, 2, 1, 8)
    let n2: i64 = traj_push(&t, 0, 300, 1, 0, 8)

    // Drop a payload feature on u1 to exercise the f64 flat-row path.
    traj_set_payload(&t, 1, 3, 0.75)

    var ok: i64 = 1

    if n0 != 1 { ok = 0 }
    if n1 != 2 { ok = 0 }
    if n2 != 3 { ok = 0 }
    if traj_len(&t) != 3 { ok = 0 }

    if traj_hash(&t, 0) != 100 { ok = 0 }
    if traj_hash(&t, 1) != 200 { ok = 0 }
    if traj_hash(&t, 2) != 300 { ok = 0 }

    if traj_speaker(&t, 0) != 0 { ok = 0 }
    if traj_speaker(&t, 1) != 1 { ok = 0 }
    if traj_speaker(&t, 2) != 0 { ok = 0 }

    let p13: f64 = traj_payload_at(&t, 1, 3)
    if p13 < 0.749 { ok = 0 }
    if p13 > 0.751 { ok = 0 }

    if traj_count_speaker(&t, 0) != 2 { ok = 0 }
    if traj_count_speaker(&t, 1) != 1 { ok = 0 }
    if traj_count_rupture(&t) != 1 { ok = 0 }

    if ok == 1 { print("PASS\n") } else { print("FAIL\n") }
    return 0
}
