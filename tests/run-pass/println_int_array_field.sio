//@ run-pass
// Regression for the println i64-segfault array-element axis: printing an i64
// element of a struct's array field must route to print_int, not the char*
// printer (which SIGSEGV'd by deref'ing the integer as a pointer).
struct S { c: [i64; 4], bits: i64 }
fn make() -> S {
    S { c: [10, 20, 30, 40], bits: 7 }
}
fn main() with IO {
    let v = make()
    println(v.c[2])
    println(v.bits)
    println("elem PASS")
}
