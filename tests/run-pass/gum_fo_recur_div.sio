//@ run-pass
//@ requires: madaros
//@ expect-stdout: d0 0.090000
//@ expect-stdout: d2 0.005625
//@ expect-stdout: d12 0.000000
//@ expect-stdout: dneg 0.090000
//@ expect-stdout: RECUR_DIV_OK
// a = 5 +- 0.3, var = 0.09.
// h(a, n) = a / 2^n. n = 2 is 0.09 / 16. n = 12 is 0.09 / 4096^2.

fn h(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        h(x, n - 1) / 2.0
    }
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let d0 = variance_of(h(a, 0))
    let d2 = variance_of(h(a, 2))
    let d12 = variance_of(h(a, 12))
    let dneg = variance_of(h(a, 0 - 2))
    print("d0 ")
    print_f64(d0)
    println("")
    print("d2 ")
    print_f64(d2)
    println("")
    print("d12 ")
    print_f64(d12)
    println("")
    print("dneg ")
    print_f64(dneg)
    println("")
    var fails: i64 = 0
    if d0 < 0.089999 || d0 > 0.090001 { fails = fails + 1 }
    if d2 < 0.005624 || d2 > 0.005626 { fails = fails + 1 }
    if d12 < 0.000000005 || d12 > 0.000000006 { fails = fails + 1 }
    if dneg < 0.089999 || dneg > 0.090001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_DIV_OK")
        0
    } else {
        println("RECUR_DIV_FAIL")
        1
    }
}
