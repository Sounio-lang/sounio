use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step2_taylor2_time_slab_containment_check(
        311696236, 301485983, 268229078, 223161586, 444092349, 0, 13)
    if artifact_fp != 85766158 { return 1 }
    let audit_fp = lorenz_i256_step2_taylor2_time_slab_containment_audit_fingerprint(
        artifact_fp, 121434193, 856015850, 311696236, 301485983,
        268229078, 223161586, 444092349, 2, 13, 255)
    if audit_fp != 81234415 { return 2 }
