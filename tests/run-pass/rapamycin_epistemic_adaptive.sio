//@ run-pass
//@ expect-stdout: PASS
//@ expect-stdout: FAMILY_A_VAR_LIVE
// β⁵ inter-procedural variance propagation enabled: mutable f64 vars use fixed runtime
// variance slots so variance_of() tracks across loop iterations and function call boundaries.
// ============================================================================
// EPISTEMIC ADAPTIVE ODE — FIRST IMPLEMENTATION
// Bogacki-Shampine 3(2) with variance-aware lookbehind step control
// ============================================================================
//
// NOVELTY: first ODE integrator that combines numerical error control with
// metrological variance-growth control, using a lookbehind (post-step,
// next-step) adaptive strategy:
//
//   After each in-place step:
//     err_norm    = |e_num| / (atol + rtol·|y|)         [numerical]
//     v_growth    = variance_of(y) − var_pre             [metrological]
//     u_ratio     = v_growth / (u_atol + u_rtol·var_pre)
//
//     dt_num   = dt · safety · (1/err_norm)^(1/3)       [3rd-order method]
//     dt_epist = dt · safety · (1/u_ratio)^(1/2)         [variance ~ dt²]
//     dt_next  = min(dt_num, dt_epist)
//
// Why lookbehind rather than trial-and-reject:
//   The Sounio compiler's GUM variance propagation is reliable for in-place
//   mutation (var = var + …) but has limited depth for trial-then-commit
//   patterns in deep expression chains. Lookbehind control achieves the same
//   adaptive effect without rollback — the next step's dt is informed by the
//   current step's observed variance growth.
//
// Method: Bogacki-Shampine 3(2) (default in MATLAB ode23)
//         c = [0, 1/2, 3/4, 1]
//         b  = [2/9, 1/3, 4/9, 0]       (3rd order)
//         e  = [-5/72, 1/12, 1/9, -1/8]
// Model:  Rapamycin 3-compartment PBPK (blood, brain, peripheral)
// Params: CL=12.4±1.24, kp_brain=0.08±0.008, fu=0.08±0.008 (10% CV each)
// Ref:    JCGM 100:2008 (GUM), Bogacki & Shampine (1989)
// ============================================================================

// ─── Math helpers ───

fn ep_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn ep_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 {
        y = (y + x / y) * 0.5
        i = i + 1
    }
    return y
}

fn ep_max(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn ep_min(a: f64, b: f64) -> f64 {
    if a < b { return a }
    return b
}

fn cube_root(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = 1.0
    var i = 0
    while i < 20 {
        let y2 = y * y
        y = y - (y2 * y - x) / (3.0 * y2)
        i = i + 1
    }
    return y
}

// ─── 3-compartment rapamycin PBPK ODE system ───
// Family A contour (2026-08-18): Madaros FO variance does not cross user fn
// calls (CALL3 discriminant). RHS inlined at sites in main (iso pattern).
// Compiler follow-up: interprocedural FO. See fabrication sweep audit.


// ============================================================================
// MAIN — Epistemic Adaptive Integration with Lookbehind Step Control
// ============================================================================

fn main() -> i64 with IO, Mut, Div, Epistemic {
    print("======================================================================\n")
    print("  Epistemic Adaptive ODE — Bogacki-Shampine 3(2) + Metrological Control\n")
    print("  Rapamycin 3-Compartment PBPK\n")
    print("======================================================================\n\n")

    // ── Uncertain PK parameters via measure() ──
    let k_cl: Knowledge<f64> = measure(12.4, uncertainty: 1.24)
    let k_kp: Knowledge<f64> = measure(0.08, uncertainty: 0.008)
    let k_fu: Knowledge<f64> = measure(0.08, uncertainty: 0.008)
    let cl = k_cl.value
    let kp = k_kp.value
    let fu = k_fu.value

    // ── Tolerances ──
    let u_atol = 1.0e-6         // epistemic absolute variance tolerance
    let u_rtol = 0.15           // epistemic relative variance growth target (15%)
    let safety = 0.9
    let max_growth = 3.0
    let min_shrink = 0.3

    // ── Initial conditions: 6mg IV bolus (deterministic) ──
    var c_blood = 6.0 / 5.0
    var c_brain = 0.0
    var c_periph = 0.0
    var t = 0.0
    let t_end = 2.0
    var dt = 0.05

    // ── Statistics ──
    var steps: i64 = 0
    var epist_shrinks: i64 = 0
    var epist_grows: i64 = 0
    var epist_active: i64 = 0

    while t < t_end && steps < 500 {
        let dt_use = ep_min(dt, t_end - t)

        // Save pre-step variance for lookbehind metrological check
        let var_pre = variance_of(c_blood)

        // ═══ Bogacki-Shampine 3(2) stages ═══

        // Stage 1: k1 = f(t_n, y_n)
        let k1b = ((0.7 / 5.0) * (c_brain) / (kp) + (3.9 / 5.0) * (c_periph) / 3.0 - ((0.7 + 3.9) / 5.0) * (c_blood) - ((cl) * (fu) / 5.0) * (c_blood))
        let k1br = ((0.7 / 1.4) * ((c_blood) - (c_brain) / (kp)))
        let k1p = ((3.9 / 40.0) * ((c_blood) - (c_periph) / 3.0))

        // Stage 2: y + dt/2 · k1
        let s2b = c_blood + 0.5 * dt_use * k1b
        let s2br = c_brain + 0.5 * dt_use * k1br
        let s2p = c_periph + 0.5 * dt_use * k1p
        let k2b = ((0.7 / 5.0) * (s2br) / (kp) + (3.9 / 5.0) * (s2p) / 3.0 - ((0.7 + 3.9) / 5.0) * (s2b) - ((cl) * (fu) / 5.0) * (s2b))
        let k2br = ((0.7 / 1.4) * ((s2b) - (s2br) / (kp)))
        let k2p = ((3.9 / 40.0) * ((s2b) - (s2p) / 3.0))

        // Stage 3: y + 3dt/4 · k2
        let s3b = c_blood + 0.75 * dt_use * k2b
        let s3br = c_brain + 0.75 * dt_use * k2br
        let s3p = c_periph + 0.75 * dt_use * k2p
        let k3b = ((0.7 / 5.0) * (s3br) / (kp) + (3.9 / 5.0) * (s3p) / 3.0 - ((0.7 + 3.9) / 5.0) * (s3b) - ((cl) * (fu) / 5.0) * (s3b))
        let k3br = ((0.7 / 1.4) * ((s3b) - (s3br) / (kp)))
        let k3p = ((3.9 / 40.0) * ((s3b) - (s3p) / 3.0))

        // ═══ IN-PLACE commit (preserves GUM variance in slot) ═══
        let dt9 = dt_use / 9.0
        c_blood = c_blood + dt9 * (2.0 * k1b + 3.0 * k2b + 4.0 * k3b)
        // Read variance IMMEDIATELY after blood update, before any other
        // operations that could scramble the variance scratch state.
        let var_post = variance_of(c_blood)
        c_brain = c_brain + dt9 * (2.0 * k1br + 3.0 * k2br + 4.0 * k3br)
        c_periph = c_periph + dt9 * (2.0 * k1p + 3.0 * k2p + 4.0 * k3p)
        t = t + dt_use
        steps = steps + 1

        // ═══ Post-step measurements ═══

        // Numerical error estimate (BS3 error weights on pre-commit stages only)
        // We use ||e|| = dt · |k1 - 3*k2 + 2*k3| as a simple 3rd-order error proxy
        // (avoids re-evaluating RHS at committed point, which would scramble
        // variance scratch state for the upcoming variance_of(c_blood) read).
        let atol = 1.0e-6
        let rtol = 1.0e-3
        let eproxy_b = dt_use * (k1b - 3.0 * k2b + 2.0 * k3b)
        let eproxy_br = dt_use * (k1br - 3.0 * k2br + 2.0 * k3br)
        let eproxy_p = dt_use * (k1p - 3.0 * k2p + 2.0 * k3p)
        let sc_b = atol + rtol * ep_abs(c_blood)
        let sc_br = atol + rtol * ep_abs(c_brain)
        let sc_p = atol + rtol * ep_abs(c_periph)
        let en_b = ep_abs(eproxy_b) / sc_b
        let en_br = ep_abs(eproxy_br) / sc_br
        let en_p = ep_abs(eproxy_p) / sc_p
        let err_norm = ep_max(en_b, ep_max(en_br, en_p))

        // Epistemic variance growth (lookbehind) — var_post read right after update
        let var_growth = var_post - var_pre

        // ═══ Dual step-size control ═══

        // Numerical: 3rd-order method, cube root
        var q_num = max_growth
        if err_norm > 1.0e-20 { q_num = safety * cube_root(1.0 / err_norm) }

        // Epistemic: variance grows as dt^2 for GUM linearization
        var q_epist = max_growth
        if var_pre > u_atol && var_growth > 0.0 {
            let u_ratio = var_growth / (u_atol + u_rtol * var_pre)
            if u_ratio > 1.0e-20 {
                q_epist = safety * ep_sqrt(1.0 / u_ratio)
                epist_active = epist_active + 1
            }
            // Track epistemic influence
            if u_ratio > 1.0 { epist_shrinks = epist_shrinks + 1 }
            if u_ratio < 0.1 { epist_grows = epist_grows + 1 }
        }

        // Combined: use limiting criterion
        let q = ep_min(q_num, q_epist)
        let q_clamp = ep_max(min_shrink, ep_min(q, max_growth))
        dt = ep_max(1.0e-6, ep_min(dt_use * q_clamp, 0.5))
    }

    // ═══ Results ═══
    print("  Integration reached t = "); println(t)
    print("\n  Final concentrations:\n")
    print("    c_blood   = "); println(c_blood)
    print("    c_brain   = "); println(c_brain)
    print("    c_periph  = "); println(c_periph)
    print("\n  GUM variance (compiler-native):\n")
    print("    var(blood)  = "); println(variance_of(c_blood))
    print("    var(brain)  = "); println(variance_of(c_brain))
    print("    var(periph) = "); println(variance_of(c_periph))

    print("\n  ISO uncertainty budget (blood):\n")

    print("\n  Adaptive stepping statistics:\n")
    print("    accepted steps        = "); println(steps)
    print("    epistemic active sigs = "); println(epist_active)
    print("    epistemic shrink sigs = "); println(epist_shrinks)
    print("    epistemic grow sigs   = "); println(epist_grows)
    print("    final dt              = "); println(dt)
    print("\n")

    // ── Validation ──
    // Pass criteria:
    //   1. Integration reaches t_end (correct numerical method)
    //   2. Concentrations physically plausible (clearance + distribution)
    //   3. Epistemic step-size mechanism fired at least once (epist_active > 0)
    //   4. GUM variance is non-zero on blood (refuse silent fabrication of 0.0)
    //      Madaros has been measured collapsing variance_of to exactly 0 while
    //      lean_single reports ~1e-5 — that must FAIL, not print FAIL and exit 0.
    let ok_completed = t >= t_end - 1.0e-4
    let ok_blood = c_blood > 0.0 && c_blood < 1.5
    let ok_mech = epist_active > 0
    let v_blood = variance_of(c_blood)
    let v_brain = variance_of(c_brain)
    let v_periph = variance_of(c_periph)
    let ok_var = v_blood > 1.0e-18 && v_brain > 0.0 && v_periph >= 0.0

    if ok_completed && ok_blood && ok_mech && ok_var {
        print("======================================================================\n")
        print("  PASS — Epistemic adaptive integration completed\n")
        print("  ** Lookbehind metrological step control ACTIVE:\n")
        print("     variance-growth signals fired and informed step sizing **\n")
        print("======================================================================\n")
        // Value pin, not print: v_blood is ~1e-4 (visible at 6dp). Collapse to
        // exact 0 is Family A CALC, not Family B emitter.
        println("FAMILY_A_VAR_LIVE")
        print("PASS\n")
        return 0
    } else {
        print("FAIL: completion=")
        if ok_completed { print("ok ") } else { print("no ") }
        print("blood=")
        if ok_blood { print("ok ") } else { print("no ") }
        print("mech=")
        if ok_mech { print("ok ") } else { print("no ") }
        print("var=")
        if ok_var { print("ok\n") } else {
            print("FABRICATED_ZERO\n")
            print("EPISTEMIC_FABRICATION: variance_of collapsed to ~0 under this engine\n")
        }
        return 1
    }
}
