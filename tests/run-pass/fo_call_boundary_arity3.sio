//@ run-pass
//@ known-failure: Madaros FO transfer skips helpers with >2 params (lower.sio
//@   fo_register_pure_fn_transfer). Identity of the first arg still arrives 0.
//@   lean_single keeps a live variance. See MADAROS_FO_CALL_BOUNDARY_DISPATCH.
//@ expect-stdout: FO_CALL_BOUNDARY_LIVE
//@ description: FO must survive a 3-parameter user function (even identity).

fn id3(a: f64, b: f64, c: f64) -> f64 { a }

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(10.0, uncertainty: 1.0)
    let v = variance_of(id3(k.value, 0.0, 0.0))
    print("id3_var ")
    print_f64(v)
    println("")
    if v > 1.0e-12 {
        println("FO_CALL_BOUNDARY_LIVE")
        0
    } else {
        println("FO_CALL_BOUNDARY_ZERO")
        1
    }
}
