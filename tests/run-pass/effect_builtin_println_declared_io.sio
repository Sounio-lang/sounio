//@ run-pass
//@ expect-stdout: hello
//@ description: #2760 -- the declared counterpart of tests/compile-fail/effect_builtin_println_issue_2760.sio. `with IO` on the caller satisfies the builtin's effect on both engines.

fn greet(n: i64) -> i64 with IO {
    println("hello")
    n + 1
}
fn main() -> i64 with IO {
    let r = greet(1)
    if r == 2 { 0 } else { 1 }
}
