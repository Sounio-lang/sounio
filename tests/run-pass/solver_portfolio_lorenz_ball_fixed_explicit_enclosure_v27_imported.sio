//@ requires: madaros
//@ description: Imported portfolio v27 Lorenz ball-fixed explicit-enclosure receipt smoke

use theorem::portfolio::*

fn main() -> i64 with Mod {
    let instance_fp = solver_portfolio_v27_lorenz_explicit_enclosure_instance_fingerprint(
        1000000, 5, 508132668, 166945519, 7)
    if instance_fp != 808477419 { return 1 }

    let certificate_fp = solver_portfolio_v27_lorenz_explicit_enclosure_certificate_fingerprint(
        instance_fp, 70877465, 565673886, 114244647, 166945519, 7)
    if certificate_fp != 414432618 { return 2 }

    let entry_fp = portfolio_entry_fingerprint(
        portfolio_kind_lorenz_ball_fixed_explicit_enclosure(),
        instance_fp,
        certificate_fp,
        portfolio_result_validated(),
        portfolio_checker_lorenz_ball_fixed_explicit_enclosure())
    if entry_fp != 547731575 { return 3 }

    let manifest_fp = solver_portfolio_v27_lorenz_explicit_enclosure_bundle_fingerprint(
        508132668, 166945519, 114244647)
    if manifest_fp != 291678314 { return 4 }

    let result_coverage_fp = solver_portfolio_v27_result_coverage_fingerprint(
        27, 31, 9, 20, 1, 1, manifest_fp)
    if result_coverage_fp != 505104449 { return 5 }

    let family_coverage_fp = solver_portfolio_v27_checker_family_coverage_fingerprint(
        27, 31, 5, 3, 2, 1, 20, manifest_fp)
    if family_coverage_fp != 475711309 { return 6 }

    let acceptance_fp = solver_portfolio_v27_acceptance_receipt_fingerprint(
        27, manifest_fp, result_coverage_fp)
    if acceptance_fp != 609703723 { return 7 }

    let audit_fp = solver_portfolio_v27_audit_receipt_fingerprint(
        27, manifest_fp, result_coverage_fp, family_coverage_fp, acceptance_fp)
    if audit_fp != 377961680 { return 8 }

    let readiness_fp = solver_portfolio_v27_readiness_fingerprint(
        27, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp)
    if readiness_fp != 106882974 { return 9 }

    if solver_portfolio_v27_lorenz_explicit_enclosure_bundle_fingerprint(
        508132668, 166945520, 114244647) != (0 - 1) { return 10 }
    if solver_portfolio_v27_result_coverage_fingerprint(
        27, 31, 9, 19, 1, 1, manifest_fp) != (0 - 1) { return 11 }
    if solver_portfolio_v27_checker_family_coverage_fingerprint(
        27, 31, 5, 3, 2, 1, 19, manifest_fp) != (0 - 1) { return 12 }
    if solver_portfolio_v27_readiness_fingerprint(
        27, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp + 1) != (0 - 1) { return 13 }

    return 0
}
