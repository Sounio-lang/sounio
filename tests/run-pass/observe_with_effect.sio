//@ run-pass

// All observation boundaries are satisfied because `with Observe` is declared.

fn observe_and_return(x: Unobserved<f64>) -> f64 with Observe {
    x
}

fn observe_and_bind(x: Unobserved<f64>) -> f64 with Observe {
    let y: f64 = x
    y
}

fn consume(x: f64) -> f64 {
    x
}

fn observe_and_pass(u: Unobserved<f64>) -> f64 with Observe {
    consume(u)
}

fn main() -> i64 with IO {
    0
}
