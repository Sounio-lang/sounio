//@ run-pass
//@ expect-stdout: UNIT_XMOD_EPISTEMIC_CLONE_PASS
// A helper whose parameters are typed by a `unit` declared in ITS module,
// called from a function that carries Epistemic. The call goes through the
// helper's tangent clone, which the queue drain of the caller lowers; until
// the fix that drain lowered it under the caller's module id, where the
// helper's units are unknown, so each unit parameter became an integer word
// and `as f64` converted the double's bits: 2.0 /h x 0.25 h printed 2^60,
// 2.0 /h printed 2^62, and cl / v divided two words (half-life 0 or inf).
// The same calls from a caller without Epistemic were always right.
use testmod::unit_xmod_epi::*

fn close(got: f64, want: f64) -> bool {
    let d = got - want
    d < 0.000000001 && d > 0.0 - 0.000000001
}

fn ka_dt_typed(ka: f64, dt: f64) -> f64 {
    let kau: per_h = ka
    let dtu: h = dt
    return uxe_ka_dt(kau, dtu)
}

fn cast_typed(ka: f64) -> f64 {
    let kau: per_h = ka
    return uxe_cast(kau)
}

fn half_life_typed(cl: f64, v: f64) -> f64 {
    let clu: L_per_h = cl
    let vu: L = v
    return uxe_half_life(clu, vu)
}

fn scale_typed(q: f64, e: f64) -> f64 {
    let qu: L_per_h = q
    return uxe_scale(qu, e)
}

fn plain_ok() -> i64 with IO {
    var bad: i64 = 0
    if !close(ka_dt_typed(2.0, 0.25), 0.5) { bad = bad + 1 }
    if !close(cast_typed(2.0), 2.0) { bad = bad + 1 }
    if !close(half_life_typed(6.0, 42.0), 4.851) { bad = bad + 1 }
    if !close(scale_typed(6.0, 0.25), 1.5) { bad = bad + 1 }
    bad
}

fn main() -> i64 with IO, Epistemic {
    let a = ka_dt_typed(2.0, 0.25)
    let b = cast_typed(2.0)
    let c = half_life_typed(6.0, 42.0)
    let s = scale_typed(6.0, 0.25)
    print("ka_dt ")
    println(a)
    print("cast ")
    println(b)
    print("half_life ")
    println(c)
    print("scale ")
    println(s)
    var bad = plain_ok()
    if !close(a, 0.5) { bad = bad + 1 }
    if !close(b, 2.0) { bad = bad + 1 }
    if !close(c, 4.851) { bad = bad + 1 }
    if !close(s, 1.5) { bad = bad + 1 }
    if bad == 0 {
        println("UNIT_XMOD_EPISTEMIC_CLONE_PASS")
        return 0
    }
    print("unit_xmod_epistemic_clone: wrong values ")
    print_int(bad)
    print("\n")
    return 1
}
