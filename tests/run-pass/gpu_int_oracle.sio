// Device oracle for the integer signedness class.
use gpu::kaxi_backend::*
use gpu::kaxi_to_ptx::*
fn oc_store(text: string, src: i64, addr: i64, seq: i64) -> string with Mut, Panic, Div, Alloc {
    var t = str_concat(text, "store_global r")
    t = str_concat(t, oc_i64(src))
    t = str_concat(t, ", addr=r")
    t = str_concat(t, oc_i64(addr))
    t = str_concat(t, ", seq=")
    t = str_concat(t, oc_i64(seq))
    t = str_concat(t, "\n")
    t
}
fn oc_imm(text: string, dst: i64, imm: i64, seq: i64) -> string with Mut, Panic, Div, Alloc {
    var t = str_concat(text, "load_imm r")
    t = str_concat(t, oc_i64(dst))
    t = str_concat(t, ", imm=")
    t = str_concat(t, oc_i64(imm))
    t = str_concat(t, ", seq=")
    t = str_concat(t, oc_i64(seq))
    t = str_concat(t, "\n")
    t
}
fn oc_i64(v: i64) -> string with Mut, Panic, Div {
    if v == 0 { return "0" }
    var neg: bool = false
    var x = v
    if x < 0 { neg = true; x = 0 - x }
    var digits = ""
    while x > 0 {
        let d = x - (x / 10) * 10
        var ch = "0"
        if d == 1 { ch = "1" }
        else if d == 2 { ch = "2" }
        else if d == 3 { ch = "3" }
        else if d == 4 { ch = "4" }
        else if d == 5 { ch = "5" }
        else if d == 6 { ch = "6" }
        else if d == 7 { ch = "7" }
        else if d == 8 { ch = "8" }
        else if d == 9 { ch = "9" }
        digits = str_concat(ch, digits)
        x = x / 10
    }
    if neg { return str_concat("-", digits) }
    digits
}
fn oc_contains(haystack: string, needle: string) -> bool with Mut, Panic, Div {
    let hlen = str_len(haystack)
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if hlen < nlen { return false }
    var i: i64 = 0
    while i <= (hlen - nlen) {
        var j: i64 = 0
        var ok: bool = true
        while j < nlen {
            if str_char_at(haystack, i + j) != str_char_at(needle, j) { ok = false; break }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    false
}
pub fn kaxi_emit_int_oracle_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var text = "; int oracle: negative-operand sweep\n"
    var seq: i64 = 0
    text = oc_imm(text, 0, 1, seq); seq = seq + 1
    text = oc_imm(text, 20, 7, seq); seq = seq + 1
    text = str_concat(text, "sub r1, r21, r20, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = oc_imm(text, 2, 3, seq); seq = seq + 1
    text = oc_imm(text, 21, 0, seq); seq = seq + 1
    text = str_concat(text, "div r3, r1, r2, var=+0%, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "div r4, r2, r1, var=+0%, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "setp.lt p0, r1, r2, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "setp.gt p1, r1, r2, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "setp.le p2, r1, r2, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "setp.ge p3, r1, r2, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "setp.eq p4, r1, r2, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "setp.ne p5, r1, r2, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "min r5, r1, r2, var=+0%, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "max r6, r1, r2, var=+0%, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "abs r7, r1, var=+0%, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "neg r8, r2, var=+0%, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "selp r9, r1, r2, pred=p0, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "add r10, r1, r2, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "sub r11, r1, r2, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "mul r12, r1, r2, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "selp r13, r0, r21, pred=p0, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "selp r14, r0, r21, pred=p1, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "selp r15, r0, r21, pred=p2, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "selp r16, r0, r21, pred=p3, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "selp r17, r0, r21, pred=p4, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    text = str_concat(text, "selp r18, r0, r21, pred=p5, seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n"); seq = seq + 1
    var w: i64 = 0
    var r: i64 = 3
    while w < 10 {
        text = oc_imm(text, 30, w, seq); seq = seq + 1
        text = oc_store(text, r, 30, seq); seq = seq + 1
        r = r + 1
        w = w + 1
    }
    var q: i64 = 0
    var pr: i64 = 13
    while q < 6 {
        text = oc_imm(text, 30, 10 + q, seq); seq = seq + 1
        text = oc_store(text, pr, 30, seq); seq = seq + 1
        pr = pr + 1
        q = q + 1
    }
    text = str_concat(text, "ret seq="); text = str_concat(text, oc_i64(seq)); text = str_concat(text, "\n")
    kaxi_asm_push_str(kaxi_asm_new(), text)
}
fn oc_expected(i: i64) -> i64 with Mut {
    if i == 0 { return 0 - 2 }
    if i == 1 { return 0 }
    if i == 2 { return 0 - 7 }
    if i == 3 { return 3 }
    if i == 4 { return 7 }
    if i == 5 { return 0 - 3 }
    if i == 6 { return 0 - 7 }
    if i == 7 { return 0 - 4 }
    if i == 8 { return 0 - 10 }
    if i == 9 { return 0 - 21 }
    if i == 10 { return 1 }
    if i == 11 { return 0 }
    if i == 12 { return 1 }
    if i == 13 { return 0 }
    if i == 14 { return 0 }
    1
}
fn main() -> i64 with IO, Mut, Div, Panic, Alloc {
    var fails: i64 = 0
    let asm = kaxi_emit_int_oracle_asm()
    print(kaxi_asm_to_string(asm))
    print("oc_probe:")
    print(oc_i64(0 - 7))
    print("\n")
    let ptx = kaxi_transpile_to_ptx_unified(asm, 0)
    if !oc_contains(ptx, "div.s64") { print("FAIL oracle ptx div\n"); fails = fails + 1 }
    if !oc_contains(ptx, "setp.lt.s64") { print("FAIL oracle ptx lt\n"); fails = fails + 1 }
    if !oc_contains(ptx, "setp.gt.s64") { print("FAIL oracle ptx gt\n"); fails = fails + 1 }
    if !oc_contains(ptx, "setp.le.s64") { print("FAIL oracle ptx le\n"); fails = fails + 1 }
    if !oc_contains(ptx, "setp.ge.s64") { print("FAIL oracle ptx ge\n"); fails = fails + 1 }
    if !oc_contains(ptx, "setp.eq.s64") { print("FAIL oracle ptx eq\n"); fails = fails + 1 }
    if !oc_contains(ptx, "setp.ne.s64") { print("FAIL oracle ptx ne\n"); fails = fails + 1 }
    if !oc_contains(ptx, "min.s64") { print("FAIL oracle ptx min\n"); fails = fails + 1 }
    if !oc_contains(ptx, "max.s64") { print("FAIL oracle ptx max\n"); fails = fails + 1 }
    if !oc_contains(ptx, "abs.s64") { print("FAIL oracle ptx abs\n"); fails = fails + 1 }
    if !oc_contains(ptx, "neg.s64") { print("FAIL oracle ptx neg\n"); fails = fails + 1 }
    let stream = kaxi_assemble(asm)
    var st = kaxi_sim_new()
    st = kaxi_sim_exec(st, stream)
    var i: i64 = 0
    while i < 16 {
        if i == 2 { }
        else if i == 3 { }
        else if i == 4 { }
        else if i == 5 { }
        else if kaxi_sim_mem(&!st, i) != oc_expected(i) {
            print("FAIL oracle sim slot "); print(i); print("\n")
            fails = fails + 1
        }
        i = i + 1
    }
    print("oracle_sim_dump:\n")
    i = 0
    while i < 16 {
        print(kaxi_sim_mem(&!st, i))
        print("\n")
        i = i + 1
    }
    print("oracle_device_expected:\n")
    i = 0
    while i < 16 {
        print(oc_expected(i))
        print("\n")
        i = i + 1
    }
    let bad = oc_expected(0) + 1
    if bad == kaxi_sim_mem(&!st, 0) {
        print("FAIL oracle sabotage survived\n")
        fails = fails + 1
    } else {
        print("oracle_sabotage OK\n")
    }
    if fails == 0 { print("oracle_sim_and_ptx OK\n") }
    print("oracle_ptx_begin\n")
    print(ptx)
    print("oracle_ptx_end\n")
    fails
}
