//@ run-pass
//@ requires: madaros
//@ description: Tiny SAT model-witness certificate for a fixed CNF

fn model_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn lit_var(lit: i64) -> i64 {
    if lit < 0 { return 0 - lit }
    return lit
}

fn lit_code(lit: i64) -> i64 {
    let v = lit_var(lit)
    if lit < 0 { return (v * 2) + 1 }
    return v * 2
}

fn assignment_valid(ax: i64, ay: i64, az: i64) -> i64 {
    if ax < 0 { return 0 }
    if ax > 1 { return 0 }
    if ay < 0 { return 0 }
    if ay > 1 { return 0 }
    if az < 0 { return 0 }
    if az > 1 { return 0 }
    return 1
}

fn clause_len(id: i64) -> i64 {
    if id == 1 { return 2 } // x OR y
    if id == 2 { return 2 } // -x OR z
    if id == 3 { return 2 } // -y OR z
    if id == 4 { return 3 } // x OR -z OR y
    if id == 5 { return 3 } // -x OR y OR -z, false under the witness
    if id == 6 { return 2 } // duplicate literal, invalid shape
    if id == 7 { return 1 } // zero literal, invalid shape
    return 0 - 1
}

fn clause_lit(id: i64, pos: i64) -> i64 {
    if id == 1 {
        if pos == 0 { return 1 }
        if pos == 1 { return 2 }
    }
    if id == 2 {
        if pos == 0 { return 0 - 1 }
        if pos == 1 { return 3 }
    }
    if id == 3 {
        if pos == 0 { return 0 - 2 }
        if pos == 1 { return 3 }
    }
    if id == 4 {
        if pos == 0 { return 1 }
        if pos == 1 { return 0 - 3 }
        if pos == 2 { return 2 }
    }
    if id == 5 {
        if pos == 0 { return 0 - 1 }
        if pos == 1 { return 2 }
        if pos == 2 { return 0 - 3 }
    }
    if id == 6 {
        if pos == 0 { return 1 }
        if pos == 1 { return 1 }
    }
    if id == 7 {
        if pos == 0 { return 0 }
    }
    return 0
}

fn lit_complement(a: i64, b: i64) -> i64 {
    if a + b == 0 {
        if a != 0 { return 1 }
    }
    return 0
}

fn clause_shape_valid(id: i64) -> i64 {
    let n = clause_len(id)
    if n <= 0 { return 0 }
    if n > 3 { return 0 }

    var i: i64 = 0
    while i < n {
        let lit_i = clause_lit(id, i)
        let var_i = lit_var(lit_i)
        if lit_i == 0 { return 0 }
        if var_i < 1 { return 0 }
        if var_i > 3 { return 0 }

        var j = i + 1
        while j < n {
            let lit_j = clause_lit(id, j)
            if lit_i == lit_j { return 0 }
            if lit_complement(lit_i, lit_j) == 1 { return 0 }
            j = j + 1
        }
        i = i + 1
    }
    return 1
}

fn literal_truth(lit: i64, ax: i64, ay: i64, az: i64) -> i64 {
    var a: i64 = 0 - 1
    let v = lit_var(lit)
    if v == 1 { a = ax }
    if v == 2 { a = ay }
    if v == 3 { a = az }
    if a < 0 { return 99 }
    if lit < 0 {
        if a == 0 { return 1 }
        return 0
    }
    return a
}

fn clause_satisfied(id: i64, ax: i64, ay: i64, az: i64) -> i64 {
    if assignment_valid(ax, ay, az) == 0 { return 0 }
    if clause_shape_valid(id) == 0 { return 0 }

    var i: i64 = 0
    while i < clause_len(id) {
        if literal_truth(clause_lit(id, i), ax, ay, az) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn formula_satisfied(clause_count: i64, ax: i64, ay: i64, az: i64) -> i64 {
    if clause_count != 4 { return 0 }
    var id: i64 = 1
    while id <= clause_count {
        if clause_satisfied(id, ax, ay, az) == 0 { return 0 }
        id = id + 1
    }
    return 1
}

fn sat_model_formula_fingerprint() -> i64 with Mod {
    var fp: i64 = 157
    fp = model_mix(fp, 3, 1409) // variables
    fp = model_mix(fp, 4, 1409) // clauses
    fp = model_mix(fp, clause_len(1), 1409)
    fp = model_mix(fp, lit_code(clause_lit(1, 0)), 1409)
    fp = model_mix(fp, lit_code(clause_lit(1, 1)), 1409)
    fp = model_mix(fp, clause_len(2), 1409)
    fp = model_mix(fp, lit_code(clause_lit(2, 0)), 1409)
    fp = model_mix(fp, lit_code(clause_lit(2, 1)), 1409)
    fp = model_mix(fp, clause_len(3), 1409)
    fp = model_mix(fp, lit_code(clause_lit(3, 0)), 1409)
    fp = model_mix(fp, lit_code(clause_lit(3, 1)), 1409)
    fp = model_mix(fp, clause_len(4), 1409)
    fp = model_mix(fp, lit_code(clause_lit(4, 0)), 1409)
    fp = model_mix(fp, lit_code(clause_lit(4, 1)), 1409)
    fp = model_mix(fp, lit_code(clause_lit(4, 2)), 1409)
    return fp
}

fn sat_model_assignment_fingerprint(ax: i64, ay: i64, az: i64) -> i64 with Mod {
    if assignment_valid(ax, ay, az) == 0 { return 0 - 1 }
    var fp: i64 = 163
    fp = model_mix(fp, ax, 1423)
    fp = model_mix(fp, ay, 1423)
    fp = model_mix(fp, az, 1423)
    return fp
}

fn sat_model_certificate_fingerprint(formula_fp: i64, model_fp: i64,
                                     clause_count: i64, var_count: i64,
                                     c1: i64, c2: i64, c3: i64, c4: i64,
                                     formula_ok: i64) -> i64 with Mod {
    if formula_fp != 620950027 { return 0 - 1 }
    if model_fp != 904583820 { return 0 - 1 }
    if clause_count != 4 { return 0 - 1 }
    if var_count != 3 { return 0 - 1 }
    if c1 != 1 { return 0 - 1 }
    if c2 != 1 { return 0 - 1 }
    if c3 != 1 { return 0 - 1 }
    if c4 != 1 { return 0 - 1 }
    if formula_ok != 1 { return 0 - 1 }

    var fp: i64 = 167
    fp = model_mix(fp, formula_fp, 1439)
    fp = model_mix(fp, model_fp, 1439)
    fp = model_mix(fp, clause_count, 1439)
    fp = model_mix(fp, var_count, 1439)
    fp = model_mix(fp, c1, 1439)
    fp = model_mix(fp, c2, 1439)
    fp = model_mix(fp, c3, 1439)
    fp = model_mix(fp, c4, 1439)
    fp = model_mix(fp, formula_ok, 1439)
    return fp
}

fn main() -> i64 {
    let ax: i64 = 1
    let ay: i64 = 0
    let az: i64 = 1
    let c1 = clause_satisfied(1, ax, ay, az)
    let c2 = clause_satisfied(2, ax, ay, az)
    let c3 = clause_satisfied(3, ax, ay, az)
    let c4 = clause_satisfied(4, ax, ay, az)
    let formula_ok = formula_satisfied(4, ax, ay, az)
    let formula_fp = sat_model_formula_fingerprint()
    let model_fp = sat_model_assignment_fingerprint(ax, ay, az)
    let cert_fp = sat_model_certificate_fingerprint(formula_fp, model_fp, 4, 3,
                                                    c1, c2, c3, c4, formula_ok)

    if c1 != 1 { return 1 }
    if c2 != 1 { return 2 }
    if c3 != 1 { return 3 }
    if c4 != 1 { return 4 }
    if formula_ok != 1 { return 5 }
    if clause_satisfied(5, ax, ay, az) != 0 { return 6 }
    if clause_shape_valid(6) != 0 { return 7 }
    if clause_shape_valid(7) != 0 { return 8 }
    if formula_satisfied(4, 0, 0, 1) != 0 { return 9 }
    if formula_fp != 620950027 { return 10 }
    if model_fp != 904583820 { return 11 }
    if cert_fp != 701650234 { return 12 }
    if sat_model_certificate_fingerprint(formula_fp + 1, model_fp, 4, 3, c1, c2, c3, c4, formula_ok) != (0 - 1) { return 13 }
    if sat_model_certificate_fingerprint(formula_fp, sat_model_assignment_fingerprint(0, 0, 1), 4, 3, c1, c2, c3, c4, formula_ok) != (0 - 1) { return 14 }
    if sat_model_certificate_fingerprint(formula_fp, model_fp, 4, 3, c1, c2, c3, 0, formula_ok) != (0 - 1) { return 15 }
    return 0
}
