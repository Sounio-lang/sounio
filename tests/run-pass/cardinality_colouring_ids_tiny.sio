//@ run-pass
//@ requires: madaros
//@ description: Tiny graph-colouring cardinality proof-log ID/literal smoke

fn card_exactly_one_clause_count(n: i64) -> i64 {
    if n <= 0 { return 0 }
    return 1 + (n * (n - 1)) / 2
}

fn card_var(slot: i64) -> i64 {
    return slot + 1
}

fn card_lit_abs(lit: i64) -> i64 {
    if lit < 0 { return 0 - lit }
    return lit
}

fn card_exactly_one_clause_len(n: i64, clause_id: i64) -> i64 {
    if n <= 0 { return 0 }
    if clause_id == 1 { return n }
    if clause_id >= 2 {
        if clause_id <= card_exactly_one_clause_count(n) { return 2 }
    }
    return 0
}

fn card_exactly_one_lit(n: i64, clause_id: i64, pos: i64) -> i64 {
    if n <= 0 { return 0 }
    if clause_id == 1 {
        if pos < 0 { return 0 }
        if pos >= n { return 0 }
        return card_var(pos)
    }
    if pos < 0 { return 0 }
    if pos >= 2 { return 0 }

    var id: i64 = 2
    var i: i64 = 0
    while i < n {
        var j: i64 = i + 1
        while j < n {
            if id == clause_id {
                if pos == 0 { return 0 - card_var(i) }
                return 0 - card_var(j)
            }
            id = id + 1
            j = j + 1
        }
        i = i + 1
    }
    return 0
}

fn card_colour_var(vertex: i64, colour_count: i64, colour: i64) -> i64 {
    if vertex < 0 { return 0 }
    if colour_count <= 0 { return 0 }
    if colour < 0 { return 0 }
    if colour >= colour_count { return 0 }
    return vertex * colour_count + colour + 1
}

fn card_colour_vertex_clause_count(colour_count: i64) -> i64 {
    return card_exactly_one_clause_count(colour_count)
}

fn card_colour_vertex_clause_id(vertex: i64, colour_count: i64, local_clause_id: i64) -> i64 {
    if vertex < 0 { return 0 - 1 }
    let per_vertex = card_colour_vertex_clause_count(colour_count)
    if per_vertex <= 0 { return 0 - 1 }
    if local_clause_id < 1 { return 0 - 1 }
    if local_clause_id > per_vertex { return 0 - 1 }
    return vertex * per_vertex + local_clause_id
}

fn card_colour_vertex_lit(vertex: i64, colour_count: i64, local_clause_id: i64, pos: i64) -> i64 {
    if vertex < 0 { return 0 }
    let local = card_exactly_one_lit(colour_count, local_clause_id, pos)
    if local == 0 { return 0 }
    let v = card_lit_abs(local)
    if v <= 0 { return 0 }
    let colour = v - 1
    let global = card_colour_var(vertex, colour_count, colour)
    if global == 0 { return 0 }
    if local < 0 { return 0 - global }
    return global
}

fn card_colour_edge_base_id(vertex_count: i64, colour_count: i64) -> i64 {
    if vertex_count < 0 { return 0 - 1 }
    let per_vertex = card_colour_vertex_clause_count(colour_count)
    if per_vertex <= 0 { return 0 - 1 }
    return vertex_count * per_vertex + 1
}

fn card_colour_edge_clause_id(vertex_count: i64, colour_count: i64, edge_index: i64, colour: i64) -> i64 {
    if edge_index < 0 { return 0 - 1 }
    if colour < 0 { return 0 - 1 }
    if colour >= colour_count { return 0 - 1 }
    let base = card_colour_edge_base_id(vertex_count, colour_count)
    if base < 1 { return 0 - 1 }
    return base + edge_index * colour_count + colour
}

fn card_colour_edge_lit(u: i64, v: i64, colour_count: i64, colour: i64, pos: i64) -> i64 {
    if u < 0 { return 0 }
    if v < 0 { return 0 }
    if u == v { return 0 }
    if pos == 0 {
        let vu = card_colour_var(u, colour_count, colour)
        if vu == 0 { return 0 }
        return 0 - vu
    }
    if pos == 1 {
        let vv = card_colour_var(v, colour_count, colour)
        if vv == 0 { return 0 }
        return 0 - vv
    }
    return 0
}

fn card_colour_edge_verify_conflict(u: i64, v: i64, colour_count: i64, colour: i64, lit_u: i64, lit_v: i64) -> i64 {
    if lit_u <= 0 { return 0 }
    if lit_v <= 0 { return 0 }
    let c0 = card_colour_edge_lit(u, v, colour_count, colour, 0)
    let c1 = card_colour_edge_lit(u, v, colour_count, colour, 1)
    if c0 + lit_u == 0 {
        if c1 + lit_v == 0 { return 1 }
    }
    if c0 + lit_v == 0 {
        if c1 + lit_u == 0 { return 1 }
    }
    return 0
}

fn main() -> i64 {
    let k: i64 = 3
    if card_colour_var(0, k, 0) != 1 { return 1 }
    if card_colour_var(0, k, 2) != 3 { return 2 }
    if card_colour_var(1, k, 0) != 4 { return 3 }
    if card_colour_var(1, k, 2) != 6 { return 4 }

    if card_colour_vertex_clause_count(k) != 4 { return 5 }
    if card_colour_vertex_clause_id(0, k, 1) != 1 { return 6 }
    if card_colour_vertex_clause_id(0, k, 4) != 4 { return 7 }
    if card_colour_vertex_clause_id(1, k, 1) != 5 { return 8 }
    if card_colour_vertex_clause_id(1, k, 4) != 8 { return 9 }

    if card_colour_vertex_lit(1, k, 1, 0) != 4 { return 10 }
    if card_colour_vertex_lit(1, k, 1, 2) != 6 { return 11 }
    if card_colour_vertex_lit(1, k, 4, 0) != (0 - 5) { return 12 }
    if card_colour_vertex_lit(1, k, 4, 1) != (0 - 6) { return 13 }

    if card_colour_edge_base_id(2, k) != 9 { return 14 }
    if card_colour_edge_clause_id(2, k, 0, 0) != 9 { return 15 }
    if card_colour_edge_clause_id(2, k, 0, 2) != 11 { return 16 }
    if card_colour_edge_lit(0, 1, k, 2, 0) != (0 - 3) { return 17 }
    if card_colour_edge_lit(0, 1, k, 2, 1) != (0 - 6) { return 18 }

    if card_colour_edge_verify_conflict(0, 1, k, 2, 3, 6) != 1 { return 19 }
    if card_colour_edge_verify_conflict(0, 1, k, 2, 3, 5) != 0 { return 20 }
    if card_colour_edge_verify_conflict(0, 0, k, 2, 3, 3) != 0 { return 21 }
    if card_colour_edge_clause_id(2, k, 0, 3) != (0 - 1) { return 22 }

    return 0
}
