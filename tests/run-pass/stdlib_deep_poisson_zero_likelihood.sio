//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: STDLIB_DEEP_POISSON_ZERO_LIKELIHOOD_PASS
use stats::regression::nb2_likelihood::{nb2_likelihood_slot,nb2_log_probability_into,nb2_likelihood_snapshot,nb2_likelihood_slot_log_probability,nb2_likelihood_slot_status,nb2_likelihood_slot_normalizer_status,nb2_likelihood_slot_residual_status,nb2_likelihood_slot_deviance_status,nb2_likelihood_slot_poisson_limit}
fn check_zero(i:i64,mean:f64) with IO,Mut,Div,Panic {
 var slot=nb2_likelihood_slot()
 assert(nb2_log_probability_into(0,mean,0.0,&!slot)==0)
 let actual:f64=nb2_likelihood_slot_log_probability(&slot)
 let mean_bits:i64=f64_to_bits(mean)
 let want_bits:i64=(mean_bits-9223372036854775807)-1
 assert(f64_to_bits(actual)==want_bits)
 assert(nb2_likelihood_slot_status(&slot)==0)
 assert(nb2_likelihood_slot_normalizer_status(&slot)==0)
 assert(nb2_likelihood_slot_residual_status(&slot)==0)
 assert(nb2_likelihood_slot_poisson_limit(&slot))
 let saved=nb2_likelihood_snapshot(&slot)
 assert(saved.status==0 && saved.count==0 && saved.poisson_limit)
 assert(!saved.assumptions_assessed && !saved.stirling_used)
 assert(saved.saturated_log_probability==0.0)
 assert(f64_to_bits(saved.log_probability)==want_bits)
 let dstatus:i64=nb2_likelihood_slot_deviance_status(&slot)
 if i==9 {assert(dstatus==1);assert(saved.deviance==0.0)} else {assert(dstatus==0)}
 let actual_bits:i64=f64_to_bits(actual)
 let status:i64=saved.status
 let normalizer:i64=saved.normalizer_status
 let residual:i64=saved.residual_status
 let poisson_flag:bool=saved.poisson_limit
 print("P0 ");print(i);print(" ");print(mean_bits);print(" ");print(actual_bits);print(" ");print(status);print(" ");print(normalizer);print(" ");print(residual);print(" ");print(dstatus);print(" ")
 if poisson_flag {print("true")} else {print("false")}
 println("")
 // Reuse and fail after snapshot: the detached snapshot must preserve exact bits.
 assert(nb2_log_probability_into(-1,mean,0.0,&!slot)==1)
 assert(nb2_likelihood_slot_log_probability(&slot)==0.0)
 assert(f64_to_bits(saved.log_probability)==want_bits)
 assert(nb2_log_probability_into(0,mean,-0.0,&!slot)==0)
 assert(f64_to_bits(nb2_likelihood_slot_log_probability(&slot))==want_bits)
}
fn main()->i32 with IO,Mut,Div,Panic {
 let minimum:f64=2.2250738585072014e-308/4503599627370496.0
 assert(f64_to_bits(minimum)==1)
 check_zero(0,minimum)
 check_zero(1,minimum*2.0)
 check_zero(2,2.2250738585072014e-308)
 check_zero(3,0.125)
 check_zero(4,0.5)
 check_zero(5,1.0)
 check_zero(6,2.0)
 check_zero(7,10.0)
 var large:f64=1.0
 var i:i64=0
 while i<512 {large=large*2.0;i=i+1}
 check_zero(8,large)
 check_zero(9,1.7976931348623157e308)
 var bad=nb2_likelihood_slot()
 assert(nb2_log_probability_into(-1,0.0,-1.0,&!bad)==1)
 assert(nb2_log_probability_into(0,0.0,-1.0,&!bad)==2)
 assert(nb2_log_probability_into(0,1.0,-1.0,&!bad)==3)
 assert(nb2_log_probability_into(9007199254740993,1.0,0.0,&!bad)==4)
 assert(!nb2_likelihood_slot_poisson_limit(&bad))
 assert(nb2_likelihood_slot_log_probability(&bad)==0.0)
 println("STDLIB_DEEP_POISSON_ZERO_LIKELIHOOD_PASS")
 return 0
}
