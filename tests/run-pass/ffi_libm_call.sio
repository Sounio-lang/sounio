//@ run-pass
// FFI test: call libm functions via extern "C" bindings

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn sin(x: f64) -> f64;
    fn cos(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn log(x: f64) -> f64;
    fn fabs(x: f64) -> f64;
    fn floor(x: f64) -> f64;
    fn ceil(x: f64) -> f64;
    fn pow(x: f64, y: f64) -> f64;
    fn tgamma(x: f64) -> f64;
}

fn approx_eq(a: f64, b: f64, eps: f64) -> bool {
    let diff = a - b
    if diff < 0.0 {
        return (0.0 - diff) < eps
    }
    diff < eps
}

fn check_sqrt() -> i64 with IO {
    let s = sqrt(25.0)
    if approx_eq(s, 5.0, 0.0001) { 0 } else { 1 }
}

fn check_tgamma() -> i64 with IO {
    let g = tgamma(5.0)
    if approx_eq(g, 24.0, 0.001) { 0 } else { 10 }
}

fn check_pow() -> i64 with IO {
    let p = pow(2.0, 10.0)
    if approx_eq(p, 1024.0, 0.001) { 0 } else { 100 }
}

fn check_floor() -> i64 with IO {
    let f = floor(3.7)
    if approx_eq(f, 3.0, 0.0001) { 0 } else { 1000 }
}

fn check_ceil() -> i64 with IO {
    let c = ceil(3.2)
    if approx_eq(c, 4.0, 0.0001) { 0 } else { 10000 }
}

fn main() -> i64 with IO {
    // Return 0 if all FFI calls produce correct results.
    // Non-zero encodes which function failed (1=sqrt, 10=tgamma, etc.)
    check_sqrt() + check_tgamma() + check_pow() + check_floor() + check_ceil()
}
