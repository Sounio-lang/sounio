//@ run-pass
// FFI test: call libm functions via extern "C" bindings
// Validates: extern symbol PLT resolution, -lm linking, f64 calling convention

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn tgamma(x: f64) -> f64;
    fn pow(x: f64, y: f64) -> f64;
    fn floor(x: f64) -> f64;
    fn ceil(x: f64) -> f64;
}

fn approx_eq(a: f64, b: f64, eps: f64) -> bool {
    let diff = a - b
    if diff < 0.0 {
        return (0.0 - diff) < eps
    }
    diff < eps
}

fn main() -> i64 with IO {
    // Verify sqrt(25.0) = 5.0 via integer truncation
    // This exercises: PLT call, xmm0 arg passing, xmm0 return
    let s = sqrt(25.0)
    let s_int = s as i64
    // s_int should be 5 if FFI call worked, 0 or garbage otherwise
    if s_int == 5 { 0 } else { s_int }
}
