    audit_fp = mix(audit_fp, 149302752, 6073)
    audit_fp = mix(audit_fp, 253587342, 6073)
    audit_fp = mix(audit_fp, 537357117, 6073)
    audit_fp = mix(audit_fp, 2, 6073)
    audit_fp = mix(audit_fp, 15, 6073)
    audit_fp = mix(audit_fp, 255, 6073)
    if audit_fp != 927005854 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 129, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
