    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 126, 1151)
    manifest_fp = mix(manifest_fp, 130, 1151)
    manifest_fp = mix(manifest_fp, 474619438, 1151)
    manifest_fp = mix(manifest_fp, 487184792, 1151)
    manifest_fp = mix(manifest_fp, 826067971, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 98914593 { return 4 }

    var result_fp: i64 = 131
