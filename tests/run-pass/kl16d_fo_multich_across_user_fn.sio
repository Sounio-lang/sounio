//@ run-pass
// KL-16d: inter-procedural FO across channels 0..1 (and 1–7 plumbing) on
// lean_single user f64→f64 fns. Seed-only pin via
// scripts/ci/lean_single_kl16d_interproc_multich_gate.sh — no Madaros sabotage.

fn add(a: f64, b: f64) -> f64 { a + b }

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Epistemic, Mut, Div {
    let xm: Knowledge<f64> = measure(2.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let x = xm.value
    let y = ym.value

    // MEAS_KNOW_IDX assigns ch0 to x and ch1 to y; add must carry both
    // across the call boundary (KL-16c only shipped ch0).
    let s0 = sensitivity_of(add(x, y), 0)
    let s1 = sensitivity_of(add(x, y), 1)

    println(s0)
    println(s1)

    let ok = abs_f(s0 - 1.0) < 1.0e-9
        && abs_f(s1 - 1.0) < 1.0e-9
    if ok {
        print("KL16D_FO_MULTICH_ACROSS_USER_FN_PASS\n")
    } else {
        print("KL16D_FO_MULTICH_ACROSS_USER_FN_FAIL\n")
    }
}
