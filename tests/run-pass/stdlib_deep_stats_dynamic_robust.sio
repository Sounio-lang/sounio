//@ run-pass
//@ requires: madaros
//@ timeout: 120
//@ expect-stdout: DEEP DYNAMIC ROBUST PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_at,numeric_buffer_set,numeric_buffer_close,numeric_matrix}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
use stats::regression::dynamic_robust_covariance::{dynamic_robust_workspace,dynamic_linear_hc3,dynamic_linear_cluster}
use io::sci_print::{println_f64_sci}
fn robust_case(kind:i64) with Alloc,IO,Mut,Div,Panic {
 let n:i64=516
 let p:i64=12
 let query=dynamic_robust_workspace(n,p)
 assert(query.status==0)
 let stride:i64=if kind==8 {p+3}else{p}
 let offset:i64=if kind==8 {1}else{0}
 let elements:i64=offset+n*stride
 var a=numeric_buffer_new(elements,elements*8)
 var y=numeric_buffer_new(n,n*8)
 var ids=integer_buffer_new(n,n*8)
 var beta=numeric_buffer_new(p,p*8)
 var covariance=numeric_buffer_new(p*p,p*p*8)
 var se=numeric_buffer_new(p,p*8)
 var leverage=numeric_buffer_new(n,n*8)
 var work=numeric_buffer_new(query.numeric_elements,query.numeric_elements*8)
 var order=integer_buffer_new(query.integer_elements,query.integer_elements*8)
 let layout=numeric_matrix(elements,n,p,stride,1,offset)
 var i:i64=0
 while i<n {
  let original=if kind==5 {n-1-i}else{i}
  let group=original/43
  let within=original%43
  let column=if kind==4 {p-1-group}else{group}
  let scale:f64=if kind==3 {if group%2==0 {1e75}else{1e-75}}else{1.0}
  numeric_buffer_set(&!a,offset+i*stride+column,scale)
  let response:f64=if kind==7 {0.0}else{((group+1)*10+(within%5)-2) as f64+((within%3) as f64)*0.25}
  numeric_buffer_set(&!y,i,response)
  let label:i64=if kind==6 {original}else{(within%7)*1000000007-3000000021}
  integer_buffer_set(&!ids,i,label)
  i=i+1
 }
 let method:i64=if kind==2 || kind==4 {1}else{0}
 let result=if kind==0 || kind==3 || kind==7 {
  dynamic_linear_hc3(&a,&layout,&y,0.0,&!beta,&!covariance,&!se,&!leverage,&!work,&!order)
 }else{
  dynamic_linear_cluster(&a,&layout,&y,&ids,method,0.0,&!beta,&!covariance,&!se,&!leverage,&!work,&!order)
 }
 let fit_status:i64=result.fit.status
 let status:i64=result.covariance_status
 let groups:i64=result.clusters
 let factor:f64=result.correction_factor
 print("dynamic robust trace kind: ");println(kind)
 print("dynamic robust trace fit: ");println(fit_status)
 print("dynamic robust trace covariance: ");println(status)
 assert(fit_status==0 && status==0)
 assert(!result.assumptions_assessed && !result.finite_sample_calibrated)
 print("dynamic robust case: ");println(kind)
 print("dynamic robust groups: ");println(groups)
 print("dynamic robust factor: ");println_f64_sci(factor,15)
 var j:i64=0
 while j<p {
  let coefficient:f64=numeric_buffer_at(&beta,j)
  let standard_error:f64=numeric_buffer_at(&se,j)
  print("dynamic robust beta: ");println_f64_sci(coefficient,15)
  print("dynamic robust se: ");println_f64_sci(standard_error,15)
  j=j+1
 }
 j=0
 while j<p*p {
  let value:f64=numeric_buffer_at(&covariance,j)
  print("dynamic robust covariance: ");println_f64_sci(value,15)
  j=j+1
 }
 i=0
 while i<n {
  let h:f64=numeric_buffer_at(&leverage,i)
  assert(h>0.0 && h<1.0)
  assert(if h>1.0/43.0 {h-1.0/43.0<1e-12}else{1.0/43.0-h<1e-12})
  i=i+1
 }
 numeric_buffer_close(a)
 numeric_buffer_close(y)
 integer_buffer_close(ids)
 numeric_buffer_close(beta)
 numeric_buffer_close(covariance)
 numeric_buffer_close(se)
 numeric_buffer_close(leverage)
 numeric_buffer_close(work)
 integer_buffer_close(order)
}
fn main()->i32 with Alloc,IO,Mut,Div,Panic {
 var kind:i64=0
 while kind<9 {robust_case(kind);kind=kind+1}
 println("DEEP DYNAMIC ROBUST PASS")
 0
}
