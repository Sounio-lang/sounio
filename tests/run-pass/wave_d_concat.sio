//@ run-pass
// Wave D: ++ concatenation for strings and arrays

fn main() -> i32 with IO {
    // String concatenation
    let greeting = "Hello" ++ ", " ++ "World!"
    println(greeting)

    // Array concatenation
    var A: [i64; 3] = [0; 3]
    A[0] = 10; A[1] = 20; A[2] = 30
    var B: [i64; 2] = [0; 2]
    B[0] = 50; B[1] = 60
    let C = A ++ B
    print_int(C[0])
    print_int(C[1])
    print_int(C[2])
    print_int(C[3])
    print_int(C[4])
    0
}
