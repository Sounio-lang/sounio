//@ run-pass
//@ expect-stdout: complex hierarchy OK

// Test: deep and branching hierarchy with multiple subclass_of paths.

ontology Taxonomy {
    class LivingThing
    class Animal subclass_of LivingThing
    class Plant subclass_of LivingThing
    class Mammal subclass_of Animal
    class Reptile subclass_of Animal
    class Dog subclass_of Mammal
    class Cat subclass_of Mammal
    class Snake subclass_of Reptile
    disjoint Animal, Plant
}

fn handle_animal(a: Animal) -> i32 with IO {
    println("animal handled")
    1
}

fn handle_mammal(m: Mammal) -> i32 with IO {
    println("mammal handled")
    2
}

fn handle_dog(d: Dog) -> i32 with IO {
    println("dog handled")
    3
}

fn main() -> i32 with IO {
    let d: Dog = make_dog()
    // Dog ⊂ Mammal ⊂ Animal — all three calls should compile
    handle_dog(d)
    handle_mammal(d)
    handle_animal(d)
    println("complex hierarchy OK")
    0
}

fn make_dog() -> Dog { 0 as Dog }
