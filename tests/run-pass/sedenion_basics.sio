//@ run-pass
// Sedenion module smoke test: multiplication table sanity and the
// canonical primitive zero-divisor identity sed_mul(z, w) = 0.

use algebra::sedenion::{
    sed_zero, sed_basis, sed_from_pair, sed_mul, sed_associator,
    sed_norm_sq, sed_l1_norm, sed_canonical_zd_z, sed_canonical_zd_w
}

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn check_unit_identity() -> bool with Mut, Div, Panic {
    // e_0 is the real unit: e_0 * e_3 = e_3.
    var e0: [f64; 16] = [0.0; 16]
    var e3: [f64; 16] = [0.0; 16]
    var prod: [f64; 16] = [0.0; 16]
    sed_basis(0, &!e0)
    sed_basis(3, &!e3)
    sed_mul(&e0, &e3, &!prod)
    abs_f64(prod[3] - 1.0) < 1.0e-12
}

fn check_basis_squares_minus_one() -> bool with Mut, Div, Panic {
    // e_i * e_i = -e_0 for i in 1..15.
    var ei: [f64; 16] = [0.0; 16]
    var prod: [f64; 16] = [0.0; 16]
    var i: i64 = 1
    while i < 16 {
        sed_basis(i, &!ei)
        sed_mul(&ei, &ei, &!prod)
        if abs_f64(prod[0] + 1.0) > 1.0e-12 { return false }
        i = i + 1
    }
    true
}

fn check_canonical_zero_divisor() -> bool with Mut, Div, Panic {
    // (e_3 + e_10) * (e_6 − e_15) = 0  (de Marrais 2000).
    var z: [f64; 16] = [0.0; 16]
    var w: [f64; 16] = [0.0; 16]
    var prod: [f64; 16] = [0.0; 16]
    sed_canonical_zd_z(&!z)
    sed_canonical_zd_w(&!w)
    sed_mul(&z, &w, &!prod)
    let n2 = sed_norm_sq(&prod)
    n2 < 1.0e-20
}

fn check_flexibility() -> bool with Mut, Div, Panic {
    // Every CD algebra is flexible: [x, y, x] = 0 for all x, y.
    // Pick two generic basis elements to witness.
    var x: [f64; 16] = [0.0; 16]
    var y: [f64; 16] = [0.0; 16]
    var assoc: [f64; 16] = [0.0; 16]
    sed_basis(5, &!x)
    sed_basis(11, &!y)
    sed_associator(&x, &y, &x, &!assoc)
    sed_norm_sq(&assoc) < 1.0e-20
}

fn check_l1_norm_nonzero() -> bool with Mut, Div, Panic {
    // A non-alternative triple mixing the two CD halves has non-zero
    // associator L1 mass — the substrate of v3 F_3.
    var eI: [f64; 16] = [0.0; 16]
    var eJ: [f64; 16] = [0.0; 16]
    var eK: [f64; 16] = [0.0; 16]
    var assoc: [f64; 16] = [0.0; 16]
    sed_basis(1, &!eI)
    sed_basis(10, &!eJ)   // j=2, lifted to 8+2=10
    sed_basis(4, &!eK)
    sed_associator(&eI, &eJ, &eK, &!assoc)
    sed_l1_norm(&assoc) > 0.0
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let a = check_unit_identity()
    let b = check_basis_squares_minus_one()
    let c = check_canonical_zero_divisor()
    let d = check_flexibility()
    let e = check_l1_norm_nonzero()
    if a && b && c && d && e {
        println("sedenion ALL PASS")
        0
    } else {
        println("sedenion FAIL")
        1
    }
}
