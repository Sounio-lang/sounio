//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_SLOT_FIELD_ACCESS_METHOD_AND_LIT_BASE PASS
//
// Copilot review (PR #2516), finding B on the third review round:
// expr_is_tuple_slot_f64_array_ref (self-hosted/ir/lower.sio) only special-
// cased ExprIdent and ExprCall bases for a direct tuple-slot field access
// (`base.0`), falling straight through to `false` for any other base kind
// -- even though expr_result_tuple_arr_mask_ref (extended in an earlier
// round of this same review) already knows how to classify ExprMethodCall
// and ExprTupleLit bases too. So `p.pair().0` (base is a method call) and
// `([x; 2], [y; 2]).0` (base is a tuple literal) both fell back to the
// integer-element path even with no intervening `let` binding at all.
struct Pairer {
    scale: f64,
}

impl Pairer {
    fn pair(self) -> ([f64; 2], [f64; 2]) with Mut, Panic {
        var a: [f64; 2] = [0.0; 2]
        var b: [f64; 2] = [0.0; 2]
        a[0] = 1.5 * self.scale
        b[0] = 4.5
        (a, b)
    }
}

fn main() -> i32 with IO, Mut, Panic {
    let p = Pairer { scale: 1.0 }
    // Direct field access on a METHOD CALL base, no intervening `let (a,b)=`.
    let a = p.pair().0
    let s0: f64 = a[0] * 2.0

    // Direct field access on a TUPLE LITERAL base built from f64 locals.
    let x: f64 = 2.5
    let y: f64 = 0.5
    let lit_slot = ([x; 2], [y; 2]).0
    let s1: f64 = lit_slot[0] * 2.0

    if s0 == 3.0 && s1 == 5.0 {
        println("TUPLE_SLOT_FIELD_ACCESS_METHOD_AND_LIT_BASE PASS")
        return 0
    }
    1
}
