//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: STDLIB_DEEP_NB2_LIKELIHOOD_SCRATCH_PASS
use stats::regression::nb2_likelihood::{nb2_likelihood_slot,nb2_log_probability_into,nb2_likelihood_snapshot,nb2_likelihood_slot_status,nb2_likelihood_slot_log_probability,nb2_likelihood_slot_normalizer_status,nb2_likelihood_slot_stirling_used,nb2_likelihood_slot_remainder_estimate_available,nb2_likelihood_slot_residual_status}
fn scratch_abs(x:f64)->f64 {if x<0.0 {-x}else{x}}
fn main()->i32 with IO,Mut,Div,Panic {
 var slot=nb2_likelihood_slot()
 assert(nb2_log_probability_into(1,1.0,1.0,&!slot)==0)
 let saved=nb2_likelihood_snapshot(&slot)
 assert(saved.status==0 && saved.normalizer_status==0)
 assert(scratch_abs(saved.log_probability+1.3862943611198906)<2e-14)
 // Exercise both Stirling normalizer branches before returning to small-count sums.
 assert(nb2_log_probability_into(8,8.0,0.0625,&!slot)==0)
 assert(nb2_likelihood_slot_stirling_used(&slot))
 assert(nb2_log_probability_into(100,100.0,1.0,&!slot)==0)
 assert(nb2_likelihood_slot_stirling_used(&slot))
 assert(nb2_log_probability_into(1,0.0,1.0,&!slot)==2)
 assert(nb2_likelihood_slot_status(&slot)==2)
 assert(nb2_likelihood_slot_normalizer_status(&slot)==2)
 assert(nb2_likelihood_slot_residual_status(&slot)==2)
 assert(!nb2_likelihood_slot_stirling_used(&slot))
 assert(!nb2_likelihood_slot_remainder_estimate_available(&slot))
 assert(nb2_likelihood_slot_log_probability(&slot)==0.0)
 assert(saved.status==0 && scratch_abs(saved.log_probability+1.3862943611198906)<2e-14)
 // NB2(mean1,alpha1) is geometric: P(k)=2^(-k-1). This closed form
 // checks factorial/ratio/log scratch reuse without mirroring those algorithms.
 var i:i64=0
 while i<20000 {
  let count=i%8
  assert(nb2_log_probability_into(count,1.0,1.0,&!slot)==0)
  let actual:f64=nb2_likelihood_slot_log_probability(&slot)
  let expected= -((count+1) as f64)*0.6931471805599453
  assert(scratch_abs(actual-expected)<2e-14)
  assert(nb2_likelihood_slot_normalizer_status(&slot)==0)
  i=i+1
 }
 assert(nb2_log_probability_into(0,2.0,0.0,&!slot)==0)
 assert(nb2_likelihood_slot_log_probability(&slot)== -2.0)
 assert(saved.status==0 && scratch_abs(saved.log_probability+1.3862943611198906)<2e-14)
 println("STDLIB_DEEP_NB2_LIKELIHOOD_SCRATCH_PASS")
 return 0
}
