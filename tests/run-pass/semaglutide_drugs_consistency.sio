//@ run-pass
//@ expect-stdout-contains: SEMAGLUTIDE_DRUGS_CONSISTENCY_PASS

// Consistency test for stdlib/darwin_pbpk/drugs/semaglutide.sio.
//
// The drug-identity module must forward the canonical numbers, never
// redefine them: dosing vs scenarios/semaglutide_sc_depot.sio, organ
// parameters vs core/pbpk28_params.sio. Guards the no-duplication
// boundary (single source of truth stays in core/epistemic modules).

use darwin_pbpk::drugs::semaglutide::*
use darwin_pbpk::scenarios::semaglutide_sc_depot::*
use darwin_pbpk::core::pbpk28_params::*

fn main() -> i64 with IO, Mut {
    var exit_fails = 0

    // Dosing: 1 mg weekly, ka = ln(2)/60 h, F = 0.89 (Overgaard 2019).
    if semaglutide_dose_mg_weekly() != sema_dose_mg() {
        print("FAIL: weekly dose mismatch\n")
        exit_fails = exit_fails + 1
    }
    if semaglutide_ka_sc() != sema_ka() {
        print("FAIL: ka_sc mismatch\n")
        exit_fails = exit_fails + 1
    }
    if semaglutide_f_sc() != sema_f() {
        print("FAIL: f_sc mismatch\n")
        exit_fails = exit_fails + 1
    }

    // Proteolytic clearance forwarded to the PBPK28 bundle.
    let prm = semaglutide_pbpk28_params()
    if semaglutide_cl_proteolytic() != prm.cl_central {
        print("FAIL: cl_proteolytic mismatch vs PBPKParams28\n")
        exit_fails = exit_fails + 1
    }
    if prm.cl_central != 0.077 {
        print("FAIL: cl_central drift vs Overgaard 2019 value\n")
        exit_fails = exit_fails + 1
    }

    // Chemical identity: ChEBI:90816, GO:0008152.
    if semaglutide_chebi_id() != 90816 {
        print("FAIL: chebi id mismatch\n")
        exit_fails = exit_fails + 1
    }
    if semaglutide_clearance_process_id() != 8152 {
        print("FAIL: clearance process id mismatch\n")
        exit_fails = exit_fails + 1
    }

    // Unbound fraction: 99% albumin-bound (Tougaard 2022).
    if semaglutide_fu_plasma() != 0.010 {
        print("FAIL: fu_plasma mismatch\n")
        exit_fails = exit_fails + 1
    }

    println("SEMAGLUTIDE_DRUGS_CONSISTENCY_PASS")
    if exit_fails > 0 {
        return 1
    }
    return 0
}
