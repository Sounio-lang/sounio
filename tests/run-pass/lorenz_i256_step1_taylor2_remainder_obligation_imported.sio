//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-1 Taylor-2 remainder obligation smoke

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step1_taylor2_remainder_obligation_check(
        35000, 45000, 10000, 0)
    if artifact_fp != 265853299 { return 1 }
    let audit_fp = lorenz_i256_step1_taylor2_remainder_obligation_audit_fingerprint(
        artifact_fp, 340568604, 273027742, 496675613, 472667880,
        133154696, 1, 5, 127, 0, 0)
    if audit_fp != 919608627 { return 2 }
    return 0
}
