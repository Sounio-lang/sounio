//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: measure direct: PASS
//@ expect-stdout-contains: measure via helper: PASS
//@ description: P1.4 -- a private user fn named `measure` shadows the epistemic builtin in its module (was E001/E008 "expected Knowledge")

fn measure(x: i32) -> i32 { x * 2 }

fn twice_measured(x: i32) -> i32 { measure(x) }

fn main() with IO {
    let y: i32 = measure(21)
    if y == 42 { print("measure direct: PASS\n") } else { print("measure direct: FAIL\n") }
    if twice_measured(10) == 20 { print("measure via helper: PASS\n") } else { print("measure via helper: FAIL\n") }
}
