//@ run-pass
// Per-state feature smoke test for F_1 / F_2 / F_3 (prereg v3).
// Sanity-only: numeric values against the Python reference are
// validated in the dry-run integration stage, not here.

use algebra::features::{
    f1_state_contribution, f2_state_contribution, f3_state_contribution
}

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i32 with IO, Mut, Div, Panic {
    // Pure real octonion: all associators involve e_0, so every basis
    // associator [e_i, e_j, e_k] with i,j,k in 1..7 has coefficient
    // h_0[i]*h_0[j]*h_0[k] = 0. Hence F_1 must be exactly 0.
    var real_only: [f64; 8] = [0.0; 8]
    real_only[0] = 1.0
    let f1_real = f1_state_contribution(&real_only)

    // Generic octonion with non-zero imaginary mass should give F_1 > 0.
    var h: [f64; 8] = [0.0; 8]
    h[0] = 0.5
    h[1] = 0.3
    h[2] = 0.7
    h[4] = 0.4
    let f1_generic = f1_state_contribution(&h)

    // F_2 with zero state is 0 over eps; must be finite and >= 0.
    var zero8: [f64; 8] = [0.0; 8]
    let f2_zero = f2_state_contribution(&zero8, &zero8)

    // F_2 for the canonical zero-divisor itself, viewed as a sedenion
    // via (h_0, h_1) = (e_3, e_2)  (so s has mass at indices 3 and 10,
    // matching sed_canonical_zd_z). ||s*z|| should be small relative
    // to ||s||² (z left-annihilates its paired partner, not itself,
    // but proximity is finite). Just check finiteness here.
    var h0: [f64; 8] = [0.0; 8]
    var h1: [f64; 8] = [0.0; 8]
    h0[3] = 1.0
    h1[2] = 1.0
    let f2_val = f2_state_contribution(&h0, &h1)

    // F_3 on a generic trajectory state must be > 0 (H3 rejects the
    // associative-subalgebra subset).
    var g0: [f64; 8] = [0.0; 8]
    var g1: [f64; 8] = [0.0; 8]
    g0[1] = 0.6
    g0[4] = 0.3
    g1[2] = 0.5
    g1[7] = 0.2
    let f3_val = f3_state_contribution(&g0, &g1)

    let ok1 = abs_f64(f1_real) < 1.0e-12
    let ok2 = f1_generic > 0.0
    let ok3 = f2_zero >= 0.0 && f2_zero < 1.0e-6
    let ok4 = f2_val >= 0.0
    let ok5 = f3_val > 0.0

    if ok1 && ok2 && ok3 && ok4 && ok5 {
        println("features ALL PASS")
        0
    } else {
        println("features FAIL")
        1
    }
}
