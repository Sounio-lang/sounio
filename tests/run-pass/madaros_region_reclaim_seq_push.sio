//@ run-pass
//@ requires: madaros
//@ expect-stdout: REGION_RECLAIM_SEQ_PUSH_OK
//@ description: non-growing Seq append must not escape an otherwise reclaimable helper region
// A Seq grows only logarithmically. The old unconditional youngest-store
// barrier nevertheless marked every helper invocation escaped, so the P
// allocation leaked one handle per append and crossed the 2^22 table limit.
// With the barrier on the actual growth edge, only growth calls escape; normal
// scalar appends leave P reclaimable.
// docs/audit/MADAROS_HANDLE_182_BBB_PER_CONSTRUCTION_DISPATCH_2026-09-26.md

struct P { a: i64, b: i64, c: i64 }

fn append_one(s: &!Seq<i64>, i: i64) -> i64 with Mut, Panic, Epistemic {
    let p = P { a: i, b: i + 1, c: i + 2 }
    s.push(i)
    p.a + p.b + p.c
}

fn main() -> i32 with IO, Mut, Panic, Epistemic {
    var s: Seq<i64> = seq_new()
    var checksum: i64 = 0
    var i: i64 = 0
    while i < 4300000 {
        checksum = checksum + append_one(&!s, i)
        i = i + 1
    }
    if s.count() != 4300000 { return 1 }
    if s.get(0) != 0 || s.get(4299999) != 4299999 { return 2 }
    if checksum <= 0 { return 3 }
    println("REGION_RECLAIM_SEQ_PUSH_OK")
    0
}
