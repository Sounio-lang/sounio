//@ run-pass
// Madaros residual: module-level global arrays passed by &! must mutate BSS.
// Direct GG[i] = v works; local arrays by &! work; global by &! used to write
// at BSS+object_header (ref_array path) while GG[i] still read BSS+0 → silent
// wrong result. See docs/audit/MADAROS_NATIVE_V2_F64_REMAINING_BUGS_2026-07-20.md
// Defect B. Expected bits of 5.0 = 4617315517961601024; of 7.0 = 4619567317775286272.

var GG_F64: [f64; 4] = [0.0; 4]
var GG_I64: [i64; 4] = [0; 4]

fn wr_f64(a: &![f64; 4]) with Mut {
    a[0] = 5.0
    a[3] = 7.0
}

fn wr_i64(a: &![i64; 4]) with Mut {
    a[0] = 5
    a[3] = 7
}

fn main() -> i32 with IO, Mut, Div, Panic {
    // Cross-fn call with &! global f64 array
    wr_f64(&!GG_F64)
    let b0 = f64_to_bits(GG_F64[0])
    let b3 = f64_to_bits(GG_F64[3])
    if b0 != 4617315517961601024 {
        print("FAIL f64[0] bits=")
        print_int(b0)
        print("\n")
        return 1
    }
    if b3 != 4619567317775286272 {
        print("FAIL f64[3] bits=")
        print_int(b3)
        print("\n")
        return 2
    }

    // Cross-fn call with &! global i64 array
    wr_i64(&!GG_I64)
    if GG_I64[0] != 5 {
        print("FAIL i64[0]=")
        print_int(GG_I64[0])
        print("\n")
        return 3
    }
    if GG_I64[3] != 7 {
        print("FAIL i64[3]=")
        print_int(GG_I64[3])
        print("\n")
        return 4
    }

    // Same-function alias form
    var A: [f64; 2] = [0.0; 2]
    // control: local ref still works
    var lp: &![f64; 2] = &!A
    lp[0] = 5.0
    if f64_to_bits(A[0]) != 4617315517961601024 {
        print("FAIL local alias\n")
        return 5
    }

    var gp: &![f64; 4] = &!GG_F64
    gp[1] = 5.0
    if f64_to_bits(GG_F64[1]) != 4617315517961601024 {
        print("FAIL global alias bits=")
        print_int(f64_to_bits(GG_F64[1]))
        print("\n")
        return 6
    }

    // Direct store still works after ref path
    GG_F64[2] = 5.0
    if f64_to_bits(GG_F64[2]) != 4617315517961601024 {
        print("FAIL direct store\n")
        return 7
    }

    print("GLOBAL_ARRAY_REF_MUT_OK\n")
    0
}
