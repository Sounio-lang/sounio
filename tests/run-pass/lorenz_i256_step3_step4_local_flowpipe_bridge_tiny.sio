//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-3-to-step-4 local-flowpipe bridge keeps global claim closed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    let proof_mask: i64 = 15
    let seed_mask: i64 = 15
    let chain_mask: i64 = 15
    var bridge_mask: i64 = 0
    bridge_mask = bridge_mask + 1
    bridge_mask = bridge_mask + 2
    bridge_mask = bridge_mask + 4
    bridge_mask = bridge_mask + 8
    if bridge_mask != 15 { return 1 }

    var extension_mask: i64 = 0
    if proof_mask == 15 { extension_mask = extension_mask + 1 }
    if seed_mask == 15 { extension_mask = extension_mask + 2 }
    if chain_mask == 15 { extension_mask = extension_mask + 4 }
    if bridge_mask == 15 { extension_mask = extension_mask + 8 }
    if extension_mask != 15 { return 2 }

    let global_claim_mask: i64 = 0
    let status: i64 = 24
    let ok_mask: i64 = 255
    if global_claim_mask != 0 { return 3 }

    var inst: i64 = 1627
    inst = mix(inst, 78860411, 5519)
    inst = mix(inst, 972719127, 5519)
    inst = mix(inst, 389654052, 5519)
    inst = mix(inst, 790630993, 5519)
    inst = mix(inst, 249889958, 5519)
    inst = mix(inst, 603078026, 5519)
    inst = mix(inst, 737039167, 5519)
    inst = mix(inst, 753371133, 5519)
    inst = mix(inst, 3, 5519)
    inst = mix(inst, 3, 5519)
    inst = mix(inst, 4, 5519)
    inst = mix(inst, 256, 5519)
    inst = mix(inst, 32, 5519)
    inst = mix(inst, 1, 5519)
    inst = mix(inst, 100, 5519)
    inst = mix(inst, 4406636440, 5519)
    inst = mix(inst, 6517899153, 5519)
    inst = mix(inst, 4164877513, 5519)
    inst = mix(inst, 4617762706, 5519)
    inst = mix(inst, 7643846696, 5519)
    inst = mix(inst, 4120687759, 5519)
    inst = mix(inst, proof_mask, 5519)
    inst = mix(inst, seed_mask, 5519)
    inst = mix(inst, chain_mask, 5519)
    inst = mix(inst, bridge_mask, 5519)
    inst = mix(inst, extension_mask, 5519)
    inst = mix(inst, global_claim_mask, 5519)
    inst = mix(inst, status, 5519)
    if inst != 151689640 { return 4 }

    var cert: i64 = 1637
    cert = mix(cert, inst, 5521)
    cert = mix(cert, proof_mask, 5521)
    cert = mix(cert, seed_mask, 5521)
    cert = mix(cert, chain_mask, 5521)
    cert = mix(cert, bridge_mask, 5521)
    cert = mix(cert, extension_mask, 5521)
    cert = mix(cert, global_claim_mask, 5521)
    cert = mix(cert, status, 5521)
    cert = mix(cert, 3, 5521)
    cert = mix(cert, 3, 5521)
    cert = mix(cert, 4, 5521)
    cert = mix(cert, 256, 5521)
    cert = mix(cert, 32, 5521)
    cert = mix(cert, 1, 5521)
    cert = mix(cert, 100, 5521)
    cert = mix(cert, ok_mask, 5521)
    if cert != 22530645 { return 5 }

    var artifact: i64 = 1657
    artifact = mix(artifact, inst, 5527)
    artifact = mix(artifact, cert, 5527)
    artifact = mix(artifact, 17, 5527)
    artifact = mix(artifact, 3, 5527)
    artifact = mix(artifact, 3, 5527)
    artifact = mix(artifact, 4, 5527)
    artifact = mix(artifact, proof_mask, 5527)
    artifact = mix(artifact, bridge_mask, 5527)
    artifact = mix(artifact, extension_mask, 5527)
    artifact = mix(artifact, global_claim_mask, 5527)
    artifact = mix(artifact, status, 5527)
    artifact = mix(artifact, ok_mask, 5527)
    if artifact != 692714944 { return 6 }

    var audit: i64 = 1663
    audit = mix(audit, artifact, 5531)
    audit = mix(audit, inst, 5531)
    audit = mix(audit, cert, 5531)
    audit = mix(audit, 78860411, 5531)
    audit = mix(audit, 972719127, 5531)
    audit = mix(audit, 389654052, 5531)
    audit = mix(audit, 790630993, 5531)
    audit = mix(audit, 249889958, 5531)
    audit = mix(audit, 603078026, 5531)
    audit = mix(audit, 737039167, 5531)
    audit = mix(audit, 753371133, 5531)
    audit = mix(audit, 3, 5531)
    audit = mix(audit, 3, 5531)
    audit = mix(audit, 4, 5531)
    audit = mix(audit, status, 5531)
    audit = mix(audit, ok_mask, 5531)
    if audit != 627937430 { return 7 }
    return 0
}
