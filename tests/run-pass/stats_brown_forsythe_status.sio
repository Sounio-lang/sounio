//@ run-pass
//@ expect-stdout: STATS_BROWN_FORSYTHE_STATUS_PASS
use stats::brown_forsythe::{brown_forsythe}
use stats::order::{sort100}
fn main() with IO,Mut,Div,Panic {
 var a:[f64;100]=[0.0;100]
 var b:[f64;100]=[0.0;100]
 assert(brown_forsythe(&a,1,&b,3).status==1)
 assert(brown_forsythe(&a,101,&b,3).status==1)
 assert(brown_forsythe(&a,3,&b,-9223372036854775807-1).status==1)
 assert(brown_forsythe(&a,3,&b,3).status==3)
 a[0]=1.0;a[1]=3.0;b[0]=2.0;b[1]=6.0
 let degenerate=brown_forsythe(&a,2,&b,2)
 assert(degenerate.status==3 && degenerate.p==0.0)
 a[2]=1.0e308*2.0
 assert(brown_forsythe(&a,3,&b,3).status==2)
 a[2]=0.0/0.0
 assert(brown_forsythe(&a,3,&b,3).status==2)
 a[0]=3.0;a[1]=1.0;a[2]=2.0
 b[0]=1.0;b[1]=2.0;b[2]=3.0
 let good=brown_forsythe(&a,3,&b,3)
 assert(good.status==0 && good.f_stat==0.0 && good.p==1.0)
 assert(good.df1==1 && good.df2==4 && good.reference_approximate)
 assert(a[0]==3.0 && a[1]==1.0)
 assert(!sort100(&!a,101) && a[0]==3.0)
 a[2]=0.0/0.0
 assert(!sort100(&!a,3) && a[0]==3.0)
 a[2]=2.0
 assert(sort100(&!a,3) && a[0]==1.0 && a[2]==3.0)
 assert(sort100(&!a,0))
 println("STATS_BROWN_FORSYTHE_STATUS_PASS")
 0
}
