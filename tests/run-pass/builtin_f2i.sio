//@ run-pass
// Builtin float calls must convert on as-i64 (frontend float-ness).
// Regression: read_f64/sqrt results skipped IrFloatToInt and IEEE bits
// leaked downstream (print showed 0x4059.. while ==102 held).
use tensor2::cpu_kernel::{CpuBuf, ck_alloc, ck_set}

fn conv_in_callee(cp: &CpuBuf) -> i64 {
    read_f64(cp.data, 2) as i64
}

fn main() with IO, Mut, Panic, Div, Alloc {
    var ok = true
    var cp = ck_alloc(4)
    ck_set(&!cp, 2, 102.0)
    if read_f64(cp.data, 2) as i64 != 102 { ok = false }
    let f = read_f64(cp.data, 2)
    if f as i64 != 102 { ok = false }
    if conv_in_callee(&cp) != 102 { ok = false }
    if sqrt(102.0) as i64 != 10 { ok = false }
    if ok { print("BUILTINF2I PASS") } else { print("BUILTINF2I FAIL") }
    print("\n")
    if !ok { exit(1) }
    exit(0)
}
