//@ run-pass
//@ expect-stdout-contains: KNOWLEDGE_LITERAL_DECLARED_VARIANCE_PASS

// A Knowledge literal with a constant `value:` keeps the `variance:` it
// declares. Madaros derived the variance of the value expression (0.0 for a
// constant) and wrote it over field 1, so
//     Knowledge { value: 0.077, variance: 0.5, .. }.variance
// read 0.0 (lean_single: 0.5). A non-constant value (`value: m[0]`) was not
// affected, which is why the darwin_pbpk priors did not show it.

struct KBox { kn: [Knowledge[f64]; 2], n: i32 }

fn mk_one() -> Knowledge[f64] with Mut {
    Knowledge { value: 0.077, variance: 0.5, epsilon: 0.9, provenance: "x" }
}

fn mk_box() -> KBox with Mut {
    var kn: [Knowledge[f64]; 2] = [Knowledge(0.0, ε=1.0, prov="e"); 2]
    kn[0] = Knowledge { value: 0.077, variance: 0.5, epsilon: 0.9, provenance: "x" }
    KBox { kn: kn, n: 1 }
}

fn near(a: f64, b: f64) -> bool {
    let d = if a > b { a - b } else { b - a }
    return d < 1.0e-12
}

fn check(tag: string, value: f64, variance: f64, confidence: f64) -> i32 with IO {
    if near(value, 0.077) && near(variance, 0.5) && near(confidence, 0.9) { return 0 }
    print("FAIL "); print(tag); print(" value="); print_f64(value); print(" variance="); print_f64(variance); print(" confidence="); print_f64(confidence); println("")
    return 1
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    let a = Knowledge { value: 0.077, variance: 0.5, epsilon: 0.9, provenance: "x" }
    fails = fails + check("local literal", a.value, a.variance, a.confidence)
    var arr: [Knowledge[f64]; 2] = [Knowledge(0.0, ε=1.0, prov="e"); 2]
    arr[0] = Knowledge { value: 0.077, variance: 0.5, epsilon: 0.9, provenance: "x" }
    fails = fails + check("array element", arr[0].value, arr[0].variance, arr[0].confidence)
    let o = mk_one()
    fails = fails + check("returned", o.value, o.variance, o.confidence)
    let b = mk_box()
    fails = fails + check("field array element", b.kn[0].value, b.kn[0].variance, b.kn[0].confidence)
    let n = Knowledge { value: -0.077, variance: 0.5, epsilon: 0.9, provenance: "x" }
    fails = fails + check("negated literal", 0.0 - n.value, n.variance, n.confidence)
    if fails == 0 {
        println("KNOWLEDGE_LITERAL_DECLARED_VARIANCE_PASS")
        return 0
    }
    println("KNOWLEDGE_LITERAL_DECLARED_VARIANCE_FAIL")
    return 1
}
