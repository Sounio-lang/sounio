//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_INTERPROC_EXP_PASS

// Interproc FO through exp/log inside pure helpers (bytecode unary ops 20+).
// Measured hole before this fix: variance_of(clearance(cl0,eta)) == 0
// while inline cl0*exp(eta) was FO-live.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn clearance(cl0: f64, eta: f64) -> f64 {
    cl0 * exp(eta)
}

fn log_clearance(cl: f64) -> f64 {
    log(cl)
}

fn scaled_exp(a: f64, b: f64) -> f64 {
    a * exp(b)
}

fn main() with IO, Mut, Div, Epistemic {
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let cl0 = kCL0.value
    let eta = kEta.value

    // Inline reference
    let v_inline = variance_of(cl0 * exp(eta))
    let m_inline = second_order_mean(cl0 * exp(eta))
    // Interproc — must match
    let v_helper = variance_of(clearance(cl0, eta))
    let m_helper = second_order_mean(clearance(cl0, eta))
    let v_scaled = variance_of(scaled_exp(cl0, eta))

    // Analytic at η=0: Var = σ_CL0² + CL0² σ_η² = 0.09 + 0.25 = 0.34
    // E2[CL0·exp(η)] = CL0 · (1 + ½ σ_η²) = 5 * 1.005 = 5.025
    //   (when only η curves; CL0 linear — product of indep: E2 ≈ μ_CL0 * E2[exp]
    //    more carefully FO product of CL0 and exp(η):
    //    at means, E2 ≈ cl0*exp + ½*(H terms); matches m_inline)

    print("v_inline="); print_f64(v_inline); print("\n")
    print("v_helper="); print_f64(v_helper); print("\n")
    print("v_scaled="); print_f64(v_scaled); print("\n")
    print("m_inline="); print_f64(m_inline); print("\n")
    print("m_helper="); print_f64(m_helper); print("\n")

    // log through helper on FO-live clearance peel
    let kX: Knowledge<f64> = measure(2.718281828, uncertainty: 0.05)
    let x = kX.value
    let v_log_i = variance_of(log(x))
    let v_log_h = variance_of(log_clearance(x))
    print("v_log_i="); print_f64(v_log_i); print("\n")
    print("v_log_h="); print_f64(v_log_h); print("\n")

    let ok = abs_f(v_inline - 0.34) < 1.0e-9
        && abs_f(v_helper - v_inline) < 1.0e-9
        && abs_f(v_scaled - v_inline) < 1.0e-9
        && abs_f(m_helper - m_inline) < 1.0e-7
        && abs_f(m_inline - 5.025) < 1.0e-6
        && abs_f(v_log_h - v_log_i) < 1.0e-9
        && v_helper > 0.0
    if ok {
        print("MADAROS_GUM_FO_INTERPROC_EXP_PASS\n")
    } else {
        print("MADAROS_GUM_FO_INTERPROC_EXP_FAIL\n")
    }
}
