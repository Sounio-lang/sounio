//@ run-pass
//@ description: Card A parser regression coverage for raw pointer type syntax.

extern "C" {
    fn malloc(size: usize) -> *mut u8;
}

fn takes_ptrs(a: *mut i64, b: *const f64) -> i64 {
    var local: *mut i64;
    if a as i64 == 0 {
        return b as i64
    }
    local = a
    local as i64
}

fn main() -> i32 {
    takes_ptrs(0 as *mut i64, 0 as *const f64) as i32
}
