//@ run-pass
// Minimal generic cross-module summary-lowering repro (A10).
// Imports a GENERIC struct GBig<F>{c:[F;2048],bits} + generic fn returning it by
// value, monomorphised via turbofish gbig_basis::<i64>. Under Madaros this
// compile-time SIGSEGVs inside lower_program_to_ir_summary_box_with_externs_ref
// (the summary-lowering pass for the generic dependency module). Single-module or
// non-generic [i64;256] deps lower fine (see sret_forwarding_cross_module_min).
// Expected output once fixed: GEN_DEP_SUMMARY_OK

use testmod::gen_big::{GBig, gbig_basis}

fn main() -> i64 with IO, Mut, Panic {
    let zero: i64 = 0
    let one: i64 = 1
    let r = gbig_basis::<i64>(4, 3, zero, one)
    if r.c[3] == 1 && r.c[0] == 0 && r.bits == 4 {
        println("GEN_DEP_SUMMARY_OK")
        return 0
    }
    println("GEN_DEP_SUMMARY_FAIL")
    return 1
}
