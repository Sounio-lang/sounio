//@ run-pass
//@ expect-stdout: TUPLE_BOX_SLOT_OK
// `let next = pair.1` where the call returns (Pz, Box<EL>) binds `next` as a Box
// of EL, so `next.label` / `next.head` read EL's fields (label 0, head 1). The
// D structs put `head` at 0 and `label` at 1 and win the untyped field vote that
// Madaros used to fall back to: it printed 3. The same shape is
// Parser::parse_call_expr_box (`let next = pair2.1` from parse_call_arg_expr),
// whose gen2 build stored each later call argument's head as its label (#2966).
// The Option<Box<EL>> slot covers `match pair.1 { Some(n) => (*n).head }`.

struct D1 { head: i64, label: i64, x: i64 }
struct D2 { head: i64, label: i64, y: i64 }
struct D3 { head: i64, label: i64 }
struct EL { label: i64, head: i64, tail: Option<Box<EL>> }
struct Pz { pos: i64 }

impl Pz {
    fn arg(self) -> (Pz, Box<EL>) with Mut, Alloc {
        let q = Pz { pos: self.pos + 1 }
        (q, Box::new(EL { label: 10 + self.pos, head: 20 + self.pos, tail: None }))
    }

    fn maybe(self) -> (Pz, Option<Box<EL>>) with Mut, Alloc {
        let q = Pz { pos: self.pos + 1 }
        (q, Some(Box::new(EL { label: 30, head: 40, tail: None })))
    }
}

fn main() -> i32 with IO, Mut, Div, Alloc, Panic {
    let a = D1 { head: 1, label: 2, x: 3 }
    let b = D2 { head: 1, label: 2, y: 3 }
    let c = D3 { head: 1, label: 2 }
    let p = Pz { pos: 0 }
    let pair2 = p.arg()
    let next = pair2.1
    let node = EL { label: next.label, head: next.head, tail: None }
    var r = node.label * 100 + node.head + a.head + b.head + c.head - 3
    let pair3 = pair2.0.maybe()
    let opt = pair3.1
    match opt {
        Some(n) => { r = r + (*n).head * 10000 + (*n).label * 1000000 }
        None => { r = r + 7 }
    }
    if r != 30401020 {
        println(r)
        return 1
    }
    println("TUPLE_BOX_SLOT_OK")
    return 0
}
