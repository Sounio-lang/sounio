//@ run-pass
//@ requires: madaros
//@ description: Scalar mirror for Lorenz i256 projection into validated ball enclosure smoke

fn cert_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness(numerator: i64, denominator: i64,
                     quotient: i64, remainder: i64) -> i64 {
    if denominator <= 0 { return 0 }
    if quotient < 0 { return 0 }
    if remainder < 0 { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn projection_inclusion_fingerprint(
    trajectory_manifest_fp: i64,
    final_x_2p32: i64,
    final_y_2p32: i64,
    final_z_2p32: i64,
    scale_log2: i64,
    target_scale: i64,
    x_q: i64,
    x_r: i64,
    y_q: i64,
    y_r: i64,
    z_q: i64,
    z_r: i64,
    x_lo: i64,
    x_hi: i64,
    y_lo: i64,
    y_hi: i64,
    z_lo: i64,
    z_hi: i64) -> i64 with Mod {
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if final_x_2p32 != 5309941770 { return 0 - 1 }
    if final_y_2p32 != 10058731223 { return 0 - 1 }
    if final_z_2p32 != 4084837935 { return 0 - 1 }
    if scale_log2 != 32 { return 0 - 1 }
    if target_scale != 1000000 { return 0 - 1 }
    if x_q != 1236317 { return 0 - 1 }
    if x_r != 687511168 { return 0 - 1 }
    if y_q != 2341980 { return 0 - 1 }
    if y_r != 3715113920 { return 0 - 1 }
    if z_q != 951075 { return 0 - 1 }
    if z_r != 1913956800 { return 0 - 1 }
    if x_lo != 992950 { return 0 - 1 }
    if x_hi != 1479682 { return 0 - 1 }
    if y_lo != 2022339 { return 0 - 1 }
    if y_hi != 2661619 { return 0 - 1 }
    if z_lo != 908630 { return 0 - 1 }
    if z_hi != 993526 { return 0 - 1 }

    let source_scale: i64 = 4294967296
    if check_div_witness(final_x_2p32 * target_scale, source_scale,
                         x_q, x_r) != 1 { return 0 - 1 }
    if check_div_witness(final_y_2p32 * target_scale, source_scale,
                         y_q, y_r) != 1 { return 0 - 1 }
    if check_div_witness(final_z_2p32 * target_scale, source_scale,
                         z_q, z_r) != 1 { return 0 - 1 }

    var inclusion_mask: i64 = 0
    if x_q >= x_lo {
        if x_q < x_hi { inclusion_mask = inclusion_mask + 1 }
        if x_q == x_hi {
            if x_r == 0 { inclusion_mask = inclusion_mask + 1 }
        }
    }
    if y_q >= y_lo {
        if y_q < y_hi { inclusion_mask = inclusion_mask + 2 }
        if y_q == y_hi {
            if y_r == 0 { inclusion_mask = inclusion_mask + 2 }
        }
    }
    if z_q >= z_lo {
        if z_q < z_hi { inclusion_mask = inclusion_mask + 4 }
        if z_q == z_hi {
            if z_r == 0 { inclusion_mask = inclusion_mask + 4 }
        }
    }
    if inclusion_mask != 7 { return 0 - 1 }

    var fp: i64 = 251
    fp = cert_mix(fp, trajectory_manifest_fp, 2411)
    fp = cert_mix(fp, final_x_2p32, 2411)
    fp = cert_mix(fp, final_y_2p32, 2411)
    fp = cert_mix(fp, final_z_2p32, 2411)
    fp = cert_mix(fp, scale_log2, 2411)
    fp = cert_mix(fp, target_scale, 2411)
    fp = cert_mix(fp, x_q, 2411)
    fp = cert_mix(fp, x_r, 2411)
    fp = cert_mix(fp, y_q, 2411)
    fp = cert_mix(fp, y_r, 2411)
    fp = cert_mix(fp, z_q, 2411)
    fp = cert_mix(fp, z_r, 2411)
    fp = cert_mix(fp, x_lo, 2411)
    fp = cert_mix(fp, x_hi, 2411)
    fp = cert_mix(fp, y_lo, 2411)
    fp = cert_mix(fp, y_hi, 2411)
    fp = cert_mix(fp, z_lo, 2411)
    fp = cert_mix(fp, z_hi, 2411)
    fp = cert_mix(fp, inclusion_mask, 2411)
    return fp
}

fn projection_contract_fingerprint(trajectory_manifest_fp: i64,
                                   inclusion_fp: i64,
                                   radius_budget_fp: i64,
                                   quality_profile_fp: i64,
                                   inclusion_mask: i64) -> i64 with Mod {
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if inclusion_fp != 890086395 { return 0 - 1 }
    if radius_budget_fp != 565673886 { return 0 - 1 }
    if quality_profile_fp != 70877465 { return 0 - 1 }
    if inclusion_mask != 7 { return 0 - 1 }

    var fp: i64 = 257
    fp = cert_mix(fp, trajectory_manifest_fp, 2423)
    fp = cert_mix(fp, inclusion_fp, 2423)
    fp = cert_mix(fp, radius_budget_fp, 2423)
    fp = cert_mix(fp, quality_profile_fp, 2423)
    fp = cert_mix(fp, inclusion_mask, 2423)
    return fp
}

fn main() -> i64 with Mod {
    let inclusion_fp = projection_inclusion_fingerprint(
        214180161, 5309941770, 10058731223, 4084837935,
        32, 1000000,
        1236317, 687511168,
        2341980, 3715113920,
        951075, 1913956800,
        992950, 1479682,
        2022339, 2661619,
        908630, 993526)
    if inclusion_fp != 890086395 { return 1 }

    let contract_fp = projection_contract_fingerprint(
        214180161, inclusion_fp, 565673886, 70877465, 7)
    if contract_fp != 607091799 { return 2 }

    if projection_inclusion_fingerprint(
        214180161, 5309941770, 10058731223, 4084837935,
        32, 1000000,
        1236317, 687511169,
        2341980, 3715113920,
        951075, 1913956800,
        992950, 1479682,
        2022339, 2661619,
        908630, 993526) != (0 - 1) { return 3 }
    if projection_inclusion_fingerprint(
        214180161, 5309941770, 10058731223, 4084837935,
        32, 1000000,
        1236317, 687511168,
        2341980, 3715113920,
        951075, 1913956800,
        1236318, 1479682,
        2022339, 2661619,
        908630, 993526) != (0 - 1) { return 4 }
    if projection_contract_fingerprint(
        214180161, inclusion_fp, 565673887, 70877465, 7) != (0 - 1) { return 5 }
    if projection_contract_fingerprint(
        214180161, inclusion_fp, 565673886, 70877465, 6) != (0 - 1) { return 6 }

    return 0
}
