//@ run-pass
//@ expect-stdout: VIZ_KOENKER_PASS
//@ expect-stdout: synthetic n=20
//@ expect-stdout: chi2(1) asymptotic
//@ expect-stdout: squared normalized residuals
use stats::regression::assessments::{assess_simple_linear}
use stats::regression::ols::{ols_fit_simple}
use viz::axis::{axis_label,axis_ticks}
use viz::ir::{viz_scene_new,viz_add_line_chart,viz_line_set_viewport,viz_add_axis,
 viz_add_series_legend,viz_node_set_label,viz_add_label,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var x:[f64;100]=[0.0;100]
 var y:[f64;100]=[0.0;100]
 var i:i64=0
 while i<20 {
  x[i as usize]=i as f64
  let sign:f64=if i%2==0 {1.0}else{-1.0}
  y[i as usize]=2.0+3.0*(i as f64)+sign*(0.2+0.1*(i as f64))
  i=i+1
 }
 let assessment=assess_simple_linear(&x,&y,20)
 assert(assessment.fit.status==0 && assessment.heteroscedasticity.status==0 && assessment.normality.status==0)
 assert(assessment.heteroscedasticity.lm>17.846233018 && assessment.heteroscedasticity.lm<17.846233019)
 assert(assessment.heteroscedasticity.p>2.394928980e-5 && assessment.heteroscedasticity.p<2.394928983e-5)
 let scale:f64=assessment.heteroscedasticity.residual_scale
 var squares:[f64;100]=[0.0;100]
 var xs:[f64;1024]=[0.0;1024]
 var ys:[f64;1024]=[0.0;1024]
 var prediction:[f64;1024]=[0.0;1024]
 i=0
 while i<20 {
  let e:f64=assessment.fit.residuals[i as usize]/scale
  squares[i as usize]=e*e
  xs[i as usize]=x[i as usize]
  ys[i as usize]=e*e
  i=i+1
 }
 // This auxiliary fit is only for displaying the observed series and line;
 // the statistical core uses scalar passes and allocates no sample buffers.
 let aux=ols_fit_simple(&x,&squares,20)
 assert(aux.status==0)
 assert(aux.r_squared>0.8923116509 && aux.r_squared<0.8923116510)
 i=0
 while i<20 {prediction[i as usize]=aux.fitted[i as usize];i=i+1}
 let ticks=axis_ticks(-0.5,1.5,4)
 assert(ticks.status==0 && ticks.values[1]==0.0)
 var scene=viz_scene_new()
 let curve=viz_add_line_chart(&!scene,&xs,&ys,20,viz_layout_rect(140,100,600,220),viz_style_rgb(70,180,235))
 let line=viz_add_line_chart(&!scene,&xs,&prediction,20,viz_layout_rect(140,100,600,220),viz_style_rgb(245,170,65))
 assert(viz_line_set_viewport(&!scene,curve,0.0,20.0,-0.5,1.5))
 assert(viz_line_set_viewport(&!scene,line,0.0,20.0,-0.5,1.5))
 let xa=viz_add_axis(&!scene,0.0,20.0,5,false,viz_layout_rect(140,338,600,1),viz_style_rgb(190,200,215))
 let ya=viz_add_axis(&!scene,-0.5,1.5,4,true,viz_layout_rect(120,100,1,220),viz_style_rgb(190,200,215))
 var title:[i8;64]=[0;64]
 title[0]=79
 title[1]=76
 title[2]=83
 title[3]=32
 title[4]=114
 title[5]=101
 title[6]=115
 title[7]=105
 title[8]=100
 title[9]=117
 title[10]=97
 title[11]=108
 title[12]=32
 title[13]=118
 title[14]=97
 title[15]=114
 title[16]=105
 title[17]=97
 title[18]=110
 title[19]=99
 title[20]=101
 title[21]=32
 title[22]=100
 title[23]=105
 title[24]=97
 title[25]=103
 title[26]=110
 title[27]=111
 title[28]=115
 title[29]=116
 title[30]=105
 title[31]=99
 title[32]=32
 title[33]=45
 title[34]=32
 title[35]=115
 title[36]=121
 title[37]=110
 title[38]=116
 title[39]=104
 title[40]=101
 title[41]=116
 title[42]=105
 title[43]=99
 title[44]=32
 title[45]=110
 title[46]=61
 title[47]=50
 title[48]=48
 var method:[i8;64]=[0;64]
 method[0]=75
 method[1]=111
 method[2]=101
 method[3]=110
 method[4]=107
 method[5]=101
 method[6]=114
 method[7]=32
 method[8]=110
 method[9]=82
 method[10]=50
 method[11]=59
 method[12]=32
 method[13]=99
 method[14]=104
 method[15]=105
 method[16]=50
 method[17]=40
 method[18]=49
 method[19]=41
 method[20]=32
 method[21]=97
 method[22]=115
 method[23]=121
 method[24]=109
 method[25]=112
 method[26]=116
 method[27]=111
 method[28]=116
 method[29]=105
 method[30]=99
 method[31]=59
 method[32]=32
 method[33]=110
 method[34]=111
 method[35]=32
 method[36]=112
 method[37]=111
 method[38]=115
 method[39]=116
 method[40]=101
 method[41]=114
 method[42]=105
 method[43]=111
 method[44]=114
 var xname:[i8;64]=[0;64]
 xname[0]=112
 xname[1]=114
 xname[2]=101
 xname[3]=100
 xname[4]=105
 xname[5]=99
 xname[6]=116
 xname[7]=111
 xname[8]=114
 xname[9]=32
 xname[10]=120
 var yname:[i8;64]=[0;64]
 yname[0]=115
 yname[1]=113
 yname[2]=117
 yname[3]=97
 yname[4]=114
 yname[5]=101
 yname[6]=100
 yname[7]=32
 yname[8]=110
 yname[9]=111
 yname[10]=114
 yname[11]=109
 yname[12]=97
 yname[13]=108
 yname[14]=105
 yname[15]=122
 yname[16]=101
 yname[17]=100
 yname[18]=32
 yname[19]=114
 yname[20]=101
 yname[21]=115
 yname[22]=105
 yname[23]=100
 yname[24]=117
 yname[25]=97
 yname[26]=108
 yname[27]=115
 var fitname:[i8;64]=[0;64]
 fitname[0]=97
 fitname[1]=117
 fitname[2]=120
 fitname[3]=105
 fitname[4]=108
 fitname[5]=105
 fitname[6]=97
 fitname[7]=114
 fitname[8]=121
 fitname[9]=32
 fitname[10]=108
 fitname[11]=101
 fitname[12]=97
 fitname[13]=115
 fitname[14]=116
 fitname[15]=32
 fitname[16]=115
 fitname[17]=113
 fitname[18]=117
 fitname[19]=97
 fitname[20]=114
 fitname[21]=101
 fitname[22]=115

 viz_node_set_label(&!scene,xa,&xname,11)
 viz_node_set_label(&!scene,ya,&yname,28)
 assert(viz_add_label(&!scene,&title,49,viz_layout_rect(140,20,600,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&method,45,viz_layout_rect(140,48,600,20),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_series_legend(&!scene,curve,&yname,28,viz_layout_rect(140,390,320,22))>=0)
 assert(viz_add_series_legend(&!scene,line,&fitname,23,viz_layout_rect(470,390,270,22))>=0)
 let lm=axis_label(assessment.heteroscedasticity.lm)
 let p=axis_label(assessment.heteroscedasticity.p)
 var lmtext:[i8;64]=[0;64]
 var ptext:[i8;64]=[0;64]
 lmtext[0]=76;lmtext[1]=77;lmtext[2]=61
 ptext[0]=112;ptext[1]=61
 i=0
 while i<lm.n {lmtext[(i+3) as usize]=lm.text[i as usize];i=i+1}
 i=0
 while i<p.n {ptext[(i+2) as usize]=p.text[i as usize];i=i+1}
 assert(viz_add_label(&!scene,&lmtext,lm.n+3,viz_layout_rect(140,76,270,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&ptext,p.n+2,viz_layout_rect(470,76,270,20),viz_style_rgb(230,235,245))>=0)
 assert(scene.series_count==2 && scene.node_count==10)
 assert(scene.series[0].n==20 && scene.series[1].n==20)
 let pixels=heap_alloc(820*440*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:820,height:440}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,320*820+118)==190*65536+200*256+215)
 viz_html_emit_scene(&scene,820,440)
 println("VIZ_KOENKER_PASS")
 0
}
