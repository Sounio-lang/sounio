//@ run-pass
//@ requires: madaros
//@ expect-stdout: 0.003780
// March 2020 COVID kernel with explicit temporal/provenance typing.
//
// The two inputs are independent sources, and the program says so by building
// each one INSIDE the function that multiplies them: a Knowledge literal starts
// from an empty noise-source set, whereas a parameter or a call result has an
// unknown one, which E230 (ADR-016 5.5) does not treat as independent.
// Nominal value 0.18 * 0.021 = 0.00378.

fn covid_kernel_march_2020() -> Knowledge[f64, ValidUntil("2020-03-31"), Derived] {
    let incidence: Knowledge[f64, ValidUntil("2020-03-31"), Derived] = Knowledge {
        value: 0.18,
        epsilon: 0.83,
        validity: "2020-03-31",
        provenance: "eu_cdc_march_2020"
    }

    let lethality: Knowledge[f64, ValidUntil("2020-03-31"), Derived] = Knowledge {
        value: 0.021,
        epsilon: 0.93,
        validity: "2020-03-31",
        provenance: "lombardy_march_2020"
    }

    incidence * lethality
}

fn main() with IO {
    let kernel = covid_kernel_march_2020()
    println(kernel)
}
