//@ run-pass
//@ check-only
// March 2020 COVID kernel with explicit temporal/provenance typing.

fn covid_kernel_march_2020(
    incidence: Knowledge[f64, ValidUntil("2020-03-31"), Derived],
    lethality: Knowledge[f64, ValidUntil("2020-03-31"), Derived]
) -> Knowledge[f64, ValidUntil("2020-03-31"), Derived] {
    incidence * lethality
}

fn main() with IO {
    let incidence: Knowledge[f64, ValidUntil("2020-03-31"), Derived] = Knowledge {
        value: 0.18,
        epsilon: 0.83,
        validity: "2020-03-31",
        provenance: "eu_cdc_march_2020"
    }

    let lethality: Knowledge[f64, ValidUntil("2020-03-31"), Derived] = Knowledge {
        value: 0.021,
        epsilon: 0.93,
        validity: "2020-03-31",
        provenance: "lombardy_march_2020"
    }

    let kernel = covid_kernel_march_2020(incidence, lethality)
    println(kernel)
}
