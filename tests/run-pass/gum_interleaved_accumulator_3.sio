//@ run-pass
//@ expect-stdout: PASS
// #3547: measurements introduced between updates must all contribute variance.

fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    var s: f64 = 0.0
    let k0: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    s = s + k0.value
    let k1: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    s = s + k1.value
    let k2: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    s = s + k2.value
    let v = variance_of(s)
    print("interleaved 3: "); print_f64(v); print("\n")
    // Reusing a source must preserve covariance and its original sensitivity.
    s = s + k0.value
    let repeated = variance_of(s)
    let source = variance_of(k0.value)
    let cancelled = variance_of(s - 2.0 * k0.value - k1.value - k2.value)
    if s == 4.0 && v > 0.029999999999 && v < 0.030000000001
        && repeated > 0.059999999999 && repeated < 0.060000000001
        && source > 0.009999999999 && source < 0.010000000001
        && cancelled > -0.000000000001 && cancelled < 0.000000000001 {
        print("PASS\n")
        return 0
    }
    return 1
}
