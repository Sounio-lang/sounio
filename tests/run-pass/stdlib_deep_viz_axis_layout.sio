//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_VIZ_AXIS_LAYOUT_PASS
//@ expect-stdout: data-axis-label="2"
use viz::axis::{axis_ticks}
use viz::scale::{ScaleSpec}
use viz::axis_layout::{AxisLabelPlan,axis_measure_labels,axis_fit_labels}
use display::canvas::{Canvas,canvas_clear,canvas_draw_text}
fn paint_and_emit(plan:&AxisLabelPlan,c:&!Canvas) with IO,Mut,Div,Panic {
 println("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"500\" height=\"120\" viewBox=\"0 0 500 120\">")
 println("<rect width=\"500\" height=\"120\" fill=\"black\"/>")
 var text:[i8;256]=[0;256]
 var i:i64=0
 while i<plan.n {
  let label=plan.labels[i as usize]
  var j:i64=0
  while j<label.n {text[j as usize]=label.text[j as usize];j=j+1}
  let x:i64=plan.text_x[i as usize];let y:i64=plan.text_y[i as usize]
  let baseline:i64=y+7
  let text_width:i64=plan.text_width[i as usize]
  canvas_draw_text(c,&text,label.n,x,y,70,180,235)
  print("<text data-axis-label=\"");print(i);print("\" x=\"");print(x)
  print("\" y=\"");print(baseline);print("\" textLength=\"");print(text_width)
  print("\" lengthAdjust=\"spacingAndGlyphs\" font-family=\"monospace\" font-size=\"8\" fill=\"rgb(70,180,235)\">")
  j=0
  while j<label.n {print_char(label.text[j as usize] as i64);j=j+1}
  println("</text>")
  i=i+1
 }
 println("</svg>")
}
fn main() with IO,Mut,Div,Alloc,Panic {
 let ticks=axis_ticks(-1.0,1.0,2)
 let linear_scale=ScaleSpec{mode:0,constant:1.0}
 let fit=axis_fit_labels(-1.0,1.0,8,false,100,40,160,500,120,&linear_scale)
 assert(fit.status==0 && fit.n==3 && fit.intervals==2)
 let dense=axis_measure_labels(&ticks,false,100,40,30,500,120)
 assert(dense.status==2 && dense.n==0)
 let outside=axis_measure_labels(&ticks,false,0,40,160,500,120)
 assert(outside.status==3 && outside.n==0 && outside.required_left>0)
 let vertical=axis_measure_labels(&ticks,true,160,20,80,500,120)
 assert(vertical.status==0)
 let top=axis_measure_labels(&ticks,true,160,0,80,500,120)
 assert(top.status==3 && top.required_top>0)
 let bad=axis_fit_labels(-1.0,1.0,9,false,100,40,160,500,120,&linear_scale)
 assert(bad.status==1 && bad.n==0)
 let pixels=heap_alloc(500*120*8) as *mut i64
 assert(pixels as i64!=0)
 var canvas=Canvas{pixels:pixels,width:500,height:120}
 canvas_clear(&!canvas,0,0,0)
 paint_and_emit(&fit,&!canvas)
 var y:i64=0
 var painted:i64=0
 while y<120 {
  var x:i64=0
  while x<500 {
   let color:i64=read_i64(canvas.pixels,y*500+x)
   if color!=0 {
    var inside=false
    var i:i64=0
    while i<fit.n {
     if x>=fit.text_x[i as usize] && x<fit.text_x[i as usize]+fit.text_width[i as usize] &&
        y>=fit.text_y[i as usize] && y<fit.text_y[i as usize]+8 {inside=true}
     i=i+1
    }
    assert(inside)
    print("AXIS_PIXEL ");print(x);print(" ");print(y);print(" ");println(color)
    painted=painted+1
   }
   x=x+1
  }
  y=y+1
 }
 assert(painted>0)
 heap_free(canvas.pixels as *mut i8)
 println("STDLIB_DEEP_VIZ_AXIS_LAYOUT_PASS")
 0
}
