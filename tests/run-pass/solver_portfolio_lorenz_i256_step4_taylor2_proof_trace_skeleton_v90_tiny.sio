//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v90 smoke for Lorenz i256 step-4 Taylor-2 proof-trace skeleton

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1919
    receipt_fp = mix(receipt_fp, 556038402, 5881)
    receipt_fp = mix(receipt_fp, 509176612, 5881)
    receipt_fp = mix(receipt_fp, 634222760, 5881)
    receipt_fp = mix(receipt_fp, 483096477, 5881)
    receipt_fp = mix(receipt_fp, 453220610, 5881)
    receipt_fp = mix(receipt_fp, 109460759, 5881)
    receipt_fp = mix(receipt_fp, 909105361, 5881)
    receipt_fp = mix(receipt_fp, 389227567, 5881)
    receipt_fp = mix(receipt_fp, 234665993, 5881)
    receipt_fp = mix(receipt_fp, 4, 5881)
    receipt_fp = mix(receipt_fp, 6, 5881)
    receipt_fp = mix(receipt_fp, 255, 5881)
    if receipt_fp != 465157622 { return 1 }

    var audit_fp: i64 = 1931
    audit_fp = mix(audit_fp, receipt_fp, 5897)
    audit_fp = mix(audit_fp, 556038402, 5897)
    audit_fp = mix(audit_fp, 509176612, 5897)
    audit_fp = mix(audit_fp, 634222760, 5897)
    audit_fp = mix(audit_fp, 483096477, 5897)
    audit_fp = mix(audit_fp, 389227567, 5897)
    audit_fp = mix(audit_fp, 234665993, 5897)
    audit_fp = mix(audit_fp, 909105361, 5897)
    audit_fp = mix(audit_fp, 4, 5897)
    audit_fp = mix(audit_fp, 6, 5897)
    audit_fp = mix(audit_fp, 255, 5897)
    if audit_fp != 625996767 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 93, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 93, 1103)
    if entry_fp != 502064734 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 90, 1151)
    manifest_fp = mix(manifest_fp, 94, 1151)
    manifest_fp = mix(manifest_fp, 109460759, 1151)
    manifest_fp = mix(manifest_fp, 453220610, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 785386925 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 90, 1871)
    result_fp = mix(result_fp, 94, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 82, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 296618982 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 90, 1907)
    family_fp = mix(family_fp, 94, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 77, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 866712550 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 90, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 647953398 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 90, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 448312604 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 90, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 888891354 { return 9 }
    return 0
}
