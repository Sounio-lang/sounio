//@ run-pass
//@ description: #1386 control — the legitimate cross-module uses of the capability module still compile on both engines: issuing and inspecting through the module's API, reading a pub field of a struct that also has a private one, and redeeming a linear capability once.
//@ expect-stdout: CAPABILITY_API_1386_PASS
use fixtures::capability_token_1386::{Token, Mixed, Cap, issue, scope_of, mixed, mint, redeem}

fn main() -> i32 with IO {
    let t = issue()
    let m = mixed()
    let c = mint()
    let r = redeem(c)
    if scope_of(&t) != 1 { print("FAIL scope\n"); return 1 }
    if m.label != 7 { print("FAIL label\n"); return 1 }
    if r != 1 { print("FAIL redeem\n"); return 1 }
    print("CAPABILITY_API_1386_PASS\n")
    return 0
}
