//@ run-pass
// Repeats tls_client_handshake_loopback.sio with an ECDSA P-256 test
// certificate on a second port, confirming the ecdsa_p256_verify path
// (Task 2) and the EC-public-key parsing path (Task 3) both work
// end-to-end against a real, independently-generated certificate and
// signature.
//
// Test cert generated via:
//   openssl ecparam -name prime256v1 -genkey -noout -out ec_key.pem
//   openssl req -new -x509 -key ec_key.pem -out ec_cert.pem -days 1 \
//     -subj "/CN=localhost" -addext "subjectAltName=DNS:127.0.0.1"
//   openssl x509 -in ec_cert.pem -outform DER -out ec_cert.der
// Server driven via:
//   openssl s_server -key ec_key.pem -cert ec_cert.pem -accept 44331 -tls1_3 -www

use tls::client::*
use x509::trust_store::*
use x509::cert::*
use net::socket::*

fn main() -> i64 with IO, Mut {
    let der_len: i64 = 407
    let der_bytes: [u8; 407] = [
        0x30, 0x82, 0x1, 0x93, 0x30, 0x82, 0x1, 0x39, 0xa0, 0x3, 0x2, 0x1,
        0x2, 0x2, 0x14, 0x1b, 0x9c, 0x64, 0xc8, 0xb9, 0x38, 0xc5, 0x98, 0xe9,
        0x18, 0x52, 0xf0, 0xa3, 0xae, 0x3d, 0x4, 0x4, 0x46, 0x6d, 0xe0, 0x30,
        0xa, 0x6, 0x8, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x4, 0x3, 0x2, 0x30,
        0x14, 0x31, 0x12, 0x30, 0x10, 0x6, 0x3, 0x55, 0x4, 0x3, 0xc, 0x9,
        0x6c, 0x6f, 0x63, 0x61, 0x6c, 0x68, 0x6f, 0x73, 0x74, 0x30, 0x1e, 0x17,
        0xd, 0x32, 0x36, 0x30, 0x38, 0x32, 0x36, 0x30, 0x32, 0x31, 0x32, 0x34,
        0x37, 0x5a, 0x17, 0xd, 0x32, 0x36, 0x30, 0x38, 0x32, 0x37, 0x30, 0x32,
        0x31, 0x32, 0x34, 0x37, 0x5a, 0x30, 0x14, 0x31, 0x12, 0x30, 0x10, 0x6,
        0x3, 0x55, 0x4, 0x3, 0xc, 0x9, 0x6c, 0x6f, 0x63, 0x61, 0x6c, 0x68,
        0x6f, 0x73, 0x74, 0x30, 0x59, 0x30, 0x13, 0x6, 0x7, 0x2a, 0x86, 0x48,
        0xce, 0x3d, 0x2, 0x1, 0x6, 0x8, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x3,
        0x1, 0x7, 0x3, 0x42, 0x0, 0x4, 0x12, 0xcd, 0x3f, 0xa5, 0x2d, 0xf2,
        0x6a, 0x4f, 0x78, 0x9, 0x64, 0x78, 0xda, 0xe9, 0x39, 0x50, 0xab, 0x14,
        0xfc, 0x91, 0x8b, 0x90, 0x60, 0x26, 0xba, 0x35, 0xd3, 0xac, 0x39, 0x15,
        0xef, 0x61, 0x1, 0xf2, 0x5b, 0xdc, 0x55, 0x39, 0xe, 0x52, 0x49, 0xf1,
        0x84, 0x41, 0x96, 0x45, 0x66, 0x7a, 0x8c, 0x3b, 0x3c, 0x57, 0x66, 0xe1,
        0x40, 0xc8, 0x2b, 0x6a, 0xe2, 0x13, 0x7d, 0x30, 0x97, 0x1f, 0xa3, 0x69,
        0x30, 0x67, 0x30, 0x1d, 0x6, 0x3, 0x55, 0x1d, 0xe, 0x4, 0x16, 0x4,
        0x14, 0x93, 0x29, 0xd8, 0x7b, 0xae, 0xec, 0x75, 0x9d, 0x8e, 0xe8, 0xdd,
        0xa0, 0x8f, 0x2d, 0x6, 0xbe, 0x53, 0x4a, 0x85, 0x2, 0x30, 0x1f, 0x6,
        0x3, 0x55, 0x1d, 0x23, 0x4, 0x18, 0x30, 0x16, 0x80, 0x14, 0x93, 0x29,
        0xd8, 0x7b, 0xae, 0xec, 0x75, 0x9d, 0x8e, 0xe8, 0xdd, 0xa0, 0x8f, 0x2d,
        0x6, 0xbe, 0x53, 0x4a, 0x85, 0x2, 0x30, 0xf, 0x6, 0x3, 0x55, 0x1d,
        0x13, 0x1, 0x1, 0xff, 0x4, 0x5, 0x30, 0x3, 0x1, 0x1, 0xff, 0x30,
        0x14, 0x6, 0x3, 0x55, 0x1d, 0x11, 0x4, 0xd, 0x30, 0xb, 0x82, 0x9,
        0x31, 0x32, 0x37, 0x2e, 0x30, 0x2e, 0x30, 0x2e, 0x31, 0x30, 0xa, 0x6,
        0x8, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x4, 0x3, 0x2, 0x3, 0x48, 0x0,
        0x30, 0x45, 0x2, 0x21, 0x0, 0x87, 0x35, 0xaf, 0xc2, 0x8, 0xfc, 0x30,
        0xf7, 0x42, 0x6, 0x2f, 0x59, 0x74, 0x34, 0xd2, 0x72, 0xa, 0xda, 0x13,
        0x27, 0x9d, 0x93, 0x1f, 0x7b, 0xbe, 0xe9, 0x2f, 0x7, 0x64, 0x9f, 0x12,
        0x91, 0x2, 0x20, 0x49, 0xc0, 0x2e, 0xf3, 0x1a, 0x5b, 0xfe, 0xb2, 0xae,
        0x7, 0xeb, 0xfe, 0xfe, 0xce, 0xbe, 0x67, 0xb3, 0xee, 0x51, 0xb4, 0xbb,
        0xb9, 0x1, 0x4c, 0xa2, 0x4d, 0xf2, 0x81, 0x9b, 0xce, 0x7d, 0x62,
    ]

    let der_buf = rawbuf_new(der_len + 8)
    var i: i64 = 0
    while i < der_len {
        rawbuf_set(&der_buf, i, der_bytes[i as usize] as i64)
        i = i + 1
    }

    let (cert, perr) = x509_parse_certificate(&der_buf, der_len)
    if perr != 0 {
        println("tls_client_handshake_ecdsa_loopback: failed to parse test certificate")
        return 1
    }

    var store = TrustStore { certs: [certificate_zero(); 512], bufs: [rawbuf_new(1); 512], count: 1 }
    store.certs[0] = cert
    store.bufs[0] = der_buf

    let host_text = "127.0.0.1"
    let host_len = str_len(host_text)
    let host = rawbuf_new(host_len + 8)
    var hi: i64 = 0
    while hi < host_len {
        rawbuf_set(&host, hi, str_char_at(host_text, hi))
        hi = hi + 1
    }

    let now_unix: i64 = 1787710389

    let (conn, result_code) = tls_connect(&host, host_len, 44331 as u16, &store, now_unix)
    if result_code != 0 {
        println("tls_client_handshake_ecdsa_loopback: handshake failed")
        print_int(result_code)
        return 1
    }
    println("tls_client_handshake_ecdsa_loopback: handshake reached application keys")
    return 0
}
