//@ run-pass
//
// Gradient Topology Types (GTT) — β⁹ week-8 regression (n-ary surface).
//
// Week-3 unioned channel topology across binary user-fn calls
// (gtt_interprocedural_topology.sio).  Week-4 added body-precision
// filtering via FN_USED_PARAMS.  Week-5 introduced Lean's Expr.callN
// + gtt_sound_body_callN soundness.  The compiler-side variadic
// iteration over B9_ARG_CH_SET[16] has been live since week-3, but
// was only validated at arity 2.  This test locks in arities 3..5
// to prove the union scales smoothly across the per-arg slot table.
//
// Concretely, for
//
//     fn my_sum3(a, b, c) -> f64 { a + b + c }
//     let x = k0.value   // channel 0
//     let y = k1.value   // channel 1
//     let z = k2.value   // channel 2
//     hessian_of(my_sum3(x, y, z), 0, 2)
//
// pre-week-3 would have leaked only z's topology ({ch2}); the (0, 2)
// query would have refused on missing channel 0.  Week-3's variadic
// union over B9_ARG_CH_SET emits {ch0, ch1, ch2}, so every cross-pair
// query type-checks.  This test verifies the (0,1), (0,2), (1,2)
// triangle for arity 3, and analogous coverage for arity 4 and 5.

fn my_sum3(a: f64, b: f64, c: f64) -> f64 with Epistemic {
    a + b + c
}

fn my_sum4(a: f64, b: f64, c: f64, d: f64) -> f64 with Epistemic {
    a + b + c + d
}

fn my_sum5(a: f64, b: f64, c: f64, d: f64, e: f64) -> f64 with Epistemic {
    a + b + c + d + e
}

fn main() with IO, Epistemic, Mut, Div {
    let k0: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let k1: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
    let k2: Knowledge<f64> = measure(5.0, uncertainty: 0.1)
    let k3: Knowledge<f64> = measure(7.0, uncertainty: 0.1)
    let k4: Knowledge<f64> = measure(11.0, uncertainty: 0.1)

    let x = k0.value              // channel 0
    let y = k1.value              // channel 1
    let z = k2.value              // channel 2
    let w = k3.value              // channel 3
    let v = k4.value              // channel 4

    // Arity 3: every cross-pair must type-check.
    let h3_02 = hessian_of(my_sum3(x, y, z), 0, 2)
    let h3_01 = hessian_of(my_sum3(x, y, z), 0, 1)
    let h3_12 = hessian_of(my_sum3(x, y, z), 1, 2)
    println(h3_02)
    println(h3_01)
    println(h3_12)

    // Arity 4: corner pair (0, 3) crosses the full arg span.
    let h4_03 = hessian_of(my_sum4(x, y, z, w), 0, 3)
    let h4_12 = hessian_of(my_sum4(x, y, z, w), 1, 2)
    println(h4_03)
    println(h4_12)

    // Arity 5: corner pair (0, 4) crosses the full arg span.
    let h5_04 = hessian_of(my_sum5(x, y, z, w, v), 0, 4)
    let h5_23 = hessian_of(my_sum5(x, y, z, w, v), 2, 3)
    println(h5_04)
    println(h5_23)
}
