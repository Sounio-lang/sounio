//@ run-pass
//@ expect-stdout: STATS_WEIGHTED_QR_STATUS_PASS
use stats::regression::multiple::{multiple_linear_fit,weighted_multiple_linear_fit}
use linalg::weighted_least_squares::{WeightedLeastSquaresResult}
use math::pure::{is_finite}
fn wls_abs(x:f64)->f64 {if x<0.0 {0.0-x}else{x}}
fn wls_empty_solution(r:&WeightedLeastSquaresResult)->bool with Mut,Div,Panic {
 if r.df!=0 || r.residual_norm!=0.0 || r.normalized_weighted_residual_norm!=0.0 || r.variance_model_assessed {return false}
 var i:i64=0
 while i<8 {if r.coefficients[i as usize]!=0.0 {return false};i=i+1}
 i=0
 while i<256 {if r.fitted[i as usize]!=0.0 || r.residuals[i as usize]!=0.0 {return false};i=i+1}
 true
}
fn wls_extreme_weights() with Mut,Div,Panic {
 var a:[f64;2048]=[0.0;2048]
 var b:[f64;256]=[0.0;256]
 var w:[f64;256]=[0.0;256]
 a[8]=1.0;b[0]=1.0;b[1]=2.0
 w[0]=1.7976931348623157e308
 w[1]=2.2250738585072014e-308/4503599627370496.0
 let fit=weighted_multiple_linear_fit(&a,&b,&w,2,1,0.0)
 assert(fit.status==0 && fit.rank==1 && fit.df==1)
 assert(fit.coefficients[0]>1.99999 && fit.coefficients[0]<2.00001)
 assert(fit.fitted[1]>1.99999 && fit.fitted[1]<2.00001)
 assert(fit.normalized_weighted_residual_norm>0.99999 && fit.normalized_weighted_residual_norm<1.00001)
}
fn main() with IO,Mut,Div,Panic {
 wls_extreme_weights()
 var a:[f64;2048]=[0.0;2048]
 var b:[f64;256]=[0.0;256]
 var w:[f64;256]=[0.0;256]
 let size=weighted_multiple_linear_fit(&a,&b,&w,0,0,-1.0)
 assert(size.status==1 && size.m==0 && size.p==0 && wls_empty_solution(&size))
 let tol=weighted_multiple_linear_fit(&a,&b,&w,4,2,-1.0)
 assert(tol.status==5 && tol.rcond_used==0.0 && tol.weight_scale==0.0 && wls_empty_solution(&tol))
 let missing=weighted_multiple_linear_fit(&a,&b,&w,4,2,0.0)
 assert(missing.status==6 && missing.rank==0 && wls_empty_solution(&missing))
 a[0]=1.0;a[1]=-1.0;a[8]=1.0;a[9]=0.0
 a[16]=1.0;a[17]=1.0;a[24]=1.0;a[25]=2.0
 b[0]=-1.0;b[1]=2.0;b[2]=5.0;b[3]=8.2
 var i:i64=0
 while i<4 {w[i as usize]=1.0;i=i+1}
 a[7]=0.0/0.0;a[2047]=1.0e308*2.0;b[255]=0.0/0.0;w[255]=-1.0
 let ordinary=multiple_linear_fit(&a,&b,4,2,0.0)
 let unit=weighted_multiple_linear_fit(&a,&b,&w,4,2,0.0)
 assert(ordinary.status==0 && unit.status==0 && unit.rank==2 && unit.df==2)
 assert(unit.weight_scale==1.0 && !unit.variance_model_assessed)
 i=0
 while i<2 {assert(wls_abs(unit.coefficients[i as usize]-ordinary.coefficients[i as usize])<1.0e-11);i=i+1}
 i=0
 while i<4 {
  assert(wls_abs(unit.fitted[i as usize]-ordinary.fitted[i as usize])<1.0e-11)
  assert(wls_abs(unit.residuals[i as usize]-ordinary.residuals[i as usize])<1.0e-11)
  w[i as usize]=16.0;i=i+1
 }
 assert(wls_abs(unit.residual_norm-ordinary.residual_norm)<1.0e-11)
 assert(wls_abs(unit.normalized_weighted_residual_norm-unit.residual_norm)<1.0e-11)
 let scaled=weighted_multiple_linear_fit(&a,&b,&w,4,2,0.0)
 assert(scaled.status==0 && scaled.weight_scale==16.0)
 assert(wls_abs(scaled.coefficients[0]-unit.coefficients[0])<1.0e-11)
 assert(wls_abs(scaled.coefficients[1]-unit.coefficients[1])<1.0e-11)
 assert(wls_abs(scaled.normalized_weighted_residual_norm-unit.normalized_weighted_residual_norm)<1.0e-11)
 assert(is_finite(scaled.residual_norm))
 let rank=weighted_multiple_linear_fit(&a,&b,&w,4,3,0.0)
 assert(rank.status==3 && rank.rank==2 && rank.weight_scale==16.0 && wls_empty_solution(&rank))
 w[0]=-1.0
 let negative=weighted_multiple_linear_fit(&a,&b,&w,4,2,0.0)
 assert(negative.status==6 && negative.weight_scale==0.0 && wls_empty_solution(&negative))
 a[0]=0.0/0.0
 let data=weighted_multiple_linear_fit(&a,&b,&w,4,2,0.0)
 assert(data.status==2 && data.rank==0 && data.weight_scale==0.0 && wls_empty_solution(&data))
 println("STATS_WEIGHTED_QR_STATUS_PASS")
 0
}
