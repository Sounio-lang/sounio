//@ run-pass
//@ requires: madaros
//@ description: Tiny proof-logged exactly-one cardinality encoding gate

fn card_exactly_one_alo_id() -> i64 {
    return 1
}

fn card_exactly_one_clause_count(n: i64) -> i64 {
    if n <= 0 { return 0 }
    return 1 + (n * (n - 1)) / 2
}

fn card_var(slot: i64) -> i64 {
    return slot + 1
}

fn card_valid_slot(n: i64, slot: i64) -> i64 {
    if slot < 0 { return 0 }
    if slot >= n { return 0 }
    return 1
}

fn card_exactly_one_amo_id(n: i64, a: i64, b: i64) -> i64 {
    if card_valid_slot(n, a) == 0 { return 0 - 1 }
    if card_valid_slot(n, b) == 0 { return 0 - 1 }
    if a == b { return 0 - 1 }

    var id: i64 = 2
    var i: i64 = 0
    while i < n {
        var j: i64 = i + 1
        while j < n {
            if i == a {
                if j == b { return id }
            }
            if i == b {
                if j == a { return id }
            }
            id = id + 1
            j = j + 1
        }
        i = i + 1
    }
    return 0 - 1
}

fn card_exactly_one_clause_len(n: i64, clause_id: i64) -> i64 {
    if n <= 0 { return 0 }
    if clause_id == 1 { return n }
    if clause_id >= 2 {
        if clause_id <= card_exactly_one_clause_count(n) { return 2 }
    }
    return 0
}

fn card_exactly_one_lit(n: i64, clause_id: i64, pos: i64) -> i64 {
    if n <= 0 { return 0 }
    if clause_id == 1 {
        if pos < 0 { return 0 }
        if pos >= n { return 0 }
        return card_var(pos)
    }

    if pos < 0 { return 0 }
    if pos >= 2 { return 0 }

    var id: i64 = 2
    var i: i64 = 0
    while i < n {
        var j: i64 = i + 1
        while j < n {
            if id == clause_id {
                if pos == 0 { return 0 - card_var(i) }
                return 0 - card_var(j)
            }
            id = id + 1
            j = j + 1
        }
        i = i + 1
    }
    return 0
}

fn card_verify_amo_conflict(n: i64, clause_id: i64, lit_a: i64, lit_b: i64) -> i64 {
    if lit_a <= 0 { return 0 }
    if lit_b <= 0 { return 0 }
    let a = lit_a - 1
    let b = lit_b - 1
    if card_valid_slot(n, a) == 0 { return 0 }
    if card_valid_slot(n, b) == 0 { return 0 }
    if a == b { return 0 }
    if card_exactly_one_amo_id(n, a, b) != clause_id { return 0 }

    let c0 = card_exactly_one_lit(n, clause_id, 0)
    let c1 = card_exactly_one_lit(n, clause_id, 1)
    if c0 + lit_a == 0 {
        if c1 + lit_b == 0 { return 1 }
    }
    if c0 + lit_b == 0 {
        if c1 + lit_a == 0 { return 1 }
    }
    return 0
}

fn card_verify_alo_conflict3(n: i64, lit0: i64, lit1: i64, lit2: i64) -> i64 {
    if n != 3 { return 0 }
    if lit0 != (0 - 1) { return 0 }
    if lit1 != (0 - 2) { return 0 }
    if lit2 != (0 - 3) { return 0 }
    return 1
}

fn main() -> i64 {
    if card_exactly_one_clause_count(3) != 4 { return 1 }
    if card_exactly_one_alo_id() != 1 { return 2 }

    if card_exactly_one_amo_id(3, 0, 1) != 2 { return 3 }
    if card_exactly_one_amo_id(3, 0, 2) != 3 { return 4 }
    if card_exactly_one_amo_id(3, 1, 2) != 4 { return 5 }
    if card_exactly_one_amo_id(3, 2, 1) != 4 { return 6 }

    if card_exactly_one_clause_len(3, 1) != 3 { return 7 }
    if card_exactly_one_clause_len(3, 2) != 2 { return 8 }
    if card_exactly_one_lit(3, 1, 0) != 1 { return 9 }
    if card_exactly_one_lit(3, 1, 2) != 3 { return 10 }
    if card_exactly_one_lit(3, 4, 0) != (0 - 2) { return 11 }
    if card_exactly_one_lit(3, 4, 1) != (0 - 3) { return 12 }

    if card_verify_amo_conflict(3, 3, 1, 3) != 1 { return 13 }
    if card_verify_amo_conflict(3, 2, 1, 3) != 0 { return 14 }
    if card_verify_amo_conflict(3, 3, 1, 1) != 0 { return 15 }
    if card_verify_amo_conflict(3, 3, 1, 0 - 3) != 0 { return 16 }

    if card_verify_alo_conflict3(3, 0 - 1, 0 - 2, 0 - 3) != 1 { return 17 }
    if card_verify_alo_conflict3(3, 0 - 1, 0 - 2, 3) != 0 { return 18 }

    return 0
}
