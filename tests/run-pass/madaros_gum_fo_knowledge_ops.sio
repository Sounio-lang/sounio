//@ run-pass
//@ requires: lean_single
//@ expect-stdout: MADAROS_GUM_FO_KNOWLEDGE_OPS_PASS
//@ note: Madaros refuses Knowledge (x) Knowledge arithmetic with E245 (no lowering; tests/compile-fail/knowledge_binary_arith_has_no_lowering.sio), so this pins lean_single only. Drop the requires line when Madaros grows a Knowledge arm in lower_binary_expr_ref and E245 is withdrawn.
// Back from tests/known_failures/ (#2776 part 2). lean_single computed every
// value and variance below, and failed only `inline_match`:
// variance_of((kA * kB).value) read var(kB) = 0.04 for an analytic 0.25,
// because `(kA * kB)` left the last identifier (kB) as the cached Knowledge
// local. Analytic: var(ab) = b^2 sa^2 + a^2 sb^2 = 9(0.01) + 4(0.04) = 0.25.

// Knowledge ⊗ Knowledge FO/GUM — product/sum/div match peel `.value` FO.
// Closed hole: variance_of((kA*kB).value) was 0 while peel gave analytic Var.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() -> i64 with IO, Mut, Div, Epistemic {
    let kA: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let kB: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    let kC: Knowledge<f64> = measure(5.0, uncertainty: 0.5)

    let a = kA.value
    let b = kB.value
    let c = kC.value

    // Values
    let kprod = kA * kB
    let kadd = kA + kB
    let kdiv = kA / kB
    let k3 = (kA * kB) * kC

    let v_ok = abs_f(kprod.value - 6.0) < 1.0e-12
        && abs_f(kadd.value - 5.0) < 1.0e-12
        && abs_f(kdiv.value - (2.0 / 3.0)) < 1.0e-9
        && abs_f(k3.value - 30.0) < 1.0e-9

    // FO: Knowledge path vs peel
    let peel_mul = variance_of(a * b)
    let k_mul = variance_of(kprod.value)
    let peel_add = variance_of(a + b)
    let k_add = variance_of(kadd.value)
    let peel_div = variance_of(a / b)
    let k_div = variance_of(kdiv.value)
    let peel3 = variance_of(a * b * c)
    let k3v = variance_of(k3.value)

    // Analytic independent: Var(ab)=b²σa²+a²σb² = 9*0.01+4*0.04 = 0.25
    let mul_analytic = abs_f(peel_mul - 0.25) < 1.0e-9
    let mul_match = abs_f(k_mul - peel_mul) < 1.0e-9
    let add_match = abs_f(k_add - peel_add) < 1.0e-9
    let div_match = abs_f(k_div - peel_div) < 1.0e-9
    let triple_match = abs_f(k3v - peel3) < 1.0e-6

    // Inline Knowledge product without intermediate let
    let inline_v = variance_of((kA * kB).value)
    let inline_match = abs_f(inline_v - peel_mul) < 1.0e-9

    print("peel_mul="); print_f64(peel_mul); print("\n")
    print("k_mul="); print_f64(k_mul); print("\n")
    print("k_add="); print_f64(k_add); print("\n")
    print("k_div="); print_f64(k_div); print("\n")
    print("k3v="); print_f64(k3v); print("\n")
    print("inline_v="); print_f64(inline_v); print("\n")

    let ok = v_ok && mul_analytic && mul_match && add_match && div_match
        && triple_match && inline_match && k_mul > 0.0
    if ok {
        print("MADAROS_GUM_FO_KNOWLEDGE_OPS_PASS\n")
        return 0
    } else {
        print("MADAROS_GUM_FO_KNOWLEDGE_OPS_FAIL\n")
        print("v_ok="); if v_ok { print("1\n") } else { print("0\n") }
        print("mul_analytic="); if mul_analytic { print("1\n") } else { print("0\n") }
        print("mul_match="); if mul_match { print("1\n") } else { print("0\n") }
        print("add_match="); if add_match { print("1\n") } else { print("0\n") }
        print("div_match="); if div_match { print("1\n") } else { print("0\n") }
        print("triple_match="); if triple_match { print("1\n") } else { print("0\n") }
        print("inline_match="); if inline_match { print("1\n") } else { print("0\n") }
    }
    1
}
