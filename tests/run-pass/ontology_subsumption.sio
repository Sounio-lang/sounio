//@ run-pass
// Minimal ontology subsumption test — inline hierarchy, no stdlib import.
//
// Tests onto_is_a transitive parent-chain lookup using a flat parent array.
// Parent array convention: parents[i] = j means concept i directly subclasses j.
// A root node satisfies parents[i] == i.
//
// Hierarchy used in this test:
//
//   0: Thing              (root — parents[0] = 0)
//   1: Entity             (parents[1] = 0)
//   2: ClinicalFinding    (parents[2] = 1)
//   3: Disorder           (parents[3] = 2)
//   4: InfectiousDisease  (parents[4] = 3)
//   5: Procedure          (parents[5] = 1)
//   6: SurgicalProc       (parents[6] = 5)
//   7: Organism           (parents[7] = 0)

// onto_is_a: reflexive-transitive parent-chain subsumption check.
// parents: flat array of size 1024, parents[i] = direct parent of i
// (parents[i] == i signals a root concept)
fn onto_is_a(parents: &[i64; 1024], n_concepts: i64,
             child: i64, parent: i64) -> bool with Mut {
    if child == parent {
        return true
    }
    if child < 0 || child >= n_concepts {
        return false
    }
    if parent < 0 || parent >= n_concepts {
        return false
    }

    var current = child
    let max_depth = n_concepts
    var steps = 0

    while steps < max_depth {
        let p = parents[current]
        if p == current {
            return false
        }
        if p == parent {
            return true
        }
        if p < 0 || p >= n_concepts {
            return false
        }
        current = p
        steps = steps + 1
    }

    false
}

fn main() -> i64 with IO, Mut, Panic {
    // Build concept hierarchy as a flat parent array
    var parents: [i64; 1024] = [0; 1024]

    // Concept indices (representative of SNOMED CT top-level hierarchy)
    let THING:              i64 = 0
    let ENTITY:             i64 = 1
    let CLINICAL_FINDING:   i64 = 2
    let DISORDER:           i64 = 3
    let INFECTIOUS_DISEASE: i64 = 4
    let PROCEDURE:          i64 = 5
    let SURGICAL_PROC:      i64 = 6
    let ORGANISM:           i64 = 7
    let n: i64 = 8

    // Wire parent pointers
    parents[0] = THING              // Thing is root (self-loop)
    parents[1] = THING              // Entity isa Thing
    parents[2] = ENTITY             // ClinicalFinding isa Entity
    parents[3] = CLINICAL_FINDING   // Disorder isa ClinicalFinding
    parents[4] = DISORDER           // InfectiousDisease isa Disorder
    parents[5] = ENTITY             // Procedure isa Entity
    parents[6] = PROCEDURE          // SurgicalProc isa Procedure
    parents[7] = THING              // Organism isa Thing

    // Reflexive checks
    assert(onto_is_a(&parents, n, THING, THING))
    assert(onto_is_a(&parents, n, DISORDER, DISORDER))

    // Direct parent
    assert(onto_is_a(&parents, n, ENTITY, THING))
    assert(onto_is_a(&parents, n, DISORDER, CLINICAL_FINDING))
    assert(onto_is_a(&parents, n, SURGICAL_PROC, PROCEDURE))

    // Transitive (2 hops)
    assert(onto_is_a(&parents, n, DISORDER, ENTITY))
    assert(onto_is_a(&parents, n, SURGICAL_PROC, ENTITY))

    // Transitive (3 hops)
    assert(onto_is_a(&parents, n, INFECTIOUS_DISEASE, ENTITY))
    assert(onto_is_a(&parents, n, INFECTIOUS_DISEASE, THING))

    // Negative: unrelated branches
    assert(!onto_is_a(&parents, n, DISORDER, PROCEDURE))
    assert(!onto_is_a(&parents, n, SURGICAL_PROC, CLINICAL_FINDING))
    assert(!onto_is_a(&parents, n, ORGANISM, CLINICAL_FINDING))

    // Negative: parent is not subclass of child (antisymmetric)
    assert(!onto_is_a(&parents, n, THING, ENTITY))
    assert(!onto_is_a(&parents, n, ENTITY, INFECTIOUS_DISEASE))

    // Edge: out-of-range concept (negative index)
    assert(!onto_is_a(&parents, n, 0 - 1, THING))
    assert(!onto_is_a(&parents, n, THING, 0 - 1))

    print("ontology_subsumption: all onto_is_a tests passed\n")
    return 0
}
