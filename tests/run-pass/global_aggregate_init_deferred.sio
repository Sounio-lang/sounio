//@ run-pass
//@ requires: madaros
//@ expect-stdout: -0.400000 0.700000
//@ expect-stdout: 9 100 7
//@ expect-stdout: 4
//@ expect-stdout: none
//@ expect-stdout: 6
//@ description: fixed-array globals with a closed initializer are written before `main`, not zero-filled
// A fixed-array global holds its elements inline in BSS, so the one-word
// deferral could not store it and a struct or enum element list was dropped:
// TURNS held null handles and the program died with SIGILL (rc 132). The
// parser now turns a closed element list or repeat into the statements that
// write it, run at `main`'s entry. `[e; n]` evaluates `e` per element, so
// writing RS[1] leaves RS[0] and RS[2] alone.
struct Rec { tag: i64, val: i64 }
struct Oct { e: [f64; 8] }
enum K { A, B, C }
struct Cell { v: i64 }

var TURNS: [Oct; 3] = [
    Oct { e: [0.3, 0.5, 0.2, 0.1, 0.8, 0.4, 0.1, 0.7] },
    Oct { e: [0.1, 0.7, 0.4, 0.3, 0.6, 0.5, 0.4, 0.5] },
    Oct { e: [-0.4, 0.8, 0.6, 0.2, 0.4, 0.3, 0.7, 0.3] },
]
var RS: [Rec; 3] = [Rec { tag: 7, val: 9 }; 3]
var KS: [K; 4] = [K::B; 4]
var ROOT: Option<Box<Cell>> = None
var NUMS: [i64; 3] = [4, 5, 6]

fn main() -> i64 with IO, Mut, Panic {
    print_f64(TURNS[2].e[0])
    print(" ")
    print_f64(TURNS[0].e[7])
    print("\n")
    RS[1].val = 100
    print_int(RS[0].val)
    print(" ")
    print_int(RS[1].val)
    print(" ")
    print_int(RS[2].tag)
    print("\n")
    var nb: i64 = 0
    var i: i64 = 0
    while i < 4 {
        match KS[i as usize] {
            K::B => { nb = nb + 1 }
            _ => {}
        }
        i = i + 1
    }
    print_int(nb)
    print("\n")
    match ROOT {
        None => { println("none") }
        Some(_) => { println("some") }
    }
    print_int(NUMS[2])
    print("\n")
    return 0
}
