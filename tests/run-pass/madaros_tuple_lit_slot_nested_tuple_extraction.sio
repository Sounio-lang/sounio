//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_LIT_SLOT_NESTED_TUPLE_EXTRACTION PASS
//
// Copilot review (PR #2516), finding 1 on the eighth review round: a
// nested case of round 6's finding 1. ExprFieldAccess is how BOTH a
// struct field access (`holder.values`) AND a tuple-slot extraction
// (`pair().0`) are represented, but tuple_lit_slot_is_f64_array_ref only
// ever tried the struct-field lookup (field_array_elem_is_float_for_base_ref),
// which naturally found no struct named "0" and fell through to `false` --
// even though pair()'s slot 0 being an f64 array is exactly what
// expr_is_tuple_slot_f64_array_ref already classifies. So
// `let (a, n) = (pair().0, 0)` lost the array-slot mask on the temporary
// tuple literal and `a[0]` fell back to the integer conversion path.
fn pair() -> ([f64; 2], [f64; 2]) with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    var b: [f64; 2] = [0.0; 2]
    a[0] = 1.5
    b[0] = 0.25
    (a, b)
}

fn main() -> i32 with IO, Mut, Panic {
    let (a, n) = (pair().0, 0)
    let s0: f64 = a[0] * 2.0

    if s0 == 3.0 && n == 0 {
        println("TUPLE_LIT_SLOT_NESTED_TUPLE_EXTRACTION PASS")
        return 0
    }
    1
}
