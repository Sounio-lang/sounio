//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v141 smoke for Lorenz i256 step-1 Taylor-2 flowpipe obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt: i64 = 2039
    receipt = mix(receipt, 90632144, 6067)
    receipt = mix(receipt, 922642400, 6067)
    receipt = mix(receipt, 940931367, 6067)
    receipt = mix(receipt, 788316508, 6067)
    receipt = mix(receipt, 191710845, 6067)
    receipt = mix(receipt, 382273466, 6067)
    receipt = mix(receipt, 506555685, 6067)
    receipt = mix(receipt, 721641728, 6067)
    receipt = mix(receipt, 120130225, 6067)
    receipt = mix(receipt, 1, 6067)
    receipt = mix(receipt, 15, 6067)
    receipt = mix(receipt, 255, 6067)
    if receipt != 579621511 { return 1 }

    var audit: i64 = 2053
    audit = mix(audit, receipt, 6073)
    audit = mix(audit, 90632144, 6073)
    audit = mix(audit, 922642400, 6073)
    audit = mix(audit, 62233558, 6073)
    audit = mix(audit, 104592626, 6073)
    audit = mix(audit, 26998442, 6073)
    audit = mix(audit, 558635697, 6073)
    audit = mix(audit, 590782342, 6073)
    audit = mix(audit, 991875676, 6073)
    audit = mix(audit, 993840454, 6073)
    audit = mix(audit, 232141983, 6073)
    audit = mix(audit, 824834880, 6073)
    audit = mix(audit, 262282451, 6073)
    audit = mix(audit, 191710845, 6073)
    audit = mix(audit, 1, 6073)
    audit = mix(audit, 15, 6073)
    audit = mix(audit, 255, 6073)
    if audit != 392918762 { return 2 }

    var entry: i64 = 101
    entry = mix(entry, 144, 1103)
    entry = mix(entry, receipt, 1103)
    entry = mix(entry, audit, 1103)
    entry = mix(entry, 1, 1103)
    entry = mix(entry, 144, 1103)
    if entry != 246755403 { return 3 }

    var manifest: i64 = 107
    manifest = mix(manifest, 141, 1151)
    manifest = mix(manifest, 145, 1151)
    manifest = mix(manifest, 788316508, 1151)
    manifest = mix(manifest, 382273466, 1151)
    manifest = mix(manifest, 940931367, 1151)
    manifest = mix(manifest, entry, 1151)
    if manifest != 730796448 { return 4 }

    var result: i64 = 131
    result = mix(result, 141, 1871)
    result = mix(result, 145, 1871)
    result = mix(result, 10, 1871)
    result = mix(result, 133, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, manifest, 1871)
    if result != 355992419 { return 5 }

    var family: i64 = 149
    family = mix(family, 141, 1907)
    family = mix(family, 145, 1907)
    family = mix(family, 6, 1907)
    family = mix(family, 4, 1907)
    family = mix(family, 3, 1907)
    family = mix(family, 2, 1907)
    family = mix(family, 128, 1907)
    family = mix(family, 2, 1907)
    family = mix(family, manifest, 1907)
    if family != 868871575 { return 6 }

    var acceptance: i64 = 137
    acceptance = mix(acceptance, 141, 1889)
    acceptance = mix(acceptance, manifest, 1889)
    acceptance = mix(acceptance, result, 1889)
    if acceptance != 853879678 { return 7 }

    var audit_receipt: i64 = 157
    audit_receipt = mix(audit_receipt, 141, 1931)
    audit_receipt = mix(audit_receipt, manifest, 1931)
    audit_receipt = mix(audit_receipt, result, 1931)
    audit_receipt = mix(audit_receipt, family, 1931)
    audit_receipt = mix(audit_receipt, acceptance, 1931)
    if audit_receipt != 893659579 { return 8 }

    var readiness: i64 = 163
    readiness = mix(readiness, 141, 1951)
    readiness = mix(readiness, 31, 1951)
    readiness = mix(readiness, manifest, 1951)
    readiness = mix(readiness, result, 1951)
    readiness = mix(readiness, family, 1951)
    readiness = mix(readiness, acceptance, 1951)
    readiness = mix(readiness, audit_receipt, 1951)
    if readiness != 639513798 { return 9 }
    return 0
}
