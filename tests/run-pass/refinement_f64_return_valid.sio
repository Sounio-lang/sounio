//@ run-pass
//@ description: valid f64 return satisfies a COMPOUND (AND) return refinement — no false positive
//
// Complements compile-fail/refinement_f64_return_violation.sio. Guards the fix
// that captures FN_RET_PRED_COMPOUND_IS_AND on the signature-scan path: an AND
// return refinement must reject out-of-range literals (1.7) AND accept in-range
// ones (0.5) — not falsely reject valid returns.

fn probability() -> { p: f64 | p >= 0.0 && p <= 1.0 } {
    return 0.5
}

fn main() {
    let _ = probability()
}
