//@ run-pass
// R2 narrow-integer witness: i16 20000 + 20000 must wrap to -25536
// (two's complement; 40000 mod 65536 = 40000; as signed i16: 40000 - 65536 = -25536).

fn main() with IO, Div, Panic {
    let x: i16 = 20000 + 20000
    if x == 0 - 25536 {
        print("r2_i16_overflow: PASS\n")
    } else {
        print("r2_i16_overflow: FAIL got=")
        print_int(x)
        print("\n")
    }
}
