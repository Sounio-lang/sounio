//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_LIT_SLOT_SINGLE_ARRAY_FROM_IF_TUPLE_SLOT PASS
//
// Copilot review (PR #2516), finding on the twelfth review round: the
// same ExprFieldAccess gap as the struct-field sibling test, but for a
// NUMERIC tuple-slot extraction instead of a named struct field --
// `(if cond { pair().0 } else { pair2().0 }, 0)` -- which
// tuple_lit_slot_is_f64_array_ref already classifies directly via
// expr_is_tuple_slot_f64_array_ref (lower_name_tuple_index >= 0). Fixed
// by delegating ExprFieldAccess in expr_result_is_f64_array_ref's
// control-flow recursion to the same dispatch tuple_lit_slot_is_f64_array_ref
// uses at its own top level.
fn pair() -> ([f64; 2], [f64; 2]) with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    var b: [f64; 2] = [0.0; 2]
    a[0] = 1.5
    b[0] = 0.25
    (a, b)
}

fn pair2() -> ([f64; 2], [f64; 2]) with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    var b: [f64; 2] = [0.0; 2]
    a[0] = 4.5
    b[0] = 0.75
    (a, b)
}

fn main() -> i32 with IO, Mut, Panic {
    let cond = true
    let (a, n) = (if cond { pair().0 } else { pair2().0 }, 0)
    let s0: f64 = a[0] * 2.0

    if s0 == 3.0 && n == 0 {
        println("TUPLE_LIT_SLOT_SINGLE_ARRAY_FROM_IF_TUPLE_SLOT PASS")
        return 0
    }
    1
}
