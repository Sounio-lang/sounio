//@ run-pass
//@ expect-stdout: NATIVE_MATH_ATAN_FAMILY_OK
//@ requires: madaros
// Replaces compile-fail/native_math_without_backend_builtin.sio, which asserted
// error[E221] for `atan(0.5)`: atan, tan, tanh, asin and acos were bound for
// typechecking but absent from the backend, so the call used to compile to an
// ELF and die on an illegal instruction (check rc=0, compile rc=0, run rc=132).
// Madaros now emits all five (native::math_trans) plus atan2 and ln, so the
// refusal is gone and this program is the same call, run to completion. Accuracy
// and edge cases are in math_trans_values.sio; this is the smoke test.

fn near(a: f64, b: f64) -> bool {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    d < 1.0e-12
}

fn main() -> i64 with IO, Mut, Div {
    // reference values: 20 significant digits, libquadmath
    let ok = near(atan(0.5), 0.46364760900080611621)
        && near(tan(0.5), 0.54630248984379051326)
        && near(tanh(0.5), 0.46211715726000975850)
        && near(asin(0.5), 0.52359877559829887308)
        && near(acos(0.5), 1.04719755119659774615)
        && near(atan2(1.0, 2.0), 0.46364760900080611621)
        && near(ln(2.0), 0.69314718055994530942)
    if ok {
        print("NATIVE_MATH_ATAN_FAMILY_OK\n")
        return 0
    }
    print("NATIVE_MATH_ATAN_FAMILY_FAIL\n")
    1
}
