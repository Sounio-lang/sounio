//@ run-pass
//@ description: Lorenz i128 second-step enclosure contract from first validated enclosure

fn main() -> i64 {
    // The i128 center transition step1 -> step2 is already covered by
    // lorenz_i128_ball_two_step.sio. This contract carries the validated
    // first-step radius forward and adds a second interval LTE budget.
    let cx2: i64 = 1026000
    let cy2: i64 = 1517566
    let cz2: i64 = 969712

    // First validated enclosure from lorenz_i128_validated_first_step.sio.
    let xr1: i64 = 25452
    let yr1: i64 = 32153
    let zr1: i64 = 3373

    // Radius propagation through one Euler vector-field evaluation at step 1.
    let dxr1: i64 = 10 * (yr1 + xr1)
    let x_rhoz_r1: i64 = ((1000000 * zr1) + (27016666 * xr1) + (xr1 * zr1)) / 1000000 + 1
    let dyr1: i64 = x_rhoz_r1 + yr1
    let xyr1: i64 = ((1000000 * yr1) + (1260000 * xr1) + (xr1 * yr1)) / 1000000 + 1
    let beta_zr1: i64 = ((8 * zr1) + 2) / 3
    let dzr1: i64 = xyr1 + beta_zr1

    let euler_xr2: i64 = xr1 + (10000 * dxr1) / 1000000 + 1
    let euler_yr2: i64 = yr1 + (10000 * dyr1) / 1000000 + 1
    let euler_zr2: i64 = zr1 + (10000 * dzr1) / 1000000 + 1

    // Tube covering the first validated enclosure and the second Euler ball:
    //   x in [974548, 1057213]
    //   y in [1227847, 1556952]
    //   z in [965598, 986707]
    let scale64: i64 = 1000000
    let h2: i64 = 100000000
    let lte_den: i64 = 2000000000000
    let x_abs: i64 = 1057213
    let y_abs: i64 = 1556952
    let z_abs: i64 = 986707
    let rhoz_abs: i64 = 27034402

    let f_x_abs: i64 = 10 * (y_abs + x_abs)
    let f_y_abs: i64 = (x_abs * rhoz_abs + scale64 - 1) / scale64 + y_abs
    let f_z_abs: i64 = (x_abs * y_abs + scale64 - 1) / scale64 + ((8 * z_abs) + 2) / 3

    let ddx_abs: i64 = 10 * (f_y_abs + f_x_abs)
    let ddy_abs: i64 = (f_x_abs * rhoz_abs + scale64 - 1) / scale64 +
                       (x_abs * f_z_abs + scale64 - 1) / scale64 +
                       f_y_abs
    let ddz_abs: i64 = (f_x_abs * y_abs + scale64 - 1) / scale64 +
                       (x_abs * f_y_abs + scale64 - 1) / scale64 +
                       ((8 * f_z_abs) + 2) / 3

    let lte_x: i64 = (h2 * ddx_abs + lte_den - 1) / lte_den
    let lte_y: i64 = (h2 * ddy_abs + lte_den - 1) / lte_den
    let lte_z: i64 = (h2 * ddz_abs + lte_den - 1) / lte_den

    let final_xr2: i64 = euler_xr2 + lte_x
    let final_yr2: i64 = euler_yr2 + lte_y
    let final_zr2: i64 = euler_zr2 + lte_z

    let x_lo: i64 = cx2 - final_xr2
    let x_hi: i64 = cx2 + final_xr2
    let y_lo: i64 = cy2 - final_yr2
    let y_hi: i64 = cy2 + final_yr2
    let z_lo: i64 = cz2 - final_zr2
    let z_hi: i64 = cz2 + final_zr2

    if dxr1 != 576050 { return 1 }
    if x_rhoz_r1 != 691088 { return 2 }
    if dyr1 != 723241 { return 3 }
    if xyr1 != 65041 { return 4 }
    if beta_zr1 != 8995 { return 5 }
    if dzr1 != 74036 { return 6 }
    if euler_xr2 != 31213 { return 7 }
    if euler_yr2 != 39386 { return 8 }
    if euler_zr2 != 4114 { return 9 }

    if f_x_abs != 26141650 { return 10 }
    if f_y_abs != 30138074 { return 11 }
    if f_z_abs != 4277249 { return 12 }
    if ddx_abs != 562797240 { return 13 }
    if ddy_abs != 741383914 { return 14 }
    if ddz_abs != 83969657 { return 15 }
    if lte_x != 28140 { return 16 }
    if lte_y != 37070 { return 17 }
    if lte_z != 4199 { return 18 }

    if final_xr2 != 59353 { return 19 }
    if final_yr2 != 76456 { return 20 }
    if final_zr2 != 8313 { return 21 }
    if x_lo != 966647 { return 22 }
    if x_hi != 1085353 { return 23 }
    if y_lo != 1441110 { return 24 }
    if y_hi != 1594022 { return 25 }
    if z_lo != 961399 { return 26 }
    if z_hi != 978025 { return 27 }

    return 0
}
