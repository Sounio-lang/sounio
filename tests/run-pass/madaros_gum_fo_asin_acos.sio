//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_ASIN_ACOS_PASS

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let k: Knowledge<f64> = measure(0.0, uncertainty: 0.05)
    let x = k.value
    let va = variance_of(asin(x))
    let ma = second_order_mean(asin(x))
    let vc = variance_of(acos(x))
    let mc = second_order_mean(acos(x))
    let pi2 = 1.5707963267948966

    print("va="); print_f64(va); print("\n")
    print("ma="); print_f64(ma); print("\n")
    print("vc="); print_f64(vc); print("\n")
    print("mc="); print_f64(mc); print("\n")
    print("a0="); print_f64(asin(0.0)); print("\n")
    print("c0="); print_f64(acos(0.0)); print("\n")

    let ok = abs_f(va - 0.0025) < 1.0e-9
        && abs_f(ma - 0.0) < 1.0e-9
        && abs_f(vc - 0.0025) < 1.0e-9
        && abs_f(mc - pi2) < 1.0e-5
        && abs_f(asin(0.0) - 0.0) < 1.0e-12
        && abs_f(acos(0.0) - pi2) < 1.0e-6
    if ok {
        print("MADAROS_GUM_FO_ASIN_ACOS_PASS\n")
    } else {
        print("MADAROS_GUM_FO_ASIN_ACOS_FAIL\n")
    }
}
