//@ run-pass
//@ timeout: 240
// ============================================================================
// DISSERTATION PBPK28 PARITY REFERENCE — VANCOMYCIN (SIO-519)
//
// Single 1000 mg IV INFUSION over 1.0 h (label rate; never bolus push).
// Zero-order blood input rate Dose/Tinf on [0, Tinf]. Predominantly renal
// sink CL = 5.18 L/h (Matzke 1984 at CrCl 120), plasma referenced.
// Kp = vancomycin tissue values (Vd ~45 L); PS flow-limited except
// brain/adipose/bone. The infusion path does not touch the SIO-504
// clamped bolus kernel.
//
// This ref runs the stdlib scenario ITSELF
// (scenarios/vancomycin_iv.sio): its step, its release law, its params.
// It holds no copy of the model. The companion is
// website/src/lib/pbpk28_core.mjs (DEFAULT_PARAMS_VANCOMYCIN) and the gate
// case at scripts/ci/dissertation_pbpk28_parity_gate.sh.
//
// PK only, single infusion. No clinical-validity claim: parity only
// (ADR009).
//
// Integrator: fully-coupled CN on the 27-state arrow matrix, dt = 0.001,
// input rate at the step midpoint (same convention as Node releaseRateAt).
// ============================================================================

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*
use darwin_pbpk::scenarios::vancomycin_iv::*
use io::sci_print::*

fn emit_at(scen: VancomycinScenario, p: PBPKParams28, t: f64, abs_cum: f64) with IO, Mut, Div {
    var i = 0
    while i < 14 {
        print("PARITY|t=")
        println(t)
        println("")
        print("PARITY|i=")
        println(i)
        print("PARITY|cv=")
        println_f64_sci(scen.pbpk.cv[i], 10)
        print("PARITY|ct=")
        println_f64_sci(scen.pbpk.ct[i], 10)
        print("PARITY|cavg=")
        println_f64_sci(pbpk28_organ_average(scen.pbpk, p, i), 10)
        i = i + 1
    }
    print("TMASS|t=")
    println(t)
    println("")
    print("TMASS|m=")
    println(pbpk28_total_mass(scen.pbpk, p))
    println("")
    print("TREL|t=")
    println(t)
    println("")
    print("TREL|cum=")
    println(abs_cum)
    println("")
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("DISSERTATION_PBPK28_VANCOMYCIN_PARITY_REF v1")
    println("compartments=14")
    println("states=28")
    println("dt=0.001")
    println("dose_mg=1000.0")
    println("release=iv_infusion_1000mg_1h")
    println("cl_L_per_h=5.18")
    println("integrator=fully_coupled_CN_27state")
    println("drug=vancomycin")
    println("samples=12")

    let p = vnc_pbpk28_params()
    var scen = vnc_scenario_init()
    let dt = 0.001
    var t = 0.0
    var abs_cum = 0.0

    var s = 0
    while s < 12 {
        var target = 0.1
        if s == 1 { target = 0.5 }
        if s == 2 { target = 1.0 }
        if s == 3 { target = 2.0 }
        if s == 4 { target = 4.0 }
        if s == 5 { target = 6.0 }
        if s == 6 { target = 8.0 }
        if s == 7 { target = 12.0 }
        if s == 8 { target = 16.0 }
        if s == 9 { target = 20.0 }
        if s == 10 { target = 24.0 }
        if s == 11 { target = 30.0 }
        while t + dt * 0.5 < target {
            abs_cum = abs_cum + vnc_release_rate_at(t + 0.5 * dt) * dt
            scen = vnc_step(scen, p, t, dt)
            t = t + dt
        }
        emit_at(scen, p, t, abs_cum)
        s = s + 1
    }

    println("DISSERTATION_PBPK28_VANCOMYCIN_PARITY_DONE")
    return 0
}
