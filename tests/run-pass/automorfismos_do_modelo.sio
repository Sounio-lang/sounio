//@ run-pass
// O modelo de A1–A10 admite automorfismo NAO-IDENTIDADE?
//
// Estrategia a testar, e nao a supor:
//   1. A diagonal a*∘a* = 1 tem solucao UNICA, porque ∘ e estritamente crescente. Logo todo
//      automorfismo tem de fixar a*.
//   2. No interior, fora do aniquilador, a estrutura E uma PCS — positiva, monotona, com
//      solvabilidade restrita e arquimediana. Logo Cohen & Narens (1979, Thm 2.1) se aplica:
//      automorfismo que fixa um ponto e a identidade.
//   3. Portanto so a identidade sobrevive, e a FRONTEIRA DE ANIQUILACAO e quem fornece o ponto
//      fixo — o papel que a funcao de solvabilidade tem no Teorema 5 de Luce.
//
// Este programa testa (1) e testa candidatos concretos a automorfismo contra a preservacao da
// operacao e do teto. Nao prova o teorema; testa se ha contraexemplo obvio.

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn op(a: f64, b: f64, eps: f64) -> f64 with Div, Panic {
    a + b + eps * a * b / (a + b)
}

// Potencia por serie de Newton para expoente racional simples: x^p via exp/ln nao existe aqui,
// entao testa-se a familia de DILATACOES (x -> lam*x), que sao as candidatas naturais porque ∘
// e homogenea de grau 1, e a familia x -> x*(1+d*(1-x)), monotona em (0,1) e nao-linear.
fn dilata(x: f64, lam: f64) -> f64 { lam * x }
fn curva(x: f64, d: f64) -> f64 { x * (1.0 + d * (1.0 - x)) }

fn main() -> i64 with IO, Mut, Div, Panic {
    let eps: f64 = 1.0
    var falhas: i64 = 0

    // ── 1. UNICIDADE DA SOLUCAO DIAGONAL. Conta quantos a na malha tem a∘a cruzando 1.
    var travessias: i64 = 0
    var i: i64 = 1
    while i < 900 {
        let a1 = (i as f64) / 1000.0
        let a2 = ((i + 1) as f64) / 1000.0
        if op(a1, a1, eps) < 1.0 && op(a2, a2, eps) >= 1.0 { travessias = travessias + 1 }
        i = i + 1
    }
    print("DIAGONAL_TRAVESSIAS "); print_int(travessias)
    if travessias != 1 { println("FALHA: a solucao diagonal nao e unica"); falhas = falhas + 1 }

    let a_star = 1.0 / (2.0 + eps / 2.0)
    print("A_ESTRELA_MILESIMOS "); print_int((a_star * 1000.0) as i64)

    // ── 2. DILATACOES: alpha(x) = lam*x preserva ∘ por homogeneidade, mas preserva o TETO?
    //     Se a∘b = 1 entao alpha(a)∘alpha(b) = lam*1 = lam, que so vale 1 se lam = 1.
    //     Testa lam != 1 e confirma que o teto quebra.
    var quebras_teto: i64 = 0
    var lam_i: i64 = 5
    while lam_i < 20 {
        if lam_i != 10 {
            let lam = (lam_i as f64) / 10.0
            // par que aniquila: (a*, a*)
            let img = op(dilata(a_star, lam), dilata(a_star, lam), eps)
            // deveria continuar valendo exatamente 1 para ser automorfismo
            if abs_f64(img - 1.0) > 0.000001 { quebras_teto = quebras_teto + 1 }
        }
        lam_i = lam_i + 1
    }
    print("DILATACOES_TESTADAS "); print_int(14)
    print("DILATACOES_QUE_QUEBRAM_O_TETO "); print_int(quebras_teto)
    if quebras_teto != 14 { println("FALHA: alguma dilatacao != 1 preservou o teto"); falhas = falhas + 1 }

    // ── 3. FAMILIA NAO-LINEAR: alpha(x) = x(1 + d(1-x)), estritamente crescente em (0,1) para
    //     d pequeno, fixa 1. Ela preserva a OPERACAO? Testa a identidade alpha(a∘b) =
    //     alpha(a)∘alpha(b) numa malha, para d != 0.
    var d_i: i64 = 1
    var familias_que_preservam: i64 = 0
    while d_i < 6 {
        let d = (d_i as f64) / 20.0
        var viol: i64 = 0
        var p: i64 = 1
        while p < 20 {
            var q: i64 = 1
            while q < 20 {
                let a = (p as f64) / 100.0
                let b = (q as f64) / 100.0
                let v = op(a, b, eps)
                if v < 1.0 {
                    let esq = curva(v, d)
                    let dir = op(curva(a, d), curva(b, d), eps)
                    if abs_f64(esq - dir) > 0.000001 { viol = viol + 1 }
                }
                q = q + 1
            }
            p = p + 1
        }
        if viol == 0 { familias_que_preservam = familias_que_preservam + 1 }
        d_i = d_i + 1
    }
    print("NAO_LINEARES_TESTADAS "); print_int(5)
    print("NAO_LINEARES_QUE_PRESERVAM_A_OPERACAO "); print_int(familias_que_preservam)
    if familias_que_preservam != 0 {
        println("ATENCAO: apareceu candidato a automorfismo nao-identidade")
        falhas = falhas + 1
    }

    // ── 4. CONTROLE: a identidade preserva tudo. Se este falhar, o teste esta errado.
    var viol_id: i64 = 0
    var p2: i64 = 1
    while p2 < 20 {
        var q2: i64 = 1
        while q2 < 20 {
            let a = (p2 as f64) / 100.0
            let b = (q2 as f64) / 100.0
            let v = op(a, b, eps)
            if v < 1.0 {
                if abs_f64(v - op(a, b, eps)) > 0.000001 { viol_id = viol_id + 1 }
            }
            q2 = q2 + 1
        }
        p2 = p2 + 1
    }
    print("CONTROLE_IDENTIDADE_VIOLACOES "); print_int(viol_id)
    if viol_id != 0 { falhas = falhas + 1 }

    if falhas == 0 { println("automorfismos: MODELO RIGIDO") } else { println("automorfismos: FAIL") }
    falhas
}
