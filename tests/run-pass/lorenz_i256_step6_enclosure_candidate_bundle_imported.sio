//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-6 enclosure candidate bundle keeps partial-status guard public

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step6_enclosure_candidate_bundle_check(
        134624236, 237534229, 516981885, 15, 7, 8, 3)
    if artifact_fp != 947760031 { return 1 }

    let audit_fp = lorenz_i256_step6_enclosure_candidate_bundle_audit_fingerprint(
        artifact_fp, 425169956, 54004840, 516981885, 506104143, 6, 4, 127)
    if audit_fp != 982064907 { return 2 }
    return 0
}
