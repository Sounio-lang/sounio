    audit_fp = mix(audit_fp, 731697967, 4289)
    audit_fp = mix(audit_fp, 6, 4289)
    audit_fp = mix(audit_fp, 12, 4289)
    audit_fp = mix(audit_fp, 255, 4289)
    if audit_fp != 79381760 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 65, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 65, 1103)
    if entry_fp != 274272622 { return 3 }

    let manifest_fp: i64 = 806638802
