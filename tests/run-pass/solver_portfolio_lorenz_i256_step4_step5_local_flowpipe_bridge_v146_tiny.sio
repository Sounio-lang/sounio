    audit = mix(audit, 880867663, 6121)
    audit = mix(audit, 674753000, 6121)
    audit = mix(audit, 494170390, 6121)
    audit = mix(audit, 781321526, 6121)
    audit = mix(audit, 258802509, 6121)
    audit = mix(audit, 583092751, 6121)
    audit = mix(audit, 2491648, 6121)
    audit = mix(audit, 737039167, 6121)
    audit = mix(audit, 753371133, 6121)
    audit = mix(audit, 23144051, 6121)
    audit = mix(audit, 561641681, 6121)
    audit = mix(audit, 4, 6121)
    audit = mix(audit, 5, 6121)
    audit = mix(audit, 17, 6121)
    audit = mix(audit, 255, 6121)
    if audit != 876128531 { return 2 }

    var entry: i64 = 101
    entry = mix(entry, 149, 1103)
    entry = mix(entry, receipt, 1103)
    entry = mix(entry, audit, 1103)
    entry = mix(entry, 1, 1103)
    entry = mix(entry, 149, 1103)
    if entry != 654864830 { return 3 }

    var manifest: i64 = 107
    manifest = mix(manifest, 146, 1151)
    manifest = mix(manifest, 150, 1151)
    manifest = mix(manifest, 906661736, 1151)
    manifest = mix(manifest, 422116880, 1151)
    manifest = mix(manifest, entry, 1151)
    if manifest != 139046199 { return 4 }

    var result: i64 = 131
    result = mix(result, 146, 1871)
    result = mix(result, 150, 1871)
    result = mix(result, 10, 1871)
    result = mix(result, 138, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, manifest, 1871)
    if result != 579336677 { return 5 }

    var family: i64 = 149
    family = mix(family, 146, 1907)
    family = mix(family, 150, 1907)
    family = mix(family, 6, 1907)
    family = mix(family, 4, 1907)
    family = mix(family, 3, 1907)
    family = mix(family, 2, 1907)
    family = mix(family, 133, 1907)
    family = mix(family, 2, 1907)
    family = mix(family, manifest, 1907)
    if family != 949351674 { return 6 }

    var acceptance: i64 = 137
    acceptance = mix(acceptance, 146, 1889)
    acceptance = mix(acceptance, manifest, 1889)
    acceptance = mix(acceptance, result, 1889)
    if acceptance != 412537629 { return 7 }

    var audit_receipt: i64 = 157
    audit_receipt = mix(audit_receipt, 146, 1931)
    audit_receipt = mix(audit_receipt, manifest, 1931)
    audit_receipt = mix(audit_receipt, result, 1931)
    audit_receipt = mix(audit_receipt, family, 1931)
    audit_receipt = mix(audit_receipt, acceptance, 1931)
    if audit_receipt != 652056951 { return 8 }

    var readiness: i64 = 163
    readiness = mix(readiness, 146, 1951)
    readiness = mix(readiness, 31, 1951)
    readiness = mix(readiness, manifest, 1951)
    readiness = mix(readiness, result, 1951)
    readiness = mix(readiness, family, 1951)
    readiness = mix(readiness, acceptance, 1951)
    readiness = mix(readiness, audit_receipt, 1951)
    if readiness != 514521290 { return 9 }
    return 0
