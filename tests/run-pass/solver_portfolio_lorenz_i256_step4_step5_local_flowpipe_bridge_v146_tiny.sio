    receipt = mix(receipt, 804311422, 6113)
    receipt = mix(receipt, 258802509, 6113)
    receipt = mix(receipt, 583092751, 6113)
    receipt = mix(receipt, 737039167, 6113)
    receipt = mix(receipt, 753371133, 6113)
    receipt = mix(receipt, 23144051, 6113)
    receipt = mix(receipt, 561641681, 6113)
    receipt = mix(receipt, 4, 6113)
    receipt = mix(receipt, 5, 6113)
    receipt = mix(receipt, 17, 6113)
    receipt = mix(receipt, 255, 6113)
    if receipt != 984096488 { return 1 }

    var audit: i64 = 2089
