//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v146 smoke for Lorenz i256 step-4-to-step-5 local-flowpipe bridge

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt: i64 = 2087
    receipt = mix(receipt, 880867663, 6113)
    receipt = mix(receipt, 674753000, 6113)
    receipt = mix(receipt, 95709658, 6113)
    receipt = mix(receipt, 663928611, 6113)
