//@ run-pass
//@ requires: madaros
//@ expect-stdout: SIGN_OK
// What leaves a contest is one Knowledge. Its variance is the shared
// interval only. An empty intersection leaves a wider bar, not a point.

use epistemic::sign::{sign_knowledge, sign_interval, relative_half_width, inside_window}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let wide: Knowledge<f64> = measure(10.0, uncertainty: 2.0)
    let tight: Knowledge<f64> = measure(10.5, uncertainty: 0.5)
    let left = sign_knowledge(wide, tight)
    let v_left = variance_of(left.value)
    let apart_a: Knowledge<f64> = measure(0.0, uncertainty: 1.0)
    let apart_b: Knowledge<f64> = measure(10.0, uncertainty: 1.0)
    let apart = sign_interval(0.0, 1.0, 10.0, 1.0)
    let left_apart = sign_knowledge(apart_a, apart_b)
    let v_apart = variance_of(left_apart.value)
    print("left ")
    print_f64(v_left)
    print(" apart ")
    print_f64(v_apart)
    print("\n")
    let rel = relative_half_width(left)
    let rel_apart = relative_half_width(left_apart)
    if near(v_left, 0.25, 0.0001) && v_left < 4.0 && !apart.agreed && v_apart > 1.0 && near(rel, 0.5 / 10.5, 0.0001) && inside_window(left, 10.0, 11.0) && !inside_window(left, 10.2, 10.8) && rel_apart > 1.0 {
        println("SIGN_OK")
        return 0
    }
    println("SIGN_FAIL")
    1
}
