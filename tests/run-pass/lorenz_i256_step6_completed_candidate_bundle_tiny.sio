//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 completed candidate bundle keeps validation separate

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 439
    fp = mix(fp, 6, 3701)
    fp = mix(fp, 506104143, 3701)
    fp = mix(fp, 956295573, 3701)
    fp = mix(fp, 134624236, 3701)
    fp = mix(fp, 643317565, 3701)
    fp = mix(fp, 237534229, 3701)
    fp = mix(fp, 931365823, 3701)
    fp = mix(fp, 516981885, 3701)
    fp = mix(fp, 989033159, 3701)
    fp = mix(fp, 652877359, 3701)
    fp = mix(fp, 344816971, 3701)
    fp = mix(fp, 15, 3701)
    fp = mix(fp, 15, 3701)
    fp = mix(fp, 0, 3701)
    fp = mix(fp, 4, 3701)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 175122911 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 443
    fp = mix(fp, instance, 3719)
    fp = mix(fp, 4, 3719)
    fp = mix(fp, 4, 3719)
    fp = mix(fp, 4, 3719)
    fp = mix(fp, 0, 3719)
    fp = mix(fp, 15, 3719)
    fp = mix(fp, 0, 3719)
    fp = mix(fp, 0, 3719)
    fp = mix(fp, ok_mask, 3719)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 175122911 { return 0 - 1 }
    if certificate != 425699291 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 449
    fp = mix(fp, instance, 3733)
    fp = mix(fp, certificate, 3733)
    fp = mix(fp, 4, 3733)
    fp = mix(fp, 6, 3733)
    fp = mix(fp, 15, 3733)
    fp = mix(fp, 0, 3733)
    fp = mix(fp, 4, 3733)
    fp = mix(fp, ok_mask, 3733)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 641464796 { return 0 - 1 }
    if instance != 175122911 { return 0 - 1 }
    if certificate != 425699291 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 457
    fp = mix(fp, artifact, 3761)
    fp = mix(fp, instance, 3761)
    fp = mix(fp, certificate, 3761)
    fp = mix(fp, 516981885, 3761)
    fp = mix(fp, 652877359, 3761)
    fp = mix(fp, 506104143, 3761)
    fp = mix(fp, 6, 3761)
    fp = mix(fp, 4, 3761)
    fp = mix(fp, ok_mask, 3761)
    return fp
}

fn completed_mask() -> i64 {
    let required_mask: i64 = 15
    let provided_mask: i64 = 15
    let missing_mask: i64 = 0
    let complete_status: i64 = 4
    let validated_mask: i64 = 0

    var ok_mask: i64 = 0
    if 134624236 > 0 {
        if 237534229 > 0 {
            if 516981885 > 0 {
                if 652877359 > 0 { ok_mask = ok_mask + 1 }
            }
        }
    }
    if 134624236 != 237534229 {
        if 516981885 != 652877359 { ok_mask = ok_mask + 2 }
    }
    if missing_mask == required_mask - provided_mask { ok_mask = ok_mask + 4 }
    if 4 == 4 {
        if 0 == 0 { ok_mask = ok_mask + 8 }
    }
    if complete_status == 4 {
        if missing_mask == 0 { ok_mask = ok_mask + 16 }
    }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if provided_mask == required_mask {
        if provided_mask + missing_mask == required_mask { ok_mask = ok_mask + 64 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = completed_mask()
    if ok_mask != 127 { return 1 }
    let inst = instance_fp()
    if inst != 175122911 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 425699291 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 641464796 { return 4 }
    if audit_fp(art, inst, cert, ok_mask) != 222156824 { return 5 }
    if certificate_fp(inst, 126) != (0 - 1) { return 6 }
    return 0
}
