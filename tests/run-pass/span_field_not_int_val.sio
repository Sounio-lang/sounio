//@ run-pass
//@ expect-stdout: SPAN_IDX_PASS

// Witness for the gen3 null-handle ud2 (file 0x34e5efd / #2966).
//
// An untyped `.span` used to first-match whatever layout was registered
// first, then (after unanimous consensus) hashed to 51 because SessionStep
// (span@2) and AuditSection (span@3) vetoed the AST majority at 1. Field 51
// is past Expr's payload, so the load was 0 and the next field-get hit the
// #2979 null-handle ud2. Named layouts must keep `.span` at 1 for a Node and
// at 2 for Other; untyped lookup uses the kind-tagged majority (still 1).

struct Other { a: i64, b: i64, span: i64 }
struct Node { kind: i64, span: i64 }

fn node_span(n: Node) -> i64 {
    n.span
}

fn other_span(o: Other) -> i64 {
    o.span
}

fn main() -> i64 with IO {
    let n = Node { kind: 6, span: 42 }
    let o = Other { a: 1, b: 2, span: 99 }
    var nodes: [Node; 1] = [Node { kind: 6, span: 17 }]
    print("n.span="); print_int(node_span(n)); print("\n")
    print("o.span="); print_int(other_span(o)); print("\n")
    print("nodes[0].span="); print_int(nodes[0].span); print("\n")
    if node_span(n) == 42 && other_span(o) == 99 && nodes[0].span == 17 {
        print("SPAN_IDX_PASS\n")
        0
    } else {
        print("SPAN_IDX_FAIL\n")
        1
    }
}
