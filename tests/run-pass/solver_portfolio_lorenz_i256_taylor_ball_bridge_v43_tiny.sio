//@ run-pass
//@ description: Tiny portfolio v43 smoke for Lorenz i256 Taylor/ball bridge entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 487
    receipt_fp = mix(receipt_fp, 979362768, 2939)
    receipt_fp = mix(receipt_fp, 927174126, 2939)
    receipt_fp = mix(receipt_fp, 389121447, 2939)
    receipt_fp = mix(receipt_fp, 731723710, 2939)
    receipt_fp = mix(receipt_fp, 845057161, 2939)
    receipt_fp = mix(receipt_fp, 584513793, 2939)
    receipt_fp = mix(receipt_fp, 2, 2939)
    receipt_fp = mix(receipt_fp, 127, 2939)
    if receipt_fp != 609891562 { return 1 }

    var audit_fp: i64 = 491
    audit_fp = mix(audit_fp, receipt_fp, 2953)
    audit_fp = mix(audit_fp, 979362768, 2953)
    audit_fp = mix(audit_fp, 927174126, 2953)
    audit_fp = mix(audit_fp, 725222703, 2953)
    audit_fp = mix(audit_fp, 845057161, 2953)
    audit_fp = mix(audit_fp, 584513793, 2953)
    audit_fp = mix(audit_fp, 2, 2953)
    audit_fp = mix(audit_fp, 127, 2953)
    if audit_fp != 519708695 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 46, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 46, 1103)
    if entry_fp != 862964893 { return 3 }

    if audit_fp == 519708696 { return 4 }
    return 0
}
