//@ run-pass
//@ description: #2218 -- a tuple-returned [f64; N] keeps its f64 element typing next to a scalar element
//@ expect-stdout-contains: dc0*1e6=2000000.000000
//@ expect-stdout-contains: TUPLE_SCALAR_F64_ARRAY_2218_OK

fn rhs(t: f64) -> (f64, [f64; 2]) {
    let arr: [f64; 2] = [2.0, 3.0]
    (t, arr)
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let (dt, dc) = rhs(2.0)
    print("dt=");        println(dt)
    print("dc0=");       println(dc[0])
    print("dc0*1e6=");   println(dc[0] * 1.0e6)
    let plain: f64 = 2.0
    print("plain*1e6="); println(plain * 1.0e6)
    if dt == 2.0 && dc[0] * 1.0e6 == 2000000.0 && dc[1] + 0.5 == 3.5 {
        println("TUPLE_SCALAR_F64_ARRAY_2218_OK")
    } else {
        println("TUPLE_SCALAR_F64_ARRAY_2218_FAIL")
    }
    0
}
