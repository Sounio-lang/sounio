//@ run-pass
//@ requires: madaros
//@ expect-stdout: 9
//@ description: FX-8 a handler with nine clauses dispatches the ninth (runtime scratch lives above the clause table) (SIO-417)
//@ semantic-lane: SPEC-07-7.4-FX-8

effect Big { fn o1() -> i64 fn o2() -> i64 fn o3() -> i64 fn o4() -> i64 fn o5() -> i64 fn o6() -> i64 fn o7() -> i64 fn o8() -> i64 fn o9() -> i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<Big> { perform Big.o9() } with {
        on o1() -> 1 on o2() -> 2 on o3() -> 3 on o4() -> 4 on o5() -> 5 on o6() -> 6 on o7() -> 7 on o8() -> 8 on o9() -> 9
    }
    println(r)
    0
}
