//@ run-pass
//@ expect-stdout: HALO PGX GATE PASS

// Dissertation contribution: compile-time PGx confidence gate — PASS path.
//
// `prescribe_haloperidol` is annotated `with Confidence(750)`. Per the compiler's
// EpistemicComplete gate, every expression inside the body must carry compile-time
// confidence ≥ 750/1000.
//
// `measure(40.0, uncertainty: 1.6)` yields confidence = 1 − 1.6/40.0 = 0.96
// = 960/1000, which EXCEEDS the 750 threshold. The compiler emits binary code.
//
// Clinical narrative: post-CYP2D6 genotyping with activity score confirms NM
// phenotype. The star-allele call (e.g., *1/*1) reduces CL uncertainty to ±4%
// (measurement CV), well above the Confidence(750) threshold. The program
// compiles — prescribing is authorised.

fn prescribe_haloperidol(cl_l_h: f64, dose_target_ng_ml: f64) -> f64 with Mut, Div, Confidence(750) {
    let f_oral:  f64 = 0.65
    let tau_h:   f64 = 24.0
    let target_mg_l = dose_target_ng_ml * 1.0e-3
    target_mg_l * cl_l_h * tau_h / f_oral
}

// Confidence(750) is the PGx compile-time gate; Epistemic is required to read
// Knowledge.value under Madaros (E170). Confidence ≠ unwrap permission —
// lean_single under-enforces this; do not weaken Madaros to match.
fn main() with IO, Mut, Div, Panic, Confidence(750), Epistemic {
    // Post-genotyping: NM phenotype confirmed (activity score = 1.0).
    // CL = 40 L/h ± 1.6 (CV = 4%) from pharmacogenomic-guided population estimate.
    // confidence = 1 − 1.6/40.0 = 0.96 = 960/1000 > 750.  COMPILE PASSES.
    let k_cl: Knowledge<f64> = measure(40.0, uncertainty: 1.6)
    let cl = k_cl.value
    let dose_mg = prescribe_haloperidol(cl, 5.0)
    print("dose_mg = ")
    print_f64(dose_mg)
    println("")
    println("HALO PGX GATE PASS")
}
