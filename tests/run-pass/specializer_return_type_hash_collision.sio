//@ run-pass
//@ requires: madaros
//@ expect-stdout: 99
// The specializer's return-type cache (SPEC_RT_HASH/SPEC_RT_TYPE, populated by
// spec_collect_return_types) stored only ast_name_hash(fn.name), not the name
// itself -- the same gap already fixed for the inference scope and the emitted-
// instance cache. `az` and `bY` are both two-letter names with the same DJB2
// hash. Both are recorded, `az` first (declared first); a hash-only lookup of
// EITHER name then finds `az`'s entry, since the search walks forward from
// index 0 and stops at the first hash match. `identify(bY())` -- a turbofish-
// less generic call inferring its type argument from bY()'s call-expression
// return type -- resolved to StructA (az's return type) instead of StructB on
// the pre-patch compiler, instantiating the wrong generic clone entirely.

struct StructA { a_field: i64 }
struct StructB { b_field: i64 }

fn az() -> StructA { StructA { a_field: 42 } }
fn bY() -> StructB { StructB { b_field: 99 } }

fn identify<T>(x: T) -> T { x }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let result = identify(bY())
    print_int(result.b_field)
    print("\n")
    0
}
