    audit_fp = mix(audit_fp, 5, 4831)
    audit_fp = mix(audit_fp, 1, 4831)
    audit_fp = mix(audit_fp, 255, 4831)
    if audit_fp != 333354824 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 74, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 74, 1103)
    if entry_fp != 826588480 { return 3 }

    let manifest_fp: i64 = 257446237
