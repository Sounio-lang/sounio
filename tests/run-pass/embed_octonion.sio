//@ run-pass
//
// Native-stage mirror for the OCSSM embed smoke. The import-bearing version is
// preserved under tests/madaros/ocssm_imported/ until Madaros/import-aware
// execution is wired into the full suite.

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn embed_axis(hash: i64) -> i64 {
    let r: i64 = hash - (hash / 7) * 7
    return 1 + r
}

fn embed_into(hash: i64, out: &![f64; 8]) with Mut {
    var i: i64 = 0
    while i < 8 {
        out[i as usize] = 0.0
        i = i + 1
    }
    out[0] = 0.6
    out[embed_axis(hash) as usize] = 0.8
}

fn norm_sq(v: &[f64; 8]) -> f64 {
    return v[0]*v[0] + v[1]*v[1] + v[2]*v[2] + v[3]*v[3]
         + v[4]*v[4] + v[5]*v[5] + v[6]*v[6] + v[7]*v[7]
}

fn diff_sq(a: &[f64; 8], b: &[f64; 8]) -> f64 with Mut {
    var s: f64 = 0.0
    var i: i64 = 0
    while i < 8 {
        let d: f64 = a[i as usize] - b[i as usize]
        s = s + d * d
        i = i + 1
    }
    return s
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var v_a: [f64; 8] = [0.0; 8]
    var v_b: [f64; 8] = [0.0; 8]
    var v_c: [f64; 8] = [0.0; 8]

    embed_into(42, &!v_a)
    embed_into(42, &!v_b)
    embed_into(43, &!v_c)

    var ok: i64 = 1
    if diff_sq(&v_a, &v_b) > 0.000000001 { ok = 0 }
    if abs_f64(norm_sq(&v_a) - 1.0) > 0.000001 { ok = 0 }
    if abs_f64(norm_sq(&v_c) - 1.0) > 0.000001 { ok = 0 }
    if diff_sq(&v_a, &v_c) < 0.001 { ok = 0 }

    if ok == 1 { print("PASS\n") } else { print("FAIL\n") }
    return 0
}
