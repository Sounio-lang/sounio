//@ run-pass
//@ expect-stdout: VIZ_AD_ECDF_PASS
//@ expect-stdout: synthetic n=20
//@ expect-stdout: fitted normal CDF
//@ expect-stdout: approximate p; no confidence band
use stats::anderson_darling::{anderson_darling}
use math::pure::{sqrt}
use special::igamma::{igamma_upper}
use viz::axis::{axis_label}
use viz::ir::{viz_scene_new,viz_add_line_chart,viz_add_axis,viz_line_set_viewport,
 viz_add_label,viz_node_set_label,viz_add_series_legend,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var sample:[f64;256]=[0.0;256]
 var xs:[f64;1024]=[0.0;1024]
 var ecdf:[f64;1024]=[0.0;1024]
 var normal:[f64;1024]=[0.0;1024]
 var i:i64=0
 while i<20 {
  sample[i as usize]=i as f64
  let z=((i as f64)-9.5)/sqrt(35.0)
  let tail=0.5*igamma_upper(0.5,0.5*z*z)
  let f=if z<0.0 {tail} else {1.0-tail}
  xs[(2*i) as usize]=i as f64
  xs[(2*i+1) as usize]=i as f64
  ecdf[(2*i) as usize]=(i as f64)/20.0
  ecdf[(2*i+1) as usize]=((i+1) as f64)/20.0
  normal[(2*i) as usize]=f
  normal[(2*i+1) as usize]=f
  i=i+1
 }
 let r=anderson_darling(&sample,20)
 assert(r.status==0 && r.a2>0.22073784165 && r.a2<0.22073784167)
 assert(r.p>0.8063550612 && r.p<0.8063550615)
 var scene=viz_scene_new()
 let empirical=viz_add_line_chart(&!scene,&xs,&ecdf,40,viz_layout_rect(140,110,600,220),viz_style_rgb(70,180,235))
 let fitted=viz_add_line_chart(&!scene,&xs,&normal,40,viz_layout_rect(140,110,600,220),viz_style_rgb(245,170,65))
 assert(viz_line_set_viewport(&!scene,empirical,0.0,20.0,0.0,1.0))
 assert(viz_line_set_viewport(&!scene,fitted,0.0,20.0,0.0,1.0))
 let xa=viz_add_axis(&!scene,0.0,20.0,4,false,viz_layout_rect(140,348,600,1),viz_style_rgb(190,200,215))
 let ya=viz_add_axis(&!scene,0.0,1.0,4,true,viz_layout_rect(120,110,1,220),viz_style_rgb(190,200,215))
 var title:[i8;64]=[0;64]
 title[0]=65
 title[1]=110
 title[2]=100
 title[3]=101
 title[4]=114
 title[5]=115
 title[6]=111
 title[7]=110
 title[8]=45
 title[9]=68
 title[10]=97
 title[11]=114
 title[12]=108
 title[13]=105
 title[14]=110
 title[15]=103
 title[16]=32
 title[17]=69
 title[18]=67
 title[19]=68
 title[20]=70
 title[21]=32
 title[22]=45
 title[23]=32
 title[24]=115
 title[25]=121
 title[26]=110
 title[27]=116
 title[28]=104
 title[29]=101
 title[30]=116
 title[31]=105
 title[32]=99
 title[33]=32
 title[34]=110
 title[35]=61
 title[36]=50
 title[37]=48

 var subtitle:[i8;64]=[0;64]
 subtitle[0]=70
 subtitle[1]=105
 subtitle[2]=116
 subtitle[3]=116
 subtitle[4]=101
 subtitle[5]=100
 subtitle[6]=32
 subtitle[7]=110
 subtitle[8]=111
 subtitle[9]=114
 subtitle[10]=109
 subtitle[11]=97
 subtitle[12]=108
 subtitle[13]=58
 subtitle[14]=32
 subtitle[15]=115
 subtitle[16]=97
 subtitle[17]=109
 subtitle[18]=112
 subtitle[19]=108
 subtitle[20]=101
 subtitle[21]=32
 subtitle[22]=109
 subtitle[23]=101
 subtitle[24]=97
 subtitle[25]=110
 subtitle[26]=32
 subtitle[27]=97
 subtitle[28]=110
 subtitle[29]=100
 subtitle[30]=32
 subtitle[31]=115
 subtitle[32]=97
 subtitle[33]=109
 subtitle[34]=112
 subtitle[35]=108
 subtitle[36]=101
 subtitle[37]=32
 subtitle[38]=83
 subtitle[39]=68

 var xn:[i8;64]=[0;64]
 xn[0]=115
 xn[1]=97
 xn[2]=109
 xn[3]=112
 xn[4]=108
 xn[5]=101
 xn[6]=32
 xn[7]=118
 xn[8]=97
 xn[9]=108
 xn[10]=117
 xn[11]=101

 var yn:[i8;64]=[0;64]
 yn[0]=99
 yn[1]=117
 yn[2]=109
 yn[3]=117
 yn[4]=108
 yn[5]=97
 yn[6]=116
 yn[7]=105
 yn[8]=118
 yn[9]=101
 yn[10]=32
 yn[11]=112
 yn[12]=114
 yn[13]=111
 yn[14]=98
 yn[15]=97
 yn[16]=98
 yn[17]=105
 yn[18]=108
 yn[19]=105
 yn[20]=116
 yn[21]=121

 var lg:[i8;64]=[0;64]
 lg[0]=101
 lg[1]=109
 lg[2]=112
 lg[3]=105
 lg[4]=114
 lg[5]=105
 lg[6]=99
 lg[7]=97
 lg[8]=108
 lg[9]=32
 lg[10]=67
 lg[11]=68
 lg[12]=70

 var fit:[i8;64]=[0;64]
 fit[0]=102
 fit[1]=105
 fit[2]=116
 fit[3]=116
 fit[4]=101
 fit[5]=100
 fit[6]=32
 fit[7]=110
 fit[8]=111
 fit[9]=114
 fit[10]=109
 fit[11]=97
 fit[12]=108
 fit[13]=32
 fit[14]=67
 fit[15]=68
 fit[16]=70

 var foot:[i8;64]=[0;64]
 foot[0]=83
 foot[1]=116
 foot[2]=101
 foot[3]=112
 foot[4]=104
 foot[5]=101
 foot[6]=110
 foot[7]=115
 foot[8]=32
 foot[9]=97
 foot[10]=112
 foot[11]=112
 foot[12]=114
 foot[13]=111
 foot[14]=120
 foot[15]=105
 foot[16]=109
 foot[17]=97
 foot[18]=116
 foot[19]=101
 foot[20]=32
 foot[21]=112
 foot[22]=59
 foot[23]=32
 foot[24]=110
 foot[25]=111
 foot[26]=32
 foot[27]=99
 foot[28]=111
 foot[29]=110
 foot[30]=102
 foot[31]=105
 foot[32]=100
 foot[33]=101
 foot[34]=110
 foot[35]=99
 foot[36]=101
 foot[37]=32
 foot[38]=98
 foot[39]=97
 foot[40]=110
 foot[41]=100

 viz_node_set_label(&!scene,xa,&xn,12)
 viz_node_set_label(&!scene,ya,&yn,22)
 assert(viz_add_label(&!scene,&title,38,viz_layout_rect(140,20,600,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&subtitle,40,viz_layout_rect(140,48,600,20),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_series_legend(&!scene,empirical,&lg,13,viz_layout_rect(140,400,280,22))>=0)
 assert(viz_add_series_legend(&!scene,fitted,&fit,17,viz_layout_rect(470,400,270,22))>=0)
 assert(viz_add_label(&!scene,&foot,42,viz_layout_rect(140,436,600,14),viz_style_rgb(190,200,215))>=0)
 let av=axis_label(r.a2)
 let pv=axis_label(r.p)
 var at:[i8;64]=[0;64]
 var pt:[i8;64]=[0;64]
 at[0]=65;at[1]=50;at[2]=61;pt[0]=112;pt[1]=61
 i=0
 while i<av.n {at[(i+3) as usize]=av.text[i as usize];i=i+1}
 i=0
 while i<pv.n {pt[(i+2) as usize]=pv.text[i as usize];i=i+1}
 assert(viz_add_label(&!scene,&at,av.n+3,viz_layout_rect(140,74,280,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&pt,pv.n+2,viz_layout_rect(470,74,280,20),viz_style_rgb(230,235,245))>=0)
 assert(scene.node_count==11 && scene.series_count==2)
 let pixels=heap_alloc(920*450*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:920,height:450}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,330*920+118)==190*65536+200*256+215)
 viz_html_emit_scene(&scene,920,450)
 println("VIZ_AD_ECDF_PASS")
 0
}
