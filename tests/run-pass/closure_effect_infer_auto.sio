//@ run-pass
//@ expect-stdout: inferred IO PASS
// Closure body effect inference: body calling IO functions auto-infers `with IO`.
// The closure needs no explicit annotation — the compiler derives it from body analysis.

fn apply_io(f: fn(i64) -> i64 with IO, x: i64) -> i64 with IO { f(x) }

fn print_val(x: i64) with IO { print_int(x) }

fn main() -> i32 with IO, Mut {
    // No 'with IO' annotation on closure — inferred from print call in body
    let log_and_add = |x: i64| -> i64 { print("body\n"); x + 1 }
    let r = apply_io(log_and_add, 9)
    if r == 10 { print("inferred IO PASS\n") }

    // Nested inference: closure calling a named fn with IO
    let log2 = |x: i64| -> i64 { print_val(x); x * 2 }
    let r2 = apply_io(log2, 5)
    if r2 == 10 { print("named fn IO PASS\n") }

    0
}
