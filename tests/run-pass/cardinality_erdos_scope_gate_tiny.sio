//@ run-pass
//@ requires: madaros
//@ description: Scalar Erdős/Hadwiger-Nelson graph-colouring scope gate

fn graph_mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn scope_k3_not_2_colourable() -> i64 { return 3202 }
fn scope_hadwiger_nelson_chi_ge_6() -> i64 { return 5086 }
fn erdos_hadwiger_nelson_id() -> i64 { return 508 }
fn erdos_unit_distance_count_id() -> i64 { return 90 }

fn current_unsat_scope_fingerprint(scope_code: i64,
                                   erdos_problem_id: i64,
                                   vertex_count: i64,
                                   edge_count: i64,
                                   colour_count: i64,
                                   graph_instance_fingerprint: i64,
                                   unsat_claim_fingerprint: i64,
                                   unit_distance_graph_flag: i64,
                                   independent_replay_mask: i64) -> i64 {
    if scope_code != scope_k3_not_2_colourable() { return 0 - 1 }
    if erdos_problem_id != 0 { return 0 - 1 }
    if vertex_count != 3 { return 0 - 1 }
    if edge_count != 3 { return 0 - 1 }
    if colour_count != 2 { return 0 - 1 }
    if graph_instance_fingerprint != 77085393 { return 0 - 1 }
    if unsat_claim_fingerprint != 848522370 { return 0 - 1 }
    if unit_distance_graph_flag != 0 { return 0 - 1 }
    if independent_replay_mask != 15 { return 0 - 1 }

    var acc: i64 = 47
    acc = graph_mix(acc, scope_code, 479)
    acc = graph_mix(acc, erdos_problem_id, 479)
    acc = graph_mix(acc, vertex_count, 479)
    acc = graph_mix(acc, edge_count, 479)
    acc = graph_mix(acc, colour_count, 479)
    acc = graph_mix(acc, graph_instance_fingerprint, 479)
    acc = graph_mix(acc, unsat_claim_fingerprint, 479)
    acc = graph_mix(acc, unit_distance_graph_flag, 479)
    acc = graph_mix(acc, independent_replay_mask, 479)
    return acc
}

fn hadwiger_nelson_chi6_preflight(erdos_problem_id: i64,
                                  claimed_lower_bound: i64,
                                  vertex_count: i64,
                                  edge_count: i64,
                                  colour_count_for_unsat: i64,
                                  concrete_unit_distance_graph: i64,
                                  graph_instance_fingerprint: i64,
                                  unsat_claim_fingerprint: i64,
                                  independent_replay_mask: i64) -> i64 {
    if erdos_problem_id != erdos_hadwiger_nelson_id() { return 0 }
    if claimed_lower_bound != 6 { return 0 }
    if vertex_count <= 0 { return 0 }
    if edge_count <= 0 { return 0 }
    if colour_count_for_unsat != 5 { return 0 }
    if concrete_unit_distance_graph != 1 { return 0 }
    if graph_instance_fingerprint <= 0 { return 0 }
    if unsat_claim_fingerprint <= 0 { return 0 }
    if independent_replay_mask != 31 { return 0 }
    return 1
}

fn main() -> i64 {
    let scope_fp = current_unsat_scope_fingerprint(
        3202, 0, 3, 3, 2, 77085393, 848522370, 0, 15)
    if scope_fp != 37553010 { return 1 }
    if scope_k3_not_2_colourable() != 3202 { return 2 }
    if scope_hadwiger_nelson_chi_ge_6() != 5086 { return 3 }
    if erdos_hadwiger_nelson_id() != 508 { return 4 }
    if erdos_unit_distance_count_id() != 90 { return 5 }

    if current_unsat_scope_fingerprint(
        5086, 508, 3, 3, 2, 77085393, 848522370, 0, 15) != (0 - 1) { return 6 }
    if current_unsat_scope_fingerprint(
        3202, 0, 3, 3, 5, 77085393, 848522370, 0, 15) != (0 - 1) { return 7 }
    if hadwiger_nelson_chi6_preflight(
        508, 6, 3, 3, 2, 0, 77085393, 848522370, 15) != 0 { return 8 }
    if hadwiger_nelson_chi6_preflight(
        90, 6, 3, 3, 5, 1, 77085393, 848522370, 31) != 0 { return 9 }
    if hadwiger_nelson_chi6_preflight(
        508, 6, 1581, 10000, 5, 1, 123456789, 987654321, 31) != 1 { return 10 }

    return 0
}
