//@ run-pass
//@ expect-stdout: INFORMATIVE_OBSERVATION_DIRECT_CONTROL_PASS
// Synthetic direct-control witness. It has no patient data, dose, diagnosis,
// or clinical action. It proves only the selected nominal receipt boundary.

struct ObservationOpportunityReceipt { protocol_id: i64 }
struct EncounterPresenceReceipt { channel_id: i64 }
struct MeasurementSelectionReceipt { selection_id: i64 }
struct MeasurementActReceipt { act_id: i64 }
struct RecordedMeasurementReceipt { record_id: i64 }
struct ObservationFeatureUseReceipt { feature_id: i64 }
struct ObservationProcessAbstentionReceipt { reason_id: i64 }

fn record_measurement(opportunity: ObservationOpportunityReceipt, presence: EncounterPresenceReceipt, selection: MeasurementSelectionReceipt, act: MeasurementActReceipt) -> RecordedMeasurementReceipt {
    RecordedMeasurementReceipt {
        record_id: opportunity.protocol_id + presence.channel_id + selection.selection_id + act.act_id
    }
}

fn form_prediction_feature(presence: EncounterPresenceReceipt, selection: MeasurementSelectionReceipt) -> ObservationFeatureUseReceipt {
    ObservationFeatureUseReceipt {
        feature_id: presence.channel_id + selection.selection_id
    }
}

fn abstain_for_unresolved_route(opportunity: ObservationOpportunityReceipt) -> ObservationProcessAbstentionReceipt {
    ObservationProcessAbstentionReceipt { reason_id: opportunity.protocol_id + 9000 }
}

fn main() -> i64 {
    let opportunity = ObservationOpportunityReceipt { protocol_id: 10 }
    let presence = EncounterPresenceReceipt { channel_id: 20 }
    let selection = MeasurementSelectionReceipt { selection_id: 30 }
    let act = MeasurementActReceipt { act_id: 40 }
    let measurement = record_measurement(opportunity, presence, selection, act)

    let feature_presence = EncounterPresenceReceipt { channel_id: 20 }
    let feature_selection = MeasurementSelectionReceipt { selection_id: 30 }
    let feature = form_prediction_feature(feature_presence, feature_selection)

    let unresolved_opportunity = ObservationOpportunityReceipt { protocol_id: 10 }
    let abstention = abstain_for_unresolved_route(unresolved_opportunity)

    println(measurement.record_id)
    println(feature.feature_id)
    println(abstention.reason_id)
    println("INFORMATIVE_OBSERVATION_DIRECT_CONTROL_PASS")
    0
}
