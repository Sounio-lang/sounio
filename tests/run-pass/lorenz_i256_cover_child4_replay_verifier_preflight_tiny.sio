//@ run-pass
//@ description: Self-contained Lorenz i256 child-4 replay verifier preflight

fn child4_replay_verifier_preflight_check(
    replay_manifest_fp: i64,
    replay_manifest_audit_fp: i64,
    replay_manifest_status: i64,
    verifier_preflight_status: i64,
    manifest_focused_gate_mask: i64,
    manifest_offload_review_mask: i64,
    verifier_phase_mask: i64,
    verifier_reject_mask: i64,
    replay_execution_mask: i64,
    replay_verified_mask: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    boundary_gluing_proof_mask: i64,
    child4_discharge_mask: i64,
    finite_cover_certificate_mask: i64) -> i64 {
    if replay_manifest_fp != 916482305 { return 0 - 1 }
    if replay_manifest_audit_fp != 274650918 { return 0 - 1 }
    if replay_manifest_status != 90 { return 0 - 1 }
    if verifier_preflight_status != 91 { return 0 - 1 }
    if manifest_focused_gate_mask != 15 { return 0 - 1 }
    if manifest_offload_review_mask != 3 { return 0 - 1 }
    if verifier_phase_mask != 31 { return 0 - 1 }
    if verifier_reject_mask != 63 { return 0 - 1 }
    if replay_execution_mask != 0 { return 0 - 1 }
    if replay_verified_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if child4_discharge_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    return 391742608
}

fn main() -> i64 {
    let artifact = child4_replay_verifier_preflight_check(
        916482305, 274650918, 90, 91, 15, 3, 31, 63, 0, 0, 0, 0, 0, 0, 0)
    if artifact != 391742608 { return 1 }

    let audit_fp: i64 = 650219347
    let instance_fp: i64 = 184903726
    let certificate_fp: i64 = 709561238
    let verifier_dependency_mask: i64 = 31
    let verifier_input_mask: i64 = 31
    let known_failure_mask: i64 = 1
    let full_portfolio_green_mask: i64 = 0
    let heavy_validation_mask: i64 = 0
    let verifier_anchor_mask: i64 = 255
    let verifier_status_mask: i64 = 3
    let verifier_available_phase_mask: i64 = 31
    let verifier_required_input_mask: i64 = 31
    let verifier_required_reject_mask: i64 = 63
    let known_imported_native_lowering_failure_mask: i64 = 1
    let no_full_portfolio_evidence_mask: i64 = 0
    let no_heavy_validation_evidence_mask: i64 = 0
    let replay_not_executed_mask: i64 = 0
    let replay_not_verified_mask: i64 = 0
    let public_theorem_ready_mask: i64 = 0
    let global_promotion_ready_mask: i64 = 0
    let verifier_next_action_mask: i64 = 31
    let ok_mask: i64 = 255

    if audit_fp != 650219347 { return 2 }
    if instance_fp != 184903726 { return 3 }
    if certificate_fp != 709561238 { return 4 }
    if verifier_dependency_mask != 31 { return 5 }
    if verifier_input_mask != 31 { return 6 }
    if known_failure_mask != 1 { return 7 }
    if full_portfolio_green_mask != 0 { return 8 }
    if heavy_validation_mask != 0 { return 9 }
    if verifier_anchor_mask != 255 { return 10 }
    if verifier_status_mask != 3 { return 11 }
    if verifier_available_phase_mask != 31 { return 12 }
    if verifier_required_input_mask != 31 { return 13 }
    if verifier_required_reject_mask != 63 { return 14 }
    if known_imported_native_lowering_failure_mask != 1 { return 15 }
    if no_full_portfolio_evidence_mask != 0 { return 16 }
    if no_heavy_validation_evidence_mask != 0 { return 17 }
    if replay_not_executed_mask != 0 { return 18 }
    if replay_not_verified_mask != 0 { return 19 }
    if public_theorem_ready_mask != 0 { return 20 }
    if global_promotion_ready_mask != 0 { return 21 }
    if verifier_next_action_mask != 31 { return 22 }
    if ok_mask != 255 { return 23 }

    let wrong_manifest = child4_replay_verifier_preflight_check(
        1, 274650918, 90, 91, 15, 3, 31, 63, 0, 0, 0, 0, 0, 0, 0)
    if wrong_manifest != 0 - 1 { return 24 }

    let incomplete_phase = child4_replay_verifier_preflight_check(
        916482305, 274650918, 90, 91, 15, 3, 15, 63, 0, 0, 0, 0, 0, 0, 0)
    if incomplete_phase != 0 - 1 { return 25 }

    let fake_replay_execution = child4_replay_verifier_preflight_check(
        916482305, 274650918, 90, 91, 15, 3, 31, 63, 1, 0, 0, 0, 0, 0, 0)
    if fake_replay_execution != 0 - 1 { return 26 }

    let fake_replay_verified = child4_replay_verifier_preflight_check(
        916482305, 274650918, 90, 91, 15, 3, 31, 63, 0, 1, 0, 0, 0, 0, 0)
    if fake_replay_verified != 0 - 1 { return 27 }

    let fake_public = child4_replay_verifier_preflight_check(
        916482305, 274650918, 90, 91, 15, 3, 31, 63, 0, 0, 1, 0, 0, 0, 0)
    if fake_public != 0 - 1 { return 28 }

    let fake_gluing = child4_replay_verifier_preflight_check(
        916482305, 274650918, 90, 91, 15, 3, 31, 63, 0, 0, 0, 0, 1, 0, 0)
    if fake_gluing != 0 - 1 { return 29 }

    return 0
}
