//@ run-pass
//@ description: Imported Lorenz i256 bounded trajectory certificate fingerprint smoke

use systems::lorenz_i256_trajectory2_replay_bounded_bridge::*
use systems::lorenz_i256_trajectory2_certificate_bounded_bridge::*

fn main() -> i64 with Div {
    let state0_fp = lorenz_i256_trajectory2_certificate_state_fingerprint(
        0, 500000000, 0, 0, 0, 625000000, 1, 0, 0, 375000000, 0, 0, 0)
    if state0_fp != 250000085 { return 1 }

    let state1_fp = lorenz_i256_trajectory2_certificate_state_fingerprint(
        1, 750000000, 11, 0, 0, 812500000, 13, 0, 0, 187500000, 0, 0, 0)
    if state1_fp != 626001669 { return 2 }

    let state2_fp = lorenz_i256_trajectory2_certificate_state_fingerprint(
        2, 375000000, 32, 0, 0, 796875000, 326, 0, 0, 984375000, 161, 0, 0)
    if state2_fp != 2048507 { return 3 }

    let cert = lorenz_i256_trajectory2_certificate_fingerprint(
        500000000, 0, 0, 0, 625000000, 1, 0, 0, 375000000, 0, 0, 0,
        750000000, 11, 0, 0, 812500000, 13, 0, 0, 187500000, 0, 0, 0,
        375000000, 32, 0, 0, 796875000, 326, 0, 0, 984375000, 161, 0, 0)
    if cert != 657108232 { return 4 }

    let mismatch = lorenz_i256_trajectory2_certificate_fingerprint(
        500000000, 0, 0, 0, 625000000, 1, 0, 0, 375000000, 0, 0, 0,
        750000001, 11, 0, 0, 812500000, 13, 0, 0, 187500000, 0, 0, 0,
        375000000, 32, 0, 0, 796875000, 326, 0, 0, 984375000, 161, 0, 0)
    if mismatch != 0 - 1 { return 5 }

    let invalid_limb = lorenz_i256_trajectory2_certificate_state_fingerprint(
        0, 1000000000, 0, 0, 0, 625000000, 1, 0, 0, 375000000, 0, 0, 0)
    if invalid_limb != 0 - 1 { return 6 }

    let replay_anchor = lorenz_i256_trajectory2_replay_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 117)
    if replay_anchor != 734260981 { return 7 }

    let replay_audit = lorenz_i256_trajectory2_replay_bounded_bridge_audit_fingerprint(
        replay_anchor, 482709136, 193840625, 812457306, 459028173,
        701846329, 263917508, 1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 117, 2047)
    if replay_audit != 605913274 { return 8 }

    let artifact = lorenz_i256_trajectory2_certificate_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 118)
    if artifact != 918274650 { return 9 }

    let audit = lorenz_i256_trajectory2_certificate_bounded_bridge_audit_fingerprint(
        artifact, 675230419, 208746531, replay_anchor, replay_audit,
        cert, state0_fp, state1_fp, state2_fp, 1, 1, 1, 1, 1, 1,
        256, 1000000000, 0, 0, 0, 0, 118, 4095)
    if audit != 341902786 { return 10 }
    return 0
