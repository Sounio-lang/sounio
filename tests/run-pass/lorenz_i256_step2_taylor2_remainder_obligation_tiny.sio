//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-2 Taylor-2 remainder obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn abs_and_derivative_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let start_x: i256 = 4406636440 as i256
    let start_y: i256 = 6517899153 as i256
    let start_z: i256 = 4164877513 as i256
    let rx: i256 = 112098647 as i256
    let ry: i256 = 1106813073 as i256
    let rz: i256 = 58841052 as i256
    let x_abs: i256 = 4518735087 as i256
    let y_abs: i256 = 7624712226 as i256
    let z_abs: i256 = 4223718565 as i256
    let rhoz_abs: i256 = 116153047827 as i256
    let x_prime: i256 = 121434473130 as i256
    let y_prime: i256 = 129829333707 as i256
    let z_prime: i256 = 19285209231 as i256
    let x_second: i256 = 2512638068370 as i256
    let y_second: i256 = 3434191844255 as i256
    let z_second: i256 = 403599237402 as i256

    var mask: i64 = 0
    if x_abs == start_x + rx {
        if y_abs == start_y + ry {
            if z_abs == start_z + rz {
                if rhoz_abs == (28 as i256) * source_scale - (start_z - rz) {
                    mask = mask + 1
                }
            }
        }
    }

    let y_prime_product: i256 = x_abs * rhoz_abs
    let xy_product: i256 = x_abs * y_abs
    let beta_z_product: i256 = (8 as i256) * z_abs
    if x_prime == (10 as i256) * (x_abs + y_abs) {
        if (y_prime - y_abs - (1 as i256)) * source_scale < y_prime_product {
            if (y_prime - y_abs) * source_scale >= y_prime_product {
                if ((8021959724 as i256) - (1 as i256)) * source_scale < xy_product {
                    if (8021959724 as i256) * source_scale >= xy_product {
                        if ((11263249507 as i256) - (1 as i256)) * (3 as i256) < beta_z_product {
                            if (11263249507 as i256) * (3 as i256) >= beta_z_product {
                                if z_prime == (8021959724 as i256) + (11263249507 as i256) {
                                    mask = mask + 2
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if x_second == (10 as i256) * (y_prime + x_prime) {
        if y_second == (3284072541939 as i256) + (20289968609 as i256) + y_prime {
            if z_second == (215578570947 as i256) + (136593441839 as i256) + (51427224616 as i256) {
                mask = mask + 4
            }
        }
    }
    return mask
}

fn lte_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let dt_q: i256 = 42949672 as i256
    let dt2: i256 = dt_q * dt_q
    let den: i256 = (2 as i256) * source_scale * source_scale
    let x_second: i256 = 2512638068370 as i256
    let y_second: i256 = 3434191844255 as i256
    let z_second: i256 = 403599237402 as i256
    let x_lte_source: i256 = 125631898 as i256
    let y_lte_source: i256 = 171709585 as i256
    let z_lte_source: i256 = 20179961 as i256
    let x_lte_ppm: i256 = 29251 as i256
    let y_lte_ppm: i256 = 39980 as i256
    let z_lte_ppm: i256 = 4699 as i256

    var mask: i64 = 0
    if (x_lte_source - (1 as i256)) * den < x_second * dt2 {
        if x_lte_source * den >= x_second * dt2 {
            if (y_lte_source - (1 as i256)) * den < y_second * dt2 {
                if y_lte_source * den >= y_second * dt2 {
                    if (z_lte_source - (1 as i256)) * den < z_second * dt2 {
                        if z_lte_source * den >= z_second * dt2 { mask = mask + 8 }
                    }
                }
            }
        }
    }
    if (x_lte_ppm - (1 as i256)) * source_scale < x_lte_source * target_scale {
        if x_lte_ppm * source_scale >= x_lte_source * target_scale {
            if (y_lte_ppm - (1 as i256)) * source_scale < y_lte_source * target_scale {
                if y_lte_ppm * source_scale >= y_lte_source * target_scale {
                    if (z_lte_ppm - (1 as i256)) * source_scale < z_lte_source * target_scale {
                        if z_lte_ppm * source_scale >= z_lte_source * target_scale { mask = mask + 16 }
                    }
                }
            }
        }
    }
    if 40000 - 29251 == 10749 {
        if 55000 - 39980 == 15020 {
            if 10000 - 4699 == 5301 { mask = mask + 32 }
        }
    }
    return mask + 64
}

fn main() -> i64 {
    let ok_mask = abs_and_derivative_mask() + lte_mask()
    if ok_mask != 127 { return 1 }

    var inst: i64 = 1813
    inst = mix(inst, 2, 5753)
    inst = mix(inst, 4294967296, 5753)
    inst = mix(inst, 1000000, 5753)
    inst = mix(inst, 42949672, 5753)
    inst = mix(inst, 482555681, 5753)
    inst = mix(inst, 591288676, 5753)
    inst = mix(inst, 554654324, 5753)
    inst = mix(inst, 135610689, 5753)
    inst = mix(inst, 443171640, 5753)
    inst = mix(inst, 790224648, 5753)
    inst = mix(inst, 4406636440, 5753)
    inst = mix(inst, 6517899153, 5753)
    inst = mix(inst, 4164877513, 5753)
    inst = mix(inst, 112098647, 5753)
    inst = mix(inst, 1106813073, 5753)
    inst = mix(inst, 58841052, 5753)
    inst = mix(inst, 0, 5753)
    inst = mix(inst, 0, 5753)
    if inst != 272280595 { return 2 }

    var cert: i64 = 1817
    cert = mix(cert, inst, 5779)
    cert = mix(cert, 4518735087, 5779)
    cert = mix(cert, 7624712226, 5779)
    cert = mix(cert, 4223718565, 5779)
    cert = mix(cert, 116153047827, 5779)
    cert = mix(cert, 121434473130, 5779)
    cert = mix(cert, 129829333707, 5779)
    cert = mix(cert, 19285209231, 5779)
    cert = mix(cert, 2512638068370, 5779)
    cert = mix(cert, 3434191844255, 5779)
    cert = mix(cert, 403599237402, 5779)
    cert = mix(cert, 125631898, 5779)
    cert = mix(cert, 171709585, 5779)
    cert = mix(cert, 20179961, 5779)
    cert = mix(cert, 29251, 5779)
    cert = mix(cert, 39980, 5779)
    cert = mix(cert, 4699, 5779)
    cert = mix(cert, 40000, 5779)
    cert = mix(cert, 55000, 5779)
    cert = mix(cert, 10000, 5779)
    cert = mix(cert, 10749, 5779)
    cert = mix(cert, 15020, 5779)
    cert = mix(cert, 5301, 5779)
    cert = mix(cert, ok_mask, 5779)
    cert = mix(cert, 0, 5779)
    cert = mix(cert, 0, 5779)
    if cert != 598358642 { return 3 }

    var art: i64 = 1819
    art = mix(art, inst, 5783)
    art = mix(art, cert, 5783)
    art = mix(art, 482555681, 5783)
    art = mix(art, 591288676, 5783)
    art = mix(art, 554654324, 5783)
    art = mix(art, 135610689, 5783)
    art = mix(art, 443171640, 5783)
    art = mix(art, 790224648, 5783)
    art = mix(art, 5, 5783)
    art = mix(art, 2, 5783)
    art = mix(art, 29251, 5783)
    art = mix(art, 39980, 5783)
    art = mix(art, 4699, 5783)
    art = mix(art, 40000, 5783)
    art = mix(art, 55000, 5783)
    art = mix(art, 10000, 5783)
    art = mix(art, ok_mask, 5783)
    art = mix(art, 0, 5783)
    art = mix(art, 0, 5783)
    if art != 444092349 { return 4 }

    var audit: i64 = 1829
    audit = mix(audit, art, 5791)
    audit = mix(audit, inst, 5791)
    audit = mix(audit, cert, 5791)
    audit = mix(audit, 482555681, 5791)
    audit = mix(audit, 554654324, 5791)
    audit = mix(audit, 443171640, 5791)
    audit = mix(audit, 2, 5791)
    audit = mix(audit, 5, 5791)
    audit = mix(audit, ok_mask, 5791)
    audit = mix(audit, 0, 5791)
    audit = mix(audit, 0, 5791)
    if audit != 625429438 { return 5 }
    return 0
}
