struct Entry {
    pub vals: [i64; 4],
    pub score: i64,
}

struct Driver {
    pub entries: [Entry; 8],
    pub count: i64,
}

fn set_val(d: &! Driver, slot: i64, idx: i64, v: i64) with Mut, Panic {
    d.entries[slot as usize].vals[idx as usize] = v
}

fn set_score(d: &! Driver, slot: i64, s: i64) with Mut, Panic {
    d.entries[slot as usize].score = s
}

fn set_count(d: &! Driver, n: i64) with Mut, Panic {
    d.count = n
}

fn main() -> i32 with IO, Mut, Panic {
    var drv: Driver = Driver { entries: [Entry { vals: [0; 4], score: 0 }; 8], count: 0 }
    set_val(&! drv, 0, 2, 99)
    set_score(&! drv, 0, 42)
    set_count(&! drv, 7)
    if drv.entries[0].vals[2] != 99 {
        println("FAIL: vals[2] mutation not visible")
        return 1
    }
    if drv.entries[0].score != 42 {
        println("FAIL: score mutation not visible")
        return 1
    }
    if drv.count != 7 {
        println("FAIL: count mutation not visible")
        return 1
    }
    println("PASS")
    return 0
}
