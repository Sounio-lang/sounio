//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_F64_ARRAY_STREAMING_BODY_LANE PASS
//
// Copilot review (PR #2516), finding A on the third review round:
// lower_program_bodies_filtered_ref (self-hosted/ir/lower.sio) is the body
// lowering lane reached by `madaros --probe-native-streaming <file>` (via
// lower_program_function_body_from_summary_flat_with_epistemic_ref) and by
// any other one-function-at-a-time streaming caller. It never went through
// lowerer_fo_preregister_pure_fns_multipass_mut -- the shared function an
// earlier round of this review wired the tuple-array collector into -- so
// this lane never populated LOWER_FN_TUPLE_ARR_* at all. A function
// destructuring another function's `([f64; N], [f64; N])` tuple return,
// lowered ONE FUNCTION AT A TIME through this streaming lane, would fall
// back to the integer-element path even though the exact same source
// classifies correctly through every other lowering lane.
//
// This fixture exercises the normal `madaros run` path (which already
// covers the non-streaming lanes from earlier rounds) AND is a valid
// single-module, no-import program that `--probe-native-streaming` accepts,
// so it also exercises lower_program_bodies_filtered_ref directly, function
// by function, without erroring or losing this function's tuple-array mask.
fn pair() -> ([f64; 2], [f64; 2]) with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    var b: [f64; 2] = [0.0; 2]
    a[0] = 1.5
    b[0] = 0.25
    (a, b)
}

fn main() -> i32 with IO, Mut, Panic {
    let (oa, ob) = pair()
    let s0: f64 = oa[0] * 2.0
    let s1: f64 = 2.0 * ob[0]
    if s0 == 3.0 && s1 == 0.5 {
        println("TUPLE_F64_ARRAY_STREAMING_BODY_LANE PASS")
        return 0
    }
    1
}
