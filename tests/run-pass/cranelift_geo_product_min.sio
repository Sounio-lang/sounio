//@ run-pass
//@ expect-stdout: CRANELIFT_GEO_MIN_PASS
// Minimal reproducer for a Cranelift 16-lane Clifford-style geometric
// product accumulation pattern that regressed in the past.
//
// Expected behavior:
// - `souc run` (self-hosted VM) prints CRANELIFT_GEO_MIN_PASS
// - `souc jit` should also print CRANELIFT_GEO_MIN_PASS
//
// This fixture stays in run-pass as a backend parity regression guard.

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn approx_eq(a: f64, b: f64, tol: f64) -> bool {
    abs_f64(a - b) < tol
}

fn geo_sign(a: i64, b: i64) -> f64 with Mut, Panic, Div {
    var swaps = 0
    var j = 0
    while j < 4 {
        if (b >> j) & 1 != 0 {
            var k = j + 1
            while k < 4 {
                if (a >> k) & 1 != 0 { swaps = swaps + 1 }
                k = k + 1
            }
        }
        j = j + 1
    }
    let common = a & b
    var msign = 1.0
    if (common >> 1) & 1 != 0 { msign = 0.0 - msign }
    if (common >> 2) & 1 != 0 { msign = 0.0 - msign }
    if (common >> 3) & 1 != 0 { msign = 0.0 - msign }
    if swaps % 2 == 0 { return msign }
    return 0.0 - msign
}

fn geo_product(a: [f64], b: [f64]) -> [f64] with Mut, Panic, Div {
    var r0  = 0.0; var r1  = 0.0; var r2  = 0.0; var r3  = 0.0
    var r4  = 0.0; var r5  = 0.0; var r6  = 0.0; var r7  = 0.0
    var r8  = 0.0; var r9  = 0.0; var r10 = 0.0; var r11 = 0.0
    var r12 = 0.0; var r13 = 0.0; var r14 = 0.0; var r15 = 0.0
    var i = 0
    while i < 16 {
        if a[i] != 0.0 {
            var j = 0
            while j < 16 {
                if b[j] != 0.0 {
                    let k = i ^ j
                    let val = geo_sign(i, j) * a[i] * b[j]
                    if k == 0 { r0 = r0 + val }
                    else if k == 1 { r1 = r1 + val }
                    else if k == 2 { r2 = r2 + val }
                    else if k == 3 { r3 = r3 + val }
                    else if k == 4 { r4 = r4 + val }
                    else if k == 5 { r5 = r5 + val }
                    else if k == 6 { r6 = r6 + val }
                    else if k == 7 { r7 = r7 + val }
                    else if k == 8 { r8 = r8 + val }
                    else if k == 9 { r9 = r9 + val }
                    else if k == 10 { r10 = r10 + val }
                    else if k == 11 { r11 = r11 + val }
                    else if k == 12 { r12 = r12 + val }
                    else if k == 13 { r13 = r13 + val }
                    else if k == 14 { r14 = r14 + val }
                    else if k == 15 { r15 = r15 + val }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return [r0, r1, r2, r3, r4, r5, r6, r7,
            r8, r9, r10, r11, r12, r13, r14, r15]
}

fn mv_basis(idx: i64) -> [f64] with Mut, Panic, Div {
    var r0  = 0.0; var r1  = 0.0; var r2  = 0.0; var r3  = 0.0
    var r4  = 0.0; var r5  = 0.0; var r6  = 0.0; var r7  = 0.0
    var r8  = 0.0; var r9  = 0.0; var r10 = 0.0; var r11 = 0.0
    var r12 = 0.0; var r13 = 0.0; var r14 = 0.0; var r15 = 0.0
    if idx == 0 { r0 = 1.0 }
    else if idx == 1 { r1 = 1.0 }
    else if idx == 2 { r2 = 1.0 }
    else if idx == 3 { r3 = 1.0 }
    else if idx == 4 { r4 = 1.0 }
    else if idx == 5 { r5 = 1.0 }
    else if idx == 6 { r6 = 1.0 }
    else if idx == 7 { r7 = 1.0 }
    else if idx == 8 { r8 = 1.0 }
    else if idx == 9 { r9 = 1.0 }
    else if idx == 10 { r10 = 1.0 }
    else if idx == 11 { r11 = 1.0 }
    else if idx == 12 { r12 = 1.0 }
    else if idx == 13 { r13 = 1.0 }
    else if idx == 14 { r14 = 1.0 }
    else if idx == 15 { r15 = 1.0 }
    return [r0, r1, r2, r3, r4, r5, r6, r7,
            r8, r9, r10, r11, r12, r13, r14, r15]
}

fn test_full_metric() -> bool with Mut, Panic, Div {
    let e0_sq = geo_product(mv_basis(1), mv_basis(1))
    let e1_sq = geo_product(mv_basis(2), mv_basis(2))
    let e2_sq = geo_product(mv_basis(4), mv_basis(4))
    let e3_sq = geo_product(mv_basis(8), mv_basis(8))
    return approx_eq(e0_sq[0], 1.0, 1.0e-10)
        && approx_eq(e1_sq[0], 0.0 - 1.0, 1.0e-10)
        && approx_eq(e2_sq[0], 0.0 - 1.0, 1.0e-10)
        && approx_eq(e3_sq[0], 0.0 - 1.0, 1.0e-10)
}

fn main() -> i32 with IO, Mut, Panic, Div {
    if test_full_metric() {
        println("CRANELIFT_GEO_MIN_PASS")
        return 0
    }
    println("CRANELIFT_GEO_MIN_FAIL")
    return 1
}
