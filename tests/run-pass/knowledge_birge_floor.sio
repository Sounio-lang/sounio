//@ run-pass
//@ requires: madaros
//@ expect-stdout: floor 12.413777 12.493645
//@ expect-stdout: out 3.505211 3.642851
//@ expect-stdout: short 1
//@ expect-stdout: BIRGE_FLOOR_OK
// chi = 0.359693 is below 1. The weighted arm keeps the parentheses:
// max(chi, 1) widens 12.429720-12.477620 to the band pinned here.
// At 300 K the same parentheses make the two arms meet at 3.505211-3.642851.
// The chi-square does not refuse. Two pressures are not a fit.

use epistemic::regression::plateau_pressure

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn bit(b: bool) -> i64 {
    if b { return 1 }
    0
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var xs: [f64; 8] = [0.0; 8]
    var ys: [f64; 8] = [0.0; 8]
    var uln: [f64; 8] = [0.0; 8]
    xs[0] = 1.0 / 400.0
    xs[1] = 1.0 / 450.0
    xs[2] = 1.0 / 500.0
    xs[3] = 1.0 / 550.0
    ys[0] = log(12.0 / 100.0)
    ys[1] = log(10.84 / 100.0)
    ys[2] = log(11.0 / 100.0)
    ys[3] = log(16.23 / 100.0)
    uln[0] = 6.0 / 12.0
    uln[1] = 0.05 / 10.84
    uln[2] = 6.0 / 11.0
    uln[3] = 0.05 / 16.23
    let held = plateau_pressure(xs, ys, uln, 4, 1.0 / 480.0, 100.0)
    let out = plateau_pressure(xs, ys, uln, 4, 1.0 / 300.0, 100.0)
    let short = plateau_pressure(xs, ys, uln, 2, 1.0 / 480.0, 100.0)
    let wide = (held.hi - held.lo) > 0.06
    let pinned = near(held.lo, 12.413777, 0.000001) && near(held.hi, 12.493645, 0.000001) && near(held.chi, 0.359693, 0.000001)
    let out_ok = out.open && !out.refused && near(out.lo, 3.505211, 0.000001) && near(out.hi, 3.642851, 0.000001) && near(out.chi, 0.359693, 0.000001)
    let short_ok = !short.open && !short.refused && !(short.lo == short.lo) && !(short.hi == short.hi) && !(short.chi == short.chi)
    print("floor ")
    print_f64(held.lo)
    print(" ")
    print_f64(held.hi)
    println("")
    print("out ")
    print_f64(out.lo)
    print(" ")
    print_f64(out.hi)
    println("")
    print("short ")
    print_int(bit(short_ok))
    println("")
    if held.open && !held.refused && wide && pinned && out_ok && short_ok {
        println("BIRGE_FLOOR_OK")
        return 0
    }
    println("BIRGE_FLOOR_FAIL")
    1
}
