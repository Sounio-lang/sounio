//@ run-pass
//@ expect-stdout: STATS_CORRELATION_STATUS_PASS
use stats::correlation_core::{CorrelationEstimate,pearson_checked,spearman_checked}
use stats::correlation_inference::{pearson_inference,spearman_inference}
fn failed(c:CorrelationEstimate,status:i64,n:i64)->bool {
 c.status==status && c.n==n && c.coefficient==0.0 && c.residual_ratio==0.0
}
fn main() with IO,Mut,Div,Panic {
 var x:[f64;256]=[0.0;256]
 var y:[f64;256]=[0.0;256]
 var i:i64=0
 while i<5{x[i as usize]=i as f64;y[i as usize]=((i*i)%7) as f64;i=i+1}
 assert(failed(pearson_checked(&x,&y,257),1,257))
 assert(failed(spearman_checked(&x,&y,-1),1,-1))
 assert(failed(pearson_checked(&x,&y,0),1,0))
 assert(failed(spearman_checked(&x,&y,1),1,1))
 let nan=0.0/0.0
 let inf=1e308*2.0
 x[255]=nan;y[255]=inf
 assert(pearson_checked(&x,&y,5).status==0)
 assert(spearman_checked(&x,&y,5).status==0)
 x[0]=nan
 assert(failed(pearson_checked(&x,&y,5),2,5))
 assert(failed(spearman_checked(&x,&y,5),2,5))
 x[0]=0.0;y[1]=inf
 assert(failed(pearson_checked(&x,&y,5),2,5))
 assert(failed(spearman_checked(&x,&y,5),2,5))
 y[1]=1.0
 let a=pearson_inference(&x,&y,5,0.95,false)
 assert(a.status==0 && a.p_status==1 && a.ci_status==1 && a.calibration==0)
 let b=pearson_inference(&x,&y,5,0.95,true)
 assert(b.status==0 && b.p_status==0 && b.ci_status==0 && b.calibration==1)
 assert(b.ci_lower<=b.coefficient && b.coefficient<=b.ci_upper)
 assert(pearson_inference(&x,&y,5,0.0,true).status==5)
 assert(pearson_inference(&x,&y,5,1.0,true).status==5)
 assert(pearson_inference(&x,&y,5,nan,true).status==5)
 let extreme=pearson_inference(&x,&y,5,0.99999999,true)
 assert(extreme.status==0 && extreme.p_status==0 && extreme.ci_status==4)
 let s=spearman_inference(&x,&y,5,false)
 assert(s.status==0 && s.p_status==1 && s.ci_status==1)
 let sa=spearman_inference(&x,&y,5,true)
 assert(sa.status==0 && sa.p_status==0 && sa.calibration==2 && sa.ci_status==1)
 let two=pearson_inference(&x,&y,2,0.95,true)
 assert(two.status==0 && two.p_status==2 && two.ci_status==2)
 y[0]=0.0;y[1]=2.0;y[2]=1.0
 let three=pearson_inference(&x,&y,3,0.95,true)
 assert(three.status==0 && three.p_status==0 && three.ci_status==2)
 i=0
 while i<5{y[i as usize]=x[i as usize];i=i+1}
 let perfect=pearson_inference(&x,&y,5,0.95,true)
 assert(perfect.status==0 && perfect.p_status==3 && perfect.ci_status==3)
 assert(perfect.p_value==0.0 && perfect.t_stat==0.0 && perfect.level==0.0)
 i=0
 while i<5{x[i as usize]=1.0;i=i+1}
 assert(failed(pearson_checked(&x,&y,5),3,5))
 assert(failed(spearman_checked(&x,&y,5),3,5))
 assert(x[0]==1.0 && y[4]==4.0)
 println("STATS_CORRELATION_STATUS_PASS")
 0
}
