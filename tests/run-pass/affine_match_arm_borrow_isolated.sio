//@ run-pass
//@ requires: madaros

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 with Panic {
    let permit = Permit { id: 191 }
    let selector = 0
    let observed = match selector {
        0 => {
            let borrowed = &permit
            (*borrowed).id
        }
        _ => {
            let borrowed = &permit
            (*borrowed).id
        }
    }
    let consumed = spend(permit)
    assert(observed == 191)
    assert(consumed == 191)
    0
}
