//@ run-pass
//@ requires: madaros
//@ expect-stdout: REGION_RECLAIM_ENCODED_SCALAR_OK
//@ description: integer Seq stores and f64 returns preserve encoded aggregate handles

struct P { a: i64, b: i64, c: i64 }

fn put_encoded(s: &!Seq<i64>) -> i64 with Mut, Panic, Epistemic {
    let p = P { a: 42, b: 43, c: 44 }
    let bits = p as i64
    s.push(bits)
    0
}

fn return_encoded() -> f64 with Mut {
    let p = P { a: 71, b: 72, c: 73 }
    let bits = p as i64
    bits_to_f64(bits)
}

fn churn() -> i64 with Mut {
    var i: i64 = 0
    var n: i64 = 0
    while i < 10000 {
        let p = P { a: 99, b: 99, c: 99 }
        n = n + p.a
        i = i + 1
    }
    n
}

fn main() -> i32 with IO, Mut, Panic, Epistemic {
    var s: Seq<i64> = seq_new()
    s.push(-1)
    let ignored = put_encoded(&!s)
    let churn1 = churn()
    let recovered1 = s.get(1) as P
    if recovered1.a != 42 || recovered1.b != 43 || recovered1.c != 44 { return 1 }
    let encoded = return_encoded()
    let churn2 = churn()
    let recovered2 = f64_to_bits(encoded) as P
    if recovered2.a != 71 || recovered2.b != 72 || recovered2.c != 73 { return 2 }
    if ignored != 0 || churn1 != 990000 || churn2 != 990000 { return 3 }
    println("REGION_RECLAIM_ENCODED_SCALAR_OK")
    0
}
