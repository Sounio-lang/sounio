//@ run-pass
//@ expect-stdout: STATS_LINEAR_HC3_STATUS_PASS
use stats::regression::robust_covariance::{LinearHc3Result,multiple_linear_hc3}
fn mag(x:f64)->f64 {if x<0.0 {-x}else{x}}
fn same(a:f64,b:f64) with Mut,Div,Panic {
 if b==0.0 {assert(a==0.0)} else {assert(a!=0.0) assert(mag((a-b)/b)<=1.0e-7)}
}
fn unavailable(r:&LinearHc3Result,fit_status:i64,cov_status:i64) with Mut,Div,Panic {
 assert(r.fit.status==fit_status && r.covariance_status==cov_status)
 assert(r.method==3 && !r.assumptions_assessed)
 var i:i64=0
 while i<64 {assert(r.covariance[i as usize]==0.0) i=i+1}
 i=0
 while i<8 {assert(r.standard_errors[i as usize]==0.0) i=i+1}
 i=0
 while i<256 {assert(r.leverage[i as usize]==0.0) i=i+1}
}
fn statuses() with Mut,Div,Panic {
 var a:[f64;2048]=[0.0;2048]
 var b:[f64;256]=[0.0;256]
 let nan=0.0/0.0
 a[0]=nan
 let size=multiple_linear_hc3(&a,&b,0,1,nan)
 unavailable(&size,1,1)
 assert(size.fit.m==0 && size.fit.p==1)
 let pwide=multiple_linear_hc3(&a,&b,4,9,0.0)
 unavailable(&pwide,1,1)
 let nwide=multiple_linear_hc3(&a,&b,257,1,0.0)
 unavailable(&nwide,1,1)
 let pgt=multiple_linear_hc3(&a,&b,1,2,0.0)
 unavailable(&pgt,1,1)
 let control=multiple_linear_hc3(&a,&b,2,1,-1.0)
 unavailable(&control,5,1)
 let nonfinite=multiple_linear_hc3(&a,&b,2,1,0.0)
 unavailable(&nonfinite,2,1)
 a[0]=1.0 a[8]=1.0 b[1]=1.0e308*10.0
 let response_inf=multiple_linear_hc3(&a,&b,2,1,0.0)
 unavailable(&response_inf,2,1)
 b[1]=3.0 b[0]=1.0
 a[1]=1.0 a[9]=1.0
 let rank=multiple_linear_hc3(&a,&b,2,2,0.0)
 unavailable(&rank,3,1)
 assert(rank.fit.rank==1)
 // Mathematical unit leverage with a singleton indicator column.
 a[0]=1.0 a[1]=0.0 a[8]=1.0 a[9]=0.0 a[16]=0.0 a[17]=1.0 b[2]=8.0
 let unit=multiple_linear_hc3(&a,&b,3,2,0.0)
 unavailable(&unit,0,3)
 // A valid fit remains available even though covariance has no residual df.
 a[0]=1.0 a[1]=0.0 a[8]=0.0 a[9]=1.0 b[0]=2.0 b[1]=3.0
 let square=multiple_linear_hc3(&a,&b,2,2,0.0)
 unavailable(&square,0,2)
 same(square.fit.coefficients[0],2.0) same(square.fit.coefficients[1],3.0)
 let one=multiple_linear_hc3(&a,&b,1,1,0.0)
 unavailable(&one,0,2)
 // Inactive nonfinite cells must not be validated or read.
 a[8]=1.0 a[16]=1.0 a[24]=1.0
 a[1]=nan a[2047]=nan b[255]=nan
 b[0]=0.0 b[1]=0.0 b[2]=0.0 b[3]=0.0
 let zero=multiple_linear_hc3(&a,&b,4,1,0.0)
 assert(zero.fit.status==0 && zero.covariance_status==0)
 var i:i64=0
 while i<64 {assert(zero.covariance[i as usize]==0.0) i=i+1}
 i=0
 while i<8 {assert(zero.standard_errors[i as usize]==0.0) i=i+1}
 i=0
 while i<4 {same(zero.leverage[i as usize],0.25) i=i+1}
}
fn transformations() with Mut,Div,Panic {
 var a:[f64;2048]=[0.0;2048]
 var b:[f64;256]=[0.0;256]
 b[0]=1.2 b[1]=2.7 b[2]=5.4 b[3]=6.6 b[4]=9.6 b[5]=10.4 b[6]=13.5 b[7]=14.5
 var i:i64=0
 while i<8 {a[(i*8) as usize]=1.0 a[(i*8+1) as usize]=i as f64 i=i+1}
 let base=multiple_linear_hc3(&a,&b,8,2,0.0)
 assert(base.fit.status==0 && base.covariance_status==0)
 var scaled_a:[f64;2048]=[0.0;2048]
 var scaled_b:[f64;256]=[0.0;256]
 i=0
 while i<8 {
  scaled_a[(i*8) as usize]=4.0
  scaled_a[(i*8+1) as usize]=(i as f64)*0.25
  scaled_b[i as usize]=b[i as usize]*8.0
  i=i+1
 }
 let scaled=multiple_linear_hc3(&scaled_a,&scaled_b,8,2,0.0)
 assert(scaled.fit.status==0 && scaled.covariance_status==0)
 same(scaled.fit.coefficients[0]/2.0,base.fit.coefficients[0])
 same(scaled.fit.coefficients[1]/32.0,base.fit.coefficients[1])
 same(scaled.standard_errors[0]/2.0,base.standard_errors[0])
 same(scaled.standard_errors[1]/32.0,base.standard_errors[1])
 same(scaled.covariance[0]/4.0,base.covariance[0])
 same(scaled.covariance[1]/64.0,base.covariance[1])
 same(scaled.covariance[8]/64.0,base.covariance[8])
 same(scaled.covariance[9]/1024.0,base.covariance[9])
 i=0
 while i<8 {same(scaled.leverage[i as usize],base.leverage[i as usize]) i=i+1}
 var perm_a:[f64;2048]=[0.0;2048]
 i=0
 while i<8 {perm_a[(i*8) as usize]=i as f64 perm_a[(i*8+1) as usize]=1.0 i=i+1}
 let perm=multiple_linear_hc3(&perm_a,&b,8,2,0.0)
 assert(perm.fit.status==0 && perm.covariance_status==0)
 same(perm.fit.coefficients[0],base.fit.coefficients[1])
 same(perm.fit.coefficients[1],base.fit.coefficients[0])
 same(perm.covariance[0],base.covariance[9])
 same(perm.covariance[1],base.covariance[8])
 same(perm.covariance[8],base.covariance[1])
 same(perm.covariance[9],base.covariance[0])
 var row_a:[f64;2048]=[0.0;2048]
 var row_b:[f64;256]=[0.0;256]
 i=0
 while i<8 {
  row_a[(i*8) as usize]=1.0
  row_a[(i*8+1) as usize]=(7-i) as f64
  row_b[i as usize]=b[(7-i) as usize]
  i=i+1
 }
 let rows=multiple_linear_hc3(&row_a,&row_b,8,2,0.0)
 assert(rows.fit.status==0 && rows.covariance_status==0)
 same(rows.covariance[0],base.covariance[0])
 same(rows.covariance[1],base.covariance[1])
 same(rows.covariance[9],base.covariance[9])
 i=0
 while i<8 {same(rows.leverage[i as usize],base.leverage[(7-i) as usize]) i=i+1}
}
fn main()->i32 with IO,Mut,Div,Panic {
 statuses()
 transformations()
 println("STATS_LINEAR_HC3_STATUS_PASS")
 0
}
