//@ run-pass
//@ expect-stdout: PHYSICS_LORENTZ_LEGACY_PASS
use physics::em::{lorentz_force_scalar,lorentz_force_3d,vec3_new}
fn main() with IO,Mut,Div,Panic {
 let (f,u)=lorentz_force_scalar(1.0,1.0,-6.0,0.0,2.0,0.0,3.0,0.0)
 assert(f==0.0 && u==0.0)
 let (g,w)=lorentz_force_scalar(1.0,1.0,1.0,0.0,2.0,0.0,3.0,0.0)
 assert(g==7.0 && w==7.0)
 let (h,t)=lorentz_force_scalar(-2.0,0.0,1.0,0.0,2.0,0.0,3.0,0.0)
 assert(h== -14.0 && t==0.0)
 let (bad,unavailable)=lorentz_force_scalar(1.0,-1.0,1.0,0.0,2.0,0.0,3.0,0.0)
 assert(bad==0.0 && unavailable== -1.0)
 let e=vec3_new(1.0,2.0,3.0)
 let z=vec3_new(0.0,0.0,0.0)
 let (force,uncertainty)=lorentz_force_3d(0.0,1.0,e,0.0,z,0.0,z,0.0)
 assert(force.x==0.0 && force.y==0.0 && force.z==0.0)
 assert(uncertainty>3.74 && uncertainty<3.75)
 println("PHYSICS_LORENTZ_LEGACY_PASS")
 0
}
