//@ run-pass
//@ expect-stdout-contains: read_file carry regression ok
//
// Discriminating test for emit_read_file_a64 Darwin carry / mmap failure
// handling (Apple Self-Host native typecheck, PR #2980).
//
// emit_read_file_a64 used to push open()/mmap()/read() results without the
// XNU carry-flag normalize that emit_read_byte_a64 / emit_read_line_a64 /
// emit_file_size_a64 already had. A failed syscall returns +errno with
// CARRY set. #2832's loop then added that errno to len until 4 MiB and
// printed "file larger than 4 MiB is not supported on this target" for
// tests/selfhost/native_typecheck/undefined_var.sio (~30 bytes).
//
// Scope note: this runs the default x86-64 engine (same as
// a64_read_byte_read_line_carry_regression.sio). It does not execute the
// aarch64-macos emitter. It locks the success-path contract the typecheck
// proof needs: read_file of a tiny existing source returns its bytes, not
// an empty string and not a 4 MiB refuse.

fn main() -> i32 with IO, Panic {
    let path = "tests/selfhost/native_typecheck/undefined_var.sio"
    let data = read_file(path)
    let n = str_len(data)
    assert(n > 10)
    assert(n < 4096)
    print("read_file carry regression ok\n")
    0
}
