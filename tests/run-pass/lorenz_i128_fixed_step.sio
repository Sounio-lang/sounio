//@ run-pass
//@ known-failure: source-level i128 Lorenz fixed-point step: main returns 2. Not a segfault/139
//@ requires: madaros
//@ description: Lorenz one-step fixed-point smoke over i128 arithmetic

fn main() -> i64 {
    let scale: i128 = 1000000 as i128
    let dt: i128 = 10000 as i128

    let sigma: i128 = 10 as i128
    let rho: i128 = 28 as i128
    let beta_num: i128 = 8 as i128
    let beta_den: i128 = 3 as i128

    let x: i128 = scale
    let y: i128 = scale
    let z: i128 = scale

    // Fixed-point Lorenz derivative at (1,1,1), scale = 1e6.
    let dx: i128 = sigma * (y - x)
    let dy: i128 = (x * ((rho * scale) - z)) / scale - y
    let dz: i128 = (x * y) / scale - (beta_num * z) / beta_den

    let nx: i128 = x + (dt * dx) / scale
    let ny: i128 = y + (dt * dy) / scale
    // Avoid signed negative wide division here; that has its own ABI/codegen
    // boundary. The Lorenz z-step is negative, so compute the positive drop.
    let z_drop: i128 = (dt * ((0 as i128) - dz)) / scale
    let nz: i128 = z - z_drop

    if dx != (0 as i128) { return 1 }
    if dy != (26000000 as i128) { return 2 }
    if dz != ((0 as i128) - (1666666 as i128)) { return 3 }
    if nx != (1000000 as i128) { return 4 }
    if ny != (1260000 as i128) { return 5 }
    if nz != (983334 as i128) { return 6 }
    return 0
}
