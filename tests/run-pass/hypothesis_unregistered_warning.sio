//@ run-pass

study MyStudy {
    title: "Test"
    design: cohort
    participants {
        sample_size: 50
        power: 0.80
    }
    outcomes {
        primary: blood_pressure
    }
    analysis {
        hypothesis H1 {
            outcome: blood_pressure
            direction: less
            effect_size: 0.3
        }
        alpha: 0.05
        correction: bonferroni
    }
}

fn t_test_one_sample(outcome: i32, n: i32, mu0: i32) -> i32 {
    outcome + n + mu0
}

fn exploratory() -> i32 with Hypothesis {
    let bmi = 7
    t_test_one_sample(bmi, 50, 0)
}

fn main() -> i32 with Hypothesis {
    exploratory()
}
