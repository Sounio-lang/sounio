//@ run-pass
//@ description: Imported Lorenz i256 bounded x*y-beta*z derivative bridge smoke

use systems::lorenz_i256_scaled_product_bridge::*
use systems::lorenz_i256_beta_z_bridge::*
use systems::lorenz_i256_signed_delta_bridge::*
use systems::lorenz_i256_z_derivative_bounded_bridge::*

fn main() -> i64 with Div {
    let positive = lorenz_i256_z_derivative_bounded_check(
        500000000, 1, 0, 0, 250000000, 2, 0, 0, 375000000, 0, 0, 0, 1, 375000000, 2, 0, 0)
    if positive != 1 { return 1 }

    let negative = lorenz_i256_z_derivative_bounded_check(
        500000000, 0, 0, 0, 500000000, 0, 0, 0, 375000000, 0, 0, 0, 0 - 1, 750000000, 0, 0, 0)
    if negative != 1 { return 2 }

    let zero = lorenz_i256_z_derivative_bounded_check(
        500000000, 0, 0, 0, 0, 2, 0, 0, 375000000, 0, 0, 0, 0, 0, 0, 0, 0)
    if zero != 1 { return 3 }

    let inexact_product = lorenz_i256_z_derivative_bounded_abs_limb(
        333333333, 0, 0, 0, 333333333, 0, 0, 0, 0, 0, 0, 0, 0)
    if inexact_product != 0 - 1 { return 4 }

    let inexact_beta = lorenz_i256_z_derivative_bounded_abs_limb(
        0, 0, 0, 0, 0, 0, 0, 0, 100000000, 0, 0, 0, 0)
    if inexact_beta != 0 - 1 { return 5 }

    let product_anchor = lorenz_i256_scaled_product_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 109)
    if product_anchor != 920174638 { return 6 }

    let product_audit = lorenz_i256_scaled_product_bridge_audit_fingerprint(
        product_anchor, 703918426, 268540197, 1, 1, 1, 1, 1, 256,
        1000000000, 0, 0, 0, 0, 109, 1023)
    if product_audit != 481036275 { return 7 }

    let beta_anchor = lorenz_i256_beta_z_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 112)
    if beta_anchor != 639182704 { return 8 }

    let beta_audit = lorenz_i256_beta_z_bridge_audit_fingerprint(
        beta_anchor, 582607319, 918340256, 734815269, 216903584,
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 112, 1023)
    if beta_audit != 174905863 { return 9 }

    let delta_anchor = lorenz_i256_signed_delta_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 104)
    if delta_anchor != 492681735 { return 10 }

    let delta_audit = lorenz_i256_signed_delta_bridge_audit_fingerprint(
        delta_anchor, 604913728, 195740286, 1, 1, 1, 1, 1, 256,
        1000000000, 0, 0, 0, 0, 104, 1023)
    if delta_audit != 837260419 { return 11 }

    let artifact = lorenz_i256_z_derivative_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 113)
    if artifact != 471806392 { return 12 }

    let audit = lorenz_i256_z_derivative_bounded_bridge_audit_fingerprint(
        artifact, 294718650, 730462819, product_anchor, product_audit,
        beta_anchor, beta_audit, delta_anchor, delta_audit,
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 113, 1023)
    if audit != 806135247 { return 13 }
    return 0
}
