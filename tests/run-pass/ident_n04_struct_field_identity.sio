//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: IDENT_N04_STRUCT_FIELD_PASS
//
// Prediction (N-04 runtime observation identity across struct fields):
// Storing a derived Knowledge value `a * 2.0` into a struct field and loading
// it back must preserve its sensitivity channel to `a`.
// Analytic:
//   Cov(r.value, a.value) == 2.0
//   Var(r.value - a.value) == 1.0.

struct Holder {
    k: Knowledge<f64>,
    other: Knowledge<f64>,
}

fn main() -> i64 with IO, Epistemic {
    let a = measure(10.0, uncertainty: 1.0)
    let b = measure(5.0, uncertainty: 2.0)
    let h = Holder { k: a * 2.0, other: b }
    let r = h.k
    let cov_ra = covariance_of(r.value, a.value)
    let var_diff = variance_of(r.value - a.value)
    var d1 = cov_ra - 2.0
    if d1 < 0.0 { d1 = 0.0 - d1 }
    var d2 = var_diff - 1.0
    if d2 < 0.0 { d2 = 0.0 - d2 }
    if d1 > 1.0e-12 || d2 > 1.0e-12 { return 1 }

    println("IDENT_N04_STRUCT_FIELD_PASS")
    0
}
