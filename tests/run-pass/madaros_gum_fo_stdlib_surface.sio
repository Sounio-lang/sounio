//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_STDLIB_SURFACE_PASS

// stdlib epistemic::fo pure helpers FO-transfer (same-module mirrors).
// Point values match imported stdlib fo_css. Multi-mod FO of imports is residual.

use epistemic::fo::{fo_css}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn rate_h(f: f64, dose: f64, tau: f64) -> f64 {
    (f * dose) / tau
}
fn cl_h(cl0: f64, eta: f64) -> f64 {
    cl0 * exp(eta)
}
fn css_h(f: f64, dose: f64, tau: f64, cl0: f64, eta: f64) -> f64 {
    rate_h(f, dose, tau) / cl_h(cl0, eta)
}
fn mul2(a: f64, b: f64) -> f64 { a * b }
fn div2(a: f64, b: f64) -> f64 { a / b }

fn main() with IO, Mut, Div, Epistemic {
    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kTau: Knowledge<f64> = measure(12.0, uncertainty: 0.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let f = kF.value
    let dose = kDose.value
    let tau = kTau.value
    let cl0 = kCL0.value
    let eta = kEta.value

    let pt_local = css_h(f, dose, tau, cl0, eta)
    let pt_imp = fo_css(f, dose, tau, cl0, eta)

    let v_css = variance_of(css_h(f, dose, tau, cl0, eta))
    let v_site = variance_of(rate_h(f, dose, tau) / cl_h(cl0, eta))
    let m2 = second_order_mean(css_h(f, dose, tau, cl0, eta))

    let ka: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let kb: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    let a = ka.value
    let b = kb.value
    let v_mul = variance_of(mul2(a, b))
    let v_div = variance_of(div2(a, b))

    print("pt_local="); print_f64(pt_local); print("\n")
    print("pt_imp="); print_f64(pt_imp); print("\n")
    print("v_css="); print_f64(v_css); print("\n")
    print("v_mul="); print_f64(v_mul); print("\n")
    print("v_div="); print_f64(v_div); print("\n")

    let ok = abs_f(pt_local - pt_imp) < 1.0e-9
        && abs_f(v_css - v_site) < 1.0e-9
        && v_css > 0.1
        && abs_f(m2 - 6.724) < 1.0e-3
        && abs_f(v_mul - 0.25) < 1.0e-9
        && v_div > 0.0
    if ok {
        print("MADAROS_GUM_FO_STDLIB_SURFACE_PASS\n")
    } else {
        print("MADAROS_GUM_FO_STDLIB_SURFACE_FAIL\n")
    }
}
