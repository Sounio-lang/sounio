//@ run-pass
// Adversarial case (task-7 brief Step 5): tls_connect against the Step-1
// loopback server, but with a TrustStore that does NOT contain the
// server's certificate (empty trust store). Must fail closed (negative
// sentinel), never succeed.

use tls::client::*
use x509::trust_store::*
use x509::cert::*
use net::socket::*

fn main() -> i64 with IO, Mut {
    var store = TrustStore { certs: [certificate_zero(); 512], bufs: [rawbuf_new(1); 512], count: 0 }

    let host_text = "127.0.0.1"
    let host_len = str_len(host_text)
    let host = rawbuf_new(host_len + 8)
    var hi: i64 = 0
    while hi < host_len {
        rawbuf_set(&host, hi, str_char_at(host_text, hi))
        hi = hi + 1
    }

    let now_unix: i64 = 1787720000

    let (conn, result_code) = tls_connect(&host, host_len, 44330 as u16, &store, now_unix)
    if result_code >= 0 {
        println("tls_client_adversarial_untrusted_loopback: SECURITY FAILURE -- handshake succeeded against an untrusted certificate")
        return 1
    }
    println("tls_client_adversarial_untrusted_loopback: correctly failed closed against untrusted certificate")
    return 0
}
