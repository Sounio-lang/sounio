//@ run-pass
// Test: ε=⊥ (Knightian undefined) type annotation, evaluation, and propagation.
// The type annotation Knowledge[T, ε=⊥] marks epistemic states where the
// probability distribution is unknown — NOT a Beta posterior mean.

fn main() with IO {
    // Basic Knightian Knowledge value — type annotation carries ε=⊥
    let dm: Knowledge[f64, ε=⊥] = Knowledge { value: 0.26 }
    println(dm)

    // Arithmetic propagation: Knightian * scalar
    let scaled = dm * 3.0
    println(scaled)

    // Two Knightian values combined
    let dm2: Knowledge[f64, ε=⊥] = Knowledge { value: 0.5 }
    let combined = dm + dm2
    println(combined)
}
