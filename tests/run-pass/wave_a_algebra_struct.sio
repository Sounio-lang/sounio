//@ run-pass
// Wave A: algebra basis: → real struct type

algebra Vec2 over f64 {
    basis: x, y
}

algebra Quaternion over f64 {
    basis: r, i, j, k
}

fn vec2_dot(a: Vec2, b: Vec2) -> f64 {
    a.x * b.x + a.y * b.y
}

fn main() -> i32 with IO {
    let v = Vec2 { x: 3.0, y: 4.0 }
    let w = Vec2 { x: 1.0, y: 0.0 }
    let d = vec2_dot(v, w)
    // dot = 3.0
    println("algebra struct ok")
    0
}
