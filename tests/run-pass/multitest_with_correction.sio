//@ run-pass

fn t_test_one_sample(a: i32, b: i32, c: i32) -> i32 {
    a + b + c
}

fn chi2_goodness_of_fit(a: i32, b: i32, c: i32) -> i32 {
    a + b + c
}

fn bonferroni() {
}

fn good_analysis() with MultiTest, IO {
    let p1 = t_test_one_sample(1, 10, 0)
    let p2 = t_test_one_sample(2, 10, 0)
    let p3 = chi2_goodness_of_fit(3, 4, 5)
    bonferroni()
    let total = p1 + p2 + p3
    if total > 0 {
        println("running tests with correction")
    }
}

fn main() -> i32 with IO, MultiTest {
    good_analysis()
    println("ALL PASS")
    0
}
