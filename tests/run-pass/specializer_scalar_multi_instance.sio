//@ run-pass
//@ requires: madaros
// One template must emit distinct concrete bodies for integer and floating
// arithmetic. Also pin all argument positions, repeated reuse and recursion.
fn twice<T>(x: T) -> T { x + x }
fn first<T, U>(a: T, b: U) -> T { a }
fn countdown<T>(x: T, n: i64) -> T {
    if n == 0 { return x }
    countdown::<T>(x, n - 1)
}
fn main() -> i64 with IO {
    let a = twice::<i64>(7)
    let b = twice::<f64>(1.5)
    let c = twice::<i64>(9)
    if a != 14 { return 1 }
    if b != 3.0 { return 2 }
    if c != 18 { return 3 }
    let d = first::<i64, f64>(7, 1.5)
    let e = first::<i64, i64>(9, 2)
    let f = first::<f64, i64>(2.5, 3)
    if d != 7 { return 4 }
    if e != 9 { return 5 }
    if f != 2.5 { return 6 }
    let g = countdown::<i64>(11, 3)
    let h = countdown::<f64>(1.5, 4)
    if g != 11 { return 7 }
    if h != 1.5 { return 8 }
    println("SCALAR_MULTI_INSTANCE_OK")
    return 0
}
