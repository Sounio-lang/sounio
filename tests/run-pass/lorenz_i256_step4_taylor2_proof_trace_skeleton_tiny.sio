//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-4 Taylor-2 proof-trace skeleton keeps replay separate from validation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1889
    fp = mix(fp, 4, 5861)
    fp = mix(fp, 389227567, 5861)
    fp = mix(fp, 234665993, 5861)
    fp = mix(fp, 575348777, 5861)
    fp = mix(fp, 450696904, 5861)
    fp = mix(fp, 749342117, 5861)
    fp = mix(fp, 700260810, 5861)
    fp = mix(fp, 1, 5861)
    fp = mix(fp, 4, 5861)
    fp = mix(fp, 4, 5861)
    fp = mix(fp, 4, 5861)
    fp = mix(fp, 15, 5861)
    fp = mix(fp, 15, 5861)
    fp = mix(fp, 0, 5861)
    fp = mix(fp, 5, 5861)
    fp = mix(fp, 0, 5861)
    fp = mix(fp, 0, 5861)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 607086535 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1901
    fp = mix(fp, instance, 5867)
    fp = mix(fp, 4, 5867)
    fp = mix(fp, 4, 5867)
    fp = mix(fp, 15, 5867)
    fp = mix(fp, 15, 5867)
    fp = mix(fp, 15, 5867)
    fp = mix(fp, 0, 5867)
    fp = mix(fp, 5, 5867)
    fp = mix(fp, ok_mask, 5867)
    fp = mix(fp, 0, 5867)
    fp = mix(fp, 0, 5867)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 607086535 { return 0 - 1 }
    if certificate != 46656432 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1907
    fp = mix(fp, instance, 5869)
    fp = mix(fp, certificate, 5869)
    fp = mix(fp, 6, 5869)
    fp = mix(fp, 4, 5869)
    fp = mix(fp, 1, 5869)
    fp = mix(fp, 4, 5869)
    fp = mix(fp, ok_mask, 5869)
    fp = mix(fp, 0, 5869)
    fp = mix(fp, 0, 5869)
    return fp
}

fn skeleton_mask() -> i64 {
    let obligation_mask: i64 = 15
    let replay_order_mask: i64 = 15
    let validated_mask: i64 = 0
    let local_containment_mask: i64 = 0
    let global_flowpipe_mask: i64 = 0
    let trace_status: i64 = 5

    var ok_mask: i64 = 0
    if 389227567 > 0 {
        if 575348777 > 0 {
            if 450696904 > 0 {
                if 749342117 > 0 {
                    if 700260810 > 0 { ok_mask = ok_mask + 1 }
                }
            }
        }
    }
    if 4 == 4 {
        if obligation_mask == 15 { ok_mask = ok_mask + 2 }
    }
    if replay_order_mask == obligation_mask { ok_mask = ok_mask + 4 }
    if 15 == obligation_mask { ok_mask = ok_mask + 8 }
    if trace_status == 5 { ok_mask = ok_mask + 16 }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if 389227567 != 575348777 { ok_mask = ok_mask + 64 }
    if local_containment_mask == 0 {
        if global_flowpipe_mask == 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = skeleton_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 607086535 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 46656432 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 556038402 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
