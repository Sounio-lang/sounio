//@ run-pass
// Seq<Struct> with repeated pushes — each pushed struct gets its own heap copy
// (seq_push materializes struct/aggregate elements), so loop-pushed elements do
// NOT alias the same buffer. This is the pattern the ontology relies on
// (class.superclasses.push(iri) in a loop, then indexing distinct elements).
struct IRI { id: i64, ns: i64, local: i64 }
fn mk(n: i64) -> IRI { IRI { id: n, ns: n + 1, local: n + 2 } }
struct Bag { items: Seq<IRI>, tag: i64 }

fn main() -> i32 with IO, Mut, Panic, Epistemic {
    // local Seq, loop push of distinct structs (literal + fn-return)
    var v: Seq<IRI> = seq_new()
    var i = 0
    while i < 12 { v.push(IRI { id: i * 10, ns: i, local: 0 }); i = i + 1 }
    var k = 0
    while k < 12 {
        if v.get(k as i64).id != k * 10 { return 10 }
        if v.get(k as i64).ns != k { return 11 }
        k = k + 1
    }

    // field Seq, loop push via fn-returned struct (SRET) — also must not alias
    var b: Bag = Bag { items: seq_new(), tag: 5 }
    var j = 0
    while j < 9 { b.items.push(mk(j * 100)); j = j + 1 }
    var m = 0
    while m < 9 {
        if b.items[m as i64].id != m * 100 { return 20 }
        if b.items[m as i64].local != m * 100 + 2 { return 21 }
        m = m + 1
    }
    if b.tag != 5 { return 22 }

    return 0
}
