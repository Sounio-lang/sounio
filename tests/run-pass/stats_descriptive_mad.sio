//@ run-pass
//@ expect-stdout: STATS_DESCRIPTIVE_MAD_PASS
use stats::descriptive::{mad}

fn main() with IO, Mut, Div, Panic {
    var x: [f64; 100] = [0.0; 100]
    x[0] = 1.0; x[1] = 2.0; x[2] = 3.0; x[3] = 4.0; x[4] = 100.0
    // Raw MAD is 1; the former mean-of-deviations approximation gives 20.2.
    assert(mad(x, 5, 3.0) == 1.0)
    x[0] = 100.0; x[1] = 4.0; x[2] = 3.0; x[3] = 2.0; x[4] = 1.0
    assert(mad(x, 5, 3.0) == 1.0)
    assert(x[0] == 100.0)
    x[0] = 0.0; x[1] = 1.0; x[2] = 2.0; x[3] = 100.0
    assert(mad(x, 4, 1.5) == 1.0)
    x[0] = 7.0
    assert(mad(x, 1, 7.0) == 0.0)
    x[0] = 10.0; x[1] = 14.0; x[2] = 18.0; x[3] = 22.0; x[4] = 406.0
    assert(mad(x, 5, 18.0) == 4.0)
    var i: i64 = 0
    while i < 100 {
        x[i as usize] = if i < 50 { 0.0 } else { 2.0 }
        i = i + 1
    }
    assert(mad(x, 100, 1.0) == 1.0)
    println("STATS_DESCRIPTIVE_MAD_PASS")
    0
}

