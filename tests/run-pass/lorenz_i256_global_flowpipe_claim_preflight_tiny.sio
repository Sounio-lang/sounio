//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 global-flowpipe non-claim preflight receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1741
    fp = mix(fp, 911209450, 5651)
    fp = mix(fp, 709377850, 5651)
    fp = mix(fp, 657988743, 5651)
    fp = mix(fp, 867133305, 5651)
    fp = mix(fp, 31177321, 5651)
    fp = mix(fp, 214180161, 5651)
    fp = mix(fp, 23144051, 5651)
    fp = mix(fp, 561641681, 5651)
    fp = mix(fp, 5, 5651)
    fp = mix(fp, 4, 5651)
    fp = mix(fp, 256, 5651)
    fp = mix(fp, 32, 5651)
    fp = mix(fp, 1, 5651)
    fp = mix(fp, 100, 5651)
    fp = mix(fp, 15, 5651)
    fp = mix(fp, 15, 5651)
    fp = mix(fp, 0, 5651)
    fp = mix(fp, 0, 5651)
    fp = mix(fp, 1, 5651)
    fp = mix(fp, 4, 5651)
    fp = mix(fp, 27, 5651)
    return fp
}

fn certificate_fp(instance: i64) -> i64 {
    var fp: i64 = 1747
    fp = mix(fp, instance, 5657)
    fp = mix(fp, 15, 5657)
    fp = mix(fp, 15, 5657)
    fp = mix(fp, 0, 5657)
    fp = mix(fp, 0, 5657)
    fp = mix(fp, 1, 5657)
    fp = mix(fp, 4, 5657)
    fp = mix(fp, 27, 5657)
    fp = mix(fp, 255, 5657)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64) -> i64 {
    var fp: i64 = 1753
    fp = mix(fp, instance, 5669)
    fp = mix(fp, certificate, 5669)
    fp = mix(fp, 19, 5669)
    fp = mix(fp, 5, 5669)
    fp = mix(fp, 15, 5669)
    fp = mix(fp, 0, 5669)
    fp = mix(fp, 0, 5669)
    fp = mix(fp, 27, 5669)
    fp = mix(fp, 255, 5669)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64) -> i64 {
    var fp: i64 = 1759
    fp = mix(fp, artifact, 5683)
    fp = mix(fp, instance, 5683)
    fp = mix(fp, certificate, 5683)
    fp = mix(fp, 911209450, 5683)
    fp = mix(fp, 709377850, 5683)
    fp = mix(fp, 657988743, 5683)
    fp = mix(fp, 867133305, 5683)
    fp = mix(fp, 31177321, 5683)
    fp = mix(fp, 214180161, 5683)
    fp = mix(fp, 23144051, 5683)
    fp = mix(fp, 561641681, 5683)
    fp = mix(fp, 5, 5683)
    fp = mix(fp, 4, 5683)
    fp = mix(fp, 256, 5683)
    fp = mix(fp, 32, 5683)
    fp = mix(fp, 1, 5683)
    fp = mix(fp, 100, 5683)
    fp = mix(fp, 15, 5683)
    fp = mix(fp, 15, 5683)
    fp = mix(fp, 0, 5683)
    fp = mix(fp, 0, 5683)
    fp = mix(fp, 1, 5683)
    fp = mix(fp, 4, 5683)
    fp = mix(fp, 27, 5683)
    fp = mix(fp, 255, 5683)
    return fp
}

fn main() -> i64 {
    let instance = instance_fp()
    if instance != 549978893 { return 1 }
    let certificate = certificate_fp(instance)
    if certificate != 696181837 { return 2 }
    let artifact = artifact_fp(instance, certificate)
    if artifact != 461075499 { return 3 }
    let audit = audit_fp(artifact, instance, certificate)
    if audit != 641858696 { return 4 }
    return 0
}
