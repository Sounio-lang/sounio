//@ run-pass
// indep_knowledge_grammar.sio
//
// IndepKnowledge<T, A, B | Z> is writable. Before this, the type kind existed
// in the checker (TypeKind::TyCondIndep, its constructor, its compat rule, its
// printer) while no surface syntax could produce it — so nothing in the language
// could ever assert independence, and every quadrature was unfounded by default.
//
// The `|` is the conditioning bar of P(A ⊥ B | Z), and it is accepted only after
// this head; no other type position gains a pipe.
//
// The claim is transparent to T at runtime: it is checked, not represented. That
// is deliberate — an independence claim is an obligation on the program, not a
// value the program carries around.
//
// The degenerate claim A = B is rejected; see
// tests/compile-fail/cond_indep_violation.sio.

fn main() -> i64 with IO {
    // Marginal independence: the conditioning set is empty.
    let m: IndepKnowledge<f64, hrv, kp> = 12.5

    // The same claim, with the empty set written out. Both mean X ⊥ Y | {}.
    let e: IndepKnowledge<f64, hrv, kp> = 12.5
    let e2: IndepKnowledge<f64, hrv, kp | {}> = 12.5

    // Conditioned on one variable. This is the honest form for the physiological
    // case: heart-rate variability and geomagnetic activity share time of day as
    // a driver, so any independence between them is conditional on it.
    let c1: IndepKnowledge<f64, hrv, kp | hora> = 12.5

    // Conditioned on a set.
    let c2: IndepKnowledge<f64, hrv, kp | {hora, plantao}> = 12.5

    // Unbraced multi-variable conditioning set.
    let c3: IndepKnowledge<f64, hrv, kp | hora, plantao> = 12.5

    // Transparent to T: arithmetic on the inner type works unchanged.
    let soma = m + e + e2 + c1 + c2 + c3
    if soma < 74.0 || soma > 76.0 {
        println("FALHA: o tipo deveria ser transparente ao f64 interno")
        return 1
    }

    // A conditioning set is a SET: order carries no meaning.
    let s1: IndepKnowledge<f64, hrv, kp | {hora, plantao}> = 1.0
    let s2: IndepKnowledge<f64, hrv, kp | {plantao, hora}> = 1.0
    if s1 != s2 {
        println("FALHA: a ordem do conjunto condicionante nao deveria importar")
        return 1
    }

    println("OK: IndepKnowledge<T, A, B | Z> agora se escreve")
    println("  marginal, | {}, | Z, | {Z1, Z2} e | Z1, Z2 aceitos")
    0
}
