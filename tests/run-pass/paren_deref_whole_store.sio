//@ run-pass
//@ description: `(*p) = v` stores through a &! ref exactly like `*p = v` (scalar, f64, struct, array). lean_single used to drop the parenthesised store silently.
//@ expect-stdout: PASS

struct Pair {
    pub a: i64,
    pub b: i64,
}

fn set_paren_i64(out: &! i64, v: i64) with Mut {
    (*out) = v
}

fn set_bare_i64(out: &! i64, v: i64) with Mut {
    *out = v
}

fn set_paren_f64(out: &! f64, v: f64) with Mut {
    (*out) = v
}

fn set_paren_pair(out: &! Pair, a: i64, b: i64) with Mut {
    (*out) = Pair { a: a, b: b }
}

fn set_paren_arr(out: &! [i64; 4]) with Mut {
    var tmp: [i64; 4] = [0; 4]
    tmp[0] = 11
    tmp[3] = 44
    (*out) = tmp
}

fn main() -> i32 with IO, Mut, Panic {
    var n: i64 = 0 - 7
    set_paren_i64(&! n, 42)
    if n != 42 {
        print("FAIL paren i64 n=") print_int(n) print("\n")
        return 1
    }
    var m: i64 = 0 - 7
    set_bare_i64(&! m, 43)
    if m != 43 {
        print("FAIL bare i64 m=") print_int(m) print("\n")
        return 1
    }
    var x: f64 = 0.5
    set_paren_f64(&! x, 2.25)
    if x != 2.25 {
        println("FAIL paren f64")
        return 1
    }
    var p = Pair { a: 1, b: 2 }
    set_paren_pair(&! p, 30, 40)
    if p.a != 30 || p.b != 40 {
        print("FAIL paren struct a=") print_int(p.a) print(" b=") print_int(p.b) print("\n")
        return 1
    }
    var arr: [i64; 4] = [0; 4]
    set_paren_arr(&! arr)
    if arr[0] != 11 || arr[3] != 44 {
        print("FAIL paren array a0=") print_int(arr[0]) print(" a3=") print_int(arr[3]) print("\n")
        return 1
    }
    println("PASS")
    return 0
}
