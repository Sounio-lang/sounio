//@ run-pass
//@ expect-stdout-contains: All or-pattern tests passed
// Phase 1.4: or-pattern arms in match expressions (A | B => body)

enum Color {
    Red,
    Green,
    Blue,
}

fn assert_eq_i32(a: i32, b: i32, msg: str) with IO, Panic {
    if a != b {
        println("FAIL: " ++ msg)
        panic("assertion failed: values not equal")
    }
}

fn main() with IO, Panic, Mut {
    println("=== Or-Pattern Match Tests ===")

    // ---- T01: Integer or-pattern, first alternative matches ----
    println("T01: integer or-pattern first alt")
    var n: i64 = 1
    var r: i64 = 0
    match n {
        1 | 2 | 3 => { r = 10 }
        _ => { r = 99 }
    }
    if r != 10 { panic("T01 failed") }
    println("  PASS")

    // ---- T02: Integer or-pattern, middle alternative matches ----
    println("T02: integer or-pattern middle alt")
    n = 2
    r = 0
    match n {
        1 | 2 | 3 => { r = 10 }
        _ => { r = 99 }
    }
    if r != 10 { panic("T02 failed") }
    println("  PASS")

    // ---- T03: Integer or-pattern, last alternative matches ----
    println("T03: integer or-pattern last alt")
    n = 3
    r = 0
    match n {
        1 | 2 | 3 => { r = 10 }
        _ => { r = 99 }
    }
    if r != 10 { panic("T03 failed") }
    println("  PASS")

    // ---- T04: Integer or-pattern, no alternative matches → wildcard ----
    println("T04: integer or-pattern no match → wildcard")
    n = 5
    r = 0
    match n {
        1 | 2 | 3 => { r = 10 }
        _ => { r = 99 }
    }
    if r != 99 { panic("T04 failed") }
    println("  PASS")

    // ---- T05: Two-alternative integer or-pattern ----
    println("T05: two-alternative integer or-pattern")
    n = 7
    r = 0
    match n {
        7 | 8 => { r = 42 }
        _ => { r = 0 }
    }
    if r != 42 { panic("T05 failed") }
    println("  PASS")

    // ---- T06: Enum or-pattern, first alternative matches ----
    println("T06: enum or-pattern first alt")
    let c = Color::Red
    var color_id: i32 = 0
    match c {
        Color::Red | Color::Blue => { color_id = 1 }
        Color::Green => { color_id = 2 }
    }
    assert_eq_i32(color_id, 1, "Color::Red should match Red|Blue arm")
    println("  PASS")

    // ---- T07: Enum or-pattern, second alternative matches ----
    println("T07: enum or-pattern second alt")
    let c2 = Color::Blue
    color_id = 0
    match c2 {
        Color::Red | Color::Blue => { color_id = 1 }
        Color::Green => { color_id = 2 }
    }
    assert_eq_i32(color_id, 1, "Color::Blue should match Red|Blue arm")
    println("  PASS")

    // ---- T08: Enum or-pattern, non-matching falls to next arm ----
    println("T08: enum or-pattern non-matching arm")
    let c3 = Color::Green
    color_id = 0
    match c3 {
        Color::Red | Color::Blue => { color_id = 1 }
        Color::Green => { color_id = 2 }
    }
    assert_eq_i32(color_id, 2, "Color::Green should match Green arm")
    println("  PASS")

    // ---- T09: Option or-pattern: None matches ----
    println("T09: None or-pattern")
    let opt: ?i32 = None
    r = 0
    match opt {
        None => { r = 1 }
        Some(v) => { r = 2 }
    }
    if r != 1 { panic("T09 failed") }
    println("  PASS")

    // ---- T10: Integer or-pattern, value zero ----
    println("T10: integer or-pattern with zero")
    n = 0
    r = 0
    match n {
        0 | 1 => { r = 55 }
        _ => { r = 0 }
    }
    if r != 55 { panic("T10 failed") }
    println("  PASS")

    println("")
    println("=== All or-pattern tests passed ===")
}
