//@ run-pass
//@ requires: madaros
//@ expect-stdout: ns-union-mul: PASS
//
// N2 witness (REQ-3, union, OpMul -- separate from OpAdd): multiplication
// goes through the SAME knowledge_binary_result union site as addition
// (self-hosted/check/epistemic.sio), just with a different epsilon-combine
// rule. Observable only under SOUNIO_NS_TRACE=1: two "NS_TRACE measure=<h>"
// seed lines with DISTINCT handles, then one "NS_TRACE union=<h>" line for
// the product.

fn main() -> i64 with IO {
    let a: Knowledge[f64, Measured] = measure(3.0, uncertainty: 0.1)
    let b: Knowledge[f64, Measured] = measure(4.0, uncertainty: 0.1)
    let p: Knowledge[f64, Derived] = a * b
    println("ns-union-mul: PASS")
    0
}
