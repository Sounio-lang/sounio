//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_EIGHT_PARAM_PASS

// Bold FO: pure helpers with up to 8 parameters (was 4).
// Multi-factor PK/DDI style sums and products through inter-procedural FO bytecode.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn five_sum(a: f64, b: f64, c: f64, d: f64, e: f64) -> f64 {
    a + b + c + d + e
}

fn five_prod(a: f64, b: f64, c: f64, d: f64, e: f64) -> f64 {
    (((a * b) * c) * d) * e
}

fn eight_sum(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: f64) -> f64 {
    a + b + c + d + e + f + g + h
}

fn weighted3(a: f64, b: f64, c: f64, w1: f64, w2: f64, w3: f64) -> f64 {
    let t1 = w1 * a
    let t2 = w2 * b
    let t3 = w3 * c
    t1 + t2 + t3
}

fn main() with IO, Mut, Div, Epistemic {
    let k0: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k1: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k2: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k3: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k4: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k5: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k6: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k7: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let a = k0.value
    let b = k1.value
    let c = k2.value
    let d = k3.value
    let e = k4.value
    let f = k5.value
    let g = k6.value
    let h = k7.value

    // 5 independent unit vars: Var(sum)=5*0.0025=0.0125
    let v5s = variance_of(five_sum(a, b, c, d, e))
    // 5 independent unit product: each ∂=1, Var=5*0.0025=0.0125
    let v5p = variance_of(five_prod(a, b, c, d, e))
    // 8-sum: 8*0.0025=0.02
    let v8s = variance_of(eight_sum(a, b, c, d, e, f, g, h))
    // weighted: f=w1*a+w2*b+w3*c with wi fixed via measure 2,3,4? use constants via helpers
    // Use pure constants as Knowledge with zero unc would need measure(2,0)
    let w1k: Knowledge<f64> = measure(2.0, uncertainty: 0.0)
    let w2k: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let w3k: Knowledge<f64> = measure(4.0, uncertainty: 0.0)
    let w1 = w1k.value
    let w2 = w2k.value
    let w3 = w3k.value
    // s_a=2,s_b=3,s_c=4 → Var=4*0.0025+9*0.0025+16*0.0025=0.0725
    let vw = variance_of(weighted3(a, b, c, w1, w2, w3))

    print("v5s="); print_f64(v5s); print("\n")
    print("v5p="); print_f64(v5p); print("\n")
    print("v8s="); print_f64(v8s); print("\n")
    print("vw="); print_f64(vw); print("\n")

    let ok = abs_f(v5s - 0.0125) < 1.0e-9
        && abs_f(v5p - 0.0125) < 1.0e-9
        && abs_f(v8s - 0.02) < 1.0e-9
        && abs_f(vw - 0.0725) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_EIGHT_PARAM_PASS\n")
    } else {
        print("MADAROS_GUM_FO_EIGHT_PARAM_FAIL\n")
    }
}
