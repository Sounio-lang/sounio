//@ run-pass
// test_interpolation.sio - Tests for interpolation methods
//
// Self-contained tests for linear interpolation, Newton divided differences,
// and barycentric Lagrange interpolation. All helpers inlined (no imports).
// Arrays fixed at size 32.
//
// References:
//   Berrut & Trefethen, "Barycentric Lagrange Interpolation",
//       SIAM Review 46(3), 2004, pp. 501-517
//   Atkinson, "An Introduction to Numerical Analysis" (2nd ed.)

// ============================================================================
// PURE MATH HELPERS (must precede callers)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn floor_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x >= 0.0 {
        let i = x as i32
        return i as f64
    }
    let i = x as i32
    let f = i as f64
    if f > x { return f - 1.0 }
    return f
}

fn sin_f64(x: f64) -> f64 with Mut, Panic, Div {
    let pi = 3.141592653589793
    let two_pi = 6.283185307179586
    var t = x - floor_f64(x / two_pi) * two_pi
    if t > pi { t = t - two_pi }
    if t < 0.0 - pi { t = t + two_pi }
    var sum = t
    var term = t
    var n = 1
    while n <= 20 {
        term = 0.0 - term * t * t / (((2 * n) as f64) * ((2 * n + 1) as f64))
        sum = sum + term
        n = n + 1
    }
    return sum
}

fn cos_f64(x: f64) -> f64 with Mut, Panic, Div {
    return sin_f64(x + 1.5707963267948966)
}

fn exp_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x > 20.0 { return exp_f64(x / 2.0) * exp_f64(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / exp_f64(0.0 - x) }

    var sum = 1.0
    var term = 1.0
    var k = 1
    while k <= 25 {
        term = term * x / (k as f64)
        sum = sum + term
        k = k + 1
    }
    return sum
}

fn approx_eq(a: f64, b: f64, tol: f64) -> bool {
    abs_f64(a - b) < tol
}

// ============================================================================
// LINEAR INTERPOLATION (sorted x[], y[], binary search + lerp)
// ============================================================================

fn linear_interp(xs: &[f64; 32], ys: &[f64; 32], n: i32, t: f64) -> f64 with Mut, Panic, Div {
    if n < 2 {
        if n == 1 { return ys[0] }
        return 0.0
    }
    if t <= xs[0] { return ys[0] }
    if t >= xs[n - 1] { return ys[n - 1] }

    // Binary search for interval
    var lo: i32 = 0
    var hi: i32 = n - 1
    while hi - lo > 1 {
        let mid = lo + (hi - lo) / 2
        if xs[mid] <= t {
            lo = mid
        } else {
            hi = mid
        }
    }

    let h = xs[lo + 1] - xs[lo]
    if abs_f64(h) < 1.0e-30 { return ys[lo] }
    let frac = (t - xs[lo]) / h
    return ys[lo] + frac * (ys[lo + 1] - ys[lo])
}

// ============================================================================
// NEWTON DIVIDED DIFFERENCES
// ============================================================================

fn newton_coeffs(x: &[f64; 32], y: &[f64; 32], n: i32, c: &![f64; 32]) with Mut, Div, Panic {
    var i = 0
    while i < n { c[i] = y[i]; i = i + 1 }
    var j = 1
    while j < n {
        i = n - 1
        while i >= j {
            c[i] = (c[i] - c[i - 1]) / (x[i] - x[i - j])
            i = i - 1
        }
        j = j + 1
    }
}

fn newton_eval(x: &[f64; 32], c: &[f64; 32], n: i32, t: f64) -> f64 with Mut, Div, Panic {
    var result = c[n - 1]
    var i = n - 2
    while i >= 0 {
        result = result * (t - x[i]) + c[i]
        i = i - 1
    }
    result
}

// ============================================================================
// BARYCENTRIC LAGRANGE INTERPOLATION
// ============================================================================

fn bary_weights(x: &[f64; 32], n: i32, w: &![f64; 32]) with Mut, Div, Panic {
    var i = 0
    while i < n {
        w[i] = 1.0
        var j = 0
        while j < n {
            if j != i { w[i] = w[i] / (x[i] - x[j]) }
            j = j + 1
        }
        i = i + 1
    }
}

fn bary_eval(x: &[f64; 32], y: &[f64; 32], w: &[f64; 32], n: i32, t: f64) -> f64 with Mut, Div, Panic {
    var num = 0.0
    var den = 0.0
    var i = 0
    while i < n {
        let d = t - x[i]
        if abs_f64(d) < 1.0e-15 { return y[i] }
        let term = w[i] / d
        num = num + term * y[i]
        den = den + term
        i = i + 1
    }
    num / den
}

// ============================================================================
// TESTS
// ============================================================================

// Test 1: Linear interp of y=2x+1 at nodes [0,1,2,3], eval at x=1.5, expect 4.0
fn test_linear_interp_basic() -> bool with IO, Mut, Panic, Div {
    var xs: [f64; 32] = [0.0; 32]
    var ys: [f64; 32] = [0.0; 32]
    xs[0] = 0.0; ys[0] = 1.0
    xs[1] = 1.0; ys[1] = 3.0
    xs[2] = 2.0; ys[2] = 5.0
    xs[3] = 3.0; ys[3] = 7.0

    let val = linear_interp(&xs, &ys, 4, 1.5)
    let err = abs_f64(val - 4.0)

    print("  val=")
    println(val)
    print("  err=")
    println(err)

    return err < 1.0e-12
}

// Test 2: Linear interp at a node: eval at x=1.0, expect y[1] exactly
fn test_linear_interp_at_node() -> bool with IO, Mut, Panic, Div {
    var xs: [f64; 32] = [0.0; 32]
    var ys: [f64; 32] = [0.0; 32]
    xs[0] = 0.0; ys[0] = 1.0
    xs[1] = 1.0; ys[1] = 3.0
    xs[2] = 2.0; ys[2] = 5.0
    xs[3] = 3.0; ys[3] = 7.0

    let val = linear_interp(&xs, &ys, 4, 1.0)
    let err = abs_f64(val - 3.0)

    print("  val=")
    println(val)
    print("  err=")
    println(err)

    return err < 1.0e-12
}

// Test 3: Newton interp of 3 points on y=x^2: (0,0),(1,1),(2,4), eval at x=1.5, expect 2.25
fn test_newton_quadratic() -> bool with IO, Mut, Panic, Div {
    var xs: [f64; 32] = [0.0; 32]
    var ys: [f64; 32] = [0.0; 32]
    xs[0] = 0.0; ys[0] = 0.0
    xs[1] = 1.0; ys[1] = 1.0
    xs[2] = 2.0; ys[2] = 4.0

    var c: [f64; 32] = [0.0; 32]
    newton_coeffs(&xs, &ys, 3, &!c)
    let val = newton_eval(&xs, &c, 3, 1.5)
    let err = abs_f64(val - 2.25)

    print("  val=")
    println(val)
    print("  err=")
    println(err)

    return err < 1.0e-10
}

// Test 4: Newton interp reproduces polynomial exactly: 4 points on y=x^3, eval at midpoint
fn test_newton_cubic_exact() -> bool with IO, Mut, Panic, Div {
    var xs: [f64; 32] = [0.0; 32]
    var ys: [f64; 32] = [0.0; 32]
    xs[0] = 0.0; ys[0] = 0.0
    xs[1] = 1.0; ys[1] = 1.0
    xs[2] = 2.0; ys[2] = 8.0
    xs[3] = 3.0; ys[3] = 27.0

    var c: [f64; 32] = [0.0; 32]
    newton_coeffs(&xs, &ys, 4, &!c)

    // Eval at x=1.5: expected 1.5^3 = 3.375
    let val = newton_eval(&xs, &c, 4, 1.5)
    let expected = 3.375
    let err = abs_f64(val - expected)

    print("  val=")
    println(val)
    print("  expected=")
    println(expected)
    print("  err=")
    println(err)

    return err < 1.0e-8
}

// Test 5: Barycentric interp of y=sin(x) at 5 equispaced nodes [0,pi/4,pi/2,3pi/4,pi],
//         eval at pi/3
fn test_bary_sin() -> bool with IO, Mut, Panic, Div {
    let pi = 3.141592653589793
    var xs: [f64; 32] = [0.0; 32]
    var ys: [f64; 32] = [0.0; 32]
    xs[0] = 0.0;             ys[0] = sin_f64(0.0)
    xs[1] = pi / 4.0;       ys[1] = sin_f64(pi / 4.0)
    xs[2] = pi / 2.0;       ys[2] = sin_f64(pi / 2.0)
    xs[3] = 3.0 * pi / 4.0; ys[3] = sin_f64(3.0 * pi / 4.0)
    xs[4] = pi;             ys[4] = sin_f64(pi)

    var w: [f64; 32] = [0.0; 32]
    bary_weights(&xs, 5, &!w)

    let t = pi / 3.0
    let val = bary_eval(&xs, &ys, &w, 5, t)
    let expected = sin_f64(t)
    let err = abs_f64(val - expected)

    print("  val=")
    println(val)
    print("  expected=")
    println(expected)
    print("  err=")
    println(err)

    return err < 1.0e-2
}

// Test 6: Barycentric interp at a node returns exact value
fn test_bary_at_node() -> bool with IO, Mut, Panic, Div {
    var xs: [f64; 32] = [0.0; 32]
    var ys: [f64; 32] = [0.0; 32]
    xs[0] = 0.0; ys[0] = 1.0
    xs[1] = 1.0; ys[1] = 3.0
    xs[2] = 2.0; ys[2] = 7.0
    xs[3] = 3.0; ys[3] = 13.0

    var w: [f64; 32] = [0.0; 32]
    bary_weights(&xs, 4, &!w)

    let val = bary_eval(&xs, &ys, &w, 4, 2.0)
    let err = abs_f64(val - 7.0)

    print("  val=")
    println(val)
    print("  err=")
    println(err)

    return err < 1.0e-12
}

// Test 7: For n points on a degree-(n-1) polynomial, Newton interp is exact
//         5 points on y = x^4 - 2x^2 + x, eval at x=0.7
fn test_newton_degree4_exact() -> bool with IO, Mut, Panic, Div {
    var xs: [f64; 32] = [0.0; 32]
    var ys: [f64; 32] = [0.0; 32]
    // p(x) = x^4 - 2x^2 + x
    xs[0] = 0.0 - 2.0; ys[0] = 16.0 - 8.0 + (0.0 - 2.0)       // p(-2) = 16 - 8 - 2 = 6
    xs[1] = 0.0 - 1.0; ys[1] = 1.0 - 2.0 + (0.0 - 1.0)         // p(-1) = 1 - 2 - 1 = -2
    xs[2] = 0.0;        ys[2] = 0.0                               // p(0) = 0
    xs[3] = 1.0;        ys[3] = 1.0 - 2.0 + 1.0                  // p(1) = 0
    xs[4] = 2.0;        ys[4] = 16.0 - 8.0 + 2.0                 // p(2) = 10

    var c: [f64; 32] = [0.0; 32]
    newton_coeffs(&xs, &ys, 5, &!c)

    let t = 0.7
    let val = newton_eval(&xs, &c, 5, t)
    // p(0.7) = 0.7^4 - 2*(0.7^2) + 0.7 = 0.2401 - 0.98 + 0.7 = -0.0399
    let expected = 0.2401 - 0.98 + 0.7
    let err = abs_f64(val - expected)

    print("  val=")
    println(val)
    print("  expected=")
    println(expected)
    print("  err=")
    println(err)

    return err < 1.0e-8
}

// Test 8: Barycentric and Newton agree at same evaluation point
fn test_bary_newton_agree() -> bool with IO, Mut, Panic, Div {
    var xs: [f64; 32] = [0.0; 32]
    var ys: [f64; 32] = [0.0; 32]
    xs[0] = 0.0; ys[0] = 1.0
    xs[1] = 1.0; ys[1] = 2.7
    xs[2] = 2.0; ys[2] = 5.3
    xs[3] = 3.0; ys[3] = 9.1
    xs[4] = 4.0; ys[4] = 14.0

    // Newton
    var c: [f64; 32] = [0.0; 32]
    newton_coeffs(&xs, &ys, 5, &!c)
    let newton_val = newton_eval(&xs, &c, 5, 2.5)

    // Barycentric
    var w: [f64; 32] = [0.0; 32]
    bary_weights(&xs, 5, &!w)
    let bary_val = bary_eval(&xs, &ys, &w, 5, 2.5)

    let diff = abs_f64(newton_val - bary_val)

    print("  newton_val=")
    println(newton_val)
    print("  bary_val=")
    println(bary_val)
    print("  diff=")
    println(diff)

    return diff < 1.0e-8
}

// Test 9: Linear interp on 2 points = exact line: (0,0),(1,1) at x=0.5 gives 0.5
fn test_linear_two_points() -> bool with IO, Mut, Panic, Div {
    var xs: [f64; 32] = [0.0; 32]
    var ys: [f64; 32] = [0.0; 32]
    xs[0] = 0.0; ys[0] = 0.0
    xs[1] = 1.0; ys[1] = 1.0

    let val = linear_interp(&xs, &ys, 2, 0.5)
    let err = abs_f64(val - 0.5)

    print("  val=")
    println(val)
    print("  err=")
    println(err)

    return err < 1.0e-12
}

// Test 10: Newton interp of 2 points = linear
fn test_newton_two_points_linear() -> bool with IO, Mut, Panic, Div {
    var xs: [f64; 32] = [0.0; 32]
    var ys: [f64; 32] = [0.0; 32]
    xs[0] = 1.0; ys[0] = 3.0
    xs[1] = 4.0; ys[1] = 9.0

    var c: [f64; 32] = [0.0; 32]
    newton_coeffs(&xs, &ys, 2, &!c)

    // Eval at x=2.5: line y = 2x + 1, expect 6.0
    let val = newton_eval(&xs, &c, 2, 2.5)
    let expected = 6.0
    let err = abs_f64(val - expected)

    print("  val=")
    println(val)
    print("  expected=")
    println(expected)
    print("  err=")
    println(err)

    return err < 1.0e-12
}

// Test 11: Interpolation of constant function: all methods return constant
fn test_constant_function() -> bool with IO, Mut, Panic, Div {
    let c_val = 7.77
    var xs: [f64; 32] = [0.0; 32]
    var ys: [f64; 32] = [0.0; 32]
    xs[0] = 0.0; ys[0] = c_val
    xs[1] = 1.0; ys[1] = c_val
    xs[2] = 2.0; ys[2] = c_val
    xs[3] = 3.0; ys[3] = c_val
    xs[4] = 4.0; ys[4] = c_val

    let t = 2.3

    // Linear
    let lin_val = linear_interp(&xs, &ys, 5, t)
    let lin_err = abs_f64(lin_val - c_val)

    // Newton
    var nc: [f64; 32] = [0.0; 32]
    newton_coeffs(&xs, &ys, 5, &!nc)
    let newt_val = newton_eval(&xs, &nc, 5, t)
    let newt_err = abs_f64(newt_val - c_val)

    // Barycentric
    var w: [f64; 32] = [0.0; 32]
    bary_weights(&xs, 5, &!w)
    let bary_val = bary_eval(&xs, &ys, &w, 5, t)
    let bary_err = abs_f64(bary_val - c_val)

    print("  lin_err=")
    println(lin_err)
    print("  newt_err=")
    println(newt_err)
    print("  bary_err=")
    println(bary_err)

    return lin_err < 1.0e-12 && newt_err < 1.0e-12 && bary_err < 1.0e-12
}

// Test 12: 5-point Newton interp of exp(x) at Chebyshev nodes, eval at 0, error < 0.01
fn test_newton_exp_chebyshev() -> bool with IO, Mut, Panic, Div {
    let pi = 3.141592653589793
    let n = 5

    // Chebyshev nodes on [-1, 1]: x_k = cos((2k+1)*pi / (2n))
    var xs: [f64; 32] = [0.0; 32]
    var ys: [f64; 32] = [0.0; 32]

    var k = 0
    while k < n {
        let angle = ((2 * k + 1) as f64) * pi / ((2 * n) as f64)
        xs[k] = cos_f64(angle)
        ys[k] = exp_f64(xs[k])
        k = k + 1
    }

    var c: [f64; 32] = [0.0; 32]
    newton_coeffs(&xs, &ys, n, &!c)
    let val = newton_eval(&xs, &c, n, 0.0)
    let expected = 1.0  // exp(0) = 1
    let err = abs_f64(val - expected)

    print("  val=")
    println(val)
    print("  expected=")
    println(expected)
    print("  err=")
    println(err)

    return err < 1.0e-2
}

// Test 13: Runge function 1/(1+25x^2): Chebyshev nodes give better interp than equispaced
fn test_runge_chebyshev_vs_equispaced() -> bool with IO, Mut, Panic, Div {
    let pi = 3.141592653589793
    let n = 11

    // Equispaced nodes on [-1, 1]
    var xs_eq: [f64; 32] = [0.0; 32]
    var ys_eq: [f64; 32] = [0.0; 32]
    var i = 0
    while i < n {
        xs_eq[i] = 0.0 - 1.0 + 2.0 * (i as f64) / ((n - 1) as f64)
        ys_eq[i] = 1.0 / (1.0 + 25.0 * xs_eq[i] * xs_eq[i])
        i = i + 1
    }

    // Chebyshev nodes on [-1, 1]
    var xs_ch: [f64; 32] = [0.0; 32]
    var ys_ch: [f64; 32] = [0.0; 32]
    i = 0
    while i < n {
        let angle = ((2 * i + 1) as f64) * pi / ((2 * n) as f64)
        xs_ch[i] = cos_f64(angle)
        ys_ch[i] = 1.0 / (1.0 + 25.0 * xs_ch[i] * xs_ch[i])
        i = i + 1
    }

    // Newton coefficients for both
    var c_eq: [f64; 32] = [0.0; 32]
    newton_coeffs(&xs_eq, &ys_eq, n, &!c_eq)

    var c_ch: [f64; 32] = [0.0; 32]
    newton_coeffs(&xs_ch, &ys_ch, n, &!c_ch)

    // Evaluate max error at a set of test points
    var max_err_eq = 0.0
    var max_err_ch = 0.0
    var j = 0
    while j <= 20 {
        let t = 0.0 - 1.0 + 2.0 * (j as f64) / 20.0
        let exact = 1.0 / (1.0 + 25.0 * t * t)

        let v_eq = newton_eval(&xs_eq, &c_eq, n, t)
        let e_eq = abs_f64(v_eq - exact)
        if e_eq > max_err_eq { max_err_eq = e_eq }

        let v_ch = newton_eval(&xs_ch, &c_ch, n, t)
        let e_ch = abs_f64(v_ch - exact)
        if e_ch > max_err_ch { max_err_ch = e_ch }

        j = j + 1
    }

    print("  max_err_equispaced=")
    println(max_err_eq)
    print("  max_err_chebyshev=")
    println(max_err_ch)

    // Chebyshev should be strictly better for Runge function
    return max_err_ch < max_err_eq
}

// Test 14: Newton interp of 4 equispaced points on sin(x) at midpoint
fn test_newton_sin_midpoint() -> bool with IO, Mut, Panic, Div {
    let pi = 3.141592653589793
    var xs: [f64; 32] = [0.0; 32]
    var ys: [f64; 32] = [0.0; 32]
    xs[0] = 0.0;           ys[0] = sin_f64(0.0)
    xs[1] = pi / 4.0;      ys[1] = sin_f64(pi / 4.0)
    xs[2] = pi / 2.0;      ys[2] = sin_f64(pi / 2.0)
    xs[3] = 3.0 * pi / 4.0; ys[3] = sin_f64(3.0 * pi / 4.0)

    var c: [f64; 32] = [0.0; 32]
    newton_coeffs(&xs, &ys, 4, &!c)

    // Eval at midpoint pi/3
    let t = pi / 3.0
    let val = newton_eval(&xs, &c, 4, t)
    let expected = sin_f64(t)
    let err = abs_f64(val - expected)

    print("  val=")
    println(val)
    print("  expected=")
    println(expected)
    print("  err=")
    println(err)

    return err < 1.0e-4
}

// Test 15: Barycentric Lagrange of degree 10 polynomial is exact at eval point
//          p(x) = x^3 + 2x^2 - x + 3, using 11 nodes (degree <= 10, so 11 nodes exact)
fn test_bary_high_degree_exact() -> bool with IO, Mut, Panic, Div {
    let n = 11

    // Use 11 equispaced nodes on [0, 5]
    var xs: [f64; 32] = [0.0; 32]
    var ys: [f64; 32] = [0.0; 32]
    var i = 0
    while i < n {
        let xv = (i as f64) * 0.5
        xs[i] = xv
        // p(x) = x^3 + 2*x^2 - x + 3
        ys[i] = xv * xv * xv + 2.0 * xv * xv - xv + 3.0
        i = i + 1
    }

    var w: [f64; 32] = [0.0; 32]
    bary_weights(&xs, n, &!w)

    // Eval at x = 2.3
    let t = 2.3
    let val = bary_eval(&xs, &ys, &w, n, t)
    let expected = t * t * t + 2.0 * t * t - t + 3.0
    let err = abs_f64(val - expected)

    print("  val=")
    println(val)
    print("  expected=")
    println(expected)
    print("  err=")
    println(err)

    return err < 1.0e-6
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== Interpolation Methods Test Suite ===")
    println("")

    var passed = 0
    var failed = 0

    // Test 1
    print("Test  1: linear interp y=2x+1....... ")
    if test_linear_interp_basic() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 2
    print("Test  2: linear interp at node...... ")
    if test_linear_interp_at_node() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 3
    print("Test  3: Newton y=x^2 at 1.5....... ")
    if test_newton_quadratic() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 4
    print("Test  4: Newton y=x^3 exact........ ")
    if test_newton_cubic_exact() {
