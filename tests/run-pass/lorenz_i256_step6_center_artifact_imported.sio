//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-6 center artifact checks quotient/remainder witness API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step6_center_artifact_check(
        42949672, 96,
        143628214324, 3606116906,
        12435782019, 2421034086,
        10892901160, 0,
        474878934, 2944751696,
        1335694801, 665264776,
        15428808, 1052865080,
        5784820704, 11394426024, 4100266743)
    if artifact_fp != 134624236 { return 1 }

    let audit_fp = lorenz_i256_step6_center_artifact_audit_fingerprint(
        artifact_fp, 104233294, 366755610, 214180161,
        506104143, 956295573, 6, 1, 127)
    if audit_fp != 643317565 { return 2 }
    return 0
}
