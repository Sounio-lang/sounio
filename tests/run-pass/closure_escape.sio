//@ run-pass
//@ expect-stdout: PASS
// Escaping closure: closure returned from function, env outlives creating frame.
// Requires heap-allocated env (mmap) so captures survive past make_adder's return.

fn make_adder(n: i64) -> fn(i64) -> i64 with Mut, Panic, Div {
    |x: i64| -> i64 { x + n }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let add5 = make_adder(5)
    let add10 = make_adder(10)
    let r1 = add5(10)
    let r2 = add10(7)
    assert(r1 == 15)
    assert(r2 == 17)
    print("PASS\n")
    0
}
