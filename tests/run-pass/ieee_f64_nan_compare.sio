//@ run-pass
//@ expect-stdout: IEEE_F64_NAN_CMP_OK
//@ sabotage: ieee-f64-special

// IEEE 754 f64 compares with NaN operands (#2389 / KL-2).
fn main() -> i32 with IO, Mut, Div, Panic {
    let inf: f64 = 1.0 / 0.0
    let nan: f64 = inf - inf
    if nan == nan { return 1 }
    if nan != nan == false { return 2 }
    if nan < 1.0 { return 3 }
    if nan > 1.0 { return 4 }
    if nan <= 1.0 { return 5 }
    if nan >= 1.0 { return 6 }
    if 1.0 == nan { return 7 }
    println("IEEE_F64_NAN_CMP_OK")
    0
}
