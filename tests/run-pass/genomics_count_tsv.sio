fn visual_qc() with Mut,Div,Panic {
 var qc=count_qc_new(3)
 let r0:[i64;8]=[0,2,4,0,0,0,0,0]
 assert(count_qc_add_row(&!qc,&r0)==0)
 let r1:[i64;8]=[3,0,0,0,0,0,0,0]
 assert(count_qc_add_row(&!qc,&r1)==0)
 let r2:[i64;8]=[0,6,0,0,0,0,0,0]
 assert(count_qc_add_row(&!qc,&r2)==0)
 let r3:[i64;8]=[5,7,8,0,0,0,0,0]
 assert(count_qc_add_row(&!qc,&r3)==0)
 assert(qc.rows==4)
 assert(qc.totals[0]==8 && qc.zeros[0]==2)
 assert(qc.totals[1]==15 && qc.zeros[1]==1)
 assert(qc.totals[2]==12 && qc.zeros[2]==2)
}
