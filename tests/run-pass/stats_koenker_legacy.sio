//@ run-pass
//@ expect-stdout: STATS_KOENKER_LEGACY_PASS
use stats::epistemic::assumptions::{breusch_pagan_test}
fn main() with IO,Mut,Div,Panic {
 var x:[f64;100]=[0.0;100]
 var e:[f64;100]=[0.0;100]
 x[0]=0.0;x[1]=1.0e-200;x[2]=2.0e-200;x[3]=3.0e-200;x[4]=4.0e-200;x[5]=5.0e-200;x[6]=6.0e-200;x[7]=7.0e-200
 e[0]=0.1e200;e[1]=-0.3e200;e[2]=0.2e200;e[3]=-0.6e200;e[4]=0.8e200;e[5]=-0.2e200;e[6]=1.1e200;e[7]=-1.8e200
 let r=breusch_pagan_test(e,x,8)
 assert(r.status==0 && r.asymptotic && r.df==1)
 assert(r.lm>4.520536342 && r.lm<4.520536344)
 assert(r.p>0.033490330970 && r.p<0.033490330975)
 assert(breusch_pagan_test(e,x,101).status==1)
 println("STATS_KOENKER_LEGACY_PASS")
 0
}
