//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_VIZ_DYNAMIC_CONTOUR_PASS
//@ expect-stdout: data-saddle="exact-dyadic"
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_close,numeric_matrix}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
use display::canvas::{Canvas,canvas_clear}
use viz::dynamic_plot::{DynamicPlotSpec}
use viz::dynamic_contour::{dynamic_contour_canvas,dynamic_contour_svg}
fn contour_case(c:&!Canvas,id:i64) with IO,Alloc,Mut,Div,Panic {
 let wide=id>=6 && id<=8
 let cols:i64=if wide {3}else{2}
 var xs=numeric_buffer_new(cols,24);var ys=numeric_buffer_new(2,16)
 var data=numeric_buffer_new(6,48);var levels=numeric_buffer_new(1,8)
 var mask=integer_buffer_new(cols-1,16)
 var i:i64=0
 while i<cols {let a=numeric_buffer_set(&!xs,i,i as f64);i=i+1}
 let y0=numeric_buffer_set(&!ys,0,0.0);let y1=numeric_buffer_set(&!ys,1,1.0)
 let level=numeric_buffer_set(&!levels,0,0.0)
 i=0
 while i<6 {let a=numeric_buffer_set(&!data,i,0.0);i=i+1}
 i=0
 while i<cols-1 {let a=integer_buffer_set(&!mask,i,if id==7 && i==0 {0}else{1});i=i+1}
 if wide {
  let a=numeric_buffer_set(&!data,0,if id==8 {0.0}else{1.0})
  let b=numeric_buffer_set(&!data,2,1.0)
  let d=numeric_buffer_set(&!data,3,if id==8 {0.0}else{1.0})
  let e=numeric_buffer_set(&!data,5,1.0)
 }else{
  var a:f64=1.0;var b:f64= -1.0;var d:f64= -1.0;var e:f64=1.0
  if id==1 {a=3.0;e=3.0}
  if id==2 {b= -3.0;d= -3.0}
  if id==3 {a=0.0;b=0.0;e=1.0;d= -1.0}
  if id==4 {a=0.0;b=0.0;e=1.0;d=0.0}
  if id==5 {a=0.0;b=0.0;e=0.0;d=0.0}
  if id==9 {a=0.0;b= -1.0;e= -1.0;d= -1.0}
  if id==10 {a= -1.0;b=1.0;e=1.0;d= -1.0}
  let sa=numeric_buffer_set(&!data,0,a);let sb=numeric_buffer_set(&!data,1,b)
  let sc=numeric_buffer_set(&!data,4,e);let sd=numeric_buffer_set(&!data,3,d)
 }
 let matrix=numeric_matrix(6,2,cols,3,1,0)
 let spec=DynamicPlotSpec{x:20+id*80,y:20,w:60,h:60,xmin:0.0,xmax:(cols-1) as f64,ymin:0.0,ymax:1.0,r:70,g:180,b:235,interval_kind:0,level:0.0}
 let work=dynamic_contour_canvas(c,&spec,&xs,&ys,&data,&matrix,&mask,&levels,0,20)
 assert(work.status==6 && work.painted==0)
 let limited=dynamic_contour_svg(&spec,&xs,&ys,&data,&matrix,&mask,&levels,20,0,100+id)
 if id==5 || id==9 {assert(limited.status==0 && limited.segments_required==0)}else{assert(limited.status==7 && limited.segments_required>0 && limited.painted==0)}
 let drawn=dynamic_contour_canvas(c,&spec,&xs,&ys,&data,&matrix,&mask,&levels,20,20)
 assert(drawn.status==0 && drawn.painted==drawn.segments_required)
 let emitted=dynamic_contour_svg(&spec,&xs,&ys,&data,&matrix,&mask,&levels,20,20,id)
 assert(emitted.status==0 && emitted.painted==drawn.painted)
 let required:i64=drawn.segments_required;let painted:i64=drawn.painted
 let flat:i64=drawn.flat_cells;let degenerate:i64=drawn.degenerate_segments;let masked:i64=drawn.masked_cells
 print("CONTOUR_CASE ");print(id);print(" ");print(required);print(" ");print(painted);print(" ");print(flat);print(" ");print(degenerate);print(" ");println(masked)
 let invalid=numeric_buffer_set(&!data,if wide {5}else{4},0.0/0.0)
 let failed=dynamic_contour_svg(&spec,&xs,&ys,&data,&matrix,&mask,&levels,20,20,200+id)
 assert(failed.status==3 && failed.painted==0)
 numeric_buffer_close(xs);numeric_buffer_close(ys);numeric_buffer_close(data);numeric_buffer_close(levels);integer_buffer_close(mask)
}
fn main() with IO,Alloc,Mut,Div,Panic {
 let pixels=heap_alloc(920*100*8) as *mut i64
 assert((pixels as i64)>0)
 var canvas=Canvas{pixels:pixels,width:920,height:100}
 canvas_clear(&!canvas,0,0,0)
 println("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"920\" height=\"100\" viewBox=\"0 0 920 100\">")
 var i:i64=0
 while i<11 {contour_case(&!canvas,i);i=i+1}
 println("</svg>")
 var y:i64=0
 while y<100 {
  var x:i64=0
  while x<920 {
   let color:i64=read_i64(canvas.pixels,y*920+x)
   if color!=0 {print("CONTOUR_PIXEL ");print(x);print(" ");print(y);print(" ");println(color)}
   x=x+1
  }
  y=y+1
 }
 heap_free(canvas.pixels as *mut i8)
 println("STDLIB_DEEP_VIZ_DYNAMIC_CONTOUR_PASS")
}
