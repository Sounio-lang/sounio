//@ run-pass
//@ requires: madaros
//@ expect-stdout: 0.260000 2.400000
// `Knowledge[T, ε=⊥]` (Knightian ignorance) parses and type-checks in Madaros.
// The lexer tolerated the `⊥` bytes, but the parser stopped on them, so every
// `ε=⊥` annotation failed to parse and the mode-3 checks were dead code. A
// Knightian value meets a `ε=⊥` parameter. Its compile-fail twins
// (knightian_mixed, covid_2020_knightian_refusal) are refused when it is passed
// where a confidence floor is required.

fn read_unknown(k: Knowledge[f64, ε=⊥]) -> f64 with Epistemic {
    k.value
}

fn main() -> i64 with IO, Epistemic {
    let dm: Knowledge[f64, ε=⊥] = Knowledge { value: 0.26 }
    let rt: Knowledge[f64, ε=⊥] = Knowledge { value: 2.4 }
    print_f64(read_unknown(dm))
    print(" ")
    print_f64(read_unknown(rt))
    println("")
    0
}
