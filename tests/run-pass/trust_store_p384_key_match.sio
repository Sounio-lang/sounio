fn main() -> i64 with IO, Mut, Div, Panic {
    // ---- P-384 case: before this task's guard fix, this returned false
    // unconditionally regardless of subject/key match. ----
    let p384_cert = parse_p384_self_signed()
    assert(p384_cert.public_key_algorithm == PUBKEY_ALG_EC_P384)

    var p384_store = TrustStore { certs: [certificate_zero(); 512], bufs: [rawbuf_new(1); 512], count: 1 }
    p384_store.certs[0] = p384_cert

    let p384_match = trust_store_has_matching_key_for_subject(&p384_store, &p384_cert)
    if p384_match == false {
        println("trust_store_p384_key_match: P-384 self-signed cert NOT recognized as matching anchor")
        return 1
    }
    assert(p384_match == true)

    // ---- Regression: the original P-256 case must still work exactly as
    // before this task's change. ----
    let p256_cert = parse_p256_self_signed()
    assert(p256_cert.public_key_algorithm == PUBKEY_ALG_EC_P256)

    var p256_store = TrustStore { certs: [certificate_zero(); 512], bufs: [rawbuf_new(1); 512], count: 1 }
    p256_store.certs[0] = p256_cert

    let p256_match = trust_store_has_matching_key_for_subject(&p256_store, &p256_cert)
    if p256_match == false {
        println("trust_store_p384_key_match: P-256 self-signed cert regressed (should still match)")
        return 1
    }
    assert(p256_match == true)

    // ---- Cross-check: a P-384 candidate must NOT match a store that only
    // holds the (different-subject) P-256 anchor. ----
    let cross_match = trust_store_has_matching_key_for_subject(&p256_store, &p384_cert)
    if cross_match == true {
        println("trust_store_p384_key_match: P-384 cert wrongly matched an unrelated P-256 anchor")
        return 1
    }
    assert(cross_match == false)

    // ---- D17's actual threat model: SAME Subject DN, DIFFERENT key
    // material. The cross-check above only proves rejection on a DN
    // mismatch, which the shared comparison logic already covers via
    // tests/run-pass/x509_chain_forged_ec_root_dn_collision.sio. This
    // block instead forges a candidate that shares the p384_cert's exact
    // subject but carries different EC public key coordinates, so the
    // match must fail on the key comparison itself
    // (store.certs[i].ec_public_key.{x,y} vs cert.ec_public_key.{x,y} in
    // trust_store_has_matching_key_for_subject), not on the subject
    // check. No new openssl fixture is generated -- the forged key is
    // derived in-memory from the real parsed P-384 public key by adding 1
    // to its x-coordinate, which is sufficient to fail bigint_cmp while
    // keeping every other field (including subject) identical.
    var forged_cert = p384_cert
    let one = bigint_from_u32(1)
    forged_cert.ec_public_key.x = bigint_add(&p384_cert.ec_public_key.x, &one)

    let same_dn_diff_key_match = trust_store_has_matching_key_for_subject(&p384_store, &forged_cert)
    if same_dn_diff_key_match == true {
        println("trust_store_p384_key_match: same-subject different-key P-384 candidate wrongly matched")
        return 1
    }
    assert(same_dn_diff_key_match == false)

    println("trust_store_p384_key_match: OK")
    0
}
