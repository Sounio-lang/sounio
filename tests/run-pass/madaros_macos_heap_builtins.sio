//@ run-pass
//@ requires: madaros
//@ expect-stdout: MADAROS_HEAP_BUILTINS_PASS

struct Cell { a: i64, b: i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let p = heap_alloc(64) as *mut Cell
    if (p as i64) == 0 || (p as i64) % 16 != 0 { return 1 }
    if (*p).a != 0 || (*p).b != 0 { return 2 }
    (*p).a = 73
    (*p).b = 91
    if (*p).a != 73 || (*p).b != 91 { return 3 }
    heap_free(p as *mut u8)
    if (heap_alloc(0) as i64) != 0 { return 4 }
    if (heap_alloc(0 - 8) as i64) != 0 { return 5 }
    if (heap_alloc(9223372036854775807) as i64) != 0 { return 6 }
    heap_free(0 as *mut u8)
    let q = heap_alloc(32768) as *mut Cell
    if (q as i64) == 0 || (q as i64) % 16 != 0 { return 7 }
    if (*q).a != 0 || (*q).b != 0 { return 8 }
    heap_free(q as *mut u8)
    println("MADAROS_HEAP_BUILTINS_PASS")
    0
}
