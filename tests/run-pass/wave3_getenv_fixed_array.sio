//@ run-pass
//@ requires: madaros
//@ expect-stdout: GETENV_VALUE=visible
//@ expect-stdout: GETENV_FIXED_ARRAY_OK
use os::env::{env_var_present};
extern "C" { fn getenv(key: &[u8; 64]) -> i64 }
var WAVE_ENV_GLOBAL: [u8; 64] = [0; 64]
fn key_from_string(text: string) -> [u8; 64] with Mut, Panic, Div {
    var key: [u8; 64] = [0; 64]
    var i: i64 = 0
    while i < str_len(text) && i < 63 {
        key[i as usize] = str_char_at(text, i) as u8
        i = i + 1
    }
    key
}
fn main() -> i32 with IO, Mut, Panic, Div {
    let present = key_from_string("WAVE3_ENV_PRESENT")
    let empty = key_from_string("WAVE3_ENV_EMPTY")
    let missing = key_from_string("WAVE3_ENV_MISSING_7319")
    let prefix = key_from_string("WAVE3_ENV_PREFIX")
    let wrong_case = key_from_string("wave3_env_present")
    let invalid = key_from_string("WAVE3_ENV_PRESENT=visible")
    let blank: [u8; 64] = [0; 64]
    var unterminated: [u8; 64] = [65; 64]
    var max_key: [u8; 64] = [90; 64]
    max_key[63] = 0
    if !env_var_present(&present) { return 1 }
    if !env_var_present(&empty) { return 2 }
    if env_var_present(&missing) { return 3 }
    if env_var_present(&prefix) { return 4 }
    if env_var_present(&wrong_case) { return 5 }
    if env_var_present(&invalid) { return 6 }
    if env_var_present(&blank) { return 7 }
    if env_var_present(&unterminated) { return 8 }
    if !env_var_present(&max_key) { return 9 }
    WAVE_ENV_GLOBAL[0] = 80
    WAVE_ENV_GLOBAL[1] = 65
    WAVE_ENV_GLOBAL[2] = 84
    WAVE_ENV_GLOBAL[3] = 72
    if !env_var_present(&WAVE_ENV_GLOBAL) { return 10 }
    let value = getenv(&present)
    print("GETENV_VALUE=")
    let written = syscall6(1, 1, value, 7, 0, 0, 0)
    if written != 7 { return 11 }
    print("\n")
    println("GETENV_FIXED_ARRAY_OK")
    0
}
