//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-3 Taylor-2 radius candidate artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn conversion_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let rx: i256 = 212600882 as i256
    let ry: i256 = 1127428916 as i256
    let rz: i256 = 45097157 as i256
    let x_conv_excess: i256 = rx * target_scale - (49500 as i256) * source_scale
    let y_conv_excess: i256 = ry * target_scale - (262500 as i256) * source_scale
    let z_conv_excess: i256 = rz * target_scale - (10500 as i256) * source_scale
    if x_conv_excess >= (0 as i256) {
        if y_conv_excess >= (0 as i256) {
            if z_conv_excess >= (0 as i256) {
                if x_conv_excess < target_scale {
                    if y_conv_excess < target_scale {
                        if z_conv_excess < target_scale { return 1 }
                    }
                }
            }
        }
    }
    return 0
}

fn derivative_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let x3_abs: i256 = 4617762706 as i256
    let y3_abs: i256 = 7643846696 as i256
    let z3: i256 = 4120687759 as i256
    let rhoz_abs: i256 = (28 as i256) * source_scale - z3
    let rx: i256 = 212600882 as i256
    let ry: i256 = 1127428916 as i256
    let rz: i256 = 45097157 as i256
    let dx_rad: i256 = 13400297980 as i256
    let prod_x_rhoz: i256 = 5799569470 as i256
    let dy_rad: i256 = 6926998386 as i256
    let prod_xy: i256 = 1646340856 as i256
    let beta_rad: i256 = 120259087 as i256
    let dz_rad: i256 = 1766599943 as i256

    var mask: i64 = 0
    if dx_rad == (10 as i256) * (rx + ry) { mask = mask + 2 }

    let xrhoz_total: i256 =
        x3_abs * rz +
        rhoz_abs * rx +
        rx * rz
    if (prod_x_rhoz - (1 as i256)) * source_scale <= xrhoz_total {
        if prod_x_rhoz * source_scale > xrhoz_total { mask = mask + 4 }
    }
    if dy_rad == prod_x_rhoz + ry { mask = mask + 8 }

    let xy_total: i256 =
        x3_abs * ry +
        y3_abs * rx +
        rx * ry
    let beta_total: i256 = (8 as i256) * rz
    if (prod_xy - (1 as i256)) * source_scale <= xy_total {
        if prod_xy * source_scale > xy_total {
            if (beta_rad - (2 as i256)) * (3 as i256) < beta_total {
                if (beta_rad - (1 as i256)) * (3 as i256) >= beta_total {
                    if dz_rad == prod_xy + beta_rad { mask = mask + 16 }
                }
            }
        }
    }
    return mask
}

fn next_radius_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let dt_q: i256 = 42949672 as i256
    let rx: i256 = 212600882 as i256
    let ry: i256 = 1127428916 as i256
    let rz: i256 = 45097157 as i256
    let dx_rad: i256 = 13400297980 as i256
    let dy_rad: i256 = 6926998386 as i256
    let dz_rad: i256 = 1766599943 as i256
    let next_x: i256 = 346603859 as i256
    let next_y: i256 = 1196698899 as i256
    let next_z: i256 = 62763157 as i256
    if (next_x - rx - (1 as i256)) * source_scale <= dt_q * dx_rad {
        if (next_x - rx) * source_scale > dt_q * dx_rad {
            if (next_y - ry - (1 as i256)) * source_scale <= dt_q * dy_rad {
                if (next_y - ry) * source_scale > dt_q * dy_rad {
                    if (next_z - rz - (1 as i256)) * source_scale <= dt_q * dz_rad {
                        if (next_z - rz) * source_scale > dt_q * dz_rad { return 32 }
                    }
                }
            }
        }
    }
    return 0
}

fn cap_mask() -> i64 {
    if (346603859 as i256) <= (500000000 as i256) {
        if (1196698899 as i256) <= (1500000000 as i256) {
            if (62763157 as i256) <= (100000000 as i256) { return 64 }
        }
    }
    return 0
}

fn main() -> i64 {
    let ok_mask = conversion_mask() + derivative_mask() + next_radius_mask() + cap_mask()
    if ok_mask != 127 { return 1 }

    var inst: i64 = 1783
    inst = mix(inst, 3, 5711)
    inst = mix(inst, 4294967296, 5711)
    inst = mix(inst, 1000000, 5711)
    inst = mix(inst, 164784481, 5711)
    inst = mix(inst, 660765149, 5711)
    inst = mix(inst, 116883728, 5711)
    inst = mix(inst, 84354264, 5711)
    inst = mix(inst, 417748218, 5711)
    inst = mix(inst, 109213065, 5711)
    inst = mix(inst, 49500, 5711)
    inst = mix(inst, 262500, 5711)
    inst = mix(inst, 10500, 5711)
    inst = mix(inst, 212600882, 5711)
    inst = mix(inst, 1127428916, 5711)
    inst = mix(inst, 45097157, 5711)
    inst = mix(inst, 0, 5711)
    inst = mix(inst, 0, 5711)
    if inst != 118650140 { return 2 }

    var cert: i64 = 1787
    cert = mix(cert, inst, 5717)
    cert = mix(cert, 13400297980, 5717)
    cert = mix(cert, 5799569470, 5717)
    cert = mix(cert, 6926998386, 5717)
    cert = mix(cert, 1646340856, 5717)
    cert = mix(cert, 120259087, 5717)
    cert = mix(cert, 1766599943, 5717)
    cert = mix(cert, 346603859, 5717)
    cert = mix(cert, 1196698899, 5717)
    cert = mix(cert, 62763157, 5717)
    cert = mix(cert, 500000000, 5717)
    cert = mix(cert, 1500000000, 5717)
    cert = mix(cert, 100000000, 5717)
    cert = mix(cert, ok_mask, 5717)
    cert = mix(cert, 0, 5717)
    cert = mix(cert, 0, 5717)
    if cert != 413660742 { return 3 }

    var art: i64 = 1789
    art = mix(art, inst, 5737)
    art = mix(art, cert, 5737)
    art = mix(art, 164784481, 5737)
    art = mix(art, 660765149, 5737)
    art = mix(art, 2, 5737)
    art = mix(art, 3, 5737)
    art = mix(art, 346603859, 5737)
    art = mix(art, 1196698899, 5737)
    art = mix(art, 62763157, 5737)
    art = mix(art, 500000000, 5737)
    art = mix(art, 1500000000, 5737)
    art = mix(art, 100000000, 5737)
    art = mix(art, ok_mask, 5737)
    art = mix(art, 0, 5737)
    art = mix(art, 0, 5737)
    if art != 844877047 { return 4 }

    var audit: i64 = 1801
    audit = mix(audit, art, 5741)
    audit = mix(audit, inst, 5741)
    audit = mix(audit, cert, 5741)
    audit = mix(audit, 164784481, 5741)
    audit = mix(audit, 660765149, 5741)
    audit = mix(audit, 3, 5741)
    audit = mix(audit, 2, 5741)
    audit = mix(audit, ok_mask, 5741)
    audit = mix(audit, 0, 5741)
    audit = mix(audit, 0, 5741)
    if audit != 492955058 { return 5 }
    return 0
}
