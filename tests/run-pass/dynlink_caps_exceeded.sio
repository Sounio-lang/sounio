//@ run-pass
//@ requires: madaros
//@ expect-stdout: dynlink_caps_exceeded: PASS
// Regression: >8 distinct dynlink symbols (old max_symbols cap) drawn from
// >4 distinct DT_NEEDED libraries (old max_libs cap). Previously the writer
// hard-rejected these with rc=22/23 (see codegen native_v2 dynlink caps).
// Needs libkl14b_probe.so, libkl14c_probe.so, libkl14d_a.so, libkl14d_b.so
// and libzstd.so.1 on LD_LIBRARY_PATH.
extern "C" {
    fn kl14b_add(a: i64, b: i64) -> i64
    fn kl14c_add(a: i64, b: i64) -> i64
    fn kl14c_mul(a: i64, b: i64) -> i64
    fn kl14c_neg(a: i64) -> i64
    fn kl14d_a(x: i64) -> i64
    fn kl14d_b(x: i64) -> i64
    fn ZSTD_compress(dst: i64, cap: i64, src: i64, src_len: i64, level: i64) -> i64
    fn ZSTD_decompress(dst: i64, cap: i64, src: i64, src_len: i64) -> i64
    fn ZSTD_isError(code: i64) -> i64
}

fn main() -> i32 with IO, Mut, Panic, Div {
    // Exercise 9 distinct symbols so all 9 enter extern_relocs.
    let a = kl14b_add(1, 2)          // 3
    let b = kl14c_add(10, 5)         // 15
    let c = kl14c_mul(3, 4)          // 12
    let d = kl14c_neg(7)             // -7
    let e = kl14d_a(10)              // 11
    let f = kl14d_b(4)               // 12
    let z1 = ZSTD_isError(0)
    // Keep ZSTD_compress/decompress reachable so they are emitted symbols.
    if a + b + c + d + e + f == 99999 {
        let t = ZSTD_compress(0, 0, 0, 0, 0)
        let u = ZSTD_decompress(0, 0, 0, 0)
        if t + u + z1 == 88888 { println("dynlink_caps_exceeded: FAIL") }
    }
    if a == 3 && b == 15 && c == 12 && d == 0 - 7 && e == 11 && f == 12 && z1 == 0 {
        println("dynlink_caps_exceeded: PASS")
        return 0
    }
    println("dynlink_caps_exceeded: FAIL")
    return 1
}
