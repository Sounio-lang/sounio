// tests/run-pass/fano_lower_guard_coverage.sio
//@ run-pass
// Exercises production EVEX byte 1 and the three fail-closed paths in
// lower_hyper_mul_o_fano without duplicating their implementations.
//@ requires: madaros
//@ expect-stdout: 0

use native::lower_ir::{evex_p1, lower_hyper_mul_o_fano}
use native::frame::{NativeCompiler, compiler_new}
use native::encode::{NC_BIG_CODE}
use ir::ir::{IrInstr, ir_hyper_mul_o}

fn expect_ud2(start: i64) -> i64 {
    let b0 = (NC_BIG_CODE[start as usize] as i64) & 0xFF
    let b1 = (NC_BIG_CODE[(start + 1) as usize] as i64) & 0xFF
    if b0 == 0x0F && b1 == 0x0B { 0 } else { 1 }
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let low = evex_p1(0, 15, 1)
    let high = evex_p1(0, 31, 1)
    if ((low >> 6) & 1) != 1 { return 1 }
    if ((high >> 6) & 1) != 0 { return 2 }

    var nc = compiler_new()
    var bad_bounds: IrInstr = ir_hyper_mul_o(26, 0, 1)
    bad_bounds.label_id = 0
    lower_hyper_mul_o_fano(&!nc, bad_bounds)
    if expect_ud2(0) != 0 { return 3 }

    var overlap: IrInstr = ir_hyper_mul_o(0, 1, 2)
    overlap.label_id = 0
    lower_hyper_mul_o_fano(&!nc, overlap)
    if expect_ud2(2) != 0 { return 4 }

    var alias: IrInstr = ir_hyper_mul_o(2, 4, 1)
    alias.label_id = 11 << 4
    lower_hyper_mul_o_fano(&!nc, alias)
    if expect_ud2(4) != 0 { return 5 }

    print_int(0)
    0
}
