//@ run-pass
// Sprint 228: Function references — named functions as first-class values

fn add_one(x: i64) -> i64 { x + 1 }
fn sub_one(x: i64) -> i64 { x - 1 }
fn negate(x: i64) -> i64 { 0 - x }
fn square(x: i64) -> i64 { x * x }

fn apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }

fn select_op(which: i64) -> fn(i64) -> i64 with Mut, Panic, Div {
    if which == 0 { add_one }
    else if which == 1 { sub_one }
    else { negate }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    // Test 1: Pass named function directly
    let r1 = apply(add_one, 5)
    assert(r1 == 6)

    // Test 2: Store fn in variable, call through variable
    let f = square
    let r2 = f(7)
    assert(r2 == 49)

    // Test 3: Function returned from function
    let op0 = select_op(0)
    assert(op0(10) == 11)

    let op1 = select_op(1)
    assert(op1(10) == 9)

    let op2 = select_op(2)
    assert(op2(10) == -10)

    // Test 4: Sequential dynamic dispatch
    let ops: [i64; 3] = [0, 1, 2]
    var total: i64 = 0
    var i: i64 = 0
    while i < 3 {
        let op = select_op(ops[i])
        total = total + op(10)
        i = i + 1
    }
    // 11 + 9 + (-10) = 10
    assert(total == 10)

    print(0)
    0
}
