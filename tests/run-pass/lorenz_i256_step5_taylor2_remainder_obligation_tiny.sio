//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-5 Taylor-2 remainder obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1163
    fp = mix(fp, 5, 4919)
    fp = mix(fp, 4294967296, 4919)
    fp = mix(fp, 1000000, 4919)
    fp = mix(fp, 42949672, 4919)
    fp = mix(fp, 422368008, 4919)
    fp = mix(fp, 577119901, 4919)
    fp = mix(fp, 171451971, 4919)
    fp = mix(fp, 862108922, 4919)
    fp = mix(fp, 815806077, 4919)
    fp = mix(fp, 655666714, 4919)
    fp = mix(fp, 4920371098, 4919)
    fp = mix(fp, 8816077911, 4919)
    fp = mix(fp, 4092986080, 4919)
    fp = mix(fp, 390842024, 4919)
    fp = mix(fp, 1245540516, 4919)
    fp = mix(fp, 8589935, 4919)
    fp = mix(fp, 0, 4919)
    fp = mix(fp, 0, 4919)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 77648112 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }
    var fp: i64 = 1171
    fp = mix(fp, instance, 4931)
    fp = mix(fp, 5311213122, 4931)
    fp = mix(fp, 10061618427, 4931)
    fp = mix(fp, 4101576015, 4931)
    fp = mix(fp, 116174688143, 4931)
    fp = mix(fp, 153728315490, 4931)
    fp = mix(fp, 153724767780, 4931)
    fp = mix(fp, 23379865897, 4931)
    fp = mix(fp, 3074530832700, 4931)
    fp = mix(fp, 4340838038257, 4931)
    fp = mix(fp, 612576495421, 4931)
    fp = mix(fp, 153726535, 4931)
    fp = mix(fp, 217041893, 4931)
    fp = mix(fp, 30628824, 4931)
    fp = mix(fp, 35793, 4931)
    fp = mix(fp, 50535, 4931)
    fp = mix(fp, 7132, 4931)
    fp = mix(fp, 40000, 4931)
    fp = mix(fp, 55000, 4931)
    fp = mix(fp, 10000, 4931)
    fp = mix(fp, 4207, 4931)
    fp = mix(fp, 4465, 4931)
    fp = mix(fp, 2868, 4931)
    fp = mix(fp, ok_mask, 4931)
    fp = mix(fp, 0, 4931)
    fp = mix(fp, 0, 4931)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 77648112 { return 0 - 1 }
    if certificate != 754547684 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }
    var fp: i64 = 1181
    fp = mix(fp, instance, 4933)
    fp = mix(fp, certificate, 4933)
    fp = mix(fp, 422368008, 4933)
    fp = mix(fp, 577119901, 4933)
    fp = mix(fp, 171451971, 4933)
    fp = mix(fp, 862108922, 4933)
    fp = mix(fp, 815806077, 4933)
    fp = mix(fp, 655666714, 4933)
    fp = mix(fp, 5, 4933)
    fp = mix(fp, 5, 4933)
    fp = mix(fp, 35793, 4933)
    fp = mix(fp, 50535, 4933)
    fp = mix(fp, 7132, 4933)
    fp = mix(fp, 40000, 4933)
    fp = mix(fp, 55000, 4933)
    fp = mix(fp, 10000, 4933)
    fp = mix(fp, ok_mask, 4933)
    fp = mix(fp, 0, 4933)
    fp = mix(fp, 0, 4933)
    return fp
}

fn abs_box_mask() -> i64 {
    let x_abs: i256 = 5311213122 as i256
    let y_abs: i256 = 10061618427 as i256
    let z_abs: i256 = 4101576015 as i256
    if x_abs == (4920371098 as i256) + (390842024 as i256) {
        if y_abs == (8816077911 as i256) + (1245540516 as i256) {
            if z_abs == (4092986080 as i256) + (8589935 as i256) { return 1 }
        }
    }
    return 0
}

fn first_derivative_mask() -> i64 {
    let q: i256 = 4294967296 as i256
    let x_abs: i256 = 5311213122 as i256
    let y_abs: i256 = 10061618427 as i256
    let z_abs: i256 = 4101576015 as i256
    let rhoz: i256 = 116174688143 as i256
    let x_prime: i256 = 153728315490 as i256
    let y_prime: i256 = 153724767780 as i256
    let z_prime: i256 = 23379865897 as i256
    let xy_bound: i256 = 12442329857 as i256
    let beta_z_bound: i256 = 10937536040 as i256
    if x_prime == (10 as i256) * (x_abs + y_abs) {
        if (y_prime - y_abs - (1 as i256)) * q < x_abs * rhoz {
            if (y_prime - y_abs) * q >= x_abs * rhoz {
                if (xy_bound - (1 as i256)) * q < x_abs * y_abs {
                    if xy_bound * q >= x_abs * y_abs {
                        if (beta_z_bound - (1 as i256)) * (3 as i256) < (8 as i256) * z_abs {
                            if beta_z_bound * (3 as i256) >= (8 as i256) * z_abs {
                                if z_prime == xy_bound + beta_z_bound { return 2 }
                            }
                        }
                    }
                }
            }
        }
    }
    return 0
}

fn second_derivative_mask() -> i64 {
    let q: i256 = 4294967296 as i256
    let x_abs: i256 = 5311213122 as i256
    let y_abs: i256 = 10061618427 as i256
    let rhoz: i256 = 116174688143 as i256
    let x_prime: i256 = 153728315490 as i256
    let y_prime: i256 = 153724767780 as i256
    let z_prime: i256 = 23379865897 as i256
    let x_second: i256 = 3074530832700 as i256
    let y_second: i256 = 4340838038257 as i256
    let z_second: i256 = 612576495421 as i256
    let y2a: i256 = 4158201420401 as i256
    let y2b: i256 = 28911850076 as i256
    let z2a: i256 = 360132114004 as i256
    let z2b: i256 = 190098072358 as i256
    let z2c: i256 = 62346309059 as i256
    if x_second == (10 as i256) * (y_prime + x_prime) {
        if (y2a - (1 as i256)) * q < x_prime * rhoz {
            if y2a * q >= x_prime * rhoz {
                if (y2b - (1 as i256)) * q < x_abs * z_prime {
                    if y2b * q >= x_abs * z_prime {
                        if y_second == y2a + y2b + y_prime {
                            if (z2a - (1 as i256)) * q < x_prime * y_abs {
                                if z2a * q >= x_prime * y_abs {
                                    if (z2b - (1 as i256)) * q < x_abs * y_prime {
                                        if z2b * q >= x_abs * y_prime {
                                            if (z2c - (1 as i256)) * (3 as i256) < (8 as i256) * z_prime {
                                                if z2c * (3 as i256) >= (8 as i256) * z_prime {
                                                    if z_second == z2a + z2b + z2c { return 4 }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                }
            }
        }
    }
    }
    return 0
}

fn source_lte_mask() -> i64 {
    let q: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256
    let x_second: i256 = 3074530832700 as i256
    let y_second: i256 = 4340838038257 as i256
    let z_second: i256 = 612576495421 as i256
    let den: i256 = (2 as i256) * q * q
    if ((153726535 as i256) - (1 as i256)) * den < x_second * dt * dt {
        if (153726535 as i256) * den >= x_second * dt * dt {
            if ((217041893 as i256) - (1 as i256)) * den < y_second * dt * dt {
                if (217041893 as i256) * den >= y_second * dt * dt {
                    if ((30628824 as i256) - (1 as i256)) * den < z_second * dt * dt {
                        if (30628824 as i256) * den >= z_second * dt * dt { return 8 }
                    }
                }
            }
        }
    }
    return 0
}

fn target_lte_mask() -> i64 {
    let q: i256 = 4294967296 as i256
    let ppm: i256 = 1000000 as i256
    if ((35793 as i256) - (1 as i256)) * q < (153726535 as i256) * ppm {
        if (35793 as i256) * q >= (153726535 as i256) * ppm {
            if ((50535 as i256) - (1 as i256)) * q < (217041893 as i256) * ppm {
                if (50535 as i256) * q >= (217041893 as i256) * ppm {
                    if ((7132 as i256) - (1 as i256)) * q < (30628824 as i256) * ppm {
                        if (7132 as i256) * q >= (30628824 as i256) * ppm { return 16 }
                    }
                }
            }
        }
    }
    return 0
}

fn cap_mask() -> i64 {
    if 40000 - 35793 == 4207 {
        if 55000 - 50535 == 4465 {
            if 10000 - 7132 == 2868 { return 32 }
        }
    }
    return 0
}

fn arithmetic_mask() -> i64 {
    return abs_box_mask() + first_derivative_mask() + second_derivative_mask() +
        source_lte_mask() + target_lte_mask() + cap_mask() + 64
}

fn main() -> i64 {
    let ok_mask = arithmetic_mask()
    if ok_mask != 127 { return 1 }
    let inst = instance_fp()
    if inst != 77648112 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 754547684 { return 3 }
    if artifact_fp(inst, cert, ok_mask) != 69995750 { return 4 }
    if certificate_fp(inst, 126) != (0 - 1) { return 5 }
    return 0
}
