//@ run-pass
//@ requires: madaros
//@ expect-stdout: -5:251:5102109
// SIO-557: dereferencing a *mut i8/*mut u8 performs a byte load with the
// pointee's signedness (movsx/movzx), not the default 8-byte word load.
// Before, `*cell as i64` over heap bytes read the whole word (26470
// instead of 102), which surfaced as garbage K/V in large single-function
// forwards that stage bytes through pointer-carrying struct slots.

struct PBuf {
    ptr: *mut i8,
    len: i64,
}

fn palloc(n: i64) -> PBuf with Mut {
    let p = heap_alloc(n) as *mut i8
    PBuf { ptr: p, len: n }
}

fn pset(b: &!PBuf, i: i64, v: i8) with Mut {
    let cell = ((b.ptr as i64) + i) as *mut i8
    *cell = v
}

fn pget(b: &PBuf, i: i64) -> i64 {
    let cell = ((b.ptr as i64) + i) as *mut i8
    *cell as i64
}

fn big(a: &![i64; 4], b: &![PBuf; 4], c: &![i64; 4], d: &![i64; 4], e: &![i64; 4], f: &![i64; 4], g: &![i64; 4], h: &![PBuf; 8], k: &![i64; 8], l: &![i64; 8], m: i64) -> i64 with Mut {
    var cp = palloc(4)
    var i: i64 = 0
    while i < 4 {
        pset(&!cp, i, (100 + i) as i8)
        i = i + 1
    }
    b[0] = cp
    a[0] = 7
    d[0] = k[0]
    a[0] + c[0] * 1000 + d[0] * 1000000 + pget(&b[0], 2)
}

fn uneg() -> i64 with Mut {
    let p = heap_alloc(2) as *mut u8
    let c0 = (p as i64) as *mut u8
    *c0 = 251 as u8
    let back = (p as i64) as *mut u8
    *back as i64
}

fn main() -> i32 with Mut, IO {
    var a: [i64; 4] = [0; 4]
    var z = palloc(1)
    var b: [PBuf; 4] = [z; 4]
    var c: [i64; 4] = [102; 4]
    var d: [i64; 4] = [0; 4]
    var e: [i64; 4] = [0; 4]
    var f: [i64; 4] = [0; 4]
    var g: [i64; 4] = [0; 4]
    var h: [PBuf; 8] = [z; 8]
    var k: [i64; 8] = [5; 8]
    var l: [i64; 8] = [0; 8]
    let r = big(&!a, &!b, &!c, &!d, &!e, &!f, &!g, &!h, &!k, &!l, 0)
    // negative i8 byte sign-extends: -5, not 251
    var n = palloc(1)
    let neg5: i8 = (0 - 5) as i8
    pset(&!n, 0, neg5)
    print_int(pget(&n, 0))
    print(":")
    print_int(uneg())
    print(":")
    print_int(r)
    println("")
    return 0
}
