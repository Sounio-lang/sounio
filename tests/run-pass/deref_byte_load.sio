//@ run-pass
//@ requires: madaros
//@ expect-stdout: -5:251:5102109:4660:100:1:77:100:200:-5:5
// SIO-557: dereferencing a *mut i8/*mut u8 performs a byte load with the
// pointee's signedness (movsx/movzx), not the default 8-byte word load.
// Before, `*cell as i64` over heap bytes read the whole word (26470
// instead of 102), which surfaced as garbage K/V in large single-function
// forwards that stage bytes through pointer-carrying struct slots.

struct PBuf {
    ptr: *mut i8,
    len: i64,
}

struct PBufU {
    ptr: *mut u8,
    len: i64,
}

fn palloc(n: i64) -> PBuf with Mut {
    let p = heap_alloc(n) as *mut i8
    PBuf { ptr: p, len: n }
}

fn pset(b: &!PBuf, i: i64, v: i8) with Mut {
    let cell = ((b.ptr as i64) + i) as *mut i8
    *cell = v
}

fn pget(b: &PBuf, i: i64) -> i64 {
    let cell = ((b.ptr as i64) + i) as *mut i8
    *cell as i64
}

fn big(a: &![i64; 4], b: &![PBuf; 4], c: &![i64; 4], d: &![i64; 4], e: &![i64; 4], f: &![i64; 4], g: &![i64; 4], h: &![PBuf; 8], k: &![i64; 8], l: &![i64; 8], m: i64) -> i64 with Mut {
    var cp = palloc(4)
    var i: i64 = 0
    while i < 4 {
        pset(&!cp, i, (100 + i) as i8)
        i = i + 1
    }
    b[0] = cp
    a[0] = 7
    d[0] = k[0]
    a[0] + c[0] * 1000 + d[0] * 1000000 + pget(&b[0], 2)
}

fn uneg() -> i64 with Mut {
    let p = heap_alloc(2) as *mut u8
    let c0 = (p as i64) as *mut u8
    *c0 = 251 as u8
    let back = (p as i64) as *mut u8
    *back as i64
}

// Borrow round-trip: pp's slot holds an ADDRESS, so `*pp` stays a word
// load even though p points to bytes (4660, not its low byte 52).
fn ppround() -> i64 with Mut {
    let p = 4660 as *mut i8
    let pp = &p
    *pp as i64
}

// Direct field deref: `*(b.ptr)` narrows through the field's declared
// `*mut i8`, like the cast form does.
fn fieldderef(b: &PBuf) -> i64 {
    *(b.ptr) as i64
}

// Store-free body: without any store the function keeps the MIR pipeline,
// which used to drop the width flags and emit a word load.
fn ronly(p: *mut i8) -> i64 {
    *p as i64
}

// Field-alias: `let cell = b.ptr` narrows exactly like `*(b.ptr)` does,
// signed and unsigned (a movsx mix-up reads 200 as -56).
fn aliasi8(b: &PBuf) -> i64 {
    let cell = b.ptr
    *cell as i64
}
fn aliasu8(b: &PBufU) -> i64 {
    let cell = b.ptr
    *cell as i64
}

// Slot round-trips: a pointer laundered out of a borrow addresses a
// word-backed slot, so traffic through it stays word-width and the slot
// invariant survives positive-to-negative and back. (One store + one read
// per function: mixing a second raw store with combined later reads trips
// an unrelated pre-existing slot-confusion miscompile, filed separately.)
fn sl_neg() -> i64 with Mut {
    var x: i8 = 5
    let xp = (&!x) as *mut i8
    *xp = (0 - 5) as i8
    x as i64
}
fn sl_pos() -> i64 with Mut {
    var x: i8 = 0 - 5
    let xp = (&!x) as *mut i8
    *xp = 5 as i8
    x as i64
}

fn main() -> i32 with Mut, IO {
    var a: [i64; 4] = [0; 4]
    var z = palloc(1)
    var b: [PBuf; 4] = [z; 4]
    var c: [i64; 4] = [102; 4]
    var d: [i64; 4] = [0; 4]
    var e: [i64; 4] = [0; 4]
    var f: [i64; 4] = [0; 4]
    var g: [i64; 4] = [0; 4]
    var h: [PBuf; 8] = [z; 8]
    var k: [i64; 8] = [5; 8]
    var l: [i64; 8] = [0; 8]
    let r = big(&!a, &!b, &!c, &!d, &!e, &!f, &!g, &!h, &!k, &!l, 0)
    // negative i8 byte sign-extends: -5, not 251
    var n = palloc(1)
    let neg5: i8 = (0 - 5) as i8
    pset(&!n, 0, neg5)
    print_int(pget(&n, 0))
    print(":")
    print_int(uneg())
    print(":")
    print_int(r)
    print(":")
    print_int(ppround())
    print(":")
    print_int(fieldderef(&b[0]))
    print(":")
    // Sentinel LAST-byte-first: a word store at [1] would zero the [2]
    // sentinel, so pget(2) == 1 proves byte stores; ronly == 77 with the
    // sentinel intact (word load would read 333) proves byte loads.
    var m = palloc(8)
    let v77: i8 = 77 as i8
    let v1: i8 = 1 as i8
    pset(&!m, 2, v1)
    pset(&!m, 1, v77)
    // let-bound: nesting a BinOp pointer computation directly as a call arg
    // segfaults the compiler (pre-existing, unrelated to byte widths).
    let off = ((m.ptr as i64) + 1) as *mut i8
    print_int(pget(&m, 2))
    print(":")
    print_int(ronly(off))
    print(":")
    print_int(aliasi8(&b[0]))
    print(":")
    var mu = PBufU { ptr: heap_alloc(4), len: 4 }
    *(mu.ptr) = 200 as u8
    *(((mu.ptr as i64) + 1) as *mut u8) = 201 as u8
    print_int(aliasu8(&mu))
    print(":")
    print_int(sl_neg())
    print(":")
    print_int(sl_pos())
    println("")
    return 0
}
