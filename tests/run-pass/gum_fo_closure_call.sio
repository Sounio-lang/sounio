//@ run-pass
//@ requires: madaros
//@ expect-stdout: scale 0.360000
//@ expect-stdout: square 9.000000
//@ expect-stdout: capture 0.090000
//@ expect-stdout: block 0.360000
//@ expect-stdout: literal 0.000000
//@ expect-stdout: CLOSURE_VAR_OK
// variance_of(f(a)) for let f = |y: f64| 2.0 * y.
// a = 5 +- 0.3, var(a) = 0.09.
// scale: (2)^2 * 0.09 = 0.36
// square: (2*5)^2 * 0.09 = 9
// capture of a, argument exact: 0.09
// literal argument: 0

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let f = |y: f64| 2.0 * y
    let scale = variance_of(f(a))
    let g = |y: f64| y * y
    let square = variance_of(g(a))
    let h = |y: f64| y + a
    let capture = variance_of(h(1.0))
    let b = |y: f64| { 2.0 * y }
    let block = variance_of(b(a))
    let literal = variance_of(f(1.0))
    print("scale ")
    print_f64(scale)
    println("")
    print("square ")
    print_f64(square)
    println("")
    print("capture ")
    print_f64(capture)
    println("")
    print("block ")
    print_f64(block)
    println("")
    print("literal ")
    print_f64(literal)
    println("")
    var fails: i64 = 0
    if scale < 0.359999 || scale > 0.360001 { fails = fails + 1 }
    if square < 8.999999 || square > 9.000001 { fails = fails + 1 }
    if capture < 0.089999 || capture > 0.090001 { fails = fails + 1 }
    if block < 0.359999 || block > 0.360001 { fails = fails + 1 }
    if literal < 0.0 - 0.000001 || literal > 0.000001 { fails = fails + 1 }
    if fails == 0 {
        println("CLOSURE_VAR_OK")
        0
    } else {
        println("CLOSURE_VAR_FAIL")
        1
    }
}
