//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: IDENT_FRESH_PER_CALL_PASS
//
// Prediction (ADR-032 decision 3, fresh sources per call):
// Sources a callee body creates via `measure(...)` get a fresh identity per
// call. Two calls `fresh_obs()` produce disjoint static noise sets (`x + y`
// and `x - y` accepted without E230) and distinct runtime channels so their
// residues never cancel (`Var(x.value - y.value) == 2.0`, `Cov == 0.0`).
// Transitive wrappers (`wrap_fresh`) and scaled fresh sources (`fresh_scaled`)
// also produce fresh independent sources per call.

fn fresh_obs() -> Knowledge<f64> {
    measure(10.0, uncertainty: 1.0)
}

fn fresh_scaled() -> Knowledge<f64> {
    measure(10.0, uncertainty: 1.0) * 2.0
}

fn wrap_fresh() -> Knowledge<f64> {
    fresh_obs()
}

fn main() -> i64 with IO, Epistemic {
    let x = fresh_obs()
    let y = fresh_obs()
    let s = x + y
    let d = x - y
    var ds = s.variance - 2.0
    if ds < 0.0 { ds = 0.0 - ds }
    var dd = d.variance - 2.0
    if dd < 0.0 { dd = 0.0 - dd }
    if ds > 1.0e-12 || dd > 1.0e-12 { return 1 }

    let cov_xy = covariance_of(x.value, y.value)
    let var_xy = variance_of(x.value - y.value)
    var dc = cov_xy
    if dc < 0.0 { dc = 0.0 - dc }
    var dv = var_xy - 2.0
    if dv < 0.0 { dv = 0.0 - dv }
    if dc > 1.0e-12 || dv > 1.0e-12 { return 2 }

    let p = fresh_scaled()
    let q = fresh_scaled()
    let ps = p + q
    var dp = ps.variance - 8.0
    if dp < 0.0 { dp = 0.0 - dp }
    let var_pq = variance_of(p.value - q.value)
    var dpq = var_pq - 8.0
    if dpq < 0.0 { dpq = 0.0 - dpq }
    if dp > 1.0e-12 || dpq > 1.0e-12 { return 3 }

    let u = wrap_fresh()
    let v = wrap_fresh()
    let uv = u + v
    var duv = uv.variance - 2.0
    if duv < 0.0 { duv = 0.0 - duv }
    if duv > 1.0e-12 { return 4 }

    println("IDENT_FRESH_PER_CALL_PASS")
    0
}
