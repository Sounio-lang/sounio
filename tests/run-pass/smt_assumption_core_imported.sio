//@ run-pass
//@ description: Imported theorem::smt assumption/core replay smoke

use theorem::smt::*

fn add_base_or(ctx: &!SmtContext) with Mut, Div {
    var clause: [i32; 8] = [0 as i32; 8]
    clause[0] = 0 as i32  // x
    clause[1] = 2 as i32  // y
    smt_add_clause(ctx, &clause, 2 as i32)
}

fn main() -> i32 with Mut, Div {
    var ctx = smt_new()
    add_base_or(&! ctx)

    if smt_solve(&! ctx) != 1 { return 1 }

    var assumptions: [i32; 8] = [0 as i32; 8]
    assumptions[0] = 1 as i32  // not x
    assumptions[1] = 3 as i32  // not y

    if smt_solve_with_assumptions(&! ctx, &assumptions, 2 as i32) != 0 { return 2 }
    if smt_solve_with_assumptions(&! ctx, &assumptions, 1 as i32) != 1 { return 3 }
    if smt_solve(&! ctx) != 1 { return 4 } // temporary units must be rolled back

    var core: [i32; 8] = [0 as i32; 8]
    core[0] = 0 as i32
    core[1] = 1 as i32
    if smt_check_assumption_core(&! ctx, &assumptions, 2 as i32, &core, 2 as i32) != 1 { return 5 }

    var singleton: [i32; 8] = [0 as i32; 8]
    singleton[0] = 0 as i32
    if smt_check_assumption_core(&! ctx, &assumptions, 2 as i32, &singleton, 1 as i32) != 0 { return 6 }

    var duplicate: [i32; 8] = [0 as i32; 8]
    duplicate[0] = 0 as i32
    duplicate[1] = 0 as i32
    if smt_check_assumption_core(&! ctx, &assumptions, 2 as i32, &duplicate, 2 as i32) != 0 { return 7 }

    var out_of_range: [i32; 8] = [0 as i32; 8]
    out_of_range[0] = 2 as i32
    if smt_check_assumption_core(&! ctx, &assumptions, 2 as i32, &out_of_range, 1 as i32) != 0 { return 8 }

    return 0
}
