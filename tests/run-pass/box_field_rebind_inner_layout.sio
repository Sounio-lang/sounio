//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: BOX_FIELD_REBIND_OK
// `let p = holder.inner` rebinds a local from a Box<T> FIELD (not a call or a
// struct literal). The bind marked `p` as Box but derived its inner layout
// through expr_first_arg_struct_name_ref, which only reads a call/struct-lit
// argument list and answers nothing for a field-access RHS -- the layout
// stayed -1 and (*p).field fell back to the first globally matching field
// name. A and B put "x"/"y" at swapped indices so a name-only fallback reads
// the wrong slot silently instead of crashing.

struct A { x: i64, y: i64 }
struct B { y: i64, x: i64 }

struct HolderA { inner: Box<A> }
struct HolderB { inner: Box<B> }

fn make_holder_a() -> HolderA with Alloc {
    HolderA { inner: Box::new(A { x: 1, y: 2 }) }
}

fn make_holder_b() -> HolderB with Alloc {
    HolderB { inner: Box::new(B { y: 10, x: 20 }) }
}

fn check(bad: i64, got: i64, want: i64) -> i64 with IO, Mut, Panic, Div {
    if got != want {
        print("MISMATCH got=")
        print_int(got)
        print(" want=")
        print_int(want)
        print("\n")
        return bad + 1
    }
    bad
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var bad: i64 = 0

    let ha = make_holder_a()
    let p = ha.inner
    bad = check(bad, (*p).x, 1)
    bad = check(bad, (*p).y, 2)

    let hb = make_holder_b()
    let q = hb.inner
    bad = check(bad, (*q).y, 10)
    bad = check(bad, (*q).x, 20)

    if bad == 0 {
        print("BOX_FIELD_REBIND_OK\n")
        return 0
    }
    print("BOX_FIELD_REBIND_FAIL\n")
    1
}
