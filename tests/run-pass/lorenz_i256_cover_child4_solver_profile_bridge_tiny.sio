//@ run-pass
//@ description: Self-contained Lorenz i256 child-4 solver proof-profile bridge

fn child4_solver_profile_bridge_check(
    solver_proof_profile_fp: i64,
    solver_proof_profile_audit_fp: i64,
    child4_boundary_gluing_input_guard_fp: i64,
    child4_boundary_gluing_input_guard_audit_fp: i64,
    solver_domain: i64,
    proof_format: i64,
    accepted_profile_mask: i64,
    rejected_profile_mask: i64,
    lorenz_numeric_gate: i64,
    private_acceptance_level: i64,
    formal_theorem_ready: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    boundary_gluing_proof_mask: i64,
    child4_discharge_mask: i64,
    finite_cover_certificate_mask: i64,
    bridge_status: i64) -> i64 {
    if solver_proof_profile_fp != 964210753 { return 0 - 1 }
    if solver_proof_profile_audit_fp != 526184309 { return 0 - 1 }
    if child4_boundary_gluing_input_guard_fp != 508913246 { return 0 - 1 }
    if child4_boundary_gluing_input_guard_audit_fp != 672184905 { return 0 - 1 }
    if solver_domain != 4 { return 0 - 1 }
    if proof_format != 6 { return 0 - 1 }
    if accepted_profile_mask != 15 { return 0 - 1 }
    if rejected_profile_mask != 48 { return 0 - 1 }
    if lorenz_numeric_gate != 1 { return 0 - 1 }
    if private_acceptance_level != 2 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if child4_discharge_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if bridge_status != 89 { return 0 - 1 }
    return 784215609
}

fn main() -> i64 {
    let artifact = child4_solver_profile_bridge_check(
        964210753, 526184309, 508913246, 672184905, 4, 6, 15, 48, 1, 2,
        0, 0, 0, 0, 0, 0, 89)
    if artifact != 784215609 { return 1 }

    let audit_fp: i64 = 639104872
    let instance_fp: i64 = 284903761
    let certificate_fp: i64 = 731582406
    let profile_status: i64 = 88
    let guard_status: i64 = 87
    let solver_profile_bridge_mask: i64 = 31
    let lorenz_receipt_family_mask: i64 = 16
    let bridge_dependency_mask: i64 = 31
    let checked_private_receipt_mask: i64 = 1
    let public_theorem_ready_mask: i64 = 0
    let global_promotion_ready_mask: i64 = 0
    let solver_bridge_next_action_mask: i64 = 31
    let ok_mask: i64 = 255

    if audit_fp != 639104872 { return 2 }
    if instance_fp != 284903761 { return 3 }
    if certificate_fp != 731582406 { return 4 }
    if profile_status != 88 { return 5 }
    if guard_status != 87 { return 6 }
    if solver_profile_bridge_mask != 31 { return 7 }
    if lorenz_receipt_family_mask != 16 { return 8 }
    if bridge_dependency_mask != 31 { return 9 }
    if checked_private_receipt_mask != 1 { return 10 }
    if public_theorem_ready_mask != 0 { return 11 }
    if global_promotion_ready_mask != 0 { return 12 }
    if solver_bridge_next_action_mask != 31 { return 13 }
    if ok_mask != 255 { return 14 }

    let wrong_profile = child4_solver_profile_bridge_check(
        1, 526184309, 508913246, 672184905, 4, 6, 15, 48, 1, 2,
        0, 0, 0, 0, 0, 0, 89)
    if wrong_profile != 0 - 1 { return 15 }

    let wrong_format = child4_solver_profile_bridge_check(
        964210753, 526184309, 508913246, 672184905, 4, 5, 15, 48, 1, 2,
        0, 0, 0, 0, 0, 0, 89)
    if wrong_format != 0 - 1 { return 16 }

    let fake_public = child4_solver_profile_bridge_check(
        964210753, 526184309, 508913246, 672184905, 4, 6, 15, 48, 1, 2,
        0, 1, 0, 0, 0, 0, 89)
    if fake_public != 0 - 1 { return 17 }

    let fake_global = child4_solver_profile_bridge_check(
        964210753, 526184309, 508913246, 672184905, 4, 6, 15, 48, 1, 2,
        0, 0, 1, 0, 0, 0, 89)
    if fake_global != 0 - 1 { return 18 }

    let fake_gluing_proof = child4_solver_profile_bridge_check(
        964210753, 526184309, 508913246, 672184905, 4, 6, 15, 48, 1, 2,
        0, 0, 0, 1, 0, 0, 89)
    if fake_gluing_proof != 0 - 1 { return 19 }

    return 0
}
