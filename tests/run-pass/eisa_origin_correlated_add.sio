//@ run-pass
//@ description: R7 — x+x same non-zero origin. Integer oracle 3+3=6, not 3*sqrt(2).
//
// Oracle (integers only, no floating point):
//   ua = 3, ub = 3, origin 1 == origin 1 != 0
//   => u' = ua + ub = 6
//   => origin' = 1
// IEEE 3.0+3.0 is exact; the runtime compares against 6.0 reconstructed
// from that integer sum, not against an IEEE sqrt.

use eisa::core::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let ua: i64 = 3
    let ub: i64 = 3
    let expected_u_int: i64 = ua + ub

    let x = ereg_origin(1.0, 3.0, 1)
    let z = eadd(x, x)

    if x.origin != 1 {
        println("EISA_ORIGIN_CORR_ADD FAIL origin(x)")
        return 1
    }
    if z.origin != 1 {
        println("EISA_ORIGIN_CORR_ADD FAIL origin(z)")
        return 1
    }
    // 6.0 is the integer oracle 3+3, written as f64 only to compare lanes.
    if z.u != 6.0 {
        println("EISA_ORIGIN_CORR_ADD FAIL u != 6")
        print("u=")
        print_f64(z.u)
        println("")
        return 1
    }
    if expected_u_int != 6 {
        println("EISA_ORIGIN_CORR_ADD FAIL integer oracle")
        return 1
    }
    println("EISA_ORIGIN_CORR_ADD OK u=6 origin=1")
    0
}
