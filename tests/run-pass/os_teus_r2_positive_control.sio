//@ run-pass
// R2 positive control: deliberately break the mask so the i8 witness fails.
// This file is the negative half of the positive-control pair
// (os_teus_r2_i8_overflow.sio). It runs in the *broken* branch (not the
// merged branch) and must produce FAIL, proving the witness catches a
// regression.
//
// The mask in hlir_int_type_mask_bits is set to all-ones (no-op) instead of
// the real 8-bit mask; the i8 100+100 result then prints as 200, not -56,
// and the witness detects the regression.
//
// To run this control: temporarily edit hlir_int_type_mask_bits to return
// -1 for I8/I16/I32 (and rebuild), then execute this file. The witness
// os_teus_r2_i8_overflow.sio should print FAIL. After verifying, revert
// the edit so the witness prints PASS in the merged branch.

fn main() with IO, Div, Panic {
    let x: i8 = 100 + 100
    if x == 0 - 56 {
        print("r2_positive_control: WRONG_MASK_PASS (this means the mask is broken)\n")
    } else {
        print("r2_positive_control: WRONG_MASK_FAIL (mask is correct, control did not run as intended)\n")
    }
}
