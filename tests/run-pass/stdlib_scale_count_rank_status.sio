//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: CHECKED RANK DIFFERENCE PASS
use stats::regression::nb2_likelihood::{nb2_likelihood_difference_slot,nb2_log_probability_difference_into,nb2_log_probability_rank_difference_into,nb2_likelihood_difference_snapshot,nb2_likelihood_difference_value,nb2_likelihood_difference_first_status,nb2_likelihood_difference_second_status,nb2_log_probability_mean_difference_traced_into,nb2_log_probability_mean_rank_difference_traced_into}
use stats::regression::count_fit_trace::{count_fit_trace_slot,count_fit_trace_bounded,count_fit_trace_metric,count_fit_trace_status,count_fit_trace_reset}
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
fn compare_one(count:i64,m0:f64,a0:f64,m1:f64,a1:f64,expected:i64,local:bool) with Mut,Div,Panic {
 var full=nb2_likelihood_difference_slot()
 var rank=nb2_likelihood_difference_slot()
 let fs:i64=nb2_log_probability_difference_into(count,m0,a0,m1,a1,&!full)
 let rs:i64=nb2_log_probability_rank_difference_into(count,m0,a0,m1,a1,&!rank)
 assert(fs==expected && rs==expected)
 let fv:f64=nb2_likelihood_difference_value(&full)
 let rv:f64=nb2_likelihood_difference_value(&rank)
 assert(f64_to_bits(fv)==f64_to_bits(rv))
 let saved=nb2_likelihood_difference_snapshot(&rank)
 if local {
  assert(saved.local_increment)
  assert(saved.first_status==2 && saved.second_status==2)
 } else {
  assert(saved.first_status==nb2_likelihood_difference_first_status(&full))
  assert(saved.second_status==nb2_likelihood_difference_second_status(&full))
 }
 assert(nb2_log_probability_rank_difference_into(-1,1.0,0.0,1.0,0.0,&!rank)==1)
 assert(f64_to_bits(saved.value)==f64_to_bits(rv) && saved.status==expected)
}
fn main()->i32 with Alloc,IO,Mut,Div,Panic {
 compare_one(4,4.0,0.0,4.125,0.0,0,true)
 compare_one(0,4.0,0.5,4.125,0.5,0,true)
 compare_one(4,4.0,0.5,4.125,0.5001,0,true)
 compare_one(4,4.0,0.0,40.0,0.0,0,false)
 compare_one(4,4.0,0.5,4.0,0.5,0,true)
 compare_one(-1,1.0,0.0,1.0,0.0,1,false)
 compare_one(9007199254740993,1.0,0.0,1.0,0.0,4,false)
 compare_one(1,0.0,0.0,1.0,0.0,2,false)
 compare_one(1,1.0,0.0,0.0,0.0,2,false)
 compare_one(1,1.0,-1.0,1.0,0.0,3,false)
 compare_one(1,1.0,0.0,1.0,-1.0,3,false)
 let minimum:f64=2.2250738585072014e-308/4503599627370496.0
 let twice_minimum:f64=minimum*2.0
 compare_one(0,minimum,0.0,twice_minimum,0.0,0,false)
 compare_one(0,1.7976931348623157e308,0.0,minimum,0.0,0,false)
 compare_one(9007199254740992,1e300,0.0,1.01e300,0.0,0,true)
 compare_one(9007199254740992,1e308,0.0,1e308,0.0,0,true)
 let nan:f64=0.0/0.0
 let inf:f64=1.0/0.0
 compare_one(1,nan,0.0,1.0,0.0,2,false)
 compare_one(1,1.0,0.0,1.0,inf,3,false)
 var c=integer_buffer_new(3,24)
 var m=numeric_buffer_new(3,24)
 var t=numeric_buffer_new(3,24)
 var i:i64=0
 while i<3 {integer_buffer_set(&!c,i,4+i);numeric_buffer_set(&!m,i,4.0);numeric_buffer_set(&!t,i,4.125);i=i+1}
 var full=nb2_likelihood_difference_slot()
 var rank=nb2_likelihood_difference_slot()
 var trace=count_fit_trace_slot()
 assert(nb2_log_probability_mean_rank_difference_traced_into(&c,&m,0.5,&t,0.5,3,&!rank,&!trace)==0)
 let rank_value:f64=nb2_likelihood_difference_value(&rank)
 assert(count_fit_trace_metric(&trace,7)==0)
 assert(nb2_likelihood_difference_first_status(&rank)==2 && nb2_likelihood_difference_second_status(&rank)==2)
 assert(nb2_log_probability_mean_difference_traced_into(&c,&m,0.5,&t,0.5,3,&!full,&!trace)==0)
 let full_value:f64=nb2_likelihood_difference_value(&full)
 assert(f64_to_bits(rank_value)==f64_to_bits(full_value))
 assert(count_fit_trace_metric(&trace,7)==6)
 count_fit_trace_reset(&!trace)
 i=0
 while i<3 {numeric_buffer_set(&!t,i,40.0);i=i+1}
 assert(nb2_log_probability_mean_rank_difference_traced_into(&c,&m,0.0,&t,0.0,3,&!rank,&!trace)==0)
 assert(count_fit_trace_metric(&trace,7)==6)
 assert(nb2_likelihood_difference_first_status(&rank)==0 && nb2_likelihood_difference_second_status(&rank)==0)
 count_fit_trace_reset(&!trace)
 i=0
 while i<3 {numeric_buffer_set(&!t,i,4.125);i=i+1}
 integer_buffer_set(&!c,1,-1)
 assert(nb2_log_probability_mean_rank_difference_traced_into(&c,&m,0.5,&t,0.5,3,&!rank,&!trace)==1)
 assert(count_fit_trace_metric(&trace,7)==2)
 assert(nb2_likelihood_difference_value(&rank)==0.0)
 var bounded=count_fit_trace_bounded(0)
 assert(nb2_log_probability_mean_rank_difference_traced_into(&c,&m,0.0,&t,0.0,0,&!rank,&!bounded)==1)
 assert(count_fit_trace_status(&bounded)==0)
 integer_buffer_close(c)
 numeric_buffer_close(m)
 numeric_buffer_close(t)
 println("CHECKED RANK DIFFERENCE PASS")
 0
}
