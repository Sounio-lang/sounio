//@ run-pass
//@ requires: madaros
//@ expect-stdout: 7
// SIO-352: implicit borrow of an identifier at a call (ADR-020, D-26):
// `sum(p)` with `p: Point` and parameter `&Point` borrows the identifier
// and prints 7. The shipped compiler used to accept and then segfault
// (rc 139); the source was fixed without a regression test landing.

struct Point { x: i64, y: i64 }

fn sum(p: &Point) -> i64 {
    return p.x + p.y
}

fn main() -> i32 with IO {
    let p = Point { x: 3, y: 4 }
    print_int(sum(p))
    println("")
    return 0
}
