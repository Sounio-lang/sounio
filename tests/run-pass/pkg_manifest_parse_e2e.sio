//@ run-pass
// End-to-end smoke test: pkg TOML string parsing primitives.
// Validates: str_len on multiline strings, str_char_at, newline scanning,
// basic substring detection — same primitives used by pkg/manifest.sio.

fn pkg_sw(s: str, pos: i64, prefix: str) -> bool with Mut, Panic {
    let plen = str_len(prefix) as i64
    let slen = str_len(s) as i64
    if slen - pos < plen { return false }
    var i: i64 = 0
    while i < plen {
        if str_char_at(s, pos + i) != str_char_at(prefix, i) {
            return false
        }
        i = i + 1
    }
    true
}

fn count_newlines(s: str) -> i64 with Mut, Panic {
    let n = str_len(s) as i64
    var count: i64 = 0
    var i: i64 = 0
    while i < n {
        if str_char_at(s, i) as i64 == 10 { count = count + 1 }
        i = i + 1
    }
    count
}

fn main() -> i32 with IO, Mut, Panic {
    let toml = "[package]\nname = \"test-pkg\"\nversion = \"1.0.0\"\n"

    // T1: length check
    let n = str_len(toml) as i64
    if n < 10 {
        println("T1 FAIL: string too short")
        return 1
    }
    println("T1 PASS: string length")

    // T2: newline count
    let nl = count_newlines(toml)
    if nl != 3 {
        println("T2 FAIL: wrong newline count")
        return 1
    }
    println("T2 PASS: newline count")

    // T3: section detection
    if !pkg_sw(toml, 0, "[package]") {
        println("T3 FAIL: section not detected")
        return 1
    }
    println("T3 PASS: section detection")

    // T4: key detection (name at position 10)
    if !pkg_sw(toml, 10, "name") {
        println("T4 FAIL: name key not at pos 10")
        return 1
    }
    println("T4 PASS: key position")

    println("pkg_manifest_parse_e2e: ALL PASS")
    return 0
}
