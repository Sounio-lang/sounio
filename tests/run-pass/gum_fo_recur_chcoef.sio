//@ run-pass
//@ requires: madaros
//@ expect-stdout: c0 0.090000
//@ expect-stdout: c1 1.060000
//@ expect-stdout: c2 10.660000
//@ expect-stdout: c12 513571635.540000
//@ expect-stdout: cneg 0.090000
//@ expect-stdout: RECUR_CHCOEF_OK
// a = 5 +- 0.3, var = 0.09. b = 2 +- 0.1, var = 0.01. Independent.
// z_n = a * (b^(n+1) - 1) / (b - 1). n = 1 is 9 * 0.09 + 25 * 0.01.
// n = 12 is 8191^2 * 0.09 + 225285^2 * 0.01.

fn cy(x: f64, y: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        y * cy(x, y, n - 1) + x
    }
}

fn main() -> i64 with IO, Epistemic {
    let kx: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let ky: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let a = kx.value
    let b = ky.value
    let c0 = variance_of(cy(a, b, 0))
    let c1 = variance_of(cy(a, b, 1))
    let c2 = variance_of(cy(a, b, 2))
    let c12 = variance_of(cy(a, b, 12))
    let cneg = variance_of(cy(a, b, 0 - 2))
    print("c0 ")
    print_f64(c0)
    println("")
    print("c1 ")
    print_f64(c1)
    println("")
    print("c2 ")
    print_f64(c2)
    println("")
    print("c12 ")
    print_f64(c12)
    println("")
    print("cneg ")
    print_f64(cneg)
    println("")
    var fails: i64 = 0
    if c0 < 0.089999 || c0 > 0.090001 { fails = fails + 1 }
    if c1 < 1.059999 || c1 > 1.060001 { fails = fails + 1 }
    if c2 < 10.659999 || c2 > 10.660001 { fails = fails + 1 }
    if c12 < 513571635.0 || c12 > 513571636.0 { fails = fails + 1 }
    if cneg < 0.089999 || cneg > 0.090001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_CHCOEF_OK")
        0
    } else {
        println("RECUR_CHCOEF_FAIL")
        1
    }
}
