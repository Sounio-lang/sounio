pub fn imported_f64_return_value() -> f64 {
    return 10.0
}

pub fn imported_i64_return_value() -> i64 {
    return 10
}

pub fn imported_f64_internal_check() -> i64 {
    let x = 10.0
    if !(x > 9.999 && x < 10.001) { return 0 }
    return 1
}
