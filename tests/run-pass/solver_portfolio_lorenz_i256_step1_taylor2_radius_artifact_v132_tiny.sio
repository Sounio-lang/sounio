//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v132 smoke for Lorenz i256 step-1 Taylor-2 radius artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2179
    receipt_fp = mix(receipt_fp, 133154696, 6211)
    receipt_fp = mix(receipt_fp, 194048456, 6211)
    receipt_fp = mix(receipt_fp, 385676943, 6211)
    receipt_fp = mix(receipt_fp, 791962712, 6211)
    receipt_fp = mix(receipt_fp, 498045878, 6211)
    receipt_fp = mix(receipt_fp, 360785796, 6211)
    receipt_fp = mix(receipt_fp, 450703322, 6211)
    receipt_fp = mix(receipt_fp, 472667880, 6211)
    receipt_fp = mix(receipt_fp, 286326819, 6211)
    receipt_fp = mix(receipt_fp, 1, 6211)
    receipt_fp = mix(receipt_fp, 2, 6211)
    receipt_fp = mix(receipt_fp, 127, 6211)
    if receipt_fp != 313127397 { return 1 }

    var audit_fp: i64 = 2203
    audit_fp = mix(audit_fp, receipt_fp, 6217)
    audit_fp = mix(audit_fp, 133154696, 6217)
    audit_fp = mix(audit_fp, 194048456, 6217)
    audit_fp = mix(audit_fp, 385676943, 6217)
    audit_fp = mix(audit_fp, 791962712, 6217)
    audit_fp = mix(audit_fp, 472667880, 6217)
    audit_fp = mix(audit_fp, 286326819, 6217)
    audit_fp = mix(audit_fp, 450703322, 6217)
    audit_fp = mix(audit_fp, 1, 6217)
    audit_fp = mix(audit_fp, 2, 6217)
    audit_fp = mix(audit_fp, 127, 6217)
    if audit_fp != 155192722 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 135, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 135, 1103)
    if entry_fp != 840177182 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 132, 1151)
    manifest_fp = mix(manifest_fp, 136, 1151)
    manifest_fp = mix(manifest_fp, 360785796, 1151)
    manifest_fp = mix(manifest_fp, 498045878, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 567532487 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 132, 1871)
    result_fp = mix(result_fp, 136, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 124, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 525558358 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 132, 1907)
    family_fp = mix(family_fp, 136, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 119, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 695592996 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 132, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 32482341 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 132, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 242956216 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 132, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
