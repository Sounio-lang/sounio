//@ run-pass
//@ expect-stdout: unit module var: PASS
// A unit-typed variable at module scope. This is the original symptom: the
// type-check passed and the value came back wrong -- 298.0 read back as 0.09 --
// which is the worst failure a type system can have. No test bound a unit at
// module scope at all.

unit degK = K;

var T_MIN: degK = 298.0

fn main() -> i32 with IO, Mut, Panic, Div {
    if T_MIN == 298.0 {
        print("unit module var: PASS\n")
    }
    return 0
}
