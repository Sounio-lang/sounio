//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v115 smoke for Lorenz i256 step-2 Taylor-2 response envelope

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2099
    receipt_fp = mix(receipt_fp, 482555681, 6113)
    receipt_fp = mix(receipt_fp, 591288676, 6113)
    receipt_fp = mix(receipt_fp, 468517435, 6113)
    receipt_fp = mix(receipt_fp, 402376335, 6113)
    receipt_fp = mix(receipt_fp, 675936756, 6113)
    receipt_fp = mix(receipt_fp, 237552477, 6113)
    receipt_fp = mix(receipt_fp, 373523570, 6113)
    receipt_fp = mix(receipt_fp, 268229078, 6113)
    receipt_fp = mix(receipt_fp, 223161586, 6113)
    receipt_fp = mix(receipt_fp, 2, 6113)
    receipt_fp = mix(receipt_fp, 20, 6113)
    receipt_fp = mix(receipt_fp, 255, 6113)
    if receipt_fp != 867385129 { return 1 }

    var audit_fp: i64 = 2111
    audit_fp = mix(audit_fp, receipt_fp, 6121)
    audit_fp = mix(audit_fp, 482555681, 6121)
    audit_fp = mix(audit_fp, 591288676, 6121)
    audit_fp = mix(audit_fp, 468517435, 6121)
    audit_fp = mix(audit_fp, 402376335, 6121)
    audit_fp = mix(audit_fp, 268229078, 6121)
    audit_fp = mix(audit_fp, 223161586, 6121)
    audit_fp = mix(audit_fp, 373523570, 6121)
    audit_fp = mix(audit_fp, 2, 6121)
    audit_fp = mix(audit_fp, 20, 6121)
    audit_fp = mix(audit_fp, 255, 6121)
    if audit_fp != 50054842 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 118, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 118, 1103)
    if entry_fp != 865711690 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 115, 1151)
    manifest_fp = mix(manifest_fp, 119, 1151)
    manifest_fp = mix(manifest_fp, 237552477, 1151)
    manifest_fp = mix(manifest_fp, 675936756, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 242024859 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 115, 1871)
    result_fp = mix(result_fp, 119, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 107, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 828729430 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 115, 1907)
    family_fp = mix(family_fp, 119, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 102, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 684502203 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 115, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 954945780 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 115, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 916566740 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 115, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 442225509 { return 9 }
    return 0
}
