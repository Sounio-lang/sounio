//@ run-pass
//@ expect-stdout: ONTOLOGY_ELPLUS_EXPLANATION_CYCLE_OK
// Malformed provenance regression. S(0,1) claims transitivity through
// itself, so proof reconstruction must reject the cycle with a negative
// result rather than recurse forever. This is distinct from completed-node
// DAG reuse, which remains covered by the shared-premise fixture.

use ontology::elplus_explain::{elplus_trace_new, elplus_explanation_new, elplus_explain_subsumption}

fn main() -> i32 with IO, Mut, Div, Panic {
    var s: [bool; 4096] = [false; 4096]
    var r: [bool; 32768] = [false; 32768]
    var pack: [i64; 704] = [0; 704]
    var trace = elplus_trace_new()
    var out = elplus_explanation_new()

    s[1] = true
    trace.srule[1] = 3
    trace.swit[1] = 1
    let rc = elplus_explain_subsumption(&s, &r, &pack, &trace, &!out, 0, 1)
    if rc != 0 - 4 { return 20 }
    if out.count != 0 || out.active_count != 0 { return 21 }

    println("ONTOLOGY_ELPLUS_EXPLANATION_CYCLE_OK rc=-4")
    return 0
}
