//@ run-pass
//@ expect-stdout: RESULTADO_CORRETO
// O produto de pressão e pressão inversa deve ser adimensional.
unit pressure = kg / m / s / s
unit inverse_pressure = m * s * s / kg

fn exponent(beta: inverse_pressure, delta: pressure) -> f64 {
    (beta as f64) * (delta as f64)
}

// O teste de faixa evita depender somente da impressão.
fn main() -> i32 with IO {
    let beta: inverse_pressure = 0.00007
    let delta: pressure = 1000.0
    let result = exponent(beta, delta)
    print_f64(result)
    print("\n")
    if result > 0.069999 {
        if result < 0.070001 {
            print("RESULTADO_CORRETO\n")
            return 0
        }
    }
    print("RESULTADO_INCORRETO\n")
    return 1
}
