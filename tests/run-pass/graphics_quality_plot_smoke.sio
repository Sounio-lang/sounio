//@ run-pass

use graphics::drawing::{Color}
use graphics::surface::{surface_new, surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b}
use graphics::quality::{plot_line_raster_smooth, quality_line_plot_config_default}

fn main() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(80, 80)
    var xs: [f64; 256] = [0.0; 256]
    var ys: [f64; 256] = [0.0; 256]
    xs[0] = 0.0
    ys[0] = 0.0
    xs[1] = 1.0
    ys[1] = 0.7
    xs[2] = 2.0
    ys[2] = 0.2
    xs[3] = 3.0
    ys[3] = 1.0

    let cfg = quality_line_plot_config_default()
    s = plot_line_raster_smooth(s, &xs, &ys, 4, cfg)

    let vaxis_r = surface_get_pixel_r(&s, 20, 40)
    let vaxis_b = surface_get_pixel_b(&s, 20, 40)
    if vaxis_r > 80 || vaxis_b > 120 {
        print("FAIL vertical axis missing\n")
        return 1
    }
    let haxis_r = surface_get_pixel_r(&s, 40, 59)
    let haxis_b = surface_get_pixel_b(&s, 40, 59)
    if haxis_r > 80 || haxis_b > 120 {
        print("FAIL horizontal axis missing\n")
        return 2
    }

    let grid_r = surface_get_pixel_r(&s, 30, 30)
    if grid_r <= 120 || grid_r >= 255 {
        print("FAIL alpha grid did not blend over white background\n")
        return 3
    }

    var line_count = 0
    var partial_count = 0
    var y = 0
    while y < 80 {
        var x = 0
        while x < 80 {
            let r = surface_get_pixel_r(&s, x, y)
            let g = surface_get_pixel_g(&s, x, y)
            let b = surface_get_pixel_b(&s, x, y)
            if b > r && b > g {
                line_count = line_count + 1
                if b < 255 || r > 0 || g > 80 {
                    partial_count = partial_count + 1
                }
            }
            x = x + 1
        }
        y = y + 1
    }

    if line_count < 20 {
        print("FAIL smooth quality line missing\n")
        return 10
    }
    if partial_count < 8 {
        print("FAIL smooth quality line lacks partial coverage\n")
        return 11
    }

    var c = surface_new(48, 48)
    var cxs: [f64; 256] = [0.0; 256]
    var cys: [f64; 256] = [2.0; 256]
    cxs[0] = 1.0
    cxs[1] = 1.0
    cxs[2] = 1.0
    c = plot_line_raster_smooth(c, &cxs, &cys, 3, cfg)

    var constant_pixels = 0
    y = 0
    while y < 48 {
        var x2 = 0
        while x2 < 48 {
            let r2 = surface_get_pixel_r(&c, x2, y)
            let g2 = surface_get_pixel_g(&c, x2, y)
            let b2 = surface_get_pixel_b(&c, x2, y)
            if b2 > r2 && b2 > g2 {
                constant_pixels = constant_pixels + 1
            }
            x2 = x2 + 1
        }
        y = y + 1
    }
    if constant_pixels <= 0 {
        print("FAIL constant quality line did not render\n")
        return 20
    }

    print("PASS graphics_quality_plot_smoke\n")
    0
}
