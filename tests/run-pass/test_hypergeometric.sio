//@ run-pass

// ---------------------------------------------------------------------------
// Hypergeometric Functions test suite -- all helpers inlined, no imports
//
// Functions tested (Taylor series implementations):
//   hyperg_1f1  -- Kummer's confluent hypergeometric M(a, b, z)
//   hyperg_2f1  -- Gauss hypergeometric 2F1(a, b; c; z)  (|z| < 1)
//   hyperg_0f1  -- Confluent limit 0F1(; b; z)
//
// References:
//   Abramowitz & Stegun (1964), Ch. 13, 15
//   DLMF (https://dlmf.nist.gov) chapters 13, 15, 16
//   Andrews, Askey, Roy "Special Functions" (1999)
// ---------------------------------------------------------------------------

// ============================================================================
// CONSTANTS
// ============================================================================

fn pi_val() -> f64 {
    3.14159265358979323846
}

fn ln2_val() -> f64 {
    0.6931471805599453
}

// ============================================================================
// HELPERS (must precede callers)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn exp_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x > 20.0 { return exp_f64(x / 2.0) * exp_f64(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / exp_f64(0.0 - x) }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 30 {
        term = term * x / (i as f64)
        sum = sum + term
        i = i + 1
    }
    return sum
}

fn ln_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    if x == 1.0 { return 0.0 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 {
        term = term * t2
        sum = sum + term / ((2 * k + 1) as f64)
        k = k + 1
    }
    return 2.0 * sum + (e as f64) * ln2_val()
}

// ============================================================================
// HYPERGEOMETRIC FUNCTIONS
// ============================================================================

// 1F1(a, b, z) = M(a, b, z) = sum_{k=0}^{inf} (a)_k z^k / ((b)_k k!)
// Pochhammer: (a)_k = a * (a+1) * ... * (a+k-1)
// Recurrence for terms: term_k = term_{k-1} * a_{k-1} * z / (b_{k-1} * k)
//   where a_{k-1} = a + k - 1, b_{k-1} = b + k - 1
// Max 100 terms; break when |term| < 1e-15 * |sum|
fn hyperg_1f1(a: f64, b: f64, z: f64) -> f64 with Mut, Panic, Div {
    var sum = 1.0
    var term = 1.0
    var k = 1
    while k <= 100 {
        let kf = k as f64
        term = term * (a + kf - 1.0) * z / ((b + kf - 1.0) * kf)
        sum = sum + term
        if abs_f64(term) < 1.0e-15 * abs_f64(sum) {
            return sum
        }
        k = k + 1
    }
    return sum
}

// 2F1(a, b, c, z) = sum_{k=0}^{inf} (a)_k (b)_k z^k / ((c)_k k!)
// For |z| < 1.
// Recurrence: term_k = term_{k-1} * (a+k-1) * (b+k-1) * z / ((c+k-1) * k)
// Max 200 terms; break when |term| < 1e-15 * |sum|
fn hyperg_2f1(a: f64, b: f64, c: f64, z: f64) -> f64 with Mut, Panic, Div {
    var sum = 1.0
    var term = 1.0
    var k = 1
    while k <= 200 {
        let kf = k as f64
        term = term * (a + kf - 1.0) * (b + kf - 1.0) * z / ((c + kf - 1.0) * kf)
        sum = sum + term
        if abs_f64(term) < 1.0e-15 * abs_f64(sum) {
            return sum
        }
        k = k + 1
    }
    return sum
}

// 0F1(; b; z) = sum_{k=0}^{inf} z^k / ((b)_k k!)
// Recurrence: term_k = term_{k-1} * z / ((b+k-1) * k)
// Max 100 terms; break when |term| < 1e-15 * |sum|
fn hyperg_0f1(b: f64, z: f64) -> f64 with Mut, Panic, Div {
    var sum = 1.0
    var term = 1.0
    var k = 1
    while k <= 100 {
        let kf = k as f64
        term = term * z / ((b + kf - 1.0) * kf)
        sum = sum + term
        if abs_f64(term) < 1.0e-15 * abs_f64(sum) {
            return sum
        }
        k = k + 1
    }
    return sum
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

// Test 1: 1F1(1, 1, 1) = e
// M(1,1,z) = e^z, so M(1,1,1) = e
fn test_1f1_is_exp() -> bool with IO, Mut, Panic, Div {
    let got = hyperg_1f1(1.0, 1.0, 1.0)
    let expected = exp_f64(1.0)
    let tol = 1.0e-10
    print("  1F1(1,1,1)=")
    println(got)
    print("  e=")
    println(expected)
    return abs_f64(got - expected) < tol
}

// Test 2: 1F1(1, 1, 0) = 1
fn test_1f1_at_zero() -> bool with IO, Mut, Panic, Div {
    let got = hyperg_1f1(1.0, 1.0, 0.0)
    let expected = 1.0
    let tol = 1.0e-12
    print("  1F1(1,1,0)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 3: 1F1(1, 1, -1) = 1/e
fn test_1f1_neg_one() -> bool with IO, Mut, Panic, Div {
    let got = hyperg_1f1(1.0, 1.0, 0.0 - 1.0)
    let expected = 1.0 / exp_f64(1.0)
    let tol = 1.0e-10
    print("  1F1(1,1,-1)=")
    println(got)
    print("  1/e=")
    println(expected)
    return abs_f64(got - expected) < tol
}

// Test 4: 1F1(1, 2, 1) = (e - 1) / 1 = e - 1
// Identity: M(1, 2, z) = (e^z - 1) / z
fn test_1f1_kummer_identity() -> bool with IO, Mut, Panic, Div {
    let got = hyperg_1f1(1.0, 2.0, 1.0)
    let expected = exp_f64(1.0) - 1.0
    let tol = 1.0e-8
    print("  1F1(1,2,1)=")
    println(got)
    print("  e-1=")
    println(expected)
    return abs_f64(got - expected) < tol
}

// Test 5: 2F1(1, 1, 2, -1) = ln(2)
// Identity: 2F1(1, 1, 2, -z) = ln(1+z) / z
// At z=1: 2F1(1,1,2,-1) = ln(2) / 1 = ln(2)
fn test_2f1_ln2() -> bool with IO, Mut, Panic, Div {
    let got = hyperg_2f1(1.0, 1.0, 2.0, 0.0 - 1.0)
    let expected = ln_f64(2.0)
    let tol = 1.0e-8
    print("  2F1(1,1,2,-1)=")
    println(got)
    print("  ln(2)=")
    println(expected)
    return abs_f64(got - expected) < tol
}

// Test 6: 2F1(1, 1, 1, 0) = 1
fn test_2f1_at_zero() -> bool with IO, Mut, Panic, Div {
    let got = hyperg_2f1(1.0, 1.0, 1.0, 0.0)
    let expected = 1.0
    let tol = 1.0e-12
    print("  2F1(1,1,1,0)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 7: 2F1(0.5, 1, 1.5, -1) = pi/4
// Identity: 2F1(1/2, 1, 3/2, -x) = arctan(sqrt(x)) / sqrt(x)
// At x=1: arctan(1) / 1 = pi/4
fn test_2f1_arctan() -> bool with IO, Mut, Panic, Div {
    let got = hyperg_2f1(0.5, 1.0, 1.5, 0.0 - 1.0)
    let expected = pi_val() / 4.0
    let tol = 1.0e-6
    print("  2F1(0.5,1,1.5,-1)=")
    println(got)
    print("  pi/4=")
    println(expected)
    return abs_f64(got - expected) < tol
}

// Test 8: 0F1(;1;-0.25) = J_0(1) ~ 0.7651976865579666
// Identity: J_v(z) = (z/2)^v / Gamma(v+1) * 0F1(; v+1; -z^2/4)
// For v=0: J_0(z) = 0F1(; 1; -z^2/4)
// At z=1: 0F1(; 1; -1/4) = J_0(1)
fn test_0f1_bessel_j0() -> bool with IO, Mut, Panic, Div {
    let got = hyperg_0f1(1.0, 0.0 - 0.25)
    let expected = 0.7651976865579666
    let tol = 1.0e-4
    print("  0F1(;1;-0.25)=")
    println(got)
    print("  J_0(1)=")
    println(expected)
    return abs_f64(got - expected) < tol
}

// Test 9: 2F1(a, b, c, 0) = 1 for any valid a, b, c
fn test_2f1_any_at_zero() -> bool with IO, Mut, Panic, Div {
    let g1 = hyperg_2f1(3.7, 2.1, 5.5, 0.0)
    let g2 = hyperg_2f1(0.0 - 0.5, 1.0, 3.0, 0.0)
    let g3 = hyperg_2f1(10.0, 0.1, 0.3, 0.0)
    let tol = 1.0e-12
    print("  2F1(3.7,2.1,5.5,0)=")
    println(g1)
    print("  2F1(-0.5,1,3,0)=")
    println(g2)
    print("  2F1(10,0.1,0.3,0)=")
    println(g3)
    let ok1 = abs_f64(g1 - 1.0) < tol
    let ok2 = abs_f64(g2 - 1.0) < tol
    let ok3 = abs_f64(g3 - 1.0) < tol
    return ok1 && ok2 && ok3
}

// Test 10: 1F1(a, a, z) = e^z
// Identity: M(a, a, z) = e^z for any a
// Test M(3, 3, 2) = e^2
fn test_1f1_equal_params() -> bool with IO, Mut, Panic, Div {
    let got = hyperg_1f1(3.0, 3.0, 2.0)
    let expected = exp_f64(2.0)
    let tol = 1.0e-8
    print("  1F1(3,3,2)=")
    println(got)
    print("  e^2=")
    println(expected)
    return abs_f64(got - expected) < tol
}

// Test 11: 2F1(1, 1, 2, 0.5) = -ln(1-0.5) / 0.5 = -ln(0.5) / 0.5 = 2*ln(2)
// Identity: 2F1(1, 1, 2, z) = -ln(1-z) / z
fn test_2f1_log_identity() -> bool with IO, Mut, Panic, Div {
    let got = hyperg_2f1(1.0, 1.0, 2.0, 0.5)
    let expected = 0.0 - ln_f64(0.5) / 0.5
    let tol = 1.0e-6
    print("  2F1(1,1,2,0.5)=")
    println(got)
    print("  2*ln(2)=")
    println(expected)
    return abs_f64(got - expected) < tol
}

// Test 12: 0F1(;1;0) = 1
fn test_0f1_at_zero() -> bool with IO, Mut, Panic, Div {
    let got = hyperg_0f1(1.0, 0.0)
    let expected = 1.0
    let tol = 1.0e-12
    print("  0F1(;1;0)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 13: Symmetry: 2F1(a, b, c, z) = 2F1(b, a, c, z)
// Check at a=0.3, b=0.7, c=1.5, z=0.4
fn test_2f1_symmetry() -> bool with IO, Mut, Panic, Div {
    let val1 = hyperg_2f1(0.3, 0.7, 1.5, 0.4)
    let val2 = hyperg_2f1(0.7, 0.3, 1.5, 0.4)
    let tol = 1.0e-10
    print("  2F1(0.3,0.7,1.5,0.4)=")
    println(val1)
    print("  2F1(0.7,0.3,1.5,0.4)=")
    println(val2)
    return abs_f64(val1 - val2) < tol
}

// Test 14: Kummer transformation: M(a, b, z) = e^z * M(b-a, b, -z)
// Test at a=1, b=3, z=2
fn test_kummer_transform() -> bool with IO, Mut, Panic, Div {
    let lhs = hyperg_1f1(1.0, 3.0, 2.0)
    let rhs = exp_f64(2.0) * hyperg_1f1(2.0, 3.0, 0.0 - 2.0)
    let tol = 1.0e-6
    print("  M(1,3,2)=")
    println(lhs)
    print("  e^2 * M(2,3,-2)=")
    println(rhs)
    return abs_f64(lhs - rhs) < tol
}

// Test 15: 2F1(1/2, 1/2, 1, k^2) = (2/pi) * K(k)
// where K(k) is the complete elliptic integral of the first kind.
// At k=0.5 (k^2=0.25): K(0.5) ~ 1.8541 so 2F1(0.5,0.5,1,0.25) ~ (2/pi)*1.8541 ~ 1.1803
fn test_2f1_elliptic_k() -> bool with IO, Mut, Panic, Div {
    let got = hyperg_2f1(0.5, 0.5, 1.0, 0.25)
    let expected = 1.1803405990149968
    let tol = 1.0e-4
    print("  2F1(0.5,0.5,1,0.25)=")
    println(got)
    print("  (2/pi)*K(0.5)=")
    println(expected)
    return abs_f64(got - expected) < tol
}

// ============================================================================
// MAIN TEST RUNNER
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== Hypergeometric Functions Tests ===")
    println("")

    var passed = 0
    var failed = 0

    // Test 1
    print("Test  1: 1F1(1,1,1) = e .............. ")
    if test_1f1_is_exp() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 2
    print("Test  2: 1F1(1,1,0) = 1 .............. ")
    if test_1f1_at_zero() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 3
    print("Test  3: 1F1(1,1,-1) = 1/e ........... ")
    if test_1f1_neg_one() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 4
    print("Test  4: 1F1(1,2,1) = e-1 ............ ")
    if test_1f1_kummer_identity() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 5
    print("Test  5: 2F1(1,1,2,-1) = ln(2) ....... ")
    if test_2f1_ln2() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 6
    print("Test  6: 2F1(1,1,1,0) = 1 ............ ")
    if test_2f1_at_zero() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 7
    print("Test  7: 2F1(0.5,1,1.5,-1) = pi/4 .... ")
    if test_2f1_arctan() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 8
    print("Test  8: 0F1(;1;-0.25) = J_0(1) ...... ")
    if test_0f1_bessel_j0() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 9
    print("Test  9: 2F1(a,b,c,0) = 1 ............ ")
    if test_2f1_any_at_zero() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 10
    print("Test 10: 1F1(3,3,2) = e^2 ............ ")
    if test_1f1_equal_params() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 11
    print("Test 11: 2F1(1,1,2,0.5) = 2*ln(2) ... ")
    if test_2f1_log_identity() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 12
    print("Test 12: 0F1(;1;0) = 1 ............... ")
    if test_0f1_at_zero() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 13
    print("Test 13: 2F1 symmetry a<->b .......... ")
    if test_2f1_symmetry() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 14
    print("Test 14: Kummer transformation ........ ")
    if test_kummer_transform() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 15
    print("Test 15: 2F1 elliptic K identity ...... ")
    if test_2f1_elliptic_k() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    println("")
    if failed == 0 {
        println("ALL 15 TESTS PASSED")
        return 0
    }
    println("SOME TESTS FAILED")
    return 1
}
