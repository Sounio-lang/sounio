//@ run-pass
//@ requires: madaros

affine struct Permit {
    id: i64,
}

struct Envelope {
    permit: Permit,
}

fn open(envelope: Envelope) -> i64 {
    envelope.permit.id
}

fn main() -> i32 with Panic {
    let envelope = Envelope { permit: Permit { id: 31 } }
    assert(open(envelope) == 31)
    0
}
