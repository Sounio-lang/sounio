//@ run-pass
//@ known-failure: Requires implementation

use theorem::search::{
    proof_context_new, ctx_prop, ctx_get_prop, ctx_get_proof,
    prop_custom, prop_and, prop_or, prop_implies, prop_not,
    assume, auto_prove, verify, search_reset, to_cnf, resolve, saturate,
    tactic_or, tactic_then, and_intro
}

fn test_t1() -> bool with Mut, Div {
    var ctx = proof_context_new()
    let a = ctx_prop(&! ctx, prop_custom(1))
    let b = ctx_prop(&! ctx, prop_custom(2))
    assume(&! ctx, 1, a)
    assume(&! ctx, 2, b)
    let goal = ctx_prop(&! ctx, prop_and(a, b))
    let prf = auto_prove(&! ctx, goal, 4)
    if prf < 0 { return false }
    if verify(&ctx, prf).is_valid == false { return false }
    return ctx_get_proof(&ctx, prf).prop_id == goal
}

fn test_t2() -> bool with Mut, Div {
    var ctx = proof_context_new()
    let a = ctx_prop(&! ctx, prop_custom(10))
    let b = ctx_prop(&! ctx, prop_custom(20))
    let ab = ctx_prop(&! ctx, prop_implies(a, b))
    assume(&! ctx, 1, ab)
    assume(&! ctx, 2, a)
    let prf = auto_prove(&! ctx, b, 4)
    if prf < 0 { return false }
    if verify(&ctx, prf).is_valid == false { return false }
    return ctx_get_proof(&ctx, prf).prop_id == b
}

fn test_t3() -> bool with Mut, Div {
    var ctx = proof_context_new()
    let a = ctx_prop(&! ctx, prop_custom(30))
    let b = ctx_prop(&! ctx, prop_custom(40))
    assume(&! ctx, 1, a)
    let goal = ctx_prop(&! ctx, prop_or(a, b))
    let prf = auto_prove(&! ctx, goal, 4)
    if prf < 0 { return false }
    if verify(&ctx, prf).is_valid == false { return false }
    return ctx_get_proof(&ctx, prf).prop_id == goal
}

fn test_t4() -> bool with Mut, Div {
    var ctx = proof_context_new()
    let a = ctx_prop(&! ctx, prop_custom(50))
    let na = ctx_prop(&! ctx, prop_not(a))
    let nna = ctx_prop(&! ctx, prop_not(na))
    assume(&! ctx, 1, nna)
    let prf = auto_prove(&! ctx, a, 5)
    if prf < 0 { return false }
    if verify(&ctx, prf).is_valid == false { return false }
    return ctx_get_proof(&ctx, prf).prop_id == a
}

fn test_t5() -> bool with Mut, Div {
    var ctx = proof_context_new()
    let a = ctx_prop(&! ctx, prop_custom(60))
    let b = ctx_prop(&! ctx, prop_custom(61))
    let c = ctx_prop(&! ctx, prop_custom(62))
    let ab = ctx_prop(&! ctx, prop_implies(a, b))
    let bc = ctx_prop(&! ctx, prop_implies(b, c))
    let ac = ctx_prop(&! ctx, prop_implies(a, c))
    let inner = ctx_prop(&! ctx, prop_implies(bc, ac))
    let goal = ctx_prop(&! ctx, prop_implies(ab, inner))
    let prf = auto_prove(&! ctx, goal, 6)
    if prf < 0 { return false }
    if verify(&ctx, prf).is_valid == false { return false }
    return ctx_get_proof(&ctx, prf).prop_id == goal
}

fn test_t6() -> bool with Mut, Div {
    var ctx = proof_context_new()
    let a = ctx_prop(&! ctx, prop_custom(70))
    let b = ctx_prop(&! ctx, prop_custom(71))
    let na = ctx_prop(&! ctx, prop_not(a))
    let nb = ctx_prop(&! ctx, prop_not(b))
    let c2 = ctx_prop(&! ctx, prop_or(na, b))
    let mid_and = ctx_prop(&! ctx, prop_and(a, c2))
    let formula = ctx_prop(&! ctx, prop_and(mid_and, nb))
    search_reset(&! ctx)
    to_cnf(&! ctx, formula)
    let mid = resolve(&! ctx, a, c2, a)
    if mid < 0 { return false }
    let fin = resolve(&! ctx, mid, nb, b)
    if fin < 0 { return false }
    if ctx_get_prop(&ctx, fin).tag != 1 { return false }
    search_reset(&! ctx)
    to_cnf(&! ctx, formula)
    return saturate(&! ctx, 20)
}

fn test_t7() -> bool with Mut, Div {
    var ctx = proof_context_new()
    let a = ctx_prop(&! ctx, prop_custom(80))
    let b = ctx_prop(&! ctx, prop_custom(81))
    let ab = ctx_prop(&! ctx, prop_and(a, b))
    let not_ab = ctx_prop(&! ctx, prop_not(ab))
    let not_a = ctx_prop(&! ctx, prop_not(a))
    let not_b = ctx_prop(&! ctx, prop_not(b))
    let disj = ctx_prop(&! ctx, prop_or(not_a, not_b))
    let fwd = ctx_prop(&! ctx, prop_implies(not_ab, disj))
    let rev = ctx_prop(&! ctx, prop_implies(disj, not_ab))
    let goal = ctx_prop(&! ctx, prop_and(fwd, rev))
    let p1 = tactic_or(&! ctx, fwd, 1, 2)
    let first_rev = tactic_or(&! ctx, rev, 1, 3)
    let p2 = tactic_then(&! ctx, rev, first_rev, 2)
    if p1 < 0 || verify(&ctx, p1).is_valid == false || ctx_get_proof(&ctx, p1).prop_id != fwd { return false }
    if p2 < 0 || verify(&ctx, p2).is_valid == false || ctx_get_proof(&ctx, p2).prop_id != rev { return false }
    let both = and_intro(&! ctx, p1, p2, goal)
    if both < 0 { return false }
    if verify(&ctx, both).is_valid == false { return false }
    return ctx_get_proof(&ctx, both).prop_id == goal
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var pass = 0

    if test_t1() { println("T1 PASS"); pass = pass + 1 } else { println("T1 FAIL") }
    if test_t2() { println("T2 PASS"); pass = pass + 1 } else { println("T2 FAIL") }
    if test_t3() { println("T3 PASS"); pass = pass + 1 } else { println("T3 FAIL") }
    if test_t4() { println("T4 PASS"); pass = pass + 1 } else { println("T4 FAIL") }
    if test_t5() { println("T5 PASS"); pass = pass + 1 } else { println("T5 FAIL") }
    if test_t6() { println("T6 PASS"); pass = pass + 1 } else { println("T6 FAIL") }
    if test_t7() { println("T7 PASS"); pass = pass + 1 } else { println("T7 FAIL") }

    if pass == 7 {
        println("ALL PASS")
        return 0
    } else {
        return 1
    }
}
