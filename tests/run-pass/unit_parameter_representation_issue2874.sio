//@ run-pass
//@ requires: madaros
//@ expect-stdout: UNIT_PARAMETER_PASS
unit pressure = kg / m / s / s
unit inverse_pressure = m * s * s / kg

fn exponent(beta: inverse_pressure, delta: pressure) -> f64 {
    (beta as f64) * (delta as f64)
}
fn plain_exponent(beta: f64, delta: f64) -> f64 { beta * delta }
fn pressure_echo(delta: pressure) -> pressure { delta }
fn near(actual: f64, expected: f64) -> bool {
    actual > expected - 0.000000000001 && actual < expected + 0.000000000001
}
fn main() -> i32 with IO {
    let beta: inverse_pressure = 0.00007
    let delta: pressure = 1000.0
    let local = (beta as f64) * (delta as f64)
    let called = exponent(beta, delta)
    let plain = plain_exponent(0.00007, 1000.0)
    let returned = pressure_echo(delta)
    if !near(local, 0.07) { print("UNIT_LOCAL_FAIL\n"); return 1 }
    if !near(plain, 0.07) { print("F64_CONTROL_FAIL\n"); return 2 }
    if !near(called, 0.07) { print("UNIT_PARAMETER_FAIL\n"); return 3 }
    if !near(returned as f64, 1000.0) { print("UNIT_RETURN_FAIL\n"); return 4 }
    if !near(exponent(0.0, delta), 0.0) { print("UNIT_ZERO_FAIL\n"); return 5 }
    if !near(exponent(0.0 - 0.00007, delta), 0.0 - 0.07) { print("UNIT_NEGATIVE_FAIL\n"); return 6 }
    print("UNIT_PARAMETER_PASS\n")
    return 0
}
