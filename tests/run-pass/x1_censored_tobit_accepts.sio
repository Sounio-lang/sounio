//@ run-pass
//@ expect-stdout: X1_CENSORED_PASS
// X1 positive control: an M3/Tobit-style consumer that accepts the
// Censored type itself (PKNCA's Tobit half-life is the external model:
// the likelihood uses the bound, never an invented measurement at 0).
// Expected: bound 0.25 is used in the Tobit branch and the score is 1.

fn tobit_accepts(c: Censored<f64>) -> f64 {
    // A censored likelihood branch needs the quantification limit, and
    // only that: there is no measured value to invent.
    let lloq = censored_bound(c)
    if lloq == 0.25 { 1.0 } else { 0.0 }
}

fn main() -> i64 with IO {
    var fails: i64 = 0
    let obs: Censored<f64> = censored(0.25)
    if tobit_accepts(obs) != 1.0 { fails = fails + 1 }
    if censored_bound(obs) != 0.25 { fails = fails + 1 }
    if fails == 0 {
        println("X1_CENSORED_PASS")
    } else {
        println("X1_CENSORED_FAIL")
    }
    return fails
}
