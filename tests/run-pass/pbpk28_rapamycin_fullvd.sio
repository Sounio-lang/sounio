//@ run-pass
//@ timeout: 300
//@ expect-stdout-contains: PBPK28_RAPAMYCIN_FULLVD_PASS
//
// pbpk28_params_rapamycin_fullvd(): the PBPK28 rapamycin set with the clinical
// distribution volume. The capped set (pbpk28_params_rapamycin) has V_ss =
// 48.67 L and an IV bolus half-life of about 3 h; the clinical values are an
// apparent V_ss of 12 ± 5 L/kg and a terminal half-life of 62 ± 16 h
// (Zimmerman & Kahan 1997, PMID 9156373).
//
// Checks, each with its expected value fixed before the run:
//   1. V_ss = V_b + Σ V_i (f_v + (1 − f_v) Kp_i) = 840 L within 0.01 L;
//   2. brain Kp is the capped set's (0.10), every other tissue Kp is the
//      capped value times the one factor;
//   3. terminal half-life of a 5 mg IV bolus, from two late samples of the
//      blood curve, inside 46..78 h (62 ± 16 h);
//   4. the capped set fails check 3 (control: about 3 h);
//   5. the tangent Jacobian and the finite-difference Jacobian of the
//      full-volume case agree column by column (1e-3 relative).

use math::pure::{ln}
use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::epistemic_pbpk28::*
use darwin_pbpk::sens_pbpk28::{EpTangent28, ep28_tangent_run}

fn fv_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn fv_vss(p: PBPKParams28) -> f64 with Mut, Div {
    var vss = p.v_ref[0]
    var i: i32 = 1
    while i < 14 {
        vss = vss + p.v_ref[i] * (p.vasc_frac[i] + (1.0 - p.vasc_frac[i]) * p.kp[i])
        i = i + 1
    }
    return vss
}

// Half-life between cone samples a and b of the blood curve.
fn fv_thalf(tg: EpTangent28, a: i32, b: i32) -> f64 with Mut, Div, Panic {
    let ca = tg.cone.c_blood[a]
    let cb = tg.cone.c_blood[b]
    if !(ca > 0.0) || !(cb > 0.0) || !(ca > cb) { return 0.0 }
    return 0.6931471805599453 * (tg.cone.t[b] - tg.cone.t[a]) / ln(ca / cb)
}

fn fv_col(a: f64, b: f64, floor: f64) -> f64 with Mut, Div {
    let d = fv_abs(a - b)
    var s = fv_abs(b)
    if s < floor { s = floor }
    return d / s
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    let cap = pbpk28_params_rapamycin()
    let full = pbpk28_params_rapamycin_fullvd()

    let vss = fv_vss(full)
    print("V_ss full (L): "); println(vss)
    if fv_abs(vss - 840.0) > 0.01 { println("  [FAIL] V_ss is not 840 L"); fails = fails + 1 }

    let f = pbpk28_rapamycin_fullvd_kp_factor()
    var i: i32 = 1
    var bad: i32 = 0
    while i < 14 {
        if i == 3 {
            if fv_abs(full.kp[i] - cap.kp[i]) > 1.0e-12 { bad = bad + 1 }
        } else {
            if fv_abs(full.kp[i] - cap.kp[i] * f) > 1.0e-9 { bad = bad + 1 }
        }
        i = i + 1
    }
    if bad != 0 { println("  [FAIL] Kp vector is not the capped vector times one factor"); fails = fails + 1 }

    let pr = ep28_rapamycin_fullvd_priors()
    let tg = ep28_tangent_run(full, pr, 5.0, 600.0)
    let th = fv_thalf(tg, 30, 60)
    print("terminal half-life, full (h): "); println(th)
    if !(th >= 46.0) || !(th <= 78.0) { println("  [FAIL] half-life outside 62 +/- 16 h"); fails = fails + 1 }

    let tc = ep28_tangent_run(cap, ep28_rapamycin_priors(), 5.0, 48.0)
    let thc = fv_thalf(tc, 5, 30)
    print("half-life, capped set (h): "); println(thc)
    if thc >= 46.0 { println("  [FAIL] control: the capped set passes the half-life check"); fails = fails + 1 }

    let fd = ep28_jacobian_columns(full, pr, 5.0, 600.0)
    if !fd.ok { println("  [FAIL] finite-difference run rejected"); fails = fails + 1 }
    var j: i32 = 0
    var worst = 0.0
    while j < 7 {
        if pr.kn[j].variance > 0.0 {
            let r = fv_col(tg.jac.d_auc_b[j], fd.d_auc_b[j], 1.0e-9)
            if r > worst { worst = r }
        }
        j = j + 1
    }
    print("max rel column diff x 1e6, AUC_blood: "); println(worst * 1.0e6)
    if worst > 1.0e-3 { println("  [FAIL] tangent and finite difference disagree"); fails = fails + 1 }

    if fails == 0 {
        println("PBPK28_RAPAMYCIN_FULLVD_PASS")
        return 0
    }
    println("PBPK28_RAPAMYCIN_FULLVD_FAIL")
    return 1
}
