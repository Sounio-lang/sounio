//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v20 smoke for Lorenz i128/i256 wide-precision ladder entry

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 23 { return 0 - 1 }
    if instance_fp != 725615043 { return 0 - 1 }
    if certificate_fp != 455456906 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 23 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn i128_enclosure_receipt_fingerprint() -> i64 with Mod {
    var fp: i64 = 181
    fp = portfolio_mix(fp, 128, 2029)
    fp = portfolio_mix(fp, 1000000, 2029)
    fp = portfolio_mix(fp, 5, 2029)
    fp = portfolio_mix(fp, 1236316, 2029)
    fp = portfolio_mix(fp, 2341979, 2029)
    fp = portfolio_mix(fp, 951078, 2029)
    fp = portfolio_mix(fp, 243366, 2029)
    fp = portfolio_mix(fp, 319640, 2029)
    fp = portfolio_mix(fp, 42448, 2029)
    fp = portfolio_mix(fp, 992950, 2029)
    fp = portfolio_mix(fp, 1479682, 2029)
    fp = portfolio_mix(fp, 2022339, 2029)
    fp = portfolio_mix(fp, 2661619, 2029)
    fp = portfolio_mix(fp, 908630, 2029)
    fp = portfolio_mix(fp, 993526, 2029)
    return fp
}

fn ladder_instance_fingerprint(ball_trajectory_manifest_fp: i64) -> i64 with Mod {
    if ball_trajectory_manifest_fp != 508132668 { return 0 - 1 }

    var fp: i64 = 173
    fp = portfolio_mix(fp, 128, 1999)
    fp = portfolio_mix(fp, 256, 1999)
    fp = portfolio_mix(fp, 5, 1999)
    fp = portfolio_mix(fp, 5, 1999)
    fp = portfolio_mix(fp, 1000000, 1999)
    fp = portfolio_mix(fp, 32, 1999)
    fp = portfolio_mix(fp, ball_trajectory_manifest_fp, 1999)
    return fp
}

fn ladder_certificate_fingerprint(instance_fp: i64, i128_enclosure_fp: i64,
                                  i256_trajectory5_entry_fp: i64,
                                  radius_budget_entry_fp: i64) -> i64 with Mod {
    if instance_fp != 725615043 { return 0 - 1 }
    if i128_enclosure_fp != 302145212 { return 0 - 1 }
    if i256_trajectory5_entry_fp != 626160047 { return 0 - 1 }
    if radius_budget_entry_fp != 295040814 { return 0 - 1 }

    var fp: i64 = 191
    fp = portfolio_mix(fp, instance_fp, 2039)
    fp = portfolio_mix(fp, i128_enclosure_fp, 2039)
    fp = portfolio_mix(fp, i256_trajectory5_entry_fp, 2039)
    fp = portfolio_mix(fp, radius_budget_entry_fp, 2039)
    fp = portfolio_mix(fp, 128, 2039)
    fp = portfolio_mix(fp, 256, 2039)
    fp = portfolio_mix(fp, 1, 2039)
    fp = portfolio_mix(fp, 1, 2039)
    return fp
}

fn portfolio_v20_manifest_fingerprint(ladder_entry_fp: i64) -> i64 with Mod {
    if ladder_entry_fp != 124720146 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 20, 1151)
    fp = portfolio_mix(fp, 24, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, 590228875, 1151)
    fp = portfolio_mix(fp, 46718256, 1151)
    fp = portfolio_mix(fp, 295040814, 1151)
    fp = portfolio_mix(fp, ladder_entry_fp, 1151)
    return fp
}

fn portfolio_v20_result_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 158082390 { return 0 - 1 }

    var fp: i64 = 131
    fp = portfolio_mix(fp, 20, 1871)
    fp = portfolio_mix(fp, 24, 1871)
    fp = portfolio_mix(fp, 8, 1871)
    fp = portfolio_mix(fp, 14, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn portfolio_v20_checker_family_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 158082390 { return 0 - 1 }

    var fp: i64 = 149
    fp = portfolio_mix(fp, 20, 1907)
    fp = portfolio_mix(fp, 24, 1907)
    fp = portfolio_mix(fp, 4, 1907)
    fp = portfolio_mix(fp, 3, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 1, 1907)
    fp = portfolio_mix(fp, 14, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn portfolio_v20_readiness_fingerprint(
    manifest_fp: i64,
    result_coverage_fp: i64,
    family_coverage_fp: i64,
    acceptance_receipt_fp: i64,
    audit_receipt_fp: i64) -> i64 with Mod {
    if manifest_fp != 158082390 { return 0 - 1 }
    if result_coverage_fp != 2761010 { return 0 - 1 }
    if family_coverage_fp != 251415300 { return 0 - 1 }
    if acceptance_receipt_fp != 128854088 { return 0 - 1 }
    if audit_receipt_fp != 610639541 { return 0 - 1 }

    var fp: i64 = 163
    fp = portfolio_mix(fp, 20, 1951)
    fp = portfolio_mix(fp, 31, 1951)
    fp = portfolio_mix(fp, manifest_fp, 1951)
    fp = portfolio_mix(fp, result_coverage_fp, 1951)
    fp = portfolio_mix(fp, family_coverage_fp, 1951)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1951)
    fp = portfolio_mix(fp, audit_receipt_fp, 1951)
    return fp
}

fn main() -> i64 with Mod {
    let i128_fp = i128_enclosure_receipt_fingerprint()
    if i128_fp != 302145212 { return 1 }

    let instance_fp = ladder_instance_fingerprint(508132668)
    if instance_fp != 725615043 { return 2 }

    let certificate_fp = ladder_certificate_fingerprint(
        instance_fp, i128_fp, 626160047, 295040814)
    if certificate_fp != 455456906 { return 3 }

    let entry_fp = portfolio_entry_fingerprint(23, instance_fp, certificate_fp, 1, 23)
    if entry_fp != 124720146 { return 4 }

    let manifest_fp = portfolio_v20_manifest_fingerprint(entry_fp)
    if manifest_fp != 158082390 { return 5 }

    let result_coverage_fp = portfolio_v20_result_coverage_fingerprint(manifest_fp)
    if result_coverage_fp != 2761010 { return 6 }

    let family_coverage_fp = portfolio_v20_checker_family_coverage_fingerprint(manifest_fp)
    if family_coverage_fp != 251415300 { return 7 }

    if portfolio_v20_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        128854088, 610639541) != 511521805 { return 8 }

    if ladder_instance_fingerprint(508132669) != (0 - 1) { return 9 }
    if ladder_certificate_fingerprint(
        instance_fp, i128_fp + 1, 626160047, 295040814) != (0 - 1) { return 10 }
    if portfolio_entry_fingerprint(23, instance_fp, certificate_fp, 0, 23) != (0 - 1) { return 11 }
    if portfolio_v20_manifest_fingerprint(entry_fp + 1) != (0 - 1) { return 12 }
    if portfolio_v20_result_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 13 }
    if portfolio_v20_checker_family_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 14 }
    if portfolio_v20_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        128854088, 610639542) != (0 - 1) { return 15 }

    return 0
}
