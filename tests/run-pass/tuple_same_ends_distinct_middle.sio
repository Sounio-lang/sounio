//@ run-pass
//@ description: #2798 — tuple types with equal arity and equal first/last elements but a different middle element keep their own element types (destructure, .0, .1) on lean_single.
//@ expect-stdout: PASS

fn a3(x: f64) -> (f64, f64, i64) { (x, x, 1) }
fn b3(x: f64) -> (f64, i64, i64) { (x, 7, 1) }
fn c3(v: i64) -> (i64, i64, i64) { (v, v + 1, v + 2) }
fn d3(v: i64) -> (i64, f64, i64) { (v, 2.5, v + 2) }
fn id(v: i64) -> i64 { v }
fn idf(v: f64) -> f64 { v }

fn main() -> i32 with IO, Mut, Panic {
    let (p, q, r) = b3(0.5)
    if id(q) != 7 || r != 1 || p != 0.5 {
        println("FAIL b3 destructure")
        return 1
    }
    let t = b3(0.5)
    if t.1 + 0 != 7 {
        println("FAIL b3 .1")
        return 1
    }
    let (u0, u1, u2) = a3(0.25)
    if idf(u1) != 0.25 || u2 != 1 || u0 != 0.25 {
        println("FAIL a3 destructure")
        return 1
    }
    let c = c3(10)
    if c.1 != 11 {
        println("FAIL c3")
        return 1
    }
    let (d0, d1, d2) = d3(10)
    if d0 != 10 || idf(d1) != 2.5 || d2 != 12 {
        println("FAIL d3 destructure")
        return 1
    }
    let d = d3(20)
    if idf(d.1) != 2.5 || d.0 != 20 {
        println("FAIL d3 .0/.1")
        return 1
    }
    println("PASS")
    return 0
}
