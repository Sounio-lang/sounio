//@ run-pass
// Madaros Root 2: multi-module associated function Type::method import.
// Uses stdlib Epistemic (free-API coexists; method wrappers present).

use epistemic::knowledge::{Epistemic, ep_confidence, ep_val, ep_variance}

fn main() -> i32 with IO, Mut, Div, Panic {
    let e = Epistemic::measured(10.0, 0.5)
    let c = Epistemic::certain(1.0)
    if ep_val(&e) != 10.0 { return 10 }
    if ep_variance(&e) != 0.25 { return 11 }
    if ep_confidence(&e) != 900 { return 12 }
    if ep_val(&c) != 1.0 { return 13 }
    if ep_variance(&c) != 0.0 { return 14 }
    if ep_confidence(&c) != 1000 { return 15 }
    print("ROOT2_ASSOCIATED_IMPORT_OK\n")
    return 0
}
