    let c = Epistemic::certain(1.0)
    if ep_val(&e) != 10.0 { return 10 }
    if ep_val(&c) != 1.0 { return 11 }
    // Associated construction only — instance methods still multi-module residual.
    print("ROOT2_ASSOCIATED_IMPORT_OK\n")
