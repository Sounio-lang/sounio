//@ run-pass
//@ expect-stdout-contains: SHARED_ARRAY_CONTROL_PASS

// Positive control for E232: the refusal must NOT fire on the correct form.
//
// A gate that refuses everything measures nothing. One literal per field is
// what the code always meant, and it must stay legal and stay distinct -- the
// assertion below is that u and v really are two arrays.

struct Pair {
    u: [i64; 4],
    v: [i64; 4],
}

fn write_both(p: &Pair) with Mut {
    p.u[1] = 11
    p.v[1] = 22
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var p: Pair = Pair { u: [0; 4], v: [0; 4] }
    write_both(&p)
    print("u1="); print_int(p.u[1]); print("\n")
    print("v1="); print_int(p.v[1]); print("\n")
    if p.u[1] == 11 && p.v[1] == 22 {
        print("SHARED_ARRAY_CONTROL_PASS\n")
        return 0
    }
    print("SHARED_ARRAY_CONTROL_FAIL\n")
    1
}
