//@ run-pass
//@ expect-stdout-contains: join: PASS
//@ expect-stdout-contains: join_computed: PASS
//@ native-pass
// join(h1, h2) — wait for two concurrent tasks, returns (r1, r2)

fn main() with IO, Async {
    let h1 = spawn { 10 }
    let h2 = spawn { 20 }
    let (r1, r2) = join(h1, h2)
    if r1 == 10 && r2 == 20 {
        print("join: PASS\n")
    } else {
        print("join: FAIL\n")
    }

    // Join with computed results
    let ha = spawn { 3 * 7 }
    let hb = spawn { 100 - 58 }
    let (ra, rb) = join(ha, hb)
    if ra == 21 && rb == 42 {
        print("join_computed: PASS\n")
    } else {
        print("join_computed: FAIL\n")
    }
}
