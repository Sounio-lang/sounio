//@ run-pass
// Negative control: lowercase `input` remains an identifier.
//
// A run-pass witness must exit 0, and `main`'s value is its exit status.
// Returning the bound value made this control exit 7 and fail the suite for
// the one reason it was not measuring. The binding and the read are still
// what is observed; only the returned value changed.

fn main() -> i64 {
    let input = 7
    input - 7
}
