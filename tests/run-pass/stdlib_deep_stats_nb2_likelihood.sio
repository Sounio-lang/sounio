//@ run-pass
//@ requires: madaros
//@ expect-stdout: DEEP NB2 LIKELIHOOD PASS
use stats::regression::nb2_likelihood::{nb2_log_probability,nb2_saturated_log_probability}
use math::pure::{is_finite}
use io::sci_print::{println_f64_sci}
fn main()->i32 with IO,Mut,Div,Panic {
 let counts:[i64;6]=[0,1,7,8,1000000,9007199254740992]
 // alpha0; r approximately1e-308,1,8,1e6,1e300,0.5.
 let alphas:[f64;9]=[0.0,1e308,1.0,0.125,1e-6,1e-300,2.0,0.12500000000000003,0.12499999999999999]
 var case_id:i64=0
 var c:i64=0
 while c<6 {
  var a:i64=0
  while a<9 {
   var mode:i64=0
   while mode<4 {
    let count=counts[c as usize]
    let alpha=alphas[a as usize]
    var mean:f64=1.0
    if mode==0 {if count>0 {mean=count as f64}}
    if mode==1 {
     if count>0 {mean=(count as f64)*(1.0+2.2204460492503131e-16)}
     else {mean=1e-308}
    }
    if mode==2 {mean=1e308}
    if mode==3 {mean=1e-308}
    let value=nb2_log_probability(count,mean,alpha)
    print("likelihood case: ");println(case_id)
    print("likelihood status: ");println(value.status)
    print("normalizer status: ");println(value.normalizer_status)
    assert(value.status==0 && value.normalizer_status==0 && value.residual_status==0)
    assert(is_finite(value.log_probability) && value.log_probability<=0.0)
    assert(is_finite(value.saturated_log_probability) && value.saturated_log_probability<=0.0)
    assert(!value.assumptions_assessed)
    assert(value.poisson_limit==(alpha==0.0))
    if mode==0 {
     if count>0 {assert(value.log_probability==value.saturated_log_probability)}
    }
    if count==0 {
     assert(value.saturated_log_probability==0.0)
     if alpha==0.0 {
      if mode==2 {assert(value.deviance_status==1 && value.deviance==0.0)}
     }
    }
    print("log probability: ");println_f64_sci(value.log_probability,15)
    print("saturated log probability: ");println_f64_sci(value.saturated_log_probability,15)
    print("deviance payload status: ");println(value.deviance_status)
    mode=mode+1
    case_id=case_id+1
   }
   a=a+1
  }
  c=c+1
 }
 // Direct regression for case58: independent Big400 full log PMF, recorded
 // by deep_stats_nb2_likelihood_reference.cpp (no relaxed tolerance).
 // Forming log1p(alpha*delta1) near -1 previously lost the small complement.
 let negative_edge=nb2_log_probability(1,1e308,1e-300)
 assert(negative_edge.status==0)
 let negative_edge_expected:f64= -1.8420680753952365e301
 let negative_edge_relative=negative_edge.log_probability/negative_edge_expected-1.0
 assert(negative_edge_relative>= -1e-11 && negative_edge_relative<=1e-11)
 let large_r=nb2_saturated_log_probability(1,1e-300)
 assert(large_r.status==0 && large_r.stirling_used && !large_r.remainder_estimate_available)
 let ordinary=nb2_saturated_log_probability(8,0.125)
 assert(ordinary.status==0 && ordinary.stirling_used && ordinary.remainder_estimate_available)
 assert(ordinary.remainder_estimate>0.0)
 // The reciprocal of a nonzero alpha may be unrepresentable. Do not silently
 // replace this positive-count model by the alpha0 likelihood.
 let quantum=2.2250738585072014e-308/4503599627370496.0
 let tiny_alpha=nb2_log_probability(1,1.0,quantum)
 assert(tiny_alpha.status==5 && tiny_alpha.normalizer_status==5)
 assert(tiny_alpha.residual_status==0 && tiny_alpha.deviance_status==0)
 let zero_tiny_alpha=nb2_log_probability(0,1.0,quantum)
 assert(zero_tiny_alpha.status==0 && zero_tiny_alpha.saturated_log_probability==0.0)
 assert(nb2_log_probability(-1,1.0,0.0).status==1)
 assert(nb2_log_probability(0,0.0,0.0).status==2)
 assert(nb2_log_probability(0,1.0,-1.0).status==3)
 assert(nb2_log_probability(9007199254740993,1.0,0.0).status==4)
 println("DEEP NB2 LIKELIHOOD PASS")
 0
}
