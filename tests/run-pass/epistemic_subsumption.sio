//@ run-pass
//@ ignore BLOCKED: pinned binary does not support Knowledge<T, epsilon < V> syntax
//@ expect-stdout: epistemic subsumption: PASS

// Knowledge<f64, eps=0.01> IS assignable to Knowledge<f64, eps=0.1>
// because 0.01 <= 0.1 (tighter bound satisfies looser requirement)

fn needs_loose(k: Knowledge<f64, epsilon < 0.1>) -> f64 {
    k.value
}

fn main() -> i32 with IO, Epistemic {
    let precise: Knowledge<f64, epsilon < 0.01> = measure(500.0, uncertainty: 5.0)
    let result = needs_loose(precise)
    print("epistemic subsumption: PASS\n")
    return 0
}
