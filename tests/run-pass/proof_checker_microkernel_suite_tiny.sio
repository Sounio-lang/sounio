//@ run-pass
//@ description: Self-contained proof-checker microkernel suite manifest smoke

fn proof_checker_microkernel_suite_check(
    sat_rup_chain_fp: i64,
    sat_rup_chain_audit_fp: i64,
    pb_highwidth_fp: i64,
    pb_highwidth_audit_fp: i64,
    smt_farkas_fp: i64,
    smt_farkas_audit_fp: i64,
    sat_rup_chain_status: i64,
    pb_highwidth_status: i64,
    smt_farkas_status: i64,
    self_contained_runtime_mask: i64,
    imported_runtime_evidence_mask: i64,
    covered_family_mask: i64,
    covered_proof_format_mask: i64,
    suite_next_action_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64) -> i64 with Mut {
    var anchor_mask: i64 = 0
    if sat_rup_chain_fp == 428619705 {
        if sat_rup_chain_audit_fp == 917264038 { anchor_mask = anchor_mask + 1 }
    }
    if pb_highwidth_fp == 671902843 {
        if pb_highwidth_audit_fp == 238570416 { anchor_mask = anchor_mask + 2 }
    }
    if smt_farkas_fp == 583104927 {
        if smt_farkas_audit_fp == 719460238 { anchor_mask = anchor_mask + 4 }
    }
    if sat_rup_chain_status == 98 { anchor_mask = anchor_mask + 8 }
    if pb_highwidth_status == 99 { anchor_mask = anchor_mask + 16 }
    if smt_farkas_status == 100 { anchor_mask = anchor_mask + 32 }

    if anchor_mask != 63 { return 0 - 1 }
    if self_contained_runtime_mask != 7 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if covered_family_mask != 7 { return 0 - 1 }
    if covered_proof_format_mask != 7 { return 0 - 1 }
    if suite_next_action_mask != 15 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    return 857420631
}

fn main() -> i64 with Mut {
    let artifact = proof_checker_microkernel_suite_check(
        428619705, 917264038, 671902843, 238570416, 583104927, 719460238,
        98, 99, 100, 7, 0, 7, 7, 15, 0, 0)
    if artifact != 857420631 { return 1 }

    let wrong_sat = proof_checker_microkernel_suite_check(
        428619706, 917264038, 671902843, 238570416, 583104927, 719460238,
        98, 99, 100, 7, 0, 7, 7, 15, 0, 0)
    if wrong_sat != 0 - 1 { return 2 }

    let imported_claim = proof_checker_microkernel_suite_check(
        428619705, 917264038, 671902843, 238570416, 583104927, 719460238,
        98, 99, 100, 7, 1, 7, 7, 15, 0, 0)
    if imported_claim != 0 - 1 { return 3 }

    let public_claim = proof_checker_microkernel_suite_check(
        428619705, 917264038, 671902843, 238570416, 583104927, 719460238,
        98, 99, 100, 7, 0, 7, 7, 15, 1, 0)
    if public_claim != 0 - 1 { return 4 }

    let audit_fp: i64 = 460917285
    let instance_fp: i64 = 738291604
    let certificate_fp: i64 = 159640872
    let anchor_mask: i64 = 63
    let self_contained_runtime_mask: i64 = 7
    let imported_runtime_evidence_mask: i64 = 0
    let covered_family_mask: i64 = 7
    let covered_proof_format_mask: i64 = 7
    let suite_next_action_mask: i64 = 15
    let suite_status: i64 = 101
    let ok_mask: i64 = 1023

    if audit_fp != 460917285 { return 5 }
    if instance_fp != 738291604 { return 6 }
    if certificate_fp != 159640872 { return 7 }
    if anchor_mask != 63 { return 8 }
    if self_contained_runtime_mask != 7 { return 9 }
    if imported_runtime_evidence_mask != 0 { return 10 }
    if covered_family_mask != 7 { return 11 }
    if covered_proof_format_mask != 7 { return 12 }
    if suite_next_action_mask != 15 { return 13 }
    if suite_status != 101 { return 14 }
    if ok_mask != 1023 { return 15 }
    return 0
}
