//@ run-pass
//@ requires: lean_single
//@ expect-stdout: TRANSCENDENTAL_VARIANCE_CHAIN_OK
// #3551: derivative-squared variance at two points, for calls and methods.
// Literal oracles are analytic first-order values, not pass-through variance.

fn near(a: f64, b: f64) -> bool {
    let d = a - b
    return d > -1.0e-7 && d < 1.0e-7
}

fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    let ka: Knowledge<f64> = measure(0.5, uncertainty: 0.1)
    let kb: Knowledge<f64> = measure(0.25, uncertainty: 0.2)
    let a = ka.value
    let b = kb.value

    assert(near(variance_of(sin(a)), 0.007701511529341))
    assert(near(variance_of(cos(a)), 0.002298488470659))
    assert(near(variance_of(tan(a)), 0.016859630807054))
    assert(near(variance_of(atan(a)), 0.0064))
    assert(near(variance_of(tanh(a)), 0.006185000366872))
    assert(near(variance_of(asin(a)), 0.013333333333333))
    assert(near(variance_of(acos(a)), 0.013333333333333))
    assert(near(variance_of(exp(a)), 0.027182818284590))
    assert(near(variance_of(log(a)), 0.04))
    assert(near(variance_of(ln(a)), 0.04))
    assert(near(variance_of(sqrt(a)), 0.005))
    assert(near(variance_of(sin(b)), 0.037551651237807))
    assert(near(variance_of(cos(b)), 0.002448348762193))
    assert(near(variance_of(tan(b)), 0.045385998713597))
    assert(near(variance_of(atan(b)), 0.035432525951557))
    assert(near(variance_of(tanh(b)), 0.035345116639059))
    assert(near(variance_of(asin(b)), 0.042666666666667))
    assert(near(variance_of(acos(b)), 0.042666666666667))
    assert(near(variance_of(exp(b)), 0.065948850828005))
    assert(near(variance_of(log(b)), 0.64))
    assert(near(variance_of(ln(b)), 0.64))
    assert(near(variance_of(sqrt(b)), 0.04))

    assert(near(variance_of(a.sin()), 0.007701511529341))
    assert(near(variance_of(a.cos()), 0.002298488470659))
    assert(near(variance_of(a.tan()), 0.016859630807054))
    assert(near(variance_of(a.atan()), 0.0064))
    assert(near(variance_of(a.tanh()), 0.006185000366872))
    assert(near(variance_of(a.asin()), 0.013333333333333))
    assert(near(variance_of(a.acos()), 0.013333333333333))
    assert(near(variance_of(a.exp()), 0.027182818284590))
    assert(near(variance_of(a.log()), 0.04))
    assert(near(variance_of(a.ln()), 0.04))
    assert(near(variance_of(a.sqrt()), 0.005))
    assert(near(variance_of(b.sin()), 0.037551651237807))
    assert(near(variance_of(b.cos()), 0.002448348762193))
    assert(near(variance_of(b.tan()), 0.045385998713597))
    assert(near(variance_of(b.atan()), 0.035432525951557))
    assert(near(variance_of(b.tanh()), 0.035345116639059))
    assert(near(variance_of(b.asin()), 0.042666666666667))
    assert(near(variance_of(b.acos()), 0.042666666666667))
    assert(near(variance_of(b.exp()), 0.065948850828005))
    assert(near(variance_of(b.log()), 0.64))
    assert(near(variance_of(b.ln()), 0.64))
    assert(near(variance_of(b.sqrt()), 0.04))

    // Composition must consume the transformed variance and retain sensitivities.
    assert(near(variance_of(log(exp(a))), 0.01))
    assert(near(variance_of(a.exp().log()), 0.01))
    assert(near(variance_of(sin(a + b)), 0.026768430041693))
    let s = sin(a)
    assert(near(variance_of(s - s), 0.0))
    assert(near(variance_of(sin(0.5)), 0.0))
    assert(near(variance_of(a), 0.01))
    print("TRANSCENDENTAL_VARIANCE_CHAIN_OK\n")
    return 0
}
