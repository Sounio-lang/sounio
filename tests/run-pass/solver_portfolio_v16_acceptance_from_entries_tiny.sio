//@ run-pass
//@ requires: madaros
//@ description: Self-contained solver portfolio v16 acceptance-from-entries smoke

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_manifest_v16_fingerprint(version: i64, entry_count: i64,
                                      lrat_entry_fp: i64, smt_entry_fp: i64,
                                      qflra_entry_fp: i64, pb_entry_fp: i64,
                                      lorenz_entry_fp: i64,
                                      lorenz_i256_entry_fp: i64,
                                      lorenz_i256_range_entry_fp: i64,
                                      sat_resolution_entry_fp: i64,
                                      sat_bridge_entry_fp: i64,
                                      pb_opt_entry_fp: i64,
                                      lorenz_i256_div_entry_fp: i64,
                                      lorenz_i256_chain_entry_fp: i64,
                                      lorenz_i256_chain3_entry_fp: i64,
                                      lorenz_i256_trajectory_entry_fp: i64,
                                      sat_model_entry_fp: i64,
                                      lorenz_i256_chain4_entry_fp: i64,
                                      lorenz_i256_step_contract_entry_fp: i64,
                                      graph_colouring_unsat_entry_fp: i64,
                                      lorenz_i256_chain5_entry_fp: i64,
                                      lorenz_i256_trajectory5_entry_fp: i64) -> i64 with Mod {
    if version != 16 { return 0 - 1 }
    if entry_count != 20 { return 0 - 1 }
    if lrat_entry_fp <= 0 { return 0 - 1 }
    if smt_entry_fp <= 0 { return 0 - 1 }
    if qflra_entry_fp <= 0 { return 0 - 1 }
    if pb_entry_fp <= 0 { return 0 - 1 }
    if lorenz_entry_fp <= 0 { return 0 - 1 }
    if lorenz_i256_entry_fp <= 0 { return 0 - 1 }
    if lorenz_i256_range_entry_fp <= 0 { return 0 - 1 }
    if sat_resolution_entry_fp <= 0 { return 0 - 1 }
    if sat_bridge_entry_fp <= 0 { return 0 - 1 }
    if pb_opt_entry_fp <= 0 { return 0 - 1 }
    if lorenz_i256_div_entry_fp <= 0 { return 0 - 1 }
    if lorenz_i256_chain_entry_fp <= 0 { return 0 - 1 }
    if lorenz_i256_chain3_entry_fp <= 0 { return 0 - 1 }
    if lorenz_i256_trajectory_entry_fp <= 0 { return 0 - 1 }
    if sat_model_entry_fp <= 0 { return 0 - 1 }
    if lorenz_i256_chain4_entry_fp <= 0 { return 0 - 1 }
    if lorenz_i256_step_contract_entry_fp <= 0 { return 0 - 1 }
    if graph_colouring_unsat_entry_fp <= 0 { return 0 - 1 }
    if lorenz_i256_chain5_entry_fp <= 0 { return 0 - 1 }
    if lorenz_i256_trajectory5_entry_fp <= 0 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, version, 1151)
    fp = portfolio_mix(fp, entry_count, 1151)
    fp = portfolio_mix(fp, lrat_entry_fp, 1151)
    fp = portfolio_mix(fp, smt_entry_fp, 1151)
    fp = portfolio_mix(fp, qflra_entry_fp, 1151)
    fp = portfolio_mix(fp, pb_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_i256_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_i256_range_entry_fp, 1151)
    fp = portfolio_mix(fp, sat_resolution_entry_fp, 1151)
    fp = portfolio_mix(fp, sat_bridge_entry_fp, 1151)
    fp = portfolio_mix(fp, pb_opt_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_i256_div_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_i256_chain_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_i256_chain3_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_i256_trajectory_entry_fp, 1151)
    fp = portfolio_mix(fp, sat_model_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_i256_chain4_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_i256_step_contract_entry_fp, 1151)
    fp = portfolio_mix(fp, graph_colouring_unsat_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_i256_chain5_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_i256_trajectory5_entry_fp, 1151)
    return fp
}

fn known_manifest_v16_valid(lrat_entry_fp: i64, smt_entry_fp: i64,
                            qflra_entry_fp: i64, pb_entry_fp: i64,
                            lorenz_entry_fp: i64,
                            lorenz_i256_entry_fp: i64,
                            lorenz_i256_range_entry_fp: i64,
                            sat_resolution_entry_fp: i64,
                            sat_bridge_entry_fp: i64,
                            pb_opt_entry_fp: i64,
                            lorenz_i256_div_entry_fp: i64,
                            lorenz_i256_chain_entry_fp: i64,
                            lorenz_i256_chain3_entry_fp: i64,
                            lorenz_i256_trajectory_entry_fp: i64,
                            sat_model_entry_fp: i64,
                            lorenz_i256_chain4_entry_fp: i64,
                            lorenz_i256_step_contract_entry_fp: i64,
                            graph_colouring_unsat_entry_fp: i64,
                            lorenz_i256_chain5_entry_fp: i64,
                            lorenz_i256_trajectory5_entry_fp: i64,
                            manifest_fp: i64) -> i64 {
    if lrat_entry_fp != 53646245 { return 0 }
    if smt_entry_fp != 528026990 { return 0 }
    if qflra_entry_fp != 301444501 { return 0 }
    if pb_entry_fp != 258927862 { return 0 }
    if lorenz_entry_fp != 388915166 { return 0 }
    if lorenz_i256_entry_fp != 900589789 { return 0 }
    if lorenz_i256_range_entry_fp != 205040674 { return 0 }
    if sat_resolution_entry_fp != 580031260 { return 0 }
    if sat_bridge_entry_fp != 973127057 { return 0 }
    if pb_opt_entry_fp != 438043475 { return 0 }
    if lorenz_i256_div_entry_fp != 887056435 { return 0 }
    if lorenz_i256_chain_entry_fp != 769531137 { return 0 }
    if lorenz_i256_chain3_entry_fp != 579271506 { return 0 }
    if lorenz_i256_trajectory_entry_fp != 252932879 { return 0 }
    if sat_model_entry_fp != 838301653 { return 0 }
    if lorenz_i256_chain4_entry_fp != 755389732 { return 0 }
    if lorenz_i256_step_contract_entry_fp != 521104746 { return 0 }
    if graph_colouring_unsat_entry_fp != 537394311 { return 0 }
    if lorenz_i256_chain5_entry_fp != 827916944 { return 0 }
    if lorenz_i256_trajectory5_entry_fp != 626160047 { return 0 }
    if manifest_fp != 320118125 { return 0 }
    return 1
}

fn portfolio_v16_result_coverage_fingerprint(version: i64,
                                             entry_count: i64,
                                             unsat_count: i64,
                                             validated_count: i64,
                                             optimal_count: i64,
                                             sat_count: i64,
                                             manifest_fp: i64) -> i64 with Mod {
    if version != 16 { return 0 - 1 }
    if entry_count != 20 { return 0 - 1 }
    if unsat_count != 7 { return 0 - 1 }
    if validated_count != 11 { return 0 - 1 }
    if optimal_count != 1 { return 0 - 1 }
    if sat_count != 1 { return 0 - 1 }
    if manifest_fp != 320118125 { return 0 - 1 }

    var fp: i64 = 131
    fp = portfolio_mix(fp, version, 1871)
    fp = portfolio_mix(fp, entry_count, 1871)
    fp = portfolio_mix(fp, unsat_count, 1871)
    fp = portfolio_mix(fp, validated_count, 1871)
    fp = portfolio_mix(fp, optimal_count, 1871)
    fp = portfolio_mix(fp, sat_count, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn portfolio_v16_acceptance_receipt_fingerprint(version: i64,
                                                manifest_fp: i64,
                                                coverage_fp: i64) -> i64 with Mod {
    if version != 16 { return 0 - 1 }
    if manifest_fp != 320118125 { return 0 - 1 }
    if coverage_fp != 685105937 { return 0 - 1 }

    var fp: i64 = 137
    fp = portfolio_mix(fp, version, 1889)
    fp = portfolio_mix(fp, manifest_fp, 1889)
    fp = portfolio_mix(fp, coverage_fp, 1889)
    return fp
}

fn portfolio_v16_checker_family_coverage_fingerprint(
    version: i64,
    entry_count: i64,
    sat_family_count: i64,
    smt_family_count: i64,
    pb_family_count: i64,
    graph_family_count: i64,
    lorenz_family_count: i64,
    manifest_fp: i64) -> i64 with Mod {
    if version != 16 { return 0 - 1 }
    if entry_count != 20 { return 0 - 1 }
    if sat_family_count != 4 { return 0 - 1 }
    if smt_family_count != 2 { return 0 - 1 }
    if pb_family_count != 2 { return 0 - 1 }
    if graph_family_count != 1 { return 0 - 1 }
    if lorenz_family_count != 11 { return 0 - 1 }
    if manifest_fp != 320118125 { return 0 - 1 }

    var fp: i64 = 149
    fp = portfolio_mix(fp, version, 1907)
    fp = portfolio_mix(fp, entry_count, 1907)
    fp = portfolio_mix(fp, sat_family_count, 1907)
    fp = portfolio_mix(fp, smt_family_count, 1907)
    fp = portfolio_mix(fp, pb_family_count, 1907)
    fp = portfolio_mix(fp, graph_family_count, 1907)
    fp = portfolio_mix(fp, lorenz_family_count, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn portfolio_v16_audit_receipt_fingerprint(version: i64,
                                           manifest_fp: i64,
                                           result_coverage_fp: i64,
                                           family_coverage_fp: i64,
                                           acceptance_receipt_fp: i64) -> i64 with Mod {
    if version != 16 { return 0 - 1 }
    if manifest_fp != 320118125 { return 0 - 1 }
    if result_coverage_fp != 685105937 { return 0 - 1 }
    if family_coverage_fp != 210011781 { return 0 - 1 }
    if acceptance_receipt_fp != 629028996 { return 0 - 1 }

    var fp: i64 = 157
    fp = portfolio_mix(fp, version, 1931)
    fp = portfolio_mix(fp, manifest_fp, 1931)
    fp = portfolio_mix(fp, result_coverage_fp, 1931)
    fp = portfolio_mix(fp, family_coverage_fp, 1931)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1931)
    return fp
}

fn portfolio_v16_acceptance_from_entries_fingerprint(
    version: i64,
    entry_count: i64,
    lrat_entry_fp: i64,
    smt_entry_fp: i64,
    qflra_entry_fp: i64,
    pb_entry_fp: i64,
    lorenz_entry_fp: i64,
    lorenz_i256_entry_fp: i64,
    lorenz_i256_range_entry_fp: i64,
    sat_resolution_entry_fp: i64,
    sat_bridge_entry_fp: i64,
    pb_opt_entry_fp: i64,
    lorenz_i256_div_entry_fp: i64,
    lorenz_i256_chain_entry_fp: i64,
    lorenz_i256_chain3_entry_fp: i64,
    lorenz_i256_trajectory_entry_fp: i64,
    sat_model_entry_fp: i64,
    lorenz_i256_chain4_entry_fp: i64,
    lorenz_i256_step_contract_entry_fp: i64,
    graph_colouring_unsat_entry_fp: i64,
    lorenz_i256_chain5_entry_fp: i64,
    lorenz_i256_trajectory5_entry_fp: i64,
    unsat_count: i64,
    validated_count: i64,
    optimal_count: i64,
    sat_count: i64) -> i64 with Mod {
    let manifest_fp = portfolio_manifest_v16_fingerprint(
        version, entry_count,
        lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp,
        lorenz_entry_fp, lorenz_i256_entry_fp, lorenz_i256_range_entry_fp,
        sat_resolution_entry_fp, sat_bridge_entry_fp, pb_opt_entry_fp,
        lorenz_i256_div_entry_fp, lorenz_i256_chain_entry_fp,
        lorenz_i256_chain3_entry_fp, lorenz_i256_trajectory_entry_fp,
        sat_model_entry_fp, lorenz_i256_chain4_entry_fp,
        lorenz_i256_step_contract_entry_fp, graph_colouring_unsat_entry_fp,
        lorenz_i256_chain5_entry_fp, lorenz_i256_trajectory5_entry_fp)
    if known_manifest_v16_valid(
        lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp,
        lorenz_entry_fp, lorenz_i256_entry_fp, lorenz_i256_range_entry_fp,
        sat_resolution_entry_fp, sat_bridge_entry_fp, pb_opt_entry_fp,
        lorenz_i256_div_entry_fp, lorenz_i256_chain_entry_fp,
        lorenz_i256_chain3_entry_fp, lorenz_i256_trajectory_entry_fp,
        sat_model_entry_fp, lorenz_i256_chain4_entry_fp,
        lorenz_i256_step_contract_entry_fp, graph_colouring_unsat_entry_fp,
        lorenz_i256_chain5_entry_fp, lorenz_i256_trajectory5_entry_fp,
        manifest_fp) == 0 { return 0 - 1 }

    let coverage_fp = portfolio_v16_result_coverage_fingerprint(
        version, entry_count, unsat_count, validated_count, optimal_count,
        sat_count, manifest_fp)
    if coverage_fp != 685105937 { return 0 - 1 }
    return portfolio_v16_acceptance_receipt_fingerprint(
        version, manifest_fp, coverage_fp)
}

fn portfolio_v16_audit_from_entries_fingerprint(
    version: i64,
    entry_count: i64,
    lrat_entry_fp: i64,
    smt_entry_fp: i64,
    qflra_entry_fp: i64,
    pb_entry_fp: i64,
    lorenz_entry_fp: i64,
    lorenz_i256_entry_fp: i64,
    lorenz_i256_range_entry_fp: i64,
    sat_resolution_entry_fp: i64,
    sat_bridge_entry_fp: i64,
    pb_opt_entry_fp: i64,
    lorenz_i256_div_entry_fp: i64,
    lorenz_i256_chain_entry_fp: i64,
    lorenz_i256_chain3_entry_fp: i64,
    lorenz_i256_trajectory_entry_fp: i64,
    sat_model_entry_fp: i64,
    lorenz_i256_chain4_entry_fp: i64,
    lorenz_i256_step_contract_entry_fp: i64,
    graph_colouring_unsat_entry_fp: i64,
    lorenz_i256_chain5_entry_fp: i64,
    lorenz_i256_trajectory5_entry_fp: i64,
    unsat_count: i64,
    validated_count: i64,
    optimal_count: i64,
    sat_count: i64,
    sat_family_count: i64,
    smt_family_count: i64,
    pb_family_count: i64,
    graph_family_count: i64,
    lorenz_family_count: i64) -> i64 with Mod {
    let manifest_fp = portfolio_manifest_v16_fingerprint(
        version, entry_count,
        lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp,
        lorenz_entry_fp, lorenz_i256_entry_fp, lorenz_i256_range_entry_fp,
        sat_resolution_entry_fp, sat_bridge_entry_fp, pb_opt_entry_fp,
        lorenz_i256_div_entry_fp, lorenz_i256_chain_entry_fp,
        lorenz_i256_chain3_entry_fp, lorenz_i256_trajectory_entry_fp,
        sat_model_entry_fp, lorenz_i256_chain4_entry_fp,
        lorenz_i256_step_contract_entry_fp, graph_colouring_unsat_entry_fp,
        lorenz_i256_chain5_entry_fp, lorenz_i256_trajectory5_entry_fp)
    if known_manifest_v16_valid(
        lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp,
        lorenz_entry_fp, lorenz_i256_entry_fp, lorenz_i256_range_entry_fp,
        sat_resolution_entry_fp, sat_bridge_entry_fp, pb_opt_entry_fp,
        lorenz_i256_div_entry_fp, lorenz_i256_chain_entry_fp,
        lorenz_i256_chain3_entry_fp, lorenz_i256_trajectory_entry_fp,
        sat_model_entry_fp, lorenz_i256_chain4_entry_fp,
        lorenz_i256_step_contract_entry_fp, graph_colouring_unsat_entry_fp,
        lorenz_i256_chain5_entry_fp, lorenz_i256_trajectory5_entry_fp,
        manifest_fp) == 0 { return 0 - 1 }

    let result_coverage_fp = portfolio_v16_result_coverage_fingerprint(
        version, entry_count, unsat_count, validated_count, optimal_count,
        sat_count, manifest_fp)
    if result_coverage_fp != 685105937 { return 0 - 1 }

    let family_coverage_fp = portfolio_v16_checker_family_coverage_fingerprint(
        version, entry_count, sat_family_count, smt_family_count, pb_family_count,
        graph_family_count, lorenz_family_count, manifest_fp)
    if family_coverage_fp != 210011781 { return 0 - 1 }

    let acceptance_receipt_fp = portfolio_v16_acceptance_receipt_fingerprint(
        version, manifest_fp, result_coverage_fp)
    if acceptance_receipt_fp != 629028996 { return 0 - 1 }

    return portfolio_v16_audit_receipt_fingerprint(
        version, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_receipt_fp)
}

fn portfolio_v16_readiness_mask(version: i64,
                                manifest_fp: i64,
                                result_coverage_fp: i64,
                                family_coverage_fp: i64,
                                acceptance_receipt_fp: i64,
                                audit_receipt_fp: i64) -> i64 {
    if version != 16 { return 0 - 1 }
    var mask: i64 = 0
    if manifest_fp == 320118125 { mask = mask + 1 }
    if result_coverage_fp == 685105937 { mask = mask + 2 }
    if family_coverage_fp == 210011781 { mask = mask + 4 }
    if acceptance_receipt_fp == 629028996 { mask = mask + 8 }
    if audit_receipt_fp == 932551699 { mask = mask + 16 }
    return mask
}

fn portfolio_v16_readiness_fingerprint(version: i64,
                                       manifest_fp: i64,
                                       result_coverage_fp: i64,
                                       family_coverage_fp: i64,
                                       acceptance_receipt_fp: i64,
                                       audit_receipt_fp: i64) -> i64 with Mod {
    let readiness_mask = portfolio_v16_readiness_mask(
        version, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_receipt_fp, audit_receipt_fp)
    if readiness_mask != 31 { return 0 - 1 }

    var fp: i64 = 163
    fp = portfolio_mix(fp, version, 1951)
    fp = portfolio_mix(fp, readiness_mask, 1951)
    fp = portfolio_mix(fp, manifest_fp, 1951)
    fp = portfolio_mix(fp, result_coverage_fp, 1951)
    fp = portfolio_mix(fp, family_coverage_fp, 1951)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1951)
    fp = portfolio_mix(fp, audit_receipt_fp, 1951)
    return fp
}

fn portfolio_v16_readiness_from_entries_fingerprint(
    version: i64,
    entry_count: i64,
    lrat_entry_fp: i64,
    smt_entry_fp: i64,
    qflra_entry_fp: i64,
    pb_entry_fp: i64,
    lorenz_entry_fp: i64,
    lorenz_i256_entry_fp: i64,
    lorenz_i256_range_entry_fp: i64,
    sat_resolution_entry_fp: i64,
    sat_bridge_entry_fp: i64,
    pb_opt_entry_fp: i64,
    lorenz_i256_div_entry_fp: i64,
    lorenz_i256_chain_entry_fp: i64,
    lorenz_i256_chain3_entry_fp: i64,
    lorenz_i256_trajectory_entry_fp: i64,
    sat_model_entry_fp: i64,
    lorenz_i256_chain4_entry_fp: i64,
    lorenz_i256_step_contract_entry_fp: i64,
    graph_colouring_unsat_entry_fp: i64,
    lorenz_i256_chain5_entry_fp: i64,
    lorenz_i256_trajectory5_entry_fp: i64,
    unsat_count: i64,
    validated_count: i64,
    optimal_count: i64,
    sat_count: i64,
    sat_family_count: i64,
    smt_family_count: i64,
    pb_family_count: i64,
    graph_family_count: i64,
    lorenz_family_count: i64) -> i64 with Mod {
    let audit_receipt_fp = portfolio_v16_audit_from_entries_fingerprint(
        version, entry_count,
        lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp,
        lorenz_entry_fp, lorenz_i256_entry_fp, lorenz_i256_range_entry_fp,
        sat_resolution_entry_fp, sat_bridge_entry_fp, pb_opt_entry_fp,
        lorenz_i256_div_entry_fp, lorenz_i256_chain_entry_fp,
        lorenz_i256_chain3_entry_fp, lorenz_i256_trajectory_entry_fp,
        sat_model_entry_fp, lorenz_i256_chain4_entry_fp,
        lorenz_i256_step_contract_entry_fp, graph_colouring_unsat_entry_fp,
        lorenz_i256_chain5_entry_fp, lorenz_i256_trajectory5_entry_fp,
        unsat_count, validated_count, optimal_count, sat_count,
        sat_family_count, smt_family_count, pb_family_count,
        graph_family_count, lorenz_family_count)
    if audit_receipt_fp != 932551699 { return 0 - 1 }

    return portfolio_v16_readiness_fingerprint(
        version, 320118125, 685105937, 210011781, 629028996,
        audit_receipt_fp)
}

fn check_known_receipt() -> i64 with Mod {
    return portfolio_v16_acceptance_from_entries_fingerprint(
        16, 20,
        53646245, 528026990, 301444501, 258927862,
        388915166, 900589789, 205040674, 580031260,
        973127057, 438043475, 887056435, 769531137,
        579271506, 252932879, 838301653, 755389732,
        521104746, 537394311, 827916944, 626160047,
        7, 11, 1, 1)
}

fn check_known_audit() -> i64 with Mod {
    return portfolio_v16_audit_from_entries_fingerprint(
        16, 20,
        53646245, 528026990, 301444501, 258927862,
        388915166, 900589789, 205040674, 580031260,
        973127057, 438043475, 887056435, 769531137,
        579271506, 252932879, 838301653, 755389732,
        521104746, 537394311, 827916944, 626160047,
        7, 11, 1, 1, 4, 2, 2, 1, 11)
}

fn check_known_readiness() -> i64 with Mod {
    return portfolio_v16_readiness_from_entries_fingerprint(
        16, 20,
        53646245, 528026990, 301444501, 258927862,
        388915166, 900589789, 205040674, 580031260,
        973127057, 438043475, 887056435, 769531137,
        579271506, 252932879, 838301653, 755389732,
        521104746, 537394311, 827916944, 626160047,
        7, 11, 1, 1, 4, 2, 2, 1, 11)
}

fn main() -> i64 with Mod {
    if check_known_receipt() != 629028996 { return 1 }
    if check_known_audit() != 932551699 { return 6 }
    if check_known_readiness() != 589844740 { return 9 }

    if portfolio_v16_acceptance_from_entries_fingerprint(
        15, 20,
        53646245, 528026990, 301444501, 258927862,
        388915166, 900589789, 205040674, 580031260,
        973127057, 438043475, 887056435, 769531137,
        579271506, 252932879, 838301653, 755389732,
