//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-5 Taylor-2 remainder obligation smoke

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step5_taylor2_remainder_obligation_check(
        40000, 55000, 10000, 0)
    if artifact_fp != 69995750 { return 1 }
    let audit_fp = lorenz_i256_step5_taylor2_remainder_obligation_audit_fingerprint(
        artifact_fp, 77648112, 754547684, 422368008, 171451971,
        815806077, 5, 5, 127, 0, 0)
    if audit_fp != 380914208 { return 2 }
    return 0
}
