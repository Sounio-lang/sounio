//@ run-pass
//@ description: #2834/#1157 — spec §7.2.1 escape rule: mutating frame-local storage needs no `Mut` (both engines)
//@ expect-stdout: 3
//@ expect-stdout: 193377032
//@ expect-stdout: 25
//@ expect-stdout: 1

struct Acc { total: i64, buf: [i64; 4] }

// The issue's helper: a local `var` reassigned in a function with no effects.
fn bump(s: i64) -> i64 {
    var z = s
    z = z + 1
    z
}

// The ast.sio `ast_name_hash` shape from #1157: local loop counters under `with Div` only.
fn h(n: i64) -> i64 with Div {
    var hash: i64 = 5381
    var i = 0
    while i < n {
        hash = hash * 33 + i
        i = i + 1
    }
    hash
}

// Local array element, local struct field and local struct array-field stores.
fn local_aggregates(x: i64) -> i64 {
    var a = [0; 4]
    a[1] = x
    var s = Acc { total: 0, buf: [0; 4] }
    s.total = a[1]
    s.buf[2] = s.total * 4
    s.buf[2] + s.total
}

// A by-value parameter is a frame-local copy: writing it does not reach the caller.
fn scratch(b: [i64; 4]) -> i64 {
    b[0] = 99
    b[0] - 98
}

fn main() -> i64 with IO, Div {
    println(bump(2))
    println(h(3))
    println(local_aggregates(5))
    let keep = [0; 4]
    println(scratch(keep) + keep[0])
    0
}
