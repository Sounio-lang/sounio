//@ run-pass
//@ requires: madaros

affine struct OptionalPermit {
    id: i64,
}

fn spend(permit: OptionalPermit) -> i64 {
    permit.id
}

fn main() -> i32 with Panic {
    let permit = OptionalPermit { id: 7 }
    let enabled = true
    let result = if enabled {
        spend(permit)
    } else {
        0
    }
    assert(result == 7)
    0
}
