//@ run-pass
//@ description: Tiny portfolio v46 smoke for Lorenz i256 Taylor-2 adaptive-step-decision entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 557
    receipt_fp = mix(receipt_fp, 120259197, 3041)
    receipt_fp = mix(receipt_fp, 471466754, 3041)
    receipt_fp = mix(receipt_fp, 699995048, 3041)
    receipt_fp = mix(receipt_fp, 975812377, 3041)
    receipt_fp = mix(receipt_fp, 498384393, 3041)
    receipt_fp = mix(receipt_fp, 2, 3041)
    receipt_fp = mix(receipt_fp, 63, 3041)
    if receipt_fp != 279109641 { return 1 }

    var audit_fp: i64 = 563
    audit_fp = mix(audit_fp, receipt_fp, 3053)
    audit_fp = mix(audit_fp, 120259197, 3053)
    audit_fp = mix(audit_fp, 471466754, 3053)
    audit_fp = mix(audit_fp, 486061656, 3053)
    audit_fp = mix(audit_fp, 85088711, 3053)
    audit_fp = mix(audit_fp, 498384393, 3053)
    audit_fp = mix(audit_fp, 2, 3053)
    audit_fp = mix(audit_fp, 63, 3053)
    if audit_fp != 207228249 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 49, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 49, 1103)
    if entry_fp != 889790136 { return 3 }

    if audit_fp == 207228250 { return 4 }
    return 0
}
