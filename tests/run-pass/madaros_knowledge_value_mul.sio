//@ run-pass
//@ expect-stdout: MADAROS_KNOWLEDGE_VALUE_MUL_PASS

// Madaros regression: Knowledge.value must be an f64 register so
// a1 * a1 is IEEE mul (not integer imul of bit patterns).
// Pre-fix (2026-07-25): a1=1.0, aa=0.0 under default Madaros.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let a: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let a1 = a.value
    let aa = a1 * a1
    let A = 4.0 * aa
    let va = variance_of(a1)
    let vaa = variance_of(aa)
    let vA = variance_of(A)
    print("a1="); print_f64(a1); print("\n")
    print("aa="); print_f64(aa); print("\n")
    print("A="); print_f64(A); print("\n")
    print("var_a1="); print_f64(va); print("\n")
    print("var_aa="); print_f64(vaa); print("\n")
    print("var_A="); print_f64(vA); print("\n")
    let ok_val = abs_f(a1 - 1.0) < 1.0e-12 && abs_f(aa - 1.0) < 1.0e-12 && abs_f(A - 4.0) < 1.0e-12
    let ok_var = abs_f(va - 0.0025) < 1.0e-9 && abs_f(vaa - 0.01) < 1.0e-9 && abs_f(vA - 0.16) < 1.0e-9
    if ok_val && ok_var {
        print("MADAROS_KNOWLEDGE_VALUE_MUL_PASS\n")
    } else {
        print("MADAROS_KNOWLEDGE_VALUE_MUL_FAIL\n")
    }
}
