//@ run-pass
//@ requires: madaros
//@ expect-stdout: MADAROS_CORRELATE_NEGATIVE_RHO_PASS

// A negative correlation coefficient.
//
// This dialect writes a negative literal as `0.0 - 0.5`, an ExprBinary. The
// lowerer folded only ExprFloatLit, so every negative rho fell through to the
// initialiser 0.0 -- silently asserting independence in the one case the
// builtin exists for. Anticorrelation is not an edge case in GUM; it is where
// the correction changes sign.
//
//   sigma_x = 0.1, sigma_y = 0.3
//   rho = +1.0 : 0.01 + 0.09 + 2*0.03 = 0.16
//   rho =  0.0 : 0.01 + 0.09          = 0.10
//   rho = -1.0 : 0.01 + 0.09 - 2*0.03 = 0.04
//   rho = -0.5 : 0.01 + 0.09 - 0.03   = 0.07

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn v_with_rho_neg_one() -> f64 with IO, Mut, Div, Epistemic {
    let kx: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let ky: Knowledge<f64> = measure(2.0, uncertainty: 0.3)
    let x = kx.value
    let y = ky.value
    let _r = correlate(x, y, 0.0 - 1.0)
    return variance_of(x + y)
}

fn v_with_rho_neg_half() -> f64 with IO, Mut, Div, Epistemic {
    let kx: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let ky: Knowledge<f64> = measure(2.0, uncertainty: 0.3)
    let x = kx.value
    let y = ky.value
    let _r = correlate(x, y, 0.0 - 0.5)
    return variance_of(x + y)
}

fn v_with_rho_plus_one() -> f64 with IO, Mut, Div, Epistemic {
    let kx: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let ky: Knowledge<f64> = measure(2.0, uncertainty: 0.3)
    let x = kx.value
    let y = ky.value
    let _r = correlate(x, y, 1.0)
    return variance_of(x + y)
}

fn main() with IO, Mut, Div, Epistemic {
    let v_neg1 = v_with_rho_neg_one()
    let v_neghalf = v_with_rho_neg_half()
    let v_pos1 = v_with_rho_plus_one()

    print("v_neg1="); print_f64(v_neg1); print("\n")
    print("v_neghalf="); print_f64(v_neghalf); print("\n")
    print("v_pos1="); print_f64(v_pos1); print("\n")

    let ok = abs_f(v_neg1 - 0.04) < 1.0e-12
        && abs_f(v_neghalf - 0.07) < 1.0e-12
        && abs_f(v_pos1 - 0.16) < 1.0e-12
    if ok {
        print("MADAROS_CORRELATE_NEGATIVE_RHO_PASS\n")
    } else {
        print("MADAROS_CORRELATE_NEGATIVE_RHO_FAIL\n")
    }
}
