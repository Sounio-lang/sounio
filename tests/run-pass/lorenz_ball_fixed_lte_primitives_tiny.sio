//@ run-pass
//@ description: Scalar Lorenz fixed-point LTE primitive smoke with interval second-derivative bounds

fn bf_abs64(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    return x
}

fn bf_ceil_div_nonneg(n: i64, d: i64) -> i64 with Div {
    if n < 0 { return 0 - 1 }
    if d <= 0 { return 0 - 1 }
    return (n + d - 1) / d
}

fn bf_dt_square(dt: i64) -> i64 {
    if dt < 0 { return 0 - 1 }
    if dt > 1000000000 { return 0 - 1 }
    return dt * dt
}

fn bf_lte_den(scale: i64) -> i64 {
    if scale <= 0 { return 0 - 1 }
    if scale > 1000000000 { return 0 - 1 }
    return 2 * scale * scale
}

fn bf_lte_radius_from_h2(dd_abs: i64, h2: i64, lte_den: i64) -> i64 with Div {
    if dd_abs < 0 { return 0 - 1 }
    if dd_abs > 4000000000 { return 0 - 1 }
    if h2 < 0 { return 0 - 1 }
    if h2 > 1000000000 { return 0 - 1 }
    if lte_den <= 0 { return 0 - 1 }
    return bf_ceil_div_nonneg(h2 * dd_abs, lte_den)
}

fn bf_lte_radius(dd_abs: i64, dt: i64, scale: i64) -> i64 with Div {
    let h2: i64 = bf_dt_square(dt)
    if h2 < 0 { return 0 - 1 }
    let den: i64 = bf_lte_den(scale)
    if den < 0 { return 0 - 1 }
    return bf_lte_radius_from_h2(dd_abs, h2, den)
}

fn bf_add_lte_radius(euler_radius: i64, lte_radius: i64) -> i64 {
    if euler_radius < 0 { return 0 - 1 }
    if lte_radius < 0 { return 0 - 1 }
    return euler_radius + lte_radius
}

fn bf_max_abs_pair(lo: i64, hi: i64) -> i64 {
    let a: i64 = bf_abs64(lo)
    let b: i64 = bf_abs64(hi)
    if b > a { return b }
    return a
}

fn bf_lorenz_dx_abs_bound(x_abs: i64, y_abs: i64, sigma_abs: i64) -> i64 {
    if x_abs < 0 { return 0 - 1 }
    if y_abs < 0 { return 0 - 1 }
    if sigma_abs < 0 { return 0 - 1 }
    return sigma_abs * (x_abs + y_abs)
}

fn bf_lorenz_dy_abs_bound(x_abs: i64, rhoz_abs: i64, y_abs: i64, scale: i64) -> i64 with Div {
    if x_abs < 0 { return 0 - 1 }
    if rhoz_abs < 0 { return 0 - 1 }
    if y_abs < 0 { return 0 - 1 }
    if scale <= 0 { return 0 - 1 }
    return bf_ceil_div_nonneg(x_abs * rhoz_abs, scale) + y_abs
}

fn bf_lorenz_dz_abs_bound(x_abs: i64, y_abs: i64, z_abs: i64, scale: i64) -> i64 with Div {
    if x_abs < 0 { return 0 - 1 }
    if y_abs < 0 { return 0 - 1 }
    if z_abs < 0 { return 0 - 1 }
    if scale <= 0 { return 0 - 1 }
    let xy_abs: i64 = bf_ceil_div_nonneg(x_abs * y_abs, scale)
    let beta_abs: i64 = bf_ceil_div_nonneg(8 * z_abs, 3)
    return xy_abs + beta_abs
}

fn bf_lorenz_ddx_abs_bound(dx_abs: i64, dy_abs: i64, sigma_abs: i64) -> i64 {
    if dx_abs < 0 { return 0 - 1 }
    if dy_abs < 0 { return 0 - 1 }
    if sigma_abs < 0 { return 0 - 1 }
    return sigma_abs * (dy_abs + dx_abs)
}

fn bf_lorenz_ddy_abs_bound(dx_abs: i64, rhoz_abs: i64, x_abs: i64, dz_abs: i64, dy_abs: i64, scale: i64) -> i64 with Div {
    if dx_abs < 0 { return 0 - 1 }
    if rhoz_abs < 0 { return 0 - 1 }
    if x_abs < 0 { return 0 - 1 }
    if dz_abs < 0 { return 0 - 1 }
    if dy_abs < 0 { return 0 - 1 }
    if scale <= 0 { return 0 - 1 }
    let dx_rhoz_abs: i64 = bf_ceil_div_nonneg(dx_abs * rhoz_abs, scale)
    let x_dz_abs: i64 = bf_ceil_div_nonneg(x_abs * dz_abs, scale)
    return dx_rhoz_abs + x_dz_abs + dy_abs
}

fn bf_lorenz_ddz_abs_bound(dx_abs: i64, y_abs: i64, x_abs: i64, dy_abs: i64, dz_abs: i64, scale: i64) -> i64 with Div {
    if dx_abs < 0 { return 0 - 1 }
    if y_abs < 0 { return 0 - 1 }
    if x_abs < 0 { return 0 - 1 }
    if dy_abs < 0 { return 0 - 1 }
    if dz_abs < 0 { return 0 - 1 }
    if scale <= 0 { return 0 - 1 }
    let dx_y_abs: i64 = bf_ceil_div_nonneg(dx_abs * y_abs, scale)
    let x_dy_abs: i64 = bf_ceil_div_nonneg(x_abs * dy_abs, scale)
    let beta_dz_abs: i64 = bf_ceil_div_nonneg(8 * dz_abs, 3)
    return dx_y_abs + x_dy_abs + beta_dz_abs
}

fn main() -> i64 with Div {
    let scale: i64 = 1000000
    let dt: i64 = 10000
    let h2: i64 = bf_dt_square(dt)
    let den: i64 = bf_lte_den(scale)

    let x_abs: i64 = 1000013
    let y_abs: i64 = 1260013
    let z_abs: i64 = 1000010
    let rhoz_abs: i64 = bf_max_abs_pair(28000000 - 983323, 28000000 - 1000010)

    let dx_abs: i64 = bf_lorenz_dx_abs_bound(x_abs, y_abs, 10)
    let dy_abs: i64 = bf_lorenz_dy_abs_bound(x_abs, rhoz_abs, y_abs, scale)
    let dz_abs: i64 = bf_lorenz_dz_abs_bound(x_abs, y_abs, z_abs, scale)

    let ddx_abs: i64 = bf_lorenz_ddx_abs_bound(dx_abs, dy_abs, 10)
    let ddy_abs: i64 = bf_lorenz_ddy_abs_bound(dx_abs, rhoz_abs, x_abs, dz_abs, dy_abs, scale)
    let ddz_abs: i64 = bf_lorenz_ddz_abs_bound(dx_abs, y_abs, x_abs, dy_abs, dz_abs, scale)

    let lte_x: i64 = bf_lte_radius_from_h2(ddx_abs, h2, den)
    let lte_y: i64 = bf_lte_radius_from_h2(ddy_abs, h2, den)
    let lte_z: i64 = bf_lte_radius_from_h2(ddz_abs, h2, den)

    if h2 != 100000000 { return 1 }
    if den != 2000000000000 { return 2 }
    if rhoz_abs != 27016677 { return 3 }
    if dx_abs != 22600260 { return 4 }
    if dy_abs != 28277042 { return 5 }
    if dz_abs != 3926724 { return 6 }
    if ddx_abs != 508773020 { return 7 }
    if ddy_abs != 642787743 { return 8 }
    if ddz_abs != 67225296 { return 9 }
    if lte_x != 25439 { return 10 }
    if lte_y != 32140 { return 11 }
    if lte_z != 3362 { return 12 }
    if bf_lte_radius(ddx_abs, dt, scale) != 25439 { return 13 }
    if bf_add_lte_radius(13, lte_x) != 25452 { return 14 }
    if bf_add_lte_radius(13, lte_y) != 32153 { return 15 }
    if bf_add_lte_radius(11, lte_z) != 3373 { return 16 }

    if bf_lte_den(0) != (0 - 1) { return 30 }
    if bf_dt_square(0 - 1) != (0 - 1) { return 31 }
    if bf_lte_radius_from_h2(0 - 1, h2, den) != (0 - 1) { return 32 }
    if bf_lte_radius_from_h2(ddx_abs, 0 - 1, den) != (0 - 1) { return 33 }
    if bf_lte_radius_from_h2(ddx_abs, h2, 0) != (0 - 1) { return 34 }
    if bf_add_lte_radius(13, 0 - 1) != (0 - 1) { return 35 }
    if bf_lorenz_dy_abs_bound(x_abs, rhoz_abs, y_abs, 0) != (0 - 1) { return 36 }
    if bf_lorenz_ddy_abs_bound(dx_abs, rhoz_abs, x_abs, 0 - 1, dy_abs, scale) != (0 - 1) { return 37 }

    return 0
}
