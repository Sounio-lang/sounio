use systems::lorenz_i256_limb_scale_bridge::*

fn main() -> i64 with Div {
    let sigma_delta = lorenz_i256_sigma_delta10_check(200000000, 0, 0, 0, 0, 2, 0, 0)
    if sigma_delta != 1 { return 1 }

    let scale_carry = lorenz_i256_limb_scale_check(150000000, 1, 0, 0, 10, 500000000, 11, 0, 0)
    if scale_carry != 1 { return 2 }

    let artifact = lorenz_i256_limb_scale_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 103)
