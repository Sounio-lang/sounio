//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_NESTED_METHOD_PASS

// Nested method FO — self.rate / self.clearance expanded inside self.css.
// Requires multipass FO register + MethodCall expand under FO_BC_IMPL_TYPE.

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn clearance(self: &Pk, eta: f64) -> f64 {
        self.cl0 * exp(eta)
    }
    fn rate(self: &Pk, f: f64, dose: f64, tau: f64) -> f64 {
        (f * dose) / tau
    }
    fn css(self: &Pk, f: f64, dose: f64, tau: f64, eta: f64) -> f64 {
        self.rate(f, dose, tau) / self.clearance(eta)
    }
}

fn free_css(f: f64, dose: f64, tau: f64, cl0: f64, eta: f64) -> f64 {
    ((f * dose) / tau) / (cl0 * exp(eta))
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let f = kF.value
    let dose = kDose.value
    let cl0 = kCL0.value
    let eta = kEta.value
    let pk = Pk { cl0: cl0, v0: 50.0 }

    let v_nested = variance_of(pk.css(f, dose, 12.0, eta))
    let v_free = variance_of(free_css(f, dose, 12.0, cl0, eta))
    let v_site = variance_of(pk.rate(f, dose, 12.0) / pk.clearance(eta))
    let m2 = second_order_mean(pk.css(f, dose, 12.0, eta))

    print("v_nested="); print_f64(v_nested); print("\n")
    print("v_free="); print_f64(v_free); print("\n")
    print("v_site="); print_f64(v_site); print("\n")
    print("m2="); print_f64(m2); print("\n")

    let ok = abs_f(v_nested - v_free) < 1.0e-9
        && abs_f(v_nested - v_site) < 1.0e-9
        && abs_f(v_nested - 0.795833) < 1.0e-4
        && abs_f(m2 - 6.724) < 1.0e-3
    if ok {
        print("MADAROS_GUM_FO_NESTED_METHOD_PASS\n")
    } else {
        print("MADAROS_GUM_FO_NESTED_METHOD_FAIL\n")
    }
}
