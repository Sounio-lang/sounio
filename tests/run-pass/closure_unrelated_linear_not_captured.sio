//@ run-pass
//@ check-only
//@ requires: madaros
//@ description: A closure is not linear merely because an unrelated linear value is visible

linear struct Permit {
    level: i32,
}

fn consume(p: Permit) -> i32 {
    p.level
}

fn main() -> i32 {
    let permit = Permit { level: 5 }
    let add_one = |x: i32| -> i32 { x + 1 }
    let first = add_one(1)
    let second = add_one(2)
    consume(permit) + first + second
}
