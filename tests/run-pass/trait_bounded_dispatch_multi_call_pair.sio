//@ run-pass
struct Pair { x: i64, y: i64 }
trait R { fn radd(self, o: Self) -> Self; fn rsub(self, o: Self) -> Self }
impl R for i64 { fn radd(self, o: Self) -> Self { self + o } fn rsub(self, o: Self) -> Self { self - o } }
impl R for Pair { fn radd(self, o: Self) -> Self { Pair { x: self.x + o.x, y: self.y + o.y } } fn rsub(self, o: Self) -> Self { Pair { x: self.x - o.x, y: self.y - o.y } } }
fn compute<F: R>(a: F, b: F) -> F { a.radd(b) }
fn combine<F: R>(a: F, b: F, c: F) -> F { let intermediate = compute::<F>(a, b); intermediate.rsub(c) }
fn main() -> i32 with IO, Mut, Panic {
    let p1 = Pair { x: 4, y: 5 }
    let p2 = Pair { x: 2, y: 2 }
    let p3 = Pair { x: 1, y: 1 }
    let res_p = combine::<Pair>(p1, p2, p3)
    println(res_p.x)
    println(res_p.y)
    println("multi_call PASS Pair")
    0
}
