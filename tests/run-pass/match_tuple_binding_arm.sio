//@ run-pass
//@ requires: madaros
//@ expect-stdout: 5|
// SIO-322: the irrefutable tuple pattern `(a, b)` must bind both elements
// and run its arm. It used to be skipped silently, printing nothing.

fn main() -> i32 with IO {
    let n = 0
    let m = 5
    match (n, m) {
        (a, b) => print_int(a + b),
    }
    println("|")
    return 0
}
