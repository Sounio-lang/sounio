//@ run-pass
//@ expect-stdout: BOX_FIELD_LOCAL_TYPED_OK
// #2966: `var t = h.table` with `table: Box<Table>` was tagged Box with an
// unknown payload, so `(*t).depth[1] = ..` resolved `depth` by the untyped
// vote. Two decoys put `depth` at index 0, so the store landed in Table.pad.
// The let path now takes T from the field's declared Box<T>.
struct DecoyA {
    depth: i64,
}

struct DecoyB {
    depth: i64,
    x: i64,
}

struct Table {
    pad: i64,
    depth: [i64; 4],
}

struct Holder {
    id: i64,
    table: Box<Table>,
}

fn read_depth(t: &Table, i: i64) -> i64 {
    (*t).depth[i as usize]
}

fn fill(h: &Holder) with Mut, Panic, Div {
    var t = (*h).table
    (*t).depth[1] = 40
    (*t).depth[2] = 2
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let a = DecoyA { depth: 5 }
    let b = DecoyB { depth: 6, x: 7 }
    let h = Holder { id: 1, table: Box::new(Table { pad: 0, depth: [0; 4] }) }
    fill(&h)
    let s = read_depth(&(*h.table), 1) + read_depth(&(*h.table), 2)
    if s == 42 && (*h.table).pad == 0 && a.depth + b.depth == 11 {
        println("BOX_FIELD_LOCAL_TYPED_OK")
        return 0
    }
    print("BOX_FIELD_LOCAL_TYPED_FAIL s=")
    print_int(s)
    println("")
    return 1
}
