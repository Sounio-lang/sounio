//@ run-pass
//@ description: #2834 — spec §7.2.1: rebinding a local that holds a reference (`current = &(*c).tail`, `r = &b`) changes only the local, so it needs no `Mut` (both engines). Found compiling Madaros' module_frontend.sio list walkers under #1494.
//@ expect-stdout: 3
//@ expect-stdout: 7

struct Cell { v: i64, tail: Option<Box<Cell>> }

// module_frontend.sio's list-walker shape: only `with Alloc, Div, Panic`, no Mut.
fn count_cells(head: &Option<Box<Cell>>) -> i64 with Alloc, Div, Panic {
    var n: i64 = 0
    var current = head
    while true {
        match *current {
            Some(c) => {
                n = n + 1
                current = &(*c).tail
            }
            None => return n,
        }
    }
    n
}

// A local `&i64` rebound to another local's address.
fn pick(a: i64, b: i64) -> i64 {
    var r = &a
    if b > a { r = &b }
    *r
}

fn main() -> i64 with IO, Alloc, Div, Panic {
    let list: Option<Box<Cell>> = Some(Box::new(Cell { v: 1, tail: Some(Box::new(Cell { v: 2, tail: Some(Box::new(Cell { v: 3, tail: None })) })) }))
    println(count_cells(&list))
    println(pick(4, 7))
    0
}
