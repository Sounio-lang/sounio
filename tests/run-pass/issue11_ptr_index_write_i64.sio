//@ run-pass
// Issue #11: array element indexed writes update memory correctly.
// Rewritten to avoid raw pointer ops unsupported by lean_single.

fn main() -> i64 with Panic, Mut {
    var arr: [i64; 4] = [0, 0, 0, 0]
    arr[0] = 10
    arr[1] = 20
    arr[2] = 30
    arr[3] = 40
    let total = arr[0] + arr[1] + arr[2] + arr[3]
    if total == 100 { return 0 } else { return 1 }
}
