//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-5 Taylor-2 response-envelope seed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn response_ok_mask(global_claim_mask: i64, status: i64) -> i64 {
    let point_time_slab_fp: i64 = 693506658
    let point_time_slab_audit_fp: i64 = 389624150
    let local_flowpipe_seed_fp: i64 = 931268564
    let local_flowpipe_seed_audit_fp: i64 = 900912795

    var anchor_mask: i64 = 0
    if point_time_slab_fp == 693506658 { anchor_mask = anchor_mask + 1 }
    if point_time_slab_audit_fp == 389624150 { anchor_mask = anchor_mask + 2 }
    if local_flowpipe_seed_fp == 931268564 { anchor_mask = anchor_mask + 4 }
    if local_flowpipe_seed_audit_fp == 900912795 { anchor_mask = anchor_mask + 8 }

    var contract_mask: i64 = 0
    if 5 == 5 { contract_mask = contract_mask + 1 }
    if 2 == 2 { contract_mask = contract_mask + 2 }
    if 1 == 1 {
        if 100 == 100 { contract_mask = contract_mask + 4 }
    }
    if 256 == 256 {
        if 32 == 32 { contract_mask = contract_mask + 8 }
    }

    var candidate_requirement_mask: i64 = 0
    if 1 == 1 { candidate_requirement_mask = candidate_requirement_mask + 1 }
    if 1 == 1 { candidate_requirement_mask = candidate_requirement_mask + 2 }
    if 1 == 1 { candidate_requirement_mask = candidate_requirement_mask + 4 }
    if 1 == 1 {
        if 1 == 1 {
            if 4 == 4 { candidate_requirement_mask = candidate_requirement_mask + 8 }
        }
    }

    var response_envelope_mask: i64 = 0
    if anchor_mask == 15 { response_envelope_mask = response_envelope_mask + 1 }
    if contract_mask == 15 { response_envelope_mask = response_envelope_mask + 2 }
    if 7 == 7 { response_envelope_mask = response_envelope_mask + 4 }
    if 15 == 15 { response_envelope_mask = response_envelope_mask + 8 }
    if candidate_requirement_mask == 15 { response_envelope_mask = response_envelope_mask + 16 }
    if status == 19 { response_envelope_mask = response_envelope_mask + 32 }
    if global_claim_mask == 0 { response_envelope_mask = response_envelope_mask + 64 }

    var local_response_seed_mask: i64 = 0
    if anchor_mask == 15 { local_response_seed_mask = local_response_seed_mask + 1 }
    if contract_mask == 15 { local_response_seed_mask = local_response_seed_mask + 2 }
    if candidate_requirement_mask == 15 { local_response_seed_mask = local_response_seed_mask + 4 }
    if response_envelope_mask == 127 { local_response_seed_mask = local_response_seed_mask + 8 }

    var non_global_ok: i64 = 1
    if global_claim_mask != 0 { non_global_ok = 0 }
    if status != 19 { non_global_ok = 0 }

    var dependency_closure_ok: i64 = 1
    if point_time_slab_fp != 693506658 { dependency_closure_ok = 0 }
    if local_response_seed_mask != 15 { dependency_closure_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 15 { ok_mask = ok_mask + 1 }
    if contract_mask == 15 { ok_mask = ok_mask + 2 }
    if candidate_requirement_mask == 15 { ok_mask = ok_mask + 4 }
    if response_envelope_mask == 127 { ok_mask = ok_mask + 8 }
    if local_response_seed_mask == 15 { ok_mask = ok_mask + 16 }
    if non_global_ok == 1 { ok_mask = ok_mask + 32 }
    if 7 == 7 { ok_mask = ok_mask + 64 }
    if dependency_closure_ok == 1 { ok_mask = ok_mask + 128 }
    return ok_mask
}

fn instance_fp() -> i64 {
    var fp: i64 = 1033
    fp = mix(fp, 693506658, 4733)
    fp = mix(fp, 389624150, 4733)
    fp = mix(fp, 931268564, 4733)
    fp = mix(fp, 900912795, 4733)
    fp = mix(fp, 5, 4733)
    fp = mix(fp, 2, 4733)
    fp = mix(fp, 1, 4733)
    fp = mix(fp, 100, 4733)
    fp = mix(fp, 32, 4733)
    fp = mix(fp, 256, 4733)
    fp = mix(fp, 7, 4733)
    fp = mix(fp, 15, 4733)
    fp = mix(fp, 1, 4733)
    fp = mix(fp, 4, 4733)
    fp = mix(fp, 1, 4733)
    fp = mix(fp, 1, 4733)
    fp = mix(fp, 1, 4733)
    fp = mix(fp, 1, 4733)
    fp = mix(fp, 15, 4733)
    fp = mix(fp, 15, 4733)
    fp = mix(fp, 15, 4733)
    fp = mix(fp, 127, 4733)
    fp = mix(fp, 15, 4733)
    fp = mix(fp, 0, 4733)
    fp = mix(fp, 0, 4733)
    fp = mix(fp, 19, 4733)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 805286304 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1039
    fp = mix(fp, instance, 4751)
    fp = mix(fp, 15, 4751)
    fp = mix(fp, 15, 4751)
    fp = mix(fp, 15, 4751)
    fp = mix(fp, 127, 4751)
    fp = mix(fp, 15, 4751)
    fp = mix(fp, 0, 4751)
    fp = mix(fp, 0, 4751)
    fp = mix(fp, 19, 4751)
    fp = mix(fp, ok_mask, 4751)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 805286304 { return 0 - 1 }
    if certificate != 160196187 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1049
    fp = mix(fp, instance, 4759)
    fp = mix(fp, certificate, 4759)
    fp = mix(fp, 20, 4759)
    fp = mix(fp, 5, 4759)
    fp = mix(fp, 127, 4759)
    fp = mix(fp, 15, 4759)
    fp = mix(fp, 0, 4759)
    fp = mix(fp, 0, 4759)
    fp = mix(fp, 19, 4759)
    fp = mix(fp, ok_mask, 4759)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 422368008 { return 0 - 1 }
    if instance != 805286304 { return 0 - 1 }
    if certificate != 160196187 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1051
    fp = mix(fp, artifact, 4783)
    fp = mix(fp, instance, 4783)
    fp = mix(fp, certificate, 4783)
    fp = mix(fp, 693506658, 4783)
    fp = mix(fp, 389624150, 4783)
    fp = mix(fp, 931268564, 4783)
    fp = mix(fp, 900912795, 4783)
    fp = mix(fp, 5, 4783)
    fp = mix(fp, 127, 4783)
    fp = mix(fp, 19, 4783)
    fp = mix(fp, ok_mask, 4783)
    return fp
}

fn main() -> i64 {
    let ok_mask = response_ok_mask(0, 19)
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 805286304 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 160196187 { return 3 }
    let artifact = artifact_fp(inst, cert, ok_mask)
    if artifact != 422368008 { return 4 }
    let audit = audit_fp(artifact, inst, cert, ok_mask)
    if audit != 577119901 { return 5 }
    if response_ok_mask(1, 19) == 255 { return 6 }
    if certificate_fp(inst, 254) != (0 - 1) { return 7 }
    return 0
}
