//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_LIT_SLOT_STRUCT_FIELD_F64_ARRAY PASS
//
// Copilot review (PR #2516), finding 1 on the sixth review round: the
// tuple-literal slot classifier (tuple_lit_slot_is_f64_array_ref,
// self-hosted/ir/lower.sio) did not handle ExprFieldAccess, so a slot
// backed by an f64-array STRUCT FIELD -- `(holder.values, 0)` -- fell
// through to false even though field_array_elem_is_float_for_base_ref
// already resolves this exact shape (struct-typed base -> declared field
// layout) elsewhere in the same file. Before the fix, `a[0]` on the
// destructured slot took the integer conversion path.
struct Holder {
    values: [f64; 2],
}

fn main() -> i32 with IO, Mut, Panic {
    var holder = Holder { values: [0.0; 2] }
    holder.values[0] = 1.5
    holder.values[1] = 0.25

    let (a, n) = (holder.values, 0)
    let s0: f64 = a[0] * 2.0
    let s1: f64 = 2.0 * a[1]

    if s0 == 3.0 && s1 == 0.5 && n == 0 {
        println("TUPLE_LIT_SLOT_STRUCT_FIELD_F64_ARRAY PASS")
        return 0
    }
    1
}
