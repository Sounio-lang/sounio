//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v85 smoke for Lorenz i256 step-4 Taylor-2 response envelope

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1721
    receipt_fp = mix(receipt_fp, 575348777, 5651)
    receipt_fp = mix(receipt_fp, 417943295, 5651)
    receipt_fp = mix(receipt_fp, 414744732, 5651)
    receipt_fp = mix(receipt_fp, 65508192, 5651)
    receipt_fp = mix(receipt_fp, 600773460, 5651)
    receipt_fp = mix(receipt_fp, 157689400, 5651)
    receipt_fp = mix(receipt_fp, 544039824, 5651)
    receipt_fp = mix(receipt_fp, 827089582, 5651)
    receipt_fp = mix(receipt_fp, 688797663, 5651)
    receipt_fp = mix(receipt_fp, 4, 5651)
    receipt_fp = mix(receipt_fp, 20, 5651)
    receipt_fp = mix(receipt_fp, 255, 5651)
    if receipt_fp != 574699726 { return 1 }

    var audit_fp: i64 = 1723
    audit_fp = mix(audit_fp, receipt_fp, 5653)
    audit_fp = mix(audit_fp, 575348777, 5653)
    audit_fp = mix(audit_fp, 417943295, 5653)
    audit_fp = mix(audit_fp, 414744732, 5653)
    audit_fp = mix(audit_fp, 65508192, 5653)
    audit_fp = mix(audit_fp, 827089582, 5653)
    audit_fp = mix(audit_fp, 688797663, 5653)
    audit_fp = mix(audit_fp, 544039824, 5653)
    audit_fp = mix(audit_fp, 4, 5653)
    audit_fp = mix(audit_fp, 20, 5653)
    audit_fp = mix(audit_fp, 255, 5653)
    if audit_fp != 858781339 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 88, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 88, 1103)
    if entry_fp != 676159538 { return 3 }

    let manifest_fp: i64 = 767589932
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 85, 1871)
    result_fp = mix(result_fp, 89, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 77, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 463727489 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 85, 1907)
    family_fp = mix(family_fp, 89, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 72, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 176685209 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 85, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 162558664 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 85, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 69746315 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 85, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 661481028 { return 8 }
    return 0
}
