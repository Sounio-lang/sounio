//@ check-only
//@ requires: madaros
//@ expect-stdout-contains: W044
//
// PR #2515 review round 6, finding A (comment_id 4090966164,
// self-hosted/check/check.sio): CHECKER_USE_MODULE_HASH used to be ONE
// GLOBAL set -- membership meant "some module, somewhere in this whole
// compilation, imported this segment", not "the module CURRENTLY being
// checked imported it". testmod::dep_chain_leaf (stdlib/testmod/dep_chain_leaf.sio)
// is `use`d only by testmod::dep_chain_mid (stdlib/testmod/dep_chain_mid.sio,
// the round-2 finding-D dependency-chain fixture) -- never by this file.
// Before the fix, THIS file could still call `dep_chain_leaf::leaf_add(..)`
// directly, accepted only because dep_chain_mid (a different, unrelated
// module as far as THIS file's own `use` list is concerned) happened to
// import it somewhere else in the same compilation.
//
// The registry is now keyed per-module (current_module_id); this file's own
// `use testmod::dep_chain_mid;` legitimately makes `dep_chain_mid::mid_call(..)`
// resolve, but `dep_chain_leaf` was never THIS module's own import, so
// `dep_chain_leaf::leaf_add(..)` now correctly falls back to the
// pre-existing W044 "unresolved path" warning (verified here via `--check`,
// never executed -- W044 is a warning, not a hard error, matching the
// existing documented behavior for every other genuinely-unresolvable path
// in this codebase, so this does not fail the compile outright) instead of
// silently binding the real, unrelated module's signature.
use testmod::dep_chain_mid;

fn main() -> i32 with IO, Mut, Panic {
    let a = dep_chain_mid::mid_call(5)
    let b = dep_chain_leaf::leaf_add(5, 1)
    if a == 10006 {
        println("CROSS_MODULE_LEAK_REJECTED")
        return 0
    }
    1
}
