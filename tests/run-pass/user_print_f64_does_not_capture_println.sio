//@ run-pass
//@ description: a user fn named print_f64 with a different signature does not capture the runtime printer println(f64) dispatches to (stdlib/plot/bar.sio's private print_f64 turned println(f64) into an unbounded digit stream)
//@ expect-stdout: user=2.5
//@ expect-stdout: builtin=1.500000

fn print_f64(value: f64, decimals: i64) with IO, Mut, Div, Panic {
    let int_part = value as i64
    print(int_part)
    print(".")
    var remaining = value - int_part as f64
    var d: i64 = 0
    while d < decimals {
        remaining = remaining * 10.0
        let digit = remaining as i64
        print(digit)
        remaining = remaining - digit as f64
        d = d + 1
    }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("user=")
    print_f64(2.5, 1)
    print("\n")
    print("builtin=")
    println(1.5)
    0
}
