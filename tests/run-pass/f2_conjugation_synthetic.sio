//@ run-pass
//
// Native-stage mirror for F2 on a synthetic alternating-speaker trajectory.

fn embed_axis(hash: i64) -> i64 {
    let r: i64 = hash - (hash / 7) * 7
    return 1 + r
}

fn embed_into(hash: i64, out: &![f64; 8]) with Mut {
    var i: i64 = 0
    while i < 8 {
        out[i as usize] = 0.0
        i = i + 1
    }
    out[0] = 0.6
    out[embed_axis(hash) as usize] = 0.8
}

fn conj(v: &[f64; 8], out: &![f64; 8]) with Mut {
    out[0] = v[0]
    var i: i64 = 1
    while i < 8 {
        out[i as usize] = 0.0 - v[i as usize]
        i = i + 1
    }
}

fn dist_sq(a: &[f64; 8], b: &[f64; 8]) -> f64 with Mut {
    var s: f64 = 0.0
    var i: i64 = 0
    while i < 8 {
        let d: f64 = a[i as usize] - b[i as usize]
        s = s + d * d
        i = i + 1
    }
    return s
}

fn pair_residual_sq(hash_a: i64, hash_b: i64) -> f64 with Mut {
    var ea: [f64; 8] = [0.0; 8]
    var eb: [f64; 8] = [0.0; 8]
    var ca: [f64; 8] = [0.0; 8]
    embed_into(hash_a, &!ea)
    embed_into(hash_b, &!eb)
    conj(&ea, &!ca)
    return dist_sq(&eb, &ca)
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var speakers: [i64; 8] = [0, 1, 0, 1, 0, 1, 0, 1]
    var hashes: [i64; 8] = [1001, 2002, 1003, 2004, 1005, 2006, 1007, 2008]

    var sum_p: f64 = 0.0
    var c_p: i64 = 0
    var i: i64 = 0
    while i < 7 {
        if speakers[i as usize] != speakers[(i + 1) as usize] {
            sum_p = sum_p + pair_residual_sq(hashes[i as usize], hashes[(i + 1) as usize])
            c_p = c_p + 1
        }
        i = i + 1
    }

    var sum_r: f64 = 0.0
    var c_r: i64 = 0
    var k: i64 = 0
    while k < 8 {
        let j: i64 = (k + 3) - ((k + 3) / 8) * 8
        sum_r = sum_r + pair_residual_sq(hashes[k as usize], hashes[j as usize])
        c_r = c_r + 1
        k = k + 1
    }

    let d_paired: f64 = sum_p / (c_p as f64)
    let d_random: f64 = sum_r / (c_r as f64)
    var ratio: f64 = 0.0
    if d_paired > 0.0000000001 { ratio = d_random / d_paired }

    var ok: i64 = 1
    if c_p == 0 { ok = 0 }
    if d_paired <= 0.0 { ok = 0 }
    if ratio < 0.1 { ok = 0 }
    if ratio > 10.0 { ok = 0 }

    if ok == 1 { print("PASS\n") } else { print("FAIL\n") }
    return 0
}
