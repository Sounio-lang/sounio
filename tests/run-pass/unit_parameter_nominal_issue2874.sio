//@ run-pass
//@ expect-stdout: 0.070000
// O produto de pressão e pressão inversa deve ser adimensional.
unit pressure = kg / m / s / s
unit inverse_pressure = m * s * s / kg

fn exponent(beta: inverse_pressure, delta: pressure) -> f64 {
    (beta as f64) * (delta as f64)
}

fn main() -> i32 with IO {
    let beta: inverse_pressure = 0.00007
    let delta: pressure = 1000.0
    print_f64(exponent(beta, delta))
    print("\n")
    0
}
