//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-1 Taylor-2 radius candidate artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn conversion_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let rx: i256 = 4295 as i256
    let ry: i256 = 1116695792 as i256
    let rz: i256 = 71584220 as i256
    let x_conv_excess: i256 = rx * target_scale - (1 as i256) * source_scale
    let y_conv_excess: i256 = ry * target_scale - (260001 as i256) * source_scale
    let z_conv_excess: i256 = rz * target_scale - (16667 as i256) * source_scale
    if x_conv_excess >= (0 as i256) {
        if y_conv_excess >= (0 as i256) {
            if z_conv_excess >= (0 as i256) {
                if x_conv_excess < target_scale {
                    if y_conv_excess < target_scale {
                        if z_conv_excess < target_scale { return 1 }
                    }
                }
            }
        }
    }
    return 0
}

fn derivative_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let x1_abs: i256 = 4294967296 as i256
    let y1_abs: i256 = 5411658768 as i256
    let z1: i256 = 4223384510 as i256
    let rhoz_abs: i256 = (28 as i256) * source_scale - z1
    let rx: i256 = 4295 as i256
    let ry: i256 = 1116695792 as i256
    let rz: i256 = 71584220 as i256
    let dx_rad: i256 = 11167000870 as i256
    let prod_x_rhoz: i256 = 71700329 as i256
    let dy_rad: i256 = 1188396121 as i256
    let prod_xy: i256 = 1116702321 as i256
    let beta_rad: i256 = 190891255 as i256
    let dz_rad: i256 = 1307593576 as i256

    var mask: i64 = 0
    if dx_rad == (10 as i256) * (rx + ry) { mask = mask + 2 }

    let xrhoz_total: i256 =
        x1_abs * rz +
        rhoz_abs * rx +
        rx * rz
    if (prod_x_rhoz - (1 as i256)) * source_scale <= xrhoz_total {
        if prod_x_rhoz * source_scale > xrhoz_total { mask = mask + 4 }
    }
    if dy_rad == prod_x_rhoz + ry { mask = mask + 8 }

    let xy_total: i256 =
        x1_abs * ry +
        y1_abs * rx +
        rx * ry
    let beta_total: i256 = (8 as i256) * rz
    if (prod_xy - (1 as i256)) * source_scale <= xy_total {
        if prod_xy * source_scale > xy_total {
            if (beta_rad - (2 as i256)) * (3 as i256) < beta_total {
                if (beta_rad - (1 as i256)) * (3 as i256) >= beta_total {
                    if dz_rad == prod_xy + beta_rad { mask = mask + 16 }
                }
            }
        }
    }
    return mask
}

fn next_radius_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let dt_q: i256 = 42949672 as i256
    let rx: i256 = 4295 as i256
    let ry: i256 = 1116695792 as i256
    let rz: i256 = 71584220 as i256
    let dx_rad: i256 = 11167000870 as i256
    let dy_rad: i256 = 1188396121 as i256
    let dz_rad: i256 = 1307593576 as i256
    let next_x: i256 = 111674302 as i256
    let next_y: i256 = 1128579753 as i256
    let next_z: i256 = 84660156 as i256
    if (next_x - rx - (1 as i256)) * source_scale <= dt_q * dx_rad {
        if (next_x - rx) * source_scale > dt_q * dx_rad {
            if (next_y - ry - (1 as i256)) * source_scale <= dt_q * dy_rad {
                if (next_y - ry) * source_scale > dt_q * dy_rad {
                    if (next_z - rz - (1 as i256)) * source_scale <= dt_q * dz_rad {
                        if (next_z - rz) * source_scale > dt_q * dz_rad { return 32 }
                    }
                }
            }
        }
    }
    return 0
}

fn cap_mask() -> i64 {
    if (111674302 as i256) <= (120000000 as i256) {
        if (1128579753 as i256) <= (1200000000 as i256) {
            if (84660156 as i256) <= (90000000 as i256) { return 64 }
        }
    }
    return 0
}

fn main() -> i64 {
    let ok_mask = conversion_mask() + derivative_mask() + next_radius_mask() + cap_mask()
    if ok_mask != 127 { return 1 }

    var inst: i64 = 1759
    inst = mix(inst, 1, 5689)
    inst = mix(inst, 4294967296, 5689)
    inst = mix(inst, 1000000, 5689)
    inst = mix(inst, 472667880, 5689)
    inst = mix(inst, 286326819, 5689)
    inst = mix(inst, 496675613, 5689)
    inst = mix(inst, 467471545, 5689)
    inst = mix(inst, 44353214, 5689)
    inst = mix(inst, 431845922, 5689)
    inst = mix(inst, 1, 5689)
    inst = mix(inst, 260001, 5689)
    inst = mix(inst, 16667, 5689)
    inst = mix(inst, 4295, 5689)
    inst = mix(inst, 1116695792, 5689)
    inst = mix(inst, 71584220, 5689)
    inst = mix(inst, 0, 5689)
    inst = mix(inst, 0, 5689)
    if inst != 763744159 { return 2 }

    var cert: i64 = 1763
    cert = mix(cert, inst, 5693)
    cert = mix(cert, 11167000870, 5693)
    cert = mix(cert, 71700329, 5693)
    cert = mix(cert, 1188396121, 5693)
    cert = mix(cert, 1116702321, 5693)
    cert = mix(cert, 190891255, 5693)
    cert = mix(cert, 1307593576, 5693)
    cert = mix(cert, 111674302, 5693)
    cert = mix(cert, 1128579753, 5693)
    cert = mix(cert, 84660156, 5693)
    cert = mix(cert, 120000000, 5693)
    cert = mix(cert, 1200000000, 5693)
    cert = mix(cert, 90000000, 5693)
    cert = mix(cert, ok_mask, 5693)
    cert = mix(cert, 0, 5693)
    cert = mix(cert, 0, 5693)
    if cert != 224745160 { return 3 }

    var art: i64 = 1769
    art = mix(art, inst, 5699)
    art = mix(art, cert, 5699)
    art = mix(art, 472667880, 5699)
    art = mix(art, 286326819, 5699)
    art = mix(art, 2, 5699)
    art = mix(art, 1, 5699)
    art = mix(art, 111674302, 5699)
    art = mix(art, 1128579753, 5699)
    art = mix(art, 84660156, 5699)
    art = mix(art, 120000000, 5699)
    art = mix(art, 1200000000, 5699)
    art = mix(art, 90000000, 5699)
    art = mix(art, ok_mask, 5699)
    art = mix(art, 0, 5699)
    art = mix(art, 0, 5699)
    if art != 133154696 { return 4 }

    var audit: i64 = 1777
    audit = mix(audit, art, 5701)
    audit = mix(audit, inst, 5701)
    audit = mix(audit, cert, 5701)
    audit = mix(audit, 472667880, 5701)
    audit = mix(audit, 286326819, 5701)
    audit = mix(audit, 1, 5701)
    audit = mix(audit, 2, 5701)
    audit = mix(audit, ok_mask, 5701)
    audit = mix(audit, 0, 5701)
    audit = mix(audit, 0, 5701)
    if audit != 194048456 { return 5 }
    return 0
}
