//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_VIZ_LINE_REDUCE_MILLION_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_status,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_status,integer_buffer_set,integer_buffer_at,integer_buffer_close}
use viz::dynamic_line_reduce::{dynamic_line_reduce}
fn main() with IO,Alloc,Mut,Div,Panic {
 let n:i64=1000000
 var x=numeric_buffer_new(n,8000000)
 var y=numeric_buffer_new(n,8000000)
 var available=integer_buffer_new(n,8000000)
 var out=integer_buffer_new(n,8000000)
 assert(numeric_buffer_status(&x)==0 && numeric_buffer_status(&y)==0)
 assert(integer_buffer_status(&available)==0 && integer_buffer_status(&out)==0)
 var i:i64=0
 while i<n {
  var value:f64=0.0
  if i%100003==0 {value=1000000.0}
  if i%100019==0 {value=-1000000.0}
  let gap=(i>=100000 && i<100010) || (i>=500000 && i<500020) || (i>=900000 && i<900010)
  let a=numeric_buffer_set(&!x,i,i as f64)
  let b=numeric_buffer_set(&!y,i,value)
  let c=integer_buffer_set(&!available,i,if gap {0}else{1})
  i=i+1
 }
 let result=dynamic_line_reduce(&x,&y,&available,1024.0,525312.0,512,&!out)
 assert(result.status==0 && result.required==result.written && result.written<n)
 print("LINE_COUNT ");println(result.written)
 i=0
 while i<result.written {
  print("LINE_INDEX ");print(i);print(" ");println(integer_buffer_at(&out,i))
  if i>0 {assert(integer_buffer_at(&out,i)>integer_buffer_at(&out,i-1))}
  i=i+1
 }
 numeric_buffer_close(x);numeric_buffer_close(y)
 integer_buffer_close(available);integer_buffer_close(out)
 println("STDLIB_DEEP_VIZ_LINE_REDUCE_MILLION_PASS")
}
