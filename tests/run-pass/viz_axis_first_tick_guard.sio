//@ run-pass
//@ expect-stdout: AXIS_FIRST_TICK_GUARD_PASS
// This regression deliberately runs under the Stage2 engine too.
// The first tick has no predecessor; no negative index may be evaluated.
use viz::axis::{axis_ticks}
use viz::axis_layout::{axis_measure_labels}
fn main()->i32 with IO,Mut,Div,Panic {
 let ticks=axis_ticks(0.0,1.0,1)
 assert(ticks.status==0 && ticks.n==2)
 let plan=axis_measure_labels(&ticks,false,64,32,240,400,100)
 let status:i64=plan.status
 let n:i64=plan.n
 let problem:i64=plan.first_problem
 print("axis first status: ");println(status)
 print("axis first n: ");println(n)
 print("axis first problem: ");println(problem)
 assert(plan.status==0 && plan.n==2 && plan.first_problem== -1)
 assert(plan.tick_x[0]==64 && plan.tick_y[0]==32)
 assert(plan.labels[0].n==1 && (plan.labels[0].text[0] as i64)==48)
 var duplicate=axis_ticks(0.0,1.0,1)
 duplicate.values[1]=duplicate.values[0]
 let rejected=axis_measure_labels(&duplicate,false,64,32,240,400,100)
 assert(rejected.status==1 && rejected.n==0 && rejected.first_problem==1)
 println("AXIS_FIRST_TICK_GUARD_PASS")
 0
}
