//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v142 smoke for Lorenz i256 step-1 Taylor-2 local-flowpipe proof

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt: i64 = 2063
    receipt = mix(receipt, 908974219, 6079)
    receipt = mix(receipt, 890221848, 6079)
    receipt = mix(receipt, 246755403, 6079)
    receipt = mix(receipt, 730796448, 6079)
    receipt = mix(receipt, 639513798, 6079)
    receipt = mix(receipt, 940931367, 6079)
    receipt = mix(receipt, 382273466, 6079)
    receipt = mix(receipt, 120130225, 6079)
    receipt = mix(receipt, 506555685, 6079)
    receipt = mix(receipt, 721641728, 6079)
    receipt = mix(receipt, 1, 6079)
    receipt = mix(receipt, 16, 6079)
    receipt = mix(receipt, 255, 6079)
    if receipt != 989878921 { return 1 }

    var audit: i64 = 2069
    audit = mix(audit, receipt, 6089)
    audit = mix(audit, 908974219, 6089)
    audit = mix(audit, 890221848, 6089)
    audit = mix(audit, 579621511, 6089)
    audit = mix(audit, 392918762, 6089)
    audit = mix(audit, 62233558, 6089)
    audit = mix(audit, 104592626, 6089)
    audit = mix(audit, 26998442, 6089)
    audit = mix(audit, 558635697, 6089)
    audit = mix(audit, 824834880, 6089)
    audit = mix(audit, 262282451, 6089)
    audit = mix(audit, 590782342, 6089)
    audit = mix(audit, 991875676, 6089)
    audit = mix(audit, 993840454, 6089)
    audit = mix(audit, 232141983, 6089)
    audit = mix(audit, 639513798, 6089)
    audit = mix(audit, 1, 6089)
    audit = mix(audit, 16, 6089)
    audit = mix(audit, 255, 6089)
    if audit != 995615032 { return 2 }

    var entry: i64 = 101
    entry = mix(entry, 145, 1103)
    entry = mix(entry, receipt, 1103)
    entry = mix(entry, audit, 1103)
    entry = mix(entry, 1, 1103)
    entry = mix(entry, 145, 1103)
    if entry != 394497389 { return 3 }

    var manifest: i64 = 107
    manifest = mix(manifest, 142, 1151)
    manifest = mix(manifest, 146, 1151)
    manifest = mix(manifest, 730796448, 1151)
    manifest = mix(manifest, 246755403, 1151)
    manifest = mix(manifest, entry, 1151)
    if manifest != 976586199 { return 4 }

    var result: i64 = 131
    result = mix(result, 142, 1871)
    result = mix(result, 146, 1871)
    result = mix(result, 10, 1871)
    result = mix(result, 134, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, manifest, 1871)
    if result != 564801070 { return 5 }

    var family: i64 = 149
    family = mix(family, 142, 1907)
    family = mix(family, 146, 1907)
    family = mix(family, 6, 1907)
    family = mix(family, 4, 1907)
    family = mix(family, 3, 1907)
    family = mix(family, 2, 1907)
    family = mix(family, 129, 1907)
    family = mix(family, 2, 1907)
    family = mix(family, manifest, 1907)
    if family != 449107390 { return 6 }

    var acceptance: i64 = 137
    acceptance = mix(acceptance, 142, 1889)
    acceptance = mix(acceptance, manifest, 1889)
    acceptance = mix(acceptance, result, 1889)
    if acceptance != 327543567 { return 7 }

    var audit_receipt: i64 = 157
    audit_receipt = mix(audit_receipt, 142, 1931)
    audit_receipt = mix(audit_receipt, manifest, 1931)
    audit_receipt = mix(audit_receipt, result, 1931)
    audit_receipt = mix(audit_receipt, family, 1931)
    audit_receipt = mix(audit_receipt, acceptance, 1931)
    if audit_receipt != 790297139 { return 8 }

    var readiness: i64 = 163
    readiness = mix(readiness, 142, 1951)
    readiness = mix(readiness, 31, 1951)
    readiness = mix(readiness, manifest, 1951)
    readiness = mix(readiness, result, 1951)
    readiness = mix(readiness, family, 1951)
    readiness = mix(readiness, acceptance, 1951)
    readiness = mix(readiness, audit_receipt, 1951)
    if readiness != 97103871 { return 9 }
    return 0
}
