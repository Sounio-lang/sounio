//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: ALIASRET 2.500000 0.040000
//@ expect-stdout-contains: ALIAS2RET 4.000000
//@ expect-stdout-contains: 2.500000
//
// No Knowledge arithmetic here: a function declared `-> Alias` with
// `type Alias = Knowledge[f64]` (and an alias of an alias) must be classified
// as Knowledge by the lowerer, so `.value`, `.variance` and println of the
// call result resolve. Before, the return type stayed an opaque named type and
// println was refused as an unresolved scalar kind.

type Dose = Knowledge[f64];
type Dose2 = Dose;

fn pick(flag: bool) -> Dose with Panic {
    let a: Knowledge[f64] = measure(2.5, uncertainty: 0.2)
    let b: Knowledge[f64] = measure(1.0, uncertainty: 0.1)
    if flag { a } else { b }
}

fn pick2() -> Dose2 with Panic {
    let c: Knowledge[f64] = measure(4.0, uncertainty: 0.3)
    c
}

fn main() -> i64 with IO, Epistemic, Panic {
    let p = pick(true)
    print("ALIASRET "); print_f64(p.value); print(" "); print_f64(p.variance); print("\n")
    let q = pick2()
    print("ALIAS2RET "); print_f64(q.value); print("\n")
    println(pick(true).value)
    0
}
