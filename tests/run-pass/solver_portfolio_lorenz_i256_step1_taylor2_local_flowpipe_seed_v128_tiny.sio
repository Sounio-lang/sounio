//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v128 smoke for Lorenz i256 step-1 Taylor-2 local flowpipe seed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2099
    receipt_fp = mix(receipt_fp, 301347724, 6121)
    receipt_fp = mix(receipt_fp, 777254975, 6121)
    receipt_fp = mix(receipt_fp, 839567289, 6121)
    receipt_fp = mix(receipt_fp, 443349153, 6121)
    receipt_fp = mix(receipt_fp, 251844917, 6121)
    receipt_fp = mix(receipt_fp, 660429472, 6121)
    receipt_fp = mix(receipt_fp, 510854875, 6121)
    receipt_fp = mix(receipt_fp, 887056435, 6121)
    receipt_fp = mix(receipt_fp, 769531137, 6121)
    receipt_fp = mix(receipt_fp, 335080767, 6121)
    receipt_fp = mix(receipt_fp, 899209716, 6121)
    receipt_fp = mix(receipt_fp, 1, 6121)
    receipt_fp = mix(receipt_fp, 18, 6121)
    receipt_fp = mix(receipt_fp, 255, 6121)
    if receipt_fp != 824834880 { return 1 }

    var audit_fp: i64 = 2111
    audit_fp = mix(audit_fp, receipt_fp, 6131)
    audit_fp = mix(audit_fp, 301347724, 6131)
    audit_fp = mix(audit_fp, 777254975, 6131)
    audit_fp = mix(audit_fp, 538682593, 6131)
    audit_fp = mix(audit_fp, 591327954, 6131)
    audit_fp = mix(audit_fp, 660429472, 6131)
    audit_fp = mix(audit_fp, 510854875, 6131)
    audit_fp = mix(audit_fp, 335080767, 6131)
    audit_fp = mix(audit_fp, 899209716, 6131)
    audit_fp = mix(audit_fp, 887056435, 6131)
    audit_fp = mix(audit_fp, 769531137, 6131)
    audit_fp = mix(audit_fp, 251844917, 6131)
    audit_fp = mix(audit_fp, 1, 6131)
    audit_fp = mix(audit_fp, 18, 6131)
    audit_fp = mix(audit_fp, 255, 6131)
    if audit_fp != 262282451 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 131, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 131, 1103)
    if entry_fp != 120130225 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 128, 1151)
    manifest_fp = mix(manifest_fp, 132, 1151)
    manifest_fp = mix(manifest_fp, 443349153, 1151)
    manifest_fp = mix(manifest_fp, 839567289, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 123836674 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 128, 1871)
    result_fp = mix(result_fp, 132, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 120, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 229786945 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 128, 1907)
    family_fp = mix(family_fp, 132, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 115, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 914112913 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 128, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 497055835 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 128, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 442075876 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 128, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 506855028 { return 9 }

    return 0
}
