//@ run-pass
// Test hessian_wrt(z, x, y): second-order AD indexed by source identity.
// Port of epistemic_hessian_of.sio from the deprecated positional form.
//   f(x, y) = x * y  =>  H[x,y] = 1, H[x,x] = 0, H[y,y] = 0
//   f(x) = x * x    =>  H[x,x] = 2
//   f(x, y) = x * x * y  =>  H[x,x] = 2y, H[x,y] = 2x, H[y,y] = 0

fn test_xy() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(5.0, uncertainty: 0.0)
    let x = xm.value
    let y = ym.value
    let z = x * y
    hessian_wrt(z, xm, ym)  // ∂²(x*y)/∂x∂y = 1
}

fn test_xx() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let x = xm.value
    let z = x * x
    hessian_wrt(z, xm, xm)  // ∂²(x²)/∂x² = 2
}

fn test_xxy() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(5.0, uncertainty: 0.0)
    let x = xm.value
    let y = ym.value
    let z = x * x * y
    hessian_wrt(z, xm, xm)  // ∂²(x²y)/∂x² = 2y = 10.0
}

fn main() with IO, Epistemic {
    let h01 = test_xy()
    let h00_xx = test_xx()
    let h00_xxy = test_xxy()
    println(h01)      // expect 1.0
    println(h00_xx)   // expect 2.0
    println(h00_xxy)  // expect 10.0
}
