//@ run-pass
//@ requires: madaros
use crypto::chacha20::*

fn main() -> i64 with IO {
    // RFC 8439 section 2.3.2's worked ChaCha20 block-function example.
    // Independently re-fetched and re-verified against the RFC's primary
    // text on 2026-08-25: key is 00..1f sequential, nonce and counter come
    // from the RFC's specific example -- counter=1, NOT counter=0. The
    // RFC prints the keystream as 32-bit little-endian words in hex
    // (e.g. word 0 = e4e7f110), which serializes to bytes 10,f1,e7,e4 --
    // matching this `expected` array's first four bytes.
    let key: [u8;32] = [
        0x00,0x01,0x02,0x03,0x04,0x05,0x06,0x07,
        0x08,0x09,0x0a,0x0b,0x0c,0x0d,0x0e,0x0f,
        0x10,0x11,0x12,0x13,0x14,0x15,0x16,0x17,
        0x18,0x19,0x1a,0x1b,0x1c,0x1d,0x1e,0x1f
    ]
    let nonce: [u8;12] = [
        0x00,0x00,0x00,0x09,0x00,0x00,0x00,0x4a,0x00,0x00,0x00,0x00
    ]
    let counter: i64 = 1
    let expected: [u8;64] = [
        0x10,0xf1,0xe7,0xe4,0xd1,0x3b,0x59,0x15,0x50,0x0f,0xdd,0x1f,0xa3,0x20,0x71,0xc4,
        0xc7,0xd1,0xf4,0xc7,0x33,0xc0,0x68,0x03,0x04,0x22,0xaa,0x9a,0xc3,0xd4,0x6c,0x4e,
        0xd2,0x82,0x64,0x46,0x07,0x9f,0xaa,0x09,0x14,0xc2,0xd7,0x05,0xd9,0x8b,0x02,0xa2,
        0xb5,0x12,0x9c,0xd1,0xde,0x16,0x4e,0xb9,0xcb,0xd0,0x83,0xe8,0xa2,0x50,0x3c,0x4e
    ]

    let block = chacha20_block(&key, counter, &nonce)
    var i: i64 = 0
    while i < 64 {
        if block[i as usize] != expected[i as usize] {
            print_int(1)
            return 1
        }
        i = i + 1
    }

    println("chacha20_block: matches RFC 8439 section 2.3.2's published test vector")
    return 0
}
