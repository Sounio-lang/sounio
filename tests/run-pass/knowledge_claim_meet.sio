//@ run-pass
//@ requires: madaros
//@ expect-stdout: CLAIM_MEET_OK
// claim_meet is not about hydrogen. Two models of one product, read off the
// same Knowledge before and after correlate. The shared bar is the overlap.
// The excess is what only one model claims.
// The clock for the moments is the product rule written below.

use epistemic::claim_meet::{claim_meet, ClaimMeet}

ontology Lab {
    class Thing { property amount: f64 where amount >= 0.0 }
    class Feed subclass_of Thing
    class Whole subclass_of Thing
    disjoint Feed, Whole
}

struct Out {
    whole: Knowledge[Whole, ValidUntil("2026-12-31"), epsilon < 0.05, Derived]
}

fn prod(a: Knowledge<Feed>, b: Knowledge<f64>) -> Out with Epistemic, Mut, Div {
    let x: f64 = a.value
    let y: f64 = b.value
    let p: f64 = x * y
    let w: Whole = p
    Out {
        whole: Knowledge { value: w, epsilon: 0.01, validity: "2027-06-30", provenance: "cell" }
    }
}

fn claim_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 40 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let bars = claim_meet(0.0, 4.0, 0.0, 1.0)
    let apart = claim_meet(0.0, 1.0, 10.0, 1.0)
    let a0: f64 = 10.0
    let b0: f64 = 2.0
    let a: Knowledge<Feed> = measure(a0, uncertainty: 0.1)
    let b: Knowledge<f64> = measure(b0, uncertainty: 0.2)
    let named = prod(a, b)
    let m0 = second_order_mean(named.whole.value)
    let v0 = variance_of(named.whole.value)
    let xa: f64 = a.value
    let yb: f64 = b.value
    let _rho = correlate(xa, yb, 1.0)
    let m1 = second_order_mean(named.whole.value)
    let v1 = variance_of(named.whole.value)
    let meet = claim_meet(m0, v0, m1, v1)
    let var0 = 4.04
    let var1 = 4.84
    let mean0 = 20.0
    let mean1 = 20.02
    let s0 = claim_sqrt(var0)
    let s1 = claim_sqrt(var1)
    var lo = mean0 - s0
    if mean1 - s1 > lo { lo = mean1 - s1 }
    var hi = mean0 + s0
    if mean1 + s1 < hi { hi = mean1 + s1 }
    print("m0 ")
    print_f64(m0)
    print(" m1 ")
    print_f64(m1)
    print(" v0 ")
    print_f64(v0)
    print(" v1 ")
    print_f64(v1)
    print(" lo ")
    print_f64(meet.lo)
    print(" hi ")
    print_f64(meet.hi)
    print(" excess ")
    print_f64(meet.excess)
    print("\n")
    if bars.shared && near(bars.lo, 0.0 - 1.0, 0.0001) && near(bars.hi, 1.0, 0.0001) && near(bars.excess, 2.0, 0.0001) && !apart.shared && near(v0, var0, 0.001) && near(v1, var1, 0.001) && near(m0, mean0, 0.001) && near(m1, mean1, 0.001) && meet.shared && near(meet.lo, lo, 0.001) && near(meet.hi, hi, 0.001) && near(meet.excess, 2.0 * (s1 - s0), 0.001) {
        println("CLAIM_MEET_OK")
        return 0
    }
    println("CLAIM_MEET_FAIL")
    1
}
