//@ run-pass
//@ expect-stdout: after block 7 10
//@ description: A block `{ ... }` used as a statement or as a value. lean_single read the `{` as 0, compiled the block's statements as if they followed it, and let its `}` close the function: every statement after the block disappeared.

fn main() with IO {
    var x: i64 = 1
    {
        let y = 2
        x = x + y
    }
    {}
    x = { x + 4 }
    let z = if x > 1 { { 10 } } else { { 20 } }
    print("after block ")
    print_int(x)
    print(" ")
    print_int(z)
    println("")
}
