//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 Taylor/ball bridge binds dependency-DAG, enclosure, and radius-budget receipts

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let fp = lorenz_i256_taylor_ball_bridge_fingerprint(
        214180161, 713010204, 114244647, 166945519,
        87220662, 677514412, 69322697,
        1000000, 5, 2, 1, 100, 256, 32, 184,
        243366, 319640, 42448,
        250000, 325000, 50000, 127)
    if fp != 979362768 { return 1 }

    let audit_fp = lorenz_i256_taylor_ball_bridge_audit_fingerprint(
        fp, 725222703, 845057161, 114244647, 166945519, 2, 127)
    if audit_fp != 927174126 { return 2 }
    return 0
}
