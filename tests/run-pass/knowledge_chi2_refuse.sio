//@ run-pass
//@ requires: madaros
//@ expect-stdout: CHI2_REFUSE_OK
// The 5% point for any degrees of freedom is the chi-square quantile.
// Two degrees of freedom must reproduce -2 ln(0.05). A degree the old
// function left open, six, now refuses a sum past that point.

use stats::chi_square::{chi2_quantile}
use epistemic::regression::fit_centre_refused

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn bit(b: bool) -> i64 {
    if b { return 1 }
    0
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let q1 = chi2_quantile(0.95, 1.0)
    let q2 = chi2_quantile(0.95, 2.0)
    let q3 = chi2_quantile(0.95, 3.0)
    let q4 = chi2_quantile(0.95, 4.0)
    let q5 = chi2_quantile(0.95, 5.0)
    let q6 = chi2_quantile(0.95, 6.0)
    let q10 = chi2_quantile(0.95, 10.0)
    let exact2 = 0.0 - 2.0 * log(0.05)
    let pins = near(q1, 3.841458820694124, 1.0e-6) && near(q2, exact2, 1.0e-9) && near(q3, 7.814727903251172, 1.0e-9) && near(q4, 9.487729036781154, 1.0e-8) && near(q5, 11.070497693516351, 1.0e-8) && near(q6, 12.591587243743977, 1.0e-8) && near(q10, 18.307038053275146, 1.0e-8)
    let below6 = fit_centre_refused((q6 - 1.0e-4) / 6.0, 6.0, 298.15, 398.0, 498.0)
    let above6 = fit_centre_refused((q6 + 1.0e-4) / 6.0, 6.0, 298.15, 398.0, 498.0)
    let inside6 = fit_centre_refused(1000.0, 6.0, 448.0, 398.0, 498.0)
    let dead = fit_centre_refused(1000.0, 0.0, 298.15, 398.0, 498.0)
    let above1 = fit_centre_refused(q1 + 1.0e-4, 1.0, 298.15, 398.0, 498.0)
    let above10 = fit_centre_refused((q10 + 1.0e-4) / 10.0, 10.0, 298.15, 398.0, 498.0)
    if pins && !below6 && above6 && !inside6 && !dead && above1 && above10 && bit(above6) == 1 {
        println("CHI2_REFUSE_OK")
        return 0
    }
    println("CHI2_REFUSE_FAIL")
    1
}
