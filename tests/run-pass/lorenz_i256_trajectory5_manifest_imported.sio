//@ run-pass
//@ requires: madaros
//@ description: Imported systems::lorenz_i256_cert five-step trajectory manifest smoke

use systems::lorenz_i256_cert::*

fn main() -> i64 with Mod {
    if lorenz_i256_cert_ready() != 1 { return 1 }

    let manifest_fp = lorenz_i256_trajectory5_manifest_fingerprint(
        32, 42949672, 96, 5,
        4294967296, 4294967296, 4294967296,
        23144051, 561641681,
        5309941770, 10058731223, 4084837935)
    if manifest_fp != 214180161 { return 2 }

    if lorenz_i256_trajectory5_manifest_valid(
        32, 42949672, 96, 5, 23144051, 561641681,
        manifest_fp) != 1 { return 3 }

    if lorenz_i256_trajectory5_manifest_fingerprint(
        32, 42949672, 96, 5,
        4294967296, 4294967296, 4294967296,
        23144052, 561641681,
        5309941770, 10058731223, 4084837935) == manifest_fp { return 4 }
    if lorenz_i256_trajectory5_manifest_fingerprint(
        32, 42949672, 96, 5,
        4294967296, 4294967296, 4294967296,
        23144051, 561641681,
        5309941770, 10058731224, 4084837935) != (0 - 1) { return 5 }
    if lorenz_i256_trajectory5_manifest_valid(
        32, 42949672, 96, 4, 23144051, 561641681,
        manifest_fp) != 0 { return 6 }

    return 0
}
