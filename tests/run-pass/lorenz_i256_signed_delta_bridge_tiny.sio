//@ run-pass
//@ description: Self-contained Lorenz i256 signed delta bridge smoke

fn base() -> i64 { return 1000000000 }

fn limb_ok(x: i64) -> i64 {
    if x < 0 { return 0 }
    if x >= base() { return 0 }
    return 1
}

fn inputs_ok(a0: i64, a1: i64, a2: i64, a3: i64, b0: i64, b1: i64, b2: i64, b3: i64) -> i64 {
    if limb_ok(a0) != 1 { return 0 }
    if limb_ok(a1) != 1 { return 0 }
    if limb_ok(a2) != 1 { return 0 }
    if limb_ok(a3) != 1 { return 0 }
    if limb_ok(b0) != 1 { return 0 }
    if limb_ok(b1) != 1 { return 0 }
    if limb_ok(b2) != 1 { return 0 }
    if limb_ok(b3) != 1 { return 0 }
    return 1
}

fn cmp_dec4(a0: i64, a1: i64, a2: i64, a3: i64, b0: i64, b1: i64, b2: i64, b3: i64) -> i64 {
    if inputs_ok(a0, a1, a2, a3, b0, b1, b2, b3) != 1 { return 0 - 2 }
    if a3 > b3 { return 1 }
    if a3 < b3 { return 0 - 1 }
    if a2 > b2 { return 1 }
    if a2 < b2 { return 0 - 1 }
    if a1 > b1 { return 1 }
    if a1 < b1 { return 0 - 1 }
    if a0 > b0 { return 1 }
    if a0 < b0 { return 0 - 1 }
    return 0
}

fn main() -> i64 {
    let positive_sign = cmp_dec4(150000000, 1, 0, 0, 950000000, 0, 0, 0)
    if positive_sign != 1 { return 1 }

    let negative_sign = cmp_dec4(950000000, 0, 0, 0, 150000000, 1, 0, 0)
    if negative_sign != 0 - 1 { return 2 }

    let zero_sign = cmp_dec4(950000000, 0, 0, 0, 950000000, 0, 0, 0)
    if zero_sign != 0 { return 3 }

    let invalid_sign = cmp_dec4(1000000000, 0, 0, 0, 0, 0, 0, 0)
    if invalid_sign != 0 - 2 { return 4 }

    let artifact_fp: i64 = 492681735
    let audit_fp: i64 = 837260419
    let instance_fp: i64 = 604913728
    let certificate_fp: i64 = 195740286
    let target_integer_width: i64 = 256
    let limb_base_value: i64 = 1000000000
    let native_i256_evidence_mask: i64 = 0
    let imported_runtime_evidence_mask: i64 = 0
    let public_claim_mask: i64 = 0
    let formal_theorem_ready: i64 = 0
    let bridge_status: i64 = 104
    let ok_mask: i64 = 1023

    if artifact_fp != 492681735 { return 5 }
    if audit_fp != 837260419 { return 6 }
    if instance_fp != 604913728 { return 7 }
    if certificate_fp != 195740286 { return 8 }
    if target_integer_width != 256 { return 9 }
    if limb_base_value != 1000000000 { return 10 }
    if native_i256_evidence_mask != 0 { return 11 }
    if imported_runtime_evidence_mask != 0 { return 12 }
    if public_claim_mask != 0 { return 13 }
    if formal_theorem_ready != 0 { return 14 }
    if bridge_status != 104 { return 15 }
    if ok_mask != 1023 { return 16 }
    return 0
}
