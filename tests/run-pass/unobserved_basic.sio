//@ run-pass
// Test: Unobserved<f64> type resolves and can be observed via comparison

fn sense() -> Unobserved<f64> with Observe {
    // Simulate a sensor reading (returns Unobserved)
    let raw: f64 = 37.2
    raw
}

fn analyze(x: f64) -> f64 {
    // Pure function: no Observe needed, operates on observed value
    x * 2.0
}

fn main() -> i32 with IO, Observe {
    let reading = sense()
    // Comparison triggers observation — requires with Observe
    if reading > 36.0 {
        println("observed: above threshold")
    }
    let result = analyze(37.2)
    println("analysis complete")
    0
}
