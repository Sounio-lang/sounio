//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-4 local-flowpipe preflight receipt

fn child4_local_flowpipe_preflight_check(
    child4_obligation_seed_fp: i64,
    child4_obligation_seed_audit_fp: i64,
    child3_discharge_preflight_fp: i64,
    child3_discharge_preflight_audit_fp: i64,
    five_step_local_flowpipe_chain_fp: i64,
    five_step_local_flowpipe_chain_audit_fp: i64,
    child_index: i64,
    slot_x: i64,
    slot_y: i64,
    slot_z: i64,
    global_flowpipe_claim_mask: i64,
    preflight_status: i64) -> i64 {
    if child4_obligation_seed_fp != 17166205 { return 0 - 1 }
    if child4_obligation_seed_audit_fp != 78794130 { return 0 - 1 }
    if child3_discharge_preflight_fp != 57643306 { return 0 - 1 }
    if child3_discharge_preflight_audit_fp != 784781218 { return 0 - 1 }
    if five_step_local_flowpipe_chain_fp != 911209450 { return 0 - 1 }
    if five_step_local_flowpipe_chain_audit_fp != 709377850 { return 0 - 1 }
    if child_index != 4 { return 0 - 1 }
    if slot_x != 0 { return 0 - 1 }
    if slot_y != 0 { return 0 - 1 }
    if slot_z != 1 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if preflight_status != 73 { return 0 - 1 }
    return 886312874
}

fn main() -> i64 {
    let artifact = child4_local_flowpipe_preflight_check(
        17166205, 78794130, 57643306, 784781218, 911209450, 709377850,
        4, 0, 0, 1, 0, 73)
    if artifact != 886312874 { return 1 }

    let audit_fp: i64 = 82275288
    let instance_fp: i64 = 635431038
    let certificate_fp: i64 = 801960582
    let selected_child_mask: i64 = 16
    let prior_child_validated_mask: i64 = 15
    let pending_child_validation_mask: i64 = 16
    let local_flowpipe_preflight_mask: i64 = 31
    let proof_dependency_mask: i64 = 31
    let available_local_chain_mask: i64 = 31
    let pending_local_proof_mask: i64 = 31
    let local_flowpipe_proof_mask: i64 = 0
    let child_validated_mask: i64 = 0
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0
    let preflight_status: i64 = 73
    let ok_mask: i64 = 255

    if audit_fp != 82275288 { return 2 }
    if instance_fp != 635431038 { return 3 }
    if certificate_fp != 801960582 { return 4 }
    if selected_child_mask != 16 { return 5 }
    if prior_child_validated_mask != 15 { return 6 }
    if pending_child_validation_mask != 16 { return 7 }
    if local_flowpipe_preflight_mask != 31 { return 8 }
    if proof_dependency_mask != 31 { return 9 }
    if available_local_chain_mask != 31 { return 10 }
    if pending_local_proof_mask != 31 { return 11 }
    if local_flowpipe_proof_mask != 0 { return 12 }
    if child_validated_mask != 0 { return 13 }
    if child_discharge_mask != 0 { return 14 }
    if global_cover_certificate_mask != 0 { return 15 }
    if global_flowpipe_claim_mask != 0 { return 16 }
    if preflight_status != 73 { return 17 }
    if ok_mask != 255 { return 18 }

    let wrong_slot = child4_local_flowpipe_preflight_check(
        17166205, 78794130, 57643306, 784781218, 911209450, 709377850,
        4, 1, 0, 0, 0, 73)
    if wrong_slot != 0 - 1 { return 19 }

    let wrong_chain = child4_local_flowpipe_preflight_check(
        17166205, 78794130, 57643306, 784781218, 1, 709377850,
        4, 0, 0, 1, 0, 73)
    if wrong_chain != 0 - 1 { return 20 }

    let overclaim = child4_local_flowpipe_preflight_check(
        17166205, 78794130, 57643306, 784781218, 911209450, 709377850,
        4, 0, 0, 1, 1, 73)
    if overclaim != 0 - 1 { return 21 }

    return 0
}
