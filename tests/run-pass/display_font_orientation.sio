//@ run-pass
//@ expect-stdout: DISPLAY_FONT_ORIENTATION_PASS
// Source/backend parity and primary font orientation are checked independently.
// Dumps precede the final canonical anchor so the before-control remains auditable.
use display::font::{font_glyph,font_draw_char}
use display::canvas::{Canvas,canvas_clear,canvas_draw_char,canvas_draw_text}
fn font_dump_grid(c:&Canvas,kind:i64) with IO,Mut {
 let w:i64=c.width;let h:i64=c.height
 print("FONT_GRID ");print(kind);print(" ");print(w);print(" ");println(h)
 var i:i64=0
 while i<w*h {
  let value:i64=read_i64(c.pixels,i)
  print("FONT_PIXEL ");print(kind);print(" ");print(i);print(" ");println(value)
  i=i+1
 }
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let pixels=heap_alloc(128*48*8) as *mut i64
 assert((pixels as i64)>0)
 var canvas=Canvas{pixels:pixels,width:128,height:48}
 canvas_clear(&!canvas,0,0,0)
 var ch:i64=32
 while ch<128 {
  let glyph:i64=font_glyph(ch)
  print("FONT_GLYPH ");print(ch);print(" ");println(glyph)
  let x:i64=((ch-32)%16)*8;let y:i64=((ch-32)/16)*8
  canvas_draw_char(&!canvas,ch,x,y,255,255,255)
  ch=ch+1
 }
 font_dump_grid(&canvas,0)
 let anchor:i64=read_i64(canvas.pixels,(((53-32)/16)*8)*128+(((53-32)%16)*8))
 heap_free(canvas.pixels as *mut i8)
 let clipped_pixels=heap_alloc(16*16*8) as *mut i64
 assert((clipped_pixels as i64)>0)
 var clipped=Canvas{pixels:clipped_pixels,width:16,height:16}
 canvas_clear(&!clipped,0,0,0)
 font_draw_char(clipped.pixels,16,16,70,-3,-2,255,255,255)
 canvas_draw_char(&!clipped,53,13,14,255,255,255)
 font_dump_grid(&clipped,1)
 heap_free(clipped.pixels as *mut i8)
 let text_pixels=heap_alloc(24*18*8) as *mut i64
 assert((text_pixels as i64)>0)
 var text_canvas=Canvas{pixels:text_pixels,width:24,height:18}
 canvas_clear(&!text_canvas,0,0,0)
 var text:[i8;256]=[0;256]
 text[0]=70;text[1]=53;text[2]=10;text[3]=60;text[4]=76
 canvas_draw_text(&!text_canvas,&text,5,0,0,255,255,255)
 font_dump_grid(&text_canvas,2)
 heap_free(text_canvas.pixels as *mut i8)
 assert(font_glyph(31)==0 && font_glyph(128)==0 && font_glyph(-1)==0)
 println("FONT_NATIVE_DUMP_COMPLETE")
 // Pinned primary glyph5 top row0x3f, bit0 left. Old mixed/MSB font fails here.
 assert(anchor==16777215)
 println("DISPLAY_FONT_ORIENTATION_PASS")
 0
}
