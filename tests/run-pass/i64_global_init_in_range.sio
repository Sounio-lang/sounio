//@ run-pass
//@ requires: madaros
//@ expect-stdout: a=9223372036854775807
//@ expect-stdout: b=9223372030926249001
//@ expect-stdout: c=-9223372036854775808
//@ expect-stdout: d=-9223372036854775808
//@ expect-stdout: e=-9223372036854775808
//@ expect-stdout: f=-9223372036854775808
// ADR-031 R1: module-level i64 initializers at the edge of the range still
// compile and keep their value; only a result outside i64 is E300
// (tests/compile-fail/i64_global_{let,var}_init_overflow.sio). D, e and f are
// products that land exactly on MIN: the fits test once refused them.
let A: i64 = 9223372036854775806 + 1
var B: i64 = 3037000499 * 3037000499
let C: i64 = 0 - 9223372036854775807 - 1
var D: i64 = -4611686018427387904 * 2

fn main() -> i64 with IO {
    print("a=")
    print_int(A)
    println("")
    print("b=")
    print_int(B)
    println("")
    print("c=")
    print_int(C)
    println("")
    print("d=")
    print_int(D)
    println("")
    let e: i64 = 4611686018427387904 * -2
    print("e=")
    print_int(e)
    println("")
    let f: i64 = (0 - 9223372036854775807 - 1) * 1
    print("f=")
    print_int(f)
    println("")
    0
}
