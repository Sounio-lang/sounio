//@ run-pass

// Inherent impl: methods on a struct without a trait.
// impl Point { fn magnitude(self: Point) -> f64 { ... } }
// Then: p.magnitude() dispatches via FN_RECV_HASH.

struct Point { x: f64, y: f64 }

impl Point {
    fn get_x(self: Point) -> f64 {
        self.x
    }
}

fn main() -> i64 with IO {
    let p = Point { x: 3.0, y: 4.0 }
    let x = p.get_x()
    0
}
