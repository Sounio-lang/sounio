//@ run-pass
//@ requires:madaros
// Wave10: pure zero-arg call in global element-list init folds to real BSS words.
// Pre-wave10 residual: `[ten(), 20, 30]` was fail-closed BSS zero (honest, incomplete).
// Must never left-shift remaining const words (`20 30 0` silent miscompile).

fn ten() -> i64 {
    10
}

var A: [i64; 3] = [ten(), 20, 30]

fn main() -> i64 with IO {
    print_int(A[0])
    print(" ")
    print_int(A[1])
    print(" ")
    print_int(A[2])
    print("\n")
    if A[0] != 10 { return 1 }
    if A[1] != 20 { return 2 }
    if A[2] != 30 { return 3 }
    0
}
