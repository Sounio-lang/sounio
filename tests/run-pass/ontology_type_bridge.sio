//@ run-pass
// Test: ontology type bridge — subclass passes where superclass expected

ontology Biomedical {
    class ChemicalEntity
    class Drug subclass_of ChemicalEntity
    class Rapamycin subclass_of Drug
}

fn make_rapamycin() -> Rapamycin { 0 as Rapamycin }

fn process_drug(d: Drug) -> i32 with IO {
    println("processing drug")
    1
}

fn process_chemical(c: ChemicalEntity) -> i32 with IO {
    println("processing chemical")
    1
}

fn main() -> i32 with IO {
    let r: Rapamycin = make_rapamycin()
    // Rapamycin is subclass of Drug — should compile
    process_drug(r)
    // Rapamycin is subclass of ChemicalEntity (transitive) — should compile
    process_chemical(r)
    println("ontology type bridge OK")
    0
}

// Construtor da classe de ontologia, no mesmo idioma de `make_dog` em
// ontology_complex_hierarchy.sio. Faltava, e o E201 (28-ago-2026) o revelou: a chamada virava
// `xor eax,eax` e o teste "passava" sem nunca instanciar nada.
fn make_rapamycin() -> Rapamycin { 0 as Rapamycin }
