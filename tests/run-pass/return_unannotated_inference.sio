//@ run-pass
//@ requires: madaros
//@ description: Closing `return <expr>` in an unannotated function must not close the
//@ forms that stay legal: a trailing expression still infers the return type and is
//@ still usable at the call site, a bare `return` is still legal, and a closure that
//@ declares its own return type may still return a value even when the function
//@ enclosing it declares none. Companion to tests/ui/type/return_value_in_unannotated_fn.sio.

fn trailing() { 42 }

fn bare_return() with IO {
    println("bare return ok")
    return
}

fn closure_host() -> f64 {
    let square = |x: f64| -> f64 { return x * x }
    square(3.0)
}

fn main() -> i32 with IO {
    // Binding the call proves the unannotated return type is still usable at the
    // call site. Its VALUE is deliberately not asserted: an unannotated function's
    // inferred return is accepted by the checker but does not reach the caller at
    // runtime (this binding observes 0, not 42), on Madaros and lean_single alike.
    // That gap is orthogonal to the return-statement rule under test here.
    let _v: i64 = trailing()
    bare_return()
    let sq = closure_host()
    if sq > 8.9 && sq < 9.1 {
        println("ALL PASS")
    }
    return 0
}
