    version: i64,
    entry_count: i64,
    sat_family_count: i64,
    smt_family_count: i64,
    pb_family_count: i64,
    graph_family_count: i64,
    lorenz_family_count: i64,
    manifest_fp: i64) -> i64 with Mod {
    if version != 16 { return 0 - 1 }
    if entry_count != 20 { return 0 - 1 }
    if sat_family_count != 4 { return 0 - 1 }
    if smt_family_count != 2 { return 0 - 1 }
    if pb_family_count != 2 { return 0 - 1 }
    if graph_family_count != 1 { return 0 - 1 }
    if lorenz_family_count != 11 { return 0 - 1 }
    if manifest_fp != 320118125 { return 0 - 1 }

    var fp: i64 = 149
    fp = compose_mix(fp, version, 1907)
    fp = compose_mix(fp, entry_count, 1907)
    fp = compose_mix(fp, sat_family_count, 1907)
    fp = compose_mix(fp, smt_family_count, 1907)
    fp = compose_mix(fp, pb_family_count, 1907)
    fp = compose_mix(fp, graph_family_count, 1907)
    fp = compose_mix(fp, lorenz_family_count, 1907)
    fp = compose_mix(fp, manifest_fp, 1907)
    return fp
}

fn portfolio_v16_acceptance_receipt_fingerprint(version: i64,
                                                manifest_fp: i64,
                                                coverage_fp: i64) -> i64 with Mod {
    if version != 16 { return 0 - 1 }
    if manifest_fp != 320118125 { return 0 - 1 }
    if coverage_fp != 685105937 { return 0 - 1 }

    var fp: i64 = 137
    fp = compose_mix(fp, version, 1889)
    fp = compose_mix(fp, manifest_fp, 1889)
    fp = compose_mix(fp, coverage_fp, 1889)
    return fp
}

fn portfolio_v16_audit_receipt_fingerprint(version: i64,
                                           manifest_fp: i64,
                                           result_coverage_fp: i64,
                                           family_coverage_fp: i64,
                                           acceptance_receipt_fp: i64) -> i64 with Mod {
    if version != 16 { return 0 - 1 }
    if manifest_fp != 320118125 { return 0 - 1 }
    if result_coverage_fp != 685105937 { return 0 - 1 }
    if family_coverage_fp != 210011781 { return 0 - 1 }
    if acceptance_receipt_fp != 629028996 { return 0 - 1 }

    var fp: i64 = 157
    fp = compose_mix(fp, version, 1931)
    fp = compose_mix(fp, manifest_fp, 1931)
    fp = compose_mix(fp, result_coverage_fp, 1931)
    fp = compose_mix(fp, family_coverage_fp, 1931)
    fp = compose_mix(fp, acceptance_receipt_fp, 1931)
    return fp
}

fn portfolio_v16_readiness_mask(version: i64,
                                manifest_fp: i64,
                                result_coverage_fp: i64,
                                family_coverage_fp: i64,
                                acceptance_receipt_fp: i64,
                                audit_receipt_fp: i64) -> i64 {
    if version != 16 { return 0 - 1 }
    var mask: i64 = 0
    if manifest_fp == 320118125 { mask = mask + 1 }
    if result_coverage_fp == 685105937 { mask = mask + 2 }
    if family_coverage_fp == 210011781 { mask = mask + 4 }
    if acceptance_receipt_fp == 629028996 { mask = mask + 8 }
    if audit_receipt_fp == 932551699 { mask = mask + 16 }
    return mask
}

fn portfolio_v16_readiness_fingerprint(version: i64,
                                       manifest_fp: i64,
                                       result_coverage_fp: i64,
                                       family_coverage_fp: i64,
                                       acceptance_receipt_fp: i64,
                                       audit_receipt_fp: i64) -> i64 with Mod {
    let readiness_mask = portfolio_v16_readiness_mask(
        version, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_receipt_fp, audit_receipt_fp)
    if readiness_mask != 31 { return 0 - 1 }

    var fp: i64 = 163
    fp = compose_mix(fp, version, 1951)
    fp = compose_mix(fp, readiness_mask, 1951)
    fp = compose_mix(fp, manifest_fp, 1951)
    fp = compose_mix(fp, result_coverage_fp, 1951)
    fp = compose_mix(fp, family_coverage_fp, 1951)
    fp = compose_mix(fp, acceptance_receipt_fp, 1951)
    fp = compose_mix(fp, audit_receipt_fp, 1951)
    return fp
}

fn main() -> i64 with Mod {
    let trajectory_manifest_fp = lorenz_i256_trajectory5_certificate_check(
        42949672, 96,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731223, 4084837935)
    if trajectory_manifest_fp != 214180161 { return 1 }

    let portfolio_fp = portfolio_v16_bundle_fingerprint(
        660429472, trajectory_manifest_fp, 827916944)
    if portfolio_fp != 320118125 { return 2 }

    let result_coverage_fp = portfolio_v16_result_coverage_fingerprint(
        16, 20, 7, 11, 1, 1, portfolio_fp)
    if result_coverage_fp != 685105937 { return 3 }

    let family_coverage_fp = portfolio_v16_checker_family_coverage_fingerprint(
        16, 20, 4, 2, 2, 1, 11, portfolio_fp)
    if family_coverage_fp != 210011781 { return 4 }

    let acceptance_fp = portfolio_v16_acceptance_receipt_fingerprint(
        16, portfolio_fp, result_coverage_fp)
    if acceptance_fp != 629028996 { return 5 }

    let audit_fp = portfolio_v16_audit_receipt_fingerprint(
        16, portfolio_fp, result_coverage_fp, family_coverage_fp, acceptance_fp)
    if audit_fp != 932551699 { return 6 }

    let readiness_fp = portfolio_v16_readiness_fingerprint(
        16, portfolio_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp)
    if readiness_fp != 589844740 { return 7 }

    if portfolio_v16_bundle_fingerprint(
        660429472, trajectory_manifest_fp + 1, 827916944) != (0 - 1) { return 8 }
    if portfolio_v16_bundle_fingerprint(
        660429472, trajectory_manifest_fp, 827916945) != (0 - 1) { return 9 }
    if lorenz_i256_trajectory5_certificate_check(
        42949672, 95,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731223, 4084837935) != (0 - 1) { return 10 }
    if portfolio_entry_fingerprint(
        14, 660429472, trajectory_manifest_fp, 0, 14) != (0 - 1) { return 11 }
    if lorenz_i256_trajectory5_certificate_check(
        42949672, 96,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731224, 4084837935) != (0 - 1) { return 12 }
    if portfolio_v16_checker_family_coverage_fingerprint(
        16, 20, 4, 2, 2, 1, 10, portfolio_fp) != (0 - 1) { return 13 }
    if portfolio_v16_readiness_fingerprint(
        16, portfolio_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp + 1) != (0 - 1) { return 14 }

    return 0
}
