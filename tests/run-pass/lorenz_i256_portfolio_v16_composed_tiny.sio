//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 trajectory certificate into portfolio v16 bundle composition smoke

fn compose_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn lorenz_i256_trajectory5_manifest_fingerprint(scale_log2: i64,
                                                 dt_q: i64, dt_r: i64,
                                                 step_count: i64,
                                                 initial_x: i64,
                                                 initial_y: i64,
                                                 initial_z: i64,
                                                 chain_anchor: i64,
                                                 final_step_certificate: i64,
                                                 final_x: i64,
                                                 final_y: i64,
                                                 final_z: i64) -> i64 with Mod {
    if scale_log2 != 32 { return 0 - 1 }
    if dt_q != 42949672 { return 0 - 1 }
    if dt_r != 96 { return 0 - 1 }
    if step_count != 5 { return 0 - 1 }
    if initial_x != 4294967296 { return 0 - 1 }
    if initial_y != 4294967296 { return 0 - 1 }
    if initial_z != 4294967296 { return 0 - 1 }
    if chain_anchor != 23144051 { return 0 - 1 }
    if final_step_certificate != 561641681 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }

    var fp: i64 = 191
    fp = compose_mix(fp, scale_log2, 1487)
    fp = compose_mix(fp, dt_q, 1487)
    fp = compose_mix(fp, dt_r, 1487)
    fp = compose_mix(fp, step_count, 1487)
    fp = compose_mix(fp, initial_x, 1487)
    fp = compose_mix(fp, initial_y, 1487)
    fp = compose_mix(fp, initial_z, 1487)
    fp = compose_mix(fp, chain_anchor, 1487)
    fp = compose_mix(fp, final_step_certificate, 1487)
    fp = compose_mix(fp, final_x, 1487)
    fp = compose_mix(fp, final_y, 1487)
    fp = compose_mix(fp, final_z, 1487)
    return fp
}

fn lorenz_i256_step5_certificate_fingerprint(start_x: i64, start_y: i64,
                                             start_z: i64, dy_scaled_q: i64,
                                             dy_scaled_r: i64, xy_scaled_q: i64,
                                             xy_scaled_r: i64, beta_q: i64,
                                             beta_r: i64, x_inc_q: i64,
                                             x_inc_r: i64, y_inc_q: i64,
                                             y_inc_r: i64, z_drop_q: i64,
                                             z_drop_r: i64, final_x: i64,
                                             final_y: i64, final_z: i64,
                                             all_divisions_ok: i64) -> i64 with Mod {
    if start_x != 4920371098 { return 0 - 1 }
    if start_y != 8816077911 { return 0 - 1 }
    if start_z != 4092986080 { return 0 - 1 }
    if dy_scaled_q != 133081411987 { return 0 - 1 }
    if dy_scaled_r != 405415232 { return 0 - 1 }
    if xy_scaled_q != 10099814960 { return 0 - 1 }
    if xy_scaled_r != 2149068118 { return 0 - 1 }
    if beta_q != 10914629546 { return 0 - 1 }
    if beta_r != 2 { return 0 - 1 }
    if x_inc_q != 389570672 { return 0 - 1 }
    if x_inc_r != 2544410448 { return 0 - 1 }
    if y_inc_q != 1242653312 { return 0 - 1 }
    if y_inc_r != 4228538720 { return 0 - 1 }
    if z_drop_q != 8148145 { return 0 - 1 }
    if z_drop_r != 2911449872 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }
    if all_divisions_ok != 1 { return 0 - 1 }

    var fp: i64 = 233
    fp = compose_mix(fp, start_x, 1601)
    fp = compose_mix(fp, start_y, 1601)
    fp = compose_mix(fp, start_z, 1601)
    fp = compose_mix(fp, dy_scaled_q, 1601)
    fp = compose_mix(fp, dy_scaled_r, 1601)
    fp = compose_mix(fp, xy_scaled_q, 1601)
    fp = compose_mix(fp, xy_scaled_r, 1601)
    fp = compose_mix(fp, beta_q, 1601)
    fp = compose_mix(fp, beta_r, 1601)
    fp = compose_mix(fp, x_inc_q, 1601)
    fp = compose_mix(fp, x_inc_r, 1601)
    fp = compose_mix(fp, y_inc_q, 1601)
    fp = compose_mix(fp, y_inc_r, 1601)
    fp = compose_mix(fp, z_drop_q, 1601)
    fp = compose_mix(fp, z_drop_r, 1601)
    fp = compose_mix(fp, final_x, 1601)
    fp = compose_mix(fp, final_y, 1601)
    fp = compose_mix(fp, final_z, 1601)
    fp = compose_mix(fp, all_divisions_ok, 1601)
    return fp
}

fn lorenz_i256_five_step_chain_fingerprint(step5_certificate_fp: i64,
                                           final_x: i64,
                                           final_y: i64,
                                           final_z: i64) -> i64 with Mod {
    if step5_certificate_fp != 561641681 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }

    var fp: i64 = 239
    fp = compose_mix(fp, 5, 1613)
    fp = compose_mix(fp, 510854875, 1613)
    fp = compose_mix(fp, 899209716, 1613)
    fp = compose_mix(fp, 603078026, 1613)
    fp = compose_mix(fp, 753371133, 1613)
    fp = compose_mix(fp, step5_certificate_fp, 1613)
    fp = compose_mix(fp, final_x, 1613)
    fp = compose_mix(fp, final_y, 1613)
    fp = compose_mix(fp, final_z, 1613)
    return fp
}

fn lorenz_i256_trajectory5_certificate_check(
    dt_q: i64, dt_r: i64,
    dy_scaled_q_i64: i64, dy_scaled_r_i64: i64,
    xy_scaled_q_i64: i64, xy_scaled_r_i64: i64,
    beta_q_i64: i64, beta_r_i64: i64,
    x_inc_q_i64: i64, x_inc_r_i64: i64,
    y_inc_q_i64: i64, y_inc_r_i64: i64,
    z_drop_q_i64: i64, z_drop_r_i64: i64,
    final_x_i64: i64, final_y_i64: i64,
    final_z_i64: i64) -> i64 with Mod {
    let scale: i256 = 4294967296 as i256
    let x4: i256 = 4920371098 as i256
    let y4: i256 = 8816077911 as i256
    let z4: i256 = 4092986080 as i256
    let dt: i256 = dt_q as i256
    let dy_scaled_q: i256 = dy_scaled_q_i64 as i256
    let xy_scaled_q: i256 = xy_scaled_q_i64 as i256
    let beta_q: i256 = beta_q_i64 as i256
    let x_inc_q: i256 = x_inc_q_i64 as i256
    let y_inc_q: i256 = y_inc_q_i64 as i256
    let z_drop_q: i256 = z_drop_q_i64 as i256

    let dx_num: i256 = (10 as i256) * (y4 - x4)
    let dy_num: i256 = x4 * ((28 as i256) * scale - z4)
    let xy_num: i256 = x4 * y4
    let beta_num_z: i256 = (8 as i256) * z4
    let dy: i256 = dy_scaled_q - y4
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    if check_div_witness_i256(scale, 100 as i256, dt, dt_r as i256) != 1 { return 0 - 1 }
    if check_div_witness_i256(dy_num, scale, dy_scaled_q, dy_scaled_r_i64 as i256) != 1 { return 0 - 1 }
    if check_div_witness_i256(xy_num, scale, xy_scaled_q, xy_scaled_r_i64 as i256) != 1 { return 0 - 1 }
    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r_i64 as i256) != 1 { return 0 - 1 }
    if check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r_i64 as i256) != 1 { return 0 - 1 }
    if check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r_i64 as i256) != 1 { return 0 - 1 }
    if check_div_witness_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r_i64 as i256) != 1 { return 0 - 1 }

    if x4 + x_inc_q != final_x_i64 as i256 { return 0 - 1 }
    if y4 + y_inc_q != final_y_i64 as i256 { return 0 - 1 }
    if z4 - z_drop_q != final_z_i64 as i256 { return 0 - 1 }

    let step5_fp = lorenz_i256_step5_certificate_fingerprint(
        4920371098, 8816077911, 4092986080,
        dy_scaled_q_i64, dy_scaled_r_i64, xy_scaled_q_i64, xy_scaled_r_i64,
        beta_q_i64, beta_r_i64, x_inc_q_i64, x_inc_r_i64,
        y_inc_q_i64, y_inc_r_i64, z_drop_q_i64, z_drop_r_i64,
        final_x_i64, final_y_i64, final_z_i64, 1)
    let chain_anchor = lorenz_i256_five_step_chain_fingerprint(
        step5_fp, final_x_i64, final_y_i64, final_z_i64)
    if chain_anchor != 23144051 { return 0 - 1 }

    return lorenz_i256_trajectory5_manifest_fingerprint(
        32, dt_q, dt_r, 5,
        4294967296, 4294967296, 4294967296,
        chain_anchor, step5_fp,
        final_x_i64, final_y_i64, final_z_i64)
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 14 { return 0 - 1 }
    if instance_fp != 660429472 { return 0 - 1 }
    if certificate_fp != 214180161 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 14 { return 0 - 1 }

    var fp: i64 = 101
    fp = compose_mix(fp, kind, 1103)
    fp = compose_mix(fp, instance_fp, 1103)
    fp = compose_mix(fp, certificate_fp, 1103)
    fp = compose_mix(fp, result_code, 1103)
    fp = compose_mix(fp, checker_code, 1103)
    return fp
}

fn portfolio_v16_bundle_fingerprint(instance_fp: i64,
                                    trajectory_manifest_fp: i64,
                                    chain5_entry_fp: i64) -> i64 with Mod {
    if chain5_entry_fp != 827916944 { return 0 - 1 }

    let trajectory_entry_fp = portfolio_entry_fingerprint(
        14, instance_fp, trajectory_manifest_fp, 1, 14)
    if trajectory_entry_fp != 626160047 { return 0 - 1 }

    var fp: i64 = 107
    fp = compose_mix(fp, 16, 1151)
    fp = compose_mix(fp, 20, 1151)
    fp = compose_mix(fp, 53646245, 1151)
    fp = compose_mix(fp, 528026990, 1151)
    fp = compose_mix(fp, 301444501, 1151)
    fp = compose_mix(fp, 258927862, 1151)
    fp = compose_mix(fp, 388915166, 1151)
    fp = compose_mix(fp, 900589789, 1151)
    fp = compose_mix(fp, 205040674, 1151)
    fp = compose_mix(fp, 580031260, 1151)
    fp = compose_mix(fp, 973127057, 1151)
    fp = compose_mix(fp, 438043475, 1151)
    fp = compose_mix(fp, 887056435, 1151)
    fp = compose_mix(fp, 769531137, 1151)
    fp = compose_mix(fp, 579271506, 1151)
    fp = compose_mix(fp, 252932879, 1151)
    fp = compose_mix(fp, 838301653, 1151)
    fp = compose_mix(fp, 755389732, 1151)
    fp = compose_mix(fp, 521104746, 1151)
    fp = compose_mix(fp, 537394311, 1151)
    fp = compose_mix(fp, chain5_entry_fp, 1151)
    fp = compose_mix(fp, trajectory_entry_fp, 1151)
    return fp
}

fn portfolio_v16_result_coverage_fingerprint(version: i64,
                                             entry_count: i64,
                                             unsat_count: i64,
                                             validated_count: i64,
                                             optimal_count: i64,
                                             sat_count: i64,
                                             manifest_fp: i64) -> i64 with Mod {
    if version != 16 { return 0 - 1 }
    if entry_count != 20 { return 0 - 1 }
    if unsat_count != 7 { return 0 - 1 }
    if validated_count != 11 { return 0 - 1 }
    if optimal_count != 1 { return 0 - 1 }
    if sat_count != 1 { return 0 - 1 }
    if manifest_fp != 320118125 { return 0 - 1 }

    var fp: i64 = 131
    fp = compose_mix(fp, version, 1871)
    fp = compose_mix(fp, entry_count, 1871)
    fp = compose_mix(fp, unsat_count, 1871)
    fp = compose_mix(fp, validated_count, 1871)
    fp = compose_mix(fp, optimal_count, 1871)
    fp = compose_mix(fp, sat_count, 1871)
    fp = compose_mix(fp, manifest_fp, 1871)
    return fp
}

