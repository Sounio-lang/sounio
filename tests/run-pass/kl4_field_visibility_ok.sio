//@ run-pass
//@ expect-stdout: KL4_FIELD_VISIBILITY_OK

use math::dd64::{dd_zero}

struct Vault {
    hidden: i64,
}

impl Vault {
    fn reveal(self: &Vault) -> i64 {
        self.hidden
    }
}

fn main() -> i32 with IO {
    let public_value = dd_zero().hi
    let vault = Vault { hidden: 4 }
    if public_value == 0.0 && vault.reveal() == 4 {
        println("KL4_FIELD_VISIBILITY_OK")
        return 0
    }
    1
}
