//@ run-pass
//@ timeout: 90
//@ expect-stdout-contains: M5_GUM_FOURTH_ORDER_CUMULANT_BUDGET_PASS
// main() prints M5_GUM_FOURTH_ORDER_CUMULANT_BUDGET_OUTPUT (not _PASS) when
// any check above set failed != 0, but then unconditionally prints PASS and
// returns 0 regardless -- an unannotated run-pass file only checks the exit
// code, so without this it would report success even when every scientific
// assertion in this file failed. Requiring the real success marker closes
// that.
//
// HISTORY (2026-09-22): this test was briefly tagged //@ known-failure
// after closing the vacuous-PASS gate above, because
// rel_fourth_residual=3.284213 measured WORSE than rel_hess_residual=0.175404
// -- the fourth-order cumulant correction appeared to make the AUC
// uncertainty estimate worse, not better. Root cause: NOT a modeling bug.
// darwin_pbpk::cumulants::m5_exp (this module's own Taylor-series exp())
// used a "n_f = x*inv_ln2; n = n_f as i64; if (n as f64) > n_f { n = n-1 }"
// floor-then-power-of-2-loop range-reduction idiom that lean_single
// miscompiles: the power-of-2 while loop runs at ~2x its correct trip
// count regardless of whether the correcting if-branch is taken. For
// CL_hep's lognormal kappa4 (needed by the fourth-order variance-budget
// terms below), this inflated e^{6*sigma2_log} by 2x, which inflated
// kappa4/central4 by ~42x, which made var_kurtosis and var_cubic dominate
// var_total. Fixed by replacing m5_exp's range reduction with the
// already-correct iterative form used by ms28_exp in
// pbpk28_mc_prior_family_sweep.sio (independently verified not to trigger
// the bug), confirmed via a minimal isolated repro, and reviewed
// (bin/llm-offload -t math-review -p xai; see .claude/llm_offload_log.md,
// 2026-09-22 entry). Post-fix: kappa4=1302.266361, matching a reference
// closed-form lognormal-fourth-cumulant computation to 6 significant
// figures; rel_fourth_residual=0.057910 now correctly improves over
// rel_hess_residual=0.175404, the theoretically expected direction for
// this endpoint's first-omitted-term correction (not a guarantee that
// still-higher orders would keep improving -- Edgeworth/cumulant
// expansions are asymptotic, not convergent, in general).
//
// Focused M5 validation: cumulants, inverse-AUC derivatives, and PBPK28
// fourth-order budget emission.

use darwin_pbpk::cumulants::*

fn t_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn rel_err(a: f64, b: f64) -> f64 with Div {
    let d = t_abs(a - b)
    let den = if t_abs(b) > 1.0e-12 { t_abs(b) } else { 1.0 }
    d / den
}

fn check_close(tag: string, got: f64, expected: f64, tol: f64) -> bool with IO, Div {
    let r = rel_err(got, expected)
    print(tag); print(" got="); print_f64(got)
    print(" expected="); print_f64(expected)
    print(" rel_err="); print_f64(r); println("")
    return r <= tol
}

fn gaussian_fixture_cumulant() -> CumulantSummary with Mut, Div {
    // Three-point Gaussian-moment fixture: P(0)=2/3, P(+/-sqrt(3))=1/6.
    // The first four central moments are mean=0, variance=1, kappa3=0,
    // kappa4=0, so it is a deterministic check of the Pébay update.
    var s = cumulant_init()
    s = cumulant_update(s, 0.0 - 1.7320508075688772)
    s = cumulant_update(s, 1.7320508075688772)
    s = cumulant_update(s, 0.0)
    s = cumulant_update(s, 0.0)
    s = cumulant_update(s, 0.0)
    s = cumulant_update(s, 0.0)
    cumulant_finalize(s)
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    var failed = 0

    println("======================================================================")
    println("  M5 PBPK28 GUM Fourth-Order Cumulant Budget")
    println("======================================================================")

    let g = gaussian_fixture_cumulant()
    print("Gaussian fixture kappa3: "); print_f64(g.kappa3); println("")
    print("Gaussian fixture kappa4: "); print_f64(g.kappa4); println("")
    if t_abs(g.kappa3) < 1.0e-9 && t_abs(g.kappa4) < 1.0e-9 {
        println("Gaussian cumulant fixture: PASS")
    } else {
        println("Gaussian cumulant fixture: FAIL")
        failed = failed + 1
    }

    let lc = lognormal_cumulants_from_mean_variance(12.4, 22.202944)
    print("Lognormal CL sigma2_log: "); print_f64(lc.sigma2_log); println("")
    print("Lognormal CL kappa3:     "); print_f64(lc.kappa3); println("")
    print("Lognormal CL kappa4:     "); print_f64(lc.kappa4); println("")
    if lc.kappa3 > 0.0 && lc.kappa4 > 0.0 && lc.central4 > 0.0 {
        println("Lognormal cumulants positive: PASS")
    } else {
        println("Lognormal cumulants positive: FAIL")
        failed = failed + 1
    }

    let dose = 5.0
    let cl = 12.4
    let v = 1.0
    let h = 0.001
    let der_inv = extract_auc_inverse_derivatives(dose, cl, v, h)
    let d1_expected = 0.0 - dose / (cl * cl * v)
    let d2_expected = 2.0 * dose / (cl * cl * cl * v)
    let d3_expected = 0.0 - 6.0 * dose / (cl * cl * cl * cl * v)
    if !check_close("dAUC/dCL", der_inv.d1[0], d1_expected, 1.0e-6) { failed = failed + 1 }
    if !check_close("d2AUC/dCL2", der_inv.d2[0], d2_expected, 1.0e-4) { failed = failed + 1 }
    if !check_close("d3AUC/dCL3", der_inv.d3[0], d3_expected, 1.0e-3) { failed = failed + 1 }

    println("")
    println("Running PBPK28 M6 fourth-order convergence budget ...")
    let bud = m5_pbpk28_convergence_budget()
    print("u_MC canonical:          "); print_f64(0.357945); println("")
    print("u_1st direct:            "); print_f64(bud.u_1st); println("")
    print("u_2nd full Hessian:      "); print_f64(bud.u_2nd_hessian); println("")
    print("u_total fourth-order:    "); print_f64(bud.u_total); println("")
    print("rel_hess_residual:       "); print_f64(bud.rel_hess_residual); println("")
    print("rel_fourth_residual:     "); print_f64(bud.rel_fourth_residual); println("")
    print("dominant_correction_idx: "); print_f64(bud.dominant_index as f64); println("")
    print("var_1st:                 "); print_f64(bud.var_1st); println("")
    print("var_skewness:            "); print_f64(bud.var_skewness); println("")
    print("var_kurtosis:            "); print_f64(bud.var_kurtosis); println("")
    print("var_cubic:               "); print_f64(bud.var_cubic); println("")
    print("var_total:               "); print_f64(bud.var_total); println("")

    if !bud.success || bud.u_1st <= 0.0 {
        println("PBPK28 budget failed")
        failed = failed + 1
    }
    if bud.rel_fourth_residual < bud.rel_hess_residual {
        println("Fourth-order improves over full second-order Hessian: PASS")
    } else {
        println("Fourth-order improves over full second-order Hessian: FAIL")
        failed = failed + 1
    }

    if failed == 0 {
        println("M5_GUM_FOURTH_ORDER_CUMULANT_BUDGET_PASS")
    } else {
        println("M5_GUM_FOURTH_ORDER_CUMULANT_BUDGET_OUTPUT")
    }
    println("PASS")
    return 0
}
