//@ run-pass
//@ description: nested str_concat/str_slice with a user-fn call leaf (SIO-378). lean_single kept per-call temps in the shared BUILTIN_SLOT_* globals, so any nested builtin in an argument subtree hijacked the outer emit (depth >= 3 printed "CCCC;" instead of "QQBB = CC;"). Fixed by per-call locals in lean_single.sio; pinned here through the engine-parity gate (both engines must AGREE).
//@ expect-stdout: QQBB = CC;
//@ expect-stdout: QQBB = CC;
//@ expect-stdout: QQBBCC
//@ expect-stdout: BB
//@ expect-stdout: BBDD
fn mk_depth3() -> string with Mut, Panic, Div, Alloc {
    str_concat("Q", "Q")
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = str_concat(str_concat(str_concat(mk_depth3(), "BB"), " = "), str_concat("CC", ";"))
    println(r)
    let s = str_concat(str_concat(str_concat("QQ", "BB"), " = "), str_concat("CC", ";"))
    println(s)
    let t = str_concat(str_concat(mk_depth3(), "BB"), "CC")
    println(t)
    let u = str_slice(str_concat(str_concat("AA", "BB"), "CC"), 2, 4)
    println(u)
    let v = str_concat(str_slice("AABBCC", 2, 4), "DD")
    println(v)
    0
}
