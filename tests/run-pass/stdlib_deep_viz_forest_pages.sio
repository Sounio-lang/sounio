//@ run-pass
//@ expect-stdout: STDLIB_DEEP_VIZ_FOREST_PAGES_PASS
use viz::forest::{forest_layout,forest_page_plan,forest_project,forest_clip_rect}
use viz::ir::{viz_scene_new,viz_add_forest_interval_page,viz_add_forest_interval_plot,
 viz_layout_rect,viz_style_rgb,VIZ_INTERVAL_CONFIDENCE}
fn main() with IO,Mut,Div,Panic {
 let too_many=forest_layout(8,20,20,20,20)
 assert(too_many.status==2 && too_many.capacity==3)
 let fit=forest_layout(3,20,20,20,20)
 assert(fit.status==0 && fit.step==7 && fit.first==23)
 let old=forest_layout(2,20,20,100,40)
 assert(old.status==0 && old.step==13 && old.first==26)
 let empty=forest_layout(0,20,20,20,20)
 assert(empty.status==0)
 let plan=forest_page_plan(5,0,20,20,20,20)
 assert(plan.status==0 && plan.count==3 && plan.next==3 && plan.has_more)
 let final=forest_page_plan(5,plan.next,20,20,20,20)
 assert(final.status==0 && final.count==2 && final.next==5 && !final.has_more)
 var e:[f64;1024]=[0.0;1024]
 var lo:[f64;1024]=[0.0;1024]
 var hi:[f64;1024]=[0.0;1024]
 var i:i64=0
 while i<5 {e[i as usize]=i as f64;lo[i as usize]=(i as f64)-1.0;hi[i as usize]=(i as f64)+1.0;i=i+1}
 var scene=viz_scene_new()
 let rect=viz_layout_rect(20,20,20,20)
 let style=viz_style_rgb(70,180,235)
 assert(viz_add_forest_interval_plot(&!scene,&e,&lo,&hi,5,VIZ_INTERVAL_CONFIDENCE,0.95,rect,style)==-1)
 let first=viz_add_forest_interval_page(&!scene,&e,&lo,&hi,5,0,VIZ_INTERVAL_CONFIDENCE,0.95,rect,style)
 assert(first.status==0 && first.chart==0 && first.count==3 && first.next==3 && first.has_more)
 let second=viz_add_forest_interval_page(&!scene,&e,&lo,&hi,5,first.next,VIZ_INTERVAL_CONFIDENCE,0.95,rect,style)
 assert(second.status==0 && second.count==2 && !second.has_more && second.next==5)
 assert(scene.series[0].x_min==scene.series[1].x_min && scene.series[0].x_max==scene.series[1].x_max)
 assert(scene.series[1].xs[0]==e[3] && scene.series[1].xs[1]==e[4])
 assert(scene.nodes[second.chart as usize].min_value==3.0 && scene.nodes[second.chart as usize].max_value==5.0)
 let before=scene.series_count
 hi[4]= -1.0
 let invalid=viz_add_forest_interval_page(&!scene,&e,&lo,&hi,5,0,VIZ_INTERVAL_CONFIDENCE,0.95,rect,style)
 assert(invalid.status==2 && scene.series_count==before)
 let row=forest_project(5.0,-2.0,12.0,0,1,0.0,10.0,20,20,20,20)
 assert(row.status==0 && !row.lower_cap && !row.upper_cap && row.marker)
 let clipped=forest_clip_rect(17,20,7,7,20,20,20,20)
 assert(clipped.status==0 && clipped.x==20 && clipped.w==4)
 println("STDLIB_DEEP_VIZ_FOREST_PAGES_PASS")
 0
}
