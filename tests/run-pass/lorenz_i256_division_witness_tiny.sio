//@ run-pass
//@ known-failure: source-level i256 Lorenz division witness tiny case: main returns 1. Not a segfault/139
//@ requires: madaros
//@ description: Lorenz i256 small-step division witness certificate without source-level i256 division

fn witness_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn lorenz_i256_division_instance_fingerprint(scale_log2: i64, dt_den: i64,
                                             rho: i64, beta_num: i64,
                                             beta_den: i64, division_count: i64) -> i64 with Mod {
    if scale_log2 != 32 { return 0 - 1 }
    if dt_den != 100 { return 0 - 1 }
    if rho != 28 { return 0 - 1 }
    if beta_num != 8 { return 0 - 1 }
    if beta_den != 3 { return 0 - 1 }
    if division_count != 5 { return 0 - 1 }

    var fp: i64 = 139
    fp = witness_mix(fp, scale_log2, 1301)
    fp = witness_mix(fp, dt_den, 1301)
    fp = witness_mix(fp, rho, 1301)
    fp = witness_mix(fp, beta_num, 1301)
    fp = witness_mix(fp, beta_den, 1301)
    fp = witness_mix(fp, division_count, 1301)
    return fp
}

fn lorenz_i256_division_certificate_fingerprint(instance_fp: i64,
                                                dt_q: i64, dt_r: i64,
                                                dy_scaled_q: i64, dy_scaled_r: i64,
                                                xy_scaled_q: i64, xy_scaled_r: i64,
                                                beta_q: i64, beta_r: i64,
                                                ny_inc_q: i64, ny_inc_r: i64,
                                                zdrop_q: i64, zdrop_r: i64,
                                                linked_numerator_ok: i64,
                                                all_divisions_ok: i64) -> i64 with Mod {
    if instance_fp != 660429472 { return 0 - 1 }
    if dt_q != 42949672 { return 0 - 1 }
    if dt_r != 96 { return 0 - 1 }
    if dy_scaled_q != 115964116992 { return 0 - 1 }
    if dy_scaled_r != 0 { return 0 - 1 }
    if xy_scaled_q != 4294967296 { return 0 - 1 }
    if xy_scaled_r != 0 { return 0 - 1 }
    if beta_q != 11453246122 { return 0 - 1 }
    if beta_r != 2 { return 0 - 1 }
    if ny_inc_q != 1116691472 { return 0 - 1 }
    if ny_inc_r != 0 { return 0 - 1 }
    if zdrop_q != 71582786 { return 0 - 1 }
    if zdrop_r != 2834678416 { return 0 - 1 }
    if linked_numerator_ok != 1 { return 0 - 1 }
    if all_divisions_ok != 1 { return 0 - 1 }

    var fp: i64 = 149
    fp = witness_mix(fp, instance_fp, 1327)
    fp = witness_mix(fp, dt_q, 1327)
    fp = witness_mix(fp, dt_r, 1327)
    fp = witness_mix(fp, dy_scaled_q, 1327)
    fp = witness_mix(fp, dy_scaled_r, 1327)
    fp = witness_mix(fp, xy_scaled_q, 1327)
    fp = witness_mix(fp, xy_scaled_r, 1327)
    fp = witness_mix(fp, beta_q, 1327)
    fp = witness_mix(fp, beta_r, 1327)
    fp = witness_mix(fp, ny_inc_q, 1327)
    fp = witness_mix(fp, ny_inc_r, 1327)
    fp = witness_mix(fp, zdrop_q, 1327)
    fp = witness_mix(fp, zdrop_r, 1327)
    fp = witness_mix(fp, linked_numerator_ok, 1327)
    fp = witness_mix(fp, all_divisions_ok, 1327)
    return fp
}

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let x: i256 = scale
    let y: i256 = scale
    let z: i256 = scale
    let rho: i256 = 28 as i256

    let dt_q: i256 = 42949672 as i256
    let dt_r: i256 = 96 as i256
    let dy_scaled_q: i256 = 115964116992 as i256
    let xy_scaled_q: i256 = scale
    let beta_q: i256 = 11453246122 as i256
    let beta_r: i256 = 2 as i256
    let ny_inc_q: i256 = 1116691472 as i256
    let zdrop_q: i256 = 71582786 as i256
    let zdrop_r: i256 = 2834678416 as i256

    let rho_scale_minus_z: i256 = (rho * scale) - z
    let dy_num: i256 = x * rho_scale_minus_z
    let xy_num: i256 = x * y
    let beta_num_z: i256 = (8 as i256) * z
    let expected_square: i256 = scale * scale

    var linked_numerator_ok: i64 = 0
    if rho_scale_minus_z == (27 as i256) * scale {
        if xy_num == expected_square {
            if dy_num == (27 as i256) * expected_square {
                if beta_num_z == (8 as i256) * scale {
                    linked_numerator_ok = 1
                }
            }
        }
    }

    let dt_ok = check_div_witness_i256(scale, 100 as i256, dt_q, dt_r)
    let dy_scaled_ok = check_div_witness_i256(dy_num, scale, dy_scaled_q, 0 as i256)
    let xy_scaled_ok = check_div_witness_i256(xy_num, scale, xy_scaled_q, 0 as i256)
    let beta_ok = check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r)

    let dy: i256 = dy_scaled_q - y
    let dz_drop_num: i256 = beta_q - xy_scaled_q
    let ny_inc_ok = check_div_witness_i256(dt_q * dy, scale, ny_inc_q, 0 as i256)
    let zdrop_ok = check_div_witness_i256(dt_q * dz_drop_num, scale, zdrop_q, zdrop_r)

    var all_divisions_ok: i64 = 0
    if dt_ok == 1 {
        if dy_scaled_ok == 1 {
            if xy_scaled_ok == 1 {
                if beta_ok == 1 {
                    if ny_inc_ok == 1 {
                        if zdrop_ok == 1 { all_divisions_ok = 1 }
                    }
                }
            }
        }
    }

    let nx: i256 = x
    let ny: i256 = y + ny_inc_q
    let nz: i256 = z - zdrop_q

    let instance_fp = lorenz_i256_division_instance_fingerprint(32, 100, 28, 8, 3, 5)
    let cert_fp = lorenz_i256_division_certificate_fingerprint(
        instance_fp, 42949672, 96, 115964116992, 0, 4294967296, 0,
        11453246122, 2, 1116691472, 0, 71582786, 2834678416,
        linked_numerator_ok, all_divisions_ok)

    if linked_numerator_ok != 1 { return 1 }
    if all_divisions_ok != 1 { return 2 }
    if dy != (26 as i256) * scale { return 3 }
    if dz_drop_num != 7158278826 as i256 { return 4 }
    if nx != scale { return 5 }
    if ny != 5411658768 as i256 { return 6 }
    if nz != 4223384510 as i256 { return 7 }
    if instance_fp != 660429472 { return 8 }
    if cert_fp != 510854875 { return 9 }

    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, 3 as i256) != 0 { return 10 }
    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q + (1 as i256), beta_r) != 0 { return 11 }
    if lorenz_i256_division_certificate_fingerprint(
        instance_fp, 42949672, 96, 115964116992, 0, 4294967296, 0,
        11453246122, 1, 1116691472, 0, 71582786, 2834678416,
        linked_numerator_ok, all_divisions_ok) != (0 - 1) { return 12 }
    if lorenz_i256_division_instance_fingerprint(32, 101, 28, 8, 3, 5) != (0 - 1) { return 13 }

    return 0
}
