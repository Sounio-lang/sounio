//@ run-pass
//@ requires: madaros
//@ expect-stdout: TAN_REDUCTION_COMPENSATED_2608_OK
// Regression for #2608 discussion_r4067618378. Exact binary64 inputs;
// constants independently re-derived by tests/oracles/tan_reduction_2608.cpp.
// Must fail with the old two-part reduction; tolerance is unchanged (4e-15).
fn tan_probe_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}
fn tan_probe(got: f64, want: f64) -> i64 with Mut, Div {
    var scale = tan_probe_abs(want)
    if scale < 1.0 { scale = 1.0 }
    if tan_probe_abs(got - want) <= 4.0e-15 * scale { 0 } else { 1 }
}
fn main() -> i32 with IO, Mut, Div, Panic {
    var fails: i64 = 0
    fails = fails + tan_probe(tan(0.0 - 479424.3176972952), 0.0 - 9806663.258355444)
    fails = fails + tan_probe(tan(0.0 - 479424.31769729516), 0.0 - 9801068.58367296)
    fails = fails + tan_probe(tan(0.0 - 479424.3176972953), 0.0 - 9812264.32382312)
    fails = fails + tan_probe(tan(479424.3176972952), 9806663.258355444)
    fails = fails + tan_probe(tan(1.5707963267948966), 1.633123935319537e+16)
    fails = fails + tan_probe(tan(1.5707963267948963), 3530114321217157.5)
    fails = fails + tan_probe(tan(1.5707963267948968), 0.0 - 6218431163823738.0)
    fails = fails + tan_probe(tan(0.0 - 1.5707963267948966), 0.0 - 1.633123935319537e+16)
    fails = fails + tan_probe(tan(3.141592653589793), 0.0 - 1.2246467991473532e-16)
    fails = fails + tan_probe(tan(3.1415926535897936), 3.216245299353273e-16)
    fails = fails + tan_probe(tan(1647097.7583689587), 291056669292.4059)
    fails = fails + tan_probe(tan(1647097.758368959), 0.0 - 4359295077.378354)
    fails = fails + tan_probe(tan(1647097.7583689585), 4232510408.045062)
    fails = fails + tan_probe(tan(1647099.3291652855), 0.0 - 6.420676210313675e-11)
    fails = fails + tan_probe(tan(0.0 - 1647099.3291652855), 6.420676210313675e-11)
    fails = fails + tan_probe(tan(1000000.0), 0.0 - 0.373624453987599)
    fails = fails + tan_probe(tan(0.0 - 1000000.0), 0.373624453987599)
    fails = fails + tan_probe(tan(0.5), 0.5463024898437905)
    fails = fails + tan_probe(tan(0.0 - 0.5), 0.0 - 0.5463024898437905)
    let nz = 0.0 * (0.0 - 1.0)
    if tan(nz) != 0.0 || !(1.0 / tan(nz) < 0.0) { fails = fails + 1 }
    if tan(1.0e-300) != 1.0e-300 { fails = fails + 1 }
    let past = tan(1.0e7)
    if past == past { fails = fails + 1 }
    if fails != 0 {
        print("TAN_REDUCTION_COMPENSATED_2608_FAIL ")
        print_int(fails)
        print("\n")
        return 1
    }
    print("TAN_REDUCTION_COMPENSATED_2608_OK\n")
    0
}
