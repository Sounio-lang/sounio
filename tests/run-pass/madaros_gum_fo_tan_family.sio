//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_TAN_FAMILY_PASS

// FO chain rule for tan / atan / tanh + second_order_mean.
// Independent of native exp/log health.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    // tan(0): f'=1, f''=0 → Var=σ², E2=0
    let k0: Knowledge<f64> = measure(0.0, uncertainty: 0.05)
    let x0 = k0.value
    let vt = variance_of(tan(x0))
    let mt = second_order_mean(tan(x0))

    // atan(0): f'=1, f''=0 → same
    let va = variance_of(atan(x0))
    let ma = second_order_mean(atan(x0))

    // tanh(0): f'=1, f''=0
    let vh = variance_of(tanh(x0))
    let mh = second_order_mean(tanh(x0))

    // tan at 0.3: f'=1+t², t=tan(0.3)
    let k1: Knowledge<f64> = measure(0.3, uncertainty: 0.02)
    let x1 = k1.value
    let t1 = tan(0.3)
    let fp = 1.0 + t1 * t1
    let v1_exp = fp * fp * 0.0004
    let f2 = 2.0 * t1 * fp
    let m1_exp = t1 + 0.5 * f2 * 0.0004
    let v1 = variance_of(tan(x1))
    let m1 = second_order_mean(tan(x1))

    print("vt="); print_f64(vt); print("\n")
    print("mt="); print_f64(mt); print("\n")
    print("va="); print_f64(va); print("\n")
    print("ma="); print_f64(ma); print("\n")
    print("vh="); print_f64(vh); print("\n")
    print("mh="); print_f64(mh); print("\n")
    print("v1="); print_f64(v1); print("\n")
    print("m1="); print_f64(m1); print("\n")

    let ok = abs_f(vt - 0.0025) < 1.0e-9
        && abs_f(mt - 0.0) < 1.0e-9
        && abs_f(va - 0.0025) < 1.0e-9
        && abs_f(ma - 0.0) < 1.0e-9
        && abs_f(vh - 0.0025) < 1.0e-9
        && abs_f(mh - 0.0) < 1.0e-9
        && abs_f(v1 - v1_exp) < 1.0e-8
        && abs_f(m1 - m1_exp) < 1.0e-8
    if ok {
        print("MADAROS_GUM_FO_TAN_FAMILY_PASS\n")
    } else {
        print("MADAROS_GUM_FO_TAN_FAMILY_FAIL\n")
    }
}
