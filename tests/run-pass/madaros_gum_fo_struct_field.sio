//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_STRUCT_FIELD_PASS
//@ known-failure: fails on both engines -- lean_single loses variance through struct fields/rebind/alias (= 0, #2776); Madaros loses it through method/expression returns (v_meth = v_exp = 0, #1706)

// Struct field FO — peels flow through struct-literal fields and aliases.
// Also method FO via self.field (LOAD_PARAM_FIELD) when cl0 lives on the receiver.

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn clearance(self: &Pk, eta: f64) -> f64 {
        self.cl0 * exp(eta)
    }
    fn exposure(self: &Pk, eta: f64) -> f64 {
        self.cl0 * self.v0 * exp(eta)
    }
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() -> i64 with IO, Mut, Div, Epistemic {
    var exit_fails: i64 = 0
    let kCL: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let cl0 = kCL.value
    let v0 = kV.value
    let eta = kEta.value

    let pk = Pk { cl0: cl0, v0: v0 }
    let v_field_cl = variance_of(pk.cl0)
    let v_peel_cl = variance_of(cl0)
    let v_field_sum = variance_of(pk.cl0 + pk.v0)
    let v_peel_sum = variance_of(cl0 + v0)
    let c2 = pk.cl0
    let v_rebind = variance_of(c2)

    let pk2 = pk
    let v_alias = variance_of(pk2.cl0)

    // Method FO through self.cl0
    let v_meth = variance_of(pk.clearance(eta))
    let v_free = variance_of(cl0 * exp(eta))
    let v_exp = variance_of(pk.exposure(eta))
    let v_exp_peel = variance_of(cl0 * v0 * exp(eta))

    print("v_field_cl="); print_f64(v_field_cl); print("\n")
    print("v_field_sum="); print_f64(v_field_sum); print("\n")
    print("v_rebind="); print_f64(v_rebind); print("\n")
    print("v_alias="); print_f64(v_alias); print("\n")
    print("v_meth="); print_f64(v_meth); print("\n")
    print("v_exp="); print_f64(v_exp); print("\n")

    let ok = abs_f(v_field_cl - v_peel_cl) < 1.0e-9
        && abs_f(v_field_cl - 0.09) < 1.0e-9
        && abs_f(v_field_sum - v_peel_sum) < 1.0e-9
        && abs_f(v_rebind - v_peel_cl) < 1.0e-9
        && abs_f(v_alias - v_peel_cl) < 1.0e-9
        && abs_f(v_meth - v_free) < 1.0e-9
        && abs_f(v_meth - 0.34) < 1.0e-9
        && abs_f(v_exp - v_exp_peel) < 1.0e-6
        && v_exp > 1.0
    if ok {
        print("MADAROS_GUM_FO_STRUCT_FIELD_PASS\n")
    } else {
        print("MADAROS_GUM_FO_STRUCT_FIELD_FAIL\n")
        exit_fails = exit_fails + 1
    }
    if exit_fails > 0 {
        return 1
    }
    return 0
}
