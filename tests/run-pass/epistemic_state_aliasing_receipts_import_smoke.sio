//@ run-pass
//@ expect-stdout: EPISTEMIC_STATE_ALIASING_RECEIPTS_IMPORT_SMOKE_PASS
// Synthetic import smoke for observed-proxy collision boundaries. It makes no
// latent-state, biological, psychiatric, causal, or clinical claim.

use epistemic::observation_provenance::*
use epistemic::state_aliasing_receipts::*

fn main() with IO, Panic {
    let opportunity = op_observation_opportunity_i64(10, 11)
    let presence = op_encounter_presence_i64(20, 21)
    let selection = op_measurement_selection_i64(30, 31)
    let act = op_measurement_act_i64(40, 41)
    let recorded = op_record_measurement_i64(opportunity, presence, selection, act)
    let left_history = op_observation_history_from_recorded_i64(recorded, 1001)
    let right_history = op_observation_history_from_recorded_i64(recorded, 1002)

    let left_proxy = sar_observed_proxy_i64(left_history, 9001)
    let right_proxy = sar_observed_proxy_i64(right_history, 9001)
    let collision = sar_observed_proxy_collision_i64(left_proxy, right_proxy)
    let challenge = sar_predictive_challenge_i64(collision, 9101, 9102, 9103)
    let separation = sar_predictive_separation_i64(challenge, 9201, 9202)
    let refinement = sar_state_refinement_request_i64(challenge, separation, 9301)
    let abstention = sar_state_equivalence_abstention_i64(collision, 9401)

    let proxy_ok = sar_observed_proxy_history_tag_i64(left_proxy) == 1001 &&
        sar_observed_proxy_source_system_tag_i64(left_proxy) == 11 &&
        sar_observed_proxy_tag_i64(left_proxy) == 9001
    let collision_ok = sar_collision_source_system_tag_i64(collision) == 11 &&
        sar_collision_observed_proxy_tag_i64(collision) == 9001 &&
        sar_collision_left_history_tag_i64(collision) == 1001 &&
        sar_collision_right_history_tag_i64(collision) == 1002
    let challenge_ok = sar_predictive_challenge_horizon_tag_i64(challenge) == 9101 &&
        sar_predictive_challenge_target_feature_tag_i64(challenge) == 9102 &&
        sar_predictive_challenge_comparator_tag_i64(challenge) == 9103
    let separation_ok = sar_predictive_separation_left_output_tag_i64(separation) == 9201 &&
        sar_predictive_separation_right_output_tag_i64(separation) == 9202 &&
        sar_predictive_separation_source_system_tag_i64(separation) == 11
    let refinement_ok = sar_state_refinement_observed_proxy_tag_i64(refinement) == 9001 &&
        sar_state_refinement_source_system_tag_i64(refinement) == 11 &&
        sar_state_refinement_left_history_tag_i64(refinement) == 1001 &&
        sar_state_refinement_right_history_tag_i64(refinement) == 1002 &&
        sar_state_refinement_horizon_tag_i64(refinement) == 9101 &&
        sar_state_refinement_target_feature_tag_i64(refinement) == 9102 &&
        sar_state_refinement_comparator_tag_i64(refinement) == 9103 &&
        sar_state_refinement_omitted_state_tag_i64(refinement) == 9301
    let abstention_ok = sar_state_equivalence_abstention_observed_proxy_tag_i64(abstention) == 9001 &&
        sar_state_equivalence_abstention_reason_tag_i64(abstention) == 9401

    if proxy_ok && collision_ok && challenge_ok && separation_ok && refinement_ok && abstention_ok {
        println("EPISTEMIC_STATE_ALIASING_RECEIPTS_IMPORT_SMOKE_PASS")
    } else {
        println("EPISTEMIC_STATE_ALIASING_RECEIPTS_IMPORT_SMOKE_FAIL")
    }
}
