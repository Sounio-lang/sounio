//@ run-pass
//@ expect-stdout: fmt x=42 s=ab f=2.5
//@ expect-stdout: braces {} and 7
//@ expect-stdout: p=9 q=-4
//@ expect-stdout: one-arg {} stays
//@ expect-stdout: trail=5
//@ expect-stdout: order 1 2 3
//@ description: print/println with a format and arguments (ADR-013). Each `{}` prints the next argument as print(arg) would; `{{` and `}}` are literal braces; arguments are evaluated left to right; with a single argument the string prints verbatim. Before ADR-013 both engines dropped every argument after the first and printed `fmt x={} s={} f={}`.

var COUNTER: i64 = 0

fn next_count() -> i64 with Mut {
    COUNTER = COUNTER + 1
    COUNTER
}

fn sq(x: i64) -> i64 {
    x * x
}

fn main() with IO, Mut {
    println("fmt x={} s={} f={}", 42, "ab", 2.5)
    println("braces {{}} and {}", 7)
    print("p={} ", sq(3))
    println("q={}", -4)
    println("one-arg {} stays")
    println("trail={}", 5,)
    println("order {} {} {}", next_count(), next_count(), next_count())
}
