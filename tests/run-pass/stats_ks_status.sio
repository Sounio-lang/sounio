//@ run-pass
//@ expect-stdout: STATS_KS_STATUS_PASS
use stats::ks_test::{ks_one_normal,ks_two,run_tests}
fn main() with IO,Mut,Div,Panic {
 var x:[f64;256]=[0.0;256]
 var y:[f64;256]=[0.0;256]
 assert(ks_one_normal(&x,0,0.0,1.0).status==1)
 assert(ks_one_normal(&x,257,0.0,1.0).status==1)
 assert(ks_one_normal(&x,1,0.0,0.0).status==3)
 assert(ks_one_normal(&x,1,0.0,-1.0).status==3)
 assert(ks_one_normal(&x,1,0.0/0.0,1.0).status==3)
 assert(ks_one_normal(&x,1,0.0,1.0e308*2.0).status==3)
 assert(ks_two(&x,257,&y,1).status==1)
 assert(ks_two(&x,1,&y,-1).status==1)
 let invalid=ks_one_normal(&x,0,0.0,1.0)
 assert(invalid.p==0.0 && invalid.d==0.0 && invalid.ne==0.0 && invalid.n_x==0 && invalid.n_y==0)
 x[0]=0.0/0.0
 assert(ks_one_normal(&x,1,0.0,1.0).status==2)
 assert(ks_two(&x,1,&y,1).status==2)
 x[0]=0.0
 y[0]=1.0e308*2.0
 assert(ks_two(&x,1,&y,1).status==2)
 y[0]=0.0
 let constant=ks_two(&x,3,&y,6)
 assert(constant.status==0 && constant.d==0.0 && constant.p==1.0 && constant.has_ties)
 assert(constant.n_x==3 && constant.n_y==6 && constant.asymptotic)
 // Equal empirical distributions with unequal tied multiplicities.
 x[0]=1.0;x[1]=0.0
 y[0]=0.0;y[1]=1.0;y[2]=0.0;y[3]=1.0
 let equal=ks_two(&x,2,&y,4)
 assert(equal.status==0 && equal.d==0.0 && equal.p==1.0 && equal.has_ties)
 assert(x[0]==1.0 && x[1]==0.0 && y[0]==0.0 && y[1]==1.0)
 let swapped=ks_two(&y,4,&x,2)
 assert(swapped.status==0 && swapped.d==equal.d && swapped.p==equal.p)
 let singleton=ks_one_normal(&x,1,1.0,1.0)
 assert(singleton.status==0 && singleton.d==0.5 && !singleton.has_ties)
 // Active prefix only: inactive NaN must not invalidate a request.
 x[255]=0.0/0.0
 assert(ks_one_normal(&x,1,1.0,1.0).status==0)
 assert(run_tests())
 println("STATS_KS_STATUS_PASS")
 0
}
