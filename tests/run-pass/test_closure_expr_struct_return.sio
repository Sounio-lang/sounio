//@ run-pass
//@ expect-stdout: closure expr sret ok
struct Pair { left: i64, right: i64 }

fn pair_sum(p: Pair) -> i64 {
    p.left + p.right
}

fn make_pair(x: i64, bias: i64) -> Pair {
    Pair { left: x + bias, right: x + bias + 1 }
}

fn main() -> i32 with IO, Panic {
    let bias = 40
    let make = |x: i64| -> Pair make_pair(x, bias)

    let a = make(1)
    let b = make(5)
    assert(a.left == 41)
    assert(a.right == 42)
    assert(b.left == 45)
    assert(b.right == 46)

    let total = pair_sum(make(7))
    assert(total == 95)

    let nested = make(make(2).right)
    assert(nested.left == 83)
    assert(nested.right == 84)

    print("closure expr sret ok\n")
    0
}
