//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: 2.500000
//
// `epsilon=⊥` (ASCII identifier) parses as Knightian, like `ε=⊥`.

fn f(k: Knowledge[f64, epsilon=⊥]) -> f64 with Epistemic { k.value }

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge[f64, epsilon=⊥] = Knowledge(2.5, ε=⊥)
    print_f64(f(k))
    print("\n")
    0
}
