//@ run-pass
//@ expect-stdout-contains: sleep: PASS
//@ expect-stdout-contains: sleep_parallel: PASS
//@ native-pass
// sleep(ms).await — nanosleep(2) builtin

fn main() -> i64 with IO, Async {
    var exit_fails: i64 = 0
    sleep(10).await
    print("sleep: PASS\n")

    // Two tasks that sleep in parallel — both should finish and return correctly
    let t1 = spawn { sleep(5).await; 1 }
    let t2 = spawn { sleep(5).await; 2 }
    let r1 = t1.await
    let r2 = t2.await
    if r1 == 1 && r2 == 2 {
        print("sleep_parallel: PASS\n")
    } else {
        print("sleep_parallel: FAIL\n")
        exit_fails = exit_fails + 1
    }
    if exit_fails > 0 {
        return 1
    }
    return 0
}
