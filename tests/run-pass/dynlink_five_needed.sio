//@ run-pass
//@ requires: madaros
//@ expect-stdout: dynlink_five_needed: PASS
// #2533: five distinct DT_NEEDED libraries (kl14b, kl14c, kl14d_a, kl14d_b,
// libzstd) under the symbol cap. Before the fix the unique-library count
// saturated at 4, the cap check could not fire, the build exited 0 and the
// ELF had no DT_NEEDED libzstd.so.1: "undefined symbol: ZSTD_isError" at load.
// Needs the probe libraries and libzstd.so.1 on LD_LIBRARY_PATH.
// Gate: scripts/ci/madaros_dynlink_caps_gate.sh

extern "C" {
    fn kl14b_add(a: i64, b: i64) -> i64
    fn kl14c_add(a: i64, b: i64) -> i64
    fn kl14d_a(x: i64) -> i64
    fn kl14d_b(x: i64) -> i64
    fn ZSTD_isError(code: i64) -> i64
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let a = kl14b_add(1, 2)          // 3
    let b = kl14c_add(a, 4)          // 7
    let c = kl14d_b(kl14d_a(b))      // (7 + 1) * 3 = 24
    let z = ZSTD_isError(0)          // 0: not an error code
    if c == 24 && z == 0 {
        println("dynlink_five_needed: PASS")
        return 0
    }
    println("dynlink_five_needed: FAIL")
    1
}
