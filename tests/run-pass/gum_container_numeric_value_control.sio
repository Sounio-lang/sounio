//@ run-pass
//@ requires: madaros
//@ expect-stdout: GUM_CONTAINER_NUMERIC_VALUE_PASS
// #3546 CI follow-up: an ordinary status-bearing value is not Knowledge.

struct Reading { value: f64, status: i64 }
struct Result { magnitude: f64 }
fn read_value(x: f64) -> Reading { Reading { value: x, status: 0 } }
fn main() -> i64 with IO, Mut, Div, Panic {
    var out = Result { magnitude: 0.0 }
    var magnitude = 0.0
    var i: i64 = 0
    while i < 2 {
        let entry = if i == 0 { read_value(2.0) } else { read_value(3.0) }
        let value = entry.value
        if value > magnitude { magnitude = value }
        i = i + 1
    }
    out.magnitude = magnitude
    assert(out.magnitude == 3.0)
    print("GUM_CONTAINER_NUMERIC_VALUE_PASS\n")
    return 0
}
