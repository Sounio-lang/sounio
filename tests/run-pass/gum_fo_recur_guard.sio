//@ run-pass
//@ requires: madaros
//@ expect-stdout: g0 0.090000
//@ expect-stdout: g3 1.440000
//@ expect-stdout: g8 7.290000
//@ expect-stdout: g12 15.210000
//@ expect-stdout: gneg 0.090000
//@ expect-stdout: s12 1509949.440000
//@ expect-stdout: RECUR_GUARD_OK
// `n <= 0` is the same stop as `n < 1` for an integer step of 1.
// Linear n = 8 is 81 * 0.09. Geometric 2 at n = 12 is 4096^2 * 0.09.

fn lin(x: f64, n: i64) -> f64 {
    if n <= 0 {
        x
    } else {
        lin(x, n - 1) + x
    }
}

fn sc(x: f64, n: i64) -> f64 {
    if n <= 0 {
        x
    } else {
        2.0 * sc(x, n - 1)
    }
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let g0 = variance_of(lin(a, 0))
    let g3 = variance_of(lin(a, 3))
    let g8 = variance_of(lin(a, 8))
    let g12 = variance_of(lin(a, 12))
    let gneg = variance_of(lin(a, 0 - 2))
    let s12 = variance_of(sc(a, 12))
    print("g0 ")
    print_f64(g0)
    println("")
    print("g3 ")
    print_f64(g3)
    println("")
    print("g8 ")
    print_f64(g8)
    println("")
    print("g12 ")
    print_f64(g12)
    println("")
    print("gneg ")
    print_f64(gneg)
    println("")
    print("s12 ")
    print_f64(s12)
    println("")
    var fails: i64 = 0
    if g0 < 0.089999 || g0 > 0.090001 { fails = fails + 1 }
    if g3 < 1.439999 || g3 > 1.440001 { fails = fails + 1 }
    if g8 < 7.289999 || g8 > 7.290001 { fails = fails + 1 }
    if g12 < 15.209999 || g12 > 15.210001 { fails = fails + 1 }
    if gneg < 0.089999 || gneg > 0.090001 { fails = fails + 1 }
    if s12 < 1509949.439999 || s12 > 1509949.440001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_GUARD_OK")
        0
    } else {
        println("RECUR_GUARD_FAIL")
        1
    }
}
