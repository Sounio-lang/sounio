//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-1 Taylor-2 remainder obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn abs_and_derivative_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let start_x: i256 = 4294967296 as i256
    let start_y: i256 = 5411658768 as i256
    let start_z: i256 = 4223384510 as i256
    let rx: i256 = 4295 as i256
    let ry: i256 = 1116695792 as i256
    let rz: i256 = 71584220 as i256
    let x_abs: i256 = 4294971591 as i256
    let y_abs: i256 = 6528354560 as i256
    let z_abs: i256 = 4294968730 as i256
    let rhoz_abs: i256 = 116107283998 as i256
    let x_prime: i256 = 108233261510 as i256
    let y_prime: i256 = 122635754667 as i256
    let z_prime: i256 = 17981611036 as i256
    let x_second: i256 = 2308690161770 as i256
    let y_second: i256 = 3066523255862 as i256
    let z_second: i256 = 335101505169 as i256

    var mask: i64 = 0
    if x_abs == start_x + rx {
        if y_abs == start_y + ry {
            if z_abs == start_z + rz {
                if rhoz_abs == (28 as i256) * source_scale - (start_z - rz) {
                    mask = mask + 1
                }
            }
        }
    }

    let y_prime_product: i256 = x_abs * rhoz_abs
    let xy_product: i256 = x_abs * y_abs
    let beta_z_product: i256 = (8 as i256) * z_abs
    if x_prime == (10 as i256) * (x_abs + y_abs) {
        if (y_prime - y_abs - (1 as i256)) * source_scale < y_prime_product {
            if (y_prime - y_abs) * source_scale >= y_prime_product {
                if ((6528361089 as i256) - (1 as i256)) * source_scale < xy_product {
                    if (6528361089 as i256) * source_scale >= xy_product {
                        if ((11453249947 as i256) - (1 as i256)) * (3 as i256) < beta_z_product {
                            if (11453249947 as i256) * (3 as i256) >= beta_z_product {
                                if z_prime == (6528361089 as i256) + (11453249947 as i256) {
                                    mask = mask + 2
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if x_second == (10 as i256) * (y_prime + x_prime) {
        if y_second == (2925905872177 as i256) + (17981629018 as i256) + y_prime {
            if z_second == (164514665102 as i256) + (122635877304 as i256) + (47950962763 as i256) {
                mask = mask + 4
            }
        }
    }
    return mask
}

fn lte_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let dt_q: i256 = 42949672 as i256
    let dt2: i256 = dt_q * dt_q
    let den: i256 = (2 as i256) * source_scale * source_scale
    let x_second: i256 = 2308690161770 as i256
    let y_second: i256 = 3066523255862 as i256
    let z_second: i256 = 335101505169 as i256
    let x_lte_source: i256 = 115434503 as i256
    let y_lte_source: i256 = 153326156 as i256
    let z_lte_source: i256 = 16755075 as i256
    let x_lte_ppm: i256 = 26877 as i256
    let y_lte_ppm: i256 = 35700 as i256
    let z_lte_ppm: i256 = 3902 as i256

    var mask: i64 = 0
    if (x_lte_source - (1 as i256)) * den < x_second * dt2 {
        if x_lte_source * den >= x_second * dt2 {
            if (y_lte_source - (1 as i256)) * den < y_second * dt2 {
                if y_lte_source * den >= y_second * dt2 {
                    if (z_lte_source - (1 as i256)) * den < z_second * dt2 {
                        if z_lte_source * den >= z_second * dt2 { mask = mask + 8 }
                    }
                }
            }
        }
    }
    if (x_lte_ppm - (1 as i256)) * source_scale < x_lte_source * target_scale {
        if x_lte_ppm * source_scale >= x_lte_source * target_scale {
            if (y_lte_ppm - (1 as i256)) * source_scale < y_lte_source * target_scale {
                if y_lte_ppm * source_scale >= y_lte_source * target_scale {
                    if (z_lte_ppm - (1 as i256)) * source_scale < z_lte_source * target_scale {
                        if z_lte_ppm * source_scale >= z_lte_source * target_scale { mask = mask + 16 }
                    }
                }
            }
        }
    }
    if 35000 - 26877 == 8123 {
        if 45000 - 35700 == 9300 {
            if 10000 - 3902 == 6098 { mask = mask + 32 }
        }
    }
    return mask + 64
}

fn main() -> i64 {
    let ok_mask = abs_and_derivative_mask() + lte_mask()
    if ok_mask != 127 { return 1 }

    var inst: i64 = 1793
    inst = mix(inst, 1, 5707)
    inst = mix(inst, 4294967296, 5707)
    inst = mix(inst, 1000000, 5707)
    inst = mix(inst, 42949672, 5707)
    inst = mix(inst, 496675613, 5707)
    inst = mix(inst, 467471545, 5707)
    inst = mix(inst, 472667880, 5707)
    inst = mix(inst, 286326819, 5707)
    inst = mix(inst, 133154696, 5707)
    inst = mix(inst, 194048456, 5707)
    inst = mix(inst, 4294967296, 5707)
    inst = mix(inst, 5411658768, 5707)
    inst = mix(inst, 4223384510, 5707)
    inst = mix(inst, 4295, 5707)
    inst = mix(inst, 1116695792, 5707)
    inst = mix(inst, 71584220, 5707)
    inst = mix(inst, 0, 5707)
    inst = mix(inst, 0, 5707)
    if inst != 340568604 { return 2 }

    var cert: i64 = 1797
    cert = mix(cert, inst, 5711)
    cert = mix(cert, 4294971591, 5711)
    cert = mix(cert, 6528354560, 5711)
    cert = mix(cert, 4294968730, 5711)
    cert = mix(cert, 116107283998, 5711)
    cert = mix(cert, 108233261510, 5711)
    cert = mix(cert, 122635754667, 5711)
    cert = mix(cert, 17981611036, 5711)
    cert = mix(cert, 2308690161770, 5711)
    cert = mix(cert, 3066523255862, 5711)
    cert = mix(cert, 335101505169, 5711)
    cert = mix(cert, 115434503, 5711)
    cert = mix(cert, 153326156, 5711)
    cert = mix(cert, 16755075, 5711)
    cert = mix(cert, 26877, 5711)
    cert = mix(cert, 35700, 5711)
    cert = mix(cert, 3902, 5711)
    cert = mix(cert, 35000, 5711)
    cert = mix(cert, 45000, 5711)
    cert = mix(cert, 10000, 5711)
    cert = mix(cert, 8123, 5711)
    cert = mix(cert, 9300, 5711)
    cert = mix(cert, 6098, 5711)
    cert = mix(cert, ok_mask, 5711)
    cert = mix(cert, 0, 5711)
    cert = mix(cert, 0, 5711)
    if cert != 273027742 { return 3 }

    var art: i64 = 1801
    art = mix(art, inst, 5717)
    art = mix(art, cert, 5717)
    art = mix(art, 496675613, 5717)
    art = mix(art, 467471545, 5717)
    art = mix(art, 472667880, 5717)
    art = mix(art, 286326819, 5717)
    art = mix(art, 133154696, 5717)
    art = mix(art, 194048456, 5717)
    art = mix(art, 5, 5717)
    art = mix(art, 1, 5717)
    art = mix(art, 26877, 5717)
    art = mix(art, 35700, 5717)
    art = mix(art, 3902, 5717)
    art = mix(art, 35000, 5717)
    art = mix(art, 45000, 5717)
    art = mix(art, 10000, 5717)
    art = mix(art, ok_mask, 5717)
    art = mix(art, 0, 5717)
    art = mix(art, 0, 5717)
    if art != 265853299 { return 4 }

    var audit: i64 = 1807
    audit = mix(audit, art, 5719)
    audit = mix(audit, inst, 5719)
    audit = mix(audit, cert, 5719)
    audit = mix(audit, 496675613, 5719)
    audit = mix(audit, 472667880, 5719)
    audit = mix(audit, 133154696, 5719)
    audit = mix(audit, 1, 5719)
    audit = mix(audit, 5, 5719)
    audit = mix(audit, ok_mask, 5719)
    audit = mix(audit, 0, 5719)
    audit = mix(audit, 0, 5719)
    if audit != 919608627 { return 5 }
    return 0
}
