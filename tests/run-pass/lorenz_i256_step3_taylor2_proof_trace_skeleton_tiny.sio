//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-3 Taylor-2 proof-trace skeleton keeps replay separate from validation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1889
    fp = mix(fp, 3, 5861)
    fp = mix(fp, 693283321, 5861)
    fp = mix(fp, 160292433, 5861)
    fp = mix(fp, 116883728, 5861)
    fp = mix(fp, 164784481, 5861)
    fp = mix(fp, 844877047, 5861)
    fp = mix(fp, 693563916, 5861)
    fp = mix(fp, 1, 5861)
    fp = mix(fp, 3, 5861)
    fp = mix(fp, 4, 5861)
    fp = mix(fp, 4, 5861)
    fp = mix(fp, 15, 5861)
    fp = mix(fp, 15, 5861)
    fp = mix(fp, 0, 5861)
    fp = mix(fp, 5, 5861)
    fp = mix(fp, 0, 5861)
    fp = mix(fp, 0, 5861)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 50354795 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1901
    fp = mix(fp, instance, 5867)
    fp = mix(fp, 4, 5867)
    fp = mix(fp, 4, 5867)
    fp = mix(fp, 15, 5867)
    fp = mix(fp, 15, 5867)
    fp = mix(fp, 15, 5867)
    fp = mix(fp, 0, 5867)
    fp = mix(fp, 5, 5867)
    fp = mix(fp, ok_mask, 5867)
    fp = mix(fp, 0, 5867)
    fp = mix(fp, 0, 5867)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 50354795 { return 0 - 1 }
    if certificate != 17187575 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1907
    fp = mix(fp, instance, 5869)
    fp = mix(fp, certificate, 5869)
    fp = mix(fp, 6, 5869)
    fp = mix(fp, 3, 5869)
    fp = mix(fp, 1, 5869)
    fp = mix(fp, 3, 5869)
    fp = mix(fp, ok_mask, 5869)
    fp = mix(fp, 0, 5869)
    fp = mix(fp, 0, 5869)
    return fp
}

fn skeleton_mask() -> i64 {
    let obligation_mask: i64 = 15
    let replay_order_mask: i64 = 15
    let validated_mask: i64 = 0
    let local_containment_mask: i64 = 0
    let global_flowpipe_mask: i64 = 0
    let trace_status: i64 = 5

    var ok_mask: i64 = 0
    if 693283321 > 0 {
        if 116883728 > 0 {
            if 164784481 > 0 {
                if 844877047 > 0 {
                    if 693563916 > 0 { ok_mask = ok_mask + 1 }
                }
            }
        }
    }
    if 4 == 4 {
        if obligation_mask == 15 { ok_mask = ok_mask + 2 }
    }
    if replay_order_mask == obligation_mask { ok_mask = ok_mask + 4 }
    if 15 == obligation_mask { ok_mask = ok_mask + 8 }
    if trace_status == 5 { ok_mask = ok_mask + 16 }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if 693283321 != 116883728 { ok_mask = ok_mask + 64 }
    if local_containment_mask == 0 {
        if global_flowpipe_mask == 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = skeleton_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 50354795 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 17187575 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 308150621 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
