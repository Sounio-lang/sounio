//@ run-pass
//@ description: #888 control — the same stores through an exclusive `&!T` stay legal on both engines
//@ expect-stdout: 36

struct P { value: i64, arr: [i64; 4] }
struct W { inner: P }

fn ok1(p: &!P) with Mut { p.value = 7 }
fn ok2(p: &!P) with Mut { (*p).value = 8 }
fn ok3(p: &!P) with Mut { p.arr[1] = 9 }
fn ok4(a: &![i64; 4]) with Mut { a[2] = 5 }
fn ok5(w: &!W) with Mut { w.inner.value = 7 }

fn main() -> i64 with IO, Mut {
    var p = P { value: 1, arr: [0; 4] }
    var w = W { inner: P { value: 1, arr: [0; 4] } }
    ok1(&!p)
    ok2(&!p)
    ok3(&!p)
    ok4(&!p.arr)
    ok5(&!w)
    println(p.value + p.arr[1] + p.arr[2] + w.inner.value + 7)
    0
}
