//@ run-pass
//@ expect-stdout: ontology roles basic OK

ontology PharmaRoles {
    class Drug
    class Disease
    role treats domain Drug range Disease
    role treated_by inverse_of treats
    role has_part transitive
    role related_to symmetric
    role parent_of functional
}

fn main() -> i32 with IO {
    println("ontology roles basic OK")
    0
}
