//@ run-pass
//@ requires: madaros

// Task 8 Step 1/2: end-to-end test against a REAL, openssl-generated X.509
// certificate's DER bytes -- not a hand-built plausible fixture. Per the
// controller's ONE deviation from this task's brief (decided before this
// dispatch): the brief offered two ways to "obtain a real certificate" --
// fetching one live via `openssl s_client -connect <site>:443` from a real
// external website, or generating a self-signed one locally. This test uses
// ONLY the self-signed path:
//
//   openssl req -x509 -newkey rsa:2048 -days 365 -nodes -subj "/CN=test.example" \
//     -keyout key.pem -out cert.pem
//   openssl x509 -in cert.pem -outform DER -out cert.der
//
// A live `s_client` fetch was deliberately ruled out: an unattended
// background agent making an outbound connection to an arbitrary
// third-party site is undesirable, and a test depending on a live site's
// certificate would become flaky/non-reproducible whenever that
// certificate rotates. The self-signed certificate below is a real,
// openssl-generated DER-encoded X.509v3 certificate with realistic wire
// bytes (RSA-2048, SHA-256, UTF8String RDNs, SKI/AKI/basicConstraints
// extensions) -- fully sufficient for this task's goal of exercising the
// parser against real bytes it did not author, and it keeps the test
// self-contained and reproducible forever.
//
// Independent cross-check performed during test authoring, via
// `openssl x509 -in cert.pem -text -noout` and `openssl asn1parse -in
// cert.der -inform DER` against this same cert.der:
//
//   Serial Number: 24:6e:12:87:8b:3c:8d:ae:ff:aa:0a:e3:c9:c7:af:24:1f:1c:80:65
//     (20 bytes, positive -- high bit of first byte 0x24 is 0)
//   Signature Algorithm: sha256WithRSAEncryption (both outer and TBS-inner
//     copies -- self-signed, so no SIG_ALG_MISMATCH)
//   Issuer: CN=test.example  (UTF8String, 12 bytes: 74 65 73 74 2E 65 78 61
//     6D 70 6C 65)
//   Subject: CN=test.example  (identical bytes -- self-signed)
//   Validity:
//     Not Before: Aug 24 16:05:34 2026 GMT -> Unix 1787587534
//     Not After : Aug 24 16:05:34 2027 GMT -> Unix 1819123534
//     (independently converted via Python's stdlib `datetime`, UTC,
//     `datetime(2026,8,24,16,5,34,tzinfo=utc).timestamp()` and the 2027
//     equivalent -- cross-checking parse_utc_time_to_unix's own
//     Y/M/D/H/M/S -> Unix arithmetic against a second implementation)
//   RSA modulus: 2048 bits (256 bytes), leading byte 0xD9, trailing byte
//     0x3F (`openssl x509 -in cert.pem -noout -modulus`, first/last two hex
//     chars: D9...3F)
//   RSA public exponent: 65537 (0x010001), openssl's default
//   Extensions (3, v3 cert): Subject Key Identifier, Authority Key
//     Identifier, Basic Constraints (critical, CA:TRUE, no pathLenConstraint)
//   TBSCertificate TLV: offset 4, header 0x30 0x82 0x01 0xF7 (long-form,
//     4-byte header, content length 503) -> total TLV length 507 bytes
//     (independently confirmed via `openssl asn1parse`: "4:d=1 hl=4 l=503
//     cons: SEQUENCE").
//   Outer signatureValue: BIT STRING, unused-bits=0, 256-byte RSA-2048
//     signature payload (`openssl asn1parse` depth-1 BIT STRING, l=257 =
//     1 unused-bits byte + 256 payload bytes).
//
// This certificate is self-signed (Issuer == Subject == CN=test.example,
// and the AKI's key identifier bytes are byte-identical to the SKI's own),
// so its own modulus/exponent verify its own outer signature -- exercised
// below via x509_verify_signature.
//
// DEVIATION FROM THE BRIEF'S LITERAL STEP 1 TEXT: the brief's cross-check
// list includes "issuer subject CN" and "issuer CN" as if they might
// differ; for a self-signed certificate they are byte-identical, so both
// checks below compare against the same expected bytes -- this is not a
// weaker test, since the parser has two INDEPENDENT call sites
// (x509_parse_name is invoked once for `issuer` and once for `subject`,
// see stdlib/x509/cert.sio's x509_parse_tbs_core), so both call sites are
// still separately exercised.
//
// KNOWN, DOCUMENTED LIMITATION NOT ASSERTED HERE (not a new finding): this
// real certificate's Authority Key Identifier extension encodes its
// extnValue as `AuthorityKeyIdentifier ::= SEQUENCE { [0] IMPLICIT
// keyIdentifier OCTET STRING, ... }` (wire bytes `30 16 80 14 <20 bytes>`),
// but stdlib/x509/cert.sio's `x509_decode_key_identifier` (shared with
// subjectKeyIdentifier's decode path) only accepts a bare OCTET STRING tag
// (0x04) at the top of the extnValue -- exactly what subjectKeyIdentifier
// itself encodes (`04 14 <20 bytes>`), but NOT what authorityKeyIdentifier
// encodes per RFC 5280 SS4.2.1.1. This is pre-existing stdlib behavior
// (Tasks 1-7, not touched by this test-only task) rather than a new
// Madaros compiler defect, so it is out of this task's scope to fix; this
// test does not assert on `cert.authority_key_id`/`authority_key_id_len`
// in either direction to avoid encoding an assumption about behavior this
// task was not chartered to change.

use asn1::der::*
use bignum::bigint::*
use net::socket::*
use x509::cert::*
use x509::oid::*

// Little-endian 16-bit limbs of the real certificate's RSA-2048 modulus,
// from `openssl x509 -in cert.pem -noout -modulus`, regrouped the same way
// as tests/run-pass/x509_verify_signature.sio's own issuer_modulus_limbs.
fn real_modulus_limbs() -> [u16; 128] {
    let r: [u16; 128] = [
        37951, 35382, 32799, 2233, 40121, 22763, 303, 31788,
        16505, 53957, 52021, 47483, 30524, 54977, 43824, 48682,
        28014, 61227, 15917, 22318, 14977, 14405, 16055, 9157,
        5471, 47438, 29471, 22038, 1933, 15096, 24241, 39253,
        63253, 38312, 58310, 5945, 57704, 48858, 31110, 38986,
        7989, 24911, 14142, 12651, 31477, 15505, 26615, 45494,
        11859, 3656, 40290, 32469, 50116, 26677, 50949, 48665,
        60746, 35213, 9468, 27325, 40940, 36311, 47022, 28578,
        37420, 9160, 26561, 2409, 19984, 16902, 29230, 54350,
        32858, 47177, 27599, 32308, 6498, 29328, 7898, 45320,
        15678, 61048, 53173, 31698, 13426, 51491, 12734, 63137,
        12463, 64847, 54282, 31560, 47058, 7837, 9756, 16370,
        42256, 56939, 30029, 7616, 47128, 3348, 25339, 47384,
        44396, 26057, 2930, 51707, 59936, 52053, 2654, 3066,
        27634, 26785, 45251, 7514, 4989, 2063, 3782, 38761,
        7438, 28073, 47592, 30901, 1439, 40140, 20417, 55762,
    ]
    r
}

fn build_bigint_128(values: [u16; 128]) -> BigInt {
    var result = bigint_zero()
    var i: i64 = 0
    while i < 128 {
        result.limbs[i as usize] = values[i as usize]
        i = i + 1
    }
    result.len = 128
    result
}

// Little-endian 16-bit limbs of the real certificate's 20-byte serial
// number (24:6e:12:87:8b:3c:8d:ae:ff:aa:0a:e3:c9:c7:af:24:1f:1c:80:65),
// padded to 16 limbs (only the first 10 are non-zero -- 20 bytes = 10
// u16 limbs).
fn real_serial_limbs() -> [u16; 16] {
    let r: [u16; 16] = [
        32869, 7964, 44836, 51655, 2787, 65450, 36270, 35644,
        4743, 9326, 0, 0, 0, 0, 0, 0,
    ]
    r
}

fn build_bigint_16(values: [u16; 16], count: i64) -> BigInt {
    var result = bigint_zero()
    var i: i64 = 0
    while i < count {
        result.limbs[i as usize] = values[i as usize]
        i = i + 1
    }
    result.len = count
    result
}

fn main() -> i64 with IO {
    let total_len: i64 = 787
    let buf = rawbuf_new(total_len + 8)

    let bytes: [i64; 787] = [
        0x30, 0x82, 0x03, 0x0F, 0x30, 0x82, 0x01, 0xF7, 0xA0, 0x03, 0x02, 0x01,
        0x02, 0x02, 0x14, 0x24, 0x6E, 0x12, 0x87, 0x8B, 0x3C, 0x8D, 0xAE, 0xFF,
        0xAA, 0x0A, 0xE3, 0xC9, 0xC7, 0xAF, 0x24, 0x1F, 0x1C, 0x80, 0x65, 0x30,
        0x0D, 0x06, 0x09, 0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D, 0x01, 0x01, 0x0B,
        0x05, 0x00, 0x30, 0x17, 0x31, 0x15, 0x30, 0x13, 0x06, 0x03, 0x55, 0x04,
        0x03, 0x0C, 0x0C, 0x74, 0x65, 0x73, 0x74, 0x2E, 0x65, 0x78, 0x61, 0x6D,
        0x70, 0x6C, 0x65, 0x30, 0x1E, 0x17, 0x0D, 0x32, 0x36, 0x30, 0x38, 0x32,
        0x34, 0x31, 0x36, 0x30, 0x35, 0x33, 0x34, 0x5A, 0x17, 0x0D, 0x32, 0x37,
        0x30, 0x38, 0x32, 0x34, 0x31, 0x36, 0x30, 0x35, 0x33, 0x34, 0x5A, 0x30,
        0x17, 0x31, 0x15, 0x30, 0x13, 0x06, 0x03, 0x55, 0x04, 0x03, 0x0C, 0x0C,
        0x74, 0x65, 0x73, 0x74, 0x2E, 0x65, 0x78, 0x61, 0x6D, 0x70, 0x6C, 0x65,
        0x30, 0x82, 0x01, 0x22, 0x30, 0x0D, 0x06, 0x09, 0x2A, 0x86, 0x48, 0x86,
        0xF7, 0x0D, 0x01, 0x01, 0x01, 0x05, 0x00, 0x03, 0x82, 0x01, 0x0F, 0x00,
        0x30, 0x82, 0x01, 0x0A, 0x02, 0x82, 0x01, 0x01, 0x00, 0xD9, 0xD2, 0x4F,
        0xC1, 0x9C, 0xCC, 0x05, 0x9F, 0x78, 0xB5, 0xB9, 0xE8, 0x6D, 0xA9, 0x1D,
        0x0E, 0x97, 0x69, 0x0E, 0xC6, 0x08, 0x0F, 0x13, 0x7D, 0x1D, 0x5A, 0xB0,
        0xC3, 0x68, 0xA1, 0x6B, 0xF2, 0x0B, 0xFA, 0x0A, 0x5E, 0xCB, 0x55, 0xEA,
        0x20, 0xC9, 0xFB, 0x0B, 0x72, 0x65, 0xC9, 0xAD, 0x6C, 0xB9, 0x18, 0x62,
        0xFB, 0x0D, 0x14, 0xB8, 0x18, 0x1D, 0xC0, 0x75, 0x4D, 0xDE, 0x6B, 0xA5,
        0x10, 0x3F, 0xF2, 0x26, 0x1C, 0x1E, 0x9D, 0xB7, 0xD2, 0x7B, 0x48, 0xD4,
        0x0A, 0xFD, 0x4F, 0x30, 0xAF, 0xF6, 0xA1, 0x31, 0xBE, 0xC9, 0x23, 0x34,
        0x72, 0x7B, 0xD2, 0xCF, 0xB5, 0xEE, 0x78, 0x3D, 0x3E, 0xB1, 0x08, 0x1E,
        0xDA, 0x72, 0x90, 0x19, 0x62, 0x7E, 0x34, 0x6B, 0xCF, 0xB8, 0x49, 0x80,
        0x5A, 0xD4, 0x4E, 0x72, 0x2E, 0x42, 0x06, 0x4E, 0x10, 0x09, 0x69, 0x67,
        0xC1, 0x23, 0xC8, 0x92, 0x2C, 0x6F, 0xA2, 0xB7, 0xAE, 0x8D, 0xD7, 0x9F,
        0xEC, 0x6A, 0xBD, 0x24, 0xFC, 0x89, 0x8D, 0xED, 0x4A, 0xBE, 0x19, 0xC7,
