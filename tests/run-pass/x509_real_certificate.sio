        0x53, 0xB1, 0xB6, 0x67, 0xF7, 0x3C, 0x91, 0x7A, 0xF5, 0x31, 0x6B, 0x37,
        0x3E, 0x61, 0x4F, 0x1F, 0x35, 0x98, 0x4A, 0x79, 0x86, 0xBE, 0xDA, 0xE1,
        0x68, 0x17, 0x39, 0xE3, 0xC6, 0x95, 0xA8, 0xF7, 0x15, 0x99, 0x55, 0x5E,
        0xB1, 0x3A, 0xF8, 0x07, 0x8D, 0x56, 0x16, 0x73, 0x1F, 0xB9, 0x4E, 0x15,
        0x5F, 0x23, 0xC5, 0x3E, 0xB7, 0x38, 0x45, 0x3A, 0x81, 0x57, 0x2E, 0x3E,
        0x2D, 0xEF, 0x2B, 0x6D, 0x6E, 0xBE, 0x2A, 0xAB, 0x30, 0xD6, 0xC1, 0x77,
        0x3C, 0xB9, 0x7B, 0xCB, 0x35, 0xD2, 0xC5, 0x40, 0x79, 0x7C, 0x2C, 0x01,
        0x2F, 0x58, 0xEB, 0x9C, 0xB9, 0x08, 0xB9, 0x80, 0x1F, 0x8A, 0x36, 0x94,
        0x3F, 0x02, 0x03, 0x01, 0x00, 0x01, 0xA3, 0x53, 0x30, 0x51, 0x30, 0x1D,
        0x06, 0x03, 0x55, 0x1D, 0x0E, 0x04, 0x16, 0x04, 0x14, 0x7E, 0x92, 0x7F,
        0x6A, 0x11, 0x0C, 0xD4, 0x73, 0x7D, 0xB3, 0x61, 0x31, 0x24, 0x89, 0x96,
        0x79, 0xDB, 0x47, 0x5D, 0xBD, 0x30, 0x1F, 0x06, 0x03, 0x55, 0x1D, 0x23,
        0x04, 0x18, 0x30, 0x16, 0x80, 0x14, 0x7E, 0x92, 0x7F, 0x6A, 0x11, 0x0C,
        0xD4, 0x73, 0x7D, 0xB3, 0x61, 0x31, 0x24, 0x89, 0x96, 0x79, 0xDB, 0x47,
        0x5D, 0xBD, 0x30, 0x0F, 0x06, 0x03, 0x55, 0x1D, 0x13, 0x01, 0x01, 0xFF,
        0x04, 0x05, 0x30, 0x03, 0x01, 0x01, 0xFF, 0x30, 0x0D, 0x06, 0x09, 0x2A,
        0x86, 0x48, 0x86, 0xF7, 0x0D, 0x01, 0x01, 0x0B, 0x05, 0x00, 0x03, 0x82,
        0x01, 0x01, 0x00, 0x51, 0x22, 0xD4, 0x2A, 0xBD, 0xB1, 0xD2, 0x2F, 0x1A,
        0x9C, 0xBC, 0xFB, 0xA8, 0xE1, 0x32, 0x42, 0x7B, 0xF6, 0x3C, 0xAF, 0x7A,
        0x6A, 0xA7, 0x6E, 0x10, 0xFF, 0x6E, 0xCC, 0xB9, 0x5B, 0x1A, 0xF5, 0xE9,
        0xDC, 0x51, 0xD8, 0xF8, 0xD3, 0xCE, 0xCA, 0xDC, 0xDF, 0xBB, 0xE1, 0x6D,
        0x91, 0x67, 0x83, 0x74, 0x96, 0xB3, 0xD9, 0x12, 0x92, 0x75, 0xC2, 0x06,
        0x78, 0x6D, 0x75, 0x45, 0x5E, 0xD8, 0x5B, 0xF8, 0x70, 0x81, 0x26, 0x53,
        0x45, 0x8A, 0x1A, 0x31, 0xA4, 0x15, 0x63, 0x35, 0xD7, 0x3A, 0xC7, 0x18,
        0x1D, 0xFD, 0xAF, 0xDB, 0xBB, 0x3A, 0x8E, 0xE0, 0x82, 0xA6, 0x6E, 0x67,
        0x65, 0x75, 0x84, 0xAC, 0x8A, 0xC9, 0xCA, 0x30, 0x6B, 0x72, 0x1C, 0x3C,
        0xA1, 0x9F, 0xE9, 0xFD, 0xFE, 0x5B, 0x82, 0xC1, 0xD4, 0xFB, 0x87, 0xA7,
        0xA2, 0x29, 0xFE, 0xC0, 0xF4, 0x6F, 0xF2, 0x71, 0xAB, 0x4F, 0x40, 0x2A,
        0x82, 0x04, 0x41, 0x0B, 0x8F, 0x6B, 0xAA, 0x1C, 0xB2, 0x68, 0x20, 0xB3,
        0x01, 0x8A, 0xCD, 0x83, 0x4F, 0x63, 0x08, 0x8C, 0x55, 0xB9, 0xC2, 0xC1,
        0x84, 0x40, 0x1C, 0x4E, 0x62, 0x7A, 0xC5, 0x4F, 0x1C, 0x6E, 0xFF, 0x00,
        0x0F, 0x08, 0x9A, 0xFB, 0x4E, 0x16, 0xC9, 0x4E, 0x8D, 0x52, 0xA0, 0x22,
        0x00, 0x07, 0xA5, 0x9E, 0x10, 0x85, 0x4F, 0xF0, 0xE1, 0xBF, 0x67, 0xE1,
        0x3B, 0x40, 0xEA, 0xCB, 0x66, 0x39, 0xE0, 0x75, 0x9C, 0x3D, 0xF2, 0xD8,
        0x1F, 0x61, 0x2B, 0x99, 0xC1, 0x28, 0xF3, 0x10, 0x5D, 0x1A, 0xC8, 0xF0,
        0xD0, 0x6D, 0xD4, 0x46, 0xD4, 0xC7, 0x48, 0xCD, 0xDA, 0xA3, 0x0F, 0x49,
        0xF0, 0x5C, 0x56, 0x89, 0xBD, 0x2C, 0x04, 0xA0, 0x1E, 0xF9, 0x24, 0xC1,
        0x6E, 0xC9, 0xE6, 0xE2, 0xA0, 0x33, 0x51, 0x91, 0xA6, 0xAE, 0x6F, 0x3B,
        0x15, 0xA2, 0xB2, 0xAF, 0xF4, 0xCF, 0x7A,
    ]

    var i: i64 = 0
    while i < total_len {
        rawbuf_set(&buf, i, bytes[i as usize])
        i = i + 1
    }

    // Per Finding 25's workaround (tuple-destructured struct-typed local
    // does not propagate the struct type): declare `cert` first via
    // certificate_zero(), then overwrite its VALUE via assignment.
    var cert = certificate_zero()
    let (cert_raw, status) = x509_parse_certificate(&buf, total_len)
    cert = cert_raw

    if status != X509_OK {
        print_int(1)
        return 1
    }
    assert(status == X509_OK)

    // TBSCertificate TLV: offset 4, total length 507 (long-form header 4
    // bytes + 503 content bytes) -- confirmed via `openssl asn1parse`.
    if cert.tbs_start != 4 {
        print_int(2)
        return 1
    }
    assert(cert.tbs_start == 4)
    if cert.tbs_len != 507 {
        print_int(3)
        return 1
    }
    assert(cert.tbs_len == 507)

    // Serial number: 20-byte positive integer, cross-checked against
    // `openssl x509 -text -noout`'s own Serial Number field.
    let expected_serial = build_bigint_16(real_serial_limbs(), 10)
    if bigint_cmp(&cert.serial_number, &expected_serial) != 0 {
        print_int(4)
        return 1
    }
    assert(bigint_cmp(&cert.serial_number, &expected_serial) == 0)

    // Subject CN and Issuer CN: both "test.example" (self-signed), 12 bytes.
    if cert.issuer.count != 1 {
        print_int(5)
        return 1
    }
    assert(cert.issuer.count == 1)
    if cert.issuer.entries[0].value_len != 12 {
        print_int(6)
        return 1
    }
    assert(cert.issuer.entries[0].value_len == 12)
    if (cert.issuer.entries[0].value[0] as i64) != 0x74 {
        print_int(7)
        return 1
    }
    if (cert.issuer.entries[0].value[11] as i64) != 0x65 {
        print_int(8)
        return 1
    }
    assert((cert.issuer.entries[0].value[0] as i64) == 0x74)
    assert((cert.issuer.entries[0].value[11] as i64) == 0x65)

    if cert.subject.count != 1 {
        print_int(9)
        return 1
    }
    assert(cert.subject.count == 1)
    if cert.subject.entries[0].value_len != 12 {
        print_int(10)
        return 1
    }
    assert(cert.subject.entries[0].value_len == 12)
    if (cert.subject.entries[0].value[0] as i64) != 0x74 {
        print_int(11)
        return 1
    }
    if (cert.subject.entries[0].value[11] as i64) != 0x65 {
        print_int(12)
        return 1
    }
    assert((cert.subject.entries[0].value[0] as i64) == 0x74)
    assert((cert.subject.entries[0].value[11] as i64) == 0x65)

    // Validity dates, converted to Unix timestamps (independently
    // cross-checked against Python's `datetime` for the same UTC Y/M/D/H/M/S).
    if cert.not_before_unix != 1787587534 {
        print_int(13)
        return 1
    }
    assert(cert.not_before_unix == 1787587534)
    if cert.not_after_unix != 1819123534 {
        print_int(14)
        return 1
    }
    assert(cert.not_after_unix == 1819123534)

    // RSA modulus: first/last few bytes cross-checked against `openssl x509
    // -noout -modulus` (leading 0xD9, trailing 0x3F).
    let expected_modulus = build_bigint_128(real_modulus_limbs())
    if bigint_cmp(&cert.modulus, &expected_modulus) != 0 {
        print_int(15)
        return 1
    }
    assert(bigint_cmp(&cert.modulus, &expected_modulus) == 0)

    let expected_exponent = bigint_from_u32(65537)
    if bigint_cmp(&cert.public_exponent, &expected_exponent) != 0 {
        print_int(16)
        return 1
    }
    assert(bigint_cmp(&cert.public_exponent, &expected_exponent) == 0)

    // v3 extensions: Subject Key Identifier + Authority Key Identifier +
    // Basic Constraints (critical, CA:TRUE, no pathLenConstraint).
    if cert.extension_count != 3 {
        print_int(17)
        return 1
    }
    assert(cert.extension_count == 3)
    if cert.is_ca != true {
        print_int(18)
        return 1
    }
    assert(cert.is_ca == true)
    if cert.path_len_constraint != (0 - 1) {
        print_int(19)
        return 1
    }
    assert(cert.path_len_constraint == (0 - 1))

    // Outer signature: 256-byte RSA-2048/SHA-256 signature payload.
    if cert.outer_signature_len != 256 {
        print_int(20)
        return 1
    }
    assert(cert.outer_signature_len == 256)

    // Self-signed: this certificate's OWN modulus/exponent must verify its
    // own outer signature. x509_verify_signature now takes the issuer's
    // full Certificate (so it can branch on issuer.public_key_algorithm) --
    // for a self-signed cert, issuer == cert itself.
    let ok = x509_verify_signature(&buf, &cert, &cert)
    if ok == false {
        print_int(21)
        return 1
    }
    assert(ok)

    println("x509_real_certificate: real openssl-generated self-signed certificate parses and self-verifies correctly")
    return 0
}
