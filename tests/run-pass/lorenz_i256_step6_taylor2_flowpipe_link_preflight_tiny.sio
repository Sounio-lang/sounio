//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 Taylor-2 flowpipe link preflight

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 701
    fp = mix(fp, 6, 4241)
    fp = mix(fp, 316597079, 4241)
    fp = mix(fp, 476878195, 4241)
    fp = mix(fp, 506104143, 4241)
    fp = mix(fp, 956295573, 4241)
    fp = mix(fp, 652877359, 4241)
    fp = mix(fp, 344816971, 4241)
    fp = mix(fp, 975464919, 4241)
    fp = mix(fp, 641464796, 4241)
    fp = mix(fp, 2, 4241)
    fp = mix(fp, 1, 4241)
    fp = mix(fp, 100, 4241)
    fp = mix(fp, 256, 4241)
    fp = mix(fp, 32, 4241)
    fp = mix(fp, 7, 4241)
    fp = mix(fp, 127, 4241)
    fp = mix(fp, 127, 4241)
    fp = mix(fp, 15, 4241)
    fp = mix(fp, 0, 4241)
    fp = mix(fp, 11, 4241)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 831922075 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    var fp: i64 = 709
    fp = mix(fp, instance, 4253)
    fp = mix(fp, 7, 4253)
    fp = mix(fp, 127, 4253)
    fp = mix(fp, 127, 4253)
    fp = mix(fp, 15, 4253)
    fp = mix(fp, 0, 4253)
    fp = mix(fp, 11, 4253)
    fp = mix(fp, 2, 4253)
    fp = mix(fp, 1, 4253)
    fp = mix(fp, 100, 4253)
    fp = mix(fp, 256, 4253)
    fp = mix(fp, 32, 4253)
    fp = mix(fp, ok_mask, 4253)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 831922075 { return 0 - 1 }
    if certificate != 453371086 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    var fp: i64 = 719
    fp = mix(fp, instance, 4259)
    fp = mix(fp, certificate, 4259)
    fp = mix(fp, 12, 4259)
    fp = mix(fp, 6, 4259)
    fp = mix(fp, 7, 4259)
    fp = mix(fp, 127, 4259)
    fp = mix(fp, 127, 4259)
    fp = mix(fp, 15, 4259)
    fp = mix(fp, 0, 4259)
    fp = mix(fp, 11, 4259)
    fp = mix(fp, ok_mask, 4259)
    return fp
}

fn preflight_mask() -> i64 {
    let scalar_inclusion_mask: i64 = 7
    let response_mask: i64 = 127
    let remainder_ok_mask: i64 = 127
    let proof_trace_replay_mask: i64 = 15
    let flowpipe_proof_mask: i64 = 0
    let link_status_preflight: i64 = 11

    var ok_mask: i64 = 0
    if 316597079 > 0 {
        if 506104143 > 0 { ok_mask = ok_mask + 1 }
    }
    if 652877359 > 0 {
        if 975464919 > 0 { ok_mask = ok_mask + 2 }
    }
    if 2 == 2 {
        if 1 == 1 {
            if 100 == 100 { ok_mask = ok_mask + 4 }
        }
    }
    if scalar_inclusion_mask == 7 {
        if response_mask == 127 {
            if remainder_ok_mask == 127 { ok_mask = ok_mask + 8 }
        }
    }
    if flowpipe_proof_mask == 0 {
        if link_status_preflight == 11 { ok_mask = ok_mask + 16 }
    }
    if response_mask == 127 {
        if 641464796 > 0 { ok_mask = ok_mask + 32 }
    }
    if proof_trace_replay_mask == 15 {
        if 975464919 > 0 { ok_mask = ok_mask + 64 }
    }
    if 256 == 256 {
        if 32 == 32 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = preflight_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 831922075 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 453371086 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 956152878 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
