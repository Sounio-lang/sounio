//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v77 smoke for Lorenz i256 step-5 Taylor-2 replay executor entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1367
    receipt_fp = mix(receipt_fp, 225293164, 5153)
    receipt_fp = mix(receipt_fp, 897523976, 5153)
