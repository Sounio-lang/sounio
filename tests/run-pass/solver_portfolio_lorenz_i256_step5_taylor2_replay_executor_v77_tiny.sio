    receipt_fp = mix(receipt_fp, 320835674, 5153)
    receipt_fp = mix(receipt_fp, 5, 5153)
    receipt_fp = mix(receipt_fp, 8, 5153)
    receipt_fp = mix(receipt_fp, 255, 5153)
