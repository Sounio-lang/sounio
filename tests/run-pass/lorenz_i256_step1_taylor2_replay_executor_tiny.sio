//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-1 Taylor-2 replay executor checks node and edge replay masks

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1321
    fp = mix(fp, 1, 5113)
    fp = mix(fp, 261545659, 5113)
    fp = mix(fp, 928945135, 5113)
    fp = mix(fp, 174108453, 5113)
    fp = mix(fp, 620127047, 5113)
    fp = mix(fp, 496675613, 5113)
    fp = mix(fp, 472667880, 5113)
    fp = mix(fp, 133154696, 5113)
    fp = mix(fp, 265853299, 5113)
    fp = mix(fp, 1, 5113)
    fp = mix(fp, 1, 5113)
    fp = mix(fp, 4, 5113)
    fp = mix(fp, 4, 5113)
    fp = mix(fp, 15, 5113)
    fp = mix(fp, 15, 5113)
    fp = mix(fp, 15, 5113)
    fp = mix(fp, 15, 5113)
    fp = mix(fp, 0, 5113)
    fp = mix(fp, 7, 5113)
    fp = mix(fp, 0, 5113)
    fp = mix(fp, 0, 5113)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 388821571 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1327
    fp = mix(fp, instance, 5119)
    fp = mix(fp, 4, 5119)
    fp = mix(fp, 4, 5119)
    fp = mix(fp, 15, 5119)
    fp = mix(fp, 15, 5119)
    fp = mix(fp, 15, 5119)
    fp = mix(fp, 15, 5119)
    fp = mix(fp, 0, 5119)
    fp = mix(fp, 7, 5119)
    fp = mix(fp, ok_mask, 5119)
    fp = mix(fp, 0, 5119)
    fp = mix(fp, 0, 5119)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 388821571 { return 0 - 1 }
    if certificate != 316195300 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1329
    fp = mix(fp, instance, 5123)
    fp = mix(fp, certificate, 5123)
    fp = mix(fp, 8, 5123)
    fp = mix(fp, 1, 5123)
    fp = mix(fp, 1, 5123)
    fp = mix(fp, 1, 5123)
    fp = mix(fp, 7, 5123)
    fp = mix(fp, ok_mask, 5123)
    fp = mix(fp, 0, 5123)
    fp = mix(fp, 0, 5123)
    return fp
}

fn replay_execution_mask() -> i64 {
    let node_receipt_mask: i64 = 15
    let edge_receipt_mask: i64 = 15
    let replayed_node_mask: i64 = 15
    let predecessor_ready_mask: i64 = 15
    let validated_mask: i64 = 0
    let local_containment_mask: i64 = 0
    let global_flowpipe_mask: i64 = 0
    let replay_status: i64 = 7

    var ok_mask: i64 = 0
    if 261545659 > 0 {
        if 174108453 > 0 {
            if 620127047 > 0 { ok_mask = ok_mask + 1 }
        }
    }
    if node_receipt_mask == 15 { ok_mask = ok_mask + 2 }
    if edge_receipt_mask == node_receipt_mask { ok_mask = ok_mask + 4 }
    if replayed_node_mask == node_receipt_mask {
        if predecessor_ready_mask == edge_receipt_mask { ok_mask = ok_mask + 8 }
    }
    if replay_status == 7 { ok_mask = ok_mask + 16 }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if 261545659 != 174108453 {
        if 174108453 != 620127047 { ok_mask = ok_mask + 64 }
    }
    if local_containment_mask == 0 {
        if global_flowpipe_mask == 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = replay_execution_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 388821571 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 316195300 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 815221512 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
