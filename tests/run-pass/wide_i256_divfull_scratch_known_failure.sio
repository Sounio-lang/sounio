//@ run-pass
//@ known-failure: source-level i256 OpDiv lowers to IrWideDivFull whose hidden temporaries collide until the rebuilt lowerer reserves scratch registers
//@ description: Regression pin for adjacent source-level i256 divisions feeding a subtraction

fn main() -> i64 {
    let scale: i256 = 1000000 as i256
    let x: i256 = scale
    let y: i256 = scale
    let z: i256 = scale
    let beta_num: i256 = 8 as i256
    let beta_den: i256 = 3 as i256

    let xy_scaled: i256 = (x * y) / scale
    let beta_z: i256 = (beta_num * z) / beta_den
    let dz: i256 = xy_scaled - beta_z

    if xy_scaled != scale { return 1 }
    if beta_z != (2666666 as i256) { return 2 }
    if dz != ((0 as i256) - (1666666 as i256)) { return 3 }
    return 0
}
