//@ run-pass
//@ expect-stdout: BOX_FIELD_LET_KEEPS_HANDLE_OK
// `let b = o.f` on a field declared Box<T> binds the Box handle; it is not a
// value copy of T. The SIO-278 place copy looked through the Box and rebuilt
// the one-slot Box object as a T, so after `lo.cur = reused` the Box slot held
// a fake T whose array fields were garbage (ud2 in a Madaros-built gen2, #2966).
// The write through `reused` must also be visible through `lo.cur`.
struct Nm { len: i64, id: i64 }
struct Fn3 { name: Nm, regs: [i64; 8], bits: [i64; 8] }
struct Lo { cur: Box<Fn3>, n: i64 }

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    var lo = Lo { cur: Box::new(Fn3 { name: Nm { len: 0, id: 0 }, regs: [7; 8], bits: [3; 8] }), n: 0 }
    var k: i64 = 0
    while k < 3 {
        var reused = lo.cur
        (*reused).bits[1] = (*reused).bits[1] + 10
        (*reused).name = Nm { len: k, id: k + 1 }
        lo.cur = reused
        k = k + 1
    }
    let total = (*lo.cur).bits[1] + (*lo.cur).regs[2] + (*lo.cur).name.id
    if total == 33 + 7 + 3 {
        println("BOX_FIELD_LET_KEEPS_HANDLE_OK")
    } else {
        print("BOX_FIELD_LET_KEEPS_HANDLE_BAD ")
        println(total)
    }
    0
}
