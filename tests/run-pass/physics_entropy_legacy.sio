//@ run-pass
//@ expect-stdout: PHYSICS_ENTROPY_LEGACY_PASS
use physics::sr::{compton_shift}
use physics::entropy::{isothermal_entropy_independent}
use physics::thermo::{isothermal_entropy,test_ideal_gas,test_first_law,
 test_carnot,test_boltzmann,test_adiabatic,test_isobaric,test_carnot_cycle,test_entropy_prod}
fn main() with IO,Mut,Div,Panic {
 let r=isothermal_entropy_independent(1.0,0.01,2.0,0.02,1.0,0.01)
 let (s,u)=isothermal_entropy(1.0,0.01,2.0,0.02,1.0,0.01)
 assert(r.status==0 && s==r.delta_s && u==r.standard_uncertainty)
 let (equal_s,equal_u)=isothermal_entropy(1.0,0.0,1.0,0.01,1.0,0.01)
 assert(equal_s==0.0 && equal_u>0.0)
 let (bad_s,bad_u)=isothermal_entropy(1.0,0.0,0.0,0.01,1.0,0.01)
 assert(bad_s==0.0 && bad_u== -1.0)
 assert(test_ideal_gas() && test_first_law() && test_carnot() && test_boltzmann())
 assert(test_adiabatic() && test_isobaric() && test_carnot_cycle() && test_entropy_prod())
 let (shift,angular_u)=compton_shift(1.57079632679489661923,0.01)
 assert(shift>0.0 && angular_u>0.0)
 println("PHYSICS_ENTROPY_LEGACY_PASS")
 0
}
