//@ run-pass
//@ expect-stdout-contains: knowledge_acknowledge: PASS
//@ description: acknowledge() explicitly extracts value from Knowledge<T> without requiring Epistemic effect

fn main() with IO {
    let k = measure(42.0, uncertainty: 2.5)
    let v: f64 = acknowledge(k, "accepted for testing purposes")

    if v == 42.0 {
        print("knowledge_acknowledge: PASS\n")
    } else {
        print("knowledge_acknowledge: FAIL\n")
    }
}
