//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS generic_impl_clone_order
// A generic impl's method statically calls another generic struct's impl.
// Lowering types `let a = A::<T>::mk(..)` from A__i64_mk's return struct, and
// the single-module preseed never registered impl method summaries, so that
// return was only known if A's clone happened to be lowered first. `impl B`
// sat ahead of A__i64, `a.get()` lowered to a body-less bare `get`, and the
// program died with SIGILL. P/Q reverses the declaration order, and X/Y call
// each other, which no item order can satisfy.

struct A<T> {
    v: T,
}

impl A<T> {
    fn mk(v: T) -> A<T> {
        A { v: v }
    }
    fn get(self: &A<T>) -> T {
        self.v
    }
}

struct B<T> {
    v: T,
}

impl B<T> {
    fn mk(v: T) -> B<T> {
        B { v: v }
    }
    fn via_a(self: &B<T>) -> T {
        let a = A::<T>::mk(self.v)
        a.get()
    }
}

struct P<T> {
    v: T,
}

impl P<T> {
    fn mk(v: T) -> P<T> {
        P { v: v }
    }
    fn via_q(self: &P<T>) -> T {
        let q = Q::<T>::mk(self.v)
        q.get()
    }
}

struct Q<T> {
    v: T,
}

impl Q<T> {
    fn mk(v: T) -> Q<T> {
        Q { v: v }
    }
    fn get(self: &Q<T>) -> T {
        self.v
    }
}

struct X<T> {
    v: T,
}

impl X<T> {
    fn mk(v: T) -> X<T> {
        X { v: v }
    }
    fn get(self: &X<T>) -> T {
        self.v
    }
    fn via_y(self: &X<T>) -> T {
        let y = Y::<T>::mk(self.v)
        y.get()
    }
}

struct Y<T> {
    v: T,
}

impl Y<T> {
    fn mk(v: T) -> Y<T> {
        Y { v: v }
    }
    fn get(self: &Y<T>) -> T {
        self.v
    }
    fn via_x(self: &Y<T>) -> T {
        let x = X::<T>::mk(self.v)
        x.get()
    }
}

fn main() -> i32 with IO {
    let b = B::<i64>::mk(3)
    if b.via_a() != 3 {
        print("FAIL b.via_a\n")
        return 1
    }
    let p = P::<i64>::mk(4)
    if p.via_q() != 4 {
        print("FAIL p.via_q\n")
        return 1
    }
    let bf = B::<f64>::mk(2.5)
    let got = bf.via_a()
    if got < 2.49 || got > 2.51 {
        print("FAIL bf.via_a\n")
        return 1
    }
    let x = X::<i64>::mk(5)
    if x.via_y() != 5 {
        print("FAIL x.via_y\n")
        return 1
    }
    let y = Y::<i64>::mk(6)
    if y.via_x() != 6 {
        print("FAIL y.via_x\n")
        return 1
    }
    print("PASS generic_impl_clone_order\n")
    return 0
}
