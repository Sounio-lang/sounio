//@ run-pass
// Sprint 228: Higher-order function patterns with first-class function references

fn dbl(x: i64) -> i64 { x * 2 }
fn sq(x: i64) -> i64 { x * x }
fn add(a: i64, b: i64) -> i64 { a + b }
fn mul(a: i64, b: i64) -> i64 { a * b }
fn max2(a: i64, b: i64) -> i64 { if a > b { a } else { b } }
fn is_positive(x: i64) -> i64 { if x > 0 { 1 } else { 0 } }
fn is_gt3(x: i64) -> i64 { if x > 3 { 1 } else { 0 } }
fn is_gt10(x: i64) -> i64 { if x > 10 { 1 } else { 0 } }
fn is_gt2(x: i64) -> i64 { if x > 2 { 1 } else { 0 } }

fn map4(arr: [i64; 4], f: fn(i64) -> i64) -> [i64; 4] with Mut, Panic, Div {
    var out: [i64; 4] = [0; 4]
    var i: i64 = 0
    while i < 4 { out[i] = f(arr[i]); i = i + 1 }
    out
}

fn fold4(arr: [i64; 4], init: i64, f: fn(i64, i64) -> i64) -> i64 with Mut, Panic, Div {
    var acc = init
    var i: i64 = 0
    while i < 4 { acc = f(acc, arr[i]); i = i + 1 }
    acc
}

fn any4(arr: [i64; 4], pred: fn(i64) -> i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < 4 {
        if pred(arr[i]) != 0 { return 1 }
        i = i + 1
    }
    0
}

fn all4(arr: [i64; 4], pred: fn(i64) -> i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < 4 {
        if pred(arr[i]) == 0 { return 0 }
        i = i + 1
    }
    1
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let data: [i64; 4] = [1, 2, 3, 4]

    // Test 1: map — double each element
    let doubled = map4(data, dbl)
    assert(doubled[0] == 2)
    assert(doubled[1] == 4)
    assert(doubled[2] == 6)
    assert(doubled[3] == 8)

    // Test 2: map — square each element
    let squared = map4(data, sq)
    assert(squared[0] == 1)
    assert(squared[1] == 4)
    assert(squared[2] == 9)
    assert(squared[3] == 16)

    // Test 3: fold — sum
    let sum = fold4(data, 0, add)
    assert(sum == 10)

    // Test 4: fold — product
    let product = fold4(data, 1, mul)
    assert(product == 24)

    // Test 5: fold — max
    let max_val = fold4(data, 0, max2)
    assert(max_val == 4)

    // Test 6: any — has element > 3?
    let has_gt3 = any4(data, is_gt3)
    assert(has_gt3 == 1)

    // Test 7: any — has element > 10?
    let has_gt10 = any4(data, is_gt10)
    assert(has_gt10 == 0)

    // Test 8: all — all positive?
    let all_pos = all4(data, is_positive)
    assert(all_pos == 1)

    // Test 9: all — all > 2?
    let all_gt2 = all4(data, is_gt2)
    assert(all_gt2 == 0)

    // Test 10: chained — sum of squares
    let sum_sq = fold4(map4(data, sq), 0, add)
    assert(sum_sq == 30)

    print(0)
    0
}
