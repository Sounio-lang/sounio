//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 cover-refinement ledger non-claim receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1801
    fp = mix(fp, 911169246, 5741)
    fp = mix(fp, 785916873, 5741)
    fp = mix(fp, 820916947, 5741)
    fp = mix(fp, 527721765, 5741)
    fp = mix(fp, 437511874, 5741)
    fp = mix(fp, 461075499, 5741)
    fp = mix(fp, 641858696, 5741)
    fp = mix(fp, 713010204, 5741)
    fp = mix(fp, 725222703, 5741)
    fp = mix(fp, 77888110, 5741)
    fp = mix(fp, 245178976, 5741)
    fp = mix(fp, 114244647, 5741)
    fp = mix(fp, 166945519, 5741)
    fp = mix(fp, 1, 5741)
    fp = mix(fp, 1, 5741)
    fp = mix(fp, 3, 5741)
    fp = mix(fp, 2, 5741)
    fp = mix(fp, 8, 5741)
    fp = mix(fp, 8, 5741)
    fp = mix(fp, 0, 5741)
    fp = mix(fp, 256, 5741)
    fp = mix(fp, 32, 5741)
    fp = mix(fp, 1000000, 5741)
    fp = mix(fp, 5, 5741)
    fp = mix(fp, 1, 5741)
    fp = mix(fp, 31, 5741)
    fp = mix(fp, 7, 5741)
    fp = mix(fp, 15, 5741)
    fp = mix(fp, 0, 5741)
    fp = mix(fp, 0, 5741)
    fp = mix(fp, 29, 5741)
    return fp
}

fn certificate_fp(instance: i64) -> i64 {
    var fp: i64 = 1811
    fp = mix(fp, instance, 5749)
    fp = mix(fp, 31, 5749)
    fp = mix(fp, 7, 5749)
    fp = mix(fp, 15, 5749)
    fp = mix(fp, 8, 5749)
    fp = mix(fp, 8, 5749)
    fp = mix(fp, 0, 5749)
    fp = mix(fp, 0, 5749)
    fp = mix(fp, 0, 5749)
    fp = mix(fp, 1, 5749)
    fp = mix(fp, 29, 5749)
    fp = mix(fp, 255, 5749)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64) -> i64 {
    var fp: i64 = 1823
    fp = mix(fp, instance, 5779)
    fp = mix(fp, certificate, 5779)
    fp = mix(fp, 21, 5779)
    fp = mix(fp, 8, 5779)
    fp = mix(fp, 8, 5779)
    fp = mix(fp, 0, 5779)
    fp = mix(fp, 1, 5779)
    fp = mix(fp, 0, 5779)
    fp = mix(fp, 0, 5779)
    fp = mix(fp, 29, 5779)
    fp = mix(fp, 255, 5779)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64) -> i64 {
    var fp: i64 = 1831
    fp = mix(fp, artifact, 5801)
    fp = mix(fp, instance, 5801)
    fp = mix(fp, certificate, 5801)
    fp = mix(fp, 911169246, 5801)
    fp = mix(fp, 785916873, 5801)
    fp = mix(fp, 820916947, 5801)
    fp = mix(fp, 527721765, 5801)
    fp = mix(fp, 437511874, 5801)
    fp = mix(fp, 461075499, 5801)
    fp = mix(fp, 641858696, 5801)
    fp = mix(fp, 713010204, 5801)
    fp = mix(fp, 725222703, 5801)
    fp = mix(fp, 77888110, 5801)
    fp = mix(fp, 245178976, 5801)
    fp = mix(fp, 114244647, 5801)
    fp = mix(fp, 166945519, 5801)
    fp = mix(fp, 1, 5801)
    fp = mix(fp, 1, 5801)
    fp = mix(fp, 3, 5801)
    fp = mix(fp, 2, 5801)
    fp = mix(fp, 8, 5801)
    fp = mix(fp, 8, 5801)
    fp = mix(fp, 0, 5801)
    fp = mix(fp, 256, 5801)
    fp = mix(fp, 32, 5801)
    fp = mix(fp, 1000000, 5801)
    fp = mix(fp, 5, 5801)
    fp = mix(fp, 1, 5801)
    fp = mix(fp, 31, 5801)
    fp = mix(fp, 7, 5801)
    fp = mix(fp, 15, 5801)
    fp = mix(fp, 0, 5801)
    fp = mix(fp, 0, 5801)
    fp = mix(fp, 29, 5801)
    fp = mix(fp, 255, 5801)
    return fp
}

fn main() -> i64 {
    let instance = instance_fp()
    if instance != 236980132 { return 1 }
    let certificate = certificate_fp(instance)
    if certificate != 747708140 { return 2 }
    let artifact = artifact_fp(instance, certificate)
    if artifact != 239912256 { return 3 }
    let audit = audit_fp(artifact, instance, certificate)
    if audit != 937619929 { return 4 }
    return 0
}
