//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 projection certificate dependency-DAG receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn dependency_dag_fingerprint(dependency_mask: i64) -> i64 {
    if dependency_mask != 127 { return 0 - 1 }

    var fp: i64 = 397
    fp = mix(fp, 77888110, 2711)
    fp = mix(fp, 245178976, 2711)
    fp = mix(fp, 214180161, 2711)
    fp = mix(fp, 63872871, 2711)
    fp = mix(fp, 326517892, 2711)
    fp = mix(fp, 547731575, 2711)
    fp = mix(fp, 291678314, 2711)
    fp = mix(fp, 916832909, 2711)
    fp = mix(fp, 137630154, 2711)
    fp = mix(fp, 116461241, 2711)
    fp = mix(fp, 628994509, 2711)
    fp = mix(fp, 775818863, 2711)
    fp = mix(fp, 601279541, 2711)
    fp = mix(fp, 585753742, 2711)
    fp = mix(fp, 502768484, 2711)
    fp = mix(fp, 44126209, 2711)
    fp = mix(fp, 490367409, 2711)
    fp = mix(fp, 297819393, 2711)
    fp = mix(fp, 162915880, 2711)
    fp = mix(fp, 189652817, 2711)
    fp = mix(fp, 622328210, 2711)
    fp = mix(fp, 836439604, 2711)
    fp = mix(fp, 163659586, 2711)
    fp = mix(fp, 7, 2711)
    fp = mix(fp, 10, 2711)
    fp = mix(fp, dependency_mask, 2711)
    return fp
}

fn dependency_dag_audit_fingerprint(dag_fp: i64) -> i64 {
    if dag_fp != 713010204 { return 0 - 1 }

    var fp: i64 = 401
    fp = mix(fp, dag_fp, 2729)
    fp = mix(fp, 77888110, 2729)
    fp = mix(fp, 245178976, 2729)
    fp = mix(fp, 214180161, 2729)
    fp = mix(fp, 63872871, 2729)
    fp = mix(fp, 547731575, 2729)
    fp = mix(fp, 916832909, 2729)
    fp = mix(fp, 116461241, 2729)
    fp = mix(fp, 775818863, 2729)
    fp = mix(fp, 585753742, 2729)
    fp = mix(fp, 44126209, 2729)
    fp = mix(fp, 297819393, 2729)
    fp = mix(fp, 189652817, 2729)
    fp = mix(fp, 836439604, 2729)
    fp = mix(fp, 127, 2729)
    return fp
}

fn main() -> i64 {
    let fp = dependency_dag_fingerprint(127)
    if fp != 713010204 { return 1 }
    let audit_fp = dependency_dag_audit_fingerprint(fp)
    if audit_fp != 725222703 { return 2 }
    if dependency_dag_fingerprint(126) != (0 - 1) { return 3 }
    return 0
}
