//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 projection quotient/remainder witnesses factored through div_witness

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let fp = lorenz_i256_projection_div_witness_fingerprint(
        214180161, 4294967296, 1000000,
        5309941770, 10058731223, 4084837935,
        1236317, 687511168,
        2341980, 3715113920,
        951075, 1913956800,
        890086395)
    if fp != 693793961 { return 1 }

    let audit_fp = lorenz_i256_projection_div_witness_audit_fingerprint(
        fp, 677514412, 69322697, 890086395, 31)
    if audit_fp != 659349019 { return 2 }

    if lorenz_i256_projection_div_witness_fingerprint(
        214180161, 4294967296, 1000000,
        5309941770, 10058731223, 4084837935,
        1236317, 687511169,
        2341980, 3715113920,
        951075, 1913956800,
        890086395) != (0 - 1) { return 3 }

    return 0
}
