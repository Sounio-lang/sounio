//@ run-pass
//@ requires: madaros
//@ expect-stdout: n0 0.090000
//@ expect-stdout: n3 1.440000
//@ expect-stdout: n12 15.210000
//@ expect-stdout: nneg 0.090000
//@ expect-stdout: RECUR_LINEAR_OK
// a = 5 +- 0.3, var = 0.09.
// nest(a, n) adds the same a once per step down to zero.
// n = 0 is a. n = 3 is four times, 16 * 0.09. n = 12 is thirteen times, 169 * 0.09.
// A negative count stays on the base arm.

fn nest(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        nest(x, n - 1) + x
    }
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let n0 = variance_of(nest(a, 0))
    let n3 = variance_of(nest(a, 3))
    let n12 = variance_of(nest(a, 12))
    let nneg = variance_of(nest(a, 0 - 2))
    print("n0 ")
    print_f64(n0)
    println("")
    print("n3 ")
    print_f64(n3)
    println("")
    print("n12 ")
    print_f64(n12)
    println("")
    print("nneg ")
    print_f64(nneg)
    println("")
    var fails: i64 = 0
    if n0 < 0.089999 || n0 > 0.090001 { fails = fails + 1 }
    if n3 < 1.439999 || n3 > 1.440001 { fails = fails + 1 }
    if n12 < 15.209999 || n12 > 15.210001 { fails = fails + 1 }
    if nneg < 0.089999 || nneg > 0.090001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_LINEAR_OK")
        0
    } else {
        println("RECUR_LINEAR_FAIL")
        1
    }
}
