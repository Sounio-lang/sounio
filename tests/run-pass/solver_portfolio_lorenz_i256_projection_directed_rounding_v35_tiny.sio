//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v35 smoke for Lorenz i256 projection directed-rounding entry

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 {
    if kind != 38 { return 0 - 1 }
    if instance_fp != 80894555 { return 0 - 1 }
    if certificate_fp != 793284661 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 38 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn directed_rounding_audit_fingerprint(directed_rounding_fp: i64,
                                       generic_directed_rounding_fp: i64,
                                       projection_div_witness_fp: i64,
                                       roundoff_budget_fp: i64,
                                       projection_margin_budget_fp: i64,
                                       readiness_mask: i64) -> i64 {
    if directed_rounding_fp != 80894555 { return 0 - 1 }
    if generic_directed_rounding_fp != 505163788 { return 0 - 1 }
    if projection_div_witness_fp != 693793961 { return 0 - 1 }
    if roundoff_budget_fp != 677514412 { return 0 - 1 }
    if projection_margin_budget_fp != 69322697 { return 0 - 1 }
    if readiness_mask != 31 { return 0 - 1 }

    var fp: i64 = 367
    fp = portfolio_mix(fp, directed_rounding_fp, 2647)
    fp = portfolio_mix(fp, generic_directed_rounding_fp, 2647)
    fp = portfolio_mix(fp, projection_div_witness_fp, 2647)
    fp = portfolio_mix(fp, roundoff_budget_fp, 2647)
    fp = portfolio_mix(fp, projection_margin_budget_fp, 2647)
    fp = portfolio_mix(fp, readiness_mask, 2647)
    return fp
}

fn portfolio_v35_fingerprint(directed_rounding_entry_fp: i64) -> i64 {
    if directed_rounding_entry_fp != 297819393 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 35, 1151)
    fp = portfolio_mix(fp, 39, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, 590228875, 1151)
    fp = portfolio_mix(fp, 46718256, 1151)
    fp = portfolio_mix(fp, 295040814, 1151)
    fp = portfolio_mix(fp, 124720146, 1151)
    fp = portfolio_mix(fp, 988622529, 1151)
    fp = portfolio_mix(fp, 757892608, 1151)
    fp = portfolio_mix(fp, 3812644, 1151)
    fp = portfolio_mix(fp, 777068644, 1151)
    fp = portfolio_mix(fp, 423305090, 1151)
    fp = portfolio_mix(fp, 63872871, 1151)
    fp = portfolio_mix(fp, 547731575, 1151)
    fp = portfolio_mix(fp, 620031252, 1151)
    fp = portfolio_mix(fp, 916832909, 1151)
    fp = portfolio_mix(fp, 786321129, 1151)
    fp = portfolio_mix(fp, 116461241, 1151)
    fp = portfolio_mix(fp, 775818863, 1151)
    fp = portfolio_mix(fp, 585753742, 1151)
    fp = portfolio_mix(fp, 44126209, 1151)
    fp = portfolio_mix(fp, directed_rounding_entry_fp, 1151)
    return fp
}

fn main() -> i64 {
    let audit_fp = directed_rounding_audit_fingerprint(
        80894555, 505163788, 693793961, 677514412, 69322697, 31)
    if audit_fp != 793284661 { return 1 }

    let entry_fp = portfolio_entry_fingerprint(38, 80894555, audit_fp, 1, 38)
    if entry_fp != 297819393 { return 2 }

    let manifest_fp = portfolio_v35_fingerprint(entry_fp)
    if manifest_fp != 162915880 { return 3 }

    if directed_rounding_audit_fingerprint(
        80894555, 505163788, 693793961, 677514413, 69322697, 31) != (0 - 1) { return 4 }
    if portfolio_entry_fingerprint(38, 80894555, audit_fp, 0, 38) != (0 - 1) { return 5 }

    return 0
}
