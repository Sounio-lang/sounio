//@ run-pass
//@ expect-stdout: ontology disjoint propagation OK

ontology PropagatedDisjointness {
    class Entity
    class Drug subclass_of Entity
    class Food subclass_of Entity
    class ExperimentalDrug subclass_of Drug
    disjoint Drug, Food
}

fn main() -> i32 with IO {
    let d: ExperimentalDrug = make_experimental_drug()
    println("ontology disjoint propagation OK")
    0
}
