//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v100 smoke for Lorenz i256 step-3 Taylor-2 response envelope

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1721
    receipt_fp = mix(receipt_fp, 116883728, 5651)
    receipt_fp = mix(receipt_fp, 84354264, 5651)
    receipt_fp = mix(receipt_fp, 109993635, 5651)
    receipt_fp = mix(receipt_fp, 39227174, 5651)
    receipt_fp = mix(receipt_fp, 999870071, 5651)
    receipt_fp = mix(receipt_fp, 650273736, 5651)
    receipt_fp = mix(receipt_fp, 295692487, 5651)
    receipt_fp = mix(receipt_fp, 417748218, 5651)
    receipt_fp = mix(receipt_fp, 109213065, 5651)
    receipt_fp = mix(receipt_fp, 3, 5651)
    receipt_fp = mix(receipt_fp, 20, 5651)
    receipt_fp = mix(receipt_fp, 255, 5651)
    if receipt_fp != 718264441 { return 1 }

    var audit_fp: i64 = 1723
    audit_fp = mix(audit_fp, receipt_fp, 5653)
    audit_fp = mix(audit_fp, 116883728, 5653)
    audit_fp = mix(audit_fp, 84354264, 5653)
    audit_fp = mix(audit_fp, 109993635, 5653)
    audit_fp = mix(audit_fp, 39227174, 5653)
    audit_fp = mix(audit_fp, 417748218, 5653)
    audit_fp = mix(audit_fp, 109213065, 5653)
    audit_fp = mix(audit_fp, 295692487, 5653)
    audit_fp = mix(audit_fp, 3, 5653)
    audit_fp = mix(audit_fp, 20, 5653)
    audit_fp = mix(audit_fp, 255, 5653)
    if audit_fp != 47474367 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 103, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 103, 1103)
    if entry_fp != 124115315 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 100, 1151)
    manifest_fp = mix(manifest_fp, 104, 1151)
    manifest_fp = mix(manifest_fp, 650273736, 1151)
    manifest_fp = mix(manifest_fp, 999870071, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 763506498 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 100, 1871)
    result_fp = mix(result_fp, 104, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 92, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 904927562 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 100, 1907)
    family_fp = mix(family_fp, 104, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 87, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 189292805 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 100, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 764455787 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 100, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 788860016 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 100, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 779852235 { return 9 }
    return 0
}
