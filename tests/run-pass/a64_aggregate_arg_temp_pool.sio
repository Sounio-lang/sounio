//@ run-pass
//@ description: by-value aggregate arguments larger than 1 MiB share BSS temporaries per function on aarch64-macos (sequential reuse, two simultaneously live temporaries in one call)
//@ expect-stdout: seq=3
//@ expect-stdout: seq2=4
//@ expect-stdout: pair=1008
struct Big { d: [i64; 140000] }

fn mk(v: i64) -> Big with Mut {
    var b = Big { d: [0; 140000] }
    b.d[0] = v
    b.d[139999] = v * 2
    b
}

fn first(b: Big) -> i64 { b.d[0] }
fn last(b: Big) -> i64 { b.d[139999] }
fn pair(a: Big, b: Big) -> i64 { a.d[0] * 1000 + b.d[0] + last(a) + last(b) }

fn main() with IO, Mut {
    print("seq=")
    print_int(first(mk(3)))
    print("\n")
    print("seq2=")
    print_int(first(mk(4)))
    print("\n")
    print("pair=")
    print_int(pair(mk(1), mk(2)))
    print("\n")
}
