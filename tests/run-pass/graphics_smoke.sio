//@ run-pass

use graphics::surface::{
    Surface, surface_new, surface_clear, surface_set_pixel,
    surface_draw_line, surface_draw_rect, surface_get_pixel_r,
    surface_get_pixel_g, surface_get_pixel_b
}
use graphics::drawing::{color_black, color_white, color_red, color_green, color_blue}
use graphics::export::{export_ppm, export_png}
use graphics::plot::{plot_line_raster, line_plot_config_default}
use graphics::scatter::{plot_scatter_raster, scatter_config_default}
use graphics::heatmap::{plot_heatmap_raster, heatmap_config_default}
use graphics::epistemic::{plot_epistemic_band_raster, epistemic_band_config_default}

fn test_surface_new() -> i64 {
    let s = surface_new(64, 64)
    if s.width != 64 { return 1 }
    if s.height != 64 { return 2 }
    0
}

fn test_clear_and_pixel() -> i64 with Mut, Panic {
    var s = surface_new(64, 64)
    s = surface_clear(s, color_white())
    if surface_get_pixel_r(&s, 0, 0) != 255 { return 10 }
    if surface_get_pixel_g(&s, 0, 0) != 255 { return 11 }
    if surface_get_pixel_b(&s, 0, 0) != 255 { return 12 }
    s = surface_set_pixel(s, 5, 5, color_red())
    if surface_get_pixel_r(&s, 5, 5) != 255 { return 13 }
    if surface_get_pixel_g(&s, 5, 5) != 0 { return 14 }
    if surface_get_pixel_b(&s, 5, 5) != 0 { return 15 }
    0
}

fn test_draw_line() -> i64 with Mut, Panic, Div {
    var s = surface_new(64, 64)
    s = surface_clear(s, color_black())
    s = surface_draw_line(s, 10, 10, 20, 20, color_white())
    if surface_get_pixel_r(&s, 10, 10) != 255 { return 20 }
    if surface_get_pixel_r(&s, 20, 20) != 255 { return 21 }
    0
}

fn test_draw_rect() -> i64 with Mut, Panic, Div {
    var s = surface_new(64, 64)
    s = surface_clear(s, color_black())
    s = surface_draw_rect(s, 30, 30, 5, 5, color_green())
    if surface_get_pixel_r(&s, 30, 30) != 0 { return 30 }
    if surface_get_pixel_g(&s, 30, 30) != 255 { return 31 }
    if surface_get_pixel_b(&s, 30, 30) != 0 { return 32 }
    if surface_get_pixel_r(&s, 34, 34) != 0 { return 33 }
    if surface_get_pixel_g(&s, 34, 34) != 255 { return 34 }
    if surface_get_pixel_b(&s, 34, 34) != 0 { return 35 }
    0
}

fn test_plot_line_raster() -> i64 with Mut, Panic, Div {
    var s = surface_new(64, 64)
    var xs: [f64; 256] = [0.0; 256]
    var ys: [f64; 256] = [0.0; 256]
    xs[0] = 0.0
    ys[0] = 0.0
    xs[1] = 1.0
    ys[1] = 1.0
    xs[2] = 2.0
    ys[2] = 0.5
    let cfg = line_plot_config_default()
    s = plot_line_raster(s, &xs, &ys, 3, cfg)
    var found = false
    var py: i64 = 15
    while py < 50 {
        var px: i64 = 15
        while px < 50 {
            if surface_get_pixel_r(&s, px, py) != 255 || surface_get_pixel_g(&s, px, py) != 255 || surface_get_pixel_b(&s, px, py) != 255 {
                found = true
            }
            px = px + 1
        }
        py = py + 1
    }
    if !found { return 40 }
    0
}

fn test_plot_scatter_raster() -> i64 with Mut, Panic, Div {
    var s = surface_new(64, 64)
    var xs: [f64; 256] = [0.0; 256]
    var ys: [f64; 256] = [0.0; 256]
    xs[0] = 0.0
    ys[0] = 0.0
    xs[1] = 1.0
    ys[1] = 1.0
    xs[2] = 0.5
    ys[2] = 0.8
    let cfg = scatter_config_default()
    s = plot_scatter_raster(s, &xs, &ys, 3, cfg)
    var found = false
    var py: i64 = 15
    while py < 50 {
        var px: i64 = 15
        while px < 50 {
            if surface_get_pixel_r(&s, px, py) == 200 && surface_get_pixel_g(&s, px, py) == 50 && surface_get_pixel_b(&s, px, py) == 50 {
                found = true
            }
            px = px + 1
        }
        py = py + 1
    }
    if !found { return 50 }
    0
}

fn test_plot_heatmap_raster() -> i64 with Mut, Panic, Div {
    var s = surface_new(64, 64)
    var data: [f64; 4096] = [0.0; 4096]
    data[0] = 0.0
    data[1] = 0.5
    data[2] = 1.0
    data[3] = 0.25
    let cfg = heatmap_config_default()
    s = plot_heatmap_raster(s, &data, 2, 2, cfg)
    var found = false
    var py: i64 = 10
    while py < 55 {
        var px: i64 = 10
        while px < 55 {
            let r = surface_get_pixel_r(&s, px, py)
            let g = surface_get_pixel_g(&s, px, py)
            let b = surface_get_pixel_b(&s, px, py)
            if (r != 255 || g != 255 || b != 255) && (r != 0 || g != 0 || b != 0) {
                found = true
            }
            px = px + 1
        }
        py = py + 1
    }
    if !found { return 60 }
    0
}

fn test_plot_epistemic_band_raster() -> i64 with Mut, Panic, Div {
    var s = surface_new(64, 64)
    var xs: [f64; 256] = [0.0; 256]
    var center: [f64; 256] = [0.0; 256]
    var lower: [f64; 256] = [0.0; 256]
    var upper: [f64; 256] = [0.0; 256]
    xs[0] = 0.0
    center[0] = 0.5
    lower[0] = 0.3
    upper[0] = 0.7
    xs[1] = 1.0
    center[1] = 0.8
    lower[1] = 0.5
    upper[1] = 1.0
    xs[2] = 2.0
    center[2] = 0.3
    lower[2] = 0.1
    upper[2] = 0.5
    let cfg = epistemic_band_config_default()
    s = plot_epistemic_band_raster(s, &xs, &center, &lower, &upper, 3, cfg)
    // Verify band fill exists: look for pixels matching band_color (180, 210, 240)
    var found_band = false
    var py: i64 = 10
    while py < 55 {
        var px: i64 = 10
        while px < 55 {
            if surface_get_pixel_r(&s, px, py) == 180 && surface_get_pixel_g(&s, px, py) == 210 && surface_get_pixel_b(&s, px, py) == 240 {
                found_band = true
            }
            px = px + 1
        }
        py = py + 1
    }
    if !found_band { return 70 }
    // Verify center line exists: look for pixels matching center_color (0, 80, 160)
    var found_center = false
    py = 10
    while py < 55 {
        var px: i64 = 10
        while px < 55 {
            if surface_get_pixel_r(&s, px, py) == 0 && surface_get_pixel_g(&s, px, py) == 80 && surface_get_pixel_b(&s, px, py) == 160 {
                found_center = true
            }
            px = px + 1
        }
        py = py + 1
    }
    if !found_center { return 71 }
    0
}

fn test_export_ppm_runs() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(4, 4)
    s = surface_clear(s, color_white())
    s = surface_set_pixel(s, 1, 1, color_red())
    export_ppm(&s)
    0
}

fn test_export_png_stub() -> i64 with IO, Mut, Panic {
    var s = surface_new(4, 4)
    let ok = export_png(&s, "test.png")
    if ok { return 80 }
    0
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let r1 = test_surface_new()
    if r1 != 0 { print("FAIL test_surface_new\n"); return r1 }

    let r2 = test_clear_and_pixel()
    if r2 != 0 { print("FAIL test_clear_and_pixel\n"); return r2 }

    let r3 = test_draw_line()
    if r3 != 0 { print("FAIL test_draw_line\n"); return r3 }

    let r4 = test_draw_rect()
    if r4 != 0 { print("FAIL test_draw_rect\n"); return r4 }

    let r5 = test_plot_line_raster()
    if r5 != 0 { print("FAIL test_plot_line_raster\n"); return r5 }

    let r6 = test_plot_scatter_raster()
    if r6 != 0 { print("FAIL test_plot_scatter_raster\n"); return r6 }

    let r7 = test_plot_heatmap_raster()
    if r7 != 0 { print("FAIL test_plot_heatmap_raster\n"); return r7 }

    let r8 = test_plot_epistemic_band_raster()
    if r8 != 0 { print("FAIL test_plot_epistemic_band_raster\n"); return r8 }

    let r9 = test_export_ppm_runs()
    if r9 != 0 { print("FAIL test_export_ppm_runs\n"); return r9 }

    let r10 = test_export_png_stub()
    if r10 != 0 { print("FAIL test_export_png_stub\n"); return r10 }

    print("PASS graphics_smoke\n")
    0
}
