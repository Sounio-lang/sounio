fn test_tiled_surface() -> i64 with Mut, Panic, Div {
    var ts = tiled_surface_new(400, 400, 256, 256)
    ts = tiled_clear(ts, color_white())
    // Draw a line that crosses the tile boundary at x=256
    ts = tiled_draw_line(ts, 10, 10, 300, 300, color_red())
    // Verify pixel at (10,10) is red
    if tiled_get_pixel_r(&ts, 10, 10) != 255 { return 80 }
    // Verify pixel at (300,300) is red (crosses into second tile)
    if tiled_get_pixel_r(&ts, 300, 300) != 255 { return 81 }
    0
}

fn test_tiled_export_ppm_runs() -> i64 with IO, Mut, Panic, Div {
    var ts = tiled_surface_new(100, 100, 64, 64)
    ts = tiled_clear(ts, color_white())
    ts = tiled_draw_rect(ts, 10, 10, 20, 20, color_green())
    tiled_export_ppm(&ts)
    0
}

fn test_export_ppm_runs() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(4, 4)
    s = surface_clear(s, color_white())
    s = surface_set_pixel(s, 1, 1, color_red())
    export_ppm(&s)
    0
}

fn test_export_png() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(4, 4)
    s = surface_clear(s, color_white())
    s = surface_set_pixel(s, 1, 1, color_red())
    let ok = export_png(&s, "/tmp/graphics_smoke.png")
    if !ok { return 90 }
    let sz = file_size("/tmp/graphics_smoke.png")
    if sz <= 0 { return 91 }
    0
}

fn test_export_png_rgba() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(4, 4)
    s = surface_clear(s, color_white())
    s = surface_set_pixel(s, 1, 1, color_red())
    let ok = export_png_rgba(&s, "/tmp/graphics_smoke_rgba.png")
    if !ok { return 92 }
    let sz = file_size("/tmp/graphics_smoke_rgba.png")
    if sz <= 0 { return 93 }
    0
}

fn test_tiled_export_png() -> i64 with IO, Mut, Panic, Div {
    var ts = tiled_surface_new(100, 100, 64, 64)
    ts = tiled_clear(ts, color_white())
    ts = tiled_draw_rect(ts, 10, 10, 20, 20, color_green())
    let ok = tiled_export_png(&ts, "/tmp/graphics_smoke_tiled.png")
    if !ok { return 94 }
    let sz = file_size("/tmp/graphics_smoke_tiled.png")
    if sz <= 0 { return 95 }
    0
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let r1 = test_surface_new()
    if r1 != 0 { print("FAIL test_surface_new\n"); return r1 }

    let r2 = test_clear_and_pixel()
    if r2 != 0 { print("FAIL test_clear_and_pixel\n"); return r2 }

    let r3 = test_draw_line()
    if r3 != 0 { print("FAIL test_draw_line\n"); return r3 }

    let r4 = test_draw_rect()
    if r4 != 0 { print("FAIL test_draw_rect\n"); return r4 }

    let r5 = test_plot_line_raster()
    if r5 != 0 { print("FAIL test_plot_line_raster\n"); return r5 }

    let r6 = test_plot_scatter_raster()
    if r6 != 0 { print("FAIL test_plot_scatter_raster\n"); return r6 }

    let r7 = test_plot_heatmap_raster()
    if r7 != 0 { print("FAIL test_plot_heatmap_raster\n"); return r7 }

    let r8 = test_plot_epistemic_band_raster()
    if r8 != 0 { print("FAIL test_plot_epistemic_band_raster\n"); return r8 }

    let r9 = test_svg_line_plot_runs()
    if r9 != 0 { print("FAIL test_svg_line_plot_runs\n"); return r9 }

    let r10 = test_svg_scatter_plot_runs()
    if r10 != 0 { print("FAIL test_svg_scatter_plot_runs\n"); return r10 }

    let r11 = test_svg_epistemic_band_plot_runs()
    if r11 != 0 { print("FAIL test_svg_epistemic_band_plot_runs\n"); return r11 }

    let r12 = test_tiled_surface()
    if r12 != 0 { print("FAIL test_tiled_surface\n"); return r12 }

    let r13 = test_tiled_export_ppm_runs()
    if r13 != 0 { print("FAIL test_tiled_export_ppm_runs\n"); return r13 }

    let r14 = test_export_ppm_runs()
    if r14 != 0 { print("FAIL test_export_ppm_runs\n"); return r14 }

    let r15 = test_export_png()
    if r15 != 0 { print("FAIL test_export_png\n"); return r15 }

    let r16 = test_export_png_rgba()
    if r16 != 0 { print("FAIL test_export_png_rgba\n"); return r16 }

    let r17 = test_tiled_export_png()
    if r17 != 0 { print("FAIL test_tiled_export_png\n"); return r17 }

    print("PASS graphics_smoke\n")
    0
}
