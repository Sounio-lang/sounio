//@ run-pass
//@ expect-stdout: STDLIB_DEEP_EIGEN_PASS
use linalg::eigen::{qr_tridiag,eigen_symmetric,eigen_workspace_reset,eigen_workspace_n,eigen_workspace_set,eigen_workspace_householder_tridiag,eigen_workspace_qr_tridiag,eigen_workspace_symmetric,eigen_converged,eigenvalue_get}
fn abs(x:f64)->f64 {if x<0.0 {-x}else{x}}
fn main()->i32 with IO,Mut,Div,Panic {
    eigen_workspace_reset(2)
    eigen_workspace_set(0,0,2.0)
    eigen_workspace_set(1,1,2.0)
    eigen_workspace_set(0,1,-1.0)
    eigen_workspace_set(1,0,-1.0)
    eigen_workspace_householder_tridiag(2)
    assert(!eigen_converged())
    assert(!eigen_workspace_symmetric(257))
    assert(eigen_workspace_n()==2)
    eigen_workspace_reset(257)
    assert(eigen_workspace_n()==0)
    eigen_workspace_reset(2)
    assert(!eigen_workspace_qr_tridiag(2,256))
    eigen_workspace_set(0,0,0.0/0.0)
    eigen_workspace_householder_tridiag(2)
    assert(!eigen_workspace_qr_tridiag(2,256) && !eigen_converged())
    eigen_workspace_reset(3)
    eigen_workspace_set(0,0,3.0);eigen_workspace_set(1,1,2.0);eigen_workspace_set(2,2,1.0)
    assert(eigen_workspace_symmetric(3) && eigen_converged())
    assert(eigenvalue_get(0)==1.0 && eigenvalue_get(1)==2.0 && eigenvalue_get(2)==3.0)
    eigen_workspace_set(0,0,5.0)
    assert(!eigen_converged() && !eigen_workspace_qr_tridiag(3,256))
    var a:[f64;65536]=[0.0;65536]
    var values:[f64;256]=[0.0;256]
    var vectors:[f64;65536]=[0.0;65536]
    a[0]=2.0e-100;a[1]=-1.0e-100;a[2]=-1.0e-100;a[3]=2.0e-100
    assert(eigen_symmetric(&!a,2,&!values,&!vectors))
    assert(abs(values[0]/1.0e-100-1.0)<1e-12)
    assert(abs(values[1]/1.0e-100-3.0)<1e-12)
    a[0]=2.0e100;a[1]=-1.0e100;a[2]=-1.0e100;a[3]=2.0e100
    assert(eigen_symmetric(&!a,2,&!values,&!vectors))
    assert(abs(values[0]/1.0e100-1.0)<1e-12)
    assert(abs(values[1]/1.0e100-3.0)<1e-12)
    a[1]=7.0
    assert(!eigen_symmetric(&!a,2,&!values,&!vectors))
    assert(!eigen_symmetric(&!a,257,&!values,&!vectors))
    var diagonal:[f64;256]=[0.0;256]
    var subdiag:[f64;256]=[0.0;256]
    diagonal[0]=1.0e308;diagonal[1]=1.0e308;subdiag[0]=1.0e307
    assert(qr_tridiag(&!diagonal,&!subdiag,2,256))
    assert(abs(diagonal[0]/1.0e308-0.9)<1.0e-12)
    assert(abs(diagonal[1]/1.0e308-1.1)<1.0e-12)
    diagonal[0]=7.0;diagonal[1]=9.0;subdiag[0]=1.0
    assert(!qr_tridiag(&!diagonal,&!subdiag,0,256))
    assert(!qr_tridiag(&!diagonal,&!subdiag,257,256))
    assert(!qr_tridiag(&!diagonal,&!subdiag,2,0))
    assert(diagonal[0]==7.0 && diagonal[1]==9.0)
    print("STDLIB_DEEP_EIGEN_PASS\n")
    return 0
}
