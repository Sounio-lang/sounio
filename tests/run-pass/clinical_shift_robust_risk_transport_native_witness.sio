//@ run-pass
// Standalone scalar executor for the bounded D11 contests.

fn d11_native_covariate_transport() with Panic {
    // Coarsen atom 0 into A and atoms 1..3 into B from the exact 12-unit law.
    let source_mass_a = 3
    let source_mass_b = 9
    let target_mass_a = 6
    let target_mass_b = 6
    let mass_denominator = 12
    let source_risk_num = 1
    let source_risk_den = 4
    let target_risk_num = 1
    let target_risk_den = 2
    // Common weight denominator 3: w(A)=6/3=2, w(B)=6/9=2/3.
    let weighted_num_scaled = source_mass_a * 2 * 3 * 1 +
        source_mass_b * 2 * 0
    let weighted_den_scaled = mass_denominator * 3
    assert(source_mass_a + source_mass_b == mass_denominator)
    assert(target_mass_a + target_mass_b == mass_denominator)
    assert(source_risk_num * 4 == source_risk_den)
    assert(target_risk_num * 2 == target_risk_den)
    assert(weighted_num_scaled == 18 && weighted_den_scaled == 36)
    assert(weighted_num_scaled * target_risk_den ==
        target_risk_num * weighted_den_scaled)
}

fn d11_native_overlap_and_label_walls() with Panic {
    let source_mass_b = 0
    let target_mass_b = 2
    let target_total = 4
    let risk_unseen_low = 0
    let risk_unseen_high = target_mass_b
    assert(source_mass_b == 0 && target_mass_b > 0)
    assert(risk_unseen_low == 0)
    assert(risk_unseen_high * 2 == target_total)

    let source_prior_y0 = 3
    let source_prior_y1 = 9
    let target_prior_y0 = 6
    let target_prior_y1 = 6
    let label_denominator = 12
    assert(source_prior_y0 * 4 == label_denominator)
    assert(target_prior_y0 * 2 == label_denominator)
    assert(source_prior_y0 + source_prior_y1 == label_denominator)
    assert(target_prior_y0 + target_prior_y1 == label_denominator)
    let label_probe_id = 31311
    let evaluated_loss_id = 31711
    assert(label_probe_id != evaluated_loss_id)
    let singular_determinant = 1 * 0 - 1 * 0
    assert(singular_determinant == 0)
    let world_a_prediction_zero_count = 4
    let world_b_prediction_zero_count = 4
    assert(world_a_prediction_zero_count == world_b_prediction_zero_count)
    assert(1 != 3)
}

fn d11_native_concept_and_subgroup_collisions() with Panic {
    let source_input_digest = 31411
    let target_input_digest = 31411
    let stable_target_risk = 2
    let shifted_target_risk = 4
    assert(source_input_digest == target_input_digest)
    assert(stable_target_risk == 2 && shifted_target_risk == 4)

    let balanced_a_errors = 3
    let balanced_b_errors = 3
    let hidden_a_errors = 0
    let hidden_b_errors = 6
    assert(balanced_a_errors + balanced_b_errors == 6)
    assert(hidden_a_errors + hidden_b_errors == 6)
    assert(balanced_a_errors * 2 == hidden_b_errors)
}

fn d11_native_calibration_transport() with Panic {
    // The diagnostic score is 1/4 in both cells; outcomes are (1,0).
    let source_residual_scaled = 3 * (4 * 1 - 1) + 9 * (4 * 0 - 1)
    let target_residual_scaled = 6 * (4 * 1 - 1) + 6 * (4 * 0 - 1)
    let residual_scaled_denominator = 12 * 4
    assert(source_residual_scaled == 0)
    assert(target_residual_scaled == 12)
    assert(residual_scaled_denominator == 48)
    assert(target_residual_scaled * 4 == residual_scaled_denominator)
    let cell_a_local_residual = 1 - 1
    let cell_b_local_residual = 0 - 0
    assert(cell_a_local_residual == 0 && cell_b_local_residual == 0)
    let later_active_residual_scaled = 6 * (0 - 1) + 6 * (0 - 0)
    assert(later_active_residual_scaled == -6)
    assert(later_active_residual_scaled * 2 == -12)
}

fn d11_native_tight_tv_risk_transport() with Panic {
    let source_mass_0 = 3
    let source_mass_1 = 3
    let source_mass_2 = 3
    let source_mass_3 = 3
    let target_mass_0 = 6
    let target_mass_1 = 2
    let target_mass_2 = 2
    let target_mass_3 = 2
    let denominator = 12
    assert(source_mass_0 + source_mass_1 + source_mass_2 +
        source_mass_3 == denominator)
    assert(target_mass_0 + target_mass_1 + target_mass_2 +
        target_mass_3 == denominator)
    let l1_num = 3 + 1 + 1 + 1
    assert(l1_num == 6)
    let source_risk_num = source_mass_0
    let target_risk_num = target_mass_0
    assert(source_risk_num * 4 == denominator)
    assert(target_risk_num * 2 == denominator)
    assert(target_risk_num == source_risk_num + l1_num / 2)
}

fn d11_native_authority_attenuation() with Panic {
    let source_rank = 3
    let continuation_rank = 3
    let degraded_rank = continuation_rank - 1
    let suspended_rank = degraded_rank - 1
    let revoked_rank = suspended_rank - 1
    assert(continuation_rank <= source_rank)
    assert(degraded_rank < continuation_rank)
    assert(suspended_rank < degraded_rank)
    assert(revoked_rank < suspended_rank)
    assert(revoked_rank == 0)
    let source_scope = 8
    let continuation_scope = 4
    let degraded_scope = 2
    let suspended_scope = 0
    assert(continuation_scope <= source_scope)
    assert(degraded_scope <= continuation_scope)
    assert(suspended_scope <= degraded_scope)
    let continuation_window = 31121
    let degraded_window = 31122
    let suspended_window = 31123
    let revoked_window = 31124
    assert(continuation_window < degraded_window)
    assert(degraded_window < suspended_window)
    assert(suspended_window < revoked_window)
    let nominal_trace_terminal = true
    let globally_absorbing = false
    let runtime_canary_disabled = false
    let fixture_replayable = true
    assert(nominal_trace_terminal && fixture_replayable)
    assert(!globally_absorbing && !runtime_canary_disabled)
}

fn main() with Panic {
    d11_native_covariate_transport()
    d11_native_overlap_and_label_walls()
    d11_native_concept_and_subgroup_collisions()
    d11_native_calibration_transport()
    d11_native_tight_tv_risk_transport()
    d11_native_authority_attenuation()

    println("D11-W0 d10_lease=30821 source_rank=3 canary_only=true production=false clinical=false")
    println("D11-W1 covariate source_mass=3,9 target_mass=6,6 weights=2,2/3 source_risk=1/4 target_risk=1/2 weighted=1/2")
    println("D11-W2 overlap source_mass=4,0 target_mass=2,2 target_risk_interval=[0,1/2] point_identified=false")
    println("D11-W3 label src=3,9 tgt=6,6 risk=1/4->1/2 probe=31311 loss=31711 singular=1/4,3/4")
    println("D11-W4 concept same_unlabeled_inputs=true stable_risk=2/4 shifted_risk=4/4 labels_required=true")
    println("D11-W5 subgroup marginal_a=6/12 marginal_b=6/12 worst_a=1/2 worst_b=1")
    println("D11-W6 calibration diag=0->1/4 local=0 active_later=-1/2 diagnostic_transition=false")
    println("D11-W7 conformal source_risk=1/4 tv=1/4 target_risk=1/2 bound_tight=true general_theorem=false")
    println("D11-W8 rank=3,3,2,1,0 scope=8,4,2,0,0 w=31121..31124 up=0 nominal=true global=false")
    println("D11-W8-LIMIT runtime_disabled=false replayable=true stale_alias_invalidated=false")
    println("PROOF-CARRYING SHIFT-ROBUST RISK TRANSPORT D11 PASS")
}
