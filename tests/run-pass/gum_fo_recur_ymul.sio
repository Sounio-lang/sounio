//@ run-pass
//@ requires: madaros
//@ expect-stdout: y0 0.090000
//@ expect-stdout: y1 0.610000
//@ expect-stdout: y2 5.440000
//@ expect-stdout: y12 152504893.440000
//@ expect-stdout: yneg 0.090000
//@ expect-stdout: RECUR_YMUL_OK
// a = 5 +- 0.3, var = 0.09. b = 2 +- 0.1, var = 0.01. Independent.
// byy(a, b, n) = a * b^n for n >= 1, and a when n < 1.
// n = 12: 4096^2 * 0.09 + (12 * 5 * 2048)^2 * 0.01.

fn byy(x: f64, y: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        y * byy(x, y, n - 1)
    }
}

fn main() -> i64 with IO, Epistemic {
    let kx: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let ky: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let a = kx.value
    let b = ky.value
    let y0 = variance_of(byy(a, b, 0))
    let y1 = variance_of(byy(a, b, 1))
    let y2 = variance_of(byy(a, b, 2))
    let y12 = variance_of(byy(a, b, 12))
    let yneg = variance_of(byy(a, b, 0 - 2))
    print("y0 ")
    print_f64(y0)
    println("")
    print("y1 ")
    print_f64(y1)
    println("")
    print("y2 ")
    print_f64(y2)
    println("")
    print("y12 ")
    print_f64(y12)
    println("")
    print("yneg ")
    print_f64(yneg)
    println("")
    var fails: i64 = 0
    if y0 < 0.089999 || y0 > 0.090001 { fails = fails + 1 }
    if y1 < 0.609999 || y1 > 0.610001 { fails = fails + 1 }
    if y2 < 5.439999 || y2 > 5.440001 { fails = fails + 1 }
    if y12 < 152504893.0 || y12 > 152504894.0 { fails = fails + 1 }
    if yneg < 0.089999 || yneg > 0.090001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_YMUL_OK")
        0
    } else {
        println("RECUR_YMUL_FAIL")
        1
    }
}
