//@ run-pass

struct Inner {
    pub scalar: i64,
    pub values: [i64; 2],
}

struct Outer {
    pub inner: Inner,
}

fn main() -> i64 with IO, Mut, Panic {
    var outer = Outer {
        inner: Inner {
            scalar: 0,
            values: [0, 0],
        },
    }
    let p = &!outer
    (*p).inner.scalar = 9
    (*p).inner.values[0] = 7

    if outer.inner.scalar != 9 || outer.inner.values[0] != 7 {
        println("FAIL lean_nested_deref_store_public")
        return 1
    }
    println("PASS lean_nested_deref_store_public")
    0
}
