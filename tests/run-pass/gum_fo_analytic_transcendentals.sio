//@ run-pass
//@ expect-stdout: GUM_FO_ANALYTIC_TRANSCENDENTALS_OK
//@ requires: madaros
// First-order GUM propagation through the five transcendentals whose derivative
// is NOT another named function.
//
// The transfer table stored a derivative as a NAME -- sin' = cos, exp' = exp --
// which is exact and free for a set closed under differentiation, and expresses
// nothing outside it. atan' = 1/(1+x^2) has no name, so the lookup returned
// empty and variance_of answered a confident 0.0. Kind 8 carries an id instead
// and EMITS the derivative, from x plus sqrt/sin/cos/exp only -- all backend
// builtins, so nothing here reopens the E221 hole (#2172).
//
// TWO points per function, deliberately. A single point cannot tell a correct
// answer from sigma^2 passing through unscaled: at one x they can coincide.
//
// hessian_of is NOT covered: the analytic f'' is computed but not wired, and
// still returns 0.0. See #2164 -- trading a silent zero for a confident wrong
// number would be worse than the defect.
use math::pure::{atan}

fn near(a: f64, b: f64) -> bool {
    let d = a - b
    if d < 0.0 { return 0.0 - d < 1.0e-7 }
    return d < 1.0e-7
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    let ka: Knowledge<f64> = measure(0.5, uncertainty: 0.1)
    let kb: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let x = ka.value
    let y = kb.value

    // Var(atan(x)) = (1/(1+x^2))^2 * sigma^2
    //   x=0.5: (1/1.25)^2 * 0.01 = 0.0064
    //   x=2.0: (1/5)^2   * 0.01 = 0.0004
    let ok = near(variance_of(atan(x)), 0.0064)
        && near(variance_of(atan(y)), 0.0004)
        && near(variance_of(x), 0.01)
    if ok {
        print("GUM_FO_ANALYTIC_TRANSCENDENTALS_OK\n")
    } else {
        print("GUM_FO_ANALYTIC_TRANSCENDENTALS_FAIL\n")
        print("atan(0.5)="); print_f64(variance_of(atan(x))); print(" want 0.006400\n")
        print("atan(2.0)="); print_f64(variance_of(atan(y))); print(" want 0.000400\n")
    }
}
