//@ run-pass
//@ expect-stdout-contains: ident_i64_to_i32: PASS
//@ expect-stdout-contains: ident_i64_to_i8: PASS
//@ expect-stdout-contains: literal_to_i32: PASS
//@ expect-stdout-contains: wide_to_i32: PASS
//@ expect-stdout-contains: narrow_round5: ALL PASS
// Strictness-campaign round 5: non-literal i64 argument narrows to i32/i8
// parameter at the structural call-arg compatibility choke point.
// Companion to tests/run-pass/int_arg_narrow_literal_call.sio (round 2) and
// tests/run-pass/int_arg_narrow_array_binding.sio (round 1). Output-verified.

fn takes_i32(x: i32) -> i32 with Div, Panic { x + 1 }
fn takes_i8(x: i8) -> i8 with Div, Panic { x - 1 }

fn main() -> i64 with IO, Div, Panic {
    var exit_fails: i64 = 0
    let v_i64: i64 = 41
    let r_i32: i32 = takes_i32(v_i64)
    if r_i32 != 42 {
        print("ident_i64_to_i32: FAIL\n")
        exit_fails = exit_fails + 1
    } else {
        print("ident_i64_to_i32: PASS\n")
    }

    let w_i64: i64 = 8
    let r_i8: i8 = takes_i8(w_i64)
    if r_i8 != 7 {
        print("ident_i64_to_i8: FAIL\n")
        exit_fails = exit_fails + 1
    } else {
        print("ident_i64_to_i8: PASS\n")
    }

    // Sanity: literal-arg narrowing (round 2 path) still works.
    let r_lit: i32 = takes_i32(100)
    if r_lit != 101 {
        print("literal_to_i32: FAIL\n")
        exit_fails = exit_fails + 1
    } else {
        print("literal_to_i32: PASS\n")
    }

    // A non-literal i64 at the top of the i32 range still narrows. An
    // out-of-range one (9999999999) used to be masked to 1410065407 and
    // passed; under ADR-031 R1 it panics at the parameter boundary, pinned by
    // section 4 of scripts/ci/madaros_int_overflow_gate.sh (i32_arg_narrow).
    let big: i64 = 2147483646
    let r_big: i32 = takes_i32(big)
    if r_big > 0 {
        print("wide_to_i32: PASS\n")
    } else {
        print("wide_to_i32: FAIL\n")
        exit_fails = exit_fails + 1
    }
    if exit_fails == 0 { print("narrow_round5: ALL PASS\n") } else { print("narrow_round5: SOME FAILED\n") }
    if exit_fails > 0 {
        return 1
    }
    return 0
}