//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_QR_FACTOR_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close,numeric_matrix}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_at,integer_buffer_close}
use io::sci_print::{println_f64_sci}
use linalg::dynamic_least_squares::{dynamic_qr_workspace,dynamic_qr_factorize}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
    let m:i64=512
    let p:i64=12
    let need=dynamic_qr_workspace(m,p)
    var a=numeric_buffer_new(m*p,m*p*8)
    var zero=numeric_buffer_new(m,m*8)
    var work=numeric_buffer_new(need,need*8)
    var r=numeric_buffer_new(p*p,p*p*8)
    var scales=numeric_buffer_new(p,p*8)
    var perm=integer_buffer_new(p,p*8)
    var i:i64=0
    while i<m {
        var j:i64=0
        while j<p {
            let value=((1+if i%p==j {j+1}else{0})*(j+2)) as f64
            numeric_buffer_set(&!a,i*p+j,value);j=j+1
        };i=i+1
    }
    let layout=numeric_matrix(m*p,m,p,p,1,0)
    let fit=dynamic_qr_factorize(&a,&layout,&!zero,&!work,&!r,&!scales,&!perm,0.0)
    assert(fit.status==0 && fit.rank==p)
    print("QR_FACTOR\n")
    i=0
    while i<p*p {let v:f64=numeric_buffer_at(&r,i);println_f64_sci(v,15);i=i+1}
    i=0
    while i<p {let v:f64=numeric_buffer_at(&scales,i);println_f64_sci(v,15);i=i+1}
    i=0
    while i<p {let v:i64=integer_buffer_at(&perm,i);println(v);i=i+1}
    numeric_buffer_set(&!r,0,123.0);numeric_buffer_set(&!scales,0,456.0);integer_buffer_set(&!perm,0,789)
    let invalid=dynamic_qr_factorize(&a,&layout,&!zero,&!work,&!r,&!scales,&!perm,1.0)
    assert(invalid.status==5)
    assert(numeric_buffer_at(&r,0)==123.0 && numeric_buffer_at(&scales,0)==456.0 && integer_buffer_at(&perm,0)==789)
    numeric_buffer_close(a);numeric_buffer_close(zero);numeric_buffer_close(work)
    numeric_buffer_close(r);numeric_buffer_close(scales);integer_buffer_close(perm)
    print("STDLIB_DEEP_QR_FACTOR_PASS\n")
    return 0
}
