//@ run-pass
//@ description: ADR-026 amendment — `seg_count` sits at index 1 in AstPath and 0 in Other; `(*formal).path.seg_count` through an annotated `&TypeExpr` must read AstPath.seg_count (the shape of check/specializer.sio spec_infer_call_type_args; the name hash read slot 51 and counted 0)
//@ expect-stdout: 1
//@ expect-stdout: 9
struct StrL { n: i64 }
struct AstPath { segments: StrL, seg_count: i64 }
struct Other { seg_count: i64, a: i64, b: i64, c: i64 }
struct Span { lo: i64, hi: i64 }
struct TypeExpr { kind: i64, span: Span, path: AstPath }
struct Param { name: i64, ty: TypeExpr }
struct ParamList { head: Param, tail: Option<Box<ParamList> > }
struct Fd { params: Option<Box<ParamList> > }

fn count_single(fd: &Fd) -> i64 with Mut, Panic, Div {
    var n: i64 = 0
    var params = &(*fd).params
    while true {
        match *params {
            Some(p) => {
                let formal: &TypeExpr = &(*p).head.ty
                if (*formal).kind == 1 && (*formal).path.seg_count == 1 { n = n + 1 }
                params = &(*p).tail
            }
            None => break,
        }
    }
    n
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let o = Other { seg_count: 9, a: 0, b: 0, c: 0 }
    let t1 = TypeExpr { kind: 1, span: Span { lo: 0, hi: 0 }, path: AstPath { segments: StrL { n: 0 }, seg_count: 1 } }
    let t2 = TypeExpr { kind: 1, span: Span { lo: 0, hi: 0 }, path: AstPath { segments: StrL { n: 0 }, seg_count: 2 } }
    let l2 = ParamList { head: Param { name: 2, ty: t2 }, tail: None }
    let l1 = ParamList { head: Param { name: 1, ty: t1 }, tail: Some(Box::new(l2)) }
    let fd = Fd { params: Some(Box::new(l1)) }
    println(count_single(&fd))
    println(o.seg_count)
    0
}
