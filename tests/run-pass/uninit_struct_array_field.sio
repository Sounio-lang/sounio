//@ run-pass
//@ requires: madaros
//@ expect-stdout: 99
//@ expect-stdout: 7
//@ description: an uninitialized struct allocates each fixed array field before the first indexed store
struct UninitArrayHolder { values: [i64; 4], count: i64 }

fn main() -> i32 with IO, Mut, Panic, Alloc {
    var holder: UninitArrayHolder;
    holder.values[2] = 99
    holder.count = 7
    println(holder.values[2])
    println(holder.count)
    return 0
}
