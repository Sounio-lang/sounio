//@ run-pass
// Test tuple destructuring in let statements

fn main() with IO {
    // Basic tuple destructuring
    let (a, b) = (1, 2)

    // Nested tuples
    let (x, (y, z)) = (10, (20, 30))

    // Mixed with wildcards
    let (first, _) = (5, 10)

    // Verify values are bound correctly
    if a == 1 && b == 2 {
        if x == 10 && y == 20 && z == 30 {
            if first == 5 {
                println("tuple destructure test passed")
            }
        }
    }
}
