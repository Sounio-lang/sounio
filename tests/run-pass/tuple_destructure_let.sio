//@ run-pass
// Test tuple destructuring in let statements

fn main() with IO {
    // Basic tuple destructuring
    let (a, b) = (1, 2)

    // Nested tuple destructuring
    let (x, (y, z)) = (10, (20, 30))

    // Wildcard pattern
    let (first, _) = (5, 10)

    // Verify all bindings worked
    if a == 1 && b == 2 && x == 10 && y == 20 && z == 30 && first == 5 {
        println("tuple destructuring test passed")
    }
}
