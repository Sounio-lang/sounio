//@ run-pass
//@ requires: madaros
//@ expect-stdout: SCALE NORMALIZATION STATUS PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_at,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
use genomics::dynamic_normalization::{dynamic_median_ratio_size_factors_workspace,dynamic_size_factors_slot,dynamic_size_factors_slot_status,dynamic_median_ratio_size_factors_into}
fn normalization_failure(kind:i64) with Alloc,Mut,Div,Panic {
 let count_len:i64=if kind==12 {0}else{4}
 let factor_len:i64=if kind==11 {1}else{2}
 let anchor_len:i64=if kind==9 {1}else{2}
 let work_len:i64=if kind==10 {7}else{8}
 var counts=integer_buffer_new(count_len,count_len*8)
 var anchors=integer_buffer_new(anchor_len,anchor_len*8)
 var factors=numeric_buffer_new(factor_len,factor_len*8)
 var logs=numeric_buffer_new(2,16)
 var work=numeric_buffer_new(work_len,work_len*8)
 var slot=dynamic_size_factors_slot()
 var i:i64=0
 while i<count_len {integer_buffer_set(&!counts,i,2);i=i+1}
 i=0
 while i<factor_len {numeric_buffer_set(&!factors,i,123.0);i=i+1}
 numeric_buffer_set(&!logs,0,456.0)
 numeric_buffer_set(&!logs,1,456.0)
 if kind==0 {integer_buffer_set(&!counts,3, -1)}
 if kind==1 {integer_buffer_set(&!counts,3,9007199254740993)}
 if kind==2 {integer_buffer_set(&!counts,3,9223372036854775807)}
 if kind==7 {i=0;while i<4 {integer_buffer_set(&!counts,i,0);i=i+1}}
 if kind==8 {integer_buffer_set(&!counts,1,0);integer_buffer_set(&!counts,3,0)}
 let mode:i64=if kind==3 {2}else{if kind==8 {1}else{0}}
 let offset:i64=if kind==4 {-1}else{0}
 let row_stride:i64=if kind==5 {9223372036854775807}else{2}
 let col_stride:i64=if kind==6 {9223372036854775807}else{1}
 let expected:i64=if kind==0 {2}else{if kind==1 || kind==2 {5}else{if kind==7 || kind==8 {3}else{1}}}
 let status=dynamic_median_ratio_size_factors_into(&counts,2,2,row_stride,col_stride,offset,mode,&!factors,&!logs,&!work,&!anchors,&!slot)
 assert(status==expected && dynamic_size_factors_slot_status(&slot)==expected)
 i=0
 while i<factor_len {assert(numeric_buffer_at(&factors,i)==123.0);i=i+1}
 assert(numeric_buffer_at(&logs,0)==456.0 && numeric_buffer_at(&logs,1)==456.0)
 integer_buffer_close(counts)
 integer_buffer_close(anchors)
 numeric_buffer_close(factors)
 numeric_buffer_close(logs)
 numeric_buffer_close(work)
}
fn main()->i32 with Alloc,IO,Mut,Div,Panic {
 let empty=dynamic_median_ratio_size_factors_workspace(0,2)
 let overflow=dynamic_median_ratio_size_factors_workspace(9223372036854775807,2)
 let payload=dynamic_median_ratio_size_factors_workspace(400000000000000000,2)
 assert(empty.status==1 && overflow.status==1 && payload.status==1)
 var kind:i64=0
 while kind<13 {normalization_failure(kind);kind=kind+1}
 println("SCALE NORMALIZATION STATUS PASS")
 0
}
