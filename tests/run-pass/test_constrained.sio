//@ run-pass
//@ expect-stdout: ALL 12 TESTS PASSED
//@ expect-stdout: Failed: 0
// test_constrained.sio -- Tests for constrained nonlinear optimization module
//
// Self-contained test suite for L-BFGS, projected gradient, augmented
// Lagrangian, quadratic penalty, log-barrier, KKT violation, Armijo search,
// box_project, and default config/result initialization.
// All structs, helpers, and algorithms are inlined since tests cannot import.
//
// References:
//   Nocedal & Wright (2006): "Numerical Optimization" Ch. 17-18
//   Bertsekas (1999): "Nonlinear Programming"
//   Boyd & Vandenberghe (2004): "Convex Optimization" Ch. 11

// ============================================================================
// PURE MATH HELPERS (must precede callers)
// ============================================================================

fn co_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn co_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn co_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

fn co_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 30 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn co_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 700.0 { return 1.0e308 }
    if x < -700.0 { return 0.0 }
    let ln2 = 0.6931471805599453
    var k_f = x / ln2
    var k: i32 = 0
    if k_f >= 0.0 { k = k_f as i32 } else { k = (k_f - 1.0) as i32 }
    let r = x - (k as f64) * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 30 { term = term * r / (n as f64); sum = sum + term; n = n + 1 }
    var result = sum
    var j = 0
    if k >= 0 {
        while j < k { result = result * 2.0; j = j + 1 }
    } else {
        var neg_k = 0 - k
        while j < neg_k { result = result * 0.5; j = j + 1 }
    }
    result
}

fn co_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e308 }
    if x == 1.0 { return 0.0 }
    let ln2 = 0.6931471805599453
    var m = x
    var k: i32 = 0
    while m > 2.0 { m = m * 0.5; k = k + 1 }
    while m < 0.5 { m = m * 2.0; k = k - 1 }
    let u = (m - 1.0) / (m + 1.0)
    let u2 = u * u
    var sum = u
    var term = u
    var n = 1
    while n < 40 {
        term = term * u2
        sum = sum + term / (2.0 * (n as f64) + 1.0)
        n = n + 1
    }
    2.0 * sum + (k as f64) * ln2
}

fn approx_eq(a: f64, b: f64, tol: f64) -> bool {
    co_abs(a - b) < tol
}

// ============================================================================
// VECTOR HELPERS (fixed-size [f64; 64])
// ============================================================================

fn co_dot(a: &[f64; 64], b: &[f64; 64], n: i32) -> f64 with Mut, Div, Panic {
    var s = 0.0
    var i = 0
    while i < n { s = s + a[i] * b[i]; i = i + 1 }
    s
}

fn co_norm2(a: &[f64; 64], n: i32) -> f64 with Mut, Div, Panic {
    var s = 0.0
    var i = 0
    while i < n { s = s + a[i] * a[i]; i = i + 1 }
    co_sqrt(s)
}

fn co_norminf(a: &[f64; 64], n: i32) -> f64 with Mut, Div, Panic {
    var mx = 0.0
    var i = 0
    while i < n {
        let v = co_abs(a[i])
        if v > mx { mx = v }
        i = i + 1
    }
    mx
}

fn co_copy(src: &[f64; 64], dst: &![f64; 64], n: i32) with Mut, Div, Panic {
    var i = 0
    while i < n { dst[i] = src[i]; i = i + 1 }
}

fn co_axpy(alpha: f64, x: &[f64; 64], dst: &![f64; 64], n: i32) with Mut, Div, Panic {
    var i = 0
    while i < n { dst[i] = dst[i] + alpha * x[i]; i = i + 1 }
}

fn co_scale(dst: &![f64; 64], alpha: f64, n: i32) with Mut, Div, Panic {
    var i = 0
    while i < n { dst[i] = dst[i] * alpha; i = i + 1 }
}

fn co_zero(dst: &![f64; 64], n: i32) with Mut, Div, Panic {
    var i = 0
    while i < n { dst[i] = 0.0; i = i + 1 }
}

// ============================================================================
// STRUCTS
// ============================================================================

struct ConstrainedConfig {
    max_iter: i32,
    tol_opt: f64,
    tol_feas: f64,
    mu_init: f64,
    mu_max: f64,
    rho: f64
}

struct ConstrainedResult {
    x: [f64; 64],
    obj_val: f64,
    constraint_viol: f64,
    iterations: i32,
    converged: bool,
    n_dim: i32
}

struct LBFGSState {
    s_store: [f64; 4096],
    y_store: [f64; 4096],
    rho_store: [f64; 64],
    m: i32,
    n: i32,
    count: i32
}

// ============================================================================
// DEFAULT CONFIG / INIT RESULT
// ============================================================================

fn constrained_default_config(cfg: &!ConstrainedConfig) with Mut {
    cfg.max_iter = 100
    cfg.tol_opt = 1.0e-8
    cfg.tol_feas = 1.0e-8
    cfg.mu_init = 1.0
    cfg.mu_max = 1.0e8
    cfg.rho = 10.0
}

fn constrained_init_result(res: &!ConstrainedResult) with Mut, Div, Panic {
    var i = 0
    while i < 64 { res.x[i] = 0.0; i = i + 1 }
    res.obj_val = 0.0
    res.constraint_viol = 0.0
    res.iterations = 0
    res.converged = false
    res.n_dim = 0
}

// ============================================================================
// ARMIJO BACKTRACKING LINE SEARCH
// ============================================================================

fn co_armijo_search(f: fn(&[f64; 64], i32) -> f64 with Mut, Div, Panic,
                    x: &[f64; 64], dir: &[f64; 64], grad: &[f64; 64],
                    n: i32, alpha_init: f64) -> f64 with Mut, Div, Panic {
    let c1 = 1.0e-4
    let min_alpha = 1.0e-16
    let f0 = f(x, n)
    let dg = co_dot(grad, dir, n)
    if dg >= 0.0 { return min_alpha }
    var alpha = alpha_init
    var trial: [f64; 64] = [0.0; 64]
    var iter = 0
    while iter < 40 {
        var i = 0
        while i < n { trial[i] = x[i] + alpha * dir[i]; i = i + 1 }
        let f_trial = f(&trial, n)
        if f_trial <= f0 + c1 * alpha * dg { return alpha }
        alpha = alpha * 0.5
        if alpha < min_alpha { return min_alpha }
        iter = iter + 1
    }
    alpha
}

// ============================================================================
// L-BFGS
// ============================================================================

fn lbfgs_init(state: &!LBFGSState, n: i32, m: i32) with Mut, Div, Panic {
    state.n = n
    state.m = m
    state.count = 0
    var i = 0
    while i < 4096 { state.s_store[i] = 0.0; i = i + 1 }
    i = 0
    while i < 4096 { state.y_store[i] = 0.0; i = i + 1 }
    i = 0
    while i < 64 { state.rho_store[i] = 0.0; i = i + 1 }
}

fn lbfgs_update(state: &!LBFGSState, s: &[f64; 64], y: &[f64; 64]) with Mut, Div, Panic {
    let n = state.n
    let m = state.m
    let slot = state.count - (state.count / m) * m
    var i = 0
    while i < n {
        state.s_store[slot * n + i] = s[i]
        state.y_store[slot * n + i] = y[i]
        i = i + 1
    }
    var ys = 0.0
    i = 0
    while i < n { ys = ys + y[i] * s[i]; i = i + 1 }
    if co_abs(ys) < 1.0e-30 { ys = 1.0e-30 }
    state.rho_store[slot] = 1.0 / ys
    state.count = state.count + 1
}

fn lbfgs_direction(state: &LBFGSState, grad: &[f64; 64], dir: &![f64; 64]) with Mut, Div, Panic {
    let n = state.n
    let m = state.m
    let k = state.count
    var bound = k
    if bound > m { bound = m }

    var q: [f64; 64] = [0.0; 64]
    var i = 0
    while i < n { q[i] = grad[i]; i = i + 1 }

    var alpha: [f64; 64] = [0.0; 64]

    var idx = 0
    while idx < bound {
        let raw = k - 1 - idx
        var slot = raw - (raw / m) * m
        if slot < 0 { slot = slot + m }
        var stq = 0.0
        i = 0
        while i < n { stq = stq + state.s_store[slot * n + i] * q[i]; i = i + 1 }
        alpha[idx] = state.rho_store[slot] * stq
        i = 0
        while i < n { q[i] = q[i] - alpha[idx] * state.y_store[slot * n + i]; i = i + 1 }
        idx = idx + 1
    }

    var gamma = 1.0
    if bound > 0 {
        let nraw = k - 1
        var nslot = nraw - (nraw / m) * m
        if nslot < 0 { nslot = nslot + m }
        var sy = 0.0
        var yy = 0.0
        i = 0
        while i < n {
            sy = sy + state.s_store[nslot * n + i] * state.y_store[nslot * n + i]
            yy = yy + state.y_store[nslot * n + i] * state.y_store[nslot * n + i]
            i = i + 1
        }
        if co_abs(yy) > 1.0e-30 { gamma = sy / yy }
    }

    var r: [f64; 64] = [0.0; 64]
    i = 0
    while i < n { r[i] = gamma * q[i]; i = i + 1 }

    idx = bound - 1
    while idx >= 0 {
        let raw2 = k - 1 - idx
        var slot2 = raw2 - (raw2 / m) * m
        if slot2 < 0 { slot2 = slot2 + m }
        var ytr = 0.0
        i = 0
        while i < n { ytr = ytr + state.y_store[slot2 * n + i] * r[i]; i = i + 1 }
        let beta = state.rho_store[slot2] * ytr
        i = 0
        while i < n { r[i] = r[i] + (alpha[idx] - beta) * state.s_store[slot2 * n + i]; i = i + 1 }
        idx = idx - 1
    }

    i = 0
    while i < n { dir[i] = 0.0 - r[i]; i = i + 1 }
}

fn lbfgs_minimize(f: fn(&[f64; 64], i32) -> f64 with Mut, Div, Panic,
                  grad_f: fn(&[f64; 64], i32, &![f64; 64]) with Mut, Div, Panic,
                  x0: &[f64; 64], n: i32, max_iter: i32, tol: f64,
                  result: &!ConstrainedResult) with Mut, Div, Panic {
    var state: LBFGSState = LBFGSState {
        s_store: [0.0; 4096], y_store: [0.0; 4096],
        rho_store: [0.0; 64], m: 0, n: 0, count: 0
    }
    lbfgs_init(&!state, n, 7)

    var x: [f64; 64] = [0.0; 64]
    co_copy(x0, &!x, n)
    var grad: [f64; 64] = [0.0; 64]
    var grad_prev: [f64; 64] = [0.0; 64]
    var dir: [f64; 64] = [0.0; 64]
    var x_prev: [f64; 64] = [0.0; 64]
    var s_vec: [f64; 64] = [0.0; 64]
    var y_vec: [f64; 64] = [0.0; 64]

    grad_f(&x, n, &!grad)
    var iter = 0

    while iter < max_iter {
        let gnorm = co_norminf(&grad, n)
        if gnorm < tol {
            var ri = 0
            while ri < n { result.x[ri] = x[ri]; ri = ri + 1 }
            result.obj_val = f(&x, n)
            result.constraint_viol = 0.0
            result.iterations = iter
            result.converged = true
            result.n_dim = n
            return
        }
        co_copy(&x, &!x_prev, n)
        co_copy(&grad, &!grad_prev, n)

        if iter == 0 {
            var i = 0
            while i < n { dir[i] = 0.0 - grad[i]; i = i + 1 }
        } else {
            lbfgs_direction(&state, &grad, &!dir)
        }

        let alpha = co_armijo_search(f, &x, &dir, &grad, n, 1.0)
        var i = 0
        while i < n { x[i] = x[i] + alpha * dir[i]; i = i + 1 }
        grad_f(&x, n, &!grad)

        i = 0
        while i < n {
            s_vec[i] = x[i] - x_prev[i]
            y_vec[i] = grad[i] - grad_prev[i]
            i = i + 1
        }
        let sy = co_dot(&s_vec, &y_vec, n)
        if sy > 1.0e-16 { lbfgs_update(&!state, &s_vec, &y_vec) }
        iter = iter + 1
    }

    var ri = 0
    while ri < n { result.x[ri] = x[ri]; ri = ri + 1 }
    result.obj_val = f(&x, n)
    result.constraint_viol = 0.0
    result.iterations = iter
    result.converged = false
    result.n_dim = n
}

// ============================================================================
// BOX-CONSTRAINED OPTIMIZATION
// ============================================================================

fn box_project(x: &![f64; 64], lower: &[f64; 64], upper: &[f64; 64], n: i32) with Mut, Div, Panic {
    var i = 0
    while i < n {
        if x[i] < lower[i] { x[i] = lower[i] }
        if x[i] > upper[i] { x[i] = upper[i] }
        i = i + 1
    }
}

fn projected_gradient(f: fn(&[f64; 64], i32) -> f64 with Mut, Div, Panic,
                      grad_f: fn(&[f64; 64], i32, &![f64; 64]) with Mut, Div, Panic,
                      x0: &[f64; 64], lower: &[f64; 64], upper: &[f64; 64],
                      n: i32, max_iter: i32, tol: f64,
                      result: &!ConstrainedResult) with Mut, Div, Panic {
    var x: [f64; 64] = [0.0; 64]
    co_copy(x0, &!x, n)
    box_project(&!x, lower, upper, n)

    var grad: [f64; 64] = [0.0; 64]
    var x_trial: [f64; 64] = [0.0; 64]
    var proj_test: [f64; 64] = [0.0; 64]
    var iter = 0

    while iter < max_iter {
        grad_f(&x, n, &!grad)

        var i = 0
        while i < n { proj_test[i] = x[i] - grad[i]; i = i + 1 }
        box_project(&!proj_test, lower, upper, n)
        var opt_viol = 0.0
        i = 0
        while i < n {
            let diff = co_abs(proj_test[i] - x[i])
            if diff > opt_viol { opt_viol = diff }
            i = i + 1
        }
        if opt_viol < tol {
            var ri = 0
            while ri < n { result.x[ri] = x[ri]; ri = ri + 1 }
            result.obj_val = f(&x, n)
            result.constraint_viol = 0.0
            result.iterations = iter
            result.converged = true
            result.n_dim = n
            return
        }

        let f0 = f(&x, n)
        var alpha = 1.0
        let c1 = 1.0e-4
        var ls_iter = 0
        while ls_iter < 30 {
            i = 0
            while i < n { x_trial[i] = x[i] - alpha * grad[i]; i = i + 1 }
            box_project(&!x_trial, lower, upper, n)
            let f_trial = f(&x_trial, n)
            var descent = 0.0
            i = 0
            while i < n { descent = descent + grad[i] * (x_trial[i] - x[i]); i = i + 1 }
            if f_trial <= f0 + c1 * descent {
                co_copy(&x_trial, &!x, n)
                ls_iter = 30
            } else {
                alpha = alpha * 0.5
                if alpha < 1.0e-16 {
                    co_copy(&x_trial, &!x, n)
                    ls_iter = 30
                } else {
                    ls_iter = ls_iter + 1
                }
            }
        }
        iter = iter + 1
    }

    var ri = 0
    while ri < n { result.x[ri] = x[ri]; ri = ri + 1 }
    result.obj_val = f(&x, n)
    result.constraint_viol = 0.0
    result.iterations = iter
    result.converged = false
    result.n_dim = n
}

// ============================================================================
// AUGMENTED LAGRANGIAN: HELPERS (must precede auglag_minimize)
// ============================================================================

fn auglag_eval_obj(f: fn(&[f64; 64], i32) -> f64 with Mut, Div, Panic,
                   c_eq: fn(&[f64; 64], i32, &![f64; 64], i32) with Mut, Div, Panic,
                   n_eq: i32,
                   c_ineq: fn(&[f64; 64], i32, &![f64; 64], i32) with Mut, Div, Panic,
                   n_ineq: i32,
                   x: &[f64; 64], n: i32,
                   lambda_eq: &[f64; 64], lambda_ineq: &[f64; 64],
                   mu: f64) -> f64 with Mut, Div, Panic {
    var val = f(x, n)
    if n_eq > 0 {
        var ceq: [f64; 64] = [0.0; 64]
        c_eq(x, n, &!ceq, n_eq)
        var i = 0
        while i < n_eq {
            val = val + lambda_eq[i] * ceq[i] + 0.5 * mu * ceq[i] * ceq[i]
            i = i + 1
        }
    }
    if n_ineq > 0 {
        var cineq: [f64; 64] = [0.0; 64]
        c_ineq(x, n, &!cineq, n_ineq)
        var j = 0
        while j < n_ineq {
            let shifted = lambda_ineq[j] + mu * cineq[j]
            if shifted > 0.0 {
                val = val + (shifted * shifted - lambda_ineq[j] * lambda_ineq[j]) / (2.0 * mu)
            }
            j = j + 1
        }
    }
    val
}

fn auglag_line_search(f: fn(&[f64; 64], i32) -> f64 with Mut, Div, Panic,
                      c_eq: fn(&[f64; 64], i32, &![f64; 64], i32) with Mut, Div, Panic,
                      n_eq: i32,
                      c_ineq: fn(&[f64; 64], i32, &![f64; 64], i32) with Mut, Div, Panic,
                      n_ineq: i32,
                      x: &[f64; 64], dir: &[f64; 64], grad: &[f64; 64],
                      n: i32,
                      lambda_eq: &[f64; 64], lambda_ineq: &[f64; 64],
                      mu: f64) -> f64 with Mut, Div, Panic {
    let c1 = 1.0e-4
    let min_alpha = 1.0e-16
    let f0 = auglag_eval_obj(f, c_eq, n_eq, c_ineq, n_ineq, x, n,
                             lambda_eq, lambda_ineq, mu)
    let dg = co_dot(grad, dir, n)
    if dg >= 0.0 { return min_alpha }
    var alpha = 1.0
    var trial: [f64; 64] = [0.0; 64]
    var iter = 0
    while iter < 30 {
        var i = 0
        while i < n { trial[i] = x[i] + alpha * dir[i]; i = i + 1 }
        let f_trial = auglag_eval_obj(f, c_eq, n_eq, c_ineq, n_ineq, &trial, n,
                                      lambda_eq, lambda_ineq, mu)
        if f_trial <= f0 + c1 * alpha * dg { return alpha }
        alpha = alpha * 0.5
        if alpha < min_alpha { return min_alpha }
        iter = iter + 1
    }
    alpha
}

// ============================================================================
// AUGMENTED LAGRANGIAN METHOD
// ============================================================================

fn auglag_minimize(f: fn(&[f64; 64], i32) -> f64 with Mut, Div, Panic,
                   grad_f: fn(&[f64; 64], i32, &![f64; 64]) with Mut, Div, Panic,
                   c_eq: fn(&[f64; 64], i32, &![f64; 64], i32) with Mut, Div, Panic,
                   n_eq: i32,
                   c_ineq: fn(&[f64; 64], i32, &![f64; 64], i32) with Mut, Div, Panic,
                   n_ineq: i32,
                   x0: &[f64; 64], n: i32,
                   config: &ConstrainedConfig,
                   result: &!ConstrainedResult) with Mut, Div, Panic {
    var x: [f64; 64] = [0.0; 64]
    co_copy(x0, &!x, n)
    var lambda_eq: [f64; 64] = [0.0; 64]
    var lambda_ineq: [f64; 64] = [0.0; 64]
    var mu = config.mu_init
    var ceq_val: [f64; 64] = [0.0; 64]
    var cineq_val: [f64; 64] = [0.0; 64]

    var outer = 0
    while outer < config.max_iter {
        if n_eq > 0 { c_eq(&x, n, &!ceq_val, n_eq) }
        if n_ineq > 0 { c_ineq(&x, n, &!cineq_val, n_ineq) }
        var feas_viol = 0.0
        var i = 0
        while i < n_eq {
            let v = co_abs(ceq_val[i])
            if v > feas_viol { feas_viol = v }
            i = i + 1
        }
        i = 0
        while i < n_ineq {
            if cineq_val[i] > 0.0 {
                if cineq_val[i] > feas_viol { feas_viol = cineq_val[i] }
            }
            i = i + 1
        }
        if feas_viol < config.tol_feas {
            var grad_L: [f64; 64] = [0.0; 64]
            grad_f(&x, n, &!grad_L)
            let gnorm = co_norminf(&grad_L, n)
            if gnorm < config.tol_opt {
                var ri = 0
                while ri < n { result.x[ri] = x[ri]; ri = ri + 1 }
                result.obj_val = f(&x, n)
                result.constraint_viol = feas_viol
                result.iterations = outer
                result.converged = true
                result.n_dim = n
                return
            }
        }

        // Inner L-BFGS solve on augmented Lagrangian
        var istate: LBFGSState = LBFGSState {
            s_store: [0.0; 4096], y_store: [0.0; 4096],
            rho_store: [0.0; 64], m: 0, n: 0, count: 0
        }
        lbfgs_init(&!istate, n, 7)
        var grad_aug: [f64; 64] = [0.0; 64]
        var grad_aug_prev: [f64; 64] = [0.0; 64]
        var dir_aug: [f64; 64] = [0.0; 64]
        var x_prev: [f64; 64] = [0.0; 64]
        var s_in: [f64; 64] = [0.0; 64]
        var y_in: [f64; 64] = [0.0; 64]
        var xp: [f64; 64] = [0.0; 64]
        var xm: [f64; 64] = [0.0; 64]
        let cbrt_eps = 6.0554544523933429e-6

        var inner = 0
        while inner < 50 {
            var gi = 0
            while gi < n {
                var j = 0
                while j < n { xp[j] = x[j]; xm[j] = x[j]; j = j + 1 }
                let h = cbrt_eps * co_max(co_abs(x[gi]), 1.0)
                xp[gi] = x[gi] + h
                xm[gi] = x[gi] - h
                let fp = auglag_eval_obj(f, c_eq, n_eq, c_ineq, n_ineq,
                                         &xp, n, &lambda_eq, &lambda_ineq, mu)
                let fm = auglag_eval_obj(f, c_eq, n_eq, c_ineq, n_ineq,
                                         &xm, n, &lambda_eq, &lambda_ineq, mu)
                grad_aug[gi] = (fp - fm) / (2.0 * h)
                gi = gi + 1
            }
            let gnorm_in = co_norminf(&grad_aug, n)
            if gnorm_in < config.tol_opt * 10.0 {
                inner = 50
            } else {
                co_copy(&x, &!x_prev, n)
                co_copy(&grad_aug, &!grad_aug_prev, n)
                if inner == 0 {
                    var di = 0
                    while di < n { dir_aug[di] = 0.0 - grad_aug[di]; di = di + 1 }
                } else {
                    lbfgs_direction(&istate, &grad_aug, &!dir_aug)
                }
                let a_aug = auglag_line_search(f, c_eq, n_eq, c_ineq, n_ineq,
                                               &x, &dir_aug, &grad_aug,
                                               n, &lambda_eq, &lambda_ineq, mu)
                var ui = 0
                while ui < n { x[ui] = x[ui] + a_aug * dir_aug[ui]; ui = ui + 1 }

                gi = 0
                while gi < n {
                    var j = 0
                    while j < n { xp[j] = x[j]; xm[j] = x[j]; j = j + 1 }
                    let h = cbrt_eps * co_max(co_abs(x[gi]), 1.0)
                    xp[gi] = x[gi] + h
                    xm[gi] = x[gi] - h
                    let fp2 = auglag_eval_obj(f, c_eq, n_eq, c_ineq, n_ineq,
                                              &xp, n, &lambda_eq, &lambda_ineq, mu)
                    let fm2 = auglag_eval_obj(f, c_eq, n_eq, c_ineq, n_ineq,
                                              &xm, n, &lambda_eq, &lambda_ineq, mu)
                    grad_aug[gi] = (fp2 - fm2) / (2.0 * h)
                    gi = gi + 1
                }
                var si = 0
                while si < n {
                    s_in[si] = x[si] - x_prev[si]
                    y_in[si] = grad_aug[si] - grad_aug_prev[si]
                    si = si + 1
                }
                let sy_in = co_dot(&s_in, &y_in, n)
                if sy_in > 1.0e-16 { lbfgs_update(&!istate, &s_in, &y_in) }
                inner = inner + 1
            }
        }

        // Update multipliers
        if n_eq > 0 { c_eq(&x, n, &!ceq_val, n_eq) }
        if n_ineq > 0 { c_ineq(&x, n, &!cineq_val, n_ineq) }
        i = 0
        while i < n_eq { lambda_eq[i] = lambda_eq[i] + mu * ceq_val[i]; i = i + 1 }
        i = 0
        while i < n_ineq {
            let cand = lambda_ineq[i] + mu * cineq_val[i]
            if cand > 0.0 { lambda_ineq[i] = cand } else { lambda_ineq[i] = 0.0 }
            i = i + 1
        }
        mu = mu * config.rho
        if mu > config.mu_max { mu = config.mu_max }
        outer = outer + 1
    }

    if n_eq > 0 { c_eq(&x, n, &!ceq_val, n_eq) }
    if n_ineq > 0 { c_ineq(&x, n, &!cineq_val, n_ineq) }
    var fv = 0.0
    var vi = 0
    while vi < n_eq {
        let v = co_abs(ceq_val[vi])
        if v > fv { fv = v }
        vi = vi + 1
    }
    vi = 0
    while vi < n_ineq {
        if cineq_val[vi] > 0.0 { if cineq_val[vi] > fv { fv = cineq_val[vi] } }
        vi = vi + 1
    }
    var ri = 0
    while ri < n { result.x[ri] = x[ri]; ri = ri + 1 }
    result.obj_val = f(&x, n)
    result.constraint_viol = fv
    result.iterations = outer
    result.converged = false
    result.n_dim = n
}

// ============================================================================
// PENALTY METHOD: HELPERS (must precede penalty_minimize)
// ============================================================================

fn penalty_eval_obj(f: fn(&[f64; 64], i32) -> f64 with Mut, Div, Panic,
                    c: fn(&[f64; 64], i32, &![f64; 64], i32) with Mut, Div, Panic,
                    n_c: i32,
                    x: &[f64; 64], n: i32,
                    mu: f64) -> f64 with Mut, Div, Panic {
    var val = f(x, n)
    var c_val: [f64; 64] = [0.0; 64]
    c(x, n, &!c_val, n_c)
    var penalty = 0.0
    var i = 0
    while i < n_c { penalty = penalty + c_val[i] * c_val[i]; i = i + 1 }
    val + 0.5 * mu * penalty
}

fn penalty_line_search(f: fn(&[f64; 64], i32) -> f64 with Mut, Div, Panic,
                       c: fn(&[f64; 64], i32, &![f64; 64], i32) with Mut, Div, Panic,
                       n_c: i32,
                       x: &[f64; 64], dir: &[f64; 64], grad: &[f64; 64],
                       n: i32, mu: f64) -> f64 with Mut, Div, Panic {
    let c1 = 1.0e-4
    let min_alpha = 1.0e-16
    let f0 = penalty_eval_obj(f, c, n_c, x, n, mu)
    let dg = co_dot(grad, dir, n)
    if dg >= 0.0 { return min_alpha }
    var alpha = 1.0
    var trial: [f64; 64] = [0.0; 64]
    var iter = 0
    while iter < 30 {
        var i = 0
        while i < n { trial[i] = x[i] + alpha * dir[i]; i = i + 1 }
        let f_trial = penalty_eval_obj(f, c, n_c, &trial, n, mu)
        if f_trial <= f0 + c1 * alpha * dg { return alpha }
        alpha = alpha * 0.5
        if alpha < min_alpha { return min_alpha }
        iter = iter + 1
    }
    alpha
}

// ============================================================================
// QUADRATIC PENALTY METHOD
// ============================================================================

fn penalty_minimize(f: fn(&[f64; 64], i32) -> f64 with Mut, Div, Panic,
                    grad_f: fn(&[f64; 64], i32, &![f64; 64]) with Mut, Div, Panic,
                    c: fn(&[f64; 64], i32, &![f64; 64], i32) with Mut, Div, Panic,
                    n_c: i32,
                    x0: &[f64; 64], n: i32,
                    config: &ConstrainedConfig,
                    result: &!ConstrainedResult) with Mut, Div, Panic {
    var x: [f64; 64] = [0.0; 64]
    co_copy(x0, &!x, n)
    var mu = config.mu_init
    var c_val: [f64; 64] = [0.0; 64]

    var outer = 0
    while outer < config.max_iter {
        var istate: LBFGSState = LBFGSState {
            s_store: [0.0; 4096], y_store: [0.0; 4096],
            rho_store: [0.0; 64], m: 0, n: 0, count: 0
        }
        lbfgs_init(&!istate, n, 7)
        var gp: [f64; 64] = [0.0; 64]
        var gp_prev: [f64; 64] = [0.0; 64]
        var dp: [f64; 64] = [0.0; 64]
        var xprev: [f64; 64] = [0.0; 64]
        var sp: [f64; 64] = [0.0; 64]
        var yp: [f64; 64] = [0.0; 64]
        var xpp: [f64; 64] = [0.0; 64]
        var xmm: [f64; 64] = [0.0; 64]
        let cbrt_eps = 6.0554544523933429e-6

        var inner = 0
        while inner < 50 {
            var gi = 0
            while gi < n {
                var j = 0
                while j < n { xpp[j] = x[j]; xmm[j] = x[j]; j = j + 1 }
                let h = cbrt_eps * co_max(co_abs(x[gi]), 1.0)
                xpp[gi] = x[gi] + h
                xmm[gi] = x[gi] - h
                let fp = penalty_eval_obj(f, c, n_c, &xpp, n, mu)
                let fm = penalty_eval_obj(f, c, n_c, &xmm, n, mu)
                gp[gi] = (fp - fm) / (2.0 * h)
                gi = gi + 1
            }
            let gnorm = co_norminf(&gp, n)
            if gnorm < config.tol_opt * 10.0 {
                inner = 50
            } else {
                co_copy(&x, &!xprev, n)
                co_copy(&gp, &!gp_prev, n)
                if inner == 0 {
                    var di = 0
                    while di < n { dp[di] = 0.0 - gp[di]; di = di + 1 }
                } else {
                    lbfgs_direction(&istate, &gp, &!dp)
                }
                let ap = penalty_line_search(f, c, n_c, &x, &dp, &gp, n, mu)
                var ui = 0
                while ui < n { x[ui] = x[ui] + ap * dp[ui]; ui = ui + 1 }

                gi = 0
                while gi < n {
                    var j = 0
                    while j < n { xpp[j] = x[j]; xmm[j] = x[j]; j = j + 1 }
                    let h = cbrt_eps * co_max(co_abs(x[gi]), 1.0)
                    xpp[gi] = x[gi] + h
                    xmm[gi] = x[gi] - h
                    let fp2 = penalty_eval_obj(f, c, n_c, &xpp, n, mu)
                    let fm2 = penalty_eval_obj(f, c, n_c, &xmm, n, mu)
                    gp[gi] = (fp2 - fm2) / (2.0 * h)
                    gi = gi + 1
                }
                var si = 0
                while si < n {
                    sp[si] = x[si] - xprev[si]
                    yp[si] = gp[si] - gp_prev[si]
                    si = si + 1
                }
                let syp = co_dot(&sp, &yp, n)
                if syp > 1.0e-16 { lbfgs_update(&!istate, &sp, &yp) }
                inner = inner + 1
            }
        }

        c(&x, n, &!c_val, n_c)
        var fv = 0.0
        var vi = 0
        while vi < n_c {
            let v = co_abs(c_val[vi])
            if v > fv { fv = v }
            vi = vi + 1
        }
        if fv < config.tol_feas {
            var ri = 0
            while ri < n { result.x[ri] = x[ri]; ri = ri + 1 }
            result.obj_val = f(&x, n)
            result.constraint_viol = fv
            result.iterations = outer
            result.converged = true
            result.n_dim = n
            return
        }
        mu = mu * config.rho
        if mu > config.mu_max { mu = config.mu_max }
        outer = outer + 1
    }

    c(&x, n, &!c_val, n_c)
    var fv = 0.0
    var vi = 0
    while vi < n_c {
        let v = co_abs(c_val[vi])
        if v > fv { fv = v }
        vi = vi + 1
    }
    var ri = 0
    while ri < n { result.x[ri] = x[ri]; ri = ri + 1 }
    result.obj_val = f(&x, n)
    result.constraint_viol = fv
    result.iterations = outer
    result.converged = false
    result.n_dim = n
}

// ============================================================================
// BARRIER METHOD: HELPERS (must precede barrier_minimize)
// ============================================================================

fn barrier_eval_obj(f: fn(&[f64; 64], i32) -> f64 with Mut, Div, Panic,
                    c_ineq: fn(&[f64; 64], i32, &![f64; 64], i32) with Mut, Div, Panic,
                    n_ineq: i32,
                    x: &[f64; 64], n: i32,
                    t: f64) -> f64 with Mut, Div, Panic {
    var val = f(x, n)
    var cineq: [f64; 64] = [0.0; 64]
    c_ineq(x, n, &!cineq, n_ineq)
    var j = 0
    while j < n_ineq {
        if cineq[j] >= 0.0 { return 1.0e308 }
        val = val - co_ln(0.0 - cineq[j]) / t
        j = j + 1
    }
    val
}

fn barrier_line_search(f: fn(&[f64; 64], i32) -> f64 with Mut, Div, Panic,
                       c_ineq: fn(&[f64; 64], i32, &![f64; 64], i32) with Mut, Div, Panic,
                       n_ineq: i32,
                       x: &[f64; 64], dir: &[f64; 64], grad: &[f64; 64],
                       n: i32, t: f64) -> f64 with Mut, Div, Panic {
    let c1 = 1.0e-4
    let min_alpha = 1.0e-16
    let f0 = barrier_eval_obj(f, c_ineq, n_ineq, x, n, t)
    let dg = co_dot(grad, dir, n)
    if dg >= 0.0 { return min_alpha }
    var alpha = 1.0
    var trial: [f64; 64] = [0.0; 64]
    var ct: [f64; 64] = [0.0; 64]
    var iter = 0
    while iter < 40 {
        var i = 0
        while i < n { trial[i] = x[i] + alpha * dir[i]; i = i + 1 }
        c_ineq(&trial, n, &!ct, n_ineq)
        var feasible = true
        i = 0
        while i < n_ineq {
            if ct[i] >= 0.0 { feasible = false }
            i = i + 1
        }
        if feasible {
            let f_trial = barrier_eval_obj(f, c_ineq, n_ineq, &trial, n, t)
            if f_trial <= f0 + c1 * alpha * dg { return alpha }
        }
        alpha = alpha * 0.5
        if alpha < min_alpha { return min_alpha }
        iter = iter + 1
    }
    alpha
}

// ============================================================================
// LOG-BARRIER INTERIOR POINT METHOD
// ============================================================================

fn barrier_minimize(f: fn(&[f64; 64], i32) -> f64 with Mut, Div, Panic,
                    grad_f: fn(&[f64; 64], i32, &![f64; 64]) with Mut, Div, Panic,
                    c_ineq: fn(&[f64; 64], i32, &![f64; 64], i32) with Mut, Div, Panic,
                    n_ineq: i32,
                    x0: &[f64; 64], n: i32,
                    config: &ConstrainedConfig,
                    result: &!ConstrainedResult) with Mut, Div, Panic {
    var x: [f64; 64] = [0.0; 64]
    co_copy(x0, &!x, n)
    var t = 1.0
    var cv: [f64; 64] = [0.0; 64]

    c_ineq(&x, n, &!cv, n_ineq)
    var i = 0
    while i < n_ineq {
        if cv[i] >= 0.0 {
            var ri = 0
            while ri < n { result.x[ri] = x0[ri]; ri = ri + 1 }
            result.obj_val = f(x0, n)
            result.constraint_viol = 1.0e30
            result.iterations = 0
            result.converged = false
            result.n_dim = n
            return
        }
        i = i + 1
    }

    var outer = 0
    while outer < config.max_iter {
        var istate: LBFGSState = LBFGSState {
            s_store: [0.0; 4096], y_store: [0.0; 4096],
            rho_store: [0.0; 64], m: 0, n: 0, count: 0
        }
        lbfgs_init(&!istate, n, 7)
        var gb: [f64; 64] = [0.0; 64]
        var gb_prev: [f64; 64] = [0.0; 64]
        var db: [f64; 64] = [0.0; 64]
        var xprev: [f64; 64] = [0.0; 64]
        var sb: [f64; 64] = [0.0; 64]
        var yb: [f64; 64] = [0.0; 64]
        var xpp: [f64; 64] = [0.0; 64]
        var xmm: [f64; 64] = [0.0; 64]
        let cbrt_eps = 6.0554544523933429e-6

        var inner = 0
        while inner < 80 {
            var gi = 0
            while gi < n {
                var j = 0
                while j < n { xpp[j] = x[j]; xmm[j] = x[j]; j = j + 1 }
                let h = cbrt_eps * co_max(co_abs(x[gi]), 1.0)
                xpp[gi] = x[gi] + h
                xmm[gi] = x[gi] - h
                let fp = barrier_eval_obj(f, c_ineq, n_ineq, &xpp, n, t)
                let fm = barrier_eval_obj(f, c_ineq, n_ineq, &xmm, n, t)
                let diff = fp - fm
                if co_abs(diff) < 1.0e300 {
                    gb[gi] = diff / (2.0 * h)
                } else {
                    gb[gi] = 0.0
                }
                gi = gi + 1
            }
            let gnorm = co_norminf(&gb, n)
            if gnorm < config.tol_opt {
                inner = 80
            } else {
                co_copy(&x, &!xprev, n)
                co_copy(&gb, &!gb_prev, n)
                if inner == 0 {
                    var di = 0
                    while di < n { db[di] = 0.0 - gb[di]; di = di + 1 }
                } else {
                    lbfgs_direction(&istate, &gb, &!db)
                }
                let ab = barrier_line_search(f, c_ineq, n_ineq,
                                             &x, &db, &gb, n, t)
                var ui = 0
                while ui < n { x[ui] = x[ui] + ab * db[ui]; ui = ui + 1 }

                gi = 0
                while gi < n {
                    var j = 0
                    while j < n { xpp[j] = x[j]; xmm[j] = x[j]; j = j + 1 }
                    let h = cbrt_eps * co_max(co_abs(x[gi]), 1.0)
                    xpp[gi] = x[gi] + h
                    xmm[gi] = x[gi] - h
                    let fp2 = barrier_eval_obj(f, c_ineq, n_ineq, &xpp, n, t)
                    let fm2 = barrier_eval_obj(f, c_ineq, n_ineq, &xmm, n, t)
                    let diff2 = fp2 - fm2
                    if co_abs(diff2) < 1.0e300 {
                        gb[gi] = diff2 / (2.0 * h)
                    } else {
                        gb[gi] = 0.0
                    }
                    gi = gi + 1
                }
                var si = 0
                while si < n {
                    sb[si] = x[si] - xprev[si]
                    yb[si] = gb[si] - gb_prev[si]
                    si = si + 1
                }
                let syb = co_dot(&sb, &yb, n)
                if syb > 1.0e-16 { lbfgs_update(&!istate, &sb, &yb) }
                inner = inner + 1
            }
        }

        let gap = (n_ineq as f64) / t
        if gap < config.tol_opt {
            c_ineq(&x, n, &!cv, n_ineq)
            var mv = 0.0
            i = 0
            while i < n_ineq {
                if cv[i] > 0.0 { if cv[i] > mv { mv = cv[i] } }
                i = i + 1
            }
            var ri = 0
            while ri < n { result.x[ri] = x[ri]; ri = ri + 1 }
            result.obj_val = f(&x, n)
            result.constraint_viol = mv
            result.iterations = outer
            result.converged = true
            result.n_dim = n
            return
        }
        t = t * config.rho
        outer = outer + 1
    }

    c_ineq(&x, n, &!cv, n_ineq)
    var mv = 0.0
    i = 0
    while i < n_ineq {
        if cv[i] > 0.0 { if cv[i] > mv { mv = cv[i] } }
        i = i + 1
    }
    var ri = 0
    while ri < n { result.x[ri] = x[ri]; ri = ri + 1 }
    result.obj_val = f(&x, n)
    result.constraint_viol = mv
    result.iterations = outer
    result.converged = false
    result.n_dim = n
}

// ============================================================================
// KKT VIOLATION
// ============================================================================

fn kkt_violation(grad_f_x: &[f64; 64],
                 jac_eq: &[f64; 4096], n_eq: i32,
                 jac_ineq: &[f64; 4096], n_ineq: i32,
                 lambda_eq: &[f64; 64], lambda_ineq: &[f64; 64],
                 c_eq_x: &[f64; 64], c_ineq_x: &[f64; 64],
                 n: i32) -> f64 with Mut, Div, Panic {
    var stat: [f64; 64] = [0.0; 64]
    var i = 0
    while i < n { stat[i] = grad_f_x[i]; i = i + 1 }
    i = 0
    while i < n_eq {
        var j = 0
        while j < n { stat[j] = stat[j] + jac_eq[i * n + j] * lambda_eq[i]; j = j + 1 }
        i = i + 1
    }
    i = 0
    while i < n_ineq {
        var j = 0
        while j < n { stat[j] = stat[j] + jac_ineq[i * n + j] * lambda_ineq[i]; j = j + 1 }
        i = i + 1
    }
    var sv = 0.0
    i = 0
    while i < n { let v = co_abs(stat[i]); if v > sv { sv = v }; i = i + 1 }

    var ev = 0.0
    i = 0
    while i < n_eq { let v = co_abs(c_eq_x[i]); if v > ev { ev = v }; i = i + 1 }

    var iv = 0.0
    i = 0
    while i < n_ineq {
        if c_ineq_x[i] > 0.0 { if c_ineq_x[i] > iv { iv = c_ineq_x[i] } }
        i = i + 1
    }

    var dv = 0.0
    i = 0
    while i < n_ineq {
        if lambda_ineq[i] < 0.0 { let v = co_abs(lambda_ineq[i]); if v > dv { dv = v } }
        i = i + 1
    }

    var cv = 0.0
    i = 0
    while i < n_ineq {
        let v = co_abs(lambda_ineq[i] * c_ineq_x[i])
        if v > cv { cv = v }
        i = i + 1
    }

    var mx = sv
    if ev > mx { mx = ev }
    if iv > mx { mx = iv }
    if dv > mx { mx = dv }
    if cv > mx { mx = cv }
    mx
}

// ============================================================================
// OBJECTIVE / GRADIENT / CONSTRAINT FUNCTIONS FOR TESTS
// (must precede test functions and main)
// ============================================================================

// Quadratic: f(x) = x[0]^2 + x[1]^2
fn quad_obj(x: &[f64; 64], n: i32) -> f64 with Mut, Div, Panic {
    x[0] * x[0] + x[1] * x[1]
}

fn quad_grad(x: &[f64; 64], n: i32, g: &![f64; 64]) with Mut, Div, Panic {
    g[0] = 2.0 * x[0]
    g[1] = 2.0 * x[1]
}

// Rosenbrock: f(x) = (1-x[0])^2 + 100*(x[1]-x[0]^2)^2
fn rosen_obj(x: &[f64; 64], n: i32) -> f64 with Mut, Div, Panic {
    let a = 1.0 - x[0]
    let b = x[1] - x[0] * x[0]
    a * a + 100.0 * b * b
}

fn rosen_grad(x: &[f64; 64], n: i32, g: &![f64; 64]) with Mut, Div, Panic {
    let b = x[1] - x[0] * x[0]
    g[0] = 0.0 - 2.0 * (1.0 - x[0]) - 400.0 * x[0] * b
    g[1] = 200.0 * b
}

// Equality constraint for penalty/auglag tests: c(x) = x[0] + x[1] - 1
fn eq_constraint(x: &[f64; 64], n: i32, c_out: &![f64; 64], n_c: i32) with Mut, Div, Panic {
    c_out[0] = x[0] + x[1] - 1.0
}

// Inequality constraints for barrier test: c_i(x) <= 0
// c[0] = 1 - x[0] <= 0  (i.e. x[0] >= 1)
// c[1] = 1 - x[1] <= 0  (i.e. x[1] >= 1)
fn barrier_ineq(x: &[f64; 64], n: i32, c_out: &![f64; 64], n_c: i32) with Mut, Div, Panic {
    c_out[0] = 1.0 - x[0]
    c_out[1] = 1.0 - x[1]
}

// Linear objective for barrier test: f(x) = x[0] + x[1]
fn linear_obj(x: &[f64; 64], n: i32) -> f64 with Mut, Div, Panic {
    x[0] + x[1]
}

fn linear_grad(x: &[f64; 64], n: i32, g: &![f64; 64]) with Mut, Div, Panic {
    g[0] = 1.0
    g[1] = 1.0
}

// Dummy inequality constraint (no inequalities): used where n_ineq=0
fn no_ineq(x: &[f64; 64], n: i32, c_out: &![f64; 64], n_c: i32) with Mut, Div, Panic {
    // no-op
}

// Dummy equality constraint (no equalities): used where n_eq=0
fn no_eq(x: &[f64; 64], n: i32, c_out: &![f64; 64], n_c: i32) with Mut, Div, Panic {
    // no-op
}

// ============================================================================
// TEST FUNCTIONS (must precede main)
// ============================================================================

// Test 1: L-BFGS on quadratic: min x1^2 + x2^2, x* = (0,0)
fn test_lbfgs_quadratic() -> bool with Mut, Div, Panic {
    var x0: [f64; 64] = [0.0; 64]
    x0[0] = 5.0
    x0[1] = 3.0
    var res: ConstrainedResult = ConstrainedResult {
        x: [0.0; 64], obj_val: 0.0, constraint_viol: 0.0,
        iterations: 0, converged: false, n_dim: 0
    }
    constrained_init_result(&!res)
    lbfgs_minimize(quad_obj, quad_grad, &x0, 2, 200, 1.0e-6, &!res)
    let ok1 = approx_eq(res.x[0], 0.0, 1.0e-3)
    let ok2 = approx_eq(res.x[1], 0.0, 1.0e-3)
    let ok3 = approx_eq(res.obj_val, 0.0, 1.0e-3)
    ok1 && ok2 && ok3
}

// Test 2: L-BFGS on Rosenbrock: min (1-x1)^2 + 100*(x2-x1^2)^2, x* ~ (1,1)
fn test_lbfgs_rosenbrock() -> bool with Mut, Div, Panic {
    var x0: [f64; 64] = [0.0; 64]
    x0[0] = 0.0 - 1.0
    x0[1] = 1.0
    var res: ConstrainedResult = ConstrainedResult {
        x: [0.0; 64], obj_val: 0.0, constraint_viol: 0.0,
        iterations: 0, converged: false, n_dim: 0
    }
    constrained_init_result(&!res)
    lbfgs_minimize(rosen_obj, rosen_grad, &x0, 2, 2000, 1.0e-6, &!res)
    // Rosenbrock is notoriously hard; accept if close to (1,1)
    let ok1 = approx_eq(res.x[0], 1.0, 0.05)
    let ok2 = approx_eq(res.x[1], 1.0, 0.05)
    ok1 && ok2
}

// Test 3: L-BFGS converged flag on simple quadratic
fn test_lbfgs_converged_flag() -> bool with Mut, Div, Panic {
    var x0: [f64; 64] = [0.0; 64]
    x0[0] = 2.0
    x0[1] = 3.0
    var res: ConstrainedResult = ConstrainedResult {
        x: [0.0; 64], obj_val: 0.0, constraint_viol: 0.0,
        iterations: 0, converged: false, n_dim: 0
    }
    constrained_init_result(&!res)
    lbfgs_minimize(quad_obj, quad_grad, &x0, 2, 500, 1.0e-6, &!res)
    res.converged
}

// Test 4: box_project clamps correctly
fn test_box_project() -> bool with Mut, Div, Panic {
    var x: [f64; 64] = [0.0; 64]
    x[0] = 0.0 - 1.0
    x[1] = 2.0
    x[2] = 0.5
    var lower: [f64; 64] = [0.0; 64]
    lower[0] = 0.0
    lower[1] = 0.0
    lower[2] = 0.0
    var upper: [f64; 64] = [0.0; 64]
    upper[0] = 1.0
    upper[1] = 1.0
    upper[2] = 1.0
    box_project(&!x, &lower, &upper, 3)
    let ok1 = approx_eq(x[0], 0.0, 1.0e-12)
    let ok2 = approx_eq(x[1], 1.0, 1.0e-12)
    let ok3 = approx_eq(x[2], 0.5, 1.0e-12)
    ok1 && ok2 && ok3
}

// Test 5: Projected gradient on quadratic with box [0.5, 2]^2 -> x*=(0.5, 0.5)
fn test_projected_gradient_box() -> bool with Mut, Div, Panic {
    var x0: [f64; 64] = [0.0; 64]
    x0[0] = 1.5
    x0[1] = 1.5
    var lower: [f64; 64] = [0.0; 64]
    lower[0] = 0.5
    lower[1] = 0.5
    var upper: [f64; 64] = [0.0; 64]
    upper[0] = 2.0
    upper[1] = 2.0
    var res: ConstrainedResult = ConstrainedResult {
        x: [0.0; 64], obj_val: 0.0, constraint_viol: 0.0,
        iterations: 0, converged: false, n_dim: 0
    }
    constrained_init_result(&!res)
    projected_gradient(quad_obj, quad_grad, &x0, &lower, &upper, 2, 500, 1.0e-6, &!res)
    let ok1 = approx_eq(res.x[0], 0.5, 1.0e-3)
    let ok2 = approx_eq(res.x[1], 0.5, 1.0e-3)
    let ok3 = approx_eq(res.obj_val, 0.5, 1.0e-3)
    ok1 && ok2 && ok3
}

// Test 6: Penalty method on equality: min x1^2+x2^2 s.t. x1+x2=1 -> x*=(0.5,0.5)
fn test_penalty_equality() -> bool with Mut, Div, Panic {
    var x0: [f64; 64] = [0.0; 64]
    x0[0] = 2.0
    x0[1] = 2.0
    var cfg: ConstrainedConfig = ConstrainedConfig {
        max_iter: 0, tol_opt: 0.0, tol_feas: 0.0,
        mu_init: 0.0, mu_max: 0.0, rho: 0.0
    }
    constrained_default_config(&!cfg)
    cfg.max_iter = 30
    cfg.tol_feas = 1.0e-4
    cfg.tol_opt = 1.0e-6
    var res: ConstrainedResult = ConstrainedResult {
        x: [0.0; 64], obj_val: 0.0, constraint_viol: 0.0,
        iterations: 0, converged: false, n_dim: 0
    }
    constrained_init_result(&!res)
    penalty_minimize(quad_obj, quad_grad, eq_constraint, 1, &x0, 2, &cfg, &!res)
    let ok1 = approx_eq(res.x[0], 0.5, 1.0e-2)
    let ok2 = approx_eq(res.x[1], 0.5, 1.0e-2)
    // Check constraint satisfaction
    let ok3 = approx_eq(res.x[0] + res.x[1], 1.0, 1.0e-2)
    ok1 && ok2 && ok3
}

// Test 7: Augmented Lagrangian on equality: same problem, should converge
fn test_auglag_equality() -> bool with Mut, Div, Panic {
    var x0: [f64; 64] = [0.0; 64]
    x0[0] = 2.0
    x0[1] = 2.0
    var cfg: ConstrainedConfig = ConstrainedConfig {
        max_iter: 0, tol_opt: 0.0, tol_feas: 0.0,
        mu_init: 0.0, mu_max: 0.0, rho: 0.0
    }
    constrained_default_config(&!cfg)
    cfg.max_iter = 30
    cfg.tol_feas = 1.0e-4
    cfg.tol_opt = 1.0e-6
    var res: ConstrainedResult = ConstrainedResult {
        x: [0.0; 64], obj_val: 0.0, constraint_viol: 0.0,
        iterations: 0, converged: false, n_dim: 0
    }
    constrained_init_result(&!res)
    auglag_minimize(quad_obj, quad_grad, eq_constraint, 1, no_ineq, 0,
                    &x0, 2, &cfg, &!res)
    let ok1 = approx_eq(res.x[0], 0.5, 1.0e-2)
    let ok2 = approx_eq(res.x[1], 0.5, 1.0e-2)
    let ok3 = approx_eq(res.x[0] + res.x[1], 1.0, 1.0e-2)
    ok1 && ok2 && ok3
}

// Test 8: Barrier on inequality: min x1+x2 s.t. x1>=1, x2>=1 -> x*=(1,1), obj=2
fn test_barrier_inequality() -> bool with Mut, Div, Panic {
    // Start strictly feasible: x0 = (3, 3) so c = (1-3, 1-3) = (-2, -2) < 0
    var x0: [f64; 64] = [0.0; 64]
    x0[0] = 3.0
    x0[1] = 3.0
    var cfg: ConstrainedConfig = ConstrainedConfig {
        max_iter: 0, tol_opt: 0.0, tol_feas: 0.0,
        mu_init: 0.0, mu_max: 0.0, rho: 0.0
    }
    constrained_default_config(&!cfg)
    cfg.max_iter = 40
    cfg.tol_opt = 1.0e-4
    cfg.rho = 10.0
    var res: ConstrainedResult = ConstrainedResult {
        x: [0.0; 64], obj_val: 0.0, constraint_viol: 0.0,
        iterations: 0, converged: false, n_dim: 0
    }
    constrained_init_result(&!res)
    barrier_minimize(linear_obj, linear_grad, barrier_ineq, 2,
                     &x0, 2, &cfg, &!res)
    // Barrier approaches boundary but does not reach it exactly
    let ok1 = approx_eq(res.x[0], 1.0, 0.1)
    let ok2 = approx_eq(res.x[1], 1.0, 0.1)
    let ok3 = approx_eq(res.obj_val, 2.0, 0.2)
    ok1 && ok2 && ok3
}

// Test 9: KKT violation zero at unconstrained quadratic optimum (origin)
fn test_kkt_zero_at_optimum() -> bool with Mut, Div, Panic {
    // grad f = (0, 0) at origin; no constraints
    var grad_f_x: [f64; 64] = [0.0; 64]
    var jac_eq: [f64; 4096] = [0.0; 4096]
    var jac_ineq: [f64; 4096] = [0.0; 4096]
    var lam_eq: [f64; 64] = [0.0; 64]
    var lam_ineq: [f64; 64] = [0.0; 64]
    var c_eq_x: [f64; 64] = [0.0; 64]
    var c_ineq_x: [f64; 64] = [0.0; 64]
    let kkt_val = kkt_violation(&grad_f_x, &jac_eq, 0, &jac_ineq, 0,
                                &lam_eq, &lam_ineq, &c_eq_x, &c_ineq_x, 2)
    approx_eq(kkt_val, 0.0, 1.0e-12)
}

// Test 10: Armijo search returns valid step
fn test_armijo_valid_step() -> bool with Mut, Div, Panic {
    var x: [f64; 64] = [0.0; 64]
    x[0] = 3.0
    x[1] = 4.0
    var dir: [f64; 64] = [0.0; 64]
    // Steepest descent direction: -grad = (-6, -8)
    dir[0] = 0.0 - 6.0
    dir[1] = 0.0 - 8.0
    var grad: [f64; 64] = [0.0; 64]
    grad[0] = 6.0
    grad[1] = 8.0
    let alpha = co_armijo_search(quad_obj, &x, &dir, &grad, 2, 1.0)
    // Alpha should be positive
    let ok1 = alpha > 0.0
    // Check sufficient decrease: f(x + alpha*d) <= f(x) + c1*alpha*grad'*d
    var x_new: [f64; 64] = [0.0; 64]
    x_new[0] = x[0] + alpha * dir[0]
    x_new[1] = x[1] + alpha * dir[1]
    let f0 = quad_obj(&x, 2)
    let f1 = quad_obj(&x_new, 2)
    let dg = grad[0] * dir[0] + grad[1] * dir[1]
    let ok2 = f1 <= f0 + 1.0e-4 * alpha * dg + 1.0e-12
    ok1 && ok2
}

// Test 11: Default config values
fn test_default_config() -> bool with Mut, Div, Panic {
    var cfg: ConstrainedConfig = ConstrainedConfig {
        max_iter: 0, tol_opt: 0.0, tol_feas: 0.0,
        mu_init: 0.0, mu_max: 0.0, rho: 0.0
    }
    constrained_default_config(&!cfg)
    let ok1 = cfg.max_iter == 100
    let ok2 = approx_eq(cfg.tol_opt, 1.0e-8, 1.0e-12)
    let ok3 = approx_eq(cfg.tol_feas, 1.0e-8, 1.0e-12)
    let ok4 = approx_eq(cfg.mu_init, 1.0, 1.0e-12)
    let ok5 = approx_eq(cfg.mu_max, 1.0e8, 1.0)
    let ok6 = approx_eq(cfg.rho, 10.0, 1.0e-12)
    ok1 && ok2 && ok3 && ok4 && ok5 && ok6
}

// Test 12: Init result zeros
fn test_init_result_zeros() -> bool with Mut, Div, Panic {
    var res: ConstrainedResult = ConstrainedResult {
        x: [0.0; 64], obj_val: 0.0, constraint_viol: 0.0,
        iterations: 0, converged: false, n_dim: 0
    }
    // Set some values first to ensure init overwrites them
    res.x[0] = 99.0
    res.obj_val = 42.0
    res.iterations = 7
    res.converged = true
    constrained_init_result(&!res)
    let ok1 = approx_eq(res.x[0], 0.0, 1.0e-12)
    let ok2 = approx_eq(res.obj_val, 0.0, 1.0e-12)
    let ok3 = approx_eq(res.constraint_viol, 0.0, 1.0e-12)
    let ok4 = res.iterations == 0
    let ok5 = res.converged == false
    let ok6 = res.n_dim == 0
    ok1 && ok2 && ok3 && ok4 && ok5 && ok6
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== Constrained Optimization Test Suite ===")
    println("")

    var pass = 0
    var fail = 0

    // Test 1
    print("Test  1: L-BFGS on quadratic (x*=origin) ... ")
    if test_lbfgs_quadratic() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 2
    print("Test  2: L-BFGS on Rosenbrock (x*~(1,1)) ... ")
    if test_lbfgs_rosenbrock() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 3
    print("Test  3: L-BFGS converged flag (quadratic) ... ")
    if test_lbfgs_converged_flag() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 4
    print("Test  4: box_project clamp correctness ... ")
    if test_box_project() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 5
    print("Test  5: Projected gradient box-constrained ... ")
    if test_projected_gradient_box() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 6
    print("Test  6: Penalty method equality constraint ... ")
    if test_penalty_equality() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 7
    print("Test  7: Augmented Lagrangian equality ... ")
    if test_auglag_equality() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 8
    print("Test  8: Barrier on inequality (x*~(1,1)) ... ")
    if test_barrier_inequality() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 9
    print("Test  9: KKT violation zero at optimum ... ")
    if test_kkt_zero_at_optimum() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 10
    print("Test 10: Armijo search valid step ... ")
    if test_armijo_valid_step() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 11
    print("Test 11: Default config values ... ")
    if test_default_config() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 12
    print("Test 12: Init result zeros ... ")
    if test_init_result_zeros() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    println("")
    print("Passed: "); println(pass as string)
    print("Failed: "); println(fail as string)
    println("")
    if fail == 0 {
        println("ALL 12 TESTS PASSED")
        return 0
    } else {
        println("SOME TESTS FAILED")
        return 1
    }
}
