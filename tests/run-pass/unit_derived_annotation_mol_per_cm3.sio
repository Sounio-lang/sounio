//@ run-pass
//@ expect-stdout: derived annotation: PASS
//@ description: KL-13b — bare derived unit annotations (mol/cm3) parse and bind.

fn main() -> i32 with IO, Mut, Div, Panic {
    let n: mol = 0.0000081
    let v: cm3 = 1.0
    let c: mol/cm3 = n / v
    let t: K = 1500.0
    // Additive mismatch must still refuse (dimension retained).
    // Binding the concentration alone is the green witness.
    if c > 0.0 {
        if t > 0.0 {
            print("derived annotation: PASS\n")
        }
    }
    return 0
}
