//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v39 smoke for solver/proof-checker SOTA alignment receipt

use theorem::portfolio::*

fn main() -> i64 {
    let alignment_fp = solver_portfolio_v39_sota_alignment_fingerprint(
        53646245, 423305090, 620031252,
        258927862, 438043475, 46718256,
        389121447, 731723710, 5, 4, 31)
    if alignment_fp != 74298281 { return 1 }

    let audit_fp = solver_portfolio_v39_sota_alignment_audit_fingerprint(
        alignment_fp, 53646245, 423305090, 620031252,
        258927862, 438043475, 46718256,
        389121447, 731723710, 31)
    if audit_fp != 963677367 { return 2 }

    let manifest_fp = solver_portfolio_v39_sota_alignment_bundle_fingerprint(
        alignment_fp, audit_fp)
    if manifest_fp != 409028717 { return 3 }

    let result_fp = solver_portfolio_v39_result_coverage_fingerprint(
        39, 43, 10, 31, 1, 1, manifest_fp)
    if result_fp != 806296867 { return 4 }

    let family_fp = solver_portfolio_v39_checker_family_coverage_fingerprint(
        39, 43, 6, 3, 2, 2, 29, 1, manifest_fp)
    if family_fp != 933171094 { return 5 }

    let acceptance_fp = solver_portfolio_v39_acceptance_receipt_fingerprint(
        39, manifest_fp, result_fp)
    if acceptance_fp != 216209469 { return 6 }

    let audit_receipt_fp = solver_portfolio_v39_audit_receipt_fingerprint(
        39, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 832122075 { return 7 }

    let readiness_fp = solver_portfolio_v39_readiness_fingerprint(
        39, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 812428526 { return 8 }

    return 0
}
