//@ run-pass
//@ requires: madaros

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 with Panic {
    let permit = Permit { id: 43 }
    let selector = 0
    let result = match selector {
        0 => spend(permit)
        _ => 0
    }
    assert(result == 43)
    0
}
