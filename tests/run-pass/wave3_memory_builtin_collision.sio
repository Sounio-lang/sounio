//@ run-pass
//@ requires: madaros
//@ expect-stdout: MEMORY_BUILTIN_BINDING_OK
use tests::fixtures::wave3_memory_builtin_collision::codec::{read_i64, write_i64, read_f64, write_f64};
use tests::fixtures::wave3_memory_builtin_collision::owner::{memory_sum};
use tests::fixtures::wave3_memory_builtin_collision::private::{private_memory_named_call};
fn main() -> i32 with IO, Alloc, Mut {
    if memory_sum() != 49 { return 1 }
    let bytes: [u8; 1] = [0]
    if read_i64(&bytes, 2, 3) != 705 { return 2 }
    if write_i64(&bytes, 2, 3, 4) != 809 { return 3 }
    if read_f64(&bytes, 0, 0) != 3.25 { return 4 }
    if write_f64(&bytes, 0, 1.0, 0) != 900 { return 5 }
    if private_memory_named_call() != 6 { return 6 }
    println("MEMORY_BUILTIN_BINDING_OK")
    0
}
