//@ run-pass
//@ requires: madaros
//@ expect-stdout: KNOWLEDGE_AMOUNT_VAR_OK
// The mole count of Knowledge<H2> leaves a function with its GUM variance.
// The species stays on the parameter. Kind 10 records `p.value`; kind 1 does
// not, because kind 1 means the result is the Knowledge object itself.

ontology Fuel {
    class Substance { property amount: f64 where amount >= 0.0 }
    class H2 subclass_of Substance
}

var FARADAY: f64 = 96485.3321
var E_CELL: f64 = 0.65

fn moles(h: Knowledge<H2>) -> f64 with Epistemic, Mut, Div {
    let n: f64 = h.value
    n
}

fn moles_bare(h: Knowledge<H2>) -> f64 with Epistemic, Mut, Div {
    h.value
}

fn moles_second(x: f64, h: Knowledge<H2>) -> f64 with Epistemic, Mut, Div {
    let n: f64 = h.value
    n
}

fn joules(h: Knowledge<H2>) -> f64 with Epistemic, Mut, Div {
    let n: f64 = h.value
    n * 2.0 * FARADAY * E_CELL / 1.0e6
}

fn joules_second(x: f64, h: Knowledge<H2>) -> f64 with Epistemic, Mut, Div {
    let n: f64 = h.value
    n * 2.0 * FARADAY * E_CELL / 1.0e6
}

var U_VOLT: f64 = 0.01

fn joules_both(h: Knowledge<H2>, e: Knowledge<f64>) -> f64 with Epistemic, Mut, Div {
    let n: f64 = h.value
    let volts: f64 = e.value
    n * 2.0 * FARADAY * volts / 1.0e6
}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let tagged: H2 = 210.826
    let k: Knowledge<H2> = measure(tagged, uncertainty: 2.10826)
    let scale = 0.12543093173
    let n = moles(k)
    let mj = n * scale
    let v = variance_of(mj)
    let sigma = 2.10826 * scale
    let expect_v = sigma * sigma
    let n_bare = moles_bare(k)
    let v_bare = variance_of(n_bare)
    let n_second = moles_second(1.0, k)
    let v_second = variance_of(n_second)
    let expect_n = 2.10826 * 2.10826
    let mj_fn = joules(k)
    let v_fn = variance_of(mj_fn)
    let mj_second = joules_second(1.0, k)
    let v_fn2 = variance_of(mj_second)
    let volts: Knowledge<f64> = measure(0.65, uncertainty: 0.01)
    let mj_both = joules_both(k, volts)
    let var_both = variance_of(mj_both)
    let c_ne = 2.0 * FARADAY / 1.0e6
    let term_n = (c_ne * 0.65) * (c_ne * 0.65) * (2.10826 * 2.10826)
    let term_v = (c_ne * 210.826) * (c_ne * 210.826) * (0.01 * 0.01)
    let expect_both = term_n + term_v

    print("mol ")
    print_f64(n)
    print(" var_mj ")
    print_f64(v)
    print(" var_fn ")
    print_f64(v_fn)
    print(" var_both ")
    print_f64(var_both)
    print(" expect_both ")
    print_f64(expect_both)
    print("\n")

    if near(n, 210.826, 0.001) && near(n_bare, 210.826, 0.001) && near(n_second, 210.826, 0.001) && near(mj_fn, 26.444102, 0.001) && near(mj_second, 26.444102, 0.001) && near(v, expect_v, 0.00001) && near(v_bare, expect_n, 0.0001) && near(v_second, expect_n, 0.0001) && near(v_fn, expect_v, 0.00001) && near(v_fn2, expect_v, 0.00001) && v > 0.05 && v_fn > 0.05 && near(var_both, expect_both, 0.0001) && var_both > v_fn {
        println("KNOWLEDGE_AMOUNT_VAR_OK")
        return 0
    }
    println("KNOWLEDGE_AMOUNT_VAR_FAIL")
    1
}
