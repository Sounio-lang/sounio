//@ run-pass
//@ expect-stdout: escaping float closure: PASS
fn make_scale(scale: f64) -> fn(f64) -> f64 with Mut, Panic, Div {
    |x: f64| -> f64 { x * scale + 1.0 }
}
fn main() -> i32 with IO, Mut, Panic, Div {
    let first = make_scale(2.5)
    let second = make_scale(3.0)
    assert(first(4.0) == 11.0)
    assert(second(2.0) == 7.0)
    assert(first(2.0) == 6.0)
    print("escaping float closure: PASS\n")
    0
}
