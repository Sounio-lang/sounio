//@ run-pass
//@ requires: madaros
// heap_alloc returns a payload address, not a handle slot. (*p).field must
// store into that address. The old lowering scalar-loaded word 0 (zero) and
// resolved handle 0, which is the gen3 SIGSEGV in checker_init_in_place.

struct Slot {
    a: i64,
    b: i64,
}

fn set_a(p: *mut Slot, v: i64) with Mut, Panic, Div {
    (*p).a = v
}

fn get_a(p: *mut Slot) -> i64 with Mut, Panic, Div {
    (*p).a
}

fn main() -> i64 with Mut, Panic, Div, Alloc {
    let p = heap_alloc(4096) as *mut Slot
    if (p as i64) == 0 { return 1 }
    set_a(p, 11)
    (*p).b = 22
    if get_a(p) != 11 { return 2 }
    if (*p).b != 22 { return 3 }
    heap_free(p as *mut u8)
    0
}
