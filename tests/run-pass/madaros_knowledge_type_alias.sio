//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: ALIAS 6.000000 0.250000
//@ expect-stdout-contains: ALIAS2 5.000000 0.050000
//@ expect-stdout-contains: PARAM 0.666667
//@ expect-stdout-contains: PRINT 6.000000
//
// `type Alias = Knowledge[f64]` and an alias of an alias must be classified as
// Knowledge by the lowerer: as a return type (arithmetic on the call result,
// `.variance`, println), as a parameter, and as a let annotation. Before, the
// lowerer saw an opaque named type and refused println as an unresolved scalar
// kind.

type Dose = Knowledge[f64];
type Dose2 = Dose;

fn product() -> Dose with Panic {
    let a: Knowledge[f64] = measure(2.0, uncertainty: 0.1)
    let b: Knowledge[f64] = measure(3.0, uncertainty: 0.2)
    a * b
}

fn total() -> Dose2 with Panic {
    let a: Knowledge[f64] = measure(2.0, uncertainty: 0.1)
    let b: Knowledge[f64] = measure(3.0, uncertainty: 0.2)
    a + b
}

fn ratio(x: Dose, y: Dose2) -> f64 with Epistemic, Panic {
    let q = x.value / y.value
    q
}

fn main() -> i64 with IO, Epistemic, Panic {
    let p = product()
    print("ALIAS "); print_f64(p.value); print(" "); print_f64(p.variance); print("\n")
    let t = total()
    print("ALIAS2 "); print_f64(t.value); print(" "); print_f64(t.variance); print("\n")
    let m: Dose = measure(2.0, uncertainty: 0.0)
    let n: Dose2 = measure(3.0, uncertainty: 0.0)
    print("PARAM "); print_f64(ratio(m, n)); print("\n")
    print("PRINT "); println(product().value)
    0
}
