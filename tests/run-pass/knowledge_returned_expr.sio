//@ run-pass
//@ requires: madaros
//@ expect-stdout: LEAF_RELOWER_OK
// A returned Knowledge field is the expression that built it, re-lowered
// at the call. A product of three amounts and a quotient both cross the
// function. The two-factor product still does.
//
// Oracle class: sounio_closed_form_twin (ADR-009).
// The clock is central differences of the scalar functions. It does not
// call variance_of.

ontology Lab {
    class Thing { property amount: f64 where amount >= 0.0 }
    class Feed subclass_of Thing
    class Whole subclass_of Thing
    disjoint Feed, Whole
}

struct Out {
    whole: Knowledge[Whole, ValidUntil("2026-12-31"), epsilon < 0.05, Derived]
}

fn prod3(a: Knowledge<Feed>, b: Knowledge<f64>, c: Knowledge<f64>) -> Out with Epistemic, Mut, Div {
    let x: f64 = a.value
    let y: f64 = b.value
    let z: f64 = c.value
    let p: f64 = x * y * z
    let w: Whole = p
    Out {
        whole: Knowledge { value: w, epsilon: 0.01, validity: "2027-06-30", provenance: "cell" }
    }
}

fn quot(a: Knowledge<Feed>, b: Knowledge<f64>) -> Out with Epistemic, Mut, Div {
    let x: f64 = a.value
    let y: f64 = b.value
    let q: f64 = x / y
    let w: Whole = q
    Out {
        whole: Knowledge { value: w, epsilon: 0.01, validity: "2027-06-30", provenance: "cell" }
    }
}

fn prod2(a: Knowledge<Feed>, b: Knowledge<f64>) -> Out with Epistemic, Mut, Div {
    let x: f64 = a.value
    let y: f64 = b.value
    let p: f64 = x * y
    let w: Whole = p
    Out {
        whole: Knowledge { value: w, epsilon: 0.01, validity: "2027-06-30", provenance: "cell" }
    }
}

fn scalar3(x: f64, y: f64, z: f64) -> f64 { x * y * z }
fn scalarq(x: f64, y: f64) -> f64 { x / y }
fn scalar2(x: f64, y: f64) -> f64 { x * y }

fn gum3(x: f64, y: f64, z: f64, ux: f64, uy: f64, uz: f64, rho: f64) -> f64 {
    let h = 0.001
    let dx = (scalar3(x + h, y, z) - scalar3(x - h, y, z)) / (2.0 * h)
    let dy = (scalar3(x, y + h, z) - scalar3(x, y - h, z)) / (2.0 * h)
    let dz = (scalar3(x, y, z + h) - scalar3(x, y, z - h)) / (2.0 * h)
    let diag = dx * dx * ux * ux + dy * dy * uy * uy + dz * dz * uz * uz
    let cross = 2.0 * dx * dy * ux * uy * rho
    diag + cross
}

fn gumq(x: f64, y: f64, ux: f64, uy: f64, rho: f64) -> f64 {
    let h = 0.001
    let dx = (scalarq(x + h, y) - scalarq(x - h, y)) / (2.0 * h)
    let dy = (scalarq(x, y + h) - scalarq(x, y - h)) / (2.0 * h)
    let diag = dx * dx * ux * ux + dy * dy * uy * uy
    let cross = 2.0 * dx * dy * ux * uy * rho
    diag + cross
}

fn gum2(x: f64, y: f64, ux: f64, uy: f64, rho: f64) -> f64 {
    let h = 0.001
    let dx = (scalar2(x + h, y) - scalar2(x - h, y)) / (2.0 * h)
    let dy = (scalar2(x, y + h) - scalar2(x, y - h)) / (2.0 * h)
    let diag = dx * dx * ux * ux + dy * dy * uy * uy
    let cross = 2.0 * dx * dy * ux * uy * rho
    diag + cross
}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let a0: f64 = 10.0
    let b0: f64 = 2.0
    let c0: f64 = 3.0
    let a: Knowledge<Feed> = measure(a0, uncertainty: 0.1)
    let b: Knowledge<f64> = measure(b0, uncertainty: 0.2)
    let c: Knowledge<f64> = measure(c0, uncertainty: 0.3)
    let named = prod3(a, b, c)
    let ratio = quot(a, b)
    let two = prod2(a, b)
    let direct = variance_of(prod3(a, b, c).whole.value)
    let v3 = variance_of(named.whole.value)
    let vq = variance_of(ratio.whole.value)
    let v2 = variance_of(two.whole.value)
    let c3 = gum3(10.0, 2.0, 3.0, 0.1, 0.2, 0.3, 0.0)
    let cq = gumq(10.0, 2.0, 0.1, 0.2, 0.0)
    let c2 = gum2(10.0, 2.0, 0.1, 0.2, 0.0)
    let xa: f64 = a.value
    let yb: f64 = b.value
    let _rho = correlate(xa, yb, 1.0)
    let v3r = variance_of(named.whole.value)
    let v2r = variance_of(two.whole.value)
    let c3r = gum3(10.0, 2.0, 3.0, 0.1, 0.2, 0.3, 1.0)
    let c2r = gum2(10.0, 2.0, 0.1, 0.2, 1.0)
    print("three ")
    print_f64(v3)
    print(" clock ")
    print_f64(c3)
    print(" quot ")
    print_f64(vq)
    print(" clock ")
    print_f64(cq)
    print(" two ")
    print_f64(v2)
    print(" direct ")
    print_f64(direct)
    print(" three_rho ")
    print_f64(v3r)
    print(" clockr ")
    print_f64(c3r)
    print("\n")
    if near(v3, c3, 0.001) && near(vq, cq, 0.001) && near(v2, c2, 0.001) && near(direct, c3, 0.001) && near(v3r, c3r, 0.001) && near(v2r, c2r, 0.001) && v3 > 70.0 && vq > 0.2 && vq < 1.0 && v3r > v3 {
        println("LEAF_RELOWER_OK")
        return 0
    }
    println("LEAF_RELOWER_FAIL")
    1
}
