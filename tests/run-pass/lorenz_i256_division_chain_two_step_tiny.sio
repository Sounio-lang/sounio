//@ run-pass
//@ known-failure: source-level i256 Lorenz division-chain two-step tiny case: main returns 2. Not a segfault/139
//@ requires: madaros
//@ description: Two-step Lorenz i256 quotient/remainder witness chain without source-level i256 division

fn chain_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn lorenz_i256_step2_certificate_fingerprint(start_x: i64, start_y: i64, start_z: i64,
                                             dy_scaled_q: i64, dy_scaled_r: i64,
                                             xy_scaled_q: i64, xy_scaled_r: i64,
                                             beta_q: i64, beta_r: i64,
                                             x_inc_q: i64, x_inc_r: i64,
                                             y_inc_q: i64, y_inc_r: i64,
                                             z_drop_q: i64, z_drop_r: i64,
                                             final_x: i64, final_y: i64, final_z: i64,
                                             all_divisions_ok: i64) -> i64 with Mod {
    if start_x != 4294967296 { return 0 - 1 }
    if start_y != 5411658768 { return 0 - 1 }
    if start_z != 4223384510 { return 0 - 1 }
    if dy_scaled_q != 116035699778 { return 0 - 1 }
    if dy_scaled_r != 0 { return 0 - 1 }
    if xy_scaled_q != 5411658768 { return 0 - 1 }
    if xy_scaled_r != 0 { return 0 - 1 }
    if beta_q != 11262358693 { return 0 - 1 }
    if beta_r != 1 { return 0 - 1 }
    if x_inc_q != 111669144 { return 0 - 1 }
    if x_inc_r != 3023657216 { return 0 - 1 }
    if y_inc_q != 1106240385 { return 0 - 1 }
    if y_inc_r != 1604599760 { return 0 - 1 }
    if z_drop_q != 58506997 { return 0 - 1 }
    if z_drop_r != 4047004488 { return 0 - 1 }
    if final_x != 4406636440 { return 0 - 1 }
    if final_y != 6517899153 { return 0 - 1 }
    if final_z != 4164877513 { return 0 - 1 }
    if all_divisions_ok != 1 { return 0 - 1 }

    var fp: i64 = 157
    fp = chain_mix(fp, start_x, 1361)
    fp = chain_mix(fp, start_y, 1361)
    fp = chain_mix(fp, start_z, 1361)
    fp = chain_mix(fp, dy_scaled_q, 1361)
    fp = chain_mix(fp, dy_scaled_r, 1361)
    fp = chain_mix(fp, xy_scaled_q, 1361)
    fp = chain_mix(fp, xy_scaled_r, 1361)
    fp = chain_mix(fp, beta_q, 1361)
    fp = chain_mix(fp, beta_r, 1361)
    fp = chain_mix(fp, x_inc_q, 1361)
    fp = chain_mix(fp, x_inc_r, 1361)
    fp = chain_mix(fp, y_inc_q, 1361)
    fp = chain_mix(fp, y_inc_r, 1361)
    fp = chain_mix(fp, z_drop_q, 1361)
    fp = chain_mix(fp, z_drop_r, 1361)
    fp = chain_mix(fp, final_x, 1361)
    fp = chain_mix(fp, final_y, 1361)
    fp = chain_mix(fp, final_z, 1361)
    fp = chain_mix(fp, all_divisions_ok, 1361)
    return fp
}

fn lorenz_i256_two_step_chain_fingerprint(step_count: i64,
                                           step1_certificate_fp: i64,
                                           step2_certificate_fp: i64,
                                           final_x: i64, final_y: i64,
                                           final_z: i64) -> i64 with Mod {
    if step_count != 2 { return 0 - 1 }
    if step1_certificate_fp != 510854875 { return 0 - 1 }
    if step2_certificate_fp != 899209716 { return 0 - 1 }
    if final_x != 4406636440 { return 0 - 1 }
    if final_y != 6517899153 { return 0 - 1 }
    if final_z != 4164877513 { return 0 - 1 }

    var fp: i64 = 167
    fp = chain_mix(fp, step_count, 1399)
    fp = chain_mix(fp, step1_certificate_fp, 1399)
    fp = chain_mix(fp, step2_certificate_fp, 1399)
    fp = chain_mix(fp, final_x, 1399)
    fp = chain_mix(fp, final_y, 1399)
    fp = chain_mix(fp, final_z, 1399)
    return fp
}

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256

    let x1: i256 = scale
    let y1: i256 = 5411658768 as i256
    let z1: i256 = 4223384510 as i256
    let rho: i256 = 28 as i256

    let dx_num: i256 = (10 as i256) * (y1 - x1)
    let rho_scale_minus_z: i256 = (rho * scale) - z1
    let dy_num: i256 = x1 * rho_scale_minus_z
    let xy_num: i256 = x1 * y1
    let beta_num_z: i256 = (8 as i256) * z1

    let dy_scaled_q: i256 = 116035699778 as i256
    let xy_scaled_q: i256 = 5411658768 as i256
    let beta_q: i256 = 11262358693 as i256
    let beta_r: i256 = 1 as i256
    let x_inc_q: i256 = 111669144 as i256
    let x_inc_r: i256 = 3023657216 as i256
    let y_inc_q: i256 = 1106240385 as i256
    let y_inc_r: i256 = 1604599760 as i256
    let z_drop_q: i256 = 58506997 as i256
    let z_drop_r: i256 = 4047004488 as i256

    let dy: i256 = dy_scaled_q - y1
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    let dy_scaled_ok = check_div_witness_i256(dy_num, scale, dy_scaled_q, 0 as i256)
    let xy_scaled_ok = check_div_witness_i256(xy_num, scale, xy_scaled_q, 0 as i256)
    let beta_ok = check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r)
    let x_inc_ok = check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r)
    let y_inc_ok = check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r)
    let z_drop_ok = check_div_witness_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r)

    var all_divisions_ok: i64 = 0
    if dy_scaled_ok == 1 {
        if xy_scaled_ok == 1 {
            if beta_ok == 1 {
                if x_inc_ok == 1 {
                    if y_inc_ok == 1 {
                        if z_drop_ok == 1 { all_divisions_ok = 1 }
                    }
                }
            }
        }
    }

    let x2: i256 = x1 + x_inc_q
    let y2: i256 = y1 + y_inc_q
    let z2: i256 = z1 - z_drop_q

    let step2_fp = lorenz_i256_step2_certificate_fingerprint(
        4294967296, 5411658768, 4223384510,
        116035699778, 0, 5411658768, 0,
        11262358693, 1, 111669144, 3023657216,
        1106240385, 1604599760, 58506997, 4047004488,
        4406636440, 6517899153, 4164877513, all_divisions_ok)
    let chain_fp = lorenz_i256_two_step_chain_fingerprint(
        2, 510854875, step2_fp, 4406636440, 6517899153, 4164877513)

    if all_divisions_ok != 1 { return 1 }
    if dx_num != 11166914720 as i256 { return 2 }
    if dy != 110624041010 as i256 { return 3 }
    if dz_drop_num != 5850699925 as i256 { return 4 }
    if x2 != 4406636440 as i256 { return 5 }
    if y2 != 6517899153 as i256 { return 6 }
    if z2 != 4164877513 as i256 { return 7 }
    if step2_fp != 899209716 { return 8 }
    if chain_fp != 335080767 { return 9 }

    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, 3 as i256) != 0 { return 10 }
    if lorenz_i256_step2_certificate_fingerprint(
        4294967296, 5411658768, 4223384510,
        116035699778, 0, 5411658768, 0,
        11262358693, 1, 111669144, 3023657216,
        1106240385, 1604599760, 58506997, 4047004487,
        4406636440, 6517899153, 4164877513, all_divisions_ok) != (0 - 1) { return 11 }
    if lorenz_i256_two_step_chain_fingerprint(
        2, 510854875, step2_fp, 4406636440, 6517899154, 4164877513) != (0 - 1) { return 12 }

    return 0
}
