//@ run-pass
//@ expect-stdout: ALL PASS
//
// End-to-end acceptance for the trajectory bridge of dialogue/bracket.sio:
// the O-CSSM functor F evaluated under both bracketings, through the full
// pipeline (flat-array Trajectory → payload projection → octonion product
// → associator). Ground truth comes from the algebra: a trajectory whose
// turns project to (e1,e2,e4) must show sensitivity ‖[e1,e2,e4]‖² = 4, and
// (e1,e2,e3) — a Fano triple — must show 0.
//
//   W1  non-Fano trajectory: sensitivity = 4 through the pipeline
//   W2  the two functor evaluations differ (left ≠ right)
//   W3  Fano trajectory: sensitivity = 0 (grouping-invariant)
//   W4  turn-projection exactness: traj_turn_oct reproduces the basis

use dialogue::bracket::{
    traj_turn_oct, traj_fold3_left, traj_fold3_right,
    traj_bracket_sensitivity3,
}
use dialogue::trajectory::{
    Trajectory, traj_empty, traj_push, traj_set_payload,
}

fn approx(x: f64, y: f64) -> bool {
    let d = if x > y { x - y } else { y - x }
    d < 0.0001
}

// Push a turn whose projection out[k] = p[k] − p[k+8] equals basis element
// e_idx: set payload cell idx to 1.0, all others 0.
fn push_basis_turn(t: &Trajectory, speaker: i64, idx: i64) with Mut {
    let i: i64 = traj_push(t, speaker, 0, 0, 0, 16)
    traj_set_payload(t, i - 1, idx, 1.0)
}

fn main() with Mut, Div, Panic, NonAssoc {
    var ok = true

    // --- W4 first: projection exactness on a single turn ---
    var t0: Trajectory = traj_empty()
    push_basis_turn(&!t0, 0, 1)
    var v: [f64; 8] = [0.0; 8]
    traj_turn_oct(&t0, 0, &!v)
    if approx(v[1], 1.0) && approx(v[0], 0.0) {
        print("W4 projection e1 exact: PASS")
    } else { print("W4 projection: FAIL"); ok = false }

    // --- W1/W2: non-Fano trajectory (e1, e2, e4) ---
    var t1: Trajectory = traj_empty()
    push_basis_turn(&!t1, 0, 1)
    push_basis_turn(&!t1, 1, 2)
    push_basis_turn(&!t1, 0, 4)
    let s1: f64 = traj_bracket_sensitivity3(&t1)
    if approx(s1, 4.0) { print("W1 trajectory sensitivity=4: PASS") }
    else { print("W1 trajectory sensitivity: FAIL"); ok = false }

    var fl: [f64; 8] = [0.0; 8]
    var fr: [f64; 8] = [0.0; 8]
    traj_fold3_left(&t1, &!fl)
    traj_fold3_right(&t1, &!fr)
    var diff: f64 = 0.0
    var i: i64 = 0
    while i < 8 {
        let d: f64 = if fl[i] > fr[i] { fl[i] - fr[i] } else { fr[i] - fl[i] }
        if d > diff { diff = d }
        i = i + 1
    }
    if diff > 1.9 { print("W2 F-left ≠ F-right: PASS") }
    else { print("W2 functor bracket difference: FAIL"); ok = false }

    // --- W3: Fano trajectory (e1, e2, e3) is grouping-invariant ---
    var t2: Trajectory = traj_empty()
    push_basis_turn(&!t2, 0, 1)
    push_basis_turn(&!t2, 1, 2)
    push_basis_turn(&!t2, 0, 3)
    let s2: f64 = traj_bracket_sensitivity3(&t2)
    if approx(s2, 0.0) { print("W3 fano trajectory sensitivity=0: PASS") }
    else { print("W3 fano trajectory: FAIL"); ok = false }

    if ok { print("ALL PASS") } else { print("SOME FAIL") }
}
