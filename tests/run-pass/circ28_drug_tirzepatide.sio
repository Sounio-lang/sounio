//@ run-pass
//@ timeout: 180
//@ expect-stdout-contains: CIRC28_DRUG_TIRZEPATIDE_PASS
//
// Tirzepatide on the circ28 kernel (stdlib/darwin_pbpk/circ28_drug_tirzepatide.sio): the same
// plasma-confined albumin-bound peptide model as semaglutide (engine pep_* in
// circ28_drug_semaglutide.sio), tirzepatide numbers. V_ss ~6.9 L, below the 8.6 L floor of
// the previous kernel. Parameter table, sources, absolute/apparent status of every
// clearance and volume: header of the module.
//
// FITTED / SET TO AN OBSERVABLE: only the exchange, sum of organ ps = Q (Schneck & Urva 2024
// Table 3, 0.126 L/h/70 kg, scaled to 73 kg). CL, F, ka are population estimates taken as
// inputs. NOT FITTED: V_ss (a prediction; no scalar on the Kp), the distribution half-life.
//
// LINEAGE OF THE DATA: the Coskun 2018 single/multiple ascending dose study (NCT02759107,
// healthy subjects and T2DM) is study 1 of the pooled dataset behind Schneck & Urva 2024
// (their Table 1 lists the 0.25-8 mg single doses and 4 weeks of weekly dosing). The Coskun
// rows are therefore CONSISTENCY checks of the population estimates scaled to 73 kg, not
// independent tests. Independent of any fit: V_ss, the split between plasma and
// interstitium, the shape of the profile (Cmax, tmax, accumulation) and the time to steady
// state. The 5 mg cohort body weight is not in my hands (Table 1 of Coskun was not read for
// weight): the model is the 73 kg man, so a cohort weight different from 73 kg is a
// source of discrepancy that I cannot quantify here.
//
// CRITERION (as in the semaglutide test): geometric mean with CV%: |z| <= 2 with
// z = ln(pred/obs)/sqrt(ln(1 + CV^2)); a row with a range: the prediction lies inside it;
// a population estimate without CV: stated fold. A row that fails is NOT tuned: its measured
// discrepancy is asserted inside a band and explained. Every band is written with its row.
//
// DISCLOSURE OF WHAT I SAW BEFORE WRITING THIS HEADER. No tirzepatide run existed when
// this header was written. What I had: (a) the semaglutide test and module results
// (same engine, other numbers); (b) hand arithmetic from the module's formulas, approximate:
//   V_plasma 3.000 L; V_ss = 3 + 10.3 (fu + (1 - fu) 0.37) = 6.88 L (the 10.3 L is
//   the semaglutide run backed out: 3.84 / 0.3723, so the figure is not independent of that run);
//   AUC identity F D / CL = 0.8 x 5 / 0.03403 = 117.5 mg h/L; CL/F = 0.0425 L/h;
//   two-compartment terminal rate of the kernel (V1 3.0, V2 3.88, Q 0.1303, CL 0.03403):
//   beta ~0.00455 /h, t1/2 ~152 h, Vz/F = CL/(F beta) ~9.4 L; the same for the Schneck volumes
//   (Vc 2.58, Vp 4.15) gives beta 0.00458, t1/2 151 h;
//   one-compartment-with-V_ss estimate of a single 5 mg dose: Cmax ~430 ng/mL near 60 h
//   (the two-compartment kernel will be a few per cent higher in plasma and peak earlier);
//   four-dose accumulation without absorption lag 1 - r^4 / (1 - r) = 1.56, r = exp(-beta tau).
// (c) A planning note from the previous context listed Vz/F as an expected FAIL. The hand
//   arithmetic above, done before any run, says z ~ -0.7 (pass), so the row is registered
//   as expected PASS; the note's reasoning is not recoverable and is not relied on.
// (d) the observed values (Coskun Table 2, label, Schneck Table 3) because they are the sources.
// Nothing of the kernel's own output for tirzepatide had been seen.
//
// PRE-REGISTERED ROWS  (expectation; pass criterion; band)
//  Structure
//   S1  plasma volume bp x V_blood = 3.000 L (Nordell Vp 3.0 L)                 identity 1e-3
//   S2  V_ss primary ~6.9 L vs Schneck (Vc + Vp) 6.45 x 73/70 = 6.73 L           pass, fold 1.15, ratio band [0.97, 1.08]
//   S3  V_ss primary vs Nordell Vp (1 + R) + fu (VE - R Vp) = 7.30 L             pass, fold 1.10, band [0.90, 1.00]
//   S4  V_ss with r from Nordell volumes (~5.9 L) vs 6.73                        pass, fold 1.15, band [0.82, 0.95]
//   S5  V_ss with Rodgers-Rowland albumin ratios (~8.1 L) vs 6.73                FAIL, fold 1.15, band [1.15, 1.30]
//   S6  formula molecular weight vs the 4810.52 Da printed by Coskun              pass, fold 1.01
//   S7  label apparent CL 0.061 reconstructed from the ABSOLUTE Schneck CL:
//       0.0329 (90/70)^0.8 / (0.8 (1 - 0.181)) = 0.0614                         pass, fold 1.05 (a consistency of units,
//                                                                              not a validation of the kernel)
//  Identities (kernel scheme, exact; single dose 5 mg, grid 1 h to 336 h then 4 h to 2900 h)
//   I1  mass balance, relative < 1e-6;  I2 input = F D (1 - exp(-ka T)) to 1e-9
//   I3  AUC_inf (venous plasma, extrapolated) = F D / CL within 2e-3 (identity, NOT validation;
//       CL renal is zero here, so no arterial/venous residual)
//   I4  step halving: Cmax dt 1 h vs dt 0.5 h within 2e-3; SS AUC with dt 2 h after 336 h vs
//       dt 1 h within 1e-3 (justification of the coarse steps)
//  Kernel against the Schneck two-compartment model (analytic, same CL, Q, F, ka, 73 kg)
//   K1 Cmax within 15 % (band [0.90, 1.15]); K2 tmax within 15 % (band [0.85, 1.15]);
//   K3 concentrations at 24, 72, 168, 336, 672 h within 20 % (band [0.8, 1.2]);
//   K4 terminal t1/2 within 5 % of ln2/beta (band [0.95, 1.05]).
//  Observations  Coskun 2018 SAD 5 mg, healthy, n = 5 (Table 2), geometric mean (CV%)
//   O1  Cmax 397 ng/mL (23): expected pass, z ~ +0.5, band z [-1.0, 1.5]
//   O2  Tmax 24 h (24-72) and label 8-72 h: kernel tmax inside [24, 72], band [40, 72] (hand estimate ~55-62 h);
//       the cohort MEDIAN is 24 h, the sampling grid of the table is in 24 h steps; reported as a diagnostic
//   O3  AUC0-inf 90.5 mg h/L (15): expected PASS, marginal, z ~ +1.76, band z [1.5, 2.0] (identity F D/CL against the datum)
//   O4  CL/F 0.0553 L/h (15): expected PASS, marginal, z ~ -1.76, band [-2.0, -1.5]; the same datum as O3 (5 mg / AUC)
//   O5  t1/2 123 h (range 99.9-147): kernel ~152 h. Fold 1.25 vs 123: expected PASS marginal (ratio ~1.24), band [1.15, 1.30];
//       the range row [99.9, 147]: expected FAIL, band [147, 165]. Diagnosis: model slope over 336-840 h vs
//       the slope over 168-504 h (printed, no criterion)
//   O6  Vz/F 9.80 L (7): expected PASS z ~ -0.7, band z [-1.5, 0.5]. The pass is a CANCELLATION: CL/F is 23 % low and
//       t1/2 24 % high, Vz/F = (CL/F) t1/2 / ln 2
//   D1  diagnostic with F = 0.8 (1 - 0.181) = 0.655 (Schneck's between-study effect; whether the Coskun cohort carries
//       it is not derivable from the text I read; NOT a fit, F is not adjusted anywhere else): AUC z ~ +0.4 pass,
//       CL/F z ~ -0.4 pass, Vz/F z ~ +2.2 FAIL
//   O7  accumulation after four weekly doses (Coskun: "average accumulation ... 1.58"; the definition is not given,
//       here AUC_tau of dose 4 / AUC_tau of dose 1): fold 1.25, expected pass, ratio band [0.90, 1.20]; the
//       steady-state ratio 1/(1 - exp(-beta tau)) is printed
//   O8  label: steady state after 4 weeks of weekly dosing: trough before dose k reaches 95 % of the final trough at k = 4 or 5
//  Steady state, 5 mg weekly x 12 (73 kg healthy): AUC_tau = F D / CL (identity); Cavg, Cmax, trough/peak printed as predictions.
//  Budget: u(AUC)/AUC equals sqrt(uF^2 + uCL^2) within 2e-3; Cmax budgets printed.
//
// AFTER THE RUN (written after seeing the output, recorded for honesty). Every pre-registered
// expectation and band held except one band and two pieces of my hand arithmetic:
//  * O2 tmax: the kernel gives 33.3 h (Schneck two-compartment model 29.5 h, K2 ratio 1.13), inside the
//    observed range [24, 72] (PASS) but OUTSIDE my registered band [40, 72]. The hand estimate (~55-62 h)
//    assumed quasi-equilibrium with the whole body (one compartment, V_ss); that needs alpha >> ka, and
//    here alpha/ka = 0.0906/0.0373 = 2.4, so the plasma pool peaks well before the body average. The
//    band below is therefore the measured one [28, 40] (asserted discrepancy, not tuning of the model).
//    Added after the run: the profile is flat (conc/Cmax 0.971 at 24 h, 0.965 at 48 h), so on the 24-h
//    sampling grid of Coskun's table the argmax is 24 h, the cohort median.
//  * Cmax 472 ng/mL (hand estimate 430-460): z +0.76 against 397, inside its band.
//  * O7 accumulation 1.85 (ratio 1.17 to 1.58, inside the band but near its top). My hand figure 1.56
//    used r = exp(-ln2 tau / 116.7 h) = 0.369 from Coskun's half-life instead of the kernel's
//    r = exp(-beta tau) = 0.466 (1 + r + r^2 + r^3 = 1.78 without absorption lag). 1.58 = 1/(1 - 0.369)
//    is what Coskun's t1/2 gives; the kernel's longer terminal t1/2 (152 h, equal to the Schneck model's
//    151 h within 0.7 %, K4) gives more accumulation. Same cause as O5.
//  * O5 diagnosis: the slope over 168-504 h (152.4 h) equals the slope over 336-840 h (152.5 h), so the
//    shorter NCA half-life is not an early-window effect of the model. The kernel reproduces the population
//    model (K4); the discrepancy with the cohort NCA t1/2 (123 h) and the label's "approximately 5
//    days" sits in the population parameters against this cohort, not in the PBPK structure. Its cause is
//    not established here.
//
// Marker CIRC28_DRUG_TIRZEPATIDE_PASS.

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_drug_semaglutide::*
use darwin_pbpk::circ28_drug_tirzepatide::*
use math::pure::{exp, ln}

fn st_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn st_rel(tag: string, got: f64, want: f64, tol: f64) -> i32 with IO, Mut, Div, Panic {
    let r = st_abs(got - want) / st_abs(want)
    print("  "); print(tag); print(": got "); print(got); print(" want "); print(want); print("  rel = "); print(r)
    if !(r <= tol) {
        println("  [FAIL]")
        return 1
    }
    println("")
    return 0
}

// expect: 1 must pass, 0 must fail, 2 diagnostic (band only)
fn st_row_ln(tag: string, pred: f64, obs: f64, cv: f64, expect: i32, blo: f64, bhi: f64) -> i32 with IO, Mut, Div, Panic {
    let sg = cd_sqrt(ln(1.0 + cv * cv))
    let z = ln(pred / obs) / sg
    let pass = st_abs(z) <= 2.0
    print("  "); print(tag); print(": predicted "); print(pred); print("  observed "); print(obs)
    print("  ratio "); print(pred / obs); print("  z "); print(z)
    if pass { print("  PASS") } else { print("  FAIL") }
    var bad = 0
    if z < blo || z > bhi {
        print("  [outside the asserted band]")
        bad = 1
    }
    if expect == 1 && !pass {
        print("  [expected pass]")
        bad = 1
    }
    if expect == 0 && pass {
        print("  [expected fail]")
        bad = 1
    }
    println("")
    return bad
}

fn st_row_fold(tag: string, pred: f64, obs: f64, fold: f64, expect: i32, blo: f64, bhi: f64) -> i32 with IO, Mut, Div, Panic {
    let r = pred / obs
    let pass = r <= fold && r >= 1.0 / fold
    print("  "); print(tag); print(": predicted "); print(pred); print("  observed "); print(obs); print("  ratio "); print(r)
    if pass { print("  PASS") } else { print("  FAIL") }
    var bad = 0
    if r < blo || r > bhi {
        print("  [outside the asserted band]")
        bad = 1
    }
    if expect == 1 && !pass {
        print("  [expected pass]")
        bad = 1
    }
    if expect == 0 && pass {
        print("  [expected fail]")
        bad = 1
    }
    println("")
    return bad
}

fn st_row_rng(tag: string, pred: f64, lo: f64, hi: f64, expect: i32, blo: f64, bhi: f64) -> i32 with IO, Mut, Div, Panic {
    let pass = pred >= lo && pred <= hi
    print("  "); print(tag); print(": predicted "); print(pred); print("  observed range ["); print(lo); print(", "); print(hi); print("]")
    if pass { print("  PASS") } else { print("  FAIL") }
    var bad = 0
    if pred < blo || pred > bhi {
        print("  [outside the asserted band]")
        bad = 1
    }
    if expect == 1 && !pass {
        print("  [expected pass]")
        bad = 1
    }
    if expect == 0 && pass {
        print("  [expected fail]")
        bad = 1
    }
    println("")
    return bad
}

fn st_pname(i: i32) -> string {
    if i == 0 { return "MW" }
    if i == 1 { return "Hct (bp)" }
    if i == 2 { return "fu" }
    if i == 3 { return "r_int" }
    if i == 4 { return "CL total" }
    if i == 5 { return "CL renal" }
    if i == 6 { return "F" }
    if i == 7 { return "ka" }
    return "Q (sum ps)"
}

// Single 5 mg dose, grid 1 h to 336 h then 4 h to 2900 h. m[0..11] as in the semaglutide test.
fn st_single(th: &[f64; 9], dose: f64, m: &![f64; 64], ts: &![f64; 3000], cs: &![f64; 3000], ca: &![f64; 3000]) with Mut, Div, Panic {
    var dk: [f64; 16] = [0.0; 16]
    dk[0] = dose
    var bal: [f64; 4] = [0.0; 4]
    var pk: [f64; 2] = [0.0; 2]
    let n = pep_run(th, &dk, 1, 1.0, 336.0, 4.0, 2900.0, ts, cs, ca, &!bal)
    pep_peak(&*ts, &*cs, n, 0.0, 168.0, &!pk)
    (*m)[0] = pk[0]
    (*m)[1] = pk[1]
    let lz = pep_lambda(&*ts, &*cs, n, 336.0, 840.0)
    (*m)[2] = 0.6931471805599453 / lz
    (*m)[3] = (*ca)[n] + (*cs)[n] / lz
    (*m)[4] = bal[3]
    (*m)[5] = bal[0]
    (*m)[6] = (*cs)[pep_idx(&*ts, n, 24.0)]
    (*m)[7] = (*cs)[pep_idx(&*ts, n, 72.0)]
    (*m)[8] = (*cs)[pep_idx(&*ts, n, 168.0)]
    (*m)[9] = (*cs)[pep_idx(&*ts, n, 336.0)]
    (*m)[10] = (*cs)[pep_idx(&*ts, n, 672.0)]
    (*m)[11] = pep_auc(&*ts, &*ca, n, 0.0, 168.0)
    let lz2 = pep_lambda(&*ts, &*cs, n, 168.0, 504.0)
    (*m)[14] = 0.6931471805599453 / lz2
    (*m)[15] = (*cs)[pep_idx(&*ts, n, 48.0)]
    (*m)[16] = (*cs)[pep_idx(&*ts, n, 96.0)]
    (*m)[17] = lz
}

fn st_half(th: &[f64; 9], dose: f64, m: &![f64; 64], ts: &![f64; 3000], cs: &![f64; 3000], ca: &![f64; 3000]) with Mut, Div, Panic {
    var dk: [f64; 16] = [0.0; 16]
    dk[0] = dose
    var bal: [f64; 4] = [0.0; 4]
    var pk: [f64; 2] = [0.0; 2]
    let n = pep_run(th, &dk, 1, 0.5, 336.0, 4.0, 840.0, ts, cs, ca, &!bal)
    pep_peak(&*ts, &*cs, n, 0.0, 168.0, &!pk)
    (*m)[12] = pk[0]
    (*m)[13] = pk[1]
}

// Weekly dose x 12, dt2 after 336 h. Results at b: b+0 AUC last interval, b+1 Cmax last,
// b+2 tmax last (h after the dose), b+3 balance error, b+4 AUC interval 1, b+5 AUC interval 4,
// b+6 Cmax interval 4, b+7 Cmax interval 1, b+8..b+19 trough before dose 2..13 (end of week k).
fn st_weekly(th: &[f64; 9], dose: f64, dt2: f64, b: i32, m: &![f64; 64], ts: &![f64; 3000], cs: &![f64; 3000], ca: &![f64; 3000]) with Mut, Div, Panic {
    var dk: [f64; 16] = [0.0; 16]
    var k: i32 = 0
    while k < 12 {
        dk[k] = dose
        k = k + 1
    }
    var bal: [f64; 4] = [0.0; 4]
    var pk: [f64; 2] = [0.0; 2]
    let n = pep_run(th, &dk, 12, 1.0, 336.0, dt2, 2016.0, ts, cs, ca, &!bal)
    (*m)[b + 0] = pep_auc(&*ts, &*ca, n, 1848.0, 2016.0)
    pep_peak(&*ts, &*cs, n, 1848.0, 2016.0, &!pk)
    (*m)[b + 1] = pk[0]
    (*m)[b + 2] = pk[1] - 1848.0
    (*m)[b + 3] = bal[3]
    (*m)[b + 4] = pep_auc(&*ts, &*ca, n, 0.0, 168.0)
    (*m)[b + 5] = pep_auc(&*ts, &*ca, n, 504.0, 672.0)
    pep_peak(&*ts, &*cs, n, 504.0, 672.0, &!pk)
    (*m)[b + 6] = pk[0]
    pep_peak(&*ts, &*cs, n, 0.0, 168.0, &!pk)
    (*m)[b + 7] = pk[0]
    k = 1
    while k <= 12 {
        (*m)[b + 7 + k] = (*cs)[pep_idx(&*ts, n, 168.0 * (k as f64))]
        k = k + 1
    }
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var th: [f64; 9] = [0.0; 9]
    var u: [f64; 9] = [0.0; 9]
    tirz_theta_into(&!th, &!u)
    var m: [f64; 64] = [0.0; 64]
    var ts: [f64; 3000] = [0.0; 3000]
    var cs: [f64; 3000] = [0.0; 3000]
    var ca: [f64; 3000] = [0.0; 3000]
    st_single(&th, 5.0, &!m, &!ts, &!cs, &!ca)
    st_half(&th, 5.0, &!m, &!ts, &!cs, &!ca)
    st_weekly(&th, 5.0, 2.0, 24, &!m, &!ts, &!cs, &!ca)
    st_weekly(&th, 5.0, 1.0, 44, &!m, &!ts, &!cs, &!ca)

    let cl = th[PT_CL]
    let f = th[PT_F]
    let s = tirz_wt_ratio()
    let ln2 = 0.6931471805599453

    println("S0 parameters at the 73 kg man (value, standard uncertainty); CL ABSOLUTE, no renal term")
    var i: i32 = 0
    while i < 9 {
        print("  "); print(st_pname(i)); print("  "); print(th[i]); print("  u "); println(u[i])
        i = i + 1
    }
    println("S0a apparent <-> absolute conversions")
    let feff = tirz_f_rel()
    print("  Schneck absolute CL 0.0329 L/h/70 kg (F fixed 0.8); F_eff in the other studies 0.8 (1 - 0.181) = "); println(feff)
    print("  label apparent CL (T2D, ~90 kg) reconstructed: CL x (90/70)^0.8 / F_eff = "); println(tirz_cl_ref() * pep_pow(90.0 / 70.0, 0.8) / feff)
    print("  the defect, shown: label 0.061 taken as absolute and F 0.8 applied again -> "); print(0.061 * 0.8); print(" L/h; model absolute CL at 73 kg "); print(cl); print(" ("); print(100.0 * (0.061 * 0.8 / cl - 1.0)); println(" % too high)")
    print("  label apparent steady-state V 10.3 L (V/F): x F_eff = "); print(10.3 * feff); print(" L, x 0.8 = "); print(10.3 * 0.8); println(" L (the label does not say which F; Vss predicted below, not taken from it)")
    print("  Coskun CL/F and Vz/F are apparent: absolute CL/Vz need F; here CL/F predicted = CL/F = "); println(cl / f)

    println("S structure: volumes")
    let vpl = pep_vplasma(&th)
    let v0 = pep_vss(&th, 0)
    let v1 = pep_vss(&th, 1)
    var thn = th
    thn[PT_RINT] = 1.4 * 3.0 / 15.2
    let vn = pep_vss(&thn, 0)
    let vpop = (tirz_vc_ref() + tirz_vp_ref()) * s
    let vnord = 3.0 * (1.0 + 1.4) + th[PT_FU] * (15.2 - 1.4 * 3.0)
    print("  bp "); print(1.0 - th[PT_HCT]); print("  plasma volume bp V_blood "); print(vpl); println(" L")
    print("  V_ss primary "); print(v0); print("  Rodgers-Rowland albumin route "); print(v1); print("  r from Nordell volumes (r = "); print(thn[PT_RINT]); print(") "); println(vn)
    print("  population (Vc+Vp) 6.45 L/70 kg x 73/70 = "); print(vpop); print("   Nordell 7.2 + 11 fu = "); println(vnord)
    fails = fails + st_rel("S1 plasma volume = 3.0 L", vpl, 3.0, 1.0e-3)
    fails = fails + st_row_fold("S2 V_ss primary vs population Vc+Vp (73 kg)", v0, vpop, 1.15, 1, 0.97, 1.08)
    fails = fails + st_row_fold("S3 V_ss primary vs Nordell relation", v0, vnord, 1.10, 1, 0.90, 1.00)
    fails = fails + st_row_fold("S4 V_ss, r from Nordell volumes, vs population", vn, vpop, 1.15, 1, 0.82, 0.95)
    fails = fails + st_row_fold("S5 V_ss, Rodgers-Rowland albumin route, vs population", v1, vpop, 1.15, 0, 1.15, 1.30)
    fails = fails + st_row_fold("S6 formula MW vs Coskun 4810.52 Da", th[PT_MW], 4810.52, 1.01, 1, 0.999, 1.002)
    fails = fails + st_row_fold("S7 label CL 0.061 reconstructed from the absolute population CL", tirz_cl_ref() * pep_pow(90.0 / 70.0, 0.8) / feff, 0.061, 1.05, 1, 0.99, 1.02)

    println("I identities of the scheme (single dose 5 mg, grid 1 h to 336 h then 4 h to 2900 h)")
    let auc_cf = f * 5.0 / cl
    print("  input "); print(m[5]); print("  F D (1 - exp(-ka T)) = "); println(f * 5.0 * (1.0 - exp(0.0 - th[PT_KA] * 2900.0)))
    fails = fails + st_rel("I1 mass balance (error + 1)", m[4] + 1.0, 1.0, 1.0e-6)
    fails = fails + st_rel("I2 input = F D", m[5], f * 5.0 * (1.0 - exp(0.0 - th[PT_KA] * 2900.0)), 1.0e-9)
    fails = fails + st_rel("I3 AUC_inf = F D / CL (identity, not validation)", m[3], auc_cf, 2.0e-3)
    println("I4 step halving")
    fails = fails + st_rel("Cmax dt 1 h vs dt 0.5 h", m[0], m[12], 2.0e-3)
    print("  tmax dt 1 h "); print(m[1]); print("  dt 0.5 h "); println(m[13])
    if st_abs(m[1] - m[13]) > 1.0 {
        println("  [FAIL] tmax step dependence > 1 h")
        fails = fails + 1
    }
    fails = fails + st_rel("SS AUC, dt 2 h vs dt 1 h after 336 h", m[24], m[44], 1.0e-3)

    println("K kernel against the Schneck two-compartment model (analytic, 73 kg)")
    let sw = pep_pow(s, tirz_wexp())
    let clp = tirz_cl_ref() * sw
    let qp = tirz_q_ref() * sw
    let vcp = tirz_vc_ref() * s
    let vpp = tirz_vp_ref() * s
    var rt: [f64; 2] = [0.0; 2]
    pep_pop2_rates(clp, vcp, qp, vpp, &!rt)
    print("  population alpha "); print(rt[0]); print(" /h (t1/2 "); print(ln2 / rt[0]); print(" h)  beta "); print(rt[1]); print(" /h (t1/2 "); print(ln2 / rt[1]); println(" h)")
    var cpm = 0.0
    var tpm = 0.0
    var tt = 0.5
    while tt <= 168.0 {
        let c = pep_pop2(f, 5.0, th[PT_KA], clp, vcp, qp, vpp, tt)
        if c > cpm {
            cpm = c
            tpm = tt
        }
        tt = tt + 0.5
    }
    print("  population Cmax "); print(1000.0 * cpm); print(" ng/mL at "); print(tpm); print(" h;  kernel Cmax "); print(1000.0 * m[0]); print(" ng/mL at "); print(m[1]); println(" h")
    fails = fails + st_row_fold("K1 Cmax kernel vs population", m[0], cpm, 1.15, 1, 0.90, 1.15)
    fails = fails + st_row_fold("K2 tmax kernel vs population", m[1], tpm, 1.15, 1, 0.85, 1.15)
    fails = fails + st_row_fold("K3a conc at 24 h", m[6], pep_pop2(f, 5.0, th[PT_KA], clp, vcp, qp, vpp, 24.0), 1.20, 1, 0.8, 1.2)
    fails = fails + st_row_fold("K3b conc at 72 h", m[7], pep_pop2(f, 5.0, th[PT_KA], clp, vcp, qp, vpp, 72.0), 1.20, 1, 0.8, 1.2)
    fails = fails + st_row_fold("K3c conc at 168 h", m[8], pep_pop2(f, 5.0, th[PT_KA], clp, vcp, qp, vpp, 168.0), 1.20, 1, 0.8, 1.2)
    fails = fails + st_row_fold("K3d conc at 336 h", m[9], pep_pop2(f, 5.0, th[PT_KA], clp, vcp, qp, vpp, 336.0), 1.20, 1, 0.8, 1.2)
    fails = fails + st_row_fold("K3e conc at 672 h", m[10], pep_pop2(f, 5.0, th[PT_KA], clp, vcp, qp, vpp, 672.0), 1.20, 1, 0.8, 1.2)
    fails = fails + st_row_fold("K4 terminal t1/2 kernel vs ln2/beta", m[2], ln2 / rt[1], 1.05, 1, 0.95, 1.05)

    println("O Coskun 2018 SAD, 5 mg, healthy, n = 5 (Table 2), geometric mean (CV%); lineage: inside the Schneck dataset")
    let auc_sd = m[3]
    let clf = 5.0 / auc_sd
    let vzf = clf / m[17]
    print("  Cmax "); print(1000.0 * m[0]); print(" ng/mL  tmax "); print(m[1]); print(" h  AUC_inf "); print(auc_sd); print(" mg h/L  t1/2 "); print(m[2]); print(" h  CL/F "); print(clf); print(" L/h  Vz/F "); print(vzf); println(" L")
    fails = fails + st_row_ln("O1 Cmax (ng/mL)", 1000.0 * m[0], 397.0, 0.23, 1, -1.0, 1.5)
    // registered band [40, 72] was missed (measured 33.3 h); band below is the measured one, see AFTER THE RUN
    fails = fails + st_row_rng("O2 Tmax (h), Coskun 5 mg [24, 72], label 8-72", m[1], 24.0, 72.0, 1, 28.0, 40.0)
    print("  O2 diagnostic: conc/Cmax at 24 h "); print(m[6] / m[0]); print("  48 h "); print(m[15] / m[0]); print("  72 h "); print(m[7] / m[0]); print("  96 h "); println(m[16] / m[0])
    if !(m[6] >= m[15] && m[6] >= m[7] && m[6] >= m[16]) {
        println("  [FAIL] O2 grid argmax over {24, 48, 72, 96} h is not 24 h")
        fails = fails + 1
    } else {
        println("  O2 grid argmax over {24, 48, 72, 96} h = 24 h (cohort median 24 h)")
    }
    fails = fails + st_row_ln("O3 AUC0-inf (mg h/L)", auc_sd, 90.5, 0.15, 1, 1.5, 2.0)
    fails = fails + st_row_ln("O4 CL/F (L/h)", clf, 0.0553, 0.15, 1, -2.0, -1.5)
    fails = fails + st_row_fold("O5a t1/2 (h) vs geometric mean 123, fold 1.25", m[2], 123.0, 1.25, 1, 1.15, 1.30)
    fails = fails + st_row_rng("O5b t1/2 (h) inside the cohort range [99.9, 147]", m[2], 99.9, 147.0, 0, 147.0, 165.0)
    print("  O5 diagnostic: t1/2 from the slope over 168-504 h "); print(m[14]); print(" h; over 336-840 h "); print(m[2]); println(" h")
    fails = fails + st_row_ln("O6 Vz/F (L)", vzf, 9.80, 0.07, 1, -1.5, 0.5)
    print("  O6 cancellation: CL/F ratio pred/obs "); print(clf / 0.0553); print("  t1/2 ratio pred/obs "); print(m[2] / 123.0); println("  (Vz/F = CL/F x t1/2 / ln2)")
    println("D1 diagnostic with F = 0.655 (Schneck between-study effect; not a fit)")
    fails = fails + st_row_ln("D1a AUC0-inf (mg h/L), F 0.655", feff * 5.0 / cl, 90.5, 0.15, 1, 0.0, 1.0)
    fails = fails + st_row_ln("D1b CL/F (L/h), F 0.655", cl / feff, 0.0553, 0.15, 1, -1.0, 0.0)
    fails = fails + st_row_ln("D1c Vz/F (L), F 0.655", cl / (feff * m[17]), 9.80, 0.07, 0, 1.8, 2.6)

    println("O7 accumulation, 5 mg weekly (grid 1 h to 336 h, 2 h after)")
    let racc4 = m[29] / m[28]
    print("  AUC_tau dose 4 / dose 1 = "); print(racc4); print("   Cmax dose 4 / dose 1 = "); print(m[30] / m[31]); print("   AUC_tau,ss(12) / dose 1 = "); print(m[24] / m[28]); print("   1/(1 - exp(-beta tau)) = "); println(1.0 / (1.0 - exp(0.0 - m[17] * 168.0)))
    fails = fails + st_row_fold("O7 accumulation after four doses vs 1.58", racc4, 1.58, 1.25, 1, 0.90, 1.20)

    println("S7 steady state, 5 mg weekly x 12, 73 kg healthy man")
    let auc_w = m[24]
    print("  AUC_tau (last interval) "); print(auc_w); print(" mg h/L  F D / CL = "); print(auc_cf); print("  Cavg "); print(1000.0 * auc_w / 168.0); println(" ng/mL")
    fails = fails + st_rel("S7a AUC_tau = F D / CL (identity)", auc_w, auc_cf, 2.0e-3)
    print("  Cmax "); print(1000.0 * m[25]); print(" ng/mL at "); print(m[26]); print(" h after the dose; trough (168 h) "); print(1000.0 * m[43]); print(" ng/mL; trough/peak "); println(m[43] / m[25])
    fails = fails + st_rel("S7b mass balance (error + 1)", m[27] + 1.0, 1.0, 1.0e-6)
    var k: i32 = 1
    var kss: i32 = 0
    while k <= 11 {
        let ratio = m[24 + 7 + k] / m[43]
        print("  trough before dose "); print(k + 1); print(" / final trough "); println(ratio)
        if ratio >= 0.95 && kss == 0 { kss = k }
        k = k + 1
    }
    print("  95 % of the final trough reached after "); print(kss); println(" weekly doses (label: 4 weeks)")
    var okss = 0
    if kss == 4 || kss == 5 { okss = 1 }
    if okss == 0 {
        println("  [FAIL] O8 time to steady state outside 4-5 weeks")
        fails = fails + 1
    }

    var res: [f64; 8] = [0.0; 8]
    var ca1: [f64; 9] = [0.0; 9]
    var ca2: [f64; 9] = [0.0; 9]
    var ca3: [f64; 9] = [0.0; 9]
    pep_budget(&th, &u, 5.0, &!res, &!ca1, &!ca2, &!ca3)
    println("U uncertainty budget (first-order, independent inputs, 5 mg weekly)")
    print("  AUC_tau,ss "); print(res[0]); print(" mg h/L  u "); print(cd_sqrt(res[3])); print("  (rel "); print(cd_sqrt(res[3]) / res[0]); println(")")
    print("  Cmax single dose "); print(1000.0 * res[1]); print(" ng/mL  u "); print(1000.0 * cd_sqrt(res[4])); print("  (rel "); print(cd_sqrt(res[4]) / res[1]); println(")")
    print("  Cmax steady state "); print(1000.0 * res[2]); print(" ng/mL  u "); print(1000.0 * cd_sqrt(res[5])); print("  (rel "); print(cd_sqrt(res[5]) / res[2]); println(")")
    println("  input        share of var(AUC) %  var(Cmax single) %  var(Cmax SS) %")
    i = 0
    while i < 9 {
        if u[i] > 0.0 {
            print("  "); print(st_pname(i)); print("   "); print(100.0 * ca1[i] / res[3]); print("   "); print(100.0 * ca2[i] / res[4]); print("   "); println(100.0 * ca3[i] / res[5])
        }
        i = i + 1
    }
    fails = fails + st_rel("budget AUC equals the weekly run", res[0], auc_w, 1.0e-9)
    let uf = u[PT_F] / f
    let ucl = u[PT_CL] / cl
    print("  closed form u(AUC)/AUC = sqrt(uF^2 + uCL^2) = "); println(cd_sqrt(uf * uf + ucl * ucl))
    fails = fails + st_rel("budget u(AUC)/AUC vs closed form", cd_sqrt(res[3]) / res[0], cd_sqrt(uf * uf + ucl * ucl), 2.0e-3)

    if fails == 0 {
        println("CIRC28_DRUG_TIRZEPATIDE_PASS")
        return 0
    }
    println("CIRC28_DRUG_TIRZEPATIDE_FAIL")
    return 1
}
