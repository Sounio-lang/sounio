//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v110 smoke for Lorenz i256 step-3 Taylor-2 time-slab containment

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2027
    receipt_fp = mix(receipt_fp, 113001479, 6037)
    receipt_fp = mix(receipt_fp, 175704874, 6037)
    receipt_fp = mix(receipt_fp, 896565841, 6037)
    receipt_fp = mix(receipt_fp, 427093525, 6037)
    receipt_fp = mix(receipt_fp, 780008796, 6037)
    receipt_fp = mix(receipt_fp, 999870071, 6037)
    receipt_fp = mix(receipt_fp, 420821728, 6037)
    receipt_fp = mix(receipt_fp, 3, 6037)
    receipt_fp = mix(receipt_fp, 14, 6037)
    receipt_fp = mix(receipt_fp, 255, 6037)
    if receipt_fp != 207736416 { return 1 }

    var audit_fp: i64 = 2029
    audit_fp = mix(audit_fp, receipt_fp, 6043)
    audit_fp = mix(audit_fp, 113001479, 6043)
    audit_fp = mix(audit_fp, 175704874, 6043)
    audit_fp = mix(audit_fp, 280440446, 6043)
    audit_fp = mix(audit_fp, 300531949, 6043)
    audit_fp = mix(audit_fp, 109993635, 6043)
    audit_fp = mix(audit_fp, 39227174, 6043)
    audit_fp = mix(audit_fp, 780008796, 6043)
    audit_fp = mix(audit_fp, 3, 6043)
    audit_fp = mix(audit_fp, 14, 6043)
    audit_fp = mix(audit_fp, 255, 6043)
    if audit_fp != 314571242 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 113, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 113, 1103)
    if entry_fp != 739787906 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 110, 1151)
    manifest_fp = mix(manifest_fp, 114, 1151)
    manifest_fp = mix(manifest_fp, 427093525, 1151)
    manifest_fp = mix(manifest_fp, 896565841, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 767613887 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 110, 1871)
    result_fp = mix(result_fp, 114, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 102, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 539223951 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 110, 1907)
    family_fp = mix(family_fp, 114, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 97, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 537860883 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 110, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 579383998 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 110, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 339236300 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 110, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 843058093 { return 9 }
    return 0
