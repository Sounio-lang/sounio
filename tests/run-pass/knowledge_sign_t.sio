//@ run-pass
//@ requires: madaros
//@ expect-stdout: SIGN_T_OK
// sign(a, b) returns Knowledge of the same species as a and b.
// The variance is the shared interval. An enthalpy result is not a pressure.

ontology Lab {
    class Quantity { property amount: f64 where amount >= 0.0 }
    class Pressure subclass_of Quantity
    class Enthalpy subclass_of Quantity
    disjoint Enthalpy, Pressure
}

fn as_pressure(p: Knowledge<Pressure>) -> f64 with Epistemic, Mut, Div {
    variance_of(p.value)
}

fn as_enthalpy(h: Knowledge<Enthalpy>) -> f64 with Epistemic, Mut, Div {
    variance_of(h.value)
}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let p0: Pressure = 10.0
    let p1: Pressure = 10.5
    let a: Knowledge<Pressure> = measure(p0, uncertainty: 2.0)
    let b: Knowledge<Pressure> = measure(p1, uncertainty: 0.5)
    let sp = sign(a, b)
    let vp = as_pressure(sp)
    let e0: Enthalpy = 30.0
    let e1: Enthalpy = 30.2
    let ea: Knowledge<Enthalpy> = measure(e0, uncertainty: 1.0)
    let eb: Knowledge<Enthalpy> = measure(e1, uncertainty: 0.2)
    let se = sign(ea, eb)
    let ve = as_enthalpy(se)
    print("p ")
    print_f64(vp)
    print(" e ")
    print_f64(ve)
    print("\n")
    if near(vp, 0.25, 0.001) && near(ve, 0.04, 0.001) {
        println("SIGN_T_OK")
        return 0
    }
    println("SIGN_T_FAIL")
    1
}
