//@ run-pass
//@ expect-stdout: OP_SUB_INLINE_LIVE
//@ description: Inline OpSub (a-b and 0.0-a) must keep FO. Call wrapping is the hole.

fn main() -> i64 with IO, Mut, Epistemic {
    let ka: Knowledge<f64> = measure(10.0, uncertainty: 1.0)
    let kb: Knowledge<f64> = measure(4.0, uncertainty: 1.0)
    let a = ka.value
    let b = kb.value
    let v_sub = variance_of(a - b)
    let v_neg = variance_of(0.0 - a)
    let v_mul = variance_of(a * b)
    print("inline_sub ")
    print_f64(v_sub)
    println("")
    print("inline_neg ")
    print_f64(v_neg)
    println("")
    print("inline_mul ")
    print_f64(v_mul)
    println("")
    // GUM: var(a-b)=2, var(-a)=1, var(a*b)=116. All must be live.
    if v_sub > 1.0e-12 && v_neg > 1.0e-12 && v_mul > 1.0e-12 {
        println("OP_SUB_INLINE_LIVE")
        0
    } else {
        println("OP_SUB_INLINE_ZERO")
        1
    }
}
