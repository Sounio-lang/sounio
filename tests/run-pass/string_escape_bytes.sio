//@ run-pass
//@ requires: madaros
//@ expect-stdout: escape bytes ok
//@ description: `\0` is the NUL byte and `\xHH` is one byte with that value; Madaros used to compile them as the text "0" and "xHH"

fn byte_at(s: string, i: i64) -> i64 {
    let raw = s[i as usize] as i64
    if raw < 0 { raw + 256 } else { raw }
}

fn expect(label: string, got: i64, want: i64) -> i64 with IO {
    if got == want { return 0 }
    print(label)
    print(" got ")
    print_int(got)
    print(" want ")
    print_int(want)
    println("")
    1
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var bad = 0
    let h = "\x41\x42\x7a"
    bad = bad + expect("x41", byte_at(h, 0), 65)
    bad = bad + expect("x42", byte_at(h, 1), 66)
    bad = bad + expect("x7a", byte_at(h, 2), 122)
    let e = "[\x1b]"
    bad = bad + expect("x1b", byte_at(e, 1), 27)
    bad = bad + expect("x1b-next", byte_at(e, 2), 93)
    let f = "\xFFz"
    bad = bad + expect("xFF", byte_at(f, 0), 255)
    bad = bad + expect("xFF-next", byte_at(f, 1), 122)
    let z = "a\0b"
    bad = bad + expect("nul", byte_at(z, 1), 0)
    bad = bad + expect("nul-next", byte_at(z, 2), 98)
    let k = "\\\"\n\t\r"
    bad = bad + expect("bs", byte_at(k, 0), 92)
    bad = bad + expect("dq", byte_at(k, 1), 34)
    bad = bad + expect("lf", byte_at(k, 2), 10)
    bad = bad + expect("tab", byte_at(k, 3), 9)
    bad = bad + expect("cr", byte_at(k, 4), 13)
    if bad == 0 { println("escape bytes ok") }
    bad
}
