//@ run-pass
//@ requires: madaros
//@ expect-stdout: -495:507:let-cast-snapshot-ok
// SIO-569: `let neg = x as i64` must snapshot the widened value at the
// binding. Int->int casts erase in lower_cast_expr_ref (src_reg is returned
// with no conversion op), so the binding aliased the source register and a
// later store to x showed through the supposedly frozen local: the slot
// form printed 505 instead of -495, and the plain form 707 instead of 507.
fn slotround() -> i64 with Mut {
    var x: i8 = 5
    let xp = (&!x) as *mut i8
    *xp = (0 - 5) as i8
    let neg = x as i64
    *xp = 5 as i8
    (neg * 100) + (x as i64)
}
fn plain() -> i64 with Mut {
    var x: i8 = 5
    let neg = x as i64
    x = 7 as i8
    (neg * 100) + (x as i64)
}
fn main() -> i64 with IO, Mut {
    print_int(slotround())
    print(":")
    print_int(plain())
    print(":let-cast-snapshot-ok")
    println("")
    return 0
}
