//@ run-pass
//@ expect-stdout: deployment validity revocable authority parallel ontology OK

ontology DeploymentValidityRevocableAuthorityWitness {
    class EpistemicArtifact

    class MetricEvidenceArtifact subclass_of EpistemicArtifact
    class DiscriminationEvidence subclass_of MetricEvidenceArtifact
    class CalibrationEvidence subclass_of MetricEvidenceArtifact

    class SequentialValidityArtifact subclass_of EpistemicArtifact
    class FixedHorizonValidity subclass_of SequentialValidityArtifact
    class TimeUniformValidity subclass_of SequentialValidityArtifact
    class FixedEValue subclass_of SequentialValidityArtifact
    class EProcess subclass_of SequentialValidityArtifact

    class SafetyEvidenceArtifact subclass_of EpistemicArtifact
    class ManufacturerSafetyCase subclass_of SafetyEvidenceArtifact
    class LocalDeploymentSafetyCase subclass_of SafetyEvidenceArtifact

    class DeferralArtifact subclass_of EpistemicArtifact
    class ModelAbstention subclass_of DeferralArtifact
    class SafeDeferral subclass_of DeferralArtifact

    class ShiftAssessmentArtifact subclass_of EpistemicArtifact
    class InputShift subclass_of ShiftAssessmentArtifact
    class PerformanceDrift subclass_of ShiftAssessmentArtifact
    class CalibrationDrift subclass_of ShiftAssessmentArtifact
    class NoDetectedShift subclass_of ShiftAssessmentArtifact
    class NoShift subclass_of ShiftAssessmentArtifact

    class ChangeControlArtifact subclass_of EpistemicArtifact
    class PCCPPlan subclass_of ChangeControlArtifact
    class AuthorizedModification subclass_of ChangeControlArtifact
    class UnauthorizedChange subclass_of ChangeControlArtifact

    class DeploymentDispositionArtifact subclass_of EpistemicArtifact
    class FixtureCanaryLease subclass_of DeploymentDispositionArtifact
    class ProductionDeploymentAuthority subclass_of DeploymentDispositionArtifact
    class Quarantined subclass_of DeploymentDispositionArtifact
    class AdvisoryReady subclass_of DeploymentDispositionArtifact
    class ClinicalActionAuthority subclass_of DeploymentDispositionArtifact

    class DeploymentSubjectArtifact subclass_of EpistemicArtifact
    class ModelVersion subclass_of DeploymentSubjectArtifact
    class DeploymentSite subclass_of DeploymentSubjectArtifact
    class MonitoringEpoch subclass_of DeploymentSubjectArtifact
}

fn accept_metric(v: MetricEvidenceArtifact) -> i32 { 0 }
fn accept_sequential(v: SequentialValidityArtifact) -> i32 { 0 }
fn accept_safety(v: SafetyEvidenceArtifact) -> i32 { 0 }
fn accept_deferral(v: DeferralArtifact) -> i32 { 0 }
fn accept_shift(v: ShiftAssessmentArtifact) -> i32 { 0 }
fn accept_change(v: ChangeControlArtifact) -> i32 { 0 }
fn accept_disposition(v: DeploymentDispositionArtifact) -> i32 { 0 }
fn accept_subject(v: DeploymentSubjectArtifact) -> i32 { 0 }

fn discrimination_bridge(v: DiscriminationEvidence) -> i32 { accept_metric(v) }
fn calibration_bridge(v: CalibrationEvidence) -> i32 { accept_metric(v) }
fn fixed_horizon_bridge(v: FixedHorizonValidity) -> i32 {
    accept_sequential(v)
}
fn time_uniform_bridge(v: TimeUniformValidity) -> i32 {
    accept_sequential(v)
}
fn fixed_e_value_bridge(v: FixedEValue) -> i32 { accept_sequential(v) }
fn e_process_bridge(v: EProcess) -> i32 { accept_sequential(v) }
fn manufacturer_bridge(v: ManufacturerSafetyCase) -> i32 { accept_safety(v) }
fn local_safety_bridge(v: LocalDeploymentSafetyCase) -> i32 {
    accept_safety(v)
}
fn abstention_bridge(v: ModelAbstention) -> i32 { accept_deferral(v) }
fn safe_deferral_bridge(v: SafeDeferral) -> i32 { accept_deferral(v) }
fn input_shift_bridge(v: InputShift) -> i32 { accept_shift(v) }
fn performance_drift_bridge(v: PerformanceDrift) -> i32 { accept_shift(v) }
fn calibration_drift_bridge(v: CalibrationDrift) -> i32 { accept_shift(v) }
fn no_detected_shift_bridge(v: NoDetectedShift) -> i32 { accept_shift(v) }
fn no_shift_bridge(v: NoShift) -> i32 { accept_shift(v) }
fn plan_bridge(v: PCCPPlan) -> i32 { accept_change(v) }
fn authorized_change_bridge(v: AuthorizedModification) -> i32 {
    accept_change(v)
}
fn unauthorized_change_bridge(v: UnauthorizedChange) -> i32 {
    accept_change(v)
}
fn canary_bridge(v: FixtureCanaryLease) -> i32 { accept_disposition(v) }
fn production_bridge(v: ProductionDeploymentAuthority) -> i32 {
    accept_disposition(v)
}
fn quarantine_bridge(v: Quarantined) -> i32 { accept_disposition(v) }
fn advisory_bridge(v: AdvisoryReady) -> i32 { accept_disposition(v) }
fn clinical_bridge(v: ClinicalActionAuthority) -> i32 {
    accept_disposition(v)
}
fn model_bridge(v: ModelVersion) -> i32 { accept_subject(v) }
fn site_bridge(v: DeploymentSite) -> i32 { accept_subject(v) }
fn epoch_bridge(v: MonitoringEpoch) -> i32 { accept_subject(v) }

fn main() -> i32 {
    print("deployment validity revocable authority parallel ontology OK\n")
    0
}
