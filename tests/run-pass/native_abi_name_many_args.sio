//@ run-pass

struct MiniName {
    buf: [i8; 128],
    len: i64,
}

fn make_name(ch: i8, len: i64) -> MiniName with Mut, Panic {
    var n = MiniName { buf: [0; 128], len: len }
    n.buf[0] = ch
    n
}

fn consume_many(a: i64, b: i64, first: MiniName, middle: i64, second: MiniName, third: MiniName, tail: i64) -> i64 {
    (first.buf[0] as i64) + middle + (second.buf[0] as i64) + (third.buf[0] as i64) + tail + a + b
}

fn consume_frontend_shape(data: string, start: i64, end: i64, param: MiniName, local0: MiniName, local0_off: i64, local1: MiniName, local1_delta: i64) -> i64 {
    str_len(data) + start + end + (param.buf[0] as i64) + (local0.buf[0] as i64) + local0_off + (local1.buf[0] as i64) + local1_delta
}

fn tuple_frontend_shape(data: string, start: i64, end: i64, param: MiniName, local0: MiniName, local0_off: i64, local1: MiniName, local1_delta: i64) -> (bool, i64) {
    (true, str_len(data) + start + end + (param.buf[0] as i64) + (local0.buf[0] as i64) + local0_off + (local1.buf[0] as i64) + local1_delta)
}

fn wrapper_frontend_shape(data: string, start: i64, end: i64, param: MiniName, local0: MiniName, local0_off: i64, local1: MiniName, local1_delta: i64) -> (bool, i64) {
    tuple_frontend_shape(data, start, end, param, local0, local0_off, local1, local1_delta)
}

fn make_pair(v: i64) -> (bool, i64) {
    (true, v)
}

fn main() -> i64 {
    let x = make_name(10 as i8, 1)
    let y = make_name(20 as i8, 1)
    let z = make_name(30 as i8, 1)
    let base = consume_many(1, 2, x, 3, y, z, 4)
    let shaped = consume_frontend_shape("abc", 5, 6, x, y, 7, z, 8)
    let tupled = wrapper_frontend_shape("abc", 5, 6, x, y, 7, z, 8)
    if !tupled.0 {
        return 1
    }
    let pair = make_pair(7)
    let tupled_from_field = wrapper_frontend_shape("abc", 5, 6, x, y, pair.1, z, 8)
    if !tupled_from_field.0 {
        return 2
    }
    let total = base + shaped + tupled.1 + tupled_from_field.1
    if total == 337 {
        return 0
    }
    total
}
