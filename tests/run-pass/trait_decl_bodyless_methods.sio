//@ run-pass
// Acceptance test 3 for compiler prerequisite #2 (impl Trait for Type parsing).
// Tests trait declarations with bodyless method signatures (Bug A).
// This is a parse/check-only exercise; no impl needed.
// Expected output: "bodyless PASS"

// Trait with two bodyless method signatures
trait ExactOps {
    fn add(self, o: Self) -> Self
    fn mul(self, o: Self) -> Self
}

// Empty trait control (must continue to parse)
trait Empty {}

// Unrelated standalone function to verify no interference
fn helper(x: i64) -> i64 {
    x + 1
}

fn main() with IO {
    println("bodyless PASS")
}
