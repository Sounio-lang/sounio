//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: IDENT_N04_KNOWLEDGE_ADD_PASS
//
// Prediction (N-04 runtime observation identity in Knowledge + Knowledge):
// `let s = a + b` must keep its first-order sensitivity vector `[1.0 on a, 1.0 on b]`
// instead of seeding a fresh independent channel from `var_a + var_b`.
// Analytic:
//   Cov(s.value, a.value) == Var(a) == 1.0
//   Var(s.value - a.value) == Var(b) == 4.0
//   For p = a * 2.0: Cov(p.value, a.value) == 2.0, Var(p.value - a.value) == 1.0.

fn main() -> i64 with IO, Epistemic {
    let a = measure(10.0, uncertainty: 1.0)
    let b = measure(5.0, uncertainty: 2.0)
    let s = a + b
    let cov_sa = covariance_of(s.value, a.value)
    let var_sub = variance_of(s.value - a.value)
    var d1 = cov_sa - 1.0
    if d1 < 0.0 { d1 = 0.0 - d1 }
    var d2 = var_sub - 4.0
    if d2 < 0.0 { d2 = 0.0 - d2 }
    if d1 > 1.0e-12 || d2 > 1.0e-12 { return 1 }

    let p = a * 2.0
    let cov_pa = covariance_of(p.value, a.value)
    let var_pa = variance_of(p.value - a.value)
    var d3 = cov_pa - 2.0
    if d3 < 0.0 { d3 = 0.0 - d3 }
    var d4 = var_pa - 1.0
    if d4 < 0.0 { d4 = 0.0 - d4 }
    if d3 > 1.0e-12 || d4 > 1.0e-12 { return 2 }

    println("IDENT_N04_KNOWLEDGE_ADD_PASS")
    0
}
