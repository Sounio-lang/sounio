//@ run-pass

use graphics::surface::{surface_new, surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b}
use graphics::quality::{
    plot_heatmap_raster_smooth, plot_contour_raster,
    quality_heatmap_config_default, quality_contour_config_default
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var data: [f64; 4096] = [0.0; 4096]
    var r: i64 = 0
    while r < 4 {
        data[r * 4 + 0] = 0.0
        data[r * 4 + 1] = 0.33
        data[r * 4 + 2] = 0.67
        data[r * 4 + 3] = 1.0
        r = r + 1
    }

    var s = surface_new(72, 72)
    s = plot_heatmap_raster_smooth(s, &data, 4, 4, quality_heatmap_config_default())
    s = plot_contour_raster(s, &data, 4, 4, 0.5, quality_contour_config_default())

    var contour_pixels = 0
    var y = 24
    while y <= 48 {
        var x = 34
        while x <= 38 {
            let pr = surface_get_pixel_r(&s, x, y)
            let pg = surface_get_pixel_g(&s, x, y)
            let pb = surface_get_pixel_b(&s, x, y)
            if pr < 40 && pg < 40 && pb < 60 {
                contour_pixels = contour_pixels + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    if contour_pixels < 12 {
        print("FAIL contour isoline missing near expected center\n")
        return 1
    }

    var false_edge_pixels = 0
    y = 24
    while y <= 48 {
        let left_r = surface_get_pixel_r(&s, 24, y)
        let right_r = surface_get_pixel_r(&s, 48, y)
        if left_r < 40 { false_edge_pixels = false_edge_pixels + 1 }
        if right_r < 40 { false_edge_pixels = false_edge_pixels + 1 }
        y = y + 1
    }
    if false_edge_pixels > 4 {
        print("FAIL contour leaked far from expected level\n")
        return 2
    }

    print("PASS graphics_quality_contour_smoke\n")
    0
}
