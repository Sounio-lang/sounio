//@ run-pass
//
// M2c smoke — `NaturalityG2` effect bit 20 is parsed and propagates.
//
// Pins three contracts of the M2c compiler change:
//   1. `with NaturalityG2` parses without error.
//   2. The effect propagates through the call graph: a function calling
//      a NaturalityG2-declared callee inherits the requirement.
//   3. The effect interacts cleanly with existing effects (Mut, Div,
//      Panic, IO) — they can be declared together in any order.
//
// The Lean obligation generator is M4 work; this test makes no claim
// about g · embed = embed ∘ σ_g. Declaring the effect today is the
// documented intent.

// Innermost: a trivial G₂-equivariant function (constant function is
// trivially equivariant: f(g·x) = c = g·c when c is the unit scalar 1).
fn f_const_one(_x: i64) -> i64 with NaturalityG2 {
    return 1
}

// Caller inherits NaturalityG2 — propagation check.
fn f_double(_x: i64) -> i64 with NaturalityG2 {
    return 2 * f_const_one(0)
}

// Effect mixed with the four "standard" effects on a single function.
fn f_mixed(x: f64) -> f64 with NaturalityG2, Mut, Div, Panic {
    if x < 0.0 { return 0.0 }
    let half: f64 = x / 2.0
    return half + 0.5
}

fn main() -> i64 with IO, NaturalityG2, Mut, Div, Panic {
    var ok: i64 = 1

    if f_const_one(5) != 1 { ok = 0 }
    if f_double(5) != 2 { ok = 0 }

    let m: f64 = f_mixed(3.0)
    if m < 1.999 { ok = 0 }
    if m > 2.001 { ok = 0 }

    if ok == 1 { print("PASS\n") } else { print("FAIL\n") }
    return 0
}
