//@ run-pass
//@ description: Tiny portfolio v57 smoke for Lorenz i256 step-6 replay preflight entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 547
    receipt_fp = mix(receipt_fp, 490362827, 3989)
    receipt_fp = mix(receipt_fp, 772468073, 3989)
    receipt_fp = mix(receipt_fp, 728112333, 3989)
    receipt_fp = mix(receipt_fp, 813874951, 3989)
    receipt_fp = mix(receipt_fp, 836194547, 3989)
    receipt_fp = mix(receipt_fp, 6, 3989)
    receipt_fp = mix(receipt_fp, 7, 3989)
    receipt_fp = mix(receipt_fp, 127, 3989)
    if receipt_fp != 607197254 { return 1 }

    var audit_fp: i64 = 557
    audit_fp = mix(audit_fp, receipt_fp, 4001)
    audit_fp = mix(audit_fp, 490362827, 4001)
    audit_fp = mix(audit_fp, 772468073, 4001)
    audit_fp = mix(audit_fp, 811993749, 4001)
    audit_fp = mix(audit_fp, 440893911, 4001)
    audit_fp = mix(audit_fp, 836194547, 4001)
    audit_fp = mix(audit_fp, 6, 4001)
    audit_fp = mix(audit_fp, 7, 4001)
    audit_fp = mix(audit_fp, 127, 4001)
    if audit_fp != 794872504 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 60, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 60, 1103)
    if entry_fp != 340418867 { return 3 }

    let manifest_fp: i64 = 181028475
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 57, 1871)
    result_fp = mix(result_fp, 61, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 49, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 912636832 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 57, 1907)
    family_fp = mix(family_fp, 61, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 44, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 225633834 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 57, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 109240090 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 57, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 898775050 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 57, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 439805716 { return 8 }
    return 0
}
