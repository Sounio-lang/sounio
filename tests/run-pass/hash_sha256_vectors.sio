//@ run-pass
//@ requires: madaros
use hash::sha256::*
use net::socket::*

fn write_str(buf: &RawBuf, s: string) -> i64 with IO {
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        rawbuf_set(buf, i, str_char_at(s, i))
        i = i + 1
    }
    n
}

fn hex_nibble_to_char(nibble: i64) -> i64 {
    if nibble < 10 {
        48 + nibble
    } else {
        87 + nibble
    }
}

fn assert_digest_hex(digest: [u8; 32], expected_hex: string) with IO {
    var i: i64 = 0
    while i < 32 {
        let byte_val = digest[i as usize] as i64
        let hi_nibble = byte_val / 16
        let lo_nibble = byte_val - hi_nibble * 16
        let expected_hi = str_char_at(expected_hex, i * 2)
        let expected_lo = str_char_at(expected_hex, i * 2 + 1)
        assert(hex_nibble_to_char(hi_nibble) == expected_hi)
        assert(hex_nibble_to_char(lo_nibble) == expected_lo)
        i = i + 1
    }
}

fn main() with IO {
    let buf1 = rawbuf_new(1)
    let d1 = sha256(&buf1, 0)
    assert_digest_hex(d1, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")

    let buf2 = rawbuf_new(3)
    let len2 = write_str(&buf2, "abc")
    let d2 = sha256(&buf2, len2)
    assert_digest_hex(d2, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")

    let msg3 = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    let buf3 = rawbuf_new(64)
    let len3 = write_str(&buf3, msg3)
    let d3 = sha256(&buf3, len3)
    assert_digest_hex(d3, "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")

    // Vector 4: exactly one block (64 bytes, SHA-256's block size) of 'a'.
    // This is the classic SHA padding boundary case: the message fills the
    // block completely, so padding (the 0x80 byte plus the 64-bit length
    // field) must occupy an entire second block with no message bytes in
    // it. Expected digest independently verified with both Python's
    // hashlib and `openssl dgst -sha256` against the same 64-byte input.
    let msg4 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    let buf4 = rawbuf_new(64)
    let len4 = write_str(&buf4, msg4)
    let d4 = sha256(&buf4, len4)
    assert_digest_hex(d4, "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb")

    println("hash_sha256_vectors: all cases passed")
}
