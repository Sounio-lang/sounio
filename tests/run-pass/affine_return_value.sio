//@ run-pass
//@ requires: madaros

affine struct Permit {
    id: i64,
}

fn pass_through(permit: Permit) -> Permit {
    permit
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 with Panic {
    let permit = Permit { id: 13 }
    let returned = pass_through(permit)
    assert(spend(returned) == 13)
    0
}
