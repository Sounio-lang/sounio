//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_MATH_NATIVE_PASS

// Gate: Madaros native exp/log after xmm0-store fix.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div {
    let e0 = exp(0.0)
    let e1 = exp(1.0)
    let l1 = log(1.0)
    let le = log(exp(1.0))
    let ok = abs_f(e0 - 1.0) < 1.0e-6
        && abs_f(e1 - 2.718281828) < 1.0e-5
        && abs_f(l1 - 0.0) < 1.0e-6
        && abs_f(le - 1.0) < 1.0e-4
    print("e0="); print_f64(e0); print("\n")
    print("e1="); print_f64(e1); print("\n")
    print("l1="); print_f64(l1); print("\n")
    print("le="); print_f64(le); print("\n")
    if ok {
        print("MADAROS_GUM_FO_MATH_NATIVE_PASS\n")
    } else {
        print("MADAROS_GUM_FO_MATH_NATIVE_FAIL\n")
    }
}
