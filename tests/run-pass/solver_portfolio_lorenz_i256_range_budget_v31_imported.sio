use theorem::portfolio::*

fn main() -> i64 {
    let audit_fp = solver_portfolio_v31_lorenz_i256_range_budget_audit_fingerprint(
        87220662, 149359034, 890086395, 166945519, 184, 31)
    if audit_fp != 323169628 { return 1 }

    let manifest_fp = solver_portfolio_v31_lorenz_i256_range_budget_bundle_fingerprint(
        87220662, audit_fp)
    if manifest_fp != 628994509 { return 2 }

    let result_fp = solver_portfolio_v31_result_coverage_fingerprint(
        31, 35, 10, 23, 1, 1, manifest_fp)
    if result_fp != 322111452 { return 3 }

    let family_fp = solver_portfolio_v31_checker_family_coverage_fingerprint(
        31, 35, 6, 3, 2, 2, 22, manifest_fp)
    if family_fp != 379191739 { return 4 }

    let acceptance_fp = solver_portfolio_v31_acceptance_receipt_fingerprint(
        31, manifest_fp, result_fp)
    if acceptance_fp != 978689863 { return 5 }

    let audit_receipt_fp = solver_portfolio_v31_audit_receipt_fingerprint(
        31, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 692196152 { return 6 }

    let readiness_fp = solver_portfolio_v31_readiness_fingerprint(
        31, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 376269457 { return 7 }

    if solver_portfolio_v31_lorenz_i256_range_budget_audit_fingerprint(
        87220662, 149359034, 890086396, 166945519, 184, 31) != (0 - 1) { return 8 }
    if solver_portfolio_v31_result_coverage_fingerprint(
        31, 35, 11, 22, 1, 1, manifest_fp) != (0 - 1) { return 9 }

    return 0
}
