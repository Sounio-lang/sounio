//@ run-pass
//@ requires: madaros
//@ description: Scalar Lorenz ball-fixed step-policy margin receipt smoke

fn quality_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 811) % 1000000007
}

fn step_policy_margin_fingerprint(step_policy_fp: i64,
                                  radius_fill_limit_ppm: i64,
                                  min_slack_ppm: i64,
                                  max_aspect_q: i64,
                                  max_box_volume: i64) -> i64 {
    if step_policy_fp != 231786611 { return 0 - 1 }
    if radius_fill_limit_ppm != 970000 { return 0 - 1 }
    if min_slack_ppm != 30000 { return 0 - 1 }
    if max_aspect_q != 8 { return 0 - 1 }
    if max_box_volume != 27000000000000000 { return 0 - 1 }

    let radius_fill_ppm = 968726
    let slack_ppm = 31273
    let aspect_q = 7
    let box_volume = 26416072366172160
    let fill_margin_ppm = radius_fill_limit_ppm - radius_fill_ppm
    let slack_margin_ppm = slack_ppm - min_slack_ppm
    let aspect_margin_q = max_aspect_q - aspect_q
    let volume_margin = max_box_volume - box_volume
    if fill_margin_ppm != 1274 { return 0 - 1 }
    if slack_margin_ppm != 1273 { return 0 - 1 }
    if aspect_margin_q != 1 { return 0 - 1 }
    if volume_margin != 583927633827840 { return 0 - 1 }

    var margin_mask: i64 = 0
    if fill_margin_ppm > 0 { margin_mask = margin_mask + 1 }
    if slack_margin_ppm > 0 { margin_mask = margin_mask + 2 }
    if aspect_margin_q > 0 { margin_mask = margin_mask + 4 }
    if volume_margin > 0 { margin_mask = margin_mask + 8 }
    if margin_mask != 15 { return 0 - 1 }

    let min_ppm_margin = 1273
    let margin_action_accept_same_dt: i64 = 1

    var acc: i64 = 103
    acc = quality_mix(acc, step_policy_fp)
    acc = quality_mix(acc, radius_fill_limit_ppm)
    acc = quality_mix(acc, min_slack_ppm)
    acc = quality_mix(acc, max_aspect_q)
    acc = quality_mix(acc, max_box_volume)
    acc = quality_mix(acc, radius_fill_ppm)
    acc = quality_mix(acc, slack_ppm)
    acc = quality_mix(acc, aspect_q)
    acc = quality_mix(acc, box_volume)
    acc = quality_mix(acc, fill_margin_ppm)
    acc = quality_mix(acc, slack_margin_ppm)
    acc = quality_mix(acc, aspect_margin_q)
    acc = quality_mix(acc, volume_margin)
    acc = quality_mix(acc, min_ppm_margin)
    acc = quality_mix(acc, margin_mask)
    acc = quality_mix(acc, margin_action_accept_same_dt)
    return acc
}

fn main() -> i64 {
    let fp = step_policy_margin_fingerprint(
        231786611, 970000, 30000, 8, 27000000000000000)
    if fp != 494960746 { return 1 }

    if 970000 - 968726 != 1274 { return 2 }
    if 31273 - 30000 != 1273 { return 3 }
    if 8 - 7 != 1 { return 4 }
    if 27000000000000000 - 26416072366172160 != 583927633827840 { return 5 }

    if step_policy_margin_fingerprint(
        231786612, 970000, 30000, 8, 27000000000000000) != (0 - 1) { return 6 }
    if step_policy_margin_fingerprint(
        231786611, 968725, 30000, 8, 27000000000000000) != (0 - 1) { return 7 }
    if step_policy_margin_fingerprint(
        231786611, 970000, 31274, 8, 27000000000000000) != (0 - 1) { return 8 }
    if step_policy_margin_fingerprint(
        231786611, 970000, 30000, 6, 27000000000000000) != (0 - 1) { return 9 }
    if step_policy_margin_fingerprint(
        231786611, 970000, 30000, 8, 26416072366172159) != (0 - 1) { return 10 }

    return 0
}
