//@ run-pass
//@ requires: madaros
//@ expect-stdout: zero first
// SIO-322: a tuple pattern must test/bind the scrutinee's element slots.
// `(0, _)` used to fall to the lowerer's "unsupported pattern" skip and
// never matched. The second half of the card repro (the irrefutable
// `(a, b)` arm printing 5) is match_tuple_binding_arm.sio.

fn main() -> i32 with IO {
    let n = 0
    let m = 5
    match (n, m) {
        (0, _) => println("zero first"),
        _ => println("else"),
    }
    return 0
}
