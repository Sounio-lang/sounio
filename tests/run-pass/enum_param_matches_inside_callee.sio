//@ run-pass
//@ expect-stdout: enum param: PASS
// The control for option_box_survives_call_boundary.sio, and the measurement
// that narrows it. A plain sum type passed as a parameter and matched inside
// the callee works under BOTH engines, Madaros included.
//
// So Madaros does not mishandle sum types as arguments in general. What it
// mishandles is Option specifically, which is the one payload-carrying sum type
// the language has -- a user enum with a payload does not parse at all in the
// modular parser: `enum Talvez { Nada, Algo(i64) }` is a parse error on the
// variant with the payload.
//
// That is what makes this control worth committing: it puts the generic enum
// path and the argument ABI outside the suspect set, and leaves the special
// null-pointer representation of Option as the surface to look at.

enum Cor {
    Vermelho,
    Azul,
}

fn dentro(c: Cor) -> i64 with Mut, Alloc {
    match c {
        Cor::Vermelho => 1
        Cor::Azul => 2
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let c = Cor::Azul
    if dentro(c) == 2 {
        print("enum param: PASS\n")
    }
    return 0
}
