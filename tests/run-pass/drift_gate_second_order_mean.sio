//@ run-pass
//@ requires: madaros

// Drift-gate fixture for the `second_order_mean` builtin.
//
// Source marker `call_expr_is_builtin_second_order_mean` lives in
// self-hosted/check/check.sio (predicate used at type-check time to
// recognise a second-order-mean call expression). If the shipped
// Madaros predates that predicate, this fixture fails to type-check
// under `souc check`, and the drift gate row goes BEHIND on this
// branch.
//
// The second-order mean of x*x under a Knowledge<f64> measurement is
// μ² + σ²; the numerical value is not asserted here -- only that the
// call parses, type-checks, and binds to the builtin.

fn main() with IO, Epistemic {
    let k: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let x = k.value
    let _m2 = second_order_mean(x * x)
}