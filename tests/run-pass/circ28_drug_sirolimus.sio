//@ run-pass
//@ timeout: 180
//@ expect-stdout-contains: CIRC28_DRUG_SIROLIMUS_PASS
//
// Sirolimus on the circ28 drug record with LOCAL saturable erythrocyte binding
// (stdlib/darwin_pbpk/circ28_drug_sirolimus.sio, circ28_nl.sio). WHOLE-BLOOD concentrations, oral solution.
// Parameter table, sources, access levels and status of every value: header of the module.
//
// NO INTRAVENOUS HUMAN DATA WERE FOUND: V and CL are apparent and F = 0.14 (label) is declared, u 0.04.
//
// FITTED (so NOT validations), one observable each:
//   V_ss/F  pooled k = 2, N = 52 (Brattstrom 2000; Djebli 2006)              -> Kp scalar   (with F)
//   CL/F    pooled k = 3, N = 70 (Brattstrom 2000; Bottiger 2001; Djebli 2006) -> hepatic clint (with F)
//   F       0.14 (label, declared)                                           -> gut-wall clint
//   R24     C(24 h)/Cmax = 0.177 after 6 mg (Leelahavanichkul 2005, n = 12)  -> ps scalar (a RATE observable)
//   Tmax    pooled 1.225 h (label 1 h; Leelahavanichkul 1.45 h)              -> ka
// DERIVED: Bmax 475 ng/mL RBC (FKBP-12 capacity equal in moles to tacrolimus'), Kd 16.8 ng/mL plasma from the
//   IN-VITRO blood:plasma ratio 12.9 (Yatscoff 1993, abstract); ps_gut 11.33 L/h (tacrolimus surrogate).
//
// CRITERION. Observation with an inter-individual SD: |z| <= 2. Observation without spread: within the stated
// fold. Each row asserts a band around its measured outcome; a failure stays a failure, inside its band.
// A row whose study is inside a fitted pool is marked CONSISTENCY (not an independent test).
//
// PREDICTIONS, written before any validation quantity was computed. Seen before writing: the pooled values
// (CL/F 16.62 +/- 2.16 L/h, V_ss/F 1184 +/- 585 L), the fit constants (Kp scalar 0.468, bp_ref 12.58, ps scalar
// 0.149, ka 1.39 /h, clint, clgut), the R24 scan used by the fit (0.274 / 0.192 / 0.130 at s = 1 / 0.3 / 0.1)
// and the run time of the fit. NOT seen: any Cmax, AUC, half-life, trough, B:P of a run, interaction ratio,
// budget.
//   P0  input consistency: V_ss ln2/CL = 1184 x 0.693/16.62 = 49 h against the pooled healthy half-life 76 h:
//       ratio 0.65, room for a distribution phase (computed by hand before the run; printed by the test).
//   P1  terminal half-life 60 h (50-80): Brattstrom 82 +/- 12: z -1.8 PASS (borderline); Bottiger 79: ratio
//       0.76, fold 1.3: PASS at the edge; patients on ciclosporin 62 +/- 16 (Zimmerman & Kahan): z -0.1 PASS.
//   P2a Cmax 10 mg: 35 ng/mL (20-55) against 67 (Bottiger, geometric mean, n = 18), fold 1.5: FAIL (ratio 0.52).
//   P2b Cmax 6 mg: 21 ng/mL (12-33) against 25.3 +/- 6.1 (Leelahavanichkul): z -0.7 PASS. (The two studies
//       disagree per mg, 6.7 against 4.2 ng/mL/mg: one prediction cannot meet both.)
//   P2c C(24 h) 6 mg = R24 x Cmax = 3.7 ng/mL against 4.47 +/- 0.57: z -1.4 PASS (tied to P2b by the fitted R24).
//   P3a AUC_inf 10 mg = D/(CL/F) = 602 ng h/mL (570-620) against 736 (Bottiger; CONSISTENCY, in the pool):
//       ratio 0.82, fold 1.3 PASS.
//   P3b AUC(0-24) 6 mg: 150 ng h/mL (110-200) against 187.9 +/- 48.2: z -0.8 PASS.
//   P3c AUC_inf 6 mg x 1.27 (label: tablet 27 % above the solution) = 458 against 452 (Huang 2013, AUC 0-264 h,
//       6 mg tablets, n = 24): fold 1.3 PASS.
//   P4  steady state 2 mg/day (21 doses): trough 4.0 ng/mL (3.2-4.6), Cmax 8 (6-11), AUC(0-24) 120 (114-126).
//       Label Table 4 (de novo recipients WITH ciclosporin 4 h before): Cmin 7.1 +/- 3.5 (z -0.9), Cmax 14.4 +/-
//       5.3 (z -1.2), AUC 194 +/- 78 (z -0.95): PASS inside 2 SD, all three LOW, as expected without the
//       ciclosporin effect. What-if x 1.8 (label, single dose 4 h after ciclosporin: AUC +80 %): trough 7.2.
//       LAM patients, 2 mg/day tablets, no ciclosporin: median trough 6.8 (IQR 4.6-9.0): model x 1.27 = 5.1:
//       inside the IQR.
//   P5  Fh = 1 - Eh = 0.975 against 0.96 +/- 0.03 (Emoto 2013, in-vitro scaled): z +0.5 PASS.
//   P6a blood:plasma ratio of the venous pool at the 10 mg peak 11.5 (10-12.6), at 24 h after 6 mg 12.5:
//       label 36 +/- 18: z -1.35 PASS; Zimmerman & Kahan 38 +/- 13: z -2.0 (FAIL, at the edge); Ferron 30.9
//       (CV 48.5 %, SD 15): z -1.3 PASS; Brattstrom 36, healthy, no SD, fold 1.5: ratio 0.32 FAIL.
//       So the in-vitro-derived binding gives a third of the in-vivo ratio.
//   P6b concentration dependence: model B:P(100 ng/mL)/B:P(5 ng/mL) = 0.6 (0.5-0.7) against "no concentration
//       dependence" over 5-100 ug/L (Yatscoff 1993; also Ferron 1997), criterion 0.80-1.25: FAIL. Cause, if it
//       fails: the capacity Hct x Bmax = 206 ng/mL of blood is too small; the FKBP-12 equivalence with the
//       tacrolimus Bmax is not supported for sirolimus.
//   P7  dose linearity 0.6 to 16 mg (Brattstrom: 0.3-8 mg/m2, proportional): dose-normalised Cmax(16)/Cmax(0.6)
//       0.90 (0.80-0.97), AUC_inf 0.95 (0.88-0.99): inside 0.80-1.25 PASS, less than proportional.
//   P8  intravenous what-if (1 mg over 2 h): simulated F within 0.9-1.1 of 0.14; CL within 0.9-1.1 of the fit.
//   P9  interactions, WHAT-IFS (factor on the gut-wall clint g, on the hepatic clint h; the factor is SOLVED for
//       the observed AUC ratio in closed form, the Cmax ratio is then the prediction; criterion fold 1.3):
//       gut only (G): Cmax ratio ~ AUC ratio; liver only (H): Cmax ratio ~ 1.0-1.1.
//         diltiazem   AUC 1.60, Cmax 1.43:  G 1.55 PASS;  H 1.03 FAIL       -> needs the gut pathway
//         verapamil   AUC 2.2,  Cmax 2.3:   G 2.1 PASS;   H 1.05 FAIL       -> needs the gut pathway
//         erythromycin AUC 4.2, Cmax 4.4:   G 3.9 PASS;   H 1.1 FAIL        -> needs the gut pathway
//         ciclosporin (simultaneous) AUC 3.3, Cmax 2.16:  G 3.1 FAIL (1.44); H 1.1 FAIL -> gut needed, not enough
//         ketoconazole AUC 10.9, Cmax 4.3, half-life unchanged: G cannot reach it (ceiling (1 - Eh)/F = 6.9);
//             gut fully inhibited + hepatic factor 0.63: Cmax 6.5 FAIL (1.5), half-life x 1.6 against "unchanged".
//         rifampicin  AUC 0.18, Cmax 0.29:  same factor on gut and liver: Cmax 0.20 FAIL (0.69).
//   P10 single-ratio module, same parameters: |dCmax|/Cmax < 3 %, |dAUC(0-72)|/AUC < 1 %.
//   P11 budget (6 mg): u(AUC)/AUC 0.13 (0.11-0.16), CL/F more than 90 % of the variance, F below 1 %;
//       u(Cmax)/Cmax 0.5 (0.35-0.7), V_ss/F the largest share, then ps_gut and the ps scalar.
//   Mass balance < 1e-9; grid refinement moves Cmax and AUC_inf by < 5e-3 and the half-life by < 1e-2.
//
// RESULTS AGAINST THE PREDICTIONS: see the block RESULTS at the end of this header (written after the first run;
// nothing above was edited after it).
//
// RESULTS (first complete run, 2026-11-15; bands of the rows whose outcome differed from the prediction were set AFTER
// the run, around the measured value; nothing in the PREDICTIONS block was edited)
//   HIT:  P0 0.648; P1 64.7 h (z -1.44, ratio 0.82, z +0.17); P2a FAIL as predicted, but lower (26.1, ratio 0.39; predicted
//         35); P2b 16.3 (z -1.48); P3a 594 (ratio 0.81); P3b 147 (z -0.86); P3c 459 against 452; P4 trough 3.45, Cmax 8.9,
//         AUC 118.6 (z -1.04, -1.04, -0.97), x 1.8: 6.2 (z -0.25); P5 0.984 (z +0.80; predicted 0.975); P6a 11.4: label z
//         -1.37 PASS, Zimmerman & Kahan z -2.05 FAIL, Ferron z -1.30 PASS, Brattstrom ratio 0.32 FAIL, all as predicted;
//         P6b 0.585 FAIL as predicted; P7 0.865 / 0.947; P8 1.0005 / 0.999; P10 dCmax -0.32 %, dAUC +0.14 %; P11
//         u(AUC)/AUC 0.131 (CL/F 99.5 % of the variance, F 0.04 %), u(Cmax)/Cmax 0.36 (V_ss/F 53 %, ps_gut 15 %, ka 12 %,
//         Bmax 9 %, ps scalar 6 %).
//   MISSED:
//     P2c C(24 h) 2.90 against 4.47 +/- 0.57: z -2.75 FAIL (predicted PASS at z -1.4): it is R24 x Cmax and Cmax is low.
//     P4e LAM trough x 1.27 = 4.38 against 6.8: ratio 0.644, FAIL just outside fold 1.5 and just below the IQR (predicted 5.1).
//     P9, gut-only rows: the Cmax ratio is NOT close to the AUC ratio (predicted): the gut tissue releases the spared drug
//       slowly, so AUC rises more than Cmax: diltiazem 1.35 (predicted 1.55) PASS; ciclosporin 1.96 against 2.16 PASS
//       (predicted 3.1, FAIL: wrong).
//     P9 ceilings: the gut wall also clears ARTERIAL drug (Q_gut Eg = 33 % of the blood clearance), which the hand
//       estimate ignored: gut fully inhibited gives AUC x 10.4 (predicted 6.9), the liver alone at most x 3.1. Ketoconazole
//       (x 10.9) is 5 % above the gut ceiling; with the hepatic factor 0.95 added: Cmax x 2.94 against 4.3 (ratio 0.68, FAIL;
//       predicted 6.5, the wrong side) and CL/CL' 1.55 against an unchanged half-life (FAIL as predicted).
//     P9 rifampicin: same factor on gut and liver gives Cmax x 0.42 against 0.29 (FAIL, ratio 1.46; predicted 0.20, the
//       wrong side); gut-only induction (x 6.0) gives 0.24 (PASS, no prediction had been written); liver only 0.73 FAIL.
//     P9 verapamil and erythromycin: the header compared SINGLE-DOSE Cmax ratios with studies made at STEADY STATE (my
//       error, found after the first run: single-dose ratios 1.61 and 2.17). Rows replaced by steady-state runs, disclosed:
//       verapamil Cmax,ss x 1.85 against 2.3 PASS (ratio 0.80); erythromycin x 2.95 against 4.4 FAIL (ratio 0.67).
//   WHICH NEED THE GUT PATHWAY: all of them. Liver-only factors leave Cmax nearly unchanged (diltiazem 1.03, rifampicin
//     0.73) and cannot reach AUC x 3.3, x 4.2 or x 10.9 at all.
//   BUGS OF MINE found and fixed before the bands were set (no tuning): the standard grid had no sample at 24 h (C24 and
//     AUC(0-24) printed 0); a factor 0.001 too many in two fit-check rows; two fit rounds left R24 3 % off (three rounds: 0.5 %).
//   RUNTIME: compiled 3.8 s (fit 3 rounds on coarse grids, 4 h runs for interaction Cmax, 16-dose steady states on a 17
//     steps/day grid, budget by forward differences on a 51-step grid; refined-grid row: Cmax 5e-4, AUC 2e-5, t1/2 2e-4).
//
// COMPILER WORKAROUNDS (not fixes): Nl28Sys / Circ28Sys are created once, first in main; the first run on a
// fresh Nl28Sys is a discarded warm-up (lean_single returned a wrong first run in the tacrolimus test); every
// run is made in its own helper function; no struct is reassigned from a function of itself.
//
// Marker CIRC28_DRUG_SIROLIMUS_PASS.

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_blood::*
use darwin_pbpk::circ28_nl::*
use darwin_pbpk::circ28_drug_sirolimus::*
use math::pure::{exp, ln}

fn st_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn st_rel(tag: string, got: f64, want: f64, tol: f64) -> i32 with IO, Mut, Div, Panic {
    let r = st_abs(got - want) / st_abs(want)
    print("  "); print(tag); print(": got "); print(got); print(" want "); print(want)
    print("  rel = "); println(r)
    if !(r <= tol) {
        println("  [FAIL]")
        return 1
    }
    return 0
}

// One validation row. sd > 0: |z| <= 2; sd = 0: within `fold`. expect 1 pass, 0 fail. band_lo..band_hi bound
// z (sd > 0) or the ratio pred/obs (sd = 0). Returns 1 if the test must fail.
fn st_row(tag: string, pred: f64, obs: f64, sd: f64, fold: f64, expect: i32, band_lo: f64, band_hi: f64) -> i32 with IO, Mut, Div, Panic {
    var stat = pred / obs
    var pass = false
    if sd > 0.0 {
        stat = (pred - obs) / sd
        pass = st_abs(stat) <= 2.0
    } else {
        pass = stat <= fold && stat >= 1.0 / fold
    }
    print("  "); print(tag); print(": predicted "); print(pred); print("  observed "); print(obs)
    print("  ratio "); print(pred / obs)
    if sd > 0.0 {
        print("  z "); print(stat)
    }
    if pass { print("  PASS") } else { print("  FAIL") }
    var bad = 0
    if stat < band_lo || stat > band_hi {
        print("  [outside the asserted band]")
        bad = 1
    }
    if expect == 1 && !pass {
        print("  [expected pass]")
        bad = 1
    }
    if expect == 0 && pass {
        print("  [expected fail]")
        bad = 1
    }
    println("")
    return bad
}

fn st_rname(i: i32) -> string {
    if i == 0 { return "MW" }
    if i == 1 { return "logP" }
    if i == 2 { return "pKa1" }
    if i == 3 { return "pKa2" }
    if i == 4 { return "ion class" }
    if i == 5 { return "fu" }
    if i == 6 { return "B:P at C_ref" }
    if i == 7 { return "clint (hep)" }
    if i == 8 { return "clform" }
    if i == 9 { return "clint (gut)" }
    if i == 10 { return "cl renal" }
    if i == 11 { return "cl plasma" }
    if i == 12 { return "Kp scalar" }
    if i == 13 { return "ps scalar" }
    if i == 14 { return "ka" }
    if i == 15 { return "fa" }
    if i == 16 { return "tlag" }
    return "ps gut"
}

fn st_bname(i: i32) -> string {
    if i == 0 { return "logP" }
    if i == 1 { return "fu" }
    if i == 2 { return "Hct" }
    if i == 3 { return "Bmax" }
    if i == 4 { return "Kd" }
    if i == 5 { return "ps_gut" }
    if i == 6 { return "fa" }
    if i == 7 { return "V_ss/F obs" }
    if i == 8 { return "CL/F obs" }
    if i == 9 { return "F" }
    if i == 10 { return "ka" }
    return "ps scalar"
}

// Record values with the gut-wall and hepatic intrinsic clearances scaled by gs and hs.
fn st_theta(d: &Circ28Drug, gs: f64, hs: f64) -> [f64; 18] with Mut, Div, Panic, Epistemic {
    var th: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        th[i] = circ28_drug_value(d, i)
        i = i + 1
    }
    th[CD_CLGUT] = th[CD_CLGUT] * gs
    th[CD_CLINT] = th[CD_CLINT] * hs
    return th
}

// Single oral dose on the standard grid (488 h).
fn st_oral(d: &Circ28Drug, dose: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = circ28_drug_params_theta(st_theta(d, 1.0, 1.0))
    var dc = sir_cfg(dose)
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    return mtor_run(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysn)
}

fn st_oral_fine(d: &Circ28Drug, dose: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = circ28_drug_params_theta(st_theta(d, 1.0, 1.0))
    var dc = sir_cfg(dose)
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    dc.dt1 = 0.05
    dc.dt2 = 0.25
    dc.dt3 = 4.0
    return mtor_run(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysn)
}

// Budget grid: 0.2 h to 3 h, 3 h to 24 h, 16 h to 488 h.
fn st_cfg_budget(d: &Circ28Drug, dose: f64) -> MtorDose with Mut, Div, Panic, Epistemic {
    var dc = sir_cfg(dose)
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    dc.dt1 = 0.2
    dc.dt2 = 3.0
    dc.dt3 = 16.0
    return dc
}

fn st_oral_budget_grid(d: &Circ28Drug, dose: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = circ28_drug_params_theta(st_theta(d, 1.0, 1.0))
    let dc = st_cfg_budget(d, dose)
    return mtor_run(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysn)
}

// 4 h run (Cmax only) with scaled clearances.
fn st_oral_short(d: &Circ28Drug, dose: f64, gs: f64, hs: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = circ28_drug_params_theta(st_theta(d, gs, hs))
    var dc = mtor_cfg_oral(dose, 4.0, 100.0, 200.0)
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    return mtor_run(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysn)
}

// Steady state: 16 daily doses (6 model half-lives), clearances scaled by gs, hs; grid 0.25 h to 3 h, 3 h to 12 h,
// 6 h to 24 h; the last interval is recorded.
fn st_ss(d: &Circ28Drug, dose: f64, gs: f64, hs: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = circ28_drug_params_theta(st_theta(d, gs, hs))
    var dc = mtor_cfg_oral(dose, 24.0, 100.0, 200.0)
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    dc.ndose = 16
    dc.tau = 24.0
    dc.dt1 = 0.25
    dc.dt2 = 3.0
    dc.dt3 = 6.0
    return mtor_run(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysn)
}

// Intravenous what-if: 1 mg over 2 h.
fn st_iv(d: &Circ28Drug, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = circ28_drug_params_theta(st_theta(d, 1.0, 1.0))
    var dc = sir_cfg(1.0)
    dc.route = 0
    dc.t_inf = 2.0
    return mtor_run(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysn)
}

// Comparison grid of the single-ratio module: 0.1 h to 3 h, then 1 h to 72 h.
fn st_cmp_cfg(d: &Circ28Drug, t_end: f64) -> MtorDose with Mut, Div, Panic, Epistemic {
    var dc = mtor_cfg_oral(6.0, t_end, 100.0, 200.0)
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    dc.dt2 = 1.0
    dc.t2 = t_end
    dc.dt3 = 1.0
    return dc
}

fn st_cmp_nl(d: &Circ28Drug, t_end: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = circ28_drug_params_theta(st_theta(d, 1.0, 1.0))
    let dc = st_cmp_cfg(d, t_end)
    return mtor_run(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysn)
}

fn st_cmp_single(d: &Circ28Drug, sysc: &!Circ28Sys) -> MtorSingle with Mut, Div, Panic, Epistemic {
    let p = circ28_drug_params_theta(st_theta(d, 1.0, 1.0))
    let dc = st_cmp_cfg(d, 72.0)
    return mtor_run_single(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysc)
}

fn st_print_run(tag: string, r: &MtorRun) with IO, Mut, Div {
    print("  "); print(tag)
    print(": Cmax "); print(1000.0 * (*r).cmax); print(" ng/mL  Tmax "); print((*r).tmax)
    print(" h  C24 "); print(1000.0 * (*r).c24); print("  AUC24 "); print(1000.0 * (*r).auc_tau); print("  AUCinf "); print(1000.0 * (*r).auc_inf)
    print("  t1/2 "); print((*r).thalf); print(" h  bal "); print((*r).balance_err)
    print("  fails "); println((*r).nfail)
}

// S0: pools (printed), a guard computed a second way, the input-consistency check.
fn st_sec_pool() -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("S0 pooled observables (n-weighted mean; u = max(pooled standard error, between-study SD/sqrt k))")
    var a = mtor_pool_zero()
    sir_pool_clf(&!a)
    print("  CL/F (L/h), k = 3, N = 70: studies 20.294 (Brattstrom, SD 8.541, n 30), 13.587 (Bottiger, n 18), 14.1 (Djebli, n 22): mean ")
    print(mtor_pool_mean(&a)); print("  pooled SE "); print(mtor_pool_se(&a)); print("  between/sqrt k "); print(mtor_pool_between(&a)); print("  u "); println(mtor_pool_u(&a))
    // guard: the same pooled mean and between-study term written out by hand
    let m_hand = (30.0 * 0.278 * 73.0 + 18.0 * (10.0 / 0.736) + 22.0 * 14.1) / 70.0
    let x1 = 0.278 * 73.0
    let x2 = 10.0 / 0.736
    let x3 = 14.1
    let xm = (x1 + x2 + x3) / 3.0
    let b_hand = cd_sqrt(((x1 - xm) * (x1 - xm) + (x2 - xm) * (x2 - xm) + (x3 - xm) * (x3 - xm)) / 2.0) / cd_sqrt(3.0)
    fails = fails + st_rel("guard: pooled CL/F mean, second computation", sir_obs_clf(), m_hand, 1.0e-12)
    fails = fails + st_rel("guard: pooled CL/F u (between-study), second computation", sir_u_clf(), b_hand, 1.0e-9)
    var b = mtor_pool_zero()
    sir_pool_vssf(&!b)
    print("  V_ss/F (L), k = 2, N = 52: studies 1679 (Brattstrom, SD 730, n 30), 510 (Djebli, n 22): mean ")
    print(mtor_pool_mean(&b)); print("  pooled SE "); print(mtor_pool_se(&b)); print("  between/sqrt k "); print(mtor_pool_between(&b)); print("  u "); println(mtor_pool_u(&b))
    fails = fails + st_rel("guard: pooled V_ss/F mean, second computation", sir_obs_vssf(), (30.0 * 23.0 * 73.0 + 22.0 * 510.0) / 52.0, 1.0e-12)
    var c = mtor_pool_zero()
    sir_pool_thalf(&!c)
    print("  t1/2 healthy (h), k = 3, equal weights: 82, 79, 67.5: mean "); print(mtor_pool_mean(&c)); print("  u "); println(mtor_pool_u(&c))
    var e = mtor_pool_zero()
    sir_pool_tmax(&!e)
    print("  Tmax (h), k = 2, equal weights: 1.0, 1.45: mean "); print(mtor_pool_mean(&e)); print("  u "); println(mtor_pool_u(&e))
    println("S0b input-consistency check (before any structure): V_ss ln2 / CL against the pooled terminal half-life")
    let tchk = sir_obs_vssf() * 0.6931471805599453 / sir_obs_clf()
    print("  V_ss/F ln2 / (CL/F) = "); print(tchk); print(" h;  pooled healthy t1/2 "); print(mtor_pool_mean(&c)); print(" h;  ratio "); println(tchk / mtor_pool_mean(&c))
    fails = fails + st_row("P0 V_ss ln2/CL over pooled t1/2  pred 0.65: must be < 1", tchk / mtor_pool_mean(&c), 1.0, 0.0, 2.0, 1, 0.55, 0.75)
    print("  ciclosporin-comedicated patients (NOT pooled): Zimmerman & Kahan 12 L/kg, 208 mL/h/kg -> V ln2/CL = ")
    print(12.0 * 0.6931471805599453 / 0.208); println(" h against their 62 h")
    return fails
}

// S1: the record and the fits against their own observables.
fn st_sec_fit(d: &Circ28Drug, sysn: &!Nl28Sys) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("S1 parameter record (value, standard uncertainty, status)")
    var i: i32 = 0
    while i < 18 {
        print("  "); print(i); print(" "); print(st_rname(i)); print("  value "); print(circ28_drug_value(d, i))
        print("  u "); print(cd_sqrt(circ28_drug_variance(d, i))); print("  status "); println((*d).status[i])
        i = i + 1
    }
    print("  binding: Hct 0.434, Bmax "); print(1000.0 * sir_bmax()); print(" ng/mL RBC (u 50 %), in-vitro bp0 "); print(sir_bp0()); print(" (u "); print(sir_u_bp0())
    print("), Kd "); print(1000.0 * sir_kd()); print(" ng/mL plasma (u "); print(1000.0 * sir_u_kd()); println(")")
    println("S2 the fits reproduce their observables (these are NOT validations)")
    let o = sir_obs_base()
    let th = st_theta(d, 1.0, 1.0)
    let p = circ28_drug_params_theta(th)
    let bp = circ28_drug_value(d, CD_BP)
    print("  C_ref (ng/mL) "); println(1000.0 * o.cref)
    fails = fails + st_rel("V_ss plasma-referred = F V_ss/F x bp_ref", circ28_vss_plasma(p), o.vss * bp, 1.0e-9)
    fails = fails + st_rel("blood CL (L/h) = F x pooled CL/F", circ28_splanchnic_clearance(p), o.cl, 1.0e-9)
    let fcl = circ28_drug_value(d, CD_FA) * circ28_gut_availability(p) * (1.0 - circ28_hepatic_extraction(p))
    fails = fails + st_rel("F = fa Fg (1 - Eh) = 0.14", fcl, 0.14, 1.0e-9)
    print("  Fg "); print(circ28_gut_availability(p)); print("  Eh "); print(circ28_hepatic_extraction(p)); print("  Eg "); println(circ28_gut_extraction(p))
    let r24 = sir_r24_at(st_theta(d, 1.0, 1.0), o, circ28_drug_value(d, CD_PSSC), circ28_drug_value(d, CD_KA), sysn)
    fails = fails + st_rel("R24 = C(24 h)/Cmax at the record (fit check)", r24, sir_obs_r24(), 1.0e-2)
    let tm = mtor_tmax_at(p, o.hct, o.bmax, o.kd, 6.0, th[CD_FA], th[CD_KA], sysn)
    fails = fails + st_rel("Tmax at the record (fit check)", tm, sir_obs_tmax(), 1.0e-2)
    print("  ps scalar bounds: s_min (hepatic fit exists) "); print(mtor_ps_min(th, o)); println(", upper bound 1 (flow-limited)")
    return fails
}

// One single-dose interaction what-if. mode: see mtor_ddi_solve. Prints the solved factor, the closed-form AUC
// and CL ratios and the simulated Cmax ratio (4 h runs, 10 mg). Returns the Cmax ratio, -1 when the AUC ratio
// is not reachable in that mode.
fn st_ddi(tag: string, d: &Circ28Drug, mode: i32, ra: f64, cbase: f64, sysn: &!Nl28Sys) -> f64 with IO, Mut, Div, Panic, Epistemic {
    let th = st_theta(d, 1.0, 1.0)
    let x = mtor_ddi_solve(th, mode, ra)
    print("  "); print(tag); print(": AUC ratio target "); print(ra)
    if x < 0.0 {
        var g0 = 0.0
        var h0 = 1.0
        if mode == 1 {
            g0 = 1.0
            h0 = 0.0
        }
        print("  NOT REACHABLE; ceiling of the AUC ratio "); println(mtor_auc_ratio(th, g0, h0))
        return 0.0 - 1.0
    }
    var g = x
    var h = 1.0
    if mode == 1 {
        g = 1.0
        h = x
    }
    if mode == 2 { h = x }
    if mode == 3 {
        g = 0.0
        h = x
    }
    let r = st_oral_short(d, 10.0, g, h, sysn)
    print("  factor "); print(x); print("  AUC ratio closed form "); print(mtor_auc_ratio(th, g, h))
    print("  CL'/CL "); print(mtor_cl_ratio(th, g, h)); print("  Cmax ratio simulated "); println(r.cmax / cbase)
    return r.cmax / cbase
}

// Steady-state interaction what-if (2 mg/day, 16 doses), gut-wall factor solved for the AUC ratio: returns the
// ratio of the steady-state Cmax; prints the simulated AUC(0-24) ratio next to the closed form.
fn st_ddi_ss(tag: string, d: &Circ28Drug, ra: f64, base: &MtorRun, sysn: &!Nl28Sys) -> f64 with IO, Mut, Div, Panic, Epistemic {
    let th = st_theta(d, 1.0, 1.0)
    let g = mtor_ddi_solve(th, 0, ra)
    let r = st_ss(d, 2.0, g, 1.0, sysn)
    print("  "); print(tag); print(": AUC ratio target "); print(ra); print("  gut factor "); print(g)
    print("  simulated AUC(0-24),ss ratio "); print(r.auc_tau / (*base).auc_tau); print("  Cmax,ss ratio "); println(r.cmax / (*base).cmax)
    return r.cmax / (*base).cmax
}

fn st_unreach(tag: string, x: f64) -> i32 with IO, Mut, Div, Panic {
    if x < 0.0 {
        print("  "); print(tag); println(": not reachable, as asserted")
        return 0
    }
    print("  "); print(tag); println(": [FAIL] expected NOT reachable")
    return 1
}

fn st_sec_ddi(d: &Circ28Drug, rss: &MtorRun, sysn: &!Nl28Sys) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("V9 interaction WHAT-IFS (factor solved for the observed AUC ratio; the Cmax ratio is the prediction; fold 1.3)")
    println("   G: gut-wall clint x g, liver unchanged.  H: hepatic clint x h, gut unchanged.")
    let rb = st_oral_short(d, 10.0, 1.0, 1.0, sysn)
    let cb = rb.cmax
    let th = st_theta(d, 1.0, 1.0)
    print("  ceilings of the AUC ratio: gut wall fully inhibited "); print(mtor_auc_ratio(th, 0.0, 1.0)); print(";  liver fully inhibited "); println(mtor_auc_ratio(th, 1.0, 0.0))
    println("  single-dose studies (label): diltiazem 120 mg, ciclosporin 300 mg simultaneous, ketoconazole, rifampicin")
    let dg = st_ddi("diltiazem G  ", d, 0, 1.60, cb, sysn)
    let dh = st_ddi("diltiazem H  ", d, 1, 1.60, cb, sysn)
    fails = fails + st_row("P9a diltiazem G Cmax ratio  obs 1.43 (90 % CI 1.14-1.81)  pred 1.55", dg, 1.43, 0.0, 1.3, 1, 0.9, 1.0)
    fails = fails + st_row("P9a diltiazem H Cmax ratio  obs 1.43                       pred 1.03", dh, 1.43, 0.0, 1.3, 0, 0.68, 0.769)
    let cg = st_ddi("ciclosporin G", d, 0, 3.3, cb, sysn)
    fails = fails + st_row("P9b ciclosporin G Cmax ratio  obs 2.16   pred 3.1 FAIL (prediction WRONG)", cg, 2.16, 0.0, 1.3, 1, 0.85, 0.97)
    fails = fails + st_unreach("P9b ciclosporin H (AUC x 3.3 by the liver alone)", mtor_ddi_solve(th, 1, 3.3))
    fails = fails + st_unreach("P9c ketoconazole G (AUC x 10.9 by the gut wall alone)", mtor_ddi_solve(th, 0, 10.9))
    let km = st_ddi("ketoconazole, gut fully inhibited + hepatic factor", d, 3, 10.9, cb, sysn)
    let hk = mtor_ddi_solve(th, 3, 10.9)
    fails = fails + st_row("P9c ketoconazole mixed Cmax ratio  obs 4.3   pred 6.5 (WRONG side)   ", km, 4.3, 0.0, 1.3, 0, 0.62, 0.769)
    fails = fails + st_row("P9c ketoconazole mixed half-life ratio CL/CL'  obs 1.0 (unchanged), fold 1.25", 1.0 / mtor_cl_ratio(th, 0.0, hk), 1.0, 0.0, 1.25, 0, 1.4, 1.7)
    let rr = st_ddi("rifampicin, same factor on gut and liver", d, 2, 0.18, cb, sysn)
    let rg = st_ddi("rifampicin G ", d, 0, 0.18, cb, sysn)
    let rh = st_ddi("rifampicin H ", d, 1, 0.18, cb, sysn)
    fails = fails + st_row("P9d rifampicin both Cmax ratio  obs 0.29   pred 0.20 (WRONG side)      ", rr, 0.29, 0.0, 1.3, 0, 1.3001, 1.65)
    fails = fails + st_row("P9d rifampicin G Cmax ratio  obs 0.29 (no prediction written)         ", rg, 0.29, 0.0, 1.3, 1, 0.77, 0.9)
    fails = fails + st_row("P9d rifampicin H Cmax ratio  obs 0.29 (no prediction written)         ", rh, 0.29, 0.0, 1.3, 0, 2.2, 2.8)
    println("  steady-state studies (label; sirolimus 2 mg/day with verapamil 180 mg q12h, erythromycin 800 mg q8h): the")
    println("  comparison is made at steady state, where Cmax carries the accumulated trough (the header's single-dose P9 rows")
    println("  for these two were the WRONG experiment: single-dose Cmax ratios are printed, steady-state ratios are asserted)")
    let vg1 = st_ddi("verapamil G, single dose (not the study design)", d, 0, 2.2, cb, sysn)
    let eg1 = st_ddi("erythromycin G, single dose (not the study design)", d, 0, 4.2, cb, sysn)
    let vg = st_ddi_ss("verapamil G, steady state   ", d, 2.2, rss, sysn)
    let eg = st_ddi_ss("erythromycin G, steady state", d, 4.2, rss, sysn)
    fails = fails + st_row("P9e verapamil G Cmax,ss ratio  obs 2.3                                 ", vg, 2.3, 0.0, 1.3, 1, 0.77, 1.3)
    fails = fails + st_row("P9f erythromycin G Cmax,ss ratio  obs 4.4                              ", eg, 4.4, 0.0, 1.3, 0, 0.6, 0.769)
    fails = fails + st_unreach("P9f erythromycin H (AUC x 4.2 by the liver alone)", mtor_ddi_solve(th, 1, 4.2))
    if !(vg1 > 0.0 && eg1 > 0.0) { fails = fails + 1 }
    return fails
}

fn st_sec_cmp(d: &Circ28Drug, sysn: &!Nl28Sys, sysc: &!Circ28Sys) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("V10 single-ratio module (circ28_blood) against the local stepper, same parameters and grid, 6 mg")
    let cw = st_cmp_nl(d, 12.0, sysn)
    let cn = st_cmp_nl(d, 72.0, sysn)
    let cs = st_cmp_single(d, sysc)
    print("  Cmax local "); print(1000.0 * cn.cmax); print("  single-ratio "); print(1000.0 * cs.cmax); print("  dCmax "); print(100.0 * (cs.cmax - cn.cmax) / cn.cmax); println(" %")
    print("  AUC(0-72) local "); print(1000.0 * cn.auc_t); print("  single-ratio "); print(1000.0 * cs.auc_t); print("  dAUC "); print(100.0 * (cs.auc_t - cn.auc_t) / cn.auc_t); println(" %")
    print("  single-ratio bp range used "); print(cs.bp_min); print(" - "); println(cs.bp_max)
    if !(st_abs(cs.cmax - cn.cmax) / cn.cmax < 0.03) {
        println("  [FAIL] |dCmax|/Cmax >= 3 %")
        fails = fails + 1
    }
    if !(st_abs(cs.auc_t - cn.auc_t) / cn.auc_t < 0.01) {
        println("  [FAIL] |dAUC|/AUC >= 1 %")
        fails = fails + 1
    }
    return fails
}

// The budget itself is computed in main (one frame less): called from this section function, lean_single returned a
// base run off by 2e-4 (sirolimus) and 2.4 % (everolimus), measured 2026-11-15; from main it agrees with Madaros.
fn st_sec_budget(d: &Circ28Drug, r6: &MtorRun, rbp: &MtorRun, budp: &MtorBudget, u_v: f64) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("S4 uncertainty budget with refit, 6 mg oral (twelve inputs; closed-form fits redone at every perturbation)")
    fails = fails + st_rel("budget grid AUC_inf against the standard grid", (*rbp).auc_inf, (*r6).auc_inf, 5.0e-3)
    fails = fails + st_rel("budget grid Cmax against the standard grid", (*rbp).cmax, (*r6).cmax, 1.0e-2)
    let thb = st_theta(d, 1.0, 1.0)
    let z0 = sir_z0(thb)
    let u = sir_u_all(cd_sqrt(circ28_drug_variance(d, CD_KA)), cd_sqrt(circ28_drug_variance(d, CD_PSSC)))
    print("  runs "); println((*budp).runs)
    print("  AUC_inf "); print((*budp).auc * 1000.0); print(" ng h/mL  u "); print(cd_sqrt((*budp).var_auc) * 1000.0); print("  (rel "); print(cd_sqrt((*budp).var_auc) / (*budp).auc); println(")")
    print("  Cmax    "); print((*budp).cmax * 1000.0); print(" ng/mL    u "); print(cd_sqrt((*budp).var_cmax) * 1000.0); print("  (rel "); print(cd_sqrt((*budp).var_cmax) / (*budp).cmax); println(")")
    println("  input       u          dlnAUC/dlnx   share of var(AUC) %   dlnCmax/dlnx  share of var(Cmax) %")
    var j: i32 = 0
    var sh_a = 0.0
    var sh_c = 0.0
    while j < 12 {
        let la = (*budp).sens_auc[j] * z0[j] / (*budp).auc
        let lc = (*budp).sens_cmax[j] * z0[j] / (*budp).cmax
        print("  "); print(st_bname(j)); print("   "); print(u[j]); print("   "); print(la); print("   "); print(100.0 * (*budp).contrib_auc[j] / (*budp).var_auc)
        print("   "); print(lc); print("   "); println(100.0 * (*budp).contrib_cmax[j] / (*budp).var_cmax)
        sh_a = sh_a + (*budp).contrib_auc[j] / (*budp).var_auc
        sh_c = sh_c + (*budp).contrib_cmax[j] / (*budp).var_cmax
        j = j + 1
    }
    fails = fails + st_rel("budget AUC = the 6 mg run (same grid, refit path)", (*budp).auc, (*rbp).auc_inf, 1.0e-6)
    fails = fails + st_rel("shares of var(AUC) add to 1", sh_a, 1.0, 1.0e-9)
    fails = fails + st_rel("shares of var(Cmax) add to 1", sh_c, 1.0, 1.0e-9)
    fails = fails + st_row("P11 u(AUC)/AUC   predicted 0.13 (0.11-0.16)", cd_sqrt((*budp).var_auc) / (*budp).auc, 0.13, 0.0, 1.25, 1, 0.8, 1.25)
    fails = fails + st_row("P11 u(Cmax)/Cmax predicted 0.5 (0.35-0.7)  ", cd_sqrt((*budp).var_cmax) / (*budp).cmax, 0.5, 0.0, 1.4, 1, 0.7, 1.4)
    fails = fails + st_row("P11 share of CL/F in var(AUC)  predicted > 0.90", (*budp).contrib_auc[8] / (*budp).var_auc, 0.95, 0.0, 1.06, 1, 0.94, 1.06)
    return fails
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var sysr = nl28_sys_zero()
    var sysn = nl28_sys_zero()
    var sysc = circ28_sys_zero()
    var d = circ28_drug_new()
    sir_drug_into(&!d, &!sysr)
    let warm = st_oral_short(&d, 6.0, 1.0, 1.0, &!sysn)
    fails = fails + st_sec_cmp(&d, &!sysn, &!sysc)
    fails = fails + st_sec_pool()
    fails = fails + st_sec_fit(&d, &!sysr)

    println("R runs (whole blood; venous pool)")
    let r6 = st_oral(&d, 6.0, &!sysn)
    st_print_run("oral 6 mg ", &r6)
    let r6f = st_oral_fine(&d, 6.0, &!sysn)
    st_print_run("oral 6 mg, grid refined", &r6f)
    let r10 = st_oral(&d, 10.0, &!sysn)
    st_print_run("oral 10 mg", &r10)
    let r06 = st_oral(&d, 0.6, &!sysn)
    st_print_run("oral 0.6 mg", &r06)
    let r16 = st_oral(&d, 16.0, &!sysn)
    st_print_run("oral 16 mg", &r16)
    let riv = st_iv(&d, &!sysn)
    st_print_run("IV what-if 1 mg over 2 h", &riv)
    let rss = st_ss(&d, 2.0, 1.0, 1.0, &!sysn)
    print("  steady state 2 mg/day, dose 16: Cmax "); print(1000.0 * rss.cmax); print(" ng/mL  Tmax "); print(rss.tmax); print(" h  trough C(24) "); print(1000.0 * rss.c_tau)
    print("  AUC(0-24) "); print(1000.0 * rss.auc_tau); print("  bal "); println(rss.balance_err)

    println("C numerical checks")
    fails = fails + st_rel("mass balance oral 6 mg", r6.balance_err + 1.0, 1.0, 1.0e-9)
    fails = fails + st_rel("mass balance 16 mg", r16.balance_err + 1.0, 1.0, 1.0e-9)
    fails = fails + st_rel("mass balance IV", riv.balance_err + 1.0, 1.0, 1.0e-9)
    fails = fails + st_rel("mass balance steady state", rss.balance_err + 1.0, 1.0, 1.0e-9)
    if !(r6.ok && r6f.ok && r10.ok && r06.ok && r16.ok && riv.ok && rss.ok && warm.ok) {
        println("  [FAIL] a run did not complete")
        fails = fails + 1
    }
    if !(r6.nfail == 0 && r16.nfail == 0 && rss.nfail == 0) {
        println("  [FAIL] failed Newton steps")
        fails = fails + 1
    }
    if !(r6.fit_ok && r10.fit_ok && riv.fit_ok) {
        println("  [FAIL] terminal fit not valid")
        fails = fails + 1
    }
    fails = fails + st_rel("grid refinement: Cmax", r6f.cmax, r6.cmax, 5.0e-3)
    fails = fails + st_rel("grid refinement: AUC_inf", r6f.auc_inf, r6.auc_inf, 5.0e-3)
    fails = fails + st_rel("grid refinement: t1/2", r6f.thalf, r6.thalf, 1.0e-2)

    println("V validation, predicted against observed (whole blood)")
    fails = fails + st_row("P1a t1/2 (h)  Brattstrom 2000 healthy, n=30              ", r6.thalf, 82.0, 12.0, 0.0, 1, -2.0, 0.0)
    fails = fails + st_row("P1b t1/2 (h)  Bottiger 2001 healthy, fold 1.3            ", r10.thalf, 79.0, 0.0, 1.3, 1, 0.77, 1.0)
    fails = fails + st_row("P1c t1/2 (h)  Zimmerman & Kahan 1997 patients + CsA      ", r6.thalf, 62.0, 16.0, 0.0, 1, -1.0, 1.0)
    fails = fails + st_row("P2a Cmax 10 mg (ng/mL)  Bottiger 2001, fold 1.5          ", 1000.0 * r10.cmax, 67.0, 0.0, 1.5, 0, 0.3, 0.6666)
    fails = fails + st_row("P2b Cmax 6 mg (ng/mL)  Leelahavanichkul 2005             ", 1000.0 * r6.cmax, 25.3, 6.1, 0.0, 1, -2.0, 1.5)
    fails = fails + st_row("P2c C(24 h) 6 mg (ng/mL)  Leelahavanichkul (tied to P2b by R24)", 1000.0 * r6.c24, 4.47, 0.57, 0.0, 0, -3.1, -2.4)
    fails = fails + st_row("P3a AUC_inf 10 mg (ng h/mL)  Bottiger 736 (CONSISTENCY), fold 1.3", 1000.0 * r10.auc_inf, 736.0, 0.0, 1.3, 1, 0.77, 0.86)
    fails = fails + st_rel("P3a AUC_inf 10 mg against D/(CL/F) (the fit; binding non-linearity within 6 %)", r10.auc_inf, 10.0 / sir_obs_clf(), 6.0e-2)
    fails = fails + st_row("P3b AUC(0-24) 6 mg (ng h/mL)  Leelahavanichkul 2005      ", 1000.0 * r6.auc_tau, 187.9, 48.2, 0.0, 1, -2.0, 1.0)
    fails = fails + st_row("P3c AUC_inf 6 mg x 1.27 (tablet)  Huang 2013 AUC(0-264) 452, fold 1.3", 1270.0 * r6.auc_inf, 452.0, 0.0, 1.3, 1, 0.8, 1.2)
    println("  steady state 2 mg/day against label Table 4 (de novo recipients WITH ciclosporin)")
    fails = fails + st_row("P4a trough (ng/mL)  label 7.1 +/- 3.5                    ", 1000.0 * rss.c_tau, 7.1, 3.5, 0.0, 1, -1.5, 0.0)
    fails = fails + st_row("P4b Cmax,ss (ng/mL)  label 14.4 +/- 5.3                  ", 1000.0 * rss.cmax, 14.4, 5.3, 0.0, 1, -2.0, 0.0)
    fails = fails + st_row("P4c AUC(0-24),ss (ng h/mL)  label 194 +/- 78             ", 1000.0 * rss.auc_tau, 194.0, 78.0, 0.0, 1, -1.5, 0.0)
    fails = fails + st_rel("P4c AUC(0-24),ss against D/(CL/F) (the fit)", rss.auc_tau, 2.0 / sir_obs_clf(), 6.0e-2)
    fails = fails + st_row("P4d what-if trough x 1.8 (ciclosporin 4 h before, label)  ", 1800.0 * rss.c_tau, 7.1, 3.5, 0.0, 1, -1.0, 1.0)
    fails = fails + st_row("P4e what-if trough x 1.27 (tablet)  LAM median 6.8 (IQR 4.6-9.0), fold 1.5", 1270.0 * rss.c_tau, 6.8, 0.0, 1.5, 0, 0.6, 0.6666)
    let th = st_theta(&d, 1.0, 1.0)
    let p = circ28_drug_params_theta(th)
    fails = fails + st_row("P5  Fh = 1 - Eh  Emoto 2013 0.96 +/- 0.03                ", 1.0 - circ28_hepatic_extraction(p), 0.96, 0.03, 0.0, 1, 0.0, 1.0)
    fails = fails + st_row("    Fg  Emoto 2013 0.16 +/- 0.10 (CONSISTENCY: F is fitted)", circ28_gut_availability(p), 0.16, 0.10, 0.0, 1, -0.5, 0.5)
    println("V6 blood:plasma ratio of the venous pool (model: local relation)")
    print("  at the 10 mg peak "); print(r10.bp_peak); print("  24 h after 6 mg "); print(r6.bp24); print("  at the steady-state trough "); println(rss.bp_end)
    fails = fails + st_row("P6a B:P at the 10 mg peak  label 36 +/- 18               ", r10.bp_peak, 36.0, 18.0, 0.0, 1, -1.6, -1.0)
    fails = fails + st_row("P6a B:P  Zimmerman & Kahan 38 +/- 13                     ", r10.bp_peak, 38.0, 13.0, 0.0, 0, -2.3, -2.0001)
    fails = fails + st_row("P6a B:P  Ferron 30.9 (SD 15)                             ", r10.bp_peak, 30.9, 15.0, 0.0, 1, -1.6, -1.0)
    fails = fails + st_row("P6a B:P  Brattstrom 36 healthy (no SD), fold 1.5         ", r10.bp_peak, 36.0, 0.0, 1.5, 0, 0.25, 0.4)
    let b5 = nl28_bp_local(mtor_hct(), sir_bmax(), sir_kd(), 0.005)
    let b100 = nl28_bp_local(mtor_hct(), sir_bmax(), sir_kd(), 0.100)
    print("  binding relation: B:P at 5 ng/mL "); print(b5); print("  at 100 ng/mL "); println(b100)
    fails = fails + st_row("P6b B:P(100)/B:P(5)  observed: no dependence (Yatscoff), 0.80-1.25", b100 / b5, 1.0, 0.0, 1.25, 0, 0.5, 0.7)
    println("V7 dose linearity (Brattstrom 2000: proportional over 0.3-8 mg/m2)")
    fails = fails + st_row("P7a Cmax(16)/Cmax(0.6) dose-normalised, 0.80-1.25        ", (r16.cmax / 16.0) / (r06.cmax / 0.6), 1.0, 0.0, 1.25, 1, 0.80, 0.97)
    fails = fails + st_row("P7b AUC_inf(16)/AUC_inf(0.6) dose-normalised, 0.80-1.25  ", (r16.auc_inf / 16.0) / (r06.auc_inf / 0.6), 1.0, 0.0, 1.25, 1, 0.88, 0.99)
    println("V8 intravenous what-if (no observation exists)")
    let f_sim = (r6.auc_inf / 6.0) / (riv.auc_inf / 1.0)
    print("  simulated F "); print(f_sim); print("  IV CL (L/h) "); print(1.0 / riv.auc_inf); print("  V_ss by NCA (L) "); print(riv.vss_nca); print("  IV t1/2 "); println(riv.thalf)
    fails = fails + st_row("P8a simulated F / 0.14                                   ", f_sim, 0.14, 0.0, 1.1, 1, 0.9, 1.1)
    fails = fails + st_row("P8b IV CL simulated / fitted blood CL                    ", 1.0 / riv.auc_inf, sir_f() * sir_obs_clf(), 0.0, 1.1, 1, 0.9, 1.1)

    fails = fails + st_sec_ddi(&d, &rss, &!sysn)
    let rbg = st_oral_budget_grid(&d, 6.0, &!sysn)
    let thb = st_theta(&d, 1.0, 1.0)
    let bud = mtor_budget(sir_z0(thb), sir_u_all(cd_sqrt(circ28_drug_variance(&d, CD_KA)), cd_sqrt(circ28_drug_variance(&d, CD_PSSC))), thb, sir_cref(), st_cfg_budget(&d, 6.0), &!sysn)
    fails = fails + st_sec_budget(&d, &r6, &rbg, &bud, 0.0)
    if fails == 0 {
        println("CIRC28_DRUG_SIROLIMUS_PASS")
        return 0
    }
    println("CIRC28_DRUG_SIROLIMUS_FAIL")
    return 1
}
