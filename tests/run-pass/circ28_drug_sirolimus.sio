//   New rows: Cmax/AUC_inf FAIL (0.0442 against 0.0910, ratio 0.49); k PASS; Tmax consistency; Cmax/AUC(0-24) PASS (ratio 0.92).
//   Column B against A (all rows logged, 39): PASS in A and FAIL in B: P4e, P9b, P9e, k against Djebli; FAIL in A and PASS in B: t1/2
//   Bottiger. Decision: B NOT adopted; sir_gut() = 0 (all-organ Kp scalar).
//   D-S (diagnostic, nothing adopted): Bottiger 2001 is INSIDE the CL/F pool (13.59 L/h, n 18); without it the pool is 17.67 L/h
//   and the AUC gap widens (ratio 0.817 -> 0.769); with Huang 2013 tablets/1.27 added the pool is 16.68 L/h (ratio 0.814); the
//   geometric/arithmetic bracket exp(s^2/2) is 1.046-1.133 on Bottiger's CL/F (CV not in the abstract). Pool kept, no study dropped.
//   REMAINING FAILURES: Cmax 10 mg (ratio 0.39) and Cmax/AUC_inf (0.49) and C(24 h) (z -2.74), B:P (0.30-0.32, and no concentration
//   dependence), t1/2 Bottiger (0.74), the interaction Cmax rows (diltiazem H, ketoconazole, rifampicin both/H, erythromycin).
//   RUNTIME: compiled 4.8-5.0 s (original single-column test 3.3 s on the same machine and session): column B skips the numerical
//   checks (grid refinement, single-ratio comparison); the fit alternates two rounds from converged starting values of k.
//
// COMPILER WORKAROUNDS (not fixes): Nl28Sys / Circ28Sys are created once, first in main; the first run on a
// fresh Nl28Sys is a discarded warm-up (lean_single returned a wrong first run in the tacrolimus test); every
// run is made in its own helper function; no struct is reassigned from a function of itself.
//
// Marker CIRC28_DRUG_SIROLIMUS_PASS.

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_blood::*
use darwin_pbpk::circ28_nl::*
use darwin_pbpk::circ28_drug_sirolimus::*
use math::pure::{exp, ln}

fn st_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn st_rel(tag: string, got: f64, want: f64, tol: f64) -> i32 with IO, Mut, Div, Panic {
    let r = st_abs(got - want) / st_abs(want)
    print("  "); print(tag); print(": got "); print(got); print(" want "); print(want)
    print("  rel = "); println(r)
    if !(r <= tol) {
        println("  [FAIL]")
        return 1
    }
    return 0
}

// One validation row. sd > 0: |z| <= 2; sd = 0: within `fold`. expect 1 pass, 0 fail. band_lo..band_hi bound
// z (sd > 0) or the ratio pred/obs (sd = 0). Returns 1 if the test must fail.
fn st_row(ct: &![i32; 100], tag: string, pred: f64, obs: f64, sd: f64, fold: f64, expect: i32, band_lo: f64, band_hi: f64) -> i32 with IO, Mut, Div, Panic {
    var stat = pred / obs
    var pass = false
    if sd > 0.0 {
        stat = (pred - obs) / sd
        pass = st_abs(stat) <= 2.0
    } else {
        pass = stat <= fold && stat >= 1.0 / fold
    }
    print("  "); print(tag); print(": predicted "); print(pred); print("  observed "); print(obs)
    print("  ratio "); print(pred / obs)
    if sd > 0.0 {
        print("  z "); print(stat)
    }
    if pass { print("  PASS") } else { print("  FAIL") }
    // verdict log of this column (ct[0] = number of rows so far, ct[1 + i] = 1 when row i passes); ct[99] = 1: the
    // column is the ADOPTED one and its bands are asserted; 0: printed only (the verdicts are compared in main)
    let ri = ct[0]
    if ri < 90 {
        ct[1 + ri] = 0
        if pass { ct[1 + ri] = 1 }
    }
    ct[0] = ri + 1
    var bad = 0
    if ct[99] == 1 {
        if stat < band_lo || stat > band_hi {
            print("  [outside the asserted band]")
            bad = 1
        }
        if expect == 1 && !pass {
            print("  [expected pass]")
            bad = 1
        }
        if expect == 0 && pass {
            print("  [expected fail]")
            bad = 1
        }
    }
    println("")
    return bad
}

fn st_rname(i: i32) -> string {
    if i == 0 { return "MW" }
    if i == 1 { return "logP" }
    if i == 2 { return "pKa1" }
    if i == 3 { return "pKa2" }
    if i == 4 { return "ion class" }
    if i == 5 { return "fu" }
    if i == 6 { return "B:P at C_ref" }
    if i == 7 { return "clint (hep)" }
    if i == 8 { return "clform" }
    if i == 9 { return "clint (gut)" }
    if i == 10 { return "cl renal" }
    if i == 11 { return "cl plasma" }
    if i == 12 { return "Kp scalar" }
    if i == 13 { return "ps scalar" }
    if i == 14 { return "ka" }
    if i == 15 { return "fa" }
    if i == 16 { return "tlag" }
    return "ps gut"
}

fn st_bname(i: i32) -> string {
    if i == 0 { return "logP" }
    if i == 1 { return "fu" }
    if i == 2 { return "Hct" }
    if i == 3 { return "Bmax" }
    if i == 4 { return "Kd" }
    if i == 5 { return "ps_gut" }
    if i == 6 { return "fa" }
    if i == 7 { return "V_ss/F obs" }
    if i == 8 { return "CL/F obs" }
    if i == 9 { return "F" }
    if i == 10 { return "ka" }
    return "ps scalar"
}

// Record values with the gut-wall and hepatic intrinsic clearances scaled by gs and hs.
fn st_theta(d: &Circ28Drug, gs: f64, hs: f64) -> [f64; 18] with Mut, Div, Panic, Epistemic {
    var th: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        th[i] = circ28_drug_value(d, i)
        i = i + 1
    }
    th[CD_CLGUT] = th[CD_CLGUT] * gs
    th[CD_CLINT] = th[CD_CLINT] * hs
    return th
}

// Single oral dose on the standard grid (488 h).
fn st_oral(d: &Circ28Drug, gut: i32, dose: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = mtor_params(st_theta(d, 1.0, 1.0), gut)
    var dc = st_cfg(dose)
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    return mtor_run(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysn)
}

fn st_oral_fine(d: &Circ28Drug, gut: i32, dose: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = mtor_params(st_theta(d, 1.0, 1.0), gut)
    var dc = st_cfg(dose)
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    dc.dt1 = 0.05
    dc.dt2 = 0.25
    dc.dt3 = 4.0
    return mtor_run(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysn)
}

// Budget grid: 0.2 h to 3 h, 3 h to 24 h, 16 h to 488 h.
fn st_cfg_budget(d: &Circ28Drug, dose: f64) -> MtorDose with Mut, Div, Panic, Epistemic {
    var dc = st_cfg(dose)
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    dc.dt1 = 0.2
    dc.dt2 = 3.0
    dc.dt3 = 16.0
    return dc
}

fn st_oral_budget_grid(d: &Circ28Drug, gut: i32, dose: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = mtor_params(st_theta(d, 1.0, 1.0), gut)
    let dc = st_cfg_budget(d, dose)
    return mtor_run(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysn)
}

// 4 h run (Cmax only) with scaled clearances.
fn st_oral_short(d: &Circ28Drug, gut: i32, dose: f64, gs: f64, hs: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = mtor_params(st_theta(d, gs, hs), gut)
    var dc = mtor_cfg_oral(dose, 4.0, 100.0, 200.0)
    dc.ntr = sir_ntr()
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    return mtor_run(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysn)
}

// Steady state: 16 daily doses (6 model half-lives), clearances scaled by gs, hs; grid 0.25 h to 3 h, 3 h to 12 h,
// 6 h to 24 h; the last interval is recorded.
fn st_ss(d: &Circ28Drug, gut: i32, dose: f64, gs: f64, hs: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = mtor_params(st_theta(d, gs, hs), gut)
    var dc = mtor_cfg_oral(dose, 24.0, 100.0, 200.0)
    dc.ntr = sir_ntr()
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    dc.ndose = 16
    dc.tau = 24.0
    dc.dt1 = 0.25
    dc.dt2 = 3.0
    dc.dt3 = 6.0
    return mtor_run(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysn)
}

// Intravenous what-if: 1 mg over 2 h.
fn st_iv(d: &Circ28Drug, gut: i32, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = mtor_params(st_theta(d, 1.0, 1.0), gut)
    var dc = st_cfg(1.0)
    dc.route = 0
    dc.t_inf = 2.0
    return mtor_run(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysn)
}

// Comparison grid of the single-ratio module: 0.1 h to 3 h, then 1 h to 72 h.
fn st_cmp_cfg(d: &Circ28Drug, t_end: f64) -> MtorDose with Mut, Div, Panic, Epistemic {
    var dc = mtor_cfg_oral(6.0, t_end, 100.0, 200.0)
    dc.ntr = sir_ntr()
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    dc.dt2 = 1.0
    dc.t2 = t_end
    dc.dt3 = 1.0
    return dc
}

fn st_cmp_nl(d: &Circ28Drug, gut: i32, t_end: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = mtor_params(st_theta(d, 1.0, 1.0), gut)
    let dc = st_cmp_cfg(d, t_end)
    return mtor_run(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysn)
}

fn st_cmp_single(d: &Circ28Drug, gut: i32, sysc: &!Circ28Sys) -> MtorSingle with Mut, Div, Panic, Epistemic {
    let p = mtor_params(st_theta(d, 1.0, 1.0), gut)
    let dc = st_cmp_cfg(d, 72.0)
    return mtor_run_single(p, mtor_hct(), sir_bmax(), sir_kd(), dc, sysc)
}

fn st_print_run(tag: string, r: &MtorRun) with IO, Mut, Div {
    print("  "); print(tag)
    print(": Cmax "); print(1000.0 * (*r).cmax); print(" ng/mL  Tmax "); print((*r).tmax)
    print(" h  C24 "); print(1000.0 * (*r).c24); print("  AUC24 "); print(1000.0 * (*r).auc_tau); print("  AUCinf "); print(1000.0 * (*r).auc_inf)
    print("  t1/2 "); print((*r).thalf); print(" h  bal "); print((*r).balance_err)
    print("  fails "); println((*r).nfail)
}

// S0: pools (printed), a guard computed a second way, the input-consistency check.
fn st_sec_pool() -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    var ct: [i32; 100] = [0; 100]
    ct[99] = 1
    println("S0 pooled observables (n-weighted mean; u = max(pooled standard error, between-study SD/sqrt k))")
    var a = mtor_pool_zero()
    sir_pool_clf(&!a)
    print("  CL/F (L/h), k = 3, N = 70: studies 20.294 (Brattstrom, SD 8.541, n 30), 13.587 (Bottiger, n 18), 14.1 (Djebli, n 22): mean ")
    print(mtor_pool_mean(&a)); print("  pooled SE "); print(mtor_pool_se(&a)); print("  between/sqrt k "); print(mtor_pool_between(&a)); print("  u "); println(mtor_pool_u(&a))
    // guard: the same pooled mean and between-study term written out by hand
    let m_hand = (30.0 * 0.278 * 73.0 + 18.0 * (10.0 / 0.736) + 22.0 * 14.1) / 70.0
    let x1 = 0.278 * 73.0
    let x2 = 10.0 / 0.736
    let x3 = 14.1
    let xm = (x1 + x2 + x3) / 3.0
    let b_hand = cd_sqrt(((x1 - xm) * (x1 - xm) + (x2 - xm) * (x2 - xm) + (x3 - xm) * (x3 - xm)) / 2.0) / cd_sqrt(3.0)
    fails = fails + st_rel("guard: pooled CL/F mean, second computation", sir_obs_clf(), m_hand, 1.0e-12)
    fails = fails + st_rel("guard: pooled CL/F u (between-study), second computation", sir_u_clf(), b_hand, 1.0e-9)
    var b = mtor_pool_zero()
    sir_pool_vssf(&!b)
    print("  V_ss/F (L), k = 2, N = 52: studies 1679 (Brattstrom, SD 730, n 30), 510 (Djebli, n 22): mean ")
    print(mtor_pool_mean(&b)); print("  pooled SE "); print(mtor_pool_se(&b)); print("  between/sqrt k "); print(mtor_pool_between(&b)); print("  u "); println(mtor_pool_u(&b))
    fails = fails + st_rel("guard: pooled V_ss/F mean, second computation", sir_obs_vssf(), (30.0 * 23.0 * 73.0 + 22.0 * 510.0) / 52.0, 1.0e-12)
    var c = mtor_pool_zero()
    sir_pool_thalf(&!c)
    print("  t1/2 healthy (h), k = 3, equal weights: 82, 79, 67.5: mean "); print(mtor_pool_mean(&c)); print("  u "); println(mtor_pool_u(&c))
    var e = mtor_pool_zero()
    sir_pool_tmax(&!e)
    print("  Tmax (h), k = 2, equal weights: 1.0, 1.45: mean "); print(mtor_pool_mean(&e)); print("  u "); println(mtor_pool_u(&e))
    println("S0b input-consistency check (before any structure): V_ss ln2 / CL against the pooled terminal half-life")
    let tchk = sir_obs_vssf() * 0.6931471805599453 / sir_obs_clf()
    print("  V_ss/F ln2 / (CL/F) = "); print(tchk); print(" h;  pooled healthy t1/2 "); print(mtor_pool_mean(&c)); print(" h;  ratio "); println(tchk / mtor_pool_mean(&c))
    fails = fails + st_row(&!ct, "P0 V_ss ln2/CL over pooled t1/2  pred 0.65: must be < 1", tchk / mtor_pool_mean(&c), 1.0, 0.0, 2.0, 1, 0.55, 0.75)
    print("  ciclosporin-comedicated patients (NOT pooled): Zimmerman & Kahan 12 L/kg, 208 mL/h/kg -> V ln2/CL = ")
    print(12.0 * 0.6931471805599453 / 0.208); println(" h against their 62 h")
    return fails
}

// S1: the record and the fits against their own observables.
fn st_sec_fit(d: &Circ28Drug, gut: i32, sysn: &!Nl28Sys) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("S1 parameter record (value, standard uncertainty, status)")
    var i: i32 = 0
    while i < 18 {
        print("  "); print(i); print(" "); print(st_rname(i)); print("  value "); print(circ28_drug_value(d, i))
        print("  u "); print(cd_sqrt(circ28_drug_variance(d, i))); print("  status "); println((*d).status[i])
        i = i + 1
    }
    print("  binding: Hct 0.434, Bmax "); print(1000.0 * sir_bmax()); print(" ng/mL RBC (u 50 %), in-vitro bp0 "); print(sir_bp0()); print(" (u "); print(sir_u_bp0())
    print("), Kd "); print(1000.0 * sir_kd()); print(" ng/mL plasma (u "); print(1000.0 * sir_u_kd()); println(")")
    println("S2 the fits reproduce their observables (these are NOT validations)")
    let o = sir_obs_base()
    let th = st_theta(d, 1.0, 1.0)
    let p = mtor_params(th, gut)
    let bp = circ28_drug_value(d, CD_BP)
    print("  C_ref (ng/mL) "); println(1000.0 * o.cref)
    fails = fails + st_rel("V_ss plasma-referred = F V_ss/F x bp_ref", circ28_vss_plasma(p), o.vss * bp, 1.0e-9)
    fails = fails + st_rel("blood CL (L/h) = F x pooled CL/F", circ28_splanchnic_clearance(p), o.cl, 1.0e-9)
    let fcl = circ28_drug_value(d, CD_FA) * circ28_gut_availability(p) * (1.0 - circ28_hepatic_extraction(p))
    fails = fails + st_rel("F = fa Fg (1 - Eh) = 0.14", fcl, 0.14, 1.0e-9)
    print("  Fg "); print(circ28_gut_availability(p)); print("  Eh "); print(circ28_hepatic_extraction(p)); print("  Eg "); println(circ28_gut_extraction(p))
    let r24 = sir_r24_at_g(st_theta(d, 1.0, 1.0), o, circ28_drug_value(d, CD_PSSC), circ28_drug_value(d, CD_KA), sir_ntr(), gut, sysn)
    fails = fails + st_rel("R24 = C(24 h)/Cmax at the record (fit check)", r24, sir_obs_r24(), 1.0e-2)
    let tm = mtor_tmax_at_n(p, o.hct, o.bmax, o.kd, 6.0, th[CD_FA], th[CD_KA], sir_ntr(), sysn)
    fails = fails + st_rel("Tmax at the record (fit check)", tm, sir_obs_tmax(), 1.0e-2)
    print("  ps scalar bounds: s_min (hepatic fit exists) "); print(mtor_ps_min_g(th, o, gut)); println(", upper bound 1 (flow-limited)")
    return fails
}

// One single-dose interaction what-if. mode: see mtor_ddi_solve. Prints the solved factor, the closed-form AUC
// and CL ratios and the simulated Cmax ratio (4 h runs, 10 mg). Returns the Cmax ratio, -1 when the AUC ratio
// is not reachable in that mode.
fn st_ddi(tag: string, d: &Circ28Drug, gut: i32, mode: i32, ra: f64, cbase: f64, sysn: &!Nl28Sys) -> f64 with IO, Mut, Div, Panic, Epistemic {
    let th = st_theta(d, 1.0, 1.0)
    let x = mtor_ddi_solve(th, mode, ra)
    print("  "); print(tag); print(": AUC ratio target "); print(ra)
    if x < 0.0 {
        var g0 = 0.0
        var h0 = 1.0
        if mode == 1 {
            g0 = 1.0
            h0 = 0.0
        }
        print("  NOT REACHABLE; ceiling of the AUC ratio "); println(mtor_auc_ratio(th, g0, h0))
        return 0.0 - 1.0
    }
    var g = x
    var h = 1.0
    if mode == 1 {
        g = 1.0
        h = x
    }
    if mode == 2 { h = x }
    if mode == 3 {
        g = 0.0
        h = x
    }
    let r = st_oral_short(d, gut, 10.0, g, h, sysn)
    print("  factor "); print(x); print("  AUC ratio closed form "); print(mtor_auc_ratio(th, g, h))
    print("  CL'/CL "); print(mtor_cl_ratio(th, g, h)); print("  Cmax ratio simulated "); println(r.cmax / cbase)
    return r.cmax / cbase
}

// Steady-state interaction what-if (2 mg/day, 16 doses), gut-wall factor solved for the AUC ratio: returns the
// ratio of the steady-state Cmax; prints the simulated AUC(0-24) ratio next to the closed form.
fn st_ddi_ss(tag: string, d: &Circ28Drug, gut: i32, ra: f64, base: &MtorRun, sysn: &!Nl28Sys) -> f64 with IO, Mut, Div, Panic, Epistemic {
    let th = st_theta(d, 1.0, 1.0)
    let g = mtor_ddi_solve(th, 0, ra)
    let r = st_ss(d, gut, 2.0, g, 1.0, sysn)
    print("  "); print(tag); print(": AUC ratio target "); print(ra); print("  gut factor "); print(g)
    print("  simulated AUC(0-24),ss ratio "); print(r.auc_tau / (*base).auc_tau); print("  Cmax,ss ratio "); println(r.cmax / (*base).cmax)
    return r.cmax / (*base).cmax
}

fn st_unreach(tag: string, x: f64) -> i32 with IO, Mut, Div, Panic {
    if x < 0.0 {
        print("  "); print(tag); println(": not reachable, as asserted")
        return 0
    }
    print("  "); print(tag); println(": [FAIL] expected NOT reachable")
    return 1
}

fn st_sec_ddi(d: &Circ28Drug, gut: i32, rss: &MtorRun, ct: &![i32; 100], sysn: &!Nl28Sys) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("V9 interaction WHAT-IFS (factor solved for the observed AUC ratio; the Cmax ratio is the prediction; fold 1.3)")
    println("   G: gut-wall clint x g, liver unchanged.  H: hepatic clint x h, gut unchanged.")
    let rb = st_oral_short(d, gut, 10.0, 1.0, 1.0, sysn)
    let cb = rb.cmax
    let th = st_theta(d, 1.0, 1.0)
    print("  ceilings of the AUC ratio: gut wall fully inhibited "); print(mtor_auc_ratio(th, 0.0, 1.0)); print(";  liver fully inhibited "); println(mtor_auc_ratio(th, 1.0, 0.0))
    println("  single-dose studies (label): diltiazem 120 mg, ciclosporin 300 mg simultaneous, ketoconazole, rifampicin")
    let dg = st_ddi("diltiazem G  ", d, gut, 0, 1.60, cb, sysn)
    let dh = st_ddi("diltiazem H  ", d, gut, 1, 1.60, cb, sysn)
    fails = fails + st_row(ct, "P9a diltiazem G Cmax ratio  obs 1.43 (90 % CI 1.14-1.81)  pred 1.55", dg, 1.43, 0.0, 1.3, 1, 0.9, 1.0)
    fails = fails + st_row(ct, "P9a diltiazem H Cmax ratio  obs 1.43                       pred 1.03", dh, 1.43, 0.0, 1.3, 0, 0.68, 0.769)
    let cg = st_ddi("ciclosporin G", d, gut, 0, 3.3, cb, sysn)
    fails = fails + st_row(ct, "P9b ciclosporin G Cmax ratio  obs 2.16   pred 3.1 FAIL (prediction WRONG)", cg, 2.16, 0.0, 1.3, 1, 0.80, 0.86)
    fails = fails + st_unreach("P9b ciclosporin H (AUC x 3.3 by the liver alone)", mtor_ddi_solve(th, 1, 3.3))
    fails = fails + st_unreach("P9c ketoconazole G (AUC x 10.9 by the gut wall alone)", mtor_ddi_solve(th, 0, 10.9))
    let km = st_ddi("ketoconazole, gut fully inhibited + hepatic factor", d, gut, 3, 10.9, cb, sysn)
    let hk = mtor_ddi_solve(th, 3, 10.9)
    fails = fails + st_row(ct, "P9c ketoconazole mixed Cmax ratio  obs 4.3   pred 6.5 (WRONG side)   ", km, 4.3, 0.0, 1.3, 0, 0.62, 0.769)
    fails = fails + st_row(ct, "P9c ketoconazole mixed half-life ratio CL/CL'  obs 1.0 (unchanged), fold 1.25", 1.0 / mtor_cl_ratio(th, 0.0, hk), 1.0, 0.0, 1.25, 0, 1.4, 1.7)
    let rr = st_ddi("rifampicin, same factor on gut and liver", d, gut, 2, 0.18, cb, sysn)
    let rg = st_ddi("rifampicin G ", d, gut, 0, 0.18, cb, sysn)
    let rh = st_ddi("rifampicin H ", d, gut, 1, 0.18, cb, sysn)
    fails = fails + st_row(ct, "P9d rifampicin both Cmax ratio  obs 0.29   pred 0.20 (WRONG side)      ", rr, 0.29, 0.0, 1.3, 0, 1.3001, 1.65)
    fails = fails + st_row(ct, "P9d rifampicin G Cmax ratio  obs 0.29 (no prediction written)         ", rg, 0.29, 0.0, 1.3, 1, 0.77, 0.9)
    fails = fails + st_row(ct, "P9d rifampicin H Cmax ratio  obs 0.29 (no prediction written)         ", rh, 0.29, 0.0, 1.3, 0, 2.2, 2.8)
    println("  steady-state studies (label; sirolimus 2 mg/day with verapamil 180 mg q12h, erythromycin 800 mg q8h): the")
    println("  comparison is made at steady state, where Cmax carries the accumulated trough (the header's single-dose P9 rows")
    println("  for these two were the WRONG experiment: single-dose Cmax ratios are printed, steady-state ratios are asserted)")
    let vg1 = st_ddi("verapamil G, single dose (not the study design)", d, gut, 0, 2.2, cb, sysn)
    let eg1 = st_ddi("erythromycin G, single dose (not the study design)", d, gut, 0, 4.2, cb, sysn)
    let vg = st_ddi_ss("verapamil G, steady state   ", d, gut, 2.2, rss, sysn)
    let eg = st_ddi_ss("erythromycin G, steady state", d, gut, 4.2, rss, sysn)
    fails = fails + st_row(ct, "P9e verapamil G Cmax,ss ratio  obs 2.3                                 ", vg, 2.3, 0.0, 1.3, 1, 0.77, 1.3)
    fails = fails + st_row(ct, "P9f erythromycin G Cmax,ss ratio  obs 4.4                              ", eg, 4.4, 0.0, 1.3, 0, 0.6, 0.769)
    fails = fails + st_unreach("P9f erythromycin H (AUC x 4.2 by the liver alone)", mtor_ddi_solve(th, 1, 4.2))
    if !(vg1 > 0.0 && eg1 > 0.0) { fails = fails + 1 }
    return fails
}

fn st_sec_cmp(d: &Circ28Drug, gut: i32, sysn: &!Nl28Sys, sysc: &!Circ28Sys) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("V10 single-ratio module (circ28_blood) against the local stepper, same parameters and grid, 6 mg")
    let cw = st_cmp_nl(d, gut, 12.0, sysn)
    let cn = st_cmp_nl(d, gut, 72.0, sysn)
    let cs = st_cmp_single(d, gut, sysc)
    print("  Cmax local "); print(1000.0 * cn.cmax); print("  single-ratio "); print(1000.0 * cs.cmax); print("  dCmax "); print(100.0 * (cs.cmax - cn.cmax) / cn.cmax); println(" %")
    print("  AUC(0-72) local "); print(1000.0 * cn.auc_t); print("  single-ratio "); print(1000.0 * cs.auc_t); print("  dAUC "); print(100.0 * (cs.auc_t - cn.auc_t) / cn.auc_t); println(" %")
    print("  single-ratio bp range used "); print(cs.bp_min); print(" - "); println(cs.bp_max)
    if !(st_abs(cs.cmax - cn.cmax) / cn.cmax < 0.03) {
        println("  [FAIL] |dCmax|/Cmax >= 3 %")
        fails = fails + 1
    }
    if !(st_abs(cs.auc_t - cn.auc_t) / cn.auc_t < 0.01) {
        println("  [FAIL] |dAUC|/AUC >= 1 %")
        fails = fails + 1
    }
    return fails
}

// The budget itself is computed in main (one frame less): called from this section function, lean_single returned a
// base run off by 2e-4 (sirolimus) and 2.4 % (everolimus), measured 2026-11-15; from main it agrees with Madaros.
fn st_sec_budget(ct: &![i32; 100], thb: [f64; 18], uka: f64, ups: f64, auc_std: f64, cmax_std: f64, auc_bg: f64, cmax_bg: f64, budp: &MtorBudget) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("S4 uncertainty budget with refit, 6 mg oral (twelve inputs; closed-form fits redone at every perturbation)")
    fails = fails + st_rel("budget grid AUC_inf against the standard grid", auc_bg, auc_std, 5.0e-3)
    fails = fails + st_rel("budget grid Cmax against the standard grid", cmax_bg, cmax_std, 1.0e-2)
    let z0 = sir_z0(thb)
    let u = sir_u_all(uka, ups)
    print("  runs "); println((*budp).runs)
    print("  AUC_inf "); print((*budp).auc * 1000.0); print(" ng h/mL  u "); print(cd_sqrt((*budp).var_auc) * 1000.0); print("  (rel "); print(cd_sqrt((*budp).var_auc) / (*budp).auc); println(")")
    print("  Cmax    "); print((*budp).cmax * 1000.0); print(" ng/mL    u "); print(cd_sqrt((*budp).var_cmax) * 1000.0); print("  (rel "); print(cd_sqrt((*budp).var_cmax) / (*budp).cmax); println(")")
    println("  input       u          dlnAUC/dlnx   share of var(AUC) %   dlnCmax/dlnx  share of var(Cmax) %")
    var j: i32 = 0
    var sh_a = 0.0
    var sh_c = 0.0
    while j < 12 {
        let la = (*budp).sens_auc[j] * z0[j] / (*budp).auc
        let lc = (*budp).sens_cmax[j] * z0[j] / (*budp).cmax
        print("  "); print(st_bname(j)); print("   "); print(u[j]); print("   "); print(la); print("   "); print(100.0 * (*budp).contrib_auc[j] / (*budp).var_auc)
        print("   "); print(lc); print("   "); println(100.0 * (*budp).contrib_cmax[j] / (*budp).var_cmax)
        sh_a = sh_a + (*budp).contrib_auc[j] / (*budp).var_auc
        sh_c = sh_c + (*budp).contrib_cmax[j] / (*budp).var_cmax
        j = j + 1
    }
    fails = fails + st_rel("budget AUC = the 6 mg run (same grid, refit path)", (*budp).auc, auc_bg, 1.0e-6)
    fails = fails + st_rel("shares of var(AUC) add to 1", sh_a, 1.0, 1.0e-9)
    fails = fails + st_rel("shares of var(Cmax) add to 1", sh_c, 1.0, 1.0e-9)
    fails = fails + st_row(ct, "P11 u(AUC)/AUC   predicted 0.13 (0.11-0.16)", cd_sqrt((*budp).var_auc) / (*budp).auc, 0.13, 0.0, 1.25, 1, 0.8, 1.25)
    fails = fails + st_row(ct, "P11 u(Cmax)/Cmax predicted 0.5 (0.35-0.7)  ", cd_sqrt((*budp).var_cmax) / (*budp).cmax, 0.5, 0.0, 1.4, 1, 0.7, 1.4)
    fails = fails + st_row(ct, "P11 share of CL/F in var(AUC)  predicted > 0.90", (*budp).contrib_auc[8] / (*budp).var_auc, 0.95, 0.0, 1.06, 1, 0.94, 1.06)
    return fails
}

// One full validation column: the record `d` (fitted with sir_drug_into_g at the stage count sir_ntr() and the gut
// variant `gut`), every run and every row of the validation. res receives the numbers compared between the columns.
fn st_col(d: &Circ28Drug, gut: i32, ct: &![i32; 100], res: &![f64; 40], sysn: &!Nl28Sys, sysc: &!Circ28Sys) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    let warm = st_oral_short(d, gut, 6.0, 1.0, 1.0, sysn)
    if gut == 0 { fails = fails + st_sec_cmp(d, gut, sysn, sysc) }
    fails = fails + st_sec_fit(d, gut, sysn)

    println("R runs (whole blood; venous pool)")
    let r6 = st_oral(d, gut, 6.0, sysn)
    st_print_run("oral 6 mg ", &r6)
    var r6f = r6
    if gut == 0 {
        r6f = st_oral_fine(d, gut, 6.0, sysn)
        st_print_run("oral 6 mg, grid refined (numerical check, column A only)", &r6f)
    }
    let r10 = st_oral(d, gut, 10.0, sysn)
    st_print_run("oral 10 mg", &r10)
    let r06 = st_oral(d, gut, 0.6, sysn)
    st_print_run("oral 0.6 mg", &r06)
    let r16 = st_oral(d, gut, 16.0, sysn)
    st_print_run("oral 16 mg", &r16)
    let riv = st_iv(d, gut, sysn)
    st_print_run("IV what-if 1 mg over 2 h", &riv)
    let rss = st_ss(d, gut, 2.0, 1.0, 1.0, sysn)
    print("  steady state 2 mg/day, dose 16: Cmax "); print(1000.0 * rss.cmax); print(" ng/mL  Tmax "); print(rss.tmax); print(" h  trough C(24) "); print(1000.0 * rss.c_tau)
    print("  AUC(0-24) "); print(1000.0 * rss.auc_tau); print("  bal "); println(rss.balance_err)

    println("C numerical checks")
    fails = fails + st_rel("mass balance oral 6 mg", r6.balance_err + 1.0, 1.0, 1.0e-9)
    fails = fails + st_rel("mass balance 16 mg", r16.balance_err + 1.0, 1.0, 1.0e-9)
    fails = fails + st_rel("mass balance IV", riv.balance_err + 1.0, 1.0, 1.0e-9)
    fails = fails + st_rel("mass balance steady state", rss.balance_err + 1.0, 1.0, 1.0e-9)
    if !(r6.ok && r6f.ok && r10.ok && r06.ok && r16.ok && riv.ok && rss.ok) {
        println("  [FAIL] a run did not complete")
        fails = fails + 1
    }
    if !(r6.nfail == 0 && r16.nfail == 0 && rss.nfail == 0) {
        println("  [FAIL] failed Newton steps")
        fails = fails + 1
    }
    if !(r6.fit_ok && r10.fit_ok && riv.fit_ok) {
        println("  [FAIL] terminal fit not valid")
        fails = fails + 1
    }
    fails = fails + st_rel("grid refinement: Cmax", r6f.cmax, r6.cmax, 5.0e-3)
    fails = fails + st_rel("grid refinement: AUC_inf", r6f.auc_inf, r6.auc_inf, 5.0e-3)
    fails = fails + st_rel("grid refinement: t1/2", r6f.thalf, r6.thalf, 1.0e-2)

    println("V validation, predicted against observed (whole blood)")
    fails = fails + st_row(ct, "P1a t1/2 (h)  Brattstrom 2000 healthy, n=30              ", r6.thalf, 82.0, 12.0, 0.0, 1, -2.0, 0.0)
    fails = fails + st_row(ct, "P1b t1/2 (h)  Bottiger 2001 healthy, fold 1.3            ", r10.thalf, 79.0, 0.0, 1.3, 0, 0.70, 0.76)
    fails = fails + st_row(ct, "P1c t1/2 (h)  Zimmerman & Kahan 1997 patients + CsA      ", r6.thalf, 62.0, 16.0, 0.0, 1, -1.0, 1.0)
    fails = fails + st_row(ct, "P2a Cmax 10 mg (ng/mL)  Bottiger 2001, fold 1.5          ", 1000.0 * r10.cmax, 67.0, 0.0, 1.5, 0, 0.3, 0.6666)
    fails = fails + st_row(ct, "P2b Cmax 6 mg (ng/mL)  Leelahavanichkul 2005             ", 1000.0 * r6.cmax, 25.3, 6.1, 0.0, 1, -2.0, 1.5)
    fails = fails + st_row(ct, "P2c C(24 h) 6 mg (ng/mL)  Leelahavanichkul (tied to P2b by R24)", 1000.0 * r6.c24, 4.47, 0.57, 0.0, 0, -3.1, -2.4)
    fails = fails + st_row(ct, "P3a AUC_inf 10 mg (ng h/mL)  Bottiger 736 (CONSISTENCY), fold 1.3", 1000.0 * r10.auc_inf, 736.0, 0.0, 1.3, 1, 0.77, 0.86)
    fails = fails + st_rel("P3a AUC_inf 10 mg against D/(CL/F) (the fit; binding non-linearity within 6 %)", r10.auc_inf, 10.0 / sir_obs_clf(), 6.0e-2)
    fails = fails + st_row(ct, "P3b AUC(0-24) 6 mg (ng h/mL)  Leelahavanichkul 2005      ", 1000.0 * r6.auc_tau, 187.9, 48.2, 0.0, 1, -2.0, 1.0)
    fails = fails + st_row(ct, "P3c AUC_inf 6 mg x 1.27 (tablet)  Huang 2013 AUC(0-264) 452, fold 1.3", 1270.0 * r6.auc_inf, 452.0, 0.0, 1.3, 1, 0.8, 1.2)
    println("  steady state 2 mg/day against label Table 4 (de novo recipients WITH ciclosporin)")
    fails = fails + st_row(ct, "P4a trough (ng/mL)  label 7.1 +/- 3.5                    ", 1000.0 * rss.c_tau, 7.1, 3.5, 0.0, 1, -1.5, 0.0)
    fails = fails + st_row(ct, "P4b Cmax,ss (ng/mL)  label 14.4 +/- 5.3                  ", 1000.0 * rss.cmax, 14.4, 5.3, 0.0, 1, -2.0, 0.0)
    fails = fails + st_row(ct, "P4c AUC(0-24),ss (ng h/mL)  label 194 +/- 78             ", 1000.0 * rss.auc_tau, 194.0, 78.0, 0.0, 1, -1.5, 0.0)
    fails = fails + st_rel("P4c AUC(0-24),ss against D/(CL/F) (the fit)", rss.auc_tau, 2.0 / sir_obs_clf(), 6.0e-2)
    fails = fails + st_row(ct, "P4d what-if trough x 1.8 (ciclosporin 4 h before, label)  ", 1800.0 * rss.c_tau, 7.1, 3.5, 0.0, 1, -1.0, 1.0)
    fails = fails + st_row(ct, "P4e what-if trough x 1.27 (tablet)  LAM median 6.8 (IQR 4.6-9.0), fold 1.5", 1270.0 * rss.c_tau, 6.8, 0.0, 1.5, 1, 0.66, 0.70)
    let th = st_theta(d, 1.0, 1.0)
    let p = mtor_params(th, gut)
    fails = fails + st_row(ct, "P5  Fh = 1 - Eh  Emoto 2013 0.96 +/- 0.03                ", 1.0 - circ28_hepatic_extraction(p), 0.96, 0.03, 0.0, 1, 0.0, 1.0)
    fails = fails + st_row(ct, "    Fg  Emoto 2013 0.16 +/- 0.10 (CONSISTENCY: F is fitted)", circ28_gut_availability(p), 0.16, 0.10, 0.0, 1, -0.5, 0.5)
    println("V6 blood:plasma ratio of the venous pool (model: local relation)")
    print("  at the 10 mg peak "); print(r10.bp_peak); print("  24 h after 6 mg "); print(r6.bp24); print("  at the steady-state trough "); println(rss.bp_end)
    fails = fails + st_row(ct, "P6a B:P at the 10 mg peak  label 36 +/- 18               ", r10.bp_peak, 36.0, 18.0, 0.0, 1, -1.6, -1.0)
    fails = fails + st_row(ct, "P6a B:P  Zimmerman & Kahan 38 +/- 13                     ", r10.bp_peak, 38.0, 13.0, 0.0, 0, -2.3, -2.0001)
    fails = fails + st_row(ct, "P6a B:P  Ferron 30.9 (SD 15)                             ", r10.bp_peak, 30.9, 15.0, 0.0, 1, -1.6, -1.0)
    fails = fails + st_row(ct, "P6a B:P  Brattstrom 36 healthy (no SD), fold 1.5         ", r10.bp_peak, 36.0, 0.0, 1.5, 0, 0.25, 0.4)
    let b5 = nl28_bp_local(mtor_hct(), sir_bmax(), sir_kd(), 0.005)
    let b100 = nl28_bp_local(mtor_hct(), sir_bmax(), sir_kd(), 0.100)
    print("  binding relation: B:P at 5 ng/mL "); print(b5); print("  at 100 ng/mL "); println(b100)
    fails = fails + st_row(ct, "P6b B:P(100)/B:P(5)  observed: no dependence (Yatscoff), 0.80-1.25", b100 / b5, 1.0, 0.0, 1.25, 0, 0.5, 0.7)
    println("V7 dose linearity (Brattstrom 2000: proportional over 0.3-8 mg/m2)")
    fails = fails + st_row(ct, "P7a Cmax(16)/Cmax(0.6) dose-normalised, 0.80-1.25        ", (r16.cmax / 16.0) / (r06.cmax / 0.6), 1.0, 0.0, 1.25, 1, 0.80, 0.97)
    fails = fails + st_row(ct, "P7b AUC_inf(16)/AUC_inf(0.6) dose-normalised, 0.80-1.25  ", (r16.auc_inf / 16.0) / (r06.auc_inf / 0.6), 1.0, 0.0, 1.25, 1, 0.88, 0.99)
    println("V8 intravenous what-if (no observation exists)")
    let f_sim = (r6.auc_inf / 6.0) / (riv.auc_inf / 1.0)
    print("  simulated F "); print(f_sim); print("  IV CL (L/h) "); print(1.0 / riv.auc_inf); print("  V_ss by NCA (L) "); print(riv.vss_nca); print("  IV t1/2 "); println(riv.thalf)
    fails = fails + st_row(ct, "P8a simulated F / 0.14                                   ", f_sim, 0.14, 0.0, 1.1, 1, 0.9, 1.1)
    fails = fails + st_row(ct, "P8b IV CL simulated / fitted blood CL                    ", 1.0 / riv.auc_inf, sir_f() * sir_obs_clf(), 0.0, 1.1, 1, 0.9, 1.1)

    println("V12 shape and input-rate rows (transit input)")
    let kfit = circ28_drug_value(d, CD_KA)
    print("  fitted k (1/h) "); print(kfit); print("  stages "); print(sir_ntr()); print("  MTT = stages/k (h) "); println((sir_ntr() as f64) / kfit)
    fails = fails + st_row(ct, "P12a Cmax/AUC_inf 10 mg (1/h)  Bottiger 67/736 = 0.0910, fold 1.3", r10.cmax / r10.auc_inf, 67.0 / 736.0, 0.0, 1.3, 0, 0.0, 10.0)
    fails = fails + st_row(ct, "P12b fitted k (1/h)  Djebli 2006 Ktr 5.25 /h (AB; n of the Erlang chain NOT in the abstract: n declared)", kfit, 5.25, 0.0, 1.5, 1, 0.0, 10.0)
    fails = fails + st_row(ct, "P12c Tmax 6 mg (h)  Leelahavanichkul 1.45 +/- 0.5 (CONSISTENCY: inside the Tmax pool)", r6.tmax, 1.45, 0.5, 0.0, 1, -10.0, 10.0)
    fails = fails + st_row(ct, "P12d Cmax/AUC(0-24) 6 mg (1/h)  Leelahavanichkul 25.3/187.9, fold 1.3", r6.cmax / r6.auc_tau, 25.3 / 187.9, 0.0, 1.3, 1, 0.90, 0.95)
    res[0] = 1000.0 * r10.cmax
    res[1] = 1000.0 * r6.cmax
    res[2] = 1000.0 * r6.c24
    res[3] = 1000.0 * r10.auc_inf
    res[4] = 1000.0 * r6.auc_tau
    res[5] = r6.thalf
    res[6] = 1000.0 * rss.c_tau
    res[7] = 1000.0 * rss.cmax
    res[8] = 1000.0 * rss.auc_tau
    res[9] = r10.bp_peak
    res[10] = r6.tmax
    res[11] = r10.cmax / r10.auc_inf
    res[12] = kfit
    res[13] = circ28_drug_value(d, CD_PSSC)
    res[14] = circ28_drug_value(d, CD_KPSC)
    res[15] = p.kp[8]
    res[16] = (sir_ntr() as f64) / kfit
    res[17] = f_sim
    res[18] = circ28_gut_availability(p)
    res[19] = circ28_hepatic_extraction(p)
    res[20] = r6.cmax / r6.auc_tau
    res[21] = r6.c24 / r6.cmax
    res[22] = r6.auc_inf * 1000.0
    fails = fails + st_sec_ddi(d, gut, &rss, ct, sysn)
    return fails
}

// Single-dose grid with the stage count of the adopted input.
fn st_cfg(dose: f64) -> MtorDose {
    return sir_cfg_n(dose, sir_ntr())
}

fn st_pick(a: [f64; 18], b: [f64; 18], g: i32) -> [f64; 18] {
    if g == 1 { return b }
    return a
}

fn st_pickf(a: f64, b: f64, g: i32) -> f64 {
    if g == 1 { return b }
    return a
}

// D-S (LABELLED DIAGNOSTIC, nothing adopted): the CL/F pool of sirolimus with and without individual studies.
fn st_pool_m(excl_bott: i32, add_huang: i32) -> f64 with Mut, Div, Panic {
    var a = mtor_pool_zero()
    mtor_pool_add(&!a, 0.278 * mtor_bw(), 0.117 * mtor_bw(), 30.0)
    if excl_bott == 0 { mtor_pool_add(&!a, 10.0 / 0.736, 0.0, 18.0) }
    mtor_pool_add(&!a, 14.1, 0.0, 22.0)
    if add_huang == 1 { mtor_pool_add(&!a, 6.0 / 0.45196 * 1.27, 0.0, 24.0) }
    return mtor_pool_mean(&a)
}

fn st_pool_show(tag: string, m: f64) with IO, Mut, Div {
    print("  "); print(tag); print(": pooled CL/F "); print(m); print(" L/h;  model AUC_inf 10 mg = D/(CL/F) "); print(10000.0 / m); print(" ng h/mL, ratio to Bottiger 736: "); println(10000.0 / m / 736.0)
}

fn st_sec_ds() -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("D-S LABELLED DIAGNOSTIC: is Bottiger 2001 inside the CL/F pool, and what do other pools do to the AUC gap")
    println("  Bottiger 2001 (PMID 11180036): diltiazem crossover, n = 18, 10 mg; 736 ng h/mL and 67 ng/mL are GEOMETRIC means of the sirolimus-alone period")
    let m0 = st_pool_m(0, 0)
    st_pool_show("pool as used (Brattstrom, Bottiger, Djebli)        ", m0)
    let m1 = st_pool_m(1, 0)
    st_pool_show("without Bottiger (Brattstrom, Djebli)               ", m1)
    let m2 = st_pool_m(0, 1)
    st_pool_show("with Huang 2013 tablets/1.27 added (4 studies)      ", m2)
    print("  Huang 2013 reference tablets, 6 mg, AUC0-264 451.96: CL/F as measured "); print(6.0 / 0.45196); print(" L/h; x 1.27 (label tablet/solution) "); println(6.0 / 0.45196 * 1.27)
    print("  Bottiger alone: CL/F "); print(10.0 / 0.736); print(" L/h; Brattstrom alone "); print(0.278 * 73.0); print(" L/h; spread factor "); println(0.278 * 73.0 / (10.0 / 0.736))
    let f30 = exp(0.5 * 0.3 * 0.3)
    let f50 = exp(0.5 * 0.5 * 0.5)
    print("  geometric-to-arithmetic bracket exp(s^2/2): CV 30 % "); print(f30); print(", CV 50 % "); print(f50)
    print("  -> Bottiger CL/F arithmetic-mean equivalent "); print(10.0 / 0.736 * f30); print(" to "); print(10.0 / 0.736 * f50); println(" L/h (CV not in the abstract: bracket only)")
    if !(m1 > m0 && m0 > 10.0 / 0.736) { fails = fails + 1 }
    return fails
}

fn st_cmp_cols(ra: &[f64; 40], rb: &[f64; 40], cta: &[i32; 100], ctb: &[i32; 100]) -> i32 with IO, Mut, Div, Panic {
    println("COLUMNS A (all-organ Kp scalar) against B (gut wall at its Rodgers-Rowland Kp), everything refitted")
    println("  quantity                         A            B")
    print("  Cmax 10 mg (ng/mL)               "); print((*ra)[0]); print("   "); println((*rb)[0])
    print("  Cmax 6 mg (ng/mL)                "); print((*ra)[1]); print("   "); println((*rb)[1])
    print("  C(24 h) 6 mg (ng/mL)             "); print((*ra)[2]); print("   "); println((*rb)[2])
    print("  AUC_inf 10 mg (ng h/mL)          "); print((*ra)[3]); print("   "); println((*rb)[3])
    print("  AUC(0-24) 6 mg (ng h/mL)         "); print((*ra)[4]); print("   "); println((*rb)[4])
    print("  t1/2 6 mg (h)                    "); print((*ra)[5]); print("   "); println((*rb)[5])
    print("  trough ss 2 mg/day (ng/mL)       "); print((*ra)[6]); print("   "); println((*rb)[6])
    print("  Cmax,ss (ng/mL)                  "); print((*ra)[7]); print("   "); println((*rb)[7])
    print("  AUC24,ss (ng h/mL)               "); print((*ra)[8]); print("   "); println((*rb)[8])
    print("  B:P at the 10 mg peak            "); print((*ra)[9]); print("   "); println((*rb)[9])
    print("  Tmax 6 mg (h)                    "); print((*ra)[10]); print("   "); println((*rb)[10])
    print("  Cmax/AUC_inf 10 mg (1/h)         "); print((*ra)[11]); print("   "); println((*rb)[11])
    print("  fitted k per stage (1/h)         "); print((*ra)[12]); print("   "); println((*rb)[12])
    print("  MTT = stages/k (h)               "); print((*ra)[16]); print("   "); println((*rb)[16])
    print("  ps scalar (R24 fit)              "); print((*ra)[13]); print("   "); println((*rb)[13])
    print("  Kp scalar (V_ss fit)             "); print((*ra)[14]); print("   "); println((*rb)[14])
    print("  gut-wall Kp                      "); print((*ra)[15]); print("   "); println((*rb)[15])
    print("  simulated F                      "); print((*ra)[17]); print("   "); println((*rb)[17])
    print("  Fg, Eh                           "); print((*ra)[18]); print(" "); print((*ra)[19]); print("   "); print((*rb)[18]); print(" "); println((*rb)[19])
    print("  Cmax/AUC(0-24) 6 mg (1/h)        "); print((*ra)[20]); print("   "); println((*rb)[20])
    var flips = 0
    var gains = 0
    var i: i32 = 0
    while i < (*cta)[0] && i < 90 {
        if (*cta)[1 + i] == 1 && (*ctb)[1 + i] == 0 { flips = flips + 1 }
        if (*cta)[1 + i] == 0 && (*ctb)[1 + i] == 1 { gains = gains + 1 }
        i = i + 1
    }
    print("  rows logged "); print((*cta)[0]); print("  PASS in A and FAIL in B: "); print(flips); print("  FAIL in A and PASS in B: "); println(gains)
    let c1 = (*rb)[0] > (*ra)[0] && (*rb)[1] > (*ra)[1]
    let dauc = st_abs((*rb)[3] / (*ra)[3] - 1.0)
    let c2 = dauc < 0.13
    let c3 = flips == 0
    print("  rule (i) Cmax of B higher in both rows: "); print(c1); print("   (ii) |dAUC| "); print(dauc); print(" < 0.13: "); print(c2); print("   (iii) no PASS -> FAIL: "); println(c3)
    var adopt = 0
    if c1 && c2 && c3 { adopt = 1 }
    print("  DECISION: gut variant adopted = "); println(adopt)
    return adopt
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var sysr = nl28_sys_zero()
    var sysn = nl28_sys_zero()
    var sysc = circ28_sys_zero()
    var da = circ28_drug_new()
    var db = circ28_drug_new()
    sir_drug_into_g(&!da, sir_ntr(), 0, &!sysr)
    sir_drug_into_g(&!db, sir_ntr(), 1, &!sysr)
    var cta: [i32; 100] = [0; 100]
    var ctb: [i32; 100] = [0; 100]
    var ra: [f64; 40] = [0.0; 40]
    var rb: [f64; 40] = [0.0; 40]
    cta[99] = 0
    ctb[99] = 0
    if sir_gut() == 0 { cta[99] = 1 } else { ctb[99] = 1 }
    fails = fails + st_sec_pool()
    fails = fails + st_sec_ds()
    println("=== COLUMN A: all-organ Kp scalar, 4 stages ===")
    fails = fails + st_col(&da, 0, &!cta, &!ra, &!sysn, &!sysc)
    println("=== COLUMN B: gut wall at its Rodgers-Rowland Kp, 4 stages ===")
    fails = fails + st_col(&db, 1, &!ctb, &!rb, &!sysn, &!sysc)
    let adopt = st_cmp_cols(&ra, &rb, &cta, &ctb)
    if adopt != sir_gut() {
        println("  [FAIL] the decision made by the rule differs from sir_gut() declared in the module")
        fails = fails + 1
    }
    // budget of the ADOPTED record (computed in main: see the workaround note at st_sec_budget)
    let g = sir_gut()
    let tha = st_theta(&da, 1.0, 1.0)
    let thb2 = st_theta(&db, 1.0, 1.0)
    let thb = st_pick(tha, thb2, g)
    let uka = st_pickf(cd_sqrt(circ28_drug_variance(&da, CD_KA)), cd_sqrt(circ28_drug_variance(&db, CD_KA)), g)
    let ups = st_pickf(cd_sqrt(circ28_drug_variance(&da, CD_PSSC)), cd_sqrt(circ28_drug_variance(&db, CD_PSSC)), g)
    let pb = mtor_params(thb, g)
    var dcb = st_cfg(6.0)
    dcb.dt1 = 0.2
    dcb.dt2 = 3.0
    dcb.dt3 = 16.0
    dcb.ka = thb[CD_KA]
    dcb.fa = thb[CD_FA]
    let rbg = mtor_run(pb, mtor_hct(), sir_bmax(), sir_kd(), dcb, &!sysn)
    let bud = mtor_budget_g(sir_z0(thb), sir_u_all(uka, ups), thb, sir_cref(), dcb, g, &!sysn)
    var ctd: [i32; 100] = [0; 100]
    ctd[99] = 1
    fails = fails + st_sec_budget(&!ctd, thb, uka, ups, 0.001 * st_pickf(ra[22], rb[22], g), 0.001 * st_pickf(ra[1], rb[1], g), rbg.auc_inf, rbg.cmax, &bud)
    if fails == 0 {
        println("CIRC28_DRUG_SIROLIMUS_PASS")
        return 0
    }
    println("CIRC28_DRUG_SIROLIMUS_FAIL")
    return 1
}
