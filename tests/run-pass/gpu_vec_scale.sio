//@ run-pass
//@ ignore
//@ expect-stdout: PASS: GPU vec_scale

kernel fn vec_scale_in_place(n: i64, a: &![f64], factor: f64) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        a[tid as usize] = a[tid as usize] * factor
    }
}

kernel fn vec_scale_out(n: i64, input: &[f64], factor: f64, output: &![f64]) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        output[tid as usize] = input[tid as usize] * factor
    }
}

fn main() -> i32 with IO, Mut, Panic, GPU {
    var scale_in: [f64; 64] = [0.0; 64]
    var scale_out_in: [f64; 64] = [0.0; 64]
    var scale_out: [f64; 64] = [0.0; 64]

    var i: i64 = 0
    while i < 64 {
        scale_in[i as usize] = (i as f64) + 1.0
        scale_out_in[i as usize] = (i as f64) + 2.0
        i = i + 1
    }

    vec_scale_in_place(64, &!scale_in, 3.0)
    vec_scale_out(64, &scale_out_in, 4.0, &!scale_out)

    if scale_in[0] > 2.99 && scale_in[0] < 3.01 &&
       scale_in[10] > 32.99 && scale_in[10] < 33.01 &&
       scale_out[0] > 7.99 && scale_out[0] < 8.01 &&
       scale_out[10] > 47.99 && scale_out[10] < 48.01 {
        println("PASS: GPU vec_scale")
    } else {
        println("FAIL: GPU vec_scale")
    }
    0
}
