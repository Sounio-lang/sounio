//@ run-pass
//@ description: observe(k, y, uncertainty: s) performs normal-normal conjugate posterior contraction
//
// Lane A — native GUM->Bayes posterior contraction (M1 math-reviewed, xai/Grok 2026-05-24).
//   prior N(mu=10, var=4);  observe y=12 with obs var=1
//   var_post = var*sobs/(var+sobs) = 4*1/5 = 0.8   (< 4: contraction)
//   mu_post  = (mu*sobs + y*var)/(var+sobs) = (10 + 48)/5 = 11.6
// A second identical observation moves the mean further toward 12, which is only
// possible if the posterior variance contracted (the prior now carries less weight).

fn main() with IO {
    let prior = measure(10.0, uncertainty: 2.0)
    let post = observe(prior, 12.0, uncertainty: 1.0)
    let m: f64 = acknowledge(post, "posterior mean")
    var ok: i64 = 1
    if m < 11.5999 { ok = 0 }
    if m > 11.6001 { ok = 0 }

    let post2 = observe(post, 12.0, uncertainty: 1.0)
    let m2: f64 = acknowledge(post2, "second posterior mean")
    if m2 <= m { ok = 0 }
    if m2 >= 12.0 { ok = 0 }

    if ok == 1 { print("observe_contraction: PASS\n") } else { print("observe_contraction: FAIL\n") }
}
