//@ run-pass
//@ known-failure: Missing library implementation
// ============================================================================
// EPISTEMIC PBPK NATIVE DEMO — Sounio Epistemic Computing Showcase
// ============================================================================
// Rapamycin 3-compartment PBPK with GUM uncertainty propagation.
// Compiles to native ELF via lean driver — NO runtime, NO libc, NO JIT.
//
// What this proves: Sounio propagates measurement uncertainty through every
// arithmetic operation in a pharmacokinetic simulation, producing not just
// predicted drug concentrations but confidence-weighted uncertainty bounds.
//
// JCGM 100:2008 (GUM) linearization via finite differences.
// SOTA: Ferron 1997 (CYP3A4), Lampen 1998 (P-gp BBB), Schreiber 1991 (binding)
// ============================================================================

// ---- Math helpers ----

fn ep_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn ep_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 {
        y = (y + x / y) * 0.5
        i = i + 1
    }
    return y
}

fn ep_max(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

// Print f64 as "integer.fraction" using multiply-truncate (6 digits)
fn print_f64_6(v: f64) -> i64 {
    if v < 0.0 {
        print("-")
        let neg_v = 0.0 - v
        let int_part = neg_v as i64
        let frac = ((neg_v - (int_part as f64)) * 1000000.0) as i64
        print_int(int_part)
        print(".")
        // Pad with leading zeros
        if frac < 100000 { print("0") }
        if frac < 10000 { print("0") }
        if frac < 1000 { print("0") }
        if frac < 100 { print("0") }
        if frac < 10 { print("0") }
        print_int(frac)
        return 0
    }
    let int_part = v as i64
    let frac = ((v - (int_part as f64)) * 1000000.0) as i64
    print_int(int_part)
    print(".")
    if frac < 100000 { print("0") }
    if frac < 10000 { print("0") }
    if frac < 1000 { print("0") }
    if frac < 100 { print("0") }
    if frac < 10 { print("0") }
    print_int(frac)
    return 0
}

// Print f64 with 3 decimal places
fn print_f64_3(v: f64) -> i64 {
    if v < 0.0 {
        print("-")
        let neg_v = 0.0 - v
        let int_part = neg_v as i64
        let frac = ((neg_v - (int_part as f64)) * 1000.0) as i64
        print_int(int_part)
        print(".")
        if frac < 100 { print("0") }
        if frac < 10 { print("0") }
        print_int(frac)
        return 0
    }
    let int_part = v as i64
    let frac = ((v - (int_part as f64)) * 1000.0) as i64
    print_int(int_part)
    print(".")
    if frac < 100 { print("0") }
    if frac < 10 { print("0") }
    print_int(frac)
    return 0
}

// ---- 3-Compartment State ----

struct Rp3St {
    blood: f64,
    brain: f64,
    periph: f64,
}

// ---- Parameters (9-field) ----

struct Rp3Prm {
    v_blood: f64,
    v_brain: f64,
    v_periph: f64,
    q_brain: f64,
    q_periph: f64,
    kp_brain: f64,
    kp_periph: f64,
    cl_hepatic: f64,
    fu_plasma: f64,
}

// ---- Epistemic priors ----

struct EpPriors {
    cl_mean: f64,
    cl_var: f64,
    cl_conf: f64,
    kp_mean: f64,
    kp_var: f64,
    kp_conf: f64,
    fu_mean: f64,
    fu_var: f64,
    fu_conf: f64,
}

// ---- Simulation metrics ----

struct Metrics {
    cmax: f64,
    auc: f64,
    brain_final: f64,
    blood_final: f64,
}

// ---- Epistemic result ----

struct EpResult {
    auc_mean: f64,
    auc_var: f64,
    auc_conf: f64,
    bpr_mean: f64,
    bpr_var: f64,
    s_cl: f64,
    s_kp: f64,
    s_fu: f64,
}

// ---- Vector operations ----

fn rp3_zero() -> Rp3St {
    return Rp3St { blood: 0.0, brain: 0.0, periph: 0.0 }
}

fn rp3_add(a: Rp3St, b: Rp3St) -> Rp3St {
    return Rp3St {
        blood: a.blood + b.blood,
        brain: a.brain + b.brain,
        periph: a.periph + b.periph,
    }
}

fn rp3_scale(s: Rp3St, f: f64) -> Rp3St {
    return Rp3St {
        blood: s.blood * f,
        brain: s.brain * f,
        periph: s.periph * f,
    }
}

// ---- ODE right-hand side ----

fn rp3_ode(st: Rp3St, p: Rp3Prm) -> Rp3St {
    let cl_eff = p.cl_hepatic * p.fu_plasma

    let inflow_brain = p.q_brain / p.v_blood * st.brain / p.kp_brain
    let inflow_periph = p.q_periph / p.v_blood * st.periph / p.kp_periph
    let outflow = (p.q_brain + p.q_periph) / p.v_blood * st.blood
    let clearance = cl_eff / p.v_blood * st.blood

    let d_blood = inflow_brain + inflow_periph - outflow - clearance
    let d_brain = (p.q_brain / p.v_brain) * (st.blood - st.brain / p.kp_brain)
    let d_periph = (p.q_periph / p.v_periph) * (st.blood - st.periph / p.kp_periph)

    return Rp3St { blood: d_blood, brain: d_brain, periph: d_periph }
}

// ---- RK4 integrator ----

fn rk4_advance(st: Rp3St, p: Rp3Prm, dt: f64) -> Rp3St {
    let k1 = rp3_ode(st, p)
    let s2 = rp3_add(st, rp3_scale(k1, dt * 0.5))
    let k2 = rp3_ode(s2, p)
    let s3 = rp3_add(st, rp3_scale(k2, dt * 0.5))
    let k3 = rp3_ode(s3, p)
    let s4 = rp3_add(st, rp3_scale(k3, dt))
    let k4 = rp3_ode(s4, p)

    let w = rp3_add(k1, rp3_add(rp3_scale(k2, 2.0), rp3_add(rp3_scale(k3, 2.0), k4)))
    return rp3_add(st, rp3_scale(w, dt / 6.0))
}

// ---- Run simulation ----

fn run_sim(prm: Rp3Prm, dose_mg: f64, t_end: f64) -> Metrics {
    let c0 = dose_mg / prm.v_blood
    var st = Rp3St { blood: c0, brain: 0.0, periph: 0.0 }
    var t = 0.0
    let dt = 0.1
    var cmax = c0
    var auc = 0.0
    var c_prev = c0

    while t < t_end {
        var dt_use = dt
        if t + dt > t_end { dt_use = t_end - t }
        st = rk4_advance(st, prm, dt_use)
        if st.blood > cmax { cmax = st.blood }
        auc = auc + (c_prev + st.blood) * 0.5 * dt_use
        c_prev = st.blood
        t = t + dt_use
    }

    return Metrics { cmax: cmax, auc: auc, brain_final: st.brain, blood_final: st.blood }
}

// ---- Reference parameters ----

fn mean_params() -> Rp3Prm {
    return Rp3Prm {
        v_blood: 5.0,
        v_brain: 1.4,
        v_periph: 50.0,
        q_brain: 0.05,
        q_periph: 87.0,
        kp_brain: 0.08,
        kp_periph: 0.5,
        cl_hepatic: 12.4,
        fu_plasma: 0.08,
    }
}

fn get_priors() -> EpPriors {
    return EpPriors {
        cl_mean: 12.4,    cl_var: 54.76,     cl_conf: 0.65,
        kp_mean: 0.08,    kp_var: 0.000625,  kp_conf: 0.55,
        fu_mean: 0.08,    fu_var: 0.0004,    fu_conf: 0.72,
    }
}

// ---- GUM finite-difference step size ----

fn fdiff_h(mean: f64, variance: f64) -> f64 {
    let h_rel = 0.000001 * ep_abs(mean)
    let h_abs = 0.01 * ep_sqrt(variance)
    return ep_max(h_rel, h_abs)
}

// ---- Epistemic propagation ----

fn run_epistemic(priors: EpPriors, dose: f64, t_end: f64) -> EpResult {
    let prm_ref = mean_params()
    let ref_m = run_sim(prm_ref, dose, t_end)
    let auc_ref = ref_m.auc
    var bpr_ref = 0.0
    if ref_m.blood_final > 0.000000000001 {
        bpr_ref = ref_m.brain_final / ref_m.blood_final
    }

    // Perturbation 1: CL
    let h_cl = fdiff_h(priors.cl_mean, priors.cl_var)
    var prm_cl = mean_params()
    prm_cl.cl_hepatic = prm_ref.cl_hepatic + h_cl
    let m_cl = run_sim(prm_cl, dose, t_end)
    let dauc_dcl = (m_cl.auc - auc_ref) / h_cl

    // Perturbation 2: kp_brain
    let h_kp = fdiff_h(priors.kp_mean, priors.kp_var)
    var prm_kp = mean_params()
    prm_kp.kp_brain = prm_ref.kp_brain + h_kp
    let m_kp = run_sim(prm_kp, dose, t_end)
    let dauc_dkp = (m_kp.auc - auc_ref) / h_kp

    // Perturbation 3: fu_plasma
    let h_fu = fdiff_h(priors.fu_mean, priors.fu_var)
    var prm_fu = mean_params()
    prm_fu.fu_plasma = prm_ref.fu_plasma + h_fu
    let m_fu = run_sim(prm_fu, dose, t_end)
    let dauc_dfu = (m_fu.auc - auc_ref) / h_fu

    // GUM variance propagation
    let var_auc = dauc_dcl * dauc_dcl * priors.cl_var
               + dauc_dkp * dauc_dkp * priors.kp_var
               + dauc_dfu * dauc_dfu * priors.fu_var

    // BPR variance (finite diff)
    var bpr_cl = 0.0
    if m_cl.blood_final > 0.000000000001 { bpr_cl = m_cl.brain_final / m_cl.blood_final }
    var bpr_kp = 0.0
    if m_kp.blood_final > 0.000000000001 { bpr_kp = m_kp.brain_final / m_kp.blood_final }
    let dbpr_dcl = (bpr_cl - bpr_ref) / h_cl
    let dbpr_dkp = (bpr_kp - bpr_ref) / h_kp

    let var_bpr = dbpr_dcl * dbpr_dcl * priors.cl_var
               + dbpr_dkp * dbpr_dkp * priors.kp_var

    // Sensitivity fractions
    var s_cl = 0.0
    var s_kp = 0.0
    var s_fu = 0.0
    if var_auc > 0.0000000000000000000000000000001 {
        s_cl = dauc_dcl * dauc_dcl * priors.cl_var / var_auc
        s_kp = dauc_dkp * dauc_dkp * priors.kp_var / var_auc
        s_fu = dauc_dfu * dauc_dfu * priors.fu_var / var_auc
    }

    // Evidence-weighted confidence
    let conf_auc = priors.cl_conf * s_cl + priors.kp_conf * s_kp + priors.fu_conf * s_fu

    return EpResult {
        auc_mean: auc_ref,
        auc_var: var_auc,
        auc_conf: conf_auc,
        bpr_mean: bpr_ref,
        bpr_var: var_bpr,
        s_cl: s_cl,
        s_kp: s_kp,
        s_fu: s_fu,
    }
}

// ---- Main ----

fn main() -> i64 {
    print("======================================================================\n")
    print("  SOUNIO EPISTEMIC PBPK — Native ELF Demo\n")
    print("  Rapamycin 3-Compartment: Blood / Brain (BBB, P-gp) / Peripheral\n")
    print("  GUM Uncertainty Propagation (JCGM 100:2008)\n")
    print("======================================================================\n\n")

    let priors = get_priors()
    let dose = 5.0
    let t_end = 48.0
    let ep = run_epistemic(priors, dose, t_end)

    // ---- Display results ----

    print("  Drug: Rapamycin (Sirolimus) 5mg IV bolus\n")
    print("  Simulation: 48h, RK4 dt=0.1h (480 steps x 4 perturbations)\n\n")

    print("  AUC(0-48h):  ")
    print_f64_3(ep.auc_mean)
    print(" +/- ")
    print_f64_3(ep_sqrt(ep.auc_var))
    print(" mg*h/L\n")

    print("  Confidence:  ")
    print_f64_3(ep.auc_conf)
    print("\n")

    let cv_auc = ep_sqrt(ep.auc_var) / ep.auc_mean
    print("  CV(AUC):     ")
    print_f64_3(cv_auc * 100.0)
    print("%\n\n")

    print("  Brain/Plasma ratio: ")
    print_f64_6(ep.bpr_mean)
    print(" +/- ")
    print_f64_6(ep_sqrt(ep.bpr_var))
    print("\n\n")

    print("  Sensitivity Analysis (AUC variance contributions):\n")
    print("    CL_hepatic (CYP3A4): ")
    print_f64_3(ep.s_cl * 100.0)
    print("%\n")
    print("    kp_brain   (P-gp):   ")
    print_f64_3(ep.s_kp * 100.0)
    print("%\n")
    print("    fu_plasma  (binding): ")
    print_f64_3(ep.s_fu * 100.0)
    print("%\n\n")

    // ---- Validation tests ----

    var passed = 0
    var failed = 0

    // T1: Brain/plasma < 0.15 (P-gp efflux)
    if ep.bpr_mean > 0.0 {
        if ep.bpr_mean < 0.15 {
            print("  PASS: T1 brain/plasma < 0.15 (P-gp verified)\n")
            passed = passed + 1
        } else {
            print("  FAIL: T1 brain/plasma >= 0.15\n")
            failed = failed + 1
        }
    } else {
        print("  FAIL: T1 brain/plasma <= 0\n")
        failed = failed + 1
    }

    // T2: CV(AUC) > 30% (CYP3A4 variability)
    if cv_auc > 0.30 {
        print("  PASS: T2 CV(AUC) > 30% (CYP3A4 variability propagated)\n")
        passed = passed + 1
    } else {
        print("  FAIL: T2 CV(AUC) <= 30%\n")
        failed = failed + 1
    }

    // T3: All variances > 0
    if ep.auc_var > 0.0 {
        if ep.bpr_var > 0.0 {
            print("  PASS: T3 all epistemic variances > 0\n")
            passed = passed + 1
        } else {
            print("  FAIL: T3 bpr_var <= 0\n")
            failed = failed + 1
        }
    } else {
        print("  FAIL: T3 auc_var <= 0\n")
        failed = failed + 1
    }

    // T4: Causal monotonicity — AUC(CL/2) > AUC(CL)
    var prm_low = mean_params()
    prm_low.cl_hepatic = 6.2
    let m_low = run_sim(prm_low, dose, t_end)
    if m_low.auc > ep.auc_mean {
        print("  PASS: T4 AUC(CL/2) > AUC(CL) (causal monotonicity)\n")
        passed = passed + 1
    } else {
        print("  FAIL: T4 causal monotonicity violated\n")
        failed = failed + 1
    }

    // T5: CL dominates AUC uncertainty (s_cl > 0.5)
    if ep.s_cl > 0.5 {
        print("  PASS: T5 CL dominates AUC uncertainty (s_cl > 0.5)\n")
        passed = passed + 1
    } else {
        print("  FAIL: T5 s_cl <= 0.5\n")
        failed = failed + 1
    }

    // T6: Confidence in valid range
    if ep.auc_conf > 0.0 {
        if ep.auc_conf < 1.0 {
            print("  PASS: T6 confidence in (0,1)\n")
            passed = passed + 1
        } else {
            print("  FAIL: T6 confidence >= 1.0\n")
            failed = failed + 1
        }
    } else {
        print("  FAIL: T6 confidence <= 0\n")
        failed = failed + 1
    }

    print("\n======================================================================\n")
    print("  RESULT: ")
    print_int(passed)
    print("/6 PASS, ")
    print_int(failed)
    print(" FAIL\n")

    if failed == 0 {
        print("\n  No other language compiles uncertainty propagation to native code.\n")
        print("  This ELF binary carries epistemic guarantees through every operation.\n")
    }
    print("======================================================================\n")

    return failed
}
