//@ run-pass
//@ requires: madaros
//@ expect-stdout: ALLOCATION_DOMAIN_CURSORS_OK
// Box reset cannot rewind the aggregate heap observed by region reclamation.
struct PersistentValue { a: i64, b: i64, c: i64 }
fn main() -> i64 with IO, Mut, Alloc, Panic {
    let aggregate_before = __rgn_cursor()
    let box_before = __arena_mark()
    let p = Box::new(17)
    let box_after = __arena_mark()
    if box_after <= box_before { return 1 }
    if __rgn_cursor() != aggregate_before { return 2 }
    if *p != 17 { return 3 }
    let value = PersistentValue { a: 31, b: 37, c: 41 }
    let aggregate_after = __rgn_cursor()
    if aggregate_after <= aggregate_before { return 4 }
    if __arena_mark() != box_after { return 5 }
    __arena_reset(box_before)
    let q = Box::new(29)
    if *q != 29 { return 6 }
    if __rgn_cursor() != aggregate_after { return 7 }
    if value.a != 31 || value.b != 37 || value.c != 41 { return 8 }
    println("ALLOCATION_DOMAIN_CURSORS_OK")
    0
}
