//@ run-pass
// Test: struct-level type parameters parse correctly

struct Pair<T> {
    first: T,
    second: T,
}

struct Map<K, V> {
    key: K,
    val: V,
}

fn main() -> i64 with IO {
    println("generic struct parse ok")
    // Explicit success exit avoids interpreting the printed sentinel as exit status.
    0
}
