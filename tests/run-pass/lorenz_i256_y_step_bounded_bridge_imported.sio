//@ description: Imported Lorenz i256 bounded y-step bridge smoke

use systems::lorenz_i256_limb_bridge::*
use systems::lorenz_i256_y_derivative_bounded_bridge::*
use systems::lorenz_i256_y_step_bounded_bridge::*

fn main() -> i64 with Div {
    let positive = lorenz_i256_y_step_bounded_check(
        500000000, 1, 0, 0, 0, 1, 0, 0, 0, 26, 0, 0, 0, 3, 0, 0)
    if positive != 1 { return 1 }

    let negative = lorenz_i256_y_step_bounded_check(
        500000000, 0, 0, 0, 0, 1, 0, 0, 0, 27, 0, 0, 500000000, 0, 0, 0)
    if negative != 1 { return 2 }

    let zero = lorenz_i256_y_step_bounded_check(
        500000000, 0, 0, 0, 500000000, 0, 0, 0, 0, 27, 0, 0, 500000000, 0, 0, 0)
    if zero != 1 { return 3 }

    let underflow = lorenz_i256_y_step_bounded_limb(
        0, 0, 0, 0, 500000000, 0, 0, 0, 0, 27, 0, 0, 0)
    if underflow != 0 - 1 { return 4 }

    let derivative_anchor = lorenz_i256_y_derivative_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 110)
    if derivative_anchor != 742619083 { return 5 }

    let derivative_audit = lorenz_i256_y_derivative_bounded_bridge_audit_fingerprint(
        derivative_anchor, 815204637, 204973856, 920174638, 481036275,
        492681735, 837260419, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 110, 1023)
    if derivative_audit != 396508712 { return 6 }

    let limb_anchor = lorenz_i256_limb_bridge_receipt_check(
        1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 102)
    if limb_anchor != 681429570 { return 7 }

    let limb_audit = lorenz_i256_limb_bridge_audit_fingerprint(
        limb_anchor, 905714263, 247816039, 1, 1, 1, 1, 256,
        1000000000, 0, 0, 0, 0, 102, 1023)
    if limb_audit != 352908746 { return 8 }

    let artifact = lorenz_i256_y_step_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 111)
    if artifact != 286140975 { return 9 }

    let audit = lorenz_i256_y_step_bounded_bridge_audit_fingerprint(
        artifact, 731064852, 508216749, derivative_anchor, derivative_audit,
        limb_anchor, limb_audit, 1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 111, 1023)
    if audit != 653928410 { return 10 }
    return 0
}
