//@ run-pass
//@ expect-stdout: 20000
//@ description: Darwin bootstrap stack supports deep non-tail recursion beyond the initial 64 MiB stack
fn stack_depth(n: i64) -> i64 with Mut, Panic {
    var pad: [i64; 512] = [0; 512]
    pad[0] = n
    if n == 0 { return 0 }
    let child = stack_depth(n - 1)
    child + (pad[0] - n + 1)
}
fn main() with IO, Mut, Panic {
    print_int(stack_depth(20000))
    print("\n")
}
