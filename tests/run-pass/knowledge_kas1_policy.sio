//@ run-pass
// β⁸ Phase 4 — KAS-1 policy demonstration.
//
// Shows both paths through a Knowledge<f64> multiplication:
//   Path A (butterfly #3): direct `k1 * k2` — second-order shadows are
//                           dropped; hessian_of on the result is zero.
//   Path B (KAS-1 compliant): extract `.value` first, scalar multiply,
//                              then hessian_of returns the true Hessian.
//
// Both paths produce the same point estimate; the difference is only in
// the Hessian dimension that Phase 1's gum_second_order_variance consumes.
//
// Formalised in formal/KnowledgeArithmeticSoundness.lean (kas_policy_sound).

fn path_kas1_compliant() -> f64 with IO, Epistemic, Mut, Div {
    let k1: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let k2: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
    // KAS-1: extract .value first
    let x = k1.value
    let y = k2.value
    let z = x * y                    // scalar mul with shadow propagation
    // Hessian of x*y: H_00 = 0, H_01 = 1, H_11 = 0  (bilinear)
    hessian_of(z, 0, 1)              // expect 1.0
}

fn path_butterfly3() -> f64 with IO, Epistemic, Mut, Div {
    let k1: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let k2: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
    // Direct Knowledge multiplication — shadows dropped
    let kz = k1 * k2
    // kz.value is 6.0 correctly, but hessian_of on kz.value sees no shadows
    hessian_of(kz.value, 0, 1)       // expect 0.0 (shadows dropped)
}

fn main() with IO, Epistemic, Mut, Div {
    let h_compliant = path_kas1_compliant()
    let h_butterfly = path_butterfly3()
    println(h_compliant)    // expect 1.000000
    println(h_butterfly)    // expect 0.000000 — documents the gap
}
