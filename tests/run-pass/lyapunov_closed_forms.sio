//@ run-pass
//@ description: A-layer-2 substrate — largest Lyapunov exponent matches closed forms; chaos sign correct
use math::lyapunov::*

fn approx(a: f64, b: f64, e: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < e
}

fn main() -> i64 with Mut, Div, Panic {
    // logistic r=4 is conjugate to the tent map ⇒ λ = ln2 (the DERIVED value must match)
    let l4 = lyap_logistic(4.0)
    if !approx(l4, 0.6931471805599453, 0.01) { return 1 }
    if !lyap_is_chaotic(l4) { return 2 }

    // tent μ=2 ⇒ λ = ln2 exactly
    if !approx(lyap_tent(2.0), 0.6931471805599453, 0.0001) { return 3 }

    // periodic windows ⇒ λ < 0 (NOT chaotic) — the discriminator A-layer-2 relies on
    if lyap_is_chaotic(lyap_logistic(3.2)) { return 4 }
    if lyap_is_chaotic(lyap_logistic(3.5)) { return 5 }

    // chaotic band ⇒ λ > 0
    if !lyap_is_chaotic(lyap_logistic(3.7)) { return 6 }
    if !lyap_is_chaotic(lyap_logistic(3.9)) { return 7 }

    // manifest cross-check: derived logistic_r4.0 value (0.693149) within tolerance
    if !approx(l4, 0.693149, 0.005) { return 8 }

    0
}
