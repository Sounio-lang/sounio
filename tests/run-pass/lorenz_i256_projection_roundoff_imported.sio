//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 projection roundoff budget into ball-fixed scale

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let budget_fp = lorenz_i256_projection_roundoff_budget_fingerprint(
        214180161, 4294967296, 1000000,
        1236317, 687511168,
        2341980, 3715113920,
        951075, 1913956800,
        890086395, 1, 3715113920, 42445, 42450, 7)
    if budget_fp != 677514412 { return 1 }

    let audit_fp = lorenz_i256_projection_roundoff_audit_fingerprint(
        budget_fp, 87220662, 149359034, 166945519, 184, 31)
    if audit_fp != 159826781 { return 2 }

    if lorenz_i256_projection_roundoff_budget_fingerprint(
        214180161, 4294967296, 1000000,
        1236317, 687511168,
        2341980, 3715113921,
        951075, 1913956800,
        890086395, 1, 3715113920, 42445, 42450, 7) != (0 - 1) { return 3 }
    if lorenz_i256_projection_roundoff_audit_fingerprint(
        budget_fp, 87220663, 149359034, 166945519, 184, 31) != (0 - 1) { return 4 }

    return 0
}
