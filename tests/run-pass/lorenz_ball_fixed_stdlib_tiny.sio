//@ run-pass
//@ description: Imported systems::ball_fixed Lorenz radius primitive gate

use systems::ball_fixed::*

fn main() -> i64 with Div {
    let scale: i64 = 1000000
    let dt: i64 = 10000
    let xr: i64 = 10
    let yr: i64 = 10
    let zr: i64 = 10

    if ball_fixed_module_ready() != 1 { return 1 }
    if ball_fixed_abs64(0 - 27) != 27 { return 2 }
    if ball_fixed_floor_div_nonneg(2000000, scale) != 2 { return 3 }
    if ball_fixed_ceil_div_nonneg(80, 3) != 27 { return 4 }
    if ball_fixed_status_ok(13, scale, 1000000000) != 1 { return 5 }
    if ball_fixed_status_ok(0 - 1, scale, 1000000000) != 0 { return 6 }
    if ball_fixed_status_ok(13, 0, 1000000000) != 0 { return 7 }
    if ball_fixed_status_ok(13, scale, 0 - 1) != 0 { return 8 }

    let dx_rad: i64 = ball_fixed_lorenz_dx_radius(10, xr, yr)
    let x_rhoz_rad: i64 = ball_fixed_mul_radius_guarded(1000000, xr, 27000000, zr, scale)
    let dy_rad: i64 = ball_fixed_lorenz_dy_radius(1000000, xr, 27000000, zr, yr, scale)
    let xy_rad: i64 = ball_fixed_mul_radius_guarded(1000000, xr, 1000000, yr, scale)
    let beta_z_rad_tight: i64 = ball_fixed_beta_radius_tight(zr)
    let beta_z_rad_guarded: i64 = ball_fixed_beta_radius_guarded(zr)
    let dz_rad: i64 = ball_fixed_lorenz_dz_radius(1000000, xr, 1000000, yr, zr, scale)

    let nx_rad: i64 = ball_fixed_euler_radius_guarded(xr, dx_rad, dt, scale)
    let ny_rad: i64 = ball_fixed_euler_radius_guarded(yr, dy_rad, dt, scale)
    let nz_rad: i64 = ball_fixed_euler_radius_guarded(zr, dz_rad, dt, scale)

    let ny_center: i64 = 1260000
    let ny_lo: i64 = ball_fixed_bound_lo(ny_center, ny_rad)
    let ny_hi: i64 = ball_fixed_bound_hi(ny_center, ny_rad)

    let h2: i64 = ball_fixed_dt_square(dt)
    let lte_den: i64 = ball_fixed_lte_den(scale)
    let x_abs: i64 = 1000013
    let y_abs: i64 = 1260013
    let z_abs: i64 = 1000010
    let rhoz_abs: i64 = ball_fixed_max_abs_pair(28000000 - 983323, 28000000 - 1000010)
    let dx_abs: i64 = ball_fixed_lorenz_dx_abs_bound(x_abs, y_abs, 10)
    let dy_abs: i64 = ball_fixed_lorenz_dy_abs_bound(x_abs, rhoz_abs, y_abs, scale)
    let dz_abs: i64 = ball_fixed_lorenz_dz_abs_bound(x_abs, y_abs, z_abs, scale)
    let ddx_abs: i64 = ball_fixed_lorenz_ddx_abs_bound(dx_abs, dy_abs, 10)
    let ddy_abs: i64 = ball_fixed_lorenz_ddy_abs_bound(dx_abs, rhoz_abs, x_abs, dz_abs, dy_abs, scale)
    let ddz_abs: i64 = ball_fixed_lorenz_ddz_abs_bound(dx_abs, y_abs, x_abs, dy_abs, dz_abs, scale)
    let lte_x: i64 = ball_fixed_lte_radius_from_h2(ddx_abs, h2, lte_den)
    let lte_y: i64 = ball_fixed_lte_radius_from_h2(ddy_abs, h2, lte_den)
    let lte_z: i64 = ball_fixed_lte_radius_from_h2(ddz_abs, h2, lte_den)

    if dx_rad != 200 { return 20 }
    if x_rhoz_rad != 281 { return 21 }
    if dy_rad != 291 { return 22 }
    if xy_rad != 21 { return 23 }
    if beta_z_rad_tight != 27 { return 24 }
    if beta_z_rad_guarded != 28 { return 25 }
    if dz_rad != 49 { return 26 }
    if nx_rad != 13 { return 27 }
    if ny_rad != 13 { return 28 }
    if nz_rad != 11 { return 29 }
    if ny_lo != 1259987 { return 30 }
    if ny_hi != 1260013 { return 31 }
    if h2 != 100000000 { return 32 }
    if lte_den != 2000000000000 { return 33 }
    if rhoz_abs != 27016677 { return 34 }
    if dx_abs != 22600260 { return 35 }
    if dy_abs != 28277042 { return 36 }
    if dz_abs != 3926724 { return 37 }
    if ddx_abs != 508773020 { return 38 }
    if ddy_abs != 642787743 { return 39 }
    if ddz_abs != 67225296 { return 40 }
    if lte_x != 25439 { return 41 }
    if lte_y != 32140 { return 42 }
    if lte_z != 3362 { return 43 }
    if ball_fixed_add_lte_radius(nx_rad, lte_x) != 25452 { return 44 }
    if ball_fixed_add_lte_radius(ny_rad, lte_y) != 32153 { return 45 }
    if ball_fixed_add_lte_radius(nz_rad, lte_z) != 3373 { return 46 }
    if ball_fixed_bounds_match(1000000, 25452, 974548, 1025452) != 1 { return 47 }
    if ball_fixed_bounds_match(1260000, 32153, 1227847, 1292153) != 1 { return 48 }
    if ball_fixed_bounds_match(983334, 3373, 979961, 986707) != 1 { return 49 }
    if ball_fixed_contains_ball(1000000, 25452, 1000000, nx_rad) != 1 { return 50 }
    if ball_fixed_contains_ball(1260000, 32153, 1260000, ny_rad) != 1 { return 51 }
    if ball_fixed_contains_ball(983334, 3373, 983334, nz_rad) != 1 { return 52 }
    if ball_fixed_contains_value(1000000, 25452, 974548) != 1 { return 53 }
    if ball_fixed_contains_value(1000000, 25452, 1025453) != 0 { return 54 }
    if ball_fixed_enclosure_from_euler_lte(1000000, nx_rad, lte_x, 974548, 1025452) != 1 { return 55 }
    if ball_fixed_enclosure_from_euler_lte(1000000, nx_rad, lte_x, 974549, 1025452) != 0 { return 56 }
    if ball_fixed_validated_step3(1000000, 1260000, 983334,
                                  nx_rad, ny_rad, nz_rad,
                                  lte_x, lte_y, lte_z,
                                  974548, 1025452,
                                  1227847, 1292153,
                                  979961, 986707) != 1 { return 57 }
    if ball_fixed_validated_step3_fingerprint(1000000, 1260000, 983334,
                                              nx_rad, ny_rad, nz_rad,
                                              lte_x, lte_y, lte_z,
                                              974548, 1025452,
                                              1227847, 1292153,
                                              979961, 986707) != 242670977 { return 58 }
    if ball_fixed_validated_step3_chain_fingerprint(0, 1, scale, dt, 242670977) != 447483934 { return 59 }
    if ball_fixed_validated_step3(1000000, 1260000, 983334,
                                  nx_rad, ny_rad, nz_rad,
                                  lte_x, lte_y, lte_z,
                                  974549, 1025452,
                                  1227847, 1292153,
                                  979961, 986707) != 0 { return 70 }

    if ball_fixed_lorenz_dx_radius(0 - 10, xr, yr) != (0 - 1) { return 60 }
    if ball_fixed_lorenz_dy_radius(1000000, 0 - 1, 27000000, zr, yr, scale) != (0 - 1) { return 61 }
    if ball_fixed_lorenz_dz_radius(1000000, xr, 1000000, yr, 0 - 1, scale) != (0 - 1) { return 62 }
    if ball_fixed_lte_den(0) != (0 - 1) { return 63 }
    if ball_fixed_lte_radius(0 - 1, dt, scale) != (0 - 1) { return 64 }
    if ball_fixed_add_lte_radius(nx_rad, 0 - 1) != (0 - 1) { return 65 }
    if ball_fixed_contains_ball(1000000, 13, 1000000, 25452) != 0 { return 66 }
    if ball_fixed_bounds_match(1000000, 0 - 1, 999999, 1000001) != 0 { return 67 }
    if ball_fixed_validated_step3(1000000, 1260000, 983334,
                                  nx_rad, ny_rad, nz_rad,
                                  lte_x, 0 - 1, lte_z,
                                  974548, 1025452,
                                  1227847, 1292153,
                                  979961, 986707) != 0 { return 68 }
    if ball_fixed_validated_step3_fingerprint(1000000, 1260000, 983334,
                                              nx_rad, ny_rad, nz_rad,
                                              lte_x, 0 - 1, lte_z,
                                              974548, 1025452,
                                              1227847, 1292153,
                                              979961, 986707) != (0 - 1) { return 69 }
    if ball_fixed_validated_step3_chain_fingerprint(0, 0, scale, dt, 242670977) != (0 - 1) { return 71 }
    if ball_fixed_validated_step3_chain_fingerprint(0, 1, scale, dt, 0 - 1) != (0 - 1) { return 72 }

    return 0
}
