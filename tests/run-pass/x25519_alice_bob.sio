//@ run-pass
//@ requires: madaros
// RFC 7748 section 6.1's Alice/Bob X25519 Diffie-Hellman example. Fetched
// and independently byte-length-verified (64 hex chars == 32 bytes each)
// from https://www.rfc-editor.org/rfc/rfc7748.txt on 2026-08-25.
use crypto::x25519::*

fn main() -> i64 with IO {
    let alice_private: [u8;32] = [119, 7, 109, 10, 115, 24, 165, 125, 60, 22, 193, 114, 81, 178, 102, 69, 223, 76, 47, 135, 235, 192, 153, 42, 177, 119, 251, 165, 29, 185, 44, 42]
    let bob_private: [u8;32] = [93, 171, 8, 126, 98, 74, 138, 75, 121, 225, 127, 139, 131, 128, 14, 230, 111, 59, 177, 41, 38, 24, 182, 253, 28, 47, 139, 39, 255, 136, 224, 235]
    let expected_shared_secret: [u8;32] = [74, 93, 157, 91, 164, 206, 45, 225, 114, 142, 59, 244, 128, 53, 15, 37, 224, 126, 33, 201, 71, 209, 158, 51, 118, 240, 155, 60, 30, 22, 23, 66]

    let alice_public = x25519_base_point_mul(&alice_private)
    let bob_public = x25519_base_point_mul(&bob_private)

    let (shared_from_alice, ok_a) = x25519(&alice_private, &bob_public)
    if !ok_a { print_int(1); return 1 }
    let (shared_from_bob, ok_b) = x25519(&bob_private, &alice_public)
    if !ok_b { print_int(2); return 1 }

    // The core key-exchange property: both parties independently derive
    // the SAME shared secret.
    var i: i64 = 0
    while i < 32 {
        if shared_from_alice[i as usize] != shared_from_bob[i as usize] {
            print_int(3)
            return 1
        }
        i = i + 1
    }

    // And it matches RFC 7748's own published expected value.
    var j: i64 = 0
    while j < 32 {
        if shared_from_alice[j as usize] != expected_shared_secret[j as usize] {
            print_int(4)
            return 1
        }
        j = j + 1
    }

    println("x25519_alice_bob: both parties derive the same shared secret, matching RFC 7748's published value")
    return 0
}
