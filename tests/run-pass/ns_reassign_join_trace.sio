//@ run-pass
//@ known-failure: E245 (#1706) refuses Knowledge x Knowledge arithmetic on Madaros (no lowering) independently of the NS wire; this N2 witness is check-level only -- its NS_TRACE dataflow is asserted by scripts/ci/ns_dataflow_trace_gate.sh / ns_antigarbling_gate.sh
//@ requires: madaros
//@ expect-stdout: ns-reassign-join: PASS
//
// N2 negative control (codex ruling 2026-08-23): `var x = measure(1); x =
// measure(2)` must not leave x's checker-tracked noise_set_id pinned to the
// FIRST value's set forever. checker_check_assign_stmt_inplace never rebound
// env's TYPE on assignment at all before this fix -- x's env entry stayed
// exactly as declared, no matter how many times it was reassigned. The fix
// rebinds x, on every Knowledge-typed reassignment, to a monotone union of
// its OLD noise_set_id and the new value's (this checker is not flow-
// sensitive/SSA, so union -- never flow-sensitive replacement -- is the
// sound choice; REQ-4's top-absorbs rule means this also gives a loop-
// carried reassignment a real one-pass widen, see ns_loop_widen_top_trace.sio).
//
// Observable only under SOUNIO_NS_TRACE=1: two "NS_TRACE measure=<h>" seed
// lines with distinct handles, two "NS_TRACE union=<h>" laundering lines,
// then one "NS_TRACE reassign_join=<h>" line whose handle differs from
// EITHER individual assignment's own union handle (folds both).
//
// Per-rule sabotage: SOUNIO_NS_SABOTAGE_JOIN=1 skips the rebind entirely, so
// no "reassign_join" line is emitted at all -- the observable proof that
// this specific rule (not something else) produced it.

fn main() -> i64 with IO {
    let s1: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let w1: Knowledge[f64, epsilon < 1.0] = Knowledge(0.0, ε = 0.05)
    var x: Knowledge[f64, epsilon < 1.0] = s1 + w1

    let s2: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let w2: Knowledge[f64, epsilon < 1.0] = Knowledge(0.0, ε = 0.05)
    x = s2 + w2

    println("ns-reassign-join: PASS")
    0
}
