//@ run-pass
//@ expect-stdout: RETURN_HEX_INT_LITERAL_OK
// `return` followed by a hex integer keeps the value. Hex literals are their
// own token kind, and the "does an expression follow" list did not admit it:
// `return 0x10` parsed as a bare return, the literal was dropped, and the
// checker reported "expected i64, found ()" at `return`.
fn hex(j: i64) -> i64 {
    if j == 0 { return 0x10 }
    if j == 1 { return 0xBFE0000000000000 }
    if j == 2 { return 0x7FFF_FFFF }
    0
}

fn hex_tail_return() -> i64 {
    return 0x2A
}

fn main() with IO, Mut {
    var ok = true
    if hex(0) != 16 { ok = false }
    if hex(1) != (0 - 4620693217682128896) { ok = false }
    if hex(2) != 2147483647 { ok = false }
    if hex(3) != 0 { ok = false }
    if hex_tail_return() != 42 { ok = false }
    if ok { println("RETURN_HEX_INT_LITERAL_OK") } else { println("RETURN_HEX_INT_LITERAL_FAIL") }
}
