//@ run-pass
//@ expect-stdout: REF_OPTION_LOCAL_MATCH_TYPED_OK
// #2966 (gen3 wall Lowerer_fo_inline_note): a local bound to a REFERENCE to an
// Option<Box<T>> field -- `var cur = &(*h).items` -- carried no payload type, so
// in `match *cur { Some(n) => (*n).head.expr }` the binding `n` was untyped and
// `.expr` fell to the untyped field vote. Three structs below name `expr` at
// three different indices, so the vote has no majority and the read hashed
// to an unrelated word. The let path now types such a local like the field.
struct ExprAtOne {
    kind: i64,
    expr: i64,
}

struct ExprAtZero {
    expr: i64,
}

struct Node {
    a: i64,
    b: i64,
    c: i64,
    expr: i64,
}

struct List {
    head: Node,
    tail: Option<Box<List>>,
}

struct Holder {
    pad: i64,
    items: Option<Box<List>>,
}

fn sum_exprs(h: &Holder) -> i64 with Mut, Panic, Div {
    var acc: i64 = 0
    var cur = &(*h).items
    while true {
        match *cur {
            Some(n) => {
                acc = acc + (*n).head.expr
                cur = &(*n).tail
            }
            None => break
        }
    }
    acc
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let one = ExprAtOne { kind: 7, expr: 1000 }
    let zero = ExprAtZero { expr: 2000 }
    let n2 = List { head: Node { a: 1, b: 2, c: 3, expr: 30 }, tail: None }
    let n1 = List { head: Node { a: 4, b: 5, c: 6, expr: 12 }, tail: Some(Box::new(n2)) }
    let h = Holder { pad: 99, items: Some(Box::new(n1)) }
    let s = sum_exprs(&h)
    if s == 42 && one.kind + zero.expr == 2007 {
        println("REF_OPTION_LOCAL_MATCH_TYPED_OK")
        return 0
    }
    print("REF_OPTION_LOCAL_MATCH_TYPED_FAIL sum=")
    println(s)
    return 1
}
