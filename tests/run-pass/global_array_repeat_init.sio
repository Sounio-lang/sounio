//@ run-pass
// Madaros native-v2 must honour global array-repeat initializers `[V; N]`.
// Pre-fix: BSS stayed zero and print_int(CT[0]) printed 0 (silent wrong numbers).
// Acceptance: non-zero fill is visible to both print_int and integer compare.
//@ expect-stdout: 42 42 sum=84
//@ expect-stdout: 7 9
//@ expect-stdout: CT_OK

var CT: [i64; 2] = [42; 2]
var ZW: [i64; 2] = [0; 2]

fn main() -> i64 with IO, Mut {
    print_int(CT[0])
    print(" ")
    print_int(CT[1])
    print(" sum=")
    print_int(CT[0] + CT[1])
    print("\n")

    // Write path must still work (pre-existing, control).
    ZW[0] = 7
    ZW[1] = 9
    print_int(ZW[0])
    print(" ")
    print_int(ZW[1])
    print("\n")

    if CT[0] != 42 { return 1 }
    if CT[1] != 42 { return 2 }
    if ZW[0] != 7 { return 3 }
    if ZW[1] != 9 { return 4 }

    // Scalar global control (already worked pre-fix).
    print("CT_OK\n")
    0
}
