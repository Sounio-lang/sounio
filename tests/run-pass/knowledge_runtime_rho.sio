//@ run-pass
//@ requires: madaros
//@ expect-stdout: RUNTIME_RHO_OK
// correlate accepts the coefficient as a value, not only as a literal.
// The bars are computed too. The closed form below does not call variance_of.

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let a0 = 10.0
    let b0 = 2.0
    let ua = 0.05 + 0.05
    let ub = 0.1 + 0.1
    let rho = 0.25 + 0.25
    let rho_n = 0.0 - 0.5
    let ak: Knowledge<f64> = measure(a0, uncertainty: ua)
    let bk: Knowledge<f64> = measure(b0, uncertainty: ub)
    let v0 = variance_of(ak.value + bk.value)
    let xa: f64 = ak.value
    let yb: f64 = bk.value
    let _c = correlate(xa, yb, rho)
    let v1 = variance_of(ak.value + bk.value)
    let _d = correlate(xa, yb, rho_n)
    let v2 = variance_of(ak.value + bk.value)
    let expect0 = ua * ua + ub * ub
    let expect1 = expect0 + 2.0 * ua * ub * rho
    let expect2 = expect0 + 2.0 * ua * ub * rho_n
    print("v0 ")
    print_f64(v0)
    print(" v1 ")
    print_f64(v1)
    print(" v2 ")
    print_f64(v2)
    print("\n")
    if near(v0, expect0, 0.000001) && near(v1, expect1, 0.000001) && near(v2, expect2, 0.000001) {
        println("RUNTIME_RHO_OK")
        return 0
    }
    println("RUNTIME_RHO_FAIL")
    1
}
