//@ run-pass
//@ description: Imported LRAT binary-resolution unit proof step smoke

use theorem::lrat::*

fn main() -> i64 with Mut {
    lrat_reset()

    if lrat_add_clause4(1, 1, 2, 0, 0, 2) != 1 { return 1 }
    if lrat_add_clause4(2, 0 - 1, 2, 0, 0, 2) != 1 { return 2 }

    if lrat_check_binary_resolution_unit(1, 2, 1, 2) != 1 { return 3 }
    if lrat_check_binary_resolution_unit(2, 1, 0 - 1, 2) != 1 { return 4 }
    if lrat_add_binary_resolution_unit(3, 1, 2, 1, 2) != 1 { return 5 }
    if lrat_has_active(3) != 1 { return 6 }

    if lrat_check_binary_resolution_unit(1, 2, 1, 1) != 0 { return 7 }
    if lrat_check_binary_resolution_unit(1, 2, 2, 1) != 0 { return 8 }
    if lrat_check_binary_resolution_unit(1, 2, 0, 2) != 0 { return 9 }
    if lrat_add_binary_resolution_unit(3, 1, 2, 1, 2) != 0 { return 10 }

    if lrat_delete(2) != 1 { return 11 }
    if lrat_check_binary_resolution_unit(1, 2, 1, 2) != 0 { return 12 }

    return 0
}
