//@ run-pass
//@ description: io::sci_print::print_f64_sci prints f64 in C-style %e form (P1.9)
//@ expect-stdout-contains: zero=0.000000e+00
//@ expect-stdout-contains: negzero=0.000000e+00
//@ expect-stdout-contains: one=1.000000e+00
//@ expect-stdout-contains: small=2.517927e-07
//@ expect-stdout-contains: small10=2.517927000e-07
//@ expect-stdout-contains: big=1.234567e+12
//@ expect-stdout-contains: neg=-3.000000e-09
//@ expect-stdout-contains: decade=1.000000e-04
//@ expect-stdout-contains: decade_neg=-1.000000e+01
//@ expect-stdout-contains: keep=9.9999999e-05
//@ expect-stdout-contains: third=3.33333333e-01
//@ expect-stdout-contains: huge=1.79769313e+308
//@ expect-stdout-contains: tiny=2.22507386e-308
//@ expect-stdout-contains: subnormal=5.56268465e-309
//@ expect-stdout-contains: denorm_min=4.9e-324
//@ expect-stdout-contains: sig1=3e+00
//@ expect-stdout-contains: nan=NaN
//@ expect-stdout-contains: inf=inf
//@ expect-stdout-contains: ninf=-inf
//@ expect-stdout-contains: badsig=SCI_PRINT_ERROR_BAD_SIG
//@ expect-stdout-contains: SCI_PRINT_DONE
//
// `println(<f64>)` prints six fixed decimals, so 2.517927e-07 prints as
// 0.000000. The PBPK28 parity gate reshapes Sounio output with awk into
// benchmarks/pbpk/*.csv; the producers therefore print concentrations
// with print_f64_sci. This test pins the format on both engines:
//   ./bin/souc run tests/run-pass/io_sci_print_f64.sio
//   SOUNIO_SOUC_ENGINE=lean_single ./bin/souc run tests/run-pass/io_sci_print_f64.sio
// Values are locals only (no `&f64` dereference in arithmetic).
use io::sci_print::*

fn show(tag: string, x: f64, sig: i64) with IO, Mut {
    print(tag)
    print("=")
    println_f64_sci(x, sig)
}

fn main() -> i32 with IO, Mut {
    let zero = 0.0
    show("zero", zero, 7)
    show("negzero", 0.0 - zero, 7)
    show("one", 1.0, 7)
    show("small", 2.517927e-07, 7)
    show("small10", 2.517927e-07, 10)
    show("big", 1.234567e+12, 7)
    show("neg", -3.0e-9, 7)
    // Rounds up across a decade: 9.9999999e-05 at 7 digits is 1.000000e-04.
    show("decade", 9.9999999e-05, 7)
    show("decade_neg", -9.99999999, 7)
    show("keep", 9.9999999e-05, 8)
    show("third", 1.0 / 3.0, 9)
    show("huge", 1.7976931348623157e308, 9)
    show("tiny", 2.2250738585072014e-308, 9)
    // Subnormals are computed, not written as literals: measured
    // 2026-10-06, Madaros parses the literal 4.9406564584124654e-324 as 0.0
    // (lean_single keeps it), which is a literal-parsing issue, not a
    // printer one. 2^-1022 / 4 = 2^-1024 and 2^-1022 / 2^52 = 2^-1074 are
    // exact.
    let min_normal = 2.2250738585072014e-308
    show("subnormal", min_normal / 4.0, 9)
    show("denorm_min", min_normal / 4503599627370496.0, 2)
    show("sig1", 3.14159, 1)
    let nan = zero / zero
    show("nan", nan, 7)
    let inf = 1.0e308 * 10.0
    show("inf", inf, 7)
    show("ninf", 0.0 - inf, 7)
    show("badsig", 1.0, 16)
    println("SCI_PRINT_DONE")
    0
}
