//@ run-pass
//@ expect-stdout-contains: PBPK28_ORGAN_SINK_CN_PASS
//
// Organ sink inside the PBPK28 CN step (pbpk28_full_cn_step_sink_mut), on the
// venlafaxine parent profile with the CYP2D6 formation clearance on the liver.
// Imports only the kernel + params, in darwin_pbpk28_smoke's style, so it also
// runs under Madaros (scenarios/venlafaxine_xr pulls in release/matrix_er,
// which the Madaros checker currently segfaults on).
//
// 75 mg oral dose from a gut pool (ka = 0.63 /h), dt = 0.5 h, 48 h;
// CL_form = 43 · r / 3.45 L/h (Klamerus 1999 NM value scaled by Kirchheiner
// 2006 ODV/parent ratios r, as in pgx/cyp2d6_venlafaxine), CL_central = 57 L/h.
// CL_form·dt/V_liver spans 0.87 (PM) .. 35.7 (UM). Checks:
//   1. Per-step mass identity M_new = M_old + dt·input
//      − h·CL_c·(C_b,old + C_b,new) − removed, on every step where no state
//      was clamped; exact in the CN algebra, so tolerance = rounding (1e-12 mg).
//   2. Cumulative formation strictly increases PM < IM < NM < UM (an explicit
//      post-step sink capped at the liver content forms identical mass for
//      IM, NM and UM at this dt).
//   3. With no sink the step is bit-identical to the sink-free kernel as it
//      was before the sink existed. The reference is a frozen copy of that
//      kernel below (frozen_cn_step_mut), not a call into tsit5_pbpk28:
//      pbpk28_full_cn_step now delegates to the sink form, so comparing against
//      it would compare the routine with itself.

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*

fn fmt_9(x: f64) -> i64 { return (x * 1000000000.0) as i64 }

// ─── Frozen reference: the sink-free PBPK28 CN kernel before the sink ───────
// Verbatim copy of pbpk28_cn_apply_schur and pbpk28_full_cn_step_mut from
// stdlib/darwin_pbpk/tsit5_pbpk28.sio at d21af92b7 (main, last change before the
// organ sink). Do not edit to track the stdlib: its whole purpose is to stay
// the old arithmetic. The Schur reconstruction keeps its own function for the
// same Madaros reason as the original (second dynamic-index loop in the fill
// frame reads zeros; docs/audit/MADAROS_IMPORTED_PBPK28_CN_SIGSEGV_2026-08-16.md).
fn frozen_cn_apply_schur(
    state: &!PBPKState28,
    cb_new: f64,
    a_v: &[f64; 14],
    b_v: &[f64; 14],
    a_t: &[f64; 14],
    b_t: &[f64; 14]
) with Mut, Div {
    (*state).cv[0] = if cb_new < 0.0 { 0.0 } else { cb_new }
    var i: i32 = 1
    while i < 14 {
        let cv = (*a_v)[i] + (*b_v)[i] * cb_new
        let ct = (*a_t)[i] + (*b_t)[i] * cb_new
        (*state).cv[i] = if cv < 0.0 { 0.0 } else { cv }
        (*state).ct[i] = if ct < 0.0 { 0.0 } else { ct }
        i = i + 1
    }
}

fn frozen_cn_step_mut(state: &!PBPKState28, p: PBPKParams28, rel_mid: f64, dt: f64) with Mut, Div {
    var a_v: [f64; 14] = [0.0; 14]
    var b_v: [f64; 14] = [0.0; 14]
    var a_t: [f64; 14] = [0.0; 14]
    var b_t: [f64; 14] = [0.0; 14]
    let h = 0.5 * dt
    let vb = p.v_ref[0]

    var sum_q = 0.0
    var i: i32 = 1
    while i < 14 {
        sum_q = sum_q + p.q[i]
        i = i + 1
    }
    let big_s = h * (sum_q + p.cl_central) / vb

    let cb_old = (*state).cv[0]
    var rhs0 = (1.0 - big_s) * cb_old + dt * rel_mid / vb

    var sum_beta_a = 0.0
    var sum_beta_b = 0.0

    i = 1
    while i < 14 {
        let vi = p.v_ref[i]
        let vf = p.vasc_frac[i]
        let vv_raw = vi * vf
        let vt_raw = vi * (1.0 - vf)
        let vv = if vv_raw < 1.0e-30 { 1.0e-30 } else { vv_raw }
        let vt = if vt_raw < 1.0e-30 { 1.0e-30 } else { vt_raw }
        let kp = p.kp[i]
        let ps = p.ps[i]
        let qi = p.q[i]

        let beta  = h * qi / vb
        let gamma = h * qi / vv
        let pp    = 1.0 + h * (qi + ps) / vv
        let qq    = h * ps / (vv * kp)
        let rr    = h * ps / vt
        let sb    = 1.0 + h * ps / (vt * kp)
        let det   = pp * sb - qq * rr

        rhs0 = rhs0 + beta * (*state).cv[i]

        let rhs_v = gamma * cb_old + (1.0 - h * (qi + ps) / vv) * (*state).cv[i] + qq * (*state).ct[i]
        let rhs_t = rr * (*state).cv[i] + (1.0 - h * ps / (vt * kp)) * (*state).ct[i]

        let av = (sb * rhs_v + qq * rhs_t) / det
        let bv = (sb * gamma) / det
        let at = (rr * rhs_v + pp * rhs_t) / det
        let bt = (rr * gamma) / det

        a_v[i] = av
        b_v[i] = bv
        a_t[i] = at
        b_t[i] = bt

        sum_beta_a = sum_beta_a + beta * av
        sum_beta_b = sum_beta_b + beta * bv
        i = i + 1
    }

    let cb_new = (rhs0 + sum_beta_a) / ((1.0 + big_s) - sum_beta_b)
    frozen_cn_apply_schur(state, cb_new, &a_v, &b_v, &a_t, &b_t)
}

fn main() with Mut, Div, IO {
    let dt = 0.5
    let h = 0.5 * dt
    let frac = 0.2702133 // 1 − exp(−0.63 · 0.5), literal so both engines share it
    var pheno = 0
    var prev_formed = 0.0 - 1.0
    var order_ok = true
    while pheno < 4 {
        var r = 3.45
        if pheno == 0 { r = 0.25 }
        if pheno == 1 { r = 1.16 }
        if pheno == 3 { r = 10.3 }
        let clf = 43.0 * (r / 3.45)
        var pp = pbpk28_params_venlafaxine_parent()
        pp.cl_central = 57.0
        var par = pbpk28_state_zero()
        var gut = 75.0
        var formed = 0.0
        var max_res = 0.0
        var k = 0
        while k < 96 {
            let ab = gut * frac
            gut = gut - ab
            let m0 = pbpk28_total_mass(par, pp)
            let c0 = par.cv[0]
            let form = pbpk28_full_cn_step_sink_mut(&!par, pp, ab / dt, dt, 1, clf)
            let m1 = pbpk28_total_mass(par, pp)
            formed = formed + form
            var zeroed = par.cv[0] == 0.0
            var i = 1
            while i < 14 {
                if par.cv[i] == 0.0 || par.ct[i] == 0.0 { zeroed = true }
                i = i + 1
            }
            if !zeroed {
                var res = m1 - (m0 + ab - h * pp.cl_central * (c0 + par.cv[0]) - form)
                if res < 0.0 { res = 0.0 - res }
                if res > max_res { max_res = res }
            }
            k = k + 1
        }
        print("pheno="); print(pheno)
        print(" formed_mg*1e9="); print(fmt_9(formed))
        print(" max_res_unclamped_mg*1e9="); println(fmt_9(max_res))
        if !(formed > prev_formed) { order_ok = false }
        if !(max_res < 1.0e-12) { order_ok = false }
        prev_formed = formed
        pheno = pheno + 1
    }
    if !order_ok {
        println("FAIL: organ-sink identity or phenotype ordering")
        return
    }

    let p0 = pbpk28_params_venlafaxine_parent()
    var s1 = pbpk28_state_zero()
    var s2 = pbpk28_state_zero()
    var j = 0
    while j < 20 {
        var rel = 0.0
        if j < 6 { rel = 5.0 }
        let removed = pbpk28_full_cn_step_sink_mut(&!s1, p0, rel, 0.5, 0, 0.0)
        frozen_cn_step_mut(&!s2, p0, rel, 0.5)
        if removed != 0.0 {
            println("FAIL: sink-off step reported removed mass")
            return
        }
        var i = 0
        while i < 14 {
            if s1.cv[i] != s2.cv[i] || s1.ct[i] != s2.ct[i] {
                println("FAIL: sink-off step differs from the frozen pre-sink kernel")
                return
            }
            i = i + 1
        }
        j = j + 1
    }
    println("PBPK28_ORGAN_SINK_CN_PASS")
}
