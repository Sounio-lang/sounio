//@ check-only
// SYNC-004: epistemic analysis remains digest-only advice, never merge authority.

use epistemic::worldline_merge_advice::*

fn main() with Mut, Panic {
    let conflict = merge_digest32(11, 12, 13, 14)
    let implementation = merge_digest32(21, 22, 23, 24)
    let complete = merge_evidence_inventory(3, 2, 0, 0, 0, 2)
    let complete_advice = analyze_worldline_merge_digests(
        conflict, implementation, complete,
    )

    assert(complete_advice.evidence_categories_distinct)
    assert(complete_advice.digest_only)
    assert(!complete_advice.protected_plaintext_observed)
    assert(!complete_advice.branch_selected)
    assert(!complete_advice.branch_mutated)
    assert(!complete_advice.authoritative_decision)
    assert(complete_advice.human_review_required)
    assert(complete_advice.analysis_admissible)
    assert(!complete_advice.inference_deferred)

    let incomplete = merge_evidence_inventory(2, 1, 1, 1, 1, 3)
    let incomplete_advice = analyze_worldline_merge_digests(
        conflict, implementation, incomplete,
    )
    assert(incomplete_advice.analysis_admissible)
    assert(incomplete_advice.inference_deferred)
    assert(!incomplete_advice.authoritative_decision)

    let absent_conflict = merge_digest32(0, 0, 0, 0)
    let invalid_advice = analyze_worldline_merge_digests(
        absent_conflict, implementation, complete,
    )
    assert(!invalid_advice.analysis_admissible)
    assert(invalid_advice.inference_deferred)
    assert(invalid_advice.human_review_required)
}
