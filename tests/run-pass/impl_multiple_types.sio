//@ run-pass

// Multiple impls: same method name on different types.
// fn_find_method resolves by name + receiver hash.

struct Dog { name_len: i64 }
struct Cat { lives: i64 }

impl Dog {
    fn speak(self: Dog) -> i64 {
        1  // bark
    }
}

impl Cat {
    fn speak(self: Cat) -> i64 {
        2  // meow
    }
}

fn main() -> i64 with IO, Panic {
    let d = Dog { name_len: 5 }
    let c = Cat { lives: 9 }
    let bark = d.speak()
    let meow = c.speak()
    assert(bark == 1)
    assert(meow == 2)
    0
}
