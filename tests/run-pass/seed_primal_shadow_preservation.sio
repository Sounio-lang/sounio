// run-pass
// Regression: the integer assignment is compiled even when its branch is not
// taken. High derivative channels can remain live after the cast/assignment.
// Shadow propagation must never replace the ordinary arithmetic result.
fn close(a: f64, b: f64) -> bool {
    let d = a - b
    d > -0.000000001 && d < 0.000000001
}

fn probe(x: f64, expected_k: f64) -> i32 with IO, Mut, Div, Panic {
    let t = x * 1.4426950408889634 + 0.5
    var k = t as i64
    if (k as f64) > t { k = k - 1 }
    let converted = k as f64
    let product = (k as f64) * 0.6931471805599453
    let sum = (k as f64) + 0.6931471805599453
    let difference = (k as f64) - 0.6931471805599453
    let quotient = (k as f64) / 2.0
    let nested = x - (k as f64) * 0.6931471805599453
    if !close(converted, expected_k) { print("FAIL cast\n"); return 1 }
    if !close(product, expected_k * 0.6931471805599453) { print("FAIL product\n"); return 2 }
    if !close(sum, expected_k + 0.6931471805599453) { print("FAIL sum\n"); return 3 }
    if !close(difference, expected_k - 0.6931471805599453) { print("FAIL difference\n"); return 4 }
    if !close(quotient, expected_k / 2.0) { print("FAIL quotient\n"); return 5 }
    if !close(nested, x - expected_k * 0.6931471805599453) { print("FAIL nested\n"); return 6 }
    0
}

fn main() -> i32 with IO, Mut, Div, Panic {
    // The first two skip the integer adjustment; the negative case takes it.
    let a = probe(1.0, 1.0)
    if a != 0 { return a }
    let b = probe(2.0, 3.0)
    if b != 0 { return b }
    let c = probe(-1.0, -1.0)
    if c != 0 { return c }
    print("PASS scalar primal preserved\n")
    0
}
