//@ run-pass
//@ requires: madaros
//@ expect-stdout: unit foot scale: PASS

// ft must resolve without a user declaration. Mixed scales require `as`.
fn foot_value(x: ft) -> ft { x }

fn main() -> i32 with IO, Mut, Panic, Div {
    let a: m = 1.0
    let b: ft = foot_value(1.0)
    let c = a + (b as m)
    let back = ((b as m) as ft) as f64
    let delta = (c as f64) - 1.3048
    print_f64(c)
    print("\n")
    if delta > -1.0e-9 && delta < 1.0e-9
        && back > 0.999999999 && back < 1.000000001 {
        print("unit foot scale: PASS\n")
        return 0
    }
    return 1
}
