//@ run-pass
//@ expect-stdout: GENOMICS_KMER_LEGACY_PASS
use genomics::core::{dna_kmer_count,dna_kmer_count_checked}
fn main() with IO,Mut,Div,Panic {
 var seq:[i32;256]=[0;256]
 seq[0]=0;seq[1]=1;seq[2]=2;seq[3]=3
 let singles=dna_kmer_count(&seq,4,1)
 assert(singles.k==1 && singles.counts[0]==1 && singles.counts[1]==1 && singles.counts[2]==1 && singles.counts[3]==1)
 let pairs=dna_kmer_count(&seq,4,2)
 assert(pairs.k==2 && pairs.counts[1]==1 && pairs.counts[6]==1 && pairs.counts[11]==1 && pairs.counts[0]==0)
 var aa:[i32;256]=[0;256]
 let aaa=dna_kmer_count(&aa,4,2)
 assert(aaa.k==2 && aaa.counts[0]==3)
 let badk=dna_kmer_count(&seq,4,0)
 assert(badk.k==0 && badk.counts[0]==0)
 assert(dna_kmer_count(&seq,4,5).k==0)
 assert(dna_kmer_count(&seq,257,2).k==0)
 assert(dna_kmer_count(&seq,-1,2).k==0)
 assert(dna_kmer_count_checked(&seq,4,0).status==1)
 assert(dna_kmer_count_checked(&seq,257,2).status==2)
 assert(dna_kmer_count_checked(&seq,0,4).status==0)
 seq[1]=-1
 let amb=dna_kmer_count_checked(&seq,4,2)
 assert(amb.status==0 && amb.accepted_bases==3 && amb.ambiguous_bases==1 && amb.total_windows==1 && amb.counts[11]==1)
 let old=dna_kmer_count(&seq,4,2)
 assert(old.k==2 && old.counts[11]==1 && old.counts[1]==0)
 println("GENOMICS_KMER_LEGACY_PASS")
 0
}
