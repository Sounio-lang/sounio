//@ ignore
// Helper module for tests/run-pass/imported_array_struct_field.sio -- not a
// standalone test. Declares two structs that SHARE the field names `value` and
// `value_len` at DIFFERENT field indices (Other: 3/4, Leaf: 1/2), with `Other`
// declared first so a name-only global field lookup resolves `value_len` to
// index 4 instead of Leaf's 2.
//
// See docs/audit/X509_PARSE_CERTIFICATE_SAN_VALUE_LEN_LOSS_2026-08-25.md.

pub struct Other { a: i32, b: i32, c: i32, value: [u8; 8], value_len: i32 }
pub struct Leaf { tag: i32, value: [u8; 8], value_len: i32 }
pub struct Owner { leaves: [Leaf; 4], count: i32 }

pub fn owner_zero() -> Owner {
    Owner {
        leaves: [
            Leaf { tag: 0, value: [0; 8], value_len: 0 },
            Leaf { tag: 0, value: [0; 8], value_len: 0 },
            Leaf { tag: 0, value: [0; 8], value_len: 0 },
            Leaf { tag: 0, value: [0; 8], value_len: 0 },
        ],
        count: 0,
    }
}

pub fn other_zero() -> Other {
    Other { a: 0, b: 0, c: 0, value: [0; 8], value_len: 0 }
}

// The WRITE happens in the DECLARING module, where `Leaf`'s layout is
// registered from its own declaration and `value_len` therefore resolves to
// field index 2.
pub fn owner_filled() -> Owner {
    var o = owner_zero()
    o.leaves[0].tag = 7
    o.leaves[0].value = [65; 8]
    o.leaves[0].value_len = 21
    o.count = 1
    o
}

// Control read, in the declaring module.
pub fn owner_read_here(o: &Owner) -> i64 {
    o.leaves[0].value_len as i64
}
