//@ run-pass
//@ requires: madaros
//@ expect-stdout: for3 0.810000
//@ expect-stdout: loop3 0.810000
//@ expect-stdout: closure 0.360000
//@ expect-stdout: FOR_LOOP_CALL_OK
// a = 5 +- 0.3, var = 0.09.
// for 0..3 and loop/break of three additions of the same a: 9 * 0.09.
// A closure inside the callee, |y| 2*y, is (2)^2 * 0.09.

fn add_for(x: f64) -> f64 {
    var acc = 0.0
    for i in 0..3 {
        acc = acc + x
    }
    acc
}

fn add_loop(x: f64) -> f64 {
    var acc = 0.0
    var i = 0
    loop {
        if i >= 3 {
            break
        }
        acc = acc + x
        i = i + 1
    }
    acc
}

fn add_closure(x: f64) -> f64 {
    let f = |y: f64| 2.0 * y
    f(x)
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let for3 = variance_of(add_for(a))
    let loop3 = variance_of(add_loop(a))
    let closure = variance_of(add_closure(a))
    print("for3 ")
    print_f64(for3)
    println("")
    print("loop3 ")
    print_f64(loop3)
    println("")
    print("closure ")
    print_f64(closure)
    println("")
    var fails: i64 = 0
    if for3 < 0.809999 || for3 > 0.810001 { fails = fails + 1 }
    if loop3 < 0.809999 || loop3 > 0.810001 { fails = fails + 1 }
    if closure < 0.359999 || closure > 0.360001 { fails = fails + 1 }
    if fails == 0 {
        println("FOR_LOOP_CALL_OK")
        0
    } else {
        println("FOR_LOOP_CALL_FAIL")
        1
    }
}
