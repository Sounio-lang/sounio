//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_ALLOC_FAILURE_PASS
// Native Linux virtual-address failure, not a physical-memory stress test.
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_status,numeric_buffer_len,numeric_buffer_capacity,numeric_buffer_set,numeric_buffer_at,numeric_buffer_reserve,numeric_buffer_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
    let impossible=numeric_buffer_new(576460752303423488,4611686018427387904)
    assert(numeric_buffer_status(&impossible)==3)
    numeric_buffer_close(impossible)
    var original=numeric_buffer_new(16,4611686018427387904)
    assert(numeric_buffer_status(&original)==0)
    assert(numeric_buffer_set(&!original,15,123.5)==0)
    let failed=numeric_buffer_reserve(&!original,576460752303423488)
    assert(failed==3)
    assert(numeric_buffer_status(&original)==0)
    assert(numeric_buffer_len(&original)==16 && numeric_buffer_capacity(&original)==16)
    assert(numeric_buffer_at(&original,15)==123.5)
    numeric_buffer_close(original)
    print("STDLIB_DEEP_ALLOC_FAILURE_PASS\n")
    return 0
}
