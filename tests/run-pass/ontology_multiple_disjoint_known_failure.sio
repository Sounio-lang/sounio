//@ run-pass
// Regression test for the Pass 2 disjoint parser boundary bug.
//
// Root cause: disjoint parser consumed consecutive declarations without
// semicolons as a single declaration, incorrectly pairing unrelated classes.
// Fix: boundary checks (class/disjoint/role/subclass_of) in skip_ontology_decl.

ontology Taxonomy {
    class LivingThing
    class Animal subclass_of LivingThing
    class Plant subclass_of LivingThing
    class Mammal subclass_of Animal
    class Reptile subclass_of Animal
    class Dog subclass_of Mammal
    class Cat subclass_of Mammal
    class Snake subclass_of Reptile
    disjoint Mammal, Reptile
    disjoint Dog, Cat
}

fn handle_mammal(m: Mammal) -> i32 with IO {
    println("mammal handled")
    0
}

fn main() -> i32 with IO {
    let d: Dog = make_dog()
    handle_mammal(d)
    println("multiple disjoint OK")
    0
}

fn make_dog() -> Dog { 0 as Dog }
