//@ run-pass
//@ description: Imported Lorenz i256 bounded trajectory manifest smoke

use systems::lorenz_i256_trajectory2_certificate_bounded_bridge::*
use systems::lorenz_i256_trajectory2_manifest_bounded_bridge::*

fn main() -> i64 with Div {
    let manifest = lorenz_i256_trajectory2_manifest_bounded_fingerprint(
        657108232, 734260981, 812457306, 73, 118, 2, 256, 1000000000)
    if manifest != 294601254 { return 1 }

    let from_cert = lorenz_i256_trajectory2_manifest_bounded_from_certificate(
        500000000, 0, 0, 0, 625000000, 1, 0, 0, 375000000, 0, 0, 0,
        750000000, 11, 0, 0, 812500000, 13, 0, 0, 187500000, 0, 0, 0,
        375000000, 32, 0, 0, 796875000, 326, 0, 0, 984375000, 161, 0, 0)
    if from_cert != 294601254 { return 2 }

    let mismatch = lorenz_i256_trajectory2_manifest_bounded_from_certificate(
        500000000, 0, 0, 0, 625000000, 1, 0, 0, 375000000, 0, 0, 0,
        750000001, 11, 0, 0, 812500000, 13, 0, 0, 187500000, 0, 0, 0,
        375000000, 32, 0, 0, 796875000, 326, 0, 0, 984375000, 161, 0, 0)
    if mismatch != 0 - 1 { return 3 }

    let bad_family = lorenz_i256_trajectory2_manifest_bounded_fingerprint(
        657108232, 734260981, 812457306, 74, 118, 2, 256, 1000000000)
    if bad_family != 0 - 1 { return 4 }

    let bad_kind = lorenz_i256_trajectory2_manifest_bounded_fingerprint(
        657108232, 734260981, 812457306, 73, 119, 2, 256, 1000000000)
    if bad_kind != 0 - 1 { return 5 }

    let certificate_anchor = lorenz_i256_trajectory2_certificate_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 118)
    if certificate_anchor != 918274650 { return 6 }

    let certificate_audit = lorenz_i256_trajectory2_certificate_bounded_bridge_audit_fingerprint(
        certificate_anchor, 675230419, 208746531, 734260981, 605913274,
        657108232, 250000085, 626001669, 2048507, 1, 1, 1, 1, 1, 1,
        256, 1000000000, 0, 0, 0, 0, 118, 4095)
    if certificate_audit != 341902786 { return 7 }

    let artifact = lorenz_i256_trajectory2_manifest_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 119)
    if artifact != 846135279 { return 8 }

    let audit = lorenz_i256_trajectory2_manifest_bounded_bridge_audit_fingerprint(
        artifact, 314708592, 860125473, certificate_anchor, certificate_audit,
        manifest, 734260981, 812457306, 73, 118, 2, 1, 1, 1, 1, 1,
        256, 1000000000, 0, 0, 0, 0, 119, 4095)
    if audit != 579264308 { return 9 }
    return 0
}
