//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_VIZ_COUNT_DIAGNOSTICS_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_at,numeric_buffer_set,numeric_buffer_close,numeric_matrix}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_at,integer_buffer_close}
use stats::regression::dynamic_count_glm::{dynamic_count_workspace,dynamic_count_fit}
use viz::count_diagnostics::{count_diagnostic_prepare,count_diagnostic_plan,count_diagnostic_svg,count_diagnostic_canvas}
use viz::scientific_document::{ScientificDocumentText}
use display::canvas::{Canvas,canvas_clear}
use viz::scatter::{scatter_project}
use io::sci_print::{println_f64_sci}
// Optional exact native-raster export; Linux fixture only. Read once, no env logging.
fn scientific_canvas_dump_enabled()->bool with IO,Mut,Div,Panic {
 let data=read_file("/proc/self/environ")
 let wanted="SOUNIO_VIZ_CANVAS_DUMP=1"
 let wanted_len=str_len(wanted)
 var size:i64=0;var found_end=false
 while size<1048575 {
  if data[size as usize]==0 {
   if data[(size+1) as usize]==0 {found_end=true;break}
  }
  size=size+1
 }
 if !found_end {return false}
 var at:i64=0
 while at<size {
  var end=at
  while end<size {if data[end as usize]==0 {break};end=end+1}
  if end-at==wanted_len {
   var same=true;var j:i64=0
   while j<wanted_len {
    if data[(at+j) as usize]!=(str_char_at(wanted,j) as i8) {same=false}
    j=j+1
   }
   if same {return true}
  }
  at=end+1
 }
 false
}
fn scientific_canvas_run(start:i64,length:i64,color:i64) with IO {
 print("CANVAS_RUN ");print(start);print(" ");print(length);print(" ");println(color)
}
fn scientific_canvas_dump(c:&Canvas) with IO,Mut,Div,Panic {
 if !scientific_canvas_dump_enabled() {return}
 let width:i64=c.width;let height:i64=c.height
 assert(width>0 && width<=4096 && height>0 && height<=4096)
 let total:i64=width*height
 assert(total<=16777216 && (c.pixels as i64)>0)
 print("CANVAS_SIZE ");print(width);print(" ");println(height)
 var start:i64=0;var color:i64=read_i64(c.pixels,0);var i:i64=1
 while i<total {
  let next:i64=read_i64(c.pixels,i)
  if next!=color {scientific_canvas_run(start,i-start,color);start=i;color=next}
  i=i+1
 }
 scientific_canvas_run(start,total-start,color)
 println("CANVAS_END")
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let n:i64=1028;let p:i64=2
 let need=dynamic_count_workspace(n,p)
 assert(need.status==0)
 var a=numeric_buffer_new(n*p,n*p*8);let layout=numeric_matrix(n*p,n,p,p,1,0)
 var counts=integer_buffer_new(n,n*8);var offsets=numeric_buffer_new(n,n*8)
 var initial=numeric_buffer_new(p,p*8);var beta=numeric_buffer_new(p,p*8)
 var means=numeric_buffer_new(n,n*8);var eta=numeric_buffer_new(n,n*8)
 var weighted=numeric_buffer_new(need.design_elements,need.design_elements*8)
 var rhs=numeric_buffer_new(n,n*8);var step=numeric_buffer_new(p,p*8)
 var qr=numeric_buffer_new(need.qr_elements,need.qr_elements*8)
 var stage=numeric_buffer_new(need.stage_elements,need.stage_elements*8)
 var observed=numeric_buffer_new(n,n*8);var residual=numeric_buffer_new(n,n*8)
 var om=integer_buffer_new(n,n*8);var rm=integer_buffer_new(n,n*8)
 var i:i64=0
 while i<n {
  integer_buffer_set(&!counts,i,(i%4)*2)
  numeric_buffer_set(&!a,i*2,if i%2==0 {1.0}else{0.0})
  numeric_buffer_set(&!a,i*2+1,if i%2==1 {1.0}else{0.0})
  i=i+1
 }
 let fit=dynamic_count_fit(&a,&layout,&counts,&offsets,&initial,0.25,0.0,100,1e-9,
 &!beta,&!means,&!eta,&!weighted,&!rhs,&!step,&!qr,&!stage)
 assert(fit.status==0 && fit.rank==2 && fit.rows==n && fit.inference_status==1 && !fit.assumptions_assessed)
 let data=count_diagnostic_prepare(&fit,&counts,&means,&!observed,&!residual,&!om,&!rm)
 assert(data.status==0 && data.n==n && data.residual_available==n && data.residual_unavailable==0)
 assert(!data.inference_available && !data.assumptions_assessed && data.payload_bytes==n*32)
 let plan=count_diagnostic_plan(&data,1380,620)
 assert(plan.status==0 && plan.identity_left && plan.zero_right)
 let chars:[i8;168]=[67,111,117,110,116,115,32,38,32,102,105,116,32,60,100,101,99,108,97,114,101,100,62,32,34,120,34,32,39,121,39,120,61,102,105,116,116,101,100,32,99,111,117,110,116,59,32,121,61,111,98,115,101,114,118,101,100,32,99,111,117,110,116,120,61,102,105,116,116,101,100,32,99,111,117,110,116,59,32,121,61,115,105,103,110,101,100,32,100,101,118,105,97,110,99,101,32,114,101,115,105,100,117,97,108,32,40,49,41,68,101,115,99,114,105,112,116,105,118,101,59,32,115,117,112,112,108,105,101,100,32,97,108,112,104,97,59,32,110,111,32,67,73,59,32,97,115,115,117,109,112,116,105,111,110,115,32,117,110,97,115,115,101,115,115,101,100,46]
 var bytes=integer_buffer_new(168,168*8)
 var bi:i64=0
 while bi<168 {let written=integer_buffer_set(&!bytes,bi,chars[bi as usize] as i64);bi=bi+1}
 let text=ScientificDocumentText{title_start:0,title_len:31,left_start:31,left_len:32,right_start:63,right_len:46,footer_start:109,footer_len:59}

 // An invalid final source row cannot partially overwrite prepared outputs.
 let saved:f64=numeric_buffer_at(&residual,n-1)
 integer_buffer_set(&!counts,n-1,-1)
 let invalid=count_diagnostic_prepare(&fit,&counts,&means,&!observed,&!residual,&!om,&!rm)
 assert(invalid.status==3 && numeric_buffer_at(&residual,n-1)==saved && numeric_buffer_at(&observed,n-1)==6.0)
 integer_buffer_set(&!counts,n-1,6)
 // Global preflight includes the final residual row before ANY SVG/Canvas output.
 numeric_buffer_set(&!residual,n-1,0.0/0.0)
 println("ZERO_SVG_BEGIN")
 let no_svg=count_diagnostic_svg(&fit,&data,&plan,&text,&bytes,&means,&observed,&residual,&om,&rm)
 println("ZERO_SVG_END")
 assert(no_svg.status==23)
 let pixels=heap_alloc(1380*620*8) as *mut i64
 assert((pixels as i64)>0)
 var canvas=Canvas{pixels:pixels,width:1380,height:620}
 canvas_clear(&!canvas,7,8,9)
 let no_canvas=count_diagnostic_canvas(&!canvas,&fit,&data,&plan,&text,&bytes,&means,&observed,&residual,&om,&rm)
 assert(no_canvas.status==23)
 i=0
 while i<1380*620 {assert(read_i64(canvas.pixels,i)==(7*65536+8*256+9));i=i+1}
 numeric_buffer_set(&!residual,n-1,saved)
 let drawn=count_diagnostic_canvas(&!canvas,&fit,&data,&plan,&text,&bytes,&means,&observed,&residual,&om,&rm)
 assert(drawn.status==0 && drawn.left_painted==n && drawn.right_painted==n)
 let point=scatter_project(numeric_buffer_at(&means,0),0.0,plan.left.xmin,plan.left.xmax,plan.left.ymin,plan.left.ymax,plan.left.x,plan.left.y,plan.left.w,plan.left.h,false)
 assert(point.status==0)
 let px:i64=point.x;let py:i64=point.y;let pixel:i64=read_i64(canvas.pixels,py*1380+px)
 print("COUNT_PIXEL ");print(px);print(" ");print(py);print(" ");println(pixel)
 println("COUNT_BOUND");println_f64_sci(data.residual_bound,15)
 i=0
 while i<4 {
  println("COUNT_ROW");println(i)
  println_f64_sci(numeric_buffer_at(&means,i),15)
  println_f64_sci(numeric_buffer_at(&residual,i),15)
  i=i+1
 }
 let svg=count_diagnostic_svg(&fit,&data,&plan,&text,&bytes,&means,&observed,&residual,&om,&rm)
 assert(svg.status==0 && svg.left_painted==n && svg.right_painted==n)
 scientific_canvas_dump(&canvas)
 heap_free(canvas.pixels as *mut i8)
 numeric_buffer_close(a);integer_buffer_close(counts);numeric_buffer_close(offsets);numeric_buffer_close(initial)
 numeric_buffer_close(beta);numeric_buffer_close(means);numeric_buffer_close(eta);numeric_buffer_close(weighted)
 numeric_buffer_close(rhs);numeric_buffer_close(step);numeric_buffer_close(qr);numeric_buffer_close(stage)
 numeric_buffer_close(observed);numeric_buffer_close(residual);integer_buffer_close(om);integer_buffer_close(rm);integer_buffer_close(bytes)
 println("STDLIB_DEEP_VIZ_COUNT_DIAGNOSTICS_PASS")
 0
}
