//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_VIZ_FOREST_PASS
//@ expect-stdout: forest n=2
// Existing API only: old production compiles but accepts the crowded forest.
use viz::ir::{viz_scene_new,viz_add_forest_interval_plot,viz_add_forest_plot,
 viz_layout_rect,viz_style_rgb,VIZ_INTERVAL_CONFIDENCE}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var e:[f64;1024]=[0.0;1024]
 var lo:[f64;1024]=[0.0;1024]
 var hi:[f64;1024]=[0.0;1024]
 var vars:[f64;1024]=[0.0;1024]
 var scene=viz_scene_new()
 let rect=viz_layout_rect(20,20,20,20)
 let style=viz_style_rgb(70,180,235)
 // Eight seven-pixel markers cannot fit: rejection must not mutate the scene.
 let crowded=viz_add_forest_interval_plot(&!scene,&e,&lo,&hi,8,VIZ_INTERVAL_CONFIDENCE,0.95,rect,style)
 assert(crowded==-1 && scene.series_count==0 && scene.node_count==0)
 assert(viz_add_forest_plot(&!scene,&e,&vars,8,rect,style)==-1)
 assert(scene.series_count==0 && scene.node_count==0)
 e[1]=10.0;lo[1]=10.0;hi[1]=10.0
 let node=viz_add_forest_interval_plot(&!scene,&e,&lo,&hi,2,VIZ_INTERVAL_CONFIDENCE,0.95,rect,style)
 assert(node==0)
 let pixels=heap_alloc(64*64*8) as *mut i64
 assert(pixels as i64!=0)
 var c=Canvas{pixels:pixels,width:64,height:64}
 canvas_clear(&!c,0,0,0)
 viz_canvas_render_scene(&scene,&!c)
 // Extreme-center 7x7 marker footprints must not escape the closed plot.
 var y:i64=0
 var painted:i64=0
 while y<64 {
  var x:i64=0
  while x<64 {
   let pixel=read_i64(c.pixels,y*64+x)
   if x<20 || x>40 || y<20 || y>40 {assert(pixel==0)}
   else {if pixel!=0 {painted=painted+1}}
   x=x+1
  }
  y=y+1
 }
 assert(painted>0)
 viz_html_emit_scene(&scene,64,64)
 // Invalid active rows in a mutated scene refuse the complete draw.
 scene.series[0].upper[1]= -1.0
 canvas_clear(&!c,0,0,0)
 viz_canvas_render_scene(&scene,&!c)
 y=0
 while y<64 {
  var x:i64=0
  while x<64 {assert(read_i64(c.pixels,y*64+x)==0);x=x+1}
  y=y+1
 }
 heap_free(c.pixels as *mut i8)
 println("STDLIB_DEEP_VIZ_FOREST_PASS")
 0
}
