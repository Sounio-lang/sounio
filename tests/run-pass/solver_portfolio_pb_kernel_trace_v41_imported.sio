//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v41 smoke for pseudo-Boolean kernel trace receipt

use theorem::portfolio::*

fn main() -> i64 {
    let receipt_fp = solver_portfolio_v41_pb_kernel_trace_fingerprint(
        478581235, 827870314, 258927862, 438043475,
        15302992, 788938861, 3, 31)
    if receipt_fp != 666560586 { return 1 }

    let audit_fp = solver_portfolio_v41_pb_kernel_trace_audit_fingerprint(
        receipt_fp, 478581235, 827870314, 983550353, 3, 31)
    if audit_fp != 879678645 { return 2 }

    let manifest_fp = solver_portfolio_v41_pb_kernel_trace_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 379464486 { return 3 }

    let result_fp = solver_portfolio_v41_result_coverage_fingerprint(
        41, 45, 10, 33, 1, 1, manifest_fp)
    if result_fp != 702770436 { return 4 }

    let family_fp = solver_portfolio_v41_checker_family_coverage_fingerprint(
        41, 45, 6, 3, 3, 2, 29, 2, manifest_fp)
    if family_fp != 141353377 { return 5 }

    let acceptance_fp = solver_portfolio_v41_acceptance_receipt_fingerprint(
        41, manifest_fp, result_fp)
    if acceptance_fp != 707086658 { return 6 }

    let audit_receipt_fp = solver_portfolio_v41_audit_receipt_fingerprint(
        41, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 860179250 { return 7 }

    let readiness_fp = solver_portfolio_v41_readiness_fingerprint(
        41, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 801644191 { return 8 }
    return 0
}
