//@ run-pass
//@ expect-stdout-contains: U64_2_63: PASS
//@ description: #3343 -- a declared u64 may use decimal 2^63. The parser must not reject this width-valid literal before the checker sees the declared type.

fn main() with IO {
    let x: u64 = 9223372036854775808
    if x == 0x8000000000000000 { print("U64_2_63: PASS\n") } else { print("U64_2_63: FAIL\n") }
}
