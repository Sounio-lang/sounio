//@ run-pass
//@ expect-stdout: unspecified epsilon: PASS

// Knowledge<f64> (no epsilon) should be compatible with any epsilon bound
fn needs_epsilon(k: Knowledge<f64, epsilon < 0.05>) -> f64 {
    k.value
}

fn accepts_any(k: Knowledge<f64>) -> f64 {
    k.value
}

fn main() -> i32 with IO, Epistemic {
    let k: Knowledge<f64> = measure(500.0, uncertainty: 2.5)
    let result = accepts_any(k)
    print("unspecified epsilon: PASS\n")
    return 0
}
