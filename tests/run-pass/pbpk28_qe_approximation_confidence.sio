//@ run-pass
//@ description: PBPK28 QE-TMDD priors as Knowledge<f64, ε>. A receptor-occupancy term
//@ declared at the HONEST ceiling (with Epistemic(500), the weakest = in-vivo target
//@ density prior) compiles and runs; Epistemic(510) is rejected.
//@ Epistemic witness for stdlib/darwin_pbpk/tmdd/qe_approximation.sio (Contribution 2).
//
// The stdlib module stores C_tot, Kd, R_total as plain f64 (Madaros-safe); here they
// are wrapped as Knowledge<f64, ε>, so the literature confidence flows into the
// compile-time gate.
//   C_tot   eps=0.90  dose/assay
//   Kd      eps=0.70  in-vitro binding
//   R_total eps=0.50  target density in vivo  <- weakest, ceiling 500

fn qe_occupancy_budget() -> f64 with Epistemic(500), Mut, Div, Panic {
    let c_tot: Knowledge[f64] = Knowledge(100.0, ε=0.90, prov="dose_assay_derived");
    let kd: Knowledge[f64] = Knowledge(1.0, ε=0.70, prov="SPR_invitro_Kd");
    let r_total: Knowledge[f64] = Knowledge(50.0, ε=0.50, prov="receptor_density_invivo");
    c_tot.value / (kd.value + c_tot.value) * r_total.value
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    println(qe_occupancy_budget());
    println("PBPK28_QE_APPROXIMATION_GATE_PASS");
}
