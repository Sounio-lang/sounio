//@ run-pass
//@ requires: madaros
//@ expect-stdout: GENERIC_BOOL_LITERAL_OK
// ExprKind represents boolean literals as ExprBoolTrue/ExprBoolFalse, not
// ExprBoolLit. Both literals must infer the same concrete scalar type.
fn keep<T>(x: T) -> T { x }
fn apply<T>(f: fn(T) -> T with Mut, x: T) -> T with Mut { f(x) }

fn main() -> i64 with IO, Mut, Panic {
    let yes = keep(true)
    let no = keep(false)
    let true_peer = apply(|x| x == true, true)
    let false_peer = apply(|x| x == false, false)
    if yes && !no && true_peer && false_peer {
        print("GENERIC_BOOL_LITERAL_OK\n")
        return 0
    }
    1
}
