//@ run-pass
// stdlib/epistemic/pbox.sio self-test: interval construction, width,
// union/intersect/scale/add/mul_pos, ignorance ratio.
use epistemic::pbox::*

fn main() -> i32 with IO, Div {
    let fails = run_tests()
    if fails == 0 {
        println("EPISTEMIC_PBOX_OK")
        return 0
    }
    print("pbox failures: ")
    println(fails)
    1
}
