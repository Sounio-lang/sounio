//@ run-pass
//@ expect-stdout: SCATTER_CONSTANT_PASS
//@ expect-stdout: <circle cx="140" cy="70" r="3" fill="rgb(220,135,225)"/>
use viz::ir::{viz_scene_new,viz_add_scatter_chart,viz_layout_rect,viz_style_rgb}
use display::canvas::{Canvas,canvas_clear}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
fn main() with IO,Mut,Div,Alloc,Panic {
 let xs:[f64;1024]=[0.0;1024]
 let ys:[f64;1024]=[0.0;1024]
 var scene=viz_scene_new()
 assert(viz_add_scatter_chart(&!scene,&xs,&ys,1,viz_layout_rect(40,30,200,80),viz_style_rgb(220,135,225))==0)
 let pixels=heap_alloc(320*160*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:320,height:160}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,70*320+140)==220*65536+135*256+225)
 viz_html_emit_scene(&scene,320,160)
 println("SCATTER_CONSTANT_PASS")
 0
}
