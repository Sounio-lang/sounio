//@ run-pass
//@ expect-stdout: assignment rhs block expr passed

fn main() with IO, Mut {
    var x: i64 = 0
    x = { 1 }

    var y: i64 = 0
    y = if true { 2 } else { 3 }

    var z: i64 = 0
    z = match true { _ => { 4 } }

    let w = if true { 5 } else { 6 }

    if x == 1 && y == 2 && z == 4 && w == 5 {
        println("assignment rhs block expr passed")
    }
}
