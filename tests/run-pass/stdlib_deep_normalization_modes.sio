//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_NORMALIZATION_MODES_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_at,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
use genomics::dynamic_normalization::{dynamic_normalization_workspace,dynamic_median_ratio_size_factors}
use math::pure::{sqrt}
fn abs(x:f64)->f64 {if x<0.0 {-x}else{x}}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
    var counts=integer_buffer_new(9,72)
    let data:[i64;9]=[0,2,4,1,0,4,1,2,0]
    var i:i64=0
    while i<9 {integer_buffer_set(&!counts,i,data[i as usize]);i=i+1}
    let need=dynamic_normalization_workspace(3,3)
    var work=numeric_buffer_new(need,need*8)
    var flags=integer_buffer_new(6,48)
    var factors=numeric_buffer_new(3,24)
    var logs=numeric_buffer_new(3,24)
    numeric_buffer_set(&!factors,0,123.0)
    let strict=dynamic_median_ratio_size_factors(&counts,3,3,0,&!factors,&!logs,&!work,&!flags)
    assert(strict.status==3 && numeric_buffer_at(&factors,0)==123.0)
    let positive=dynamic_median_ratio_size_factors(&counts,3,3,1,&!factors,&!logs,&!work,&!flags)
    assert(positive.status==0 && positive.genes_used==3)
    assert(abs(numeric_buffer_at(&factors,1)-1.0)<1e-12)
    assert(abs(numeric_buffer_at(&logs,0)+numeric_buffer_at(&logs,2))<1e-12)
    assert(abs(numeric_buffer_at(&factors,2)/numeric_buffer_at(&factors,0)-sqrt(8.0))<1e-12)
    integer_buffer_set(&!counts,2,0);integer_buffer_set(&!counts,5,0)
    numeric_buffer_set(&!factors,0,123.0)
    let missing=dynamic_median_ratio_size_factors(&counts,3,3,1,&!factors,&!logs,&!work,&!flags)
    assert(missing.status==3 && numeric_buffer_at(&factors,0)==123.0)
    numeric_buffer_close(work);numeric_buffer_close(factors);numeric_buffer_close(logs)
    integer_buffer_close(counts);integer_buffer_close(flags)
    print("STDLIB_DEEP_NORMALIZATION_MODES_PASS\n")
    return 0
}
