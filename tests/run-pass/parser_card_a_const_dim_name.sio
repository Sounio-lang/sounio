//@ run-pass
//@ expect-stdout: CARD_A_CONST_DIM 0 9
//@ description: Card A: a named const array dimension parses, checks and runs (#1495).
//
// Was tests/compile-fail/parser_card_a_const_dim_name_checker_boundary.sio, which
// pinned the checker's refusal of a named length as a known boundary (and was
// itself listed in tests/known_failures/hardened_diagnostics_full_suite.txt,
// since neither engine emitted the message it expected). #1495 folds a
// top-level integer constant used as an array length to its literal on both
// engines, so the boundary is gone.

const PARSER_CARD_A_N: i64 = 4

fn main() -> i64 with IO, Mut, Panic, Div {
    var xs: [i64; PARSER_CARD_A_N] = [0; PARSER_CARD_A_N]
    xs[3] = 9
    print("CARD_A_CONST_DIM ")
    print_int(xs[0])
    print(" ")
    print_int(xs[3])
    print("\n")
    0
}
