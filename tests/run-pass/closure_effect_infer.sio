//@ run-pass
// Closure effect inference: body calling IO function should infer IO effect

fn print_val(x: i64) with IO {
    print_int(x)
}

fn apply_io(f: fn(i64) -> i64 with IO, x: i64) -> i64 with IO {
    f(x)
}

fn main() -> i32 with IO {
    // Closure body uses IO — effect should be inferred
    let log_and_return = |x: i64| -> i64 with IO {
        print_val(x)
        x
    }

    0
}
