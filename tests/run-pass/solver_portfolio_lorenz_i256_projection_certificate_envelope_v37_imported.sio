//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v37 smoke for Lorenz i256 projection certificate-envelope entry

use theorem::portfolio::*

fn main() -> i64 {
    let audit_fp = solver_portfolio_v37_lorenz_i256_projection_certificate_envelope_audit_fingerprint(
        77888110, 214180161, 890086395, 607091799, 693793961,
        80894555, 310218620, 501185861,
        149359034, 138609006, 488107916,
        114244647, 166945519,
        87220662, 677514412, 69322697, 31)
    if audit_fp != 245178976 { return 1 }

    let manifest_fp = solver_portfolio_v37_lorenz_i256_projection_certificate_envelope_bundle_fingerprint(
        77888110, audit_fp)
    if manifest_fp != 163659586 { return 2 }

    let result_fp = solver_portfolio_v37_result_coverage_fingerprint(
        37, 41, 10, 29, 1, 1, manifest_fp)
    if result_fp != 634889936 { return 3 }

    let family_fp = solver_portfolio_v37_checker_family_coverage_fingerprint(
        37, 41, 6, 3, 2, 2, 28, manifest_fp)
    if family_fp != 924050761 { return 4 }

    let acceptance_fp = solver_portfolio_v37_acceptance_receipt_fingerprint(
        37, manifest_fp, result_fp)
    if acceptance_fp != 284662936 { return 5 }

    let audit_receipt_fp = solver_portfolio_v37_audit_receipt_fingerprint(
        37, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 559786522 { return 6 }

    let readiness_fp = solver_portfolio_v37_readiness_fingerprint(
        37, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 51601364 { return 7 }

    return 0
}
