//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_METHOD_PASS

// Method FO — mangled pure-method transfer (receiver = param 0).
// Science-style: f64 FO inputs as method args; self is a namespace/handle.
// Residual: FO through self.field requires field FO (not this gate).

struct FoOps {
    tag: i64
}

impl FoOps {
    fn mul2(self: &FoOps, a: f64, b: f64) -> f64 {
        a * b
    }
    fn clearance(self: &FoOps, cl0: f64, eta: f64) -> f64 {
        cl0 * exp(eta)
    }
    fn css(self: &FoOps, f: f64, dose: f64, tau: f64, cl0: f64, eta: f64) -> f64 {
        ((f * dose) / tau) / (cl0 * exp(eta))
    }
}

fn free_clearance(cl0: f64, eta: f64) -> f64 {
    cl0 * exp(eta)
}

fn free_css(f: f64, dose: f64, tau: f64, cl0: f64, eta: f64) -> f64 {
    ((f * dose) / tau) / (cl0 * exp(eta))
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let ops = FoOps { tag: 0 }

    let ka: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let kb: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    let a = ka.value
    let b = kb.value
    let v_mul_m = variance_of(ops.mul2(a, b))
    let v_mul_p = variance_of(a * b)

    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kTau: Knowledge<f64> = measure(12.0, uncertainty: 0.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let f = kF.value
    let dose = kDose.value
    let tau = kTau.value
    let cl0 = kCL0.value
    let eta = kEta.value

    let v_cl_m = variance_of(ops.clearance(cl0, eta))
    let v_cl_f = variance_of(free_clearance(cl0, eta))
    let v_cl_i = variance_of(cl0 * exp(eta))

    let v_css_m = variance_of(ops.css(f, dose, tau, cl0, eta))
    let v_css_f = variance_of(free_css(f, dose, tau, cl0, eta))
    let m2_m = second_order_mean(ops.css(f, dose, tau, cl0, eta))
    let m2_f = second_order_mean(free_css(f, dose, tau, cl0, eta))

    print("v_mul_m="); print_f64(v_mul_m); print("\n")
    print("v_cl_m="); print_f64(v_cl_m); print("\n")
    print("v_css_m="); print_f64(v_css_m); print("\n")
    print("m2_m="); print_f64(m2_m); print("\n")

    let ok = abs_f(v_mul_m - v_mul_p) < 1.0e-9
        && abs_f(v_mul_m - 0.25) < 1.0e-9
        && abs_f(v_cl_m - v_cl_f) < 1.0e-9
        && abs_f(v_cl_m - v_cl_i) < 1.0e-9
        && abs_f(v_cl_m - 0.34) < 1.0e-9
        && abs_f(v_css_m - v_css_f) < 1.0e-9
        && abs_f(v_css_m - 0.795833) < 1.0e-4
        && abs_f(m2_m - m2_f) < 1.0e-9
        && abs_f(m2_m - 6.724) < 1.0e-3
    if ok {
        print("MADAROS_GUM_FO_METHOD_PASS\n")
    } else {
        print("MADAROS_GUM_FO_METHOD_FAIL\n")
    }
}
