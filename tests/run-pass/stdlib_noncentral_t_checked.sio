//@ run-pass
//@ expect-stdout: STDLIB_NONCENTRAL_T_CHECKED_PASS
use stats::noncentral_t::{noncentral_t_tails_checked,noncentral_t_quantile_checked}
use stats::checked_power::{power_onesample_checked,n_for_power_onesample_checked,n_for_power_twosample_checked}
fn main()->i32 with IO,Mut,Div,Panic {
 let inf=1.0e308*10.0
 let nan=inf-inf
 assert(noncentral_t_tails_checked(nan,5.0,1.0,4096,1.0e-11).status==2)
 assert(noncentral_t_tails_checked(1.0,inf,1.0,4096,1.0e-11).status==2)
 assert(noncentral_t_tails_checked(1.0,5.0,nan,4096,1.0e-11).status==2)
 assert(noncentral_t_tails_checked(1.0,5.0,1.0,0,1.0e-11).status==1)
 let endpoint=noncentral_t_tails_checked(inf,5.0,1.0,4096,1.0e-11)
 assert(endpoint.status==0 && endpoint.cdf==1.0 && endpoint.sf==0.0 && endpoint.log_sf< -1.0e308)
 let qend=noncentral_t_quantile_checked(5.0,1.0,0.0,true,4096,1.0e-11)
 assert(qend.status==0 && qend.available && qend.value>1.0e308)
 assert(noncentral_t_quantile_checked(5.0,1.0,nan,true,4096,1.0e-11).status==2)
 assert(noncentral_t_quantile_checked(5.0,1.0,0.25,true,1,1.0e-11).status==3)
 let zero=noncentral_t_tails_checked(0.0,5.0,0.0,4096,1.0e-11)
 assert(zero.status==0 && zero.cdf==0.5 && zero.sf==0.5)
 let mixture=noncentral_t_tails_checked(3.0,5.0,1.0,4096,1.0e-11)
 assert(mixture.status==0 && mixture.method==2 && mixture.mixture_terms>0 && mixture.mixture_terms<=4096)
 let integral=noncentral_t_tails_checked(3.0,5.0,-1.0,4096,1.0e-11)
 assert(integral.status==0 && integral.method==3 && integral.estimates_available)
 assert(integral.quadrature_evaluations+integral.truncation_evaluations<=4096)
 assert(integral.quadrature_relative_error_estimate>=0.0 && integral.quadrature_relative_error_estimate<=1.25e-12)
 let tiny=noncentral_t_tails_checked(1.0,1.0,-128.0,8192,1.0e-11)
 assert(tiny.status==0 && !tiny.sf_available && tiny.log_sf_available && tiny.log_sf< -8000.0)
 let negative=power_onesample_checked(-0.5,10,0.05,false,4096,1.0e-11)
 assert(negative.status==0 && negative.value_available && negative.value<0.05)
 let null=power_onesample_checked(0.0,10,0.05,true,4096,1.0e-11)
 assert(null.status==0 && null.value==0.05)
 let underflow=power_onesample_checked(-80.0,2,0.5,false,4096,1.0e-11)
 assert(underflow.status==0 && !underflow.value_available && underflow.log_available && underflow.log_value< -6000.0)
 let impossible=n_for_power_onesample_checked(0.0,0.8,0.05,true,1000,4096,1.0e-11)
 assert(impossible.status==7 && !impossible.available && impossible.n==0)
 let capped=n_for_power_twosample_checked(0.001,0.8,0.05,true,20,4096,1.0e-11)
 assert(capped.status==6 && !capped.available && capped.n==0 && capped.candidate_n==20 && capped.power_available && capped.power<0.8)
 println("STDLIB_NONCENTRAL_T_CHECKED_PASS")
 0
}
