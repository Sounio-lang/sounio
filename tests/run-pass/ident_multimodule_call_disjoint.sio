//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: IDENT_MULTIMODULE_CALL_PASS
//
// Prediction (multi-module call propagation + N-04 runtime identity):
// `twice_mod` is defined in an imported module. Its summary must be available
// when checking `main` (which is checked before imported modules in boot4), so
// `twice_mod(a) + twice_mod(b)` is accepted and lowers without a checker span
// table. Runtime observation identity also survives across the imported call:
// Cov(twice_mod(a).value, a.value) == 2.0 and Var(twice_mod(a).value - a.value) == 1.0.

use fixtures::ident_call_leaf::{twice_mod}

fn main() -> i64 with IO, Epistemic {
    let a = measure(10.0, uncertainty: 1.0)
    let b = measure(5.0, uncertainty: 2.0)
    let s = twice_mod(a) + twice_mod(b)
    var dv = s.value - 30.0
    if dv < 0.0 { dv = 0.0 - dv }
    var dvar = s.variance - 20.0
    if dvar < 0.0 { dvar = 0.0 - dvar }
    if dv > 1.0e-12 || dvar > 1.0e-12 { return 1 }

    let t = twice_mod(a)
    let cov = covariance_of(t.value, a.value)
    let vdiff = variance_of(t.value - a.value)
    var dc = cov - 2.0
    if dc < 0.0 { dc = 0.0 - dc }
    var dd = vdiff - 1.0
    if dd < 0.0 { dd = 0.0 - dd }
    if dc > 1.0e-12 || dd > 1.0e-12 { return 2 }

    println("IDENT_MULTIMODULE_CALL_PASS")
    0
}
