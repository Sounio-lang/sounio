//@ description: Imported Lorenz Taylor-2 remainder checker binds v43 bridge to final ball slack

use systems::ball_fixed::*

fn main() -> i64 with Div {
    let fp = ball_fixed_lorenz_taylor2_remainder_fingerprint(
        979362768, 1000000, 5, 2, 100,
        607000000, 809000000, 119000000,
        102, 135, 20,
        243366, 319640, 42448,
        250000, 325000, 50000,
        127)
    if fp != 320985955 { return 1 }

    let audit_fp = ball_fixed_lorenz_taylor2_remainder_audit_fingerprint(
        fp, 979362768, 70877465, 565673886, 114244647, 127)
    if audit_fp != 980184978 { return 2 }
    return 0
}
