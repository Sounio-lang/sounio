//@ run-pass
//@ requires: madaros
use crypto::poly1305::*
use net::socket::*

fn main() -> i64 with IO {
    // RFC 8439 section 2.5.2's standalone Poly1305 test vector.
    // Independently re-fetched from the primary RFC text on 2026-08-25;
    // key and tag below match the RFC verbatim.
    let key: [u8;32] = [
        0x85,0xd6,0xbe,0x78,0x57,0x55,0x6d,0x33,0x7f,0x44,0x52,0xfe,0x42,0xd5,0x06,0xa8,
        0x01,0x03,0x80,0x8a,0xfb,0x0d,0xb2,0xfd,0x4a,0xbf,0xf6,0xaf,0x41,0x49,0xf5,0x1b
    ]
    let expected_tag: [u8;16] = [
        0xa8,0x06,0x1d,0xc1,0x30,0x51,0x36,0xc6,0xc2,0x2b,0x8b,0xaf,0x0c,0x01,0x27,0xa9
    ]

    // "Cryptographic Forum Research Group" -- 34 ASCII bytes. Built by
    // iterating the literal string with the builtin str_len/str_char_at
    // (same pattern as tests/run-pass/hash_sha256_vectors.sio's
    // write_str), NOT by hand-typing 34 integer literals, to eliminate
    // manual transcription risk on this exact character count.
    let msg_literal = "Cryptographic Forum Research Group"
    let msg_len = str_len(msg_literal)
    if msg_len != 34 {
        print_int(2)
        return 2
    }

    let msg_buf = rawbuf_new(msg_len + 8)
    var i: i64 = 0
    while i < msg_len {
        rawbuf_set(&msg_buf, i, str_char_at(msg_literal, i))
        i = i + 1
    }

    let tag = poly1305_mac(&key, &msg_buf, msg_len)
    var j: i64 = 0
    while j < 16 {
        if tag[j as usize] != expected_tag[j as usize] {
            print_int(1)
            return 1
        }
        j = j + 1
    }

    println("poly1305_mac: matches RFC 8439 section 2.5.2's published test vector")
    return 0
}
