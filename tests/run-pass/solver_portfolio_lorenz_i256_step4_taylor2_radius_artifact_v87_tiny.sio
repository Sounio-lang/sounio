//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v87 smoke for Lorenz i256 step-4 Taylor-2 radius artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1811
    receipt_fp = mix(receipt_fp, 749342117, 5743)
    receipt_fp = mix(receipt_fp, 185341710, 5743)
    receipt_fp = mix(receipt_fp, 828962730, 5743)
    receipt_fp = mix(receipt_fp, 560222765, 5743)
    receipt_fp = mix(receipt_fp, 36838171, 5743)
    receipt_fp = mix(receipt_fp, 620969911, 5743)
    receipt_fp = mix(receipt_fp, 580966337, 5743)
    receipt_fp = mix(receipt_fp, 450696904, 5743)
    receipt_fp = mix(receipt_fp, 780071782, 5743)
    receipt_fp = mix(receipt_fp, 4, 5743)
    receipt_fp = mix(receipt_fp, 2, 5743)
    receipt_fp = mix(receipt_fp, 127, 5743)
    if receipt_fp != 950328729 { return 1 }

    var audit_fp: i64 = 1823
    audit_fp = mix(audit_fp, receipt_fp, 5749)
    audit_fp = mix(audit_fp, 749342117, 5749)
    audit_fp = mix(audit_fp, 185341710, 5749)
    audit_fp = mix(audit_fp, 828962730, 5749)
    audit_fp = mix(audit_fp, 560222765, 5749)
    audit_fp = mix(audit_fp, 450696904, 5749)
    audit_fp = mix(audit_fp, 780071782, 5749)
    audit_fp = mix(audit_fp, 580966337, 5749)
    audit_fp = mix(audit_fp, 4, 5749)
    audit_fp = mix(audit_fp, 2, 5749)
    audit_fp = mix(audit_fp, 127, 5749)
    if audit_fp != 922054061 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 90, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 90, 1103)
    if entry_fp != 249654257 { return 3 }

    let manifest_fp: i64 = 370584026
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 87, 1871)
    result_fp = mix(result_fp, 91, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 79, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 992759390 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 87, 1907)
    family_fp = mix(family_fp, 91, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 74, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 448571445 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 87, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 901275932 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 87, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 860684087 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 87, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 322940586 { return 8 }
    return 0
