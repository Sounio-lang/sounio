//@ run-pass
//@ requires: madaros
//@ expect-stdout: ns-env-join-match: PASS
//
// N2 negative control (codex ruling 2026-08-23, round 3): same env-φ hole
// as ns_env_join_ifelse_trace.sio, exercised through a match arm reassign
// instead of if/else. checker_check_match_expr_inplace's single
// checker_ns_branch_enter_inplace (covering the whole match, all arms are
// mutually exclusive branches of one construct) plus the one
// checker_merge_ns_reassigned_inplace call after the arm loop closes it the
// same way.
//
// Each arm yields `x` itself as its tail expression so all three arms stay
// type-compatible (E018) regardless of which one reassigns it -- the
// reassignment happens as a STATEMENT inside arm 1's body, before its tail
// expression.
//
// Observable proof is the same end-to-end shape as the if/else control:
// `x + w3` after the match unions x's POST-merge type with an empty set;
// "union=-1" there is the proof the forced-top survived past the match.
//
// Per-rule sabotage: SOUNIO_NS_SABOTAGE_JOIN=1 reproduces the pre-fix bug --
// x reverts to its pre-match handle, and the trailing union is a real
// (non-top) handle instead of -1.

fn main() -> i64 with IO {
    let s1: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let w1: Knowledge[f64, epsilon < 1.0] = Knowledge(0.0, ε = 0.05)
    var x: Knowledge[f64, epsilon < 1.0] = s1 + w1

    let choice: i64 = 1
    let _r: Knowledge[f64, epsilon < 1.0] = match choice {
        0 => { x }
        1 => {
            let s2: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
            let w2: Knowledge[f64, epsilon < 1.0] = Knowledge(0.0, ε = 0.05)
            x = s2 + w2
            x
        }
        _ => { x }
    }

    let w3: Knowledge[f64, epsilon < 1.0] = Knowledge(0.0, ε = 0.05)
    let y: Knowledge[f64, epsilon < 1.0] = x + w3

    println("ns-env-join-match: PASS")
    0
}
