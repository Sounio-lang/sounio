//@ run-pass
//@ expect-stdout: GENOMICS_KMER_STATUS_PASS
use genomics::kmer::{kmer_new,kmer_push_base,kmer_push_chunk,kmer_probability}
fn main() with IO,Mut,Div,Panic {
 var a:[i32;256]=[0;256]
 var invalid=kmer_new(0)
 assert(invalid.status==1 && invalid.k==0 && invalid.n_bins==0)
 assert(!kmer_push_chunk(&!invalid,&a,1) && invalid.status==1 && invalid.accepted_bases==0)
 assert(kmer_new(5).status==1 && kmer_new(-1).status==1)
 var state=kmer_new(2)
 assert(kmer_push_chunk(&!state,&a,0) && state.status==0 && state.total_windows==0)
 assert(kmer_probability(&state,0).status==3)
 assert(kmer_probability(&state,16).status==2)
 assert(kmer_push_base(&!state,0) && state.valid_run==1 && state.total_windows==0)
 assert(kmer_push_base(&!state,1) && state.rolling_index==1 && state.total_windows==1 && state.counts[1]==1)
 let p=kmer_probability(&state,1)
 assert(p.status==0 && p.value==1.0 && state.counts[1]==1 && state.total_windows==1)
 assert(kmer_push_base(&!state,4) && state.ambiguous_bases==1 && state.valid_run==0 && state.rolling_index==0)
 assert(kmer_push_base(&!state,-2147483647) && state.ambiguous_bases==2)
 assert(!kmer_push_chunk(&!state,&a,257) && state.status==2 && state.total_windows==1 && state.accepted_bases==2)
 assert(!kmer_push_base(&!state,0) && state.status==2 && state.accepted_bases==2)
 assert(kmer_probability(&state,1).status==1)
 var negative=kmer_new(1)
 assert(!kmer_push_chunk(&!negative,&a,-1) && negative.status==2 && negative.total_windows==0)
 var bad=kmer_new(4)
 bad.n_bins=1000
 assert(!kmer_push_base(&!bad,0) && bad.status==3 && bad.accepted_bases==0)
 var badindex=kmer_new(1)
 badindex.rolling_index=1
 assert(!kmer_push_chunk(&!badindex,&a,0) && badindex.status==3)
 var badcount=kmer_new(1)
 badcount.counts[0]=-1
 assert(!kmer_push_base(&!badcount,0) && badcount.status==3 && badcount.accepted_bases==0)
 var overflow=kmer_new(1)
 overflow.accepted_bases=9223372036854775807
 assert(!kmer_push_base(&!overflow,0) && overflow.status==4 && overflow.total_windows==0 && overflow.counts[0]==0)
 assert(overflow.accepted_bases==9223372036854775807)
 var ambiguous=kmer_new(1)
 ambiguous.ambiguous_bases=9223372036854775807
 assert(!kmer_push_base(&!ambiguous,-1) && ambiguous.status==4 && ambiguous.valid_run==0)
 var prefix=kmer_new(1)
 prefix.accepted_bases=9223372036854775806
 prefix.total_windows=9223372036854775806
 prefix.counts[0]=9223372036854775806
 assert(!kmer_push_chunk(&!prefix,&a,2) && prefix.status==4)
 assert(prefix.accepted_bases==9223372036854775807 && prefix.total_windows==9223372036854775807 && prefix.counts[0]==9223372036854775807)
 var poison=kmer_new(1)
 a[0]=3
 a[1]=-1
 assert(kmer_push_chunk(&!poison,&a,1) && poison.accepted_bases==1 && poison.ambiguous_bases==0 && poison.counts[3]==1)
 println("GENOMICS_KMER_STATUS_PASS")
 0
}
