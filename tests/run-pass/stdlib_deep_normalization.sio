//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: STDLIB_DEEP_NORMALIZATION_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_status,numeric_buffer_at,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_status,integer_buffer_set,integer_buffer_close}
use genomics::dynamic_normalization::{dynamic_normalization_workspace,dynamic_median_ratio_size_factors}
fn abs(x:f64)->f64 {if x<0.0 {-x}else{x}}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
    let genes:i64=20000
    let samples:i64=512
    var counts=integer_buffer_new(genes*samples,genes*samples*8)
    let need=dynamic_normalization_workspace(genes,samples)
    var work=numeric_buffer_new(need,need*8)
    var flags=integer_buffer_new(2*genes,2*genes*8)
    var factors=numeric_buffer_new(samples,samples*8)
    var logs=numeric_buffer_new(samples,samples*8)
    assert(integer_buffer_status(&counts)==0 && numeric_buffer_status(&work)==0)
    var g:i64=0
    while g<genes {
        var s:i64=0
        while s<samples {
            var factor:i64=1
            var j:i64=0
            while j<s%4 {factor=factor*2;j=j+1}
            integer_buffer_set(&!counts,g*samples+s,(g+1)*factor)
            s=s+1
        }
        g=g+1
    }
    let fitted=dynamic_median_ratio_size_factors(&counts,genes,samples,0,&!factors,&!logs,&!work,&!flags)
    assert(fitted.status==0 && fitted.genes_used==genes && fitted.genes_excluded==0)
    let first=numeric_buffer_at(&factors,0)
    var sum=0.0
    var s:i64=0
    while s<samples {
        var expected=1.0
        var j:i64=0
        while j<s%4 {expected=expected*2.0;j=j+1}
        assert(abs(numeric_buffer_at(&factors,s)/first-expected)<1.0e-10)
        sum=sum+numeric_buffer_at(&logs,s)
        s=s+1
    }
    assert(abs(sum)<1.0e-9)
    numeric_buffer_set(&!factors,0,123.0)
    integer_buffer_set(&!counts,0,9007199254740993)
    let inexact=dynamic_median_ratio_size_factors(&counts,genes,samples,0,&!factors,&!logs,&!work,&!flags)
    assert(inexact.status==5 && numeric_buffer_at(&factors,0)==123.0)
    integer_buffer_set(&!counts,0,-1)
    let negative=dynamic_median_ratio_size_factors(&counts,genes,samples,0,&!factors,&!logs,&!work,&!flags)
    assert(negative.status==2 && numeric_buffer_at(&factors,0)==123.0)
    numeric_buffer_close(factors)
    numeric_buffer_close(logs)
    numeric_buffer_close(work)
    integer_buffer_close(counts)
    integer_buffer_close(flags)
    print("STDLIB_DEEP_NORMALIZATION_PASS\n")
    return 0
}
