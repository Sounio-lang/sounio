//@ run-pass
//@ known-failure: Epistemic runtime not implemented
//@ expect-stdout: ALL 10 TESTS PASSED

// Self-contained run-pass test for the epistemic arena allocator.
// Rewritten to use global flat arrays (no local struct variables) to work
// with lean_single limitations (var = struct_fn() crashes compiler).

// ============================================================================
// GLOBAL ARENA STATE (flat arrays, no local struct vars)
// ============================================================================

var G_DATA:    [i64; 512] = [0; 512]
var G_VAR32:   [i64; 512] = [0; 512]
var G_PROV:    [i64; 512] = [0; 512]
var G_CONF:    [i64; 512] = [0; 512]
var G_OCC:     [i64; 512] = [0; 512]
var G_FREESTK: [i64; 512] = [0; 512]
var G_FREETOP: i64 = 0
var G_BUMP:    i64 = 0
var G_LIVE:    i64 = 0
var G_SLOT:    i64 = 0   // last allocated slot id

// ============================================================================
// MERKLE / HASH
// ============================================================================

// Salts as decimal to avoid hex literal issues in lean_single
// 0x4F4D4547 = 1330531655
// 0x4147454E = 1095715150
// 0x45534953 = 1163347283
// 0x76312E30 = 1983271984

fn g_mix(a: i64, b: i64, c: i64, salt: i64) -> i64 {
    ((a ^ b) + c + salt) ^ (a << 5) ^ (b >> 7)
}

fn g_root(p0: i64, p1: i64, p2: i64, p3: i64, p4: i64) -> i64 {
    let h0 = g_mix(p0, p1, p2, 1330531655)
    let h1 = g_mix(p3, p4, h0, 1095715150)
    let h2 = g_mix(h0, h1, p0 ^ p3, 1163347283)
    g_mix(h1, h2, p1 ^ p2, 1983271984)
}

fn g_hash(slot_id: i64, value: i64) -> i64 {
    var hash: i64 = 5381
    hash = hash * 33 + slot_id
    hash = hash * 33 + value
    hash & 9223372036854775807
}

fn g_seed(item_hash: i64) -> i64 {
    g_root(0, item_hash, 0, 0, 1)
}

fn g_merge(root: i64, item_hash: i64, variance: i64, confidence: i64) -> i64 {
    g_root(root, item_hash, variance, confidence, root ^ item_hash)
}

fn g_delta32(fidelity: i64, provenance: i64, quantum: i64) -> i64 with Div {
    let frac_f = fidelity - (fidelity / 8) * 8
    let frac_p = provenance - (provenance / 16) * 16
    let frac_q = quantum - (quantum / 32) * 32
    frac_f * 4 + frac_p * 2 + frac_q
}

// ============================================================================
// ARENA OPERATIONS ON GLOBALS
// ============================================================================

fn g_reset() with Mut, Panic {
    var i: i64 = 0
    while i < 512 {
        G_DATA[i] = 0
        G_VAR32[i] = 0
        G_PROV[i] = 0
        G_CONF[i] = 0
        G_OCC[i] = 0
        G_FREESTK[i] = 0
        i = i + 1
    }
    G_FREETOP = 0
    G_BUMP = 0
    G_LIVE = 0
    G_SLOT = 0
}

fn g_alloc(value: i64) with Mut, Panic {
    if G_FREETOP > 0 {
        G_FREETOP = G_FREETOP - 1
        let slot = G_FREESTK[G_FREETOP]
        G_FREESTK[G_FREETOP] = 0
        G_DATA[slot] = value
        G_OCC[slot] = 1
        let hash = g_hash(slot, value)
        let new_seed = g_seed(hash)
        G_PROV[slot] = g_merge(G_PROV[slot], new_seed, G_VAR32[slot] + 1, G_CONF[slot] + 1)
        G_VAR32[slot] = G_VAR32[slot] + 1
        G_CONF[slot] = G_CONF[slot] + 1
        G_LIVE = G_LIVE + 1
        G_SLOT = slot
        return
    }
    if G_BUMP < 512 {
        let slot = G_BUMP
        G_BUMP = G_BUMP + 1
        G_DATA[slot] = value
        G_OCC[slot] = 1
        let hash = g_hash(slot, value)
        G_PROV[slot] = g_seed(hash)
        G_VAR32[slot] = 0
        G_CONF[slot] = 1
        G_LIVE = G_LIVE + 1
        G_SLOT = slot
        return
    }
    G_SLOT = 0 - 1
}

fn g_free(id: i64) with Mut, Panic, Div {
    if id < 0 { return }
    if id >= G_BUMP { return }
    if G_OCC[id] != 1 { return }
    let free_hash = g_hash(id, G_DATA[id])
    G_PROV[id] = g_merge(G_PROV[id], free_hash, G_VAR32[id] + 1, G_CONF[id] + 1)
    G_VAR32[id] = G_VAR32[id] + 1
    G_CONF[id] = G_CONF[id] + 1
    G_OCC[id] = 0
    G_FREESTK[G_FREETOP] = id
    G_FREETOP = G_FREETOP + 1
    G_LIVE = G_LIVE - 1
}

fn g_set(id: i64, value: i64) with Mut, Panic, Div {
    if id < 0 { return }
    if id >= G_BUMP { return }
    if G_OCC[id] != 1 { return }
    G_DATA[id] = value
    let hash = g_hash(id, value)
    G_PROV[id] = g_merge(G_PROV[id], hash, G_VAR32[id] + 1, G_CONF[id] + 1)
    G_VAR32[id] = G_VAR32[id] + 1
    G_CONF[id] = G_CONF[id] + 1
}

fn g_is_live(id: i64) -> i64 with Div {
    if id < 0 { return 0 }
    if id >= G_BUMP { return 0 }
    G_OCC[id]
}

// ============================================================================
// TESTS
// ============================================================================

fn test_01_empty() -> i64 {
    g_reset()
    if G_LIVE == 0 { return 1 }
    0
}

fn test_02_alloc_single() -> i64 with Mut, Panic, Div {
    g_reset()
    g_alloc(42)
    let id = G_SLOT
    if id != 0 { return 0 }
    if G_LIVE != 1 { return 0 }
    if G_DATA[id] != 42 { return 0 }
    1
}

fn test_03_alloc_multiple() -> i64 with Mut, Panic, Div {
    g_reset()
    g_alloc(10)
    let id0 = G_SLOT
    g_alloc(20)
    let id1 = G_SLOT
    g_alloc(30)
    let id2 = G_SLOT
    if id0 != 0 { return 0 }
    if id1 != 1 { return 0 }
    if id2 != 2 { return 0 }
    if G_LIVE != 3 { return 0 }
    1
}

fn test_04_set_get() -> i64 with Mut, Panic, Div {
    g_reset()
    g_alloc(0)
    let id = G_SLOT
    g_set(id, 77)
    if G_DATA[id] != 77 { return 0 }
    1
}

fn test_05_provenance_seeded() -> i64 with Mut, Panic, Div {
    g_reset()
    g_alloc(99)
    let id = G_SLOT
    if G_PROV[id] == 0 { return 0 }
    if G_VAR32[id] != 0 { return 0 }
    if G_CONF[id] != 1 { return 0 }
    1
}

fn test_06_set_merges() -> i64 with Mut, Panic, Div {
    g_reset()
    g_alloc(10)
    let id = G_SLOT
    let prov_before = G_PROV[id]
    g_set(id, 20)
    let prov_after = G_PROV[id]
    if prov_after == prov_before { return 0 }
    if G_VAR32[id] != 1 { return 0 }
    if G_CONF[id] != 2 { return 0 }
    1
}

fn test_07_free() -> i64 with Mut, Panic, Div {
    g_reset()
    g_alloc(42)
    let id = G_SLOT
    g_free(id)
    if G_LIVE != 0 { return 0 }
    if g_is_live(id) != 0 { return 0 }
    1
}

fn test_08_free_realloc() -> i64 with Mut, Panic, Div {
    g_reset()
    g_alloc(42)
    let id0 = G_SLOT
    g_free(id0)
    g_alloc(99)
    let id1 = G_SLOT
    if id1 != id0 { return 0 }
    if G_DATA[id1] != 99 { return 0 }
    if G_VAR32[id1] <= 0 { return 0 }
    if G_CONF[id1] <= 1 { return 0 }
    1
}

fn test_09_delta32_bound() -> i64 with Mut, Panic, Div {
    g_reset()
    g_alloc(1)
    g_alloc(8)
    g_alloc(1)
    var i: i64 = 0
    while i < 3 {
        let d = g_delta32(G_VAR32[i], 0, G_CONF[i])
        if d < 0 { return 0 }
        if d >= 96 { return 0 }
        i = i + 1
    }
    1
}

fn test_10_chemical_self_check() -> i64 with Mut, Panic, Div {
    g_reset()
    g_alloc(1)
    let id_h1 = G_SLOT
    g_alloc(8)
    let id_o = G_SLOT
    g_alloc(1)
    let id_h2 = G_SLOT

    if G_LIVE != 3 { return 0 }
    if g_is_live(id_h1) == 0 { return 0 }
    if g_is_live(id_o) == 0 { return 0 }
    if g_is_live(id_h2) == 0 { return 0 }
    if G_DATA[id_h1] != 1 { return 0 }
    if G_DATA[id_o] != 8 { return 0 }
    if G_DATA[id_h2] != 1 { return 0 }
    if G_PROV[id_h1] == 0 { return 0 }
    if G_PROV[id_o] == 0 { return 0 }
    if G_PROV[id_h2] == 0 { return 0 }
    if G_PROV[id_h1] == G_PROV[id_h2] { return 0 }

    let d0 = g_delta32(G_VAR32[id_h1], 0, G_CONF[id_h1])
    let d1 = g_delta32(G_VAR32[id_o], 0, G_CONF[id_o])
    let d2 = g_delta32(G_VAR32[id_h2], 0, G_CONF[id_h2])
    if d0 < 0 { return 0 }
    if d0 >= 96 { return 0 }
    if d1 < 0 { return 0 }
    if d1 >= 96 { return 0 }
    if d2 < 0 { return 0 }
    if d2 >= 96 { return 0 }

    g_free(id_h2)
    if G_LIVE != 2 { return 0 }
    if g_is_live(id_h2) != 0 { return 0 }

    g_alloc(1)
    let id_h3 = G_SLOT
    if id_h3 != id_h2 { return 0 }
    if G_PROV[id_h3] == 0 { return 0 }
    if G_VAR32[id_h3] <= 0 { return 0 }
    if G_CONF[id_h3] <= 1 { return 0 }

    1
}

// ============================================================================
// MAIN — test harness
// ============================================================================

fn main() -> i64 with IO, Mut, Panic, Div {
    print("=== Epistemic Arena Tests ===\n")

    var passed: i64 = 0
    var failed: i64 = 0

    print("Test  1: Empty arena..................... ")
    if test_01_empty() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  2: Alloc single.................... ")
    if test_02_alloc_single() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  3: Alloc multiple.................. ")
    if test_03_alloc_multiple() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  4: Set/get......................... ")
    if test_04_set_get() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  5: Provenance seeded............... ")
    if test_05_provenance_seeded() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  6: Set merges provenance........... ")
    if test_06_set_merges() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  7: Free............................ ")
    if test_07_free() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  8: Free + realloc lineage.......... ")
    if test_08_free_realloc() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  9: delta_32 bound.................. ")
    if test_09_delta32_bound() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test 10: H2O chemical self-check......... ")
    if test_10_chemical_self_check() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("\nPassed: ")
    print_int(passed)
    print("\nFailed: ")
    print_int(failed)
    print("\n")

    if failed > 0 {
        print("SOME TESTS FAILED\n")
        return 1
    }
    print("ALL 10 TESTS PASSED\n")
    0
}
