// tests/run-pass/viz_module_surface_gate.sio - public viz module import smoke
//
// Expected output:
//   VIZ_MODULE_SURFACE_GATE_PASS

use display::canvas::{Canvas}
use display::event::{Event}
use render::renderer3d::{Tri3D}
use viz::audit::{viz_audit_hash}
use viz::authoring::{viz_molecule_constraint_default}
use viz::chart::{chart_line}
use viz::colormap::{viridis_r}
use viz::coord::{coord_new}
use viz::editor::{viz_edit_trace_new}
use viz::epiviz::{epiviz_band}
use viz::inspector::{viz_inspector_hit_node}
use viz::ir::{viz_scene_new, viz_layout_rect, viz_style_rgb, viz_add_line_chart}
use viz::mol3d::{mol3d_precompute_shadow}
use viz::molecule_editor::{viz_molecule_atom_count}
use viz::molecule_studio::{viz_molecule_studio_bind}
use viz::physchem::{molecule_h2o}
use viz::sci::{sci_pbpk_series}
use viz::viz_app::{viz_app_new}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use viz::viz_replay::{viz_replay_trace_new}
use viz::workbench::{viz_workbench_build_scene}

fn main() with IO, Alloc, Mut, Div {
    // Keep public modules importable through one compilation unit. Dedicated
    // tests below this gate prove behavior; this smoke catches module-surface
    // drift without duplicating all runtime assertions.
    if false {
        var c = Canvas { pixels: heap_alloc(16) as *mut i64, width: 2, height: 2 }
        let ev = Event { kind: 0, key: 0, x: 0, y: 0, mods: 0 }
        let tri = Tri3D {
            v0x: 0.0, v0y: 0.0, v0z: 0.0,
            v1x: 0.0, v1y: 0.0, v1z: 0.0,
            v2x: 0.0, v2y: 0.0, v2z: 0.0,
            nx: 0.0, ny: 0.0, nz: 1.0,
            base_r: 0, base_g: 0, base_b: 0,
        }
        var xs: [f64; 1024] = [0.0; 1024]
        var ys: [f64; 1024] = [0.0; 1024]
        var vars: [f64; 1024] = [0.0; 1024]
        var scene = viz_scene_new()
        let id = viz_add_line_chart(&!scene, &xs, &ys, 1, viz_layout_rect(0, 0, 16, 16), viz_style_rgb(255, 255, 255))
        let cs = coord_new(0.0, 1.0, 0.0, 1.0, 0, 0, 10, 10)
        let mol = molecule_h2o()
        var shadow: [f64; 64] = [0.0; 64]
        chart_line(&cs, &xs, &ys, 1, &!c, 0, 0, 0)
        epiviz_band(&cs, &xs, &ys, &vars, 1, &!c, 0, 0, 0)
        sci_pbpk_series(&cs, &ys, &vars, &xs, 1, &!c)
        mol3d_precompute_shadow(&mol, &!shadow)
        viz_molecule_studio_bind(&!scene, id)
        viz_canvas_render_scene(&scene, &!c)
        viz_html_emit_scene(&scene, 2, 2)
        viz_audit_hash(&scene)
        viz_molecule_constraint_default(id)
        viz_edit_trace_new()
        viz_replay_trace_new()
        viz_app_new(0, 0, 0)
        viz_molecule_atom_count(&scene, id)
        viz_inspector_hit_node(&scene, 0, 0, 80, 40, 4, 12)
        viz_workbench_build_scene(&!scene)
        viridis_r(0.0)
        if ev.kind == tri.base_r { println("unreachable") }
    }
    println("VIZ_MODULE_SURFACE_GATE_PASS")
}
