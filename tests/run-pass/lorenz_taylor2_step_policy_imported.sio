//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz Taylor-2 step-policy checker binds the v44 remainder to an accept-same-dt decision

use systems::ball_fixed::*

fn main() -> i64 with Div {
    let policy_fp = ball_fixed_lorenz_taylor2_step_policy_fingerprint(
        320985955, 980184978, 979362768, 127, 15000, 5000, 19000)
    if policy_fp != 403306384 { return 1 }

    let audit_fp = ball_fixed_lorenz_taylor2_step_policy_audit_fingerprint(
        policy_fp, 320985955, 980184978, 873855189, 311965616,
        101774289, 13149, 63)
    if audit_fp != 635367450 { return 2 }
    return 0
}
