    }

    var root_cert = certificate_zero()
    let (root_raw, root_status) = x509_parse_certificate(&root_buf, root_der_len)
    root_cert = root_raw
    if root_status != X509_OK { print_int(1); return 1 }
    if root_cert.public_key_algorithm != PUBKEY_ALG_EC_P384 { print_int(2); return 1 }

    var leaf_cert = certificate_zero()
    let (leaf_raw, leaf_status) = x509_parse_certificate(&leaf_buf, leaf_der_len)
    leaf_cert = leaf_raw
    if leaf_status != X509_OK { print_int(3); return 1 }
    if leaf_cert.public_key_algorithm != PUBKEY_ALG_EC_P256 { print_int(4); return 1 }

    let verified = x509_verify_signature(&leaf_buf, &leaf_cert, &root_cert)
    if verified == false { print_int(5); return 1 }
    assert(verified)

    println("x509_chain_ecdsa_p384_signature: OK")
    return 0
