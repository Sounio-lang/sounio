//@ run-pass
//@ known-failure: E245 (#1706) refuses Knowledge x Knowledge arithmetic on Madaros (no lowering) independently of the NS wire; this W4 witness is check-level only -- its "no E230" verdict is asserted by scripts/ci/ns_antigarbling_gate.sh
//@ requires: madaros
//@ expect-stdout: ns-sub-div-disjoint: PASS
//
// W4 OVER-REFUSAL GUARD, the plain case: a legitimately UNCORRELATED subtraction
// and division must still compile. Four independent measurements, four distinct
// noise symbols, no shared source anywhere -- so the covariance term the naive
// propagation drops is genuinely zero and there is nothing to refuse.
//
// The real risk of extending E230 to Sub/Div is over-refusal, and this is the
// witness that measures it rather than assuming it away.

fn main() -> i64 with IO {
    let a: Knowledge[f64, Measured] = measure(1.0, uncertainty: 0.1)
    let b: Knowledge[f64, Measured] = measure(2.0, uncertainty: 0.1)
    let c: Knowledge[f64, Measured] = measure(3.0, uncertainty: 0.1)
    let d: Knowledge[f64, Measured] = measure(4.0, uncertainty: 0.1)
    let diff: Knowledge[f64, Derived] = a - b
    let ratio: Knowledge[f64, Derived] = c / d
    println("ns-sub-div-disjoint: PASS")
    0
}
