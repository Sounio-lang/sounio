//@ run-pass

fn main() -> i32 with IO, Epistemic {
    let k0 = measure(3.0, uncertainty: 0.1)
    let k1 = measure(5.0, uncertainty: 0.2)
    let y = k0.value * k1.value
    let s0 = sensitivity_of(y, 0)
    let s1 = sensitivity_of(y, 1)
    assert(s0 > 4.99 && s0 < 5.01)
    assert(s1 > 2.99 && s1 < 3.01)
    0
}
