//@ run-pass

struct Entry {
    pub score: i64,
}

struct Driver {
    pub entries: [Entry; 4],
}

fn update(driver: &! Driver, index: i64, value: i64) with Mut, Panic {
    driver.entries[index as usize].score = value
}

fn main() -> i32 with IO, Mut, Panic {
    var driver = Driver { entries: [Entry { score: 0 }; 4] }
    update(&! driver, 2, 73)
    if driver.entries[2].score != 73 {
        println("FAIL: array-element field store not visible")
        return 1
    }
    println("PASS")
    return 0
}
