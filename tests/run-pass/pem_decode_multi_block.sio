        i = i + 1
    }

    // Same expected values as pem_decode_roundtrip.sio -- same source cert.
    let expected_der_len: i64 = 779

    // Call 1: block 1.
    let (der1, der_len1, next1, err1) = pem_decode_next(&pem_buf, pem_len, 0)
    if err1 != 0 {
        print_int(1)
        return 1
    }
    if next1 == (0 - 1) {
        print_int(2)
        return 1
    }
    if der_len1 != expected_der_len {
        print_int(3)
        return 1
    }
    if rawbuf_get(&der1, 0) != 0x30 {
        print_int(4)
        return 1
    }

