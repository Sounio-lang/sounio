//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: SCALE COUNT FIT TRACE PASS
use stats::regression::count_fit_trace::{count_fit_trace_slot,count_fit_trace_bounded,count_fit_trace_note,count_fit_trace_metric,count_fit_trace_status,count_fit_trace_reset,count_fit_trace_snapshot,count_fit_trace_add,count_fit_trace_incomplete}
fn main()->i32 with IO,Mut,Panic {
 var s=count_fit_trace_bounded(2)
 assert(count_fit_trace_note(&!s,1)==0)
 let saved=count_fit_trace_snapshot(&s)
 assert(saved.status==0 && saved.fit_calls==1 && saved.limit==2)
 assert(count_fit_trace_note(&!s,1)==0)
 assert(count_fit_trace_note(&!s,1)==1)
 assert(count_fit_trace_metric(&s,1)==2)
 assert(count_fit_trace_note(&!s,2)==1)
 assert(count_fit_trace_metric(&s,2)==0)
 count_fit_trace_reset(&!s)
 assert(count_fit_trace_status(&s)==0)
 assert(count_fit_trace_metric(&s,1)==0)
 assert(saved.fit_calls==1 && saved.status==0)
 var metric:i64=1
 while metric<=10 {
  assert(count_fit_trace_note(&!s,metric)==0)
  assert(count_fit_trace_metric(&s,metric)==1)
  metric=metric+1
 }
 assert(count_fit_trace_note(&!s,0)==2)
 assert(count_fit_trace_metric(&s,1)==1)
 assert(count_fit_trace_metric(&s,11)== -1)
 count_fit_trace_reset(&!s)
 metric=1
 while metric<=10 {assert(count_fit_trace_metric(&s,metric)==0);metric=metric+1}
 assert(count_fit_trace_add(&!s,1,3)==1)
 assert(count_fit_trace_metric(&s,1)==0)
 count_fit_trace_reset(&!s)
 assert(count_fit_trace_add(&!s,1,2)==0)
 assert(count_fit_trace_metric(&s,1)==2)
 assert(count_fit_trace_note(&!s,1)==1)
 count_fit_trace_reset(&!s)
 assert(count_fit_trace_add(&!s,1,-1)==2)
 assert(count_fit_trace_metric(&s,1)==0)
 count_fit_trace_reset(&!s)
 assert(count_fit_trace_incomplete(&!s)==1)
 assert(count_fit_trace_metric(&s,1)==0)
 var invalid=count_fit_trace_bounded(-1)
 assert(count_fit_trace_status(&invalid)==2)
 count_fit_trace_reset(&!invalid)
 assert(count_fit_trace_status(&invalid)==2)
 var hot=count_fit_trace_slot()
 var i:i64=0
 while i<1000000 {assert(count_fit_trace_note(&!hot,2)==0);i=i+1}
 assert(count_fit_trace_metric(&hot,2)==1000000)
 assert(count_fit_trace_metric(&hot,1)==0)
 assert(count_fit_trace_status(&hot)==0)
 println("SCALE COUNT FIT TRACE PASS")
 return 0
}
