fn receipt_reuse_case() with IO,Mut,Div,Panic {
 RHS_CALLS=0;EVENT_CALLS=0;let y:[f64;64]=[0.0;64];var opts=default_options();opts.dt_init=1.0;opts.dt_max=1.0
 var dense=dp54_dense_init();var receipt=dp54_event_init();let events=dp54_default_event_options()
 let first=solve_dp54_event64(constant_rhs,event_half_time,&y,1,0.0,1.0,opts,dp54_default_limits(),events,&!dense,&!receipt)
 event_meta("reuse_first",&first,&receipt,&dense);assert(first.status==5)
 RHS_CALLS=0;EVENT_CALLS=0;opts.dt_init=0.125;opts.dt_max=0.125
 let second=solve_dp54_event64(two_rhs,event_end_time,&first.state,1,first.t_final,0.625,opts,dp54_default_limits(),events,&!dense,&!receipt)
 event_meta("reuse_second",&second,&receipt,&dense);assert(second.status==0&&second.nfeval==7)
 let info=dp54_event_info(&receipt);assert(info.count==0&&!info.found)
 dp54_dense_close(dense);dp54_event_close(receipt)
}
fn represented_time_case(kind:i64) with IO,Mut,Div,Panic {
 RHS_CALLS=0;let y:[f64;64]=[0.0;64];var opts=default_options()
 if kind==0 {
  opts.dt_init=4.5e-15;opts.dt_max=4.5e-15;opts.dt_min=1e-30;opts.rtol=1.0;opts.atol=1.0
  let r=solve_dp54_64(large_rhs,&y,1,1.0,1.0000000000000089,opts)
  meta("actual_span",&r);emit("time.actual.mean",r.state[0]);emit("time.actual.time",r.t_final);assert(r.status==0)
 }
 if kind==1 {
  opts.dt_init=4.440892098500626e-16;opts.dt_max=4.440892098500626e-16;opts.dt_min=1e-30
  let r=solve_dp54_64(constant_rhs,&y,1,1.0,1.0000000000000004,opts)
