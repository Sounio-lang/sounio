//@ run-pass
// Direct regression witness for compiler::native_compile_driver's
// drv_emit_mov_reg_imm32/64 REX.B + (reg & 7) masking on extended registers
// R8-R15. The existing driver-argument witness
// (madaros_native_v2_driver_r8_const.sio) only reaches these emitters
// indirectly through a call-argument scenario whose ABI slots all land in
// registers 0-7, so it can't catch a regression in the R8-R15 encoding path
// on its own. This calls drv_test_mov_reg_imm_extended_reg, which invokes
// drv_emit_mov_reg_imm32(8, ...) and drv_emit_mov_reg_imm64(15, ...) directly
// and asserts the emitted bytes read back out of the driver's code buffer.
//@ requires: madaros
//@ expect-stdout: 42
use compiler::native_compile_driver::{drv_test_mov_reg_imm_extended_reg}

fn main() -> i64 with IO, Mut, Panic, Div {
    if drv_test_mov_reg_imm_extended_reg() == false {
        print("FAIL\n")
        return 1
    }
    print_int(42)
    0
}
