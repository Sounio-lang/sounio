//@ run-pass
//@ requires: madaros
//@ expect-stdout: ALL PASS
//
// Regression for issue #1502: an f64 tuple SLOT (`s.1`) was classified as
// integer by the IR lowering, because tuple elements are not named struct
// fields and every float lookup resolved by field NAME against struct_layouts.
// The misclassified value was then cvtsi2sd-corrupted the moment it entered
// f64 arithmetic, while COMPARISONS and a direct RETURN of the same slot were
// unaffected -- which is why it stayed invisible.
//
// Under Madaros this silently zeroed covariance() in stdlib/epistemic/
// correlation.sio (its accessor returns `(i64, f64)`), so
// eq_prob_correlated(x, x) reported 0.1403 instead of the exact identity 1.0:
// a value was not perfectly correlated with itself. lean_single was always
// correct, so CI never saw it.

fn pair() -> (i64, f64) { return (7, 3.0) }

fn main() with IO, Mut, Div, Panic {
    var ok = true
    let s = pair()

    // integer slot -- was always correct
    if s.0 == 7 { } else { ok = false }

    // comparison on the f64 slot -- was always correct
    if s.1 > 2.5 { } else { ok = false }

    // f64 arithmetic on the slot -- these three were the miscompile
    let doubled = s.1 * 2.0
    if doubled > 5.9 { } else { ok = false }
    if doubled < 6.1 { } else { ok = false }

    let summed = 0.0 + s.1
    if summed > 2.9 { } else { ok = false }
    if summed < 3.1 { } else { ok = false }

    var acc = 0.0
    acc = acc + s.1
    if acc > 2.9 { } else { ok = false }
    if acc < 3.1 { } else { ok = false }

    // slot read straight off the call, with no intervening binding
    let direct = pair().1 * 2.0
    if direct > 5.9 { } else { ok = false }
    if direct < 6.1 { } else { ok = false }

    if ok { print("ALL PASS") } else { print("SOME FAIL") }
}
