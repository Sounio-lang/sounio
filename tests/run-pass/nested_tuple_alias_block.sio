//@ run-pass
//@ requires: madaros
//@ expect-stdout: NESTED_TUPLE_ALIAS_BLOCK_OK

var PAIR_CALLS: i64 = 0

fn pair_once() -> (i64, f64) with Mut {
    PAIR_CALLS = PAIR_CALLS + 1
    (7, 2.0)
}

fn choose(flag: bool) -> f64 with Mut {
    if flag {
        let t = (7, 2.0)
        let u = t
        u.1
    } else {
        let t = (9, 4.0)
        let u = t
        u.1
    }
}

fn choose_chain(flag: bool) -> f64 with Mut {
    if flag {
        let t = (7, 2.0)
        let u = t
        let v = u
        v.1
    } else {
        let t = (9, 4.0)
        let u = t
        let v = u
        v.1
    }
}

fn choose_called(flag: bool) -> f64 with Mut {
    if flag {
        let t = pair_once()
        let u = t
        let v = u
        v.1
    } else {
        let t = pair_once()
        let u = t
        let v = u
        v.1
    }
}

fn choose_integer(flag: bool) -> i64 with Mut {
    if flag {
        let t = (7, 9)
        let u = t
        u.0
    } else {
        let t = (9, 7)
        let u = t
        u.0
    }
}

fn main() -> i32 with IO, Mut, Div {
    if choose(true) / 16.0 != 0.125 { return 1 }
    if choose(false) / 16.0 != 0.25 { return 2 }
    if choose_chain(true) / 16.0 != 0.125 { return 3 }
    if choose_chain(false) / 16.0 != 0.25 { return 4 }
    if choose_integer(true) / 2 != 3 { return 5 }
    if choose_integer(false) / 2 != 4 { return 6 }
    PAIR_CALLS = 0
    let yes = choose_called(true)
    if yes / 16.0 != 0.125 || PAIR_CALLS != 1 { return 7 }
    PAIR_CALLS = 0
    let no = choose_called(false)
    if no / 16.0 != 0.125 || PAIR_CALLS != 1 { return 8 }
    println("NESTED_TUPLE_ALIAS_BLOCK_OK")
    0
}
