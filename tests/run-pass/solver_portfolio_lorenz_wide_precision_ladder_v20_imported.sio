//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v20 Lorenz i128/i256 wide-precision ladder smoke

use theorem::portfolio::*

fn main() -> i64 with Mod {
    let i128_fp = solver_portfolio_v20_i128_enclosure_receipt_fingerprint(
        128, 1000000, 5,
        1236316, 2341979, 951078,
        243366, 319640, 42448,
        992950, 1479682,
        2022339, 2661619,
        908630, 993526)
    if i128_fp != 302145212 { return 1 }

    let instance_fp = solver_portfolio_v20_lorenz_precision_ladder_instance_fingerprint(
        128, 256, 5, 5, 1000000, 32, 508132668)
    if instance_fp != 725615043 { return 2 }

    let certificate_fp = solver_portfolio_v20_lorenz_precision_ladder_certificate_fingerprint(
        instance_fp, i128_fp, 626160047, 295040814, 128, 256, 1, 1)
    if certificate_fp != 455456906 { return 3 }

    let entry_fp = portfolio_entry_fingerprint(
        portfolio_kind_lorenz_wide_precision_ladder(),
        instance_fp,
        certificate_fp,
        portfolio_result_validated(),
        portfolio_checker_lorenz_wide_precision_ladder())
    if entry_fp != 124720146 { return 4 }

    let manifest_fp = solver_portfolio_v20_lorenz_wide_precision_ladder_bundle_fingerprint(
        i128_fp, 626160047, 295040814, 508132668)
    if manifest_fp != 158082390 { return 5 }

    let result_coverage_fp = solver_portfolio_v20_result_coverage_fingerprint(
        20, 24, 8, 14, 1, 1, manifest_fp)
    if result_coverage_fp != 2761010 { return 6 }

    let family_coverage_fp = solver_portfolio_v20_checker_family_coverage_fingerprint(
        20, 24, 4, 3, 2, 1, 14, manifest_fp)
    if family_coverage_fp != 251415300 { return 7 }

    let acceptance_fp = solver_portfolio_v20_acceptance_receipt_fingerprint(
        20, manifest_fp, result_coverage_fp)
    if acceptance_fp != 128854088 { return 8 }

    let audit_fp = solver_portfolio_v20_audit_receipt_fingerprint(
        20, manifest_fp, result_coverage_fp, family_coverage_fp, acceptance_fp)
    if audit_fp != 610639541 { return 9 }

    let readiness_fp = solver_portfolio_v20_readiness_fingerprint(
        20, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp)
    if readiness_fp != 511521805 { return 10 }

    if solver_portfolio_v20_lorenz_wide_precision_ladder_bundle_fingerprint(
        i128_fp + 1, 626160047, 295040814, 508132668) != (0 - 1) { return 11 }
    if solver_portfolio_v20_result_coverage_fingerprint(
        20, 24, 8, 13, 1, 1, manifest_fp) != (0 - 1) { return 12 }
    if solver_portfolio_v20_checker_family_coverage_fingerprint(
        20, 24, 4, 3, 2, 1, 13, manifest_fp) != (0 - 1) { return 13 }
    if solver_portfolio_v20_readiness_fingerprint(
        20, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp + 1) != (0 - 1) { return 14 }

    return 0
}
