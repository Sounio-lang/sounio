//@ run-pass
//@ requires: madaros
//@ description: Tiny PB/Cardinality at-most-two bridge checker

fn pb_bool_valid(x: i64) -> i64 {
    if x == 0 { return 1 }
    if x == 1 { return 1 }
    if x == (0 - 1) { return 1 }
    return 0
}

fn pb_min_term(w: i64, x: i64) -> i64 {
    if x == 1 { return w }
    return 0
}

fn pb_min_sum3(w0: i64, x0: i64, w1: i64, x1: i64, w2: i64, x2: i64) -> i64 {
    return pb_min_term(w0, x0) + pb_min_term(w1, x1) + pb_min_term(w2, x2)
}

fn pb_check_le_contradiction3(w0: i64, x0: i64, w1: i64, x1: i64, w2: i64, x2: i64, rhs: i64) -> i64 {
    if w0 < 0 { return 0 }
    if w1 < 0 { return 0 }
    if w2 < 0 { return 0 }
    if pb_bool_valid(x0) == 0 { return 0 }
    if pb_bool_valid(x1) == 0 { return 0 }
    if pb_bool_valid(x2) == 0 { return 0 }
    if pb_min_sum3(w0, x0, w1, x1, w2, x2) > rhs { return 1 }
    return 0
}

fn pb_check_at_most_two_true_conflict3(x0: i64, x1: i64, x2: i64) -> i64 {
    return pb_check_le_contradiction3(1, x0, 1, x1, 1, x2, 2)
}

fn card_var(slot: i64) -> i64 {
    return slot + 1
}

fn card_valid_slot(n: i64, slot: i64) -> i64 {
    if slot < 0 { return 0 }
    if slot >= n { return 0 }
    return 1
}

fn card_at_most_two_clause_count(n: i64) -> i64 {
    if n < 3 { return 0 }
    return (n * (n - 1) * (n - 2)) / 6
}

fn card_at_most_two_clause_id(n: i64, a: i64, b: i64, c: i64) -> i64 {
    if card_valid_slot(n, a) == 0 { return 0 - 1 }
    if card_valid_slot(n, b) == 0 { return 0 - 1 }
    if card_valid_slot(n, c) == 0 { return 0 - 1 }
    if a == b { return 0 - 1 }
    if a == c { return 0 - 1 }
    if b == c { return 0 - 1 }

    var id: i64 = 1
    var i: i64 = 0
    while i < n {
        var j: i64 = i + 1
        while j < n {
            var k: i64 = j + 1
            while k < n {
                var hit: i64 = 0
                if i == a {
                    if j == b {
                        if k == c { hit = 1 }
                    }
                    if j == c {
                        if k == b { hit = 1 }
                    }
                }
                if i == b {
                    if j == a {
                        if k == c { hit = 1 }
                    }
                    if j == c {
                        if k == a { hit = 1 }
                    }
                }
                if i == c {
                    if j == a {
                        if k == b { hit = 1 }
                    }
                    if j == b {
                        if k == a { hit = 1 }
                    }
                }
                if hit == 1 { return id }
                id = id + 1
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    return 0 - 1
}

fn card_at_most_two_clause_len(n: i64, clause_id: i64) -> i64 {
    if clause_id < 1 { return 0 }
    if clause_id <= card_at_most_two_clause_count(n) { return 3 }
    return 0
}

fn card_at_most_two_lit(n: i64, clause_id: i64, pos: i64) -> i64 {
    if pos < 0 { return 0 }
    if pos >= 3 { return 0 }
    if card_at_most_two_clause_len(n, clause_id) != 3 { return 0 }

    var id: i64 = 1
    var i: i64 = 0
    while i < n {
        var j: i64 = i + 1
        while j < n {
            var k: i64 = j + 1
            while k < n {
                if id == clause_id {
                    if pos == 0 { return 0 - card_var(i) }
                    if pos == 1 { return 0 - card_var(j) }
                    return 0 - card_var(k)
                }
                id = id + 1
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    return 0
}

fn card_lit_matches_one3(clause_lit: i64, lit_a: i64, lit_b: i64, lit_c: i64) -> i64 {
    if clause_lit + lit_a == 0 { return 1 }
    if clause_lit + lit_b == 0 { return 1 }
    if clause_lit + lit_c == 0 { return 1 }
    return 0
}

fn card_verify_at_most_two_conflict(n: i64, clause_id: i64, lit_a: i64, lit_b: i64, lit_c: i64) -> i64 {
    if lit_a <= 0 { return 0 }
    if lit_b <= 0 { return 0 }
    if lit_c <= 0 { return 0 }
    if lit_a == lit_b { return 0 }
    if lit_a == lit_c { return 0 }
    if lit_b == lit_c { return 0 }

    let a = lit_a - 1
    let b = lit_b - 1
    let c = lit_c - 1
    if card_valid_slot(n, a) == 0 { return 0 }
    if card_valid_slot(n, b) == 0 { return 0 }
    if card_valid_slot(n, c) == 0 { return 0 }
    if card_at_most_two_clause_id(n, a, b, c) != clause_id { return 0 }

    let c0 = card_at_most_two_lit(n, clause_id, 0)
    let c1 = card_at_most_two_lit(n, clause_id, 1)
    let c2 = card_at_most_two_lit(n, clause_id, 2)
    if card_lit_matches_one3(c0, lit_a, lit_b, lit_c) == 0 { return 0 }
    if card_lit_matches_one3(c1, lit_a, lit_b, lit_c) == 0 { return 0 }
    if card_lit_matches_one3(c2, lit_a, lit_b, lit_c) == 0 { return 0 }
    return 1
}

fn pb_card_at_most_two_clause_matches3(clause_lit0: i64, clause_lit1: i64, clause_lit2: i64,
                                       lit_a: i64, lit_b: i64, lit_c: i64) -> i64 {
    if lit_a <= 0 { return 0 }
    if lit_b <= 0 { return 0 }
    if lit_c <= 0 { return 0 }
    if lit_a == lit_b { return 0 }
    if lit_a == lit_c { return 0 }
    if lit_b == lit_c { return 0 }
    if clause_lit0 >= 0 { return 0 }
    if clause_lit1 >= 0 { return 0 }
    if clause_lit2 >= 0 { return 0 }
    if clause_lit0 == clause_lit1 { return 0 }
    if clause_lit0 == clause_lit2 { return 0 }
    if clause_lit1 == clause_lit2 { return 0 }
    if card_lit_matches_one3(clause_lit0, lit_a, lit_b, lit_c) == 0 { return 0 }
    if card_lit_matches_one3(clause_lit1, lit_a, lit_b, lit_c) == 0 { return 0 }
    if card_lit_matches_one3(clause_lit2, lit_a, lit_b, lit_c) == 0 { return 0 }
    return 1
}

fn pb_check_card_at_most_two_clause_conflict3(clause_lit0: i64, clause_lit1: i64, clause_lit2: i64,
                                             lit_a: i64, lit_b: i64, lit_c: i64,
                                             x0: i64, x1: i64, x2: i64) -> i64 {
    if pb_card_at_most_two_clause_matches3(clause_lit0, clause_lit1, clause_lit2, lit_a, lit_b, lit_c) == 0 { return 0 }
    return pb_check_at_most_two_true_conflict3(x0, x1, x2)
}

fn bridge_at_most_two_conflict(n: i64, clause_id: i64, lit_a: i64, lit_b: i64, lit_c: i64,
                               x0: i64, x1: i64, x2: i64) -> i64 {
    if card_verify_at_most_two_conflict(n, clause_id, lit_a, lit_b, lit_c) == 0 { return 0 }
    let c0: i64 = card_at_most_two_lit(n, clause_id, 0)
    let c1: i64 = card_at_most_two_lit(n, clause_id, 1)
    let c2: i64 = card_at_most_two_lit(n, clause_id, 2)
    return pb_check_card_at_most_two_clause_conflict3(c0, c1, c2, lit_a, lit_b, lit_c, x0, x1, x2)
}

fn main() -> i64 {
    // In n=4, clause 4 is (-x2 OR -x3 OR -x4). PB view: x2+x3+x4 <= 2.
    if bridge_at_most_two_conflict(4, 4, 2, 3, 4, 1, 1, 1) != 1 { return 1 }
    if bridge_at_most_two_conflict(4, 4, 4, 2, 3, 1, 1, 1) != 1 { return 2 }
    if pb_card_at_most_two_clause_matches3(0 - 2, 0 - 3, 0 - 4, 2, 3, 4) != 1 { return 11 }
    if pb_check_card_at_most_two_clause_conflict3(0 - 2, 0 - 3, 0 - 4, 2, 3, 4, 1, 1, 1) != 1 { return 12 }

    // The cardinality clause alone is not enough: the PB contradiction requires
    // three true assignments, so two true plus unknown is not certified.
    if bridge_at_most_two_conflict(4, 4, 2, 3, 4, 1, 1, 0 - 1) != 0 { return 3 }
    if bridge_at_most_two_conflict(4, 4, 2, 3, 4, 1, 1, 0) != 0 { return 4 }
    if pb_check_card_at_most_two_clause_conflict3(0 - 2, 0 - 3, 0 - 4, 2, 3, 4, 1, 1, 0 - 1) != 0 { return 13 }

    // The PB row alone is not enough either: wrong IDs, repeated lits, signs, or
    // out-of-range variables must fail before the arithmetic certificate is used.
    if bridge_at_most_two_conflict(4, 3, 2, 3, 4, 1, 1, 1) != 0 { return 5 }
    if bridge_at_most_two_conflict(4, 4, 2, 2, 4, 1, 1, 1) != 0 { return 6 }
    if bridge_at_most_two_conflict(4, 4, 2, 3, 0 - 4, 1, 1, 1) != 0 { return 7 }
    if bridge_at_most_two_conflict(4, 4, 2, 3, 5, 1, 1, 1) != 0 { return 8 }
    if bridge_at_most_two_conflict(2, 1, 1, 2, 3, 1, 1, 1) != 0 { return 9 }
    if pb_card_at_most_two_clause_matches3(0 - 2, 0 - 2, 0 - 4, 2, 3, 4) != 0 { return 14 }
    if pb_card_at_most_two_clause_matches3(2, 0 - 3, 0 - 4, 2, 3, 4) != 0 { return 15 }
    if pb_card_at_most_two_clause_matches3(0 - 2, 0 - 3, 0 - 5, 2, 3, 4) != 0 { return 16 }
    if pb_card_at_most_two_clause_matches3(0 - 2, 0 - 3, 0 - 4, 2, 2, 4) != 0 { return 17 }

    // Bad PB assignments are rejected rather than certified.
    if bridge_at_most_two_conflict(4, 4, 2, 3, 4, 1, 2, 1) != 0 { return 10 }

    return 0
}
