//@ run-pass

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 with Panic {
    let permit = Permit { id: 7 }
    let enabled = false
    if enabled {
        let _skip = 0
    } else {
        let _other = 1
    }
    assert(spend(permit) == 7)
    0
}
