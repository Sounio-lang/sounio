// Gate: scripts/ci/madaros_f128_f256_ladder_gate.sh --stage v0b

fn identity_f256(x: f256) -> f256 {
    x
}

fn main() -> i32 {
    let a: f256 = 1.0
    let b: f256 = 2.0
    // Hex float form from the ladder spec (V0-B acceptance includes hex).
    // If the implementer lands decimal before hex, this probe stays red until hex works.
    let c: f256 = 0x1.0p+0
    let d = identity_f256(a)
    let _keep = d
    let _keep_b = b
    let _keep_c = c
    0
}
