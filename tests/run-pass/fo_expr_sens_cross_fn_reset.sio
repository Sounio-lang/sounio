//@ run-pass
// Live FO sensitivities (fo_expr_sens) hold vregs of the function that set
// them. `first` leaves them populated; `add` then reads `a.value + b.value`
// (no variance on either side) and, before the per-function reset, combined
// first's stale vreg into its own IR: `binop dst=10 src=41,41` in a function
// with 38 registers, refused at native emit as malformed_ir_registers.
// Same shape as stdlib science::lib measurement_add after run_tests.
struct M { value: f64, u: f64 }

fn sq_sum(u1: f64, u2: f64) -> f64 with Mut, Div, Panic {
    u1 * u1 + u2 * u2
}

fn first() -> i32 with Mut, Div, Panic {
    var pass = 0
    let s = sq_sum(3.0, 4.0)
    if s > 24.0 { pass = pass + 1 }
    pass
}

fn add(a: &M, b: &M) -> M with Mut, Div, Panic {
    M { value: a.value + b.value, u: 0.0 }
}

fn main() -> i32 with Mut, Div, Panic {
    let x = M { value: 1.0, u: 0.0 }
    let y = M { value: 2.0, u: 0.0 }
    let z = add(&x, &y)
    if first() != 1 { return 1 }
    if z.value != 3.0 { return 2 }
    return 0
}
