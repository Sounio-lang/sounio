//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-2 Taylor-2 radius candidate artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn conversion_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let rx: i256 = 112098647 as i256
    let ry: i256 = 1106813073 as i256
    let rz: i256 = 58841052 as i256
    let x_conv_excess: i256 = rx * target_scale - (26100 as i256) * source_scale
    let y_conv_excess: i256 = ry * target_scale - (257700 as i256) * source_scale
    let z_conv_excess: i256 = rz * target_scale - (13700 as i256) * source_scale
    if x_conv_excess >= (0 as i256) {
        if y_conv_excess >= (0 as i256) {
            if z_conv_excess >= (0 as i256) {
                if x_conv_excess < target_scale {
                    if y_conv_excess < target_scale {
                        if z_conv_excess < target_scale { return 1 }
                    }
                }
            }
        }
    }
    return 0
}

fn derivative_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let x2_abs: i256 = 4406636440 as i256
    let y2_abs: i256 = 6517899153 as i256
    let z2: i256 = 4164877513 as i256
    let rhoz_abs: i256 = (28 as i256) * source_scale - z2
    let rx: i256 = 112098647 as i256
    let ry: i256 = 1106813073 as i256
    let rz: i256 = 58841052 as i256
    let dx_rad: i256 = 12189117200 as i256
    let prod_x_rhoz: i256 = 3091965484 as i256
    let dy_rad: i256 = 4198778557 as i256
    let prod_xy: i256 = 1334595202 as i256
    let beta_rad: i256 = 156909473 as i256
    let dz_rad: i256 = 1491504675 as i256

    var mask: i64 = 0
    if dx_rad == (10 as i256) * (rx + ry) { mask = mask + 2 }

    let xrhoz_total: i256 =
        x2_abs * rz +
        rhoz_abs * rx +
        rx * rz
    if (prod_x_rhoz - (1 as i256)) * source_scale <= xrhoz_total {
        if prod_x_rhoz * source_scale > xrhoz_total { mask = mask + 4 }
    }
    if dy_rad == prod_x_rhoz + ry { mask = mask + 8 }

    let xy_total: i256 =
        x2_abs * ry +
        y2_abs * rx +
        rx * ry
    let beta_total: i256 = (8 as i256) * rz
    if (prod_xy - (1 as i256)) * source_scale <= xy_total {
        if prod_xy * source_scale > xy_total {
            if (beta_rad - (2 as i256)) * (3 as i256) < beta_total {
                if (beta_rad - (1 as i256)) * (3 as i256) >= beta_total {
                    if dz_rad == prod_xy + beta_rad { mask = mask + 16 }
                }
            }
        }
    }
    return mask
}

fn next_radius_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let dt_q: i256 = 42949672 as i256
    let rx: i256 = 112098647 as i256
    let ry: i256 = 1106813073 as i256
    let rz: i256 = 58841052 as i256
    let dx_rad: i256 = 12189117200 as i256
    let dy_rad: i256 = 4198778557 as i256
    let dz_rad: i256 = 1491504675 as i256
    let next_x: i256 = 233989817 as i256
    let next_y: i256 = 1148800858 as i256
    let next_z: i256 = 73756099 as i256
    if (next_x - rx - (1 as i256)) * source_scale <= dt_q * dx_rad {
        if (next_x - rx) * source_scale > dt_q * dx_rad {
            if (next_y - ry - (1 as i256)) * source_scale <= dt_q * dy_rad {
                if (next_y - ry) * source_scale > dt_q * dy_rad {
                    if (next_z - rz - (1 as i256)) * source_scale <= dt_q * dz_rad {
                        if (next_z - rz) * source_scale > dt_q * dz_rad { return 32 }
                    }
                }
            }
        }
    }
    return 0
}

fn cap_mask() -> i64 {
    if (233989817 as i256) <= (500000000 as i256) {
        if (1148800858 as i256) <= (1500000000 as i256) {
            if (73756099 as i256) <= (100000000 as i256) { return 64 }
        }
    }
    return 0
}

fn main() -> i64 {
    let ok_mask = conversion_mask() + derivative_mask() + next_radius_mask() + cap_mask()
    if ok_mask != 127 { return 1 }

    var inst: i64 = 1783
    inst = mix(inst, 2, 5711)
    inst = mix(inst, 4294967296, 5711)
    inst = mix(inst, 1000000, 5711)
    inst = mix(inst, 554654324, 5711)
    inst = mix(inst, 135610689, 5711)
    inst = mix(inst, 482555681, 5711)
    inst = mix(inst, 591288676, 5711)
    inst = mix(inst, 268229078, 5711)
    inst = mix(inst, 223161586, 5711)
    inst = mix(inst, 26100, 5711)
    inst = mix(inst, 257700, 5711)
    inst = mix(inst, 13700, 5711)
    inst = mix(inst, 112098647, 5711)
    inst = mix(inst, 1106813073, 5711)
    inst = mix(inst, 58841052, 5711)
    inst = mix(inst, 0, 5711)
    inst = mix(inst, 0, 5711)
    if inst != 844704318 { return 2 }

    var cert: i64 = 1787
    cert = mix(cert, inst, 5717)
    cert = mix(cert, 12189117200, 5717)
    cert = mix(cert, 3091965484, 5717)
    cert = mix(cert, 4198778557, 5717)
    cert = mix(cert, 1334595202, 5717)
    cert = mix(cert, 156909473, 5717)
    cert = mix(cert, 1491504675, 5717)
    cert = mix(cert, 233989817, 5717)
    cert = mix(cert, 1148800858, 5717)
    cert = mix(cert, 73756099, 5717)
    cert = mix(cert, 500000000, 5717)
    cert = mix(cert, 1500000000, 5717)
    cert = mix(cert, 100000000, 5717)
    cert = mix(cert, ok_mask, 5717)
    cert = mix(cert, 0, 5717)
    cert = mix(cert, 0, 5717)
    if cert != 427274446 { return 3 }

    var art: i64 = 1789
    art = mix(art, inst, 5737)
    art = mix(art, cert, 5737)
    art = mix(art, 554654324, 5737)
    art = mix(art, 135610689, 5737)
    art = mix(art, 2, 5737)
    art = mix(art, 2, 5737)
    art = mix(art, 233989817, 5737)
    art = mix(art, 1148800858, 5737)
    art = mix(art, 73756099, 5737)
    art = mix(art, 500000000, 5737)
    art = mix(art, 1500000000, 5737)
    art = mix(art, 100000000, 5737)
    art = mix(art, ok_mask, 5737)
    art = mix(art, 0, 5737)
    art = mix(art, 0, 5737)
    if art != 443171640 { return 4 }

    var audit: i64 = 1801
    audit = mix(audit, art, 5741)
    audit = mix(audit, inst, 5741)
    audit = mix(audit, cert, 5741)
    audit = mix(audit, 554654324, 5741)
    audit = mix(audit, 135610689, 5741)
    audit = mix(audit, 2, 5741)
    audit = mix(audit, 2, 5741)
    audit = mix(audit, ok_mask, 5741)
    audit = mix(audit, 0, 5741)
    audit = mix(audit, 0, 5741)
    if audit != 790224648 { return 5 }
    return 0
}
