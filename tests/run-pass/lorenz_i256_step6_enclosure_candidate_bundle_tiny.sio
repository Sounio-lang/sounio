//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 enclosure candidate bundle records partial status

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 367
    fp = mix(fp, 6, 3511)
    fp = mix(fp, 506104143, 3511)
    fp = mix(fp, 956295573, 3511)
    fp = mix(fp, 134624236, 3511)
    fp = mix(fp, 643317565, 3511)
    fp = mix(fp, 237534229, 3511)
    fp = mix(fp, 931365823, 3511)
    fp = mix(fp, 516981885, 3511)
    fp = mix(fp, 989033159, 3511)
    fp = mix(fp, 15, 3511)
    fp = mix(fp, 7, 3511)
    fp = mix(fp, 8, 3511)
    fp = mix(fp, 3, 3511)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 425169956 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 373
    fp = mix(fp, instance, 3527)
    fp = mix(fp, 3, 3527)
    fp = mix(fp, 4, 3527)
    fp = mix(fp, 3, 3527)
    fp = mix(fp, 1, 3527)
    fp = mix(fp, 7, 3527)
    fp = mix(fp, 8, 3527)
    fp = mix(fp, 0, 3527)
    fp = mix(fp, ok_mask, 3527)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 425169956 { return 0 - 1 }
    if certificate != 54004840 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 379
    fp = mix(fp, instance, 3541)
    fp = mix(fp, certificate, 3541)
    fp = mix(fp, 4, 3541)
    fp = mix(fp, 6, 3541)
    fp = mix(fp, 7, 3541)
    fp = mix(fp, 8, 3541)
    fp = mix(fp, 3, 3541)
    fp = mix(fp, ok_mask, 3541)
    return fp
}

fn candidate_mask() -> i64 {
    let required_mask: i64 = 15
    let provided_mask: i64 = 7
    let missing_mask: i64 = 8
    let partial_status: i64 = 3
    let validated_mask: i64 = 0

    var ok_mask: i64 = 0
    if 134624236 > 0 {
        if 237534229 > 0 {
            if 516981885 > 0 { ok_mask = ok_mask + 1 }
        }
    }
    if 134624236 != 237534229 {
        if 237534229 != 516981885 { ok_mask = ok_mask + 2 }
    }
    if missing_mask == required_mask - provided_mask { ok_mask = ok_mask + 4 }
    if 3 == 3 {
        if 4 == 4 {
            if 1 == 1 { ok_mask = ok_mask + 8 }
        }
    }
    if partial_status == 3 {
        if missing_mask != 0 { ok_mask = ok_mask + 16 }
    }
    if validated_mask == 0 {
        if provided_mask != required_mask { ok_mask = ok_mask + 32 }
    }
    if missing_mask == 8 {
        if provided_mask + missing_mask == required_mask { ok_mask = ok_mask + 64 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = candidate_mask()
    if ok_mask != 127 { return 1 }
    let inst = instance_fp()
    if inst != 425169956 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 54004840 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 947760031 { return 4 }
    if certificate_fp(inst, 126) != (0 - 1) { return 5 }
    return 0
}
