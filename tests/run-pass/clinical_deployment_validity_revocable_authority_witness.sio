//@ check-only
// Imported API conformance, including private token flow by inference.

use epistemic::proof_carrying_statistical_coverage_empirical_binding::*
use epistemic::proof_carrying_deployment_validity_revocable_authority::*

fn main() with Panic {
    let d9_summary = D9StatisticalCoverageSummaryReceipt {
        summary_id: 21201,
        synthetic_design_count: 455,
        positive_design_count: 165,
        positivity_failure_count: 290,
        adequate_design_count: 25,
        declared_context_binding_count: 1,
        external_evaluation_count: 1,
        empirical_binding_count: 0,
        patient_state_count: 0,
        clinical_action_authority_count: 0,
        compiler_rewrite_count: 0,
        ontology_transport_count: 0,
        exact_only_for_frozen_fixture: true,
    }
    let boundary = observe_d10_d9_boundary(30001, d9_summary)
    assert(boundary.synthetic_design_count == 455)
    assert(boundary.empirical_binding_count == 0)
    assert(boundary.patient_state_count == 0)
    assert(boundary.clinical_action_authority_count == 0)
    assert(boundary.frozen_fixture_only)

    let discrimination = record_d10_discrimination(30101)
    let profile_a = calculate_d10_calibration_profile_a(30102)
    let profile_b = calculate_d10_calibration_profile_b(30103)
    let divergence = compare_d10_calibration_profiles(
        30104, discrimination, profile_a, profile_b,
    )
    assert(discrimination.perfect_rank_discrimination_a)
    assert(discrimination.perfect_rank_discrimination_b)
    assert(!discrimination.calibration_established)
    assert(profile_a.brier_numerator == 1 && profile_a.brier_denominator == 40)
    assert(profile_b.brier_numerator == 29 && profile_b.brier_denominator == 160)
    assert(divergence.exact_gap_numerator == 5)
    assert(divergence.exact_gap_denominator == 32)
    assert(!divergence.discrimination_substitutes_for_calibration)

    let fixed = record_d10_fixed_horizon_coverage(30201)
    let stopped = record_d10_optional_stopping_failure(30202, fixed)
    let time_uniform = certify_d10_finite_time_uniform_fixture(30203)
    let uniform_observation = observe_d10_finite_time_uniform_fixture(
        30204, time_uniform,
    )
    let fixed_e = record_d10_fixed_time_e_value(30205)
    let e_process = certify_d10_frozen_e_process(30206)
    let e_observation = observe_d10_frozen_e_process(30207, e_process)
    assert(fixed.look_one_covered_mass == 12)
    assert(fixed.look_two_covered_mass == 12 && !fixed.time_uniform)
    assert(stopped.stopped_covered_mass == 9)
    assert(!stopped.fixed_horizon_promoted_to_time_uniform)
    assert(uniform_observation.simultaneous_covered_mass == 12)
    assert(uniform_observation.stopped_covered_mass == 12)
    assert(!uniform_observation.general_confidence_sequence)
    assert(!fixed_e.process_history_certified)
    assert(e_observation.stopped_expectation_numerator == 1)
    assert(!e_observation.arbitrary_null_family)

    let coverage = begin_d10_coverage_checked_fixture(30301)
    let provenance = bind_d10_fixture_provenance(coverage)
    let sequential = close_d10_fixture_sequential_validity(
        provenance, time_uniform, e_process,
    )

    let site_a = declare_d10_research_validation_site_a(30401)
    let site_b = declare_d10_research_validation_site_b(30402)
    let manufacturer = declare_d10_manufacturer_safety_case(30403)
    let local = certify_d10_local_site_a_safety(30404)
    let local_observation = observe_d10_local_site_a_safety(30405, local)
    let site_b_failure = record_d10_site_b_safety_failure(30406)
    assert(site_a.site_id != site_b.site_id)
    assert(site_a.workflow_version_id != site_b.workflow_version_id)
    assert(!site_a.external_validation && !site_b.external_validation)
    assert(manufacturer.manufacturer_scope && !manufacturer.local_site_scope)
    assert(local_observation.local_risk_review_complete)
    assert(!local_observation.production_permission)
    assert(!site_b_failure.local_safety_established)

    let abstention = record_d10_model_abstention(30501)
    let pending = record_d10_pending_deferral(30502, abstention)
    let handoff = acknowledge_d10_site_a_handoff(abstention, pending)
    let capacity = record_d10_site_a_deferral_capacity(30507)
    let response = record_d10_site_a_response_plan(30508)
    let safe = certify_d10_site_a_safe_deferral(handoff, capacity, response)
    let safe_observation = observe_d10_site_a_safe_deferral(30503, safe)
    let unsafe = record_d10_site_b_unsafe_deferral(30504, abstention)
    let human = record_d10_human_present(30505)
    let oversight = certify_d10_effective_oversight(human, local)
    let oversight_observation = observe_d10_effective_oversight(30506, oversight)
    assert(!abstention.safe_deferral_established)
    assert(!pending.handoff_complete)
    assert(capacity.capacity_adequate && capacity.capacity_case_count == 2)
    assert(response.response_sla_met)
    assert(response.unresolved_case_policy_present)
    assert(safe_observation.fixture_safe_deferral)
    assert(!safe_observation.clinical_outcome_guaranteed)
    assert(!unsafe.safe_deferral_established && unsafe.reason_mask == 3)
    assert(!human.effective_oversight_established)
    assert(oversight_observation.independent_review_possible)
    assert(!oversight_observation.clinical_judgment_replaced)

    let plan = declare_d10_pccp_plan(30601)
    let impact = record_d10_impact_assessment(30671)
    let conformance = record_d10_change_conformance(30602, plan, impact)
    let modification = authorize_d10_fixture_modification(
        plan, impact, conformance,
    )
    let authorized = observe_d10_authorized_fixture_modification(
        30603, modification,
    )
    let unauthorized = record_d10_unauthorized_change(30604)
    let quarantine = quarantine_d10_unauthorized_change(30605, unauthorized)
    assert(!plan.plan_is_authorized_change)
    assert(plan.impact_assessment_id == impact.receipt_id)
    assert(conformance.all_obligations_met)
    assert(authorized.same_frozen_discrimination)
    assert(authorized.obligation_combination_count == 16)
    assert(authorized.authorized_combination_count == 1)
    assert(!authorized.production_authority_issued)
    assert(unauthorized.same_frozen_discrimination)
    assert(!unauthorized.within_declared_change_scope)
    assert(!quarantine.advisory_ready && quarantine.reason_mask == 8)

    let input_shift = record_d10_input_shift(30701)
    let performance_drift = record_d10_performance_drift(30702)
    let calibration_drift = record_d10_calibration_drift(30703, divergence)
    let no_detected = record_d10_no_detected_shift(30704)
    assert(input_shift.input_shift_detected)
    assert(!input_shift.performance_drift_established)
    assert(performance_drift.performance_drift_detected)
    assert(!performance_drift.input_shift_established)
    assert(calibration_drift.unchanged_rank_discrimination)
    assert(calibration_drift.changed_brier_profile)
    assert(!calibration_drift.automatic_retraining_authorized)
    assert(!no_detected.shift_detected && !no_detected.absence_of_shift_proven)

    let advisory = prepare_d10_fixture_advisory(
        sequential, local, safe, oversight, modification,
    )
    let advisory_observation = observe_d10_fixture_advisory(30801, advisory)
    let unspent = open_d10_unspent_fixture_warrant(advisory)
    let spent = spend_d10_fixture_warrant(unspent)
    let spend_observation = observe_d10_spend_transition(30802, spent)
    let reuse = refuse_d10_repeat_spend(30803, spent)
    let overspend = refuse_d10_overspend(30804, spent)
    let lease = issue_d10_fixture_canary_lease(spent)
    let lease_observation = observe_d10_fixture_canary_lease(30805, lease)
    let facet = open_d10_epoch_one_facet()
    let live = observe_d10_live_lease_at_epoch_one(30806, lease, facet)
    let revoked = revoke_d10_canary_at_epoch_two(30807, lease, facet)
    assert(advisory_observation.fixture_advisory_ready)
    assert(!advisory_observation.production_deployment_ready)
    assert(spend_observation.budget_after == 0)
    assert(spend_observation.first_spend_nonce == 30811)
    assert(spend_observation.second_spend_nonce == 30812)
    assert(spend_observation.exact_local_transition_trace)
    assert(!spend_observation.affine_consumption_proven)
    assert(!reuse.repeat_spend_accepted)
    assert(!reuse.static_alias_elimination_proven)
    assert(!overspend.overspend_accepted)
    assert(lease_observation.canary_only)
    assert(lease_observation.spend_nonce == 30812)
    assert(lease_observation.ledger_epoch == 1)
    assert(!lease_observation.production_authority)
    assert(live.lease_live_in_frozen_observation)
    assert(!live.live_reference_monitor_proven)
    assert(!revoked.lease_live)
    assert(!revoked.copied_stale_facet_invalidated)

    let summary = summarize_d10_deployment_validity(
        30901, advisory_observation, lease_observation, quarantine, revoked,
    )
    assert(summary.exact_contest_count == 8)
    assert(summary.private_typestate_stage_count == 15)
    assert(summary.fixture_canary_lease_count == 1)
    assert(summary.quarantine_count == 1)
    assert(summary.external_validation_count == 0)
    assert(summary.production_authority_count == 0)
    assert(summary.patient_state_count == 0)
    assert(summary.clinical_action_authority_count == 0)
    assert(summary.compiler_rewrite_count == 0)
    assert(summary.exact_only_for_frozen_fixtures)
}
