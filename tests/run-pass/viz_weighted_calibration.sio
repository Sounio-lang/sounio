//@ run-pass
//@ expect-stdout: VIZ_WEIGHTED_CALIBRATION_PASS
//@ expect-stdout: scatter n=8
//@ expect-stdout: Relative objective weights; variance model unassessed
//@ expect-stdout: No standard errors, p-values or confidence intervals
use stats::regression::multiple::{multiple_linear_fit,weighted_multiple_linear_fit}
use viz::axis::{axis_label}
use viz::ir::{viz_scene_new,viz_add_scatter_chart,viz_add_line_chart,
 viz_line_set_viewport,viz_add_axis,viz_node_set_label,viz_add_label,
 viz_add_series_legend,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var a:[f64;2048]=[0.0;2048]
 var b:[f64;256]=[0.0;256]
 var w:[f64;256]=[0.0;256]
 var response:[f64;8]=[1.2,2.7,5.4,6.6,9.6,10.4,13.5,14.5]
 var i:i64=0
 while i<8 {
  a[(8*i) as usize]=1.0
  a[(8*i+1) as usize]=i as f64
  b[i as usize]=response[i as usize]
  w[i as usize]=if i%2==0 {1.0} else {4.0}
  i=i+1
 }
 let ordinary=multiple_linear_fit(&a,&b,8,2,1e-12)
 let weighted=weighted_multiple_linear_fit(&a,&b,&w,8,2,1e-12)
 assert(ordinary.status==0 && weighted.status==0)
 assert(ordinary.rank==2 && weighted.rank==2 && ordinary.df==6 && weighted.df==6)
 assert(!weighted.variance_model_assessed && weighted.weight_scale==4.0)
 var xs:[f64;1024]=[0.0;1024]
 var observed:[f64;1024]=[0.0;1024]
 var ols_fitted:[f64;1024]=[0.0;1024]
 var wls_fitted:[f64;1024]=[0.0;1024]
 var order:[f64;1024]=[0.0;1024]
 var ols_residual:[f64;1024]=[0.0;1024]
 var wls_residual:[f64;1024]=[0.0;1024]
 var ols_objective=0.0
 var wls_objective=0.0
 i=0
 while i<8 {
  xs[i as usize]=i as f64
  observed[i as usize]=b[i as usize]
  ols_fitted[i as usize]=ordinary.fitted[i as usize]
  wls_fitted[i as usize]=weighted.fitted[i as usize]
  order[i as usize]=(i+1) as f64
  ols_residual[i as usize]=ordinary.residuals[i as usize]
  wls_residual[i as usize]=weighted.residuals[i as usize]
  let error=b[i as usize]-weighted.fitted[i as usize]-weighted.residuals[i as usize]
  assert(error> -1e-12 && error<1e-12)
  assert(ordinary.fitted[i as usize]>=0.0 && ordinary.fitted[i as usize]<=18.0)
  assert(weighted.fitted[i as usize]>=0.0 && weighted.fitted[i as usize]<=18.0)
  assert(ordinary.residuals[i as usize]> -2.0 && ordinary.residuals[i as usize]<2.0)
  assert(weighted.residuals[i as usize]> -2.0 && weighted.residuals[i as usize]<2.0)
  let weight=w[i as usize]/weighted.weight_scale
  ols_objective=ols_objective+weight*ordinary.residuals[i as usize]*ordinary.residuals[i as usize]
  wls_objective=wls_objective+weight*weighted.residuals[i as usize]*weighted.residuals[i as usize]
  i=i+1
 }
 assert(wls_objective>0.0 && wls_objective<ols_objective)
 let norm_error=weighted.normalized_weighted_residual_norm*weighted.normalized_weighted_residual_norm-wls_objective
 assert(norm_error> -1e-10 && norm_error<1e-10)
 var scene=viz_scene_new()
 let points=viz_add_scatter_chart(&!scene,&xs,&observed,8,viz_layout_rect(140,150,480,240),viz_style_rgb(70,180,235))
 assert(points==0)
 scene.series[0].x_min=0.0;scene.series[0].x_max=8.0
 scene.series[0].y_min=0.0;scene.series[0].y_max=18.0
 let ols=viz_add_line_chart(&!scene,&xs,&ols_fitted,8,viz_layout_rect(140,150,480,240),viz_style_rgb(220,135,225))
 let wls=viz_add_line_chart(&!scene,&xs,&wls_fitted,8,viz_layout_rect(140,150,480,240),viz_style_rgb(245,170,65))
 assert(viz_line_set_viewport(&!scene,ols,0.0,8.0,0.0,18.0))
 assert(viz_line_set_viewport(&!scene,wls,0.0,8.0,0.0,18.0))
 let ordinary_errors=viz_add_scatter_chart(&!scene,&order,&ols_residual,8,viz_layout_rect(800,150,480,240),viz_style_rgb(220,135,225))
 let weighted_errors=viz_add_scatter_chart(&!scene,&order,&wls_residual,8,viz_layout_rect(800,150,480,240),viz_style_rgb(245,170,65))
 let ordinary_slot:i64=scene.nodes[ordinary_errors as usize].data_slot
 let weighted_slot:i64=scene.nodes[weighted_errors as usize].data_slot
 scene.series[ordinary_slot as usize].x_min=0.0;scene.series[ordinary_slot as usize].x_max=8.0
 scene.series[ordinary_slot as usize].y_min= -2.0;scene.series[ordinary_slot as usize].y_max=2.0
 scene.series[weighted_slot as usize].x_min=0.0;scene.series[weighted_slot as usize].x_max=8.0
 scene.series[weighted_slot as usize].y_min= -2.0;scene.series[weighted_slot as usize].y_max=2.0
 var zx:[f64;1024]=[0.0;1024]
 var zy:[f64;1024]=[0.0;1024]
 zx[1]=8.0
 let zero=viz_add_line_chart(&!scene,&zx,&zy,2,viz_layout_rect(800,150,480,240),viz_style_rgb(180,185,195))
 assert(viz_line_set_viewport(&!scene,zero,0.0,8.0,-2.0,2.0))
 let xa=viz_add_axis(&!scene,0.0,8.0,4,false,viz_layout_rect(140,408,480,1),viz_style_rgb(190,200,215))
 let ya=viz_add_axis(&!scene,0.0,18.0,3,true,viz_layout_rect(120,150,1,240),viz_style_rgb(190,200,215))
 let xb=viz_add_axis(&!scene,0.0,8.0,4,false,viz_layout_rect(800,408,480,1),viz_style_rgb(190,200,215))
 let yb=viz_add_axis(&!scene,-2.0,2.0,4,true,viz_layout_rect(780,150,1,240),viz_style_rgb(190,200,215))
