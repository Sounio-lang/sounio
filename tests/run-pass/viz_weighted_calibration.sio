 viz_node_set_label(&!scene,yb,&rn,13)
 assert(viz_add_label(&!scene,&title,38,viz_layout_rect(140,20,1140,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&subtitle,53,viz_layout_rect(140,52,1140,20),viz_style_rgb(190,200,215))>=0)
