//@ run-pass
//@ requires:madaros
// Wave12: pure multi-stmt return chain in global element-list init folds.
// Pre-wave12 residual: `[multi(), 20, 30]` with `let x = 10; x` was fail-closed
// BSS zero. Must never left-shift remaining const words (`20 30 0`).

fn multi() -> i64 {
    let x = 10
    x
}

fn chain() -> i64 {
    let x = 10
    let y = x + 5
    y
}

var A: [i64; 3] = [multi(), 20, 30]
var B: [i64; 3] = [chain(), 1, 2]

fn main() -> i64 with IO {
    print_int(A[0])
    print(" ")
    print_int(A[1])
    print(" ")
    print_int(A[2])
    print("\n")
    print_int(B[0])
    print(" ")
    print_int(B[1])
    print(" ")
    print_int(B[2])
    print("\n")
    if A[0] != 10 { return 1 }
    if A[1] != 20 { return 2 }
    if A[2] != 30 { return 3 }
    if B[0] != 15 { return 4 }
    if B[1] != 1 { return 5 }
    if B[2] != 2 { return 6 }
    0
}
