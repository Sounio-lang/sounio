//@ run-pass
//@ expect-stdout-contains: cow_isolation: PASS
// Stress: fork COW isolation — child writes to stack variable must not reach parent

fn main() with IO, Async {
    var x = 42

    // Child writes to its COW copy of x, returns 999
    let h = spawn {
        x = 999
        x
    }

    // Child's return value is 999 (its own COW copy)
    let child_saw = h.await

    // Parent's x must still be 42 (COW isolation)
    if x == 42 && child_saw == 999 {
        print("cow_isolation: PASS\n")
    } else {
        print("cow_isolation: FAIL\n")
    }
}
