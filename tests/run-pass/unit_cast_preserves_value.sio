//@ run-pass
//@ expect-stdout: unit cast value: PASS
// Entering the unit world from a raw number, which is what an empirical
// correlation needs at its boundary. The existing cast tests (unit_cast_compatible,
// unit_cast_time) print nothing at all, so they would pass with the identity, a
// wrong factor, or garbage. This one checks the number.

unit molal = mol / kg;

fn takes_molal(y: molal) -> f64 with Mut {
    y
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let raw = 7.25
    let branded = takes_molal(raw as molal)
    // Builtin brands and an integer source. Same number, no scale factor:
    // `7.25 as kg` used to become the integer 7 and print as 0.000000.
    let k = (raw as kg) as f64
    let dose: mg = 500.0
    let same = (dose as mg) as f64
    let from_raw = (500.0 as mg) as f64
    let n = (7 as kg) as f64
    if branded == 7.25 && k == 7.25 && same == 500.0 && from_raw == 500.0 && n == 7.0 {
        print("unit cast value: PASS\n")
    }
    return 0
}
