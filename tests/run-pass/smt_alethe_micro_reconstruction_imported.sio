//@ run-pass
//@ description: Imported theorem::smt Alethe-style assumption-core reconstruction smoke

use theorem::smt::*

fn add_base_or(ctx: &!SmtContext) with Mut, Div {
    var clause: [i32; 8] = [0 as i32; 8]
    clause[0] = 0 as i32
    clause[1] = 2 as i32
    smt_add_clause(ctx, &clause, 2 as i32)
}

fn main() -> i64 with Mut, Div, Mod {
    var ctx = smt_new()
    add_base_or(&! ctx)

    var assumptions: [i32; 8] = [0 as i32; 8]
    assumptions[0] = 1 as i32
    assumptions[1] = 3 as i32

    var core: [i32; 8] = [0 as i32; 8]
    core[0] = 0 as i32
    core[1] = 1 as i32

    let reconstruction_fp = smt_alethe_assumption_core_reconstruction_fingerprint(
        &! ctx, &assumptions, 2 as i32, &core, 2 as i32,
        796206516, 106325289, 666359709, 1, 1, 4, 1, 0, 63)
    if reconstruction_fp != 580810113 { return 1 }

    let audit_fp = smt_alethe_assumption_core_reconstruction_audit_fingerprint(
        reconstruction_fp, 796206516, 106325289, 666359709, 770769284, 63)
    if audit_fp != 72583387 { return 2 }
    return 0
}
