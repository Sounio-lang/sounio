//@ run-pass
//@ expect-stdout: linear ok

// A linear struct consumed exactly once is fine
linear struct Handle {
    fd: i64,
}

fn consume(h: Handle) -> i64 {
    h.fd
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var h = Handle { fd: 42 }
    let fd = consume(h)
    if fd == 42 {
        print("linear ok\n")
    }
    return 0
}
