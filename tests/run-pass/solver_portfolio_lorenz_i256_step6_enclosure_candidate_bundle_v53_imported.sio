//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v53 smoke for Lorenz i256 step-6 enclosure candidate bundle entry

use theorem::portfolio::*

fn main() -> i64 {
    let receipt_fp = solver_portfolio_v53_lorenz_i256_step6_enclosure_candidate_bundle_fingerprint(
        947760031, 982064907, 992904441, 924526189, 28339575, 6, 4, 127)
    if receipt_fp != 292824876 { return 1 }

    let audit_fp = solver_portfolio_v53_lorenz_i256_step6_enclosure_candidate_bundle_audit_fingerprint(
        receipt_fp, 947760031, 982064907, 676017160, 588554192, 28339575, 6, 4, 127)
    if audit_fp != 892715220 { return 2 }

    let manifest_fp = solver_portfolio_v53_lorenz_i256_step6_enclosure_candidate_bundle_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 145449 { return 3 }

    let result_fp = solver_portfolio_v53_result_coverage_fingerprint(
        53, 57, 10, 45, 1, 1, manifest_fp)
    if result_fp != 879678206 { return 4 }

    let family_fp = solver_portfolio_v53_checker_family_coverage_fingerprint(
        53, 57, 6, 4, 3, 2, 40, 2, manifest_fp)
    if family_fp != 706966538 { return 5 }

    let acceptance_fp = solver_portfolio_v53_acceptance_receipt_fingerprint(
        53, manifest_fp, result_fp)
    if acceptance_fp != 614374913 { return 6 }

    let audit_receipt_fp = solver_portfolio_v53_audit_receipt_fingerprint(
        53, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 235387639 { return 7 }

    let readiness_fp = solver_portfolio_v53_readiness_fingerprint(
        53, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 878999745 { return 8 }
    return 0
}
