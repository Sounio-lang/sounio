//@ run-pass

fn main() -> i32 with IO, Epistemic {
    let a = measure(2.0, uncertainty: 0.1)
    let b = measure(3.0, uncertainty: 0.1)
    let c = measure(5.0, uncertainty: 0.1)

    // y = a * b * c  (left-associative: (a*b)*c)
    let y = a.value * b.value * c.value

    // ∂y/∂a = b*c = 15.0
    let sa = sensitivity_of(y, 0)
    // ∂y/∂b = a*c = 10.0
    let sb = sensitivity_of(y, 1)
    // ∂y/∂c = a*b = 6.0
    let sc = sensitivity_of(y, 2)

    assert(sa > 14.99 && sa < 15.01)
    assert(sb > 9.99 && sb < 10.01)
    assert(sc > 5.99 && sc < 6.01)
    0
}
