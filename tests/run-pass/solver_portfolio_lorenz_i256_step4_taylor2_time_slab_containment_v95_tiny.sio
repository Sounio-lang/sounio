//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v95 smoke for Lorenz i256 step-4 Taylor-2 time-slab containment

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1487
    receipt_fp = mix(receipt_fp, 110014281, 5333)
    receipt_fp = mix(receipt_fp, 651883944, 5333)
    receipt_fp = mix(receipt_fp, 759673798, 5333)
    receipt_fp = mix(receipt_fp, 212279500, 5333)
    receipt_fp = mix(receipt_fp, 785400259, 5333)
    receipt_fp = mix(receipt_fp, 600773460, 5333)
    receipt_fp = mix(receipt_fp, 811695381, 5333)
    receipt_fp = mix(receipt_fp, 4, 5333)
    receipt_fp = mix(receipt_fp, 14, 5333)
    receipt_fp = mix(receipt_fp, 255, 5333)
    if receipt_fp != 262483726 { return 1 }

    var audit_fp: i64 = 1489
    audit_fp = mix(audit_fp, receipt_fp, 5347)
    audit_fp = mix(audit_fp, 110014281, 5347)
    audit_fp = mix(audit_fp, 651883944, 5347)
    audit_fp = mix(audit_fp, 367295300, 5347)
    audit_fp = mix(audit_fp, 113336557, 5347)
    audit_fp = mix(audit_fp, 414744732, 5347)
    audit_fp = mix(audit_fp, 65508192, 5347)
    audit_fp = mix(audit_fp, 785400259, 5347)
    audit_fp = mix(audit_fp, 4, 5347)
    audit_fp = mix(audit_fp, 14, 5347)
    audit_fp = mix(audit_fp, 255, 5347)
    if audit_fp != 260510831 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 98, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 98, 1103)
    if entry_fp != 478988651 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 95, 1151)
    manifest_fp = mix(manifest_fp, 99, 1151)
    manifest_fp = mix(manifest_fp, 212279500, 1151)
    manifest_fp = mix(manifest_fp, 759673798, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 138855577 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 95, 1871)
    result_fp = mix(result_fp, 99, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 87, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 465182141 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 95, 1907)
    family_fp = mix(family_fp, 99, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 82, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 892411550 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 95, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 750840648 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 95, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 12175216 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 95, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 506674456 { return 9 }
    return 0
}
