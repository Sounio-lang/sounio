//@ run-pass
//@ requires: madaros
//@ description: Lorenz i256 rounded projection interval contained in ball-fixed enclosure

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn interval_fingerprint(generic_interval_fp: i64,
                        directed_rounding_fp: i64,
                        projection_inclusion_fp: i64,
                        projection_margin_budget_fp: i64) -> i64 {
    if generic_interval_fp != 192258040 { return 0 - 1 }
    if directed_rounding_fp != 80894555 { return 0 - 1 }
    if projection_inclusion_fp != 890086395 { return 0 - 1 }
    if projection_margin_budget_fp != 69322697 { return 0 - 1 }

    var fp: i64 = 373
    fp = mix(fp, 214180161, 2659)
    fp = mix(fp, 4294967296, 2659)
    fp = mix(fp, 1000000, 2659)
    fp = mix(fp, 5309941770, 2659)
    fp = mix(fp, 10058731223, 2659)
    fp = mix(fp, 4084837935, 2659)
    fp = mix(fp, 1236317, 2659)
    fp = mix(fp, 1236318, 2659)
    fp = mix(fp, 992950, 2659)
    fp = mix(fp, 1479682, 2659)
    fp = mix(fp, 2341980, 2659)
    fp = mix(fp, 2341981, 2659)
    fp = mix(fp, 2022339, 2659)
    fp = mix(fp, 2661619, 2659)
    fp = mix(fp, 951075, 2659)
    fp = mix(fp, 951076, 2659)
    fp = mix(fp, 908630, 2659)
    fp = mix(fp, 993526, 2659)
    fp = mix(fp, generic_interval_fp, 2659)
    fp = mix(fp, directed_rounding_fp, 2659)
    fp = mix(fp, projection_inclusion_fp, 2659)
    fp = mix(fp, projection_margin_budget_fp, 2659)
    return fp
}

fn audit_fingerprint(interval_fp: i64) -> i64 {
    if interval_fp != 310218620 { return 0 - 1 }
    var fp: i64 = 379
    fp = mix(fp, interval_fp, 2671)
    fp = mix(fp, 192258040, 2671)
    fp = mix(fp, 80894555, 2671)
    fp = mix(fp, 890086395, 2671)
    fp = mix(fp, 69322697, 2671)
    fp = mix(fp, 31, 2671)
    return fp
}

fn main() -> i64 {
    let fp = interval_fingerprint(192258040, 80894555, 890086395, 69322697)
    if fp != 310218620 { return 1 }
    let audit_fp = audit_fingerprint(fp)
    if audit_fp != 501185861 { return 2 }
    if interval_fingerprint(192258041, 80894555, 890086395, 69322697) != (0 - 1) { return 3 }
    return 0
}
