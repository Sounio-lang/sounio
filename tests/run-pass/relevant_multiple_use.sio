//@ run-pass
//@ description: Relevant value can be used multiple times

relevant struct Counter {
    count: i32,
}

fn read_count(c: Counter) -> i32 {
    c.count
}

fn main() {
    let ctr = Counter { count: 5 }
    let a = read_count(ctr)
    let b = read_count(ctr)  // OK: relevant allows multiple uses
    let c = read_count(ctr)
}
