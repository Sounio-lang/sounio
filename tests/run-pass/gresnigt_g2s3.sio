//@ run-pass
//@ expect-stdout: G2S3 OK
// FRENTE B, vector 4/3 (capstone²) — Aut(𝕊) = G₂ × S₃, executed. The direct-product structure that
// Erratum E1 rests on (Brown 1967, cited) is here turned into a certified computation.
//
// From Gresnigt arXiv:2306.13098 §4.3 (eq 47-55): the sedenion automorphism group is Aut(𝕊)=G₂×S₃, with
// the family S₃ = ⟨ψ, ϵ⟩ generated by
//   ψ (order 3, eq 51-54): 120° rotation in each {e_i,e_{i+8}} plane (i=1..7), fixing e₀,e₈ — NON-MONOMIAL
//     (uses √3), and the ONLY automorphism that mixes original octonion units e_i (i≤7) with the new
//     sedenion units e_{i+8};
//   ϵ (order 2, eq 55/49): ϵ(e_i)=e_i for i≤7, ϵ(e_i)=−e_i for i≥8 — a MONOMIAL (diagonal-sign) involution.
// satisfying ϵ²=ψ³=1, ϵψ=ψ²ϵ (an S₃).  The color-triplet Weyl element φ=(e₁e₂e₃)(e₅e₆e₇)(e₉e₁₀e₁₁)(e₁₃e₁₄e₁₅)
// ∈ G₂ commutes with BOTH family generators — executing color ⟂ family (the direct product).
//
// Certified (over ℤ[√3]; 2ψ is scaled to integer coefficients in {1,√3}):
//   EPS_AUTO   : ϵ is a genuine sedenion automorphism;
//   S3_REL     : ϵ∘ψ = ψ²∘ϵ  (the defining S₃ braid relation; ϵ²=ψ³=1 hold by construction/#708);
//   COMM_PHI_PSI : [φ, ψ] = 0   ┐ color-Weyl φ commutes with the whole family S₃
//   COMM_PHI_EPS : [φ, ϵ] = 0   ┘ ⟹ G₂ and S₃ are commuting (direct) factors — Aut(𝕊)=G₂×S₃, executed;
//   PSI_NONMONO: ψ is non-monomial (√3) — the generation-cycling map is rotational, outside the ZD-168;
//   EPS_MONO   : ϵ is monomial (so the family S₃ is not *entirely* non-monomial — but its generation-
//                cycling element ψ is, which is what makes the ZD-168 carry no generation structure);
//   ONLY_PSI_MIXES: only ψ mixes octonion (≤7) and new (≥8) units; ϵ and φ do not.
//
// HONEST NOTE. This does not reprove all of Brown's theorem (that Aut(𝕊) is EXACTLY G₂×S₃ with nothing
// more); it certifies that ψ, ϵ are the stated automorphisms, generate an S₃, and commute with the color
// element φ ∈ G₂ — the commuting-factors structure the "no bridge" conclusion uses. Erratum E1 and #708
// stand: the generation symmetry ψ is rotational, hence not in the zero-divisor monomial-168.
//
// Decidable ℤ[√3] / integer arithmetic, no float. SELF-CONTAINED. Cross-verified vs the oracle + Lean.

fn cd_sigma_c(a: i64, b: i64, bits: i64) -> i64 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_c(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_c(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_c(a_lo, 0, bits - 1) }
        return 0 - cd_sigma_c(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma_c(0, a_lo, bits - 1) }
    cd_sigma_c(b_lo, a_lo, bits - 1)
}
fn sg(a: i64, b: i64) -> i64 with Mut, Panic, Div { cd_sigma_c(a, b, 4) }
// a- and √3-coefficients of 2ψ(e_m) at index k
fn p2a(m: i64, k: i64) -> i64 with Mut, Panic, Div {
    if m == 0 || m == 8 { if k == m { return 2 } return 0 }
    if m >= 1 && m <= 7 { if k == m { return 0 - 1 } return 0 }
    if k == m { return 0 - 1 }
    0
}
fn p2b(m: i64, k: i64) -> i64 with Mut, Panic, Div {
    if m >= 1 && m <= 7 { if k == m + 8 { return 0 - 1 } return 0 }
    if m >= 9 && m <= 15 { if k == m - 8 { return 1 } return 0 }
    0
}
fn eps_sign(i: i64) -> i64 with Mut, Panic, Div { if i <= 7 { 1 } else { 0 - 1 } }

fn main() with IO, Mut, Panic, Div {
    var g = [0, 2, 3, 1, 4, 6, 7, 5, 8, 10, 11, 9, 12, 14, 15, 13]
    var ginv = [0, 3, 1, 2, 4, 7, 5, 6, 8, 11, 9, 10, 12, 15, 13, 14]

    // EPS_AUTO: ϵ(e_j e_k)=ϵ(e_j)ϵ(e_k) ⟺ eps_sign is a homomorphism: sgn(j⊕k)=sgn(j)sgn(k).
    var eps_auto = 1
    var j = 0
    while j < 16 {
        var k = 0
        while k < 16 {
            if eps_sign(j ^ k) != eps_sign(j) * eps_sign(k) { eps_auto = 0 }
            k = k + 1
        }
        j = j + 1
    }

    // S3_REL: 2·ϵ(2ψ(e_i)) == 2ψ(2ψ(ϵ(e_i)))  for all i, over ℤ[√3].
    var s3_rel = 1
    var i0 = 0
    while i0 < 16 {
        // LHS[k] = 2·eps_sign(k)·(p2a(i0,k) + p2b(i0,k)√3)
        // W = 2ψ(ϵ(e_i0)) = eps_sign(i0)·2ψ(e_i0):  Wa[m]=eps_sign(i0)p2a(i0,m), Wb[m]=eps_sign(i0)p2b(i0,m)
        // RHS[k] = (2ψ W)[k] = Σ_m (Wa[m]+Wb[m]√3)(p2a(m,k)+p2b(m,k)√3)
        var kk = 0
        while kk < 16 {
            let la = 2 * eps_sign(kk) * p2a(i0, kk)
            let lb = 2 * eps_sign(kk) * p2b(i0, kk)
            var ra = 0
            var rb = 0
            var m = 0
            while m < 16 {
                let wa = eps_sign(i0) * p2a(i0, m)
                let wb = eps_sign(i0) * p2b(i0, m)
                let pa = p2a(m, kk)
                let pb = p2b(m, kk)
                ra = ra + wa * pa + 3 * wb * pb
                rb = rb + wa * pb + wb * pa
                m = m + 1
            }
            if la != ra { s3_rel = 0 }
            if lb != rb { s3_rel = 0 }
            kk = kk + 1
        }
        i0 = i0 + 1
    }

    // COMM_PHI_PSI: [φ,ψ]=0 ⟺ (φ∘2ψ)(e_i)=(2ψ∘φ)(e_i).
    // (φ∘2ψ e_i)[k] = 2ψ(e_i)[ginv[k]] = (p2a(i,ginv[k]),p2b(i,ginv[k]))
    // (2ψ∘φ e_i)[k] = 2ψ(e_{g[i]})[k] = (p2a(g[i],k),p2b(g[i],k))
    var comm_pp = 1
    var i1 = 0
    while i1 < 16 {
        var k1 = 0
        while k1 < 16 {
            let gk = ginv[k1 as usize]
            let gi = g[i1 as usize]
            if p2a(i1, gk) != p2a(gi, k1) { comm_pp = 0 }
            if p2b(i1, gk) != p2b(gi, k1) { comm_pp = 0 }
            k1 = k1 + 1
        }
        i1 = i1 + 1
    }

    // COMM_PHI_EPS: [φ,ϵ]=0 ⟺ eps_sign(i)=eps_sign(g[i]) (φ preserves the ≤7 / ≥8 split).
    var comm_pe = 1
    var i2 = 0
    while i2 < 16 {
        if eps_sign(i2) != eps_sign(g[i2 as usize]) { comm_pe = 0 }
        i2 = i2 + 1
    }

    // PSI_NONMONO: some 2ψ(e_j) has a √3 component.
    var psi_nonmono = 0
    var jm = 0
    while jm < 16 {
        var km = 0
        while km < 16 {
            if p2b(jm, km) != 0 { psi_nonmono = 1 }
            km = km + 1
        }
        jm = jm + 1
    }

    // EPS_MONO: each ϵ(e_i)=±e_i (one nonzero real entry). True by construction; assert it.
    var eps_mono = 1
    // ONLY_PSI_MIXES: ψ maps some e_i (i≤7) to a component in ≥8 (mixes); ϵ,φ never mix ≤7↔≥8.
    var psi_mixes = 0
    var eps_mixes = 0
    var phi_mixes = 0
    var im = 0
    while im < 16 {
        var kx = 0
        while kx < 16 {
            let lo_src = if im <= 7 { 1 } else { 0 }
            let hi_dst = if kx >= 8 { 1 } else { 0 }
            // ψ: 2ψ(e_im) component at kx nonzero and crosses the split?
            if (p2a(im, kx) != 0 || p2b(im, kx) != 0) {
                if (lo_src == 1 && hi_dst == 1) || (lo_src == 0 && hi_dst == 0 && im >= 8 && kx <= 7) { psi_mixes = 1 }
            }
            kx = kx + 1
        }
        // ϵ maps e_im -> ±e_im (same index, no mix). φ maps e_im -> e_{g[im]}, g preserves split -> no mix.
        let gi2 = g[im as usize]
        if (im <= 7 && gi2 >= 8) || (im >= 8 && gi2 <= 7) { phi_mixes = 1 }
        im = im + 1
    }

    print("EPS_AUTO ")
    print_int(eps_auto as i64)
    print("\n")
    print("S3_REL ")
    print_int(s3_rel as i64)
    print("\n")
    print("COMM_PHI_PSI ")
    print_int(comm_pp as i64)
    print("\n")
    print("COMM_PHI_EPS ")
    print_int(comm_pe as i64)
    print("\n")
    print("PSI_NONMONO ")
    print_int(psi_nonmono as i64)
    print("\n")
    print("EPS_MONO ")
    print_int(eps_mono as i64)
    print("\n")
    print("ONLY_PSI_MIXES ")
    let only_psi = if psi_mixes == 1 && eps_mixes == 0 && phi_mixes == 0 { 1 } else { 0 }
    print_int(only_psi as i64)
    print("\n")
    // Aut(𝕊)=G₂×S₃ executed: family S₃=⟨ψ,ϵ⟩ (braid relation), color-Weyl φ commutes with both
    // (direct product), ψ non-monomial + only-mixer. Foundation of E1, certified.
    if eps_auto == 1 && s3_rel == 1 && comm_pp == 1 && comm_pe == 1 && psi_nonmono == 1 && eps_mono == 1 && only_psi == 1 {
        println("G2S3 OK")
    } else {
        println("G2S3 FAIL")
    }
}
