//@ run-pass
// Probe: multi-field struct return + print_f64(conf) — catches bit-pattern print
// when the engine corrupts f64 field loads the same way as EpResult28.
struct ConfBox {
    conf: f64,
    pad: f64,
}

fn make_conf() -> ConfBox {
    // lean value that Madaros has printed as 4604219396932172800 on ep28
    ConfBox { conf: 0.671038, pad: 1.0 }
}

fn main() -> i64 with IO {
    let b = make_conf()
    print("PROBE_CONF ")
    print_f64(b.conf)
    println("")
    let c = b.conf
    if c > 0.20 && c < 0.90 {
        println("PROBE_RANGE_OK")
        return 0
    }
    println("PROBE_RANGE_BAD")
    if c > 1.0e15 {
        println("EPISTEMIC_FABRICATION: confidence looks like f64 bit-pattern-as-integer")
    }
    return 1
}
