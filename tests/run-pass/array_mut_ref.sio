//@ run-pass
// Regression test: &![T; N] bare array mutation visible to caller.
//
// Bug: when a bare array variable is passed by &! exclusive reference, mutations
// inside the callee via (*arr)[i] = v must be visible in the caller after return.
// Bare `arr[i] = v` on a &![T;N] parameter requires explicit deref: (*arr)[i] = v.
//
// This test verifies the correct explicit-deref pattern works end-to-end:
//   - fill() takes &![i64; 8] and writes via (*arr)[0] = 99
//   - caller's buf[0] reads back 99 after fill returns

fn fill(arr: &![i64; 8]) with Mut, Panic {
    (*arr)[0] = 99
    (*arr)[1] = 42
}

fn main() -> i64 with IO, Mut, Panic {
    var buf: [i64; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
    fill(&! buf)
    if buf[0] == 99 {
        return 0
    }
    return 1
}
