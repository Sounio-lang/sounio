//@ run-pass
//@ description: Knowledge<f64> +,-,*,/ GUM uncertainty propagation (a64 arithmetic dispatch)
//
// Regression guard for the a64 backend: compile_additive_a64 / compile_multiplicative_a64
// had no knowledge_hash_is dispatch, so `a + b` on Knowledge<f64> emitted an integer
// add of two struct pointers (SIGBUS/SIGSEGV), and the a64 dot-accessor was missing
// `.uncertainty`. x86 always handled these.

fn af(x: f64) -> f64 { if x < 0.0 { return 0.0 - x } return x }

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    var fail: i64 = 0
    let a: Knowledge<f64> = measure(10.0, uncertainty: 0.3, confidence: 0.8)
    let b: Knowledge<f64> = measure(20.0, uncertainty: 0.4, confidence: 0.6)

    let sum = a + b
    if af(sum.value - 30.0) > 0.000001 || af(sum.uncertainty - 0.5) > 0.001 || af(sum.confidence - 0.6) > 0.000001 {
        print("sum FAIL\n"); fail = fail + 1
    } else { print("sum PASS\n") }

    let prod = a * b
    if af(prod.value - 200.0) > 0.000001 || af(prod.uncertainty - 7.21110255) > 0.01 || af(prod.confidence - 0.6) > 0.000001 {
        print("prod FAIL\n"); fail = fail + 1
    } else { print("prod PASS\n") }

    let quot = a / b
    if af(quot.value - 0.5) > 0.000001 || af(quot.uncertainty - 0.018027756) > 0.001 || af(quot.confidence - 0.6) > 0.000001 {
        print("quot FAIL\n"); fail = fail + 1
    } else { print("quot PASS\n") }

    if fail == 0 { print("knowledge_arith_a64: ALL PASS\n"); return 0 }
    print("knowledge_arith_a64: SOME FAIL\n")
    return 1 as i32
}
