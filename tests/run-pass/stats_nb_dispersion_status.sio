//@ run-pass
//@ expect-stdout: STATS_NB_DISPERSION_STATUS_PASS
use stats::regression::nb_dispersion::nb2_moment_dispersion
fn main()->i32 with IO,Mut,Div,Panic {
 var counts:[i64;256]=[0;256]
 var means:[f64;256]=[0.0;256]
 let bad_n=nb2_moment_dispersion(&counts,&means,1,0)
 assert(bad_n.status==1 && !bad_n.nb_assumptions_assessed && bad_n.alpha_signed==0.0)
 let bad_p=nb2_moment_dispersion(&counts,&means,4,4)
 assert(bad_p.status==1)
 means[0]=0.0/0.0
 means[1]=1.0
 let nonfinite=nb2_moment_dispersion(&counts,&means,2,0)
 assert(nonfinite.status==2 && nonfinite.pearson_x2==0.0)
 means[0]=0.0
 means[1]=2.0
 let nonpositive=nb2_moment_dispersion(&counts,&means,2,0)
 assert(nonpositive.status==3)
 means[0]=1.0
 means[1]=1.0
 counts[1]=-1
 let negative=nb2_moment_dispersion(&counts,&means,2,0)
 assert(negative.status==4 && negative.n==2)
 counts[0]=0
 counts[1]=10
 means[0]=5.0
 means[1]=5.0
 let over=nb2_moment_dispersion(&counts,&means,2,0)
 assert(over.status==0 && !over.truncated && over.residual_df==2)
 assert(over.alpha_signed==0.8 && over.alpha_nonnegative==0.8)
 assert(over.weight_sum==50.0 && over.pearson_x2==10.0)
 counts[2]=0
 counts[3]=10
 means[2]=5.0
 means[3]=5.0
 let scaled=nb2_moment_dispersion(&counts,&means,4,1)
 assert(scaled.status==0 && scaled.residual_df==3 && !scaled.truncated)
 let expect=0.8*4.0/3.0
 let gap=scaled.alpha_signed-expect
 if gap<0.0 { assert(0.0-gap<1.0e-12) } else { assert(gap<1.0e-12) }
 counts[0]=2
 counts[1]=2
 counts[2]=2
 counts[3]=2
 means[0]=2.0
 means[1]=2.0
 means[2]=2.0
 means[3]=2.0
 let under=nb2_moment_dispersion(&counts,&means,4,0)
 assert(under.status==0 && under.truncated && under.alpha_nonnegative==0.0)
 assert(under.alpha_signed<0.0 && !under.nb_assumptions_assessed)
 counts[4]=9
 means[4]=1.0e308
 let ignored=nb2_moment_dispersion(&counts,&means,4,0)
 assert(ignored.status==0 && ignored.n==4)
 println("STATS_NB_DISPERSION_STATUS_PASS")
 0
}
