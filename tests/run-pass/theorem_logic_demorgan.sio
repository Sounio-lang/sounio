//@ run-pass
// Tests for stdlib/theorem/logic.sio: De Morgan, double negation, contraposition

use theorem::kernel::*;
use theorem::logic::*;

fn run_tests(ctx: &! ProofContext) -> i32 {
    let classical = classical_context(ctx)

    // Set up propositions P and Q
    let p_id = ctx_prop(ctx, prop_custom(30001))
    let q_id = ctx_prop(ctx, prop_custom(30002))

    // Test 1: or_comm — P \/ Q => Q \/ P
    let pq_or = ctx_prop(ctx, prop_or(p_id, q_id))
    let p_prf = assume(ctx, 1, p_id)
    let pq_from_p = or_intro_left(ctx, p_prf, pq_or)
    let qp = or_comm(ctx, pq_from_p, p_id, q_id)
    let qp_conf = proof_confidence(ctx, qp)
    if qp_conf < 0.99 {
        return 1
    }

    // Test 2: and_comm — P /\ Q => Q /\ P
    let pq_and = ctx_prop(ctx, prop_and(p_id, q_id))
    let p_for_and = assume(ctx, 2, p_id)
    let q_for_and = assume(ctx, 3, q_id)
    let pq_prf = and_intro(ctx, p_for_and, q_for_and, pq_and)
    let qp_prf = and_comm(ctx, pq_prf, p_id, q_id)
    let qp_and_conf = proof_confidence(ctx, qp_prf)
    if qp_and_conf < 0.99 {
        return 2
    }

    // Test 3: de_morgan_or — ~(P \/ Q) => ~P /\ ~Q
    let not_pq_or_id = ctx_prop(ctx, prop_not(pq_or))
    let not_pq_prf = assume(ctx, 4, not_pq_or_id)
    let dm_or = de_morgan_or(ctx, not_pq_prf, p_id, q_id)
    let dm_or_conf = proof_confidence(ctx, dm_or)
    if dm_or_conf < 0.99 {
        return 3
    }

    // Test 4: de_morgan_or_rev — ~P /\ ~Q => ~(P \/ Q)
    let not_p_id = ctx_prop(ctx, prop_not(p_id))
    let not_q_id = ctx_prop(ctx, prop_not(q_id))
    let npnq_id = ctx_prop(ctx, prop_and(not_p_id, not_q_id))
    let npnq_prf = assume(ctx, 5, npnq_id)
    let dm_or_rev = de_morgan_or_rev(ctx, npnq_prf, p_id, q_id)
    let dm_rev_conf = proof_confidence(ctx, dm_or_rev)
    if dm_rev_conf < 0.99 {
        return 4
    }

    // Test 5: double_neg_intro — P => ~~P (constructive)
    let p_for_dn = assume(ctx, 6, p_id)
    let nnp = double_neg_intro(ctx, p_for_dn, p_id)
    let nnp_conf = proof_confidence(ctx, nnp)
    if nnp_conf < 0.99 {
        return 5
    }

    // Test 6: double_neg_elim — ~~P => P (classical)
    let nnp2 = double_neg_intro(ctx, p_for_dn, p_id)
    let p_back = double_neg_elim(ctx, nnp2, p_id, classical)
    let p_back_conf = proof_confidence(ctx, p_back)
    if p_back_conf < 0.99 {
        return 6
    }

    // Test 7: contrapositive — (P -> Q) => (~Q -> ~P)
    let impl_id = ctx_prop(ctx, prop_implies(p_id, q_id))
    let pq_impl = trusted(ctx, 100, impl_id, 1.0)
    let contra = contrapositive(ctx, pq_impl, p_id, q_id)
    let contra_conf = proof_confidence(ctx, contra)
    if contra_conf < 0.99 {
        return 7
    }

    // Test 8: curry/uncurry
    let r_id = ctx_prop(ctx, prop_custom(30003))
    let pq_implies_r = ctx_prop(ctx, prop_implies(pq_and, r_id))
    let pqr_prf = trusted(ctx, 200, pq_implies_r, 1.0)
    let curried = curry_proof(ctx, pqr_prf, p_id, q_id, r_id)
    let curry_conf = proof_confidence(ctx, curried)
    if curry_conf < 0.99 {
        return 8
    }

    return 0
}

fn main() -> i32 {
    var ctx = proof_context_new()
    return run_tests(&! ctx)
}
