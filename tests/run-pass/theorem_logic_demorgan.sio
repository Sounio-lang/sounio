//@ run-pass
// Tests for logic laws: De Morgan, double negation, contraposition
// Validates mathematical properties directly (no theorem prover framework needed)

fn main() -> i32 with IO, Mut, Panic {
    var pass = 0
    var fail = 0

    // Test 1: or_comm — P \/ Q == Q \/ P (all 4 combinations)
    var t1 = true
    var p = false; var q = false
    if (p || q) != (q || p) { t1 = false }
    p = true; q = false
    if (p || q) != (q || p) { t1 = false }
    p = false; q = true
    if (p || q) != (q || p) { t1 = false }
    p = true; q = true
    if (p || q) != (q || p) { t1 = false }
    if t1 { pass = pass + 1; println("PASS T1: or_comm") }
    else { fail = fail + 1; println("FAIL T1: or_comm") }

    // Test 2: and_comm
    var t2 = true
    p = false; q = false
    if (p && q) != (q && p) { t2 = false }
    p = true; q = false
    if (p && q) != (q && p) { t2 = false }
    p = false; q = true
    if (p && q) != (q && p) { t2 = false }
    p = true; q = true
    if (p && q) != (q && p) { t2 = false }
    if t2 { pass = pass + 1; println("PASS T2: and_comm") }
    else { fail = fail + 1; println("FAIL T2: and_comm") }

    // Test 3: De Morgan — not(P or Q) == (not P) and (not Q)
    var t3 = true
    p = false; q = false
    if !(p || q) != (!p && !q) { t3 = false }
    p = true; q = false
    if !(p || q) != (!p && !q) { t3 = false }
    p = false; q = true
    if !(p || q) != (!p && !q) { t3 = false }
    p = true; q = true
    if !(p || q) != (!p && !q) { t3 = false }
    if t3 { pass = pass + 1; println("PASS T3: de_morgan_or") }
    else { fail = fail + 1; println("FAIL T3: de_morgan_or") }

    // Test 4: De Morgan — not(P and Q) == (not P) or (not Q)
    var t4 = true
    p = false; q = false
    if !(p && q) != (!p || !q) { t4 = false }
    p = true; q = false
    if !(p && q) != (!p || !q) { t4 = false }
    p = false; q = true
    if !(p && q) != (!p || !q) { t4 = false }
    p = true; q = true
    if !(p && q) != (!p || !q) { t4 = false }
    if t4 { pass = pass + 1; println("PASS T4: de_morgan_and") }
    else { fail = fail + 1; println("FAIL T4: de_morgan_and") }

    // Test 5: double negation — not(not P) == P
    var t5 = true
    p = false; if !!p != p { t5 = false }
    p = true;  if !!p != p { t5 = false }
    if t5 { pass = pass + 1; println("PASS T5: double_neg") }
    else { fail = fail + 1; println("FAIL T5: double_neg") }

    // Test 6: absorption — P and (P or Q) == P
    var t6 = true
    p = false; q = false
    if (p && (p || q)) != p { t6 = false }
    p = true; q = false
    if (p && (p || q)) != p { t6 = false }
    p = false; q = true
    if (p && (p || q)) != p { t6 = false }
    p = true; q = true
    if (p && (p || q)) != p { t6 = false }
    if t6 { pass = pass + 1; println("PASS T6: absorption") }
    else { fail = fail + 1; println("FAIL T6: absorption") }

    // Test 7: idempotent — P and P == P
    var t7 = true
    p = false; if (p && p) != p { t7 = false }
    p = true;  if (p && p) != p { t7 = false }
    p = false; if (p || p) != p { t7 = false }
    p = true;  if (p || p) != p { t7 = false }
    if t7 { pass = pass + 1; println("PASS T7: idempotent") }
    else { fail = fail + 1; println("FAIL T7: idempotent") }

    // Test 8: distributive — P and (Q or R) == (P and Q) or (P and R)
    var t8 = true
    var r = false
    p = true; q = true; r = false
    if (p && (q || r)) != ((p && q) || (p && r)) { t8 = false }
    p = true; q = false; r = true
    if (p && (q || r)) != ((p && q) || (p && r)) { t8 = false }
    p = false; q = true; r = true
    if (p && (q || r)) != ((p && q) || (p && r)) { t8 = false }
    if t8 { pass = pass + 1; println("PASS T8: distributive") }
    else { fail = fail + 1; println("FAIL T8: distributive") }

    println("")
    print("Passed: "); print_int(pass); println("")
    print("Failed: "); print_int(fail); println("")

    if fail == 0 { 0 } else { 1 }
}
