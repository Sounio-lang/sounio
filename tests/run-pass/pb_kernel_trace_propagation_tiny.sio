//@ run-pass
//@ requires: madaros
//@ description: Tiny pseudo-Boolean kernel trace propagation smoke

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn row_fingerprint(w0: i64, w1: i64, w2: i64, rhs: i64, sense: i64) -> i64 {
    var fp: i64 = 83
    var sc: i64 = 0
    if sense == (0 - 1) { sc = 1 }
    if sense == 1 { sc = 2 }
    if sc == 0 { return 0 - 1 }
    fp = mix(fp, w0, 941)
    fp = mix(fp, w1, 941)
    fp = mix(fp, w2, 941)
    fp = mix(fp, rhs, 941)
    fp = mix(fp, sc, 941)
    return fp
}

fn assignment_fingerprint(x0: i64, x1: i64, x2: i64) -> i64 {
    var c0: i64 = 0
    var c1: i64 = 0
    var c2: i64 = 0
    if x0 == 0 { c0 = 1 }
    if x0 == 1 { c0 = 2 }
    if x0 == (0 - 1) { c0 = 3 }
    if x1 == 0 { c1 = 1 }
    if x1 == 1 { c1 = 2 }
    if x1 == (0 - 1) { c1 = 3 }
    if x2 == 0 { c2 = 1 }
    if x2 == 1 { c2 = 2 }
    if x2 == (0 - 1) { c2 = 3 }
    if c0 == 0 { return 0 - 1 }
    if c1 == 0 { return 0 - 1 }
    if c2 == 0 { return 0 - 1 }
    var fp: i64 = 89
    fp = mix(fp, c0, 977)
    fp = mix(fp, c1, 977)
    fp = mix(fp, c2, 977)
    return fp
}

fn main() -> i64 {
    let le = 0 - 1
    let input_fp = row_fingerprint(7, 5, 2, 6, le)
    let saturated_fp = row_fingerprint(6, 5, 2, 6, le)
    let divided_fp = row_fingerprint(3, 2, 1, 3, le)
    let addend_fp = row_fingerprint(1, 2, 0, 2, le)
    let summed_fp = row_fingerprint(4, 4, 1, 5, le)
    let assignment_fp = assignment_fingerprint(1, 0 - 1, 1)
    if input_fp != 307595342 { return 1 }
    if saturated_fp != 760841099 { return 2 }
    if divided_fp != 815489656 { return 3 }
    if addend_fp != 207864799 { return 4 }
    if summed_fp != 234077207 { return 5 }
    if assignment_fp != 140069597 { return 6 }

    var cert_fp: i64 = 127
    cert_fp = mix(cert_fp, 3, 2791)
    cert_fp = mix(cert_fp, input_fp, 2791)
    cert_fp = mix(cert_fp, saturated_fp, 2791)
    cert_fp = mix(cert_fp, 2, 2791)
    cert_fp = mix(cert_fp, divided_fp, 2791)
    cert_fp = mix(cert_fp, addend_fp, 2791)
    cert_fp = mix(cert_fp, summed_fp, 2791)
    cert_fp = mix(cert_fp, assignment_fp, 2791)
    cert_fp = mix(cert_fp, 1, 2791)
    cert_fp = mix(cert_fp, 0, 2791)
    cert_fp = mix(cert_fp, 31, 2791)
    if cert_fp != 478581235 { return 7 }

    var audit_fp: i64 = 139
    audit_fp = mix(audit_fp, cert_fp, 2801)
    audit_fp = mix(audit_fp, input_fp, 2801)
    audit_fp = mix(audit_fp, saturated_fp, 2801)
    audit_fp = mix(audit_fp, divided_fp, 2801)
    audit_fp = mix(audit_fp, summed_fp, 2801)
    audit_fp = mix(audit_fp, 1, 2801)
    audit_fp = mix(audit_fp, 0, 2801)
    audit_fp = mix(audit_fp, 31, 2801)
    if audit_fp != 827870314 { return 8 }
    return 0
}
