//@ run-pass
//@ requires: madaros
//@ expect-stdout: TRAIT_BOUND_LONG_NAME_OK

// A type parameter with a multi-letter name is a type parameter: the call is
// instantiated and the method resolved through its bound, instead of
// lowering to a body-less stub that traps at run time.
trait Lj { fn lj(self) -> f64 }
struct NaCl { pub z: i64 }
impl Lj for NaCl { fn lj(self) -> f64 { 0.300512 } }

fn sigma_of<Elem: Lj>(p: Elem) -> f64 { p.lj() }

fn main() -> i32 with IO {
    let s = sigma_of::<NaCl>(NaCl { z: 0 })
    if s == 0.300512 { print("TRAIT_BOUND_LONG_NAME_OK\n") }
    return 0
}
