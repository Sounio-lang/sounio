//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_DEEP_COMPOSITION_PASS

// Deep unary composition: exp(sin), cos(sqrt), log(exp).

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let k: Knowledge<f64> = measure(0.5, uncertainty: 0.05)
    let x = k.value
    let s = sin(0.5)
    let c = cos(0.5)
    let es = exp(s)
    let s_es = es * c
    let h_es = es * c * c + es * (0.0 - s)
    let ve_e = s_es * s_es * 0.0025
    let me_e = es + 0.5 * h_es * 0.0025
    let ve = variance_of(exp(sin(x)))
    let me = second_order_mean(exp(sin(x)))

    let k2: Knowledge<f64> = measure(4.0, uncertainty: 0.1)
    let x2 = k2.value
    let u = 2.0
    let su = 0.25
    let hu = 0.0 - 1.0 / 32.0
    let f1 = 0.0 - sin(u)
    let f2c = 0.0 - cos(u)
    let s_cs = f1 * su
    let h_cs = f2c * su * su + f1 * hu
    let vc_e = s_cs * s_cs * 0.01
    let mc_e = cos(u) + 0.5 * h_cs * 0.01
    let vc = variance_of(cos(sqrt(x2)))
    let mc = second_order_mean(cos(sqrt(x2)))

    let k3: Knowledge<f64> = measure(0.7, uncertainty: 0.03)
    let x3 = k3.value
    let vl = variance_of(log(exp(x3)))
    let ml = second_order_mean(log(exp(x3)))

    print("ve="); print_f64(ve); print("\n")
    print("me="); print_f64(me); print("\n")
    print("vc="); print_f64(vc); print("\n")
    print("mc="); print_f64(mc); print("\n")
    print("vl="); print_f64(vl); print("\n")
    print("ml="); print_f64(ml); print("\n")

    let ok = abs_f(ve - ve_e) < 1.0e-9
        && abs_f(me - me_e) < 1.0e-8
        && abs_f(vc - vc_e) < 1.0e-9
        && abs_f(mc - mc_e) < 1.0e-8
        && abs_f(vl - 0.0009) < 1.0e-6
        && abs_f(ml - 0.7) < 1.0e-4
    if ok {
        print("MADAROS_GUM_FO_DEEP_COMPOSITION_PASS\n")
    } else {
        print("MADAROS_GUM_FO_DEEP_COMPOSITION_FAIL\n")
    }
}
