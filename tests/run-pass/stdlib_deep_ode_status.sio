//@ run-pass
//@ expect-stdout: STDLIB_DEEP_ODE_STATUS_PASS
use ode::solver::{solve_rk4_exp_decay,solve_bdf1_exp_decay,solve_rk45_exp_decay,solve_pk3_rk4,default_options,State3,SolverPKParams3}
fn main()->i32 with IO,Mut,Div,Panic {
 let invalid=solve_rk4_exp_decay(1.0,0.0,1.0,0)
 assert(!invalid.success && invalid.status==3 && invalid.nsteps==0 && invalid.u_final==0.0)
 let negative=solve_bdf1_exp_decay(1.0,0.0,1.0,-1)
 assert(!negative.success && negative.status==3)
 let cap=solve_rk4_exp_decay(1.0,0.0,1.0,1000001)
 assert(cap.status==3)
 let nan=0.0/0.0
 let bad=solve_rk4_exp_decay(nan,0.0,1.0,1)
 assert(bad.status==3 && !bad.success)
 let empty=solve_rk4_exp_decay(2.0,3.0,3.0,10)
 assert(empty.success && empty.nsteps==0 && empty.nfeval==0 && empty.u_final==2.0)
 let stalled=solve_rk4_exp_decay(1.0,1.0e300,1.0000000000000002e300,10)
 assert(!stalled.success && stalled.status==2 && stalled.t_final==1.0e300)
 let normal=solve_rk4_exp_decay(1.0,0.0,1.0,10)
 assert(normal.success && normal.status==0 && normal.t_final==1.0 && normal.nsteps==10)
 let backward=solve_bdf1_exp_decay(1.0,1.0,0.0,10)
 assert(backward.success && backward.t_final==0.0 && backward.u_final>1.0)
 var opts=default_options()
 opts.max_steps=0
 let optbad=solve_rk45_exp_decay(1.0,0.0,1.0,opts)
 assert(optbad.status==3)
 opts=default_options();opts.max_steps=1;opts.dt_init=0.01
 let budget=solve_rk45_exp_decay(1.0,0.0,1.0,opts)
 assert(!budget.success && budget.status==1 && budget.nsteps+budget.nreject==1 && budget.nfeval==7)
 opts=default_options();opts.dt_min=1.0;opts.dt_max=1.0;opts.dt_init=1.0;opts.atol=1.0e-30;opts.rtol=0.0
 let rejected=solve_rk45_exp_decay(1.0,0.0,1.0,opts)
 assert(!rejected.success && rejected.status==2 && rejected.nreject==1 && rejected.nsteps==0)
 let state=State3{u1:1.0,u2:0.0,u3:0.0,t:0.0}
 let params=SolverPKParams3{ka:1.0,ke:0.0,k12:1.0,k21:0.0}
 let pkbad=solve_pk3_rk4(state,params,1.0,0)
 assert(!pkbad.success && pkbad.status==3)
 let pk=solve_pk3_rk4(state,params,1.0,1)
 assert(pk.success && pk.nsteps==1 && pk.nfeval==4)
 let d=pk.u3_final-7.0/24.0
 assert(d<1.0e-14 && d> -1.0e-14)
 println("STDLIB_DEEP_ODE_STATUS_PASS")
 0
}
