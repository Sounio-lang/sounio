//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: iv [0, 0]

fn main() -> i64 with IO, Epistemic {
    let x = knight("k", 0.0, 1.0)
    let z = x - x
    if z.iv.0 != 0.0 || z.iv.1 != 0.0 { return 1 }
    let y = knight("k", 0.0, 1.0)
    let w = x - y
    if w.iv.0 != 0.0 || w.iv.1 != 0.0 { return 1 }
    println("iv [0, 0]")
    0
}
