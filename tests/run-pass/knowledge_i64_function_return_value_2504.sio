//@ run-pass
//@ requires: madaros
//@ description: Knowledge payload kind survives direct, inferred, and method returns; f64 stays floating

fn ordinary_i64() -> i64 { 42 }

fn make_i64_observation() -> Knowledge<i64> with Epistemic {
    measure(42, uncertainty: 1.0)
}

struct ObservationFactory { tag: i64 }

impl ObservationFactory {
    fn produce(self) -> Knowledge<i64> with Epistemic {
        measure(42, uncertainty: 1.0)
    }
}

fn make_f64_observation() -> Knowledge<f64> with Epistemic {
    measure(2.5, uncertainty: 1.0)
}

fn main() -> i32 with IO, Epistemic, Div {
    if ordinary_i64() != 42 { return 7 }
    let inferred_i64 = make_i64_observation()
    if inferred_i64.value != 42 { return 1 }
    if make_i64_observation().value != 42 { return 2 }
    let factory_direct = ObservationFactory { tag: 0 }
    if factory_direct.produce().value != 42 { return 5 }
    let factory_inferred = ObservationFactory { tag: 0 }
    let inferred_method = factory_inferred.produce()
    if inferred_method.value != 42 { return 6 }
    let inferred_f64 = make_f64_observation()
    if inferred_f64.value != 2.5 { return 3 }
    if make_f64_observation().value != 2.5 { return 4 }
    0
}
