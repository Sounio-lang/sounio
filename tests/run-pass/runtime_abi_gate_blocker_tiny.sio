//@ run-pass
//@ description: Self-contained runtime ABI blocker gate

fn runtime_abi_gate_blocker_check(
    solver_proof_profile_fp: i64,
    solver_proof_profile_audit_fp: i64,
    lorenz_replay_verifier_preflight_fp: i64,
    lorenz_replay_verifier_preflight_audit_fp: i64,
    frontend_typecheck_pass_mask: i64,
    self_contained_runtime_pass_mask: i64,
    multimodule_witness_pass_mask: i64,
    wide_call_runtime_pass_mask: i64,
    imported_solver_runtime_pass_mask: i64,
    known_blocker_mask: i64,
    imported_runtime_promotion_mask: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64) -> i64 {
    if solver_proof_profile_fp != 964210753 { return 0 - 1 }
    if solver_proof_profile_audit_fp != 526184309 { return 0 - 1 }
    if lorenz_replay_verifier_preflight_fp != 391742608 { return 0 - 1 }
    if lorenz_replay_verifier_preflight_audit_fp != 650219347 { return 0 - 1 }
    if frontend_typecheck_pass_mask != 3 { return 0 - 1 }
    if self_contained_runtime_pass_mask != 1 { return 0 - 1 }
    if multimodule_witness_pass_mask != 0 { return 0 - 1 }
    if wide_call_runtime_pass_mask != 0 { return 0 - 1 }
    if imported_solver_runtime_pass_mask != 0 { return 0 - 1 }
    if known_blocker_mask != 7 { return 0 - 1 }
    if imported_runtime_promotion_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    return 584291376
}

fn main() -> i64 {
    let artifact = runtime_abi_gate_blocker_check(
        964210753, 526184309, 391742608, 650219347, 3, 1, 0, 0, 0, 7, 0, 0, 0)
    if artifact != 584291376 { return 1 }

    let audit_fp: i64 = 936740152
    let instance_fp: i64 = 265813904
    let certificate_fp: i64 = 718406529
    let solver_domain: i64 = 4
    let proof_format: i64 = 6
    let profile_status: i64 = 88
    let verifier_preflight_status: i64 = 91
    let runtime_evidence_level: i64 = 2
    let runtime_abi_anchor_mask: i64 = 63
    let frontend_contract_mask: i64 = 3
    let self_contained_evidence_mask: i64 = 1
    let imported_runtime_missing_mask: i64 = 7
    let known_madaros_runtime_blocker_mask: i64 = 7
    let runtime_evidence_private_level: i64 = 2
    let imported_promotion_blocked_mask: i64 = 0
    let public_theorem_ready_mask: i64 = 0
    let global_promotion_ready_mask: i64 = 0
    let runtime_abi_next_action_mask: i64 = 31
    let ok_mask: i64 = 255

    if audit_fp != 936740152 { return 2 }
    if instance_fp != 265813904 { return 3 }
    if certificate_fp != 718406529 { return 4 }
    if solver_domain != 4 { return 5 }
    if proof_format != 6 { return 6 }
    if profile_status != 88 { return 7 }
    if verifier_preflight_status != 91 { return 8 }
    if runtime_evidence_level != 2 { return 9 }
    if runtime_abi_anchor_mask != 63 { return 10 }
    if frontend_contract_mask != 3 { return 11 }
    if self_contained_evidence_mask != 1 { return 12 }
    if imported_runtime_missing_mask != 7 { return 13 }
    if known_madaros_runtime_blocker_mask != 7 { return 14 }
    if runtime_evidence_private_level != 2 { return 15 }
    if imported_promotion_blocked_mask != 0 { return 16 }
    if public_theorem_ready_mask != 0 { return 17 }
    if global_promotion_ready_mask != 0 { return 18 }
    if runtime_abi_next_action_mask != 31 { return 19 }
    if ok_mask != 255 { return 20 }

    let fake_multimodule_green = runtime_abi_gate_blocker_check(
        964210753, 526184309, 391742608, 650219347, 3, 1, 1, 0, 0, 7, 0, 0, 0)
    if fake_multimodule_green != 0 - 1 { return 21 }

    let fake_wide_call_green = runtime_abi_gate_blocker_check(
        964210753, 526184309, 391742608, 650219347, 3, 1, 0, 1, 0, 7, 0, 0, 0)
    if fake_wide_call_green != 0 - 1 { return 22 }

    let fake_imported_solver_green = runtime_abi_gate_blocker_check(
        964210753, 526184309, 391742608, 650219347, 3, 1, 0, 0, 1, 7, 0, 0, 0)
    if fake_imported_solver_green != 0 - 1 { return 23 }

    let fake_promotion = runtime_abi_gate_blocker_check(
        964210753, 526184309, 391742608, 650219347, 3, 1, 0, 0, 0, 7, 1, 0, 0)
    if fake_promotion != 0 - 1 { return 24 }

    let fake_public = runtime_abi_gate_blocker_check(
        964210753, 526184309, 391742608, 650219347, 3, 1, 0, 0, 0, 7, 0, 1, 0)
    if fake_public != 0 - 1 { return 25 }

    return 0
}
