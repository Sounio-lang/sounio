//@ run-pass
//@ expect-stdout: PASS
// GUM-through-ODE: variance propagation through an Euler integration loop.
// dy/dt = -k·y (exponential decay), y(0) = 100 ± 2, k = 0.1 ± 0.01
// 10 Euler steps with h = 0.1

fn rhs(y: f64, k: f64) -> f64 with Mut {
    let dy = 0.0 - k * y
    return dy
}

fn main() with IO, Mut, Epistemic {
    let ky: Knowledge<f64> = measure(100.0, uncertainty: 2.0)
    let kk: Knowledge<f64> = measure(0.1, uncertainty: 0.01)
    var y = ky.value    // var(y) = 4.0
    let k = kk.value    // var(k) = 0.0001
    let h = 0.1

    var step: i64 = 0
    while step < 10 {
        let dy = rhs(y, k)
        let delta = h * dy
        y = y + delta
        step = step + 1
    }

    let vy = variance_of(y)
    print("y_final="); println(y)
    print("var(y_final)="); println(vy)
    print("PASS\n")
}
