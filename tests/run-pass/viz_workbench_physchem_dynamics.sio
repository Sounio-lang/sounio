// tests/run-pass/viz_workbench_physchem_dynamics.sio - Workbench physchem dynamics proof
//
// Expected output:
//   VIZ_WORKBENCH_PHYSCHEM_DYNAMICS_PASS

use display::canvas::{Canvas}
use display::event::{Event, EV_MOUSE_PRESS, EV_MOTION, MOUSE_LEFT}
use viz::audit::{viz_audit_hash}
use viz::ir::{viz_scene_new, VIZ_NODE_LATTICE_FIELD, VIZ_NODE_PARTICLE_EVENT}
use viz::viz_app::{viz_app_new, viz_app_render, viz_app_frame_hash}
use viz::workbench::{
    viz_workbench_build_scene, viz_workbench_constraint,
    viz_workbench_app_handle_event,
}

fn ev(kind: i64, key: i64, x: i64, y: i64) -> Event {
    Event { kind: kind, key: key, x: x, y: y, mods: 0 }
}

fn make_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pix = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pix, width: w, height: h }
}

fn read_px(c: &Canvas, x: i64, y: i64) -> i64 {
    read_i64(c.pixels, y * c.width + x)
}

fn main() with IO, Alloc, Mut, Div {
    var scene = viz_scene_new()
    let ids = viz_workbench_build_scene(&!scene)
    var constraint = viz_workbench_constraint(&ids)
    var app = viz_app_new(10, 13, 18)
    var c = make_canvas(480, 320)

    assert(scene.nodes[ids.lattice as usize].kind == VIZ_NODE_LATTICE_FIELD)
    assert(scene.nodes[ids.particle_event as usize].kind == VIZ_NODE_PARTICLE_EVENT)
    assert(scene.lattice_count == 1)
    assert(scene.particle_event_count == 1)
    assert(scene.lattice_data[0].rows == 6)
    assert(scene.lattice_data[0].cols == 6)
    assert(scene.particle_event_data[0].n == 18)

    viz_app_render(&!app, &!scene, &!c)
    let initial_frame_hash = viz_app_frame_hash(&app, &scene, &c)
    let initial_audit = viz_audit_hash(&scene)
    let initial_phase = scene.lattice_data[0].phase[10]
    let initial_dx = scene.lattice_data[0].displacement_x[10]
    let initial_energy = scene.particle_event_data[0].energy[10]
    let initial_px = scene.particle_event_data[0].px[10]
    assert(read_px(&c, scene.nodes[ids.lattice as usize].layout.x, scene.nodes[ids.lattice as usize].layout.y) != 0)
    assert(read_px(&c, scene.nodes[ids.particle_event as usize].layout.x, scene.nodes[ids.particle_event as usize].layout.y) != 0)

    assert(viz_workbench_app_handle_event(&!app, &!scene, &!constraint, ev(EV_MOUSE_PRESS, MOUSE_LEFT, 46, 238)))
    assert(viz_workbench_app_handle_event(&!app, &!scene, &!constraint, ev(EV_MOTION, 0, 101, 238)))
    assert(scene.time == 5.0)
    assert(scene.lattice_data[0].phase[10] != initial_phase)
    assert(scene.lattice_data[0].displacement_x[10] != initial_dx)
    assert(scene.particle_event_data[0].energy[10] != initial_energy)
    assert(scene.particle_event_data[0].px[10] != initial_px)
    assert(viz_audit_hash(&scene) != initial_audit)
    assert(app.dirty)

    viz_app_render(&!app, &!scene, &!c)
    assert(!app.dirty)
    assert(viz_app_frame_hash(&app, &scene, &c) != initial_frame_hash)
    assert(read_px(&c, scene.nodes[ids.lattice as usize].layout.x, scene.nodes[ids.lattice as usize].layout.y) != 0)
    assert(read_px(&c, scene.nodes[ids.particle_event as usize].layout.x, scene.nodes[ids.particle_event as usize].layout.y) != 0)

    heap_free(c.pixels as *mut i8)
    println("VIZ_WORKBENCH_PHYSCHEM_DYNAMICS_PASS")
}
