//@ run-pass
//@ expect-stdout: EPISTEMIC_FERMENTATION_PASS
// Epistemic Fermentation: same surface number, different path-bearing truth.
//
// The point of this witness is intentionally small:
//   - two values carry the same numeric dose and confidence
//   - their fermentation path is represented by distinct types
//   - a measured-only consumer accepts only the measured path

use epistemic::path::*

fn main() with IO, Panic {
    let measured = ep_measured_gum_i64(42000, 980)
    let imputed = ep_imputed_model_i64(42000, 980)

    let measured_payload = ep_payload_from_measured_gum(measured)
    let imputed_payload = ep_payload_from_imputed_model(imputed)

    let surface_ok = ep_same_value_confidence(measured_payload, imputed_payload)
    let fermentation_diff = ep_same_fermentation(measured_payload, imputed_payload) == false
    let measured_gate_ok = ep_accept_measured_payload(measured_payload)
    let imputed_gate_rejected = ep_accept_measured_payload(imputed_payload) == false

    if surface_ok && fermentation_diff && measured_gate_ok && imputed_gate_rejected {
        println("EPISTEMIC_FERMENTATION_PASS")
    } else {
        println("EPISTEMIC_FERMENTATION_FAIL")
    }
}
