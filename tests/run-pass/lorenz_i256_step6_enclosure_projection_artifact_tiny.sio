//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 enclosure projection with directed rounding

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 317
    fp = mix(fp, 6, 3407)
    fp = mix(fp, 4294967296, 3407)
    fp = mix(fp, 1000000, 3407)
    fp = mix(fp, 134624236, 3407)
    fp = mix(fp, 643317565, 3407)
    fp = mix(fp, 237534229, 3407)
    fp = mix(fp, 931365823, 3407)
    fp = mix(fp, 5784820704, 3407)
    fp = mix(fp, 11394426024, 3407)
    fp = mix(fp, 4100266743, 3407)
    fp = mix(fp, 1287058242, 3407)
    fp = mix(fp, 1671998042, 3407)
    fp = mix(fp, 231967709, 3407)
    fp = mix(fp, 4497762462, 3407)
    fp = mix(fp, 9722427982, 3407)
    fp = mix(fp, 3868299034, 3407)
    fp = mix(fp, 7071878946, 3407)
    fp = mix(fp, 13066424066, 3407)
    fp = mix(fp, 4332234452, 3407)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 35569102 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 331
    fp = mix(fp, instance, 3433)
    fp = mix(fp, 1047216, 3433)
    fp = mix(fp, 2263679, 3433)
    fp = mix(fp, 900658, 3433)
    fp = mix(fp, 1646551, 3433)
    fp = mix(fp, 3042264, 3433)
    fp = mix(fp, 1008677, 3433)
    fp = mix(fp, 599335, 3433)
    fp = mix(fp, 778585, 3433)
    fp = mix(fp, 108019, 3433)
    fp = mix(fp, ok_mask, 3433)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 35569102 { return 0 - 1 }
    if certificate != 472466935 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 337
    fp = mix(fp, instance, 3449)
    fp = mix(fp, certificate, 3449)
    fp = mix(fp, 134624236, 3449)
    fp = mix(fp, 237534229, 3449)
    fp = mix(fp, 3, 3449)
    fp = mix(fp, 6, 3449)
    fp = mix(fp, 1047216, 3449)
    fp = mix(fp, 2263679, 3449)
    fp = mix(fp, 900658, 3449)
    fp = mix(fp, 1646551, 3449)
    fp = mix(fp, 3042264, 3449)
    fp = mix(fp, 1008677, 3449)
    fp = mix(fp, ok_mask, 3449)
    return fp
}

fn source_endpoint_mask() -> i64 {
    let cx: i256 = 5784820704 as i256
    let cy: i256 = 11394426024 as i256
    let cz: i256 = 4100266743 as i256
    let rx: i256 = 1287058242 as i256
    let ry: i256 = 1671998042 as i256
    let rz: i256 = 231967709 as i256
    let lx: i256 = cx - rx
    let ly: i256 = cy - ry
    let lz: i256 = cz - rz
    let ux: i256 = cx + rx
    let uy: i256 = cy + ry
    let uz: i256 = cz + rz
    if lx != 4497762462 as i256 { return 0 }
    if ly != 9722427982 as i256 { return 0 }
    if lz != 3868299034 as i256 { return 0 }
    if ux != 7071878946 as i256 { return 0 }
    if uy != 13066424066 as i256 { return 0 }
    if uz != 4332234452 as i256 { return 0 }
    if ux - lx != (2 as i256) * rx { return 1 }
    if uy - ly != (2 as i256) * ry { return 1 }
    if uz - lz != (2 as i256) * rz { return 1 }
    return 3
}

fn lower_rounding_mask() -> i64 {
    let s: i256 = 4294967296 as i256
    let t: i256 = 1000000 as i256
    let lx: i256 = 4497762462 as i256
    let ly: i256 = 9722427982 as i256
    let lz: i256 = 3868299034 as i256
    let qx: i256 = 1047216 as i256
    let qy: i256 = 2263679 as i256
    let qz: i256 = 900658 as i256
    if qx * s > lx * t { return 0 }
    if (qx + (1 as i256)) * s <= lx * t { return 0 }
    if qy * s > ly * t { return 0 }
    if (qy + (1 as i256)) * s <= ly * t { return 0 }
    if qz * s > lz * t { return 0 }
    if (qz + (1 as i256)) * s <= lz * t { return 0 }
    return 4
}

fn upper_rounding_mask() -> i64 {
    let s: i256 = 4294967296 as i256
    let t: i256 = 1000000 as i256
    let ux: i256 = 7071878946 as i256
    let uy: i256 = 13066424066 as i256
    let uz: i256 = 4332234452 as i256
    let qx: i256 = 1646551 as i256
    let qy: i256 = 3042264 as i256
    let qz: i256 = 1008677 as i256
    if (qx - (1 as i256)) * s >= ux * t { return 0 }
    if qx * s < ux * t { return 0 }
    if (qy - (1 as i256)) * s >= uy * t { return 0 }
    if qy * s < uy * t { return 0 }
    if (qz - (1 as i256)) * s >= uz * t { return 0 }
    if qz * s < uz * t { return 0 }
    return 8
}

fn target_shape_mask() -> i64 {
    if 1646551 - 1047216 != 599335 { return 0 }
    if 3042264 - 2263679 != 778585 { return 0 }
    if 1008677 - 900658 != 108019 { return 0 }
    if 1047216 >= 1646551 { return 0 }
    if 2263679 >= 3042264 { return 0 }
    if 900658 >= 1008677 { return 0 }
    return 16
}

fn center_and_anchor_mask() -> i64 {
    if 1047216 > 1346883 { return 0 }
    if 1646551 < 1346884 { return 0 }
    if 2263679 > 2652971 { return 0 }
    if 3042264 < 2652972 { return 0 }
    if 900658 > 954667 { return 0 }
    if 1008677 < 954668 { return 0 }
    return 96
}

fn main() -> i64 {
    var ok_mask: i64 = 0
    ok_mask = ok_mask + source_endpoint_mask()
    ok_mask = ok_mask + lower_rounding_mask()
    ok_mask = ok_mask + upper_rounding_mask()
    ok_mask = ok_mask + target_shape_mask()
    ok_mask = ok_mask + center_and_anchor_mask()
    if ok_mask != 127 { return 1 }

    let inst = instance_fp()
    if inst != 35569102 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 472466935 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 516981885 { return 4 }
    if certificate_fp(inst, 126) != (0 - 1) { return 5 }
    return 0
}
