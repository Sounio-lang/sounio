//@ run-pass

study MyStudy {
    title: "Test"
    design: parallel_rct
    participants {
        sample_size: 30
        power: 0.80
    }
    outcomes {
        primary: endpoint_a
    }
    analysis {
        hypothesis H1 {
            outcome: endpoint_a
            direction: greater
            effect_size: 0.5
        }
        alpha: 0.05
        correction: bonferroni
    }
}

fn t_test_one_sample(outcome: i32, n: i32, mu0: i32) -> i32 {
    outcome + n + mu0
}

fn analyze() -> i32 with Hypothesis {
    let endpoint_a = 3
    t_test_one_sample(endpoint_a, 30, 0)
}

fn main() -> i32 with IO, Hypothesis {
    let r = analyze()
    println("registered analysis: clean")
    0
}
