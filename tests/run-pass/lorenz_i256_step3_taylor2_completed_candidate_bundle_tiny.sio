//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-3 Taylor-2 completed candidate bundle keeps proof gates separate

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1843
    fp = mix(fp, 3, 5813)
    fp = mix(fp, 116883728, 5813)
    fp = mix(fp, 84354264, 5813)
    fp = mix(fp, 164784481, 5813)
    fp = mix(fp, 660765149, 5813)
    fp = mix(fp, 844877047, 5813)
    fp = mix(fp, 492955058, 5813)
    fp = mix(fp, 693563916, 5813)
    fp = mix(fp, 465507112, 5813)
    fp = mix(fp, 15, 5813)
    fp = mix(fp, 15, 5813)
    fp = mix(fp, 0, 5813)
    fp = mix(fp, 4, 5813)
    fp = mix(fp, 0, 5813)
    fp = mix(fp, 0, 5813)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 220878249 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    var fp: i64 = 1847
    fp = mix(fp, instance, 5821)
    fp = mix(fp, 4, 5821)
    fp = mix(fp, 4, 5821)
    fp = mix(fp, 4, 5821)
    fp = mix(fp, 0, 5821)
    fp = mix(fp, 15, 5821)
    fp = mix(fp, 0, 5821)
    fp = mix(fp, 0, 5821)
    fp = mix(fp, ok_mask, 5821)
    fp = mix(fp, 0, 5821)
    fp = mix(fp, 0, 5821)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 220878249 { return 0 - 1 }
    if certificate != 449726126 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    var fp: i64 = 1853
    fp = mix(fp, instance, 5827)
    fp = mix(fp, certificate, 5827)
    fp = mix(fp, 4, 5827)
    fp = mix(fp, 3, 5827)
    fp = mix(fp, 15, 5827)
    fp = mix(fp, 0, 5827)
    fp = mix(fp, 4, 5827)
    fp = mix(fp, 0, 5827)
    fp = mix(fp, ok_mask, 5827)
    fp = mix(fp, 0, 5827)
    fp = mix(fp, 0, 5827)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 693283321 { return 0 - 1 }
    if instance != 220878249 { return 0 - 1 }
    if certificate != 449726126 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    var fp: i64 = 1861
    fp = mix(fp, artifact, 5839)
    fp = mix(fp, instance, 5839)
    fp = mix(fp, certificate, 5839)
    fp = mix(fp, 116883728, 5839)
    fp = mix(fp, 164784481, 5839)
    fp = mix(fp, 844877047, 5839)
    fp = mix(fp, 693563916, 5839)
    fp = mix(fp, 3, 5839)
    fp = mix(fp, 4, 5839)
    fp = mix(fp, ok_mask, 5839)
    fp = mix(fp, 0, 5839)
    fp = mix(fp, 0, 5839)
    return fp
}

fn completed_mask() -> i64 {
    let required_mask: i64 = 15
    let provided_mask: i64 = 15
    let missing_mask: i64 = 0
    let complete_status: i64 = 4
    let validated_mask: i64 = 0
    let local_containment_proof_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0

    var ok_mask: i64 = 0
    if 116883728 > 0 {
        if 164784481 > 0 {
            if 844877047 > 0 {
                if 693563916 > 0 { ok_mask = ok_mask + 1 }
            }
        }
    }
    if 116883728 != 164784481 {
        if 844877047 != 693563916 { ok_mask = ok_mask + 2 }
    }
    if missing_mask == required_mask - provided_mask { ok_mask = ok_mask + 4 }
    if 4 == 4 {
        if 0 == 0 { ok_mask = ok_mask + 8 }
    }
    if complete_status == 4 {
        if missing_mask == 0 { ok_mask = ok_mask + 16 }
    }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if provided_mask == required_mask {
        if provided_mask + missing_mask == required_mask { ok_mask = ok_mask + 64 }
    }
    if local_containment_proof_mask == 0 {
        if global_flowpipe_claim_mask == 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = completed_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 220878249 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 449726126 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 693283321 { return 4 }
    if audit_fp(art, inst, cert, ok_mask) != 160292433 { return 5 }
    if certificate_fp(inst, 254) != (0 - 1) { return 6 }
    return 0
}
