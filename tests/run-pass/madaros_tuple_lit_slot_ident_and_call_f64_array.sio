//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_LIT_SLOT_IDENT_AND_CALL_F64_ARRAY PASS
//
// Copilot review (PR #2516), finding C on the fourth review round:
// expr_list_tuple_f64_array_mask_ref (the ExprTupleLit element classifier,
// self-hosted/ir/lower.sio) only marked a tuple-literal slot as an f64
// array when the slot expression WAS an array literal directly
// (array_literal_elems_are_float_ref). Two other valid, unannotated forms
// were missed:
//
//   let xs = mk_arr(); let (a, n) = (xs, 0)   -- slot is ExprIdent
//   let (a, n) = (mk_arr(), 0)                -- slot is ExprCall
//
// In both, `mk_arr()` returns a single `[f64; N]` array (not a tuple), so
// slot 0 of the tuple literal `(xs, 0)` / `(mk_arr(), 0)` is an f64 array
// even though the slot expression itself is neither `[f64;N]` nor `[x;N]`.
// Before the fix, both fell straight through to `false` and `a[0]` took the
// integer path, misreading the f64 bits as i64.
fn mk_arr() -> [f64; 2] with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    a[0] = 1.5
    a[1] = 0.25
    a
}

fn main() -> i32 with IO, Mut, Panic {
    // Form 1: local identifier already known to hold an f64 array.
    let xs = mk_arr()
    let (a, n) = (xs, 0)
    let s0: f64 = a[0] * 2.0

    // Form 2: direct call inside the tuple literal (no intervening let).
    let (a2, n2) = (mk_arr(), 1)
    let s1: f64 = 2.0 * a2[1]

    if s0 == 3.0 && s1 == 0.5 && n == 0 && n2 == 1 {
        println("TUPLE_LIT_SLOT_IDENT_AND_CALL_F64_ARRAY PASS")
        return 0
    }
    1
}
