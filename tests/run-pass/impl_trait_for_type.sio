//@ run-pass
// Acceptance test 1 for compiler prerequisite #2 (impl Trait for Type parsing).
// Spike verbatim from docs/handoff/spike_impl_trait_for_type.sio.
// Tests both Bug A (bodyless trait method signatures) and Bug B (impl Trait for Type).
// Expected output: 3, then "spike PASS"

trait Tr {
    fn g(self) -> i64
}

struct Q { v: i64 }

impl Tr for Q {
    fn g(self) -> i64 { self.v }
}

fn main() with IO {
    let q = Q { v: 3 }
    println(q.g())
    println("spike PASS")
}
