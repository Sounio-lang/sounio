//@ run-pass
// Independent scalar executor for proof-carrying rebracketing protocol D7.

fn d7_native_bool(value: bool) -> i64 { if value { 1 } else { 0 } }

fn d7_bounded_semantic_code(
    status: i64,
    survivor_mask: i64,
    burden: i64,
    evidence_count: i64,
    evidence_fingerprint: i64,
) -> i64 with Panic {
    assert(status >= 0 && status <= 3)
    assert(survivor_mask >= 0 && survivor_mask <= 3)
    assert(burden >= 0 && burden <= 7)
    assert(evidence_count >= 0 && evidence_count <= 2)
    assert(evidence_fingerprint >= 0 && evidence_fingerprint < 1000000)
    let code = (((status * 31 + survivor_mask) * 31 + burden) * 31 +
        evidence_count) * 1000000 + evidence_fingerprint
    assert(code >= 0 && code <= 92475999999)
    code
}

fn local_equality_decision_predicate(
    same_typed: bool,
    same_ordered: bool,
    same_operator: bool,
    both_defined: bool,
    exact_equal: bool,
    local_scope: bool,
) -> bool {
    same_typed && same_ordered && same_operator && both_defined && exact_equal &&
        local_scope
}

fn main() with Panic {
    let a = 9101
    let b = 9102
    let c = 9103
    let flat_source = (a * 101 + b) * 101 + c
    let flat_target = a * 10201 + (b * 101 + c)
    let source_tree = (a * 31 + b) * 31 + c
    let target_tree = a * 31 + (b * 31 + c)
    let semantic_source = d7_bounded_semantic_code(2, 3, 3, 1, 8101)
    let semantic_target = d7_bounded_semantic_code(3, 2, 7, 2, 259234)

    assert(flat_source == 93767706 && flat_target == 93767706)
    assert(source_tree == 9037326 && target_tree == 573396)
    assert(semantic_source == 62559008101)
    assert(semantic_target == 91514259234)

    let local_decided = local_equality_decision_predicate(
        true, true, true, true, flat_source == flat_target, true,
    )
    let semantic_decided = local_equality_decision_predicate(
        true, true, true, true, semantic_source == semantic_target, true,
    )
    assert(local_decided && !semantic_decided)

    let decision_audit_checksum = 10101 * 31 + 9702
    let replay_audit_checksum = decision_audit_checksum * 31 + 10301
    assert(decision_audit_checksum == 322833)
    assert(replay_audit_checksum == 10018124)

    let semantic_diff = d7_native_bool(2 != 3) +
        2 * d7_native_bool(3 != 2) +
        4 * d7_native_bool(3 != 7) +
        8 * d7_native_bool(1 != 2)
    assert(semantic_diff == 15)
    let refusal_reason_mask = 1 + 2 + 4 + 8 + 16
    let refusal_audit_checksum = ((10102 * 31 + 9701) * 31 + 9704) * 31 + 9703
    assert(refusal_reason_mask == 31)
    assert(refusal_audit_checksum == 310581870)

    let mismatch_reason_mask = 1 + 2
    let mismatch_base_checksum = (decision_audit_checksum * 31 + 11003) * 31 +
        10801
    let mismatch_refusal_checksum = mismatch_base_checksum * 7 +
        mismatch_reason_mask
    assert(mismatch_reason_mask == 3)
    assert(mismatch_refusal_checksum == 2174160852)

    let promotion_audit_checksum = decision_audit_checksum * 31 + 10501
    let abstention_reason_mask = 1 + 2 + 4 + 8 + 16 + 32
    let abstention_base_checksum = promotion_audit_checksum * 31 + 10601
    let abstention_audit_checksum = abstention_base_checksum * 127 +
        abstention_reason_mask
    assert(promotion_audit_checksum == 10018324)
    assert(abstention_reason_mask == 63)
    assert(abstention_audit_checksum == 39443487978)

    let decision_case_count = 3
    let local_count = d7_native_bool(local_decided)
    let refusal_count = d7_native_bool(!semantic_decided)
    let abstention_count = d7_native_bool(true)
    let compiler_capability_count = 0
    let compiler_rewrite_count = 0
    let contest_ir_count = 0
    let ontology_transport_count = 0
    assert(local_count + refusal_count + abstention_count == decision_case_count)

    assert(compiler_capability_count == 0 && compiler_rewrite_count == 0)
    assert(contest_ir_count == 0 && ontology_transport_count == 0)

    println("D7-W0 recorded_cases=3 local_decisions=1 semantic_refusals=1 promotion_abstentions=1 model_replays=1 mismatch_refusals=1")
    print("D7-W1 flat_left=93767706 flat_right=93767706 ")
    print("tree_left=9037326 tree_right=573396 ")
    println("decision_checksum=322833 replay_checksum=10018124")
    print("D7-W2 semantic_source=62559008101 semantic_target=91514259234 ")
    println("difference_bitset=15 reason_mask=31 refusal_checksum=310581870")
    println("D7-W3 promotion_checksum=10018324 reason_mask=63 abstention_checksum=39443487978 global_law=false")
    println("D7-W4 protocol=8700 public=true sealed=false compiler_capability=0 compiler_rewrites=0 contest_ir=0 ontology_transport=0")
    println("D7-W5 requested_occurrence=11003 mismatch_reason=3 model_replay=false refusal_checksum=2174160852")
    println("PROOF-CARRYING REBRACKETING PROTOCOL D7 PASS")
}
