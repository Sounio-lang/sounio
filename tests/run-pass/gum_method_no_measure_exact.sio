//@ run-pass
//@ requires: madaros
//@ expect-stdout: GUM_METHOD_NO_MEASURE_OK
//@ description: A method that does not measure stays exact under the call-site refusal of clone-less callees that can draw: Rig::quad (no query, tangent clone through `self`) carries the variance and second-order mean of its argument, and Rig::calm (its body asks for an uncertainty, so no clone, but it makes no measurement) called with a certain argument reads variance 0, which is the value. Expected values: tests/oracles/gum_method_no_measure_exact.cpp (1e-10 relative).

struct Rig { k: f64 }

impl Rig {
    fn quad(self: &Rig, a: f64) -> f64 with Mut, Div {
        self.k * a * a
    }
    fn calm(self: &Rig, a: f64) -> f64 with Epistemic, Mut, Div {
        let v = variance_of(self.k)
        a * self.k + v
    }
}

fn close_rel(got: f64, want: f64) -> bool with Mut, Div {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    var w = want
    if w < 0.0 { w = 0.0 - w }
    d <= 1.0e-14 + 1.0e-10 * w
}

fn report_rel(name: string, got: f64, want: f64) -> i64 with IO, Mut, Div {
    print(name)
    print(" ")
    print_f64(got)
    if close_rel(got, want) {
        print(" ok\n")
        return 0
    }
    print(" FAIL\n")
    1
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    var bad: i64 = 0
    let rig = Rig { k: 3.0 }
    let ka = measure(1.5, uncertainty: 0.1)
    let a: f64 = ka.value
    let r = rig.quad(a)
    bad = bad + report_rel("quad_var", variance_of(r), 0.81000000000000005)
    bad = bad + report_rel("quad_mean", second_order_mean(r), 6.7800000000000002)
    bad = bad + report_rel("quad_sq_var", variance_of(r * r), 147.62250000000003)
    let a0: f64 = 1.5
    let c = rig.calm(a0)
    bad = bad + report_rel("certain_var", variance_of(c), 0.0)
    if bad == 0 {
        print("GUM_METHOD_NO_MEASURE_OK\n")
        return 0
    }
    1
}
