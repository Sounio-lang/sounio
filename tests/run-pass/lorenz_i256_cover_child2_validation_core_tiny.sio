//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-2 local validation core receipt

fn child2_validation_core_check(
    child2_local_flowpipe_preflight_fp: i64,
    child2_local_flowpipe_preflight_audit_fp: i64,
    child2_obligation_seed_fp: i64,
    child2_obligation_seed_audit_fp: i64,
    child1_validation_core_fp: i64,
    child1_validation_core_audit_fp: i64,
    five_step_local_flowpipe_chain_fp: i64,
    five_step_local_flowpipe_chain_audit_fp: i64,
    child_index: i64,
    slot_x: i64,
    slot_y: i64,
    slot_z: i64,
    global_flowpipe_claim_mask: i64,
    validation_status: i64) -> i64 {
    if child2_local_flowpipe_preflight_fp != 312780944 { return 0 - 1 }
    if child2_local_flowpipe_preflight_audit_fp != 542916038 { return 0 - 1 }
    if child2_obligation_seed_fp != 844216507 { return 0 - 1 }
    if child2_obligation_seed_audit_fp != 781563019 { return 0 - 1 }
    if child1_validation_core_fp != 648831016 { return 0 - 1 }
    if child1_validation_core_audit_fp != 63312412 { return 0 - 1 }
    if five_step_local_flowpipe_chain_fp != 911209450 { return 0 - 1 }
    if five_step_local_flowpipe_chain_audit_fp != 709377850 { return 0 - 1 }
    if child_index != 2 { return 0 - 1 }
    if slot_x != 0 { return 0 - 1 }
    if slot_y != 1 { return 0 - 1 }
    if slot_z != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if validation_status != 66 { return 0 - 1 }
    return 173471211
}

fn main() -> i64 {
    let artifact = child2_validation_core_check(
        312780944, 542916038, 844216507, 781563019, 648831016, 63312412,
        911209450, 709377850, 2, 0, 1, 0, 0, 66)
    if artifact != 173471211 { return 1 }

    let audit_fp: i64 = 173431050
    let instance_fp: i64 = 61203519
    let certificate_fp: i64 = 907847810
    let selected_child_mask: i64 = 4
    let prior_child_validated_mask: i64 = 3
    let child_validated_mask: i64 = 7
    let pending_child_validation_mask: i64 = 24
    let child_axis_readiness_mask: i64 = 7
    let local_flowpipe_preflight_mask: i64 = 31
    let local_flowpipe_proof_mask: i64 = 31
    let proof_dependency_mask: i64 = 31
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0
    let validation_status: i64 = 66
    let ok_mask: i64 = 255

    if audit_fp != 173431050 { return 2 }
    if instance_fp != 61203519 { return 3 }
    if certificate_fp != 907847810 { return 4 }
    if selected_child_mask != 4 { return 5 }
    if prior_child_validated_mask != 3 { return 6 }
    if child_validated_mask != 7 { return 7 }
    if pending_child_validation_mask != 24 { return 8 }
    if child_axis_readiness_mask != 7 { return 9 }
    if local_flowpipe_preflight_mask != 31 { return 10 }
    if local_flowpipe_proof_mask != 31 { return 11 }
    if proof_dependency_mask != 31 { return 12 }
    if child_discharge_mask != 0 { return 13 }
    if global_cover_certificate_mask != 0 { return 14 }
    if global_flowpipe_claim_mask != 0 { return 15 }
    if validation_status != 66 { return 16 }
    if ok_mask != 255 { return 17 }

    let wrong_preflight = child2_validation_core_check(
        1, 542916038, 844216507, 781563019, 648831016, 63312412,
        911209450, 709377850, 2, 0, 1, 0, 0, 66)
    if wrong_preflight != 0 - 1 { return 18 }

    let wrong_child = child2_validation_core_check(
        312780944, 542916038, 844216507, 781563019, 648831016, 63312412,
        911209450, 709377850, 3, 0, 1, 0, 0, 66)
    if wrong_child != 0 - 1 { return 19 }

    let overclaim = child2_validation_core_check(
        312780944, 542916038, 844216507, 781563019, 648831016, 63312412,
        911209450, 709377850, 2, 0, 1, 0, 1, 66)
    if overclaim != 0 - 1 { return 20 }

    return 0
}
