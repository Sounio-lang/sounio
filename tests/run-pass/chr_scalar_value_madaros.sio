//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: CHR: PASS
//@ description: ADR-015 row 4 (probes chr_basic, chr_utf8) -- a character literal is its Unicode scalar value: ASCII, the escapes, and 2-, 3- and 4-byte UTF-8 sequences.

fn main() with IO {
    var ok: i64 = 1
    if 'a' as i64 != 97 { ok = 0 }
    if '\n' as i64 != 10 { ok = 0 }
    if '\'' as i64 != 39 { ok = 0 }
    if '\\' as i64 != 92 { ok = 0 }
    if 'é' as i64 != 233 { ok = 0 }
    if '€' as i64 != 8364 { ok = 0 }
    if '😀' as i64 != 128512 { ok = 0 }
    if ok == 1 { print("CHR: PASS\n") } else { print("CHR: FAIL\n") }
}
