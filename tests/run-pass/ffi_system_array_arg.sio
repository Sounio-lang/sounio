//@ run-pass
//@ requires: madaros
//@ expect-stdout: ffi_system_array_arg: PASS
// Engine-gated: ffi_system is a Madaros native builtin (fork/execve/wait4).
// KL-14a (2026-09-15): `&[i8;N]` through the signatureless ffi_ path now
// unwraps the ref to a GC handle at the call site and resolves it to a C
// char* in the emitter — same shape as the working `string` binding.
// lean_single already passed; the residual was Madaros-only.

extern "C" {
    fn system(cmd: &[i8; 1024]) -> i32
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var cmd: [i8; 1024] = [0; 1024]
    let s = "/usr/bin/touch /tmp/sounio_ffi_system_array_probe"
    var i: i64 = 0
    let n = str_len(s) as i64
    while i < n && i < 1023 {
        cmd[i as usize] = str_char_at(s, i as usize) as i8
        i = i + 1
    }
    let rc = system(&cmd)
    if rc == 0 {
        println("ffi_system_array_arg: PASS")
        return 0
    }
    println("ffi_system_array_arg: FAIL")
    return 1
}
