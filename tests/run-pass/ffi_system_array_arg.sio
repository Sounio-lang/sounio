//@ run-pass
//@ requires: madaros
// Engine-gated, not silenced. The CI suite runs souc-stage2, which is the
// lean_single self-host output, not Madaros -- see SOUNIO_TEST_SOUC_BIN in
// .github/workflows/ci.yml. ffi_system is a Madaros native builtin (fork/execve/wait4).
// Verified PASS on a Madaros built from this branch, on Slurm.
//@ known-failure: extern "C" fn with a &[i8;N] (reference-to-aggregate) parameter forwards an empty pointer through the signatureless ffi_ builtin path — the untyped builtin call site cannot lower an aggregate-reference argument correctly (a `string`/pointer-scalar arg works; see ffi_system_exec.sio). Documented in docs/audit/MADAROS_EXTERN_C_BUILTIN_PORT_DISPATCH_2026-08-16.md. The idiomatic C binding for system(const char*) is a `string` param.
// Coverage kept per the Track B author's deliberate choice of the &[i8;1024]
// binding: this reproduces the reference-to-aggregate-arg limitation so a
// future fix (giving ffi_ builtins real parameter types) has a live receipt.

extern "C" {
    fn system(cmd: &[i8; 1024]) -> i32
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var cmd: [i8; 1024] = [0; 1024]
    let s = "/usr/bin/touch /tmp/sounio_ffi_system_array_probe"
    var i: i64 = 0
    let n = str_len(s) as i64
    while i < n && i < 1023 {
        cmd[i as usize] = str_char_at(s, i as usize) as i8
        i = i + 1
    }
    let rc = system(&cmd)
    if rc == 0 {
        println("ffi_system_array_arg: PASS")
        return 0
    }
    println("ffi_system_array_arg: FAIL")
    return 1
}
