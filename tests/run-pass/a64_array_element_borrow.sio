//@ run-pass
//@ expect-stdout: 77
//@ expect-stdout: 78
//@ description: distinguish element borrow from range slice; borrow aggregate pointee, not pointer cell
struct BorrowRecord { padding: [i64; 128], marker: i64 }
fn borrow_read(p: &BorrowRecord) -> i64 { p.marker }
fn borrow_bump(p: &!BorrowRecord) with Mut { p.marker = p.marker + 1 }
fn main() with IO, Mut, Panic, Div {
    let record = BorrowRecord { padding: [0; 128], marker: 77 }
    var records: [BorrowRecord; 4] = [record; 4]
    borrow_bump(&!records[1 as usize])
    print_int(borrow_read(&records[0 as usize]))
    print("\n")
    print_int(borrow_read(&records[1 as usize]))
    print("\n")
}
