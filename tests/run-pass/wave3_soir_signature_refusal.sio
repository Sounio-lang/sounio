//@ run-pass
//@ requires: madaros
//@ expect-stdout: SOIR_SIGNATURE_REFUSAL_OK
use ir::ir::*;
use ir::serialize::*;
fn main()->i32 with IO,Mut,Alloc,Div,Panic {
    var k:i64=0
    while k<9 {
        var module=ir_empty_module()
        module.fn_count=1
        var f=ir_empty_function()
        f.name=make_name("signature")
        if k==0 {f.returns_float=1}
        if k==1 {f.return_struct_name=make_name("string")}
        if k==2 {f.return_fixed_array_len= -1073741824}
        if k==3 {f.bss_size=8}
        if k==4 {f.first_param_is_ref=1}
        if k==5 {f.f128_param_mask=1}
        if k==6 {f.ref_struct_param_mask=1}
        if k==7 {f.compile_strategy=99}
        if k==8 {f.return_fixed_array_len=4}
        ir_fn_set(&!module,0,f)
        let before=SOIR_SER_REFUSAL_COUNT
        let image=serialize_ir_module(module)
        if image.1!=0 || SOIR_SER_REFUSAL_COUNT<=before {return 1}
        k=k+1
    }
    var default_module=ir_empty_module()
    default_module.fn_count=1
    var default_fn=ir_empty_function()
    default_fn.name=make_name("default")
    ir_fn_set(&!default_module,0,default_fn)
    let before_default=SOIR_SER_REFUSAL_COUNT
    let good=serialize_ir_module(default_module)
    if good.1<=0 || SOIR_SER_REFUSAL_COUNT!=before_default {return 2}
    let restored=deserialize_ir_module(good.0,good.1)
    if restored.fn_count!=1 {return 3}
    let decoded=ir_fn_get(&restored,0)
    if decoded.return_fixed_array_len!= -1 || decoded.ref_struct_param_mask!=0 {return 4}
    println("SOIR_SIGNATURE_REFUSAL_OK")
    0
}
