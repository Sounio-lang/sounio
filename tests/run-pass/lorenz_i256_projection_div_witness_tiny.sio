//@ run-pass
//@ requires: madaros
//@ description: Lorenz i256 projection quotient/remainder witnesses factored through div_witness

fn cert_mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn projection_div_witness_fingerprint(
    trajectory_manifest_fp: i64,
    source_scale: i64,
    target_scale: i64,
    final_x_2p32: i64,
    final_y_2p32: i64,
    final_z_2p32: i64,
    x_q: i64,
    x_r: i64,
    y_q: i64,
    y_r: i64,
    z_q: i64,
    z_r: i64,
    projection_witness_fp: i64,
    projection_inclusion_fp: i64) -> i64 {
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if source_scale != 4294967296 { return 0 - 1 }
    if target_scale != 1000000 { return 0 - 1 }
    if final_x_2p32 != 5309941770 { return 0 - 1 }
    if final_y_2p32 != 10058731223 { return 0 - 1 }
    if final_z_2p32 != 4084837935 { return 0 - 1 }
    if x_q != 1236317 { return 0 - 1 }
    if x_r != 687511168 { return 0 - 1 }
    if y_q != 2341980 { return 0 - 1 }
    if y_r != 3715113920 { return 0 - 1 }
    if z_q != 951075 { return 0 - 1 }
    if z_r != 1913956800 { return 0 - 1 }
    if projection_witness_fp != 440693751 { return 0 - 1 }
    if projection_inclusion_fp != 890086395 { return 0 - 1 }

    var fp: i64 = 347
    fp = cert_mix(fp, trajectory_manifest_fp, 2609)
    fp = cert_mix(fp, source_scale, 2609)
    fp = cert_mix(fp, target_scale, 2609)
    fp = cert_mix(fp, final_x_2p32, 2609)
    fp = cert_mix(fp, final_y_2p32, 2609)
    fp = cert_mix(fp, final_z_2p32, 2609)
    fp = cert_mix(fp, x_q, 2609)
    fp = cert_mix(fp, x_r, 2609)
    fp = cert_mix(fp, y_q, 2609)
    fp = cert_mix(fp, y_r, 2609)
    fp = cert_mix(fp, z_q, 2609)
    fp = cert_mix(fp, z_r, 2609)
    fp = cert_mix(fp, projection_witness_fp, 2609)
    fp = cert_mix(fp, projection_inclusion_fp, 2609)
    return fp
}

fn projection_div_witness_audit_fingerprint(
    projection_div_witness_fp: i64,
    roundoff_budget_fp: i64,
    projection_margin_budget_fp: i64,
    projection_inclusion_fp: i64,
    readiness_mask: i64) -> i64 {
    if projection_div_witness_fp != 693793961 { return 0 - 1 }
    if roundoff_budget_fp != 677514412 { return 0 - 1 }
    if projection_margin_budget_fp != 69322697 { return 0 - 1 }
    if projection_inclusion_fp != 890086395 { return 0 - 1 }
    if readiness_mask != 31 { return 0 - 1 }

    var fp: i64 = 353
    fp = cert_mix(fp, projection_div_witness_fp, 2617)
    fp = cert_mix(fp, roundoff_budget_fp, 2617)
    fp = cert_mix(fp, projection_margin_budget_fp, 2617)
    fp = cert_mix(fp, projection_inclusion_fp, 2617)
    fp = cert_mix(fp, readiness_mask, 2617)
    return fp
}

fn main() -> i64 {
    let fp = projection_div_witness_fingerprint(
        214180161, 4294967296, 1000000,
        5309941770, 10058731223, 4084837935,
        1236317, 687511168,
        2341980, 3715113920,
        951075, 1913956800,
        440693751, 890086395)
    if fp != 693793961 { return 1 }

    let audit_fp = projection_div_witness_audit_fingerprint(
        fp, 677514412, 69322697, 890086395, 31)
    if audit_fp != 659349019 { return 2 }

    if projection_div_witness_fingerprint(
        214180161, 4294967296, 1000000,
        5309941770, 10058731223, 4084837935,
        1236317, 687511169,
        2341980, 3715113920,
        951075, 1913956800,
        440693751, 890086395) != (0 - 1) { return 3 }
    if projection_div_witness_audit_fingerprint(
        fp, 677514413, 69322697, 890086395, 31) != (0 - 1) { return 4 }

    return 0
}
