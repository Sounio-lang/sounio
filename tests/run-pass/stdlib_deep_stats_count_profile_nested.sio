use stats::regression::count_profile_embedding::{count_profile_embedding_validate,count_profile_embedding_warm}
//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: DEEP COUNT PROFILE NESTED PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_at,numeric_buffer_set,numeric_buffer_close,numeric_matrix}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_at,integer_buffer_set,integer_buffer_close}
use stats::regression::dynamic_count_profile_bootstrap::{CountProfileBootstrapOptions,dynamic_count_profile_bootstrap_nested_workspace,dynamic_count_profile_lrt_bootstrap_nested}
use stats::checked_count_sampling::{count_rng}
use math::pure::{ln_checked}
use random::pcg64_core::{pcg_step_into}
use io::sci_print::{println_f64_sci}
fn nested_case(model:i64,variant:i64) with Alloc,IO,Mut,Div,Panic {
 let n:i64=16
 let p0:i64=1
 let p1:i64=2
 let plan=dynamic_count_profile_bootstrap_nested_workspace(n,p0,p1)
 assert(plan.status==0)
 var a0=numeric_buffer_new(n*p0,n*p0*8)
 var a1=numeric_buffer_new(n*p1,n*p1*8)
 let layout0=numeric_matrix(n*p0,n,p0,p0,1,0)
 let layout1=numeric_matrix(n*p1,n,p1,p1,1,0)
 var counts=integer_buffer_new(n,n*8)
 var offsets0=numeric_buffer_new(n,n*8)
 var offsets1=numeric_buffer_new(n,n*8)
 var initial0=numeric_buffer_new(p0,p0*8)
 var initial1=numeric_buffer_new(p1,p1*8)
 var replicate=integer_buffer_new(n,n*8)
 var generating=numeric_buffer_new(n,n*8)
 var coefficients0=numeric_buffer_new(p0,p0*8)
 var means0=numeric_buffer_new(n,n*8)
 var eta0=numeric_buffer_new(n,n*8)
 var weighted0=numeric_buffer_new(plan.null_design_elements,plan.null_design_elements*8)
 var response0=numeric_buffer_new(n,n*8)
 var step0=numeric_buffer_new(p0,p0*8)
 var qr0=numeric_buffer_new(plan.null_qr_elements,plan.null_qr_elements*8)
 var stage0=numeric_buffer_new(plan.null_stage_elements,plan.null_stage_elements*8)
 var coefficients1=numeric_buffer_new(p1,p1*8)
 var means1=numeric_buffer_new(n,n*8)
 var eta1=numeric_buffer_new(n,n*8)
 var weighted1=numeric_buffer_new(plan.alternative_design_elements,plan.alternative_design_elements*8)
 var response1=numeric_buffer_new(n,n*8)
 var step1=numeric_buffer_new(p1,p1*8)
 var qr1=numeric_buffer_new(plan.alternative_qr_elements,plan.alternative_qr_elements*8)
 var stage1=numeric_buffer_new(plan.alternative_stage_elements,plan.alternative_stage_elements*8)
 var candidate_coefficients0=numeric_buffer_new(p0,p0*8)
 var candidate_means0=numeric_buffer_new(n,n*8)
 var candidate_eta0=numeric_buffer_new(n,n*8)
 var best_coefficients0=numeric_buffer_new(p0,p0*8)
 var best_means0=numeric_buffer_new(n,n*8)
 var best_eta0=numeric_buffer_new(n,n*8)
 var factor_r0=numeric_buffer_new(0,0)
 var factor_scales0=numeric_buffer_new(0,0)
 var permutation0=integer_buffer_new(0,0)
 var candidate_coefficients1=numeric_buffer_new(p1,p1*8)
 var candidate_means1=numeric_buffer_new(n,n*8)
 var candidate_eta1=numeric_buffer_new(n,n*8)
 var best_coefficients1=numeric_buffer_new(p1,p1*8)
 var best_means1=numeric_buffer_new(n,n*8)
 var best_eta1=numeric_buffer_new(n,n*8)
 var factor_r1=numeric_buffer_new(0,0)
 var factor_scales1=numeric_buffer_new(0,0)
 var permutation1=integer_buffer_new(0,0)
 var embedding=numeric_buffer_new(2,16)
 var warm_start=numeric_buffer_new(if variant==23 {0}else{2},16)
 numeric_buffer_set(&!embedding,0,1.0);numeric_buffer_set(&!embedding,1,1.0)
 let data:[i64;16]=if model==3 {[6,6,6,6,6,6,6,6,6,6,6,6,6,6,6,6]}else{if model==0 {[4,6,11,10,7,4,6,7,5,6,4,7,9,10,3,11]}else{if model==1 {[7,10,11,10,12,7,9,8,11,8,9,12,12,10,5,7]}else{[8,3,7,10,18,9,15,4,12,9,9,7,13,6,6,12]}}}
 let tiny=ln_checked(1e-20)
 let wrong=ln_checked(10.0)
 assert(tiny.status==0 && wrong.status==0)
 var i:i64=0
 while i<n {
  integer_buffer_set(&!counts,i,data[i as usize])
  numeric_buffer_set(&!a0,i,1.0)
  var j:i64=0
  while j<p1 {
   let value=if p1==1 {1.0}else{if i/8==j {1.0}else{0.0}}
   numeric_buffer_set(&!a1,i*p1+j,value)
   j=j+1
  }
  if variant==5 {
   if i==0 {
    numeric_buffer_set(&!a0,0,0.0)
    j=0
    while j<p1 {numeric_buffer_set(&!a1,j,0.0);j=j+1}
    numeric_buffer_set(&!offsets0,0,tiny.value)
    numeric_buffer_set(&!offsets1,0,tiny.value)
   }
  }
  if variant==7 {if i>=8 {numeric_buffer_set(&!offsets1,i,wrong.value)}}
  i=i+1
 }
 if variant==6 {integer_buffer_set(&!counts,0,9007199254740993)}
 if variant==10 {i=0;while i<n {integer_buffer_set(&!counts,i,6);i=i+1}}
 let pooled=ln_checked(8.0)
 assert(pooled.status==0)
 numeric_buffer_set(&!initial0,0,pooled.value)
 numeric_buffer_set(&!initial1,0,pooled.value);numeric_buffer_set(&!initial1,1,pooled.value)
 let lower:f64= -12.0
 let upper:f64=6.0
 let budget:i64=2
 let per_uniforms:i64=1000000
 if variant==20 {numeric_buffer_set(&!embedding,0,2.0)}
 if variant==21 {numeric_buffer_set(&!offsets1,0,1.0)}
 if variant==22 {let nan:f64=0.0/0.0;numeric_buffer_set(&!embedding,0,nan)}
 numeric_buffer_set(&!coefficients0,0,999.0)
 numeric_buffer_set(&!coefficients1,0,999.0)
 let options=CountProfileBootstrapOptions{replicates:2,rcond:0.0,
 log_alpha_lower:lower,log_alpha_upper:upper,outer_tolerance:1e-7,max_outer_evaluations:120,
 inner_iterations:100,inner_tolerance:1e-9,max_profile_attempts:budget,
 max_uniforms_per_draw:per_uniforms,max_proposals_per_draw:1000000,
 max_total_uniforms:1000000,max_total_proposals:1000000,
 nesting_declared:true,model_declared:true,independence_declared:variant!=2}
 let seed:i64=if model==0 {7}else{if model==1 {19}else{0}}
 let initial_rng=count_rng(seed)
 let initial_hi:i64=initial_rng.state_hi
 let initial_lo:i64=initial_rng.state_lo
 let initial_inc_hi:i64=initial_rng.inc_hi
 let initial_inc_lo:i64=initial_rng.inc_lo
 let result=dynamic_count_profile_lrt_bootstrap_nested(&a0,&layout0,&offsets0,&initial0,&a1,&layout1,
 &offsets1,&initial1,&counts,&options,initial_rng,&!replicate,&!generating,
 &!coefficients0,&!means0,&!eta0,&!weighted0,&!response0,&!step0,&!qr0,&!stage0,
 &!coefficients1,&!means1,&!eta1,&!weighted1,&!response1,&!step1,&!qr1,&!stage1,
 &!candidate_coefficients0,&!candidate_means0,&!candidate_eta0,&!best_coefficients0,&!best_means0,&!best_eta0,&!factor_r0,&!factor_scales0,&!permutation0,
 &!candidate_coefficients1,&!candidate_means1,&!candidate_eta1,&!best_coefficients1,&!best_means1,&!best_eta1,&!factor_r1,&!factor_scales1,&!permutation1,&embedding,&!warm_start)
 let status:i64=result.status
 let stage:i64=result.failure_stage
 print("NESTED ");print(model);print(" ");print(variant);print(" ");print(status);print(" ");println(stage)
 if variant>=20 {
  assert(status==13 && stage==9)
  assert(result.fit_attempts==0 && result.count_draws==0)
  assert(numeric_buffer_at(&coefficients0,0)==999.0)
  assert(numeric_buffer_at(&coefficients1,0)==999.0)
 } else {
  assert(status==5 && result.observed_available)
  assert(result.observed_lr_available && result.observed_signed_lr>=0.0)
  if model==3 {assert(result.observed_signed_lr==0.0)}
  assert(result.fit_attempts==2 && result.replicates_completed==0 && result.count_draws==0)
 }
 assert(!result.available && !result.mc_available && result.p_value==0.0)
 assert(result.rng.state_hi==initial_hi && result.rng.state_lo==initial_lo)
 assert(result.rng.inc_hi==initial_inc_hi && result.rng.inc_lo==initial_inc_lo)
 numeric_buffer_close(embedding);numeric_buffer_close(warm_start)
 numeric_buffer_close(a0)
 numeric_buffer_close(a1)
 integer_buffer_close(counts)
 numeric_buffer_close(offsets0)
 numeric_buffer_close(offsets1)
 numeric_buffer_close(initial0)
 numeric_buffer_close(initial1)
 integer_buffer_close(replicate)
 numeric_buffer_close(generating)
 numeric_buffer_close(coefficients0)
 numeric_buffer_close(means0)
 numeric_buffer_close(eta0)
 numeric_buffer_close(weighted0)
 numeric_buffer_close(response0)
 numeric_buffer_close(step0)
 numeric_buffer_close(qr0)
 numeric_buffer_close(stage0)
 numeric_buffer_close(coefficients1)
 numeric_buffer_close(means1)
 numeric_buffer_close(eta1)
 numeric_buffer_close(weighted1)
 numeric_buffer_close(response1)
 numeric_buffer_close(step1)
 numeric_buffer_close(qr1)
 numeric_buffer_close(stage1)
 numeric_buffer_close(candidate_coefficients0)
 numeric_buffer_close(candidate_means0)
 numeric_buffer_close(candidate_eta0)
 numeric_buffer_close(best_coefficients0)
 numeric_buffer_close(best_means0)
 numeric_buffer_close(best_eta0)
 numeric_buffer_close(factor_r0)
 numeric_buffer_close(factor_scales0)
 integer_buffer_close(permutation0)
 numeric_buffer_close(candidate_coefficients1)
 numeric_buffer_close(candidate_means1)
 numeric_buffer_close(candidate_eta1)
 numeric_buffer_close(best_coefficients1)
 numeric_buffer_close(best_means1)
 numeric_buffer_close(best_eta1)
 numeric_buffer_close(factor_r1)
 numeric_buffer_close(factor_scales1)
 integer_buffer_close(permutation1)
}
fn adversarial_embedding() with Alloc,IO,Mut,Div,Panic {
 var x0=numeric_buffer_new(2,16)
 var x1=numeric_buffer_new(4,32)
 var o0=numeric_buffer_new(2,16)
 var o1=numeric_buffer_new(2,16)
 var embedding=numeric_buffer_new(2,16)
 var beta=numeric_buffer_new(1,8)
 var warm=numeric_buffer_new(2,16)
 let l0=numeric_matrix(2,2,1,1,1,0)
 let l1=numeric_matrix(4,2,2,2,1,0)
 var i:i64=0
 while i<4 {numeric_buffer_set(&!x1,i,1.0);i=i+1}
 let maximum:f64=1.7976931348623157e308
 numeric_buffer_set(&!embedding,0,maximum);numeric_buffer_set(&!embedding,1,-maximum)
 assert(count_profile_embedding_validate(&x0,&l0,&o0,&x1,&l1,&o1,&embedding)==0)
 // X1*E is represented zero, yet E*beta overflows. A design witness is not
 // an exact prediction witness; the separate warm-start guard must reject.
 numeric_buffer_set(&!beta,0,2.0)
 numeric_buffer_set(&!warm,0,999.0)
 assert(count_profile_embedding_warm(&embedding,&beta,1,2,&!warm)==13)
 assert(numeric_buffer_at(&warm,0)==999.0)
 i=0;while i<4 {numeric_buffer_set(&!x1,i,2.0);i=i+1}
 assert(count_profile_embedding_validate(&x0,&l0,&o0,&x1,&l1,&o1,&embedding)==13)
 let minimum:f64=2.2250738585072014e-308/4503599627370496.0
 numeric_buffer_set(&!embedding,0,minimum);numeric_buffer_set(&!embedding,1,0.0)
 i=0;while i<2 {numeric_buffer_set(&!x1,i*2,0.5);numeric_buffer_set(&!x1,i*2+1,0.0);i=i+1}
 assert(count_profile_embedding_validate(&x0,&l0,&o0,&x1,&l1,&o1,&embedding)==13)
 numeric_buffer_set(&!embedding,0,1.0);numeric_buffer_set(&!embedding,1,1.0)
 i=0;while i<4 {numeric_buffer_set(&!x1,i,1.0);i=i+1}
 assert(count_profile_embedding_validate(&x0,&l0,&o0,&x1,&l1,&o1,&embedding)==13)
 numeric_buffer_set(&!embedding,0,1e-200);numeric_buffer_set(&!embedding,1,1e200)
 i=0;while i<2 {numeric_buffer_set(&!x1,i*2,1e200);numeric_buffer_set(&!x1,i*2+1,-1e-200);i=i+1}
 assert(count_profile_embedding_validate(&x0,&l0,&o0,&x1,&l1,&o1,&embedding)==0)
 numeric_buffer_close(x0);numeric_buffer_close(x1);numeric_buffer_close(o0);numeric_buffer_close(o1)
 numeric_buffer_close(embedding);numeric_buffer_close(beta);numeric_buffer_close(warm)
}
fn main()->i32 with Alloc,IO,Mut,Div,Panic {
 adversarial_embedding()
 nested_case(0,0);nested_case(1,0);nested_case(2,0);nested_case(3,0)
 nested_case(0,20);nested_case(0,21);nested_case(0,22);nested_case(0,23)
 println("DEEP COUNT PROFILE NESTED PASS")
 0
}
