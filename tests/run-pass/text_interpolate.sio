//@ run-pass
//@ expect-stdout: ALL 4 TESTS PASSED
// text_interpolate.sio — Tests for string template substitution
// All definitions inlined (tests cannot import stdlib).
//
// T1: interp_str("Hello {name}!", "name", "World") == "Hello World!"
// T2: interp_i64("x = {x}", "x", 42) == "x = 42"
// T3: two substitutions in sequence
// T4: no match returns template unchanged

// ============================================================================
// Inlined helpers
// ============================================================================

// format_int: i64 -> string (using str_slice on digit lookup)
fn fmt_int(n: i64) -> string with Mut, Panic, Div {
    if n == 0 { return "0" }
    var neg = n < 0
    var m: i64 = n
    if neg { m = 0 - n }
    var result = ""
    while m > 0 {
        let d = m % 10
        result = str_concat(str_slice("0123456789", d, d + 1), result)
        m = m / 10
    }
    if neg { result = str_concat("-", result) }
    result
}

// Find first occurrence of needle in haystack from position start.
// Returns index >= 0 if found, -1 otherwise.
fn interp_find(haystack: string, needle: string, start: i64) -> i64 with Mut, Div {
    let hlen = str_len(haystack)
    let nlen = str_len(needle)
    if nlen == 0 { return start }
    var i: i64 = start
    while i + nlen <= hlen {
        let sub = str_slice(haystack, i, i + nlen)
        if str_eq(sub, needle) { return i }
        i = i + 1
    }
    return 0 - 1
}

// Replace first {placeholder} in template with value.
fn interp_replace(template: string, placeholder: string, value: string) -> string with Mut, Div {
    // Build "{placeholder}" using intermediate var to avoid nested str_concat eval-order bug
    let ph_inner = str_concat(placeholder, "}")
    let ph = str_concat("{", ph_inner)
    let ph_len = str_len(ph)
    let t_len = str_len(template)
    let pos = interp_find(template, ph, 0)
    if pos < 0 { return template }
    let before = str_slice(template, 0, pos)
    let after = str_slice(template, pos + ph_len, t_len)
    let mid = str_concat(before, value)
    str_concat(mid, after)
}

fn interp_str(template: string, key: string, value: string) -> string with Mut, Div {
    interp_replace(template, key, value)
}

fn interp_i64(template: string, key: string, value: i64) -> string with Mut, Div, Panic {
    interp_replace(template, key, fmt_int(value))
}

// ============================================================================
// Tests
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    var passed: i32 = 0
    var failed: i32 = 0

    // T1: interp_str("Hello {name}!", "name", "World") == "Hello World!"
    let r1 = interp_str("Hello {name}!", "name", "World")
    if str_eq(r1, "Hello World!") {
        passed = passed + 1
    } else {
        failed = failed + 1
        println("FAIL T1")
    }

    // T2: interp_i64("x = {x}", "x", 42) == "x = 42"
    let r2 = interp_i64("x = {x}", "x", 42)
    if str_eq(r2, "x = 42") {
        passed = passed + 1
    } else {
        failed = failed + 1
        println("FAIL T2")
    }

    // T3: two substitutions in sequence
    let t3a = interp_str("Dear {first}, welcome to {place}!", "first", "Alice")
    let t3b = interp_str(t3a, "place", "Sounio")
    if str_eq(t3b, "Dear Alice, welcome to Sounio!") {
        passed = passed + 1
    } else {
        failed = failed + 1
        println("FAIL T3")
    }

    // T4: no match returns template unchanged
    let orig = "no placeholders here"
    let r4 = interp_str(orig, "missing", "value")
    if str_eq(r4, orig) {
        passed = passed + 1
    } else {
        failed = failed + 1
        println("FAIL T4")
    }

    if failed == 0 {
        println("ALL 4 TESTS PASSED")
        return 0
    }
    return 1
}
