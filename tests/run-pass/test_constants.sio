//@ run-pass
// test_constants.sio — Validates stdlib/math/constants.sio to 14+ significant digits
//
// All constant functions are inlined (no imports). Each value is checked against
// its known reference to within 1.0e-14 tolerance.
//
// References:
//   OEIS (https://oeis.org)
//   DLMF (https://dlmf.nist.gov)
//   IEEE 754-2008 (machine epsilon)

// ============================================================================
// HELPERS (must precede callers — no forward refs)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn check_f64(got: f64, expected: f64, tol: f64) -> bool {
    let diff = abs_f64(got - expected)
    if diff < tol { return true }
    return false
}

// ============================================================================
// INLINED CONSTANT FUNCTIONS (from stdlib/math/constants.sio)
// ============================================================================

// Circle constants
fn pi() -> f64 { 3.14159265358979323846 }
fn tau() -> f64 { 6.28318530717958647692 }

// Euler's number and logarithms
fn e() -> f64 { 2.71828182845904523536 }
fn ln2() -> f64 { 0.69314718055994530942 }
fn ln10() -> f64 { 2.30258509299404568402 }

// Square roots
fn sqrt2() -> f64 { 1.41421356237309504880 }
fn sqrt3() -> f64 { 1.73205080756887729353 }

// Golden ratio and related algebraic constants
fn golden_ratio() -> f64 { 1.61803398874989484820 }
fn plastic() -> f64 { 1.32471795724474602596 }

// Euler-Mascheroni
fn euler_gamma() -> f64 { 0.57721566490153286061 }

// Number-theoretic constants
fn catalan() -> f64 { 0.91596559417721901505 }
fn apery() -> f64 { 1.20205690315959428540 }
fn khinchin() -> f64 { 2.68545200106530644531 }
fn glaisher() -> f64 { 1.28242712910062263688 }

// Chaos and dynamical systems
fn feigenbaum_delta() -> f64 { 4.66920160910299067185 }
fn feigenbaum_alpha() -> f64 { 2.50290787509589282228 }

// Analysis constants
fn omega() -> f64 { 0.56714329040978387300 }

// Machine constants (IEEE 754 f64)
fn machine_eps() -> f64 { 2.2204460492503131e-16 }

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== Math Constants Tests ===")
    println("")

    var passed = 0
    var failed = 0
    let tol = 1.0e-14

    // ---- Circle constants ----
    print("pi.............. ")
    if check_f64(pi(), 3.14159265358979323846, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }
    print("tau............. ")
    if check_f64(tau(), 6.28318530717958647692, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }

    // ---- Euler's number and logarithms ----
    print("e............... ")
    if check_f64(e(), 2.71828182845904523536, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }
    print("ln2............. ")
    if check_f64(ln2(), 0.69314718055994530942, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }
    print("ln10............ ")
    if check_f64(ln10(), 2.30258509299404568402, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }

    // ---- Square roots ----
    print("sqrt2........... ")
    if check_f64(sqrt2(), 1.41421356237309504880, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }
    print("sqrt3........... ")
    if check_f64(sqrt3(), 1.73205080756887729353, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }

    // ---- Golden ratio and algebraic constants ----
    print("golden_ratio.... ")
    if check_f64(golden_ratio(), 1.61803398874989484820, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }
    print("plastic......... ")
    if check_f64(plastic(), 1.32471795724474602596, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }

    // ---- Euler-Mascheroni ----
    print("euler_gamma..... ")
    if check_f64(euler_gamma(), 0.57721566490153286061, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }

    // ---- Number-theoretic constants ----
    print("catalan......... ")
    if check_f64(catalan(), 0.91596559417721901505, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }
    print("apery........... ")
    if check_f64(apery(), 1.20205690315959428540, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }
    print("khinchin........ ")
    if check_f64(khinchin(), 2.68545200106530644531, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }
    print("glaisher........ ")
    if check_f64(glaisher(), 1.28242712910062263688, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }

    // ---- Chaos and dynamical systems ----
    print("feigenbaum_delta ")
    if check_f64(feigenbaum_delta(), 4.66920160910299067185, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }
    print("feigenbaum_alpha ")
    if check_f64(feigenbaum_alpha(), 2.50290787509589282228, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }

    // ---- Analysis constants ----
    print("omega........... ")
    if check_f64(omega(), 0.56714329040978387300, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }

    // ---- Machine constants ----
    print("machine_eps..... ")
    if check_f64(machine_eps(), 2.2204460492503131e-16, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }

    // ---- Derived-value cross-checks ----
    print("tau_eq_2pi...... ")
    if check_f64(tau(), 2.0 * pi(), tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }

    let phi = golden_ratio()
    print("phi^2_eq_phi+1.. ")
    if check_f64(phi * phi, phi + 1.0, tol) { passed = passed + 1; println("ok") } else { failed = failed + 1; println("FAIL") }

    // ---- Summary ----
    println("")
    if failed > 0 {
        println("SOME TESTS FAILED")
        return 1
    }
    println("ALL 20 TESTS PASSED")
    return 0
}
