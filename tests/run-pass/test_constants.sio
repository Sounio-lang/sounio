//@ run-pass
// test_constants.sio — Validates stdlib/math/constants.sio to 14+ significant digits
//
// All constant functions are inlined (no imports). Each value is checked against
// its known reference to within 1.0e-14 tolerance.
//
// References:
//   OEIS (https://oeis.org)
//   DLMF (https://dlmf.nist.gov)
//   IEEE 754-2008 (machine epsilon)

// ============================================================================
// HELPERS (must precede callers — no forward refs)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn print_digit(d: i32) with IO {
    if d == 0 { print("0") }
    else { if d == 1 { print("1") }
    else { if d == 2 { print("2") }
    else { if d == 3 { print("3") }
    else { if d == 4 { print("4") }
    else { if d == 5 { print("5") }
    else { if d == 6 { print("6") }
    else { if d == 7 { print("7") }
    else { if d == 8 { print("8") }
    else { if d == 9 { print("9") }
    }}}}}}}}}
}

fn print_i32_unsigned(x: i32) with IO, Div {
    if x == 0 { return }
    let rest = x / 10
    if rest > 0 { print_i32_unsigned(rest) }
    let digit = x % 10
    print_digit(digit)
}

fn print_i32(x: i32) with IO, Div {
    if x == 0 { print("0"); return }
    if x < 0 { print("-"); print_i32_unsigned(0 - x) }
    else { print_i32_unsigned(x) }
}

fn check(name: string, got: f64, expected: f64, tol: f64, pass: &!i32, fail: &!i32) with IO {
    let diff = abs_f64(got - expected)
    if diff < tol {
        *pass = *pass + 1
    } else {
        print("  FAIL: ")
        print(name)
        print(" diff=")
        println(diff)
        *fail = *fail + 1
    }
}

// ============================================================================
// INLINED CONSTANT FUNCTIONS (from stdlib/math/constants.sio)
// ============================================================================

// Circle constants
fn pi() -> f64 { 3.14159265358979323846 }
fn tau() -> f64 { 6.28318530717958647692 }

// Euler's number and logarithms
fn e() -> f64 { 2.71828182845904523536 }
fn ln2() -> f64 { 0.69314718055994530942 }
fn ln10() -> f64 { 2.30258509299404568402 }

// Square roots
fn sqrt2() -> f64 { 1.41421356237309504880 }
fn sqrt3() -> f64 { 1.73205080756887729353 }

// Golden ratio and related algebraic constants
fn golden_ratio() -> f64 { 1.61803398874989484820 }
fn plastic() -> f64 { 1.32471795724474602596 }

// Euler-Mascheroni
fn euler_gamma() -> f64 { 0.57721566490153286061 }

// Number-theoretic constants
fn catalan() -> f64 { 0.91596559417721901505 }
fn apery() -> f64 { 1.20205690315959428540 }
fn khinchin() -> f64 { 2.68545200106530644531 }
fn glaisher() -> f64 { 1.28242712910062263688 }

// Chaos and dynamical systems
fn feigenbaum_delta() -> f64 { 4.66920160910299067185 }
fn feigenbaum_alpha() -> f64 { 2.50290787509589282228 }

// Analysis constants
fn omega() -> f64 { 0.56714329040978387300 }

// Machine constants (IEEE 754 f64)
fn machine_eps() -> f64 { 2.2204460492503131e-16 }

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== Math Constants Tests ===")
    println("")

    var pass = 0
    var fail = 0
    let tol = 1.0e-14

    // ---- Circle constants ----
    check("pi",  pi(),  3.14159265358979323846, tol, &!pass, &!fail)
    check("tau", tau(), 6.28318530717958647692, tol, &!pass, &!fail)

    // ---- Euler's number and logarithms ----
    check("e",    e(),    2.71828182845904523536, tol, &!pass, &!fail)
    check("ln2",  ln2(),  0.69314718055994530942, tol, &!pass, &!fail)
    check("ln10", ln10(), 2.30258509299404568402, tol, &!pass, &!fail)

    // ---- Square roots ----
    check("sqrt2", sqrt2(), 1.41421356237309504880, tol, &!pass, &!fail)
    check("sqrt3", sqrt3(), 1.73205080756887729353, tol, &!pass, &!fail)

    // ---- Golden ratio and algebraic constants ----
    check("golden_ratio", golden_ratio(), 1.61803398874989484820, tol, &!pass, &!fail)
    check("plastic",      plastic(),      1.32471795724474602596, tol, &!pass, &!fail)

    // ---- Euler-Mascheroni ----
    check("euler_gamma", euler_gamma(), 0.57721566490153286061, tol, &!pass, &!fail)

    // ---- Number-theoretic constants ----
    check("catalan",  catalan(),  0.91596559417721901505, tol, &!pass, &!fail)
    check("apery",    apery(),    1.20205690315959428540, tol, &!pass, &!fail)
    check("khinchin", khinchin(), 2.68545200106530644531, tol, &!pass, &!fail)
    check("glaisher", glaisher(), 1.28242712910062263688, tol, &!pass, &!fail)

    // ---- Chaos and dynamical systems ----
    check("feigenbaum_delta", feigenbaum_delta(), 4.66920160910299067185, tol, &!pass, &!fail)
    check("feigenbaum_alpha", feigenbaum_alpha(), 2.50290787509589282228, tol, &!pass, &!fail)

    // ---- Analysis constants ----
    check("omega", omega(), 0.56714329040978387300, tol, &!pass, &!fail)

    // ---- Machine constants ----
    check("machine_eps", machine_eps(), 2.2204460492503131e-16, tol, &!pass, &!fail)

    // ---- Derived-value cross-checks ----
    // tau == 2 * pi
    check("tau_eq_2pi", tau(), 2.0 * pi(), tol, &!pass, &!fail)

    // golden_ratio == (1 + sqrt(5)) / 2, verify via phi^2 == phi + 1
    let phi = golden_ratio()
    check("phi^2_eq_phi+1", phi * phi, phi + 1.0, tol, &!pass, &!fail)

    // ---- Summary ----
    let total = pass + fail
    println("")

    if fail == 0 {
        print("ALL ")
        print_i32(total)
        println(" TESTS PASSED")
        return 0
    } else {
        print("FAILED: ")
        print_i32(fail)
        print(" of ")
        print_i32(total)
        println("")
        return 1
    }
}
