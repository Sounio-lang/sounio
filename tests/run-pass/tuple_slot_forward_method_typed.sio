//@ run-pass
//@ expect-stdout: TUPLE_SLOT_FORWARD_OK
// A method that returns (Pz, St) and is defined BELOW its caller still types
// `let pair = q.stmt()` / `var stmt = pair.1`, so `stmt.expr` reads St.expr
// (index 3), not the D structs' `expr` (index 1 or 2). Madaros cleared its
// return-shape tables after the impl signatures were preseeded, so a method
// was only known once its own body had been lowered: this printed 0. The same
// shape is Parser::parse_block calling parse_stmt (#2966).

struct D1 { kind: i64, expr: i64 }
struct D2 { a: i64, b: i64, expr: i64 }
struct St { kind: i64, span: i64, name: i64, expr: i64 }
struct Pz { pos: i64 }

impl Pz {
    fn blk(self) -> i64 with Mut, Alloc, Div {
        var acc: i64 = 0
        var q = self
        var i: i64 = 0
        while i < 2 {
            let pair = q.stmt()
            q = pair.0
            var stmt = pair.1
            acc = acc * 100 + stmt.expr
            i = i + 1
        }
        acc
    }

    fn stmt(self) -> (Pz, St) with Mut, Alloc {
        (Pz { pos: self.pos + 1 }, St { kind: 1, span: 2, name: 3, expr: 40 + self.pos })
    }
}

fn main() -> i32 with IO, Mut, Div, Alloc, Panic {
    let a = D1 { kind: 1, expr: 2 }
    let b = D2 { a: 1, b: 2, expr: 3 }
    let p = Pz { pos: 0 }
    let r = p.blk() + a.expr + b.expr - 5
    if r != 4041 {
        println(r)
        return 1
    }
    println("TUPLE_SLOT_FORWARD_OK")
    return 0
}
