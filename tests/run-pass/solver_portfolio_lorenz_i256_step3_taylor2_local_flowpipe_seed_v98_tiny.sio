//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v98 smoke for Lorenz i256 step-3 Taylor-2 local flowpipe seed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1609
    receipt_fp = mix(receipt_fp, 389654052, 5483)
    receipt_fp = mix(receipt_fp, 790630993, 5483)
    receipt_fp = mix(receipt_fp, 95709658, 5483)
    receipt_fp = mix(receipt_fp, 663928611, 5483)
    receipt_fp = mix(receipt_fp, 2491648, 5483)
    receipt_fp = mix(receipt_fp, 252932879, 5483)
    receipt_fp = mix(receipt_fp, 579271506, 5483)
    receipt_fp = mix(receipt_fp, 755389732, 5483)
    receipt_fp = mix(receipt_fp, 449592233, 5483)
    receipt_fp = mix(receipt_fp, 249889958, 5483)
    receipt_fp = mix(receipt_fp, 3, 5483)
    receipt_fp = mix(receipt_fp, 18, 5483)
    receipt_fp = mix(receipt_fp, 255, 5483)
    if receipt_fp != 9964953 { return 1 }

    var audit_fp: i64 = 1613
    audit_fp = mix(audit_fp, receipt_fp, 5501)
    audit_fp = mix(audit_fp, 389654052, 5501)
    audit_fp = mix(audit_fp, 790630993, 5501)
    audit_fp = mix(audit_fp, 494170390, 5501)
    audit_fp = mix(audit_fp, 781321526, 5501)
    audit_fp = mix(audit_fp, 660429472, 5501)
    audit_fp = mix(audit_fp, 449592233, 5501)
    audit_fp = mix(audit_fp, 579271506, 5501)
    audit_fp = mix(audit_fp, 755389732, 5501)
    audit_fp = mix(audit_fp, 252932879, 5501)
    audit_fp = mix(audit_fp, 2491648, 5501)
    audit_fp = mix(audit_fp, 3, 5501)
    audit_fp = mix(audit_fp, 18, 5501)
    audit_fp = mix(audit_fp, 255, 5501)
    if audit_fp != 847302474 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 101, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 101, 1103)
    if entry_fp != 904983474 { return 3 }

    let manifest_fp: i64 = 142673235
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 98, 1871)
    result_fp = mix(result_fp, 102, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 90, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 358056499 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 98, 1907)
    family_fp = mix(family_fp, 102, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 85, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 899567414 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 98, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 346679172 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 98, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 122829650 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 98, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
