//@ run-pass

// ---------------------------------------------------------------------------
// Number theory test suite — all helpers inlined, no imports
// ---------------------------------------------------------------------------

// --- Checker helpers (must precede callers) ---------------------------------

fn check_i64(got: i64, expected: i64, pass: &!i32, fail: &!i32) with IO, Mut {
    if got == expected {
        *pass = *pass + 1
    } else {
        *fail = *fail + 1
    }
}

fn check_bool(got: bool, expected: bool, pass: &!i32, fail: &!i32) with IO, Mut {
    if got == expected {
        *pass = *pass + 1
    } else {
        *fail = *fail + 1
    }
}

// --- Number theory functions ------------------------------------------------

fn gcd(a: i64, b: i64) -> i64 with Div, Mut, Panic {
    var x = a
    var y = b
    while y != 0 {
        var t = y
        y = x % y
        x = t
    }
    x
}

fn lcm(a: i64, b: i64) -> i64 with Div, Mut, Panic {
    let d = gcd(a, b)
    (a / d) * b
}

fn mod_pow(base: i64, exp: i64, modulus: i64) -> i64 with Div, Mut, Panic {
    var result: i64 = 1
    var b = base % modulus
    var e = exp
    while e > 0 {
        if e % 2 == 1 {
            result = (result * b) % modulus
        }
        e = e / 2
        b = (b * b) % modulus
    }
    result
}

fn is_prime_trial(n: i64) -> bool with Div, Mut, Panic {
    if n < 2 {
        return false
    }
    if n < 4 {
        return true
    }
    if n % 2 == 0 {
        return false
    }
    var i: i64 = 3
    while i * i <= n {
        if n % i == 0 {
            return false
        }
        i = i + 2
    }
    true
}

fn fibonacci_fast(n: i64) -> i64 {
    // Fast doubling: F(2k) = F(k)[2F(k+1) - F(k)]
    //                F(2k+1) = F(k)^2 + F(k+1)^2
    if n < 0 {
        return 0
    }
    var a: i64 = 0
    var b: i64 = 1
    var bit: i64 = 1
    // Find highest bit in n
    while bit <= n {
        bit = bit * 2
    }
    bit = bit / 2
    while bit > 0 {
        // Doubling step
        var d = a * (b * 2 - a)
        var e = a * a + b * b
        a = d
        b = e
        if (n / bit) % 2 == 1 {
            var c = a + b
            a = b
            b = c
        }
        bit = bit / 2
    }
    a
}

fn integer_sqrt(n: i64) -> i64 with Div, Mut, Panic {
    if n < 0 {
        return 0
    }
    if n == 0 {
        return 0
    }
    var x = n
    var y = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    x
}

fn euler_totient(n: i64) -> i64 with Div, Mut, Panic {
    if n <= 1 {
        return 1
    }
    var result = n
    var m = n
    var p: i64 = 2
    while p * p <= m {
        if m % p == 0 {
            while m % p == 0 {
                m = m / p
            }
            result = result - result / p
        }
        p = p + 1
    }
    if m > 1 {
        result = result - result / m
    }
    result
}

fn jacobi_symbol(a: i64, n: i64) -> i64 with Div, Mut, Panic {
    // Assumes n is odd and positive
    if n == 1 {
        return 1
    }
    var aa = a % n
    if aa < 0 {
        aa = aa + n
    }
    var nn = n
    var result: i64 = 1
    while aa != 0 {
        // Factor out powers of 2 from aa
        while aa % 2 == 0 {
            aa = aa / 2
            let r = nn % 8
            if r == 3 {
                result = 0 - result
            }
            if r == 5 {
                result = 0 - result
            }
        }
        // Quadratic reciprocity: swap aa and nn
        var tmp = aa
        aa = nn
        nn = tmp
        if aa % 4 == 3 {
            if nn % 4 == 3 {
                result = 0 - result
            }
        }
        aa = aa % nn
    }
    if nn == 1 {
        result
    } else {
        0
    }
}

// --- Main -------------------------------------------------------------------

fn main() -> i32 with IO, Mut, Panic, Div {
    var pass = 0
    var fail = 0

    // 1. gcd(12, 8) = 4
    check_i64(gcd(12, 8), 4, &!pass, &!fail)
    // 2. gcd(100, 75) = 25
    check_i64(gcd(100, 75), 25, &!pass, &!fail)
    // 3. gcd(17, 13) = 1  (coprime)
    check_i64(gcd(17, 13), 1, &!pass, &!fail)
    // 4. lcm(12, 8) = 24
    check_i64(lcm(12, 8), 24, &!pass, &!fail)
    // 5. lcm(7, 5) = 35
    check_i64(lcm(7, 5), 35, &!pass, &!fail)
    // 6. mod_pow(2, 10, 1000) = 1024
    check_i64(mod_pow(2, 10, 1000), 24, &!pass, &!fail)
    // 7. mod_pow(3, 13, 1000000007) = 1594323
    check_i64(mod_pow(3, 13, 1000000007), 1594323, &!pass, &!fail)
    // 8. is_prime_trial(2) = true
    check_bool(is_prime_trial(2), true, &!pass, &!fail)
    // 9. is_prime_trial(997) = true
    check_bool(is_prime_trial(997), true, &!pass, &!fail)
    // 10. is_prime_trial(1) = false
    check_bool(is_prime_trial(1), false, &!pass, &!fail)
    // 11. is_prime_trial(561) = false  (Carmichael number)
    check_bool(is_prime_trial(561), false, &!pass, &!fail)
    // 12. fibonacci(0) = 0
    check_i64(fibonacci_fast(0), 0, &!pass, &!fail)
    // 13. fibonacci(1) = 1
    check_i64(fibonacci_fast(1), 1, &!pass, &!fail)
    // 14. fibonacci(10) = 55
    check_i64(fibonacci_fast(10), 55, &!pass, &!fail)
    // 15. fibonacci(20) = 6765
    check_i64(fibonacci_fast(20), 6765, &!pass, &!fail)
    // 16. integer_sqrt(100) = 10
    check_i64(integer_sqrt(100), 10, &!pass, &!fail)
    // 17. integer_sqrt(99) = 9
    check_i64(integer_sqrt(99), 9, &!pass, &!fail)
    // 18. euler_totient(12) = 4
    check_i64(euler_totient(12), 4, &!pass, &!fail)
    // 19. euler_totient(1) = 1
    check_i64(euler_totient(1), 1, &!pass, &!fail)
    // 20. jacobi_symbol(2, 7) = 1
    check_i64(jacobi_symbol(2, 7), 1, &!pass, &!fail)

    if fail > 0 {
        return 1
    }
    0
}
