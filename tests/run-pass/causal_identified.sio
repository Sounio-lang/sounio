//@ run-pass
//@ description: Causal inference with Audit trail is permitted

fn observe_data() -> f64 with Observe, IO {
    42.0
}

fn causal_estimate() -> f64 with Causal, Observe, Audit, IO {
    let y = observe_data()
    y * 2.0
}

fn main() -> i64 with IO, Causal, Observe, Audit {
    let r = causal_estimate()
    println(r)
    0
}
