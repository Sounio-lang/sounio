//@ run-pass
//@ description: Imported Lorenz i256 bounded two-step trajectory bridge smoke

use systems::lorenz_i256_xyz_step_bounded_bridge::*
use systems::lorenz_i256_trajectory2_bounded_bridge::*

fn main() -> i64 with Div {
    let final_state = lorenz_i256_trajectory2_bounded_check(
        500000000, 0, 0, 0, 625000000, 1, 0, 0, 375000000, 0, 0, 0,
        375000000, 32, 0, 0, 796875000, 326, 0, 0, 984375000, 161, 0, 0)
    if final_state != 1 { return 1 }

    let step1_x = lorenz_i256_trajectory2_bounded_limb(
        500000000, 0, 0, 0, 625000000, 1, 0, 0, 375000000, 0, 0, 0, 1, 0, 1)
    if step1_x != 11 { return 2 }

    let step1_y0 = lorenz_i256_trajectory2_bounded_limb(
        500000000, 0, 0, 0, 625000000, 1, 0, 0, 375000000, 0, 0, 0, 1, 1, 0)
    if step1_y0 != 812500000 { return 3 }

    let step1_z0 = lorenz_i256_trajectory2_bounded_limb(
        500000000, 0, 0, 0, 625000000, 1, 0, 0, 375000000, 0, 0, 0, 1, 2, 0)
    if step1_z0 != 187500000 { return 4 }

    let rejection = lorenz_i256_trajectory2_bounded_limb(
        500000000, 0, 0, 0, 0, 0, 0, 0, 375000000, 0, 0, 0, 2, 0, 0)
    if rejection != 0 - 1 { return 5 }

    let xyz_anchor = lorenz_i256_xyz_step_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 115)
    if xyz_anchor != 701846329 { return 6 }

    let xyz_audit = lorenz_i256_xyz_step_bounded_bridge_audit_fingerprint(
        xyz_anchor, 538104672, 916470253, 645218970, 184760392,
        286140975, 653928410, 902461738, 317604925, 1, 1, 1, 1,
        256, 1000000000, 0, 0, 0, 0, 115, 2047)
    if xyz_audit != 263917508 { return 7 }

    let artifact = lorenz_i256_trajectory2_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 116)
    if artifact != 812457306 { return 8 }

    let audit = lorenz_i256_trajectory2_bounded_bridge_audit_fingerprint(
        artifact, 690314528, 237861904, xyz_anchor, xyz_audit,
        1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 116, 2047)
    if audit != 459028173 { return 9 }
    return 0
}
