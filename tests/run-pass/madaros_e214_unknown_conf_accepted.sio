//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: E214_UNKNOWN_CONF_ACCEPTED
// #3601: a value whose confidence the checker cannot determine (returned by a user
// function) is accepted, as documented; this control pins that behaviour.
fn passthrough(x: f64) -> f64 { return x }
fn safe_dose(w: f64) -> f64 with Mut, Epistemic(950) {
    return w * 2.0
}
fn main() with IO, Mut, Epistemic {
    let k: Knowledge<f64> = measure(10.0, uncertainty: 5.0)
    let w = passthrough(k.value)
    let d = safe_dose(w)
    print("d="); println(d)
    println("E214_UNKNOWN_CONF_ACCEPTED")
}
