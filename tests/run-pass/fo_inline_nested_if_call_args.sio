//@ run-pass
//@ requires: madaros
//@ expect-stdout: FO_INLINE_NESTED_IF_CALL_ARGS_OK
// Discriminator for the gen2 wall on orbit_is_contested:
// FO variance re-lowers a pure f64 helper whose arguments are themselves
// runtime-if helpers. An ident miss in that speculative re-lower must not
// refuse ELF publication (#2956 latch). Value path is the call, not FO.

fn boundary_eps(norm: f64, radius: f64) -> f64 {
    let lower = 0.8 * radius
    if norm < lower {
        0.0
    } else if norm > radius {
        0.0
    } else {
        1.0
    }
}

fn zd_eps(proximity: f64) -> f64 {
    if proximity > 0.1 {
        0.0
    } else if proximity < 1e-10 {
        1.0
    } else {
        1.0 - proximity / 0.1
    }
}

fn combined_eps(boundary: f64, zd: f64) -> f64 with Mut, Div {
    let combined_sq = boundary * boundary + zd * zd
    if combined_sq <= 0.0 { return 0.0 }
    var y = combined_sq
    y = 0.5 * (y + combined_sq / y)
    y = 0.5 * (y + combined_sq / y)
    if y > 1.0 { 1.0 } else { y }
}

fn is_contested(norm: f64, radius: f64, proximity: f64) -> i64 with Mut, Div {
    let eps = combined_eps(
        boundary_eps(norm, radius),
        zd_eps(proximity)
    )
    if eps > 0.01 { 1 } else { 0 }
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let bounded = is_contested(0.1, 2.0, 1.0)
    let on_boundary = is_contested(1.8, 2.0, 1.0)
    let near_z = is_contested(0.1, 2.0, 1e-12)
    if bounded == 0 && on_boundary == 1 && near_z == 1 {
        print("FO_INLINE_NESTED_IF_CALL_ARGS_OK\n")
        return 0
    }
    print("FO_INLINE_NESTED_IF_CALL_ARGS_FAIL\n")
    1
}
