//@ run-pass
// Phase 4c-prep: &seq[i] single-element borrow on a LOCAL Seq variable. For a Seq
// of struct elements (stored as heap pointers to materialized copies), &seq[i]
// yields a reference to the element — the access pattern the ontology uses, e.g.
// iri_equals(&local_seq[i], x).
//
// NOTE (deferred to P4c): borrow of a FIELD Seq element — &obj.field[i], which the
// ontology's iri_equals(&class.superclasses[i], ...) needs — is NOT yet supported
// (field-access + subscript + borrow combined). Bare-var &seq[i] is the foundation.
struct IRI { id: i64, ns: i64, local: i64 }
fn eq(a: &IRI, b: &IRI) -> bool { a.id == b.id }
fn main() -> i32 with IO, Mut, Panic, Epistemic {
    var v: Seq<IRI> = seq_new()
    v.push(IRI { id: 7, ns: 1, local: 2 })
    v.push(IRI { id: 9, ns: 3, local: 4 })
    let target = IRI { id: 9, ns: 0, local: 0 }
    if eq(&v[0], &target) { return 1 }     // 7 != 9
    if !eq(&v[1], &target) { return 2 }    // 9 == 9
    return 0
}
