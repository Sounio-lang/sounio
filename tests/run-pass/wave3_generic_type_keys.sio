//@ run-pass
//@ requires: madaros
//@ expect-stdout: GENERIC_TYPE_KEYS_OK
use parser::ast::*;
use parser::parser::{dummy_type_expr}
use compiler::module_parse::{load_module_file}
use check::specializer::{spec_type_identity_key}
fn parameter_type(p:&Program,index:i64)->TypeExpr with Mut,Alloc,Div,Panic {
    var list=p.items
    var i:i64=0
    while true {
        match list {
            Some(item)=>{
                if i==index {
                    match (*item).head.fn_def {
                        Some(fd)=>{match (*fd).params {Some(param)=>return (*param).head.ty,None=>{}}}
                        None=>{}
                    }
                    return dummy_type_expr()
                }
                i=i+1
                list=(*item).tail
            }
            None=>return dummy_type_expr()
        }
    }
    dummy_type_expr()
}
fn main()->i32 with IO,Mut,Alloc,Div,Panic {
    let p=load_module_file("tests/fixtures/wave3_generic_enum/type_keys.sio")
    var keys:[Name;18]=[make_name("");18]
    var i:i64=0
    while i<18 {
        keys[i as usize]=spec_type_identity_key(parameter_type(&p,i))
        assert(keys[i as usize].len>0)
        var j:i64=0
        while j<i {
            let equal=name_eq(keys[i as usize],keys[j as usize])
            if i==14 && j==13 {assert(equal)} else {assert(!equal)}
            j=j+1
        }
        i=i+1
    }
    var unknown=dummy_type_expr()
    unknown.kind=TypeExprKind::TypeInfer
    assert(spec_type_identity_key(unknown).len==0)
    var missing_inner=dummy_type_expr()
    missing_inner.kind=TypeExprKind::TypeReference
    missing_inner.inner=None
    assert(spec_type_identity_key(missing_inner).len==0)
    println("GENERIC_TYPE_KEYS_OK")
    0
}
