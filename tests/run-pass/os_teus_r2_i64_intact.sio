//@ run-pass
// R2 non-regression: i64 arithmetic must remain untouched. 2000000000 + 2000000000
// on i64 stays 4000000000 (no mask, no wrap).

fn main() with IO, Div, Panic {
    let x: i64 = 2000000000 + 2000000000
    if x == 4000000000 {
        print("r2_i64_intact: PASS\n")
    } else {
        print("r2_i64_intact: FAIL got=")
        print_int(x)
        print("\n")
    }
}
