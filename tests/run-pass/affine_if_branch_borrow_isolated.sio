//@ run-pass
//@ requires: madaros

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 with Panic {
    let permit = Permit { id: 193 }
    let observed = if true {
        let borrowed = &permit
        (*borrowed).id
    } else {
        0
    }
    let consumed = spend(permit)
    assert(observed == 193)
    assert(consumed == 193)
    0
}
