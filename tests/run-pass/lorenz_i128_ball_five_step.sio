//@ run-pass
//@ requires: madaros
//@ description: Lorenz fifth fixed-point ball transition with i128 centers

fn main() -> i64 {
    let scale: i128 = 1000000 as i128
    let dt: i128 = 10000 as i128
    let sigma: i128 = 10 as i128
    let rho: i128 = 28 as i128
    let beta_num: i128 = 8 as i128
    let beta_den: i128 = 3 as i128

    // Input is the step-4 ball certified by lorenz_i128_ball_four_step.sio.
    let x4: i128 = 1145612 as i128
    let y4: i128 = 2052652 as i128
    let z4: i128 = 952975 as i128
    let xr4: i64 = 25
    let yr4: i64 = 28
    let zr4: i64 = 14

    let dx4: i128 = sigma * (y4 - x4)
    let dy4: i128 = (x4 * ((rho * scale) - z4)) / scale - y4
    let dz4: i128 = (x4 * y4) / scale - (beta_num * z4) / beta_den
    let x5: i128 = x4 + (dt * dx4) / scale
    let y5: i128 = y4 + (dt * dy4) / scale
    let zdrop4: i128 = (dt * ((0 as i128) - dz4)) / scale
    let z5: i128 = z4 - zdrop4

    let dxr4: i64 = 10 * (yr4 + xr4)
    let x_rhoz_r4: i64 = ((1145612 * zr4) + (27047025 * xr4) + (xr4 * zr4)) / 1000000 + 1
    let dyr4: i64 = x_rhoz_r4 + yr4
    let xyr4: i64 = ((1145612 * yr4) + (2052652 * xr4) + (xr4 * yr4)) / 1000000 + 1
    let beta_zr4: i64 = ((8 * zr4) + 2) / 3
    let dzr4: i64 = xyr4 + beta_zr4
    let xr5: i64 = xr4 + (10000 * dxr4) / 1000000 + 1
    let yr5: i64 = yr4 + (10000 * dyr4) / 1000000 + 1
    let zr5: i64 = zr4 + (10000 * dzr4) / 1000000 + 1

    if dx4 != (9070400 as i128) { return 1 }
    if dy4 != (28932744 as i128) { return 2 }
    if dz4 != ((0 as i128) - (189724 as i128)) { return 3 }
    if x5 != (1236316 as i128) { return 4 }
    if y5 != (2341979 as i128) { return 5 }
    if z5 != (951078 as i128) { return 6 }

    if dxr4 != 530 { return 7 }
    if dyr4 != 721 { return 8 }
    if dzr4 != 122 { return 9 }
    if xr5 != 31 { return 10 }
    if yr5 != 36 { return 11 }
    if zr5 != 16 { return 12 }

    return 0
}
