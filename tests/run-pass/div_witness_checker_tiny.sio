//@ run-pass
//@ requires: madaros
//@ description: Self-contained quotient/remainder witness checker smoke

fn div_witness_check_i64(numerator: i64, denominator: i64,
                         quotient: i64, remainder: i64) -> i64 {
    if denominator <= 0 { return 0 }
    if quotient < 0 { return 0 }
    if remainder < 0 { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn div_witness_check_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn div_witness_all3(ok0: i64, ok1: i64, ok2: i64) -> i64 {
    if ok0 != 1 { return 0 }
    if ok1 != 1 { return 0 }
    if ok2 != 1 { return 0 }
    return 1
}

fn div_witness_pack3_fingerprint(tag: i64,
                                 q0: i64, r0: i64,
                                 q1: i64, r1: i64,
                                 q2: i64, r2: i64,
                                 ok0: i64, ok1: i64, ok2: i64) -> i64 with Mod {
    if tag <= 0 { return 0 - 1 }
    if div_witness_all3(ok0, ok1, ok2) == 0 { return 0 - 1 }

    var fp: i64 = 211
    fp = ((fp * 16777619) + tag + 1601) % 1000000007
    fp = ((fp * 16777619) + q0 + 1601) % 1000000007
    fp = ((fp * 16777619) + r0 + 1601) % 1000000007
    fp = ((fp * 16777619) + q1 + 1601) % 1000000007
    fp = ((fp * 16777619) + r1 + 1601) % 1000000007
    fp = ((fp * 16777619) + q2 + 1601) % 1000000007
    fp = ((fp * 16777619) + r2 + 1601) % 1000000007
    fp = ((fp * 16777619) + ok0 + 1601) % 1000000007
    fp = ((fp * 16777619) + ok1 + 1601) % 1000000007
    fp = ((fp * 16777619) + ok2 + 1601) % 1000000007
    return fp
}

fn main() -> i64 with Mod {
    let scale: i256 = 4294967296 as i256
    let dt_q: i256 = 42949672 as i256
    let dt_r: i256 = 96 as i256
    let z3: i256 = 4120687759 as i256
    let beta_num_z: i256 = (8 as i256) * z3
    let beta_q: i256 = 10988500690 as i256
    let beta_r: i256 = 2 as i256
    let dx_num: i256 = 30260839900 as i256
    let x_inc_q: i256 = 302608392 as i256
    let x_inc_r: i256 = 1014364768 as i256

    let dt_ok = div_witness_check_i256(scale, 100 as i256, dt_q, dt_r)
    let beta_ok = div_witness_check_i256(beta_num_z, 3 as i256, beta_q, beta_r)
    let x_inc_ok = div_witness_check_i256(dt_q * dx_num, scale, x_inc_q, x_inc_r)
    let i256_bundle = div_witness_pack3_fingerprint(
        32, 42949672, 96, 10988500690, 2, 302608392, 1014364768,
        dt_ok, beta_ok, x_inc_ok)

    let i64_ok0 = div_witness_check_i64(100, 7, 14, 2)
    let i64_ok1 = div_witness_check_i64(100, 11, 9, 1)
    let i64_ok2 = div_witness_check_i64(1000, 8, 125, 0)
    let i64_bundle = div_witness_pack3_fingerprint(
        64, 14, 2, 9, 1, 125, 0, i64_ok0, i64_ok1, i64_ok2)

    if dt_ok != 1 { return 1 }
    if beta_ok != 1 { return 2 }
    if x_inc_ok != 1 { return 3 }
    if i256_bundle != 813457414 { return 4 }
    if i64_bundle != 963466398 { return 5 }

    if div_witness_check_i256(beta_num_z, 3 as i256, beta_q, 3 as i256) != 0 { return 6 }
    if div_witness_check_i256(beta_num_z, 3 as i256, beta_q + (1 as i256), beta_r) != 0 { return 7 }
    if div_witness_check_i256(beta_num_z, 0 as i256, beta_q, beta_r) != 0 { return 8 }
    if div_witness_check_i64(100, 7, 14, 7) != 0 { return 9 }
    if div_witness_pack3_fingerprint(
        32, 42949672, 96, 10988500690, 2, 302608392, 1014364768,
        dt_ok, 0, x_inc_ok) != (0 - 1) { return 10 }

    return 0
}
