//@ run-pass
//@ requires: madaros
//@ expect-stdout: epistemic ontology covariance OK
// Verify that Knowledge<SubClass> is accepted where Knowledge<SuperClass> is expected,
// preserving nominal ontology covariance across epistemic wrappers.

ontology ChemicalOntology {
    class Chemical
    class CHEBI_25806 subclass_of Chemical
    class CHEBI_15377 subclass_of CHEBI_25806
    class ChEBI_0036060 subclass_of CHEBI_15377
    class CHEBI_18248 subclass_of Chemical
}

fn receber_agua(w: Knowledge<CHEBI_15377>) -> i32 {
    1
}

fn test_positive() -> i32 {
    let sub_w: Knowledge<ChEBI_0036060> = measure(0 as ChEBI_0036060, uncertainty: 0.1)
    receber_agua(sub_w)
}

fn main() -> i32 {
    let r = test_positive()
    if r == 1 {
        print("epistemic ontology covariance OK\n")
        return 0
    }
    1
}
