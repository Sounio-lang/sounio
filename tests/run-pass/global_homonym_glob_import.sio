//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: GLOB_OK 7 9 1
//
// Module-qualified identity must not break a glob import of a private global.
// The glob-imported leaf keeps its shared name (this module reads it as GK2);
// the other module's private GK2 is renamed and keeps its own value. Measured on
// the first version of the rename (#3743 @ 5799e71dcb): a glob importer was not
// recognised, and the compiler's own `use parser::ast::*` reach of the private
// VISIBILITY_* constants refused the SCO decoder probe.
use fixtures::glob_private_global_leaf::*
use fixtures::glob_private_global_other::{other_gk2}

fn main() -> i64 with IO {
    print("GLOB_OK "); print_int(GK2); print(" "); print_int(other_gk2()); print(" "); print_int(leaf_tag()); print("\n")
    0
}
