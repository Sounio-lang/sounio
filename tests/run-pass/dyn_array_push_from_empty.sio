//@ run-pass
//@ requires: madaros
//@ expect-stdout: 40:0780:3:012:1:7
// SIO-311 follow-up: `.push` on a dynamic array that starts as the empty
// literal `[]`. Its backing object has zero capacity, and the growth path
// doubled that to zero, so pushes inside a loop wrote past the object and
// segfaulted (before: SIGSEGV, no output). Element values are read back,
// not just the length, so a header copied over a slot is also caught.

fn main() -> i32 with IO, Mut, Panic, Div {
    var ys: [i64] = []
    var i: i64 = 0
    while i < 40 {
        ys.push(i * 20)
        i = i + 1
    }
    print_int(ys.len())
    print(":")
    print_int(ys[0])
    print_int(ys[39])
    var sum: i64 = 0
    var k: i64 = 0
    while k < 40 {
        sum = sum + ys[k]
        k = k + 1
    }
    if sum != 15600 { return 1 }
    var zs: [i64] = []
    for j in 0..3 {
        zs.push(j)
    }
    print(":")
    print_int(zs.len())
    print(":")
    print_int(zs[0])
    print_int(zs[1])
    print_int(zs[2])
    var ws: [i64] = []
    ws.push(7)
    print(":")
    print_int(ws.len())
    print(":")
    print_int(ws[0])
    println("")
    return 0
}
