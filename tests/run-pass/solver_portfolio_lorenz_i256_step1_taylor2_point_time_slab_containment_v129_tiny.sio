//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v129 smoke for Lorenz i256 step-1 Taylor-2 point time-slab containment

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2113
    receipt_fp = mix(receipt_fp, 44353214, 6143)
    receipt_fp = mix(receipt_fp, 431845922, 6143)
    receipt_fp = mix(receipt_fp, 120130225, 6143)
    receipt_fp = mix(receipt_fp, 123836674, 6143)
    receipt_fp = mix(receipt_fp, 506855028, 6143)
    receipt_fp = mix(receipt_fp, 301347724, 6143)
    receipt_fp = mix(receipt_fp, 777254975, 6143)
    receipt_fp = mix(receipt_fp, 1, 6143)
    receipt_fp = mix(receipt_fp, 19, 6143)
    receipt_fp = mix(receipt_fp, 255, 6143)
    if receipt_fp != 972140381 { return 1 }

    var audit_fp: i64 = 2129
    audit_fp = mix(audit_fp, receipt_fp, 6151)
    audit_fp = mix(audit_fp, 44353214, 6151)
    audit_fp = mix(audit_fp, 431845922, 6151)
    audit_fp = mix(audit_fp, 824834880, 6151)
    audit_fp = mix(audit_fp, 262282451, 6151)
    audit_fp = mix(audit_fp, 301347724, 6151)
    audit_fp = mix(audit_fp, 777254975, 6151)
    audit_fp = mix(audit_fp, 506855028, 6151)
    audit_fp = mix(audit_fp, 1, 6151)
    audit_fp = mix(audit_fp, 19, 6151)
    audit_fp = mix(audit_fp, 255, 6151)
    if audit_fp != 96825760 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 132, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 132, 1103)
    if entry_fp != 311818225 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 129, 1151)
    manifest_fp = mix(manifest_fp, 133, 1151)
    manifest_fp = mix(manifest_fp, 123836674, 1151)
    manifest_fp = mix(manifest_fp, 120130225, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 706283113 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 129, 1871)
    result_fp = mix(result_fp, 133, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 121, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 775252284 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 129, 1907)
    family_fp = mix(family_fp, 133, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 116, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 831005416 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 129, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 912904205 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 129, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 945348140 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 129, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
