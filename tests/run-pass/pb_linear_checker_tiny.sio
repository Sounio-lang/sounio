//@ run-pass
//@ requires: madaros
//@ description: Tiny pseudo-Boolean scale/add proof-step checker smoke

fn pb_small_nonneg(x: i64) -> i64 {
    if x < 0 { return 0 }
    if x > 1000000000 { return 0 }
    return 1
}

fn pb_check_scale3(w0: i64, w1: i64, w2: i64, rhs: i64, factor: i64,
                   s0: i64, s1: i64, s2: i64, srhs: i64) -> i64 {
    if pb_small_nonneg(factor) == 0 { return 0 }
    if pb_small_nonneg(rhs) == 0 { return 0 }
    if pb_small_nonneg(w0) == 0 { return 0 }
    if pb_small_nonneg(w1) == 0 { return 0 }
    if pb_small_nonneg(w2) == 0 { return 0 }
    if pb_small_nonneg(s0) == 0 { return 0 }
    if pb_small_nonneg(s1) == 0 { return 0 }
    if pb_small_nonneg(s2) == 0 { return 0 }
    if pb_small_nonneg(srhs) == 0 { return 0 }

    if w0 * factor != s0 { return 0 }
    if w1 * factor != s1 { return 0 }
    if w2 * factor != s2 { return 0 }
    if rhs * factor != srhs { return 0 }
    return 1
}

fn pb_check_add_coeffs3(a0: i64, a1: i64, a2: i64,
                        b0: i64, b1: i64, b2: i64,
                        c0: i64, c1: i64, c2: i64) -> i64 {
    if pb_small_nonneg(a0) == 0 { return 0 }
    if pb_small_nonneg(a1) == 0 { return 0 }
    if pb_small_nonneg(a2) == 0 { return 0 }
    if pb_small_nonneg(b0) == 0 { return 0 }
    if pb_small_nonneg(b1) == 0 { return 0 }
    if pb_small_nonneg(b2) == 0 { return 0 }
    if pb_small_nonneg(c0) == 0 { return 0 }
    if pb_small_nonneg(c1) == 0 { return 0 }
    if pb_small_nonneg(c2) == 0 { return 0 }

    if a0 + b0 != c0 { return 0 }
    if a1 + b1 != c1 { return 0 }
    if a2 + b2 != c2 { return 0 }
    return 1
}

fn pb_check_add_rhs(arhs: i64, brhs: i64, crhs: i64) -> i64 {
    if pb_small_nonneg(arhs) == 0 { return 0 }
    if pb_small_nonneg(brhs) == 0 { return 0 }
    if pb_small_nonneg(crhs) == 0 { return 0 }
    if arhs + brhs != crhs { return 0 }
    return 1
}

fn pb_check_le_contradiction3(w0: i64, x0: i64, w1: i64, x1: i64, w2: i64, x2: i64, rhs: i64) -> i64 {
    var sum = 0
    if x0 == 1 { sum = sum + w0 }
    if x1 == 1 { sum = sum + w1 }
    if x2 == 1 { sum = sum + w2 }
    if sum > rhs { return 1 }
    return 0
}

fn main() -> i64 {
    // 2 * (2*x0 + 1*x1 + 3*x2 <= 4) = 4*x0 + 2*x1 + 6*x2 <= 8.
    if pb_check_scale3(2, 1, 3, 4, 2, 4, 2, 6, 8) != 1 { return 1 }
    if pb_check_scale3(2, 1, 3, 4, 2, 4, 2, 7, 8) != 0 { return 2 }
    if pb_check_scale3(2, 1, 3, 4, 0 - 1, 4, 2, 6, 8) != 0 { return 3 }

    // Add two <= rows:
    // (2,1,3 <= 4) + (1,4,0 <= 2) = (3,5,3 <= 6).
    if pb_check_add_coeffs3(2, 1, 3, 1, 4, 0, 3, 5, 3) != 1 { return 4 }
    if pb_check_add_rhs(4, 2, 6) != 1 { return 5 }
    if pb_check_add_coeffs3(2, 1, 3, 1, 4, 0, 3, 5, 4) != 0 { return 6 }
    if pb_check_add_coeffs3(2, 1, 3, 0 - 1, 4, 0, 1, 5, 3) != 0 { return 7 }
    if pb_check_add_rhs(4, 2, 7) != 0 { return 8 }

    // Use the added row as a checked contradiction under x0=x1=true.
    if pb_check_le_contradiction3(3, 1, 5, 1, 3, 0 - 1, 6) != 1 { return 9 }
    return 0
}
