//@ run-pass
//@ expect-stdout: VEC_ITER_OK
// Test for-in loop over struct types with .data and .len fields (e.g. IntVec, FloatVec)

use collections::vec::*

fn local_abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Panic, Div {
    // IntVec iteration
    var v = IntVec::new()
    v.push(10)
    v.push(20)
    v.push(30)
    v.push(40)

    var sum: i64 = 0
    for x in v {
        sum = sum + x
    }
    assert(sum == 100)

    // Empty IntVec — body should not execute
    var empty = IntVec::new()
    var empty_count: i64 = 0
    for x in empty {
        empty_count = empty_count + 1
    }
    assert(empty_count == 0)

    // FloatVec iteration
    var fv = FloatVec::new()
    fv.push(1.5)
    fv.push(2.5)
    fv.push(3.0)

    var fsum: f64 = 0.0
    for f in fv {
        fsum = fsum + f
    }
    // fsum = 7.0
    assert(local_abs_f64(fsum - 7.0) < 0.001)

    // Break inside for-in-vec
    var vb = IntVec::new()
    vb.push(1)
    vb.push(2)
    vb.push(99)
    vb.push(3)

    var bsum: i64 = 0
    for x in vb {
        if x == 99 { break }
        bsum = bsum + x
    }
    assert(bsum == 3)

    println("VEC_ITER_OK")
}
