//@ run-pass
//@ description: Imported SAT RUP microkernel smoke

use theorem::sat_rup_microkernel::*

fn main() -> i64 {
    let empty_rup = sat_rup3_check(1, 0, 0, 0 - 1, 2, 0, 0 - 2, 0, 0, 0, 0, 0)
    if empty_rup != 1 { return 1 }

    let wrong_formula = sat_rup3_check(1, 0, 0, 0 - 1, 2, 0, 3, 0, 0, 0, 0, 0)
    if wrong_formula != 0 { return 2 }

    let chain = sat_rup_chain_unit_then_empty_check(1, 0, 0, 0 - 1, 2, 0, 0 - 2, 0, 0, 2)
    if chain != 1 { return 3 }

    let artifact = sat_rup_microkernel_receipt_check(1, 1, 1, 0, 0, 97)
    if artifact != 715284039 { return 4 }

    let audit = sat_rup_microkernel_audit_fingerprint(
        artifact, 806157423, 129640587, 1, 1, 1, 3, 6, 0, 0, 0, 0, 97, 255)
    if audit != 304918672 { return 5 }

    let chain_artifact = sat_rup_chain_microkernel_receipt_check(
        artifact, audit, 1, 1, 1, 1, 0, 0, 98)
    if chain_artifact != 428619705 { return 6 }

    let chain_audit = sat_rup_chain_microkernel_audit_fingerprint(
        chain_artifact, audit, 572803941, 248619370, artifact, audit, 1, 1, 1,
        1, 3, 6, 0, 0, 0, 0, 98, 511)
    if chain_audit != 917264038 { return 7 }
    return 0
}
