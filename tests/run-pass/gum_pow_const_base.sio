//@ run-pass
//@ expect-stdout: GUM_POW_CONST_BASE_OK
//@ requires: madaros
// pow(c, x) with a constant base and a Knowledge exponent. The first-order
// lowering bailed out as soon as the base had no variance, so the call cleared
// the exponent's sensitivity and variance_of() read the seed value instead of
// (ln(c) * c^x * u)^2 (silently wrong, exit 0).
//   c = 2, x = 1.5, u = 0.1:  d/dx 2^x = ln(2) * 2^x
//   Var = (ln(2) * 2^1.5 * 0.1)^2 = 0.0384362411...
//   c = 3, x = 0.5, u = 0.2:  Var = (ln(3) * 3^0.5 * 0.2)^2 = 0.1448338...
// The literal-base form happened to work; a base that is not a literal (a
// module-level f64 global) took the bail and reported 0.0. Both are checked, with
// pow(x, c) as the control.

var BASE2: f64 = 2.0
var BASE3: f64 = 3.0

fn near(a: f64, b: f64) -> bool {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    var m = b
    if m < 0.0 { m = 0.0 - m }
    d <= 1.0e-9 * m + 1.0e-14
}

fn t_const_base() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(1.5, uncertainty: 0.1)
    let x = k.value
    near(variance_of(pow(2.0, x)), 0.03843624111345611)
}

fn t_const_base_3() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(0.5, uncertainty: 0.2)
    let x = k.value
    near(variance_of(pow(3.0, x)), 0.14483387529750984)
}

fn t_global_base() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(1.5, uncertainty: 0.1)
    let x = k.value
    let k2: Knowledge<f64> = measure(0.5, uncertainty: 0.2)
    let x2 = k2.value
    near(variance_of(pow(BASE2, x)), 0.03843624111345611) && near(variance_of(pow(BASE3, x2)), 0.14483387529750984)
}

fn t_const_exp() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(1.5, uncertainty: 0.1)
    let x = k.value
    near(variance_of(pow(x, 3.0)), 0.455625)
}

fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    if t_const_base() && t_const_base_3() && t_global_base() && t_const_exp() {
        print("GUM_POW_CONST_BASE_OK\n")
        return 0
    }
    print("GUM_POW_CONST_BASE_FAIL\n")
    1
}
