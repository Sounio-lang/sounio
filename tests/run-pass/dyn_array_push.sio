//@ run-pass
//@ expect-stdout: 6:13499928
// SIO-311: `.push` on a dynamic array [T] appends, growing the backing
// object past its initial capacity (before: E019 "method calls are not
// supported for this type"). The append retargets the handle-table
// entry, so the length and elements read back through the same binding
// -- including through a struct field holding the array.

struct Bag { items: [i64], tag: i64 }

fn main() -> i32 with IO, Mut {
    var xs: [i64] = [1, 2, 3]
    xs.push(4)
    xs.push(5)
    xs.push(999)
    print_int(xs.len())
    print(":")
    print_int(xs[0])
    print_int(xs[2])
    print_int(xs[3])
    print_int(xs[5])
    var b: Bag = Bag { items: [7], tag: 0 }
    b.items.push(8)
    print_int(b.items.len())
    print_int(b.items[1])
    println("")
    return 0
}
