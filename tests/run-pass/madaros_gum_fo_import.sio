//@ run-pass
//@ requires: madaros
//@ known-failure: Madaros loses FO on imported helpers; this file also calls 5-arg fo_css so it stays red until BOTH the import wall and the ≥3-arg cap close. Observed 2026-08-18: compile rc=0, run rc=1, v_imp_mul=0 v_peel_mul=0.25. Was hidden as VXFAIL in vacuous_expect_baseline. Combined pin — the XPASS detectors are gum_fo_import_boundary.sio (2-arg import) and gum_fo_arity3_boundary.sio (same-file add3).
//@ expect-stdout: MADAROS_GUM_FO_IMPORT_PASS

// Multi-mod FO: imported pure helpers from epistemic::fo must FO-transfer
// like same-module peel. Residual was A14 nested field-address of Program
// in array (&programs[i].items → Option::None); fix copies Program by value.

use epistemic::fo::{fo_mul2, fo_div2, fo_css, fo_infusion_rate, fo_clearance}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() -> i64 with IO, Mut, Div, Epistemic {
    let ka: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let kb: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    let a = ka.value
    let b = kb.value

    let v_imp_mul = variance_of(fo_mul2(a, b))
    let v_peel_mul = variance_of(a * b)
    let v_imp_div = variance_of(fo_div2(a, b))
    let v_peel_div = variance_of(a / b)

    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kTau: Knowledge<f64> = measure(12.0, uncertainty: 0.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let f = kF.value
    let dose = kDose.value
    let tau = kTau.value
    let cl0 = kCL0.value
    let eta = kEta.value

    let v_imp_css = variance_of(fo_css(f, dose, tau, cl0, eta))
    let v_peel_css = variance_of(
        fo_infusion_rate(f, dose, tau) / fo_clearance(cl0, eta)
    )

    print("v_imp_mul="); print_f64(v_imp_mul); print("\n")
    print("v_peel_mul="); print_f64(v_peel_mul); print("\n")
    print("v_imp_div="); print_f64(v_imp_div); print("\n")
    print("v_peel_div="); print_f64(v_peel_div); print("\n")
    print("v_imp_css="); print_f64(v_imp_css); print("\n")
    print("v_peel_css="); print_f64(v_peel_css); print("\n")

    let ok = abs_f(v_imp_mul - v_peel_mul) < 1.0e-9
        && abs_f(v_imp_mul - 0.25) < 1.0e-9
        && abs_f(v_imp_div - v_peel_div) < 1.0e-9
        && v_imp_div > 0.0
        && abs_f(v_imp_css - v_peel_css) < 1.0e-9
        && v_imp_css > 0.1
    if ok {
        print("MADAROS_GUM_FO_IMPORT_PASS\n")
        0
    } else {
        print("MADAROS_GUM_FO_IMPORT_FAIL\n")
        1
    }
}
