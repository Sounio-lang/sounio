//@ run-pass
//@ requires: madaros
//@ expect-stdout: TRAIT_BOUND_HEADER_OK

// A type-parameter header with several bounds (`T: A + B`) and a `const`
// parameter next to a bounded one parses into the function's declared type
// parameters; the bounded generic is instantiated through the turbofish.
trait A { fn a(self) -> i64 }
trait B { fn b(self) -> i64 }
struct S { pub v: i64 }
impl A for S { fn a(self) -> i64 { self.v } }
impl B for S { fn b(self) -> i64 { self.v * 10 } }

fn both<T: A + B>(x: T, y: T) -> i64 { x.a() + y.b() }

fn main() -> i32 with IO {
    let s = S { v: 4 }
    let t = S { v: 5 }
    let r = both::<S>(s, t)
    if r == 54 { print("TRAIT_BOUND_HEADER_OK\n") }
    return 0
}
