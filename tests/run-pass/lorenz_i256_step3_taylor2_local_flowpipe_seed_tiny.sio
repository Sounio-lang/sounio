//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-3 Taylor-2 local flowpipe seed receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn point_replay_mask() -> i64 {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256
    let x2: i256 = 4406636440 as i256
    let y2: i256 = 6517899153 as i256
    let z2: i256 = 4164877513 as i256
    let dy_scaled_q: i256 = 119112655997 as i256
    let dy_scaled_r: i256 = 796606888 as i256
    let xy_scaled_q: i256 = 6687364522 as i256
    let xy_scaled_r: i256 = 1434262808 as i256
    let beta_q: i256 = 11106340034 as i256
    let beta_r: i256 = 2 as i256
    let x_inc_q: i256 = 211126266 as i256
    let x_inc_r: i256 = 2495204624 as i256
    let y_inc_q: i256 = 1125947543 as i256
    let y_inc_r: i256 = 1173001440 as i256
    let z_drop_q: i256 = 44189754 as i256
    let z_drop_r: i256 = 568146880 as i256
    let dx_num: i256 = (10 as i256) * (y2 - x2)
    let dy_num: i256 = x2 * ((28 as i256) * scale - z2)
    let xy_num: i256 = x2 * y2
    let beta_num_z: i256 = (8 as i256) * z2
    let dy: i256 = dy_scaled_q - y2
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    var mask: i64 = 0
    if check_div_witness_i256(scale, 100 as i256, dt, 96 as i256) == 1 { mask = mask + 1 }
    if check_div_witness_i256(dy_num, scale, dy_scaled_q, dy_scaled_r) == 1 { mask = mask + 2 }
    if check_div_witness_i256(xy_num, scale, xy_scaled_q, xy_scaled_r) == 1 { mask = mask + 4 }
    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r) == 1 { mask = mask + 8 }
    if check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r) == 1 { mask = mask + 16 }
    if check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r) == 1 { mask = mask + 32 }
    if check_div_witness_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r) == 1 { mask = mask + 64 }
    return mask
}

fn instance_fp() -> i64 {
    var fp: i64 = 1583
    fp = mix(fp, 449592233, 5443)
    fp = mix(fp, 249889958, 5443)
    fp = mix(fp, 603078026, 5443)
    fp = mix(fp, 737039167, 5443)
    fp = mix(fp, 753371133, 5443)
    fp = mix(fp, 3, 5443)
    fp = mix(fp, 3, 5443)
    fp = mix(fp, 4, 5443)
    fp = mix(fp, 256, 5443)
    fp = mix(fp, 32, 5443)
    fp = mix(fp, 1, 5443)
    fp = mix(fp, 100, 5443)
    fp = mix(fp, 4406636440, 5443)
    fp = mix(fp, 6517899153, 5443)
    fp = mix(fp, 4164877513, 5443)
    fp = mix(fp, 4617762706, 5443)
    fp = mix(fp, 7643846696, 5443)
    fp = mix(fp, 4120687759, 5443)
    fp = mix(fp, 119112655997, 5443)
    fp = mix(fp, 796606888, 5443)
    fp = mix(fp, 6687364522, 5443)
    fp = mix(fp, 1434262808, 5443)
    fp = mix(fp, 11106340034, 5443)
    fp = mix(fp, 2, 5443)
    fp = mix(fp, 211126266, 5443)
    fp = mix(fp, 2495204624, 5443)
    fp = mix(fp, 1125947543, 5443)
    fp = mix(fp, 1173001440, 5443)
    fp = mix(fp, 44189754, 5443)
    fp = mix(fp, 568146880, 5443)
    fp = mix(fp, 127, 5443)
    fp = mix(fp, 7, 5443)
    fp = mix(fp, 7, 5443)
    fp = mix(fp, 3, 5443)
    fp = mix(fp, 15, 5443)
    fp = mix(fp, 0, 5443)
    fp = mix(fp, 0, 5443)
    fp = mix(fp, 22, 5443)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 319928500 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1597
    fp = mix(fp, instance, 5449)
    fp = mix(fp, 127, 5449)
    fp = mix(fp, 7, 5449)
    fp = mix(fp, 7, 5449)
    fp = mix(fp, 3, 5449)
    fp = mix(fp, 15, 5449)
    fp = mix(fp, 0, 5449)
    fp = mix(fp, 0, 5449)
    fp = mix(fp, 22, 5449)
    fp = mix(fp, ok_mask, 5449)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 319928500 { return 0 - 1 }
    if certificate != 198035376 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1601
    fp = mix(fp, instance, 5471)
    fp = mix(fp, certificate, 5471)
    fp = mix(fp, 18, 5471)
    fp = mix(fp, 3, 5471)
    fp = mix(fp, 127, 5471)
    fp = mix(fp, 15, 5471)
    fp = mix(fp, 0, 5471)
    fp = mix(fp, 0, 5471)
    fp = mix(fp, 22, 5471)
    fp = mix(fp, ok_mask, 5471)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 389654052 { return 0 - 1 }
    if instance != 319928500 { return 0 - 1 }
    if certificate != 198035376 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1607
    fp = mix(fp, artifact, 5477)
    fp = mix(fp, instance, 5477)
    fp = mix(fp, certificate, 5477)
    fp = mix(fp, 449592233, 5477)
    fp = mix(fp, 249889958, 5477)
    fp = mix(fp, 603078026, 5477)
    fp = mix(fp, 737039167, 5477)
    fp = mix(fp, 753371133, 5477)
    fp = mix(fp, 4406636440, 5477)
    fp = mix(fp, 6517899153, 5477)
    fp = mix(fp, 4164877513, 5477)
    fp = mix(fp, 4617762706, 5477)
    fp = mix(fp, 7643846696, 5477)
    fp = mix(fp, 4120687759, 5477)
    fp = mix(fp, 3, 5477)
    fp = mix(fp, 22, 5477)
    fp = mix(fp, ok_mask, 5477)
    return fp
}

fn seed_ok_mask(global_claim_mask: i64, status: i64) -> i64 {
    let replay_mask = point_replay_mask()
    let endpoint_mask: i64 = 7
    let trajectory_mask: i64 = 7
    let suffix_mask: i64 = 3
    let seed_mask: i64 = 15
    let local_proof_mask: i64 = 0

    var ok_mask: i64 = 0
    if replay_mask == 127 { ok_mask = ok_mask + 1 }
    if endpoint_mask == 7 { ok_mask = ok_mask + 2 }
    if trajectory_mask == 7 { ok_mask = ok_mask + 4 }
    if suffix_mask == 3 { ok_mask = ok_mask + 8 }
    if seed_mask == 15 { ok_mask = ok_mask + 16 }
    if global_claim_mask == 0 {
        if status == 22 { ok_mask = ok_mask + 32 }
    }
    if 3 + 1 == 4 { ok_mask = ok_mask + 64 }
    if local_proof_mask == 0 { ok_mask = ok_mask + 128 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = seed_ok_mask(0, 22)
    if ok_mask != 255 { return 1 }
    if point_replay_mask() != 127 { return 2 }
    let inst = instance_fp()
    if inst != 319928500 { return 3 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 198035376 { return 4 }
    let artifact = artifact_fp(inst, cert, ok_mask)
    if artifact != 389654052 { return 5 }
    let audit = audit_fp(artifact, inst, cert, ok_mask)
    if audit != 790630993 { return 6 }
    if seed_ok_mask(1, 22) == 255 { return 7 }
    if certificate_fp(inst, 254) != (0 - 1) { return 8 }
    return 0
}
