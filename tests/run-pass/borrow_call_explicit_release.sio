//@ run-pass
//@ known-failure: lean_single.sio borrow checker lacks call-site borrow release (check.sio boundary fixed, pending self-hosted pipeline validation)

fn read_shared(r: &i64) -> i64 {
    *r
}

fn read_exclusive(r: &!i64) -> i64 with Mut {
    *r
}

fn main() -> i32 with Mut {
    var x: i64 = 7

    // Explicit call-site borrows should be released after each call returns.
    let a = read_exclusive(&!x)
    let b = read_shared(&x)
    let c = read_exclusive(&!x)

    if a + b + c >= 0 {
        return 0
    }
    0
}
