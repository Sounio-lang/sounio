//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 proof-trace skeleton keeps replay separate from validation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 467
    fp = mix(fp, 6, 3817)
    fp = mix(fp, 641464796, 3817)
    fp = mix(fp, 222156824, 3817)
    fp = mix(fp, 134624236, 3817)
    fp = mix(fp, 237534229, 3817)
    fp = mix(fp, 516981885, 3817)
    fp = mix(fp, 652877359, 3817)
    fp = mix(fp, 1, 3817)
    fp = mix(fp, 6, 3817)
    fp = mix(fp, 4, 3817)
    fp = mix(fp, 4, 3817)
    fp = mix(fp, 15, 3817)
    fp = mix(fp, 15, 3817)
    fp = mix(fp, 0, 3817)
    fp = mix(fp, 5, 3817)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 524260857 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 479
    fp = mix(fp, instance, 3833)
    fp = mix(fp, 4, 3833)
    fp = mix(fp, 4, 3833)
    fp = mix(fp, 15, 3833)
    fp = mix(fp, 15, 3833)
    fp = mix(fp, 15, 3833)
    fp = mix(fp, 0, 3833)
    fp = mix(fp, 5, 3833)
    fp = mix(fp, ok_mask, 3833)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 524260857 { return 0 - 1 }
    if certificate != 454263207 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 487
    fp = mix(fp, instance, 3847)
    fp = mix(fp, certificate, 3847)
    fp = mix(fp, 6, 3847)
    fp = mix(fp, 6, 3847)
    fp = mix(fp, 1, 3847)
    fp = mix(fp, 6, 3847)
    fp = mix(fp, ok_mask, 3847)
    return fp
}

fn skeleton_mask() -> i64 {
    let obligation_mask: i64 = 15
    let replay_order_mask: i64 = 15
    let validated_mask: i64 = 0
    let trace_status: i64 = 5

    var ok_mask: i64 = 0
    if 641464796 > 0 {
        if 134624236 > 0 {
            if 237534229 > 0 {
                if 516981885 > 0 {
                    if 652877359 > 0 { ok_mask = ok_mask + 1 }
                }
            }
        }
    }
    if 4 == 4 {
        if obligation_mask == 15 { ok_mask = ok_mask + 2 }
    }
    if replay_order_mask == obligation_mask { ok_mask = ok_mask + 4 }
    if 15 == obligation_mask { ok_mask = ok_mask + 8 }
    if trace_status == 5 { ok_mask = ok_mask + 16 }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if 641464796 != 134624236 { ok_mask = ok_mask + 64 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = skeleton_mask()
    if ok_mask != 127 { return 1 }
    let inst = instance_fp()
    if inst != 524260857 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 454263207 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 929938975 { return 4 }
    if certificate_fp(inst, 126) != (0 - 1) { return 5 }
    return 0
}
