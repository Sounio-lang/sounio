//@ run-pass
//@ requires: madaros
//@ expect-stdout: STRUCT_LEN_DISPATCH_OK
struct LenOwner {n:i64}
impl LenOwner {
 fn len(self:&LenOwner)->i64 {self.n}
}
fn borrowed(x:&LenOwner)->i64 {x.len()}
fn array_borrowed(x:&[i64])->i64 {x.len()}
fn main()->i32 with IO,Mut,Div,Panic {
 let owner=LenOwner {n:7}
 assert(owner.len()==7)
 assert(borrowed(&owner)==7)
 let values:[i64;3]=[1,2,3]
 assert(values.len()==3)
 assert(array_borrowed(&values)==3)
 let owners:[LenOwner;2]=[LenOwner {n:7};2]
 assert(owners.len()==2)
 let text="hello"
 assert(text.len()==5)
 println("STRUCT_LEN_DISPATCH_OK")
 return 0
}

