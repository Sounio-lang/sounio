//@ run-pass
//@ description: A-layer-2 substrate — flow/map Lyapunov exponents via Benettin/QR match published values
use math::lyapunov::*

fn approx(a: f64, b: f64, e: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < e
}

fn main() -> i64 with Mut, Div, Panic {
    // Hénon map a=1.4, b=0.3 (Jacobian iteration) — published λ1 ≈ 0.41922
    let h = lyap_henon(1.4, 0.3)
    if !approx(h, 0.41922, 0.005) { return 1 }
    if !lyap_is_chaotic(h) { return 2 }

    // Lorenz σ=10, ρ=28, β=8/3 (RK4 + variational) — published λ1 ≈ 0.9056
    let lo = lyap_lorenz()
    if !approx(lo, 0.9056, 0.02) { return 3 }
    if !lyap_is_chaotic(lo) { return 4 }

    // Rössler a=b=0.2, c=5.7 (RK4 + variational) — published λ1 ≈ 0.0714 (small, sensitive)
    let ro = lyap_rossler()
    if !approx(ro, 0.0714, 0.01) { return 5 }
    if !lyap_is_chaotic(ro) { return 6 }

    0
}
