//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_INTERPROC_PASS

// Inter-procedural FO GUM via pure-fn transfer table.
// Helpers must appear before callers in the module (xfer registered at lower_fn).
// Supported pure bodies: id, lit*x, x+y, x*y, and forward g(params).

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn id(x: f64) -> f64 { x }
fn scale2(x: f64) -> f64 { 2.0 * x }
fn scale_c(x: f64, c: f64) -> f64 { c * x }
fn add_ab(x: f64, y: f64) -> f64 { x + y }
fn mul_ab(x: f64, y: f64) -> f64 { x * y }
fn nest(x: f64) -> f64 { scale2(x) }

fn main() with IO, Mut, Div, Epistemic {
    let a: Knowledge<f64> = measure(2.0, uncertainty: 0.05)
    let b: Knowledge<f64> = measure(3.0, uncertainty: 0.05)
    let av = a.value
    let bv = b.value

    let v_id = variance_of(id(av))
    let v_s2 = variance_of(scale2(av))
    let s = scale2(av)
    let v_bind = variance_of(s)
    let v_add = variance_of(add_ab(av, bv))
    let v_mul = variance_of(mul_ab(av, bv))
    let v_nest = variance_of(nest(av))
    let v_sc = variance_of(scale_c(av, 3.0))
    let v_comp = variance_of(scale2(av) + bv)

    print("id="); print_f64(v_id); print("\n")
    print("s2="); print_f64(v_s2); print("\n")
    print("bind="); print_f64(v_bind); print("\n")
    print("add="); print_f64(v_add); print("\n")
    print("mul="); print_f64(v_mul); print("\n")
    print("nest="); print_f64(v_nest); print("\n")
    print("sc="); print_f64(v_sc); print("\n")
    print("comp="); print_f64(v_comp); print("\n")

    let ok = abs_f(v_id - 0.0025) < 1.0e-9
        && abs_f(v_s2 - 0.01) < 1.0e-9
        && abs_f(v_bind - 0.01) < 1.0e-9
        && abs_f(v_add - 0.005) < 1.0e-9
        && abs_f(v_mul - 0.0325) < 1.0e-9
        && abs_f(v_nest - 0.01) < 1.0e-9
        && abs_f(v_sc - 0.0225) < 1.0e-9
        && abs_f(v_comp - 0.0125) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_INTERPROC_PASS\n")
    } else {
        print("MADAROS_GUM_FO_INTERPROC_FAIL\n")
    }
}
