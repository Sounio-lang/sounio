//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v4 smoke for SAT resolution certificate entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 8 { return 0 - 1 }
    if instance_fp != 829764719 { return 0 - 1 }
    if certificate_fp != 177576187 { return 0 - 1 }
    if result_code != 0 { return 0 - 1 }
    if checker_code != 8 { return 0 - 1 }

    var fp: i64 = 101
    fp = mix(fp, kind, 1103)
    fp = mix(fp, instance_fp, 1103)
    fp = mix(fp, certificate_fp, 1103)
    fp = mix(fp, result_code, 1103)
    fp = mix(fp, checker_code, 1103)
    return fp
}

fn portfolio_v4_fingerprint(sat_resolution_entry_fp: i64) -> i64 with Mod {
    if sat_resolution_entry_fp != 580031260 { return 0 - 1 }
    var fp: i64 = 107
    fp = mix(fp, 4, 1151)
    fp = mix(fp, 8, 1151)
    fp = mix(fp, 53646245, 1151)
    fp = mix(fp, 528026990, 1151)
    fp = mix(fp, 301444501, 1151)
    fp = mix(fp, 258927862, 1151)
    fp = mix(fp, 388915166, 1151)
    fp = mix(fp, 900589789, 1151)
    fp = mix(fp, 205040674, 1151)
    fp = mix(fp, sat_resolution_entry_fp, 1151)
    return fp
}

fn main() -> i64 {
    let entry_fp = portfolio_entry_fingerprint(8, 829764719, 177576187, 0, 8)
    let manifest_fp = portfolio_v4_fingerprint(entry_fp)

    if entry_fp != 580031260 { return 1 }
    if manifest_fp != 609543650 { return 2 }
    if portfolio_entry_fingerprint(8, 829764719, 177576187, 1, 8) != (0 - 1) { return 3 }
    if portfolio_entry_fingerprint(8, 829764719, 177576188, 0, 8) != (0 - 1) { return 4 }
    if portfolio_v4_fingerprint(entry_fp + 1) != (0 - 1) { return 5 }
    return 0
}
