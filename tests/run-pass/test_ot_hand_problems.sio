//@ run-pass
//@ description: Exact OT/W1 over Q — 3 hand problems (known rational optima, minimization verified)
use ot::transport_exact::*
use math::rational::*

fn main() -> i64 with Mut, Div, Panic {
    // HP1: masses (2/3,1/3)->(1/3,2/3), cost [[5,1],[1,5]] ; W1 = 1 ; opt=3 (greedy NW=11)
    OT_SNUM[0]=2; OT_SDEN[0]=3; OT_SNUM[1]=1; OT_SDEN[1]=3;
    OT_DNUM[0]=1; OT_DDEN[0]=3; OT_DNUM[1]=2; OT_DDEN[1]=3;
    OT_COST[0]=5; OT_COST[1]=1; OT_COST[2]=1; OT_COST[3]=5;
    let w1 = w1_rational(2,2);
    if w1.num != 1 { return 1; }
    if w1.den != 1 { return 2; }
    // integer opt must be 3 (minimization), NOT the greedy 11
    OT_SUPPLY[0]=2; OT_SUPPLY[1]=1; OT_DEMAND[0]=1; OT_DEMAND[1]=2;
    let ci = w1_int(2,2);
    if ci != 3 { return 30 + ci; }
    // HP2: (1/3,2/3)->(2/3,1/3), cost [[0,1],[1,0]] ; W1 = 1/3
    OT_SNUM[0]=1; OT_SDEN[0]=3; OT_SNUM[1]=2; OT_SDEN[1]=3;
    OT_DNUM[0]=2; OT_DDEN[0]=3; OT_DNUM[1]=1; OT_DDEN[1]=3;
    OT_COST[0]=0; OT_COST[1]=1; OT_COST[2]=1; OT_COST[3]=0;
    let w2 = w1_rational(2,2);
    if w2.num != 1 { return 4; }
    if w2.den != 3 { return 5; }
    // HP3: (3/5,2/5)->(2/5,3/5), cost [[1,4],[4,1]] ; W1 = 8/5
    OT_SNUM[0]=3; OT_SDEN[0]=5; OT_SNUM[1]=2; OT_SDEN[1]=5;
    OT_DNUM[0]=2; OT_DDEN[0]=5; OT_DNUM[1]=3; OT_DDEN[1]=5;
    OT_COST[0]=1; OT_COST[1]=4; OT_COST[2]=4; OT_COST[3]=1;
    let w3 = w1_rational(2,2);
    if w3.num != 8 { return 6; }
    if w3.den != 5 { return 7; }
    return 0;
}
