    receipt_fp = mix(receipt_fp, 220149970, 4999)
    receipt_fp = mix(receipt_fp, 611181728, 4999)
    receipt_fp = mix(receipt_fp, 256503731, 4999)
    receipt_fp = mix(receipt_fp, 69995750, 4999)
    receipt_fp = mix(receipt_fp, 380914208, 4999)
    receipt_fp = mix(receipt_fp, 5, 4999)
    receipt_fp = mix(receipt_fp, 4, 4999)
    receipt_fp = mix(receipt_fp, 255, 4999)
    if receipt_fp != 762143588 { return 1 }

    var audit_fp: i64 = 1237
    audit_fp = mix(audit_fp, receipt_fp, 5003)
    audit_fp = mix(audit_fp, 989883403, 5003)
    audit_fp = mix(audit_fp, 754841079, 5003)
    audit_fp = mix(audit_fp, 825097798, 5003)
    audit_fp = mix(audit_fp, 397604716, 5003)
    audit_fp = mix(audit_fp, 69995750, 5003)
    audit_fp = mix(audit_fp, 380914208, 5003)
    audit_fp = mix(audit_fp, 256503731, 5003)
    audit_fp = mix(audit_fp, 5, 5003)
    audit_fp = mix(audit_fp, 4, 5003)
    audit_fp = mix(audit_fp, 255, 5003)
    if audit_fp != 258352795 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 77, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 77, 1103)
    if entry_fp != 758491585 { return 3 }

    let manifest_fp: i64 = 522438539
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 74, 1871)
    result_fp = mix(result_fp, 78, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 66, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 625368196 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 74, 1907)
    family_fp = mix(family_fp, 78, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 61, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 252627063 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 74, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 213191343 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 74, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 457602463 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 74, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 635257553 { return 8 }
    return 0
