//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v74 smoke for Lorenz i256 step-5 Taylor-2 completed candidate bundle

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1231
    receipt_fp = mix(receipt_fp, 989883403, 4999)
    receipt_fp = mix(receipt_fp, 754841079, 4999)
    receipt_fp = mix(receipt_fp, 825097798, 4999)
