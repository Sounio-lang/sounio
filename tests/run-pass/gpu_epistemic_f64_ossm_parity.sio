//@ run-pass
//@ expect-stdout: PASS: GPU epistemic f64 O-SSM parity

kernel fn ossm_oct_step_f64(n: i64, state: &[f64], out: &![f64], shadow: &![f64]) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        let upper = tid + 64
        let h0 = state[tid as usize]
        let h1 = state[upper as usize]
        let x0 = h0 + 1.0
        let x1 = h1 + 0.25

        let ah0 = (0.5 * h0) - (0.125 * h1)
        let ah1 = (0.5 * h1) + (0.125 * h0)
        let bx0 = (0.25 * x0) - (0.5 * x1)
        let bx1 = (0.25 * x1) + (0.5 * x0)
        let next0 = ah0 + bx0
        let next1 = ah1 + bx1
        let energy = (next0 * next0) + (next1 * next1)

        out[tid as usize] = next0
        out[upper as usize] = next1
        shadow[tid as usize] = energy + 0.015625
    }
}

fn main() -> i32 with IO, Mut, Panic, GPU {
    var state: [f64; 128] = [0.0; 128]
    var out: [f64; 128] = [0.0; 128]
    var shadow: [f64; 128] = [0.0; 128]

    var i: i64 = 0
    while i < 64 {
        state[i as usize] = (i as f64) + 1.0
        state[(i + 64) as usize] = ((i as f64) + 1.0) * 0.5
        i = i + 1
    }

    ossm_oct_step_f64(64, &state, &!out, &!shadow)

    if out[0] > 0.562 && out[0] < 0.563 &&
       out[64] > 1.562 && out[64] < 1.563 &&
       out[10] > 4.937 && out[10] < 4.938 &&
       out[74] > 11.562 && out[74] < 11.563 &&
       shadow[0] > 2.773 && shadow[0] < 2.774 {
        println("PASS: GPU epistemic f64 O-SSM parity")
    } else {
        println("FAIL: GPU epistemic f64 O-SSM parity")
    }
    0
}
