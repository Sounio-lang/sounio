//@ run-pass
//@ requires: madaros
//@ expect-stdout: y0 0.090000
//@ expect-stdout: y1 0.370000
//@ expect-stdout: y2 1.530000
//@ expect-stdout: y12 1677639.690000
//@ expect-stdout: yneg 0.090000
//@ expect-stdout: c3 7.450000
//@ expect-stdout: RECUR_AFFY_OK
// a = 5 +- 0.3, var = 0.09. b = 2 +- 0.1, var = 0.01. Independent.
// z_n = c^n * a + (c^n - 1)/(c - 1) * b. c = 2, n = 12 is
// 4096^2 * 0.09 + 4095^2 * 0.01. c = 3 at n = 2 is 81 * 0.09 + 16 * 0.01.

fn ay(x: f64, y: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        2.0 * ay(x, y, n - 1) + y
    }
}

fn ay3(x: f64, y: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        3.0 * ay3(x, y, n - 1) + y
    }
}

fn main() -> i64 with IO, Epistemic {
    let kx: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let ky: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let a = kx.value
    let b = ky.value
    let y0 = variance_of(ay(a, b, 0))
    let y1 = variance_of(ay(a, b, 1))
    let y2 = variance_of(ay(a, b, 2))
    let y12 = variance_of(ay(a, b, 12))
    let yneg = variance_of(ay(a, b, 0 - 2))
    let c3 = variance_of(ay3(a, b, 2))
    print("y0 ")
    print_f64(y0)
    println("")
    print("y1 ")
    print_f64(y1)
    println("")
    print("y2 ")
    print_f64(y2)
    println("")
    print("y12 ")
    print_f64(y12)
    println("")
    print("yneg ")
    print_f64(yneg)
    println("")
    print("c3 ")
    print_f64(c3)
    println("")
    var fails: i64 = 0
    if y0 < 0.089999 || y0 > 0.090001 { fails = fails + 1 }
    if y1 < 0.369999 || y1 > 0.370001 { fails = fails + 1 }
    if y2 < 1.529999 || y2 > 1.530001 { fails = fails + 1 }
    if y12 < 1677639.68 || y12 > 1677639.70 { fails = fails + 1 }
    if yneg < 0.089999 || yneg > 0.090001 { fails = fails + 1 }
    if c3 < 7.449999 || c3 > 7.450001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_AFFY_OK")
        0
    } else {
        println("RECUR_AFFY_FAIL")
        1
    }
}
