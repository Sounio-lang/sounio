//@ run-pass
//@ expect-stdout: PASS float_literal_correctly_rounded_bits
// A float literal lowers to its correctly rounded binary64 value (round half to
// even), whatever the engine. lean_single used to evaluate
// (int + frac/denom) * 10^exp at run time, rounding at every operation, which
// put 0.041, 0.000009 and 5.234690e-8 one ULP low and 1.0e-12, 1.0e-6, 1.0e-30
// and 6.02214076e23 one ULP high. 0.041 (vasc_frac[10] in
// pbpk28_params_rapamycin) was the first divergence between lean_single and
// Madaros in tests/run-pass/pbpk28_m5_gum_4th_order.sio.
//
// Every expected value below was computed with exact integer arithmetic
// (N * 2^s / 10^k as big integers, then round half to even), not with a float.

const LIT_CONST_0041: f64 = 0.041
const LIT_CONST_1EM12: f64 = 1.0e-12

fn check(tag: string, x: f64, want: i64) -> i64 with IO {
    let got = f64_to_bits(x)
    if got != want {
        print("FAIL "); print(tag)
        print(" got="); print_int(got)
        print(" want="); print_int(want)
        println("")
        return 1
    }
    return 0
}

fn main() -> i64 with IO, Mut {
    var bad: i64 = 0
    // No integer part: leading fractional zeros, scientific exponents.
    bad = bad + check("0.041", 0.041, 4586069543746904523)
    bad = bad + check("0.000009", 0.000009, 4531430287800576831)
    bad = bad + check("5.234690e-8", 5.234690e-8, 4497999268361732641)
    bad = bad + check("1.0e-12", 1.0e-12, 4427486594234968593)
    bad = bad + check("1e-12", 1e-12, 4427486594234968593)
    bad = bad + check("1.0e-6", 1.0e-6, 4517329193108106637)
    bad = bad + check("1.0e-30", 1.0e-30, 4158027847206421152)
    bad = bad + check("7e-3", 7e-3, 4574720472685930873)
    bad = bad + check("0.1", 0.1, 4591870180066957722)
    bad = bad + check("0.357945", 0.357945, 4600119783792382449)
    bad = bad + check("0.000000000000000000000001", 0.000000000000000000000001, 4247835366853742247)
    // More than 18 fraction digits: every digit counts.
    bad = bad + check("0.12345678901234567890123", 0.12345678901234567890123, 4593560419847042655)
    bad = bad + check("0.1000000000000000055511151231257827", 0.1000000000000000055511151231257827, 4591870180066957722)
    // With an integer part.
    bad = bad + check("123.456", 123.456, 4638387860618067575)
    bad = bad + check("42.195", 42.195, 4631135235630652457)
    bad = bad + check("6.02214076e23", 6.02214076e23, 4962933279127225623)
    // 2^53 + 1 is a tie between 2^53 and 2^53 + 2: even wins.
    bad = bad + check("9007199254740993.0", 9007199254740993.0, 4845873199050653696)
    // Exact binary64 values stay exact.
    bad = bad + check("0.0", 0.0, 0)
    bad = bad + check("0.0625", 0.0625, 4589168020290535424)
    bad = bad + check("2.5", 2.5, 4612811918334230528)
    bad = bad + check("1.5e1", 1.5e1, 4624633867356078080)
    bad = bad + check("100.0", 100.0, 4636737291354636288)
    // Range ends: smallest normal, largest finite. (The smallest subnormal,
    // 4.9e-324 -> bits 1, is left out: Madaros a1307ca6 lowers it to 0.0.)
    bad = bad + check("2.2250738585072014e-308", 2.2250738585072014e-308, 4503599627370496)
    bad = bad + check("1.7976931348623157e308", 1.7976931348623157e308, 9218868437227405311)
    // A named const lowers through its own site.
    bad = bad + check("const 0.041", LIT_CONST_0041, 4586069543746904523)
    bad = bad + check("const 1.0e-12", LIT_CONST_1EM12, 4427486594234968593)
    if bad != 0 {
        println("FAIL float_literal_correctly_rounded_bits")
        return 1
    }
    println("PASS float_literal_correctly_rounded_bits")
    return 0
}
