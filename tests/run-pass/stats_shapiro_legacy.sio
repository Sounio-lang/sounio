//@ run-pass
//@ expect-stdout: STATS_SHAPIRO_LEGACY_PASS
use stats::epistemic::assumptions::{shapiro_wilk_test}
fn main() with IO,Mut,Div,Panic {
 var x:[f64;100]=[0.0;100]
 x[0]=-2.0e-200;x[1]=-1.0e-200;x[2]=0.0;x[3]=1.0e-200;x[4]=2.0e-200
 let r=shapiro_wilk_test(x,5)
 assert(r.status==0 && r.calibration==1 && r.p_approximate)
 assert(r.w>0.98676215544 && r.w<0.98676215546)
 assert(r.p>0.9671739359 && r.p<0.9671739361)
 assert(shapiro_wilk_test(x,101).status==1)
 println("STATS_SHAPIRO_LEGACY_PASS")
 0
}
