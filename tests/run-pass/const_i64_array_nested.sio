//@ run-pass
//@ requires: madaros
// A literal nested inside another array literal never stamps: the outer
// literal keeps the per-element store path and the inner literal keeps its
// own stores, so nested reads see the real elements.
fn main() -> i64 {
    let xs = [[3, 5], [7, 11]]
    let a = xs[0][0]
    let b = xs[0][1]
    let c = xs[1][0]
    let d = xs[1][1]
    if a == 3 && b == 5 && c == 7 && d == 11 { 0 } else { 1 }
}
