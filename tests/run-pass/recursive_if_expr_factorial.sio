//@ run-pass
//@ requires: madaros
// Issue #3212. A recursive function whose body is an if/else used as a value
// must multiply in i64. The if/else form used to stamp the self-call as f64
// and emit mulsd; f(19) and f(20) then returned the wrong bit pattern, with
// no diagnostic. Both values fit in i64. The early-return and while forms
// were already correct and stay correct. fact_f keeps a real f64 recursion
// on the mulsd path.
// Notion: https://app.notion.com/p/4053f37f937181148eccea6fa8e20b54

fn fact_if(n: i64) -> i64 {
    if n <= 1 { 1 } else { n * fact_if(n - 1) }
}

fn fact_ret(n: i64) -> i64 {
    if n <= 1 { return 1 }
    n * fact_ret(n - 1)
}

fn fact_while(n: i64) -> i64 with Mut {
    var r: i64 = 1
    var i: i64 = 2
    while i <= n {
        r = r * i
        i = i + 1
    }
    r
}

fn id_i64(n: i64) -> i64 { n }

fn mul_id(n: i64) -> i64 {
    if n <= 1 { 1 } else { n * id_i64(n - 1) }
}

fn fact_f(n: i64) -> f64 {
    if n <= 1 { 1.0 } else { (n as f64) * fact_f(n - 1) }
}

fn main() -> i64 with Mut {
    if fact_if(10) != 3628800 { return 10 }
    if fact_if(15) != 1307674368000 { return 15 }
    if fact_if(19) != 121645100408832000 { return 19 }
    if fact_if(20) != 2432902008176640000 { return 20 }
    if fact_ret(20) != 2432902008176640000 { return 21 }
    if fact_while(20) != 2432902008176640000 { return 22 }
    if mul_id(20) != 380 { return 23 }
    let f5 = fact_f(5)
    if f5 < 119.5 { return 24 }
    if f5 > 120.5 { return 25 }
    0
}
