//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_F64_ARRAY_DESTRUCTURE PASS
//
// `let (a, b) = f()` with f returning `([f64; 8], [f64; 8])`: the destructured
// arrays hold f64 elements. Madaros did not mark them, so `a[0] * 2.0`
// converted the element's f64 bits as an i64 while a plain read passed through
// (kinetics structural_ensemble: `p * ov[j]`).
fn pair() -> ([f64; 8], [f64; 8]) with Mut, Panic {
    var a: [f64; 8] = [0.0; 8]
    var b: [f64; 8] = [0.0; 8]
    a[0] = 1.5
    b[0] = 0.25
    (a, b)
}

fn main() -> i32 with IO, Mut, Panic {
    let (oa, ob) = pair()
    let s0: f64 = oa[0] * 2.0
    let s1: f64 = 2.0 * ob[0]
    var acc: f64 = 0.0
    var j: i64 = 0
    while j < 2 {
        acc = acc + 0.5 * oa[j]
        j = j + 1
    }
    if s0 == 3.0 && s1 == 0.5 && acc == 0.75 {
        println("TUPLE_F64_ARRAY_DESTRUCTURE PASS")
        return 0
    }
    1
}
