//@ run-pass
//@ known-failure: source-level i256 Lorenz fixed-point division path at scale 2^32: main returns 3. Not a segfault/139
//@ description: Lorenz one-step fixed-point smoke over i256 arithmetic at scale 2^32

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = scale / (100 as i256)
    let sigma: i256 = 10 as i256
    let rho: i256 = 28 as i256
    let beta_num: i256 = 8 as i256
    let beta_den: i256 = 3 as i256

    let x: i256 = scale
    let y: i256 = scale
    let z: i256 = scale

    let dx: i256 = sigma * (y - x)
    let dy: i256 = (x * ((rho * scale) - z)) / scale - y
    let xy_scaled: i256 = (x * y) / scale
    let beta_z: i256 = (beta_num * z) / beta_den
    let dz: i256 = xy_scaled - beta_z

    let nx: i256 = x + (dt * dx) / scale
    let ny: i256 = y + (dt * dy) / scale
    let zdrop: i256 = (dt * ((0 as i256) - dz)) / scale
    let nz: i256 = z - zdrop

    if scale != (4294967296 as i256) { return 1 }
    if dt != (42949672 as i256) { return 2 }

    if dx != (0 as i256) { return 3 }
    if dy != (26 as i256) * scale { return 4 }
    if xy_scaled != scale { return 5 }
    if beta_z != ((8 as i256) * scale) / (3 as i256) { return 6 }
    if dz != ((0 as i256) - (((5 as i256) * scale) / (3 as i256))) { return 7 }

    if nx != scale { return 8 }
    if ny != scale + (dt * ((26 as i256) * scale)) / scale { return 9 }
    if zdrop != (dt * (((5 as i256) * scale) / (3 as i256))) / scale { return 10 }
    if nz != scale - (dt * (((5 as i256) * scale) / (3 as i256))) / scale { return 11 }

    return 0
}
