//@ run-pass

// Regression for PR #2664: the lexer gives the literal word "kernel" its own
// token kind, TK=79 (it backs the `kernel fn` GPU-kernel declaration syntax),
// distinct from TK=3 (ordinary identifier). compile_primary_a64's identifier
// dispatch checked only `k == 3`, so a parameter or local literally named
// `kernel`, read as a plain value under --target aarch64-linux, matched no
// branch and fell through with EXPR_TY/EXPR_TY_HASH left stale -- reported as
// error[E001] "Type mismatch in call argument" at the `has_a(kernel)` call
// below, on aarch64 only (x86_64's compile_primary already handled it).
// Renaming the parameter away from `kernel` made the failure disappear, which
// is the bug's signature. This is exactly the parameter-naming convention
// GPU IR-lowering code uses throughout self-hosted/gpu/*.sio.

struct Kern { a: i64 }

fn has_a(kernel: Kern) -> bool { kernel.a > 0 }

fn check(kernel: Kern) -> bool { has_a(kernel) }

fn main() -> i32 with IO {
    let k = Kern { a: 5 }
    if check(k) {
        println("PASS")
        return 0
    }
    println("FAIL: kernel-named parameter mis-typechecked")
    return 1
}
