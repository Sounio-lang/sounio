//@ run-pass
//@ expect-stdout: 30
//@ description: FX-2 with op arguments: perform arguments travel to the clause (mailbox) and the clause resumes per call (SIO-417)
//@ semantic-lane: SPEC-07-7.4-FX-2

effect Ask { fn get(n: i64) -> i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<Ask> {
        let a = perform Ask.get(1)
        let b = perform Ask.get(2)
        a + b
    } with { on get(n) -> resume(n * 10) return(x) -> x }
    println(r)
    0
}
