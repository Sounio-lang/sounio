//@ run-pass
//@ expect-stdout: PHYSICS_UNCERTAINTY_LEGACY_PASS
use units::lib::*
use physics::classical::{classical_force,classical_ke,classical_pos}
use physics::sr::{gamma,velocity_addition,four_momentum,invariant_mass_from_4p,boost_e_p}
fn report(id:i64,x:f64,u:f64) with IO {print("PHYSICS_LEGACY ") print_int(id) print(" ") print_int(f64_to_bits(x)) print(" ") print_int(f64_to_bits(u)) println("")}
fn main()->i32 with IO,Mut,Div,Panic {
 let c=299792458.0
 let m=quantity_new(0.0,1.0,dim_mass())
 let a=quantity_new(2.0,0.0,dim_acceleration())
 let force=classical_force(&m,&a)
 report(0,force.value,force.uncertainty)
 let km=quantity_new(2.0,0.1,dim_mass())
 let kv=quantity_new(3.0,0.2,dim_velocity())
 let ke=classical_ke(&km,&kv)
 report(1,ke.value,ke.uncertainty)
 let pos=classical_pos(1.0,0.1,2.0,0.2,3.0,0.3,2.0)
 report(2,pos.0,pos.1)
 let g=gamma(-0.6*c,0.001*c)
 report(3,g.0,g.1)
 let vel=velocity_addition(0.5*c,0.001*c,0.5*c,0.002*c)
 report(4,vel.0,vel.1)
 let fm=four_momentum(c*c,1.0,0.0,0.0)
 let mass=invariant_mass_from_4p(&fm)
 report(5,mass.0,mass.1)
 let (boost_e,boost_p)=boost_e_p(10.0*c,0.1*c,2.0,0.2,-0.3*c,0.001*c)
 report(6,boost_e.0,boost_e.1)
 report(7,boost_p.0,boost_p.1)
 if force.uncertainty<=0.0 || g.1<0.0 || mass.0<0.999999 || mass.0>1.000001 {return 1}
 println("PHYSICS_UNCERTAINTY_LEGACY_PASS")
 0
}
