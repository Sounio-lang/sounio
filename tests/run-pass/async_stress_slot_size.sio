//@ run-pass
//@ expect-stdout-contains: stress_slot_size: PASS
// Stress: i64 boundary values through the 8-byte mmap result slot

fn main() -> i64 with IO, Async {
    var exit_fails: i64 = 0
    // i64 max: 9223372036854775807
    let h_max = spawn { 9223372036854775807 }
    let r_max = h_max.await

    // Negative values
    let h_neg = spawn { -1 }
    let r_neg = h_neg.await

    // Zero
    let h_zero = spawn { 0 }
    let r_zero = h_zero.await

    if r_max == 9223372036854775807 && r_neg == -1 && r_zero == 0 {
        print("stress_slot_size: PASS\n")
    } else {
        print("stress_slot_size: FAIL\n")
        exit_fails = exit_fails + 1
    }
    if exit_fails > 0 {
        return 1
    }
    return 0
}
