//@ run-pass
//@ requires: madaros
//@ expect-stdout: 49:49
// SIO-572: a struct payload behind an INLINE raw-pointer cast must resolve
// the pointee layout exactly like a typed-local deref. Before the fix the
// cast form wrote the wrong slot (val read back 0) and SIGILLed on the
// indexed field after the inline array.
extern fn heap_alloc(n: i64) -> *mut u8
struct W {
    tag: [i64; 4],
    val: i64,
}
fn typed() -> i64 with Mut {
    let h = heap_alloc(40)
    let p = (h as i64) as *mut W
    (*p).tag[2] = 7
    (*p).val = 42
    (*p).val + (*p).tag[2]
}
fn inline_cast() -> i64 with Mut {
    let h = heap_alloc(40)
    (*((h as i64) as *mut W)).tag[2] = 7
    (*((h as i64) as *mut W)).val = 42
    (*((h as i64) as *mut W)).val + (*((h as i64) as *mut W)).tag[2]
}
fn main() -> i64 with IO, Mut {
    print_int(typed())
    print(":")
    print_int(inline_cast())
    println("")
    return 0
}
