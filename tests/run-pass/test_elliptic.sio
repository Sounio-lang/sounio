    let kk = elliptic_k(k)
    let ek = elliptic_e(k)
    let kkp = elliptic_k(kp)
    let ekp = elliptic_e(kp)
    let lhs = kk * ekp + ek * kkp - kk * kkp
    let expected = pi_val() / 2.0
    let tol = 1.0e-5
    print("  Legendre(0.7)=")
    println(lhs)
    return abs_f64(lhs - expected) < tol
}

// Test 18: K(k) monotonically increases, K(0.3) < K(0.6) < K(0.9)
fn test_k_monotone() -> bool with IO, Mut, Panic, Div {
    let k03 = elliptic_k(0.3)
    let k06 = elliptic_k(0.6)
    let k09 = elliptic_k(0.9)
    print("  K(0.3)=")
    println(k03)
    print("  K(0.6)=")
    println(k06)
    print("  K(0.9)=")
    println(k09)
    return k03 < k06 && k06 < k09
}

