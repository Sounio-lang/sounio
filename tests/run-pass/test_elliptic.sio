// Test 10: K(k) > E(k) for k > 0 (check at k = 0.7)
fn test_k_gt_e() -> bool with IO, Mut, Panic, Div {
    let k = 0.7
    let kv = elliptic_k(k)
    let ev = elliptic_e(k)
    print("  K(0.7)=")
    println(kv)
    print("  E(0.7)=")
    println(ev)
    return kv > ev
}

// Test 11: E(k) monotonically decreases, E(0.3) > E(0.6) > E(0.9)
fn test_e_monotone() -> bool with IO, Mut, Panic, Div {
    let e03 = elliptic_e(0.3)
    let e06 = elliptic_e(0.6)
    let e09 = elliptic_e(0.9)
    print("  E(0.3)=")
    println(e03)
    print("  E(0.6)=")
    println(e06)
    print("  E(0.9)=")
    println(e09)
    return e03 > e06 && e06 > e09
}

// Test 12: Jacobi identity sn^2 + cn^2 = 1 at u=1.0, k=0.5
fn test_jacobi_pythagorean() -> bool with IO, Mut, Panic, Div {
    let u = 1.0
    let k = 0.5
    let sn = jacobi_sn(u, k)
    let cn = jacobi_cn(u, k)
    let sum = sn * sn + cn * cn
    let tol = 1.0e-6
    print("  sn^2+cn^2=")
    println(sum)
    return abs_f64(sum - 1.0) < tol
}

// Test 13: Jacobi identity dn^2 + k^2*sn^2 = 1 at u=1.0, k=0.5
fn test_jacobi_dn_identity() -> bool with IO, Mut, Panic, Div {
    let u = 1.0
    let k = 0.5
    let sn = jacobi_sn(u, k)
    let dn = jacobi_dn(u, k)
    let sum = dn * dn + k * k * sn * sn
    let tol = 1.0e-6
    print("  dn^2+k^2*sn^2=")
    println(sum)
    return abs_f64(sum - 1.0) < tol
}

// Test 14: sn(0, k) = 0, cn(0, k) = 1, dn(0, k) = 1 for k = 0.5
fn test_jacobi_at_zero() -> bool with IO, Mut, Panic, Div {
    let k = 0.5
    let sn = jacobi_sn(0.0, k)
    let cn = jacobi_cn(0.0, k)
    let dn = jacobi_dn(0.0, k)
    let tol = 1.0e-8
    print("  sn(0,0.5)=")
    println(sn)
    print("  cn(0,0.5)=")
    println(cn)
    print("  dn(0,0.5)=")
    println(dn)
    return abs_f64(sn) < tol && abs_f64(cn - 1.0) < tol && abs_f64(dn - 1.0) < tol
}

// Test 15: sn(u, 0) = sin(u) -- when k=0, elliptic functions reduce to trig
fn test_jacobi_k_zero() -> bool with IO, Mut, Panic, Div {
    let u = 1.2
    let sn = jacobi_sn(u, 0.0)
    let expected = sin_f64(u)
    let tol = 1.0e-6
    print("  sn(1.2, 0)=")
    println(sn)
    print("  sin(1.2)=")
    println(expected)
    return abs_f64(sn - expected) < tol
}

// Test 16: Incomplete integral F(pi/2, k) = K(k) at k = 0.5
fn test_f_complete() -> bool with IO, Mut, Panic, Div {
    let k = 0.5
    let f_val = elliptic_f_incomplete(pi_val() / 2.0, k)
    let k_val = elliptic_k(k)
    let tol = 1.0e-3
    print("  F(pi/2, 0.5)=")
    println(f_val)
    print("  K(0.5)=")
    println(k_val)
    return abs_f64(f_val - k_val) < tol
}

// Test 17: Legendre relation at k = 0.7 (second check point)
fn test_legendre_relation_07() -> bool with IO, Mut, Panic, Div {
    let k = 0.7
