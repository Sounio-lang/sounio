//@ run-pass

// ---------------------------------------------------------------------------
// Elliptic Integrals and Functions test suite -- all helpers inlined, no imports
//
// Functions tested:
//   elliptic_k  -- Complete elliptic integral of the first kind K(k) via AGM
//   elliptic_e  -- Complete elliptic integral of the second kind E(k) via series
//   elliptic_f  -- Incomplete elliptic integral of the first kind F(phi,k) via series
//   jacobi_sn   -- Jacobi elliptic function sn(u,k) via arithmetic descent
//   jacobi_cn   -- Jacobi elliptic function cn(u,k) via arithmetic descent
//   jacobi_dn   -- Jacobi elliptic function dn(u,k) via arithmetic descent
//
// K(k) uses the Arithmetic-Geometric Mean (AGM) iteration:
//   a_0 = 1, b_0 = sqrt(1 - k^2)
//   a_{n+1} = (a_n + b_n)/2,  b_{n+1} = sqrt(a_n * b_n)
//   K(k) = pi / (2 * a_N)
//
// E(k) uses the power series:
//   E(k) = (pi/2) * [1 - sum_{n=1}^{N} ((2n-1)!! / (2n)!!)^2 * k^{2n} / (2n-1)]
//
// Jacobi functions use the descending Landen transformation.
//
// References:
//   Abramowitz & Stegun (1964), Ch. 17
//   DLMF (https://dlmf.nist.gov) chapters 19, 22
//   Byrd & Friedman, "Handbook of Elliptic Integrals" (1971)
//   King, "Numerical and Statistical Methods for Bioengineering" (2010)
// ---------------------------------------------------------------------------

// ============================================================================
// HELPERS (must precede callers)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sqrt_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var scaled = x
    var scale_back = 1.0
    while scaled < 1.0 {
        scaled = scaled * 4.0
        scale_back = scale_back * 2.0
    }
    while scaled > 4.0 {
        scaled = scaled * 0.25
        scale_back = scale_back * 0.5
    }
    var y = 1.5
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    return y / scale_back
}

fn pi_val() -> f64 {
    return 3.14159265358979323846
}

fn floor_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x >= 0.0 {
        if x < 1.0 { return 0.0 }
        var result = 0.0
        var remaining = x
        var power = 1000000000000000.0
        while power >= 1.0 {
            while remaining >= power {
                remaining = remaining - power
                result = result + power
            }
            power = power / 10.0
        }
        return result
    } else {
        let pos = 0.0 - x
        let pos_floor = floor_f64(pos)
        if pos > pos_floor {
            return 0.0 - pos_floor - 1.0
        }
        return 0.0 - pos_floor
    }
}

fn sin_f64(x: f64) -> f64 with Mut, Panic, Div {
    var a = x
    let tp = 6.28318530717958647692
    if a > tp || a < 0.0 - tp {
        let n = floor_f64(a / tp)
        a = a - n * tp
    }
    while a > pi_val() { a = a - tp }
    while a < 0.0 - pi_val() { a = a + tp }
    let a2 = a * a
    var sum = a
    var term = a
    var n = 1
    while n < 18 {
        term = 0.0 - term * a2 / ((2 * n) * (2 * n + 1)) as f64
        sum = sum + term
        n = n + 1
    }
    return sum
}

fn cos_f64(x: f64) -> f64 with Mut, Panic, Div {
    return sin_f64(x + pi_val() / 2.0)
}

fn atan2_f64(y: f64, x: f64) -> f64 with Mut, Panic, Div {
    // atan(z) via series for |z| <= 1, identity for |z| > 1
    if x == 0.0 {
        if y > 0.0 { return pi_val() / 2.0 }
        if y < 0.0 { return 0.0 - pi_val() / 2.0 }
        return 0.0
    }
    let ratio = y / x
    let at = atan_f64(ratio)
    if x > 0.0 { return at }
    if y >= 0.0 { return at + pi_val() }
    return at - pi_val()
}

fn atan_f64(z: f64) -> f64 with Mut, Panic, Div {
    // atan(z) for any z using range reduction and Taylor series
    if z < 0.0 { return 0.0 - atan_f64(0.0 - z) }
    if z > 1.0 { return pi_val() / 2.0 - atan_f64(1.0 / z) }
    // For |z| <= 1, use Taylor series: atan(z) = z - z^3/3 + z^5/5 - ...
    let z2 = z * z
    var sum = z
    var term = z
    var k = 1
    while k < 40 {
        term = 0.0 - term * z2
        sum = sum + term / (2.0 * (k as f64) + 1.0)
        k = k + 1
    }
    return sum
}

fn asin_f64(x: f64) -> f64 with Mut, Panic, Div {
    // asin(x) = atan2(x, sqrt(1 - x^2))
    if x >= 1.0 { return pi_val() / 2.0 }
    if x <= 0.0 - 1.0 { return 0.0 - pi_val() / 2.0 }
    return atan2_f64(x, sqrt_f64(1.0 - x * x))
}

// ============================================================================
// ELLIPTIC INTEGRALS
// ============================================================================

// Complete elliptic integral of the first kind K(k) via AGM
// K(k) = pi / (2 * AGM(1, sqrt(1 - k^2)))
//
// The AGM iteration converges quadratically:
//   a_0 = 1,  b_0 = k' = sqrt(1 - k^2)
//   a_{n+1} = (a_n + b_n) / 2
//   b_{n+1} = sqrt(a_n * b_n)
//   After convergence: K = pi / (2 * a_N)
fn elliptic_k(k: f64) -> f64 with Mut, Panic, Div {
    if abs_f64(k) >= 1.0 { return 1.0e30 }
    var a = 1.0
    var b = sqrt_f64(1.0 - k * k)
    var n = 0
    while n < 30 {
        if abs_f64(a - b) < 1.0e-15 {
            n = 30
        } else {
            let a_new = (a + b) / 2.0
            let b_new = sqrt_f64(a * b)
            a = a_new
            b = b_new
            n = n + 1
        }
    }
    return pi_val() / (2.0 * a)
}

// Complete elliptic integral of the second kind E(k) via power series
//
// E(k) = (pi/2) * [1 - sum_{n=1}^{N} c_n * k^{2n} / (2n - 1)]
// where c_n = ((2n-1)!! / (2n)!!)^2
//
// Equivalently, using the recurrence for the coefficient:
//   c_1 = (1/2)^2 = 1/4
//   c_{n+1} = c_n * ((2n+1)/(2n+2))^2 -- NO, that's not right.
//
// Actually the series is:
//   E(k) = (pi/2) * sum_{n=0}^{inf} -((2n)! / (2^n n!)^2)^2 * k^{2n} / (2n-1)
//
// More precisely, define t_n = ((2n)! / (2^n n!)^2)^2 / (1 - 2n):
//   E(k) = (pi/2) * [1 + sum_{n=1}^{N} t_n * k^{2n}]
//
// Build incrementally:
//   Let r_n = (2n)! / (2^n n!)^2 = (2n-1)!! / (2n)!!
//   r_0 = 1
//   r_n = r_{n-1} * (2n-1) / (2n)
//   coeff = - r_n^2 / (2n - 1)
//
//   E(k) = (pi/2) [1 - (1/4)*k^2/1 - (9/64)*k^4/3 - (25/256)*k^6/5 - ...]
//   i.e.  E(k) = (pi/2) [1 - sum_{n=1}^N r_n^2 * k^{2n} / (2n-1)]
fn elliptic_e(k: f64) -> f64 with Mut, Panic, Div {
    if abs_f64(k) < 1.0e-15 { return pi_val() / 2.0 }
    let k2 = k * k
    var r = 1.0          // r_n = (2n-1)!! / (2n)!!; r_0 = 1
    var k2n = 1.0        // k^{2n}
    var sum = 1.0
    var n = 1
    while n <= 50 {
        let nf = n as f64
        r = r * (2.0 * nf - 1.0) / (2.0 * nf)
        k2n = k2n * k2
        let term = r * r * k2n / (2.0 * nf - 1.0)
        sum = sum - term
        n = n + 1
    }
    return (pi_val() / 2.0) * sum
}

// Incomplete elliptic integral of the first kind F(phi, k)
// via the series expansion (valid for small k*sin(phi)):
//
// F(phi, k) = phi + sum_{n=1}^{N} c_n * S_n(phi)
// where c_n = (r_n)^2 * k^{2n} and S_n involves trigonometric sums.
//
// For simplicity, use numerical integration (trapezoidal rule):
//   F(phi, k) = integral_0^phi dt / sqrt(1 - k^2 sin^2(t))
fn elliptic_f_incomplete(phi: f64, k: f64) -> f64 with Mut, Panic, Div {
    let n_steps = 200
    let h = phi / (n_steps as f64)
    let k2 = k * k
    var sum = 0.0
    var i = 0
    while i <= n_steps {
        let t = (i as f64) * h
        let s = sin_f64(t)
        let integrand = 1.0 / sqrt_f64(1.0 - k2 * s * s)
        if i == 0 || i == n_steps {
            sum = sum + integrand / 2.0
        } else {
            sum = sum + integrand
        }
        i = i + 1
    }
    return sum * h
}

// ============================================================================
// JACOBI ELLIPTIC FUNCTIONS via descending Landen transformation
// ============================================================================

// Compute sn(u, k), cn(u, k), dn(u, k) simultaneously using the
// descending Landen transformation (AGM-based).
//
// Algorithm:
// 1. Perform N AGM iterations storing the a_n values.
// 2. Compute phi_N = 2^N * a_N * u, then descend:
//    phi_{n-1} = (phi_n + asin(c_n/a_n * sin(phi_n))) / 2
//    But more standard: ascend from phi_0 = u:
//    Actually, the standard approach is:
//    - Compute AGM sequence a_0..a_N, c_0..c_N
//    - phi_N = 2^N * a_N * u
//    - Descend: for n = N..1: phi_{n-1} = (phi_n + asin(c_n * sin(phi_n) / a_n)) / 2
//    Wait, that's the ascending Landen. Let me use the standard recipe:
//
// Standard algorithm (Abramowitz & Stegun 17.6):
// 1. a_0 = 1, b_0 = k' = sqrt(1-k^2), c_0 = k
//    a_{n+1} = (a_n + b_n)/2, c_{n+1} = (a_n - b_n)/2, b_{n+1} = sqrt(a_n*b_n)
//    Iterate until c_n ~ 0.
// 2. phi_N = 2^N * a_N * u
// 3. Descend: phi_{n-1} = (phi_n + asin(c_n * sin(phi_n) / a_n)) / 2
//    for n = N, N-1, ..., 1
// 4. sn(u,k) = sin(phi_0), cn(u,k) = cos(phi_0), dn(u,k) = cos(phi_0)/cos(phi_1-phi_0)
//    Actually: sn = sin(phi_0), cn = cos(phi_0),
//    dn = sqrt(1 - k^2 * sn^2)

// Helper: return sn(u, k)
fn jacobi_sn(u: f64, k: f64) -> f64 with Mut, Panic, Div {
    if abs_f64(k) < 1.0e-15 { return sin_f64(u) }
    if abs_f64(k - 1.0) < 1.0e-15 {
        // sn(u, 1) = tanh(u) -- but we don't have tanh, approximate
        // tanh(u) = (e^u - e^{-u}) / (e^u + e^{-u})
        // For small u, tanh(u) ~ u
        // Use sinh/cosh series
        var sinh_sum = u
        var cosh_sum = 1.0
        var term_s = u
        var term_c = 1.0
        var n = 1
        while n <= 20 {
            let nf = n as f64
            term_s = term_s * u * u / ((2.0 * nf) * (2.0 * nf + 1.0))
            term_c = term_c * u * u / ((2.0 * nf - 1.0) * (2.0 * nf))
            sinh_sum = sinh_sum + term_s
            cosh_sum = cosh_sum + term_c
            n = n + 1
        }
        return sinh_sum / cosh_sum
    }

    // AGM iteration
    var a_arr: [f64; 20] = [0.0; 20]
    var c_arr: [f64; 20] = [0.0; 20]
    var a = 1.0
    var b = sqrt_f64(1.0 - k * k)
    var c = k
    a_arr[0] = a
    c_arr[0] = c
    var n_iter = 0
    var n = 1
    while n < 20 {
        let a_new = (a + b) / 2.0
        let c_new = (a - b) / 2.0
        let b_new = sqrt_f64(a * b)
        a = a_new
        b = b_new
        c = c_new
        a_arr[n] = a
        c_arr[n] = c
        if abs_f64(c) < 1.0e-15 {
            n_iter = n
            n = 20
        } else {
            n_iter = n
            n = n + 1
        }
    }

    // Compute phi_N = 2^{n_iter} * a_{n_iter} * u
    var pow2 = 1.0
    var j = 0
    while j < n_iter {
        pow2 = pow2 * 2.0
        j = j + 1
    }
    var phi = pow2 * a_arr[n_iter] * u

    // Descend
    var m = n_iter
    while m >= 1 {
        let sin_phi = sin_f64(phi)
        let ratio = c_arr[m] * sin_phi / a_arr[m]
        // Clamp ratio to [-1, 1]
        var clamped = ratio
        if clamped > 1.0 { clamped = 1.0 }
        if clamped < 0.0 - 1.0 { clamped = 0.0 - 1.0 }
        phi = (phi + asin_f64(clamped)) / 2.0
        m = m - 1
    }

    return sin_f64(phi)
}

// Helper: return cn(u, k)
fn jacobi_cn(u: f64, k: f64) -> f64 with Mut, Panic, Div {
    let sn = jacobi_sn(u, k)
    return sqrt_f64(1.0 - sn * sn)
}

// Helper: return dn(u, k)
fn jacobi_dn(u: f64, k: f64) -> f64 with Mut, Panic, Div {
    let sn = jacobi_sn(u, k)
    return sqrt_f64(1.0 - k * k * sn * sn)
}

