// Test 7: Legendre relation
// K(k)*E(k') + E(k)*K(k') - K(k)*K(k') = pi/2
// at k = 0.5, k' = sqrt(1 - 0.25) = sqrt(0.75)
fn test_legendre_relation() -> bool with IO, Mut, Panic, Div {
    let k = 0.5
    let kp = sqrt_f64(1.0 - k * k)
    let kk = elliptic_k(k)
    let ek = elliptic_e(k)
    let kkp = elliptic_k(kp)
    let ekp = elliptic_e(kp)
    let lhs = kk * ekp + ek * kkp - kk * kkp
    let expected = pi_val() / 2.0
    let tol = 1.0e-6
    print("  K*E'+E*K'-K*K'=")
    println(lhs)
    print("  pi/2=")
    println(expected)
    return abs_f64(lhs - expected) < tol
}

