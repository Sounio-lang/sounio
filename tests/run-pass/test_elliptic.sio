// Test 1: K(0) = pi/2 (tol 1e-10)
fn test_k_zero() -> bool with IO, Mut, Panic, Div {
    let got = elliptic_k(0.0)
    let expected = pi_val() / 2.0
    let tol = 1.0e-10
    print("  K(0)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 2: E(0) = pi/2 (tol 1e-10)
fn test_e_zero() -> bool with IO, Mut, Panic, Div {
    let got = elliptic_e(0.0)
    let expected = pi_val() / 2.0
    let tol = 1.0e-10
    print("  E(0)=")
    println(got)
    return abs_f64(got - expected) < tol
}

