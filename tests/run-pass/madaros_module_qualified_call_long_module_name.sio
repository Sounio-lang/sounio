//@ run-pass
//@ requires: madaros
//@ expect-stdout: LONG_MODULE_NAME PASS
//
// PR #2515 review round 2, finding C (comment_id 4089110718): the module-
// name registry this PR added (self-hosted/ir/lower.sio's
// LOWER_USE_MODULE_HASH, and its checker/specializer-side siblings) used to
// cap each stored segment at 64 bytes and silently omit anything longer,
// instead of the full 384-byte capacity `Name` actually supports -- a real
// module whose name exceeds 64 bytes still `use`d and typechecked fine, but
// its qualified calls fell back to the mangled body-less stub (SIGILL).
//
// testmod::module_name_that_is_definitely_longer_than_sixty_four_bytes_for_testing
// (stdlib/testmod/module_name_that_is_definitely_longer_than_sixty_four_bytes_for_testing.sio,
// added as this finding's witness fixture) is a 71-byte module name -- past
// the old cap, under the fixed one.
use testmod::module_name_that_is_definitely_longer_than_sixty_four_bytes_for_testing;

fn main() -> i32 with IO, Mut, Panic {
    let r: i64 = module_name_that_is_definitely_longer_than_sixty_four_bytes_for_testing::long_module_name_add(2, 3)
    if r == 1005 {
        println("LONG_MODULE_NAME PASS")
        return 0
    }
    println("LONG_MODULE_NAME FAIL")
    1
}
