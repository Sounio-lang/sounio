//@ run-pass
//@ expect-stdout: PASS
//@ known-failure: PTX .maxntid emission fails on both engines -- lean_single runs the test and it prints FAIL, Madaros aborts with "visibility preflight failed". Exposed (not caused) by the expect-stdout extraction fix: the assertion had been matching vacuously. Real GPU/PTX defect, deliberately NOT filed under the vacuous-annotation baseline, which is for wrong annotations.

use gpu::kaxi_backend::*
use gpu::kaxi_to_ptx::*

fn ptx_str_contains(haystack: string, needle: string) -> bool with Mut, Panic, Div {
    let hlen = str_len(haystack)
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if hlen < nlen { return false }
    var i: i64 = 0
    while i <= (hlen - nlen) {
        var j: i64 = 0
        var ok: bool = true
        while j < nlen {
            if str_char_at(haystack, i + j) != str_char_at(needle, j) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    false
}

fn main() with IO, Mut, Panic, Div, Alloc {
    var buf = kaxi_asm_new()
    buf = kaxi_asm_push_conf_budget(buf, 850)
    let ptx = kaxi_transpile_to_ptx_unified(buf, 0)
    // conf_budget=850 (≥800) → .maxntid 256, 1, 1
    if ptx_str_contains(ptx, ".maxntid 256, 1, 1") {
        println("PASS")
    } else {
        println("FAIL")
    }
}
