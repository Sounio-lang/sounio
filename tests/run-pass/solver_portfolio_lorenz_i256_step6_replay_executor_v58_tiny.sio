//@ run-pass
//@ description: Tiny portfolio v58 smoke for Lorenz i256 step-6 replay executor entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 583
    receipt_fp = mix(receipt_fp, 975464919, 4049)
    receipt_fp = mix(receipt_fp, 376630542, 4049)
    receipt_fp = mix(receipt_fp, 340418867, 4049)
    receipt_fp = mix(receipt_fp, 181028475, 4049)
    receipt_fp = mix(receipt_fp, 439805716, 4049)
    receipt_fp = mix(receipt_fp, 6, 4049)
    receipt_fp = mix(receipt_fp, 8, 4049)
    receipt_fp = mix(receipt_fp, 255, 4049)
    if receipt_fp != 864047360 { return 1 }

    var audit_fp: i64 = 587
    audit_fp = mix(audit_fp, receipt_fp, 4051)
    audit_fp = mix(audit_fp, 975464919, 4051)
    audit_fp = mix(audit_fp, 376630542, 4051)
    audit_fp = mix(audit_fp, 607197254, 4051)
    audit_fp = mix(audit_fp, 794872504, 4051)
    audit_fp = mix(audit_fp, 439805716, 4051)
    audit_fp = mix(audit_fp, 6, 4051)
    audit_fp = mix(audit_fp, 8, 4051)
    audit_fp = mix(audit_fp, 255, 4051)
    if audit_fp != 554149138 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 61, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 61, 1103)
    if entry_fp != 700476579 { return 3 }

    let manifest_fp: i64 = 15485832
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 58, 1871)
    result_fp = mix(result_fp, 62, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 50, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 710113089 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 58, 1907)
    family_fp = mix(family_fp, 62, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 45, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 394537262 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 58, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 30989952 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 58, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 6887223 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 58, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 686563909 { return 8 }
    return 0
}
