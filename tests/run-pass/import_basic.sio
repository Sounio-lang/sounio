//@ run-pass
// Test: basic module import resolution in lean driver mini-compiler.
// Validates that `use` declarations resolve relative paths,
// read imported files, and make their functions available.
//
// This test is designed for the lean driver native compile pipeline:
//   boot4.elf lean_driver.sio -- import_basic.sio output.elf
//
// The test itself is self-contained (no actual imports needed)
// since the import resolution is tested via the external test harness.
// This file validates that `use` lines at file scope are parsed
// without error by the mini-compiler (they are skipped as non-fn items).

use math::add::*

fn add(a: i64, b: i64) -> i64 {
    a + b
}

fn main() -> i64 with IO {
    let result = add(10, 32)
    print_int(result)
    print("\n")
    0
}
