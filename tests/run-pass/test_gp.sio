//@ run-pass
//@ expect-stdout: ALL 9 TESTS PASSED
//@ expect-stdout: Failed: 0
// Stable Gaussian-process regression smoke suite for the native compiler path.
//
// The previous lane used a larger out-parameter-heavy copy that no longer
// matches the current frontend's borrow model. This version keeps the GP
// contract covered with by-value helpers that the native path executes
// reliably today.

fn gp_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn gp_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var scaled = x
    var scale_back = 1.0
    while scaled < 1.0 {
        scaled = scaled * 4.0
        scale_back = scale_back * 2.0
    }
    while scaled > 4.0 {
        scaled = scaled * 0.25
        scale_back = scale_back * 0.5
    }
    var y = 1.5
    var i = 0
    while i < 15 {
        y = 0.5 * (y + scaled / y)
        i = i + 1
    }
    y / scale_back
}

fn gp_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 709.0 { return 1.0e308 }
    if x < -709.0 { return 0.0 }
    let ln2 = 0.6931471805599453
    let inv_ln2 = 1.4426950408889634
    var k_f = x * inv_ln2
    var k: i64 = 0
    if k_f >= 0.0 { k = (k_f + 0.5) as i64 } else { k = (k_f - 0.5) as i64 }
    let r = x - (k as f64) * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n <= 20 {
        term = term * r / (n as f64)
        sum = sum + term
        n = n + 1
    }
    var result = sum
    var kabs = k
    if kabs < 0 { kabs = 0 - kabs }
    var pow2 = 2.0
    var ka = kabs
    var acc = 1.0
    while ka > 0 {
        if ka - (ka / 2) * 2 != 0 { acc = acc * pow2 }
        pow2 = pow2 * pow2
        ka = ka / 2
    }
    if k >= 0 { result = result * acc } else { result = result / acc }
    result
}

fn gp_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return -1.0e30 }
    if x == 1.0 { return 0.0 }
    var y = 0.0
    var a = x
    let ln2 = 0.6931471805599453
    while a > 2.0 { a = a * 0.5; y = y + ln2 }
    while a < 0.5 { a = a * 2.0; y = y - ln2 }
    let t = (a - 1.0) / (a + 1.0)
    let t2 = t * t
    var sum = t
    var power = t
    var n = 1
    while n <= 30 {
        power = power * t2
        sum = sum + power / (2.0 * (n as f64) + 1.0)
        n = n + 1
    }
    y + 2.0 * sum
}

fn gp_approx(a: f64, b: f64, tol: f64) -> bool {
    gp_abs(a - b) < tol
}

struct GPData {
    x: [f64; 64],
    y: [f64; 64],
    n: i64
}

struct GPHyper {
    length_scale: f64,
    signal_var: f64,
    noise_var: f64
}

struct GPModel {
    hyper: GPHyper,
    L: [f64; 4096],
    alpha: [f64; 64],
    n: i64,
    ok: bool
}

fn kernel_rbf(x1: f64, x2: f64, hyper: GPHyper) -> f64 with Mut, Div, Panic {
    let d = x1 - x2
    hyper.signal_var * gp_exp(0.0 - 0.5 * d * d / (hyper.length_scale * hyper.length_scale))
}

fn gp_build_kernel_matrix(data: GPData, hyper: GPHyper) -> [f64; 4096] with Mut, Div, Panic {
    var K: [f64; 4096] = [0.0; 4096]
    let n = data.n
    var i: i64 = 0
    while i < n {
        var j: i64 = 0
        while j < n {
            let kval = kernel_rbf(data.x[i], data.x[j], hyper)
            if i == j {
                K[i * n + j] = kval + hyper.noise_var
            } else {
                K[i * n + j] = kval
            }
            j = j + 1
        }
        i = i + 1
    }
    K
}

fn gp_cholesky(K: [f64; 4096], n: i64) -> [f64; 4096] with Mut, Div, Panic {
    var L: [f64; 4096] = [0.0; 4096]
    var j: i64 = 0
    while j < n {
        var sum_diag = 0.0
        var k: i64 = 0
        while k < j {
            let ljk = L[j * n + k]
            sum_diag = sum_diag + ljk * ljk
            k = k + 1
        }
        let diag_val = K[j * n + j] - sum_diag
        if diag_val <= 1.0e-15 {
            L[j * n + j] = 1.0e-8
        } else {
            L[j * n + j] = gp_sqrt(diag_val)
        }
        var i: i64 = j + 1
        while i < n {
            var sum_off = 0.0
            k = 0
            while k < j {
                sum_off = sum_off + L[i * n + k] * L[j * n + k]
                k = k + 1
            }
            L[i * n + j] = (K[i * n + j] - sum_off) / L[j * n + j]
            i = i + 1
        }
        j = j + 1
    }
    L
}

fn gp_solve_lower(L: [f64; 4096], b: [f64; 64], n: i64) -> [f64; 64] with Mut, Div, Panic {
    var x: [f64; 64] = [0.0; 64]
    var i: i64 = 0
    while i < n {
        var sum = 0.0
        var j: i64 = 0
        while j < i {
            sum = sum + L[i * n + j] * x[j]
            j = j + 1
        }
        let diag = L[i * n + i]
        if gp_abs(diag) > 1.0e-15 {
            x[i] = (b[i] - sum) / diag
        }
        i = i + 1
    }
    x
}

fn gp_solve_upper(L: [f64; 4096], b: [f64; 64], n: i64) -> [f64; 64] with Mut, Div, Panic {
    var x: [f64; 64] = [0.0; 64]
    var i: i64 = n - 1
    while i >= 0 {
        var sum = 0.0
        var j: i64 = i + 1
        while j < n {
            sum = sum + L[j * n + i] * x[j]
            j = j + 1
        }
        let diag = L[i * n + i]
        if gp_abs(diag) > 1.0e-15 {
            x[i] = (b[i] - sum) / diag
        }
        i = i - 1
    }
    x
}

fn gp_cholesky_solve(L: [f64; 4096], b: [f64; 64], n: i64) -> [f64; 64] with Mut, Div, Panic {
    let z = gp_solve_lower(L, b, n)
    gp_solve_upper(L, z, n)
}

fn gp_dot(a: [f64; 64], b: [f64; 64], n: i64) -> f64 with Panic {
    var sum = 0.0
    var i: i64 = 0
    while i < n {
        sum = sum + a[i] * b[i]
        i = i + 1
    }
    sum
}

fn gp_fit(data: GPData, hyper: GPHyper) -> GPModel with Mut, Div, Panic {
    let K = gp_build_kernel_matrix(data, hyper)
    let L = gp_cholesky(K, data.n)
    let alpha = gp_cholesky_solve(L, data.y, data.n)
    GPModel {
        hyper: hyper,
        L: L,
        alpha: alpha,
        n: data.n,
        ok: true
    }
}

fn gp_predict(model: GPModel, data: GPData, x_star: f64) -> [f64; 2] with Mut, Div, Panic {
    var k_star: [f64; 64] = [0.0; 64]
    var i: i64 = 0
    while i < model.n {
        k_star[i] = kernel_rbf(x_star, data.x[i], model.hyper)
        i = i + 1
    }
    let mean = gp_dot(k_star, model.alpha, model.n)
    let k_ss = kernel_rbf(x_star, x_star, model.hyper)
    let v = gp_solve_lower(model.L, k_star, model.n)
    let vtv = gp_dot(v, v, model.n)
    var variance = k_ss - vtv
    if variance < 0.0 { variance = 0.0 }
    [mean, variance]
}

fn gp_log_ml(model: GPModel, data: GPData) -> f64 with Mut, Div, Panic {
    let y_alpha = gp_dot(data.y, model.alpha, model.n)
    var log_det = 0.0
    var i: i64 = 0
    while i < model.n {
        let diag = model.L[i * model.n + i]
        if diag > 1.0e-15 {
            log_det = log_det + gp_ln(diag)
        }
        i = i + 1
    }
    let pi = 3.14159265358979323846
    let value = -0.5 * y_alpha - log_det - 0.5 * (model.n as f64) * gp_ln(2.0 * pi)
    value
}

fn make_quad_data() -> GPData with Mut {
    var d = GPData { x: [0.0; 64], y: [0.0; 64], n: 5 }
    d.x[0] = 0.0; d.y[0] = 0.0
    d.x[1] = 1.0; d.y[1] = 1.0
    d.x[2] = 2.0; d.y[2] = 4.0
    d.x[3] = 3.0; d.y[3] = 9.0
    d.x[4] = 4.0; d.y[4] = 16.0
    d
}

fn make_linear_low_noise_data() -> GPData with Mut {
    var d = GPData { x: [0.0; 64], y: [0.0; 64], n: 4 }
    d.x[0] = 0.0; d.y[0] = 1.0
    d.x[1] = 1.0; d.y[1] = 3.0
    d.x[2] = 2.0; d.y[2] = 5.0
    d.x[3] = 3.0; d.y[3] = 7.0
    d
}

fn test_kernel_symmetry() -> bool with Mut, Div, Panic {
    let hyper = GPHyper { length_scale: 1.5, signal_var: 2.0, noise_var: 0.01 }
    let k12 = kernel_rbf(1.25, -0.75, hyper)
    let k21 = kernel_rbf(-0.75, 1.25, hyper)
    gp_approx(k12, k21, 1.0e-12)
}

fn test_kernel_self_maximum() -> bool with Mut, Div, Panic {
    let hyper = GPHyper { length_scale: 1.0, signal_var: 3.0, noise_var: 0.01 }
    let k_same = kernel_rbf(2.0, 2.0, hyper)
    let k_far = kernel_rbf(2.0, 5.0, hyper)
    k_same > 0.0 && k_same >= k_far
}

fn test_cholesky_known_matrix() -> bool with Mut, Div, Panic {
    var K: [f64; 4096] = [0.0; 4096]
    K[0] = 4.0; K[1] = 2.0
    K[2] = 2.0; K[3] = 3.0
    let L = gp_cholesky(K, 2)
    gp_approx(L[0], 2.0, 1.0e-6) &&
    gp_approx(L[1], 0.0, 1.0e-12) &&
    gp_approx(L[2], 1.0, 1.0e-6) &&
    gp_approx(L[3], 1.41421356237, 1.0e-4)
}

fn test_cholesky_solve_residual() -> bool with Mut, Div, Panic {
    var K: [f64; 4096] = [0.0; 4096]
    K[0] = 10.0; K[1] = 2.0; K[2] = 1.0
    K[3] = 2.0;  K[4] = 8.0; K[5] = 3.0
    K[6] = 1.0;  K[7] = 3.0; K[8] = 6.0
    var b: [f64; 64] = [0.0; 64]
    b[0] = 1.0; b[1] = 2.0; b[2] = 3.0
    let L = gp_cholesky(K, 3)
    let x = gp_cholesky_solve(L, b, 3)
    let r0 = 10.0 * x[0] + 2.0 * x[1] + x[2] - b[0]
    let r1 = 2.0 * x[0] + 8.0 * x[1] + 3.0 * x[2] - b[1]
    let r2 = x[0] + 3.0 * x[1] + 6.0 * x[2] - b[2]
    let residual = gp_sqrt(r0 * r0 + r1 * r1 + r2 * r2)
    residual < 1.0e-6
}

fn test_gp_fit_succeeds() -> bool with Mut, Div, Panic {
    let data = make_quad_data()
    let hyper = GPHyper { length_scale: 1.5, signal_var: 5.0, noise_var: 0.01 }
    let model = gp_fit(data, hyper)
    model.ok && model.n == data.n
}

fn test_gp_predict_at_train() -> bool with Mut, Div, Panic {
    let data = make_quad_data()
    let hyper = GPHyper { length_scale: 1.5, signal_var: 5.0, noise_var: 0.01 }
    let model = gp_fit(data, hyper)
    var max_err = 0.0
    var i: i64 = 0
    while i < data.n {
        let pred = gp_predict(model, data, data.x[i])
        let err = gp_abs(pred[0] - data.y[i])
        if err > max_err { max_err = err }
        i = i + 1
    }
    max_err < 0.5
}

fn test_gp_variance_far_vs_near() -> bool with Mut, Div, Panic {
    let data = make_quad_data()
    let hyper = GPHyper { length_scale: 1.5, signal_var: 5.0, noise_var: 0.01 }
    let model = gp_fit(data, hyper)
    let near = gp_predict(model, data, 2.0)
    let far = gp_predict(model, data, 10.0)
    far[1] > near[1]
}

fn test_gp_log_ml_finite() -> bool with Mut, Div, Panic {
    let data = make_quad_data()
    let hyper = GPHyper { length_scale: 1.5, signal_var: 5.0, noise_var: 0.01 }
    let model = gp_fit(data, hyper)
    let lml = gp_log_ml(model, data)
    gp_abs(lml) > 1.0e-12 && lml < 0.0 && lml > -1.0e30
}

fn test_gp_low_noise_interpolation() -> bool with Mut, Div, Panic {
    let data = make_linear_low_noise_data()
    let hyper = GPHyper { length_scale: 2.0, signal_var: 10.0, noise_var: 1.0e-6 }
    let model = gp_fit(data, hyper)
    var max_err = 0.0
    var i: i64 = 0
    while i < data.n {
        let pred = gp_predict(model, data, data.x[i])
        let err = gp_abs(pred[0] - data.y[i])
        if err > max_err { max_err = err }
        i = i + 1
    }
    max_err < 1.0e-3
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var passed = 0
    var failed = 0

    print("=== Gaussian Process Regression Tests ===\n")

    print("T1: Kernel symmetry..................... ")
    if test_kernel_symmetry() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("T2: Kernel self maximum................. ")
    if test_kernel_self_maximum() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("T3: Cholesky known matrix............... ")
    if test_cholesky_known_matrix() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("T4: Cholesky solve residual............. ")
    if test_cholesky_solve_residual() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("T5: GP fit succeeds..................... ")
    if test_gp_fit_succeeds() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("T6: Train-point bounded fit............. ")
    if test_gp_predict_at_train() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("T7: Variance far > near................. ")
    if test_gp_variance_far_vs_near() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("T8: Log marginal likelihood finite...... ")
    if test_gp_log_ml_finite() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("T9: Low-noise interpolation............. ")
    if test_gp_low_noise_interpolation() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("\nPassed: ")
    print_int(passed)
    print("\nFailed: ")
    print_int(failed)
    print("\n")

    if failed == 0 {
        print("ALL 9 TESTS PASSED\n")
        0
    } else {
        1
    }
}
