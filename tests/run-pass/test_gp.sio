// MAIN
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    var pass = 0
    var fail = 0

    // Test 1
    print("Test  1: RBF kernel at same point = signal_var ... ")
    if test_rbf_same_point() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 2
    print("Test  2: RBF kernel symmetry k(x,y) = k(y,x) ... ")
    if test_rbf_symmetry() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 3
    print("Test  3: RBF kernel decays with distance ... ")
    if test_rbf_decay() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 4
    print("Test  4: Cholesky of known SPD matrix ... ")
    if test_cholesky_known() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 5
    print("Test  5: Cholesky solve accuracy ... ")
    if test_cholesky_solve() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 6
    print("Test  6: GP predict at training points ... ")
    if test_gp_predict_at_train() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 7
    print("Test  7: GP variance at training points small ... ")
    if test_gp_variance_at_train() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 8
    print("Test  8: GP variance increases away from data ... ")
    if test_gp_variance_away() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 9
    print("Test  9: GP log marginal likelihood finite ... ")
    if test_gp_log_ml_finite() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 10
    print("Test 10: GP posterior mean interpolates ... ")
    if test_gp_interpolation() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 11
    print("Test 11: Matern 3/2 kernel positive ... ")
    if test_matern32_positive() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 12
    print("Test 12: Periodic kernel periodicity ... ")
    if test_periodic_kernel() {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    println("")
    print("Passed: "); println(pass as string)
    print("Failed: "); println(fail as string)
    println("")
    if fail == 0 {
        println("ALL 12 TESTS PASSED")
        return 0
    } else {
        println("SOME TESTS FAILED")
        return 1
    }
}
