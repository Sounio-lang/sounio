//@ run-pass
//@ requires: madaros
//@ check-only
//@ description: Check-only BallFixedEnclosure record schema over the scalar Lorenz final box receipt

struct BallFixedEnclosure1 {
    scale: i64,
    center: i64,
    radius: i64,
    lo: i64,
    hi: i64,
    status_mask: i64,
    fingerprint: i64,
}

struct BallFixedEnclosure3 {
    scale: i64,
    center_x: i64,
    center_y: i64,
    center_z: i64,
    radius_x: i64,
    radius_y: i64,
    radius_z: i64,
    x_lo: i64,
    x_hi: i64,
    y_lo: i64,
    y_hi: i64,
    z_lo: i64,
    z_hi: i64,
    axis_mask: i64,
    fingerprint: i64,
}

fn bf_bound_lo(center: i64, radius: i64) -> i64 {
    return center - radius
}

fn bf_bound_hi(center: i64, radius: i64) -> i64 {
    return center + radius
}

fn bf_bounds_match(center: i64, radius: i64, lo: i64, hi: i64) -> i64 {
    if radius < 0 { return 0 }
    if lo != bf_bound_lo(center, radius) { return 0 }
    if hi != bf_bound_hi(center, radius) { return 0 }
    return 1
}

fn bf_contains_value(center: i64, radius: i64, value: i64) -> i64 {
    if radius < 0 { return 0 }
    if value < bf_bound_lo(center, radius) { return 0 }
    if value > bf_bound_hi(center, radius) { return 0 }
    return 1
}

fn enclosure_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 353) % 1000000007
}

fn enclosure1_status_mask(scale: i64, center: i64, radius: i64,
                          lo: i64, hi: i64) -> i64 {
    var mask: i64 = 0
    if scale > 0 { mask = mask + 1 }
    if radius >= 0 { mask = mask + 2 }
    if bf_bounds_match(center, radius, lo, hi) == 1 { mask = mask + 4 }
    return mask
}

fn enclosure1_fingerprint(scale: i64, center: i64, radius: i64,
                          lo: i64, hi: i64,
                          expected_mask: i64) -> i64 {
    let mask = enclosure1_status_mask(scale, center, radius, lo, hi)
    if mask != expected_mask { return 0 - 1 }
    if mask != 7 { return 0 - 1 }

    var acc: i64 = 31
    acc = enclosure_mix(acc, scale)
    acc = enclosure_mix(acc, center)
    acc = enclosure_mix(acc, radius)
    acc = enclosure_mix(acc, lo)
    acc = enclosure_mix(acc, hi)
    acc = enclosure_mix(acc, mask)
    return acc
}

fn enclosure3_axis_mask(scale: i64,
                        center_x: i64, center_y: i64, center_z: i64,
                        radius_x: i64, radius_y: i64, radius_z: i64,
                        x_lo: i64, x_hi: i64,
                        y_lo: i64, y_hi: i64,
                        z_lo: i64, z_hi: i64) -> i64 {
    var mask: i64 = 0
    if enclosure1_status_mask(scale, center_x, radius_x, x_lo, x_hi) == 7 {
        mask = mask + 1
    }
    if enclosure1_status_mask(scale, center_y, radius_y, y_lo, y_hi) == 7 {
        mask = mask + 2
    }
    if enclosure1_status_mask(scale, center_z, radius_z, z_lo, z_hi) == 7 {
        mask = mask + 4
    }
    return mask
}

fn enclosure3_fingerprint(scale: i64,
                          center_x: i64, center_y: i64, center_z: i64,
                          radius_x: i64, radius_y: i64, radius_z: i64,
                          x_lo: i64, x_hi: i64,
                          y_lo: i64, y_hi: i64,
                          z_lo: i64, z_hi: i64,
                          expected_axis_mask: i64) -> i64 {
    let axis_mask = enclosure3_axis_mask(
        scale, center_x, center_y, center_z,
        radius_x, radius_y, radius_z,
        x_lo, x_hi, y_lo, y_hi, z_lo, z_hi)
    if axis_mask != expected_axis_mask { return 0 - 1 }
    if axis_mask != 7 { return 0 - 1 }

    let x_fp = enclosure1_fingerprint(scale, center_x, radius_x, x_lo, x_hi, 7)
    let y_fp = enclosure1_fingerprint(scale, center_y, radius_y, y_lo, y_hi, 7)
    let z_fp = enclosure1_fingerprint(scale, center_z, radius_z, z_lo, z_hi, 7)
    if x_fp < 0 { return 0 - 1 }
    if y_fp < 0 { return 0 - 1 }
    if z_fp < 0 { return 0 - 1 }

    var acc: i64 = 47
    acc = enclosure_mix(acc, scale)
    acc = enclosure_mix(acc, axis_mask)
    acc = enclosure_mix(acc, x_fp)
    acc = enclosure_mix(acc, y_fp)
    acc = enclosure_mix(acc, z_fp)
    return acc
}

fn lorenz_final_enclosure_fingerprint(trajectory_manifest_fp: i64,
                                      quality_profile_fp: i64,
                                      radius_budget_fp: i64,
                                      scale: i64,
                                      center_x: i64, center_y: i64, center_z: i64,
                                      radius_x: i64, radius_y: i64, radius_z: i64,
                                      x_lo: i64, x_hi: i64,
                                      y_lo: i64, y_hi: i64,
                                      z_lo: i64, z_hi: i64,
                                      axis_mask: i64) -> i64 {
    if trajectory_manifest_fp != 508132668 { return 0 - 1 }
    if quality_profile_fp != 70877465 { return 0 - 1 }
    if radius_budget_fp != 565673886 { return 0 - 1 }
    let enclosure_fp = enclosure3_fingerprint(
        scale, center_x, center_y, center_z,
        radius_x, radius_y, radius_z,
        x_lo, x_hi, y_lo, y_hi, z_lo, z_hi,
        axis_mask)
    if enclosure_fp != 166945519 { return 0 - 1 }

    var acc: i64 = 181
    acc = enclosure_mix(acc, trajectory_manifest_fp)
    acc = enclosure_mix(acc, quality_profile_fp)
    acc = enclosure_mix(acc, radius_budget_fp)
    acc = enclosure_mix(acc, enclosure_fp)
    acc = enclosure_mix(acc, axis_mask)
    return acc
}

fn main() -> i64 {
    let ex = BallFixedEnclosure1 {
        scale: 1000000,
        center: 1236316,
        radius: 243366,
        lo: 992950,
        hi: 1479682,
        status_mask: enclosure1_status_mask(1000000, 1236316, 243366, 992950, 1479682),
        fingerprint: enclosure1_fingerprint(1000000, 1236316, 243366, 992950, 1479682, 7),
    }
    if ex.status_mask != 7 { return 1 }
    if ex.fingerprint != 781503653 { return 2 }
    if ex.scale != 1000000 { return 17 }
    if ex.center != 1236316 { return 18 }
    if ex.radius != 243366 { return 19 }
    if ex.lo != 992950 { return 20 }
    if ex.hi != 1479682 { return 21 }
    if enclosure1_fingerprint(ex.scale, ex.center, ex.radius,
                              ex.lo, ex.hi, ex.status_mask) != ex.fingerprint { return 3 }
    if bf_contains_value(ex.center, ex.radius, 1479682) != 1 { return 4 }
    if bf_contains_value(ex.center, ex.radius, 1479683) != 0 { return 5 }

    let bad = BallFixedEnclosure1 {
        scale: 1000000,
        center: 1236316,
        radius: 243366,
        lo: 992951,
        hi: 1479682,
        status_mask: enclosure1_status_mask(1000000, 1236316, 243366, 992951, 1479682),
        fingerprint: enclosure1_fingerprint(1000000, 1236316, 243366, 992951, 1479682, 3),
    }
    if bad.status_mask != 3 { return 6 }
    if bad.fingerprint != (0 - 1) { return 7 }

    let e3 = BallFixedEnclosure3 {
        scale: 1000000,
        center_x: 1236316,
        center_y: 2341979,
        center_z: 951078,
        radius_x: 243366,
        radius_y: 319640,
        radius_z: 42448,
        x_lo: 992950,
        x_hi: 1479682,
        y_lo: 2022339,
        y_hi: 2661619,
        z_lo: 908630,
        z_hi: 993526,
        axis_mask: enclosure3_axis_mask(
            1000000, 1236316, 2341979, 951078,
            243366, 319640, 42448,
            992950, 1479682, 2022339, 2661619, 908630, 993526),
        fingerprint: enclosure3_fingerprint(
            1000000, 1236316, 2341979, 951078,
            243366, 319640, 42448,
            992950, 1479682, 2022339, 2661619, 908630, 993526,
            7),
    }
    if e3.axis_mask != 7 { return 8 }
    if e3.fingerprint != 166945519 { return 9 }
    if enclosure3_fingerprint(e3.scale, e3.center_x, e3.center_y, e3.center_z,
                              e3.radius_x, e3.radius_y, e3.radius_z,
                              e3.x_lo, e3.x_hi, e3.y_lo, e3.y_hi, e3.z_lo, e3.z_hi,
                              e3.axis_mask) != e3.fingerprint { return 10 }
    if bf_contains_value(e3.center_x, e3.radius_x, 992950) != 1 { return 11 }
    if bf_contains_value(e3.center_y, e3.radius_y, 2022339) != 1 { return 12 }
    if bf_contains_value(e3.center_z, e3.radius_z, 908630) != 1 { return 13 }
    if bf_contains_value(e3.center_x, e3.radius_x, 992949) != 0 { return 14 }
    if lorenz_final_enclosure_fingerprint(
        508132668, 70877465, 565673886,
        e3.scale, e3.center_x, e3.center_y, e3.center_z,
        e3.radius_x, e3.radius_y, e3.radius_z,
        e3.x_lo, e3.x_hi, e3.y_lo, e3.y_hi, e3.z_lo, e3.z_hi,
        e3.axis_mask) != 114244647 { return 15 }
    if lorenz_final_enclosure_fingerprint(
        508132669, 70877465, 565673886,
        e3.scale, e3.center_x, e3.center_y, e3.center_z,
        e3.radius_x, e3.radius_y, e3.radius_z,
        e3.x_lo, e3.x_hi, e3.y_lo, e3.y_hi, e3.z_lo, e3.z_hi,
        e3.axis_mask) != (0 - 1) { return 16 }

    return 0
}
