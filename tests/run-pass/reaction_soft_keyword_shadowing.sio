//@ run-pass
//@ expect-stdout: shadowing ok
// `reaction` is a SOFT keyword, following the `unit` precedent: it introduces a
// declaration only in the position `reaction NAME {`. Everywhere else it stays
// an ordinary identifier, so adding this feature is not a breaking change for
// existing programs that already use the word.
//
// This test pins that guarantee: `reaction` as a function name, as a local
// binding, and as an operand must all keep compiling and running.

fn reaction(x: i64) -> i64 { x + 1 }

fn main() with IO, Mut, Panic {
    // `reaction` as a call target
    let called = reaction(41)
    // `reaction` as a local binding, shadowing the function
    let reaction = 7
    // `reaction` as an operand
    var sum = reaction + 1

    println("shadowing ok")
    print_int(called)
    print_int(reaction)
    print_int(sum)
}
