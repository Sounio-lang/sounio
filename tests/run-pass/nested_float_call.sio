//@ run-pass
//@ requires: madaros
//@ expect-stdout: 103:nested-float-ok
// SIO-574: a nested float-returning call g(f(*p + 1.0)) over a raw pointer
// checks, compiles and runs. Cured on main by the SIO-556 float-ness fix
// (direct *mut f64 derefs resolve instead of taking the deep refusal path
// that overflowed the 8MB stack); pinned here against regression.
extern fn heap_alloc(n: i64) -> *mut u8
fn f(p: *mut f64) -> f64 {
    *p + 1.0
}
fn g(x: f64) -> i64 {
    x as i64
}
fn main() -> i64 with IO, Mut {
    let p = heap_alloc(8)
    *((p as i64) as *mut f64) = 102.0
    print_int(g(f((p as i64) as *mut f64)))
    print(":nested-float-ok")
    println("")
    return 0
}
