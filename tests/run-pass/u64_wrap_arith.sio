//@ run-pass
//@ requires: madaros
//@ expect-stdout: 0
//@ expect-stdout: 18446744073709551615
//@ expect-stdout: 18446744073709551614
//@ expect-stdout: U64_WRAP_PASS

// SIO-588: unsigned +, -, * wrap (no SIO-207 trap) on u64 operands. The
// id() indirection keeps the operands out of const folding so the runtime
// UAdd/USub/UMul path is exercised: MAX+1 wraps to 0, 0-1 wraps to MAX,
// MAX*2 wraps to MAX-1. A signed-overflow trap here would fail the run.
fn id(x: u64) -> u64 { x }

fn main() -> i32 with IO {
    let m: u64 = id(18446744073709551615)
    println(m + 1)
    let z: u64 = id(0)
    println(z - 1)
    println(m * 2)
    if m + 1 == 0 && z - 1 == 18446744073709551615 && m * 2 == 18446744073709551614 {
        print("U64_WRAP_PASS\n")
    }
    return 0
}
