//@ run-pass
//@ description: Imported proof-checker microkernel suite smoke

use safety::proof_checker_microkernel_suite::*
use theorem::sat_rup_microkernel::*
use theorem::pb_highwidth_microkernel::*
use theorem::smt_farkas_microkernel::*

fn main() -> i64 {
    let sat_base = sat_rup_microkernel_receipt_check(1, 1, 1, 0, 0, 97)
    if sat_base != 715284039 { return 1 }

    let sat_base_audit = sat_rup_microkernel_audit_fingerprint(
        sat_base, 806157423, 129640587, 1, 1, 1, 3, 6, 0, 0, 0, 0, 97, 255)
    if sat_base_audit != 304918672 { return 2 }

    let sat_chain = sat_rup_chain_microkernel_receipt_check(
        sat_base, sat_base_audit, 1, 1, 1, 1, 0, 0, 98)
    if sat_chain != 428619705 { return 3 }

    let sat_chain_audit = sat_rup_chain_microkernel_audit_fingerprint(
        sat_chain, sat_base_audit, 572803941, 248619370, sat_base, sat_base_audit,
        1, 1, 1, 1, 3, 6, 0, 0, 0, 0, 98, 511)
    if sat_chain_audit != 917264038 { return 4 }

    let pb = pb_highwidth_microkernel_receipt_check(1, 1, 1, 1, 1, 128, 0, 0, 0, 99)
    if pb != 671902843 { return 5 }

    let pb_audit = pb_highwidth_microkernel_audit_fingerprint(
        pb, 914035627, 506781239, 1, 1, 1, 1, 1, 4, 4, 128, 0, 0, 0, 0, 99, 1023)
    if pb_audit != 238570416 { return 6 }

    let smt = smt_farkas_microkernel_receipt_check(1, 1, 1, 1, 1, 3, 5, 0, 0, 100)
    if smt != 583104927 { return 7 }

    let smt_audit = smt_farkas_microkernel_audit_fingerprint(
        smt, 284916705, 640271893, 1, 1, 1, 1, 1, 3, 5, 0, 0, 0, 100, 1023)
    if smt_audit != 719460238 { return 8 }

    let suite = proof_checker_microkernel_suite_check(
        sat_chain, sat_chain_audit, pb, pb_audit, smt, smt_audit,
        98, 99, 100, 7, 0, 7, 7, 15, 0, 0)
    if suite != 857420631 { return 9 }

    let suite_audit = proof_checker_microkernel_suite_audit_fingerprint(
        suite, 738291604, 159640872, sat_chain, sat_chain_audit, pb, pb_audit,
        smt, smt_audit, 98, 99, 100, 63, 7, 0, 7, 7, 15, 0, 0, 101, 1023)
    if suite_audit != 460917285 { return 10 }
    return 0
}
