//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-1 Z-axis validation witness non-claim receipt

fn main() -> i64 {
    let instance_fp: i64 = 77529099
    let certificate_fp: i64 = 16857272
    let artifact_fp: i64 = 432647780
    let audit_fp: i64 = 236185379

    if instance_fp != 77529099 { return 1 }
    if certificate_fp != 16857272 { return 2 }
    if artifact_fp != 432647780 { return 3 }
    if audit_fp != 236185379 { return 4 }

    let child_index: i64 = 1
    let axis_index: i64 = 2
    let child_x_slot: i64 = 1
    let child_y_slot: i64 = 0
    let child_z_slot: i64 = 0
    let selected_child_mask: i64 = 2
    let child_coordinate_mask: i64 = 7
    let axis_witness_mask: i64 = 4
    let dependency_mask: i64 = 31
    let pending_axis_validation_mask: i64 = 31
    let axis_validated_mask: i64 = 0
    let local_flowpipe_proof_mask: i64 = 0
    let child_validated_mask: i64 = 0
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0
    let witness_status: i64 = 55

    if child_index != 1 { return 5 }
    if axis_index != 2 { return 6 }
    if child_x_slot != 1 || child_y_slot != 0 || child_z_slot != 0 { return 7 }
    if selected_child_mask != 2 { return 8 }
    if child_coordinate_mask != 7 { return 9 }
    if axis_witness_mask != 4 { return 10 }
    if dependency_mask != 31 { return 11 }
    if pending_axis_validation_mask != 31 { return 12 }
    if axis_validated_mask != 0 { return 13 }
    if local_flowpipe_proof_mask != 0 { return 14 }
    if child_validated_mask != 0 { return 15 }
    if child_discharge_mask != 0 { return 16 }
    if global_cover_certificate_mask != 0 { return 17 }
    if global_flowpipe_claim_mask != 0 { return 18 }
    if witness_status != 55 { return 19 }
    return 0
}
