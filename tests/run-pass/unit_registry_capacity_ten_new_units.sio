//@ run-pass
//@ requires: madaros
//@ expect-stdout: UNIT_REGISTRY_CAPACITY_OK
// The checker-side unit registry (self-hosted/check/units.sio) held 32 entries and
// register_builtin_units alone claimed 27 of them -- 5 free. UnitRegistry::register
// silently no-ops past capacity, and checker_collect_unit_decl_inplace never checked
// for that. Ten new `unit NAME;` declarations, six past the old headroom, each used
// as a distinct parameter type: if the registry dropped one, its later use would
// either misresolve to whatever unit ends up at find()'s -1 (a checker crash or a
// silently wrong type) or alias an EARLIER declared unit by falling through to a
// stale slot. The table now holds 128 and register() reports capacity exhaustion
// instead of dropping silently.

unit unitA1;
unit unitA2;
unit unitA3;
unit unitA4;
unit unitA5;
unit unitA6;
unit unitA7;
unit unitA8;
unit unitA9;
unit unitA10;

fn take1(x: unitA1) -> f64 with Mut { x as f64 }
fn take2(x: unitA2) -> f64 with Mut { x as f64 }
fn take3(x: unitA3) -> f64 with Mut { x as f64 }
fn take4(x: unitA4) -> f64 with Mut { x as f64 }
fn take5(x: unitA5) -> f64 with Mut { x as f64 }
fn take6(x: unitA6) -> f64 with Mut { x as f64 }
fn take7(x: unitA7) -> f64 with Mut { x as f64 }
fn take8(x: unitA8) -> f64 with Mut { x as f64 }
fn take9(x: unitA9) -> f64 with Mut { x as f64 }
fn take10(x: unitA10) -> f64 with Mut { x as f64 }

fn main() -> i32 with IO, Mut, Panic, Div {
    let a1: unitA1 = 1.0
    let a2: unitA2 = 2.0
    let a3: unitA3 = 3.0
    let a4: unitA4 = 4.0
    let a5: unitA5 = 5.0
    let a6: unitA6 = 6.0
    let a7: unitA7 = 7.0
    let a8: unitA8 = 8.0
    let a9: unitA9 = 9.0
    let a10: unitA10 = 10.0

    let s = take1(a1) + take2(a2) + take3(a3) + take4(a4) + take5(a5)
          + take6(a6) + take7(a7) + take8(a8) + take9(a9) + take10(a10)

    if s == 55.0 {
        println("UNIT_REGISTRY_CAPACITY_OK")
        return 0
    }
    println("UNIT_REGISTRY_CAPACITY_FAIL")
    1
}
