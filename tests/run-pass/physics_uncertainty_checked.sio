use units::lib::*
use physics::classical::{classical_force_checked,classical_ke_checked,classical_pos_checked}
use physics::sr::*
use physics::uncertainty::{PhysicsScalarResult,PhysicsPairResult}
fn scalar(id:i64,r:&PhysicsScalarResult) with IO,Panic {
 print("PHYSICS_SCALAR ");print_int(id);print(" ");print_int(r.status);print(" ");print_int(f64_to_bits(r.value));print(" ");print_int(f64_to_bits(r.standard_uncertainty));print(" ");print_int(r.uncertainty_model);print(" ");print_int(if r.first_order {1}else{0});println("")
 assert(r.status==0)
}
fn pair(id:i64,r:&PhysicsPairResult) with IO,Mut,Div,Panic {
 print("PHYSICS_PAIR ");print_int(id);print(" ");print_int(r.status)
 var i:i64=0
 while i<2 {print(" ");print_int(f64_to_bits(r.values[i]));i=i+1}
 i=0;while i<2 {print(" ");print_int(f64_to_bits(r.standard_uncertainties[i]));i=i+1}
 i=0;while i<4 {print(" ");print_int(f64_to_bits(r.covariance[i]));i=i+1}
 print(" ");print_int(r.uncertainty_model);print(" ");print_int(if r.first_order {1}else{0});println("")
 assert(r.status==0)
}
fn unavailable(id:i64,expected:i64,r:&PhysicsScalarResult) with IO,Panic {
 assert(r.status==expected);assert(r.value==0.0);assert(r.standard_uncertainty==0.0);assert(r.uncertainty_model==1);assert(r.first_order)
 print("PHYSICS_UNAVAILABLE ");print_int(id);print(" ");print_int(r.status);println("")
}
fn pair_unavailable(id:i64,expected:i64,r:&PhysicsPairResult) with IO,Mut,Div,Panic {
 assert(r.status==expected);var i:i64=0
 while i<2 {assert(r.values[i]==0.0);assert(r.standard_uncertainties[i]==0.0);i=i+1}
 i=0;while i<4 {assert(r.covariance[i]==0.0);i=i+1}
 assert(r.uncertainty_model==1);assert(r.first_order)
 print("PHYSICS_PAIR_UNAVAILABLE ");print_int(id);print(" ");print_int(r.status);println("")
}
