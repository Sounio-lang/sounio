//@ run-pass
//@ description: #2779 — a parenthesised block-like expression is closed by `)`, so a newline-led operator continues it
//@ expect-stdout: 2
//@ expect-stdout: 13
//@ expect-stdout: 7

fn main() -> i64 with IO {
    let a = true
    let n: i64 = (if a { 1 } else { 0 })
        + 1
    println(n)
    let k: i64 = (match 3 { 3 => 10, _ => 0 })
        + (if a { 3 } else { 0 })
    println(k)
    // Control: an unparenthesised `if` statement still ends at the newline, so
    // `-1` below is its own expression statement and `m` keeps its value.
    var m: i64 = 7
    if a { m = 7 } else { m = 0 }
    -1
    println(m)
    0
}
