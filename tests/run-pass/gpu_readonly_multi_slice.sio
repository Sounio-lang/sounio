//@ run-pass
//@ expect-stdout: PASS: GPU readonly multi-slice

kernel fn readonly_multi_slice(n: i64, a: &[f64], b: &[f64], c: &![f64]) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        c[tid as usize] = a[tid as usize] + b[tid as usize]
    }
}

fn main() -> i32 with IO, Mut, Panic, GPU {
    var left: [f64; 128] = [0.0; 128]
    var right: [f64; 128] = [0.0; 128]
    var out: [f64; 128] = [0.0; 128]

    var i: i64 = 0
    while i < 128 {
        left[i as usize] = (i as f64) + 1.0
        right[i as usize] = (i as f64) * 4.0
        i = i + 1
    }

    readonly_multi_slice(128, &left, &right, &!out)

    if out[0] > 0.99 && out[0] < 1.01 &&
       out[1] > 5.99 && out[1] < 6.01 &&
       out[127] > 635.99 && out[127] < 636.01 {
        println("PASS: GPU readonly multi-slice")
    } else {
        println("FAIL: GPU readonly multi-slice")
    }
    0
}
