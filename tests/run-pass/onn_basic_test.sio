//@ run-pass
// Basic ONN (Octonion Neural Network) functionality test

// Test octonion creation and basic operations
fn main() {
    // Create test octonions
    let o1 = Octonion { w: 1.0, x: 2.0, y: 3.0, z: 4.0, t: 5.0, u: 6.0, v: 7.0, s: 8.0 }
    let o2 = Octonion { w: 0.5, x: 0.5, y: 0.5, z: 0.5, t: 0.5, u: 0.5, v: 0.5, s: 0.5 }

    // Test norm computation
    // |o1|^2 = 1 + 4 + 9 + 16 + 25 + 36 + 49 + 64 = 204
    let norm_sq = o1.w * o1.w + o1.x * o1.x + o1.y * o1.y + o1.z * o1.z
                + o1.t * o1.t + o1.u * o1.u + o1.v * o1.v + o1.s * o1.s
    assert(abs(norm_sq - 204.0) < 0.001)

    // Test unit octonion
    let unit = Octonion { w: 1.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 }
    let unit_norm = sqrt(unit.w * unit.w + unit.x * unit.x + unit.y * unit.y + unit.z * unit.z
                       + unit.t * unit.t + unit.u * unit.u + unit.v * unit.v + unit.s * unit.s)
    assert(abs(unit_norm - 1.0) < 0.001)

    print("ONN basic test passed!")
}

// Octonion struct (should match stdlib/onn/mod.sio)
struct Octonion {
    w: f32,
    x: f32,
    y: f32,
    z: f32,
    t: f32,
    u: f32,
    v: f32,
    s: f32,
}

fn abs(x: f32) -> f32 {
    if x < 0.0 { -x } else { x }
}

fn sqrt(x: f32) -> f32 {
    // Newton-Raphson approximation
    var guess = x / 2.0
    for i in 0..10 {
        guess = (guess + x / guess) / 2.0
    }
    guess
}
