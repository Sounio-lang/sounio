//@ run-pass
//@ description: Self-contained Erdős SAT/SMT/UNSAT scope-gate runtime mirror

fn problem_kind(problem_id: i64) -> i64 {
    if problem_id == 90 { return 1 }
    if problem_id == 508 { return 2 }
    if problem_id == 704 { return 3 }
    return 0
}

fn chi_lower_bound_preflight(
    problem_id: i64,
    claimed_lower_bound: i64,
    has_concrete_unit_distance_graph: i64,
    unsat_colour_count: i64,
    independent_replay_mask: i64) -> i64 {
    if problem_id != 508 { return 0 }
    if claimed_lower_bound < 5 { return 0 }
    if has_concrete_unit_distance_graph != 1 { return 0 }
    if independent_replay_mask != 31 { return 0 }
    if unsat_colour_count + 1 != claimed_lower_bound { return 0 }
    return 1
}

fn chi6_preflight(
    problem_id: i64,
    has_concrete_unit_distance_graph: i64,
    five_colour_unsat_certificate: i64,
    independent_replay_mask: i64) -> i64 {
    return chi_lower_bound_preflight(
        problem_id,
        6,
        has_concrete_unit_distance_graph,
        five_colour_unsat_certificate,
        independent_replay_mask)
}

fn erdos90_external_scope(
    problem_id: i64,
    has_infinite_family: i64,
    exponent_excess_positive: i64,
    human_verified_digest: i64,
    formalized_in_sounio: i64) -> i64 {
    if problem_id != 90 { return 0 }
    if has_infinite_family != 1 { return 0 }
    if exponent_excess_positive != 1 { return 0 }
    if human_verified_digest != 1 { return 0 }
    if formalized_in_sounio != 0 { return 0 }
    return 1
}

fn unsat_acceptance_gate(
    solver_result: i64,
    proof_format: i64,
    independent_checker_ok: i64,
    kernel_replay_ok: i64,
    scope_gate_ok: i64) -> i64 {
    if solver_result != 0 { return 0 }
    if proof_format < 1 { return 0 }
    if proof_format > 4 { return 0 }
    if independent_checker_ok != 1 { return 0 }
    if kernel_replay_ok != 1 { return 0 }
    if scope_gate_ok != 1 { return 0 }
    return 1
}

fn main() -> i64 {
    if problem_kind(90) != 1 { return 1 }
    if problem_kind(508) != 2 { return 2 }
    if problem_kind(704) != 3 { return 3 }

    let chi5_scope = chi_lower_bound_preflight(508, 5, 1, 4, 31)
    if chi5_scope != 1 { return 4 }

    if chi6_preflight(508, 1, 5, 31) != 1 { return 5 }
    if chi6_preflight(90, 1, 5, 31) != 0 { return 6 }
    if chi6_preflight(508, 0, 5, 31) != 0 { return 7 }
    if chi6_preflight(508, 1, 4, 31) != 0 { return 8 }
    if chi6_preflight(508, 1, 5, 15) != 0 { return 9 }

    if erdos90_external_scope(90, 1, 1, 1, 0) != 1 { return 10 }
    if erdos90_external_scope(90, 1, 1, 1, 1) != 0 { return 11 }

    if unsat_acceptance_gate(0, 1, 1, 1, chi5_scope) != 1 { return 12 }
    if unsat_acceptance_gate(0, 1, 0, 0, chi5_scope) != 0 { return 13 }
    if unsat_acceptance_gate(1, 1, 1, 1, chi5_scope) != 0 { return 14 }

    return 0
}
