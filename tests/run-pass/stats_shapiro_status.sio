//@ run-pass
//@ expect-stdout: STATS_SHAPIRO_STATUS_PASS
use stats::shapiro_wilk::{shapiro_wilk}
use stats::regression::assessments::{assess_simple_linear}
fn abs(v:f64)->f64 {if v<0.0{return -v} return v}
fn main() with IO,Mut,Div,Panic {
 var x:[f64;100]=[0.0;100]
 assert(shapiro_wilk(&x,2).status==1)
 assert(shapiro_wilk(&x,101).status==1)
 assert(shapiro_wilk(&x,3).status==3)
 x[0]=0.0/0.0
 assert(shapiro_wilk(&x,3).status==2)
 x[0]=1.0e308*2.0
 assert(shapiro_wilk(&x,3).status==2)
 x[0]=0.0;x[1]=1.0;x[2]=2.0
 let symmetric=shapiro_wilk(&x,3)
 assert(symmetric.status==0 && symmetric.calibration==0 && !symmetric.p_approximate)
 assert(abs(symmetric.w-1.0)<1.0e-14 && abs(symmetric.p-1.0)<1.0e-14)
 x[1]=0.0;x[2]=1.0
 let duplicate=shapiro_wilk(&x,3)
 assert(duplicate.status==0 && duplicate.has_ties && abs(duplicate.w-0.75)<1.0e-14 && duplicate.p<1.0e-14)
 x[0]=4.0;x[1]=1.0;x[2]=3.0;x[3]=2.0
 let unsorted=shapiro_wilk(&x,4)
 assert(x[0]==4.0 && x[1]==1.0 && x[3]==2.0)
 assert(unsorted.status==0 && unsorted.calibration==1 && unsorted.p_approximate && !unsorted.has_ties)
 var i:i64=0
 while i<12 {x[i as usize]=i as f64;i=i+1}
 let large=shapiro_wilk(&x,12)
 assert(large.status==0 && large.calibration==2 && large.p_approximate)
 var y:[f64;100]=[0.0;100]
 i=0
 while i<12 {y[i as usize]=2.0+3.0*x[i as usize];i=i+1}
 let exact=assess_simple_linear(&x,&y,3)
 assert(exact.fit.status==0 && exact.shapiro.status==3)
 let invalid=assess_simple_linear(&x,&y,101)
 assert(invalid.fit.status==1 && invalid.shapiro.status==1)
 println("STATS_SHAPIRO_STATUS_PASS")
 0
}
