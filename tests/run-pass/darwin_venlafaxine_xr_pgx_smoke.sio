//@ run-pass
//@ known-failure: measured 2026-09-26 on both engines -- prints "FAIL: CYP2D6 ordering" (harness: missing stdout contains: VENLAFAXINE_XR_PGX_SMOKE_PASS). Discretisation defect in the formation sink, not a wrong premise; see the comment block below.
//@ expect-stdout-contains: VENLAFAXINE_XR_PGX_SMOKE_PASS
//
// KNOWN RED -- deliberately left asserting PM < NM < UM.
//
// The premise is correct pharmacology: ODV/venlafaxine exposure rises with
// CYP2D6 activity (Kirchheiner 2006 -- the same data the CL_form scale in
// stdlib/darwin_pbpk/pgx/cyp2d6_venlafaxine.sio is built from). The
// assertion is therefore NOT loosened, given a tolerance, or removed.
//
// Why it fails: the CYP2D6 formation step in
// stdlib/darwin_pbpk/scenarios/venlafaxine_xr.sio is an explicit,
// per-step sink capped at the liver's available mass. Its Damkoehler number
// Da = CL_form * dt / V_liver (dt = 0.5 h, V_liver = 1.8 L) is
//   PM 0.866   IM 4.02   NM 11.94   UM 35.66
// so for IM/NM/UM the cap binds every step and empties the liver, and the
// three phenotypes become bit-identical: measured ODV/parent ratio
// 32.294514 (PM) vs 42.608279 (IM = NM = UM), lean_single and Madaros.
//
// The previous green was an artifact of a mass-fabrication bug in that
// same step (ODV received the full uncapped form_mg while the parent lost
// only the vascular-layer share, clamped at zero), which amplified the
// phenotype signal: measured pre-fix ODV/parent ratios were 15.9 (PM),
// 73.8 (IM), 219.6 (NM), 655.6 (UM), against Kirchheiner's Css ratios
// 0.25 / 1.16 / 3.45 / 10.3.
//
// What repairs it: flow-limited hepatic extraction (well-stirred
// CL_H = Q * CLint / (Q + CLint), Q_liver = 90 L/h gives a strictly
// ordered 3.01 / 12.46 / 29.10 / 52.91 L/h for PM/IM/NM/UM), expected from
// migrating this scenario onto the PBPK28 hepatic kernel (not done here).
// If this test then passes unchanged, the harness reports the
// known-failure tag as stale (XPAS) and the tag must be removed.

use darwin_pbpk::scenarios::venlafaxine_xr::*
use darwin_pbpk::release::matrix_er::*

fn main() with Mut, Div, IO, Panic {
    let rel = venlafaxine_xr_matrix_gohel2008()
    let dt = 0.5
    let t_end = 120.0

    var pm = vfx_scenario_init(0)
    pm = vfx_integrate_to(pm, rel, 0.0, t_end, dt)
    var nm = vfx_scenario_init(2)
    nm = vfx_integrate_to(nm, rel, 0.0, t_end, dt)
    var um = vfx_scenario_init(3)
    um = vfx_integrate_to(um, rel, 0.0, t_end, dt)

    let r_pm = vfx_odv_parent_ratio(pm)
    let r_nm = vfx_odv_parent_ratio(nm)
    let r_um = vfx_odv_parent_ratio(um)

    if !(r_pm < r_nm && r_nm < r_um) {
        println("FAIL: CYP2D6 ordering")
        return
    }
    if r_um < 2.0 {
        println("FAIL: UM ratio")
        return
    }
    println("VENLAFAXINE_XR_PGX_SMOKE_PASS")
}