//@ run-pass
//@ expect-stdout-contains: VENLAFAXINE_XR_PGX_SMOKE_PASS
//
// Steady-state ODV/parent readout (75 mg XR q24h, C_avg blood ratio over the
// 10th interval) across CYP2D6 phenotypes.
//
//   1. Ordering PM < IM < NM < UM at dt = 0.5 h.
//   2. At dt = 0.5 and 0.25 h, the closed-form steady state of the same model
//      (vfx_ss_ratio_closed_form, no integrator) lies inside the interval the
//      run certifies from its own clamp residuals and non-periodicity
//      (vfx_ss_ratio_lo/hi; derivation in the scenario header). Both bounds
//      come from the run, so no tolerance is chosen here. This is the
//      dt-convergence statement: at either dt the readout is within its
//      certified error of the dt-independent steady state.
//
// Agreement with published ratios is a separate known-failure test:
// darwin_venlafaxine_xr_odv_ratio_literature.sio.

use darwin_pbpk::scenarios::venlafaxine_xr::*

fn smoke_certified(pheno: i32, dt: f64) -> bool with IO, Mut, Div, Panic {
    let iv = vfx_ss_regimen_interval(pheno, dt)
    let cf = vfx_ss_ratio_closed_form(pheno)
    let lo = vfx_ss_ratio_lo(iv)
    let hi = vfx_ss_ratio_hi(iv)
    println("pheno, dt, ratio, closed form, lo, hi:")
    println(pheno)
    println(dt)
    println(vfx_ss_ratio(iv))
    println(cf)
    println(lo)
    println(hi)
    return lo <= cf && cf <= hi
}

fn main() -> i64 with Mut, Div, IO, Panic {
    var exit_fails: i64 = 0
    let dt = 0.5
    let r_pm = vfx_ss_odv_parent_ratio(0, dt)
    let r_im = vfx_ss_odv_parent_ratio(1, dt)
    let r_nm = vfx_ss_odv_parent_ratio(2, dt)
    let r_um = vfx_ss_odv_parent_ratio(3, dt)

    if !(r_pm < r_im && r_im < r_nm && r_nm < r_um) {
        println("FAIL: CYP2D6 ordering")
        return 1
    }

    var ph: i32 = 0
    while ph < 4 {
        if !smoke_certified(ph, dt) {
            println("FAIL: closed form outside certified interval at dt = 0.5")
            return 1
        }
        if !smoke_certified(ph, 0.5 * dt) {
            println("FAIL: closed form outside certified interval at dt = 0.25")
            return 1
        }
        ph = ph + 1
    }
    println("VENLAFAXINE_XR_PGX_SMOKE_PASS")
    if exit_fails > 0 {
        return 1
    }
    return 0
}
