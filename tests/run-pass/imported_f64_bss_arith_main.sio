//@ run-pass
//@ requires: madaros
// Wave15 D gate witness: imported leaf does f64 BSS arithmetic correctly.
// Expected:
//   DE bits ≈ 0x3fed67f1c864beb5 (0.9189385332046727)
//   0.0 - DE → negative of that (not ~ -4.6e18 from cvtsi2sd)
//   DE + 1.0 → ~1.9189
//   DE * 2.0 → ~1.8379

use imported_f64_bss_arith_leaf::{de_bits, exp_neg_de_like, de_plus_one, de_times_two}

fn main() -> i32 with IO, Mut, Div, Panic {
    let want_de: f64 = 0.9189385332046727
    let want_neg = 0.0 - want_de
    let want_p1 = want_de + 1.0
    let want_t2 = want_de * 2.0

    print("de_bits ")
    print_int(de_bits())
    println("")
    print("neg_bits ")
    print_int(f64_to_bits(exp_neg_de_like()))
    println("")
    print("plus1_bits ")
    print_int(f64_to_bits(de_plus_one()))
    println("")
    print("times2_bits ")
    print_int(f64_to_bits(de_times_two()))
    println("")

    if de_bits() != f64_to_bits(want_de) {
        // Allow 1-ULP encode variance of the literal
        let db = de_bits()
        let wb = f64_to_bits(want_de)
        let d = if db > wb { db - wb } else { wb - db }
        if d > 1 {
            println("FAIL de_bits")
            return 1
        }
    }

    let got_neg = exp_neg_de_like()
    let en = if got_neg > want_neg { got_neg - want_neg } else { want_neg - got_neg }
    if en > 0.000000000001 {
        println("FAIL 0.0 - DE (cvtsi2sd residual?)")
        return 2
    }

    let got_p1 = de_plus_one()
    let ep = if got_p1 > want_p1 { got_p1 - want_p1 } else { want_p1 - got_p1 }
    if ep > 0.000000000001 {
        println("FAIL DE + 1.0")
        return 3
    }

    let got_t2 = de_times_two()
    let et = if got_t2 > want_t2 { got_t2 - want_t2 } else { want_t2 - got_t2 }
    if et > 0.000000000001 {
        println("FAIL DE * 2.0")
        return 4
    }

    // Guard classic wrong class: cvtsi2sd of DE bits is ~4.6e18
    if got_p1 > 1000.0 {
        println("FAIL DE+1 collapsed to integer-bits path")
        return 5
    }

    println("IMPORTED_F64_BSS_ARITH_OK")
    0
}
