//@ run-pass
//@ requires: madaros

// TLS 1.3 handshake message wire codec (stdlib/tls/handshake.sio)
// against RFC 8448 ("Example Handshake Traces for TLS 1.3", "Simple
// 1-RTT Handshake", Section 3), fetched fresh from
// https://www.rfc-editor.org/rfc/rfc8448.txt on 2026-08-25 for this
// task -- independently re-extracted rather than assumed to carry over
// unchanged from Tasks 4/5's own fetches of the same document.
//
// Every hex vector below was copied verbatim from that fetch's
// "{server} construct a ... handshake message" sections (Section 3),
// each of which prints the FULL handshake-layer message (4-byte
// msg_type||uint24-length header + body) as it exists BEFORE record-layer
// encryption -- exactly this file's decode functions' own input shape.
// signature_scheme (0x0804) was cross-checked against RFC 8446 SS4.2.3's
// own "rsa_pss_rsae_sha256(0x0804)" table entry, independently re-fetched
// from https://www.rfc-editor.org/rfc/rfc8446.txt for this task.
//
// The ServerHello's Certificate message (RFC 8448 Section 3, "{server}
// construct a Certificate handshake message") is illustrative test
// material self-signed with CN=rsa (RFC 8448 SS3 note: "these
// certificates ... are for illustration only and are not real"), so this
// test verifies only structural decoding (list shape, leaf Subject bytes,
// serial number) against `openssl x509 -noout -subject -serial` run on
// the same DER bytes -- never chain-of-trust, per this task's brief.

use tls::handshake::*
use net::socket::*
use bignum::bigint::*

fn write_bytes(buf: &RawBuf, values: [i64; 512], n: i64) with IO {
    var i: i64 = 0
    while i < n {
        rawbuf_set(buf, i, values[i as usize])
        i = i + 1
    }
}

