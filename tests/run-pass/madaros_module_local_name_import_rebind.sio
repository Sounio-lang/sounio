//@ run-pass
//@ requires: madaros
//@ expect-stdout: MAIN_ENERGY=-7.250000
//@ expect-stdout: A_TWICE=3.000000
//@ expect-stdout: QUAL_SCALE=10.000000
//@ description: #2773 -- an importer's unqualified and module-qualified references bind to the module it imported from, even when that module is not the first-loaded definer of the name.
//
// nr_a is loaded before nr_b, so nr_a keeps the bare names; nr_b's same-named
// pub fns are renamed apart. This file imports `nr_energy` from nr_b by name
// and calls `nr_b::nr_scale()` through the whole-module import, so both must
// be rebound to nr_b. Before #2773: MAIN_ENERGY=1.5, QUAL_SCALE=2.0 (nr_a's).
// nr_a's own nr_a_twice still uses nr_a's fns.
//
// Madaros only; lean_single still binds first-loaded (#2773, KNOWN_LIMITATIONS).
use testmod::nr_a::{nr_a_twice}
use testmod::nr_b::{nr_energy}
use testmod::nr_b;

fn main() -> i32 with IO {
    print("MAIN_ENERGY=")
    print_f64(nr_energy())
    println("")
    print("A_TWICE=")
    print_f64(nr_a_twice())
    println("")
    print("QUAL_SCALE=")
    print_f64(nr_b::nr_scale())
    println("")
    0
}
