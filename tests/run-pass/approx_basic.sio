//@ run-pass
//@ description: Basic Approx effect usage and propagation

fn exact_value() -> f64 { 2.0 }

fn approximate_sqrt(x: f64) -> f64 with Approx, Mut, Div, Panic {
    var y: f64 = x
    var i: i64 = 0
    while i < 10 {
        y = (y + x / y) / 2.0
        i = i + 1
    }
    y
}

fn caller_with_approx(x: f64) -> f64 with Approx, Mut, Div, Panic {
    approximate_sqrt(x)
}

fn main() -> i64 with IO, Approx, Mut, Div, Panic {
    let v = exact_value()
    let a = caller_with_approx(v)
    println(a)
    0
}
