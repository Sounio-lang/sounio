//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-3 point time-slab containment seed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1621
    fp = mix(fp, 389654052, 5519)
    fp = mix(fp, 790630993, 5519)
    fp = mix(fp, 3, 5519)
    fp = mix(fp, 256, 5519)
    fp = mix(fp, 32, 5519)
    fp = mix(fp, 1, 5519)
    fp = mix(fp, 100, 5519)
    fp = mix(fp, 4915667, 5519)
    fp = mix(fp, 26215510, 5519)
    fp = mix(fp, 1028873, 5519)
    fp = mix(fp, 49157, 5519)
    fp = mix(fp, 262156, 5519)
    fp = mix(fp, 10289, 5519)
    fp = mix(fp, 49500, 5519)
    fp = mix(fp, 262500, 5519)
    fp = mix(fp, 10500, 5519)
    fp = mix(fp, 343, 5519)
    fp = mix(fp, 344, 5519)
    fp = mix(fp, 211, 5519)
    fp = mix(fp, 3, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 15, 5519)
    fp = mix(fp, 0, 5519)
    fp = mix(fp, 0, 5519)
    fp = mix(fp, 23, 5519)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 831120557 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1627
    fp = mix(fp, instance, 5521)
    fp = mix(fp, 4915667, 5521)
    fp = mix(fp, 26215510, 5521)
    fp = mix(fp, 1028873, 5521)
    fp = mix(fp, 49157, 5521)
    fp = mix(fp, 262156, 5521)
    fp = mix(fp, 10289, 5521)
    fp = mix(fp, 343, 5521)
    fp = mix(fp, 344, 5521)
    fp = mix(fp, 211, 5521)
    fp = mix(fp, 3, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 15, 5521)
    fp = mix(fp, 0, 5521)
    fp = mix(fp, 0, 5521)
    fp = mix(fp, 23, 5521)
    fp = mix(fp, ok_mask, 5521)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 831120557 { return 0 - 1 }
    if certificate != 546042778 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1637
    fp = mix(fp, instance, 5527)
    fp = mix(fp, certificate, 5527)
    fp = mix(fp, 19, 5527)
    fp = mix(fp, 3, 5527)
    fp = mix(fp, 7, 5527)
    fp = mix(fp, 15, 5527)
    fp = mix(fp, 0, 5527)
    fp = mix(fp, 0, 5527)
    fp = mix(fp, 23, 5527)
    fp = mix(fp, ok_mask, 5527)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64) -> i64 {
    if artifact != 417748218 { return 0 - 1 }
    if instance != 831120557 { return 0 - 1 }
    if certificate != 546042778 { return 0 - 1 }

    var fp: i64 = 1657
    fp = mix(fp, artifact, 5531)
    fp = mix(fp, instance, 5531)
    fp = mix(fp, certificate, 5531)
    fp = mix(fp, 389654052, 5531)
    fp = mix(fp, 790630993, 5531)
    fp = mix(fp, 4915667, 5531)
    fp = mix(fp, 26215510, 5531)
    fp = mix(fp, 1028873, 5531)
    fp = mix(fp, 49157, 5531)
    fp = mix(fp, 262156, 5531)
    fp = mix(fp, 10289, 5531)
    fp = mix(fp, 49500, 5531)
    fp = mix(fp, 262500, 5531)
    fp = mix(fp, 10500, 5531)
    fp = mix(fp, 3, 5531)
    fp = mix(fp, 23, 5531)
    fp = mix(fp, 255, 5531)
    return fp
}

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let x2: i256 = 4406636440 as i256
    let y2: i256 = 6517899153 as i256
    let dx_num: i256 = (10 as i256) * (y2 - x2)
    let dy_num: i256 = (119112655997 as i256) - y2
    let dz_num: i256 = (11106340034 as i256) - (6687364522 as i256)

    var derivative_mask: i64 = 0
    if (4915666 as i256) * scale < dx_num * target_scale {
        if (4915667 as i256) * scale >= dx_num * target_scale { derivative_mask = derivative_mask + 1 }
    }
    if (26215509 as i256) * scale < dy_num * target_scale {
        if (26215510 as i256) * scale >= dy_num * target_scale { derivative_mask = derivative_mask + 2 }
    }
    if (1028872 as i256) * scale < dz_num * target_scale {
        if (1028873 as i256) * scale >= dz_num * target_scale { derivative_mask = derivative_mask + 4 }
    }
    if derivative_mask != 7 { return 1 }

    let instance = instance_fp()
    if instance != 831120557 { return 2 }
    let certificate = certificate_fp(instance, 255)
    if certificate != 546042778 { return 3 }
    let artifact = artifact_fp(instance, certificate, 255)
    if artifact != 417748218 { return 4 }
    if audit_fp(artifact, instance, certificate) != 109213065 { return 5 }
    return 0
}
