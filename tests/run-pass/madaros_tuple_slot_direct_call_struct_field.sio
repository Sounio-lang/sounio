//@ run-pass
//@ requires: madaros
//@ expect-stdout: DIRECT_CALL_TUPLE_STRUCT_FIELD_OK
//
// A tuple slot selected directly from a call has no local tuple-layout
// binding. The lowerer must use the callee's tuple-struct return metadata
// before classifying Holder.values as an f64 array. Arithmetic is deliberate:
// a bare typed copy can preserve the IEEE bits even on the broken integer path.
struct Holder {
    values: [f64; 1],
}

struct Factory {
    tag: i64,
}

fn make_pair() -> (Holder, i64) {
    (Holder { values: [1.5] }, 1)
}

impl Factory {
    fn make_pair(self) -> (Holder, i64) with Mut, Panic {
        (Holder { values: [2.5] }, self.tag)
    }
}

fn main() -> i32 with IO, Mut, Panic {
    let factory = Factory { tag: 2 }
    let free_value: f64 = make_pair().0.values[0] * 2.0
    let method_value: f64 = factory.make_pair().0.values[0] * 2.0
    if free_value == 3.0 && method_value == 5.0 {
        println("DIRECT_CALL_TUPLE_STRUCT_FIELD_OK")
        return 0
    }
    1
}
