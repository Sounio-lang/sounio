use stats::student_t::{t_sf, t_two_tail}
use stats::inferential::{spearman_test}
use stats::fisher_f::{f_sf}
fn close_relative(got: f64, expected: f64) with Mut, Div, Panic {
 assert(got > 0.0)
 assert(got <= 1.0)
 let relative = got / expected - 1.0
 assert(relative < 1.0e-7)
 assert(relative > -1.0e-7)
}
fn main() with IO, Mut, Div, Panic {
 println("tail_case_1")
 close_relative(t_sf(0.00000000000000000, 1.00000000000000000), 0.500000000000000000)
 close_relative(t_two_tail(0.00000000000000000, 1.00000000000000000), 1.00000000000000000)
