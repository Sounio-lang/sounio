//@ run-pass
// test_diffgeo.sio -- Tests for the differential geometry module
//
// Self-contained test suite for metric tensors, Christoffel symbols,
// Riemann curvature, Gaussian curvature, geodesic integration,
// parallel transport, and index raising/lowering. All helpers and
// functions copied from stdlib/math/diffgeo.sio.
//
// Tests:
//  1.  Euclidean metric is identity: diag(1,1,1)
//  2.  Metric inverse of identity: g^{-1} = g for Euclidean
//  3.  Flat space Christoffel symbols = 0
//  4.  Flat space Riemann tensor = 0
//  5.  Sphere 2D Gaussian curvature = 1 (unit sphere)
//  6.  Sphere metric at equator: g = diag(1, 1)
//  7.  Schwarzschild metric at r=10: g_tt ~ -0.8, g_rr ~ 1.25
//  8.  Geodesic in flat space is straight line
//  9.  Parallel transport preserves norm in Euclidean space
// 10.  Hyperbolic plane curvature = -1
// 11.  Metric determinant of sphere: det(g) = sin^2(theta) at theta=pi/4
// 12.  Raise and lower index roundtrip

// ============================================================================
// HELPERS (copied from diffgeo.sio -- tests must be self-contained)
// ============================================================================

fn dg_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn dg_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

fn dg_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 24 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn dg_sin(x: f64) -> f64 with Mut, Div, Panic {
    var a = x
    let tp = 6.28318530717958647692
    while a >= tp { a = a - tp }
    while a < 0.0 { a = a + tp }
    if a > 3.14159265358979323846 { a = a - tp }
    let a2 = a * a
    var sum = a
    var term = a
    var n = 1
    while n < 20 { term = 0.0 - term * a2 / ((2 * n) * (2 * n + 1)) as f64; sum = sum + term; n = n + 1 }
    sum
}

fn dg_cos(x: f64) -> f64 with Mut, Div, Panic {
    dg_sin(x + 1.57079632679489661923)
}

fn dg_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < -500.0 { return 0.0 }
    let ln2 = 0.6931471805599453
    var kf = x / ln2
    var k: i32 = 0
    if kf >= 0.0 { k = kf as i32 } else { k = (kf as i32) - 1 }
    let r = x - (k as f64) * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 { term = term * r / (n as f64); sum = sum + term; n = n + 1 }
    var result = sum
    if k >= 0 { var i = 0; while i < k { result = result * 2.0; i = i + 1 } }
    else { var i = 0; while i < (0 - k) { result = result / 2.0; i = i + 1 } }
    result
}

fn dg_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    if x == 1.0 { return 0.0 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 { term = term * t2; sum = sum + term / ((2 * k + 1) as f64); k = k + 1 }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

fn dg_pi() -> f64 { 3.14159265358979323846 }

// ============================================================================
// STRUCTS (copied from diffgeo.sio)
// ============================================================================

struct Metric4 { g: [f64; 16], m4_dim: i32 }

struct Christoffel4 { gamma: [f64; 64], c4_dim: i32 }

struct RiemannTensor { R: [f64; 256], rt_dim: i32 }

struct RicciTensor { Ric: [f64; 16], scalar: f64, ric_dim: i32 }

struct GeodesicState { x: [f64; 4], v: [f64; 4], gs_dim: i32, tau: f64 }

struct GeodesicPath { x: [f64; 256], gp_v: [f64; 256], gp_tau: [f64; 128], n_steps: i32, gp_dim: i32 }

// ============================================================================
// METRIC OPERATIONS (copied from diffgeo.sio)
// ============================================================================

fn metric_inverse(g: &[f64; 16], dim: i32, g_inv: &![f64; 16]) with Mut, Div, Panic {
    var work: [f64; 32] = [0.0; 32]

    var i = 0
    while i < dim {
        var j = 0
        while j < dim {
            work[i * 2 * dim + j] = g[i * dim + j]
            j = j + 1
        }
        work[i * 2 * dim + dim + i] = 1.0
        i = i + 1
    }

    var col = 0
    while col < dim {
        var max_val = dg_abs(work[col * 2 * dim + col])
        var max_row = col
        var row = col + 1
        while row < dim {
            let v = dg_abs(work[row * 2 * dim + col])
            if v > max_val { max_val = v; max_row = row }
            row = row + 1
        }

        if max_row != col {
            var j = 0
            while j < 2 * dim {
                let tmp = work[col * 2 * dim + j]
                work[col * 2 * dim + j] = work[max_row * 2 * dim + j]
                work[max_row * 2 * dim + j] = tmp
                j = j + 1
            }
        }

        let pivot = work[col * 2 * dim + col]
        if dg_abs(pivot) < 1.0e-30 {
            i = 0
            while i < 16 { g_inv[i] = 0.0; i = i + 1 }
            i = 0
            while i < dim { g_inv[i * dim + i] = 1.0; i = i + 1 }
            return
        }

        let inv_pivot = 1.0 / pivot
        var j = 0
        while j < 2 * dim {
            work[col * 2 * dim + j] = work[col * 2 * dim + j] * inv_pivot
            j = j + 1
        }

        row = 0
        while row < dim {
            if row != col {
                let factor = work[row * 2 * dim + col]
                j = 0
                while j < 2 * dim {
                    work[row * 2 * dim + j] = work[row * 2 * dim + j] - factor * work[col * 2 * dim + j]
                    j = j + 1
                }
            }
            row = row + 1
        }
        col = col + 1
    }

    i = 0
    while i < 16 { g_inv[i] = 0.0; i = i + 1 }
    i = 0
    while i < dim {
        var j = 0
        while j < dim {
            g_inv[i * dim + j] = work[i * 2 * dim + dim + j]
            j = j + 1
        }
        i = i + 1
    }
}

fn metric_det(g: &[f64; 16], dim: i32) -> f64 with Mut, Div, Panic {
    if dim == 1 { return g[0] }

    if dim == 2 {
        return g[0] * g[3] - g[1] * g[2]
    }

    if dim == 3 {
        let a = g[0]; let b = g[1]; let c = g[2]
        let d = g[3]; let e = g[4]; let f = g[5]
        let h = g[6]; let i = g[7]; let j = g[8]
        return a * (e * j - f * i) - b * (d * j - f * h) + c * (d * i - e * h)
    }

    var A: [f64; 16] = [0.0; 16]
    var k = 0
    while k < 16 { A[k] = g[k]; k = k + 1 }

    var det = 1.0
    var col = 0
    while col < dim {
        var max_val = dg_abs(A[col * dim + col])
        var max_row = col
        var row = col + 1
        while row < dim {
            let v = dg_abs(A[row * dim + col])
            if v > max_val { max_val = v; max_row = row }
            row = row + 1
        }
        if max_row != col {
            var j = 0
            while j < dim {
                let tmp = A[col * dim + j]
                A[col * dim + j] = A[max_row * dim + j]
                A[max_row * dim + j] = tmp
                j = j + 1
            }
            det = 0.0 - det
        }

        let pivot = A[col * dim + col]
        if dg_abs(pivot) < 1.0e-30 { return 0.0 }
        det = det * pivot

        row = col + 1
        while row < dim {
            let factor = A[row * dim + col] / pivot
            var j = col + 1
            while j < dim {
                A[row * dim + j] = A[row * dim + j] - factor * A[col * dim + j]
                j = j + 1
            }
            row = row + 1
        }
        col = col + 1
    }
    det
}

fn metric_raise_index(g_inv: &[f64; 16], v_lower: &[f64; 4], dim: i32, v_upper: &![f64; 4]) with Mut, Div, Panic {
    var i = 0
    while i < dim {
        var s = 0.0
        var j = 0
        while j < dim {
            s = s + g_inv[i * dim + j] * v_lower[j]
            j = j + 1
        }
        v_upper[i] = s
        i = i + 1
    }
    while i < 4 { v_upper[i] = 0.0; i = i + 1 }
}

fn metric_lower_index(g: &[f64; 16], v_upper: &[f64; 4], dim: i32, v_lower: &![f64; 4]) with Mut, Div, Panic {
    var i = 0
    while i < dim {
        var s = 0.0
        var j = 0
        while j < dim {
            s = s + g[i * dim + j] * v_upper[j]
            j = j + 1
        }
        v_lower[i] = s
        i = i + 1
    }
    while i < 4 { v_lower[i] = 0.0; i = i + 1 }
}

// ============================================================================
// CHRISTOFFEL SYMBOLS (copied from diffgeo.sio)
// ============================================================================

fn christoffel_from_metric(metric_fn: fn(&[f64; 4], i32, &![f64; 16]) with Mut, Div, Panic,
                           x: &[f64; 4], dim: i32,
                           gamma: &!Christoffel4) with Mut, Div, Panic {
    let h = 1.0e-6
    gamma.c4_dim = dim

    var idx = 0
    while idx < 64 { gamma.gamma[idx] = 0.0; idx = idx + 1 }

    var g0: [f64; 16] = [0.0; 16]
    metric_fn(x, dim, &!g0)

    var g_inv: [f64; 16] = [0.0; 16]
    metric_inverse(&g0, dim, &!g_inv)

    var dg: [f64; 256] = [0.0; 256]

    var m = 0
    while m < dim {
        var xp: [f64; 4] = [0.0; 4]
        var xm: [f64; 4] = [0.0; 4]
        var c = 0
        while c < 4 { xp[c] = x[c]; xm[c] = x[c]; c = c + 1 }
        xp[m] = x[m] + h
        xm[m] = x[m] - h

        var gp: [f64; 16] = [0.0; 16]
        var gm: [f64; 16] = [0.0; 16]
        metric_fn(&xp, dim, &!gp)
        metric_fn(&xm, dim, &!gm)

        var i = 0
        while i < dim {
            var j = 0
            while j < dim {
                dg[m * dim * dim + i * dim + j] = (gp[i * dim + j] - gm[i * dim + j]) / (2.0 * h)
                j = j + 1
            }
            i = i + 1
        }
        m = m + 1
    }

    var k = 0
    while k < dim {
        var i = 0
        while i < dim {
            var j = 0
            while j < dim {
                var s = 0.0
                var l = 0
                while l < dim {
                    let term1 = dg[j * dim * dim + l * dim + i]
                    let term2 = dg[i * dim * dim + l * dim + j]
                    let term3 = dg[l * dim * dim + i * dim + j]
                    s = s + g_inv[k * dim + l] * (term1 + term2 - term3)
                    l = l + 1
                }
                gamma.gamma[k * dim * dim + i * dim + j] = 0.5 * s
                j = j + 1
            }
            i = i + 1
        }
        k = k + 1
    }
}

// ============================================================================
// RIEMANN CURVATURE TENSOR (copied from diffgeo.sio)
// ============================================================================

fn riemann_tensor(metric_fn: fn(&[f64; 4], i32, &![f64; 16]) with Mut, Div, Panic,
                  x: &[f64; 4], dim: i32,
                  R: &!RiemannTensor) with Mut, Div, Panic {
    let h = 1.0e-5
    R.rt_dim = dim

    var idx = 0
    while idx < 256 { R.R[idx] = 0.0; idx = idx + 1 }

    var gamma0: Christoffel4 = Christoffel4 { gamma: [0.0; 64], c4_dim: dim }
    christoffel_from_metric(metric_fn, x, dim, &!gamma0)

    var d_gamma: [f64; 256] = [0.0; 256]

    var m = 0
    while m < dim {
        var xp: [f64; 4] = [0.0; 4]
        var xm: [f64; 4] = [0.0; 4]
        var c = 0
        while c < 4 { xp[c] = x[c]; xm[c] = x[c]; c = c + 1 }
        xp[m] = x[m] + h
        xm[m] = x[m] - h

        var gp: Christoffel4 = Christoffel4 { gamma: [0.0; 64], c4_dim: dim }
        var gm: Christoffel4 = Christoffel4 { gamma: [0.0; 64], c4_dim: dim }
        christoffel_from_metric(metric_fn, &xp, dim, &!gp)
        christoffel_from_metric(metric_fn, &xm, dim, &!gm)

        var k = 0
        while k < dim {
            var a = 0
            while a < dim {
                var b = 0
                while b < dim {
                    let gp_val = gp.gamma[k * dim * dim + a * dim + b]
                    let gm_val = gm.gamma[k * dim * dim + a * dim + b]
                    d_gamma[m * dim * dim * dim + k * dim * dim + a * dim + b] = (gp_val - gm_val) / (2.0 * h)
                    b = b + 1
                }
                a = a + 1
            }
            k = k + 1
        }
        m = m + 1
    }

    var k = 0
    while k < dim {
        var l = 0
        while l < dim {
            var i = 0
            while i < dim {
                var j = 0
                while j < dim {
                    let di_Gkjl = d_gamma[i * dim * dim * dim + k * dim * dim + j * dim + l]
                    let dj_Gkil = d_gamma[j * dim * dim * dim + k * dim * dim + i * dim + l]

                    var quad1 = 0.0
                    var quad2 = 0.0
                    var mm = 0
                    while mm < dim {
                        quad1 = quad1 + gamma0.gamma[k * dim * dim + i * dim + mm] * gamma0.gamma[mm * dim * dim + j * dim + l]
                        quad2 = quad2 + gamma0.gamma[k * dim * dim + j * dim + mm] * gamma0.gamma[mm * dim * dim + i * dim + l]
                        mm = mm + 1
                    }

                    R.R[k * dim * dim * dim + l * dim * dim + i * dim + j] = di_Gkjl - dj_Gkil + quad1 - quad2
                    j = j + 1
                }
                i = i + 1
            }
            l = l + 1
        }
        k = k + 1
    }
}

// ============================================================================
// RICCI TENSOR AND SCALAR CURVATURE (copied from diffgeo.sio)
// ============================================================================

fn ricci_tensor(R_in: &RiemannTensor, result: &!RicciTensor) with Mut, Div, Panic {
    let dim = R_in.rt_dim
    result.ric_dim = dim
    result.scalar = 0.0

    var i = 0
    while i < 16 { result.Ric[i] = 0.0; i = i + 1 }

    i = 0
    while i < dim {
        var j = 0
        while j < dim {
            var s = 0.0
            var k = 0
            while k < dim {
                s = s + R_in.R[k * dim * dim * dim + i * dim * dim + k * dim + j]
                k = k + 1
            }
            result.Ric[i * dim + j] = s
            j = j + 1
        }
        i = i + 1
    }
}

fn ricci_with_scalar(metric_fn: fn(&[f64; 4], i32, &![f64; 16]) with Mut, Div, Panic,
                     x: &[f64; 4], dim: i32,
                     result: &!RicciTensor) with Mut, Div, Panic {
    var Riem: RiemannTensor = RiemannTensor { R: [0.0; 256], rt_dim: dim }
    riemann_tensor(metric_fn, x, dim, &!Riem)

    ricci_tensor(&Riem, result)

    var g0: [f64; 16] = [0.0; 16]
    metric_fn(x, dim, &!g0)
    var g_inv: [f64; 16] = [0.0; 16]
    metric_inverse(&g0, dim, &!g_inv)

    var scalar = 0.0
    var i = 0
    while i < dim {
        var j = 0
        while j < dim {
            scalar = scalar + g_inv[i * dim + j] * result.Ric[i * dim + j]
            j = j + 1
        }
        i = i + 1
    }
    result.scalar = scalar
}

fn gauss_curvature_2d(metric_fn: fn(&[f64; 4], i32, &![f64; 16]) with Mut, Div, Panic,
                      x: &[f64; 4]) -> f64 with Mut, Div, Panic {
    let dim = 2
    var ric: RicciTensor = RicciTensor { Ric: [0.0; 16], scalar: 0.0, ric_dim: dim }
    ricci_with_scalar(metric_fn, x, dim, &!ric)
    ric.scalar / 2.0
}

// ============================================================================
// GEODESIC EQUATIONS (copied from diffgeo.sio)
// ============================================================================

fn geodesic_rhs(metric_fn: fn(&[f64; 4], i32, &![f64; 16]) with Mut, Div, Panic,
                st: &GeodesicState,
                dx: &![f64; 4], dv: &![f64; 4]) with Mut, Div, Panic {
    let dim = st.gs_dim

    var i = 0
    while i < 4 { dx[i] = 0.0; dv[i] = 0.0; i = i + 1 }
    i = 0
    while i < dim { dx[i] = st.v[i]; i = i + 1 }

    var gamma: Christoffel4 = Christoffel4 { gamma: [0.0; 64], c4_dim: dim }
    christoffel_from_metric(metric_fn, &st.x, dim, &!gamma)

    var k = 0
    while k < dim {
        var s = 0.0
        i = 0
        while i < dim {
            var j = 0
            while j < dim {
                s = s + gamma.gamma[k * dim * dim + i * dim + j] * st.v[i] * st.v[j]
                j = j + 1
            }
            i = i + 1
        }
        dv[k] = 0.0 - s
        k = k + 1
    }
}

fn geodesic_step(metric_fn: fn(&[f64; 4], i32, &![f64; 16]) with Mut, Div, Panic,
                 st: &!GeodesicState, dtau: f64) with Mut, Div, Panic {
    let dim = st.gs_dim

    var dx1: [f64; 4] = [0.0; 4]
    var dv1: [f64; 4] = [0.0; 4]
    geodesic_rhs(metric_fn, st, &!dx1, &!dv1)

    var s2: GeodesicState = GeodesicState { x: [0.0; 4], v: [0.0; 4], gs_dim: dim, tau: st.tau + dtau / 2.0 }
    var c = 0
    while c < dim {
        s2.x[c] = st.x[c] + 0.5 * dtau * dx1[c]
        s2.v[c] = st.v[c] + 0.5 * dtau * dv1[c]
        c = c + 1
    }

    var dx2: [f64; 4] = [0.0; 4]
    var dv2: [f64; 4] = [0.0; 4]
    geodesic_rhs(metric_fn, &s2, &!dx2, &!dv2)

    var s3: GeodesicState = GeodesicState { x: [0.0; 4], v: [0.0; 4], gs_dim: dim, tau: st.tau + dtau / 2.0 }
    c = 0
    while c < dim {
        s3.x[c] = st.x[c] + 0.5 * dtau * dx2[c]
        s3.v[c] = st.v[c] + 0.5 * dtau * dv2[c]
        c = c + 1
    }

    var dx3: [f64; 4] = [0.0; 4]
    var dv3: [f64; 4] = [0.0; 4]
    geodesic_rhs(metric_fn, &s3, &!dx3, &!dv3)

    var s4: GeodesicState = GeodesicState { x: [0.0; 4], v: [0.0; 4], gs_dim: dim, tau: st.tau + dtau }
    c = 0
    while c < dim {
        s4.x[c] = st.x[c] + dtau * dx3[c]
        s4.v[c] = st.v[c] + dtau * dv3[c]
        c = c + 1
    }

    var dx4: [f64; 4] = [0.0; 4]
    var dv4: [f64; 4] = [0.0; 4]
    geodesic_rhs(metric_fn, &s4, &!dx4, &!dv4)

    c = 0
    while c < dim {
        st.x[c] = st.x[c] + dtau / 6.0 * (dx1[c] + 2.0 * dx2[c] + 2.0 * dx3[c] + dx4[c])
        st.v[c] = st.v[c] + dtau / 6.0 * (dv1[c] + 2.0 * dv2[c] + 2.0 * dv3[c] + dv4[c])
        c = c + 1
    }
    st.tau = st.tau + dtau
}

fn geodesic_integrate(metric_fn: fn(&[f64; 4], i32, &![f64; 16]) with Mut, Div, Panic,
                      x0: &[f64; 4], v0: &[f64; 4], dim: i32,
                      tau_end: f64, n_steps: i32,
                      path: &!GeodesicPath) with Mut, Div, Panic {
    path.gp_dim = dim
    path.n_steps = n_steps

    var z = 0
    while z < 256 { path.x[z] = 0.0; path.gp_v[z] = 0.0; z = z + 1 }
    z = 0
    while z < 128 { path.gp_tau[z] = 0.0; z = z + 1 }

    let dtau = tau_end / (n_steps as f64)

    var state: GeodesicState = GeodesicState { x: [0.0; 4], v: [0.0; 4], gs_dim: dim, tau: 0.0 }
    var c = 0
    while c < dim { state.x[c] = x0[c]; state.v[c] = v0[c]; c = c + 1 }

    c = 0
    while c < dim {
        path.x[0 * dim + c] = state.x[c]
        path.gp_v[0 * dim + c] = state.v[c]
        c = c + 1
    }
    path.gp_tau[0] = 0.0

    var step = 1
    while step <= n_steps {
        geodesic_step(metric_fn, &!state, dtau)

        if step < 128 {
            path.gp_tau[step] = state.tau
            c = 0
            while c < dim {
                path.x[step * dim + c] = state.x[c]
                path.gp_v[step * dim + c] = state.v[c]
                c = c + 1
            }
        }
        step = step + 1
    }
}

// ============================================================================
// PARALLEL TRANSPORT (copied from diffgeo.sio)
// ============================================================================

fn parallel_transport_step(metric_fn: fn(&[f64; 4], i32, &![f64; 16]) with Mut, Div, Panic,
                           x: &[f64; 4], v: &[f64; 4],
                           w: &![f64; 4], dim: i32, dtau: f64) with Mut, Div, Panic {
    var gamma: Christoffel4 = Christoffel4 { gamma: [0.0; 64], c4_dim: dim }
    christoffel_from_metric(metric_fn, x, dim, &!gamma)

    var k1: [f64; 4] = [0.0; 4]
    var k = 0
    while k < dim {
        var s = 0.0
        var i = 0
        while i < dim {
            var j = 0
            while j < dim {
                s = s + gamma.gamma[k * dim * dim + i * dim + j] * v[i] * w[j]
                j = j + 1
            }
            i = i + 1
        }
        k1[k] = 0.0 - s
        k = k + 1
    }

    var w2: [f64; 4] = [0.0; 4]
    var c = 0
    while c < dim { w2[c] = w[c] + 0.5 * dtau * k1[c]; c = c + 1 }
    var k2: [f64; 4] = [0.0; 4]
    k = 0
    while k < dim {
        var s = 0.0
        var i = 0
        while i < dim {
            var j = 0
            while j < dim {
                s = s + gamma.gamma[k * dim * dim + i * dim + j] * v[i] * w2[j]
                j = j + 1
            }
            i = i + 1
        }
        k2[k] = 0.0 - s
        k = k + 1
    }

    var w3: [f64; 4] = [0.0; 4]
    c = 0
    while c < dim { w3[c] = w[c] + 0.5 * dtau * k2[c]; c = c + 1 }
    var k3: [f64; 4] = [0.0; 4]
    k = 0
    while k < dim {
        var s = 0.0
        var i = 0
        while i < dim {
            var j = 0
            while j < dim {
                s = s + gamma.gamma[k * dim * dim + i * dim + j] * v[i] * w3[j]
                j = j + 1
            }
            i = i + 1
        }
        k3[k] = 0.0 - s
        k = k + 1
    }

    var w4: [f64; 4] = [0.0; 4]
    c = 0
    while c < dim { w4[c] = w[c] + dtau * k3[c]; c = c + 1 }
    var k4: [f64; 4] = [0.0; 4]
    k = 0
    while k < dim {
        var s = 0.0
        var i = 0
        while i < dim {
            var j = 0
            while j < dim {
                s = s + gamma.gamma[k * dim * dim + i * dim + j] * v[i] * w4[j]
                j = j + 1
            }
            i = i + 1
        }
        k4[k] = 0.0 - s
        k = k + 1
    }

    c = 0
    while c < dim {
        w[c] = w[c] + dtau / 6.0 * (k1[c] + 2.0 * k2[c] + 2.0 * k3[c] + k4[c])
        c = c + 1
    }
}

fn parallel_transport_along(metric_fn: fn(&[f64; 4], i32, &![f64; 16]) with Mut, Div, Panic,
                            path: &GeodesicPath,
                            w0: &[f64; 4],
                            w_final: &![f64; 4]) with Mut, Div, Panic {
    let dim = path.gp_dim
    let n = path.n_steps

    var c = 0
    while c < 4 { w_final[c] = 0.0; c = c + 1 }
    c = 0
    while c < dim { w_final[c] = w0[c]; c = c + 1 }

    var step = 0
    while step < n {
        var x_cur: [f64; 4] = [0.0; 4]
        var v_cur: [f64; 4] = [0.0; 4]
        c = 0
        while c < dim {
            x_cur[c] = path.x[step * dim + c]
            v_cur[c] = path.gp_v[step * dim + c]
            c = c + 1
        }

        var dtau = 0.0
        if step + 1 < 128 {
            dtau = path.gp_tau[step + 1] - path.gp_tau[step]
        }

        if dg_abs(dtau) > 1.0e-30 {
            parallel_transport_step(metric_fn, &x_cur, &v_cur, w_final, dim, dtau)
        }
        step = step + 1
    }
}

// ============================================================================
// STANDARD METRICS (copied from diffgeo.sio)
// ============================================================================

fn metric_euclidean_3d(x: &[f64; 4], dim: i32, g: &![f64; 16]) with Mut, Div, Panic {
    var i = 0
    while i < 16 { g[i] = 0.0; i = i + 1 }
    g[0] = 1.0
    g[4] = 1.0
    g[8] = 1.0
}

fn metric_sphere_2d(x: &[f64; 4], dim: i32, g: &![f64; 16]) with Mut, Div, Panic {
    var i = 0
    while i < 16 { g[i] = 0.0; i = i + 1 }
    let theta = x[0]
    let sth = dg_sin(theta)
    g[0] = 1.0
    g[3] = sth * sth
}

fn metric_schwarzschild(x: &[f64; 4], dim: i32, g: &![f64; 16]) with Mut, Div, Panic {
    var i = 0
    while i < 16 { g[i] = 0.0; i = i + 1 }

    let r = x[1]
    let theta = x[2]
    let sth = dg_sin(theta)

    var r_safe = r
    if dg_abs(r_safe) < 1.0e-10 { r_safe = 1.0e-10 }
    let f = 1.0 - 2.0 / r_safe

    if dg_abs(f) < 1.0e-30 {
        g[0] = -1.0e-30
        g[5] = 1.0e30
    } else {
        g[0] = 0.0 - f
        g[5] = 1.0 / f
    }
    g[10] = r_safe * r_safe
    g[15] = r_safe * r_safe * sth * sth
}

fn metric_hyperbolic_2d(x: &[f64; 4], dim: i32, g: &![f64; 16]) with Mut, Div, Panic {
    var i = 0
    while i < 16 { g[i] = 0.0; i = i + 1 }

    var y = x[1]
    if y < 1.0e-10 { y = 1.0e-10 }
    let inv_y2 = 1.0 / (y * y)

    g[0] = inv_y2
    g[3] = inv_y2
}

// ============================================================================
// EUCLIDEAN 2D METRIC (for geodesic/parallel transport tests)
// ============================================================================

fn metric_euclidean_2d(x: &[f64; 4], dim: i32, g: &![f64; 16]) with Mut, Div, Panic {
    var i = 0
    while i < 16 { g[i] = 0.0; i = i + 1 }
    g[0] = 1.0
    g[3] = 1.0
}

// ============================================================================
// TEST 1: Euclidean metric is identity: diag(1,1,1)
// ============================================================================

fn test_euclidean_metric_identity() -> bool with Mut, Div, Panic {
    var x: [f64; 4] = [1.0, 2.0, 3.0, 0.0]
    var g: [f64; 16] = [0.0; 16]
    metric_euclidean_3d(&x, 3, &!g)

    let tol = 1.0e-12

    // Check diagonal elements are 1
    if dg_abs(g[0] - 1.0) > tol { return false }
    if dg_abs(g[4] - 1.0) > tol { return false }
    if dg_abs(g[8] - 1.0) > tol { return false }

    // Check off-diagonal elements are 0
    if dg_abs(g[1]) > tol { return false }
    if dg_abs(g[2]) > tol { return false }
    if dg_abs(g[3]) > tol { return false }
    if dg_abs(g[5]) > tol { return false }
    if dg_abs(g[6]) > tol { return false }
    if dg_abs(g[7]) > tol { return false }

    true
}

// ============================================================================
// TEST 2: Metric inverse of identity: g^{-1} = g for Euclidean
// ============================================================================

fn test_euclidean_metric_inverse() -> bool with Mut, Div, Panic {
    var x: [f64; 4] = [1.0, 2.0, 3.0, 0.0]
    var g: [f64; 16] = [0.0; 16]
    metric_euclidean_3d(&x, 3, &!g)

    var g_inv: [f64; 16] = [0.0; 16]
    metric_inverse(&g, 3, &!g_inv)

    let tol = 1.0e-12

    // Inverse of identity is identity
    if dg_abs(g_inv[0] - 1.0) > tol { return false }
    if dg_abs(g_inv[4] - 1.0) > tol { return false }
    if dg_abs(g_inv[8] - 1.0) > tol { return false }

    if dg_abs(g_inv[1]) > tol { return false }
    if dg_abs(g_inv[2]) > tol { return false }
    if dg_abs(g_inv[3]) > tol { return false }
    if dg_abs(g_inv[5]) > tol { return false }
    if dg_abs(g_inv[6]) > tol { return false }
    if dg_abs(g_inv[7]) > tol { return false }

    true
}

// ============================================================================
// TEST 3: Flat space Christoffel symbols = 0
// ============================================================================

fn test_flat_christoffel_zero() -> bool with Mut, Div, Panic {
    var x: [f64; 4] = [1.0, 2.0, 3.0, 0.0]
    var gamma: Christoffel4 = Christoffel4 { gamma: [0.0; 64], c4_dim: 3 }
    christoffel_from_metric(metric_euclidean_3d, &x, 3, &!gamma)

    let tol = 1.0e-4

    // All 27 Christoffel symbols should be zero for flat space
    var k = 0
    while k < 3 {
        var i = 0
        while i < 3 {
            var j = 0
            while j < 3 {
                if dg_abs(gamma.gamma[k * 9 + i * 3 + j]) > tol { return false }
                j = j + 1
            }
            i = i + 1
        }
        k = k + 1
    }

    true
}

// ============================================================================
// TEST 4: Flat space Riemann tensor = 0
// ============================================================================

fn test_flat_riemann_zero() -> bool with Mut, Div, Panic {
    var x: [f64; 4] = [1.0, 2.0, 3.0, 0.0]
    var Riem: RiemannTensor = RiemannTensor { R: [0.0; 256], rt_dim: 3 }
    riemann_tensor(metric_euclidean_3d, &x, 3, &!Riem)

    let tol = 1.0e-4

    // All 81 components R^k_{lij} should be zero
    var k = 0
    while k < 3 {
        var l = 0
        while l < 3 {
            var i = 0
            while i < 3 {
                var j = 0
                while j < 3 {
                    if dg_abs(Riem.R[k * 27 + l * 9 + i * 3 + j]) > tol { return false }
                    j = j + 1
                }
                i = i + 1
            }
            l = l + 1
        }
        k = k + 1
    }

    true
}

// ============================================================================
// TEST 5: Sphere 2D Gaussian curvature = 1 (unit sphere)
// For a unit sphere, K = 1/R^2 = 1.
// ============================================================================

fn test_sphere_gauss_curvature() -> bool with Mut, Div, Panic {
    // Evaluate at theta = pi/3, phi = pi/4 (away from poles)
    let theta = dg_pi() / 3.0
    let phi = dg_pi() / 4.0
    var x: [f64; 4] = [theta, phi, 0.0, 0.0]

    let K = gauss_curvature_2d(metric_sphere_2d, &x)

    let tol = 1.0e-4
    dg_abs(K - 1.0) < tol
}

// ============================================================================
// TEST 6: Sphere metric at equator: g = diag(1, 1)
// At theta = pi/2, sin^2(pi/2) = 1, so g = diag(1, 1).
// ============================================================================

fn test_sphere_metric_equator() -> bool with Mut, Div, Panic {
    let theta = dg_pi() / 2.0
    var x: [f64; 4] = [theta, 0.0, 0.0, 0.0]
    var g: [f64; 16] = [0.0; 16]
    metric_sphere_2d(&x, 2, &!g)

    let tol = 1.0e-10

    // g_{theta theta} = 1
    if dg_abs(g[0] - 1.0) > tol { return false }
    // g_{phi phi} = sin^2(pi/2) = 1
    if dg_abs(g[3] - 1.0) > tol { return false }
    // off-diagonal = 0
    if dg_abs(g[1]) > tol { return false }
    if dg_abs(g[2]) > tol { return false }

    true
}

// ============================================================================
// TEST 7: Schwarzschild metric at r=10 (M=1)
// g_tt = -(1 - 2/10) = -0.8
// g_rr = 1/(1 - 2/10) = 1/0.8 = 1.25
// ============================================================================

fn test_schwarzschild_r10() -> bool with Mut, Div, Panic {
    // x = (t, r, theta, phi) = (0, 10, pi/2, 0)
    let theta = dg_pi() / 2.0
    var x: [f64; 4] = [0.0, 10.0, theta, 0.0]
    var g: [f64; 16] = [0.0; 16]
    metric_schwarzschild(&x, 4, &!g)

    let tol = 1.0e-10

    // g_tt = -(1 - 2/10) = -0.8
    let expected_gtt = 0.0 - 0.8
    if dg_abs(g[0] - expected_gtt) > tol { return false }

    // g_rr = 1/(1 - 2/10) = 1.25
    let expected_grr = 1.25
    if dg_abs(g[5] - expected_grr) > tol { return false }

    // g_{theta theta} = r^2 = 100
    if dg_abs(g[10] - 100.0) > tol { return false }

    // g_{phi phi} = r^2 sin^2(pi/2) = 100
    if dg_abs(g[15] - 100.0) > tol { return false }

    true
}

// ============================================================================
// TEST 8: Geodesic in flat space is straight line
// In Euclidean 2D, a geodesic starting at (0,0) with velocity (1,2) should
// produce a straight line x(t) = (t, 2t).
// ============================================================================

fn test_geodesic_flat_straight_line() -> bool with Mut, Div, Panic {
    let dim = 2
    var x0: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    var v0: [f64; 4] = [1.0, 2.0, 0.0, 0.0]

    let tau_end = 1.0
    let n_steps = 100

    var path: GeodesicPath = GeodesicPath {
        x: [0.0; 256], gp_v: [0.0; 256], gp_tau: [0.0; 128],
        n_steps: 0, gp_dim: 0
    }
    geodesic_integrate(metric_euclidean_2d, &x0, &v0, dim, tau_end, n_steps, &!path)

    let tol = 1.0e-4

    // Check final position: should be (1.0, 2.0)
    let final_x = path.x[n_steps * dim + 0]
    let final_y = path.x[n_steps * dim + 1]

    if dg_abs(final_x - 1.0) > tol { return false }
    if dg_abs(final_y - 2.0) > tol { return false }

    // Check intermediate point at step 50: should be (0.5, 1.0)
    let mid_x = path.x[50 * dim + 0]
    let mid_y = path.x[50 * dim + 1]

    if dg_abs(mid_x - 0.5) > tol { return false }
    if dg_abs(mid_y - 1.0) > tol { return false }

    true
}

// ============================================================================
// TEST 9: Parallel transport preserves norm in Euclidean space
// In flat space, parallel transport does not change the vector at all.
// The Euclidean norm ||w|| should remain constant.
// ============================================================================

fn test_parallel_transport_preserves_norm() -> bool with Mut, Div, Panic {
    let dim = 2
    var x0: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    var v0: [f64; 4] = [1.0, 0.0, 0.0, 0.0]

    let tau_end = 1.0
    let n_steps = 100

    var path: GeodesicPath = GeodesicPath {
        x: [0.0; 256], gp_v: [0.0; 256], gp_tau: [0.0; 128],
        n_steps: 0, gp_dim: 0
    }
    geodesic_integrate(metric_euclidean_2d, &x0, &v0, dim, tau_end, n_steps, &!path)

    // Transport w0 = (3, 4) along this geodesic
    var w0: [f64; 4] = [3.0, 4.0, 0.0, 0.0]
    var w_final: [f64; 4] = [0.0; 4]
    parallel_transport_along(metric_euclidean_2d, &path, &w0, &!w_final)

    // Initial norm: sqrt(9 + 16) = 5
    let norm0 = dg_sqrt(w0[0] * w0[0] + w0[1] * w0[1])
    let norm_final = dg_sqrt(w_final[0] * w_final[0] + w_final[1] * w_final[1])

    let tol = 1.0e-4
    dg_abs(norm_final - norm0) < tol
}

// ============================================================================
// TEST 10: Hyperbolic plane curvature = -1
// Poincare half-plane ds^2 = (dx^2 + dy^2)/y^2 has K = -1.
// ============================================================================

fn test_hyperbolic_curvature() -> bool with Mut, Div, Panic {
    // Evaluate at (x, y) = (1.0, 2.0) -- well inside the half-plane
    var x: [f64; 4] = [1.0, 2.0, 0.0, 0.0]

    let K = gauss_curvature_2d(metric_hyperbolic_2d, &x)

    let tol = 1.0e-4
    let expected = 0.0 - 1.0
    dg_abs(K - expected) < tol
}

// ============================================================================
// TEST 11: Metric determinant of sphere
// det(g) = 1 * sin^2(theta) - 0 = sin^2(theta)
// At theta = pi/4: sin^2(pi/4) = 0.5
// ============================================================================

fn test_sphere_metric_determinant() -> bool with Mut, Div, Panic {
    let theta = dg_pi() / 4.0
    var x: [f64; 4] = [theta, 0.0, 0.0, 0.0]
    var g: [f64; 16] = [0.0; 16]
    metric_sphere_2d(&x, 2, &!g)

    let det = metric_det(&g, 2)

    // sin^2(pi/4) = (sqrt(2)/2)^2 = 0.5
    let expected = 0.5
    let tol = 1.0e-10

    dg_abs(det - expected) < tol
}

// ============================================================================
// TEST 12: Raise and lower index roundtrip
// Lower then raise a vector: v -> v_lower -> v_upper should give back v.
// Using Euclidean 3D metric (identity), this is trivial.
// Also test with sphere metric at theta = pi/3 for non-trivial case.
// ============================================================================

fn test_raise_lower_roundtrip() -> bool with Mut, Div, Panic {
    // Non-trivial test: sphere metric at theta = pi/3
    let theta = dg_pi() / 3.0
    var x: [f64; 4] = [theta, 0.0, 0.0, 0.0]
    var g: [f64; 16] = [0.0; 16]
    metric_sphere_2d(&x, 2, &!g)

    var g_inv: [f64; 16] = [0.0; 16]
    metric_inverse(&g, 2, &!g_inv)

    // Original vector v^i = (1.0, 2.0)
    var v_upper: [f64; 4] = [1.0, 2.0, 0.0, 0.0]

    // Lower: v_i = g_{ij} v^j
    var v_lower: [f64; 4] = [0.0; 4]
    metric_lower_index(&g, &v_upper, 2, &!v_lower)

    // Raise back: v'^i = g^{ij} v_j
    var v_raised: [f64; 4] = [0.0; 4]
    metric_raise_index(&g_inv, &v_lower, 2, &!v_raised)

    let tol = 1.0e-10

    // v_raised should equal v_upper
    if dg_abs(v_raised[0] - v_upper[0]) > tol { return false }
    if dg_abs(v_raised[1] - v_upper[1]) > tol { return false }

    true
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    var pass = 0
    var fail = 0

    println("=== Differential Geometry Tests ===")
    println("")

    // Test 1
    print("Test  1: Euclidean metric is identity ......... ")
    if test_euclidean_metric_identity() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 2
    print("Test  2: Metric inverse of identity ........... ")
    if test_euclidean_metric_inverse() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 3
    print("Test  3: Flat space Christoffel = 0 ........... ")
    if test_flat_christoffel_zero() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 4
    print("Test  4: Flat space Riemann tensor = 0 ........ ")
    if test_flat_riemann_zero() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 5
    print("Test  5: Sphere Gaussian curvature = 1 ........ ")
    if test_sphere_gauss_curvature() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 6
    print("Test  6: Sphere metric at equator ............. ")
    if test_sphere_metric_equator() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 7
    print("Test  7: Schwarzschild metric at r=10 ......... ")
    if test_schwarzschild_r10() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 8
    print("Test  8: Geodesic flat space straight line .... ")
    if test_geodesic_flat_straight_line() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 9
    print("Test  9: Parallel transport preserves norm .... ")
    if test_parallel_transport_preserves_norm() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 10
    print("Test 10: Hyperbolic plane curvature = -1 ...... ")
    if test_hyperbolic_curvature() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 11
    print("Test 11: Sphere metric determinant ............ ")
    if test_sphere_metric_determinant() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 12
    print("Test 12: Raise/lower index roundtrip .......... ")
    if test_raise_lower_roundtrip() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    println("")
    if fail == 0 {
        println("ALL 12 TESTS PASSED")
        return 0
    } else {
        println("SOME TESTS FAILED")
        return 1
    }
}
