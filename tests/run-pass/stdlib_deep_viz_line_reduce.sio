//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_VIZ_LINE_REDUCE_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_at,integer_buffer_close}
use viz::dynamic_line_reduce::{dynamic_line_reduce}
fn main() with IO,Alloc,Mut,Div,Panic {
 var x=numeric_buffer_new(12,96)
 var y=numeric_buffer_new(12,96)
 var available=integer_buffer_new(12,96)
 var out=integer_buffer_new(12,96)
 var short=integer_buffer_new(1,8)
 let ignored=integer_buffer_set(&!short,0,777)
 var i:i64=0
 while i<12 {
  let a=numeric_buffer_set(&!x,i,i as f64)
  let b=numeric_buffer_set(&!y,i,0.0)
  let c=integer_buffer_set(&!available,i,1)
  let d=integer_buffer_set(&!out,i,777)
  i=i+1
 }
 let a=numeric_buffer_set(&!y,4,9.0)
 let b=numeric_buffer_set(&!y,5,-8.0)
 let c=integer_buffer_set(&!available,7,0)
 let d=integer_buffer_set(&!available,8,0)
 // Inactive payloads must never be read or required finite.
 let nan=0.0/0.0
 let e=numeric_buffer_set(&!x,7,nan)
 let f=numeric_buffer_set(&!y,8,nan)
 let insufficient=dynamic_line_reduce(&x,&y,&available,2.0,9.0,1,&!short)
 assert(insufficient.status==6 && insufficient.required==10 && insufficient.written==0)
 assert(integer_buffer_at(&short,0)==777)
 let result=dynamic_line_reduce(&x,&y,&available,2.0,9.0,1,&!out)
 assert(result.status==0 && result.required==10 && result.written==10)
 let expected:[i64;10]=[0,1,2,4,5,6,7,9,10,11]
 i=0
 while i<10 { assert(integer_buffer_at(&out,i)==expected[i as usize]); i=i+1 }
 assert(integer_buffer_at(&out,10)==777)
 let invalid=integer_buffer_set(&!available,3,2)
 let rejected=dynamic_line_reduce(&x,&y,&available,2.0,9.0,1,&!out)
 assert(rejected.status==3 && rejected.written==0)
 i=0
 while i<10 { assert(integer_buffer_at(&out,i)==expected[i as usize]); i=i+1 }
 let restored=integer_buffer_set(&!available,3,1)
 let descending=numeric_buffer_set(&!x,10,0.0)
 let unordered=dynamic_line_reduce(&x,&y,&available,2.0,9.0,1,&!out)
 assert(unordered.status==4 && unordered.written==0)
 numeric_buffer_close(x); numeric_buffer_close(y)
 integer_buffer_close(available); integer_buffer_close(out); integer_buffer_close(short)
 println("STDLIB_DEEP_VIZ_LINE_REDUCE_PASS")
}
