        0x7, 0xa, 0x9f, 0x46, 0x47, 0x2d, 0x42, 0x65, 0x7d, 0x1c, 0x7e, 0x2f,
        0x60, 0x47, 0x56, 0x43, 0x6d, 0xec, 0x75, 0x1, 0x99, 0x57, 0xc0, 0xe2,
        0xa8, 0xf4, 0x3a, 0xa3, 0x69, 0x92, 0xe6, 0xb9, 0x2e, 0x24, 0x63, 0x14,
        0xe5, 0xb7, 0x33, 0x89, 0xc1, 0x80, 0x85, 0x6e, 0xa6, 0xc4, 0x14, 0x81,
        0x2f, 0x12, 0x2, 0xf0, 0xc9, 0x67, 0xad, 0x2d, 0x38, 0xed, 0xdb, 0x5a,
        0x22, 0x66, 0x58, 0xa6, 0x12, 0x45, 0xd9, 0x2f, 0x7f, 0x88, 0xe1,
    ]

    let der_buf = rawbuf_new(der_len + 8)
    var i: i64 = 0
    while i < der_len {
        rawbuf_set(&der_buf, i, der_bytes[i as usize] as i64)
        i = i + 1
    }

    let (cert, perr) = x509_parse_certificate(&der_buf, der_len)
    if perr != 0 {
        println("tls_client_handshake_loopback: failed to parse test certificate")
        return 1
    }

    var store = TrustStore { certs: [certificate_zero(); 512], bufs: [rawbuf_new(1); 512], count: 1 }
    store.certs[0] = cert
    store.bufs[0] = der_buf

    let host_text = "127.0.0.1"
    let host_len = str_len(host_text)
    let host = rawbuf_new(host_len + 8)
    var hi: i64 = 0
    while hi < host_len {
        rawbuf_set(&host, hi, str_char_at(host_text, hi))
        hi = hi + 1
    }

    let now_unix: i64 = 1787720000 // real wall-clock time at test-authoring, inside the cert's 1-day validity window (regenerate the cert if this test is run long after 2026-08-27)

    let (conn, result_code) = tls_connect(&host, host_len, 44330 as u16, &store, now_unix)
    if result_code != 0 {
        println("tls_client_handshake_loopback: handshake failed")
        print_int(result_code)
        return 1
    }
    println("tls_client_handshake_loopback: handshake reached application keys")
    return 0
}
