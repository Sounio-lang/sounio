//@ run-pass
// Drives a real TLS 1.3 handshake against a local openssl s_server on
// loopback, using an RSA test certificate (openssl's default key type),
// confirming the connection reaches the application-key-derived state.
//
// Test cert generated via:
//   openssl req -x509 -newkey rsa:2048 -keyout rsa_key.pem -out rsa_cert.pem \
//     -days 1 -nodes -subj "/CN=localhost" -addext "subjectAltName=DNS:127.0.0.1"
//   openssl x509 -in rsa_cert.pem -outform DER -out rsa_cert.der
// Server driven via:
//   openssl s_server -key rsa_key.pem -cert rsa_cert.pem -accept 44330 -tls1_3 -www
//
// The SAN carries the literal text "127.0.0.1" as a DNS-type GeneralName
// (openssl accepts this without validating it looks like an IP) so that
// x509_verify_hostname's DNS-type exact-match path succeeds against the
// "127.0.0.1" text this test passes as `host` -- stdlib/x509/chain.sio's
// hostname checker has no separate IP-address SAN type support.

use tls::client::*
use x509::trust_store::*
use x509::cert::*
use net::socket::*

