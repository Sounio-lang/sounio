//@ run-pass
//@ requires: madaros
//@ expect-stdout: 2147483647
//@ expect-stdout: -2147483648
//@ expect-stdout: 3000000
//@ expect-stdout: 4294967295
//@ expect-stdout: 2147483647
//@ expect-stdout: 2147483647
//@ expect-stdout: I32_IN_RANGE_PASS

// ADR-031 R1: dynamic i32/u32 arithmetic is range-checked, not wrapped.
// Every result below sits exactly on or inside a 32-bit bound, so the check
// must let it through unchanged. The id() wrappers keep the operands out of
// const folding so the runtime check is exercised. The panic cases
// (i32::MAX + 1, i32::MIN - 1, 10^6 * 3000, u32::MAX + 1, -i32::MIN) are
// pinned by scripts/ci/madaros_int_overflow_gate.sh.
fn id32(x: i32) -> i32 { x }
fn idu32(x: u32) -> u32 { x }
fn bump(x: i32) -> i32 { x + 1 }

fn main() -> i32 with IO {
    let a: i32 = id32(2147483646)
    println(a + 1)
    let n: i32 = id32(-2147483647)
    println(n - 1)
    println(id32(1000) * id32(3000))
    let w: u32 = idu32(4294967294)
    println(w + 1)
    println(bump(a))
    println(-n)
    if a + 1 == 2147483647 && n - 1 == -2147483648 && w + 1 == 4294967295 && bump(a) == 2147483647 {
        print("I32_IN_RANGE_PASS\n")
    }
    return 0
}
