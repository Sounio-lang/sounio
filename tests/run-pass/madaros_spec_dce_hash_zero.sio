//@ run-pass
// spec_dce hash-0 sentinel bug: fZOXITBAFRX_E's ast_name_hash is exactly 0
// under this compiler's djb2 ast_name_hash (confirmed directly, and
// independently in Python). self-hosted/check/specializer.sio's cross-module
// DCE reachability marker (spec_dce_hash_insert / spec_dce_hash_find) used
// `if h == 0 { return false }` as a shortcut, indistinguishable from the
// open-addressing `marks[]` table's own empty-slot sentinel. A call site to
// this function could never mark it reachable, so DCE dropped its
// still-called FnDef and the compile failed closed:
//   error[E137] ... use of undeclared variable
//   name fZOXITBAFRX_E
//   IR lowering failed during merge: epistemic_export_failed
// Single module, no imports, no collision -- the plain unconditional path
// (module_frontend_lower_single_program_array_direct_box). Fixed by storing
// key = h + 1 in marks[], the same fix as private_fn_identity.sio's
// pfi_census_note/pfi_census_mods for the identical bug class.
// See docs/audit/MADAROS_SPEC_DCE_HASH_ZERO_2026-09-22.md.
//@ requires: madaros
//@ expect-stdout: 20

fn fZOXITBAFRX_E() -> i64 {
    20
}

fn main() -> i64 with IO {
    print_int(fZOXITBAFRX_E())
    0
}
