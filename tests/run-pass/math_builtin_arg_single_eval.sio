//@ run-pass
//@ requires: madaros
//@ expect-stdout: 1:1:1
// SIO-146: a math-builtin call with a compound argument (`log(0.5 +
// unif(st))`) evaluated the argument TWICE: once for the call, once more
// when the FO transfer re-lowered the argument value for the derivative
// (the second value feeds only the derivative and is discarded, but its
// side effects execute -- the RNG was consumed twice). The transfer now
// bails (variance unknown) unless the arguments are relower-safe, so each
// effectful argument below runs exactly once.
var NCALL: i64
fn bump() -> f64 with Mut {
    NCALL = NCALL + 1
    return 0.5
}
fn main() -> i64 with IO, Mut, Div, Panic {
    NCALL = 0
    let r = log(bump() + 0.5)
    print_int(NCALL)
    print(":")
    NCALL = 0
    let e = exp(bump() + 0.5)
    print_int(NCALL)
    print(":")
    NCALL = 0
    let s = sqrt(bump() + 0.5)
    print_int(NCALL)
    println("")
    return 0
}
