//@ run-pass
//@ ignore BLOCKED: test harness does not set SOUNIO_STDLIB_PATH for stdlib imports
// Tests for stdlib/theorem/tactics.sio: basic tactic framework

use theorem::kernel::*;
use theorem::tactics::*;

fn run_tests(ctx: &! ProofContext, ts: &! TacticStore) -> i32 {
    // Test 1: tac_refl proves a = a
    let eq_prop = ctx_prop(ctx, prop_eq(42, 42))
    let goal = goal_new(eq_prop)
    let t_refl = tac_refl(ts)
    let r1 = apply_tactic(ctx, ts, t_refl, goal)
    if r1.success == false {
        return 1
    }

    // Test 2: tac_trivial proves True
    let true_prop = ctx_prop(ctx, prop_true())
    let goal2 = goal_new(true_prop)
    let t_trivial = tac_trivial(ts)
    let r2 = apply_tactic(ctx, ts, t_trivial, goal2)
    if r2.success == false {
        return 2
    }

    // Test 3: tac_exact uses a provided proof
    let prf_id = true_intro(ctx)
    let t_exact = tac_exact(ts, prf_id)
    let r3 = apply_tactic(ctx, ts, t_exact, goal2)
    if r3.success == false {
        return 3
    }

    // Test 4: tac_assumption finds proof in context
    let p_prop = ctx_prop(ctx, prop_custom(40001))
    let p_prf = trusted(ctx, 1, p_prop, 1.0)
    let goal4 = goal_assume(goal_new(p_prop), 1, p_prf)
    let t_assumption = tac_assumption(ts)
    let r4 = apply_tactic(ctx, ts, t_assumption, goal4)
    if r4.success == false {
        return 4
    }

    // Test 5: tac_split generates subgoals for P /\ Q
    let q_prop = ctx_prop(ctx, prop_custom(40002))
    let pq_prop = ctx_prop(ctx, prop_and(p_prop, q_prop))
    let goal5 = goal_new(pq_prop)
    let t_split = tac_split(ts)
    let r5 = apply_tactic(ctx, ts, t_split, goal5)
    if r5.success == false {
        return 5
    }
    if r5.remaining != 2 {
        return 6
    }

    // Test 6: tac_left chooses left of P \/ Q
    let or_prop = ctx_prop(ctx, prop_or(p_prop, q_prop))
    let goal6 = goal_new(or_prop)
    let t_left = tac_left(ts)
    let r6 = apply_tactic(ctx, ts, t_left, goal6)
    if r6.success == false {
        return 7
    }
    if r6.remaining != 1 {
        return 8
    }

    // Test 7: tac_alt tries first, falls back to second
    let fail_prop = ctx_prop(ctx, prop_custom(99999))
    let goal7 = goal_new(fail_prop)
    let t_try_trivial = tac_try(ts, t_trivial)
    let t_alt = tac_alt(ts, t_refl, t_try_trivial)
    let r7 = apply_tactic(ctx, ts, t_alt, goal7)
    if r7.success == false {
        return 9
    }

    // Test 8: tac_confidence_cmp (Sounio-specific)
    let conf_prop = ctx_prop(ctx, prop_custom(80001))
    let goal8 = goal_new(conf_prop)
    let t_conf = tac_confidence_cmp(ts)
    let r8 = apply_tactic(ctx, ts, t_conf, goal8)
    if r8.success == false {
        return 10
    }

    // Test 9: solve_goal completes a True goal
    let prf9 = solve_goal(ctx, ts, t_trivial, goal_new(true_prop))
    if proof_confidence(ctx, prf9) < 0.99 {
        return 11
    }

    return 0
}

fn main() -> i32 {
    var ctx = proof_context_new()
    var ts = tac_store_new()
    return run_tests(&! ctx, &! ts)
}
