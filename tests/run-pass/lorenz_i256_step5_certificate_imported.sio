//@ run-pass
//@ requires: madaros
//@ description: Imported systems::lorenz_i256_cert fifth-step certificate contract smoke

use systems::lorenz_i256_cert::*

fn main() -> i64 with Mod {
    if lorenz_i256_cert_ready() != 1 { return 1 }

    let step5_fp = lorenz_i256_step5_certificate_fingerprint(
        4920371098, 8816077911, 4092986080,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731223, 4084837935, 1)
    if step5_fp != 561641681 { return 2 }

    let chain_fp = lorenz_i256_five_step_chain_fingerprint(
        5, 510854875, 899209716, 603078026, 753371133,
        step5_fp, 5309941770, 10058731223, 4084837935)
    if chain_fp != 23144051 { return 3 }

    let checked_chain_fp = lorenz_i256_step5_certificate_check(
        42949672, 96,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731223, 4084837935)
    if checked_chain_fp != 23144051 { return 4 }

    if lorenz_i256_step5_certificate_check(
        42949672, 95,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731223, 4084837935) != (0 - 1) { return 5 }

    if lorenz_i256_step5_certificate_check(
        42949672, 96,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 3, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731223, 4084837935) != (0 - 1) { return 6 }

    if lorenz_i256_step5_certificate_check(
        42949672, 96,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731224, 4084837935) != (0 - 1) { return 7 }

    if lorenz_i256_five_step_chain_fingerprint(
        5, 510854875, 899209716, 603078026, 753371133,
        step5_fp, 5309941770, 10058731224, 4084837935) != (0 - 1) { return 8 }

    return 0
}
