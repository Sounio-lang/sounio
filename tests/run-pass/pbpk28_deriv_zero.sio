//@ run-pass
// Force early exit from extract (f0 check) — no ODE loop
use darwin_pbpk::cumulants::*
use darwin_pbpk::epistemic_pbpk28::*

fn main() -> i32 with IO, Mut, Div, Panic {
    println("extract t_end=0")
    let der = extract_pbpk28_derivatives(ep28_rapamycin_params(), ep28_rapamycin_priors(), 5.0, 0.0)
    println("after extract")
    if der.success { println("unexpected success"); return 1 }
    println("pbpk28_deriv_zero: PASS")
    return 0
}
