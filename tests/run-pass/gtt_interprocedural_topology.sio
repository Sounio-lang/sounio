//@ run-pass
//
// Gradient Topology Types (GTT) — β⁹ week-3 regression (inter-procedural).
//
// Week-2 tracked channel topology through let-bindings, additive/
// multiplicative ops, and two-arg builtins (atan2, pow).  It did NOT
// union topology across user-defined function calls — the return
// inherited only the *last* argument's channel set.
//
// Concretely, for
//
//     fn my_sum(a: f64, b: f64) -> f64 { a + b }
//     let x = k0.value   // channel 0
//     let y = k1.value   // channel 1
//     hessian_of(my_sum(x, y), 0, 1)
//
// week-2 left EXPR_CH_SET = {ch1} (only y's topology), and the query
// H_{0,1} was REFUSED at type-check because channel 0 was not in the set.
//
// Week-3 unions the channel sets of every argument into the return
// topology (conservative upper bound, matching the atan2/pow discipline).
// The same program now type-checks.  KL-16c wires inter-procedural
// SSHADOW ch0 + H[0,0], so my_square(x) yields H[0,0]=2.0 at runtime;
// my_sum cross-term stays 0.0 analytically.  Topology tracking and
// multi-channel interproc shadows remain orthogonal concerns.
//
// Single-arg fns (my_square below) were correct by accident pre-fix and
// continue to work — union of one set is itself.

fn my_sum(a: f64, b: f64) -> f64 with Epistemic {
    a + b
}

fn my_square(x: f64) -> f64 with Epistemic {
    x * x
}

fn main() with IO, Epistemic, Mut, Div {
    let k0: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let k1: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
    let x = k0.value              // channel 0
    let y = k1.value              // channel 1

    // Week-3 regression: union topology across a 2-arg user fn.
    // Pre-fix: refused (channel 0 missing from leaked {ch1}).
    // Post-fix: accepted (union = {ch0, ch1}).
    let h_cross = hessian_of(my_sum(x, y), 0, 1)
    println(h_cross)

    // Symmetry check: the (1,0) query was accepted pre-fix by accident
    // (ch1 happened to be the last-loaded arg's channel).  Post-fix
    // still accepted — the union is a superset of the leak.
    let h_sym = hessian_of(my_sum(x, y), 1, 0)
    println(h_sym)

    // Single-arg: unchanged behavior, sanity check.
    let h_unary = hessian_of(my_square(x), 0, 0)
    println(h_unary)
}
