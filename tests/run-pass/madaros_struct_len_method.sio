//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS struct_len_method
// A user method named `len` on a struct must dispatch to the method, not the
// array/string `.len()` intrinsic. Madaros lowered `w.len()` as IrArrayLen on
// the struct handle and returned 0 after two pushes (HeapI64Vec-style push +
// len reported `FAIL len=0`).

struct W { ptr: *mut i64, len: i64, }

impl W {
    pub fn put(self: &!W, val: i64) with Mut {
        write_i64(self.ptr, self.len, val)
        self.len = self.len + 1
    }
    pub fn len(self: &W) -> i64 { self.len }
}

struct C { n: i64, }

impl C {
    pub fn len(self: &C) -> i64 { self.n }
    pub fn count(self: &C) -> i64 { self.n * 2 }
}

fn main() -> i32 with IO, Alloc, Mut {
    var w = W { ptr: heap_alloc(64) as *mut i64, len: 0 }
    w.put(10)
    w.put(20)
    if w.len() != 2 {
        print("FAIL w.len\n")
        return 1
    }
    if read_i64(w.ptr, 1) != 20 {
        print("FAIL w slot\n")
        return 1
    }

    let c = C { n: 7 }
    if c.len() != 7 {
        print("FAIL c.len\n")
        return 1
    }
    if c.count() != 14 {
        print("FAIL c.count\n")
        return 1
    }

    // The intrinsic spelling still works beside the user methods.
    let arr: [i64; 5] = [1, 2, 3, 4, 5]
    if arr.len() != 5 {
        print("FAIL arr.len\n")
        return 1
    }

    print("PASS struct_len_method\n")
    return 0
}
