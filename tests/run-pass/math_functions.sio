//@ run-pass
/// Test suite for core math library
///
/// Validates that libm FFI bindings work correctly and provide
/// accurate results compared to known mathematical constants.

use core::math::*;

fn test_exponential() -> bool {
    // Test exp(1) ≈ e
    let e_computed = exp(1.0);
    let error = abs_f64(e_computed - E);
    if error > 1e-10 {
        return false
    }

    // Test log(e) ≈ 1
    let one = log(E);
    if abs_f64(one - 1.0) > 1e-10 {
        return false
    }

    // Test exp(log(x)) = x
    let x = 5.0;
    let roundtrip = exp(log(x));
    if abs_f64(roundtrip - x) > 1e-10 {
        return false
    }

    return true
}

fn test_trigonometric() -> bool {
    // Test sin²(x) + cos²(x) = 1
    let x = 0.7;
    let sin_x = sin(x);
    let cos_x = cos(x);
    let identity = sin_x * sin_x + cos_x * cos_x;
    if abs_f64(identity - 1.0) > 1e-10 {
        return false
    }

    // Test sin(π/2) ≈ 1
    let sin_pi_2 = sin(FRAC_PI_2);
    if abs_f64(sin_pi_2 - 1.0) > 1e-10 {
        return false
    }

    // Test cos(0) = 1
    let cos_0 = cos(0.0);
    if abs_f64(cos_0 - 1.0) > 1e-10 {
        return false
    }

    return true
}

fn test_power_functions() -> bool {
    // Test sqrt(x²) = x
    let x = 4.0;
    let x_squared = x * x;
    let x_recovered = sqrt(x_squared);
    if abs_f64(x_recovered - x) > 1e-10 {
        return false
    }

    // Test cbrt(x³) = x
    let y = 3.0;
    let y_cubed = y * y * y;
    let y_recovered = cbrt(y_cubed);
    if abs_f64(y_recovered - y) > 1e-10 {
        return false
    }

    // Test pow(2, 10) = 1024
    let power = pow(2.0, 10.0);
    if abs_f64(power - 1024.0) > 1e-10 {
        return false
    }

    return true
}

fn test_special_functions() -> bool {
    // Test erf(0) = 0
    let erf_0 = erf(0.0);
    if abs_f64(erf_0) > 1e-10 {
        return false
    }

    // Test erf(x) + erfc(x) = 1
    let x = 1.5;
    let erf_x = erf(x);
    let erfc_x = erfc(x);
    let sum = erf_x + erfc_x;
    if abs_f64(sum - 1.0) > 1e-10 {
        return false
    }

    // Test Γ(5) = 4! = 24
    let gamma_5 = tgamma(5.0);
    if abs_f64(gamma_5 - 24.0) > 1e-6 {
        return false
    }

    return true
}

fn test_rounding() -> bool {
    // Test floor
    if abs_f64(floor(2.9) - 2.0) > 1e-10 {
        return false
    }
    if abs_f64(floor(-2.1) + 3.0) > 1e-10 {
        return false
    }

    // Test ceil
    if abs_f64(ceil(2.1) - 3.0) > 1e-10 {
        return false
    }
    if abs_f64(ceil(-2.9) + 2.0) > 1e-10 {
        return false
    }

    // Test round
    if abs_f64(round(2.4) - 2.0) > 1e-10 {
        return false
    }
    if abs_f64(round(2.6) - 3.0) > 1e-10 {
        return false
    }

    return true
}

fn test_hyperbolic() -> bool {
    // Test cosh²(x) - sinh²(x) = 1
    let x = 1.0;
    let cosh_x = cosh(x);
    let sinh_x = sinh(x);
    let identity = cosh_x * cosh_x - sinh_x * sinh_x;
    if abs_f64(identity - 1.0) > 1e-10 {
        return false
    }

    // Test tanh(x) = sinh(x)/cosh(x)
    let tanh_x = tanh(x);
    let ratio = sinh_x / cosh_x;
    if abs_f64(tanh_x - ratio) > 1e-10 {
        return false
    }

    return true
}

fn test_helper_functions() -> bool {
    // Test clamp
    if abs_f64(clamp(5.0, 0.0, 10.0) - 5.0) > 1e-10 {
        return false
    }
    if abs_f64(clamp(-2.0, 0.0, 10.0) - 0.0) > 1e-10 {
        return false
    }
    if abs_f64(clamp(15.0, 0.0, 10.0) - 10.0) > 1e-10 {
        return false
    }

    // Test lerp
    if abs_f64(lerp(0.0, 10.0, 0.5) - 5.0) > 1e-10 {
        return false
    }
    if abs_f64(lerp(0.0, 10.0, 0.0) - 0.0) > 1e-10 {
        return false
    }
    if abs_f64(lerp(0.0, 10.0, 1.0) - 10.0) > 1e-10 {
        return false
    }

    // Test angle conversion
    let deg_90 = 90.0;
    let rad = radians(deg_90);
    if abs_f64(rad - FRAC_PI_2) > 1e-10 {
        return false
    }
    let deg_back = degrees(rad);
    if abs_f64(deg_back - deg_90) > 1e-10 {
        return false
    }

    return true
}

// Simple abs function for testing (until we can use math::abs)
fn abs_f64(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

fn main() -> i32 {
    // Run all test suites
    if !test_exponential() {
        return 1
    }

    if !test_trigonometric() {
        return 2
    }

    if !test_power_functions() {
        return 3
    }

    if !test_special_functions() {
        return 4
    }

    if !test_rounding() {
        return 5
    }

    if !test_hyperbolic() {
        return 6
    }

    if !test_helper_functions() {
        return 7
    }

    // All tests passed
    return 0
}
