//@ run-pass
// Async channels test

use sync::channel::*;

fn run_channel_roundtrip(ch: &! IntChannel) -> i32 with Mut {
    if !channel_send(ch, 42) { return 1 }
    if !channel_send(ch, 100) { return 2 }
    let first = channel_recv(ch)
    let second = channel_recv(ch)
    if first != 42 { return 3 }
    if second != 100 { return 4 }
    return 0
}

fn main() -> i32 with Async, Mut {
    var ch = channel_new()

    let status = async { 0 }.await
    if status != 0 { return status }
    return run_channel_roundtrip(&! ch)
}
