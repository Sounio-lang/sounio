//@ run-pass
// Async channels test

use sync::channel::*;

var TEST_CHANNEL_ID: i64 = -1

fn send_pair(ch: IntChannel) -> i32 with Mut, IO {
    var first = ch
    if !channel_send(&! first, 42) { return 1 }
    var second = ch
    if !channel_send(&! second, 100) { return 2 }
    return 0
}

async fn send_pair_global() -> i32 with Async, Mut, IO {
    let ch = channel_from_id(TEST_CHANNEL_ID)
    send_pair(ch)
}

fn run_channel_roundtrip(ch: &! IntChannel) -> i32 with Async, Mut, IO {
    TEST_CHANNEL_ID = channel_id(ch)
    let sender = spawn { send_pair_global().await }
    let first = channel_recv(ch)
    let second = channel_recv(ch)
    let sender_status = sender.await
    if sender_status != 0 { return sender_status }
    if first != 42 { return 3 }
    if second != 100 { return 4 }
    return 0
}

fn main() -> i32 with Async, Mut, IO {
    var ch = channel_new()

    let status = async { 0 }.await
    if status != 0 { return status }
    return run_channel_roundtrip(&! ch)
}
