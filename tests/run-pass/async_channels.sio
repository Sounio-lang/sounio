//@ run-pass
//@ expect-stdout-contains: channel_basic: PASS
//@ native-pass
// Async channels test

fn main() -> i64 with IO, Async {
    var exit_fails: i64 = 0
    // Create a channel
    let (tx, rx) = channel::<i32>()

    // Spawn producer
    spawn {
        tx.send(42).await
        tx.send(100).await
    }

    // Receive values
    let first = rx.recv().await
    let second = rx.recv().await

    if first == 42 && second == 100 {
        print("channel_basic: PASS\n")
    } else {
        print("channel_basic: FAIL\n")
        exit_fails = exit_fails + 1
    }
    if exit_fails > 0 {
        return 1
    }
    return 0
}
