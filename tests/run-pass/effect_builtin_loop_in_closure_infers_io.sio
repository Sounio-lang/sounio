//@ run-pass
//@ requires: madaros
//@ expect-stdout: LOOP_CLOSURE_IO_OK
//@ description: #2760 review -- a closure body infers its effects, also when the builtin call sits inside a `loop`. The by-value spine used to report E035 there while the same closure without the `loop` inferred IO, so the closure could not be passed to a parameter typed `with IO`.

fn apply(f: fn(i64) -> i64 with IO, x: i64) -> i64 with IO {
    f(x)
}

fn main() -> i32 with IO {
    let r = apply(|x: i64| -> i64 {
        loop {
            println("LOOP_CLOSURE_IO_OK")
            break
        }
        x + 1
    }, 41)
    if r == 42 { 0 } else { 1 }
}
