//@ run-pass
// R2 narrow-integer witness: u8 200 + 200 must wrap to 144 (200+200=400,
// 400 mod 256 = 144).

fn main() with IO, Div, Panic {
    let x: u8 = 200 + 200
    if x == 144 {
        print("r2_u8_overflow: PASS\n")
    } else {
        print("r2_u8_overflow: FAIL got=")
        print_int(x)
        print("\n")
    }
}
