    receipt_fp = mix(receipt_fp, 675936756, 6037)
    receipt_fp = mix(receipt_fp, 296443716, 6037)
    receipt_fp = mix(receipt_fp, 2, 6037)
    receipt_fp = mix(receipt_fp, 14, 6037)
    receipt_fp = mix(receipt_fp, 255, 6037)
    if receipt_fp != 175151226 { return 1 }

    var audit_fp: i64 = 2029
    audit_fp = mix(audit_fp, receipt_fp, 6043)
    audit_fp = mix(audit_fp, 85766158, 6043)
    audit_fp = mix(audit_fp, 81234415, 6043)
    audit_fp = mix(audit_fp, 7118356, 6043)
