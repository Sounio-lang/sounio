//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v125 smoke for Lorenz i256 step-2 Taylor-2 time-slab containment

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2027
    receipt_fp = mix(receipt_fp, 85766158, 6037)
    receipt_fp = mix(receipt_fp, 81234415, 6037)
    receipt_fp = mix(receipt_fp, 487184792, 6037)
    receipt_fp = mix(receipt_fp, 449547056, 6037)
