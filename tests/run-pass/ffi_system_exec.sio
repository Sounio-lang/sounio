//@ run-pass
//@ expect-stdout: ffi_system_exec: PASS
//@ ignore — engine-forced. Executed by scripts/ci/ffi_extern_c_gate.sh against
//   a source-built lean_single (the committed seed can lag the source; see #725).
//   The default Madaros engine does not implement extern "C" system() yet —
//   Track A, docs/audit/EXTERN_C_FFI_SILENT_NOOP_DISPATCH_2026-08-13.md.
//   Remove this ignore line when Track A lands.
//
// Regression for Track B (2026-08-15): extern "C" system() must genuinely
// fork + execve("/bin/sh","-c",cmd) + wait4 via raw syscalls, not claim rc=0
// while doing nothing. The rc==0 check below alone cannot catch the silent
// no-op (a fabricated 0 also satisfies it); the side-effect file
// /tmp/sounio_ffi_system_probe is the real assertion, enforced by the gate.
//
// The command is deliberately SHORT (34 chars): the stub has a known
// command-length defect starting around ~100 chars — see secondary bug #3 in
// the dispatch doc above. Do not lengthen it without re-reading that section.

extern "C" {
    fn system(cmd: &[i8; 1024]) -> i32
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var cmd: [i8; 1024] = [0; 1024]
    let s = "touch /tmp/sounio_ffi_system_probe"
    var i: i64 = 0
    let n = str_len(s) as i64
    while i < n && i < 1023 {
        cmd[i as usize] = str_char_at(s, i as usize) as i8
        i = i + 1
    }
    let rc = system(&cmd)
    if rc == 0 {
        println("ffi_system_exec: PASS")
        return 0
    }
    println("ffi_system_exec: FAIL")
    return 1
}
