//@ run-pass
//@ expect-stdout: ffi_system_exec: PASS
// Track A landed 2026-08-16: the default Madaros engine implements extern "C"
// system() as a real fork/execve("/bin/sh","-c",cmd)/wait4 (ffi_system,
// builtin id 33). The engine-forcing //@ ignore is removed; this runs under
// the default suite. Cross-engine coverage stays in
// scripts/ci/ffi_extern_c_gate.sh.
//
// C's system() takes a `const char *`, so the idiomatic Sounio binding is a
// `string` parameter — a string is already the NUL-terminated char* the raw
// execve consumes. (The historical &[i8;1024] binding is a documented
// known-failure through the signatureless ffi_ path — see
// ffi_system_array_arg.sio and the Track A dispatch doc.)
//
// Anti-fabrication: a fabricated-0 no-op stub cannot satisfy BOTH branches —
// /bin/true exits 0 (wait status 0) and /bin/false exits 1 (wait status
// nonzero). Absolute paths are used so the test never depends on the shell's
// default PATH (system() passes envp=NULL). The touch below is the
// side-effect the cross-engine gate asserts on.

extern "C" {
    fn system(cmd: string) -> i64;
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let ok = system("/usr/bin/touch /tmp/sounio_ffi_system_probe")
    let t = system("/bin/true")
    let f = system("/bin/false")
    if ok == 0 && t == 0 && f != 0 {
        println("ffi_system_exec: PASS")
        return 0
    }
    println("ffi_system_exec: FAIL")
    return 1
}
