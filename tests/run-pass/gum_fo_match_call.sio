//@ run-pass
//@ requires: madaros
//@ expect-stdout: arm0 0.090000
//@ expect-stdout: arm1 0.360000
//@ expect-stdout: arm2 9.000000
//@ expect-stdout: direct 0.090000
//@ expect-stdout: MATCH_VAR_OK
// a = 5 +- 0.3, var = 0.09.
// arm 0 is a, arm 1 is 2*a, arm 2 is a*a.
// The call and the direct match must follow the arm the value takes.

fn arm(x: f64, n: i64) -> f64 {
    match n {
        0 => x,
        1 => 2.0 * x,
        _ => x * x,
    }
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let arm0 = variance_of(arm(a, 0))
    let arm1 = variance_of(arm(a, 1))
    let arm2 = variance_of(arm(a, 2))
    let direct = variance_of(match 0 {
        0 => a,
        _ => 2.0 * a,
    })
    print("arm0 ")
    print_f64(arm0)
    println("")
    print("arm1 ")
    print_f64(arm1)
    println("")
    print("arm2 ")
    print_f64(arm2)
    println("")
    print("direct ")
    print_f64(direct)
    println("")
    var fails: i64 = 0
    if arm0 < 0.089999 || arm0 > 0.090001 { fails = fails + 1 }
    if arm1 < 0.359999 || arm1 > 0.360001 { fails = fails + 1 }
    if arm2 < 8.999999 || arm2 > 9.000001 { fails = fails + 1 }
    if direct < 0.089999 || direct > 0.090001 { fails = fails + 1 }
    if fails == 0 {
        println("MATCH_VAR_OK")
        0
    } else {
        println("MATCH_VAR_FAIL")
        1
    }
}
