//@ run-pass
//@ requires: madaros
//@ description: Scalar graph-colouring CNF manifest fingerprint gate

fn card_exactly_one_clause_count(n: i64) -> i64 {
    if n <= 0 { return 0 }
    return 1 + (n * (n - 1)) / 2
}

fn card_colour_vertex_clause_count(colour_count: i64) -> i64 {
    return card_exactly_one_clause_count(colour_count)
}

fn card_colour_var_count(vertex_count: i64, colour_count: i64) -> i64 {
    if vertex_count < 0 { return 0 - 1 }
    if colour_count <= 0 { return 0 - 1 }
    return vertex_count * colour_count
}

fn card_colour_vertex_block_count(vertex_count: i64, colour_count: i64) -> i64 {
    if vertex_count < 0 { return 0 - 1 }
    let per_vertex = card_colour_vertex_clause_count(colour_count)
    if per_vertex <= 0 { return 0 - 1 }
    return vertex_count * per_vertex
}

fn card_colour_edge_base_id(vertex_count: i64, colour_count: i64) -> i64 {
    let vertex_block = card_colour_vertex_block_count(vertex_count, colour_count)
    if vertex_block < 0 { return 0 - 1 }
    return vertex_block + 1
}

fn card_colour_edge_clause_count(edge_count: i64, colour_count: i64) -> i64 {
    if edge_count < 0 { return 0 - 1 }
    if colour_count <= 0 { return 0 - 1 }
    return edge_count * colour_count
}

fn card_colour_total_clause_count(vertex_count: i64, edge_count: i64, colour_count: i64) -> i64 {
    let vertex_block = card_colour_vertex_block_count(vertex_count, colour_count)
    if vertex_block < 0 { return 0 - 1 }
    let edge_block = card_colour_edge_clause_count(edge_count, colour_count)
    if edge_block < 0 { return 0 - 1 }
    return vertex_block + edge_block
}

fn card_colour_manifest_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 1315423911) + value + 97) % 1000000007
}

fn card_colour_manifest_fingerprint(vertex_count: i64, edge_count: i64, colour_count: i64) -> i64 {
    let var_count = card_colour_var_count(vertex_count, colour_count)
    if var_count < 0 { return 0 - 1 }
    let vertex_block = card_colour_vertex_block_count(vertex_count, colour_count)
    if vertex_block < 0 { return 0 - 1 }
    let edge_base = card_colour_edge_base_id(vertex_count, colour_count)
    if edge_base < 0 { return 0 - 1 }
    let edge_block = card_colour_edge_clause_count(edge_count, colour_count)
    if edge_block < 0 { return 0 - 1 }
    let total = card_colour_total_clause_count(vertex_count, edge_count, colour_count)
    if total < 0 { return 0 - 1 }

    var acc: i64 = 17
    acc = card_colour_manifest_mix(acc, vertex_count)
    acc = card_colour_manifest_mix(acc, edge_count)
    acc = card_colour_manifest_mix(acc, colour_count)
    acc = card_colour_manifest_mix(acc, var_count)
    acc = card_colour_manifest_mix(acc, vertex_block)
    acc = card_colour_manifest_mix(acc, edge_base)
    acc = card_colour_manifest_mix(acc, edge_block)
    acc = card_colour_manifest_mix(acc, total)
    return acc
}

fn main() -> i64 {
    if card_colour_var_count(3, 2) != 6 { return 1 }
    if card_colour_manifest_fingerprint(3, 3, 2) != 296728038 { return 2 }
    if card_colour_manifest_fingerprint(3, 2, 2) != 760753411 { return 3 }
    if card_colour_manifest_fingerprint(2, 3, 2) != 744533223 { return 4 }
    if card_colour_manifest_fingerprint(3, 3, 3) != 675810303 { return 5 }
    if card_colour_manifest_fingerprint(0, 0, 2) != 32219691 { return 6 }

    if card_colour_manifest_fingerprint(3, 2, 2) == 296728038 { return 10 }
    if card_colour_manifest_fingerprint(2, 3, 2) == 296728038 { return 11 }
    if card_colour_manifest_fingerprint(3, 3, 3) == 296728038 { return 12 }
    if card_colour_manifest_fingerprint(0 - 1, 3, 2) != (0 - 1) { return 13 }
    if card_colour_manifest_fingerprint(3, 0 - 1, 2) != (0 - 1) { return 14 }
    if card_colour_manifest_fingerprint(3, 3, 0) != (0 - 1) { return 15 }

    return 0
}
