//@ run-pass
//@ requires: madaros
//@ exit-code: 1
//@ description: cd_embed from level -1 would shift by a negative count; cd_zero refuses the level (panic) before any loop or shift runs
// Without the cd_zero level check this program prints UNREACHED and exits 0.

use algebra::cayley_dickson::*
use algebra::cayley_dickson_tower::*

fn main() with IO, Mut, Panic, Div {
    let r = cd_embed(cd_zero(0 - 1), 0)
    println("UNREACHED")
}
