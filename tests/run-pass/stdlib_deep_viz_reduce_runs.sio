//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_VIZ_REDUCE_RUNS_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_at,integer_buffer_close}
use viz::dynamic_line_reduce::{dynamic_line_reduce}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let n:i64=2000001
 var x=numeric_buffer_new(n,n*8);var y=numeric_buffer_new(n,n*8)
 var a=integer_buffer_new(n,n*8);var out=integer_buffer_new(n,n*8)
 var i:i64=0
 while i<n {
  let q=numeric_buffer_set(&!x,i,i as f64);let r=numeric_buffer_set(&!y,i,(i%31) as f64)
  let t=integer_buffer_set(&!a,i,if i%2==0 {1}else{0});i=i+1
 }
 let result=dynamic_line_reduce(&x,&y,&a,0.0,(n-1) as f64,1024,&!out)
 assert(result.status==0 && result.written==n)
 var checksum:i64=0;i=0
 while i<n {
  let index=integer_buffer_at(&out,i)
  assert(index==i)
  checksum=(checksum+index)%1000000007;i=i+1
 }
 print("REDUCE_RUNS ");print(n);print(" ");println(checksum)
 numeric_buffer_close(x);numeric_buffer_close(y);integer_buffer_close(a);integer_buffer_close(out)
 println("STDLIB_DEEP_VIZ_REDUCE_RUNS_PASS");0
}
