//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 cover child-0 obligation seed non-claim receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1847
    fp = mix(fp, 239912256, 5813)
    fp = mix(fp, 937619929, 5813)
    fp = mix(fp, 974395903, 5813)
    fp = mix(fp, 568368767, 5813)
    fp = mix(fp, 228495843, 5813)
    fp = mix(fp, 911169246, 5813)
    fp = mix(fp, 785916873, 5813)
    fp = mix(fp, 713010204, 5813)
    fp = mix(fp, 725222703, 5813)
    fp = mix(fp, 77888110, 5813)
    fp = mix(fp, 245178976, 5813)
    fp = mix(fp, 0, 5813)
    fp = mix(fp, 0, 5813)
    fp = mix(fp, 0, 5813)
    fp = mix(fp, 0, 5813)
    fp = mix(fp, 3, 5813)
    fp = mix(fp, 2, 5813)
    fp = mix(fp, 8, 5813)
    fp = mix(fp, 1, 5813)
    fp = mix(fp, 1, 5813)
    fp = mix(fp, 1, 5813)
    fp = mix(fp, 8, 5813)
    fp = mix(fp, 0, 5813)
    fp = mix(fp, 256, 5813)
    fp = mix(fp, 32, 5813)
    fp = mix(fp, 1000000, 5813)
    fp = mix(fp, 5, 5813)
    fp = mix(fp, 1, 5813)
    fp = mix(fp, 7, 5813)
    fp = mix(fp, 15, 5813)
    fp = mix(fp, 0, 5813)
    fp = mix(fp, 0, 5813)
    fp = mix(fp, 0, 5813)
    fp = mix(fp, 0, 5813)
    fp = mix(fp, 30, 5813)
    return fp
}

fn certificate_fp(instance: i64) -> i64 {
    var fp: i64 = 1861
    fp = mix(fp, instance, 5821)
    fp = mix(fp, 1, 5821)
    fp = mix(fp, 7, 5821)
    fp = mix(fp, 15, 5821)
    fp = mix(fp, 1, 5821)
    fp = mix(fp, 8, 5821)
    fp = mix(fp, 0, 5821)
    fp = mix(fp, 0, 5821)
    fp = mix(fp, 0, 5821)
    fp = mix(fp, 0, 5821)
    fp = mix(fp, 0, 5821)
    fp = mix(fp, 1, 5821)
    fp = mix(fp, 30, 5821)
    fp = mix(fp, 255, 5821)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64) -> i64 {
    var fp: i64 = 1867
    fp = mix(fp, instance, 5843)
    fp = mix(fp, certificate, 5843)
    fp = mix(fp, 22, 5843)
    fp = mix(fp, 0, 5843)
    fp = mix(fp, 1, 5843)
    fp = mix(fp, 8, 5843)
    fp = mix(fp, 0, 5843)
    fp = mix(fp, 0, 5843)
    fp = mix(fp, 0, 5843)
    fp = mix(fp, 0, 5843)
    fp = mix(fp, 0, 5843)
    fp = mix(fp, 30, 5843)
    fp = mix(fp, 255, 5843)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64) -> i64 {
    var fp: i64 = 1871
    fp = mix(fp, artifact, 5851)
    fp = mix(fp, instance, 5851)
    fp = mix(fp, certificate, 5851)
    fp = mix(fp, 239912256, 5851)
    fp = mix(fp, 937619929, 5851)
    fp = mix(fp, 974395903, 5851)
    fp = mix(fp, 568368767, 5851)
    fp = mix(fp, 228495843, 5851)
    fp = mix(fp, 911169246, 5851)
    fp = mix(fp, 785916873, 5851)
    fp = mix(fp, 713010204, 5851)
    fp = mix(fp, 725222703, 5851)
    fp = mix(fp, 77888110, 5851)
    fp = mix(fp, 245178976, 5851)
    fp = mix(fp, 0, 5851)
    fp = mix(fp, 0, 5851)
    fp = mix(fp, 0, 5851)
    fp = mix(fp, 0, 5851)
    fp = mix(fp, 3, 5851)
    fp = mix(fp, 2, 5851)
    fp = mix(fp, 8, 5851)
    fp = mix(fp, 1, 5851)
    fp = mix(fp, 1, 5851)
    fp = mix(fp, 1, 5851)
    fp = mix(fp, 8, 5851)
    fp = mix(fp, 0, 5851)
    fp = mix(fp, 256, 5851)
    fp = mix(fp, 32, 5851)
    fp = mix(fp, 1000000, 5851)
    fp = mix(fp, 5, 5851)
    fp = mix(fp, 1, 5851)
    fp = mix(fp, 7, 5851)
    fp = mix(fp, 15, 5851)
    fp = mix(fp, 0, 5851)
    fp = mix(fp, 0, 5851)
    fp = mix(fp, 0, 5851)
    fp = mix(fp, 0, 5851)
    fp = mix(fp, 30, 5851)
    fp = mix(fp, 255, 5851)
    return fp
}

fn main() -> i64 {
    let instance = instance_fp()
    if instance != 644624864 { return 1 }
    let certificate = certificate_fp(instance)
    if certificate != 702528645 { return 2 }
    let artifact = artifact_fp(instance, certificate)
    if artifact != 577517715 { return 3 }
    let audit = audit_fp(artifact, instance, certificate)
    if audit != 49794723 { return 4 }
    return 0
}
