//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS
// Regression for #3546: array elements must retain their source channels.

fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    var arr: [f64; 4] = [0.0; 4]
    let ka: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    arr[0] = ka.value
    let y = arr[0] * 2.0
    let v = variance_of(y)
    print("var(arr)*2="); print_f64(v); print("\n")
    if v < 0.039999999 || v > 0.040000001 { return 1 }
    // Two slots from the same source are correlated, not independent.
    arr[1] = ka.value
    let d = arr[0] - arr[1]
    if variance_of(d) > 0.000000001 { return 2 }
    let s = arr[0] + arr[1]
    if variance_of(s) < 0.039999999 { return 3 }
    // A deterministic overwrite clears the old element's sensitivities.
    arr[0] = 3.0
    if variance_of(arr[0]) != 0.0 { return 4 }
    if uncertainty_of(arr[1]) < 0.099999999 { return 5 }
    print("PASS\n")
    return 0
}
