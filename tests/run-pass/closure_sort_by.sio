//@ run-pass
// Sprint 228: Sort-by with function reference comparator

fn cmp_asc(a: i64, b: i64) -> i64 { a - b }
fn cmp_desc(a: i64, b: i64) -> i64 { b - a }

fn sort4(arr: [i64; 4], cmp: fn(i64, i64) -> i64) -> [i64; 4] with Mut, Panic, Div {
    var out = arr
    var swapped: i64 = 1
    while swapped != 0 {
        swapped = 0
        var i: i64 = 0
        while i < 3 {
            if cmp(out[i], out[i + 1]) > 0 {
                let tmp = out[i]
                out[i] = out[i + 1]
                out[i + 1] = tmp
                swapped = 1
            }
            i = i + 1
        }
    }
    out
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let data: [i64; 4] = [4, 1, 3, 2]

    // Test 1: Sort ascending
    let asc = sort4(data, cmp_asc)
    assert(asc[0] == 1)
    assert(asc[1] == 2)
    assert(asc[2] == 3)
    assert(asc[3] == 4)

    // Test 2: Sort descending
    let desc = sort4(data, cmp_desc)
    assert(desc[0] == 4)
    assert(desc[1] == 3)
    assert(desc[2] == 2)
    assert(desc[3] == 1)

    // Test 3: Already sorted input
    let sorted: [i64; 4] = [1, 2, 3, 4]
    let asc2 = sort4(sorted, cmp_asc)
    assert(asc2[0] == 1)
    assert(asc2[3] == 4)

    // Test 4: Reversed input
    let rev: [i64; 4] = [4, 3, 2, 1]
    let asc3 = sort4(rev, cmp_asc)
    assert(asc3[0] == 1)
    assert(asc3[3] == 4)

    print(0)
    0
}
