 y3[1] = 5.00000000000000000
 y3[2] = 9.00000000000000000
 y3[3] = 10.0000000000000000
 y3[4] = 14.0000000000000000
 y3[5] = 20.0000000000000000
 let r3 = t_test_welch(x3, 5, y3, 6)
 assert(close(r3.mean_diff, -6.00000000000000000))
 assert(close(r3.se_diff, 2.89251908665555164))
 assert(close(r3.df, 7.00520934680239508))
 assert(close(r3.t_stat, -2.07431647648605297))
