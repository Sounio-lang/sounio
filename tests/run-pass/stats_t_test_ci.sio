//@ run-pass
//@ expect-stdout: STATS_T_TEST_CI_PASS
use stats::inferential::{t_test_one_sample, t_test_independent, t_test_welch, t_test_paired}
fn close(g: f64, e: f64) -> bool {
 let scale = if e < 0.0 { 0.0-e } else { e }
 let delta = if g > e { g-e } else { e-g }
 delta <= 2.0e-7 * scale + 1.0e-290
}
fn main() with IO, Mut, Div, Panic {
 println("t_case_1")
 var x1: [f64; 100] = [0.0; 100]
 x1[0] = 1.00000000000000000
 x1[1] = 2.00000000000000000
 x1[2] = 4.00000000000000000
 x1[3] = 5.00000000000000000
 x1[4] = 8.00000000000000000
 let r1 = t_test_one_sample(x1, 5, 3.00000000000000000)
 assert(close(r1.mean_diff, 1.00000000000000000))
 assert(close(r1.se_diff, 1.22474487139158905))
 assert(close(r1.df, 4.00000000000000000))
 assert(close(r1.t_stat, 0.816496580927726033))
 assert(close(r1.p_value, 0.460050752843961104))
 assert(close(r1.ci_lower, -2.40043690329127958))
 assert(close(r1.ci_upper, 4.40043690329127958))
 assert(close(r1.cohens_d, 0.365148371670110742))
 println("t_case_2")
 var x2: [f64; 100] = [0.0; 100]
