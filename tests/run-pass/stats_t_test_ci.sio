 assert(close(r7.ci_upper, 8.38689834489148855e+49))
 assert(close(r7.cohens_d, -1.21591094453966270))
 var paired_x: [f64; 100] = [0.0; 100]
 paired_x[0] = 1.00000000000000000
 paired_x[1] = 2.00000000000000000
 paired_x[2] = 4.00000000000000000
 paired_x[3] = 5.00000000000000000
 paired_x[4] = 8.00000000000000000
 var paired_y: [f64; 100] = [0.0; 100]
 paired_y[0] = 0.00000000000000000
 paired_y[1] = 1.00000000000000000
 paired_y[2] = 2.00000000000000000
 paired_y[3] = 3.00000000000000000
 paired_y[4] = 4.00000000000000000
 let paired = t_test_paired(paired_x, paired_y, 5)
 assert(close(paired.mean_diff, 2.00000000000000000))
 assert(close(paired.se_diff, 0.547722557505166113))
 assert(close(paired.df, 4.00000000000000000))
 assert(close(paired.ci_lower, 0.479278386208364102))
 assert(close(paired.ci_upper, 3.52072161379163590))
 println("STATS_T_TEST_CI_PASS")
