 x6[4] = 1000008.00000000000
 var y6: [f64; 100] = [0.0; 100]
 y6[0] = 1000002.00000000000
 y6[1] = 1000005.00000000000
 y6[2] = 1000009.00000000000
 y6[3] = 1000010.00000000000
 y6[4] = 1000014.00000000000
 y6[5] = 1000020.00000000000
 let r6 = t_test_welch(x6, 5, y6, 6)
 assert(close(r6.mean_diff, -6.00000000000000000))
 assert(close(r6.se_diff, 2.89251908665555164))
