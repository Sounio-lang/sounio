 y2[3] = 10.0000000000000000
 y2[4] = 14.0000000000000000
 y2[5] = 20.0000000000000000
 let r2 = t_test_independent(x2, 5, y2, 6)
 assert(close(r2.mean_diff, -6.00000000000000000))
 assert(close(r2.se_diff, 3.10077648578784453))
 assert(close(r2.df, 9.00000000000000000))
 assert(close(r2.t_stat, -1.93499919375050391))
 assert(close(r2.p_value, 0.0849884311833935230))
 assert(close(r2.ci_lower, -13.0144437375612207))
 assert(close(r2.ci_upper, 1.01444373756122070))
 assert(close(r2.cohens_d, -1.17170019882741481))
 println("t_case_3")
 var x3: [f64; 100] = [0.0; 100]
 x3[0] = 1.00000000000000000
 x3[1] = 2.00000000000000000
 x3[2] = 4.00000000000000000
 x3[3] = 5.00000000000000000
