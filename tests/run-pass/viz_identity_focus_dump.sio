//@ run-pass
// tests/run-pass/viz_identity_focus_dump.sio - Visual IR v1.1 identity/focus/dump proof
//
// Expected output:
//   VIZ_IDENTITY_FOCUS_DUMP_PASS

use display::event::{Event, EV_KEY_PRESS, KEY_SPACE}
use viz::ir::{
    viz_scene_new, viz_layout_rect, viz_style_rgb,
    viz_add_button, viz_add_slider, viz_add_toggle, viz_add_tabs, viz_add_label,
    viz_node_id, viz_scene_find_node, viz_scene_set_parent, viz_scene_set_tag,
    viz_scene_focus_next, viz_scene_focus_prev, viz_scene_activate_focused,
    viz_scene_handle_event, viz_scene_dump,
}

fn ev(kind: i64, key: i64, x: i64, y: i64) -> Event {
    Event { kind: kind, key: key, x: x, y: y, mods: 0 }
}

fn main() with IO, Mut, Div {
    var scene = viz_scene_new()
    var label: [i8; 64] = [0; 64]
    label[0] = 82
    label[1] = 117
    label[2] = 110

    let title = viz_add_label(&!scene, &label, 3, viz_layout_rect(4, 4, 40, 12), viz_style_rgb(230, 230, 230))
    let button = viz_add_button(&!scene, &label, 3, viz_layout_rect(8, 24, 48, 18), viz_style_rgb(90, 180, 240))
    let slider = viz_add_slider(&!scene, viz_layout_rect(64, 24, 80, 18), 0.0, 0.0, 10.0, viz_style_rgb(240, 190, 80))
    let toggle = viz_add_toggle(&!scene, viz_layout_rect(152, 24, 28, 18), false, viz_style_rgb(120, 220, 140))
    let tabs = viz_add_tabs(&!scene, viz_layout_rect(8, 54, 120, 18), 0, 0, 3, viz_style_rgb(190, 120, 255))

    let title_id = viz_node_id(&scene, title)
    let button_id = viz_node_id(&scene, button)
    let slider_id = viz_node_id(&scene, slider)
    let toggle_id = viz_node_id(&scene, toggle)
    assert(title_id == 1)
    assert(button_id == 2)
    assert(slider_id == 3)
    assert(toggle_id == 4)
    assert(viz_node_id(&scene, tabs) == 5)
    assert(viz_scene_find_node(&scene, slider_id) == slider)

    viz_scene_set_parent(&!scene, slider, button)
    viz_scene_set_tag(&!scene, slider, 42)
    assert(scene.nodes[slider as usize].parent_id == button_id)
    assert(scene.nodes[slider as usize].tag == 42)

    assert(viz_scene_focus_next(&!scene) == button)
    assert(scene.focused_node == button)
    assert(viz_scene_focus_next(&!scene) == slider)
    assert(viz_scene_focus_next(&!scene) == toggle)
    assert(viz_scene_focus_prev(&!scene) == slider)
    assert(viz_scene_focus_next(&!scene) == toggle)
    assert(viz_scene_activate_focused(&!scene))
    assert(scene.nodes[toggle as usize].value == 1.0)
    assert(scene.selected_node == toggle)

    scene.selected_node = 0 - 1
    scene.hovered_node = 0 - 1
    scene.focused_node = toggle
    assert(viz_scene_handle_event(&!scene, ev(EV_KEY_PRESS, KEY_SPACE, 0, 0)))
    assert(scene.nodes[toggle as usize].value == 0.0)

    viz_scene_dump(&scene)
    println("VIZ_IDENTITY_FOCUS_DUMP_PASS")
}
