//@ run-pass
//@ expect-stdout: 11 12 2
// A struct held in a tuple-literal slot must read its fields at its own
// layout. `A` and `B` declare `x` at different indices, so a by-name lookup
// has to vote. Madaros typed a tuple local's slot 0 only from a call result,
// and never typed a later slot, so `t.0.x` and `t2.1.x` were voted, landed on
// the first-byte hash and printed 0 0 2. lean_single printed 11 12 2.
// SOUNIO_STRICT_FIELD=1 refused both reads with E311 before the fix.
struct A { x: i64, y: i64 }
struct B { y: i64, x: i64 }

fn main() with IO, Mut, Div, Panic, Alloc {
    let a = A { x: 1, y: 2 }
    let t = (B { y: 2, x: 11 }, 0)
    let v = t.0.x
    let t2 = (5, B { y: 3, x: 12 })
    let w = t2.1.x
    print_int(v)
    print(" ")
    print_int(w)
    print(" ")
    print_int(a.y)
    println("")
}
