//@ run-pass
//@ expect-stdout: generic HOF scalar inference: PASS

fn apply<T>(f: fn(T) -> T with Mut, x: T) -> T with Mut { f(x) }
fn double_int(x: i64) -> i64 { x * 2 }
fn main() -> i32 with IO, Mut, Panic, Div {
    assert(apply(|x: i64| x * 2, 5) == 10)
    assert(apply(double_int, 7) == 14)
    let value: f64 = apply(|x: f64| x * 2.0, 1.25)
    assert(value == 2.5)
    print("generic HOF scalar inference: PASS\n")
    0
}
