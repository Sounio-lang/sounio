//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_KDE_STATUS_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_at,integer_buffer_close}
use stats::dynamic_kde::gaussian_kde_dynamic
fn main()->i32 with IO,Mut,Div,Panic,Alloc {
 var observations=numeric_buffer_new(3,24)
 var mask=integer_buffer_new(3,24)
 var grid=numeric_buffer_new(2,16)
 var pdf=numeric_buffer_new(2,16)
 var log_pdf=numeric_buffer_new(2,16)
 var flags=integer_buffer_new(2,16)
 var work=numeric_buffer_new(4,32)
 var flag_work=integer_buffer_new(2,16)
 numeric_buffer_set(&!observations,0,-1.0);numeric_buffer_set(&!observations,1,1.0)
 numeric_buffer_set(&!observations,2,0.0/0.0)
 integer_buffer_set(&!mask,0,1);integer_buffer_set(&!mask,1,1);integer_buffer_set(&!mask,2,0)
 numeric_buffer_set(&!grid,0,0.0);numeric_buffer_set(&!grid,1,1.0)
 numeric_buffer_set(&!pdf,0,99.0);numeric_buffer_set(&!log_pdf,0,98.0);integer_buffer_set(&!flags,0,97)
 let budget=gaussian_kde_dynamic(&observations,&mask,&grid,1.0,3,&!pdf,&!log_pdf,&!flags,&!work,&!flag_work)
 assert(budget.status==5 && budget.selected==0 && budget.pairs==0)
 assert(numeric_buffer_at(&pdf,0)==99.0 && numeric_buffer_at(&log_pdf,0)==98.0 && integer_buffer_at(&flags,0)==97)
 let domain=gaussian_kde_dynamic(&observations,&mask,&grid,0.0,4,&!pdf,&!log_pdf,&!flags,&!work,&!flag_work)
 assert(domain.status==1 && numeric_buffer_at(&pdf,0)==99.0)
 integer_buffer_set(&!mask,2,2)
 let badmask=gaussian_kde_dynamic(&observations,&mask,&grid,1.0,4,&!pdf,&!log_pdf,&!flags,&!work,&!flag_work)
 assert(badmask.status==6 && numeric_buffer_at(&pdf,0)==99.0)
 integer_buffer_set(&!mask,2,1)
 let nonfinite=gaussian_kde_dynamic(&observations,&mask,&grid,1.0,6,&!pdf,&!log_pdf,&!flags,&!work,&!flag_work)
 assert(nonfinite.status==2 && numeric_buffer_at(&pdf,0)==99.0)
 integer_buffer_set(&!mask,2,0)
 let fit=gaussian_kde_dynamic(&observations,&mask,&grid,1.0,4,&!pdf,&!log_pdf,&!flags,&!work,&!flag_work)
 assert(fit.status==0 && fit.selected==2 && fit.grid_size==2 && fit.pairs==4)
 assert(fit.linear_available==2 && fit.log_available==2)
 assert(numeric_buffer_at(&pdf,0)>0.0 && integer_buffer_at(&flags,0)==3)
 integer_buffer_set(&!mask,0,0);integer_buffer_set(&!mask,1,0)
 let empty=gaussian_kde_dynamic(&observations,&mask,&grid,1.0,0,&!pdf,&!log_pdf,&!flags,&!work,&!flag_work)
 assert(empty.status==3)
 var empty_grid=numeric_buffer_new(0,0)
 integer_buffer_set(&!mask,0,1)
 let zero_grid=gaussian_kde_dynamic(&observations,&mask,&empty_grid,1.0,0,&!pdf,&!log_pdf,&!flags,&!work,&!flag_work)
 assert(zero_grid.status==0 && zero_grid.grid_size==0 && zero_grid.pairs==0 && zero_grid.selected==1)
 var short_work=numeric_buffer_new(3,24)
 let shortage=gaussian_kde_dynamic(&observations,&mask,&grid,1.0,4,&!pdf,&!log_pdf,&!flags,&!short_work,&!flag_work)
 assert(shortage.status==1)
 numeric_buffer_close(observations);integer_buffer_close(mask);numeric_buffer_close(grid)
 numeric_buffer_close(pdf);numeric_buffer_close(log_pdf);integer_buffer_close(flags)
 numeric_buffer_close(work);integer_buffer_close(flag_work);numeric_buffer_close(empty_grid);numeric_buffer_close(short_work)
 println("STDLIB_DEEP_KDE_STATUS_PASS")
 0
}
