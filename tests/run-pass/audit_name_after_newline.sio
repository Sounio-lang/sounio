//@ run-pass
//@ requires: madaros
//@ expect-stdout: AUDIT_NAME_AFTER_NEWLINE_OK
// `audit` is the `expr audit Name` operator and an item keyword. A binding
// of that name on the next line must not be swallowed by the previous
// initializer (`2029\naudit = ...` was parsed as `2029 audit =`).

fn main() -> i64 with IO {
    var audit: i64 = 1
    audit = audit + 2
    if audit != 3 {
        println("AUDIT_NAME_AFTER_NEWLINE_FAIL")
        return 1
    }
    println("AUDIT_NAME_AFTER_NEWLINE_OK")
    0
}
