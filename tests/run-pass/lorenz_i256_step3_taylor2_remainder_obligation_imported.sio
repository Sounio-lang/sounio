//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-3 Taylor-2 remainder obligation smoke

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step3_taylor2_remainder_obligation_check(
        40000, 55000, 10000, 0)
    if artifact_fp != 693563916 { return 1 }
    let audit_fp = lorenz_i256_step3_taylor2_remainder_obligation_audit_fingerprint(
        artifact_fp, 542114330, 570828076, 116883728, 164784481,
        844877047, 3, 5, 127, 0, 0)
    if audit_fp != 465507112 { return 2 }
    return 0
}
