//@ run-pass
// tests/run-pass/viz_inspector_interactive.sio - selectable inspector proof
//
// Expected output:
//   VIZ_INSPECTOR_INTERACTIVE_PASS

use display::canvas::{Canvas, canvas_clear}
use viz::ir::{
    viz_scene_new, viz_layout_rect, viz_style_rgb,
    viz_add_button, viz_add_slider, viz_add_toggle, viz_scene_set_tag,
}
use viz::audit::{viz_audit_hash, viz_audit_node_hash}
use viz::inspector::{viz_inspector_draw, viz_inspector_select, viz_inspector_hit_node, viz_inspector_draw_node_highlights}
use viz::viz_canvas::{viz_canvas_render_scene}

fn make_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pix = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pix, width: w, height: h }
}

fn read_px(c: &Canvas, x: i64, y: i64) -> i64 {
    read_i64(c.pixels, y * c.width + x)
}

fn main() with IO, Alloc, Mut, Div {
    var scene = viz_scene_new()
    var label: [i8; 64] = [0; 64]
    label[0] = 82
    label[1] = 117
    label[2] = 110

    let button = viz_add_button(&!scene, &label, 3, viz_layout_rect(12, 12, 46, 18), viz_style_rgb(90, 180, 240))
    let slider = viz_add_slider(&!scene, viz_layout_rect(68, 12, 88, 18), 0.5, 0.0, 1.0, viz_style_rgb(240, 190, 80))
    let toggle = viz_add_toggle(&!scene, viz_layout_rect(166, 12, 26, 18), false, viz_style_rgb(120, 220, 150))
    viz_scene_set_tag(&!scene, button, 6101)
    viz_scene_set_tag(&!scene, slider, 6102)
    viz_scene_set_tag(&!scene, toggle, 6103)

    let before_hash = viz_audit_hash(&scene)
    let slider_node_hash = viz_audit_node_hash(&scene, slider)
    assert(slider_node_hash != 0)

    var c = make_canvas(300, 160)
    canvas_clear(&!c, 2, 3, 4)
    viz_canvas_render_scene(&scene, &!c)
    viz_inspector_draw(&scene, &!c, 18, 52, 240, 96)

    let hit = viz_inspector_hit_node(&scene, 18, 52, 240, 96, 30, 137)
    assert(hit == slider)
    let selected = viz_inspector_select(&!scene, 18, 52, 240, 96, 30, 137)
    assert(selected == slider)
    assert(scene.selected_node == slider)
    assert(scene.focused_node == slider)
    assert(scene.hovered_node == slider)
    assert(scene.nodes[slider as usize].selected)
    assert(viz_audit_hash(&scene) != before_hash)

    viz_inspector_draw_node_highlights(&scene, &!c)
    viz_inspector_draw(&scene, &!c, 18, 52, 240, 96)

    assert(read_px(&c, 66, 10) != 0)
    assert(read_px(&c, 30, 137) != 0)
    assert(viz_audit_node_hash(&scene, slider) == slider_node_hash)

    heap_free(c.pixels as *mut i8)
    println("VIZ_INSPECTOR_INTERACTIVE_PASS")
}
