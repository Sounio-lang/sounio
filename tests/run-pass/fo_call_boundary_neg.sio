//@ run-pass
//@ expect-stdout: FO_CALL_BOUNDARY_LIVE
//@ description: FO must survive negation through a user function.
//@   Analytic: var(0 - x) = var(x) = 1.0 (x = 10 +- 1); checked to 1e-12.
//@   Both engines: Madaros since the #2933/#1706 inliner (it used to read 0 --
//@   the FO transfer catalog had no OpSub), lean_single throughout.

fn neg1(x: f64) -> f64 { 0.0 - x }

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(10.0, uncertainty: 1.0)
    let v = variance_of(neg1(k.value))
    print("neg_var ")
    print_f64(v)
    println("")
    var dv = v - 1.0
    if dv < 0.0 { dv = 0.0 - dv }
    if dv <= 1.0e-12 {
        println("FO_CALL_BOUNDARY_LIVE")
        0
    } else {
        println("FO_CALL_BOUNDARY_ZERO")
        1
    }
}
