    intermediates[1] = inter1_cert
    intermediate_bufs[1] = inter1_buf

    let (candidates, count) = chain_build_candidates(&leaf_cert, &leaf_buf, &intermediates, &intermediate_bufs, 2, &store)
    if count < 1 {
        print_int(5)
        return 1
    }
    // A candidate of len == 4 (leaf, inter2, inter1, root) must be found
    // despite the reversed pool order.
    var found_full_path: bool = false
    var c: i32 = 0
    while c < count {
        if candidates[c as usize].len == 4 {
            found_full_path = true
        }
        c = c + 1
    }
    if !found_full_path {
        print_int(6)
        return 1
    }

    println("x509_chain_path_building_reordered: found leaf->inter2->inter1->root candidate despite reversed pool order")
    return 0
}
