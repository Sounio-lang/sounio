//     -days 1825 -out inter1.pem -extfile <(echo "basicConstraints=critical,CA:true,pathlen:1")
//   openssl genrsa -out inter2.key 2048
//   openssl req -new -key inter2.key -out inter2.csr -subj "/CN=Test Intermediate CA 2"
