//     -days 1500 -out inter2.pem -extfile <(echo "basicConstraints=critical,CA:true,pathlen:0")
//   openssl genrsa -out leaf.key 2048
//   openssl req -new -key leaf.key -out leaf.csr -subj "/CN=chain-test4.example"
//   openssl x509 -req -in leaf.csr -CA inter2.pem -CAkey inter2.key -CAcreateserial \
//     -days 365 -out leaf.pem -extfile <(echo -e "basicConstraints=CA:false\nsubjectAltName=DNS:chain-test4.example")
//   openssl x509 -in root.pem -outform DER -out root.der     # 793 bytes
