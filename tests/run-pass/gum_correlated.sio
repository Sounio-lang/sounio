//@ run-pass
// GUM §5.2: correlated inputs — same variable on both sides of an operator.
// var(h*h) = 4·h²·var(h), NOT 2·h²·var(h) (uncorrelated assumption).

fn main() with IO, Mut, Epistemic {
    let k: Knowledge<f64> = measure(1.75, uncertainty: 0.01)
    let h = k.value   // var(h) = 0.0001 (0.01²)

    // Correlated multiply: h * h
    // Correct: var(h²) = 4·h²·var(h) = 4·3.0625·0.0001 = 0.001225
    // Wrong (uncorrelated): 2·h²·var(h) = 0.0006125
    let h_sq = h * h

    // Correlated subtract: h - h = 0 with zero variance
    let diff = h - h

    // Correlated add: h + h = 2h with var = 4·var(h)
    let double_h = h + h

    let vh = variance_of(h)
    let vh_sq = variance_of(h_sq)
    let vdiff = variance_of(diff)
    let vdouble = variance_of(double_h)

    print("var(h)="); println(vh)
    print("var(h*h)="); println(vh_sq)
    print("var(h-h)="); println(vdiff)
    print("var(h+h)="); println(vdouble)
    print("PASS\n")
}
