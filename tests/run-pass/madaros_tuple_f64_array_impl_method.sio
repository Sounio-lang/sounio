//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_F64_ARRAY_IMPL_METHOD PASS
//
// Review follow-up (#2570). lower_fn_tuple_f64_arrays_collect only ever
// walked top-level ItemFn entries -- an impl method returning a tuple with an
// [f64; N] slot is lowered as a mangled free function (`Type_method`, see
// lower_impl_methods_ref) but the prepass never reached it, so the table had
// no entry under that mangled name and every method-result read of the array
// slot took the integer path. expr_is_tuple_slot_f64_array_ref also only
// recognized an ExprCall base, not ExprMethodCall, so even a correctly
// collected mask would not have been consulted for a method call's result.
//
//   A  `recv.pair().0[0]`               direct projection off a method call
//   B  `let t = recv.pair(); t.0[0]`    in-place index through a local bound
//                                        to the method call's result
//
// Copilot follow-up (#2570): expr_result_tuple_float_mask_ref and
// expr_is_tuple_slot_f64_array_ref resolved the ExprMethodCall receiver via
// lower_method_recv_type -- the same helper actual call lowering uses -- so
// they'd also cover field, dereference, chained-method, and associated-call
// receivers, not just a plain local ident. Cases A/B above only exercise the
// ident-receiver arm; C/D below pin the field-receiver arm so reverting to
// the identifier-only lookup fails this fixture.
//
//   C  `holder.pairer.pair().0[0]`               field receiver, direct
//                                                 projection
//   D  `let u = holder.pairer.pair(); u.0[0]`    field receiver, in-place
//                                                 index through a local
//
// Copilot follow-up (#2570): lower_let_stmt_type_metadata_ref's tuple-mask
// binding treated an explicit type annotation and the initializer as
// ALTERNATIVES -- a nonzero annotated_tuple_mask skipped
// expr_result_tuple_float_mask_ref entirely. An annotation only ever encodes
// the SCALAR half (an element whose type is literally f64), never the ARRAY
// half (an `[f64; N]` element), so an explicitly typed mixed tuple lost its
// array bits the instant any OTHER slot was also annotated f64. Case E below
// pins the merge: `([f64; 2], f64)` sets only the scalar bit for slot 1, so
// the annotated branch alone is nonzero and would (pre-fix) swallow slot 0's
// array bit that only the initializer's return type carries.
//
//   E  `let e: ([f64; 2], f64) = pair_free(3.5); e.0[0]`
//                                        explicit mixed-tuple annotation,
//                                        free-function initializer
//
// Copilot follow-up (#2570): `let g = pair_free` binds a LOCAL to a bare
// function reference (an identity alias, not a call) -- expr_to_callee_name_ref
// on a later `g(...)` returns the local's own name "g", which the fn-name
// table never has an entry for, so both expr_result_tuple_float_mask_ref's
// and expr_is_tuple_slot_f64_array_ref's ExprCall branches read mask 0
// regardless of what pair_free itself returns. Cases F/G pin the fix: the
// alias is resolved once at the `let g = pair_free` binding site and stored
// under g's own name, then read back by both consumers.
//
// A top-level function is ALSO named `g`, on purpose, so the alias binding
// at `let g = pair_free` shadows a REAL same-named global rather than a
// name that simply does not exist. Copilot follow-up: the first version of
// this fix checked the named-function table before checking whether
// callee_name was a local, backwards from actual call lowering
// (self.lookup_local(callee_name) >= 0 checked BEFORE the named path,
// lower.sio:21168-21223) -- with that ordering, `g()` executes the LOCAL
// alias (pair_free's body -- confirmed by manual repro: it returns the
// caller's own f64 argument, not the top-level g's distinct hard-coded
// value) while the mask lookup used whichever the checker-visible name
// resolved first, so a top-level `g` with a DIFFERENT tuple-array shape
// than pair_free silently re-corrupted the read even though F/G's own
// alias resolution (fixed in 01275b1706) was otherwise working. Kept
// same-shaped with pair_free here so the arithmetic below still
// type-checks (the type checker itself binds `g(...)`'s argument and
// result types to the GLOBAL `g`, not the local alias, so a differently
// shaped global makes `v.0[0] * 2.0` a checker error, not a lowering one --
// the mask-divergence half of this was verified with a standalone,
// differently-shaped repro instead: it printed the caller's argument's IEEE
// bit pattern as an integer under the old ordering, the argument's own
// value under the fixed one).
//
//   F  `let g = pair_free; let v = g(4.5); v.0[0]`   indirect call through
//                                                     an alias that shadows
//                                                     a same-named global,
//                                                     in-place index through
//                                                     a local
//   G  `let g = pair_free; g(1.25).0[0]`              same alias/shadow,
//                                                       direct projection
fn g(scale: f64) -> ([f64; 2], f64) with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    a[0] = 999.0
    (a, 1.0)
}

struct Pairer {
    scale: f64,
}

impl Pairer {
    fn pair(self) -> ([f64; 2], i64) with Mut, Panic {
        var a: [f64; 2] = [0.0; 2]
        a[0] = self.scale
        (a, 9)
    }
}

struct Holder {
    pairer: Pairer,
}

fn pair_free(scale: f64) -> ([f64; 2], f64) with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    a[0] = scale
    (a, 7.0)
}

fn main() -> i32 with IO, Mut, Panic {
    var bad: i32 = 0
    let recv = Pairer { scale: 1.5 }

    // A: direct projection off the method call, no tuple-local binding.
    let da: f64 = recv.pair().0[0] * 2.0
    if da != 3.0 { bad = bad + 1 }

    // B: in-place index through an ExprIdent tuple-local bound from a method call.
    let t = recv.pair()
    let db: f64 = t.0[0] * 2.0
    if db != 3.0 { bad = bad + 2 }

    let holder = Holder { pairer: Pairer { scale: 2.5 } }

    // C: direct projection off a method call through a field receiver.
    let dc: f64 = holder.pairer.pair().0[0] * 2.0
    if dc != 5.0 { bad = bad + 4 }

    // D: in-place index through a tuple-local bound from a field-receiver
    // method call.
    let u = holder.pairer.pair()
    let dd: f64 = u.0[0] * 2.0
    if dd != 5.0 { bad = bad + 8 }

    // E: explicit mixed-tuple annotation merges with the initializer's array
    // bits instead of discarding them.
    let e: ([f64; 2], f64) = pair_free(3.5)
    let de: f64 = e.0[0] * 2.0
    if de != 7.0 { bad = bad + 16 }

    // F: indirect call through a local aliasing a function's identity, then
    // in-place index through a tuple-local bound from that call.
    let g = pair_free
    let v = g(4.5)
    let dv: f64 = v.0[0] * 2.0
    if dv != 9.0 { bad = bad + 32 }

    // G: same alias, direct projection off the indirect call.
    let dg: f64 = g(1.25).0[0] * 2.0
    if dg != 2.5 { bad = bad + 64 }

    if bad == 0 {
        println("TUPLE_F64_ARRAY_IMPL_METHOD PASS")
    }
    bad
}
