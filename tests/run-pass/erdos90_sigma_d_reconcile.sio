//@ run-pass
//@ expect-stdout: erdos90_sigma_d_reconcile: PASS

// Roadmap item 3: reconcile runtime GUM shadow (variance_of) with first-order
// analytic σ_d = sqrt(vd2)/(2d). For equal coordinate σ on ANY unit edge
// (d=1): vd2 = 4·σ_coord²·(dx²+dy²) = 4·σ_coord² ⇒ σ_d = σ_coord.

fn sqrtf(x: f64) -> f64 with Mut {
    if x <= 0.0 { return 0.0 }
    var r = x
    var i = 0
    while i < 40 { r = 0.5 * (r + x / r); i = i + 1 }
    return r
}

fn absf(x: f64) -> f64 { if x < 0.0 { return 0.0 - x } else { return x } }

fn sigma_d_runtime(ax: Knowledge<f64>, ay: Knowledge<f64>,
                   bx: Knowledge<f64>, by: Knowledge<f64>) -> f64 with Mut, Div, Epistemic {
    let dx = ax.value - bx.value
    let dy = ay.value - by.value
    let d2 = dx * dx + dy * dy
    let vd2 = variance_of(d2)
    let d = sqrtf(d2)
    if d <= 0.0 { return 0.0 }
    return sqrtf(vd2) / (2.0 * d)
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let sigma_coord = 0.02
    let h_ax = measure(0.0, uncertainty: sigma_coord)
    let h_ay = measure(0.0, uncertainty: sigma_coord)
    let h_bx = measure(1.0, uncertainty: sigma_coord)
    let h_by = measure(0.0, uncertainty: sigma_coord)
    let horiz = sigma_d_runtime(h_ax, h_ay, h_bx, h_by)

    let s = 0.7071067811865475
    let d_ax = measure(0.0, uncertainty: sigma_coord)
    let d_ay = measure(0.0, uncertainty: sigma_coord)
    let d_bx = measure(s, uncertainty: sigma_coord)
    let d_by = measure(s, uncertainty: sigma_coord)
    let diag = sigma_d_runtime(d_ax, d_ay, d_bx, d_by)

    let e1 = absf(horiz - sigma_coord) / sigma_coord
    let e2 = absf(diag - sigma_coord) / sigma_coord
    print("unit-edge sigma_d: horizontal=")
    print_f64(horiz)
    print(" diagonal=")
    print_f64(diag)
    print(" analytic=")
    print_f64(sigma_coord)
    print("\n")
    if e1 < 0.05 && e2 < 0.05 {
        print("erdos90_sigma_d_reconcile: PASS\n")
        return 0
    }
    print("erdos90_sigma_d_reconcile: FAIL\n")
    return 1
}