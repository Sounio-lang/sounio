//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v43 smoke for Lorenz i256 Taylor/ball bridge entry

use theorem::portfolio::*

fn main() -> i64 {
    let receipt_fp = solver_portfolio_v43_lorenz_i256_taylor_ball_bridge_fingerprint(
        979362768, 927174126, 389121447, 731723710,
        845057161, 584513793, 2, 127)
    if receipt_fp != 609891562 { return 1 }

    let audit_fp = solver_portfolio_v43_lorenz_i256_taylor_ball_bridge_audit_fingerprint(
        receipt_fp, 979362768, 927174126, 725222703,
        845057161, 584513793, 2, 127)
    if audit_fp != 519708695 { return 2 }

    let manifest_fp = solver_portfolio_v43_lorenz_i256_taylor_ball_bridge_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 130892363 { return 3 }

    let result_fp = solver_portfolio_v43_result_coverage_fingerprint(
        43, 47, 10, 35, 1, 1, manifest_fp)
    if result_fp != 380236113 { return 4 }

    let family_fp = solver_portfolio_v43_checker_family_coverage_fingerprint(
        43, 47, 6, 4, 3, 2, 30, 2, manifest_fp)
    if family_fp != 493252763 { return 5 }

    let acceptance_fp = solver_portfolio_v43_acceptance_receipt_fingerprint(
        43, manifest_fp, result_fp)
    if acceptance_fp != 34707817 { return 6 }

    let audit_receipt_fp = solver_portfolio_v43_audit_receipt_fingerprint(
        43, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 364419889 { return 7 }

    let readiness_fp = solver_portfolio_v43_readiness_fingerprint(
        43, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 61654294 { return 8 }

    return 0
}
