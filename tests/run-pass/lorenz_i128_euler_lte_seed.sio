//@ run-pass
//@ known-failure: source-level i128 Lorenz Euler LTE seed: main returns 2. Not a segfault/139
//@ requires: madaros
//@ description: Lorenz i128 Euler local-truncation-error seed for x/y at the initial point

fn main() -> i64 {
    let scale: i128 = 1000000 as i128
    let dt: i128 = 10000 as i128
    let sigma: i128 = 10 as i128
    let rho: i128 = 28 as i128
    let beta_num: i128 = 8 as i128
    let beta_den: i128 = 3 as i128

    let x: i128 = scale
    let y: i128 = scale
    let z: i128 = scale

    let dx: i128 = sigma * (y - x)
    let dy: i128 = (x * ((rho * scale) - z)) / scale - y
    let dz: i128 = (x * y) / scale - (beta_num * z) / beta_den
    let abs_dz: i128 = (0 as i128) - dz

    // Instantaneous second derivative at the initial point, in the same
    // fixed-point scale. This is an LTE seed, not yet a supremum over the whole
    // time interval.
    let ddx_abs: i128 = sigma * (dy - dx)
    let ddy_abs: i128 = dy - (x * abs_dz) / scale
    // The z second-derivative check lives in lorenz_i128_euler_lte_z_seed.sio.
    // Keeping x/y and z split avoids a current native backend crash when both
    // wide expressions stay live in the same main function.

    // The second-derivative values fit in i64. Keep the dynamic derivatives in
    // i128, then do the LTE ceiling in i64 to avoid the current backend boundary
    // around helper-heavy wide division by a large i128 denominator.
    let den: i64 = 2000000000000
    let h2: i64 = 100000000
    let ddx_i64: i64 = 260000000
    let ddy_i64: i64 = 24333334
    let lte_x: i64 = (h2 * ddx_i64 + den - 1) / den
    let lte_y: i64 = (h2 * ddy_i64 + den - 1) / den

    // Radius from lorenz_i128_ball_step.sio plus this local truncation budget.
    let ball_xr: i64 = 13
    let ball_yr: i64 = 13
    let total_xr: i64 = ball_xr + lte_x
    let total_yr: i64 = ball_yr + lte_y

    if dx != (0 as i128) { return 1 }
    if dy != (26000000 as i128) { return 2 }
    if dz != ((0 as i128) - (1666666 as i128)) { return 3 }

    if ddx_abs != (260000000 as i128) { return 4 }
    if ddy_abs != (24333334 as i128) { return 5 }

    if lte_x != 13000 { return 7 }
    if lte_y != 1217 { return 8 }

    if total_xr != 13013 { return 10 }
    if total_yr != 1230 { return 11 }
    return 0
}
