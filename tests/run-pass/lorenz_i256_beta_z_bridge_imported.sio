//@ run-pass
//@ description: Imported Lorenz i256 exact beta*z bridge smoke

use systems::lorenz_i256_limb_scale_bridge::*
use systems::lorenz_i256_beta_z_bridge::*

fn main() -> i64 with Div {
    let one_point_five = lorenz_i256_beta_z_check(500000000, 1, 0, 0, 0, 4, 0, 0)
    if one_point_five != 1 { return 1 }

    let three_eighths = lorenz_i256_beta_z_check(375000000, 0, 0, 0, 0, 1, 0, 0)
    if three_eighths != 1 { return 2 }

    let two_point_twofive = lorenz_i256_beta_z_check(250000000, 2, 0, 0, 0, 6, 0, 0)
    if two_point_twofive != 1 { return 3 }

    let inexact = lorenz_i256_beta_z_limb(100000000, 0, 0, 0, 0)
    if inexact != 0 - 1 { return 4 }

    let invalid = lorenz_i256_beta_z_limb(1000000000, 0, 0, 0, 0)
    if invalid != 0 - 1 { return 5 }

    let scale_anchor = lorenz_i256_limb_scale_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 103)
    if scale_anchor != 734815269 { return 6 }

    let scale_audit = lorenz_i256_limb_scale_bridge_audit_fingerprint(
        scale_anchor, 508642719, 971304826, 1, 1, 1, 1, 1, 256,
        1000000000, 0, 0, 0, 0, 103, 1023)
    if scale_audit != 216903584 { return 7 }

    let artifact = lorenz_i256_beta_z_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 112)
    if artifact != 639182704 { return 8 }

    let audit = lorenz_i256_beta_z_bridge_audit_fingerprint(
        artifact, 582607319, 918340256, scale_anchor, scale_audit,
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 112, 1023)
    if audit != 174905863 { return 9 }
    return 0
}
