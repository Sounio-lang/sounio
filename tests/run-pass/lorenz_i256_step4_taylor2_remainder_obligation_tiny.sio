//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-4 Taylor-2 remainder obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var instance_fp: i64 = 1813
    instance_fp = mix(instance_fp, 4, 5753)
    instance_fp = mix(instance_fp, 4294967296, 5753)
    instance_fp = mix(instance_fp, 1000000, 5753)
    instance_fp = mix(instance_fp, 42949672, 5753)
    instance_fp = mix(instance_fp, 575348777, 5753)
    instance_fp = mix(instance_fp, 417943295, 5753)
    instance_fp = mix(instance_fp, 450696904, 5753)
    instance_fp = mix(instance_fp, 780071782, 5753)
    instance_fp = mix(instance_fp, 749342117, 5753)
    instance_fp = mix(instance_fp, 185341710, 5753)
    instance_fp = mix(instance_fp, 4617762706, 5753)
    instance_fp = mix(instance_fp, 7643846696, 5753)
    instance_fp = mix(instance_fp, 4120687759, 5753)
    instance_fp = mix(instance_fp, 304942679, 5753)
    instance_fp = mix(instance_fp, 1174673556, 5753)
    instance_fp = mix(instance_fp, 27917288, 5753)
    instance_fp = mix(instance_fp, 0, 5753)
    instance_fp = mix(instance_fp, 0, 5753)
    if instance_fp != 408418036 { return 1 }

    var certificate_fp: i64 = 1817
    certificate_fp = mix(certificate_fp, instance_fp, 5779)
    certificate_fp = mix(certificate_fp, 4922705385, 5779)
    certificate_fp = mix(certificate_fp, 8818520252, 5779)
    certificate_fp = mix(certificate_fp, 4148605047, 5779)
    certificate_fp = mix(certificate_fp, 116166313817, 5779)
    certificate_fp = mix(certificate_fp, 137412256370, 5779)
    certificate_fp = mix(certificate_fp, 141963314886, 5779)
    certificate_fp = mix(certificate_fp, 21170352540, 5779)
    certificate_fp = mix(certificate_fp, 2793755712560, 5779)
    certificate_fp = mix(certificate_fp, 3882827819070, 5779)
    certificate_fp = mix(certificate_fp, 501304305736, 5779)
    certificate_fp = mix(certificate_fp, 139687780, 5779)
    certificate_fp = mix(certificate_fp, 194141383, 5779)
    certificate_fp = mix(certificate_fp, 25065215, 5779)
    certificate_fp = mix(certificate_fp, 32524, 5779)
    certificate_fp = mix(certificate_fp, 45203, 5779)
    certificate_fp = mix(certificate_fp, 5836, 5779)
    certificate_fp = mix(certificate_fp, 40000, 5779)
    certificate_fp = mix(certificate_fp, 55000, 5779)
    certificate_fp = mix(certificate_fp, 10000, 5779)
    certificate_fp = mix(certificate_fp, 7476, 5779)
    certificate_fp = mix(certificate_fp, 9797, 5779)
    certificate_fp = mix(certificate_fp, 4164, 5779)
    certificate_fp = mix(certificate_fp, 127, 5779)
    certificate_fp = mix(certificate_fp, 0, 5779)
    certificate_fp = mix(certificate_fp, 0, 5779)
    if certificate_fp != 166672715 { return 2 }

    var artifact_fp: i64 = 1819
    artifact_fp = mix(artifact_fp, instance_fp, 5783)
    artifact_fp = mix(artifact_fp, certificate_fp, 5783)
    artifact_fp = mix(artifact_fp, 575348777, 5783)
    artifact_fp = mix(artifact_fp, 417943295, 5783)
    artifact_fp = mix(artifact_fp, 450696904, 5783)
    artifact_fp = mix(artifact_fp, 780071782, 5783)
    artifact_fp = mix(artifact_fp, 749342117, 5783)
    artifact_fp = mix(artifact_fp, 185341710, 5783)
    artifact_fp = mix(artifact_fp, 5, 5783)
    artifact_fp = mix(artifact_fp, 4, 5783)
    artifact_fp = mix(artifact_fp, 32524, 5783)
    artifact_fp = mix(artifact_fp, 45203, 5783)
    artifact_fp = mix(artifact_fp, 5836, 5783)
    artifact_fp = mix(artifact_fp, 40000, 5783)
    artifact_fp = mix(artifact_fp, 55000, 5783)
    artifact_fp = mix(artifact_fp, 10000, 5783)
    artifact_fp = mix(artifact_fp, 127, 5783)
    artifact_fp = mix(artifact_fp, 0, 5783)
    artifact_fp = mix(artifact_fp, 0, 5783)
    if artifact_fp != 700260810 { return 3 }

    var audit_fp: i64 = 1829
    audit_fp = mix(audit_fp, artifact_fp, 5791)
    audit_fp = mix(audit_fp, instance_fp, 5791)
    audit_fp = mix(audit_fp, certificate_fp, 5791)
    audit_fp = mix(audit_fp, 575348777, 5791)
    audit_fp = mix(audit_fp, 450696904, 5791)
    audit_fp = mix(audit_fp, 749342117, 5791)
    audit_fp = mix(audit_fp, 4, 5791)
    audit_fp = mix(audit_fp, 5, 5791)
    audit_fp = mix(audit_fp, 127, 5791)
    audit_fp = mix(audit_fp, 0, 5791)
    audit_fp = mix(audit_fp, 0, 5791)
    if audit_fp != 747893368 { return 4 }
    return 0
}
