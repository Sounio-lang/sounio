//@ run-pass
// tests/run-pass/viz_renderer3d_edges.sio - renderer3d face and edge proof
//
// Expected output:
//   VIZ_RENDERER3D_EDGES_PASS

use display::canvas::{Canvas, canvas_clear}
use render::renderer3d::{Camera3D, Light3D, Tri3D, r3d_depth_buf_alloc, r3d_depth_buf_clear, r3d_render}

fn make_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pix = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pix, width: w, height: h }
}

fn read_px(c: &Canvas, x: i64, y: i64) -> i64 {
    read_i64(c.pixels, y * c.width + x)
}

fn count_nonzero_rect(c: &Canvas, x: i64, y: i64, w: i64, h: i64) -> i64 with Mut {
    var count: i64 = 0
    var yy: i64 = y
    while yy < y + h {
        var xx: i64 = x
        while xx < x + w {
            if read_px(c, xx, yy) != 0 {
                count = count + 1
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
    count
}

fn main() with IO, Alloc, Mut, Div {
    var c = make_canvas(96, 96)
    canvas_clear(&!c, 0, 0, 0)
    let depth = r3d_depth_buf_alloc(c.width, c.height)
    r3d_depth_buf_clear(depth, c.width, c.height)

    var tris: [Tri3D; 4096] = [Tri3D {
        v0x: -0.45, v0y: -0.35, v0z: -2.0,
        v1x: 0.45, v1y: -0.35, v1z: -2.0,
        v2x: 0.0, v2y: 0.45, v2z: -2.0,
        nx: 0.0, ny: 0.0, nz: 1.0,
        base_r: 90, base_g: 140, base_b: 210,
    }; 4096]
    let cam = Camera3D { pos_x: 0.0, pos_y: 0.0, pos_z: 0.0, focal: 72.0 }
    let light = Light3D { dx: 0.0, dy: 0.0, dz: 1.0, r: 255, g: 255, b: 255, ambient: 0.15 }
    r3d_render(&tris, 1, &cam, &light, depth, &!c)

    let face_px = read_px(&c, 48, 48)
    let edge_count = count_nonzero_rect(&c, 30, 60, 36, 8)
    assert(face_px != 0)
    assert(edge_count > 8)

    heap_free(depth as *mut i8)
    heap_free(c.pixels as *mut i8)
    println("VIZ_RENDERER3D_EDGES_PASS")
}
