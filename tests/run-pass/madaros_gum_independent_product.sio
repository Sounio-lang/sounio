//@ run-pass
//@ expect-stdout: MADAROS_GUM_INDEPENDENT_PRODUCT_PASS

// Madaros FO GUM: independent product Var(a*b) = b² Va + a² Vb.
// Pre-fix (2026-07-25): collapsed to 2·a²·Vb (av=2,bv=3 → 0.020 not 0.0325)
// because sequential emit_variance_scale pair bindings lost the left term.
//
// Also covers correlated left-assoc chain 4.0*x*x → 4 c² x² V (0.640 not 0.320).

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let a: Knowledge<f64> = measure(2.0, uncertainty: 0.05)
    let b: Knowledge<f64> = measure(3.0, uncertainty: 0.05)
    let av = a.value
    let bv = b.value
    let va = variance_of(av)
    let vb = variance_of(bv)
    let vprod = variance_of(av * bv)
    let vprod_swap = variance_of(bv * av)
    // truth: 9*0.0025 + 4*0.0025 = 0.0325
    let want_prod = 0.0325
    // correlated chain (4*x)*x fully dependent on x
    let vchain = variance_of(4.0 * av * av)
    // truth: f=4 x², (8x)² V = 64 * 4 * 0.0025 = 0.64
    let want_chain = 0.64
    // via intermediate (independent-safe path)
    let aa = av * av
    let v_via = variance_of(4.0 * aa)
    print("va="); print_f64(va); print("\n")
    print("vb="); print_f64(vb); print("\n")
    print("vprod="); print_f64(vprod); print("\n")
    print("vprod_swap="); print_f64(vprod_swap); print("\n")
    print("vchain="); print_f64(vchain); print("\n")
    print("v_via="); print_f64(v_via); print("\n")
    let ok = abs_f(va - 0.0025) < 1.0e-9
        && abs_f(vb - 0.0025) < 1.0e-9
        && abs_f(vprod - want_prod) < 1.0e-9
        && abs_f(vprod_swap - want_prod) < 1.0e-9
        && abs_f(vchain - want_chain) < 1.0e-9
        && abs_f(v_via - want_chain) < 1.0e-9
    if ok {
        print("MADAROS_GUM_INDEPENDENT_PRODUCT_PASS\n")
    } else {
        print("MADAROS_GUM_INDEPENDENT_PRODUCT_FAIL\n")
    }
}
