//@ run-pass
//@ requires: madaros
//@ expect-stdout: ns-seed: PASS
//
// N2 witness (REQ-2, seed): a measured value becomes a fresh, non-empty
// singleton noise-symbol set -- never empty (that would claim it shares no
// uncertainty with itself) and never a stale handle borrowed from elsewhere.
// Observable only under SOUNIO_NS_TRACE=1 (self-hosted/check/noise_sets.sio's
// N2 header) as a single "NS_TRACE measure=<handle>" line with handle > 0.
// N2 is metadata-only: this test's PASS/FAIL never depends on the trace.

fn main() -> i64 with IO {
    let a: Knowledge[f64, Measured] = measure(42.0, uncertainty: 0.1)
    println("ns-seed: PASS")
    0
}
