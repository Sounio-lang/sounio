//@ run-pass
//@ timeout: 240
// ============================================================================
// DISSERTATION PBPK28 PARITY REFERENCE — LITHIUM (SIO-520)
//
// Single 300 mg lithium carbonate capsule (= 56.4 mg Li+, 8.12 mEq).
// Tablet lag (tlag = 0.25 h) + first-order gut absorption (ka = 1.0/h) with
// NO first-pass loss (F = 1.00 — nothing hepatic at all). Purely renal sink
// CL = 1.3 L/h (≈22% of GFR), plasma referenced, no protein binding.
// Kp = lithium tissue values from ECF physiology + measured anchors
// (Vd ~42 L); PS flow-limited except brain/bone/adipose.
//
// This ref runs the stdlib scenario ITSELF
// (scenarios/lithium_oral.sio): its step, its release law, its params.
// It holds no copy of the model. The companion is
// website/src/lib/pbpk28_core.mjs (DEFAULT_PARAMS_LITHIUM) and the gate
// case at scripts/ci/dissertation_pbpk28_parity_gate.sh.
//
// PK only, single dose. No clinical-validity claim: parity only (ADR009).
//
// Integrator: fully-coupled CN on the 27-state arrow matrix, dt = 0.001,
// input rate at the step midpoint (same convention as Node releaseRateAt).
// ============================================================================

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*
use darwin_pbpk::scenarios::lithium_oral::*
use io::sci_print::*

fn emit_at(scen: LithiumScenario, p: PBPKParams28, t: f64, abs_cum: f64) with IO, Mut, Div {
    var i = 0
    while i < 14 {
        print("PARITY|t=")
        println(t)
        println("")
        print("PARITY|i=")
        println(i)
        print("PARITY|cv=")
        println_f64_sci(scen.pbpk.cv[i], 10)
        print("PARITY|ct=")
        println_f64_sci(scen.pbpk.ct[i], 10)
        print("PARITY|cavg=")
        println_f64_sci(pbpk28_organ_average(scen.pbpk, p, i), 10)
        i = i + 1
    }
    print("TMASS|t=")
    println(t)
    println("")
    print("TMASS|m=")
    println(pbpk28_total_mass(scen.pbpk, p))
    println("")
    print("TREL|t=")
    println(t)
    println("")
    print("TREL|cum=")
    println(abs_cum)
    println("")
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("DISSERTATION_PBPK28_LITHIUM_PARITY_REF v1")
    println("compartments=14")
    println("states=28")
    println("dt=0.001")
    println("dose_mg=56.4")
    println("release=oral_ir_ka_1.00_F_1.00_lag_0.25")
    println("cl_L_per_h=1.3")
    println("integrator=fully_coupled_CN_27state")
    println("drug=lithium")
    println("samples=12")

    let p = li_pbpk28_params()
    var scen = li_scenario_init()
    let dt = 0.001
    var t = 0.0
    var abs_cum = 0.0

    var s = 0
    while s < 12 {
        var target = 0.1
        if s == 1 { target = 0.5 }
        if s == 2 { target = 1.0 }
        if s == 3 { target = 2.0 }
        if s == 4 { target = 4.0 }
        if s == 5 { target = 6.0 }
        if s == 6 { target = 8.0 }
        if s == 7 { target = 12.0 }
        if s == 8 { target = 16.0 }
        if s == 9 { target = 20.0 }
        if s == 10 { target = 24.0 }
        if s == 11 { target = 30.0 }
        while t + dt * 0.5 < target {
            abs_cum = abs_cum + li_release_rate_at(t + 0.5 * dt) * dt
            scen = li_step(scen, p, t, dt)
            t = t + dt
        }
        emit_at(scen, p, t, abs_cum)
        s = s + 1
    }

    println("DISSERTATION_PBPK28_LITHIUM_PARITY_DONE")
    return 0
}
