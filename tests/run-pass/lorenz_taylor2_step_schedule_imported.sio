//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz Taylor-2 schedule certificate checks selected dt inside adaptive min/max bounds

use systems::ball_fixed::*

fn main() -> i64 {
    if ball_fixed_rational_leq_nonneg(1, 200, 1, 100) != 1 { return 1 }
    if ball_fixed_rational_leq_nonneg(1, 100, 3, 200) != 1 { return 2 }

    let fp = ball_fixed_lorenz_taylor2_step_schedule_fingerprint(
        120259197, 471466754, 279109641, 207228249, 984799877, 2, 127)
    if fp != 353612555 { return 3 }

    let audit_fp = ball_fixed_lorenz_taylor2_step_schedule_audit_fingerprint(
        fp, 120259197, 471466754, 279109641, 207228249, 984799877, 2, 127)
    if audit_fp != 335541872 { return 4 }
    return 0
}
