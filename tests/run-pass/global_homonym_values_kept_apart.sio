//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: HK_APART 1.500000 2.500000 101 8
//
// Two modules each declare a private global HK (same type, different values) and
// a private var HCOUNT. Before module-qualified global identity they shared one
// storage slot: one module's value was read by both, and a write in one module
// showed through the other (review of #3743).
use fixtures::homonym_value_leaf::{leaf_hk, leaf_bump}

let HK: f64 = 1.5
var HCOUNT: i64 = 7

fn main() -> i64 with IO, Mut {
    let mine = HK
    let theirs = leaf_hk()
    let b = leaf_bump()
    HCOUNT = HCOUNT + 1
    print("HK_APART "); print_f64(mine); print(" "); print_f64(theirs); print(" "); print_int(b); print(" "); print_int(HCOUNT); print("\n")
    0
}
