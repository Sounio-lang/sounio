//@ run-pass
//@ expect-stdout: 1
// SIO-278: `let s = o.f` must value-copy the field's aggregate too, both
// when the field is itself a fixed array and when it is a struct holding
// one. It bound the source storage, so writes through `o` showed through
// the binding.

struct Inner { a: [i64; 2], k: i64 }

struct Outer { inner: Inner, arr: [i64; 3] }

fn main() -> i32 with IO {
    var o = Outer { inner: Inner { a: [1, 9], k: 0 }, arr: [1, 2, 3] }
    let inner_copy = o.inner
    let arr_copy = o.arr
    o.inner.a[0] = 99
    o.arr[0] = 99
    print_int(inner_copy.a[0] + arr_copy[0] - 1)
    println("")
    return 0
}
