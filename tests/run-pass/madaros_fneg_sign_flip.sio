//@ run-pass
module test_fneg

fn neg_f64(x: f64) -> f64 {
    -x
}

fn neg_i64(x: i64) -> i64 {
    -x
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let z: f64 = 0.0
    let nz: f64 = neg_f64(z)
    let nz_bits: i64 = f64_to_bits(nz)
    let want_nz_bits: i64 = (0 - 9223372036854775807) - 1

    let one: f64 = 1.0
    let none: f64 = neg_f64(one)
    let none_bits: i64 = f64_to_bits(none)
    let want_none_bits: i64 = f64_to_bits(0.0 - 1.0)

    let five: i64 = 5
    let nfive: i64 = neg_i64(five)

    if nz_bits != want_nz_bits {
        print("FAIL: neg(0.0) bits != -0.0 bits\n")
        return 1
    }
    if none_bits != want_none_bits {
        print("FAIL: neg(1.0) bits != -1.0 bits\n")
        return 2
    }
    if nfive != -5 {
        print("FAIL: neg(5) != -5\n")
        return 3
    }
    print("PASS: f64 and i64 negation correct!\n")
    0
}
