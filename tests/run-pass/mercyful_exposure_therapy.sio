//@ known-failure: measured 2026-08-30 under SOUNIO_SOUC_ENGINE=lean_single — error: logical not requires bool operand at <main>:16. Dormant since it carried no //@ annotation, so the breakage was never visible.
// tests/run-pass/mercyful_exposure_therapy.sio
//
// Mercyful Learning exposure-therapy benchmark (Sounio native).
//
// Clinical warning: synthetic graph; no clinical claim.

use clinical::mercyful::*

fn main() -> i32 with IO, Mut, Panic {
    let g = mercy_exposure_therapy_graph()

    // Raw minimizer without target constraint would stay at avoidance (cost 0).
    // We simulate by noting the best path to recovery has cost > 0.
    let (found, length, integral, peak, total) = mercyful_schedule(&g, 0, 3, 1.0, 10.0)

    if !found {
        println("MERCYFUL_SOUNIO_FAIL: no path found")
        return 1
    }

    // The mercyful scheduler must reach recovery (state 3).
    // For the exposure-therapy graph, any path to recovery must pass through moderate (state 2).
    // We verify that the best path has positive cost (passes through distress).
    if integral <= 0.0 {
        println("MERCYFUL_SOUNIO_FAIL: path to recovery has zero integral suffering")
        return 1
    }

    // Anti-Goodhart: recovery cost > 0 proves the hazard exists.
    // Raw unconstrained minimizer would have cost 0 (avoidance loop).
    println("MERCYFUL_SOUNIO_PASS")
    0
}
