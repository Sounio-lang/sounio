//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v103 smoke for Lorenz i256 step-3 Taylor-2 remainder obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1831
    receipt_fp = mix(receipt_fp, 693563916, 5801)
    receipt_fp = mix(receipt_fp, 465507112, 5801)
    receipt_fp = mix(receipt_fp, 72020993, 5801)
    receipt_fp = mix(receipt_fp, 690888610, 5801)
    receipt_fp = mix(receipt_fp, 570821279, 5801)
    receipt_fp = mix(receipt_fp, 323635732, 5801)
    receipt_fp = mix(receipt_fp, 584783151, 5801)
    receipt_fp = mix(receipt_fp, 844877047, 5801)
    receipt_fp = mix(receipt_fp, 492955058, 5801)
    receipt_fp = mix(receipt_fp, 3, 5801)
    receipt_fp = mix(receipt_fp, 5, 5801)
    receipt_fp = mix(receipt_fp, 127, 5801)
    if receipt_fp != 994004460 { return 1 }

    var audit_fp: i64 = 1837
    audit_fp = mix(audit_fp, receipt_fp, 5807)
    audit_fp = mix(audit_fp, 693563916, 5807)
    audit_fp = mix(audit_fp, 465507112, 5807)
    audit_fp = mix(audit_fp, 72020993, 5807)
    audit_fp = mix(audit_fp, 690888610, 5807)
    audit_fp = mix(audit_fp, 844877047, 5807)
    audit_fp = mix(audit_fp, 492955058, 5807)
    audit_fp = mix(audit_fp, 584783151, 5807)
    audit_fp = mix(audit_fp, 3, 5807)
    audit_fp = mix(audit_fp, 5, 5807)
    audit_fp = mix(audit_fp, 127, 5807)
    if audit_fp != 792236662 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 106, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 106, 1103)
    if entry_fp != 420821728 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 103, 1151)
    manifest_fp = mix(manifest_fp, 107, 1151)
    manifest_fp = mix(manifest_fp, 323635732, 1151)
    manifest_fp = mix(manifest_fp, 570821279, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 502178581 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 103, 1871)
    result_fp = mix(result_fp, 107, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 95, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 532656345 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 103, 1907)
    family_fp = mix(family_fp, 107, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 90, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 931303101 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 103, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 689402395 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 103, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 143043359 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 103, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 953013701 { return 9 }
    return 0
}
