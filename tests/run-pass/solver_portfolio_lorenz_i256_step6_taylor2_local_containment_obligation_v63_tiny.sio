//@ run-pass
//@ description: Tiny portfolio v63 smoke for Lorenz i256 step-6 Taylor-2 local containment obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 769
    receipt_fp = mix(receipt_fp, 963265870, 4349)
    receipt_fp = mix(receipt_fp, 344106968, 4349)
    receipt_fp = mix(receipt_fp, 274272622, 4349)
    receipt_fp = mix(receipt_fp, 806638802, 4349)
    receipt_fp = mix(receipt_fp, 991960186, 4349)
    receipt_fp = mix(receipt_fp, 2137721, 4349)
    receipt_fp = mix(receipt_fp, 662934823, 4349)
    receipt_fp = mix(receipt_fp, 6, 4349)
    receipt_fp = mix(receipt_fp, 13, 4349)
    receipt_fp = mix(receipt_fp, 255, 4349)
    if receipt_fp != 91311098 { return 1 }

    var audit_fp: i64 = 773
    audit_fp = mix(audit_fp, receipt_fp, 4357)
    audit_fp = mix(audit_fp, 963265870, 4357)
    audit_fp = mix(audit_fp, 344106968, 4357)
    audit_fp = mix(audit_fp, 118962929, 4357)
    audit_fp = mix(audit_fp, 79381760, 4357)
    audit_fp = mix(audit_fp, 258280637, 4357)
    audit_fp = mix(audit_fp, 617448056, 4357)
    audit_fp = mix(audit_fp, 40625512, 4357)
    audit_fp = mix(audit_fp, 853998860, 4357)
    audit_fp = mix(audit_fp, 991960186, 4357)
    audit_fp = mix(audit_fp, 6, 4357)
    audit_fp = mix(audit_fp, 13, 4357)
    audit_fp = mix(audit_fp, 255, 4357)
    if audit_fp != 4135036 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 66, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 66, 1103)
    if entry_fp != 526492507 { return 3 }

    let manifest_fp: i64 = 536676300
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 63, 1871)
    result_fp = mix(result_fp, 67, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 55, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 46398050 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 63, 1907)
    family_fp = mix(family_fp, 67, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 50, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 587958071 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 63, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 891293978 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 63, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 98798749 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 63, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 262835863 { return 8 }
    return 0
}
