//@ run-pass
//@ requires: madaros
// Native-v2 witness. The `use` is what admits this file to the modular ELF
// lane; mark() is otherwise unused by the image check.
use const_i64_array_image_mod::mod::{mark}
fn main() -> i64 {
    let xs: [i64; 4] = [3, 5, 7, 11]
    let sum = xs[0] + xs[1] + xs[2] + xs[3]
    if sum == 26 && mark() == 1 { 0 } else { 1 }
}
