//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-4 boundary-gluing proof skeleton

fn child4_boundary_gluing_proof_skeleton_check(
    child4_boundary_gluing_obligation_seed_fp: i64,
    child4_boundary_gluing_obligation_seed_audit_fp: i64,
    child4_discharge_obligation_bundle_fp: i64,
    child4_discharge_obligation_bundle_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    boundary_gluing_pending_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    skeleton_status: i64) -> i64 {
    if child4_boundary_gluing_obligation_seed_fp != 604182937 { return 0 - 1 }
    if child4_boundary_gluing_obligation_seed_audit_fp != 218570463 { return 0 - 1 }
    if child4_discharge_obligation_bundle_fp != 741805623 { return 0 - 1 }
    if child4_discharge_obligation_bundle_audit_fp != 529164708 { return 0 - 1 }
    if boundary_gluing_obligation_mask != 31 { return 0 - 1 }
    if boundary_gluing_pending_mask != 31 { return 0 - 1 }
    if boundary_gluing_verified_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if skeleton_status != 79 { return 0 - 1 }
    return 836470291
}

fn main() -> i64 {
    let artifact = child4_boundary_gluing_proof_skeleton_check(
        604182937, 218570463, 741805623, 529164708, 31, 31, 0, 0, 0, 0, 0, 79)
    if artifact != 836470291 { return 1 }

    let audit_fp: i64 = 190735846
    let instance_fp: i64 = 472619308
    let certificate_fp: i64 = 619284057
    let boundary_face_count: i64 = 5
    let skeleton_slot_mask: i64 = 31
    let skeleton_topology_mask: i64 = 31
    let skeleton_dependency_mask: i64 = 31
    let skeleton_trace_mask: i64 = 31
    let skeleton_verified_mask: i64 = 0
    let solver_skeleton_action_mask: i64 = 31
    let ready_for_boundary_gluing_proof_mask: i64 = 0
    let ok_mask: i64 = 255

    if audit_fp != 190735846 { return 2 }
    if instance_fp != 472619308 { return 3 }
    if certificate_fp != 619284057 { return 4 }
    if boundary_face_count != 5 { return 5 }
    if skeleton_slot_mask != 31 { return 6 }
    if skeleton_topology_mask != 31 { return 7 }
    if skeleton_dependency_mask != 31 { return 8 }
    if skeleton_trace_mask != 31 { return 9 }
    if skeleton_verified_mask != 0 { return 10 }
    if solver_skeleton_action_mask != 31 { return 11 }
    if ready_for_boundary_gluing_proof_mask != 0 { return 12 }
    if ok_mask != 255 { return 13 }

    let wrong_seed = child4_boundary_gluing_proof_skeleton_check(
        1, 218570463, 741805623, 529164708, 31, 31, 0, 0, 0, 0, 0, 79)
    if wrong_seed != 0 - 1 { return 14 }

    let fake_verified = child4_boundary_gluing_proof_skeleton_check(
        604182937, 218570463, 741805623, 529164708, 31, 31, 1, 0, 0, 0, 0, 79)
    if fake_verified != 0 - 1 { return 15 }

    let fake_proof = child4_boundary_gluing_proof_skeleton_check(
        604182937, 218570463, 741805623, 529164708, 31, 31, 0, 1, 0, 0, 0, 79)
    if fake_proof != 0 - 1 { return 16 }

    let fake_global = child4_boundary_gluing_proof_skeleton_check(
        604182937, 218570463, 741805623, 529164708, 31, 31, 0, 0, 0, 0, 1, 79)
    if fake_global != 0 - 1 { return 17 }

    return 0
}
