//@ run-pass
// EXACT measure-layer Structural Annihilation (Frente A: the SECOND half, over Q).
//
// The ZD census (over Z) certified the annihilation LOCUS. This certifies the MEASURE claim on it,
// exactly over Q -- the exact analogue of the float "confidence collapse" in sedenion_zero_divisor.sio.
//
// Object (from that float witness): a = alpha*e3 + beta*e10, b = gamma*e6 + delta*e15.
// The e5 and e12 components of a*b are  r5 = alpha*gamma + beta*delta,  r12 = alpha*delta + beta*gamma.
// The locus is { (alpha,beta,gamma,delta) : r5 = r12 = 0 } (e.g. (t,t,s,-s) for any t,s).
//
// Claim executed here, by DECIDABLE RATIONAL equality (no tolerance):
//   * measure supported EXACTLY on the locus  ->  E[r] = 0/1  AND  Var[r] = 0/1   (exact zero)
//   * measure perturbed OFF the locus (exact rational eps)  ->  E[r] = 0/1  BUT  Var[r] > 0 exactly.
// float Var>0 was the number; exact Var = 0/1 vs 1/150 is the contract.
//
// Self-contained inline rationals (num/den, i64). NB: i64-bounded (issue: no bigint) -- fine for these
// small denominators; a general measure needs overflow-checked / bigint rationals (rational.sio's guards).

fn igcd(a: i64, b: i64) -> i64 with Mut, Panic, Div {
    var x = if a < 0 { 0 - a } else { a }
    var y = if b < 0 { 0 - b } else { b }
    while y != 0 {
        let t = x - (x / y) * y   // x mod y
        x = y
        y = t
    }
    if x == 0 { 1 } else { x }
}

struct Rat { n: i64, d: i64 }

// Normalize: den > 0, gcd(|n|,d) = 1.
fn rat_make(n: i64, d: i64) -> Rat with Mut, Panic, Div {
    var nn = n
    var dd = d
    if dd < 0 { nn = 0 - nn; dd = 0 - dd }
    let g = igcd(nn, dd)
    Rat { n: nn / g, d: dd / g }
}
fn rat_add(a: Rat, b: Rat) -> Rat with Mut, Panic, Div { rat_make(a.n * b.d + b.n * a.d, a.d * b.d) }
fn rat_sub(a: Rat, b: Rat) -> Rat with Mut, Panic, Div { rat_make(a.n * b.d - b.n * a.d, a.d * b.d) }
fn rat_mul(a: Rat, b: Rat) -> Rat with Mut, Panic, Div { rat_make(a.n * b.n, a.d * b.d) }
fn rat_is_zero(a: Rat) -> bool { a.n == 0 }
fn rat_eq(a: Rat, b: Rat) -> bool { a.n == b.n && a.d == b.d }

// Product component r5 = alpha*gamma + beta*delta, exactly over Q.
fn r5(al: Rat, be: Rat, ga: Rat, de: Rat) -> Rat with Mut, Panic, Div {
    rat_add(rat_mul(al, ga), rat_mul(be, de))
}

// Empirical measure over N equal-weight sample points held in fixed arrays (num/den, one entry
// per sample per coefficient). E[r] = (sum r_i)/N ; Var[r] = (sum r_i^2)/N - E^2, exact.
// Returns nothing; prints the exact E and Var and a PASS/FAIL against expected.
fn run_case(
    tag: i64,          // 0 = on-locus, 1 = off-locus
    n: i64,
    a_n: [i64; 8], a_d: [i64; 8],
    b_n: [i64; 8], b_d: [i64; 8],
    g_n: [i64; 8], g_d: [i64; 8],
    d_n: [i64; 8], d_d: [i64; 8]
) -> bool with Mut, Panic, IO, Div {
    var sum = Rat { n: 0, d: 1 }
    var sumsq = Rat { n: 0, d: 1 }
    var i = 0
    while i < n {
        let al = rat_make(a_n[i as usize], a_d[i as usize])
        let be = rat_make(b_n[i as usize], b_d[i as usize])
        let ga = rat_make(g_n[i as usize], g_d[i as usize])
        let de = rat_make(d_n[i as usize], d_d[i as usize])
        let ri = r5(al, be, ga, de)
        sum = rat_add(sum, ri)
        sumsq = rat_add(sumsq, rat_mul(ri, ri))
        i = i + 1
    }
    let invN = rat_make(1, n)
    let ev = rat_mul(sum, invN)                       // E[r]
    let e2 = rat_mul(ev, ev)
    let varv = rat_sub(rat_mul(sumsq, invN), e2)       // Var[r] = E[r^2] - E[r]^2
    print("  E[r]  = "); print_int(ev.n); print("/"); print_int(ev.d); print("\n")
    print("  Var[r]= "); print_int(varv.n); print("/"); print_int(varv.d); print("\n")
    // machine-parseable line for the cross-toolchain gate: MEASURE <tag> E <n> <d> VAR <n> <d>
    print("MEASURE ")
    print_int(tag)
    print(" E ")
    print_int(ev.n)
    print(" ")
    print_int(ev.d)
    print(" VAR ")
    print_int(varv.n)
    print(" ")
    print_int(varv.d)
    print("\n")
    // On-locus: E=0 AND Var=0. Off-locus: E=0 AND Var != 0.
    if tag == 0 {
        rat_is_zero(ev) && rat_is_zero(varv)
    } else {
        rat_is_zero(ev) && !rat_is_zero(varv)
    }
}

fn main() with IO, Mut, Panic, Div {
    // CASE 1 -- support EXACTLY on the locus: (t,t,s,-s) has r5 = t*s + t*(-s) = 0 for all t,s.
    // 3 samples: (1,1,1,-1), (2,2,1,-1), (1,1,3,-3). Each: r5 = 0 exactly.
    var a_n = [1, 2, 1, 0, 0, 0, 0, 0]
    var a_d = [1, 1, 1, 1, 1, 1, 1, 1]
    var b_n = [1, 2, 1, 0, 0, 0, 0, 0]
    var b_d = [1, 1, 1, 1, 1, 1, 1, 1]
    var g_n = [1, 1, 3, 0, 0, 0, 0, 0]
    var g_d = [1, 1, 1, 1, 1, 1, 1, 1]
    var d_n = [0 - 1, 0 - 1, 0 - 3, 0, 0, 0, 0, 0]
    var d_d = [1, 1, 1, 1, 1, 1, 1, 1]
    print("CASE on-locus (support in Z, exact):\n")
    let ok1 = run_case(0, 3, a_n, a_d, b_n, b_d, g_n, g_d, d_n, d_d)
    if ok1 { println("  ON-LOCUS E=0 Var=0 PASS") } else { println("  ON-LOCUS FAIL") }

    // CASE 2 -- support perturbed OFF the locus by exact eps = 1/10 on alpha (gamma=1, beta=1, delta=-1):
    // r5 = alpha*1 + 1*(-1) = alpha - 1.  alpha in {9/10, 1, 11/10} -> r5 in {-1/10, 0, 1/10}.
    // E = 0, Var = ((1/10)^2 + 0 + (1/10)^2)/3 = (2/100)/3 = 1/150 (exact positive rational).
    var a2n = [9, 1, 11, 0, 0, 0, 0, 0]
    var a2d = [10, 1, 10, 1, 1, 1, 1, 1]
    var b2n = [1, 1, 1, 0, 0, 0, 0, 0]
    var b2d = [1, 1, 1, 1, 1, 1, 1, 1]
    var g2n = [1, 1, 1, 0, 0, 0, 0, 0]
    var g2d = [1, 1, 1, 1, 1, 1, 1, 1]
    var d2n = [0 - 1, 0 - 1, 0 - 1, 0, 0, 0, 0, 0]
    var d2d = [1, 1, 1, 1, 1, 1, 1, 1]
    print("CASE off-locus (perturbed by eps=1/10, exact):\n")
    let ok2 = run_case(1, 3, a2n, a2d, b2n, b2d, g2n, g2d, d2n, d2d)
    if ok2 { println("  OFF-LOCUS E=0 Var>0 PASS") } else { println("  OFF-LOCUS FAIL") }

    // The exact contract: Var flips from 0/1 (on locus) to 1/150 (off locus) by decidable Q equality.
    if ok1 && ok2 { println("EXACT-MEASURE-ANNIHILATION PASS") } else { println("EXACT-MEASURE-ANNIHILATION FAIL") }
}
