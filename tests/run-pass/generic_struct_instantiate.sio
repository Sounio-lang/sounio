//@ run-pass
// Test: generic struct definition, instantiation, field access

struct Pair<T> {
    first: T,
    second: T,
}

struct Map<K, V> {
    key: K,
    val: V,
}

fn main() with IO {
    // Single type param with i64
    let p = Pair { first: 10, second: 20 }
    println(p.first)
    println(p.second)

    // Two type params
    let m = Map { key: 42, val: 99 }
    println(m.key)
    println(m.val)
}
