//@ run-pass
// Test: generic struct definition, instantiation, field access

struct Pair<T> {
    first: T,
    second: T,
}

struct Map<K, V> {
    key: K,
    val: V,
}

fn main() with IO {
    // Single type param with i64
    let p = Pair { first: 10, second: 20 }
    // Explicit annotations: a generic field print loses the scalar kind at
    // print dispatch (#2354); the typed binding restores it.
    let pf: i64 = p.first
    let ps: i64 = p.second
    println(pf)
    println(ps)

    // Two type params
    let m = Map { key: 42, val: 99 }
    let mk: i64 = m.key
    let mv: i64 = m.val
    println(mk)
    println(mv)
}
