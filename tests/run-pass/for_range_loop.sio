//@ run-pass
fn main() -> i32 with IO, Mut {
    var sum: i32 = 0
    for i in 0..10 {
        sum = sum + i
    }
    if sum != 45 { return 1 }

    var count: i32 = 0
    for i in 0..5 {
        for j in 0..3 {
            count = count + 1
        }
    }
    if count != 15 { return 2 }

    let n: i32 = 8
    var total: i32 = 0
    for k in 0..n {
        total = total + k * k
    }
    if total != 140 { return 3 }

    println("ALL PASS")
    0
}
