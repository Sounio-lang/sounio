//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-2 obligation seed receipt

fn child2_obligation_seed_check(
    child1_discharge_preflight_fp: i64,
    child1_discharge_preflight_audit_fp: i64,
    child1_validation_core_fp: i64,
    child1_validation_core_audit_fp: i64,
    child_index: i64,
    slot_x: i64,
    slot_y: i64,
    slot_z: i64,
    global_flowpipe_claim_mask: i64,
    seed_status: i64) -> i64 {
    if child1_discharge_preflight_fp != 719480263 { return 0 - 1 }
    if child1_discharge_preflight_audit_fp != 602184970 { return 0 - 1 }
    if child1_validation_core_fp != 648831016 { return 0 - 1 }
    if child1_validation_core_audit_fp != 63312412 { return 0 - 1 }
    if child_index != 2 { return 0 - 1 }
    if slot_x != 0 { return 0 - 1 }
    if slot_y != 1 { return 0 - 1 }
    if slot_z != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if seed_status != 64 { return 0 - 1 }
    return 844216507
}

fn main() -> i64 {
    let artifact = child2_obligation_seed_check(
        719480263, 602184970, 648831016, 63312412, 2, 0, 1, 0, 0, 64)
    if artifact != 844216507 { return 1 }

    let audit_fp: i64 = 781563019
    let instance_fp: i64 = 234881913
    let certificate_fp: i64 = 671092444
    let selected_child_mask: i64 = 4
    let prior_child_validated_mask: i64 = 3
    let pending_child_validation_mask: i64 = 28
    let local_flowpipe_proof_mask: i64 = 0
    let child_validated_mask: i64 = 0
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0
    let seed_status: i64 = 64
    let ok_mask: i64 = 255

    if audit_fp != 781563019 { return 2 }
    if instance_fp != 234881913 { return 3 }
    if certificate_fp != 671092444 { return 4 }
    if selected_child_mask != 4 { return 5 }
    if prior_child_validated_mask != 3 { return 6 }
    if pending_child_validation_mask != 28 { return 7 }
    if local_flowpipe_proof_mask != 0 { return 8 }
    if child_validated_mask != 0 { return 9 }
    if child_discharge_mask != 0 { return 10 }
    if global_cover_certificate_mask != 0 { return 11 }
    if global_flowpipe_claim_mask != 0 { return 12 }
    if seed_status != 64 { return 13 }
    if ok_mask != 255 { return 14 }

    let wrong_child = child2_obligation_seed_check(
        719480263, 602184970, 648831016, 63312412, 1, 0, 1, 0, 0, 64)
    if wrong_child != 0 - 1 { return 15 }

    let wrong_slot = child2_obligation_seed_check(
        719480263, 602184970, 648831016, 63312412, 2, 1, 0, 0, 0, 64)
    if wrong_slot != 0 - 1 { return 16 }

    let overclaim = child2_obligation_seed_check(
        719480263, 602184970, 648831016, 63312412, 2, 0, 1, 0, 1, 64)
    if overclaim != 0 - 1 { return 17 }

    return 0
}
