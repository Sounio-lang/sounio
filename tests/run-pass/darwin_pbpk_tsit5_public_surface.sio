//@ run-pass
//@ requires: madaros
//@ expect-stdout: TSIT5_PUBLIC_SURFACE_OK
// Madaros runtime guard for the Tsit5 surface made public in PR #2698: the
// Butcher tableau helpers and the PBPKSolution14 result fields.
//
// Every assertion is a property of the method or of the solver's bookkeeping,
// not a fitted value:
// - row sums: sum_j a_ij == c_i (consistency of each stage);
// - sum_i b_i == 1 and sum_i e_i == 0 (e = b - b_hat, both weight vectors sum to 1);
// - FSAL: b_i == a_7i for i < 7 and b_7 == 0, exactly, since they are the same literals;
// - nfeval == 7 * (nsteps + nreject): each attempted step costs 7 evaluations.
//
// Tolerance 1e-13, derived: the published decimals carry up to 5.5e-16 of
// truncation (exact rational residual of row 5), and summing <= 6 terms of
// magnitude <= 12.93 in f64 adds at most about 6 * 1.11e-16 * sum|a_ij|
// (< 27), i.e. ~1.8e-14. Measured f64 residuals are <= 7.8e-16.

use darwin_pbpk::tsit5_pbpk14::*

fn near(a: f64, b: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < 0.0000000000001
}

fn main() -> i32 with IO, Mut, Div, Panic {
    if near(tsit5_a21(), tsit5_c2()) == false { return 1 }
    if near(tsit5_a31() + tsit5_a32(), tsit5_c3()) == false { return 2 }
    if near(tsit5_a41() + tsit5_a42() + tsit5_a43(), tsit5_c4()) == false { return 3 }
    if near(tsit5_a51() + tsit5_a52() + tsit5_a53() + tsit5_a54(), tsit5_c5()) == false { return 4 }
    if near(tsit5_a61() + tsit5_a62() + tsit5_a63() + tsit5_a64() + tsit5_a65(), tsit5_c6()) == false { return 5 }
    if near(tsit5_a71() + tsit5_a72() + tsit5_a73() + tsit5_a74() + tsit5_a75() + tsit5_a76(), tsit5_c7()) == false { return 6 }

    let sum_b = tsit5_b1() + tsit5_b2() + tsit5_b3() + tsit5_b4() + tsit5_b5() + tsit5_b6() + tsit5_b7()
    if near(sum_b, 1.0) == false { return 7 }
    let sum_e = tsit5_e1() + tsit5_e2() + tsit5_e3() + tsit5_e4() + tsit5_e5() + tsit5_e6() + tsit5_e7()
    if near(sum_e, 0.0) == false { return 8 }

    if tsit5_b1() != tsit5_a71() { return 9 }
    if tsit5_b2() != tsit5_a72() { return 10 }
    if tsit5_b3() != tsit5_a73() { return 11 }
    if tsit5_b4() != tsit5_a74() { return 12 }
    if tsit5_b5() != tsit5_a75() { return 13 }
    if tsit5_b6() != tsit5_a76() { return 14 }
    if tsit5_b7() != 0.0 { return 15 }

    // PBPKSolution14 fields, read from outside the defining module.
    let prm = default_pbpk_params()
    let dose = 100.0
    let t_end = 8.0
    let sol = solve_pbpk14(dose, t_end, prm, default_ode_config())
    if sol.success == false { return 16 }
    // Bounds are written positively so a NaN (every comparison false) fails.
    if (sol.t_final >= t_end) == false { return 17 }
    if sol.nfeval != 7 * (sol.nsteps + sol.nreject) { return 18 }
    let in_body = pbpk_state_total_mass(sol.state_final, prm)
    if (in_body > 0.0 && in_body < dose) == false { return 19 }

    println("TSIT5_PUBLIC_SURFACE_OK")
    0
}
