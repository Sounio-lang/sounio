//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v104 smoke for Lorenz i256 step-3 Taylor-2 completed candidate bundle

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1867
    receipt_fp = mix(receipt_fp, 693283321, 5843)
    receipt_fp = mix(receipt_fp, 160292433, 5843)
    receipt_fp = mix(receipt_fp, 994004460, 5843)
    receipt_fp = mix(receipt_fp, 792236662, 5843)
    receipt_fp = mix(receipt_fp, 420821728, 5843)
    receipt_fp = mix(receipt_fp, 502178581, 5843)
    receipt_fp = mix(receipt_fp, 953013701, 5843)
    receipt_fp = mix(receipt_fp, 693563916, 5843)
    receipt_fp = mix(receipt_fp, 465507112, 5843)
    receipt_fp = mix(receipt_fp, 3, 5843)
    receipt_fp = mix(receipt_fp, 4, 5843)
    receipt_fp = mix(receipt_fp, 255, 5843)
    if receipt_fp != 371983758 { return 1 }

    var audit_fp: i64 = 1871
    audit_fp = mix(audit_fp, receipt_fp, 5849)
    audit_fp = mix(audit_fp, 693283321, 5849)
    audit_fp = mix(audit_fp, 160292433, 5849)
    audit_fp = mix(audit_fp, 994004460, 5849)
    audit_fp = mix(audit_fp, 792236662, 5849)
    audit_fp = mix(audit_fp, 693563916, 5849)
    audit_fp = mix(audit_fp, 465507112, 5849)
    audit_fp = mix(audit_fp, 953013701, 5849)
    audit_fp = mix(audit_fp, 3, 5849)
    audit_fp = mix(audit_fp, 4, 5849)
    audit_fp = mix(audit_fp, 255, 5849)
    if audit_fp != 641476816 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 107, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 107, 1103)
    if entry_fp != 748010765 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 104, 1151)
    manifest_fp = mix(manifest_fp, 108, 1151)
    manifest_fp = mix(manifest_fp, 502178581, 1151)
    manifest_fp = mix(manifest_fp, 420821728, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 824838852 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 104, 1871)
    result_fp = mix(result_fp, 108, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 96, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 818335516 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 104, 1907)
    family_fp = mix(family_fp, 108, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 91, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 588409436 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 104, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 527800756 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 104, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 985220902 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 104, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
