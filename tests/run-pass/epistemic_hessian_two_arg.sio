//@ run-pass
// Tier 3: two-arg Hessian for atan2 and pow

// atan2(y, x) at y=0, x=1:
// ∂²/∂y² = -2xy/(x²+y²)² = 0 (since y=0)
// ∂²/∂x² =  2xy/(x²+y²)² = 0 (since y=0)
// H[0,0] at y=0, x=1 => faa*1*1 + fbb*0*0 + ... = 0.0
fn test_atan2_h00_y0() -> f64 with IO, Epistemic {
    let ym: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let xm: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let y = ym.value
    let x = xm.value
    hessian_of(atan2(y, x), 0, 0)
}

// atan2(y, x) H[0,1] at y=0, x=1: fab*(s0(y)*s1(x) + s1(y)*s0(x)) = 1*(1*0 + 0*1) = 0
// y is channel 0, x is channel 1; fab = (y²-x²)/(x²+y²)² = -1
// H[0,1] = fab*(sy0*sx1 + sy1*sx0) = (-1)*(1*1 + 0*0) = -1
fn test_atan2_h01_y0x1() -> f64 with IO, Epistemic {
    let ym: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let xm: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let y = ym.value
    let x = xm.value
    hessian_of(atan2(y, x), 0, 1)
}

// pow(x, 2.0): H[0,0] = y*(y-1)*x^(y-2) = 2*1*1 = 2
fn test_pow_h00() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let x = xm.value
    hessian_of(pow(x, 2.0), 0, 0)
}

// pow(x, y) at x=e, y=1: H[0,0] = y*(y-1)*x^(y-2) = 1*0*e^(-1) = 0
fn test_pow_h00_zero() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(2.718281828459045, uncertainty: 0.0)
    let x = xm.value
    hessian_of(pow(x, 1.0), 0, 0)
}

fn main() with IO, Epistemic {
    let h_atan2_00 = test_atan2_h00_y0()       // expect  0.0
    let h_atan2_01 = test_atan2_h01_y0x1()     // expect -1.0
    let h_pow_00   = test_pow_h00()             // expect  2.0
    let h_pow_zero = test_pow_h00_zero()        // expect  0.0
    println(h_atan2_00)
    println(h_atan2_01)
    println(h_pow_00)
    println(h_pow_zero)
}
