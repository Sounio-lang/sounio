//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: COUNT_DATASET_REFERENCE_PASS
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_at,integer_buffer_close}
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close}
use genomics::count_dataset::{count_dataset_align,count_dataset_gene,count_dataset_offsets}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let n:i64=512
 var ck=integer_buffer_new(n,n*8)
 var mk=integer_buffer_new(n,n*8)
 var perm=integer_buffer_new(n,n*8)
 var co=integer_buffer_new(n,n*8)
 var mo=integer_buffer_new(n,n*8)
 var stage=integer_buffer_new(n,n*8)
 var marks=integer_buffer_new(n,n*8)
 var counts=integer_buffer_new(2*n,2*n*8)
 var row=integer_buffer_new(n,n*8)
 var lf=numeric_buffer_new(n,n*8)
 var exposure=numeric_buffer_new(n,n*8)
 var offsets=numeric_buffer_new(n,n*8)
 var ns=numeric_buffer_new(n,n*8)
 var i:i64=0
 while i<n {
  integer_buffer_set(&!ck,i,(n-1-i)*3-999)
  integer_buffer_set(&!mk,i,i*3-999)
  integer_buffer_set(&!counts,i,i+1)
  integer_buffer_set(&!counts,n+i,(i+1)*7)
  numeric_buffer_set(&!lf,i,(i as f64)*0.25)
  numeric_buffer_set(&!exposure,i,0.5)
  i=i+1
 }
 let aligned=count_dataset_align(&ck,&mk,40000,&!perm,&!co,&!mo,&!stage)
 assert(aligned.status==0 && aligned.comparisons<=40000)
 assert(count_dataset_gene(&counts,2,n,1,&perm,9007199254740992,&!row,&!marks)==0)
 assert(count_dataset_offsets(&lf,&exposure,&perm,&!offsets,&!ns,&!marks)==0)
 i=0
 while i<n {
  print("DATASET ");print(i);print(" ");print(integer_buffer_at(&perm,i));print(" ");print(integer_buffer_at(&row,i));print(" ");println(numeric_buffer_at(&offsets,i))
  i=i+1
 }
 integer_buffer_set(&!ck,0,-9223372036854775807-1)
 integer_buffer_set(&!mk,n-1,-9223372036854775807-1)
 integer_buffer_set(&!ck,n-1,9223372036854775807)
 integer_buffer_set(&!mk,0,9223372036854775807)
 let extreme=count_dataset_align(&ck,&mk,40000,&!perm,&!co,&!mo,&!stage)
 assert(extreme.status==0)
 assert(integer_buffer_at(&perm,n-1)==0 && integer_buffer_at(&perm,0)==n-1)
 integer_buffer_close(ck);integer_buffer_close(mk);integer_buffer_close(perm);integer_buffer_close(co);integer_buffer_close(mo);integer_buffer_close(stage);integer_buffer_close(marks);integer_buffer_close(counts);integer_buffer_close(row)
 numeric_buffer_close(lf);numeric_buffer_close(exposure);numeric_buffer_close(offsets);numeric_buffer_close(ns)
 println("COUNT_DATASET_REFERENCE_PASS")
 return 0
}
