//@ run-pass
//@ description: Imported Lorenz i256 signed delta bridge smoke

use systems::lorenz_i256_signed_delta_bridge::*

fn main() -> i64 {
    let positive = lorenz_i256_signed_delta_check(
        150000000, 1, 0, 0, 950000000, 0, 0, 0, 1, 200000000, 0, 0, 0)
    if positive != 1 { return 1 }

    let negative = lorenz_i256_signed_delta_check(
        950000000, 0, 0, 0, 150000000, 1, 0, 0, 0 - 1, 200000000, 0, 0, 0)
    if negative != 1 { return 2 }

    let zero = lorenz_i256_signed_delta_check(
        950000000, 0, 0, 0, 950000000, 0, 0, 0, 0, 0, 0, 0, 0)
    if zero != 1 { return 3 }

    let borrow = lorenz_i256_signed_delta_check(
        0, 1, 0, 0, 1, 0, 0, 0, 1, 999999999, 0, 0, 0)
    if borrow != 1 { return 4 }

    let artifact = lorenz_i256_signed_delta_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 104)
    if artifact != 492681735 { return 5 }

    let audit = lorenz_i256_signed_delta_bridge_audit_fingerprint(
        artifact, 604913728, 195740286, 1, 1, 1, 1, 1, 256, 1000000000,
        0, 0, 0, 0, 104, 1023)
    if audit != 837260419 { return 6 }
    return 0
}
