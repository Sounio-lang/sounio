//@ run-pass

struct Eight { a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64 }

fn make() -> Eight {
    Eight { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 }
}

fn main() with IO {
    let v = make()
    assert(v.a == 1)
    assert(v.b == 2)
    assert(v.c == 3)
    assert(v.d == 4)
    assert(v.e == 5)
    assert(v.f == 6)
    assert(v.g == 7)
    assert(v.h == 8)
    print("OK\n")
}
