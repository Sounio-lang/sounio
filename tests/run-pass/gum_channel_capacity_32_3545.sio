//@ run-pass
//@ requires: madaros
//@ expect-stdout: GUM_CHANNEL_32_PASS
// #3545: independent sources must never be silently dropped after channel 32.
// Mathematical variance: 32 * 0.1^2 = 0.32.

fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    let k0: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k1: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k2: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k3: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k4: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k5: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k6: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k7: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k8: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k9: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k10: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k11: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k12: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k13: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k14: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k15: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k16: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k17: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k18: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k19: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k20: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k21: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k22: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k23: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k24: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k25: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k26: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k27: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k28: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k29: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k30: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k31: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let s = k0.value + k1.value + k2.value + k3.value + k4.value + k5.value + k6.value + k7.value + k8.value + k9.value + k10.value + k11.value + k12.value + k13.value + k14.value + k15.value + k16.value + k17.value + k18.value + k19.value + k20.value + k21.value + k22.value + k23.value + k24.value + k25.value + k26.value + k27.value + k28.value + k29.value + k30.value + k31.value
    let v = variance_of(s)
    print_f64(v)
    print("\n")
    if v < 0.319999999999 || v > 0.320000000001 { return 1 }
    print("GUM_CHANNEL_32_PASS\n")
    return 0
}
