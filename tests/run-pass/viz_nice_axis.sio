//@ run-pass
//@ expect-stdout: NICE_AXIS_REFERENCE_PASS
use viz::nice_axis::{axis_nice_cover}
fn near(a:f64,b:f64,s:f64)->bool with Div {let d=if a>b {a-b}else{b-a} d/s < 2.0e-12}
fn main() with IO, Mut, Div, Panic {
    println("NICE_CASE_0")
    let p0=axis_nice_cover(0.00000000000000000e+00,8.00000000000000000e+00,4)
    assert(p0.status == 0 && p0.intervals == 4)
    assert(near(p0.lo,0.00000000000000000e+00,2.00000000000000000e+00))
    assert(near(p0.hi,8.00000000000000000e+00,2.00000000000000000e+00))
    assert(near(p0.step,2.00000000000000000e+00,2.00000000000000000e+00))
    assert(p0.lo <= 0.00000000000000000e+00 && p0.hi >= 8.00000000000000000e+00)
    println("NICE_CASE_1")
    let p1=axis_nice_cover(1.30000000000000004e-01,9.10000000000000031e-01,5)
    assert(p1.status == 0 && p1.intervals == 5)
    assert(near(p1.lo,0.00000000000000000e+00,2.00000000000000011e-01))
    assert(near(p1.hi,1.00000000000000000e+00,2.00000000000000011e-01))
    assert(near(p1.step,2.00000000000000011e-01,2.00000000000000011e-01))
    assert(p1.lo <= 1.30000000000000004e-01 && p1.hi >= 9.10000000000000031e-01)
    println("NICE_CASE_2")
    let p2=axis_nice_cover(1.10000000000000009e+00,9.09999999999999964e+00,4)
    assert(p2.status == 0 && p2.intervals == 4)
    assert(near(p2.lo,0.00000000000000000e+00,2.50000000000000000e+00))
    assert(near(p2.hi,1.00000000000000000e+01,2.50000000000000000e+00))
    assert(near(p2.step,2.50000000000000000e+00,2.50000000000000000e+00))
    assert(p2.lo <= 1.10000000000000009e+00 && p2.hi >= 9.09999999999999964e+00)
    println("NICE_CASE_3")
    let p3=axis_nice_cover(-3.10000000000000009e+00,8.69999999999999929e+00,5)
    assert(p3.status == 0 && p3.intervals == 3)
    assert(near(p3.lo,-5.00000000000000000e+00,5.00000000000000000e+00))
    assert(near(p3.hi,1.00000000000000000e+01,5.00000000000000000e+00))
    assert(near(p3.step,5.00000000000000000e+00,5.00000000000000000e+00))
    assert(p3.lo <= -3.10000000000000009e+00 && p3.hi >= 8.69999999999999929e+00)
    println("NICE_CASE_4")
    let p4=axis_nice_cover(-3.10000000000000000e-04,7.90000000000000012e-04,5)
    assert(p4.status == 0 && p4.intervals == 3)
    assert(near(p4.lo,-5.00000000000000010e-04,5.00000000000000010e-04))
    assert(near(p4.hi,1.00000000000000002e-03,5.00000000000000010e-04))
    assert(near(p4.step,5.00000000000000010e-04,5.00000000000000010e-04))
    assert(p4.lo <= -3.10000000000000000e-04 && p4.hi >= 7.90000000000000012e-04)
    println("NICE_CASE_5")
    let p5=axis_nice_cover(1.29999999999999995e-299,9.09999999999999965e-299,5)
    assert(p5.status == 0 && p5.intervals == 5)
    assert(near(p5.lo,0.00000000000000000e+00,1.99999999999999998e-299))
    assert(near(p5.hi,9.99999999999999912e-299,1.99999999999999998e-299))
    assert(near(p5.step,1.99999999999999998e-299,1.99999999999999998e-299))
    assert(p5.lo <= 1.29999999999999995e-299 && p5.hi >= 9.09999999999999965e-299)
    println("NICE_CASE_6")
    let p6=axis_nice_cover(1.29999999999999999e+299,9.09999999999999959e+299,5)
    assert(p6.status == 0 && p6.intervals == 5)
    assert(near(p6.lo,0.00000000000000000e+00,2.00000000000000011e+299))
    assert(near(p6.hi,1.00000000000000005e+300,2.00000000000000011e+299))
    assert(near(p6.step,2.00000000000000011e+299,2.00000000000000011e+299))
    assert(p6.lo <= 1.29999999999999999e+299 && p6.hi >= 9.09999999999999959e+299)
    println("NICE_CASE_7")
    let p7=axis_nice_cover(-9.10000000000000000e+01,-1.30000000000000000e+01,5)
    assert(p7.status == 0 && p7.intervals == 5)
    assert(near(p7.lo,-1.00000000000000000e+02,2.00000000000000000e+01))
    assert(near(p7.hi,-0.00000000000000000e+00,2.00000000000000000e+01))
    assert(near(p7.step,2.00000000000000000e+01,2.00000000000000000e+01))
    assert(p7.lo <= -9.10000000000000000e+01 && p7.hi >= -1.30000000000000000e+01)
    println("NICE_CASE_8")
    let p8=axis_nice_cover(-9.10000000000000031e-01,-1.30000000000000004e-01,5)
    assert(p8.status == 0 && p8.intervals == 5)
    assert(near(p8.lo,-1.00000000000000000e+00,2.00000000000000011e-01))
    assert(near(p8.hi,-0.00000000000000000e+00,2.00000000000000011e-01))
    assert(near(p8.step,2.00000000000000011e-01,2.00000000000000011e-01))
    assert(p8.lo <= -9.10000000000000031e-01 && p8.hi >= -1.30000000000000004e-01)
    println("NICE_CASE_9")
    let p9=axis_nice_cover(0.00000000000000000e+00,1.00000000000000000e+00,1)
    assert(p9.status == 0 && p9.intervals == 1)
    assert(near(p9.lo,0.00000000000000000e+00,1.00000000000000000e+00))
    assert(near(p9.hi,1.00000000000000000e+00,1.00000000000000000e+00))
    assert(near(p9.step,1.00000000000000000e+00,1.00000000000000000e+00))
    assert(p9.lo <= 0.00000000000000000e+00 && p9.hi >= 1.00000000000000000e+00)
    println("NICE_CASE_10")
    let p10=axis_nice_cover(1.23000000000000007e+01,9.87000000000000028e+01,4)
    assert(p10.status == 0 && p10.intervals == 4)
    assert(near(p10.lo,0.00000000000000000e+00,2.50000000000000000e+01))
    assert(near(p10.hi,1.00000000000000000e+02,2.50000000000000000e+01))
    assert(near(p10.step,2.50000000000000000e+01,2.50000000000000000e+01))
    assert(p10.lo <= 1.23000000000000007e+01 && p10.hi >= 9.87000000000000028e+01)
    println("NICE_CASE_11")
    let p11=axis_nice_cover(-1.00000000000000000e+00,1.00000000000000000e+00,8)
    assert(p11.status == 0 && p11.intervals == 8)
    assert(near(p11.lo,-1.00000000000000000e+00,2.50000000000000000e-01))
    assert(near(p11.hi,1.00000000000000000e+00,2.50000000000000000e-01))
    assert(near(p11.step,2.50000000000000000e-01,2.50000000000000000e-01))
    assert(p11.lo <= -1.00000000000000000e+00 && p11.hi >= 1.00000000000000000e+00)
    assert(axis_nice_cover(1.0,1.0,4).status == 1)
    assert(axis_nice_cover(1.0,2.0,0).status == 1)
    assert(axis_nice_cover(1.0,2.0,9).status == 1)
    assert(axis_nice_cover(-1.0,1.0,1).status == 4)
    assert(axis_nice_cover(-1.0e308,1.0e308,4).status == 2)
    assert(axis_nice_cover(1.0e12,1.0e12+7.0,4).status == 3)
    var huge=1.0e308
    let inf=huge*10.0
    assert(axis_nice_cover(0.0,inf,4).status == 1)
    assert(axis_nice_cover(inf-inf,1.0,4).status == 1)
    println("NICE_AXIS_REFERENCE_PASS")
    0
}
