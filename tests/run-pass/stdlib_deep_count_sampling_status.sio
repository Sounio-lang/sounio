//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_COUNT_SAMPLING_STATUS_PASS
use stats::checked_count_sampling::{count_rng,poisson_count_draw,gamma_unit_draw,nb2_count_draw}
use random::pcg64_core::{PcgState,pcg_next_f64}
fn same(a:PcgState,b:PcgState)->bool {
 return a.state_hi==b.state_hi && a.state_lo==b.state_lo && a.inc_hi==b.inc_hi && a.inc_lo==b.inc_lo
}
fn main()->i32 with IO,Mut,Div,Panic {
 let rng=count_rng(17)
 let zero=poisson_count_draw(rng,0.0,0,0)
 assert(zero.status==0 && zero.count==0 && zero.uniforms==0 && zero.proposals==0)
 assert(same(zero.rng,rng))
 let budget=poisson_count_draw(rng,3.0,0,10)
 assert(budget.status==3 && budget.count==0 && budget.uniforms==0 && budget.proposals==1)
 assert(same(budget.rng,rng))
 let nobudget=poisson_count_draw(rng,3.0,10,0)
 assert(nobudget.status==3 && nobudget.uniforms==0 && nobudget.proposals==0)
 let single=poisson_count_draw(rng,20.0,1,100)
 let first=pcg_next_f64(rng)
 assert(single.status==3 && single.uniforms==1 && single.proposals==2)
 assert(same(single.rng,first.0))
 let invalid=poisson_count_draw(rng,-1.0,10,10)
 assert(invalid.status==1 && invalid.uniforms==0 && invalid.proposals==0)
 let big=poisson_count_draw(rng,4503599627370497.0,10,10)
 assert(big.status==5 && same(big.rng,rng))
 let negative_budget=poisson_count_draw(rng,0.0,-1,0)
 assert(negative_budget.status==1)
 let even=PcgState{state_hi:rng.state_hi,state_lo:rng.state_lo,inc_hi:rng.inc_hi,inc_lo:0}
 let badrng=poisson_count_draw(even,0.0,0,0)
 assert(badrng.status==1 && badrng.uniforms==0)
 let tiny=poisson_count_draw(rng,1.0e-30,10,10)
 assert(tiny.status==0 && tiny.count==0 && tiny.uniforms==1 && tiny.resolution_limited)
 let gamma_bad=gamma_unit_draw(rng,0.0,10,10)
 assert(gamma_bad.status==1 && !gamma_bad.value_available && !gamma_bad.log_available)
 let gamma_large=gamma_unit_draw(rng,9007199254740994.0,10,10)
 assert(gamma_large.status==5)
 let gamma_budget=gamma_unit_draw(rng,2.0,1,10)
 assert(gamma_budget.status==3 && gamma_budget.uniforms==1 && gamma_budget.proposals==1)
 assert(same(gamma_budget.rng,first.0))
 let extreme=gamma_unit_draw(rng,2.2250738585072014e-308/1.0e12,1000,1000)
 assert(extreme.status==0 && extreme.rounded_underflow && extreme.value_available && !extreme.log_available)
 assert(extreme.value==0.0 && extreme.log_value==0.0)
 let plain=poisson_count_draw(rng,40.0,1000,1000)
 let limit=nb2_count_draw(rng,40.0,-0.0,1000,1000)
 assert(plain.status==0 && limit.status==0 && plain.count==limit.count)
 assert(same(plain.rng,limit.rng) && plain.uniforms==limit.uniforms && plain.proposals==limit.proposals)
 let nb_zero=nb2_count_draw(rng,0.0,2.0,0,0)
 assert(nb_zero.status==0 && nb_zero.count==0 && same(nb_zero.rng,rng))
 let nb_bad=nb2_count_draw(rng,0.0,-1.0,0,0)
 assert(nb_bad.status==1)
 let reciprocal=nb2_count_draw(rng,1.0,1.0e-30,1000,1000)
 assert(reciprocal.status==5 && reciprocal.uniforms==0)
 println("STDLIB_DEEP_COUNT_SAMPLING_STATUS_PASS")
 0
}
