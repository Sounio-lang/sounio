//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v19 smoke for Lorenz ball-fixed radius-budget entry

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 22 { return 0 - 1 }
    if instance_fp != 508132668 { return 0 - 1 }
    if certificate_fp != 565673886 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 22 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn portfolio_v19_manifest_fingerprint(radius_budget_entry_fp: i64) -> i64 with Mod {
    if radius_budget_entry_fp != 295040814 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 19, 1151)
    fp = portfolio_mix(fp, 23, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, 590228875, 1151)
    fp = portfolio_mix(fp, 46718256, 1151)
    fp = portfolio_mix(fp, radius_budget_entry_fp, 1151)
    return fp
}

fn portfolio_v19_result_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 592974800 { return 0 - 1 }

    var fp: i64 = 131
    fp = portfolio_mix(fp, 19, 1871)
    fp = portfolio_mix(fp, 23, 1871)
    fp = portfolio_mix(fp, 8, 1871)
    fp = portfolio_mix(fp, 13, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn portfolio_v19_checker_family_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 592974800 { return 0 - 1 }

    var fp: i64 = 149
    fp = portfolio_mix(fp, 19, 1907)
    fp = portfolio_mix(fp, 23, 1907)
    fp = portfolio_mix(fp, 4, 1907)
    fp = portfolio_mix(fp, 3, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 1, 1907)
    fp = portfolio_mix(fp, 13, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn portfolio_v19_readiness_fingerprint(
    manifest_fp: i64,
    result_coverage_fp: i64,
    family_coverage_fp: i64,
    acceptance_receipt_fp: i64,
    audit_receipt_fp: i64) -> i64 with Mod {
    if manifest_fp != 592974800 { return 0 - 1 }
    if result_coverage_fp != 474634520 { return 0 - 1 }
    if family_coverage_fp != 17942049 { return 0 - 1 }
    if acceptance_receipt_fp != 213285430 { return 0 - 1 }
    if audit_receipt_fp != 845530340 { return 0 - 1 }

    var fp: i64 = 163
    fp = portfolio_mix(fp, 19, 1951)
    fp = portfolio_mix(fp, 31, 1951)
    fp = portfolio_mix(fp, manifest_fp, 1951)
    fp = portfolio_mix(fp, result_coverage_fp, 1951)
    fp = portfolio_mix(fp, family_coverage_fp, 1951)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1951)
    fp = portfolio_mix(fp, audit_receipt_fp, 1951)
    return fp
}

fn main() -> i64 with Mod {
    let entry_fp = portfolio_entry_fingerprint(22, 508132668, 565673886, 1, 22)
    if entry_fp != 295040814 { return 1 }

    let manifest_fp = portfolio_v19_manifest_fingerprint(entry_fp)
    if manifest_fp != 592974800 { return 2 }

    let result_coverage_fp = portfolio_v19_result_coverage_fingerprint(manifest_fp)
    if result_coverage_fp != 474634520 { return 3 }

    let family_coverage_fp = portfolio_v19_checker_family_coverage_fingerprint(manifest_fp)
    if family_coverage_fp != 17942049 { return 4 }

    if portfolio_v19_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        213285430, 845530340) != 865010181 { return 5 }

    if portfolio_entry_fingerprint(22, 508132668, 565673887, 1, 22) != (0 - 1) { return 6 }
    if portfolio_entry_fingerprint(22, 508132668, 565673886, 0, 22) != (0 - 1) { return 7 }
    if portfolio_v19_manifest_fingerprint(entry_fp + 1) != (0 - 1) { return 8 }
    if portfolio_v19_result_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 9 }
    if portfolio_v19_checker_family_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 10 }
    if portfolio_v19_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        213285430, 845530341) != (0 - 1) { return 11 }

    return 0
}
