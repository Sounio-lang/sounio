//@ run-pass
//@ expect-stdout: refinement_static: PASS
// Refinement types: static proof without Z3

// Named refinement type aliases
type Pos = { val: i64 | val > 0 }
type Prob = { val: f64 | val >= 0.0 && val <= 1.0 }

fn safe_div(a: i64, b: Pos) -> i64 with Div { a / b.val }

fn main() -> i32 with IO, Panic, Div {
    // Statically proven: 5 satisfies val > 0 (constant folding)
    let p = Pos { val: 5 }
    let result = safe_div(100, p)
    if result == 20 {
        print("refinement_static: PASS\n")
        return 0
    }
    print("refinement_static: FAIL\n")
    return 1
}
