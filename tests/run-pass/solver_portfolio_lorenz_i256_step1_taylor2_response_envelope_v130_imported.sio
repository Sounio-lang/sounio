//@ description: Imported portfolio v130 smoke for Lorenz i256 step-1 Taylor-2 response envelope

use theorem::portfolio::*

fn main() -> i64 {
    let receipt_fp = solver_portfolio_v130_lorenz_i256_step1_taylor2_response_envelope_fingerprint(
        496675613, 467471545, 311818225, 706283113, 435724379,
        44353214, 431845922, 301347724, 777254975, 1, 20, 255)
    if receipt_fp != 590782342 { return 1 }
    let audit_fp = solver_portfolio_v130_lorenz_i256_step1_taylor2_response_envelope_audit_fingerprint(
        receipt_fp, 496675613, 467471545, 972140381, 96825760,
        44353214, 431845922, 301347724, 777254975, 435724379,
        1, 20, 255)
    if audit_fp != 991875676 { return 2 }
    let manifest_fp = solver_portfolio_v130_lorenz_i256_step1_taylor2_response_envelope_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 549540177 { return 3 }
    let result_fp = solver_portfolio_v130_result_coverage_fingerprint(130, 134, 10, 122, 1, 1, manifest_fp)
    if result_fp != 581528248 { return 4 }
    let family_fp = solver_portfolio_v130_checker_family_coverage_fingerprint(130, 134, 6, 4, 3, 2, 117, 2, manifest_fp)
    if family_fp != 8708544 { return 5 }
    let acceptance_fp = solver_portfolio_v130_acceptance_receipt_fingerprint(130, manifest_fp, result_fp)
    if acceptance_fp != 973777941 { return 6 }
    let audit_receipt_fp = solver_portfolio_v130_audit_receipt_fingerprint(130, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 733264640 { return 7 }
    let readiness_fp = solver_portfolio_v130_readiness_fingerprint(130, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 275405819 { return 8 }
    return 0
}
