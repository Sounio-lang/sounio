//@ run-pass
//@ expect-stdout-contains: units: PASS
// Units of measure test (simplified - full units not yet implemented)

fn main() -> i64 with IO, Panic {
    var exit_fails: i64 = 0
    // Test basic arithmetic that would eventually have units
    let dose: f64 = 500.0
    let volume: f64 = 10.0
    let concentration = dose / volume

    if concentration == 50.0 {
        print("units: PASS\n")
    } else {
        print("units: FAIL\n")
        exit_fails = exit_fails + 1
    }
    if exit_fails > 0 {
        return 1
    }
    return 0
}
