//@ run-pass
//@ description: #2830/#2825 — u64 values with bit 63 set: `>>` is logical, `/` `%` and `<` `>` `<=` `>=` are unsigned, for locals AND parameters (lean_single used sar/idiv/setl for every u64).
//@ expect-stdout: PASS

fn shr_i(a: u64, k: i64) -> u64 { a >> k }
fn shr_u(a: u64, k: u64) -> u64 { a >> k }
fn shr_lit(a: u64) -> u64 { a >> 40 }
fn gt1(a: u64) -> bool { a > 1 }
fn div_u(a: u64, k: u64) -> u64 { a / k }
fn rem_u(a: u64, k: u64) -> u64 { a % k }
fn lt_u(a: u64, b: u64) -> bool { a < b }

// xorshift64* step from #2825; reference value computed with exact u64 arithmetic.
fn xorshift_hi(seed: u64) -> u64 with Mut {
    var s: u64 = seed
    let m: u64 = 0x2545F4914F6CDD1D
    s = s ^ (s >> 12)
    s = s ^ (s << 25)
    s = s ^ (s >> 27)
    let r: u64 = s * m
    r >> 33
}

fn main() -> i32 with IO, Mut, Div, Panic, Alloc {
    let a: u64 = 0xE220A8397B1DCDAF
    let ku: u64 = 40
    let one: u64 = 1
    if (a >> 40) != 14819496 { println("FAIL local >> lit"); return 1 }
    if (a >> ku) != 14819496 { println("FAIL local >> u64"); return 1 }
    if shr_i(a, 40) != 14819496 { println("FAIL param >> i64"); return 1 }
    if shr_u(a, 40) != 14819496 { println("FAIL param >> u64"); return 1 }
    if shr_lit(a) != 14819496 { println("FAIL param >> lit"); return 1 }
    if (a > one) == false { println("FAIL u64 > u64"); return 1 }
    if (a > 1) == false { println("FAIL u64 > lit"); return 1 }
    if gt1(a) == false { println("FAIL param > lit"); return 1 }
    if lt_u(one, a) == false { println("FAIL param <"); return 1 }
    if (a <= one) { println("FAIL u64 <="); return 1 }
    if (a / 3) != 5431402805552869178 { println("FAIL local / lit"); return 1 }
    if div_u(a, 3) != 5431402805552869178 { println("FAIL param /"); return 1 }
    if rem_u(a, 10) != 5 { println("FAIL param %"); return 1 }
    if xorshift_hi(88172645463325252) != 1934872821 { println("FAIL xorshift64*"); return 1 }
    // Signed i64 keeps arithmetic shift and signed compare.
    let n: i64 = 0 - 16
    if (n >> 2) != (0 - 4) { println("FAIL i64 >> (must stay arithmetic)"); return 1 }
    if (n < 1) == false { println("FAIL i64 < (must stay signed)"); return 1 }
    if (n / 4) != (0 - 4) { println("FAIL i64 / (must stay signed)"); return 1 }
    println("PASS")
    return 0
}
