//@ run-pass
// Issue #11: buffer read/write operations (byte-level semantics via i64 array).
// Rewritten to avoid raw pointer ops unsupported by lean_single.

// Little-endian pack: write value into buf[base..base+8]
fn wu64_le(buf: &![i64; 64], base: i64, value: i64) with Mut, Div {
    var v = value
    var j: i64 = 0
    while j < 8 {
        buf[base + j] = v % 256
        v = v / 256
        j = j + 1
    }
}

// Little-endian unpack: read 8 bytes from buf[base..base+8]
fn ru64_le(buf: &![i64; 64], base: i64) -> i64 with Div {
    var result: i64 = 0
    var mult: i64 = 1
    var j: i64 = 0
    while j < 8 {
        result = result + buf[base + j] * mult
        mult = mult * 256
        j = j + 1
    }
    return result
}

fn main() -> i64 with Panic, Div, Mut {
    var buffer: [i64; 64] = [0; 64]
    var n_pass = 0

    // Sub-test 1: single byte write
    buffer[0] = 42
    if buffer[0] == 42 { n_pass = n_pass + 1 }

    // Sub-test 2: little-endian u64 encode/decode roundtrip
    wu64_le(&!buffer, 8, 12345678)
    let read_back = ru64_le(&!buffer, 8)
    if read_back == 12345678 { n_pass = n_pass + 1 }

    // Sub-test 3: sequential byte writes
    buffer[16] = 1
    buffer[17] = 2
    buffer[18] = 3
    if buffer[16] == 1 && buffer[17] == 2 && buffer[18] == 3 { n_pass = n_pass + 1 }

    // Sub-test 4: loop writes and sum check (10+11+12+...+17 = 108)
    var i: i64 = 0
    while i < 8 {
        buffer[24 + i] = i + 10
        i = i + 1
    }
    var sum: i64 = 0
    i = 0
    while i < 8 {
        sum = sum + buffer[24 + i]
        i = i + 1
    }
    if sum == 108 { n_pass = n_pass + 1 }

    if n_pass == 4 { return 0 } else { return 1 }
}
