//@ run-pass
//@ description: Feature C-a hyperboloid model — geodesic distance closed form + exp/log round-trip
use math::hyperbolic::*

fn approx(a: f64, b: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < 0.0001
}

fn main() -> i64 with Mut, Div, Panic {
    let o = hyp_origin()

    // (1) geodesic distance closed form: dist(o, [cosh r, sinh r, 0]) == r
    let r = 1.5
    let p = hyp_point(hyp_cosh(r), hyp_sinh(r), 0.0)
    if !approx(hyp_distance(o, p), r) { return 1 }

    // (2) symmetry, (3) identity
    if !approx(hyp_distance(o, p), hyp_distance(p, o)) { return 2 }
    if !approx(hyp_distance(p, p), 0.0) { return 3 }

    // (4) exp/log round-trip: q at distance 0.9 in a 3-4-5 spatial direction
    let sr = hyp_sinh(0.9)
    let q = hyp_point(hyp_cosh(0.9), sr * 0.6, sr * 0.8)
    let v = hyp_log(o, q)
    let q2 = hyp_exp(o, v)
    if !approx(q2.c[0], q.c[0]) { return 4 }
    if !approx(q2.c[1], q.c[1]) { return 5 }
    if !approx(q2.c[2], q.c[2]) { return 6 }

    // (5) |log_o(q)|_M == dist(o, q) == 0.9
    if !approx(hyp_tangent_norm(v), 0.9) { return 7 }

    // (6) curvature scaling: K = -1/4 (kappa = 2) halves the distance
    if !approx(hyp_distance_kappa(o, p, 2.0), r / 2.0) { return 8 }

    0
}
