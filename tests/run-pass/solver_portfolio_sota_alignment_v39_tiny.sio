//@ run-pass
//@ description: Tiny portfolio v39 smoke for solver/proof-checker SOTA alignment receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var alignment_fp: i64 = 409
    alignment_fp = mix(alignment_fp, 53646245, 2741)
    alignment_fp = mix(alignment_fp, 423305090, 2741)
    alignment_fp = mix(alignment_fp, 620031252, 2741)
    alignment_fp = mix(alignment_fp, 258927862, 2741)
    alignment_fp = mix(alignment_fp, 438043475, 2741)
    alignment_fp = mix(alignment_fp, 46718256, 2741)
    alignment_fp = mix(alignment_fp, 389121447, 2741)
    alignment_fp = mix(alignment_fp, 731723710, 2741)
    alignment_fp = mix(alignment_fp, 5, 2741)
    alignment_fp = mix(alignment_fp, 4, 2741)
    alignment_fp = mix(alignment_fp, 31, 2741)
    if alignment_fp != 74298281 { return 1 }

    var audit_fp: i64 = 419
    audit_fp = mix(audit_fp, alignment_fp, 2753)
    audit_fp = mix(audit_fp, 53646245, 2753)
    audit_fp = mix(audit_fp, 423305090, 2753)
    audit_fp = mix(audit_fp, 620031252, 2753)
    audit_fp = mix(audit_fp, 258927862, 2753)
    audit_fp = mix(audit_fp, 438043475, 2753)
    audit_fp = mix(audit_fp, 46718256, 2753)
    audit_fp = mix(audit_fp, 389121447, 2753)
    audit_fp = mix(audit_fp, 731723710, 2753)
    audit_fp = mix(audit_fp, 31, 2753)
    if audit_fp != 963677367 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 42, 1103)
    entry_fp = mix(entry_fp, alignment_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 42, 1103)
    if entry_fp != 528140838 { return 3 }

    if audit_fp == 963677368 { return 4 }
    return 0
}
