//@ run-pass
//@ expect-stdout-contains: heap_alloc_basic: PASS
//@ description: heap_alloc returns zeroed memory (mmap MAP_ANON), read_i64 verifies

fn main() -> i64 with IO, Alloc {
    var exit_fails: i64 = 0
    let p = heap_alloc(64)
    let a = read_i64(p, 0)
    let b = read_i64(p, 1)
    if a == 0 && b == 0 {
        print("heap_alloc_basic: PASS\n")
    } else {
        print("heap_alloc_basic: FAIL\n")
        exit_fails = exit_fails + 1
    }
    heap_free(p)
    if exit_fails > 0 {
        return 1
    }
    return 0
}
