//@ run-pass
//@ timeout: 300
// GPU GUM parity: kernel combine vs live ep28_run, bitwise.
// Rapamycin 5 mg IV bolus / 168 h and semaglutide 1 mg / 168 h.
// Plus K-AXI emitter text asserts, PTX f64 asserts, fail-closed.

use gpu::pbpk28_gum_kernel::*
use darwin_pbpk::epistemic_pbpk28::*
use darwin_pbpk::drugs::venlafaxine::*
use darwin_pbpk::drugs::midazolam::*
use darwin_pbpk::ddi::cyp3a_competitive::*
use darwin_pbpk::pgx::cyp2d6_venlafaxine::*
use darwin_pbpk::release::matrix_er::*
use gpu::kaxi_backend::*
use gpu::kaxi_to_ptx::*

fn str_contains(haystack: string, needle: string) -> bool with Mut, Panic, Div {
    let hlen = str_len(haystack)
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if hlen < nlen { return false }
    var i: i64 = 0
    while i <= (hlen - nlen) {
        var j: i64 = 0
        var ok: bool = true
        while j < nlen {
            if str_char_at(haystack, i + j) != str_char_at(needle, j) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    false
}

fn check_gum_case(dose_mg: f64, t_end: f64, use_sema: bool) -> i64 with IO, Mut, Div, Panic, Epistemic {
    var prm = ep28_rapamycin_params()
    var priors = ep28_rapamycin_priors()
    if use_sema {
        prm = ep28_semaglutide_params()
        priors = ep28_semaglutide_priors()
    }
    let ref = ep28_run(prm, priors, dose_mg, t_end)
    if !ref.success {
        print("FAIL gpu_gum case ep28_run failed\n")
        return 1
    }
    let cols = ep28_jacobian_columns(prm, priors, dose_mg, t_end)
    if !cols.ok {
        print("FAIL gpu_gum case columns failed\n")
        return 1
    }
    let vc = ep28_prior_vc(priors)
    let got = pbpk28_gum_combine_f64(cols.d_auc_b, cols.d_cb24, cols.d_auc_l, cols.d_auc_k, vc.0, vc.1)
    if !got.ok {
        print("FAIL gpu_gum case kernel combine failed\n")
        return 1
    }
    let got_main = gum_main_array(got)
    let fails = ep28_gum_parity_check(prm, priors, dose_mg, t_end, got_main, got.sensitivity)
    if fails != 0 {
        print("FAIL gpu_gum case bitwise mismatch\n")
    } else {
        if use_sema {
            print("gpu_gum semaglutide OK\n")
        } else {
            print("gpu_gum rapamycin OK\n")
        }
    }
    fails
}
fn check_gum_case_venla(dose_mg: f64, t_end: f64) -> i64 with IO, Mut, Div, Panic, Epistemic {
    // Venlafaxine XR 75 mg oral (Gohel 2008 matrix; Wang 2022 ka/F; Lessard
    // 1999 NM formation): oral input path + CYP2D6 formation sink, NM scope.
    let prm = ep28_venlafaxine_params()
    let priors = ep28_venlafaxine_priors()
    let oi = OralInputs28 { f_abs: venlafaxine_f_oral_xr(), ka: venlafaxine_ka_abs(), cl_form: vfx_cl_form_odv_nm() }
    let rel = venlafaxine_xr_matrix_gohel2008()
    let fu_ref = venlafaxine_fu_parent()
    // XR: dose starts in the matrix (gut0 = 0).
    let gut0 = 0.0
    let ref = ep28_run_oral(prm, priors, dose_mg, t_end, oi, rel, fu_ref, gut0)
    if !ref.success {
        print("FAIL gpu_gum case ep28_run_oral failed\n")
        return 1
    }
    let cols = ep28_jacobian_columns_oral(prm, priors, dose_mg, t_end, oi, rel, fu_ref, gut0)
    if !cols.ok {
        print("FAIL gpu_gum case columns_oral failed\n")
        return 1
    }
    let vc = ep28_prior_vc(priors)
    let got = pbpk28_gum_combine_f64(cols.d_auc_b, cols.d_cb24, cols.d_auc_l, cols.d_auc_k, vc.0, vc.1)
    if !got.ok {
        print("FAIL gpu_gum case kernel combine failed\n")
        return 1
    }
    let got_main = gum_main_array(got)
    let fails = ep28_gum_parity_check_oral(prm, priors, dose_mg, t_end, oi, rel, fu_ref, gut0, got_main, got.sensitivity)
    if fails != 0 {
        print("FAIL gpu_gum case bitwise mismatch\n")
    } else {
        print("gpu_gum venlafaxine OK\n")
    }
    fails
}
fn check_gum_case_midaz(dose_mg: f64, t_end: f64) -> i64 with IO, Mut, Div, Panic, Epistemic {
    // Midazolam IR 5 mg oral (Heizmann 1984; Smith 1981; Thummel 1996;
    // Olkkola 1994): immediate-release input path + CYP3A hepatic sink, NM
    // scope. The oral input path perturbs like venlafaxine XR: dim 0 the
    // CYP3A liver formation sink, dim 2 cl_central scaled by the drug's own
    // fu reference.
    let prm = ep28_midazolam_params()
    let priors = ep28_midazolam_priors()
    let sub = midazolam_cyp3a_substrate()
    let ka = midazolam_absorption_params().ka
    let oi = OralInputs28 { f_abs: cyp3a_f_oral(sub, 1.0), ka: ka, cl_form: 0.0 }
    // IR: the dose starts in the gut; the release model is empty (total dose
    // 0, so KP releases nothing regardless of k/n).
    let rel = matrix_korsmeyer_peppas(0.0, 0.199, 0.65)
    let fu_ref = 0.03
    let gut0 = dose_mg
    let ref = ep28_run_oral(prm, priors, dose_mg, t_end, oi, rel, fu_ref, gut0)
    if !ref.success {
        print("FAIL gpu_gum case ep28_run_oral failed\n")
        return 1
    }
    let cols = ep28_jacobian_columns_oral(prm, priors, dose_mg, t_end, oi, rel, fu_ref, gut0)
    if !cols.ok {
        print("FAIL gpu_gum case columns_oral failed\n")
        return 1
    }
    let vc = ep28_prior_vc(priors)
    let got = pbpk28_gum_combine_f64(cols.d_auc_b, cols.d_cb24, cols.d_auc_l, cols.d_auc_k, vc.0, vc.1)
    if !got.ok {
        print("FAIL gpu_gum case kernel combine failed\n")
        return 1
    }
    let got_main = gum_main_array(got)
    let fails = ep28_gum_parity_check_oral(prm, priors, dose_mg, t_end, oi, rel, fu_ref, gut0, got_main, got.sensitivity)
    if fails != 0 {
        print("FAIL gpu_gum case bitwise mismatch\n")
    } else {
        print("gpu_gum midazolam OK\n")
    }
    fails
}
fn check_gum_case_halo(dose_mg: f64, t_end: f64) -> i64 with IO, Mut, Div, Panic, Epistemic {
    // Haloperidol IR 5 mg oral (Forsman 1977; Haase 1981; Loryan 2014):
    // immediate-release input path + CYP3A4/2D6 hepatic sink, NM scope.
    // BBB/D2 identity resolved, not deferred: Kp_brain = 15 (PBPK14
    // Rodgers-Rowland, lysosomal accumulation) carries the BBB phenotype,
    // and the therapeutic endpoint is wired as a receipt readout off the
    // parity-checked AUC: ISF_free,avg = Kpuu × fu × AUC_blood/t_end
    // (Kpuu = 3.0 Loryan 2014 — the same AUC-based Kpuu the oral BBB trace
    // and pbpk28-parity cases 14-16 check; rb = 1 so blood = plasma) →
    // inline d2_occupancy mirror (Kd 1.5 nM Seeman 1976; window 60-80%
    // Farde 1992). Full 9-dim BBB+D2 GUM lives in pd/d2_gum.sio;
    // chronic-window validation in validation/haloperidol_d2_pet.sio.
    // This arm asserts only the wiring (0 < occ < 1, fail-closed) plus
    // the bitwise parity.
    let prm = ep28_haloperidol_params()
    let priors = ep28_haloperidol_priors()
    // Absorption scalars inlined (NOT via drugs::haloperidol readers):
    // importing that module pulls struct types (BBBParams/BBBPriors/...) into
    // this parity binary, and any new struct type flips unrelated f64 results
    // (Madaros codegen hazard, issue filed). Values mirror the readers:
    // ka = 0.9/h, F = 0.65 (Forsman 1977; Froemming 1989).
    let oi = OralInputs28 { f_abs: 0.65, ka: 0.9, cl_form: 0.0 }
    // IR: the dose starts in the gut; the release model is empty (total dose
    // 0, so KP releases nothing regardless of k/n).
    let rel = matrix_korsmeyer_peppas(0.0, 0.199, 0.65)
    let fu_ref = 0.08
    let gut0 = dose_mg
    let ref = ep28_run_oral(prm, priors, dose_mg, t_end, oi, rel, fu_ref, gut0)
    if !ref.success {
        print("FAIL gpu_gum case ep28_run_oral failed\n")
        return 1
    }
    let cols = ep28_jacobian_columns_oral(prm, priors, dose_mg, t_end, oi, rel, fu_ref, gut0)
    if !cols.ok {
        print("FAIL gpu_gum case columns_oral failed\n")
        return 1
    }
    let vc = ep28_prior_vc(priors)
    let got = pbpk28_gum_combine_f64(cols.d_auc_b, cols.d_cb24, cols.d_auc_l, cols.d_auc_k, vc.0, vc.1)
    if !got.ok {
        print("FAIL gpu_gum case kernel combine failed\n")
        return 1
    }
    let got_main = gum_main_array(got)
    let fails = ep28_gum_parity_check_oral(prm, priors, dose_mg, t_end, oi, rel, fu_ref, gut0, got_main, got.sensitivity)
    if fails != 0 {
        print("FAIL gpu_gum case bitwise mismatch\n")
        return fails
    }
    // D2 receipt: mean ISF-free from the parity-checked AUC via the Kpuu
    // bridge, then competitive-binding occupancy occ = c/(c+Kd), Kd =
    // 0.000564 mg/L (1.5 nM Seeman 1976). Inlined rather than calling
    // pd::d2_occupancy (same struct-type codegen hazard as above; canonical
    // module + window validation live in pd/d2_occupancy.sio and
    // validation/haloperidol_d2_pet.sio). Fixed-string band receipt
    // (the mold prints no floats); window 60-80% Farde 1992.
    let c_isf_free_avg = 3.0 * 0.08 * ref.auc_blood_mean / t_end
    let occ = c_isf_free_avg / (c_isf_free_avg + 0.000564)
    if !(occ > 0.0 && occ < 1.0) {
        print("FAIL gpu_gum haloperidol D2 wiring\n")
        return 1
    }
    if occ >= 0.60 && occ < 0.80 {
        print("gpu_gum haloperidol D2 window\n")
    } else {
        if occ >= 0.80 {
            print("gpu_gum haloperidol D2 eps\n")
        } else {
            print("gpu_gum haloperidol D2 subtherapeutic\n")
        }
    }
    print("gpu_gum haloperidol OK\n")
    fails
}
fn gum_main_array(got: GumCombineOut) -> [f64; 8] with Mut {
    var got_main: [f64; 8] = [0.0; 8]
    got_main[0] = got.var_auc_b
    got_main[1] = got.var_cb24
    got_main[2] = got.var_auc_l
    got_main[3] = got.var_auc_k
    got_main[4] = got.auc_blood_conf
    got_main[5] = got.kp_share_brain
    got_main[6] = got.kp_share_liver
    got_main[7] = got.kp_share_kidney
    got_main
}
fn check_gum_sabotage() -> i64 with IO, Mut, Div, Panic, Epistemic {
    var fails: i64 = 0
    var prm = ep28_rapamycin_params()
    var priors = ep28_rapamycin_priors()
    let cols = ep28_jacobian_columns(prm, priors, 5.0, 168.0)
    if !cols.ok {
        print("FAIL gpu_gum sabotage setup\n")
        return 1
    }
    let vc = ep28_prior_vc(priors)
    let got = pbpk28_gum_combine_f64(cols.d_auc_b, cols.d_cb24, cols.d_auc_l, cols.d_auc_k, vc.0, vc.1)
    if !got.ok {
        print("FAIL gpu_gum sabotage setup\n")
        return 1
    }
    let base = gum_main_array(got)
    var bad = base
    bad[2] = bad[2] + 1.0
    let f1 = ep28_gum_parity_check(prm, priors, 5.0, 168.0, bad, got.sensitivity)
    if f1 == 0 {
        print("FAIL gpu_gum sabotage main survived\n")
        fails = fails + 1
    }
    var bads = got.sensitivity
    bads[5] = bads[5] + 1.0
    let f2 = ep28_gum_parity_check(prm, priors, 5.0, 168.0, base, bads)
    if f2 == 0 {
        print("FAIL gpu_gum sabotage sens survived\n")
        fails = fails + 1
    }
    if fails == 0 {
        print("gpu_gum sabotage OK\n")
    }
    fails
}

fn check_gum_emitter() -> i64 with IO, Mut, Panic, Div, Alloc {
    var fails: i64 = 0
    let asm = kaxi_emit_pbpk28_gum_contrib_f64_asm()
    let text = kaxi_asm_to_string(&asm)
    if !str_contains(text, "load_global") { fails = fails + 1 }
    if !str_contains(text, "store_global") { fails = fails + 1 }
    if !str_contains(text, "mul") { fails = fails + 1 }
    if !str_contains(text, "type=f64") { fails = fails + 1 }
    if !str_contains(text, "ret") { fails = fails + 1 }
    let ptx = kaxi_transpile_to_ptx_unified(&asm, 0)
    if !str_contains(ptx, "ld.global.f64") { fails = fails + 1 }
    if !str_contains(ptx, "st.global.f64") { fails = fails + 1 }
    if fails != 0 {
        print("FAIL gpu_gum emitter text\n")
    } else {
        print("gpu_gum emitter OK\n")
    }
    fails
}

fn check_gum_fail_closed() -> i64 with IO, Mut, Div, Panic {
    var fails: i64 = 0
    var d: [f64; 8] = [1.0; 8]
    var v: [f64; 8] = [0.5; 8]
    var c: [f64; 8] = [0.9; 8]
    var bad = d
    bad[3] = 0.0 / 0.0
    let r1 = pbpk28_gum_combine_f64(bad, d, d, d, v, c)
    if r1.ok { fails = fails + 1 }
    var negv = v
    negv[5] = 0.0 - 1.0
    let r2 = pbpk28_gum_combine_f64(d, d, d, d, negv, c)
    if r2.ok { fails = fails + 1 }
    var zerov: [f64; 8] = [0.0; 8]
    let r3 = pbpk28_gum_combine_f64(d, d, d, d, zerov, c)
    if !r3.ok { fails = fails + 1 }
    if r3.var_auc_b != 0.0 { fails = fails + 1 }
    if fails != 0 {
        print("FAIL gpu_gum fail-closed\n")
    } else {
        print("gpu_gum failclosed OK\n")
    }
    fails
}

fn check_gum_batched_emitter() -> i64 with IO, Mut, Panic, Div, Alloc {
    var fails: i64 = 0
    let asm = kaxi_emit_pbpk28_gum_contrib_batched_asm()
    let text = kaxi_asm_to_string(&asm)
    if !str_contains(text, "get_tid") { fails = fails + 1 }
    if !str_contains(text, "div") { fails = fails + 1 }
    if !str_contains(text, "load_global") { fails = fails + 1 }
    if !str_contains(text, "store_global") { fails = fails + 1 }
    if !str_contains(text, "mul") { fails = fails + 1 }
    if !str_contains(text, "type=f64") { fails = fails + 1 }
    if !str_contains(text, "ret") { fails = fails + 1 }
    if str_contains(text, "nop") { fails = fails + 1 }
    let ptx = kaxi_transpile_to_ptx_unified(&asm, 0)
    if !str_contains(ptx, "mov.u32 %r1, %tid.x") { fails = fails + 1 }
    if !str_contains(ptx, "div.s64") { fails = fails + 1 }
    if !str_contains(ptx, "ld.global.f64") { fails = fails + 1 }
    if !str_contains(ptx, "st.global.f64") { fails = fails + 1 }
    if !str_contains(ptx, "mul.f64") { fails = fails + 1 }
    if fails != 0 {
        print("FAIL gpu_gum batched emitter")
    } else {
        print("gpu_gum batched emitter OK")
    }
    fails
}
fn main() -> i64 with IO, Mut, Div, Panic, Alloc, Epistemic {
    var fails: i64 = 0
    fails = fails + check_gum_case(5.0, 168.0, false)
    fails = fails + check_gum_case(1.0, 168.0, true)
    fails = fails + check_gum_case_venla(75.0, 168.0)
    fails = fails + check_gum_case_midaz(5.0, 168.0)
    fails = fails + check_gum_case_halo(5.0, 72.0)
    fails = fails + check_gum_emitter()
    fails = fails + check_gum_fail_closed()
    fails = fails + check_gum_sabotage()
    fails = fails + check_gum_batched_emitter()
    if fails == 0 {
        print("PASS gpu_pbpk28_gum_parity\n")
    } else {
        print("FAIL gpu_pbpk28_gum_parity\n")
    }
    fails
}
