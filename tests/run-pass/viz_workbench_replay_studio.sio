// tests/run-pass/viz_workbench_replay_studio.sio - Workbench replay with Molecule Studio
//
// Expected output:
//   VIZ_WORKBENCH_REPLAY_STUDIO_PASS

use display::canvas::{Canvas}
use display::event::{Event, EV_KEY_PRESS, EV_MOUSE_PRESS, EV_MOTION, KEY_RIGHT, MOUSE_LEFT}
use viz::audit::{viz_audit_hash}
use viz::ir::{VizScene, viz_scene_new}
use viz::molecule_editor::{viz_molecule_atom_count}
use viz::workbench::{
    VizWorkbenchIds, viz_workbench_app_handle_event, viz_workbench_build_scene,
    viz_workbench_constraint,
}
use viz::viz_app::{VizApp, viz_app_frame_hash, viz_app_new}
use viz::viz_replay::{
    VizReplayTrace, viz_replay_present, viz_replay_record, viz_replay_trace_new,
}

fn ev(kind: i64, key: i64, x: i64, y: i64) -> Event {
    Event { kind: kind, key: key, x: x, y: y, mods: 0 }
}

fn make_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pix = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pix, width: w, height: h }
}

fn center_x(x: i64, w: i64) -> i64 {
    x + w / 2
}

fn center_y(y: i64, h: i64) -> i64 {
    y + h / 2
}

fn replay_workbench(app: &!VizApp, scene: &!VizScene, ids: &VizWorkbenchIds, canvas: &!Canvas, events: &[Event; 32], count: i64) -> VizReplayTrace with Mut, Div, Alloc {
    var trace = viz_replay_trace_new()
    var constraint = viz_workbench_constraint(ids)
    let none = ev(0, 0, 0, 0)
    var last_hash = viz_replay_present(app, scene, canvas)
    viz_replay_record(&!trace, app, scene, none, true, last_hash)
    var i: i64 = 0
    while i < count && i < 32 {
        let e = events[i as usize]
        let changed = viz_workbench_app_handle_event(app, scene, &!constraint, e)
        last_hash = viz_replay_present(app, scene, canvas)
        viz_replay_record(&!trace, app, scene, e, changed, last_hash)
        i = i + 1
    }
    trace
}

fn main() with IO, Alloc, Mut, Div {
    var scene = viz_scene_new()
    let ids = viz_workbench_build_scene(&!scene)
    var app = viz_app_new(10, 13, 18)
    var canvas = make_canvas(480, 320)
    var events: [Event; 32] = [ev(0, 0, 0, 0); 32]

    let atom1_x = 443
    let atom1_y = 72
    let add_x = scene.nodes[ids.molecule as usize].layout.x + scene.nodes[ids.molecule as usize].layout.w / 2
    let add_y = scene.nodes[ids.molecule as usize].layout.y + scene.nodes[ids.molecule as usize].layout.h / 2 + 21

    events[0] = ev(EV_MOUSE_PRESS, MOUSE_LEFT, 46, 238)
    events[1] = ev(EV_MOTION, 0, 101, 238)
    events[2] = ev(
        EV_MOUSE_PRESS, MOUSE_LEFT,
        center_x(scene.nodes[ids.studio_atom as usize].layout.x, scene.nodes[ids.studio_atom as usize].layout.w),
        center_y(scene.nodes[ids.studio_atom as usize].layout.y, scene.nodes[ids.studio_atom as usize].layout.h),
    )
    events[3] = ev(EV_MOUSE_PRESS, MOUSE_LEFT, add_x, add_y)
    events[4] = ev(
        EV_MOUSE_PRESS, MOUSE_LEFT,
        center_x(scene.nodes[ids.studio_move as usize].layout.x, scene.nodes[ids.studio_move as usize].layout.w),
        center_y(scene.nodes[ids.studio_move as usize].layout.y, scene.nodes[ids.studio_move as usize].layout.h),
    )
    events[5] = ev(EV_MOUSE_PRESS, MOUSE_LEFT, atom1_x, atom1_y)
    events[6] = ev(EV_KEY_PRESS, KEY_RIGHT, 0, 0)

    let trace = replay_workbench(&!app, &!scene, &ids, &!canvas, &events, 7)
    let last = trace.count - 1

    assert(trace.count == 8)
    assert(trace.frames[last as usize].canvas_hash != trace.frames[0].canvas_hash)
    assert(trace.frames[last as usize].audit_hash == viz_audit_hash(&scene))
    assert(trace.frames[last as usize].time_i == 5)
    assert(trace.frames[last as usize].event_key == KEY_RIGHT)
    assert(trace.frames[3].event_x == center_x(scene.nodes[ids.studio_atom as usize].layout.x, scene.nodes[ids.studio_atom as usize].layout.w))
    assert(viz_molecule_atom_count(&scene, ids.molecule) == 4)
    assert(scene.molecule_tool == 2)
    assert(scene.molecule_timeline_count >= 3)
    assert(scene.molecule_accept_count >= 3)
    assert(scene.molecule_reject_count == 0)
    assert(app.frame == 8)
    assert(!app.dirty)
    assert(viz_app_frame_hash(&app, &scene, &canvas) == trace.frames[last as usize].canvas_hash)

    heap_free(canvas.pixels as *mut i8)
    println("VIZ_WORKBENCH_REPLAY_STUDIO_PASS")
}
