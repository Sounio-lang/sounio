//@ run-pass
//@ expect-stdout-contains: NESTED_MATCH_OUTER_EXHAUSTIVE_PASS

enum Outer {
    First,
    Second,
    Third,
}

enum Inner {
    Left,
    Right,
}

fn classify(outer: Outer, inner: Inner) -> i64 {
    match outer {
        Outer::First => {
            match inner {
                Inner::Left => 1,
                Inner::Right => 2,
            }
        }
        Outer::Second => 3,
        Outer::Third => 4,
    }
}

fn main() -> i64 with IO {
    if classify(Outer::First, Inner::Right) != 2 { return 1 }
    if classify(Outer::Second, Inner::Left) != 3 { return 2 }
    if classify(Outer::Third, Inner::Left) != 4 { return 3 }
    print("NESTED_MATCH_OUTER_EXHAUSTIVE_PASS\n")
    0
}
