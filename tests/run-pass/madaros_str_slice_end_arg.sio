//@ run-pass
//@ requires: madaros
// #2244 -- str_slice(s, start, end) discarded end under Madaros and returned the
// whole suffix from start. lean_single dispatches on arity while parsing, so it
// was always right and the full suite (stage2 = lean_single) could never catch
// this; requires: madaros is what makes the fixture a guard.
//
// Exit code is the number of failing cases, so a regression is rc != 0.

fn expect_str(label: string, got: string, want: string) -> i64 with IO, Mut, Div, Panic {
    print(label)
    print("=")
    print(got)
    if str_eq(got, want) {
        println(" ok")
        return 0
    }
    print(" WANT ")
    println(want)
    1
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var bad = 0
    bad = bad + expect_str("slice", str_slice("0123456789", 2, 5), "234")
    bad = bad + expect_str("char", str_slice("abcdefghijklmnopqrstuvwxyz", 2, 3), "c")
    bad = bad + expect_str("dir", str_slice("stdlib/net/tcp.sio", 0, 10), "stdlib/net")
    bad = bad + expect_str("empty", str_slice("hello", 2, 2), "")
    bad = bad + expect_str("full", str_slice("hello", 0, 5), "hello")
    bad = bad + expect_str("head", str_slice("hello", 0, 1), "h")

    // The 3-arg result must be a fresh copy, not a view: an earlier slice must
    // survive a later one.
    let a = str_slice("0123456789", 2, 5)
    let b = str_slice("0123456789", 6, 9)
    bad = bad + expect_str("first_after_second", a, "234")
    bad = bad + expect_str("second", b, "678")

    // The 2-argument spelling is specified (STR_SLICE.md) and must keep
    // returning the suffix pointer. It has no callers in-tree, which is exactly
    // why making the one stub 3-arg-only would have gone unnoticed.
    bad = bad + expect_str("suffix", str_slice("hello", 1), "ello")
    bad = bad + expect_str("suffix0", str_slice("hello", 0), "hello")

    print("len=")
    print_int(str_len(str_slice("hello", 1, 4)))
    if str_len(str_slice("hello", 1, 4)) == 3 { println(" ok") } else {
        println(" WANT 3")
        bad = bad + 1
    }

    print("bad=")
    print_int(bad)
    println("")
    bad
}
