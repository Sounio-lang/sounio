//@ run-pass
//@ expect-stdout: angle suffix: PASS
// The <unit> form on a numeric literal, which clinical units need because their
// names contain underscores: mg_dL, mmol_L, U_L, mm_h. The equivalent test in
// tests/frontend/ is outside the suite discovery globs and never runs here.

unit mg_dL;

fn takes_glucose(x: mg_dL) -> f64 with Mut {
    return x
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let glucose = 140.0<mg_dL>
    let checked = takes_glucose(glucose)
    if checked == 140.0 {
        print("angle suffix: PASS\n")
    }
    return 0
}
