//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v30 smoke for Erdős/Hadwiger-Nelson scope audit

use theorem::portfolio::*

fn main() -> i64 {
    let scope_audit_fp = solver_portfolio_v30_erdos_scope_audit_fingerprint(
        37553010, 0, 508, 90, 15)
    if scope_audit_fp != 180094659 { return 1 }

    let manifest_fp = solver_portfolio_v30_erdos_scope_audit_bundle_fingerprint(
        37553010, scope_audit_fp)
    if manifest_fp != 856410103 { return 2 }

    let result_fp = solver_portfolio_v30_result_coverage_fingerprint(
        30, 34, 10, 22, 1, 1, manifest_fp)
    if result_fp != 586508146 { return 3 }

    let family_fp = solver_portfolio_v30_checker_family_coverage_fingerprint(
        30, 34, 6, 3, 2, 2, 21, manifest_fp)
    if family_fp != 938241679 { return 4 }

    let acceptance_fp = solver_portfolio_v30_acceptance_receipt_fingerprint(
        30, manifest_fp, result_fp)
    if acceptance_fp != 909830054 { return 5 }

    let audit_fp = solver_portfolio_v30_audit_receipt_fingerprint(
        30, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_fp != 703699366 { return 6 }

    let readiness_fp = solver_portfolio_v30_readiness_fingerprint(
        30, manifest_fp, result_fp, family_fp, acceptance_fp, audit_fp)
    if readiness_fp != 742145517 { return 7 }

    if solver_portfolio_v30_erdos_scope_audit_fingerprint(
        37553010, 1, 508, 90, 15) != (0 - 1) { return 8 }
    if solver_portfolio_v30_result_coverage_fingerprint(
        30, 34, 11, 21, 1, 1, manifest_fp) != (0 - 1) { return 9 }

    return 0
}
