        let dc = absd(cos(x) - cs[i])
        if dc > d { d = dc }
        if absd(x) <= 10.0 {
            if d > worst_small { worst_small = d }
            if d > 1.0e-15 { bad = bad + 1 }
        } else {
            if d > worst_large { worst_large = d }
            if d > 1.0e-14 { bad = bad + 1 }
        }
        i = i + 1
    }
    print("worst abs err |x|<=10: "); println(worst_small * 1.0e16)
    print("worst abs err |x|<=200: "); println(worst_large * 1.0e16)
    if bad != 0 { print_int(bad); println(" points out of bound"); return 1 }
    println("BUILTIN_TRIG_DOUBLE_PRECISION_OK")
    0
}
