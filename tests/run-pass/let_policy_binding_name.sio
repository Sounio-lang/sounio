//@ run-pass
//@ expect-stdout: LET_POLICY_BINDING_OK
// `policy` remains a declaration keyword and is contextual in local binding use.
struct PolicyBindingPayload {
    value: i32,
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let policy = PolicyBindingPayload { value: 42 }
    let copied = policy.value
    if copied != 42 {
        println("FAIL: policy as expression")
        return 1
    }
    println("LET_POLICY_BINDING_OK")
    return policy.value - 42
}
