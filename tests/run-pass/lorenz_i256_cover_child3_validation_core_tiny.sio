//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-3 local validation core receipt

fn child3_validation_core_check(
    child3_local_flowpipe_preflight_fp: i64,
    child3_local_flowpipe_preflight_audit_fp: i64,
    child3_obligation_seed_fp: i64,
    child3_obligation_seed_audit_fp: i64,
    child2_validation_core_fp: i64,
    child2_validation_core_audit_fp: i64,
    five_step_local_flowpipe_chain_fp: i64,
    five_step_local_flowpipe_chain_audit_fp: i64,
    child_index: i64,
    slot_x: i64,
    slot_y: i64,
    slot_z: i64,
    global_flowpipe_claim_mask: i64,
    validation_status: i64) -> i64 {
    if child3_local_flowpipe_preflight_fp != 730124563 { return 0 - 1 }
    if child3_local_flowpipe_preflight_audit_fp != 713941204 { return 0 - 1 }
    if child3_obligation_seed_fp != 853502997 { return 0 - 1 }
    if child3_obligation_seed_audit_fp != 176202003 { return 0 - 1 }
    if child2_validation_core_fp != 173471211 { return 0 - 1 }
    if child2_validation_core_audit_fp != 173431050 { return 0 - 1 }
    if five_step_local_flowpipe_chain_fp != 911209450 { return 0 - 1 }
    if five_step_local_flowpipe_chain_audit_fp != 709377850 { return 0 - 1 }
    if child_index != 3 { return 0 - 1 }
    if slot_x != 1 { return 0 - 1 }
    if slot_y != 1 { return 0 - 1 }
    if slot_z != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if validation_status != 70 { return 0 - 1 }
    return 686090643
}

fn main() -> i64 {
    let artifact = child3_validation_core_check(
        730124563, 713941204, 853502997, 176202003, 173471211, 173431050,
        911209450, 709377850, 3, 1, 1, 0, 0, 70)
    if artifact != 686090643 { return 1 }

    let audit_fp: i64 = 159869521
    let instance_fp: i64 = 516858439
    let certificate_fp: i64 = 931250157
    let selected_child_mask: i64 = 8
    let prior_child_validated_mask: i64 = 7
    let child_validated_mask: i64 = 15
    let pending_child_validation_mask: i64 = 16
    let child_axis_readiness_mask: i64 = 7
    let local_flowpipe_preflight_mask: i64 = 31
    let local_flowpipe_proof_mask: i64 = 31
    let proof_dependency_mask: i64 = 31
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0
    let validation_status: i64 = 70
    let ok_mask: i64 = 255

    if audit_fp != 159869521 { return 2 }
    if instance_fp != 516858439 { return 3 }
    if certificate_fp != 931250157 { return 4 }
    if selected_child_mask != 8 { return 5 }
    if prior_child_validated_mask != 7 { return 6 }
    if child_validated_mask != 15 { return 7 }
    if pending_child_validation_mask != 16 { return 8 }
    if child_axis_readiness_mask != 7 { return 9 }
    if local_flowpipe_preflight_mask != 31 { return 10 }
    if local_flowpipe_proof_mask != 31 { return 11 }
    if proof_dependency_mask != 31 { return 12 }
    if child_discharge_mask != 0 { return 13 }
    if global_cover_certificate_mask != 0 { return 14 }
    if global_flowpipe_claim_mask != 0 { return 15 }
    if validation_status != 70 { return 16 }
    if ok_mask != 255 { return 17 }

    let wrong_preflight = child3_validation_core_check(
        1, 713941204, 853502997, 176202003, 173471211, 173431050,
        911209450, 709377850, 3, 1, 1, 0, 0, 70)
    if wrong_preflight != 0 - 1 { return 18 }

    let wrong_child = child3_validation_core_check(
        730124563, 713941204, 853502997, 176202003, 173471211, 173431050,
        911209450, 709377850, 2, 1, 1, 0, 0, 70)
    if wrong_child != 0 - 1 { return 19 }

    let overclaim = child3_validation_core_check(
        730124563, 713941204, 853502997, 176202003, 173471211, 173431050,
        911209450, 709377850, 3, 1, 1, 0, 1, 70)
    if overclaim != 0 - 1 { return 20 }

    return 0
}
