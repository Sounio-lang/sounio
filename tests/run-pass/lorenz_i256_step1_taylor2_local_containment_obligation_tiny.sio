//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-1 Taylor-2 local containment obligation preserves local-only scope

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    let x_radius: i64 = 1
    let y_radius: i64 = 260001
    let z_radius: i64 = 16667
    let x_lte: i64 = 26877
    let y_lte: i64 = 35700
    let z_lte: i64 = 3902
    let x_need: i64 = x_radius + x_lte
    let y_need: i64 = y_radius + y_lte
    let z_need: i64 = z_radius + z_lte
    let x_margin: i64 = 27000
    let y_margin: i64 = 296000
    let z_margin: i64 = 21000
    let x_slack: i64 = x_margin - x_need
    let y_slack: i64 = y_margin - y_need
    let z_slack: i64 = z_margin - z_need

    var axis_mask: i64 = 0
    if x_need <= x_margin { axis_mask = axis_mask + 1 }
    if y_need <= y_margin { axis_mask = axis_mask + 2 }
    if z_need <= z_margin { axis_mask = axis_mask + 4 }
    if axis_mask != 7 { return 1 }
    if x_slack != 122 { return 2 }
    if y_slack != 299 { return 3 }
    if z_slack != 431 { return 4 }

    var inst: i64 = 1433
    inst = mix(inst, 1, 5231)
    inst = mix(inst, 737436919, 5231)
    inst = mix(inst, 387055804, 5231)
    inst = mix(inst, 815221512, 5231)
    inst = mix(inst, 981617998, 5231)
    inst = mix(inst, 620127047, 5231)
    inst = mix(inst, 133154696, 5231)
    inst = mix(inst, 265853299, 5231)
    inst = mix(inst, 2, 5231)
    inst = mix(inst, 1000000, 5231)
    inst = mix(inst, 1, 5231)
    inst = mix(inst, 100, 5231)
    inst = mix(inst, x_radius, 5231)
    inst = mix(inst, y_radius, 5231)
    inst = mix(inst, z_radius, 5231)
    inst = mix(inst, x_lte, 5231)
    inst = mix(inst, y_lte, 5231)
    inst = mix(inst, z_lte, 5231)
    inst = mix(inst, x_need, 5231)
    inst = mix(inst, y_need, 5231)
    inst = mix(inst, z_need, 5231)
    inst = mix(inst, x_margin, 5231)
    inst = mix(inst, y_margin, 5231)
    inst = mix(inst, z_margin, 5231)
    inst = mix(inst, x_slack, 5231)
    inst = mix(inst, y_slack, 5231)
    inst = mix(inst, z_slack, 5231)
    inst = mix(inst, axis_mask, 5231)
    inst = mix(inst, 7, 5231)
    inst = mix(inst, 0, 5231)
    inst = mix(inst, 12, 5231)
    if inst != 220504517 { return 5 }

    var cert: i64 = 1439
    cert = mix(cert, inst, 5233)
    cert = mix(cert, x_radius, 5233)
    cert = mix(cert, y_radius, 5233)
    cert = mix(cert, z_radius, 5233)
    cert = mix(cert, x_lte, 5233)
    cert = mix(cert, y_lte, 5233)
    cert = mix(cert, z_lte, 5233)
    cert = mix(cert, x_need, 5233)
    cert = mix(cert, y_need, 5233)
    cert = mix(cert, z_need, 5233)
    cert = mix(cert, x_margin, 5233)
    cert = mix(cert, y_margin, 5233)
    cert = mix(cert, z_margin, 5233)
    cert = mix(cert, x_slack, 5233)
    cert = mix(cert, y_slack, 5233)
    cert = mix(cert, z_slack, 5233)
    cert = mix(cert, axis_mask, 5233)
    cert = mix(cert, 7, 5233)
    cert = mix(cert, 0, 5233)
    cert = mix(cert, 12, 5233)
    cert = mix(cert, 255, 5233)
    if cert != 778022451 { return 6 }

    var artifact: i64 = 1447
    artifact = mix(artifact, inst, 5237)
    artifact = mix(artifact, cert, 5237)
    artifact = mix(artifact, 13, 5237)
    artifact = mix(artifact, 1, 5237)
    artifact = mix(artifact, axis_mask, 5237)
    artifact = mix(artifact, 7, 5237)
    artifact = mix(artifact, 0, 5237)
    artifact = mix(artifact, 12, 5237)
    artifact = mix(artifact, 255, 5237)
    if artifact != 473585568 { return 7 }

    var audit: i64 = 1451
    audit = mix(audit, artifact, 5261)
    audit = mix(audit, inst, 5261)
    audit = mix(audit, cert, 5261)
    audit = mix(audit, 737436919, 5261)
    audit = mix(audit, 387055804, 5261)
    audit = mix(audit, 815221512, 5261)
    audit = mix(audit, 981617998, 5261)
    audit = mix(audit, 620127047, 5261)
    audit = mix(audit, 133154696, 5261)
    audit = mix(audit, 265853299, 5261)
    audit = mix(audit, 1, 5261)
    audit = mix(audit, 12, 5261)
    audit = mix(audit, 255, 5261)
    if audit != 790380830 { return 8 }

    return 0
}
