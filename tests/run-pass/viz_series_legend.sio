//@ run-pass
//@ expect-stdout: SERIES_LEGEND_PASS
//@ expect-stdout: OBS&lt;&amp;&quot;
//@ expect-stdout: textLength="16"
use display::canvas::{Canvas,canvas_clear}
use viz::legend::{legend_layout}
use viz::ir::{viz_scene_new,viz_add_line_chart,viz_add_series_legend,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
fn main() with IO, Mut, Div, Alloc, Panic {
    let plan=legend_layout(40,130,200,20,6)
    assert(plan.status == 0 && plan.swatch_x == 44 && plan.swatch_y == 137)
    assert(plan.text_x == 60 && plan.text_y == 136 && plan.visible_len == 6)
    assert(legend_layout(0,0,40,20,6).visible_len == 2)
    assert(legend_layout(0,0,23,20,6).status == 1)
    assert(legend_layout(0,0,200,20,65).status == 1)
    var xs:[f64;1024]=[0.0;1024]
    var ys:[f64;1024]=[0.0;1024]
    xs[1]=1.0;ys[1]=1.0
    var scene=viz_scene_new()
    let chart=viz_add_line_chart(&!scene,&xs,&ys,2,viz_layout_rect(40,30,200,80),viz_style_rgb(255,0,0))
    var text:[i8;64]=[0;64]
    text[0]=79;text[1]=66;text[2]=83;text[3]=60;text[4]=38;text[5]=34
    let legend=viz_add_series_legend(&!scene,chart,&text,6,viz_layout_rect(40,130,200,20))
    assert(legend == 1 && scene.nodes[1].style.r == 255)
    let short=viz_add_series_legend(&!scene,chart,&text,6,viz_layout_rect(250,130,40,20))
    assert(short == 2 && scene.nodes[2].label_len == 6)
    let invalid=viz_add_series_legend(&!scene,chart,&text,6,viz_layout_rect(0,0,23,20))
    assert(invalid == -1 && scene.node_count == 3)
    text[0]=10
    let nonascii=viz_add_series_legend(&!scene,chart,&text,6,viz_layout_rect(0,0,200,20))
    assert(nonascii == -1 && scene.node_count == 3)
    let pixels=heap_alloc(320*160*8) as *mut i64
    var canvas=Canvas {pixels:pixels,width:320,height:160}
    canvas_clear(&!canvas,0,0,0)
    viz_canvas_render_scene(&scene,&!canvas)
    assert(read_i64(canvas.pixels,137*320+44) == 16711680)
    assert(read_i64(canvas.pixels,137*320+61) == 16711680)
    viz_html_emit_scene(&scene,320,160)
    println("SERIES_LEGEND_PASS")
    0
}
