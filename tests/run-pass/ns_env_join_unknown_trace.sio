//@ run-pass
//@ requires: madaros
//@ expect-stdout: ns-env-join-unknown: PASS
//
// N2 negative control (codex ruling 2026-08-23, round 3): a branch that
// reassigns x to an ALREADY-top value must still force x to top at the
// merge -- this exercises "any incoming top => top" for env bindings (the
// binding-level counterpart of REQ-4, which already covers this for
// expression RESULTS via ns_union). mystery() has ZERO parameters, so it is
// never a call-projection (the arity-1 restriction, see
// ns_call_projection_top_trace.sio) regardless of its body -- calling it
// always yields top at the call site.
//
// Observable proof, same end-to-end shape as the other two env-join
// controls: `x + w3` after the if unions x's POST-merge type with an empty
// set; "union=-1" is the proof.
//
// Per-rule sabotage: SOUNIO_NS_SABOTAGE_JOIN=1 reproduces the pre-fix bug --
// x reverts to its pre-if handle (a REAL, non-top handle), so the trailing
// union is real too, instead of -1.

fn mystery() -> Knowledge[f64, epsilon < 1.0] with IO {
    Knowledge(0.0, ε = 0.05)
}

fn main() -> i64 with IO {
    let s1: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let w1: Knowledge[f64, epsilon < 1.0] = Knowledge(0.0, ε = 0.05)
    var x: Knowledge[f64, epsilon < 1.0] = s1 + w1

    let cond = true
    if cond {
        x = mystery()
    }

    let w3: Knowledge[f64, epsilon < 1.0] = Knowledge(0.0, ε = 0.05)
    let y: Knowledge[f64, epsilon < 1.0] = x + w3

    println("ns-env-join-unknown: PASS")
    0
}
