//@ run-pass
//@ expect-stdout: STATS_BCA_LEGACY_PASS
use stats::epistemic::bootstrap::{bootstrap_ci_bca_mean}
use stats::bootstrap::{bootstrap_bca_mean}
use math::pure::{is_finite}
fn main() with IO,Mut,Div,Panic {
 var data:[f64;100]=[0.0;100]
 data[0]=1.0e308;data[1]=1.1e308;data[2]=1.2e308;data[3]=1.3e308
 let old=bootstrap_ci_bca_mean(data,4,500,0.05,42)
 assert(is_finite(old.lower) && is_finite(old.upper) && is_finite(old.se_bootstrap))
 assert(old.lower>1.0e307 && old.upper<1.4e308)
 var x:[f64;256]=[0.0;256]
 var i:i64=0
 while i<4 {x[i as usize]=data[i as usize];i=i+1}
 let checked=bootstrap_bca_mean(&x,4,500,0.95,42)
 assert(checked.status==0)
 assert(old.lower==checked.lo && old.upper==checked.hi && old.se_bootstrap==checked.se)
 let invalid=bootstrap_ci_bca_mean(data,101,500,0.05,42)
 assert(invalid.lower==0.0 && invalid.upper==0.0 && invalid.se_bootstrap==0.0)
 println("STATS_BCA_LEGACY_PASS")
 0
}
