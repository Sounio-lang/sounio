//@ run-pass
//@ requires: madaros
//@ expect-stdout: TRAIT_BOUND_METHOD_OK

// A method call on a receiver of type parameter T resolves against T's
// declared bound: the return type is the trait method's (here a tuple, not
// Self), the body type-checks whether or not the function is instantiated,
// and a bounded type parameter of the caller satisfies the callee's bound.
trait Lj { fn lj(self) -> (f64, f64, i64, i64) }
struct NaCl { pub z: i64 }
impl Lj for NaCl { fn lj(self) -> (f64, f64, i64, i64) { (0.300512, 1.438894, 2, 2) } }

fn eps_of<T: Lj>(p: T) -> f64 { let (s, e, src, how) = p.lj(); e }
fn sigma_of<T: Lj>(p: T) -> f64 { let (s, e, src, how) = p.lj(); s }
fn sigma_twice<U: Lj>(p: U, q: U) -> f64 { sigma_of::<U>(p) + sigma_of::<U>(q) }

fn main() -> i32 with IO {
    let a = NaCl { z: 0 }
    let b = NaCl { z: 0 }
    let s2 = sigma_twice::<NaCl>(a, b)
    if s2 == 2.0 * 0.300512 { print("TRAIT_BOUND_METHOD_OK\n") }
    return 0
}
