//@ run-pass
//@ description: Self-contained Lorenz i256 limb bridge smoke

fn limb_base() -> i64 { return 1000000000 }

fn limb_ok(x: i64) -> i64 {
    if x < 0 { return 0 }
    if x >= limb_base() { return 0 }
    return 1
}

fn add_limb(
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    b0: i64,
    b1: i64,
    b2: i64,
    b3: i64,
    limb_index: i64) -> i64 {
    if limb_ok(a0) != 1 { return 0 - 1 }
    if limb_ok(a1) != 1 { return 0 - 1 }
    if limb_ok(a2) != 1 { return 0 - 1 }
    if limb_ok(a3) != 1 { return 0 - 1 }
    if limb_ok(b0) != 1 { return 0 - 1 }
    if limb_ok(b1) != 1 { return 0 - 1 }
    if limb_ok(b2) != 1 { return 0 - 1 }
    if limb_ok(b3) != 1 { return 0 - 1 }
    let base = limb_base()
    let s0 = a0 + b0
    let r0 = s0 % base
    let c0 = s0 / base
    let s1 = a1 + b1 + c0
    let r1 = s1 % base
    let c1 = s1 / base
    let s2 = a2 + b2 + c1
    let r2 = s2 % base
    let c2 = s2 / base
    let s3 = a3 + b3 + c2
    let r3 = s3 % base
    let c3 = s3 / base
    if c3 != 0 { return 0 - 1 }
    if limb_index == 0 { return r0 }
    if limb_index == 1 { return r1 }
    if limb_index == 2 { return r2 }
    if limb_index == 3 { return r3 }
    return 0 - 1
}

fn increment_check(
    x0_l0: i64,
    x0_l1: i64,
    x0_l2: i64,
    x0_l3: i64,
    dx_l0: i64,
    dx_l1: i64,
    dx_l2: i64,
    dx_l3: i64,
    expected_l0: i64,
    expected_l1: i64,
    expected_l2: i64,
    expected_l3: i64) -> i64 {
    if add_limb(x0_l0, x0_l1, x0_l2, x0_l3, dx_l0, dx_l1, dx_l2, dx_l3, 0) != expected_l0 { return 0 }
    if add_limb(x0_l0, x0_l1, x0_l2, x0_l3, dx_l0, dx_l1, dx_l2, dx_l3, 1) != expected_l1 { return 0 }
    if add_limb(x0_l0, x0_l1, x0_l2, x0_l3, dx_l0, dx_l1, dx_l2, dx_l3, 2) != expected_l2 { return 0 }
    if add_limb(x0_l0, x0_l1, x0_l2, x0_l3, dx_l0, dx_l1, dx_l2, dx_l3, 3) != expected_l3 { return 0 }
    return 1
}

fn main() -> i64 {
    let carry_l0 = add_limb(950000000, 0, 0, 0, 200000000, 0, 0, 0, 0)
    if carry_l0 != 150000000 { return 1 }
    let carry_l1 = add_limb(950000000, 0, 0, 0, 200000000, 0, 0, 0, 1)
    if carry_l1 != 1 { return 2 }

    let increment_ok = increment_check(950000000, 0, 0, 0, 200000000, 0, 0, 0, 150000000, 1, 0, 0)
    if increment_ok != 1 { return 3 }

    let wrong_increment = increment_check(950000000, 0, 0, 0, 200000000, 0, 0, 0, 150000001, 1, 0, 0)
    if wrong_increment != 0 { return 4 }

    let invalid_limb = add_limb(1000000000, 0, 0, 0, 1, 0, 0, 0, 0)
    if invalid_limb != 0 - 1 { return 5 }

    let artifact_fp: i64 = 681429570
    let audit_fp: i64 = 352908746
    let instance_fp: i64 = 905714263
    let certificate_fp: i64 = 247816039
    let target_integer_width: i64 = 256
    let limb_base_value: i64 = 1000000000
    let native_i256_evidence_mask: i64 = 0
    let imported_runtime_evidence_mask: i64 = 0
    let public_claim_mask: i64 = 0
    let formal_theorem_ready: i64 = 0
    let bridge_status: i64 = 102
    let ok_mask: i64 = 1023

    if artifact_fp != 681429570 { return 6 }
    if audit_fp != 352908746 { return 7 }
    if instance_fp != 905714263 { return 8 }
    if certificate_fp != 247816039 { return 9 }
    if target_integer_width != 256 { return 10 }
    if limb_base_value != 1000000000 { return 11 }
    if native_i256_evidence_mask != 0 { return 12 }
    if imported_runtime_evidence_mask != 0 { return 13 }
    if public_claim_mask != 0 { return 14 }
    if formal_theorem_ready != 0 { return 15 }
    if bridge_status != 102 { return 16 }
    if ok_mask != 1023 { return 17 }
    return 0
}
