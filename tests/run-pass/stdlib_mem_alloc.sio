//@ run-pass
//@ expect-stdout: stdlib_mem_alloc: PASS
// Smoke test for stdlib/mem — malloc/free via extern "C" stubs.
// heap_alloc/heap_free are available via the extern stub mechanism
// (malloc → heap_alloc builtin; free → heap_free builtin).

extern "C" {
    fn malloc(size: i64) -> i64
    fn free(ptr: i64)
}

fn main() -> i32 with IO, Panic {
    let p = malloc(64)
    if p != 0 {
        free(p)
        println("stdlib_mem_alloc: PASS")
        return 0
    }
    println("stdlib_mem_alloc: FAIL")
    return 1
}
