//@ run-pass
//@ description: Parser frontier witness for trait declarations and impl Trait for Type.

struct Circle {
    radius: f64
}

trait Drawable {
    fn area(self: Circle) -> f64;
    fn identity() -> i64;
}

impl Drawable for Circle {
    fn area(self: Circle) -> f64 {
        self.radius
    }

    fn identity() -> i64 {
        1
    }
}

fn main() -> i64 {
    0
}
