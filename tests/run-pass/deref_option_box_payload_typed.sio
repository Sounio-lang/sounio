//@ run-pass
//@ expect-stdout: DEREF_OPTION_PAYLOAD_OK
// `var cur = *params` with `params: &Option<Box<PL>>` keeps the Option<Box<PL>>
// payload layout, so `match cur { Some(node) => (*node).head.name }` reads the
// field of PL's head (Param-like P, name at index 0). Madaros used to drop the
// layout on the deref copy and resolve `name` by the untyped field vote, which
// here picks the K structs (name at index 2): it printed 1055, not 507. The same
// shape is pure_fn_reg_record in self-hosted/parser/items.sio (#2966).

struct K1 { kind: i64, span: i64, name: i64 }
struct K2 { kind: i64, span: i64, name: i64, extra: i64 }
struct K3 { kind: i64, span: i64, name: i64 }
struct P { name: i64, ty: i64 }
struct PL { head: P, tail: Option<Box<PL>> }

fn walk(params: &Option<Box<PL>>) -> i64 with Mut, Div {
    var acc: i64 = 0
    var cur = *params
    while true {
        match cur {
            Some(node) => {
                acc = acc * 100 + (*node).head.name
                cur = (*node).tail
            }
            None => { break }
        }
    }
    acc
}

fn main() -> i32 with IO, Mut, Div, Alloc {
    let a = K1 { kind: 1, span: 2, name: 3 }
    let b = K2 { kind: 1, span: 2, name: 3, extra: 4 }
    let c = K3 { kind: 1, span: 2, name: 3 }
    let l2 = PL { head: P { name: 7, ty: 70 }, tail: None }
    let l1 = PL { head: P { name: 5, ty: 50 }, tail: Some(Box::new(l2)) }
    let o: Option<Box<PL>> = Some(Box::new(l1))
    let r = walk(&o) + a.name + b.name + c.name - 9
    if r != 507 {
        println(r)
        return 1
    }
    println("DEREF_OPTION_PAYLOAD_OK")
    return 0
}
