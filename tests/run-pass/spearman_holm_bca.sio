//@ run-pass
// spearman_holm_bca.sio — end-to-end integration test for the three
// primary-analysis primitives required by
// docs/papers/preregistrations/2026-04-21_ossm_168_depression_v3.md §8.
//
// Touchpoints:
//   1. Spearman's rho with tie-averaged ranks  — stats::inferential
//   2. Holm–Bonferroni FWER step-down           — stats::multiple_testing
//   3. Bias-corrected, accelerated bootstrap CI — stats::epistemic::bootstrap

use stats::inferential::{spearman_rho}
use stats::multiple_testing::{holm_bonferroni}
use stats::epistemic::bootstrap::{bootstrap_ci_bca_mean, BootstrapCI}

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn check_spearman() -> bool with Mut, Div, Panic {
    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < 10 {
        x[i as usize] = i as f64
        y[i as usize] = 0.0 - (i as f64)
        i = i + 1
    }
    let rho = spearman_rho(x, y, 10)
    abs_f64(rho + 1.0) < 1.0e-9
}

fn check_holm_three() -> bool with Mut, Div, Panic {
    // Family size 3 — matches H1/H2/H3 in the prereg.
    var p: [f64; 100] = [0.0; 100]
    p[0] = 0.005
    p[1] = 0.040
    p[2] = 0.300
    var adj: [f64; 100] = [0.0; 100]
    holm_bonferroni(p, 3, &!adj)
    let ok1 = adj[0] < 0.05
    let ok2 = adj[1] > 0.05
    let ok3 = abs_f64(adj[2] - 0.30) < 1.0e-9
    ok1 && ok2 && ok3
}

fn check_bca_mean() -> bool with Mut, Div, Panic {
    var data: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < 10 {
        data[i as usize] = 1.0 + (i as f64)
        i = i + 1
    }
    let ci = bootstrap_ci_bca_mean(data, 10, 200, 0.05, 42)
    let ok_order = ci.lower <= ci.upper
    let ok_brackets = ci.lower <= 5.5 && ci.upper >= 5.5
    let ok_se = ci.se_bootstrap > 0.0
    ok_order && ok_brackets && ok_se
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let a = check_spearman()
    let b = check_holm_three()
    let c = check_bca_mean()
    if a && b && c {
        println("ALL PASS")
        0
    } else {
        println("FAIL")
        1
    }
}
