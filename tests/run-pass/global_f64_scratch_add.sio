//@ expect-stdout: PASS global_f64_scratch_add
//@ description: Global f64-array element typing survives summary-to-body lowering.

var LEFT: [f64; 8] = [0.0; 8]
var RIGHT: [f64; 8] = [0.0; 8]
var INTS: [i64; 2] = [0; 2]

fn main() -> i32 with IO, Mut {
    LEFT[4] = 0.0 - 1.0
    RIGHT[4] = 1.0
    INTS[0] = 40
    INTS[1] = 2

    if LEFT[4] + RIGHT[4] != 0.0 { return 1 }
    if INTS[0] + INTS[1] != 42 { return 2 }
    println("PASS global_f64_scratch_add")
