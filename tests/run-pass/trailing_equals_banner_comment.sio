//@ run-pass
//@ expect-stdout: BANNER OK

// Regression witness for the raw-byte incomplete-assignment pre-scan
// (compiler/main.sio compile_scan_incomplete_assignment). It had no comment or literal
// awareness, so ANY file whose last non-whitespace byte was '=' was rejected outright with
// "syntax appears incomplete after assignment" — including the `// =====` banner this repo
// uses at end of file. Five versioned .sio files were rejected that way, among them
// self-hosted/hlir/lower.sio.
//
// The '=' below inside a string and inside a char literal must also be ignored by the scan,
// and the banner at the bottom is the actual trigger: it must parse.

fn main() with IO, Mut, Panic, Div {
    let eq_in_string = "a = b ="
    let eq_char = '='
    if str_len(eq_in_string) == 7 {
        println("BANNER OK")
    } else {
        println("BANNER BAD")
    }
}

// ============================================================================
// End of trailing_equals_banner_comment.sio
