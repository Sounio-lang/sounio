//@ run-pass
//@ requires: madaros
//@ expect-stdout: GUM_FO_TANGENT_CLONE_SO_OK
//@ description: With second order on (the function calls hessian_of or second_order_mean), a call whose body the #1706 re-lowering refuses -- var reassignment, a loop, an early return, recursion -- goes through a hyper-dual tangent clone that returns its gradient row AND its Hessian over its tangents; the caller applies the exact second-order chain rule H = sum_k J_k H(a_k) + sum_kl Hf_kl g_k g_l^T. Before, the Hessian through such a call read NaN (and the transfer table read Newton's `var y = x; y = ...; return y` as the identity of x, variance 1.0 where the true value is 0.0125). A straight-line helper keeps the exact Hessian of the re-lowering (hessian_of(sq(x)) = 2). Expected values: tests/oracles/gum_fo_tangent_clone_calls.cpp (first order) and tests/oracles/gum_so_hyperdual_clones.cpp (second order, jets through the same algorithm).

fn nsqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    return y
}

fn mymax(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn sq(x: f64) -> f64 with Mut, Div { x * x }

// sum_{i=1..4} exp(-e i / 100): a loop body
fn boltz_sum(e: f64) -> f64 with Mut, Div {
    var s = 0.0
    var i: i64 = 1
    while i <= 4 {
        s = s + exp(0.0 - e * (i as f64) / 100.0)
        i = i + 1
    }
    s
}

// sum_{i=1..3} a exp(-b i / 10): a loop body over two tangents
fn shell(a: f64, b: f64) -> f64 with Mut, Div {
    var s = 0.0
    var i: i64 = 1
    while i <= 3 {
        s = s + a * exp(0.0 - b * (i as f64) / 10.0)
        i = i + 1
    }
    s
}

fn pw(x: f64, n: i64) -> f64 with Mut, Div {
    if n == 0 { 1.0 } else { x * pw(x, n - 1) }
}

fn close(got: f64, want: f64) -> bool with Mut, Div {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    var w = want
    if w < 0.0 { w = 0.0 - w }
    d <= 1.0e-12 + 1.0e-12 * w
}

// 1e-10 relative (1e-14 absolute where the exact value is 0)
fn close_rel(got: f64, want: f64) -> bool with Mut, Div {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    var w = want
    if w < 0.0 { w = 0.0 - w }
    d <= 1.0e-14 + 1.0e-10 * w
}

fn report(name: string, got: f64, want: f64) -> i64 with IO, Mut, Div {
    print(name)
    print(" ")
    print_f64(got)
    if close(got, want) {
        print(" ok\n")
        return 0
    }
    print(" FAIL\n")
    1
}

fn report_rel(name: string, got: f64, want: f64) -> i64 with IO, Mut, Div {
    print(name)
    print(" ")
    print_f64(got)
    if close_rel(got, want) {
        print(" ok\n")
        return 0
    }
    print(" FAIL\n")
    1
}

fn check_newton_query_only() -> i64 with IO, Mut, Div, Epistemic {
    let k = measure(20.0, uncertainty: 1.0)
    let x: f64 = k.value
    // The call appears only inside the query: its value is never lowered.
    report_rel("newton_query_only", hessian_of(nsqrt(x), 0, 0), -0.0027950849707661009)
}

fn check_boltz() -> i64 with IO, Mut, Div, Epistemic {
    let ke = measure(34.2, uncertainty: 1.0)
    let e: f64 = ke.value
    let b = boltz_sum(e)
    var bad: i64 = 0
    bad = bad + report_rel("boltz_loop_hessian", hessian_of(b, 0, 0), 0.0010028518039351185)
    bad = bad + report_rel("boltz_second_order_mean", second_order_mean(boltz_sum(e)), 1.8284977328484937)
    bad
}

fn check_shell() -> i64 with IO, Mut, Div, Epistemic {
    let ka = measure(2.0, uncertainty: 0.1)
    let kb = measure(1.5, uncertainty: 0.2)
    let a: f64 = ka.value
    let b: f64 = kb.value
    let r = shell(a, b)
    var bad: i64 = 0
    bad = bad + report_rel("shell_mixed_partial", hessian_of(r, 0, 1), -0.42552288726538134)
    bad = bad + report_rel("shell_d2_da2", hessian_of(r, 0, 0), 0.0)
    bad = bad + report_rel("shell_d2_db2", hessian_of(r, 1, 1), 0.1912526844749578)
    bad
}

fn check_correlation() -> i64 with IO, Mut, Div, Epistemic {
    let k = measure(20.0, uncertainty: 1.0)
    let x: f64 = k.value
    // the call stays correlated with the other use of x
    report_rel("correlated_call_hessian", hessian_of(nsqrt(x) - x * x, 0, 0), -2.0027950849707663)
}

fn check_compose() -> i64 with IO, Mut, Div, Epistemic {
    let kx = measure(1.2, uncertainty: 0.05)
    let ky = measure(0.8, uncertainty: 0.05)
    let x: f64 = kx.value
    let y: f64 = ky.value
    // arguments that are expressions of the caller's own channels
    let r = shell(x * y, y)
    var bad: i64 = 0
    bad = bad + report_rel("compose_h00", hessian_of(r, 0, 0), 0.0)
    bad = bad + report_rel("compose_h01", hessian_of(r, 0, 1), 2.162904995817903)
    bad = bad + report_rel("compose_h11", hessian_of(r, 1, 1), -1.0874001161867282)
    bad
}

fn check_recursion_and_return() -> i64 with IO, Mut, Div, Epistemic {
    let k = measure(2.0, uncertainty: 0.1)
    let x: f64 = k.value
    var bad: i64 = 0
    bad = bad + report_rel("recursion_hessian", hessian_of(pw(x, 5), 0, 0), 160.0)
    bad = bad + report_rel("early_return_hessian", hessian_of(mymax(x * x, 3.0), 0, 0), 2.0)
    bad
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    var bad: i64 = 0
    let k = measure(20.0, uncertainty: 1.0)
    let x: f64 = k.value
    let s = nsqrt(x)
    bad = bad + report("newton_sqrt", variance_of(s), 0.012500000000353404)
    let m = mymax(x, 3.0)
    bad = bad + report("early_return_max", variance_of(m), 1.0)
    bad = bad + report("hessian_sq", hessian_of(sq(x), 0, 0), 2.0)
    // d2/dx2 of six Newton steps of sqrt at x = 20 (jets through the iteration)
    bad = bad + report_rel("hessian_fallback", hessian_of(s, 0, 0), -0.0027950849707661009)
    bad = bad + check_newton_query_only()
    bad = bad + check_boltz()
    bad = bad + check_shell()
    bad = bad + check_correlation()
    bad = bad + check_compose()
    bad = bad + check_recursion_and_return()
    if bad == 0 {
        print("GUM_FO_TANGENT_CLONE_SO_OK\n")
        return 0
    }
    1
}
