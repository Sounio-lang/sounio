//@ run-pass
//@ requires: madaros
//@ expect-stdout: GUM_FO_TANGENT_CLONE_SO_OK
//@ description: With second order on (the function calls hessian_of), a call whose body the #1706 re-lowering refuses -- var reassignment, an early return -- falls back to the tangent clone's first-order row. Before, the transfer table classified these bodies from their last `let` or last `return`: Newton's `var y = x; y = ...; return y` read as identity of x (variance 1.0, true 0.0125) and `if a > b { return a }; return b` as identity of b (variance 0.0, true 1.0). A straight-line helper keeps the exact Hessian of the re-lowering (hessian_of(sq(x)) = 2). Expected values: tests/oracles/gum_fo_tangent_clone_calls.cpp.

fn nsqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    return y
}

fn mymax(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn sq(x: f64) -> f64 with Mut, Div { x * x }

fn close(got: f64, want: f64) -> bool with Mut, Div {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    var w = want
    if w < 0.0 { w = 0.0 - w }
    d <= 1.0e-12 + 1.0e-12 * w
}

fn report(name: string, got: f64, want: f64) -> i64 with IO, Mut, Div {
    print(name)
    print(" ")
    print_f64(got)
    if close(got, want) {
        print(" ok\n")
        return 0
    }
    print(" FAIL\n")
    1
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    var bad: i64 = 0
    let k = measure(20.0, uncertainty: 1.0)
    let x: f64 = k.value
    let s = nsqrt(x)
    bad = bad + report("newton_sqrt", variance_of(s), 0.012500000000353404)
    let m = mymax(x, 3.0)
    bad = bad + report("early_return_max", variance_of(m), 1.0)
    bad = bad + report("hessian_sq", hessian_of(sq(x), 0, 0), 2.0)
    // The clone carries no Hessian row: through the fallback the second
    // derivative is unknown and must read NaN, never a structural 0.
    let hs = hessian_of(s, 0, 0)
    print("hessian_fallback_nan ")
    if hs != hs {
        print("ok\n")
    } else {
        print_f64(hs)
        print(" FAIL\n")
        bad = bad + 1
    }
    if bad == 0 {
        print("GUM_FO_TANGENT_CLONE_SO_OK\n")
        return 0
    }
    1
}
