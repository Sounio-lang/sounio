//@ run-pass
//@ requires: madaros
// Engine-gated, not silenced. The CI suite runs souc-stage2, which is the
// lean_single self-host output, not Madaros -- see SOUNIO_TEST_SOUC_BIN in
// .github/workflows/ci.yml. ffi_pow and ffi_tgamma are Madaros native intrinsics. Under lean_single the
// extern declarations resolve to nothing and every vector fails.
// Verified PASS on a Madaros built from this branch, on Slurm.
// pow and tgamma reference vectors. GENERATED by
// scripts/dev/gen_pow_tgamma_fixture.py from scripts/research/pow_tgamma_oracle.py.
// Do not hand-edit: regenerate. A hand-copied bit pattern is a transcription
// error in the one place where the test would certify it rather than catch it.
//
// The reference is the ORACLE, decided against mpmath at 60 digits, and NOT
// libm. glibc's tgamma returns 355687428096000.1 where 17! is the integer
// 355687428096000, and is 1 ulp off on 18!, 19!, 21! and 22! as well -- five
// consecutive exactly-representable factorials, precisely the rows a fixture
// should assert hardest. Asserting agreement with libm would fail a correct
// implementation.
//
// Tolerance is per row, from the design's own classification: rows with an
// exactly representable answer are bit-exact, the rest carry the published
// bound (pow <= 2 ulp, tgamma <= 5 ulp). Comparison is the integer distance
// between bit patterns, which IS the ulp distance for two finite values of the
// same sign; NaN rows assert NaN-ness instead, since IEEE-754 leaves a
// generated NaN's sign and payload unspecified.

extern "C" {
    fn pow(x: f64, y: f64) -> f64;
    fn tgamma(x: f64) -> f64;
}

fn is_nan_bits(b: i64) -> bool {
    let e = (b >> 52) & 2047
    let m = b & 4503599627370495
    e == 2047 && m != 0
}

fn ulp_gap(a: i64, b: i64) -> i64 {
    if a >= b { return a - b }
    b - a
}


fn check_pow() -> i64 with IO, Panic {
    var bad: i64 = 0
    // exact power of two, integer y
    if f64_to_bits(pow(bits_to_f64(4611686018427387904), bits_to_f64(4621819117588971520))) != 4652218415073722368 { bad = bad + 1 }
    // sqrt(2) via pow
    if ulp_gap(f64_to_bits(pow(bits_to_f64(4611686018427387904), bits_to_f64(4602678819172646912))), 4609047870845172685) > 2 { bad = bad + 1 }
    // pow(10,3): 1000 exactly only with an integer fast path
    if f64_to_bits(pow(bits_to_f64(4621819117588971520), bits_to_f64(4613937818241073152))) != 4652007308841189376 { bad = bad + 1 }
    // negative integer y, exact result 8
    if f64_to_bits(pow(bits_to_f64(4602678819172646912), bits_to_f64(-4609434218613702656))) != 4620693217682128896 { bad = bad + 1 }
    // cube-root-ish, generic path
    if ulp_gap(f64_to_bits(pow(bits_to_f64(4613937818241073152), bits_to_f64(4599676419421066581))), 4609174133800058614) > 2 { bad = bad + 1 }
    // generic non-integer y
    if ulp_gap(f64_to_bits(pow(bits_to_f64(4609434218613702656), bits_to_f64(4612811918334230528))), 4613387649414743380) > 2 { bad = bad + 1 }
    // negative base, ODD integer y -> negative result
    if f64_to_bits(pow(bits_to_f64(-4611686018427387904), bits_to_f64(4613937818241073152))) != -4602678819172646912 { bad = bad + 1 }
    // negative base, EVEN integer y -> positive result
    if f64_to_bits(pow(bits_to_f64(-4611686018427387904), bits_to_f64(4616189618054758400))) != 4625196817309499392 { bad = bad + 1 }
    // negative base, NON-integer y -> NaN, invalid
    if !is_nan_bits(f64_to_bits(pow(bits_to_f64(-4611686018427387904), bits_to_f64(4602678819172646912)))) { bad = bad + 1 }
    // result near overflow boundary, | y*log2 x | = 1023.5
    if ulp_gap(f64_to_bits(pow(bits_to_f64(4611686018427387904), bits_to_f64(4652214017027211264))), 9216230289645190093) > 2 { bad = bad + 1 }
    // smallest positive subnormal, exact
    if ulp_gap(f64_to_bits(pow(bits_to_f64(4611686018427387904), bits_to_f64(-4570933719455498240))), 1) > 2 { bad = bad + 1 }
    // overflow -> +inf
    if ulp_gap(f64_to_bits(pow(bits_to_f64(9214871658872686752), bits_to_f64(4611686018427387904))), 9218868437227405312) > 2 { bad = bad + 1 }
    // underflow -> +0
    if f64_to_bits(pow(bits_to_f64(2024022533073106), bits_to_f64(4611686018427387904))) != 0 { bad = bad + 1 }
    // x just below 1, huge y: | y*ln x | ~ 111
    if ulp_gap(f64_to_bits(pow(bits_to_f64(4607182418800017407), bits_to_f64(4831355200913801216))), 4606235931401940074) > 2 { bad = bad + 1 }
    // x just above 1, huge y: | y*ln x | ~ 2.22
    if ulp_gap(f64_to_bits(pow(bits_to_f64(4607182418800017409), bits_to_f64(4846369599423283200))), 4621375197044677778) > 2 { bad = bad + 1 }
    // large integer y
    if ulp_gap(f64_to_bits(pow(bits_to_f64(4612811918334230528), bits_to_f64(4636737291354636288))), 5202301527575020413) > 2 { bad = bad + 1 }
    // negative integer y, generic
    if ulp_gap(f64_to_bits(pow(bits_to_f64(4619567317775286272), bits_to_f64(-4599864069405540352))), 4442434076985144240) > 2 { bad = bad + 1 }
    // reciprocal via pow, y=-1
    if ulp_gap(f64_to_bits(pow(bits_to_f64(118622047889322841), bits_to_f64(-4616189618054758400))), 9094988921128908187) > 2 { bad = bad + 1 }
    // inverse sqrt of 3
    if ulp_gap(f64_to_bits(pow(bits_to_f64(4613937818241073152), bits_to_f64(-4620693217682128896))), 4603375528459645724) > 2 { bad = bad + 1 }
    //  | y*ln x | = 1.0, worst conditioning still small
    if ulp_gap(f64_to_bits(pow(bits_to_f64(4607182418800017409), bits_to_f64(4841369599423283200))), 4613303445314885481) > 2 { bad = bad + 1 }
    // y=0 dominates EVERYTHING, even NaN base
    if f64_to_bits(pow(bits_to_f64(9221120237041090560), bits_to_f64(0))) != 4607182418800017408 { bad = bad + 1 }
    // y=0 with infinite base
    if f64_to_bits(pow(bits_to_f64(9218868437227405312), bits_to_f64(0))) != 4607182418800017408 { bad = bad + 1 }
    // 0^0 = 1 by C99
    if f64_to_bits(pow(bits_to_f64(0), bits_to_f64(0))) != 4607182418800017408 { bad = bad + 1 }
    // (-0)^(-0) = 1
    if f64_to_bits(pow(bits_to_f64(-9223372036854775808), bits_to_f64(-9223372036854775808))) != 4607182418800017408 { bad = bad + 1 }
    // x=1 dominates NaN exponent
    if f64_to_bits(pow(bits_to_f64(4607182418800017408), bits_to_f64(9221120237041090560))) != 4607182418800017408 { bad = bad + 1 }
    // x=1 with infinite y
    if f64_to_bits(pow(bits_to_f64(4607182418800017408), bits_to_f64(9218868437227405312))) != 4607182418800017408 { bad = bad + 1 }
    // (-1)^(+inf) = 1
    if f64_to_bits(pow(bits_to_f64(-4616189618054758400), bits_to_f64(9218868437227405312))) != 4607182418800017408 { bad = bad + 1 }
    // (-1)^(-inf) = 1
    if f64_to_bits(pow(bits_to_f64(-4616189618054758400), bits_to_f64(-4503599627370496))) != 4607182418800017408 { bad = bad + 1 }
    // y=1 returns x bit-exactly
    if ulp_gap(f64_to_bits(pow(bits_to_f64(-4608871268660281344), bits_to_f64(4607182418800017408))), -4608871268660281344) > 2 { bad = bad + 1 }
    // +0 to positive odd int -> +0
    if f64_to_bits(pow(bits_to_f64(0), bits_to_f64(4613937818241073152))) != 0 { bad = bad + 1 }
    // -0 to positive ODD int -> -0 (sign must survive)
    if f64_to_bits(pow(bits_to_f64(-9223372036854775808), bits_to_f64(4613937818241073152))) != -9223372036854775808 { bad = bad + 1 }
    // -0 to positive even int -> +0
    if f64_to_bits(pow(bits_to_f64(-9223372036854775808), bits_to_f64(4611686018427387904))) != 0 { bad = bad + 1 }
    // -0 to positive non-integer -> +0
    if f64_to_bits(pow(bits_to_f64(-9223372036854775808), bits_to_f64(4602678819172646912))) != 0 { bad = bad + 1 }
    // +0 to negative odd int -> +inf, divide-by-zero
    if ulp_gap(f64_to_bits(pow(bits_to_f64(0), bits_to_f64(-4609434218613702656))), 9218868437227405312) > 2 { bad = bad + 1 }
    // -0 to negative ODD int -> -inf, divide-by-zero
    if ulp_gap(f64_to_bits(pow(bits_to_f64(-9223372036854775808), bits_to_f64(-4609434218613702656))), -4503599627370496) > 2 { bad = bad + 1 }
    // -0 to negative even int -> +inf, divide-by-zero
    if ulp_gap(f64_to_bits(pow(bits_to_f64(-9223372036854775808), bits_to_f64(-4611686018427387904))), 9218868437227405312) > 2 { bad = bad + 1 }
    //  | x | <1, y=-inf -> +inf
    if ulp_gap(f64_to_bits(pow(bits_to_f64(4602678819172646912), bits_to_f64(-4503599627370496))), 9218868437227405312) > 2 { bad = bad + 1 }
    //  | x | <1, y=+inf -> +0
    if f64_to_bits(pow(bits_to_f64(4602678819172646912), bits_to_f64(9218868437227405312))) != 0 { bad = bad + 1 }
    //  | x | >1, y=-inf -> +0
    if f64_to_bits(pow(bits_to_f64(4611686018427387904), bits_to_f64(-4503599627370496))) != 0 { bad = bad + 1 }
    //  | x | >1, y=+inf -> +inf
    if ulp_gap(f64_to_bits(pow(bits_to_f64(4611686018427387904), bits_to_f64(9218868437227405312))), 9218868437227405312) > 2 { bad = bad + 1 }
    // -inf to negative ODD int -> -0
    if f64_to_bits(pow(bits_to_f64(-4503599627370496), bits_to_f64(-4609434218613702656))) != -9223372036854775808 { bad = bad + 1 }
    // -inf to negative even int -> +0
    if f64_to_bits(pow(bits_to_f64(-4503599627370496), bits_to_f64(-4611686018427387904))) != 0 { bad = bad + 1 }
    // -inf to positive ODD int -> -inf
    if ulp_gap(f64_to_bits(pow(bits_to_f64(-4503599627370496), bits_to_f64(4613937818241073152))), -4503599627370496) > 2 { bad = bad + 1 }
    // -inf to positive even int -> +inf
    if ulp_gap(f64_to_bits(pow(bits_to_f64(-4503599627370496), bits_to_f64(4611686018427387904))), 9218868437227405312) > 2 { bad = bad + 1 }
    // -inf to positive non-integer -> +inf
    if ulp_gap(f64_to_bits(pow(bits_to_f64(-4503599627370496), bits_to_f64(4602678819172646912))), 9218868437227405312) > 2 { bad = bad + 1 }
    // +inf to negative y -> +0
    if f64_to_bits(pow(bits_to_f64(9218868437227405312), bits_to_f64(-4611686018427387904))) != 0 { bad = bad + 1 }
    // +inf to positive y -> +inf
    if ulp_gap(f64_to_bits(pow(bits_to_f64(9218868437227405312), bits_to_f64(4611686018427387904))), 9218868437227405312) > 2 { bad = bad + 1 }
    // NaN base propagates
    if !is_nan_bits(f64_to_bits(pow(bits_to_f64(9221120237041090560), bits_to_f64(4611686018427387904)))) { bad = bad + 1 }
    // NaN exponent propagates
    if !is_nan_bits(f64_to_bits(pow(bits_to_f64(4611686018427387904), bits_to_f64(9221120237041090560)))) { bad = bad + 1 }
    // 1e300 IS an even integer -> +inf, not NaN
    if ulp_gap(f64_to_bits(pow(bits_to_f64(-4611686018427387904), bits_to_f64(9094988921128908188))), 9218868437227405312) > 2 { bad = bad + 1 }
    // (-1)^0.5 -> NaN, invalid
    if !is_nan_bits(f64_to_bits(pow(bits_to_f64(-4616189618054758400), bits_to_f64(4602678819172646912)))) { bad = bad + 1 }
    // y = 2^53 is an even integer -> +inf
    if ulp_gap(f64_to_bits(pow(bits_to_f64(-4611686018427387904), bits_to_f64(4845873199050653696))), 9218868437227405312) > 2 { bad = bad + 1 }
    bad
}

fn check_tgamma() -> i64 with IO, Panic {
    var bad: i64 = 0
    // MUST be exactly 1.0
    if f64_to_bits(tgamma(bits_to_f64(4607182418800017408))) != 4607182418800017408 { bad = bad + 1 }
    // MUST be exactly 1.0
    if f64_to_bits(tgamma(bits_to_f64(4611686018427387904))) != 4607182418800017408 { bad = bad + 1 }
    // exactly 2.0
    if f64_to_bits(tgamma(bits_to_f64(4613937818241073152))) != 4611686018427387904 { bad = bad + 1 }
    // exactly 24.0 (4!)
    if f64_to_bits(tgamma(bits_to_f64(4617315517961601024))) != 4627448617123184640 { bad = bad + 1 }
    // exactly 120.0
    if f64_to_bits(tgamma(bits_to_f64(4618441417868443648))) != 4638144666238189568 { bad = bad + 1 }
    // 10! = 3628800, still exactly representable
    if f64_to_bits(tgamma(bits_to_f64(4622382067542392832))) != 4705047200009289728 { bad = bad + 1 }
    // 17! = 355687428096000, exactly representable
    if f64_to_bits(tgamma(bits_to_f64(4625759767262920704))) != 4824542600135966720 { bad = bad + 1 }
    // 18! = 6402373705728000, exactly representable
    if f64_to_bits(tgamma(bits_to_f64(4626041242239631360))) != 4843268373501640704 { bad = bad + 1 }
    // 22! = 1124000727777607680000 IS exactly representable (largest factori
    if f64_to_bits(tgamma(bits_to_f64(4627167142146473984))) != 4922002638466838636 { bad = bad + 1 }
    // 23! is NOT exactly representable -> nearest double
    if f64_to_bits(tgamma(bits_to_f64(4627448617123184640))) != 4942108792695858382 { bad = bad + 1 }
    // sqrt(pi) -- the canonical half-integer
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4602678819172646912))), 4610661241675116395) > 5 { bad = bad + 1 }
    // sqrt(pi)/2
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4609434218613702656))), 4606157642047745899) > 5 { bad = bad + 1 }
    // 3*sqrt(pi)/4
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4612811918334230528))), 4608665636049499024) > 5 { bad = bad + 1 }
    // half-integer, mid range
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4616752568008179712))), 4622737699013815397) > 5 { bad = bad + 1 }
    // -2*sqrt(pi), reflection path
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(-4620693217682128896))), -4608207195552288917) > 5 { bad = bad + 1 }
    // 4*sqrt(pi)/3, reflection past one pole
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(-4613937818241073152))), 4612504033801663730) > 5 { bad = bad + 1 }
    // -8*sqrt(pi)/15
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(-4610560118520545280))), -4616682233306865277) > 5 { bad = bad + 1 }
    // reflection, deeper
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(-4608308318706860032))), 4598537096490839700) > 5 { bad = bad + 1 }
    // small positive, recurrence path Gamma(x)=Gamma(x+1)/x
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4591870180066957722))), 4621545246770597255) > 5 { bad = bad + 1 }
    // tiny x: Gamma(x) ~ 1/x, near overflow of the reciprocal
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(118622047889322841))), 9094988921128908187) > 5 { bad = bad + 1 }
    // argmin of Gamma on (0,inf) (true argmin 1.46163214496836234)
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4609261425156079167))), 4606152023977970415) > 5 { bad = bad + 1 }
    // 362880 exactly
    if f64_to_bits(tgamma(bits_to_f64(4621819117588971520))) != 4689977843394805760 { bad = bad + 1 }
    // 19! exact-ish
    if f64_to_bits(tgamma(bits_to_f64(4626322717216342016))) != 4862483217080946688 { bad = bad + 1 }
    // large half-integer
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4636772475726725120))), 6955169173795998731) > 5 { bad = bad + 1 }
    // large negative non-integer: reflection with | x | >>1
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(-4586599561128050688))), -6987454463731342702) > 5 { bad = bad + 1 }
    // deep reflection, result still normal
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(-4583169084849389568))), -9216666977416979846) > 5 { bad = bad + 1 }
    // Gamma is NEGATIVE here; reflection result UNDERFLOWS to -0.0
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(-4582676503640145920))), -9223372036854775808) > 5 { bad = bad + 1 }
    // largest integer argument that does not overflow
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4640220544191430656))), 9197664872563836473) > 5 { bad = bad + 1 }
    // just below the overflow threshold
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4640241654814683955))), 9217807248994142129) > 5 { bad = bad + 1 }
    // closer still to the threshold
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4640242006658404844))), 9218226543286197118) > 5 { bad = bad + 1 }
    // LARGEST double x with Gamma(x) finite (0x406573FAE561F647)
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4640242512502584903))), 9218868437227404881) > 5 { bad = bad + 1 }
    // next double up (0x...F648) -> +inf, overflow
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4640242512502584904))), 9218868437227405312) > 5 { bad = bad + 1 }
    // just above the threshold -> +inf, overflow
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4640242710345846620))), 9218868437227405312) > 5 { bad = bad + 1 }
    // integer argument that overflows -> +inf
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4640255728563519488))), 9218868437227405312) > 5 { bad = bad + 1 }
    // pole at +0 -> +inf, divide-by-zero
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(0))), 9218868437227405312) > 5 { bad = bad + 1 }
    // pole at -0 -> -inf, divide-by-zero (sign of zero matters)
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(-9223372036854775808))), -4503599627370496) > 5 { bad = bad + 1 }
    // negative integer -> NaN, invalid
    if !is_nan_bits(f64_to_bits(tgamma(bits_to_f64(-4616189618054758400)))) { bad = bad + 1 }
    // negative integer -> NaN, invalid
    if !is_nan_bits(f64_to_bits(tgamma(bits_to_f64(-4611686018427387904)))) { bad = bad + 1 }
    // large negative integer -> NaN, invalid
    if !is_nan_bits(f64_to_bits(tgamma(bits_to_f64(-4583151492663345152)))) { bad = bad + 1 }
    // NaN propagates
    if !is_nan_bits(f64_to_bits(tgamma(bits_to_f64(9221120237041090560)))) { bad = bad + 1 }
    // +inf -> +inf
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(9218868437227405312))), 9218868437227405312) > 5 { bad = bad + 1 }
    // -inf -> NaN, invalid
    if !is_nan_bits(f64_to_bits(tgamma(bits_to_f64(-4503599627370496)))) { bad = bad + 1 }
    // 1 ulp above 2: result must NOT be 1.0
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4611686018427387905))), 4607182418800017409) > 5 { bad = bad + 1 }
    // 1 ulp below 1
    if ulp_gap(f64_to_bits(tgamma(bits_to_f64(4607182418800017407))), 4607182418800017408) > 5 { bad = bad + 1 }
    bad
}

fn main() -> i32 with IO, Panic {
    var bad = 0
    bad = bad + check_pow()
    bad = bad + check_tgamma()
    if bad == 0 {
        println("ffi_pow_tgamma_vectors: PASS")
        return 0
    }
    println("ffi_pow_tgamma_vectors: FAIL")
    return 1
}
