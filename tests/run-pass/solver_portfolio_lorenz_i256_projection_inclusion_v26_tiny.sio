//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v26 smoke for Lorenz i256 projection-inclusion bridge

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 29 { return 0 - 1 }
    if instance_fp != 214180161 { return 0 - 1 }
    if certificate_fp != 607091799 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 29 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn projection_instance_fingerprint(trajectory_manifest_fp: i64,
                                   final_x_2p32: i64,
                                   final_y_2p32: i64,
                                   final_z_2p32: i64,
                                   target_scale: i64,
                                   x_q: i64,
                                   y_q: i64,
                                   z_q: i64,
                                   inclusion_mask: i64) -> i64 {
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if final_x_2p32 != 5309941770 { return 0 - 1 }
    if final_y_2p32 != 10058731223 { return 0 - 1 }
    if final_z_2p32 != 4084837935 { return 0 - 1 }
    if target_scale != 1000000 { return 0 - 1 }
    if x_q != 1236317 { return 0 - 1 }
    if y_q != 2341980 { return 0 - 1 }
    if z_q != 951075 { return 0 - 1 }
    if inclusion_mask != 7 { return 0 - 1 }
    return trajectory_manifest_fp
}

fn projection_certificate_fingerprint(trajectory_manifest_fp: i64,
                                      inclusion_fp: i64,
                                      radius_budget_fp: i64,
                                      quality_profile_fp: i64,
                                      inclusion_mask: i64) -> i64 with Mod {
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if inclusion_fp != 890086395 { return 0 - 1 }
    if radius_budget_fp != 565673886 { return 0 - 1 }
    if quality_profile_fp != 70877465 { return 0 - 1 }
    if inclusion_mask != 7 { return 0 - 1 }

    var fp: i64 = 257
    fp = portfolio_mix(fp, trajectory_manifest_fp, 2423)
    fp = portfolio_mix(fp, inclusion_fp, 2423)
    fp = portfolio_mix(fp, radius_budget_fp, 2423)
    fp = portfolio_mix(fp, quality_profile_fp, 2423)
    fp = portfolio_mix(fp, inclusion_mask, 2423)
    return fp
}

fn portfolio_v26_manifest_fingerprint(projection_entry_fp: i64) -> i64 with Mod {
    if projection_entry_fp != 63872871 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 26, 1151)
    fp = portfolio_mix(fp, 30, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, 590228875, 1151)
    fp = portfolio_mix(fp, 46718256, 1151)
    fp = portfolio_mix(fp, 295040814, 1151)
    fp = portfolio_mix(fp, 124720146, 1151)
    fp = portfolio_mix(fp, 988622529, 1151)
    fp = portfolio_mix(fp, 757892608, 1151)
    fp = portfolio_mix(fp, 3812644, 1151)
    fp = portfolio_mix(fp, 777068644, 1151)
    fp = portfolio_mix(fp, 423305090, 1151)
    fp = portfolio_mix(fp, projection_entry_fp, 1151)
    return fp
}

fn portfolio_v26_result_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 326517892 { return 0 - 1 }

    var fp: i64 = 131
    fp = portfolio_mix(fp, 26, 1871)
    fp = portfolio_mix(fp, 30, 1871)
    fp = portfolio_mix(fp, 9, 1871)
    fp = portfolio_mix(fp, 19, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn portfolio_v26_checker_family_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 326517892 { return 0 - 1 }

    var fp: i64 = 149
    fp = portfolio_mix(fp, 26, 1907)
    fp = portfolio_mix(fp, 30, 1907)
    fp = portfolio_mix(fp, 5, 1907)
    fp = portfolio_mix(fp, 3, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 1, 1907)
    fp = portfolio_mix(fp, 19, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn portfolio_v26_readiness_fingerprint(manifest_fp: i64,
                                       result_coverage_fp: i64,
                                       family_coverage_fp: i64,
                                       acceptance_receipt_fp: i64,
                                       audit_receipt_fp: i64) -> i64 with Mod {
    if manifest_fp != 326517892 { return 0 - 1 }
    if result_coverage_fp != 576925127 { return 0 - 1 }
    if family_coverage_fp != 842185233 { return 0 - 1 }
    if acceptance_receipt_fp != 345898763 { return 0 - 1 }
    if audit_receipt_fp != 128651545 { return 0 - 1 }

    var fp: i64 = 163
    fp = portfolio_mix(fp, 26, 1951)
    fp = portfolio_mix(fp, 31, 1951)
    fp = portfolio_mix(fp, manifest_fp, 1951)
    fp = portfolio_mix(fp, result_coverage_fp, 1951)
    fp = portfolio_mix(fp, family_coverage_fp, 1951)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1951)
    fp = portfolio_mix(fp, audit_receipt_fp, 1951)
    return fp
}

fn main() -> i64 with Mod {
    let instance_fp = projection_instance_fingerprint(
        214180161, 5309941770, 10058731223, 4084837935,
        1000000, 1236317, 2341980, 951075, 7)
    if instance_fp != 214180161 { return 1 }

    let certificate_fp = projection_certificate_fingerprint(
        instance_fp, 890086395, 565673886, 70877465, 7)
    if certificate_fp != 607091799 { return 2 }

    let entry_fp = portfolio_entry_fingerprint(29, instance_fp, certificate_fp, 1, 29)
    if entry_fp != 63872871 { return 3 }

    let manifest_fp = portfolio_v26_manifest_fingerprint(entry_fp)
    if manifest_fp != 326517892 { return 4 }

    let result_coverage_fp = portfolio_v26_result_coverage_fingerprint(manifest_fp)
    if result_coverage_fp != 576925127 { return 5 }

    let family_coverage_fp = portfolio_v26_checker_family_coverage_fingerprint(manifest_fp)
    if family_coverage_fp != 842185233 { return 6 }

    if portfolio_v26_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        345898763, 128651545) != 242940443 { return 7 }

    if projection_instance_fingerprint(
        214180161, 5309941770, 10058731223, 4084837935,
        1000000, 1236318, 2341980, 951075, 7) != (0 - 1) { return 8 }
    if projection_certificate_fingerprint(
        instance_fp, 890086396, 565673886, 70877465, 7) != (0 - 1) { return 9 }
    if portfolio_entry_fingerprint(29, instance_fp, certificate_fp, 0, 29) != (0 - 1) { return 10 }
    if portfolio_v26_manifest_fingerprint(entry_fp + 1) != (0 - 1) { return 11 }
    if portfolio_v26_result_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 12 }
    if portfolio_v26_checker_family_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 13 }
    if portfolio_v26_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        345898763, 128651546) != (0 - 1) { return 14 }

    return 0
}
