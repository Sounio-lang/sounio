use stats::checked_distributions::{normal_density_checked,normal_tails_checked,normal_quantile_checked,beta_density_checked,beta_tails_checked,beta_quantile_checked}
fn main()->i32 with IO,Mut,Div,Panic {
 let n=normal_density_checked(0.0,1.0,0.0)
 assert(n.status==0 && n.value_available)
 let t=normal_tails_checked(0.0,1.0,2.0,2048,1.0e-12)
 assert(t.status==0 && t.sf_available)
 let q=normal_quantile_checked(0.0,1.0,0.025,false,2048,1.0e-12)
 assert(q.status==0 && q.available)
 let b=beta_density_checked(1.0,1.0,0.5)
 assert(b.status==0 && b.value_available)
 let bt=beta_tails_checked(2.0,3.0,0.5,2048,1.0e-12)
 assert(bt.status==0)
 let bq=beta_quantile_checked(2.0,3.0,0.1,false,2048,1.0e-12)
 assert(bq.status==0)
 println("CHECKED_DISTRIBUTIONS_SMOKE_PASS")
 0
}
