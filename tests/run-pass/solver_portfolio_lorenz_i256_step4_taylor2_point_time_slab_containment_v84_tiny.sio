//@ run-pass
//@ description: Tiny portfolio v84 smoke for Lorenz i256 step-4 point time-slab containment

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1663
    receipt_fp = mix(receipt_fp, 827089582, 5557)
    receipt_fp = mix(receipt_fp, 688797663, 5557)
    receipt_fp = mix(receipt_fp, 258802509, 5557)
    receipt_fp = mix(receipt_fp, 583092751, 5557)
    receipt_fp = mix(receipt_fp, 804311422, 5557)
    receipt_fp = mix(receipt_fp, 652012103, 5557)
    receipt_fp = mix(receipt_fp, 470514407, 5557)
    receipt_fp = mix(receipt_fp, 563331437, 5557)
    receipt_fp = mix(receipt_fp, 684718822, 5557)
    receipt_fp = mix(receipt_fp, 4, 5557)
    receipt_fp = mix(receipt_fp, 19, 5557)
    receipt_fp = mix(receipt_fp, 255, 5557)
    if receipt_fp != 414744732 { return 1 }

    var audit_fp: i64 = 1667
    audit_fp = mix(audit_fp, receipt_fp, 5563)
    audit_fp = mix(audit_fp, 827089582, 5563)
    audit_fp = mix(audit_fp, 688797663, 5563)
    audit_fp = mix(audit_fp, 258802509, 5563)
    audit_fp = mix(audit_fp, 583092751, 5563)
    audit_fp = mix(audit_fp, 563331437, 5563)
    audit_fp = mix(audit_fp, 684718822, 5563)
    audit_fp = mix(audit_fp, 470514407, 5563)
    audit_fp = mix(audit_fp, 4, 5563)
    audit_fp = mix(audit_fp, 19, 5563)
    audit_fp = mix(audit_fp, 255, 5563)
    if audit_fp != 65508192 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 87, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 87, 1103)
    if entry_fp != 600773460 { return 3 }

    let manifest_fp: i64 = 157689400
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 84, 1871)
    result_fp = mix(result_fp, 88, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 76, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 890808064 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 84, 1907)
    family_fp = mix(family_fp, 88, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 71, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 232338613 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 84, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 410135939 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 84, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 296264027 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 84, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 544039824 { return 8 }
    return 0
}
