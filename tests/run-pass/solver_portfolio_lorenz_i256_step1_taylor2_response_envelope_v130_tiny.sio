//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v130 smoke for Lorenz i256 step-1 Taylor-2 response envelope

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2141
    receipt_fp = mix(receipt_fp, 496675613, 6163)
    receipt_fp = mix(receipt_fp, 467471545, 6163)
    receipt_fp = mix(receipt_fp, 311818225, 6163)
    receipt_fp = mix(receipt_fp, 706283113, 6163)
    receipt_fp = mix(receipt_fp, 435724379, 6163)
    receipt_fp = mix(receipt_fp, 44353214, 6163)
    receipt_fp = mix(receipt_fp, 431845922, 6163)
    receipt_fp = mix(receipt_fp, 301347724, 6163)
    receipt_fp = mix(receipt_fp, 777254975, 6163)
    receipt_fp = mix(receipt_fp, 1, 6163)
    receipt_fp = mix(receipt_fp, 20, 6163)
    receipt_fp = mix(receipt_fp, 255, 6163)
    if receipt_fp != 590782342 { return 1 }

    var audit_fp: i64 = 2143
    audit_fp = mix(audit_fp, receipt_fp, 6173)
    audit_fp = mix(audit_fp, 496675613, 6173)
    audit_fp = mix(audit_fp, 467471545, 6173)
    audit_fp = mix(audit_fp, 972140381, 6173)
    audit_fp = mix(audit_fp, 96825760, 6173)
    audit_fp = mix(audit_fp, 44353214, 6173)
    audit_fp = mix(audit_fp, 431845922, 6173)
    audit_fp = mix(audit_fp, 301347724, 6173)
    audit_fp = mix(audit_fp, 777254975, 6173)
    audit_fp = mix(audit_fp, 435724379, 6173)
    audit_fp = mix(audit_fp, 1, 6173)
    audit_fp = mix(audit_fp, 20, 6173)
    audit_fp = mix(audit_fp, 255, 6173)
    if audit_fp != 991875676 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 133, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 133, 1103)
    if entry_fp != 506555685 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 130, 1151)
    manifest_fp = mix(manifest_fp, 134, 1151)
    manifest_fp = mix(manifest_fp, 706283113, 1151)
    manifest_fp = mix(manifest_fp, 311818225, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 549540177 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 130, 1871)
    result_fp = mix(result_fp, 134, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 122, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 581528248 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 130, 1907)
    family_fp = mix(family_fp, 134, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 117, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 8708544 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 130, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 973777941 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 130, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 733264640 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 130, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 275405819 { return 9 }
    return 0
}
