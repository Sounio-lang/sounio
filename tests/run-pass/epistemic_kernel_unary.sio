//@ run-pass
// Epistemic kernel exercising unary ops (abs, neg via subtraction).
// The --epistemic GPU pipeline generates shadow passthrough for these ops.

kernel fn epistemic_unary(n: i64, eps: Knowledge<f64>) -> () with GPU, Div {
    var i: i64 = 0
    while i < n {
        let x = 3.0 + 1.0
        i = i + 1
    }
}

fn main() -> i32 with IO {
    0
}
