//@ run-pass
//@ description: #2874 — three `unit` declarations with no semicolons are all registered, so a parameter typed by the LAST one is an f64 on both engines (lean_single used to skip from the first declaration to the next `;`, swallowing the later declarations, and lowered such parameters as integers: 4.544794e21).
//@ expect-stdout: UNIT_DECLS_2874_PASS
unit pressure = kg / m / s / s
unit inverse_pressure = m * s * s / kg
unit flow = m * m * m / s

fn exponent(beta: inverse_pressure, delta: pressure) -> f64 {
    (beta as f64) * (delta as f64)
}
fn per_flow(q: flow, t: f64) -> f64 {
    (q as f64) * t
}
fn near(a: f64, b: f64) -> bool {
    a > b - 0.000000001 && a < b + 0.000000001
}
fn main() -> i32 with IO {
    let beta: inverse_pressure = 0.00007
    let delta: pressure = 1000.0
    let q: flow = 0.25
    if !near(exponent(beta, delta), 0.07) { print("UNIT_DECLS_2874_FAIL exponent\n"); return 1 }
    if !near(per_flow(q, 8.0), 2.0) { print("UNIT_DECLS_2874_FAIL flow\n"); return 1 }
    print("UNIT_DECLS_2874_PASS\n")
    return 0
}
