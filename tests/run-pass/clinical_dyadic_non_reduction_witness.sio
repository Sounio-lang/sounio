//@ check-only
// Imported API conformance surface for exact finite synthetic D0. Current
// Madaros typechecks this two-module program and can execute it through the
// full-IR route after the compact modular emitter declines it. The scalarized
// native executor remains the canonical no-fallback runtime evidence.

use epistemic::dyadic_non_reduction::*

struct DyadicFamily4Receipt {
    family_id: i64,
    rule_id: i64,
    schema_id: i64,
    candidate0_id: i64,
    candidate1_id: i64,
    candidate2_id: i64,
    candidate3_id: i64,
    mode0: i64,
    mode1: i64,
    mode2: i64,
    mode3: i64,
    current_states_equal: bool,
    histories_distinct: bool,
    identifiers_absent_from_observation: bool,
    candidate_family_exhaustive: bool,
}

struct DyadicTracePartitionReceipt {
    family_id: i64,
    word_length: i64,
    probe0: i64,
    probe1: i64,
    probe2: i64,
    block0: i64,
    block1: i64,
    block2: i64,
    block3: i64,
    block_count: i64,
    pair_comparisons_replayed: i64,
    exact_traces_recomputed: bool,
    singleton_partition: bool,
    global_equivalence_claimed: bool,
}

struct PresetDyadicExperimentReceipt {
    family_id: i64,
    found: bool,
    word_length: i64,
    worst_case_cost: i64,
    probe0: i64,
    probe1: i64,
    probe2: i64,
    words_replayed: i64,
    cheaper_words_exhausted: bool,
    canonical_enumeration: bool,
}

struct AdaptiveDyadicExperimentReceipt {
    family_id: i64,
    found: bool,
    root_probe: i64,
    observation400_child_probe: i64,
    observation600_child_probe: i64,
    root_block_count: i64,
    leaf_block_count: i64,
    worst_case_cost: i64,
    one_step_probes_replayed: i64,
    exact_children_replayed: bool,
}

struct BoundedDyadicMinimalityCertificate {
    family_id: i64,
    selected_worst_case_cost: i64,
    cheaper_policy_count: i64,
    cheaper_policies_rejected: i64,
    bounded_minimality_established: bool,
    search_soundness_formally_verified: bool,
    global_minimality_claimed: bool,
}

struct LocalHorizonLimitedDyadicAmbiguityReceipt {
    family_id: i64,
    horizon_bound: i64,
    residual_block_count: i64,
    bounded_search_complete: bool,
    global_dyadic_equivalence_established: bool,
}

struct DyadicPermutationControlReceipt {
    original_block_count: i64,
    permuted_block_count: i64,
    original_adaptive_cost: i64,
    permuted_adaptive_cost: i64,
    partition_invariant_up_to_labels: bool,
    optimal_cost_invariant: bool,
}

struct DyadicSearchOrderControlReceipt {
    canonical_root_probe: i64,
    reverse_root_probe: i64,
    canonical_cost: i64,
    reverse_cost: i64,
    root_and_cost_invariant: bool,
}

struct DyadicSchemaRejectionReceipt {
    schema_id: i64,
    candidate_or_history_leak_detected: bool,
    tomography_validity_rejected: bool,
    separation_authorized: bool,
}

struct SyntheticDyadicD0Receipt {
    experiment_id: i64,
    exact_collision_and_reveal: bool,
    adaptive_and_preset_search_replayed: bool,
    factorable_null_preserved: bool,
    identifier_controls_passed: bool,
    incomplete_search_refused: bool,
    context_rival_reported: bool,
    markov_expansion_reported: bool,
    bounded_synthetic_scope_only: bool,
    real_relationship_measured: bool,
    subjective_suffering_established: bool,
    consent_established: bool,
    clinical_authority: bool,
}

fn trace_equal(
    left_mode: i64,
    right_mode: i64,
    probe0: i64,
    probe1: i64,
    probe2: i64,
    word_length: i64,
) -> bool with Panic {
    assert(word_length >= 1 && word_length <= 3)
    let equal0 = dyadic_observation_numerator(left_mode, probe0) ==
        dyadic_observation_numerator(right_mode, probe0)
    if word_length == 1 {
        equal0
    } else {
        let equal1 = dyadic_observation_numerator(left_mode, probe1) ==
            dyadic_observation_numerator(right_mode, probe1)
        if word_length == 2 {
            equal0 && equal1
        } else {
            let equal2 = dyadic_observation_numerator(left_mode, probe2) ==
                dyadic_observation_numerator(right_mode, probe2)
            equal0 && equal1 && equal2
        }
    }
}

fn partition4(
    family: DyadicFamily4Receipt,
    probe0: i64,
    probe1: i64,
    probe2: i64,
    word_length: i64,
) -> DyadicTracePartitionReceipt with Mut, Panic {
    var next_block = 1
    let block0 = 0
    var block1 = 0
    if !trace_equal(family.mode1, family.mode0, probe0, probe1, probe2, word_length) {
        block1 = next_block
        next_block = next_block + 1
    }
    var block2 = 0
    if trace_equal(family.mode2, family.mode0, probe0, probe1, probe2, word_length) {
        block2 = block0
    } else if trace_equal(family.mode2, family.mode1, probe0, probe1, probe2, word_length) {
        block2 = block1
    } else {
        block2 = next_block
        next_block = next_block + 1
    }
    var block3 = 0
    if trace_equal(family.mode3, family.mode0, probe0, probe1, probe2, word_length) {
        block3 = block0
    } else if trace_equal(family.mode3, family.mode1, probe0, probe1, probe2, word_length) {
        block3 = block1
    } else if trace_equal(family.mode3, family.mode2, probe0, probe1, probe2, word_length) {
        block3 = block2
    } else {
        block3 = next_block
        next_block = next_block + 1
    }
    DyadicTracePartitionReceipt {
        family_id: family.family_id,
        word_length: word_length,
        probe0: probe0,
        probe1: probe1,
        probe2: probe2,
        block0: block0,
        block1: block1,
        block2: block2,
        block3: block3,
        block_count: next_block,
        pair_comparisons_replayed: 6,
        exact_traces_recomputed: true,
        singleton_partition: next_block == 4,
        global_equivalence_claimed: false,
    }
}

fn declare_family4(
    family_id: i64,
    c0: DyadicCandidateStateReceipt,
    c1: DyadicCandidateStateReceipt,
    c2: DyadicCandidateStateReceipt,
    c3: DyadicCandidateStateReceipt,
) -> DyadicFamily4Receipt with Panic {
    assert(family_id > 0)
    assert(c0.candidate_id != c1.candidate_id)
    assert(c0.candidate_id != c2.candidate_id)
    assert(c0.candidate_id != c3.candidate_id)
    assert(c1.candidate_id != c2.candidate_id)
    assert(c1.candidate_id != c3.candidate_id)
    assert(c2.candidate_id != c3.candidate_id)
    assert(c0.rule_id == c1.rule_id && c0.rule_id == c2.rule_id)
    assert(c0.rule_id == c3.rule_id)
    assert(c0.schema_id == c1.schema_id && c0.schema_id == c2.schema_id)
    assert(c0.schema_id == c3.schema_id)
    assert(c0.left_state_id == c1.left_state_id && c0.left_state_id == c2.left_state_id)
    assert(c0.left_state_id == c3.left_state_id)
    assert(c0.right_state_id == c1.right_state_id && c0.right_state_id == c2.right_state_id)
    assert(c0.right_state_id == c3.right_state_id)
    assert(c0.relational_state_id == c1.relational_state_id)
    assert(c0.relational_state_id == c2.relational_state_id)
    assert(c0.relational_state_id == c3.relational_state_id)
    assert(c0.context_id == c1.context_id && c0.context_id == c2.context_id)
    assert(c0.context_id == c3.context_id)
    assert(c0.predictive_mode != c1.predictive_mode)
    assert(c0.predictive_mode != c2.predictive_mode)
    assert(c0.predictive_mode != c3.predictive_mode)
    assert(c1.predictive_mode != c2.predictive_mode)
    assert(c1.predictive_mode != c3.predictive_mode)
    assert(c2.predictive_mode != c3.predictive_mode)
    DyadicFamily4Receipt {
        family_id: family_id,
        rule_id: c0.rule_id,
        schema_id: c0.schema_id,
        candidate0_id: c0.candidate_id,
        candidate1_id: c1.candidate_id,
        candidate2_id: c2.candidate_id,
        candidate3_id: c3.candidate_id,
        mode0: c0.predictive_mode,
        mode1: c1.predictive_mode,
        mode2: c2.predictive_mode,
        mode3: c3.predictive_mode,
        current_states_equal: true,
        histories_distinct: true,
        identifiers_absent_from_observation: true,
        candidate_family_exhaustive: false,
    }
}

fn exhaustive_preset_search3(
    family: DyadicFamily4Receipt,
) -> PresetDyadicExperimentReceipt with Mut, Panic {
    var words_replayed = 0
    var found = false
    var found_length = -1
    var found0 = -1
    var found1 = -1
    var found2 = -1
    var p0 = 0
    while p0 < 3 {
        words_replayed = words_replayed + 1
        let partition = partition4(family, p0, 0, 0, 1)
        if !found && partition.singleton_partition {
            found = true
            found_length = 1
            found0 = p0
        }
        p0 = p0 + 1
    }
    p0 = 0
    while p0 < 3 && !found {
        var p1 = 0
        while p1 < 3 && !found {
            words_replayed = words_replayed + 1
            let partition = partition4(family, p0, p1, 0, 2)
            if partition.singleton_partition {
                found = true
                found_length = 2
                found0 = p0
                found1 = p1
            }
            p1 = p1 + 1
        }
        p0 = p0 + 1
    }
    p0 = 0
    while p0 < 3 && !found {
        var p1 = 0
        while p1 < 3 && !found {
            var p2 = 0
            while p2 < 3 && !found {
                words_replayed = words_replayed + 1
                let partition = partition4(family, p0, p1, p2, 3)
                if partition.singleton_partition {
                    found = true
                    found_length = 3
                    found0 = p0
                    found1 = p1
                    found2 = p2
                }
                p2 = p2 + 1
            }
            p1 = p1 + 1
        }
        p0 = p0 + 1
    }
    assert(found && found_length == 3)
    assert(found0 == 0 && found1 == 1 && found2 == 2)
    assert(words_replayed == 18)
    PresetDyadicExperimentReceipt {
        family_id: family.family_id,
        found: true,
        word_length: found_length,
        worst_case_cost: found_length,
        probe0: found0,
        probe1: found1,
        probe2: found2,
        words_replayed: words_replayed,
        cheaper_words_exhausted: true,
        canonical_enumeration: true,
    }
}

fn exhaustive_adaptive_search_depth2(
    family: DyadicFamily4Receipt,
) -> AdaptiveDyadicExperimentReceipt with Mut, Panic {
    var probe = 0
    while probe < 3 {
        let one_step = partition4(family, probe, 0, 0, 1)
        assert(!one_step.singleton_partition)
        probe = probe + 1
    }
    let root = partition4(family, 0, 0, 0, 1)
    assert(root.block_count == 2)
    let left_child = partition4(family, 0, 1, 0, 2)
    assert(left_child.block0 != left_child.block1)
    let right_child = partition4(family, 0, 2, 0, 2)
    assert(right_child.block2 != right_child.block3)
    AdaptiveDyadicExperimentReceipt {
        family_id: family.family_id,
        found: true,
        root_probe: 0,
        observation400_child_probe: 1,
        observation600_child_probe: 2,
        root_block_count: 2,
        leaf_block_count: 4,
        worst_case_cost: 2,
        one_step_probes_replayed: 3,
        exact_children_replayed: true,
    }
}

fn certify_bounded_minimality(
    family: DyadicFamily4Receipt,
    tree: AdaptiveDyadicExperimentReceipt,
) -> BoundedDyadicMinimalityCertificate with Panic {
    assert(tree.family_id == family.family_id)
    assert(tree.found && tree.worst_case_cost == 2)
    assert(tree.one_step_probes_replayed == 3)
    BoundedDyadicMinimalityCertificate {
        family_id: family.family_id,
        selected_worst_case_cost: 2,
        cheaper_policy_count: 3,
        cheaper_policies_rejected: 3,
        bounded_minimality_established: true,
        search_soundness_formally_verified: false,
        global_minimality_claimed: false,
    }
}

fn bounded_null_ambiguity(
    family_id: i64,
    null_receipt: FactorableDyadicNullReceipt,
) -> LocalHorizonLimitedDyadicAmbiguityReceipt with Panic {
    assert(family_id == null_receipt.family_id)
    assert(null_receipt.every_probe_trace_equal)
    assert(null_receipt.residual_block_count == 1)
    LocalHorizonLimitedDyadicAmbiguityReceipt {
        family_id: family_id,
        horizon_bound: 2,
        residual_block_count: 1,
        bounded_search_complete: true,
        global_dyadic_equivalence_established: false,
    }
}

fn permutation_control(
    family: DyadicFamily4Receipt,
    tree: AdaptiveDyadicExperimentReceipt,
) -> DyadicPermutationControlReceipt with Mut, Panic {
    let original = partition4(family, 0, 1, 2, 3)
    let permuted = DyadicFamily4Receipt {
        family_id: family.family_id,
        rule_id: family.rule_id,
        schema_id: family.schema_id,
        candidate0_id: family.candidate3_id,
        candidate1_id: family.candidate1_id,
        candidate2_id: family.candidate0_id,
        candidate3_id: family.candidate2_id,
        mode0: family.mode3,
        mode1: family.mode1,
        mode2: family.mode0,
        mode3: family.mode2,
        current_states_equal: true,
        histories_distinct: true,
        identifiers_absent_from_observation: true,
        candidate_family_exhaustive: false,
    }
    let permuted_partition = partition4(permuted, 0, 1, 2, 3)
    let permuted_tree = exhaustive_adaptive_search_depth2(permuted)
    assert(original.block_count == permuted_partition.block_count)
    assert(tree.worst_case_cost == permuted_tree.worst_case_cost)
    DyadicPermutationControlReceipt {
        original_block_count: original.block_count,
        permuted_block_count: permuted_partition.block_count,
        original_adaptive_cost: tree.worst_case_cost,
        permuted_adaptive_cost: permuted_tree.worst_case_cost,
        partition_invariant_up_to_labels: true,
        optimal_cost_invariant: true,
    }
}

fn reverse_search_order_control(
    family: DyadicFamily4Receipt,
) -> DyadicSearchOrderControlReceipt with Mut, Panic {
    let probe2 = partition4(family, 2, 0, 0, 1)
    let probe1 = partition4(family, 1, 0, 0, 1)
    let probe0 = partition4(family, 0, 0, 0, 1)
    assert(probe2.block_count == 2)
    assert(probe1.block_count == 2)
    assert(probe0.block_count == 2)
    // C and B leave a three-candidate block that no single child separates.
    assert(trace_equal(family.mode0, family.mode2, 2, 1, 0, 2))
    assert(trace_equal(family.mode2, family.mode3, 1, 0, 0, 2))
    // A is therefore the first complete root even under C,B,A enumeration.
    DyadicSearchOrderControlReceipt {
        canonical_root_probe: 0,
        reverse_root_probe: 0,
        canonical_cost: 2,
        reverse_cost: 2,
        root_and_cost_invariant: true,
    }
}

fn reject_leaking_schema(
    schema_id: i64,
) -> DyadicSchemaRejectionReceipt with Panic {
    let rejected = reject_leaking_dyadic_schema(schema_id, false, true)
    assert(rejected)
    DyadicSchemaRejectionReceipt {
        schema_id: schema_id,
        candidate_or_history_leak_detected: true,
        tomography_validity_rejected: true,
        separation_authorized: false,
    }
}

fn main() with Div, Mut, Panic {
    let schema = declare_dyadic_observation_schema(5101)
    let left = declare_dyadic_participant(5201, 0, 700, 1000, 1000)
    let right = declare_dyadic_participant(5202, 1, 300, 1000, 1000)
    let relation = declare_relational_state(5301, 500, 1000, 1000)
    let context = declare_dyadic_context(5401, 7)

    let h0 = declare_relational_history(5501, 0, 8001, 9001)
    let h1 = declare_relational_history(5502, 1, 8002, 9002)
    let h2 = declare_relational_history(5503, 2, 8003, 9003)
    let h3 = declare_relational_history(5504, 3, 8004, 9004)
    let c0 = declare_dyadic_candidate(5601, 5001, schema, left, right, relation, h0, context)
    let c1 = declare_dyadic_candidate(5602, 5001, schema, left, right, relation, h1, context)
    let c2 = declare_dyadic_candidate(5603, 5001, schema, left, right, relation, h2, context)
    let c3 = declare_dyadic_candidate(5604, 5001, schema, left, right, relation, h3, context)
    let family = declare_family4(5701, c0, c1, c2, c3)

    let bound = authorize_dyadic_product(1000, 1000, 9000000000000000000)
    let collision = prove_dyadic_collision(5801, c0, c2, bound)
    let common_a = declare_common_dyadic_input(5901, 5001, 1, 0, 1, 1)
    let step0 = advance_dyadic_candidate(6001, c0, common_a)
    let step2 = advance_dyadic_candidate(6002, c2, common_a)
    let non_reduction = prove_dyadic_non_reduction(6101, collision, step0, step2, bound)
    assert(non_reduction.exact_separation.signed_cross_difference == -200000)
    assert(non_reduction.exact_separation.cross_denominator == 1000000)

    let adaptive = exhaustive_adaptive_search_depth2(family)
    let preset = exhaustive_preset_search3(family)
    let minimality = certify_bounded_minimality(family, adaptive)
    assert(adaptive.worst_case_cost == 2)
    assert(preset.worst_case_cost == 3)
    assert(minimality.bounded_minimality_established)

    let h4a = declare_relational_history(5510, 4, 8101, 9101)
    let h4b = declare_relational_history(5511, 4, 8102, 9102)
    let null0 = declare_dyadic_candidate(5610, 5001, schema, left, right, relation, h4a, context)
    let null1 = declare_dyadic_candidate(5611, 5001, schema, left, right, relation, h4b, context)
    let null_receipt = prove_factorable_dyadic_null(5710, null0, null1)
    let ambiguity = bounded_null_ambiguity(5710, null_receipt)
    assert(!null_receipt.non_reduction_authorized)
    assert(!ambiguity.global_dyadic_equivalence_established)

    let permutation = permutation_control(family, adaptive)
    let reverse_order = reverse_search_order_control(family)
    let leak = reject_leaking_schema(5102)
    let incomplete = force_dyadic_search_incomplete(5701, 1, 10)
    assert(!incomplete.ambiguity_authorized && !incomplete.minimality_authorized)

    let context_rival = record_context_expansion_rival(6201, 10, 20)
    let markov_rival = record_markov_state_expansion_rival(
        6202, 0, 2, 0,
        step0.result_relational_numerator,
        step2.result_relational_numerator,
    )
    assert(context_rival.omitted_context_explains_separation)
    assert(!context_rival.history_only_claim_authorized)
    assert(markov_rival.markov_factorability_restored)
    assert(markov_rival.participant_product_non_reduction_preserved)
    assert(!markov_rival.unbounded_history_irreducibility_claimed)

    let result = SyntheticDyadicD0Receipt {
        experiment_id: 6301,
        exact_collision_and_reveal: true,
        adaptive_and_preset_search_replayed: true,
        factorable_null_preserved: true,
        identifier_controls_passed: permutation.optimal_cost_invariant &&
            reverse_order.root_and_cost_invariant &&
            leak.tomography_validity_rejected,
        incomplete_search_refused: !incomplete.search_complete,
        context_rival_reported: true,
        markov_expansion_reported: true,
        bounded_synthetic_scope_only: true,
        real_relationship_measured: false,
        subjective_suffering_established: false,
        consent_established: false,
        clinical_authority: false,
    }
    assert(result.exact_collision_and_reveal)
    assert(result.identifier_controls_passed)
    assert(!result.real_relationship_measured)
    assert(!result.subjective_suffering_established)
    assert(!result.consent_established)
    assert(!result.clinical_authority)

    println("D0-W0 current=500/1000 common_probe=A future=400/1000,600/1000 difference=-1/5")
    println("D0-W1 factorable_null=true residual_blocks=1 global_equivalence=false")
    println("D0-W2 permutation=true history_id_leak=rejected reverse_order=true")
    println("D0-W3 one_step_separates=false adaptive_cost=2 preset_cost=3 incomplete_refused=true")
    println("D0-W4 context_rival=explains-control markov_expansion=restores-factorability")
    println("boundary=participant_product_nonreduction history_unbounded_irreducibility=false")
    println("synthetic=true relationship=false suffering=false consent=false clinical=false")
    println("SYNTHETIC DYADIC NON-REDUCTION D0 PASS")
}
