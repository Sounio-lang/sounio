//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-3 Taylor-2 time-slab containment receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    let selected_dt_den: i64 = 100
    let dx_bound: i64 = 4915667
    let dy_bound: i64 = 26215510
    let dz_bound: i64 = 1028873
    let x_sweep: i64 = 49157
    let y_sweep: i64 = 262156
    let z_sweep: i64 = 10289
    let x_margin: i64 = 49500
    let y_margin: i64 = 262500
    let z_margin: i64 = 10500
    let x_slack: i64 = x_margin - x_sweep
    let y_slack: i64 = y_margin - y_sweep
    let z_slack: i64 = z_margin - z_sweep
    if x_slack != 343 { return 1 }
    if y_slack != 344 { return 2 }
    if z_slack != 211 { return 3 }

    var ceil_sweep_mask: i64 = 0
    if (x_sweep - 1) * selected_dt_den < dx_bound {
        if x_sweep * selected_dt_den >= dx_bound { ceil_sweep_mask = ceil_sweep_mask + 1 }
    }
    if (y_sweep - 1) * selected_dt_den < dy_bound {
        if y_sweep * selected_dt_den >= dy_bound { ceil_sweep_mask = ceil_sweep_mask + 2 }
    }
    if (z_sweep - 1) * selected_dt_den < dz_bound {
        if z_sweep * selected_dt_den >= dz_bound { ceil_sweep_mask = ceil_sweep_mask + 4 }
    }
    if ceil_sweep_mask != 7 { return 4 }

    var time_slab_containment_mask: i64 = 0
    if x_sweep <= x_margin { time_slab_containment_mask = time_slab_containment_mask + 1 }
    if y_sweep <= y_margin { time_slab_containment_mask = time_slab_containment_mask + 2 }
    if z_sweep <= z_margin { time_slab_containment_mask = time_slab_containment_mask + 4 }
    if time_slab_containment_mask != 7 { return 5 }

    let local_time_slab_obligation_mask: i64 = 7
    let global_flowpipe_claim_mask: i64 = 0
    let time_slab_status_local: i64 = 13
    let ok_mask: i64 = 255

    var instance_fp: i64 = 1469
    instance_fp = mix(instance_fp, 3, 5297)
    instance_fp = mix(instance_fp, 360827572, 5297)
    instance_fp = mix(instance_fp, 456885748, 5297)
    instance_fp = mix(instance_fp, 417748218, 5297)
    instance_fp = mix(instance_fp, 109213065, 5297)
    instance_fp = mix(instance_fp, 693563916, 5297)
    instance_fp = mix(instance_fp, dx_bound, 5297)
    instance_fp = mix(instance_fp, dy_bound, 5297)
    instance_fp = mix(instance_fp, dz_bound, 5297)
    instance_fp = mix(instance_fp, 1, 5297)
    instance_fp = mix(instance_fp, selected_dt_den, 5297)
    instance_fp = mix(instance_fp, x_sweep, 5297)
    instance_fp = mix(instance_fp, y_sweep, 5297)
    instance_fp = mix(instance_fp, z_sweep, 5297)
    instance_fp = mix(instance_fp, x_margin, 5297)
    instance_fp = mix(instance_fp, y_margin, 5297)
    instance_fp = mix(instance_fp, z_margin, 5297)
    instance_fp = mix(instance_fp, x_slack, 5297)
    instance_fp = mix(instance_fp, y_slack, 5297)
    instance_fp = mix(instance_fp, z_slack, 5297)
    instance_fp = mix(instance_fp, time_slab_containment_mask, 5297)
    instance_fp = mix(instance_fp, local_time_slab_obligation_mask, 5297)
    instance_fp = mix(instance_fp, global_flowpipe_claim_mask, 5297)
    instance_fp = mix(instance_fp, time_slab_status_local, 5297)
    if instance_fp != 604148523 { return 6 }

    var certificate_fp: i64 = 1471
    certificate_fp = mix(certificate_fp, instance_fp, 5303)
    certificate_fp = mix(certificate_fp, dx_bound, 5303)
    certificate_fp = mix(certificate_fp, dy_bound, 5303)
    certificate_fp = mix(certificate_fp, dz_bound, 5303)
    certificate_fp = mix(certificate_fp, 1, 5303)
    certificate_fp = mix(certificate_fp, selected_dt_den, 5303)
    certificate_fp = mix(certificate_fp, x_sweep, 5303)
    certificate_fp = mix(certificate_fp, y_sweep, 5303)
    certificate_fp = mix(certificate_fp, z_sweep, 5303)
    certificate_fp = mix(certificate_fp, x_margin, 5303)
    certificate_fp = mix(certificate_fp, y_margin, 5303)
    certificate_fp = mix(certificate_fp, z_margin, 5303)
    certificate_fp = mix(certificate_fp, x_slack, 5303)
    certificate_fp = mix(certificate_fp, y_slack, 5303)
    certificate_fp = mix(certificate_fp, z_slack, 5303)
    certificate_fp = mix(certificate_fp, time_slab_containment_mask, 5303)
    certificate_fp = mix(certificate_fp, local_time_slab_obligation_mask, 5303)
    certificate_fp = mix(certificate_fp, global_flowpipe_claim_mask, 5303)
    certificate_fp = mix(certificate_fp, time_slab_status_local, 5303)
    certificate_fp = mix(certificate_fp, ok_mask, 5303)
    if certificate_fp != 460379869 { return 7 }

    var artifact_fp: i64 = 1481
    artifact_fp = mix(artifact_fp, instance_fp, 5309)
    artifact_fp = mix(artifact_fp, certificate_fp, 5309)
    artifact_fp = mix(artifact_fp, 14, 5309)
    artifact_fp = mix(artifact_fp, 3, 5309)
    artifact_fp = mix(artifact_fp, time_slab_containment_mask, 5309)
    artifact_fp = mix(artifact_fp, local_time_slab_obligation_mask, 5309)
    artifact_fp = mix(artifact_fp, global_flowpipe_claim_mask, 5309)
    artifact_fp = mix(artifact_fp, time_slab_status_local, 5309)
    artifact_fp = mix(artifact_fp, ok_mask, 5309)
    if artifact_fp != 113001479 { return 8 }
    return 0
}
