//@ run-pass
// Phase 1 of Seq<T>: method syntax (.push/.get/.set/.len) + bounds-checked access.
// Method .push uses a local Seq variable receiver (pointer written back on grow).

fn main() -> i32 with IO, Mut, Panic, Epistemic {
    var s: Seq<i64> = seq_new()
    s.push(5)
    s.push(15)
    s.push(25)

    if s.get(0) != 5 { println("seq_methods: FAIL (get 0)"); return 1 }
    if s.get(2) != 25 { println("seq_methods: FAIL (get 2)"); return 1 }

    s.set(1, 150)
    if s.get(1) != 150 { println("seq_methods: FAIL (set/get)"); return 1 }

    if s.len().unwrap("len") != 3 { println("seq_methods: FAIL (len)"); return 1 }

    // grow through method push (forces realloc + pointer writeback via receiver slot)
    var i = 0
    while i < 30 {
        s.push(i)
        i = i + 1
    }
    if s.len().unwrap("len") != 33 { println("seq_methods: FAIL (grown len)"); return 1 }
    if s.get(32) != 29 { println("seq_methods: FAIL (grown last)"); return 1 }
    if s.get(0) != 5 { println("seq_methods: FAIL (grown first survived)"); return 1 }

    println("seq_methods: PASS")
    return 0
}
