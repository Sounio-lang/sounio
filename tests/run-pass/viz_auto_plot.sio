//@ run-pass
//@ expect-stdout: AUTO_PLOT_PASS
//@ expect-stdout: observation
//@ expect-stdout: DFFITS
//@ expect-stdout: screening
use viz::plot::{viz_auto_plot_axes,viz_plot_share_domain}
use stats::regression::ols::{ols_influence_simple}
use display::canvas::{Canvas,canvas_clear}
use viz::ir::{viz_scene_new,viz_add_line_chart,viz_line_set_viewport,viz_add_axis,
    viz_add_series_legend,viz_node_set_label,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
fn main() with IO, Mut, Div, Alloc, Panic {
    var x:[f64;100]=[0.0;100]
    var y:[f64;100]=[0.0;100]
    var i:i64=0
    while i < 8 {
        x[i as usize]=i as f64
        y[i as usize]=2.0+3.0*(i as f64)
        i=i+1
    }
    y[1]=y[1]+0.5;y[4]=y[4]-0.25;y[7]=y[7]+2.0
    let d=ols_influence_simple(&x,&y,8)
    assert(d.status == 0 && d.valid_count == 8)
    var xs:[f64;1024]=[0.0;1024]
    var ys:[f64;1024]=[0.0;1024]
    var upper:[f64;1024]=[0.0;1024]
    var lower:[f64;1024]=[0.0;1024]
    i=0
    while i < 8 {
        assert(d.dffits_status[i as usize] == 0)
        xs[i as usize]=(i+1) as f64
        ys[i as usize]=d.dffits[i as usize]
        upper[i as usize]=d.screening_cutoff
        lower[i as usize]=0.0-d.screening_cutoff
        i=i+1
    }
    var scene=viz_scene_new()
    let curve=viz_add_line_chart(&!scene,&xs,&ys,8,viz_layout_rect(130,35,560,180),viz_style_rgb(80,180,240))
    let up=viz_add_line_chart(&!scene,&xs,&upper,8,viz_layout_rect(130,35,560,180),viz_style_rgb(245,160,70))
    let down=viz_add_line_chart(&!scene,&xs,&lower,8,viz_layout_rect(130,35,560,180),viz_style_rgb(245,160,70))
    let axes=viz_auto_plot_axes(&!scene,curve,viz_style_rgb(180,190,210))
    assert(axes.status == 0)
    let xa:i64=axes.x_axis
    let ya:i64=axes.y_axis
    assert(viz_plot_share_domain(&!scene,curve,up))
    assert(viz_plot_share_domain(&!scene,curve,down))
    assert(scene.series[0].x_min == scene.nodes[xa as usize].min_value)
    assert(scene.series[0].x_max == scene.nodes[xa as usize].max_value)
    assert(scene.series[0].y_min == scene.nodes[ya as usize].min_value)
    assert(scene.series[0].y_max == scene.nodes[ya as usize].max_value)
    assert(scene.series[1].x_min == scene.series[0].x_min)
    assert(scene.series[1].y_max == scene.series[0].y_max)
    assert(scene.series[2].y_min == scene.series[0].y_min)
    assert(scene.series[0].y_max >= d.dffits[7])
    assert(scene.series[0].y_min <= 0.0-d.screening_cutoff && scene.series[0].y_max >= d.screening_cutoff)
    assert(xa == 3 && ya == 4)
    var observation:[i8;64]=[0;64]
    observation[0]=111
    observation[1]=98
    observation[2]=115
    observation[3]=101
    observation[4]=114
    observation[5]=118
    observation[6]=97
    observation[7]=116
    observation[8]=105
    observation[9]=111
    observation[10]=110
    var dffits:[i8;64]=[0;64]
    dffits[0]=68
    dffits[1]=70
    dffits[2]=70
    dffits[3]=73
    dffits[4]=84
    dffits[5]=83
    var threshold:[i8;64]=[0;64]
    threshold[0]=115
    threshold[1]=99
    threshold[2]=114
    threshold[3]=101
    threshold[4]=101
    threshold[5]=110
    threshold[6]=105
    threshold[7]=110
    threshold[8]=103
    threshold[9]=32
    threshold[10]=43
    threshold[11]=47
    threshold[12]=45
    threshold[13]=50
    threshold[14]=32
    threshold[15]=115
    threshold[16]=113
    threshold[17]=114
    threshold[18]=116
    threshold[19]=40
    threshold[20]=50
    threshold[21]=47
    threshold[22]=110
    threshold[23]=41
    viz_node_set_label(&!scene,xa,&observation,11)
    viz_node_set_label(&!scene,ya,&dffits,6)
    assert(viz_add_series_legend(&!scene,curve,&dffits,6,viz_layout_rect(130,275,160,22)) >= 0)
    assert(viz_add_series_legend(&!scene,up,&threshold,24,viz_layout_rect(320,275,300,22)) >= 0)
    assert(scene.node_count == 7 && scene.series_count == 3)
    let pixels=heap_alloc(800*320*8) as *mut i64
    var canvas=Canvas{pixels:pixels,width:800,height:320}
    canvas_clear(&!canvas,0,0,0)
    viz_canvas_render_scene(&scene,&!canvas)
    viz_html_emit_scene(&scene,800,320)
    // The active graph, IDs, and domains survive every rejected operation.
    let before_id:i64=scene.next_node_id
    scene.node_count=63
    let capacity=viz_auto_plot_axes(&!scene,curve,viz_style_rgb(1,2,3))
    assert(capacity.status == 2 && scene.node_count == 63 && scene.next_node_id == before_id)
    scene.node_count=7
    let prior_min:f64=scene.series[0].x_min
    let prior_max:f64=scene.series[0].x_max
    scene.series[0].x_min=1.0e12
    scene.series[0].x_max=1.0e12+7.0
    let labels=viz_auto_plot_axes(&!scene,curve,viz_style_rgb(1,2,3))
    assert(labels.status == 3 && scene.node_count == 7 && scene.next_node_id == before_id)
    assert(scene.series[0].x_min == 1.0e12 && scene.series[0].x_max == 1.0e12+7.0)
    scene.series[0].x_min=prior_min;scene.series[0].x_max=prior_max
    let bad=viz_add_line_chart(&!scene,&xs,&ys,8,viz_layout_rect(0,0,100,100),viz_style_rgb(1,2,3))
    let old_x:f64=scene.series[3].x_min
    assert(!viz_plot_share_domain(&!scene,curve,bad))
    assert(scene.series[3].x_min == old_x && scene.nodes[bad as usize].flags == 0)
    assert(viz_auto_plot_axes(&!scene,-1,viz_style_rgb(1,2,3)).status == 1)
    assert(viz_auto_plot_axes(&!scene,bad,viz_style_rgb(1,2,3)).status == 1)
    println("AUTO_PLOT_PASS")
    0
}
