    if manifest_fp != 592974800 { return 2 }

    let result_coverage_fp = solver_portfolio_v19_result_coverage_fingerprint(
        19, 23, 8, 13, 1, 1, manifest_fp)
    if result_coverage_fp != 474634520 { return 3 }

    let family_coverage_fp = solver_portfolio_v19_checker_family_coverage_fingerprint(
        19, 23, 4, 3, 2, 1, 13, manifest_fp)
    if family_coverage_fp != 17942049 { return 4 }

    let acceptance_fp = solver_portfolio_v19_acceptance_receipt_fingerprint(
