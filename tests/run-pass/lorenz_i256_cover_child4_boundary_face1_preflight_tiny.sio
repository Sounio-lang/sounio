//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-4 boundary face1 preflight

fn child4_boundary_face1_preflight_check(
    child4_boundary_face0_preflight_fp: i64,
    child4_boundary_face0_preflight_audit_fp: i64,
    child4_boundary_face_obligations_fp: i64,
    child4_boundary_face_obligations_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    face_obligation_mask: i64,
    prior_face_preflight_mask: i64,
    selected_face_index: i64,
    selected_face_mask: i64,
    face1_obligation_mask: i64,
    face1_verified_mask: i64,
    face1_proof_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    face1_preflight_status: i64) -> i64 {
    if child4_boundary_face0_preflight_fp != 629184705 { return 0 - 1 }
    if child4_boundary_face0_preflight_audit_fp != 884062113 { return 0 - 1 }
    if child4_boundary_face_obligations_fp != 458306927 { return 0 - 1 }
    if child4_boundary_face_obligations_audit_fp != 766184391 { return 0 - 1 }
    if boundary_gluing_obligation_mask != 31 { return 0 - 1 }
    if face_obligation_mask != 31 { return 0 - 1 }
    if prior_face_preflight_mask != 1 { return 0 - 1 }
    if selected_face_index != 1 { return 0 - 1 }
    if selected_face_mask != 2 { return 0 - 1 }
    if face1_obligation_mask != 2 { return 0 - 1 }
    if face1_verified_mask != 0 { return 0 - 1 }
    if face1_proof_mask != 0 { return 0 - 1 }
    if boundary_gluing_verified_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if face1_preflight_status != 82 { return 0 - 1 }
    return 715930842
}

fn main() -> i64 {
    let artifact = child4_boundary_face1_preflight_check(
        629184705, 884062113, 458306927, 766184391, 31, 31, 1, 1, 2, 2,
        0, 0, 0, 0, 0, 0, 0, 82)
    if artifact != 715930842 { return 1 }

    let audit_fp: i64 = 268401557
    let instance_fp: i64 = 834572019
    let certificate_fp: i64 = 450916328
    let boundary_face_count: i64 = 5
    let face1_topology_mask: i64 = 2
    let face1_orientation_mask: i64 = 2
    let face1_adjacency_mask: i64 = 2
    let face1_trace_mask: i64 = 2
    let face1_dependency_mask: i64 = 3
    let face1_preflight_mask: i64 = 2
    let face_preflight_progress_mask: i64 = 3
    let face1_pending_proof_mask: i64 = 2
    let solver_face1_action_mask: i64 = 2
    let ready_for_face1_proof_mask: i64 = 0
    let ok_mask: i64 = 255

    if audit_fp != 268401557 { return 2 }
    if instance_fp != 834572019 { return 3 }
    if certificate_fp != 450916328 { return 4 }
    if boundary_face_count != 5 { return 5 }
    if face1_topology_mask != 2 { return 6 }
    if face1_orientation_mask != 2 { return 7 }
    if face1_adjacency_mask != 2 { return 8 }
    if face1_trace_mask != 2 { return 9 }
    if face1_dependency_mask != 3 { return 10 }
    if face1_preflight_mask != 2 { return 11 }
    if face_preflight_progress_mask != 3 { return 12 }
    if face1_pending_proof_mask != 2 { return 13 }
    if solver_face1_action_mask != 2 { return 14 }
    if ready_for_face1_proof_mask != 0 { return 15 }
    if ok_mask != 255 { return 16 }

    let wrong_face0 = child4_boundary_face1_preflight_check(
        1, 884062113, 458306927, 766184391, 31, 31, 1, 1, 2, 2,
        0, 0, 0, 0, 0, 0, 0, 82)
    if wrong_face0 != 0 - 1 { return 17 }

    let wrong_prior = child4_boundary_face1_preflight_check(
        629184705, 884062113, 458306927, 766184391, 31, 31, 0, 1, 2, 2,
        0, 0, 0, 0, 0, 0, 0, 82)
    if wrong_prior != 0 - 1 { return 18 }

    let wrong_face_index = child4_boundary_face1_preflight_check(
        629184705, 884062113, 458306927, 766184391, 31, 31, 1, 0, 2, 2,
        0, 0, 0, 0, 0, 0, 0, 82)
    if wrong_face_index != 0 - 1 { return 19 }

    let fake_face1_proof = child4_boundary_face1_preflight_check(
        629184705, 884062113, 458306927, 766184391, 31, 31, 1, 1, 2, 2,
        0, 1, 0, 0, 0, 0, 0, 82)
    if fake_face1_proof != 0 - 1 { return 20 }

    let fake_global = child4_boundary_face1_preflight_check(
        629184705, 884062113, 458306927, 766184391, 31, 31, 1, 1, 2, 2,
        0, 0, 0, 0, 0, 0, 1, 82)
    if fake_global != 0 - 1 { return 21 }

    return 0
}
