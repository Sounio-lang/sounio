//@ run-pass
//@ requires: madaros
//@ expect-stdout: EPISTEMIC_MEET_SECOND_ORDER_OK
//@ description: A meet result carries second order: its Hessian is the weighted sum of the sources' Hessians, so hessian_of and second_order_mean of the fusion are exact. Expected values: tests/oracles/epistemic_meet/meet_second_order.cpp.

fn close_rel(got: f64, want: f64) -> bool with Mut, Div {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    var w = want
    if w < 0.0 { w = 0.0 - w }
    d <= 1.0e-15 + 1.0e-12 * w
}
fn report(name: string, got: f64, want: f64) -> i64 with IO, Mut, Div {
    print(name)
    print(" ")
    print_f64(got)
    if close_rel(got, want) {
        print(" ok\n")
        return 0
    }
    print(" FAIL\n")
    1
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    var bad: i64 = 0
    let kc = measure(2.0, uncertainty: 0.1)
    let kb = measure(0.0, uncertainty: 0.3)
    let c = kc.value
    let a = c * c
    let b = 4.1 + kb.value
    let m = meet(a, b)
    bad = bad + report("meet", m, 4.064)
    bad = bad + report("var", variance_of(m), 0.0576)
    bad = bad + report("hessian00", hessian_of(m, 0, 0), 0.72)
    bad = bad + report("mean2", second_order_mean(m), 4.0676)
    if bad == 0 {
        print("EPISTEMIC_MEET_SECOND_ORDER_OK\n")
        return 0
    }
    1
}
