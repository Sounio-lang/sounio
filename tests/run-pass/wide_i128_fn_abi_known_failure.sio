//@ run-pass
//@ requires: madaros
//@ description: Regression pin that source-level i128 values survive user-defined function parameter and return boundaries

fn is42(x: i128) -> i64 {
    if x == (42 as i128) { return 0 }
    return 1
}

fn add_one(x: i128) -> i128 {
    let y: i128 = x + (1 as i128)
    return y
}

fn main() -> i64 {
    if is42(42 as i128) != 0 { return 1 }

    let y: i128 = add_one(41 as i128)
    if y != (42 as i128) { return 2 }

    return 0
}
