//@ run-pass
// Test: ODE bridge with user-defined RHS function
// Solves dy/dt = -y with y(0) = 1.0 using inline RK4
// Analytical solution: y(t) = exp(-t)
//
// Rewritten to avoid dynamic arrays and solve_ode builtin
// (lean_single only supports fixed-size arrays)

fn ode_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i64 with IO, Mut, Div, Panic {
    // RK4 for dy/dt = -y, y(0)=1.0, from t=0 to t=2.0 with dt=0.01
    // 200 steps
    let dt = 0.01
    var y = 1.0
    var t = 0.0
    var step = 0
    while step < 200 {
        // k1 = f(t, y) = -y
        let k1 = 0.0 - y
        // k2 = f(t + dt/2, y + dt/2 * k1)
        let k2 = 0.0 - (y + 0.5 * dt * k1)
        // k3 = f(t + dt/2, y + dt/2 * k2)
        let k3 = 0.0 - (y + 0.5 * dt * k2)
        // k4 = f(t + dt, y + dt * k3)
        let k4 = 0.0 - (y + dt * k3)
        y = y + (dt / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
        t = t + dt
        step = step + 1
    }

    // y(2.0) should be exp(-2) ≈ 0.1353352832366127
    let expected = 0.1353352832366127
    let error = ode_abs(y - expected)

    // RK4 should be accurate to ~1e-8 with dt=0.01
    if error > 0.001 {
        println("FAIL: ODE bridge test failed")
        return 1
    }
    println("ODE bridge test passed: y(2) correct")
    return 0
}
