//@ run-pass
// Test: ODE bridge with user-defined RHS function
// Solves dy/dt = -y with y(0) = 1.0
// Analytical solution: y(t) = exp(-t)

fn exp_decay(t: f64, y: [f64]) -> [f64] {
    let dydt = [0.0 - y[0]]
    return dydt
}

fn main() {
    let y0 = [1.0]
    let sol = solve_ode(exp_decay, y0, 0.0, 2.0, 0.01)

    // Check final value: y(2) = exp(-2) ~ 0.1353
    let final_y = sol.y[sol.y.len() - 1]
    let expected = 0.1353352832366127
    let error = final_y[0] - expected
    if error < 0.0 {
        error = 0.0 - error
    }

    // RK4 should be accurate to ~1e-8 with dt=0.01
    assert(error < 0.001)
    println("ODE bridge test passed: y(2) = ", final_y[0])
}
