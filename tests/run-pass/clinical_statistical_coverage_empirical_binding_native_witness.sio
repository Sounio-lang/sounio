//@ run-pass
// Standalone exact executor for proof-carrying statistical coverage D9.

struct D9NativeEnumeration {
    total_designs: i64,
    positive_designs: i64,
    positivity_failures: i64,
    support_1: i64,
    support_2: i64,
    support_3: i64,
    support_4: i64,
    coverage_2: i64,
    coverage_3: i64,
    coverage_4: i64,
    coverage_5: i64,
    coverage_6: i64,
    coverage_7: i64,
    coverage_8: i64,
    coverage_9: i64,
    coverage_10: i64,
    adequate_designs: i64,
}

fn d9_native_positive(value: i64) -> i64 {
    if value > 0 { 1 } else { 0 }
}

fn d9_native_enumerate_designs() -> D9NativeEnumeration with Mut, Panic {
    var total: i64 = 0
    var positive: i64 = 0
    var failures: i64 = 0
    var support_1: i64 = 0
    var support_2: i64 = 0
    var support_3: i64 = 0
    var support_4: i64 = 0
    var coverage_2: i64 = 0
    var coverage_3: i64 = 0
    var coverage_4: i64 = 0
    var coverage_5: i64 = 0
    var coverage_6: i64 = 0
    var coverage_7: i64 = 0
    var coverage_8: i64 = 0
    var coverage_9: i64 = 0
    var coverage_10: i64 = 0
    var adequate: i64 = 0
    var w0: i64 = 0
    while w0 <= 12 {
        var w1: i64 = 0
        while w0 + w1 <= 12 {
            var w2: i64 = 0
            while w0 + w1 + w2 <= 12 {
                let w3 = 12 - w0 - w1 - w2
                let support = d9_native_positive(w0) +
                    d9_native_positive(w1) + d9_native_positive(w2) +
                    d9_native_positive(w3)
                total = total + 1
                if support == 1 { support_1 = support_1 + 1 }
                if support == 2 { support_2 = support_2 + 1 }
                if support == 3 { support_3 = support_3 + 1 }
                if support == 4 {
                    support_4 = support_4 + 1
                    positive = positive + 1
                    let whole = w0 + w3
                    if whole == 2 { coverage_2 = coverage_2 + 1 }
                    if whole == 3 { coverage_3 = coverage_3 + 1 }
                    if whole == 4 { coverage_4 = coverage_4 + 1 }
                    if whole == 5 { coverage_5 = coverage_5 + 1 }
                    if whole == 6 { coverage_6 = coverage_6 + 1 }
                    if whole == 7 { coverage_7 = coverage_7 + 1 }
                    if whole == 8 { coverage_8 = coverage_8 + 1 }
                    if whole == 9 { coverage_9 = coverage_9 + 1 }
                    if whole == 10 { coverage_10 = coverage_10 + 1 }
                    if whole * 4 >= 3 * 12 { adequate = adequate + 1 }
                } else {
                    failures = failures + 1
                }
                w2 = w2 + 1
            }
            w1 = w1 + 1
        }
        w0 = w0 + 1
    }
    D9NativeEnumeration {
        total_designs: total,
        positive_designs: positive,
        positivity_failures: failures,
        support_1: support_1,
        support_2: support_2,
        support_3: support_3,
        support_4: support_4,
        coverage_2: coverage_2,
        coverage_3: coverage_3,
        coverage_4: coverage_4,
        coverage_5: coverage_5,
        coverage_6: coverage_6,
        coverage_7: coverage_7,
        coverage_8: coverage_8,
        coverage_9: coverage_9,
        coverage_10: coverage_10,
        adequate_designs: adequate,
    }
}

fn d9_native_check_design_collision() with Panic {
    let a_w0 = 5
    let a_w1 = 1
    let a_w2 = 1
    let a_w3 = 5
    let b_w0 = 1
    let b_w1 = 5
    let b_w2 = 5
    let b_w3 = 1
    let a_whole = a_w0 + a_w3
    let b_whole = b_w0 + b_w3
    let a_member_a = a_w0 + a_w1 + a_w3
    let a_member_b = a_w0 + a_w2 + a_w3
    let b_member_a = b_w0 + b_w1 + b_w3
    let b_member_b = b_w0 + b_w2 + b_w3
    assert(a_whole == 10 && b_whole == 2)
    assert(a_member_a == 11 && a_member_b == 11)
    assert(b_member_a == 7 && b_member_b == 7)
    assert(a_whole * 1000 == 833 * 12 + 4)
    assert(b_whole * 1000 == 166 * 12 + 8)
    assert(a_whole * 4 == 40 && 3 * 12 == 36)
    assert(b_whole * 4 == 8)
    let realized_region_a = 3
    let realized_region_b = 3
    assert(realized_region_a == realized_region_b)
    assert(a_whole != b_whole)
}

fn d9_native_check_selection_and_authority() with Mut, Panic {
    let marginal_covered = 9
    let marginal_total = 10
    let common_covered = 9
    let common_total = 9
    let rare_covered = 0
    let rare_total = 1
    let selected_covered = rare_covered
    let selected_total = rare_total
    assert(common_covered == common_total)
    assert(marginal_covered * common_total != common_covered * marginal_total)
    assert(selected_covered == 0 && selected_total == 1)
    assert(marginal_covered * selected_total !=
        selected_covered * marginal_total)

    var eligible: i64 = 0
    var abstain: i64 = 0
    var calibration: i64 = 0
    while calibration <= 1 {
        var positivity: i64 = 0
        while positivity <= 1 {
            var compatibility: i64 = 0
            while compatibility <= 1 {
                if calibration == 1 && positivity == 1 && compatibility == 1 {
                    eligible = eligible + 1
                } else {
                    abstain = abstain + 1
                }
                compatibility = compatibility + 1
            }
            positivity = positivity + 1
        }
        calibration = calibration + 1
    }
    assert(eligible == 1 && abstain == 7)
}

fn d9_native_check_external_evaluation() with Panic {
    let calibration_covered = 286
    let calibration_total = 377
    let evaluation_covered = 265
    let evaluation_total = 375
    assert(calibration_covered * 1000 == 758 * calibration_total + 234)
    assert(evaluation_covered * 1000 == 706 * evaluation_total + 250)
    assert(calibration_covered * 4 >= 3 * calibration_total)
    assert(evaluation_covered * 4 < 3 * evaluation_total)
    assert(1125 + calibration_total + evaluation_total == 1877)
    assert(1877 + 8 == 1885)
    let reason_mask = 2 + 4 + 32 + 64 + 128
    assert(reason_mask == 230)
}

fn main() with Mut, Panic {
    d9_native_check_design_collision()
    let enumeration = d9_native_enumerate_designs()
    assert(enumeration.total_designs == 455)
    assert(enumeration.positive_designs == 165)
    assert(enumeration.positivity_failures == 290)
    assert(enumeration.support_1 == 4 && enumeration.support_2 == 66)
    assert(enumeration.support_3 == 220 && enumeration.support_4 == 165)
    assert(enumeration.coverage_2 == 9 && enumeration.coverage_3 == 16)
    assert(enumeration.coverage_4 == 21 && enumeration.coverage_5 == 24)
    assert(enumeration.coverage_6 == 25 && enumeration.coverage_7 == 24)
    assert(enumeration.coverage_8 == 21 && enumeration.coverage_9 == 16)
    assert(enumeration.coverage_10 == 9)
    assert(enumeration.adequate_designs == 25)
    d9_native_check_selection_and_authority()
    d9_native_check_external_evaluation()

    println("D9-W0 target_mask=3 procedure_masks=3,1,2,7 outcomes=4 total_mass=12")
    println("D9-W1 design_a=5,1,1,5 whole=10/12 memberwise=11/12 permille=833 remainder=4 adequate=true")
    println("D9-W2 design_b=1,5,5,1 whole=2/12 memberwise=7/12 permille=166 remainder=8 adequate=false")
    println("D9-W3 same_realized_region=3 different_procedure_coverage=true identified_set_is_confidence_region=false")
    println("D9-W4 total_designs=455 positive=165 positivity_failures=290 support_histogram=4,66,220,165")
    print("D9-W5 positive_coverage_histogram=2:9,3:16,4:21,5:24,6:25,")
    println("7:24,8:21,9:16,10:9 adequate_at_3/4=25")
    println("D9-W6 marginal=9/10 rare_group=0/1 selected=0/1 marginal_is_selected=false")
    println("D9-W7 eligibility_combinations=8 eligible=1 abstain=7 failure_masks=1,2,4")
    println("D9-W8 same_table_bytes=true same_numeric_region=true lineage_substitutable=false integrity=false custody=false")
    println("D9-W9 predictive_set_is_confidence_region=false patient_state=0 clinical_authority=0")
    println("D9-E0 rows=1885 eligible=1877 semeron_excluded=8 development=1125 calibration=377 evaluation=375")
    println("D9-E1 calibration_covered=286/377 permille=758 remainder=234 adequate=true")
    println("D9-E2 evaluation_covered=265/375 permille=706 remainder=250 adequate=false")
    println("D9-E3 support_compatible=true empirical_binding=false abstention_reason_mask=230")
    println("D9-E4 custody=false sealed=false patient_state=false clinical_authority=false")
    println("STATISTICAL COVERAGE AND EMPIRICAL BINDING D9 PASS")
}
