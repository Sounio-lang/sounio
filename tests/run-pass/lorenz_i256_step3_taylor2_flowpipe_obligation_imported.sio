//@ description: Imported Lorenz i256 step-3 Taylor-2 flowpipe obligation checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step3_taylor2_flowpipe_obligation_check(
        113001479, 175704874, 360827572, 456885748, 116883728,
        84354264, 693563916, 465507112, 389654052, 790630993, 0, 0, 20)
    if artifact_fp != 743452338 { return 1 }
    let audit_fp = lorenz_i256_step3_taylor2_flowpipe_obligation_audit_fingerprint(
        artifact_fp, 437093534, 810964111, 113001479, 175704874,
        360827572, 456885748, 116883728, 84354264, 693563916,
        465507112, 389654052, 790630993, 3, 20, 255)
    if audit_fp != 255714212 { return 2 }
