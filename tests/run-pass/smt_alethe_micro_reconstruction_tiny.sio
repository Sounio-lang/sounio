//@ run-pass
//@ description: Tiny Alethe-style SMT assumption-core reconstruction smoke

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var fp: i64 = 181
    fp = mix(fp, 796206516, 2843)
    fp = mix(fp, 106325289, 2843)
    fp = mix(fp, 666359709, 2843)
    fp = mix(fp, 1, 2843)
    fp = mix(fp, 1, 2843)
    fp = mix(fp, 2, 2843)
    fp = mix(fp, 2, 2843)
    fp = mix(fp, 4, 2843)
    fp = mix(fp, 1, 2843)
    fp = mix(fp, 0, 2843)
    fp = mix(fp, 63, 2843)
    if fp != 580810113 { return 1 }

    var audit_fp: i64 = 191
    audit_fp = mix(audit_fp, fp, 2851)
    audit_fp = mix(audit_fp, 796206516, 2851)
    audit_fp = mix(audit_fp, 106325289, 2851)
    audit_fp = mix(audit_fp, 666359709, 2851)
    audit_fp = mix(audit_fp, 770769284, 2851)
    audit_fp = mix(audit_fp, 63, 2851)
    if audit_fp != 72583387 { return 2 }
    return 0
}
