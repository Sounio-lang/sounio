//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 projection into validated ball enclosure smoke

use systems::lorenz_i256_cert::*

fn main() -> i64 with Mod {
    let inclusion_fp = lorenz_i256_trajectory5_projection_inclusion_fingerprint(
        214180161, 5309941770, 10058731223, 4084837935,
        32, 1000000,
        1236317, 687511168,
        2341980, 3715113920,
        951075, 1913956800,
        992950, 1479682,
        2022339, 2661619,
        908630, 993526)
    if inclusion_fp != 890086395 { return 1 }

    let contract_fp = lorenz_i256_trajectory5_projection_contract_fingerprint(
        214180161, inclusion_fp, 565673886, 70877465, 7)
    if contract_fp != 607091799 { return 2 }

    if lorenz_i256_trajectory5_projection_inclusion_fingerprint(
        214180161, 5309941770, 10058731223, 4084837935,
        32, 1000000,
        1236317, 687511169,
        2341980, 3715113920,
        951075, 1913956800,
        992950, 1479682,
        2022339, 2661619,
        908630, 993526) != (0 - 1) { return 3 }
    if lorenz_i256_trajectory5_projection_contract_fingerprint(
        214180161, inclusion_fp, 565673887, 70877465, 7) != (0 - 1) { return 4 }

    return 0
}
