//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-4-to-step-5 local-flowpipe bridge keeps global claim closed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    let proof_mask: i64 = 15
    let seed_mask: i64 = 15
    let chain_mask: i64 = 15
    var bridge_mask: i64 = 0
    bridge_mask = bridge_mask + 1
    bridge_mask = bridge_mask + 2
    bridge_mask = bridge_mask + 4
    bridge_mask = bridge_mask + 8
    if bridge_mask != 15 { return 1 }

    var extension_mask: i64 = 0
    if proof_mask == 15 { extension_mask = extension_mask + 1 }
    if seed_mask == 15 { extension_mask = extension_mask + 2 }
    if chain_mask == 15 { extension_mask = extension_mask + 4 }
    if bridge_mask == 15 { extension_mask = extension_mask + 8 }
    if extension_mask != 15 { return 2 }

    let global_claim_mask: i64 = 0
    let status: i64 = 25
    let ok_mask: i64 = 255
    if global_claim_mask != 0 { return 3 }

    var inst: i64 = 1667
    inst = mix(inst, 354200144, 5533)
    inst = mix(inst, 97568991, 5533)
    inst = mix(inst, 563331437, 5533)
    inst = mix(inst, 684718822, 5533)
    inst = mix(inst, 737039167, 5533)
    inst = mix(inst, 753371133, 5533)
    inst = mix(inst, 23144051, 5533)
    inst = mix(inst, 561641681, 5533)
    inst = mix(inst, 4, 5533)
    inst = mix(inst, 4, 5533)
    inst = mix(inst, 5, 5533)
    inst = mix(inst, 256, 5533)
    inst = mix(inst, 32, 5533)
    inst = mix(inst, 1, 5533)
    inst = mix(inst, 100, 5533)
    inst = mix(inst, 4617762706, 5533)
    inst = mix(inst, 7643846696, 5533)
    inst = mix(inst, 4120687759, 5533)
    inst = mix(inst, 4920371098, 5533)
    inst = mix(inst, 8816077911, 5533)
    inst = mix(inst, 4092986080, 5533)
    inst = mix(inst, proof_mask, 5533)
    inst = mix(inst, seed_mask, 5533)
    inst = mix(inst, chain_mask, 5533)
    inst = mix(inst, bridge_mask, 5533)
    inst = mix(inst, extension_mask, 5533)
    inst = mix(inst, global_claim_mask, 5533)
    inst = mix(inst, status, 5533)
    if inst != 274535943 { return 4 }

    var cert: i64 = 1669
    cert = mix(cert, inst, 5557)
    cert = mix(cert, proof_mask, 5557)
    cert = mix(cert, seed_mask, 5557)
    cert = mix(cert, chain_mask, 5557)
    cert = mix(cert, bridge_mask, 5557)
    cert = mix(cert, extension_mask, 5557)
    cert = mix(cert, global_claim_mask, 5557)
    cert = mix(cert, status, 5557)
    cert = mix(cert, 4, 5557)
    cert = mix(cert, 4, 5557)
    cert = mix(cert, 5, 5557)
    cert = mix(cert, 256, 5557)
    cert = mix(cert, 32, 5557)
    cert = mix(cert, 1, 5557)
    cert = mix(cert, 100, 5557)
    cert = mix(cert, ok_mask, 5557)
    if cert != 889322717 { return 5 }

    var artifact: i64 = 1693
    artifact = mix(artifact, inst, 5563)
    artifact = mix(artifact, cert, 5563)
    artifact = mix(artifact, 17, 5563)
    artifact = mix(artifact, 4, 5563)
    artifact = mix(artifact, 4, 5563)
    artifact = mix(artifact, 5, 5563)
    artifact = mix(artifact, proof_mask, 5563)
    artifact = mix(artifact, bridge_mask, 5563)
    artifact = mix(artifact, extension_mask, 5563)
    artifact = mix(artifact, global_claim_mask, 5563)
    artifact = mix(artifact, status, 5563)
    artifact = mix(artifact, ok_mask, 5563)
    if artifact != 880867663 { return 6 }

    var audit: i64 = 1697
    audit = mix(audit, artifact, 5569)
    audit = mix(audit, inst, 5569)
    audit = mix(audit, cert, 5569)
    audit = mix(audit, 354200144, 5569)
    audit = mix(audit, 97568991, 5569)
    audit = mix(audit, 563331437, 5569)
    audit = mix(audit, 684718822, 5569)
    audit = mix(audit, 737039167, 5569)
    audit = mix(audit, 753371133, 5569)
    audit = mix(audit, 23144051, 5569)
    audit = mix(audit, 561641681, 5569)
    audit = mix(audit, 4, 5569)
    audit = mix(audit, 4, 5569)
    audit = mix(audit, 5, 5569)
    audit = mix(audit, status, 5569)
    audit = mix(audit, ok_mask, 5569)
    if audit != 674753000 { return 7 }
    return 0
}
