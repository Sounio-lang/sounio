//@ check-only
//@ requires: madaros
//
// An array literal of Knowledge values that differ only in the epsilon
// annotation is well typed: the element type is the weakest bound/floor every
// element satisfies. It was E020 ("array elements must all have the same
// type"), because a tighter bound satisfies a looser one and never the reverse,
// so the mutual-subsumption join could not hold for any two distinct epsilons.
// check-only: Madaros lowering still refuses Knowledge containers (#3546).

fn main() -> i64 with IO, Mut, Panic, Div, Alloc, Epistemic {
    let a: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let b: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    let ks: [Knowledge<f64>; 2] = [a, b]
    let ls: [Knowledge<f64>; 2] = [measure(1.0, uncertainty: 0.1), measure(3.0, uncertainty: 0.2)]
    0
}
