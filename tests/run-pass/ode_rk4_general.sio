//@ run-pass
// General-Purpose RK4 ODE Solver Tests
//
// Tests a classical 4th-order Runge-Kutta integrator on four canonical ODEs:
//   1. Exponential decay:   du/dt = -k*u
//   2. Harmonic oscillator: dx/dt = v, dv/dt = -omega^2*x
//   3. Logistic growth:     du/dt = r*u*(1 - u/K)
//   4. Stiff linear decay:  du/dt = -50*u
//
// Plus trivial ODEs (zero RHS, constant RHS) and convergence order verification.
// All functions inlined since tests cannot import.
//
// References:
//   Hairer, Norsett, Wanner (1993) "Solving ODEs I: Nonstiff Problems"
//   Butcher (2008) "Numerical Methods for ODEs"

// ============================================================================
// MATH HELPERS (must precede callers)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn exp_approx(x: f64) -> f64 with Mut, Panic, Div {
    // Taylor series for e^x, good for small |x|
    // Split large x: e^x = e^(x/2) * e^(x/2)
    if x > 10.0 {
        let half = exp_approx(x / 2.0)
        return half * half
    }
    if x < 0.0 - 10.0 { return 1.0 / exp_approx(0.0 - x) }
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n <= 25 {
        term = term * x / (n as f64)
        sum = sum + term
        n = n + 1
    }
    return sum
}

fn sin_approx(x: f64) -> f64 with Mut, Panic, Div {
    let pi = 3.141592653589793
    let two_pi = 6.283185307179586
    var a = x
    // Range reduction
    if a > two_pi || a < 0.0 - two_pi {
        let n = (a / two_pi) as i32
        a = a - (n as f64) * two_pi
    }
    while a > pi { a = a - two_pi }
    while a < 0.0 - pi { a = a + two_pi }
    let a2 = a * a
    var sum = a
    var term = a
    var n = 1
    while n < 18 {
        term = 0.0 - term * a2 / ((2 * n) * (2 * n + 1)) as f64
        sum = sum + term
        n = n + 1
    }
    return sum
}

fn cos_approx(x: f64) -> f64 with Mut, Panic, Div {
    return sin_approx(x + 1.5707963267948966)
}

// ============================================================================
// STATE STRUCTS
// ============================================================================

struct ScalarState {
    u: f64,
    t: f64,
}

struct Vec2State {
    x: f64,
    y: f64,
    t: f64,
}

// ScalarState/Vec2State return from helpers is zeroed by codegen — use globals
var SCAL_W: ScalarState = ScalarState { u: 0.0, t: 0.0 }
var VEC2_W: Vec2State = Vec2State { x: 0.0, y: 0.0, t: 0.0 }

// ============================================================================
// ODE 1: EXPONENTIAL DECAY  du/dt = -k*u,  k=0.1
// Analytical: u(t) = u0 * exp(-k*t)
// ============================================================================

fn exp_decay_deriv(u: f64) -> f64 {
    return 0.0 - 0.1 * u
}

fn rk4_step_exp_decay(dt: f64) with Mut {
    let u = SCAL_W.u
    let k1 = exp_decay_deriv(u)
    let k2 = exp_decay_deriv(u + 0.5 * dt * k1)
    let k3 = exp_decay_deriv(u + 0.5 * dt * k2)
    let k4 = exp_decay_deriv(u + dt * k3)
    SCAL_W.u = u + dt / 6.0 * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
    SCAL_W.t = SCAL_W.t + dt
}

fn solve_exp_decay_u(u0: f64, t_end: f64, n_steps: i32) -> f64 with Mut, Panic, Div {
    let dt = t_end / (n_steps as f64)
    SCAL_W.u = u0
    SCAL_W.t = 0.0
    var i = 0
    while i < n_steps {
        rk4_step_exp_decay(dt)
        i = i + 1
    }
    return SCAL_W.u
}

// ============================================================================
// ODE 2: HARMONIC OSCILLATOR  dx/dt = v, dv/dt = -omega^2*x, omega=1.0
// Analytical: x(t) = cos(t), v(t) = -sin(t)  for x0=1, v0=0
// ============================================================================

struct HarmDerivs {
    dx: f64,
    dv: f64,
}

fn harmonic_deriv(x: f64, v: f64) -> HarmDerivs {
    HarmDerivs { dx: v, dv: 0.0 - x }
}

fn rk4_step_harmonic(dt: f64) with Mut {
    let x = VEC2_W.x
    let v = VEC2_W.y
    let k1 = harmonic_deriv(x, v)
    let k2 = harmonic_deriv(x + 0.5 * dt * k1.dx, v + 0.5 * dt * k1.dv)
    let k3 = harmonic_deriv(x + 0.5 * dt * k2.dx, v + 0.5 * dt * k2.dv)
    let k4 = harmonic_deriv(x + dt * k3.dx, v + dt * k3.dv)
    VEC2_W.x = x + dt / 6.0 * (k1.dx + 2.0 * k2.dx + 2.0 * k3.dx + k4.dx)
    VEC2_W.y = v + dt / 6.0 * (k1.dv + 2.0 * k2.dv + 2.0 * k3.dv + k4.dv)
    VEC2_W.t = VEC2_W.t + dt
}

fn solve_harmonic_xy(x0: f64, v0: f64, t_end: f64, n_steps: i32) with Mut, Panic, Div {
    let dt = t_end / (n_steps as f64)
    VEC2_W.x = x0
    VEC2_W.y = v0
    VEC2_W.t = 0.0
    var i = 0
    while i < n_steps {
        rk4_step_harmonic(dt)
        i = i + 1
    }
}

// ============================================================================
// ODE 3: LOGISTIC GROWTH  du/dt = r*u*(1 - u/K), r=1.0, K=10.0
// Analytical: u(t) = K / (1 + (K/u0 - 1)*exp(-r*t))
// ============================================================================

fn logistic_deriv(u: f64) -> f64 {
    return 1.0 * u * (1.0 - u / 10.0)
}

fn rk4_step_logistic(dt: f64) with Mut {
    let u = SCAL_W.u
    let k1 = logistic_deriv(u)
    let k2 = logistic_deriv(u + 0.5 * dt * k1)
    let k3 = logistic_deriv(u + 0.5 * dt * k2)
    let k4 = logistic_deriv(u + dt * k3)
    SCAL_W.u = u + dt / 6.0 * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
    SCAL_W.t = SCAL_W.t + dt
}

fn solve_logistic_u(u0: f64, t_end: f64, n_steps: i32) -> f64 with Mut, Panic, Div {
    let dt = t_end / (n_steps as f64)
    SCAL_W.u = u0
    SCAL_W.t = 0.0
    var i = 0
    while i < n_steps {
        rk4_step_logistic(dt)
        i = i + 1
    }
    return SCAL_W.u
}

fn logistic_exact(u0: f64, t: f64) -> f64 with Mut, Panic, Div {
    // u(t) = K / (1 + (K/u0 - 1)*exp(-r*t))
    let k = 10.0
    let r = 1.0
    let ratio = k / u0 - 1.0
    return k / (1.0 + ratio * exp_approx(0.0 - r * t))
}

// ============================================================================
// ODE 4: STIFF LINEAR DECAY  du/dt = -50*u
// Analytical: u(t) = u0 * exp(-50*t)
// ============================================================================

fn stiff_decay_deriv(u: f64) -> f64 {
    return 0.0 - 50.0 * u
}

fn rk4_step_stiff(dt: f64) with Mut {
    let u = SCAL_W.u
    let k1 = stiff_decay_deriv(u)
    let k2 = stiff_decay_deriv(u + 0.5 * dt * k1)
    let k3 = stiff_decay_deriv(u + 0.5 * dt * k2)
    let k4 = stiff_decay_deriv(u + dt * k3)
    SCAL_W.u = u + dt / 6.0 * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
    SCAL_W.t = SCAL_W.t + dt
}

fn solve_stiff_u(u0: f64, t_end: f64, n_steps: i32) -> f64 with Mut, Panic, Div {
    let dt = t_end / (n_steps as f64)
    SCAL_W.u = u0
    SCAL_W.t = 0.0
    var i = 0
    while i < n_steps {
        rk4_step_stiff(dt)
        i = i + 1
    }
    return SCAL_W.u
}

// ============================================================================
// ODE 5: ZERO RHS  du/dt = 0
// Analytical: u(t) = u0  (constant)
// ============================================================================

fn rk4_step_zero(dt: f64) with Mut {
    SCAL_W.t = SCAL_W.t + dt
}

fn solve_zero_u(u0: f64, t_end: f64, n_steps: i32) -> f64 with Mut, Panic, Div {
    let dt = t_end / (n_steps as f64)
    SCAL_W.u = u0
    SCAL_W.t = 0.0
    var i = 0
    while i < n_steps {
        rk4_step_zero(dt)
        i = i + 1
    }
    return SCAL_W.u
}

// ============================================================================
// ODE 6: LINEAR RHS  du/dt = 1
// Analytical: u(t) = u0 + t  (exact for RK4 since polynomial degree <= 4)
// ============================================================================

fn rk4_step_linear(dt: f64) with Mut {
    SCAL_W.u = SCAL_W.u + dt
    SCAL_W.t = SCAL_W.t + dt
}

fn solve_linear_u(u0: f64, t_end: f64, n_steps: i32) -> f64 with Mut, Panic, Div {
    let dt = t_end / (n_steps as f64)
    SCAL_W.u = u0
    SCAL_W.t = 0.0
    var i = 0
    while i < n_steps {
        rk4_step_linear(dt)
        i = i + 1
    }
    return SCAL_W.u
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

// Test 1: Exponential decay accuracy at t=10
fn test_exp_decay_accuracy() -> bool with IO, Mut, Panic, Div {
    let u_final = solve_exp_decay_u(1.0, 10.0, 1000)
    let exact = exp_approx(0.0 - 1.0)
    let err = abs_f64(u_final - exact)
    return err < 1.0e-8
}

fn test_exp_decay_stability() -> bool with IO, Mut, Panic, Div {
    let u_final = solve_exp_decay_u(1.0, 10.0, 1000)
    return u_final > 0.0
}

fn test_exp_decay_convergence() -> bool with IO, Mut, Panic, Div {
    let exact = exp_approx(0.0 - 1.0)
    let u_coarse = solve_exp_decay_u(1.0, 10.0, 100)
    let u_fine = solve_exp_decay_u(1.0, 10.0, 200)
    let err_coarse = abs_f64(u_coarse - exact)
    let err_fine = abs_f64(u_fine - exact)
    return err_fine < err_coarse
}

fn test_harmonic_x_period() -> bool with IO, Mut, Panic, Div {
    let two_pi = 6.283185307179586
    solve_harmonic_xy(1.0, 0.0, two_pi, 10000)
    let err = abs_f64(VEC2_W.x - 1.0)
    return err < 1.0e-6
}

fn test_harmonic_v_period() -> bool with IO, Mut, Panic, Div {
    let two_pi = 6.283185307179586
    solve_harmonic_xy(1.0, 0.0, two_pi, 10000)
    let err = abs_f64(VEC2_W.y)
    return err < 1.0e-6
}

fn test_harmonic_energy() -> bool with IO, Mut, Panic, Div {
    let two_pi = 6.283185307179586
    let e0 = 0.5 * (1.0 * 1.0 + 0.0 * 0.0)
    solve_harmonic_xy(1.0, 0.0, two_pi, 10000)
    let e_final = 0.5 * (VEC2_W.x * VEC2_W.x + VEC2_W.y * VEC2_W.y)
    let err = abs_f64(e_final - e0)
    return err < 1.0e-8
}

fn test_harmonic_half_period() -> bool with IO, Mut, Panic, Div {
    let pi = 3.141592653589793
    solve_harmonic_xy(1.0, 0.0, pi, 5000)
    let err = abs_f64(VEC2_W.x - (0.0 - 1.0))
    return err < 1.0e-6
}

fn test_logistic_equilibrium() -> bool with IO, Mut, Panic, Div {
    let u_final = solve_logistic_u(0.1, 20.0, 2000)
    let err = abs_f64(u_final - 10.0)
    return err < 0.01
}

fn test_logistic_monotone() -> bool with IO, Mut, Panic, Div {
    let dt = 20.0 / 2000.0
    SCAL_W.u = 0.1
    SCAL_W.t = 0.0
    var prev_u = SCAL_W.u
    var i = 0
    var monotone = true
    while i < 2000 {
        rk4_step_logistic(dt)
        if SCAL_W.u < prev_u {
            monotone = false
        }
        prev_u = SCAL_W.u
        i = i + 1
    }
    return monotone
}

fn test_logistic_midpoint() -> bool with IO, Mut, Panic, Div {
    let t_inflect = 4.595
    let u_final = solve_logistic_u(0.1, t_inflect, 1000)
    let exact = logistic_exact(0.1, t_inflect)
    let err = abs_f64(u_final - exact)
    return err < 0.05
}

fn test_stiff_decay() -> bool with IO, Mut, Panic, Div {
    let u_final = solve_stiff_u(1.0, 1.0, 10000)
    return abs_f64(u_final) < 1.0e-10
}

fn test_stiff_nonneg() -> bool with IO, Mut, Panic, Div {
    let dt = 1.0 / 10000.0
    SCAL_W.u = 1.0
    SCAL_W.t = 0.0
    var i = 0
    var ok = true
    while i < 10000 {
        rk4_step_stiff(dt)
        if SCAL_W.u < 0.0 {
            ok = false
        }
        i = i + 1
    }
    return ok
}

fn test_order_rk4() -> bool with IO, Mut, Panic, Div {
    let exact = exp_approx(0.0 - 1.0)
    let u1 = solve_exp_decay_u(1.0, 10.0, 100)
    let u2 = solve_exp_decay_u(1.0, 10.0, 200)
    let err1 = abs_f64(u1 - exact)
    let err2 = abs_f64(u2 - exact)
    if err2 < 1.0e-15 { return true }
    let ratio = err1 / err2
    return ratio > 10.0 && ratio < 25.0
}

fn test_zero_rhs() -> bool with IO, Mut, Panic, Div {
    let u_final = solve_zero_u(42.0, 10.0, 100)
    let err = abs_f64(u_final - 42.0)
    return err < 1.0e-12
}

fn test_linear_rhs() -> bool with IO, Mut, Panic, Div {
    let u_final = solve_linear_u(5.0, 10.0, 100)
    let exact = 5.0 + 10.0
    let err = abs_f64(u_final - exact)
    return err < 1.0e-10
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    var passed = 0
    var failed = 0

    print("Test  1: exp decay accuracy......... ")
    if test_exp_decay_accuracy() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("Test  2: exp decay stability........ ")
    if test_exp_decay_stability() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("Test  3: exp decay convergence...... ")
    if test_exp_decay_convergence() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("Test  4: harmonic x period.......... ")
    if test_harmonic_x_period() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("Test  5: harmonic v period.......... ")
    if test_harmonic_v_period() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("Test  6: harmonic energy............ ")
    if test_harmonic_energy() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("Test  7: harmonic half period....... ")
    if test_harmonic_half_period() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("Test  8: logistic equilibrium....... ")
    if test_logistic_equilibrium() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("Test  9: logistic monotone.......... ")
    if test_logistic_monotone() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("Test 10: logistic midpoint.......... ")
    if test_logistic_midpoint() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("Test 11: stiff decay................ ")
    if test_stiff_decay() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("Test 12: stiff nonnegative.......... ")
    if test_stiff_nonneg() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("Test 13: order O(h^4)............... ")
    if test_order_rk4() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("Test 14: zero rhs................... ")
    if test_zero_rhs() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("Test 15: linear rhs................. ")
    if test_linear_rhs() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    println("")
    print("Passed: ")
    println(passed)
    print("Failed: ")
    println(failed)

    if failed == 0 { println("ALL TESTS PASSED") }

    return failed
}
