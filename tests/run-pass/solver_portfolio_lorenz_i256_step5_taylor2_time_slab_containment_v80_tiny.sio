//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v80 smoke for Lorenz i256 step-5 Taylor-2 time-slab containment

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1487
    receipt_fp = mix(receipt_fp, 253054033, 5333)
    receipt_fp = mix(receipt_fp, 661134385, 5333)
    receipt_fp = mix(receipt_fp, 22667633, 5333)
    receipt_fp = mix(receipt_fp, 814116954, 5333)
    receipt_fp = mix(receipt_fp, 296359452, 5333)
    receipt_fp = mix(receipt_fp, 857456119, 5333)
    receipt_fp = mix(receipt_fp, 220149970, 5333)
    receipt_fp = mix(receipt_fp, 5, 5333)
    receipt_fp = mix(receipt_fp, 14, 5333)
    receipt_fp = mix(receipt_fp, 255, 5333)
    if receipt_fp != 913907902 { return 1 }

    var audit_fp: i64 = 1489
    audit_fp = mix(audit_fp, receipt_fp, 5347)
    audit_fp = mix(audit_fp, 253054033, 5347)
    audit_fp = mix(audit_fp, 661134385, 5347)
    audit_fp = mix(audit_fp, 590242925, 5347)
    audit_fp = mix(audit_fp, 820968143, 5347)
    audit_fp = mix(audit_fp, 920537800, 5347)
    audit_fp = mix(audit_fp, 92616329, 5347)
    audit_fp = mix(audit_fp, 296359452, 5347)
    audit_fp = mix(audit_fp, 5, 5347)
    audit_fp = mix(audit_fp, 14, 5347)
    audit_fp = mix(audit_fp, 255, 5347)
    if audit_fp != 7937759 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 83, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 83, 1103)
    if entry_fp != 380734589 { return 3 }

    let manifest_fp: i64 = 768140968
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 80, 1871)
    result_fp = mix(result_fp, 84, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 72, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 649184025 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 80, 1907)
    family_fp = mix(family_fp, 84, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 67, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 505005904 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 80, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 933320065 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 80, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 516949051 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 80, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 246310129 { return 8 }
    return 0
}
