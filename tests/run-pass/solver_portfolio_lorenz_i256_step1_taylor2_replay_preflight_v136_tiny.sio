    receipt_fp = mix(receipt_fp, 1, 6277)
    receipt_fp = mix(receipt_fp, 7, 6277)
    receipt_fp = mix(receipt_fp, 255, 6277)
    if receipt_fp != 570323855 { return 1 }

    var audit_fp: i64 = 2311
