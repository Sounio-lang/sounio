//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v136 smoke for Lorenz i256 step-1 Taylor-2 replay preflight

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2309
    receipt_fp = mix(receipt_fp, 261545659, 6277)
    receipt_fp = mix(receipt_fp, 928945135, 6277)
