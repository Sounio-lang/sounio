//@ run-pass
// End-to-end GUM variance shadow buffer test.
// Tests: seeding via Knowledge.value, additive + multiplicative propagation,
// and variance_of() introspection.

fn main() with IO, Mut, Epistemic {
    // Seed variance from Knowledge via .value extraction
    let k1: Knowledge<f64> = measure(100.0, uncertainty: 2.0)
    let k2: Knowledge<f64> = measure(50.0, uncertainty: 1.0)
    let a = k1.value   // BSS_VAR[a_slot] = 4.0 (2.0²)
    let b = k2.value   // BSS_VAR[b_slot] = 1.0 (1.0²)

    // Additive GUM: var(a + b) = var(a) + var(b) = 4.0 + 1.0 = 5.0
    let sum = a + b

    // Multiplicative GUM: var(a * b) = a²·var(b) + b²·var(a)
    //   = 100²·1.0 + 50²·4.0 = 10000 + 10000 = 20000
    let prod = a * b

    // Introspect the variances
    let va = variance_of(a)
    let vb = variance_of(b)

    // Print results
    print("a="); println(a)
    print("b="); println(b)
    print("var(a)="); println(va)
    print("var(b)="); println(vb)
    print("sum="); println(sum)
    print("prod="); println(prod)
    print("PASS\n")
}
