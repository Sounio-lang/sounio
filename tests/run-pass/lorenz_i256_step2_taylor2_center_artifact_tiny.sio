//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-2 Taylor-2 center candidate artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn instance_fp() -> i64 {
    var fp: i64 = 1733
    fp = mix(fp, 2, 5657)
    fp = mix(fp, 10, 5657)
    fp = mix(fp, 28, 5657)
    fp = mix(fp, 8, 5657)
    fp = mix(fp, 3, 5657)
    fp = mix(fp, 4294967296, 5657)
    fp = mix(fp, 42949672, 5657)
    fp = mix(fp, 96, 5657)
    fp = mix(fp, 4294967296, 5657)
    fp = mix(fp, 5411658768, 5657)
    fp = mix(fp, 4223384510, 5657)
    fp = mix(fp, 4406636440, 5657)
    fp = mix(fp, 6517899153, 5657)
    fp = mix(fp, 4164877513, 5657)
    fp = mix(fp, 482555681, 5657)
    fp = mix(fp, 591288676, 5657)
    fp = mix(fp, 268229078, 5657)
    fp = mix(fp, 223161586, 5657)
    fp = mix(fp, 633359277, 5657)
    fp = mix(fp, 421619310, 5657)
    fp = mix(fp, 0, 5657)
    fp = mix(fp, 0, 5657)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 577937280 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1741
    fp = mix(fp, instance, 5659)
    fp = mix(fp, 116035699778, 5659)
    fp = mix(fp, 0, 5659)
    fp = mix(fp, 5411658768, 5659)
    fp = mix(fp, 0, 5659)
    fp = mix(fp, 11262358693, 5659)
    fp = mix(fp, 1, 5659)
    fp = mix(fp, 111669144, 5659)
    fp = mix(fp, 3023657216, 5659)
    fp = mix(fp, 1106240385, 5659)
    fp = mix(fp, 1604599760, 5659)
    fp = mix(fp, 58506997, 5659)
    fp = mix(fp, 4047004488, 5659)
    fp = mix(fp, 4406636440, 5659)
    fp = mix(fp, 6517899153, 5659)
    fp = mix(fp, 4164877513, 5659)
    fp = mix(fp, 127, 5659)
    fp = mix(fp, 63, 5659)
    fp = mix(fp, 7, 5659)
    fp = mix(fp, 15, 5659)
    fp = mix(fp, 0, 5659)
    fp = mix(fp, 0, 5659)
    fp = mix(fp, ok_mask, 5659)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 577937280 { return 0 - 1 }
    if certificate != 442088371 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1747
    fp = mix(fp, instance, 5669)
    fp = mix(fp, certificate, 5669)
    fp = mix(fp, 482555681, 5669)
    fp = mix(fp, 591288676, 5669)
    fp = mix(fp, 268229078, 5669)
    fp = mix(fp, 223161586, 5669)
    fp = mix(fp, 633359277, 5669)
    fp = mix(fp, 421619310, 5669)
    fp = mix(fp, 1, 5669)
    fp = mix(fp, 2, 5669)
    fp = mix(fp, 4406636440, 5669)
    fp = mix(fp, 6517899153, 5669)
    fp = mix(fp, 4164877513, 5669)
    fp = mix(fp, 15, 5669)
    fp = mix(fp, 0, 5669)
    fp = mix(fp, 0, 5669)
    fp = mix(fp, ok_mask, 5669)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 554654324 { return 0 - 1 }
    if instance != 577937280 { return 0 - 1 }
    if certificate != 442088371 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1753
    fp = mix(fp, artifact, 5683)
    fp = mix(fp, instance, 5683)
    fp = mix(fp, certificate, 5683)
    fp = mix(fp, 482555681, 5683)
    fp = mix(fp, 591288676, 5683)
    fp = mix(fp, 268229078, 5683)
    fp = mix(fp, 223161586, 5683)
    fp = mix(fp, 633359277, 5683)
    fp = mix(fp, 421619310, 5683)
    fp = mix(fp, 2, 5683)
    fp = mix(fp, 1, 5683)
    fp = mix(fp, 127, 5683)
    fp = mix(fp, 63, 5683)
    fp = mix(fp, 7, 5683)
    fp = mix(fp, 15, 5683)
    fp = mix(fp, 0, 5683)
    fp = mix(fp, 0, 5683)
    fp = mix(fp, ok_mask, 5683)
    return fp
}

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256
    let x1: i256 = 4294967296 as i256
    let y1: i256 = 5411658768 as i256
    let z1: i256 = 4223384510 as i256
    let dy_scaled_q: i256 = 116035699778 as i256
    let dy_scaled_r: i256 = 0 as i256
    let xy_scaled_q: i256 = 5411658768 as i256
    let xy_scaled_r: i256 = 0 as i256
    let beta_q: i256 = 11262358693 as i256
    let beta_r: i256 = 1 as i256
    let x_inc_q: i256 = 111669144 as i256
    let x_inc_r: i256 = 3023657216 as i256
    let y_inc_q: i256 = 1106240385 as i256
    let y_inc_r: i256 = 1604599760 as i256
    let z_drop_q: i256 = 58506997 as i256
    let z_drop_r: i256 = 4047004488 as i256

    let dx_num: i256 = (10 as i256) * (y1 - x1)
    let dy_num: i256 = x1 * ((28 as i256) * scale - z1)
    let xy_num: i256 = x1 * y1
    let beta_num_z: i256 = (8 as i256) * z1
    let dy: i256 = dy_scaled_q - y1
    let z_drop_num: i256 = beta_q - xy_scaled_q

    var point_replay_mask: i64 = 0
    if check_div_witness_i256(scale, 100 as i256, dt, 96 as i256) == 1 { point_replay_mask = point_replay_mask + 1 }
    if check_div_witness_i256(dy_num, scale, dy_scaled_q, dy_scaled_r) == 1 { point_replay_mask = point_replay_mask + 2 }
    if check_div_witness_i256(xy_num, scale, xy_scaled_q, xy_scaled_r) == 1 { point_replay_mask = point_replay_mask + 4 }
    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r) == 1 { point_replay_mask = point_replay_mask + 8 }
    if check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r) == 1 { point_replay_mask = point_replay_mask + 16 }
    if check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r) == 1 { point_replay_mask = point_replay_mask + 32 }
    if check_div_witness_i256(dt * z_drop_num, scale, z_drop_q, z_drop_r) == 1 { point_replay_mask = point_replay_mask + 64 }
    if point_replay_mask != 127 { return 1 }

    var final_center_mask: i64 = 0
    if x1 + x_inc_q == 4406636440 as i256 { final_center_mask = final_center_mask + 1 }
    if y1 + y_inc_q == 6517899153 as i256 { final_center_mask = final_center_mask + 2 }
    if z1 - z_drop_q == 4164877513 as i256 { final_center_mask = final_center_mask + 4 }
    if final_center_mask != 7 { return 2 }

    let ok_mask: i64 = 255
    let inst = instance_fp()
    if inst != 577937280 { return 3 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 442088371 { return 4 }
    let artifact = artifact_fp(inst, cert, ok_mask)
    if artifact != 554654324 { return 5 }
    let audit = audit_fp(artifact, inst, cert, ok_mask)
    if audit != 135610689 { return 6 }
    if check_div_witness_i256(dt * z_drop_num, scale, z_drop_q, scale) != 0 { return 7 }
    if certificate_fp(inst, 254) != (0 - 1) { return 8 }
    return 0
}
