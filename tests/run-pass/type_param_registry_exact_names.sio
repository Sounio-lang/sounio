//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS type_param_registry_exact_names
// Lowering asks the parser's type-parameter registry whether a name is declared by the
// enclosing declaration, and the registry kept only a name's hash and length. `nF` and
// `mg` are both two letters with the same DJB2 value (110*33+70 == 109*33+103), so in
// `impl Gauge<nF>` the UNIT `mg` was taken for a declared parameter: `k + k` on an mg
// was lowered as integer arithmetic while the checker, which compares names exactly,
// typed it as the unit. The registry now keeps each name's bytes and matches exactly.

struct Gauge<nF> {
    c: nF,
}

impl Gauge<nF> {
    fn twice(self: &Gauge<nF>, k: mg) -> mg {
        k + k
    }
}

fn main() -> i32 with IO {
    let g = Gauge { c: 3 }
    let e: mg = 25.0
    let d: mg = g.twice(e)
    if d as f64 == 50.0 {
        println("PASS type_param_registry_exact_names")
    } else {
        println("FAIL type_param_registry_exact_names")
    }
    0
}
