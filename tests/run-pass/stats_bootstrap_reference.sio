//@ run-pass
//@ expect-stdout: STATS_BOOTSTRAP_REFERENCE_PASS
use stats::bootstrap::{bootstrap_mean}
use math::pure::{is_finite}
fn case_0() with Mut, Div, Panic {
var x: [f64; 256] = [0.0; 256]
x[0] = 1.00000000000000000e+00
x[1] = 2.00000000000000000e+00
x[2] = 3.00000000000000000e+00
x[3] = 4.00000000000000000e+00
x[4] = 5.00000000000000000e+00
let r = bootstrap_mean(&x, 5, 1000, 9.49999999999999956e-01, 20260715)
assert(is_finite(r.mean))
assert(abs(r.mean / 5.00000000000000000e+00 - 5.99999999999999978e-01) < 3.0e-12)
assert(is_finite(r.se))
assert(abs(r.se / 5.00000000000000000e+00 - 1.28350471146168543e-01) < 3.0e-12)
assert(is_finite(r.lo))
assert(abs(r.lo / 5.00000000000000000e+00 - 3.59999999999999987e-01) < 3.0e-12)
assert(is_finite(r.hi))
assert(abs(r.hi / 5.00000000000000000e+00 - 8.39999999999999969e-01) < 3.0e-12)
assert(r.b == 1000)
assert(x[0] == 1.00000000000000000e+00)
}
