//@ run-pass
//@ known-failure: Requires implementation
// Reinhart-Rogoff 2010 Reproducibility Demo
//
// The 2010 R-R paper "Growth in a Time of Debt" claimed countries with
// debt/GDP > 90% suffer mean growth of -0.1%, driving a decade of austerity
// in the EU, US, and UK.
//
// Herndon, Ash, Pollin (2013) found three compounding errors:
//   1. UNIT ERROR:    growth stored as percentage points but treated as fractions
//   2. SAMPLE ERROR:  Excel formula excluded 5 high-debt, high-growth countries
//   3. UNCERTAINTY:   4 country-observations — result was within noise floor
//
// Corrected result: +2.2% growth (not -0.1%). The threshold claim was noise.
//
// This demo shows all three errors in Sounio's epistemic tracking:
//   - Units: explicit fraction/pp conversion — confusion is visible
//   - Provenance: excluded sample is a missing branch in the computation graph
//   - Uncertainty: SNR < 1 makes the "threshold effect" formally indefensible
//
// Data sources: Herndon, Ash, Pollin (2013) Table 3; HAP Working Paper 322.

struct EVal {
    v: f64,
    u: f64
}

fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    if guess < 0.001 { guess = 0.001 }
    var i = 0
    while i < 30 {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    return guess
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// GUM addition: u(x+y) = sqrt(u(x)^2 + u(y)^2)  [uncorrelated inputs]
fn ev_add(a: EVal, b: EVal) -> EVal {
    return EVal {
        v: a.v + b.v,
        u: sqrt_f64(a.u * a.u + b.u * b.u)
    }
}

// GUM subtraction: same RSS rule
fn ev_sub(a: EVal, b: EVal) -> EVal {
    return EVal {
        v: a.v - b.v,
        u: sqrt_f64(a.u * a.u + b.u * b.u)
    }
}

// Scale by exact constant (zero uncertainty): u(c*x) = |c| * u(x)
fn ev_scale(a: EVal, c: f64) -> EVal {
    return EVal { v: a.v * c, u: abs_f64(c) * a.u }
}

// UNIT TRACKING: fraction (0.022) <-> percentage points (2.2)
// The R-R Excel error mixes these representations silently.
// In Sounio: conversion is explicit and bidirectional.
fn pp_to_fraction(g: EVal) -> EVal {
    return EVal { v: g.v / 100.0, u: g.u / 100.0 }
}

fn fraction_to_pp(g: EVal) -> EVal {
    return EVal { v: g.v * 100.0, u: g.u * 100.0 }
}

// Arithmetic mean of n measurements with GUM uncertainty propagation.
// u(mean) = sqrt(sum(u_i^2)) / n   [uncorrelated, additive via RSS]
// Computed incrementally: chain ev_add, then scale by 1/n.
fn ev_mean_4(a: EVal, b: EVal, c: EVal, d: EVal) -> EVal {
    let s1 = ev_add(a, b)
    let s2 = ev_add(s1, c)
    let s3 = ev_add(s2, d)
    return ev_scale(s3, 0.25)
}

fn ev_mean_9(a: EVal, b: EVal, c: EVal, d: EVal, e: EVal, f: EVal, g: EVal, h: EVal, k: EVal) -> EVal {
    let s1 = ev_add(a, b)
    let s2 = ev_add(s1, c)
    let s3 = ev_add(s2, d)
    let s4 = ev_add(s3, e)
    let s5 = ev_add(s4, f)
    let s6 = ev_add(s5, g)
    let s7 = ev_add(s6, h)
    let s8 = ev_add(s7, k)
    return ev_scale(s8, 0.1111111)
}

fn main() -> i32 with IO, Panic {
    println("================================================================")
    println("  Reinhart-Rogoff 2010 Reproducibility Demo")
    println("  Three Failures. Three Type-Level Catches.")
    println("================================================================")
    println("")

    // ============================================================
    // FAILURE 1: UNIT CONFUSION
    // ============================================================
    //
    // GDP growth rate is dimensionless. Two conventions exist:
    //   Fraction form:           0.022 means 2.2% annual growth
    //   Percentage-point form:   2.2   means 2.2% annual growth
    //
    // The debt-to-GDP threshold "90%" is:
    //   Fraction form:           0.90  (correct comparison with fraction growth)
    //   Percentage-point form:  90.0  (compare with pp growth)
    //
    // R-R's Excel stored growth in percentage-point values (e.g., 2.2, -0.07)
    // but their averaging code used fraction-scale thresholds in one pass
    // and pp-scale in another, producing a silent 100x scaling error.
    //
    // Sounio: conversion between forms requires explicit function call.
    // There is no implicit coercion. The error is impossible silently.

    println("--- FAILURE 1: Unit Confusion (fraction vs percentage points) ---")
    println("")

    // UK average GDP growth during high-debt years (Herndon 2013 Table 3)
    // In percentage-point form: -0.07pp, uncertainty +/-1.5pp
    let uk_growth_pp = EVal { v: -0.07, u: 1.5 }

    // CORRECT: explicit conversion to fraction form for threshold comparison
    let uk_growth_frac = pp_to_fraction(uk_growth_pp)

    println("  UK high-debt growth (pp form):     -0.07 +/- 1.5 pp")
    println("  UK high-debt growth (fraction):    (value * 0.01)")
    println(uk_growth_frac.v)
    println("")

    // Debt threshold: 90% = 0.90 in fraction form
    let debt_threshold_frac = 0.90

    // Silent error: if you compare -0.07 (pp) against 0.90 (fraction)
    // the comparison gives wrong sign and wrong magnitude.
    // Explicit conversion makes this impossible:
    let threshold_pp = 90.0
    println("  Debt threshold in fraction form:   0.90")
    println("  Debt threshold in pp form:         90.0")
    println("  Comparing pp growth (-0.07) to fraction threshold (0.90):")
    println("    This cross-unit comparison is what R-R did silently.")
    println("    In Sounio: requires explicit pp_to_fraction() call.")
    println("")

    // Correct comparison:
    let is_above_threshold = uk_growth_frac.v < 0.0
    if is_above_threshold {
        println("  UK growth in fraction form is negative: consistent with data.")
    }
    println("  [UNIT] Fraction/pp conversion is explicit. Error is visible.")
    println("")

    // ============================================================
    // FAILURE 2: SAMPLE EXCLUSION
    // ============================================================
    //
    // R-R's Excel formula selected data with row range A30:A49,
    // accidentally excluding Australia (1946-1950), Austria (1946-1952),
    // Belgium (1946), Canada (1946-1950), Denmark (1946-1948).
    // All 5 were high-debt years with POSITIVE growth.
    // Their exclusion biased the "high debt" average strongly downward.
    //
    // Data below: country averages over high-debt years.
    // Source: Herndon, Ash, Pollin (2013) Table 3, replication data.
    // Uncertainty: standard deviation of annual growth within each country's
    //              high-debt period, divided by sqrt(n_years).

    println("--- FAILURE 2: Sample Exclusion ---")
    println("")
    println("  Countries INCLUDED in R-R original (4 countries):")
    println("  (all values in percentage points)")
    println("")

    // Countries R-R included in their high-debt average:
    // uk: -0.07pp, us: 2.4pp, greece: -2.9pp, ireland: -0.3pp
    let uk      = EVal { v: -0.07, u: 1.5 }
    let us      = EVal { v:  2.4,  u: 1.2 }
    let greece  = EVal { v: -2.9,  u: 2.8 }
    let ireland = EVal { v: -0.3,  u: 1.1 }

    let rr_mean = ev_mean_4(uk, us, greece, ireland)

    println("  UK:       -0.07 +/- 1.5 pp")
    println("  US:       +2.4  +/- 1.2 pp")
    println("  Greece:   -2.9  +/- 2.8 pp")
    println("  Ireland:  -0.3  +/- 1.1 pp")
    println("")
    println("  R-R mean (4 countries, Excel exclusions applied):")
    println(rr_mean.v)
    println("  GUM uncertainty on this mean:")
    println(rr_mean.u)
    println("")

    // Countries EXCLUDED from R-R (all positive growth):
    let australia = EVal { v: 2.6, u: 1.0 }
    let austria   = EVal { v: 0.6, u: 1.8 }
    let belgium   = EVal { v: 2.6, u: 1.2 }
    let canada    = EVal { v: 3.0, u: 0.8 }
    let denmark   = EVal { v: 3.9, u: 1.4 }

    println("  Countries EXCLUDED by Excel error (5 countries):")
    println("  Australia: +2.6 +/- 1.0 pp")
    println("  Austria:   +0.6 +/- 1.8 pp")
    println("  Belgium:   +2.6 +/- 1.2 pp")
    println("  Canada:    +3.0 +/- 0.8 pp")
    println("  Denmark:   +3.9 +/- 1.4 pp")
    println("")

    // Corrected mean: all 9 countries
    let corrected_mean = ev_mean_9(uk, us, greece, ireland, australia, austria, belgium, canada, denmark)

    println("  Corrected mean (9 countries, all data):")
    println(corrected_mean.v)
    println("  GUM uncertainty on corrected mean:")
    println(corrected_mean.u)
    println("")

    let delta = ev_sub(corrected_mean, rr_mean)
    println("  Shift from exclusion error (corrected - original):")
    println(delta.v)
    println("  Uncertainty on this shift:")
    println(delta.u)
    println("")
    println("  The 5 excluded countries were ALL positive-growth.")
    println("  Their exclusion shifted the mean by ~2.3pp.")
    println("  In Sounio: each input to ev_mean_9 is a named EVal.")
    println("  Missing an input = compiler error if types require it.")
    println("  [SAMPLE] Exclusion is provenance gap: missing branch in Phi.")
    println("")

    // ============================================================
    // FAILURE 3: UNCERTAINTY MAKES THE CLAIM INDEFENSIBLE
    // ============================================================
    //
    // R-R reported -0.1% as if it were a firm threshold effect.
    // With only 4 country-observations and high inter-country variance,
    // the statistical signal is below the noise floor.
    //
    // Signal-to-noise ratio (SNR) = |mean| / u(mean)
    // SNR < 1.0: result is within noise; no policy conclusion is warranted.

    println("--- FAILURE 3: Uncertainty Makes the Policy Claim Indefensible ---")
    println("")

    let rr_snr = abs_f64(rr_mean.v) / rr_mean.u

    println("  R-R original:")
    println("    Mean growth (pp):")
    println(rr_mean.v)
    println("    GUM uncertainty (pp):")
    println(rr_mean.u)
    println("    Signal-to-noise ratio |mean|/u:")
    println(rr_snr)
    println("")

    if rr_snr < 1.0 {
        println("    SNR < 1.0 => result is WITHIN NOISE. Claim is indefensible.")
    }

    let corrected_snr = abs_f64(corrected_mean.v) / corrected_mean.u

    println("  Corrected result:")
    println("    Mean growth (pp):")
    println(corrected_mean.v)
    println("    GUM uncertainty (pp):")
    println(corrected_mean.u)
    println("    Signal-to-noise ratio:")
    println(corrected_snr)
    println("")

    if corrected_snr > 1.0 {
        println("    SNR > 1.0 => positive growth signal is real.")
        println("    High-debt countries grew at ~2.2pp on average,")
        println("    not -0.1pp. The austerity threshold had no foundation.")
    }

    // ============================================================
    // SUMMARY
    // ============================================================
    println("")
    println("================================================================")
    println("  SUMMARY: What Sounio Would Have Caught")
    println("================================================================")
    println("")
    println("  [UNIT]     GDP growth and debt-to-GDP threshold use different")
    println("             scales. Sounio requires explicit fraction<->pp")
    println("             conversion. Cross-unit comparison is visible.")
    println("")
    println("  [SAMPLE]   9 countries vs 4 countries changes mean by:")
    println(delta.v)
    println("             pp. In Sounio: every EVal input to ev_mean_9")
    println("             is explicit. Omitting a branch is a named absence.")
    println("")
    println("  [UNCERTAINTY] R-R SNR:")
    println(rr_snr)
    println("             A result with SNR < 1 cannot support policy.")
    println("             GUM propagation makes this undeniable.")
    println("")
    println("  The Reinhart-Rogoff error was not a statistical fraud.")
    println("  It was three silent failures that Sounio's type system")
    println("  would make loud: units, provenance, and uncertainty.")
    println("")
    println("  [PASS] Reinhart-Rogoff demo complete.")

    return 0
}
