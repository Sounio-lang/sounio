        516981885, 989033159, 354172124, 751523371, 362208564, 6, 3, 127)
    if receipt_fp != 676017160 { return 1 }

    let audit_fp = solver_portfolio_v52_lorenz_i256_step6_enclosure_projection_artifact_audit_fingerprint(
        receipt_fp, 516981885, 989033159, 971093006, 336156914, 362208564, 6, 3, 127)
    if audit_fp != 588554192 { return 2 }

    let manifest_fp = solver_portfolio_v52_lorenz_i256_step6_enclosure_projection_artifact_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 924526189 { return 3 }

    let result_fp = solver_portfolio_v52_result_coverage_fingerprint(
        52, 56, 10, 44, 1, 1, manifest_fp)
