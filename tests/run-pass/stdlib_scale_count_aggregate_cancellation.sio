//@ run-pass
//@ requires: madaros
//@ expect-stdout: CHECKED AGGREGATE CANCELLATION PASS
use stats::regression::nb2_likelihood::{Nb2LikelihoodDifferenceSlot,Nb2CachedLikelihoodDifferenceSlot,nb2_likelihood_difference_slot,nb2_cached_likelihood_difference_slot,nb2_cached_likelihood_difference_slot_reset,nb2_log_probability_mean_difference_into,nb2_log_probability_mean_rank_difference_into,nb2_log_probability_mean_rank_cached_difference_into,nb2_log_probability_mean_difference_traced_into,nb2_log_probability_mean_rank_difference_traced_into,nb2_log_probability_mean_rank_cached_difference_traced_into,nb2_likelihood_difference_value,nb2_cached_likelihood_difference_value,nb2_likelihood_difference_snapshot,nb2_cached_likelihood_difference_status,nb2_cached_likelihood_difference_full_calls}
use stats::regression::count_fit_trace::{CountFitTraceSlot,count_fit_trace_slot,count_fit_trace_reset,count_fit_trace_status,count_fit_trace_metric}
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
fn agg_emit(kind:i64,mode:i64,status:i64,value:f64,trace_status:i64,calls:i64) with IO {
 let bits:i64=f64_to_bits(value)
 print("AGG ");print(kind);print(" ");print(mode);print(" ");print(status);print(" ");print(bits);print(" ");print(trace_status);print(" ");println(calls)
}
fn agg_case(kind:i64,s:&!Nb2LikelihoodDifferenceSlot,c:&!Nb2CachedLikelihoodDifferenceSlot,trace:&!CountFitTraceSlot) with IO,Alloc,Mut,Div,Panic {
 let n:i64=if kind==2 {2}else{3}
 let expected:i64=if kind==0 || kind==2 {5}else{0}
 var counts=integer_buffer_new(n,24)
 var first=numeric_buffer_new(n,24)
 var second=numeric_buffer_new(n,24)
 var i:i64=0
 while i<n {
  var a:f64=1.0
  var b:f64=2.0
  if kind==0 {if i==0 {a=1e-300;b=2e-300};if i==1 {a=2.0;b=1.0}}
  if kind==1 {if i==1 {a=2.0;b=1.0};if i==2 {a=1e-300;b=2e-300}}
  if kind==2 {if i==1 {a=2.0;b=1.0}}
  if kind==3 {a=(i+1) as f64;b=a}
  integer_buffer_set(&!counts,i,0)
  numeric_buffer_set(&!first,i,a);numeric_buffer_set(&!second,i,b)
  let ba:i64=f64_to_bits(a)
  let bb:i64=f64_to_bits(b)
  print("INPUT ");print(kind);print(" ");print(i);print(" ");print(ba);print(" ");println(bb)
  i=i+1
 }
 let legacy:i64=nb2_log_probability_mean_difference_into(&counts,&first,0.0,&second,0.0,n,s)
 let lv:f64=nb2_likelihood_difference_value(s)
 agg_emit(kind,0,legacy,lv,0,-1)
 assert(legacy==expected)
 let rank:i64=nb2_log_probability_mean_rank_difference_into(&counts,&first,0.0,&second,0.0,n,s)
 let rv:f64=nb2_likelihood_difference_value(s)
 agg_emit(kind,1,rank,rv,0,-1)
 assert(rank==expected)
 let cached:i64=nb2_log_probability_mean_rank_cached_difference_into(&counts,&first,0.0,&second,0.0,n,c)
 let cv:f64=nb2_cached_likelihood_difference_value(c)
 agg_emit(kind,2,cached,cv,0,-1)
 assert(cached==expected)
 count_fit_trace_reset(trace)
 let lt:i64=nb2_log_probability_mean_difference_traced_into(&counts,&first,0.0,&second,0.0,n,s,trace)
 let ltv:f64=nb2_likelihood_difference_value(s)
 let lts:i64=count_fit_trace_status(trace)
 let ltc:i64=count_fit_trace_metric(trace,7)
 agg_emit(kind,3,lt,ltv,lts,ltc)
 assert(lt==expected && lts==0)
 count_fit_trace_reset(trace)
 let rt:i64=nb2_log_probability_mean_rank_difference_traced_into(&counts,&first,0.0,&second,0.0,n,s,trace)
 let rtv:f64=nb2_likelihood_difference_value(s)
 let rts:i64=count_fit_trace_status(trace)
 let rtc:i64=count_fit_trace_metric(trace,7)
 agg_emit(kind,4,rt,rtv,rts,rtc)
 assert(rt==expected && rts==0)
 count_fit_trace_reset(trace)
 let ct:i64=nb2_log_probability_mean_rank_cached_difference_traced_into(&counts,&first,0.0,&second,0.0,n,c,trace)
 let ctv:f64=nb2_cached_likelihood_difference_value(c)
 let cts:i64=count_fit_trace_status(trace)
 let ctc:i64=count_fit_trace_metric(trace,7)
 agg_emit(kind,5,ct,ctv,cts,ctc)
 assert(ct==expected && cts==0)
 if expected==5 {assert(f64_to_bits(lv)==0 && f64_to_bits(rv)==0 && f64_to_bits(cv)==0)}
 if kind==1 {assert(lv<0.0 && rv<0.0 && cv<0.0)}
 if kind==3 {assert(f64_to_bits(lv)==0 && f64_to_bits(rv)==0 && f64_to_bits(cv)==0)}
 let saved=nb2_likelihood_difference_snapshot(s)
 let before_bits:i64=f64_to_bits(rtv)
 assert(nb2_log_probability_mean_difference_into(&counts,&first,0.0,&second,0.0,0,s)==1)
 assert(f64_to_bits(nb2_likelihood_difference_value(s))==0)
 assert(saved.status==expected && f64_to_bits(saved.value)==before_bits)
 nb2_cached_likelihood_difference_slot_reset(c)
 assert(nb2_cached_likelihood_difference_status(c)==5)
 assert(nb2_cached_likelihood_difference_full_calls(c)==0)
 assert(f64_to_bits(nb2_cached_likelihood_difference_value(c))==0)
 integer_buffer_close(counts);numeric_buffer_close(first);numeric_buffer_close(second)
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var slot=nb2_likelihood_difference_slot()
 var cache=nb2_cached_likelihood_difference_slot()
 var trace=count_fit_trace_slot()
 agg_case(0,&!slot,&!cache,&!trace)
 agg_case(1,&!slot,&!cache,&!trace)
 agg_case(2,&!slot,&!cache,&!trace)
 agg_case(3,&!slot,&!cache,&!trace)
 println("CHECKED AGGREGATE CANCELLATION PASS")
 0
}
