    scale_case_14()
    scale_case_15()
    scale_case_16()
    scale_case_17()
    scale_case_18()
    scale_case_19()
    scale_case_20()
    scale_case_21()
    scale_case_22()
    scale_case_23()
    scale_case_24()
    scale_case_25()
    scale_case_26()
    scale_case_27()
    scale_case_28()
    scale_case_29()
    scale_case_30()
    scale_case_31()
    scale_case_32()
    scale_case_33()
    scale_case_34()
    scale_case_35()
    scale_case_36()
    scale_case_37()
    scale_case_38()
    scale_case_39()
    scale_case_40()
    scale_case_41()
    scale_case_42()
    scale_case_43()
    scale_case_44()
    scale_case_45()
    scale_case_46()
    scale_case_47()
    scale_case_48()
    scale_case_49()
    scale_case_50()
    let lin_spec=ScaleSpec{mode:0,constant:1.0}
    let log_spec=ScaleSpec{mode:1,constant:1.0}
    let sym_spec=ScaleSpec{mode:2,constant:1.0}
    let bad=ScaleSpec{mode:2,constant:0.0}
    assert(scale_forward(0.0,&log_spec).status == 3)
    assert(scale_forward(-1.0,&log_spec).status == 3)
    assert(scale_forward(1.0,&bad).status == 1)
    assert(scale_inverse(1.0e308,&log_spec).status == 4)
    assert(scale_inverse(1.0e308,&sym_spec).status == 4)
    assert(ln_checked(0.0).status == 1 && ln_checked(-1.0).status == 1)
    assert(ln_checked(1.0).status == 0 && ln_checked(1.0).value == 0.0)
    var huge=1.0e308
    let inf=huge*10.0
    assert(scale_forward(inf,&lin_spec).status == 2)
    assert(scale_forward(inf-inf,&sym_spec).status == 2)
    assert(ln_checked(inf).status == 2)
    let lt=axis_scaled_ticks(1.0e-6,1.0e6,6,&log_spec)
    assert(lt.status == 0 && lt.n == 7)
    assert(near(lt.values[0],9.99999999999999955e-07,9.99999999999999955e-07))
    assert(near(lt.values[1],1.00000000000000005e-04,1.00000000000000005e-04))
    assert(near(lt.values[2],1.00000000000000002e-02,1.00000000000000002e-02))
    assert(near(lt.values[3],1.00000000000000000e+00,1.00000000000000000e+00))
    assert(near(lt.values[4],1.00000000000000000e+02,1.00000000000000000e+02))
    assert(near(lt.values[5],1.00000000000000000e+04,1.00000000000000000e+04))
    assert(near(lt.values[6],1.00000000000000000e+06,1.00000000000000000e+06))
    let st=axis_scaled_ticks(-99.0,99.0,4,&sym_spec)
    assert(st.status == 0 && st.n == 5)
    assert(near(st.values[0],-9.90000000000000000e+01,9.90000000000000000e+01))
    assert(near(st.values[1],-9.00000000000000000e+00,9.00000000000000000e+00))
    assert(near(st.values[2],0.00000000000000000e+00,1.00000000000000000e+00))
    assert(near(st.values[3],9.00000000000000000e+00,9.00000000000000000e+00))
    assert(near(st.values[4],9.90000000000000000e+01,9.90000000000000000e+01))
    assert(axis_scaled_ticks(0.0,100.0,4,&log_spec).status != 0)
    println("SCALE_REFERENCE_PASS")
    0
}
