//@ run-pass
//@ expect-stdout: SCALE_REFERENCE_PASS
use viz::scale::{ScaleSpec,scale_forward,scale_inverse,axis_scaled_ticks}
use math::pure::{ln_checked}
fn near(a:f64,b:f64,s:f64)->bool with Div { let d=if a>b {a-b}else{b-a} d/s < 2.0e-11 }
fn scale_case_0() with IO, Mut, Div, Panic {
    println("SCALE_CASE_0")
    let s0=ScaleSpec{mode:0,constant:1.00000000000000000e+00}
    let f0=scale_forward(-1.00000000000000005e+300,&s0)
    assert(f0.status == 0)
    assert(near(f0.value,-1.00000000000000005e+300,1.00000000000000005e+300))
    let r0=scale_inverse(f0.value,&s0)
    assert(r0.status == 0)
    assert(near(r0.value,-1.00000000000000005e+300,1.00000000000000005e+300))
}
