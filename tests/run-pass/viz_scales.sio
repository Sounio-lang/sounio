    assert(near(f43.value,0.00000000000000000e+00,1.00000000000000000e+00))
    let r43=scale_inverse(f43.value,&s43)
    assert(r43.status == 0)
    assert(near(r43.value,0.00000000000000000e+00,1.00000000000000000e+00))
}
