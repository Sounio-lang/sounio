//@ run-pass
//@ requires: madaros
//@ description: #2830 u64 parameters shift/divide unsigned like u64 locals, and u64 < <= > >= compare unsigned (bit 63 set)
//@ expect-stdout: local_shr=14819496
//@ expect-stdout: param_shr_i64=14819496
//@ expect-stdout: param_shr_u64=14819496
//@ expect-stdout: param_shr_lit=14819496
//@ expect-stdout: param_div=5431402805552869178
//@ expect-stdout: param_rem=1
//@ expect-stdout: local_gt_one=true
//@ expect-stdout: local_gt_u64=true
//@ expect-stdout: param_gt_lit=true
//@ expect-stdout: param_lt=false
//@ expect-stdout: param_ge_self=true
//@ expect-stdout: param_le_small=false
//@ expect-stdout: small_lt_big=true
//@ expect-stdout: i64_neg_lt=true
//@ expect-stdout: U64_PARAM_2830_OK
//
// a = 0xE220A8397B1DCDAF has bit 63 set. a >> 40 = 0xE220A8 = 14819496.
// Before the fix, on a Madaros built from main: the local shift was right but
// every parameter form gave -1957720 (sign-extended), `a / 3` through a
// parameter gave -717511885683648027, and every u64 `>` / `<` compared signed
// (`a > 1` false). The last line is a signed control that must stay signed.

fn shr_i(a: u64, k: i64) -> u64 { a >> k }
fn shr_u(a: u64, k: u64) -> u64 { a >> k }
fn shr_lit(a: u64) -> u64 { a >> 40 }
fn div_u(a: u64, k: u64) -> u64 { a / k }
fn rem_u(a: u64, k: u64) -> u64 { a % k }
fn gt1(a: u64) -> bool { a > 1 }
fn lt(a: u64, b: u64) -> bool { a < b }
fn ge(a: u64, b: u64) -> bool { a >= b }
fn le(a: u64, b: u64) -> bool { a <= b }

fn show(label: string, b: bool) with IO {
    print(label)
    if b { println("true") } else { println("false") }
}

fn main() -> i32 with IO, Mut, Div, Panic, Alloc {
    var ok = true
    let a: u64 = 0xE220A8397B1DCDAF
    let s0 = (a >> 40) as i64
    print("local_shr=")
    println(s0)
    let s1 = shr_i(a, 40) as i64
    print("param_shr_i64=")
    println(s1)
    let s2 = shr_u(a, 40) as i64
    print("param_shr_u64=")
    println(s2)
    let s3 = shr_lit(a) as i64
    print("param_shr_lit=")
    println(s3)
    if s0 != 14819496 || s1 != 14819496 || s2 != 14819496 || s3 != 14819496 { ok = false }
    let d = div_u(a, 3) as i64
    print("param_div=")
    println(d)
    if d != 5431402805552869178 { ok = false }
    let r = rem_u(a, 2) as i64
    print("param_rem=")
    println(r)
    if r != 1 { ok = false }
    let one: u64 = 1
    let c1 = a > 1
    let c2 = a > one
    let c3 = gt1(a)
    let c4 = lt(a, one)
    let c5 = ge(a, a)
    let c6 = le(a, one)
    let small: u64 = 5
    let c7 = small < a
    let n: i64 = 0 - 5
    let c8 = n < 3
    show("local_gt_one=", c1)
    show("local_gt_u64=", c2)
    show("param_gt_lit=", c3)
    show("param_lt=", c4)
    show("param_ge_self=", c5)
    show("param_le_small=", c6)
    show("small_lt_big=", c7)
    show("i64_neg_lt=", c8)
    if !c1 || !c2 || !c3 || c4 || !c5 || c6 || !c7 || !c8 { ok = false }
    if ok { println("U64_PARAM_2830_OK") } else { println("U64_PARAM_2830_FAIL") }
    return 0
}
