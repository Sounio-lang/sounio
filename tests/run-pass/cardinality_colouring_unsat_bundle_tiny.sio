//@ run-pass
//@ requires: madaros
//@ description: Scalar graph-colouring UNSAT certificate bundle contract

fn card_exactly_one_clause_count(n: i64) -> i64 {
    if n <= 0 { return 0 }
    return 1 + (n * (n - 1)) / 2
}

fn card_colour_vertex_block_count(vertex_count: i64, colour_count: i64) -> i64 {
    if vertex_count < 0 { return 0 - 1 }
    let per_vertex: i64 = card_exactly_one_clause_count(colour_count)
    if per_vertex <= 0 { return 0 - 1 }
    return vertex_count * per_vertex
}

fn card_colour_edge_base_id(vertex_count: i64, colour_count: i64) -> i64 {
    if vertex_count < 0 { return 0 - 1 }
    let per_vertex: i64 = card_exactly_one_clause_count(colour_count)
    if per_vertex <= 0 { return 0 - 1 }
    return vertex_count * per_vertex + 1
}

fn card_colour_edge_clause_count(edge_count: i64, colour_count: i64) -> i64 {
    if edge_count < 0 { return 0 - 1 }
    if colour_count <= 0 { return 0 - 1 }
    return edge_count * colour_count
}

fn card_colour_total_clause_count(vertex_count: i64, edge_count: i64, colour_count: i64) -> i64 {
    let vertex_block: i64 = card_colour_vertex_block_count(vertex_count, colour_count)
    if vertex_block < 0 { return 0 - 1 }
    let edge_block: i64 = card_colour_edge_clause_count(edge_count, colour_count)
    if edge_block < 0 { return 0 - 1 }
    return vertex_block + edge_block
}

fn card_colour_var_count(vertex_count: i64, colour_count: i64) -> i64 {
    if vertex_count < 0 { return 0 - 1 }
    if colour_count <= 0 { return 0 - 1 }
    return vertex_count * colour_count
}

fn card_colour_manifest_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 1315423911) + value + 97) % 1000000007
}

fn card_colour_manifest_fingerprint(vertex_count: i64, edge_count: i64, colour_count: i64) -> i64 {
    let var_count: i64 = card_colour_var_count(vertex_count, colour_count)
    if var_count < 0 { return 0 - 1 }
    let vertex_block: i64 = card_colour_vertex_block_count(vertex_count, colour_count)
    if vertex_block < 0 { return 0 - 1 }
    let edge_base: i64 = card_colour_edge_base_id(vertex_count, colour_count)
    if edge_base < 0 { return 0 - 1 }
    let edge_block: i64 = card_colour_edge_clause_count(edge_count, colour_count)
    if edge_block < 0 { return 0 - 1 }
    let total: i64 = card_colour_total_clause_count(vertex_count, edge_count, colour_count)
    if total < 0 { return 0 - 1 }

    var acc: i64 = 17
    acc = card_colour_manifest_mix(acc, vertex_count)
    acc = card_colour_manifest_mix(acc, edge_count)
    acc = card_colour_manifest_mix(acc, colour_count)
    acc = card_colour_manifest_mix(acc, var_count)
    acc = card_colour_manifest_mix(acc, vertex_block)
    acc = card_colour_manifest_mix(acc, edge_base)
    acc = card_colour_manifest_mix(acc, edge_block)
    acc = card_colour_manifest_mix(acc, total)
    return acc
}

fn card_colour_first_derived_clause_id(vertex_count: i64, edge_count: i64, colour_count: i64) -> i64 {
    let total: i64 = card_colour_total_clause_count(vertex_count, edge_count, colour_count)
    if total < 0 { return 0 - 1 }
    return total + 1
}

fn card_colour_final_derived_clause_id(vertex_count: i64, edge_count: i64, colour_count: i64, derived_count: i64) -> i64 {
    if derived_count <= 0 { return 0 - 1 }
    let first: i64 = card_colour_first_derived_clause_id(vertex_count, edge_count, colour_count)
    if first < 0 { return 0 - 1 }
    return first + derived_count - 1
}

fn card_colour_lrat_header_valid(vertex_count: i64, edge_count: i64, colour_count: i64,
                                 manifest_fingerprint: i64, first_derived_id: i64) -> i64 {
    let expected_fp: i64 = card_colour_manifest_fingerprint(vertex_count, edge_count, colour_count)
    if expected_fp < 0 { return 0 }
    if manifest_fingerprint != expected_fp { return 0 }
    if first_derived_id != card_colour_first_derived_clause_id(vertex_count, edge_count, colour_count) { return 0 }
    return 1
}

fn card_colour_lrat_unsat_bundle_valid(vertex_count: i64, edge_count: i64, colour_count: i64,
                                       manifest_fingerprint: i64, first_derived_id: i64,
                                       derived_count: i64, final_derived_id: i64,
                                       final_clause_len: i64) -> i64 {
    if card_colour_lrat_header_valid(vertex_count, edge_count, colour_count, manifest_fingerprint, first_derived_id) == 0 { return 0 }
    if derived_count <= 0 { return 0 }
    if final_derived_id != card_colour_final_derived_clause_id(vertex_count, edge_count, colour_count, derived_count) { return 0 }
    if final_clause_len != 0 { return 0 }
    return 1
}

fn card_colour_lrat_bundle_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 389) % 1000000007
}

fn card_colour_lrat_unsat_bundle_fingerprint(vertex_count: i64, edge_count: i64, colour_count: i64,
                                             manifest_fingerprint: i64, first_derived_id: i64,
                                             derived_count: i64, final_derived_id: i64,
                                             final_clause_len: i64) -> i64 {
    if card_colour_lrat_unsat_bundle_valid(vertex_count, edge_count, colour_count,
                                           manifest_fingerprint, first_derived_id,
                                           derived_count, final_derived_id,
                                           final_clause_len) == 0 { return 0 - 1 }

    var acc: i64 = 29
    acc = card_colour_lrat_bundle_mix(acc, vertex_count)
    acc = card_colour_lrat_bundle_mix(acc, edge_count)
    acc = card_colour_lrat_bundle_mix(acc, colour_count)
    acc = card_colour_lrat_bundle_mix(acc, manifest_fingerprint)
    acc = card_colour_lrat_bundle_mix(acc, first_derived_id)
    acc = card_colour_lrat_bundle_mix(acc, derived_count)
    acc = card_colour_lrat_bundle_mix(acc, final_derived_id)
    acc = card_colour_lrat_bundle_mix(acc, final_clause_len)
    acc = card_colour_lrat_bundle_mix(acc, 1)
    return acc
}

fn main() -> i64 {
    let n: i64 = 3
    let m: i64 = 3
    let k: i64 = 2
    let fp: i64 = card_colour_manifest_fingerprint(n, m, k)

    if fp != 296728038 { return 1 }
    if card_colour_total_clause_count(n, m, k) != 12 { return 2 }
    if card_colour_first_derived_clause_id(n, m, k) != 13 { return 3 }
    if card_colour_final_derived_clause_id(n, m, k, 7) != 19 { return 4 }
    if card_colour_lrat_unsat_bundle_valid(n, m, k, fp, 13, 7, 19, 0) != 1 { return 5 }
    if card_colour_lrat_unsat_bundle_fingerprint(n, m, k, fp, 13, 7, 19, 0) != 500954697 { return 6 }

    if card_colour_lrat_unsat_bundle_valid(n, m, k, fp + 1, 13, 7, 19, 0) != 0 { return 10 }
    if card_colour_lrat_unsat_bundle_valid(n, m, k, fp, 12, 7, 19, 0) != 0 { return 11 }
    if card_colour_lrat_unsat_bundle_valid(n, m, k, fp, 13, 6, 19, 0) != 0 { return 12 }
    if card_colour_lrat_unsat_bundle_valid(n, m, k, fp, 13, 7, 18, 0) != 0 { return 13 }
    if card_colour_lrat_unsat_bundle_valid(n, m, k, fp, 13, 7, 19, 1) != 0 { return 14 }
    if card_colour_lrat_unsat_bundle_fingerprint(n, m, k, fp, 13, 7, 19, 1) != (0 - 1) { return 15 }
    if card_colour_lrat_unsat_bundle_fingerprint(n, 2, k, fp, 13, 7, 19, 0) != (0 - 1) { return 16 }

    return 0
}
