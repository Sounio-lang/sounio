//@ run-pass
//@ expect-stdout: VIZ_WEIGHTED_INFERENCE_PASS
//@ expect-stdout: data-interval-kind="confidence"
//@ expect-stdout: Conditional pointwise 95% Student intervals; df=6
//@ expect-stdout: Declared Gaussian precision model; not assessed
use stats::regression::weighted_inference::{weighted_linear_inference}
use viz::axis::{axis_label}
use viz::ir::{viz_scene_new,viz_add_forest_interval_plot,VIZ_INTERVAL_CONFIDENCE,
 viz_add_line_chart,viz_line_set_viewport,viz_add_axis,viz_node_set_label,
 viz_add_label,viz_add_series_legend,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var a:[f64;2048]=[0.0;2048]
 var b:[f64;256]=[0.0;256]
 var w:[f64;256]=[0.0;256]
 var response:[f64;8]=[1.2,2.7,5.4,6.6,9.6,10.4,13.5,14.5]
 var i:i64=0
 while i<8 {
  a[(8*i) as usize]=1.0
  a[(8*i+1) as usize]=i as f64
  b[i as usize]=response[i as usize]
  w[i as usize]=if i%2==0 {1.0} else {4.0}
  i=i+1
 }
 let undeclared=weighted_linear_inference(&a,&b,&w,8,2,1e-12,0.95,false)
 assert(undeclared.status==0 && undeclared.covariance_status==1 && undeclared.inference_status==1)
 i=0
 while i<2 {
  assert(undeclared.standard_errors[i as usize]==0.0)
  assert(undeclared.ci_lower[i as usize]==0.0 && undeclared.ci_upper[i as usize]==0.0)
  i=i+1
 }
 let result=weighted_linear_inference(&a,&b,&w,8,2,1e-12,0.95,true)
 assert(result.status==0 && result.rank==2 && result.df==6)
 assert(result.covariance_status==0 && result.inference_status==0 && result.calibration==1)
 assert(!result.variance_model_assessed)
 var estimate:[f64;1024]=[0.0;1024]
 var lower:[f64;1024]=[0.0;1024]
 var upper:[f64;1024]=[0.0;1024]
 i=0
 while i<2 {
  estimate[i as usize]=result.coefficients[i as usize]
  lower[i as usize]=result.ci_lower[i as usize]
  upper[i as usize]=result.ci_upper[i as usize]
  assert(result.standard_errors[i as usize]>0.0)
  assert(lower[i as usize]<estimate[i as usize] && upper[i as usize]>estimate[i as usize])
  assert(lower[i as usize]> -1.0 && upper[i as usize]<3.0)
  i=i+1
 }
 var scene=viz_scene_new()
 let forest=viz_add_forest_interval_plot(&!scene,&estimate,&lower,&upper,2,
  VIZ_INTERVAL_CONFIDENCE,0.95,viz_layout_rect(180,140,600,66),viz_style_rgb(80,180,240))
 assert(forest==0)
 scene.series[0].x_min= -1.0
 scene.series[0].x_max=3.0
 assert(scene.series[0].interval_kind==VIZ_INTERVAL_CONFIDENCE && scene.series[0].interval_level==0.95)
 assert(scene.series[0].lower[0]==result.ci_lower[0] && scene.series[0].upper[1]==result.ci_upper[1])
 var zx:[f64;1024]=[0.0;1024]
 var zy:[f64;1024]=[0.0;1024]
 zy[1]=1.0
 let zero=viz_add_line_chart(&!scene,&zx,&zy,2,viz_layout_rect(180,140,600,66),viz_style_rgb(180,185,195))
 assert(viz_line_set_viewport(&!scene,zero,-1.0,3.0,0.0,1.0))
 let axis=viz_add_axis(&!scene,-1.0,3.0,4,false,viz_layout_rect(180,226,600,1),viz_style_rgb(190,200,215))
