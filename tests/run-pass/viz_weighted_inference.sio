 assert(viz_add_label(&!scene,&text1,value1.n+8,viz_layout_rect(840,163,260,14),viz_style_rgb(230,235,245))>=0)
 assert(scene.node_count==14 && scene.series_count==2)
 let pixels=heap_alloc(1160*450*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:1160,height:450}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,228*1160+180)==190*65536+200*256+215)
 let marker_x=180+(((result.coefficients[0]+1.0)/4.0)*600.0) as i64
 assert(read_i64(canvas.pixels,151*1160+marker_x)==80*65536+180*256+240)
 viz_html_emit_scene(&scene,1160,450)
