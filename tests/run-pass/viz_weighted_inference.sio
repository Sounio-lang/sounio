 assert(viz_add_label(&!scene,&subtitle,49,viz_layout_rect(180,50,820,20),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_label(&!scene,&model,47,viz_layout_rect(180,80,820,20),viz_style_rgb(230,235,245))>=0)
