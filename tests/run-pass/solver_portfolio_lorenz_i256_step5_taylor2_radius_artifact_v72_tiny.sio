//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v72 smoke for Lorenz i256 step-5 Taylor-2 radius artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1129
    receipt_fp = mix(receipt_fp, 815806077, 4889)
    receipt_fp = mix(receipt_fp, 655666714, 4889)
    receipt_fp = mix(receipt_fp, 327136125, 4889)
    receipt_fp = mix(receipt_fp, 333354824, 4889)
    receipt_fp = mix(receipt_fp, 826588480, 4889)
    receipt_fp = mix(receipt_fp, 257446237, 4889)
    receipt_fp = mix(receipt_fp, 176345240, 4889)
    receipt_fp = mix(receipt_fp, 171451971, 4889)
    receipt_fp = mix(receipt_fp, 862108922, 4889)
    receipt_fp = mix(receipt_fp, 5, 4889)
    receipt_fp = mix(receipt_fp, 2, 4889)
    receipt_fp = mix(receipt_fp, 127, 4889)
    if receipt_fp != 133743506 { return 1 }

    var audit_fp: i64 = 1151
    audit_fp = mix(audit_fp, receipt_fp, 4903)
    audit_fp = mix(audit_fp, 815806077, 4903)
    audit_fp = mix(audit_fp, 655666714, 4903)
    audit_fp = mix(audit_fp, 327136125, 4903)
    audit_fp = mix(audit_fp, 333354824, 4903)
    audit_fp = mix(audit_fp, 171451971, 4903)
    audit_fp = mix(audit_fp, 862108922, 4903)
    audit_fp = mix(audit_fp, 176345240, 4903)
    audit_fp = mix(audit_fp, 5, 4903)
    audit_fp = mix(audit_fp, 2, 4903)
    audit_fp = mix(audit_fp, 127, 4903)
    if audit_fp != 23671319 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 75, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 75, 1103)
    if entry_fp != 414316671 { return 3 }

    let manifest_fp: i64 = 86228816
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 72, 1871)
    result_fp = mix(result_fp, 76, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 64, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 263120673 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 72, 1907)
    family_fp = mix(family_fp, 76, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 59, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 147525205 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 72, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 370906727 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 72, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 294632541 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 72, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 859564353 { return 8 }
    return 0
}
