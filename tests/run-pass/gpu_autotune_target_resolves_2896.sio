//@ run-pass
//@ expect-stdout: autotune target resolved
//@ requires: madaros
// #2896: gpu/opt/autotune.sio used `GpuTarget::GpuTargetPtx` without declaring
// or importing GpuTarget. Lowering fails closed on unresolved identifiers, so
// any program that reaches gpu_autotune_config_default() was refused (and the
// Madaros self-compile rung failed at gen2).
use gpu::hlir_to_gpu::*
use gpu::opt::autotune::*
use gpu::opt::fusion::*

fn main() with IO {
    let cfg = gpu_autotune_config_default()
    if cfg.sm_major == 8 {
        println("autotune target resolved")
    }
}
