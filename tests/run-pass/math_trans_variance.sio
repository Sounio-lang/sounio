//@ run-pass
//@ expect-stdout: MATH_TRANS_VARIANCE_OK
//@ requires: madaros
// First-order GUM variance (variance_of) and Hessian (hessian_of) through the
// builtins tan, atan, atan2, asin, acos, tanh and ln on Madaros. The reference
// values come from closed-form derivatives evaluated in __float128 by
// scripts/dev/gen_math_trans_var.cpp (g++ -std=c++23 gen_math_trans_var.cpp -lquadmath).
//   Var(f(x)) = f'(x)^2 sigma^2,  H = f''(x)
// Before this change tan/atan/tanh/asin/acos were refused with E221 and ln/atan2
// were unbound (E137), so none of these programs compiled.

fn near(a: f64, b: f64) -> bool {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    var m = b
    if m < 0.0 { m = 0.0 - m }
    d <= 1.0e-9 * m + 1.0e-14
}

fn t_tan() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(0.69999999999999996, uncertainty: 0.050000000000000003)
    let x = k.value
    let v = 0.0073055458276612304
    let h = 2.8796992653148323
    near(variance_of(tan(x)), v) && near(hessian_of(tan(x), 0, 0), h)
}

fn t_atan() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(0.69999999999999996, uncertainty: 0.050000000000000003)
    let x = k.value
    let v = 0.0011260754020089188
    let h = -0.63060222512499442
    near(variance_of(atan(x)), v) && near(hessian_of(atan(x), 0, 0), h)
}

fn t_tanh() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(0.40000000000000002, uncertainty: 0.050000000000000003)
    let x = k.value
    let v = 0.0018302943306161786
    let h = -0.65019813767372769
    near(variance_of(tanh(x)), v) && near(hessian_of(tanh(x), 0, 0), h)
}

fn t_asin() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(0.59999999999999998, uncertainty: 0.02)
    let x = k.value
    let v = 0.00062500000000000001
    let h = 1.1718749999999998
    near(variance_of(asin(x)), v) && near(hessian_of(asin(x), 0, 0), h)
}

fn t_acos() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(0.59999999999999998, uncertainty: 0.02)
    let x = k.value
    let v = 0.00062500000000000001
    let h = -1.1718749999999998
    near(variance_of(acos(x)), v) && near(hessian_of(acos(x), 0, 0), h)
}

fn t_ln() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(2.5, uncertainty: 0.10000000000000001)
    let x = k.value
    let v = 0.0016000000000000001
    let h = -0.16
    near(variance_of(ln(x)), v) && near(hessian_of(ln(x), 0, 0), h)
}

fn t_atan_compound() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(0.7, uncertainty: 0.05)
    let x = k.value
    let v = 0.0031862706640300559
    let h = 0.36375506315477851
    near(variance_of(atan(x * x)), v) && near(hessian_of(atan(x * x), 0, 0), h)
}

fn t_atan2() -> bool with IO, Epistemic {
    let ky: Knowledge<f64> = measure(0.6, uncertainty: 0.03)
    let kx: Knowledge<f64> = measure(0.8, uncertainty: 0.04)
    let y = ky.value
    let x = kx.value
    let v = 0.0011519999999999998
    near(variance_of(atan2(y, x)), v)
        && near(hessian_of(atan2(y, x), 0, 0), -0.95999999999999996)
        && near(hessian_of(atan2(y, x), 0, 1), -0.28000000000000008)
        && near(hessian_of(atan2(y, x), 1, 1), 0.95999999999999996)
}

fn t_atan2_const_y() -> bool with IO, Epistemic {
    let kx: Knowledge<f64> = measure(0.8, uncertainty: 0.04)
    let x = kx.value
    near(variance_of(atan2(1.0, x)), 0.00059488399762046393)
}

fn t_atan2_const_x() -> bool with IO, Epistemic {
    let ky: Knowledge<f64> = measure(0.6, uncertainty: 0.03)
    let y = ky.value
    near(variance_of(atan2(y, 0.8)), 0.00057600000000000001)
}

fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    var fails: i64 = 0
    if !t_tan() { print("FAIL tan\n")
        fails = fails + 1 }
    if !t_atan() { print("FAIL atan\n")
        fails = fails + 1 }
    if !t_tanh() { print("FAIL tanh\n")
        fails = fails + 1 }
    if !t_asin() { print("FAIL asin\n")
        fails = fails + 1 }
    if !t_acos() { print("FAIL acos\n")
        fails = fails + 1 }
    if !t_ln() { print("FAIL ln\n")
        fails = fails + 1 }
    if !t_atan_compound() { print("FAIL atan_compound\n")
        fails = fails + 1 }
    if !t_atan2() { print("FAIL atan2\n")
        fails = fails + 1 }
    if !t_atan2_const_y() { print("FAIL atan2_const_y\n")
        fails = fails + 1 }
    if !t_atan2_const_x() { print("FAIL atan2_const_x\n")
        fails = fails + 1 }
    if fails == 0 {
        print("MATH_TRANS_VARIANCE_OK\n")
        return 0
    }
    1
}
