fn check_one(
    modulus_limbs: [u16; 128],
    signature_limbs: [u16; 128],
    message_str: string,
    message_str_len: i64,
    hash_algo: i32,
    fail_base: i64,
) -> i64 with IO {
    let modulus = build_bigint_128(modulus_limbs)
    let signature = build_bigint_128(signature_limbs)
    let exponent = bigint_from_u32(65537)

    let msg_buf = rawbuf_new(message_str_len + 8)
    let msg_len = write_str(&msg_buf, message_str)
    if msg_len != message_str_len {
        return fail_base
    }

    // ---- True case: the real, independently-verified signature must
    // verify. ----
    let ok = rsa_pss_verify(&modulus, &exponent, 256, &msg_buf, msg_len, &signature, hash_algo)
    if ok == false {
        return fail_base + 1
    }
    assert(ok)

    // ---- Negative case: a signature with one flipped bit must NOT
    // verify. ----
    var corrupted_sig_limbs = signature_limbs
    corrupted_sig_limbs[0] = ((corrupted_sig_limbs[0] as i64) ^ 1) as u16
    let bad_signature = build_bigint_128(corrupted_sig_limbs)
    let bad_ok = rsa_pss_verify(&modulus, &exponent, 256, &msg_buf, msg_len, &bad_signature, hash_algo)
    if bad_ok == true {
        return fail_base + 2
    }
    assert(bad_ok == false)

    // ---- Negative case: the correct signature against a corrupted
    // message must NOT verify either. ----
    let wrong_msg_buf = rawbuf_new(message_str_len + 8)
    let wrong_msg_len = write_str(&wrong_msg_buf, message_str)
    if wrong_msg_len != message_str_len {
        return fail_base + 3
    }
    let wrong_first = rawbuf_get(&wrong_msg_buf, 0)
    rawbuf_set(&wrong_msg_buf, 0, wrong_first ^ 1)
    let bad_msg_ok = rsa_pss_verify(&modulus, &exponent, 256, &wrong_msg_buf, wrong_msg_len, &signature, hash_algo)
    if bad_msg_ok == true {
        return fail_base + 4
    }
    assert(bad_msg_ok == false)

    0
}

fn main() -> i64 with IO {
    let r256 = check_one(
        sha256_modulus_limbs(),
        sha256_signature_limbs(),
        "RSA-PSS independent test vector for Sounio TLS 1.3 rsa_pss_verify (SHA256)",
        74,
        RSA_PSS_HASH_SHA256,
        10,
    )
    if r256 != 0 {
        println("rsa_pss_verify_vectors: SHA-256 case failed")
        print_int(r256)
        return 1
    }

    let r384 = check_one(
        sha384_modulus_limbs(),
        sha384_signature_limbs(),
        "RSA-PSS independent test vector for Sounio TLS 1.3 rsa_pss_verify (SHA384)",
        74,
        RSA_PSS_HASH_SHA384,
        20,
    )
    if r384 != 0 {
        println("rsa_pss_verify_vectors: SHA-384 case failed")
        print_int(r384)
        return 1
    }

    println("rsa_pss_verify_vectors: valid signatures accepted, corrupted signatures/messages rejected")
    return 0
}
