//@ run-pass
//@ requires: madaros

// RSASSA-PSS signature verification (RFC 8017 SS8.1.2 / SS9.1.2) against
// two real, independently-generated-and-verified RSA-2048 test vectors
// (one SHA-256, one SHA-384) -- NOT transcribed from any pre-existing
// hex in this plan or repository, per this task's brief.
//
// SOURCE / METHOD (see task-1-report.md for the full transcript):
//   1. Generated with Python's `cryptography` library 43.0.0 (an
//      OpenSSL-backed, independent implementation from this project's own
//      Sounio code): `rsa.generate_private_key` (2048-bit, e=65537),
//      then `priv.sign(message, padding.PSS(mgf=padding.MGF1(hash),
//      salt_length=hash.digest_size), hash)` for SHA-256 and SHA-384.
//      MGF1 instantiated with the same hash as the signature (sLen ==
//      hLen), matching TLS 1.3's rsa_pss_rsae_* convention (RFC 8446
//      SS4.2.3). Self-checked with `pub.verify(...)` at generation time.
//   2. INDEPENDENTLY RE-VERIFIED with a second, separate tool: the
//      system `openssl pkeyutl -verify` CLI (OpenSSL 3.5.6), against a
//      PEM-exported public key, the raw message (`-rawin -digest
//      sha256`/`sha384`), the signature bytes, and explicit
//      `-pkeyopt rsa_padding_mode:pss -pkeyopt rsa_pss_saltlen:-1
//      -pkeyopt rsa_mgf1_md:<digest>`. Both vectors printed
//      "Signature Verified Successfully" (exit 0) from this fully
//      independent verification path.
//
// Modulus/signature are 2048-bit (256-byte / 128-limb) values, embedded
// below as little-endian 16-bit limb arrays derived from the raw
// generated hex (regrouped least-significant-limb-first), following the
// same pattern as tests/run-pass/pkcs1_verify.sio.

use crypto::rsa_pss::*
use bignum::bigint::*
use net::socket::*

fn write_str(buf: &RawBuf, s: string) -> i64 with IO {
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        rawbuf_set(buf, i, str_char_at(s, i))
        i = i + 1
    }
    n
}

fn build_bigint_128(values: [u16; 128]) -> BigInt {
    var result = bigint_zero()
    var i: i64 = 0
    while i < 128 {
        result.limbs[i as usize] = values[i as usize]
        i = i + 1
    }
    result.len = 128
    result
}

