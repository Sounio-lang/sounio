//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-4 Taylor-2 radius candidate artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1783
    fp = mix(fp, 4, 5711)
    fp = mix(fp, 4294967296, 5711)
    fp = mix(fp, 1000000, 5711)
    fp = mix(fp, 450696904, 5711)
    fp = mix(fp, 780071782, 5711)
    fp = mix(fp, 575348777, 5711)
    fp = mix(fp, 417943295, 5711)
    fp = mix(fp, 827089582, 5711)
    fp = mix(fp, 688797663, 5711)
    fp = mix(fp, 71000, 5711)
    fp = mix(fp, 273500, 5711)
    fp = mix(fp, 6500, 5711)
    fp = mix(fp, 304942679, 5711)
    fp = mix(fp, 1174673556, 5711)
    fp = mix(fp, 27917288, 5711)
    fp = mix(fp, 0, 5711)
    fp = mix(fp, 0, 5711)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 696087643 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 1787
    fp = mix(fp, instance, 5717)
    fp = mix(fp, 14796162350, 5717)
    fp = mix(fp, 8277823766, 5717)
    fp = mix(fp, 9452497322, 5717)
    fp = mix(fp, 1889073041, 5717)
    fp = mix(fp, 74446103, 5717)
    fp = mix(fp, 1963519144, 5717)
    fp = mix(fp, 452904300, 5717)
    fp = mix(fp, 1269198528, 5717)
    fp = mix(fp, 47552480, 5717)
    fp = mix(fp, 500000000, 5717)
    fp = mix(fp, 1500000000, 5717)
    fp = mix(fp, 100000000, 5717)
    fp = mix(fp, ok_mask, 5717)
    fp = mix(fp, 0, 5717)
    fp = mix(fp, 0, 5717)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 696087643 { return 0 - 1 }
    if certificate != 662097664 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 1789
    fp = mix(fp, instance, 5737)
    fp = mix(fp, certificate, 5737)
    fp = mix(fp, 450696904, 5737)
    fp = mix(fp, 780071782, 5737)
    fp = mix(fp, 2, 5737)
    fp = mix(fp, 4, 5737)
    fp = mix(fp, 452904300, 5737)
    fp = mix(fp, 1269198528, 5737)
    fp = mix(fp, 47552480, 5737)
    fp = mix(fp, 500000000, 5737)
    fp = mix(fp, 1500000000, 5737)
    fp = mix(fp, 100000000, 5737)
    fp = mix(fp, ok_mask, 5737)
    fp = mix(fp, 0, 5737)
    fp = mix(fp, 0, 5737)
    return fp
}

fn conversion_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let rx: i256 = 304942679 as i256
    let ry: i256 = 1174673556 as i256
    let rz: i256 = 27917288 as i256
    let x_conv_excess: i256 = rx * target_scale - (71000 as i256) * source_scale
    let y_conv_excess: i256 = ry * target_scale - (273500 as i256) * source_scale
    let z_conv_excess: i256 = rz * target_scale - (6500 as i256) * source_scale
    if x_conv_excess >= (0 as i256) {
        if y_conv_excess >= (0 as i256) {
            if z_conv_excess >= (0 as i256) {
                if x_conv_excess < target_scale {
                    if y_conv_excess < target_scale {
                        if z_conv_excess < target_scale { return 1 }
                    }
                }
            }
        }
    }
    return 0
}

fn xy_radius_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let x3_abs: i256 = 4617762706 as i256
    let z3: i256 = 4120687759 as i256
    let rhoz_abs: i256 = (28 as i256) * source_scale - z3
    let rx: i256 = 304942679 as i256
    let ry: i256 = 1174673556 as i256
    let rz: i256 = 27917288 as i256
    let dx_rad: i256 = 14796162350 as i256
    let prod_x_rhoz: i256 = 8277823766 as i256
    let dy_rad: i256 = 9452497322 as i256

    var mask: i64 = 0
    if dx_rad == (10 as i256) * (rx + ry) { mask = mask + 2 }

    let xrhoz_total: i256 =
        x3_abs * rz +
        rhoz_abs * rx +
        rx * rz
    if (prod_x_rhoz - (1 as i256)) * source_scale <= xrhoz_total {
        if prod_x_rhoz * source_scale > xrhoz_total { mask = mask + 4 }
    }
    if dy_rad == prod_x_rhoz + ry { mask = mask + 8 }
    return mask
}

fn z_radius_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let x3_abs: i256 = 4617762706 as i256
    let y3_abs: i256 = 7643846696 as i256
    let rx: i256 = 304942679 as i256
    let ry: i256 = 1174673556 as i256
    let rz: i256 = 27917288 as i256
    let prod_xy: i256 = 1889073041 as i256
    let beta_rad: i256 = 74446103 as i256
    let dz_rad: i256 = 1963519144 as i256
    let xy_total: i256 =
        x3_abs * ry +
        y3_abs * rx +
        rx * ry
    let beta_total: i256 = (8 as i256) * rz
    if (prod_xy - (1 as i256)) * source_scale <= xy_total {
        if prod_xy * source_scale > xy_total {
            if (beta_rad - (2 as i256)) * (3 as i256) < beta_total {
                if (beta_rad - (1 as i256)) * (3 as i256) >= beta_total {
                    if dz_rad == prod_xy + beta_rad { return 16 }
                }
            }
        }
    }
    return 0
}

fn next_radius_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let dt_q: i256 = 42949672 as i256
    let rx: i256 = 304942679 as i256
    let ry: i256 = 1174673556 as i256
    let rz: i256 = 27917288 as i256
    let dx_rad: i256 = 14796162350 as i256
    let dy_rad: i256 = 9452497322 as i256
    let dz_rad: i256 = 1963519144 as i256
    let next_x: i256 = 452904300 as i256
    let next_y: i256 = 1269198528 as i256
    let next_z: i256 = 47552480 as i256
    let x_step_total: i256 = dt_q * dx_rad
    let y_step_total: i256 = dt_q * dy_rad
    let z_step_total: i256 = dt_q * dz_rad
    if (next_x - rx - (1 as i256)) * source_scale <= x_step_total {
        if (next_x - rx) * source_scale > x_step_total {
            if (next_y - ry - (1 as i256)) * source_scale <= y_step_total {
                if (next_y - ry) * source_scale > y_step_total {
                    if (next_z - rz - (1 as i256)) * source_scale <= z_step_total {
                        if (next_z - rz) * source_scale > z_step_total { return 32 }
                    }
                }
            }
        }
    }
    return 0
}

fn cap_mask() -> i64 {
    let next_x: i256 = 452904300 as i256
    let next_y: i256 = 1269198528 as i256
    let next_z: i256 = 47552480 as i256
    if next_x <= (500000000 as i256) {
        if next_y <= (1500000000 as i256) {
            if next_z <= (100000000 as i256) { return 64 }
        }
    }
    return 0
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 749342117 { return 0 - 1 }
    if instance != 696087643 { return 0 - 1 }
    if certificate != 662097664 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }
    var fp: i64 = 1801
    fp = mix(fp, artifact, 5741)
    fp = mix(fp, instance, 5741)
    fp = mix(fp, certificate, 5741)
    fp = mix(fp, 450696904, 5741)
    fp = mix(fp, 780071782, 5741)
    fp = mix(fp, 4, 5741)
    fp = mix(fp, 2, 5741)
    fp = mix(fp, ok_mask, 5741)
    fp = mix(fp, 0, 5741)
    fp = mix(fp, 0, 5741)
    return fp
}

fn main() -> i64 {
    var ok_mask: i64 = 0
    ok_mask = ok_mask + conversion_mask()
    ok_mask = ok_mask + xy_radius_mask()
    ok_mask = ok_mask + z_radius_mask()
    ok_mask = ok_mask + next_radius_mask()
    ok_mask = ok_mask + cap_mask()
    if ok_mask != 127 { return 1 }

    let inst = instance_fp()
    if inst != 696087643 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 662097664 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 749342117 { return 4 }
    let audit = audit_fp(art, inst, cert, ok_mask)
    if audit != 185341710 { return 5 }
    if certificate_fp(inst, 126) != (0 - 1) { return 6 }
    return 0
}
