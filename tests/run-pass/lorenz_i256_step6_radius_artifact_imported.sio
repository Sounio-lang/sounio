//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-6 radius artifact checks conservative radius API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step6_radius_artifact_check(
        1045249011, 1372843347, 182312772,
        24180923580, 28542626778, 29915470125,
        4479326365, 486167393, 4965493758,
        1287058242, 1671998042, 231967709,
        1600000000, 2600000000, 500000000)
    if artifact_fp != 237534229 { return 1 }

    let audit_fp = lorenz_i256_step6_radius_artifact_audit_fingerprint(
        artifact_fp, 399482214, 694298444, 134624236,
        643317565, 6, 2, 127)
    if audit_fp != 931365823 { return 2 }
    return 0
}
