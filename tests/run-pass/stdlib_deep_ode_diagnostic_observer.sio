//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: ODE_DIAGNOSTIC_OBSERVER_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close}
use ode::diagnostic_observer::{diagnostic_observer_workspace,diagnostic_observer_init,diagnostic_observer_push,diagnostic_observer_get_into,diagnostic_observer_info,diagnostic_observer_status}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 assert(diagnostic_observer_workspace(0)==-1)
 assert(diagnostic_observer_workspace(9223372036854775807)==-1)
 let need=diagnostic_observer_workspace(3)
 var c=numeric_buffer_new(need,need*8)
 var slot=numeric_buffer_new(6,48)
 assert(diagnostic_observer_init(&!c,3,3,0)==0)
 assert(diagnostic_observer_push(&!c,0.0,2.0,1.0)==0)
 assert(diagnostic_observer_push(&!c,1.0,2.5,-0.5)==0)
 assert(diagnostic_observer_push(&!c,2.0,3.0,0.0)==0)
 let info=diagnostic_observer_info(&c)
 assert(info.status==0 && info.used==3 && info.events==2 && info.first_kind==2)
 assert(info.first_left==0.0 && info.first_right==1.0)
 var i:i64=0
 while i<3 {
  assert(diagnostic_observer_get_into(&c,i,&!slot)==0)
  print("ODEOBS ");print(i)
  var j:i64=0
  while j<6 {print(" ");print(numeric_buffer_at(&slot,j));j=j+1}
  println("")
  i=i+1
 }
 assert(diagnostic_observer_push(&!c,3.0,4.0,1.0)==4)
 let capacity=diagnostic_observer_info(&c)
 assert(capacity.used==3 && capacity.events==2 && capacity.status==4)
 assert(diagnostic_observer_init(&!c,3,3,0)==0)
 assert(diagnostic_observer_push(&!c,0.0,0.0,0.0)==0)
 assert(diagnostic_observer_get_into(&c,0,&!slot)==0)
 assert(numeric_buffer_at(&slot,5)==5.0)
 assert(diagnostic_observer_push(&!c,0.0,1.0,1.0)==3)
 let order=diagnostic_observer_info(&c)
 assert(order.used==1 && order.status==3)
 assert(diagnostic_observer_init(&!c,3,0,0)==0)
 assert(diagnostic_observer_push(&!c,0.0,1.0,1.0)==6)
 assert(diagnostic_observer_init(&!c,3,3,1)==0)
 assert(diagnostic_observer_push(&!c,2.0,1.0,-1.0)==0)
 assert(diagnostic_observer_push(&!c,1.0,1.0,1.0)==0)
 let backward=diagnostic_observer_info(&c)
 assert(backward.events==1 && backward.first_left==2.0 && backward.first_right==1.0)
 assert(diagnostic_observer_push(&!c,0.0,0.0/0.0,0.0)==2)
 assert(diagnostic_observer_status(&c)==2)
 let failed=diagnostic_observer_info(&c)
 assert(failed.used==2)
 assert(diagnostic_observer_init(&!c,3,3,0)==0)
 assert(diagnostic_observer_push(&!c,0.0,1.7976931348623157e308,1.7976931348623157e308)==0)
 assert(diagnostic_observer_push(&!c,1.0,-1.7976931348623157e308,-1.7976931348623157e308)==0)
 assert(diagnostic_observer_get_into(&c,1,&!slot)==0)
 assert(numeric_buffer_at(&slot,3)==0.0 && numeric_buffer_at(&slot,4)==2.0 && numeric_buffer_at(&slot,5)==10.0)
 assert(diagnostic_observer_init(&!c,3,3,1)==0)
 assert(diagnostic_observer_push(&!c,0.0,1.0,1.0)==0)
 assert(diagnostic_observer_push(&!c,1.0,1.0,-1.0)==0)
 let filtered=diagnostic_observer_info(&c)
 assert(filtered.events==0 && filtered.first_kind==0)
 assert(diagnostic_observer_init(&!c,3,9007199254740993,0)==1)
 let retained=diagnostic_observer_info(&c)
 assert(retained.used==2)
 numeric_buffer_set(&!c,3,0.5)
 assert(diagnostic_observer_status(&c)==1)
 numeric_buffer_close(c);numeric_buffer_close(slot)
 println("ODE_DIAGNOSTIC_OBSERVER_PASS")
 return 0
}
