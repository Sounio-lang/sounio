//@ run-pass
//@ requires: madaros
//@ expect-stdout: sysv_alignment_thunk: PASS
// #2537: SysV callee alignment witness for dynlink thunk.
// Calls kl14d_align_test() which uses _mm_store_ps/_mm_load_ps on a stack
// buffer. If the dynlink thunk corrupts stack alignment (old call+ret left
// rsp%16==8), the SSE instructions SIGSEGV. The new jmp thunk preserves
// rsp%16==0 and the call succeeds.
// Gate: scripts/ci/madaros_sysv_alignment_thunk_gate.sh

extern "C" {
    fn kl14d_align_test(seed: i64) -> i64
}

fn main() -> i32 with IO, Mut, Panic, Div {
    // seed=10: buf = [11,12,13,14]; sum = 11+12+13+14 = 50
    let result = kl14d_align_test(10)
    if result == 50 {
        println("sysv_alignment_thunk: PASS")
        return 0
    }
    println("sysv_alignment_thunk: FAIL result=")
    print_int(result)
    return 1
}
