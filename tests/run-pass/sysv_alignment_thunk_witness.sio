//@ run-pass
//@ requires: madaros
//@ expect-stdout: sysv_alignment_thunk: PASS
// #2537: SysV callee alignment through the dynlink stub (fix 41fae115e).
// kl14d_align_probe (tests/fixtures/kl14d/lib_align.c) returns -1000 when it
// is entered with a misaligned stack and otherwise round-trips an aligned
// SSE buffer (movaps) and returns 50 for seed 10. The gate's sabotage
// (SOUNIO_SABOTAGE_DYNLINK_THUNK_CALLRET=1) re-emits the old `call [rip+GOT];
// ret` stub; the witness must then fail. Not declared as `//@ sabotage:`:
// the generic sabotage gate cannot put the fixture library on the loader path.
// Needs libkl14d_align.so on LD_LIBRARY_PATH.
// Gate: scripts/ci/madaros_sysv_alignment_thunk_gate.sh

extern "C" {
    fn kl14d_align_probe(seed: i64) -> i64
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let first = kl14d_align_probe(10)
    // A second call from a different caller depth: the stub must not depend
    // on where in the caller's frame the call happens.
    var acc: i64 = 0
    var i: i64 = 0
    while i < 3 {
        acc = acc + kl14d_align_probe(i)
        i = i + 1
    }
    // seed 0,1,2 -> 10, 14, 18
    if first == 50 && acc == 42 {
        println("sysv_alignment_thunk: PASS")
        return 0
    }
    print("sysv_alignment_thunk: FAIL first=")
    print_int(first)
    print(" acc=")
    print_int(acc)
    print("\n")
    1
}
