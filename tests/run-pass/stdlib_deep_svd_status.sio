//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_SVD_STATUS_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_status,numeric_buffer_at,numeric_buffer_set,numeric_buffer_close,numeric_matrix}
use linalg::dynamic_svd::{dynamic_svd_workspace,dynamic_svd}
fn main()->i32 with IO,Mut,Div,Panic,Alloc {
 let impossible=dynamic_svd_workspace(9223372036854775807,9223372036854775807)
 assert(impossible.status==1 && impossible.work_len==0)
 let shape=dynamic_svd_workspace(3,2)
 assert(shape.status==0 && shape.work_len==14 && shape.u_len==6 && shape.v_len==4 && shape.sigma_len==2)
 var a=numeric_buffer_new(6,48)
 var u=numeric_buffer_new(6,48)
 var v=numeric_buffer_new(6,48)
 var sigma=numeric_buffer_new(2,16)
 var work=numeric_buffer_new(14,112)
 assert(numeric_buffer_status(&a)==0 && numeric_buffer_status(&u)==0 && numeric_buffer_status(&v)==0 && numeric_buffer_status(&sigma)==0 && numeric_buffer_status(&work)==0)
 var i:i64=0
 while i<6 {numeric_buffer_set(&!a,i,0.0);numeric_buffer_set(&!u,i,42.0);numeric_buffer_set(&!v,i,42.0);i=i+1}
 numeric_buffer_set(&!sigma,0,42.0);numeric_buffer_set(&!sigma,1,42.0)
 numeric_buffer_set(&!a,0,3.0);numeric_buffer_set(&!a,3,2.0)
 let matrix=numeric_matrix(6,3,2,2,1,0)
 let invalid=dynamic_svd(&a,&matrix,&!u,&!v,&!sigma,&!work,100,0.0,0.0)
 assert(invalid.status==1 && numeric_buffer_at(&u,0)==42.0 && numeric_buffer_at(&v,0)==42.0 && numeric_buffer_at(&sigma,0)==42.0)
 numeric_buffer_set(&!a,0,0.0/0.0)
 let nonfinite=dynamic_svd(&a,&matrix,&!u,&!v,&!sigma,&!work,100,1.0e-12,0.0)
 assert(nonfinite.status==2 && numeric_buffer_at(&u,0)==42.0)
 numeric_buffer_set(&!a,0,3.0)
 let full=dynamic_svd(&a,&matrix,&!u,&!v,&!sigma,&!work,100,1.0e-12,0.0)
 assert(full.status==0 && full.rank==2 && full.sigma_scale==3.0 && !full.transposed)
 assert(numeric_buffer_at(&sigma,0)==1.0)
 let gap=numeric_buffer_at(&sigma,1)-2.0/3.0
 assert(gap<1.0e-13 && gap> -1.0e-13)
 numeric_buffer_set(&!a,3,0.0)
 let deficient=dynamic_svd(&a,&matrix,&!u,&!v,&!sigma,&!work,100,1.0e-12,0.0)
 assert(deficient.status==0 && deficient.rank==1 && numeric_buffer_at(&sigma,1)==0.0 && deficient.orthogonality_error<=1.0e-12)
 numeric_buffer_set(&!a,0,0.0)
 let zero=dynamic_svd(&a,&matrix,&!u,&!v,&!sigma,&!work,100,1.0e-12,0.0)
 assert(zero.status==0 && zero.rank==0 && zero.sigma_scale==1.0 && numeric_buffer_at(&sigma,0)==0.0)
 numeric_buffer_set(&!a,0,1.0);numeric_buffer_set(&!a,4,2.0)
 let wide_matrix=numeric_matrix(6,2,3,3,1,0)
 let wide=dynamic_svd(&a,&wide_matrix,&!u,&!v,&!sigma,&!work,100,1.0e-12,0.0)
 assert(wide.status==0 && wide.transposed && wide.rows==2 && wide.cols==3 && wide.rank==2)
 assert(numeric_buffer_at(&sigma,0)==1.0 && numeric_buffer_at(&sigma,1)==0.5)
 assert(numeric_buffer_at(&u,2)==1.0 && numeric_buffer_at(&v,2)==1.0)
 i=0
 while i<6 {numeric_buffer_set(&!a,i,0.0);i=i+1}
 numeric_buffer_set(&!a,0,1.0);numeric_buffer_set(&!a,1,1.0e-150);numeric_buffer_set(&!a,3,1.0e-150)
 let illscaled=dynamic_svd(&a,&matrix,&!u,&!v,&!sigma,&!work,100,1.0e-12,1.0e-200)
 assert(illscaled.status==0 && illscaled.rank==2)
 let relative=numeric_buffer_at(&sigma,1)/1.0e-150
 assert(relative>0.999999999 && relative<1.000000001)
 numeric_buffer_set(&!a,0,1.0e308);numeric_buffer_set(&!a,1,0.0)
 numeric_buffer_set(&!a,3,2.2250738585072014e-308/4503599627370496.0)
 numeric_buffer_set(&!u,0,42.0);numeric_buffer_set(&!v,0,42.0);numeric_buffer_set(&!sigma,0,42.0)
 let unrepresentable=dynamic_svd(&a,&matrix,&!u,&!v,&!sigma,&!work,100,1.0e-12,0.0)
 assert(unrepresentable.status==4 && numeric_buffer_at(&u,0)==42.0 && numeric_buffer_at(&v,0)==42.0 && numeric_buffer_at(&sigma,0)==42.0)
 numeric_buffer_close(a);numeric_buffer_close(u);numeric_buffer_close(v);numeric_buffer_close(sigma);numeric_buffer_close(work)
 println("STDLIB_DEEP_SVD_STATUS_PASS")
 0
}
