//@ run-pass
//@ expect-stdout: HESSIAN_MANY_LOCALS_OK
//@ requires: madaros
// Hessian rows survive a function with more than 16 bind rows.
//
// Second-order lowering keeps one Hessian row per local that carries a
// sensitivity. LowerBigArrays.so_bind_hess had 16 rows while the first-order
// table fo_bind has 128, so a local whose bind row was >= 16 silently lost its
// Hessian: hessian_of read an empty slot, a structural zero, and printed a
// confident 0.0 with exit 0 (epistemic_hessian_8inputs printed H[7,7](x*x) = 0
// instead of 2). Eight measure locals plus eight `.value` locals already use 16
// rows, so the ninth local read -- here v7*v7 -- is the first one past the table.
//
// Expected values are the analytic Hessians of x*x (2), x*y (1) and
// x*x*x (6x = 6 at x = 1). A fix that only widened the table but stopped
// refusing overflow is covered by the compile-fail test
// epistemic_hessian_rows_overflow.sio.

fn near(a: f64, b: f64) -> bool {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    d < 1.0e-9
}

fn rows() -> bool with IO, Epistemic {
    let m0: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m1: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m2: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m3: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m4: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m5: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m6: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m7: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let v0 = m0.value
    let v1 = m1.value
    let v2 = m2.value
    let v3 = m3.value
    let v4 = m4.value
    let v5 = m5.value
    let v6 = m6.value
    let v7 = m7.value
    let keep = (v0 + v1 + v2 + v3 + v4 + v5 + v6) * 0.0
    let sq7 = v7 * v7 + keep
    let cross = v6 * v7 + keep
    let cube = v7 * v7 * v7 + keep
    near(hessian_of(sq7, 7, 7), 2.0)
        && near(hessian_of(cross, 6, 7), 1.0)
        && near(hessian_of(cube, 7, 7), 6.0)
}

fn main() -> i64 with IO, Epistemic {
    if rows() {
        print("HESSIAN_MANY_LOCALS_OK\n")
        return 0
    }
    print("HESSIAN_MANY_LOCALS_FAIL\n")
    1
}
