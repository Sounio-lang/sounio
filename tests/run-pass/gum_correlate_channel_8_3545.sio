//@ run-pass
//@ requires: madaros
//@ expect-stdout: GUM_CORRELATE_CHANNEL_8_PASS
// #3545: the last supported correlation channel stays usable for both rho forms.

fn fitted_rho() -> f64 { 1.0 }

fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    let k0: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k1: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k2: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k3: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k4: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k5: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k6: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k7: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let literal_rho = correlate(k6.value, k7.value, 0.5)
    let v_literal = variance_of(k6.value + k7.value)
    let rho = fitted_rho()
    let runtime_rho = correlate(k6.value, k7.value, rho)
    let v_runtime = variance_of(k6.value + k7.value)
    if v_literal < 0.029999999999 || v_literal > 0.030000000001 { return 1 }
    if v_runtime < 0.039999999999 || v_runtime > 0.040000000001 { return 1 }
    print("GUM_CORRELATE_CHANNEL_8_PASS\n")
    return 0
}
