//@ run-pass
//@ description: #2820 -- `ps[i].f` on an array-of-struct PARAMETER (`ps: &[P; 3]`, `ps: [P; 3]`) reads P's field `f`, not the offset of another struct's field of the same name
//@ expect-stdout: 1
//@ expect-stdout: 1
//@ expect-stdout: 3
//@ expect-stdout: 33
//@ expect-stdout: ARRAY_PARAM_STRUCT_FIELD_2820_OK
//
// Reduced from stdlib/hardware/pireus/operator_seed_kernel.sio:
// `fn osk_all_probes_complete(probes: &[PireusOskProbe; 3])` reads
// `probes[id].complete`. Madaros recorded no struct type for an array
// parameter, so the field was resolved by NAME against the first registered
// struct with a `complete` field (`Other` here, where it is field 1) and read
// P's `n` word instead: the seed kernel's probe 2 reported complete=0 with
// clean counters, and its frozen check failed. lean_single resolved it.

struct Other { x: i64, complete: bool, total: i64 }
struct P { id: i64, n: i64, total: i64, complete: bool }

fn all_complete(ps: &[P; 3]) -> bool with Mut {
    var i: i64 = 0
    while i < 3 {
        if ps[i].id != i || !ps[i].complete { return false }
        i = i + 1
    }
    true
}

fn sum_totals(ps: [P; 3]) -> i64 with Mut {
    var t: i64 = 0
    var i: i64 = 0
    while i < 3 {
        t = t + ps[i].total
        i = i + 1
    }
    t
}

fn last_id(ps: &[P; 3]) -> i64 { ps[2].id + 1 }

fn main() -> i64 with IO, Mut {
    let o = Other { x: 9, complete: false, total: 0 }
    var ps: [P; 3] = [P { id: 0, n: 0, total: 0, complete: false }; 3]
    var i: i64 = 0
    while i < 3 {
        ps[i] = P { id: i, n: 0, total: 10 + i, complete: true }
        i = i + 1
    }
    var fails: i64 = 0
    var c: i64 = 0
    if all_complete(&ps) { c = 1 }
    println(c)
    if c != 1 { fails = fails + 1 }
    var oc: i64 = 1
    if o.complete { oc = 0 }
    println(oc)
    let li = last_id(&ps)
    println(li)
    if li != 3 { fails = fails + 1 }
    let st = sum_totals(ps)
    println(st)
    if st != 33 { fails = fails + 1 }
    if fails == 0 { println("ARRAY_PARAM_STRUCT_FIELD_2820_OK") } else { println("ARRAY_PARAM_STRUCT_FIELD_2820_FAIL") }
    fails
}
