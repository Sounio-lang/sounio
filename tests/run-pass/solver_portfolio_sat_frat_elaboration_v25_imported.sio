//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v25 SAT FRAT-to-LRAT elaboration envelope smoke

use theorem::portfolio::*

fn main() -> i64 with Mod {
    let instance_fp = solver_portfolio_v25_sat_frat_elaboration_instance_fingerprint(
        3, 2, 1, 4, 5, 0)
    if instance_fp != 975208343 { return 1 }

    let certificate_fp = solver_portfolio_v25_sat_frat_elaboration_certificate_fingerprint(
        instance_fp, 459486070, 5, 0, 1)
    if certificate_fp != 86860040 { return 2 }

    let entry_fp = portfolio_entry_fingerprint(
        portfolio_kind_sat_frat_elaboration(),
        instance_fp,
        certificate_fp,
        portfolio_result_unsat(),
        portfolio_checker_sat_frat_elaboration())
    if entry_fp != 423305090 { return 3 }

    let manifest_fp = solver_portfolio_v25_sat_frat_elaboration_bundle_fingerprint(
        instance_fp, 459486070)
    if manifest_fp != 857970677 { return 4 }

    let result_coverage_fp = solver_portfolio_v25_result_coverage_fingerprint(
        25, 29, 9, 18, 1, 1, manifest_fp)
    if result_coverage_fp != 145359005 { return 5 }

    let family_coverage_fp = solver_portfolio_v25_checker_family_coverage_fingerprint(
        25, 29, 5, 3, 2, 1, 18, manifest_fp)
    if family_coverage_fp != 705272357 { return 6 }

    let acceptance_fp = solver_portfolio_v25_acceptance_receipt_fingerprint(
        25, manifest_fp, result_coverage_fp)
    if acceptance_fp != 697797234 { return 7 }

    let audit_fp = solver_portfolio_v25_audit_receipt_fingerprint(
        25, manifest_fp, result_coverage_fp, family_coverage_fp, acceptance_fp)
    if audit_fp != 136376970 { return 8 }

    let readiness_fp = solver_portfolio_v25_readiness_fingerprint(
        25, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp)
    if readiness_fp != 300977997 { return 9 }

    if solver_portfolio_v25_sat_frat_elaboration_bundle_fingerprint(
        instance_fp, 459486071) != (0 - 1) { return 10 }
    if solver_portfolio_v25_result_coverage_fingerprint(
        25, 29, 8, 18, 1, 1, manifest_fp) != (0 - 1) { return 11 }
    if solver_portfolio_v25_checker_family_coverage_fingerprint(
        25, 29, 4, 3, 2, 1, 18, manifest_fp) != (0 - 1) { return 12 }
    if solver_portfolio_v25_readiness_fingerprint(
        25, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp + 1) != (0 - 1) { return 13 }

    return 0
}
