//@ run-pass
//@ expect-stdout: variant none ok
//@ description: A user enum may have a variant called None (stdlib/snn/sedenion_layer_core.sio has SedenionActivation::None). lean_single lexed it as Option's None, so the declaration had no such variant and `Act::None => input,` compiled `input` and then `,` as an expression.

enum Act { None, Neg }

fn apply(a: Act, x: i64) -> i64 {
    match a {
        Act::None => x,
        Act::Neg => 0 - x,
    }
}

fn main() with IO {
    if apply(Act::None, 5) == 5 && apply(Act::Neg, 3) == 0 - 3 {
        println("variant none ok")
    } else {
        println("variant none wrong")
    }
}
