//@ run-pass
// Madaros print(f64) of negatives must keep magnitude (not "-0.000000").
// Regression for docs/audit/MADAROS_PRINT_NEGATIVE_F64_2026-07-14.md.
// No unary minus — form negatives as 0.0 - x.
//@ expect-stdout: -0.200000
//@ expect-stdout: -0.750000
//@ expect-stdout: -1.500000
//@ expect-stdout: -3.500000
//@ expect-stdout: 0.200000
//@ expect-stdout: 1.500000
//@ expect-stdout: 3.500000

fn main() with IO {
    let a: f64 = 0.0 - 0.2
    let b: f64 = 0.0 - 0.75
    let c: f64 = 0.0 - 1.5
    let d: f64 = 0.0 - 3.5
    let e: f64 = 0.2
    let f: f64 = 1.5
    let g: f64 = 3.5
    println(a)
    println(b)
    println(c)
    println(d)
    println(e)
    println(f)
    println(g)
}
