//@ run-pass
// E2E tests for stdlib/geo

use geo::pure::types

fn run_tests() -> i32 with IO, Mut, Div {
    var pass = 0
    var fail = 0

    print("Test 01: Point2D creation... ")
    let p1 = Point2D { x: 3.0, y: 4.0 }
    if p1.x == 3.0 && p1.y == 4.0 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 02: Point2D distance... ")
    let p2 = Point2D { x: 0.0, y: 0.0 }
    let p3 = Point2D { x: 3.0, y: 4.0 }
    let d = point2d_distance(&p2, &p3)
    if d > 4.99 && d < 5.01 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL (d=")
        print(d)
        print(")\n")
        fail = fail + 1
    }

    print("Test 03: Triangle area... ")
    let t = Triangle2D {
        p1: Point2D { x: 0.0, y: 0.0 },
        p2: Point2D { x: 4.0, y: 0.0 },
        p3: Point2D { x: 0.0, y: 3.0 },
    }
    let area = triangle_area_2d(&t)
    if area > 5.99 && area < 6.01 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL (area=")
        print(area)
        print(")\n")
        fail = fail + 1
    }

    print("Test 04: Point2D dot product... ")
    let dot = point2d_dot(&p3, &p3)
    if dot > 24.99 && dot < 25.01 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    if fail == 0 {
        print("stdlib_geo: ALL PASS (")
        print(pass)
        print("/4)\n")
        0
    } else {
        print("stdlib_geo: FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut, Div {
    run_tests()
}