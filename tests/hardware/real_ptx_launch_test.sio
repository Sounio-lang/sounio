//@ run-pass
// Sprint 1 pure-Sounio launch contract test.
// Validates launch intent -> K-AXI counters -> hardware epistemic score signal.

use hardware::launch::*

fn main() with IO, Mut, Panic, Div, Alloc {
    let cfg = launch_ptx_default_l4_config()
    let report = launch_ptx_kernel(PTX_KERNEL_EPISTEMIC_GEMM, KAXI_OP_FMA, cfg)

    assert(report.launch_accepted)
    assert(!report.used_fallback)
    assert(report.op_kind == KAXI_OP_FMA)
    assert(report.fidelity_total == 1)
    assert(report.prov_total == 1)
    assert(report.formal_total == 1)

    let hw_log_q32_32 = launch_ptx_read_epistemic_power_q32_32(report)
    let sw_log_q32_32 = launch_ptx_software_epistemic_power_log_q32_32(report)
    let hybrid_log_q32_32 = launch_ptx_hybrid_epistemic_power_log_q32_32(report)

    assert(hw_log_q32_32 == report.hardware_epistemic_power_log_q32_32)
    assert(sw_log_q32_32 > 0)
    assert(hybrid_log_q32_32 > 0)
    assert(hybrid_log_q32_32 >= hw_log_q32_32)
    assert(report.replay_flags == launch_pack_flags(KAXI_OP_FMA))

    println("real_ptx_launch_test PASS")
    println("PTX_LAUNCH_HW_LOG_Q32_32=" ++ launch_i64_to_string(hw_log_q32_32))
    println("PTX_LAUNCH_SW_LOG_Q32_32=" ++ launch_i64_to_string(sw_log_q32_32))
    println("PTX_LAUNCH_HYBRID_LOG_Q32_32=" ++ launch_i64_to_string(hybrid_log_q32_32))
    println(launch_ptx_kernel_summary(report))
}
