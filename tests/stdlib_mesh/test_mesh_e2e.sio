//@ run-pass
// E2E tests for stdlib/mesh

use mesh::pure::types

fn run_tests() -> i32 with IO, Mut, Div {
    var pass = 0
    var fail = 0

    print("Test 01: mesh_new creates empty mesh... ")
    var m1 = mesh_new()
    if mesh_vertex_count(&m1) == 0 && mesh_face_count(&m1) == 0 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 02: mesh_add_vertex adds vertices... ")
    var m2 = mesh_new()
    mesh_add_vertex(&! m2, 0.0, 0.0, 0.0)
    mesh_add_vertex(&! m2, 1.0, 0.0, 0.0)
    mesh_add_vertex(&! m2, 0.0, 1.0, 0.0)
    mesh_add_vertex(&! m2, 1.0, 1.0, 0.0)
    if mesh_vertex_count(&m2) == 4 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 03: mesh_add_face adds faces... ")
    var m3 = mesh_new()
    mesh_add_vertex(&! m3, 0.0, 0.0, 0.0)
    mesh_add_vertex(&! m3, 1.0, 0.0, 0.0)
    mesh_add_vertex(&! m3, 0.0, 1.0, 0.0)
    mesh_add_face(&! m3, 0, 1, 2)
    if mesh_face_count(&m3) == 1 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 04: mesh_get_vertex returns vertex data... ")
    var m4 = mesh_new()
    mesh_add_vertex(&! m4, 3.0, 4.0, 5.0)
    mesh_add_vertex(&! m4, 1.0, 2.0, 3.0)
    let v = mesh_get_vertex(&m4, 1)
    if v[0] == 1.0 && v[1] == 2.0 && v[2] == 3.0 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL (")
        print(v[0])
        print(",")
        print(v[1])
        print(",")
        print(v[2])
        print(")\n")
        fail = fail + 1
    }

    print("Test 05: mesh_get_face returns face indices... ")
    var m5 = mesh_new()
    mesh_add_vertex(&! m5, 0.0, 0.0, 0.0)
    mesh_add_vertex(&! m5, 1.0, 0.0, 0.0)
    mesh_add_vertex(&! m5, 0.0, 1.0, 0.0)
    mesh_add_face(&! m5, 0, 1, 2)
    let f = mesh_get_face(&m5, 0)
    if f[0] == 0 && f[1] == 1 && f[2] == 2 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL (")
        print(f[0])
        print(",")
        print(f[1])
        print(",")
        print(f[2])
        print(")\n")
        fail = fail + 1
    }

    print("Test 06: mesh_centroid computes average of vertices... ")
    var m6 = mesh_new()
    mesh_add_vertex(&! m6, 0.0, 0.0, 0.0)
    mesh_add_vertex(&! m6, 2.0, 0.0, 0.0)
    mesh_add_vertex(&! m6, 0.0, 2.0, 0.0)
    let c = mesh_centroid(&m6)
    if c[0] > 0.65 && c[0] < 0.67 && c[1] > 0.65 && c[1] < 0.67 && c[2] < 0.01 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL (")
        print(c[0])
        print(",")
        print(c[1])
        print(",")
        print(c[2])
        print(")\n")
        fail = fail + 1
    }

    if fail == 0 {
        print("stdlib_mesh: ALL PASS (")
        print(pass)
        print("/6)\n")
        0
    } else {
        print("stdlib_mesh: FAIL (")
        print(fail)
        print(" failures)\n")
        1
    }
}

fn main() -> i32 with IO, Mut, Div {
    run_tests()
}
