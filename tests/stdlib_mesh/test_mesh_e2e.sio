//@ run-pass
// E2E tests for stdlib/mesh

use mesh::pure::types

fn run_tests() -> i32 with IO, Mut {
    var pass = 0
    var fail = 0
    var m = mesh_new()

    print("Test 01: mesh_new... ")
    if mesh_vertex_count(&m) == 0 && mesh_face_count(&m) == 0 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 02: mesh_add_vertex... ")
    mesh_add_vertex(&! m, 1.0, 2.0, 3.0)
    if mesh_vertex_count(&m) == 1 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 03: mesh_add_face... ")
    mesh_add_face(&! m, 0, 1, 2)
    if mesh_face_count(&m) == 1 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    if fail == 0 {
        print("stdlib_mesh: ALL PASS (")
        print(pass)
        print("/3)\n")
        0
    } else {
        print("stdlib_mesh: FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut {
    run_tests()
}