//@ run-pass
// E2E tests for stdlib/distributed

use distributed::pure::types

fn run_tests() -> i32 with IO, Mut {
    var pass = 0
    var fail = 0

    print("Test 01: registry_new creates empty registry... ")
    var r1 = registry_new()
    if registry_size(&r1) == 0 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 02: node_id_new creates node... ")
    var n1 = node_id_new("localhost", 8080, 1)
    if n1.port == 8080 && n1.id == 1 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 03: registry_add increments size... ")
    var r2 = registry_new()
    var n2 = node_id_new("host1", 9000, 1)
    registry_add(&! r2, n2)
    if registry_size(&r2) == 1 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 04: registry_add multiple nodes... ")
    var r3 = registry_new()
    var n3 = node_id_new("host1", 9000, 1)
    var n4 = node_id_new("host2", 9001, 2)
    var n5 = node_id_new("host3", 9002, 3)
    registry_add(&! r3, n3)
    registry_add(&! r3, n4)
    registry_add(&! r3, n5)
    if registry_size(&r3) == 3 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 05: registry_add respects capacity (16)... ")
    var r4 = registry_new()
    var j = 0
    while j < 20 {
        var n = node_id_new("host", 8000 + j, j)
        registry_add(&! r4, n)
        j = j + 1
    }
    if registry_size(&r4) == 16 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL (size=")
        print(registry_size(&r4))
        print(")\n")
        fail = fail + 1
    }

    if fail == 0 {
        print("stdlib_distributed: ALL PASS (")
        print(pass)
        print("/5)\n")
        0
    } else {
        print("stdlib_distributed: FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut {
    run_tests()
}