//@ run-pass
// E2E tests for stdlib/audio

use audio::pure::types

fn run_tests() -> i32 with IO, Mut {
    var pass = 0
    var fail = 0
    var buf = audio_buffer_new(44100)

    print("Test 01: audio_buffer_new... ")
    if audio_buffer_sample_rate(&buf) == 44100 && audio_buffer_size(&buf) == 0 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 02: audio_buffer_push and size... ")
    audio_buffer_push(&! buf, 0.5)
    audio_buffer_push(&! buf, -0.5)
    audio_buffer_push(&! buf, 1.0)
    if audio_buffer_size(&buf) == 3 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 03: audio_buffer_get... ")
    let s1 = audio_buffer_get(&buf, 0)
    let s2 = audio_buffer_get(&buf, 1)
    let s3 = audio_buffer_get(&buf, 2)
    if s1 > 0.49 && s1 < 0.51 && s2 > -0.51 && s2 < -0.49 && s3 > 0.99 && s3 < 1.01 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 04: audio_buffer_get out of bounds returns 0... ")
    let s4 = audio_buffer_get(&buf, 100)
    if s4 == 0.0 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 05: fill buffer and verify... ")
    var i = 0
    while i < 100 {
        audio_buffer_push(&! buf, (i as f64) * 0.01)
        i = i + 1
    }
    if audio_buffer_size(&buf) == 103 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    if fail == 0 {
        print("stdlib_audio: ALL PASS (")
        print(pass)
        print("/5)\n")
        0
    } else {
        print("stdlib_audio: FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut {
    run_tests()
}