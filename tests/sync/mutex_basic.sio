//@ run-pass
// Basic smoke test for stdlib/sync/mutex — verifies real pthread lock/unlock cycle.

use sync::mutex::*;

fn main() -> i32 with IO {
    var m = mutex_new()

    // Lock and unlock — must not crash or deadlock
    mutex_lock(&! m)
    mutex_unlock(&! m)

    // try_lock should succeed when unheld, then unlock
    let got = mutex_try_lock(&! m)
    if got {
        mutex_unlock(&! m)
    }

    // Clean up
    mutex_destroy(&! m)

    println("mutex ok")
    return 0
}
