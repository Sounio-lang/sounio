//@ compile-fail
//@ requires: madaros
//@ error-pattern: cannot move affine value while borrowed

affine struct Permit {
    id: i64,
}

fn inspect(permit: &Permit) -> i64 {
    permit.id
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 {
    let permit = Permit { id: 97 }
    let read = || inspect(&permit)
    let moved = spend(permit)
    moved as i32
}
