//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E314]

fn precise(x: Knowledge[f64, ε < 0.5]) -> f64 with Epistemic {
    x.value
}

fn main() with IO, Epistemic {
    let measured = measure(10.0, uncertainty: 1.0)
    let mixed = measured + knight("k", 0.0, 1.0)
    println(precise(mixed))
}
