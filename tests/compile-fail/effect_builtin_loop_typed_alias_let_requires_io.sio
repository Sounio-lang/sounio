//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: error[E035
//@ description: #2760 review -- inside a `loop` body (by-value spine) a typed `let` alias of an effectful builtin keeps the builtin's IO effect, so calling it from a function declaring only Div is E035.

fn leaf() -> i64 with Div {
    loop {
        let print: fn(string) -> i64 with Div = print
        print("x")
        break
    }
    0
}

fn main() -> i64 with IO, Div {
    leaf()
}
