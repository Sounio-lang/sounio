//@ description: #2773 -- importing one name by name from two modules that each define it is refused, never bound silently to one of them.
//
// testmod::nr_a and testmod::nr_b both define pub `nr_energy`; this file
// imports it explicitly from both. Before #2773 the call ran the first-loaded
// body (nr_a's) with no diagnostic. Madaros only.
use testmod::nr_a::{nr_energy}
use testmod::nr_b::{nr_energy, nr_b_other}

fn main() -> i32 with IO {
    print_f64(nr_energy())
    println("")
    print_f64(nr_b_other())
    println("")
    0
}
