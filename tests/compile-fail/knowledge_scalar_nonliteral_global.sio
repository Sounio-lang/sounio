//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E313]
//@ description: a module-level constant whose initialiser is not a float literal is not taken as exact

fn half(v: f64) -> f64 { v / 2.0 }

let G: f64 = half(4.0)

fn main() -> i64 with IO, Epistemic {
    let x: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    let r: Knowledge<f64> = x * G
    print_f64(r.variance)
    0
}
