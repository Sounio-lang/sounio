//@ compile-fail
//@ requires: madaros
//@ error-pattern: refused instead of reading 0
//@ description: A callee whose body asks for an uncertainty (variance_of) is not given a tangent clone, and with arguments that carry no uncertainty nothing asked the call-site analysis for the measurement the callee makes inside itself, so a query on its result read 0 (the value has variance 0.09 * 4 = 0.36). A call with no clone to a function that can draw a measurement, directly or through what it calls, is refused at compile time when its result reaches a query, whatever the arguments.

fn noisy_scaled(a: f64) -> f64 with Epistemic, Mut, Div {
    let km = measure(2.0, uncertainty: 0.3)
    let m: f64 = km.value
    let v = variance_of(m)
    a * m + v
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let a0: f64 = 2.0
    let r = noisy_scaled(a0)
    print_f64(variance_of(r))
    print("\n")
    0
}
