//@ compile-fail
//@ description: SELFHOST_PASS
//@ error-pattern: not consumed
//@ description: SELFHOST_PASS

linear struct Connection {
    socket: i32,
}

fn close(c: Connection) -> i32 {
    c.socket  // actually consume by reading
}

fn process(c: Connection) -> i32 {
    let cond = false
    if cond {
        return 0  // ERROR: c not consumed on this path
    }
    let _ = close(c)
    1
}

fn main() {
    let conn = Connection { socket: 80 }
    let result = process(conn)
}
