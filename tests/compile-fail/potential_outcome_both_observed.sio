//@ compile-fail
//@ error-pattern: E073
//@ ignore
//@ description: potential outcome linear violation — cannot observe both Y(0) and Y(1) for same unit

// The Fundamental Problem of Causal Inference (Holland 1986):
//   For any unit i, only ONE of {Y_i(0), Y_i(1)} can ever be observed.
//   Y_i(0) = outcome under control; Y_i(1) = outcome under treatment.
//
// Sounio enforces this via linear types: PotentialOutcome<T> is consumed on observation.
// Attempting to use BOTH Y(0) and Y(1) for the same unit violates the linear type constraint (E073).
//
// This tests the PO track (Sprint 20): TyPotentialOutcome<T> as a linearly-consumed type.
// The individual treatment effect ITE = Y(1) - Y(0) is unobservable for any single unit;
// only the Average Treatment Effect ATE = E[Y(1) - Y(0)] can be estimated from a population.
//
// Reference: Holland 1986, Rubin 1974, Imbens & Rubin 2015 (Causal Inference for Statistics).

fn observe_control(baseline: f64) -> f64 with IO {
    // Y(0) — potential outcome under control (no treatment)
    // In Sounio, observing this consumes the PotentialOutcome<f64> linear token
    baseline
}

fn observe_treatment(baseline: f64, effect: f64) -> f64 with IO {
    // Y(1) — potential outcome under treatment
    // Also consumes the PotentialOutcome<f64> linear token for the SAME unit
    baseline + effect
}

fn main() -> i64 with IO, Div, Mut, Panic {
    let baseline: f64 = 5.0
    let effect: f64 = 2.0

    // y_ctrl = Y(0) for unit i: consumes the potential outcome token
    let y_ctrl: f64 = observe_control(baseline)

    // y_treat = Y(1) for unit i: would consume the SAME token — ILLEGAL
    // The linear type system must reject this because both potential outcomes
    // for the same unit are being materialized simultaneously, which is
    // physically impossible (fundamental problem of causal inference).
    let y_treat: f64 = observe_treatment(baseline, effect)

    // Computing y_treat - y_ctrl = ITE: requires both, violates linear type
    // E073: potential outcome token used after consumption
    let ite: f64 = y_treat + (0.0 - y_ctrl)
    42
}
