//@ compile-fail
//@ error-pattern: cannot take exclusive borrow

// Cannot take &!x while &x is active
fn use_shared(r: &i64) -> i64 {
    *r
}

fn use_exclusive(r: &!i64) -> i64 {
    *r
}

fn main() -> i32 with Mut {
    var x: i64 = 42
    let shared = &x          // shared borrow
    let exclusive = &!x      // ERROR: exclusive borrow while shared active
    return 0
}
