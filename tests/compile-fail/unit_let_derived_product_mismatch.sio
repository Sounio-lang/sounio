//@ compile-fail
//@ error-pattern: this binding expects a different type
//@ description: a let annotated with a unit refuses a product/quotient of another dimension (#2751)
//
// `distance * elapsed` has dimension m·s, not m/s. lean_single compared only
// the type hashes at the let boundary, and a product or quotient carries no
// unit-named hash (only its composed dimension), so `let speed: velocity =
// distance * elapsed` bound silently and printed 958.0. The call-argument and
// return boundaries already compared the dimension; the let boundary now does
// too (lean_single.sio: lean_let_unit_dim_mismatch).

unit velocity = m / s;

fn main() -> i32 with IO, Mut, Panic, Div {
    let distance: m = 100.0
    let elapsed: s = 9.58
    let speed: velocity = distance * elapsed
    print_f64(speed)
    return 0
}
