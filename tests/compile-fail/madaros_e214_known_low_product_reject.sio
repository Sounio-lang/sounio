//@ compile-fail
//@ requires: madaros
//@ error-pattern: confidence gate violation
// #3601 review: a product of two known low confidences (1 x 1 / 1000) must not round to the
// "unknown" sentinel 0 and skip the gate.
fn safe_dose(a: f64, b: f64) -> f64 with Mut, Epistemic(950) {
    return a * b
}
fn main() with IO, Mut, Epistemic {
    let ka: Knowledge<f64> = measure(10.0, uncertainty: 9.99)
    let kb: Knowledge<f64> = measure(10.0, uncertainty: 9.99)
    let x = ka.value * kb.value
    let d = safe_dose(x, 1.0)
    print("d="); println(d)
}
