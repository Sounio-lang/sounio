//@ compile-fail
//@ requires: lean_single
//@ error-pattern: character literals are not supported by lean_single
//@ description: lean_single has no character literals and used to skip the quotes: `[' '; 3]` filled with 0 and `'b'` read the identifier b. It now refuses them at the lexer. Madaros supports them.

fn main() with IO {
    var line: [i64; 3] = [' ' as i64; 3]
    println(line[2])
}
