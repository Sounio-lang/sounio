fn println(x: Unobserved<i64>) -> i64 with IO {
    0
}

fn leaf(x: Unobserved<i64>) -> i64 with Observe {
    loop {
        println(x)
        break
    }
    0
}

fn main() -> i64 with IO {
    0
}
