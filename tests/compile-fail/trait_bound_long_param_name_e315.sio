//@ compile-fail
//@ requires: madaros
//@ error-pattern: does not implement trait `Lj`, a bound of type parameter `Elem`

// A bound on a type parameter with a multi-letter name is checked like any
// other, by the specializer, which names the type, the trait and the parameter.
trait Lj { fn lj(self) -> f64 }
struct NaCl { pub z: i64 }
impl Lj for NaCl { fn lj(self) -> f64 { 0.300512 } }
struct SrNa { pub z: i64 }

fn sigma_of<Elem: Lj>(p: Elem) -> f64 { p.lj() }

fn main() -> i32 {
    let s = sigma_of::<SrNa>(SrNa { z: 0 })
    return 0
}
