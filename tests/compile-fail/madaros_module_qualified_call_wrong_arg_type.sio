//@ compile-fail
//@ error-pattern: E009
//@ requires: madaros
//
// PR #2515 review finding C (comment_id 4058669347): before the fix, a
// module-qualified free-fn call whose terminal name resolved to a real
// signature only suppressed the W044 "unresolved path" warning; it never
// bound `direct_sig_id`, so the callee's parameter types were never checked
// against the call's argument types (checker_check_call_args_inplace lives
// entirely inside the `direct_sig_id >= 0` block). `mod::f(wrong_type)`
// compiled clean.
//
// testmod::tc_c::tc_c_add(a: i64, b: i64) (stdlib/testmod/tc_c.sio) called
// with a bool first argument through its module-qualified path must now
// produce the same argument-type mismatch (E009) a bare `tc_c_add(true, 3)`
// would.
use testmod::tc_c;

fn main() -> i64 with IO, Mut, Panic {
    tc_c::tc_c_add(true, 3)
}
