//@ compile-fail
//@ error-pattern: affine value has already been used

affine struct Permit {
    id: i64,
}

struct Boxed<T> {
    value: T,
}

fn make_boxed<T>(value: T) -> Boxed<T> {
    Boxed { value: value }
}

fn open(boxed: Boxed<Permit>) -> i64 {
    boxed.value.id
}

fn main() -> i32 {
    let boxed = make_boxed::<Permit>(Permit { id: 71 })
    let first = open(boxed)
    let second = open(boxed)
    (first + second) as i32
}
