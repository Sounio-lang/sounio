//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E313]
//@ description: X1 absence-as-number - a below-quantification observation cannot be passed as a measurement
// PREDICTION (written before compiling): the checker refuses this with
// E313 because a Censored<f64> is not a Knowledge<f64>: it carries only
// an upper bound (< lloq), not a measured value. Replacing BLQ data by 0
// and treating it as a concentration is the lie (Beal 2001). The old
// workaround of "just use 0.0" is not an option at this boundary.

fn requires_knowledge(k: Knowledge<f64>) -> f64 with Epistemic {
    k.value
}

fn main() -> i64 with IO, Epistemic {
    let obs = censored(0.25)
    let value = requires_knowledge(obs)
    if value > 0.0 { println("unreachable") }
    return 0
}
