//@ compile-fail
//@ error-pattern: requested channel not in expression's gradient topology
//
// Gradient Topology Types (GTT) — β⁹ week-9 negative bound for
// closure / fn-ref indirect calls (open item #2).
//
// `gtt_indirect_call_topology.sio` (run-pass) proves the conservative
// union admits the in-range cross-pair.  This is the negative bound:
// a 2-arg fn-ref dispatched indirectly with args from ch[0] and ch[1]
// has gradient topology ch[0,1] — querying H_{0,2} must be refused at
// type-check, not silently return 0.0.
//
// Pre-week-9 the leak made EXPR_CH_SET = {ch1}, so this query would
// already have been refused — but for the wrong reason (ch0 missing).
// Week-9 unions to {ch0, ch1}; this test pins down that ch2 is
// correctly absent from the indirect-call return topology.

fn add2(a: f64, b: f64) -> f64 with Epistemic {
    a + b
}

fn main() with IO, Epistemic, Mut, Div {
    let k0: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let k1: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
    let x = k0.value   // channel 0
    let y = k1.value   // channel 1

    // Indirect-call return unions ch[0,1]; channel 2 is out of topology.
    let f = add2
    println(hessian_of(f(x, y), 0, 2))
}
