//@ compile-fail
//@ error-pattern: refinement type violation
//@ description: Value that clearly violates a refinement predicate is rejected statically

// Static proof engine must catch this at compile time (constant folding):
//   -3 does NOT satisfy val > 0
type Pos = { val: i64 | val > 0 }

fn main() -> i32 with IO {
    let p = Pos { val: -3 }   // ERROR: -3 violates val > 0
    return 0
}
