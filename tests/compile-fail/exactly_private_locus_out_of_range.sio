//@ compile-fail
//@ error-pattern: ZD locus
//@ description: ExactlyPrivate<T, A> must refuse an out-of-range locus. The
//@ sedenion has 15 imaginary units; e3e99 names one that does not exist.

fn release(x: ExactlyPrivate<f64, e3e99>) -> f64 with ZD { 0.0 }

// The parameter type is only interrogated once the function has a LIVE caller:
// `fn f(x: T)` alone checks clean for every T, invented types included. An
// earlier revision of these witnesses omitted this and reported PASS for a
// refusal that never happened.
fn caller() -> f64 with ZD {
    release(1.0 as ExactlyPrivate<f64, e3e99>)
}

fn main() -> i32 with IO { 0 }
