use coordination::loom_witness_mesh::{
    HostWitnessMeshReceipt,
    admit_witness_mesh_digest256,
}

fn forge_witness_mesh_receipt() -> i64 {
    let digest = admit_witness_mesh_digest256(1, 2, 3, 4, 5, 6, 7, 8)
    let forged = HostWitnessMeshReceipt {
        domain_token: 401,
        anchor_sequence: 1,
        event_count: 3,
        journal_head: digest,
    }
    0
}

fn main() -> i64 { 0 }
