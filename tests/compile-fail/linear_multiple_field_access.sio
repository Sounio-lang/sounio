//@ compile-fail
//@ error-pattern: used more than once
//@ description: Accessing multiple fields of linear struct is multiple uses

linear struct Pair {
    x: i32,
    y: i32,
}

fn sum(p: Pair) -> i32 {
    p.x + p.y  // ERROR: linear value used twice
}

fn main() {
    let pair = Pair { x: 10, y: 20 }
    let total = sum(pair)
}
