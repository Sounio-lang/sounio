//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E009]

// SIO-352 / ADR-020 (D-26): implicit borrow at a call is for identifiers
// only. A temporary passed where `&Point` is expected must be refused with
// a diagnostic (write `sum(&mk())`), never compiled into a segfault.

struct Point { x: i64, y: i64 }

fn mk() -> Point { Point { x: 3, y: 4 } }

fn sum(p: &Point) -> i64 {
    return p.x + p.y
}

fn main() -> i32 with IO {
    print_int(sum(mk()))
    println("")
    return 0
}
