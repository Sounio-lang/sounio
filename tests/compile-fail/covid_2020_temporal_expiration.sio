    signal
}

fn main() with IO {
    let stale_signal: Knowledge[f64, ValidUntil("2020-03-10"), Derived] = Knowledge {
        value: 1.7,
        epsilon: 0.86,
        validity: "2020-03-10",
        provenance: "icu_report_2020_03_10"
    }

    let _ = require_march_window(stale_signal)
}
