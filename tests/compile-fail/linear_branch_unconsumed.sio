//@ typecheck-fail
//@ error-pattern: linear value
//@ description: Linear value must be consumed in all branches

linear struct Session {
    id: i32,
}

fn end_session(s: Session) -> i32 { s.id }

fn main() {
    let s = Session { id: 1 }
    let cond = true
    if cond {
        end_session(s)
    }
    // ERROR: s not consumed in the else branch
}
