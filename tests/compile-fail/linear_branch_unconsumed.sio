//@ compile-fail
//@ error-pattern: not consumed
//@ description: Linear value must be consumed in all branches

linear struct Session {
    id: i32,
}

fn end_session(s: Session) {
    // consumes the session
}

fn main() {
    let s = Session { id: 1 }
    let cond = true
    if cond {
        end_session(s)
    }
    // ERROR: s not consumed in the else branch
}
