//@ compile-fail
//@ error-pattern: E294
//@ description: FX-7 linearity: the resume capability is used at most once on every path through a clause; a second resume is a compile error (SIO-417)

effect Ask { fn get() -> i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<Ask> {
        perform Ask.get()
    } with {
        on get() -> { let a = resume(1)
                      resume(a) }
    }
    0
}
