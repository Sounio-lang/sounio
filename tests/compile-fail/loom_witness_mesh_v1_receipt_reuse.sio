use coordination::loom_witness_mesh_v1::{
    LoomWitnessMeshV1HostTrust,
    admit_witness_mesh_v1_digest256,
    admit_verified_witness_mesh_v1_share,
    combine_verified_witness_mesh_v1_shares,
    consume_verified_witness_mesh_v1_checkpoint,
    close_host_witness_mesh_v1_receipt,
}

fn reuse_share() -> i64 with LoomWitnessMeshV1HostTrust, Panic {
    let digest = admit_witness_mesh_v1_digest256(1, 2, 3, 4, 5, 6, 7, 8)
    let first = admit_verified_witness_mesh_v1_share(101, 501, 1, 3, digest)
    let second = admit_verified_witness_mesh_v1_share(201, 501, 1, 3, digest)
    let third = admit_verified_witness_mesh_v1_share(301, 501, 1, 3, digest)
    let fourth = admit_verified_witness_mesh_v1_share(401, 501, 1, 3, digest)
    let checkpoint = combine_verified_witness_mesh_v1_shares(first, second, third)
    let receipt = consume_verified_witness_mesh_v1_checkpoint(checkpoint)
    let closed = close_host_witness_mesh_v1_receipt(receipt)
    let reused = combine_verified_witness_mesh_v1_shares(first, second, fourth)
    let second_receipt = consume_verified_witness_mesh_v1_checkpoint(reused)
    closed + close_host_witness_mesh_v1_receipt(second_receipt)
}

fn main() -> i64 { 0 }
