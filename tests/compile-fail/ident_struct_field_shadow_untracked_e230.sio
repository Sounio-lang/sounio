struct Holder {
    k: Knowledge<f64>,
}

fn mk(n: i64) -> Holder with IO {
    if n <= 0 {
        Holder { k: measure(9.0, uncertainty: 0.2) }
    } else {
        mk(n - 1)
    }
}

fn main() -> i64 with IO, Epistemic {
    let a = measure(10.0, uncertainty: 1.0)
    let b = measure(5.0, uncertainty: 1.0)
    let h = Holder { k: a }
    let flag = 1
    if flag == 1 {
        let h = mk(3)
        let s = h.k + b
        println(s.value)
    }
    0
}
