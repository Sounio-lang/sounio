//@ compile-fail
//@ error-pattern: EpistemicComplete violation
//@ description: The typed dose contract is non-bypassable. An epistemic net's
//@ confidence is computed at RUNTIME (it depends on the data seen), so it is a
//@ non-literal ε. Binding it into a Knowledge and feeding the prescription gate
//@ `with Epistemic(820)` must be REJECTED (computed ε → conf=1 < 820) — proving
//@ a learned/computed confidence cannot silently launder into a clinical dose.
//
// Counterpart: run-pass/dose_certify_accept.sio, where an explicit LITERAL-ε
// certification (the auditable clinician attestation) is accepted.

// The prescription contract: gated at the ASHP ε≥0.82 evidence bar (820/1000).
fn prescribe_vanco_dose() -> f64 with Epistemic(820), Mut, Div, Panic {
    // Stands in for the epistemic net's output: the confidence is a RUNTIME value
    // (here a plain let, exactly as a net's propagated ε would be).
    let net_conf: f64 = 0.90;
    let dose: Knowledge[f64] = Knowledge(450.0, ε=net_conf, prov="net_output_uncertified");
    dose.value
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    println(prescribe_vanco_dose());
}
