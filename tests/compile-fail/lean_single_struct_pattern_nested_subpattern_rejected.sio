// lean_single_struct_pattern_nested_subpattern_rejected
//@ compile-fail
//@ requires: lean_single
//@ error-pattern: E265
//@ description: lean_single refuses a nested/literal struct sub-pattern instead of lowering it with unbound locals
//
// lean_single lowers `field`, `field: name`, `field: _` and `..` inside a
// struct pattern. Before E265 it lowered any other sub-pattern by treating its
// identifiers as field names: the inner bindings were never created, and the
// binary could run with unbound locals (exit 139 on PR #2802).
//
// `requires: lean_single` because Madaros lowers nested struct patterns and
// accepts this program, so the diagnostic is engine-specific.

struct Inner { v: i64 }
struct Outer { tag: i64, inner: Inner }

fn main() -> i32 with IO, Panic {
    let o = Outer { tag: 1, inner: Inner { v: 42 } }
    let Outer { tag: t, inner: Inner { v } } = o
    print_int(t + v)
    0
}
