use coordination::loom_contingent_policy::{
    acquire_contingent_budget,
    close_contingent_budget,
}

fn reuse_budget() -> i64 with Panic {
    let budget = acquire_contingent_budget(100, 100, 10, 10)
    let first = close_contingent_budget(budget)
    let second = close_contingent_budget(budget)
    first + second
}

fn main() -> i64 { 0 }
