//@ compile-fail
//@ error-pattern: cannot prove ontology subsumption
ontology EndogenousObservabilityNegative {
    class EvidenceArtifact
    class ContemporaneousObservedValue subclass_of EvidenceArtifact
    class LegacyCoarsenedMissingToken subclass_of EvidenceArtifact
}

fn require_value(v: ContemporaneousObservedValue) -> i32 { 0 }

fn reject_category_error(token: LegacyCoarsenedMissingToken) -> i32 {
    require_value(token)
}
