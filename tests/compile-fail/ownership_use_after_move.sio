//@ compile-fail
//@ ignore
//@ description: SELFHOST_PASS
//@ error-pattern: moved value
//@ description: Cannot use a value after it has been moved

struct Data {
    value: i32,
}

fn take_ownership(d: Data) {
    // takes ownership of d
}

fn main() {
    let d = Data { value: 42 }
    take_ownership(d)  // d is moved here
    let x = d.value    // ERROR: use of moved value
}
