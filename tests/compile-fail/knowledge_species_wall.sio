//@ compile-fail
//@ requires: madaros
//@ error-pattern: E151
//@ description: an enthalpy cannot be delivered where a pressure is required

ontology Hydride {
    class Quantity { property amount: f64 where amount >= 0.0 }
    class Enthalpy subclass_of Quantity
    class Pressure subclass_of Quantity
    disjoint Enthalpy, Pressure
}

fn deliver(p: Knowledge<Pressure>) -> f64 with Epistemic {
    p.value
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let h: Enthalpy = 1.0
    let k: Knowledge<Enthalpy> = measure(h, uncertainty: 0.1)
    let _x = deliver(k)
    0
}
