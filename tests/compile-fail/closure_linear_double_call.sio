//@ compile-fail
//@ error-pattern: already consumed
//@ ignore BLOCKED: requires rebuilt $SOUC with Sprint 231 unified closure type theory
// Sprint 231: Linear closure called twice — must produce compile error

linear struct Resource { id: i64 }

fn make_callback(r: Resource) -> fn() -> i64 with Mut, Panic, Div {
    || -> i64 { r.id }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let cb = make_callback(Resource { id: 1 })
    let a = cb()  // OK: first call consumes
    let b = cb()  // ERROR: linear closure already consumed
    0
}
