//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: linear value has already been used
//@ description: A closure that captures a linear value may only be called once

linear struct Resource { id: i64 }

fn main() -> i32 with IO, Mut, Panic, Div {
    let resource = Resource { id: 1 }
    let cb = || -> i64 { resource.id }
    let a = cb()  // OK: first call consumes
    let b = cb()  // ERROR: linear closure already consumed
    0
}
