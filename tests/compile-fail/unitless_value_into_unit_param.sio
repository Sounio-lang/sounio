//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E041]: unit mismatch in call argument
//@ error-pattern: argument unit: (dimensionless)
// D-24 (ADR-020): a dimensionless value into a unit-bearing parameter is an
// error. A plain f64 variable carries no unit to adopt from; only pure
// literal expressions adopt the parameter unit (run-pass witness:
// unit_parameter_representation_issue2874).

unit pressure = kg / m / s / s

fn pressure_echo(delta: pressure) -> pressure { delta }

fn main() -> i32 with IO {
    let plain: f64 = 1000.0
    let returned = pressure_echo(plain)
    print("should not reach here\n")
    return 0
}
