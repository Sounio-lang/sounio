//@ compile-fail
//@ error-pattern: requested channel not in expression's gradient topology
//
// Gradient Topology Types (GTT) — β⁹ week-8 compile-fail companion.
//
// gtt_nary_topology.sio (run-pass) proves that the variadic union over
// B9_ARG_CH_SET[16] admits every in-range cross-pair at arities 3..5.
// This test is the negative bound: a user fn at arity 3 with args seeded
// from channels 0, 1, 2 has gradient topology ch[0,1,2] — querying
// H_{0,3} must be refused at type-check time, not silently return 0.0.
//
// Before week-3: only the last argument's topology was leaked, so the
// union was effectively {ch2} and H_{0,3} would have been refused for
// the wrong reason (missing ch0).  Week-3 unions to {ch0,ch1,ch2};
// this test pins down that ch3 is still correctly absent.

fn my_sum3(a: f64, b: f64, c: f64) -> f64 with Epistemic {
    a + b + c
}

fn main() with IO, Epistemic, Mut, Div {
    let k0: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let k1: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
    let k2: Knowledge<f64> = measure(5.0, uncertainty: 0.1)

    let x = k0.value   // channel 0
    let y = k1.value   // channel 1
    let z = k2.value   // channel 2

    // my_sum3 unions ch[0,1,2]; channel 3 is out of topology.
    println(hessian_of(my_sum3(x, y, z), 0, 3))
}
