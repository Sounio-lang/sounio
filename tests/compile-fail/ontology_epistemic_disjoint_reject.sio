//@ compile-fail
//@ requires: madaros
//@ error-pattern: ontology classes are disjoint and cannot be substituted
// Negative witness: Organic and Inorganic are disjoint classes,
// so Knowledge<Inorganic> cannot be substituted for Knowledge<Organic>.

ontology ChemicalOntology {
    class Chemical
    class Organic subclass_of Chemical
    class Inorganic subclass_of Chemical
    disjoint Organic, Inorganic
}

fn process_organic(x: Knowledge<Organic>) -> i32 {
    1
}

fn test_disjoint() -> i32 {
    let inorg: Knowledge<Inorganic> = measure(0 as Inorganic, uncertainty: 0.1)
    process_organic(inorg)
}

fn main() -> i32 {
    test_disjoint()
}
