//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: error[E035
//@ description: #2760 review -- same as the `let` variant, with `var`: a typed `var` alias of an effectful builtin inside a `loop` body keeps the builtin's IO effect.

fn leaf() -> i64 with Div {
    loop {
        var print: fn(string) -> i64 with Div = print
        print("x")
        break
    }
    0
}

fn main() -> i64 with IO, Div {
    leaf()
}
