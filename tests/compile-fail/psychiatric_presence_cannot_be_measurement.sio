//@ compile-fail
//@ error-pattern: expected RecordedMeasurementReceipt
// Presence in a care or research channel is not a recorded measurement.

struct EncounterPresenceReceipt { channel_id: i64 }
struct RecordedMeasurementReceipt { record_id: i64 }

fn measurement_id(measurement: RecordedMeasurementReceipt) -> i64 {
    measurement.record_id
}

fn main() -> i64 {
    let presence = EncounterPresenceReceipt { channel_id: 20 }
    measurement_id(presence)
}
