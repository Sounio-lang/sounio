//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E300]
//@ description: ADR-031 R1 -- an i64 constant expression that overflows is refused at compile time
// ADR-031 R1: an i64 constant expression whose value does not fit i64 is
// refused at compile time. Before, the checker folded it with the
// compiler's own arithmetic (wrapping on a lean_single-built compiler,
// trapping on a Madaros-built one) and the program either printed the
// wrapped value or failed only at run time.
fn main() -> i64 with IO {
    let x: i64 = 9223372036854775807 + 1
    print_int(x)
    0
}
