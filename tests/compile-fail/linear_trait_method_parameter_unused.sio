//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: linear value not consumed
//@ description: Trait implementation methods must consume a linear self parameter

trait Ignore {
    fn ignore(self) -> i32
}

linear struct Permit {
    level: i32,
}

impl Ignore for Permit {
    fn ignore(self) -> i32 {
        42
    }
}

fn main() -> i32 {
    let permit = Permit { level: 5 }
    permit.ignore()
}
