//@ compile-fail
//@ requires: madaros
//@ error-pattern: args confidence 1 < minconf 900
// A measurement whose uncertainty exceeds its value is worth no more than one
// whose uncertainty equals it. The literal confidence was 1000 - 1000*u/|v|
// only while u <= |v|; past that it fell back to the 990 default, so
// measure(10.0, uncertainty: 20.0) cleared an Epistemic(900) gate that
// measure(10.0, uncertainty: 10.0) failed. It now floors at 1, as u = |v| does.

fn gated(x: f64) -> f64 with Epistemic(900) {
    return x
}

fn main() with IO, Mut, Epistemic {
    let k: Knowledge<f64> = measure(10.0, uncertainty: 20.0)
    println(gated(k.value))
}
