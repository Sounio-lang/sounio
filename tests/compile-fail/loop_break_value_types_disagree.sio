//@ compile-fail
//@ requires: madaros
//@ error-pattern: E308
//@ description: two breaks of one `loop` carry an i64 and an f64: refused (E308), as `if` arms that disagree are.

fn main() with IO {
    var i: i64 = 0
    let r = loop {
        i = i + 1
        if i == 1 { break 1 }
        break 2.5
    }
    println(r)
}
