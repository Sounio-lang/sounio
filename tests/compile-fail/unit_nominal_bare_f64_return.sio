//@ compile-fail
//@ error-pattern: unit mismatch in return value
//@ description: returning a nominal unit from a bare `-> f64` function needs an explicit cast, exactly as a dimensionful unit does

unit mg_dL;

fn strip(x: mg_dL) -> f64 with Mut {
    return x
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let glucose = 140.0<mg_dL>
    let r = strip(glucose)
    return 0
}
