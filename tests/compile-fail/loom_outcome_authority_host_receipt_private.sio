fn forge_outcome_authority_receipt() -> i64 {
    let digest = admit_outcome_authority_digest256(1, 2, 3, 4, 5, 6, 7, 8)
    let forged = HostOutcomeAuthorityReceipt {
        policy_token: 101,
        selected_policy_token: 201,
        current_action_token: 301,
        current_path_token: 401,
        outcome_token: 501,
        generation_token: 701,
        journal_head_token: 750,
        classification_receipt_digest: digest,
    }
    0
}

fn main() -> i64 { 0 }
