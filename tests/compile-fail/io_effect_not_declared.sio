//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E035]

// SIO-27 (#2760): a bare println in a function without `with IO` must be
// refused by Madaros with E035, as lean_single refuses it. The implicit
// builtin carries the IO effect; before this, it was bound import-unknown
// with no attributed effects and the call was never asked.

fn helper() -> i64 {
    println("side effect without IO")
    0
}

fn main() -> i64 with IO {
    helper()
}
