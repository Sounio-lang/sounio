//@ compile-fail
//@ ignore
//@ description: SELFHOST_PASS
//@ error-pattern: linear value not consumed

// A linear struct value must be consumed before scope exit
linear struct Handle {
    fd: i64,
}

fn main() -> i32 with Mut, Panic, Div {
    var h = Handle { fd: 42 }
    // h is never consumed — ERROR at scope exit
    return 0
}
