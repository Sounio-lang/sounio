ontology PolicyStateFeedbackNegativeBudget {
    class EpistemicArtifact
    class BudgetArtifact subclass_of EpistemicArtifact
    class DeclaredSyntheticObservationBudget subclass_of BudgetArtifact
    class ConsentReceipt subclass_of BudgetArtifact
}

fn require_consent(v: ConsentReceipt) -> i32 { 0 }

fn reject_budget(v: DeclaredSyntheticObservationBudget) -> i32 {
    require_consent(v)
}
