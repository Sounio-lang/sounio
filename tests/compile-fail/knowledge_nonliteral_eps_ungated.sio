//@ compile-fail
//@ error-pattern: EpistemicComplete violation
//@ description: Confidence-laundering soundness guard. A Knowledge constructed with a
//@ NON-LITERAL ε (a runtime variable) cannot prove its confidence at compile time, so it
//@ must NOT satisfy a `with Epistemic(N)` gate — otherwise a low/unknown confidence could
//@ be laundered as certain by binding ε to a variable. The gate must reject (conf=1 < N).
//
// Counterpart to run-pass/dissertation_pbpk28_confidence_gate.sio (inline literal ε, which
// IS provable and compiles). A named-constant ε is conservatively treated the same as a
// runtime variable here (rejected) — compile-time const-folding of ε is future work.

fn launder_confidence() -> f64 with Epistemic(950), Mut, Div, Panic {
    let sneaky: f64 = 0.10;                                  // a low, runtime-only value
    let cl: Knowledge[f64] = Knowledge(12.4, ε=sneaky, prov="laundered");
    cl.value
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    println(launder_confidence());
}
