//@ compile-fail
//@ requires: madaros
//@ description: a borrow of a LOCAL array passed to syscall6 is refused -- a local array is a GC object of 8-byte boxed slots, and the kernel used to receive its GC handle (write(1, 0x1, 3) = EFAULT); a module-level buffer (tests/run-pass/syscall6_global_buffer.sio) keeps working
//@ error-pattern: syscall6 cannot pass a borrow of the local array `buf`

fn main() -> i32 with IO, Mut {
    var buf: [i8; 4] = [104, 105, 10, 0]
    let n: i64 = syscall6(1, 1, &!buf, 3, 0, 0, 0)
    if n != 3 { return 1 }
    0
}
