//@ compile-fail
//@ requires: madaros
//@ error-pattern: array concatenation (BinaryOp::OpConcat) is not implemented on Madaros native-v2
//@ description: `a ++ [x]` on a dynamic array reached native-v2 as a generic IrBinOp with no Concat arm and the compile died as bare rc=12, naming nothing. Until Native-v2 grows array-concat lowering (alloc + copy), the lowerer refuses by name (fail-closed), like the f128 softfloat refusal above it.

fn main() -> i32 with IO, Mut, Div, Panic, Alloc {
    var ps: [f64] = []
    ps = ps ++ [1.0]
    if ps.len() == 1 { return 0 }
    1
}
