//@ compile-fail
//@ description: #1581 — `&!s` together with `&s.y` aliases (the whole contains the field) and is refused on both engines
//@ error-pattern: borrow

struct St { y: [f64; 4], z: [f64; 4] }

fn mix(all: &!St, part: &[f64; 4]) with Mut {
    all.z[0] = (*part)[0]
}

fn main() -> i32 with IO, Mut {
    var s = St { y: [1.0, 2.0, 3.0, 4.0], z: [0.0; 4] }
    mix(&!s, &s.y)
    println(s.z[0])
    0
}
