//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: linear value not consumed
//@ description: A closure must consume each linear parameter before its scope ends

linear struct Permit {
    level: i32,
}

fn main() -> i32 {
    let ignore = |p: Permit| -> i32 { 42 }
    ignore(Permit { level: 5 })
}
