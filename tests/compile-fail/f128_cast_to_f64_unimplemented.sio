//@ compile-fail
//@ requires: madaros
//@ description: f128 cannot be cast to f64 before explicit wide conversion exists
//@ error-pattern: error[E248]
//
// Re-measured 2026-09-26: Madaros built from source at 98315edcd (no self-hosted change up to 1f4bff097) and lean_single.
// Madaros refuses wide-float casts with E248 ("wide-float casts fail closed");
// E249 is no longer emitted since the V0-B lift. lean_single implements f64<->f128
// casts in binary128 (#2387), so this refusal is Madaros-only.

fn cast_down(x: f128) -> f64 { x as f64 }
fn main() -> i32 { 0 }
