//@ compile-fail
//@ error-pattern: epsilon

// Test: Function returning Knowledge with conflicting ε bounds fails.
// Knowledge[f64, ε=0.4] cannot be assigned to Knowledge[f64, ε < 0.05]
// because the epsilon bounds are incompatible.

fn high_confidence_estimate() -> Knowledge[f64, ε < 0.05] {
    let raw: Knowledge[f64, ε=0.4] = Knowledge { value: 42.0 }
    // ERROR: epsilon bounds incompatible — 0.4 violates ε < 0.05
    raw
}

fn main() with IO {
    let x = high_confidence_estimate()
    println(x)
}
