//@ compile-fail
//@ error-pattern: error[P0003]
//@ error-pattern: expected confidence level not satisfied

// Test: Function returning Knowledge with conflicting ε confidence bounds fails.
// Knowledge[f64, ε=0.4] cannot be assigned to Knowledge[f64, ε >= 0.8]
// because the required confidence lower bound is not satisfied.

fn high_confidence_estimate() -> Knowledge[f64, ε >= 0.8] {
    let raw: Knowledge[f64, ε=0.4] = Knowledge { value: 42.0 }
    // ERROR: epsilon bounds incompatible — 0.4 violates ε >= 0.8
    raw
}

fn main() with IO {
    let x = high_confidence_estimate()
    println(x)
}
