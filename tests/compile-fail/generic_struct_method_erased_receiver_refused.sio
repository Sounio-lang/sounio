//@ compile-fail
//@ requires: madaros
//@ description: `Box1<i64>` is specialized (impl Box1__i64), but `w = Box1 { n: 0 }` names no type argument, so nothing fixes T for `w.bump(5)`; `bump` is no other type's method, so the specializer refuses instead of guessing T from the literal argument
//@ error-pattern: generic method specialization requires one unambiguous explicit turbofish

struct Box1<T> { n: i64 }

impl Box1<T> {
    fn new() -> Box1<T> {
        Box1 { n: 0 }
    }
    fn bump(self: &!Box1<T>, v: T) with Mut {
        self.n = self.n + 1
    }
}

fn main() -> i32 with Mut {
    var ok = Box1::<i64>::new()
    ok.bump(1)
    var w = Box1 { n: 0 }
    w.bump(5)
    0
}
