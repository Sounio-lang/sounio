//
// Prediction (recursion fail closed, aleatory):
// A recursive function returning Knowledge<f64> cannot have its static set
// narrowed by summary; its result widens to unknown (-1). Even when `a` and `b`
// are disjoint, `rec_scale(a, 2) + b` must be refused with E230.

fn rec_scale(x: Knowledge<f64>, n: i64) -> Knowledge<f64> {
    if n <= 0 {
        x
    } else {
        rec_scale(x * 2.0, n - 1)
    }
}

fn main() -> i64 with IO {
    let a = measure(10.0, uncertainty: 1.0)
    let b = measure(5.0, uncertainty: 1.0)
    let r = rec_scale(a, 2)
    let s = r + b
    println(s)
    0
}
