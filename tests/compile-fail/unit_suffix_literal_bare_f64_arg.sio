//@ compile-fail
//@ error-pattern: unit mismatch in call argument
//@ description: literal-suffix sibling of tests/compile-fail/unit_nominal_bare_f64_arg.sio
//
// tests/compile-fail/unit_nominal_bare_f64_arg.sio (PR #2501, feat/w1-qd128-transcend --
// not on this branch, and not touched by it) uses a NOMINAL unit (`unit mg_dL;`, no
// dimensional right-hand side) with the `<unit>` angle-bracket annotation. Neither piece
// transfers here: lean_single does not parse `<unit>` as a literal annotation at all --
// `140.0<mg_dL>` lexes as chained '<'/'>' comparisons and refuses with "undefined
// identifier `mg_dL`" on both targets -- and the nominal-unit-by-name branch of
// unit_call_arg_mismatch that PR #2501 adds to check.sio is not present on this branch, so
// a bare nominal unit still passes into f64 uncaught here regardless of literal syntax.
//
// This control instead uses a DIMENSIONAL unit with the `_suffix` literal form
// (`500.0_mg`) to exercise the exact path this fix touches: compile_primary_a64's TU[EP]
// read for k==4/k==53 literals, which feeds EXPR_UNIT/EXPR_UNIT_DIM into the same
// unit_call_arg_mismatch call-boundary check the x86 pass has always fed via
// compile_primary. Measured before this fix: x86 refused this program with "unit mismatch
// in call argument" at the uncast call; --target aarch64-linux accepted it (rc=0, ELF
// emitted) because compile_primary_a64 never read TU and so never branded the literal at
// all.

unit mg;

fn takes_f64(x: f64) -> f64 { x * 2.0 }

fn main() -> i32 with IO, Mut, Div, Panic {
    let dose = 500.0_mg
    let ok = takes_f64(dose as f64)
    println("cast mg->f64 ok")
    let bad = takes_f64(dose)
    println("implicit mg->f64 must not be accepted")
    return 0
}
