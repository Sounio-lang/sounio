//@ compile-fail
//@ requires: madaros
//@ error-pattern: incompatible types
// A nested join must not pick one arm's record owner when the arms disagree.
struct LeftOwner {alpha:f64}
struct RightOwner {point_available:bool,alpha:f64}
fn make_left_owner()->LeftOwner {LeftOwner{alpha:1.25}}
fn make_right_owner()->RightOwner {RightOwner{point_available:true,alpha:2.5}}
fn incompatible_join(pick:bool)->LeftOwner {
 let wrong=if pick {if pick {make_left_owner()}else{make_right_owner()}}else{make_left_owner()}
 wrong
}
fn main()->i32 {
 let unused=incompatible_join(true)
 0
}
