//@ compile-fail
//@ error-pattern: expected IdentificationReceipt
// A feature derived for a declared observation/prediction task is not causal
// identification evidence.

struct ObservationFeatureUseReceipt { feature_id: i64 }
struct IdentificationReceipt { assumption_id: i64 }

fn identification_id(identification: IdentificationReceipt) -> i64 {
    identification.assumption_id
}

fn main() -> i64 {
    let feature = ObservationFeatureUseReceipt { feature_id: 50 }
    identification_id(feature)
}
