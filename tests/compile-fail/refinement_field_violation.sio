//@ compile-fail
//@ error-pattern: refinement type violation
//@ description: PR-3 — struct literal with field of refined alias must enforce predicate

type Pos = { v: i32 | v > 0 }

struct Point { x: Pos, y: i32 }

fn main() {
    let p = Point { x: -3, y: 0 }  // ERROR: -3 violates field x's v > 0
}
