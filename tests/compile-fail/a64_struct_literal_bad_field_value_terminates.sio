//@ compile-fail
//@ error-pattern: E200
//@ description: #2422 an undefined name as a struct-literal field value is refused on every target; the aarch64 struct-literal loop used to spin forever on the leftover `{`
// x86-64 reports E200 (+ E006) and refuses. Before #2422 `--target aarch64-linux`
// printed the same E200 and then never terminated: compile_primary_a64's
// struct-literal field loop had no progress step for a non-identifier token.
// scripts/ci/a64_compile_fail_parity_gate.sh compiles this for both targets.
struct Receipt { id: i64 }
fn accept(r: Receipt) -> i64 { r.id }
fn main() -> i64 { accept(Receipt { id: Missing {} }) }
