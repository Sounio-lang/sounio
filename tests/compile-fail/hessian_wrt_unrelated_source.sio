//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E312]
//@ error-pattern: hessian_wrt source is not a measured source that the value depends on
//@ description: hessian_wrt refuses a measured source that z does not depend on

fn main() -> i64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(5.0, uncertainty: 0.0)
    let other: Knowledge<f64> = measure(7.0, uncertainty: 0.0)
    let x = xm.value
    let y = ym.value
    let z = x * y
    // `other` is a measured source, but z never depends on it: E312.
    let h = hessian_wrt(z, xm, other)
    if h == 0.0 {
        println("unreachable")
    }
    return 0
}
