//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: error[E035
//@ description: #2760 review -- `let print: fn(string) -> i64 with Div = print` aliases the builtin under a type annotation; the alias must not erase the builtin's IO effect, so calling it from a function declaring only Div is E035.

fn leaf() -> i64 with Div {
    let print: fn(string) -> i64 with Div = print
    print("x")
    0
}

fn main() -> i64 with IO, Div {
    leaf()
}
