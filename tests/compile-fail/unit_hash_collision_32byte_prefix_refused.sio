//@ compile-fail
//@ error-pattern: unit name collides with a different unit's hash
//@ description: unit_bytes_eq/unit_register_named_h clamped BOTH the stored and the compared name to UNIT_NAME_CAP (32), so two DIFFERENT unit names sharing a hash AND their first 32 bytes compared equal past that shared prefix -- the exact collision the exact-name fix exists to catch, just truncated. Cap now matches the parser's own 128-byte identifier width. `PrefixSharedThirtyThreeBytesXXXXXir7ws61prThPBToM` (50 bytes) and `PrefixSharedThirtyThreeBytesXXXXXerBmq31xkC` (44 bytes) share a 33-byte prefix (one byte past the old cap) and a genuine gl_name_hash collision, found by random search, not synthetic.

unit PrefixSharedThirtyThreeBytesXXXXXir7ws61prThPBToM;
unit PrefixSharedThirtyThreeBytesXXXXXerBmq31xkC;

fn takes_first(x: PrefixSharedThirtyThreeBytesXXXXXir7ws61prThPBToM) -> f64 with Mut { x as f64 }

fn main() with IO, Mut, Div, Panic {
    let b: PrefixSharedThirtyThreeBytesXXXXXerBmq31xkC = 2.0
    let leak = takes_first(b)
    println("LEAK: must not compile")
}
