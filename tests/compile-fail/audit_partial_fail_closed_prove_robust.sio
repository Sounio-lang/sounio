//@ compile-fail

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {
    require sign_consensus >= 1.0
    require relative_band <= 0.15
}

audit PartialAudit for Contest<i64, DefaultModels, DefaultPolicy> {
    metrics {
        sign_consensus: 1.0
    }
}

fn main() -> i64 {
    let d: i64 = 42
    let c: Contest<i64, DefaultModels, DefaultPolicy> = (contest [M1] on d) audit PartialAudit
    let r: Robust<i64, Stable, InDistribution> = prove_robust(c, DefaultPolicy)
    0
}
