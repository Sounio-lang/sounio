//@ compile-fail
//@ requires: madaros
//@ description: KL-20 -- a match over a payload-carrying enum that leaves a variant unmatched is E280 (a value no arm matched used to yield the 0 the end label loads, i.e. a null cell)
//@ error-pattern: error[E280]

enum Shape { Circle(f64), Rect(f64, f64), Empty }

fn area(s: Shape) -> f64 {
    match s {
        Shape::Circle(r) => r * r,
        Shape::Empty => 0.0,
    }
}

fn main() -> i64 { area(Shape::Empty) as i64 }
