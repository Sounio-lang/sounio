// refinement_compound_violation
//@ compile-fail
//@ error-pattern: refinement type violation
//@ description: PR-6 — AND compound predicate: value satisfies first but violates second

fn bounded(x: { n: i32 | n > 0 && n < 100 }) -> i32 {
    x
}

fn main() {
    let result = bounded(200)  // ERROR: 200 > 0 but 200 >= 100, violates n < 100
}
