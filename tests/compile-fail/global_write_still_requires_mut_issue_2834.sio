//@ compile-fail
//@ requires: lean_single
//@ error-pattern: E035
//@ description: #2834 guard — a module-global outlives the frame, so writing it still requires `Mut` under lean_single

var COUNTER: i64 = 0

fn tick() -> i64 {
    COUNTER = COUNTER + 1
    COUNTER
}

fn main() -> i64 with IO, Mut {
    println(tick())
    0
}
