//@ typecheck-fail
//@ error-pattern: affine value used more than once
//@ requires: madaros
// lean_single rejects this if-expression as "use of moved value" and does not
// print the affine sentence. The OR-join (one arm spends, the later use is
// E268) is the modular checker. `compile` on that checker dies with SIGSEGV
// after the diagnostic, so the pin is `souc check`, not `souc compile`.

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 {
    let permit = Permit { id: 7 }
    let enabled = true
    let result = if enabled {
        spend(permit)
    } else {
        0
    }
    let again = spend(permit)
    (result + again) as i32
}
