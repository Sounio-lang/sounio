//@ compile-fail
//@ requires: madaros
//@ error-pattern: Temporal validity window mismatch
// Negative witness: ValidWhile(expr) predicates are compared by identity, not
// treated as interchangeable just because both are "some" condition. A value
// valid ONLY while an unrelated predicate (`y > 0`) holds must not satisfy a
// parameter that requires validity while a DIFFERENT predicate (`x > 0`)
// holds -- even though both are ValidWhile and the inner ontology type and
// epsilon are identical.

ontology ChemicalOntology {
    class Chemical
    class CHEBI_15377 subclass_of Chemical
}

fn require_while_x_positive(
    w: Knowledge[CHEBI_15377, ValidWhile(x > 0), Derived]
) -> Knowledge[CHEBI_15377, ValidWhile(x > 0), Derived] {
    w
}

fn test_validwhile_predicate_mismatch(
    y: i64,
    other: Knowledge[CHEBI_15377, ValidWhile(y > 0), Derived]
) {
    require_while_x_positive(other)
}

fn main() {
}
