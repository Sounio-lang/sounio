//@ compile-fail
//@ requires: madaros
//@ error-pattern: Temporal validity window mismatch
// Negative witness: ValidWhile(expr) predicates are compared by identity, not
// treated as interchangeable just because both are "some" condition. A value
// valid ONLY while an unrelated predicate (`2 > 1`, structurally distinct)
// holds must not satisfy a parameter that requires validity while a
// DIFFERENT predicate (`1 > 0`) holds -- even though both are ValidWhile and
// the inner ontology type and epsilon are identical. Both predicates are
// closed boolean expressions over literals (no free identifiers) so this
// exercises pred_id mismatch specifically, not the separate
// resolve-and-must-be-bool check ValidWhile predicates also get.

ontology ChemicalOntology {
    class Chemical
    class CHEBI_15377 subclass_of Chemical
}

fn require_while_one_gt_zero(
    w: Knowledge[CHEBI_15377, ValidWhile(1 > 0), Derived]
) -> Knowledge[CHEBI_15377, ValidWhile(1 > 0), Derived] {
    w
}

fn test_validwhile_predicate_mismatch(
    other: Knowledge[CHEBI_15377, ValidWhile(2 > 1), Derived]
) {
    require_while_one_gt_zero(other)
}

fn main() {
}
