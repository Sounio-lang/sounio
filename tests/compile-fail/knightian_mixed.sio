//@ compile-fail
//@ error-pattern: Knightian uncertainty (ε=⊥) cannot satisfy required confidence

fn bayesian_update(prior: Knowledge[f64, ε >= 0.5]) -> Knowledge[f64, ε >= 0.5] {
    prior * 0.9
}

fn main() with IO {
    let march_2020_unknown: Knowledge[f64, ε=⊥] = Knowledge { value: 0.7 }
    let _posterior = bayesian_update(march_2020_unknown)
}
