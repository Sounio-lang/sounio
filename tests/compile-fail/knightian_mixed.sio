//@ compile-fail
//@ ignore
// TODO: Knightian subtyping enforcement not yet implemented in type checker.
// When Knowledge[T, ε=⊥] → Knowledge[T, ε >= 0.5] subtyping is wired in,
// remove the //@ ignore and this should fail with "Knightian" in the error.

fn bayesian_update(prior: Knowledge[f64, ε >= 0.5]) -> Knowledge[f64, ε >= 0.5] {
    prior * 0.9
}

fn main() with IO {
    let unknown: Knowledge[f64, ε=⊥] = Knowledge { value: 0.7 }
    // Should error: Knightian ε=⊥ is not a subtype of Knowledge[f64, ε >= 0.5]
    let result = bayesian_update(unknown)
    println(result)
}
