//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E315]

// Instantiating a bounded type parameter with a type that has no impl of the
// bound is refused at the call site.
trait Lj { fn lj(self) -> (f64, f64, i64, i64) }
struct NaCl { pub z: i64 }
impl Lj for NaCl { fn lj(self) -> (f64, f64, i64, i64) { (0.300512, 1.438894, 2, 2) } }
struct SrNa { pub z: i64 }

fn sigma_of<T: Lj>(p: T) -> f64 { let (s, e, src, how) = p.lj(); s }

fn main() -> i32 {
    let p = SrNa { z: 0 }
    let s = sigma_of::<SrNa>(p)
    return 0
}
