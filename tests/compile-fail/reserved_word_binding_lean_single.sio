//@ compile-fail
//@ requires: lean_single
//@ error-pattern: is a reserved word and cannot name a binding
//@ description: ADR-015 row 10 -- async, await, spawn, crate, super, perform and resume stay reserved. Madaros refuses them as names; lean_single used to accept `let spawn = 1; println(spawn)`. A binding named after one is now refused (declaration names such as `fn spawn` stay valid).

fn main() with IO {
    let spawn = 1
    println(spawn)
}
