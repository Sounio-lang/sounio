//@ compile-fail
//@ requires: madaros
//@ error-pattern: refused instead of reading 0
//@ description: A closure passed to a helper that calls it and also measures inside itself, with a certain argument: the call through the parameter is not resolved, so a query on the result is refused at compile time. Before it read 0 (the value s = 4 m has first-order variance 16 * 0.09 = 1.44).

fn apply1(f: fn(f64) -> f64 with Mut, Div, x: f64) -> f64 with Epistemic, Mut, Div {
    let km = measure(2.0, uncertainty: 0.3)
    let m: f64 = km.value
    var s = 0.0
    var i: i64 = 0
    while i < 1 {
        s = s + f(x) * m
        i = i + 1
    }
    s
}
fn main() -> i32 with IO, Mut, Div, Epistemic {
    let a0: f64 = 2.0
    let g = |y: f64| -> f64 { y * 2.0 }
    let r = apply1(g, a0)
    print_f64(variance_of(r))
    print("\n")
    0
}
