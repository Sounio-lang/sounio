//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: error[E266]
//@ description: #1568 — a fully-qualified call whose module was never `use`d is refused at check time
//
// Before: Madaros printed warning W044, `check` reported OK, and the binary
// trapped (SIGILL, an empty ud2 stub) or, on older binaries, silently returned
// 0.0. lean_single already refused this program (E200). With `use
// epistemic::sobol_indices::variance` the same call computes 1.000000.
var XS: [f64; 16384] = [0.0; 16384]

fn main() -> i64 with IO, Mut, Div {
    XS[0] = 1.0
    XS[1] = 2.0
    XS[2] = 3.0
    let v: f64 = epistemic::sobol_indices::variance(XS, 3)
    println(v)
    0
}
