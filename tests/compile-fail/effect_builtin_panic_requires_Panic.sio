//@ typecheck-fail
//@ error-pattern: error[E035
//@ description: #2760 -- the builtin `panic` carries the Panic effect; a caller that does not declare it is rejected on both engines.

fn leaf(n: i64) -> i64 {
    panic("x")
    n + 1
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    leaf(1)
}
