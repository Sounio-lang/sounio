//@ compile-fail
//@ error-pattern: error[E258]
//@ requires: madaros
//@ description: string literal past Name capacity must refuse (E258), never silently truncate
//
// lean_single has its own, separate, lower hard limit (256 bytes) and its own
// message ("string literal exceeds maximum of 256 bytes") -- it already
// refuses rather than silently truncating, it just isn't E258. This test is
// Madaros-specific because the error PATTERN differs, not because lean_single
// has the silent-truncation bug this diagnostic exists to prevent.
fn main() with IO {
    let s = ""
    println(s)
}
