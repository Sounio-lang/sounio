//@ compile-fail
//@ requires: madaros
//@ error-pattern: confidence gate violation
// #3601 review: a KNOWN confidence of zero must not be read as "unknown".
// measure(10.0, uncertainty: 10.0) has confidence 1000 - 1000 = 0 (known), below the floor 950.
fn safe_dose(w: f64) -> f64 with Mut, Epistemic(950) {
    return w * 2.0
}
fn main() with IO, Mut, Epistemic {
    let k: Knowledge<f64> = measure(10.0, uncertainty: 10.0)
    let w = k.value
    let d = safe_dose(w)
    print("d="); println(d)
}
