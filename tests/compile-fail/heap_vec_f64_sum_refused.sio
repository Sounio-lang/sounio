//@ compile-fail
//@ requires: madaros
//@ description: HeapVec<T>::sum returned i64 through read_i64 for every T, so a HeapVec<f64> summed IEEE-754 bit patterns (1.0 + 2.0 gave 9218868437227405312). sum left the generic impl: on a HeapVec<f64> it is a compile-time refusal; heap_vec_sum_i64 and HeapF64Vec::sum remain
//@ error-pattern: error[E011]

use collections::heap_vec::*;

fn main() -> i32 with IO, Alloc, Mut {
    var v = HeapVec::<f64>::new()
    v.push(1.0)
    v.push(2.0)
    let s = v.sum()
    v.free()
    0
}
