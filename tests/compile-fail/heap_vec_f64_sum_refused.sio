//@ compile-fail
//@ requires: madaros
//@ description: HeapVec<T>::sum returned i64 through read_i64 for every T, so a HeapVec<f64> summed IEEE-754 bit patterns (1.0 + 2.0 gave 9218868437227405312). sum was removed from HeapVec<T> (a generic -> T sum needs + on T, which the unspecialized generic-impl check rejects), so on a HeapVec<f64> it is a compile-time refusal; HeapF64Vec::sum remains
//@ error-pattern: error[E011]

use collections::heap_vec::*;

fn main() -> i32 with IO, Alloc, Mut {
    var v = HeapVec::<f64>::new()
    v.push(1.0)
    v.push(2.0)
    let s = v.sum()
    v.free()
    0
}
