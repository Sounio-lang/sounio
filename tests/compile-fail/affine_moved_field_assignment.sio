//@ compile-fail
//@ error-pattern: affine value has already been used

affine struct Permit {
    id: i64,
}

struct Holder {
    permit: Permit,
}

fn take(holder: Holder) -> i64 {
    holder.permit.id
}

fn main() -> i32 with Mut {
    var holder = Holder { permit: Permit { id: 131 } }
    let spent = take(holder)
    holder.permit = Permit { id: 137 }
    spent as i32
}
