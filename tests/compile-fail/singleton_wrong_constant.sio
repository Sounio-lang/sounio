//@ compile-fail
//@ error-pattern: E070
//@ ignore
//@ description: singleton wrong constant — arbitrary f64 does not satisfy Singleton<speed_of_light>

// Singleton<f64, "speed_of_light"> must be the canonical CODATA 2022 value: 299792458.0 m/s
// Passing an approximate f64 literal (3.0e8) must be rejected by the type system.
//
// This tests the SC track (Sprint 20): singleton constants prevent silent substitution errors.
// A function requiring the exact speed of light cannot accept an arbitrary floating-point value.

fn needs_speed_of_light(c: f64) -> f64 with IO, Div {
    // This function's parameter would be typed Singleton<f64, "speed_of_light"> in a
    // fully elaborated type annotation. The test verifies that passing a non-singleton f64
    // violates the singleton identity constraint (E070).
    c * c
}

fn main() -> i64 with IO, Div {
    // 3.0e8 is a common approximation of c, but it is NOT the canonical singleton.
    // The singleton type system rejects it because it lacks the "speed_of_light" identity tag.
    let wrong: f64 = 3.0e8
    let _ = needs_speed_of_light(wrong)
    42
}
