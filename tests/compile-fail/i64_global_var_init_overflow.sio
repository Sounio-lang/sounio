//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E300]
//@ description: ADR-031 R1 -- a module-level var whose i64 constant initializer overflows is refused at compile time
// ADR-031 R1: 3037000500 * 3037000500 exceeds i64::MAX by one square step.
// Without a type annotation the initializer is an i64 too.
var G = 3037000500 * 3037000500

fn main() -> i64 with IO {
    print_int(G)
    0
}
