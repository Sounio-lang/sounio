//@ compile-fail
//@ requires: madaros
//@ error-pattern: cannot implicitly coerce contested evidence
//@ description: contest(a, b) has type Contest<f64> (ADR-016, decision 2): the disagreeing sources are carried, never passed off as one value, so using the contest where an f64 is expected is refused.
fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    let k0 = measure(1.0, uncertainty: 0.1)
    let k1 = measure(1.3, uncertainty: 0.1)
    let c = contest(k0.value, k1.value)
    let v: f64 = c
    print_f64(v)
    0
}
