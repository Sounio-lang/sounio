//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E035]

// SIO-27 (#2760): a bare read_file in a function without `with IO` must be
// refused by Madaros with E035, as lean_single refuses it. This fixture
// declares no read_file of its own: the name is the implicit builtin.

fn load_data() -> string {
    let content = read_file("test.txt")
    content
}

fn main() -> i64 with IO {
    let s = load_data()
    0
}
