//@ compile-fail
//@ error-pattern: Undefined type: Default
//@ ignore
// Verify that using an unrecognised trait name as a generic bound is rejected.
//
// The resolver treats bound names as type references; referencing an unknown
// name such as `Default` (not declared in stdlib or the file) fails at the
// resolution phase before the checker even reaches the call site.

fn make_default<T: Default>(seed: i32) -> i32 {
    // The body is irrelevant; bounds validation fires at the call site.
    seed + 1
}

fn main() {
    // Passing () (unit) as T violates the Default bound
    let x = make_default::<()>(0)
}
