//@ compile-fail
//@ error-pattern: E067
//@ ignore
//@ description: all confounders unobserved — no valid adjustment set can be constructed

// Causal DAG: X <-> Y (bidirected confounding arc, hidden common cause).
// The only confounding path is through the hidden common cause.
// Since no node is observed that could serve as a deconfounding variable,
// P(Y|do(X)) is non-identifiable from observational data.
// E067: non_identifiable_query

fn estimate_direct_confound(x: f64, y: f64) -> f64 with IO {
    // Direct confounding: X and Y share hidden cause
    y + (0.0 - x)
}

fn main() -> i64 with IO {
    42
}
