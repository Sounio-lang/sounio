//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E313]
//@ description: a mutable global sharing its name with another module's constant is not exact

// The global-constant name table is keyed by name across all loaded
// modules. Here SCALE is a `var` of this module, mutated before use; the
// imported module has an immutable SCALE. Only a name declared once, with a
// literal initialiser, may count as exact.
use fixtures::knowledge_scale_shadow::{scale_tag}

var SCALE: f64 = 2.0

fn main() -> i64 with IO, Mut, Epistemic {
    SCALE = 10.0
    let x: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    let r: Knowledge<f64> = x * SCALE
    print_f64(r.variance)
    print_int(scale_tag())
    0
}
