//@ compile-fail
//@ error-pattern: error[E189]
//@ error-pattern: does not balance in charge
//@ error-pattern: charge left 2, right 3
// Charge balance, isolated from mass balance. Iron is conserved (Fe 1/1), so
// no E188 can fire; only the charge is wrong, +2 on the left against +3 on the
// right. The diagnostic must report both totals, not merely that they differ.
//
// Charge is written the way chemists and both reference engines write it —
// trailing + / - repeated for multiplicity — so `Fe++` is +2 and `Fe+++` is +3.

reaction iron_oxidation_unbalanced {
    Fe++ -> Fe+++
}

fn main() with IO {
    println("unreachable")
}
