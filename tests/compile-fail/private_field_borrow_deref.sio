//@ compile-fail
//@ error-pattern: E259
use collections::numeric_buffer::{NumericBuffer,numeric_buffer_new,numeric_buffer_close}
fn overwrite(x:&!i64) with Mut {*x=0}
fn leak(owner:&!NumericBuffer) with Mut {overwrite(&!(*owner).size)}
fn main() with Alloc,Mut,Div {
 var owner=numeric_buffer_new(1,8)
 leak(&!owner)
 numeric_buffer_close(owner)
}
