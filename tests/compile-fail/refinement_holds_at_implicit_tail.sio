//@ compile-fail
//@ requires: madaros
//@ error-pattern: E042
//
// The implicit tail return carries the same obligation as an explicit one.
// `fn f() -> T { 2000000000 }` and `fn f() -> T { return 2000000000 }` are the
// same claim about the same value; on main@88c2ab8ee8 Madaros accepted both.
//
// This is the FREE-FUNCTION tail, which is a different call site in the checker
// from the explicit return (checker_check_fn_item_inplace's
// checker_fn_body_return_compatible_inplace, not
// checker_check_return_expr_inplace). Fixing only the explicit return would
// leave this hole open and the refinement still launderable, just with one
// keyword fewer. The explicit-return sibling is refinement_holds_at_return.sio.
//
// Inline refinement, not a `type` alias -- see the note in that sibling file.

fn escape_by_tail() -> { n: i64 | n >= 0 && n < 1000000007 } {
    2000000000
}

fn main() -> i64 with IO {
    println("unreachable")
    0
}
