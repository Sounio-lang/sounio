//@ compile-fail
//@ requires: madaros
//@ error-pattern: E042
//
// The implicit tail return carries the same obligation as an explicit one.
// `fn f() -> T { 2000000000 }` and `fn f() -> T { return 2000000000 }` are the
// same claim about the same value, and before 2026-08-21 neither was checked
// against the refinement -- only bindings were, and the two callers of
// checker_check_refinement_literal_inplace were both in the let/var handlers.

type Fp = { n: i64 | n >= 0 && n < 1000000007 }

fn escape_by_tail() -> Fp {
    2000000000
}

fn main() -> i64 with IO {
    println("unreachable")
    0
}
