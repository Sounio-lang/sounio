//@ compile-fail
//@ requires: madaros
//@ error-pattern: argument type does not match parameter

affine struct Permit {
    id: i64,
}

fn call_twice(callback: fn() -> i64) -> i64 {
    callback() + callback()
}

fn main() -> i32 {
    let permit = Permit { id: 103 }
    let spend = || permit.id
    call_twice(spend) as i32
}
