//@ compile-fail
//@ requires: madaros

affine struct Permit {
    id: i64,
}

enum BorrowCarrier {
    Left { permit: &Permit },
    Right { permit: &Permit },
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 {
    let left = Permit { id: 229 }
    let right = Permit { id: 233 }
    let choose_left = false
    let carried = if choose_left {
        BorrowCarrier::Left { permit: &left }
    } else {
        BorrowCarrier::Right { permit: &right }
    }
    let consumed = spend(left)
    consumed as i32
}
