//@ compile-fail
//@ requires: madaros
//@ error-pattern: tuple return type's Box<T> payload names exceed 384 bytes
//@ description: lower_tuple_box_slot_list comma-joins each Box slot's type name into ONE Name (384-byte cap). A tuple with enough long Box-typed slots overflows it; the encoder used to return an empty name silently while return_box_slot still said "has boxes", so return_tuple_box_layout_for_fn_slot treated every slot as non-Box and fell back to untyped, name-based field resolution. Measured: the pre-patch compiler accepted this file and the resulting program SEGFAULTED at runtime dereferencing the mistyped slots. Refused now via the existing IR_LOWER_HARD_ERROR channel.

struct VeryLongStructNameNumber00QuiteVerboseIndeed { field: i64 }
struct VeryLongStructNameNumber01QuiteVerboseIndeed { field: i64 }
struct VeryLongStructNameNumber02QuiteVerboseIndeed { field: i64 }
struct VeryLongStructNameNumber03QuiteVerboseIndeed { field: i64 }
struct VeryLongStructNameNumber04QuiteVerboseIndeed { field: i64 }
struct VeryLongStructNameNumber05QuiteVerboseIndeed { field: i64 }
struct VeryLongStructNameNumber06QuiteVerboseIndeed { field: i64 }
struct VeryLongStructNameNumber07QuiteVerboseIndeed { field: i64 }
struct VeryLongStructNameNumber08QuiteVerboseIndeed { field: i64 }
struct VeryLongStructNameNumber09QuiteVerboseIndeed { field: i64 }

fn make_all() -> (Box<VeryLongStructNameNumber00QuiteVerboseIndeed>, Box<VeryLongStructNameNumber01QuiteVerboseIndeed>, Box<VeryLongStructNameNumber02QuiteVerboseIndeed>, Box<VeryLongStructNameNumber03QuiteVerboseIndeed>, Box<VeryLongStructNameNumber04QuiteVerboseIndeed>, Box<VeryLongStructNameNumber05QuiteVerboseIndeed>, Box<VeryLongStructNameNumber06QuiteVerboseIndeed>, Box<VeryLongStructNameNumber07QuiteVerboseIndeed>, Box<VeryLongStructNameNumber08QuiteVerboseIndeed>, Box<VeryLongStructNameNumber09QuiteVerboseIndeed>) with Alloc {
    (Box::new(VeryLongStructNameNumber00QuiteVerboseIndeed { field: 0 }), Box::new(VeryLongStructNameNumber01QuiteVerboseIndeed { field: 1 }), Box::new(VeryLongStructNameNumber02QuiteVerboseIndeed { field: 2 }), Box::new(VeryLongStructNameNumber03QuiteVerboseIndeed { field: 3 }), Box::new(VeryLongStructNameNumber04QuiteVerboseIndeed { field: 4 }), Box::new(VeryLongStructNameNumber05QuiteVerboseIndeed { field: 5 }), Box::new(VeryLongStructNameNumber06QuiteVerboseIndeed { field: 6 }), Box::new(VeryLongStructNameNumber07QuiteVerboseIndeed { field: 7 }), Box::new(VeryLongStructNameNumber08QuiteVerboseIndeed { field: 8 }), Box::new(VeryLongStructNameNumber09QuiteVerboseIndeed { field: 9 }))
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let t = make_all()
    if (*t.0).field == 0 {
        print("unreachable: this file must be refused at compile time\n")
    }
    0
}
