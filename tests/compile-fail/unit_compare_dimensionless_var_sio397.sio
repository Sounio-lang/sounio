//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E041]: unit mismatch in arithmetic operation
//@ error-pattern: left unit: mass^1
//@ error-pattern: right unit: (dimensionless)
//@ description: SIO-397 — comparing a unit-bearing value against a
// dimensionless VARIABLE stays E041. Only pure literal expressions adopt the
// other side's unit in a comparison (run-pass witnesses: unit_same_add,
// unit_scalar_mul, unit_decl_keyword); a plain f64 variable carries no unit
// to adopt from, mirroring the D-24 call-argument rule.

fn main() -> i32 with IO, Mut, Panic, Div {
    let total: mg = 500.0
    let plain: f64 = 500.0
    if total == plain {
        print("should not reach here\n")
    }
    return 0
}
