    receipt.identity_id
}

fn main() -> i64 {
    let collision = DyadicProjectionCollisionReceipt {
        collision_id: 5801,
        rule_id: 5001,
        schema_id: 5101,
        left_candidate_id: 5601,
        right_candidate_id: 5603,
        full_left_states_equal: true,
        full_right_states_equal: true,
        full_relational_states_equal: true,
        contexts_equal: true,
        current_observations_equal: true,
        relational_histories_distinct: true,
        history_only_candidate_difference: true,
        real_dyadic_identity_established: false,
    }
    claim_relational_identity(collision)
}
