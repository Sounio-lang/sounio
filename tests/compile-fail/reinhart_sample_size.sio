//@ compile-fail
//@ error-pattern: refinement
// Reinhart-Rogoff Failure 2: Insufficient Sample Size
//
// R-R's "above 90% debt/GDP" bucket contained only 4 country-observations
// after the Excel exclusion error. Drawing a policy conclusion from n=4
// with high inter-country variance is statistically indefensible.
//
// Sounio's refinement type enforces a minimum sample count.

fn policy_conclusion(sample_count: { n: i32 | n >= 5 }) -> i32 {
    return sample_count
}

fn main() {
    // R-R had only 4 countries in their high-debt bucket
    let result = policy_conclusion(4)
}
