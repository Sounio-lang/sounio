//@ compile-fail
//@ requires: madaros
//@ error-pattern: E308
//@ description: one break of a `loop` carries a value and another carries none (`()`): refused (E308).

fn main() with IO {
    var i: i64 = 0
    let r = loop {
        i = i + 1
        if i == 1 { break 1 }
        break
    }
    println(r)
}
