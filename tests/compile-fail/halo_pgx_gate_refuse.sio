//@ compile-fail
//@ error-pattern: EpistemicComplete violation

// Dissertation contribution: compile-time PGx confidence gate — REFUSE path.
//
// `prescribe_haloperidol` is annotated `with Confidence(750)`. Every expression
// inside the body must carry compile-time confidence ≥ 750/1000.
//
// `measure(40.0, uncertainty: 20.0)` yields confidence = 1 − 20.0/40.0 = 0.5
// = 500/1000, BELOW the 750 threshold.
//
// The compiler REJECTS this program — no binary is emitted, the rejection is
// enforced before any runtime check would run.
//
// Clinical narrative: before CYP2D6 genotyping, the only available CL estimate
// is the wide population-PK prior (CV ≈ 50%). The compile-time rejection prevents
// prescribing haloperidol without pharmacogenomic workup — a guarantee no runtime
// check can give.
//
// This is the psychiatric analogue of tests/compile-fail/tac_compile_gate_refuse.sio
// (tacrolimus, Contribution #2). Together they demonstrate that compile-time
// epistemic enforcement generalises across drug classes.
//
// Compiler diagnostic (lean_single.sio:20984):
//   error: EpistemicComplete violation in fn prescribe_haloperidol ... (conf=500 < 750)

fn prescribe_haloperidol(cl_l_h: f64, dose_target_ng_ml: f64) -> f64 with Mut, Div, Confidence(750) {
    // Scale dose to target SS plasma concentration.
    // C_ss = F * dose / (CL * tau); invert for dose.
    let f_oral:  f64 = 0.65
    let tau_h:   f64 = 24.0
    let target_mg_l = dose_target_ng_ml * 1.0e-3
    target_mg_l * cl_l_h * tau_h / f_oral
}

fn main() with IO, Mut, Div, Panic, Confidence(750) {
    // Pre-genotyping: wide population-PK prior for CL.
    // CV ≈ 50% on CL alone (Forsman 1977 inter-individual variability).
    // Modelled as u/v = 0.5 → confidence = 1 − 0.5 = 0.5 = 500/1000 < 750.
    // COMPILE MUST FAIL.
    let k_cl: Knowledge<f64> = measure(40.0, uncertainty: 20.0)
    let cl = k_cl.value
    let dose = prescribe_haloperidol(cl, 5.0)
    println(dose)
}
