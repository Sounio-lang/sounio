//@ typecheck-fail
//@ requires: lean_single
//@ error-pattern: unit mismatch in let binding
//@ description: #2752 guard — a derived-unit let still refuses an initializer of a different dimension (m*s is not m/s)
unit velocity = m / s;

fn main() -> i32 with IO, Mut, Panic, Div {
    let distance: m = 100.0
    let elapsed: s = 9.58
    let wrong: velocity = distance * elapsed
    print_f64(wrong); print("\n")
    return 0
}
