//@ compile-fail
//@ error-pattern: expected RightGroupedABCState

ontology OrderedPathGroupingMismatch {
    class FunctionalState
    class LeftGroupedABCState subclass_of FunctionalState
    class RightGroupedABCState subclass_of FunctionalState
}

fn requires_right(state: RightGroupedABCState) -> i64 { state as i64 }
fn misuse(state: LeftGroupedABCState) -> i64 { requires_right(state) }
fn main() -> i32 { 0 }
