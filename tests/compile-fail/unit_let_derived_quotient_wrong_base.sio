//@ compile-fail
//@ error-pattern: this binding expects a different type
//@ description: a let annotated with a base unit refuses a quotient of another dimension (#2751)
//
// `distance / elapsed` has dimension m/s; binding it to `kg` was accepted by
// lean_single (it printed 10.438413). See unit_let_derived_product_mismatch.sio.

fn main() -> i32 with IO, Mut, Panic, Div {
    let distance: m = 100.0
    let elapsed: s = 9.58
    let y: kg = distance / elapsed
    print_f64(y)
    return 0
}
