//@ compile-fail
//@ error-pattern: more than one type-argument list in a single compilation unit
//@ requires: madaros
// The refusal this file asserts is emitted only by the modular Madaros
// specializer (self-hosted/check/specializer.sio, 5a971fa3cd). Measured
// 2026-09-05, same worktree, engine swapped: Madaros rc=1 carrying
// "more than one type-argument list in a single compilation unit";
// lean_single rc=1 WITHOUT that diagnostic, which the harness reports as
// "missing error" rather than as a pass.
// Monomorphization keeps one instantiation per template. A second instantiation
// with different type arguments poisons the template back to its unspecialized
// body, and lowering has no generics concept — so a struct-typed argument
// arrives as zero. Refuse instead of emitting a program that returns zeros.
//
// Measured on Madaros v0.80.0 before this refusal existed: both the nested
// shape below and the plain two-struct shape (`pick::<P>` / `pick::<Q>`)
// compiled with rc=0 and printed zeros.
//
// See docs/handoff/BLK-20260903-specializer-nested-targ-collision.md.

struct Cell<T> {
    v: T,
}

fn pick<T>(a: T, b: T) -> T {
    a
}

fn main() -> i32 with IO {
    let ci: Cell<i64> = pick::<Cell<i64>>(Cell { v: 7 }, Cell { v: 9 })
    let vi: i64 = ci.v
    println(vi)

    let cf: Cell<f64> = pick::<Cell<f64>>(Cell { v: 1.5 }, Cell { v: 2.5 })
    let vf: f64 = cf.v
    println(vf)
    0
}
