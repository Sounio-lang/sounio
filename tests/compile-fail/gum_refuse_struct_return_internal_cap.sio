//@ compile-fail
//@ requires: madaros
//@ error-pattern: internal measurements feeding its fields; refused instead of returning a wrong covariance
//@ description: A struct-returning helper whose fields depend on more than four measurements made inside the call exceeds the number of internal channels the tangent clone exports (one per measurement, shared across the output rows). Such a call is refused at compile time (KL-11) rather than answered with independent per-field internal variances, which would give a wrong covariance between its fields.

struct Five { a: f64, b: f64, c: f64, d: f64, e: f64 }

fn noisy5(k: f64) -> Five with Mut, Div, Epistemic {
    let m1 = measure(1.0, uncertainty: 0.01)
    let m2 = measure(2.0, uncertainty: 0.02)
    let m3 = measure(3.0, uncertainty: 0.03)
    let m4 = measure(4.0, uncertainty: 0.04)
    let m5 = measure(5.0, uncertainty: 0.05)
    var s = 0.0
    var i: i64 = 0
    while i < 3 {
        s = s + k
        i = i + 1
    }
    Five { a: s * m1.value + m2.value, b: s * m2.value + m3.value, c: m3.value * m4.value, d: m4.value + m5.value, e: m1.value + m5.value }
}

fn main() -> i64 with IO, Mut, Div, Epistemic {
    let k = measure(0.5, uncertainty: 0.02)
    let r = noisy5(k.value)
    print_f64(variance_of(r.a - r.e))
    0
}
