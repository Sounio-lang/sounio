//@ compile-fail
//@ error-pattern: Mut borrow requires mutable array or slice source

fn consume(p: &!i64) -> i64 with Mut, Panic { (*p) }

fn main() -> i32 with Mut, Panic {
    let values = [10, 20, 30, 40]
    let observed = consume(&!values[1 as usize])
    if observed == 20 { return 0 }
    return 1
}
