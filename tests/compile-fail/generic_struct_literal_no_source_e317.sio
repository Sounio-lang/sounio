//@ compile-fail
//@ requires: madaros
//@ error-pattern: determined by no field and no turbofish

// `Pair<A, B>` has no field that mentions A or B. The literal does not say
// which Pair it builds, and the annotation is not a source for it.
struct Na { pub z: i64 }
struct Cl { pub z: i64 }
struct Pair<A, B> { pub d: f64 }

fn main() -> i32 with IO {
    let p: Pair<Na, Cl> = Pair { d: 3.0 }
    print(p.d)
    return 0
}
