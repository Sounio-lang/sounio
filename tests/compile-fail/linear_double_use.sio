//@ compile-fail
//@ error-pattern: not consumed
//@ description: Linear value cannot be used twice (detected as not consumed due to early error)

linear struct Token {
    id: i32,
}

fn consume(t: Token) {
    // consumes the token
}

fn main() {
    let tok = Token { id: 1 }
    consume(tok)   // first use - moves tok
    consume(tok)   // ERROR: tok already consumed/moved
}
