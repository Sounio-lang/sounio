//@ compile-fail
//@ description: SELFHOST_PASS
//@ error-pattern: use of moved value

// A linear struct value cannot be used twice
linear struct Handle {
    fd: i64,
}

fn consume(h: Handle) -> i64 {
    h.fd
}

fn main() -> i32 with Mut, Panic, Div {
    var h = Handle { fd: 42 }
    let a = consume(h)     // first use — consumes h
    let b = consume(h)     // ERROR: h already consumed
    return 0
}
