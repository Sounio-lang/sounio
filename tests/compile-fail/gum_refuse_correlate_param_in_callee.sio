//@ compile-fail
//@ requires: madaros
//@ error-pattern: refused instead of reading 0
//@ description: A `correlate` between a parameter of the callee and a quantity the callee measures needs the caller's channel for that parameter, which a tangent clone does not have (its parameters are unit tangents). Such a callee is correlated exactly only between quantities it measures itself; a query on a call to one that correlates a parameter-derived value is refused at compile time, never answered with the independent value (before, the correlation was dropped without a diagnostic).

fn corr_param(a: f64) -> f64 with Epistemic, Mut, Div {
    let km = measure(2.0, uncertainty: 0.3)
    let m: f64 = km.value
    let _c = correlate(a, m, 0.6)
    var y = a
    y = y + m
    y * y
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let ka = measure(1.5, uncertainty: 0.1)
    let a: f64 = ka.value
    let r = corr_param(a)
    print_f64(variance_of(r))
    print("\n")
    0
}
