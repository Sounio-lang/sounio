//@ compile-fail
//@ requires: madaros
//@ error-pattern: decimal integer literal does not fit a signed 64-bit type
//@ description: SIO-428 -- a signed (i64) annotation on a decimal band literal is the silent wrap itself. The accepted spellings for a u64 bit pattern are hex, or an explicit u64 annotation (see tests/run-pass/u64_print_unsigned.sio).

fn main() with IO {
    let x: i64 = 10000000000000000000
    print_int(x)
    print("\n")
}
