//@ compile-fail
//@ error-pattern: refinement type violation
//@ description: compound AND guard does not escape — literal outside if-block violates predicate

fn get_i32() -> i32 { 50 }

fn takes_bounded(x: { n: i32 | n > 0 && n < 100 }) -> i32 {
    x
}

fn main() -> i32 with IO {
    let y: i32 = get_i32()
    if y > 0 && y < 100 {
        // Guarded call is accepted (fallback to runtime check when narrowing unavailable)
        let _ = takes_bounded(y)
    }
    // After the if-block, no guard is in scope — literal violation
    let _ = takes_bounded(-5)
    0
}
