//@ compile-fail
//@ error-pattern: refinement type violation
//@ description: compound AND guard refinement must not escape the if-block

fn get_i32() -> i32 { 42 }

fn takes_bounded(x: { n: i32 | n > 0 && n < 100 }) -> i32 {
    x
}

fn main() -> i32 with IO {
    let y: i32 = get_i32()
    if y > 0 && y < 100 {
        // Inside the then-branch the guard narrows y; this call is fine.
        let _ = takes_bounded(y)
    }
    // After the if-block the guard is gone; y is plain i32 again.
    let _ = takes_bounded(y)
    0
}
