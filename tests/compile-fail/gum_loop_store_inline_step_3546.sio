//@ compile-fail
//@ requires: madaros
//@ error-pattern: GUM_UNTRACKED_CONTAINER
// The inline form: the step is computed from Knowledge fields in the same
// Epistemic function that stores into a loop-indexed array. First-order GUM
// tracks the step's dependence on `.value` through the call, so the store
// carries a channel the array cannot keep.
fn step_of(mean: f64, variance: f64) -> f64 with Mut, Div, Panic {
    let a = if mean < 0.0 { 0.0 - mean } else { mean }
    let r = 1.0e-3 * a
    let s = 0.5 * variance
    if r > s { r } else { s }
}

fn fill(kn: [Knowledge[f64]; 4]) -> [f64; 4] with Mut, Div, Panic, Epistemic {
    var out: [f64; 4] = [0.0; 4]
    var i: i32 = 0
    while i < 4 {
        let k = kn[i]
        let h = step_of(k.value, k.variance)
        out[i] = 1.0 / (2.0 * h)
        i = i + 1
    }
    return out
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let kn: [Knowledge[f64]; 4] = [Knowledge(2.0, ε=0.9, prov="t"); 4]
    let r = fill(kn)
    println("unreachable")
    return 0
}
