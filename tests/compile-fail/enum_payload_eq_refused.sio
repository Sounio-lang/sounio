//@ compile-fail
//@ requires: madaros
//@ description: KL-20 -- `==` on a payload-carrying enum is E279: its values are tagged cells, so the operator would compare addresses
//@ error-pattern: error[E279]

enum Shape { Circle(i64), Empty }

fn main() -> i64 {
    let a = Shape::Circle(1)
    let b = Shape::Circle(1)
    if a == b { 1 } else { 0 }
}
