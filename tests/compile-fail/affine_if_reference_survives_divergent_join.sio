//@ compile-fail
//@ requires: madaros

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 {
    let permit = Permit { id: 197 }
    let return_early = false
    let borrowed = if return_early {
        return 0
    } else {
        &permit
    }
    let observed = (*borrowed).id
    let consumed = spend(permit)
    (observed + consumed) as i32
}
