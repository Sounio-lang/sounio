//@ compile-fail
//@ requires: madaros

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 {
    let left = Permit { id: 199 }
    let right = Permit { id: 211 }
    let selector = 0
    let borrowed = match selector {
        0 => &left
        _ => &right
    }
    let observed = (*borrowed).id
    let consumed = spend(left)
    (observed + consumed) as i32
}
