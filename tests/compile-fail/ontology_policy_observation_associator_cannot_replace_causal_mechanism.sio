ontology D6NegativeCausality {
    class Artifact
    class PolicyObservationNonAssociativityWitness subclass_of Artifact
    class CausalPolicyObservationMechanism subclass_of Artifact
}
fn require(v: CausalPolicyObservationMechanism) -> i32 { 0 }
fn reject(v: PolicyObservationNonAssociativityWitness) -> i32 { require(v) }
