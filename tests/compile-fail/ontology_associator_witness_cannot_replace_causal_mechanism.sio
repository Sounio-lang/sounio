//@ compile-fail
//@ error-pattern: cannot prove ontology subsumption

ontology RelationalDynamicsNegativeCausality {
    class ModelArtifact
    class EpistemicReceipt subclass_of ModelArtifact
    class BoundedAssociatorWitness subclass_of EpistemicReceipt
    class CausalMechanismReceipt subclass_of EpistemicReceipt
}

fn requires_causal_mechanism(r: CausalMechanismReceipt) -> i32 { 0 }
fn reject_witness(w: BoundedAssociatorWitness) -> i32 {
    requires_causal_mechanism(w)
}
