//@ compile-fail
//@ requires: madaros
//@ error-pattern: effect row full
//
// The ninth effect must not vanish. Founder ruling 2026-08-21: widen the row,
// and never lose, and never silence.
//
// fn_sig_table_widen_effects (check/defs.sio) had `if !seen && effect_count < 8`
// and no else: when the row was full the effect was dropped with no diagnostic,
// no flag, and `changed` left false. The obligation disappeared and the compile
// carried on with a signature that was quietly incomplete, so a caller was
// never asked to declare it.
//
// With inference enabled this is not even something an author could see coming:
// the row fills by itself, from callees, without anyone having written eight.

fn nine(x: i64) -> i64 with IO, Mut, Div, Panic, Alloc, Async, GPU, Prob, Observe {
    x
}

fn caller(x: i64) -> i64 with IO, Mut, Div, Panic, Alloc, Async, GPU, Prob, Observe {
    nine(x)
}

fn main() -> i64 with IO {
    println("unreachable")
    caller(1)
}
