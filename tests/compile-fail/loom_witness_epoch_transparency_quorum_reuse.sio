use coordination::loom_witness_epoch_transparency::{
    LoomWitnessEpochTransparencyHostTrust,
    EpochTransparencyDigest256,
    admit_epoch_transparency_digest256,
    admit_verified_epoch_transparency_handoff,
    admit_verified_epoch_transparency_checkpoint,
    join_epoch_transparency,
}

fn digest(seed: i64) -> EpochTransparencyDigest256 {
    admit_epoch_transparency_digest256(
        seed, seed + 1, seed + 2, seed + 3,
        seed + 4, seed + 5, seed + 6, seed + 7,
    )
}

fn zero_digest() -> EpochTransparencyDigest256 {
    admit_epoch_transparency_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn reuse_linear_authority() -> i64
    with LoomWitnessEpochTransparencyHostTrust, Panic {
    let handoff = admit_verified_epoch_transparency_handoff(
        1, 1, 2, digest(10), zero_digest(),
    )
    let checkpoint = admit_verified_epoch_transparency_checkpoint(
        1, 1, 1, 3, 4, 1, digest(20), 1, 1,
        digest(30), digest(40), digest(50), digest(60),
    )
    let first = join_epoch_transparency(
        handoff, checkpoint, 1, 1, 1, 1, 1,
        0, 1, digest(10), zero_digest(),
        digest(70), digest(70), digest(20),
    )
    let second = join_epoch_transparency(
        handoff, checkpoint, 1, 1, 1, 1, 1,
        0, 1, digest(10), zero_digest(),
        digest(70), digest(70), digest(20),
    )
    0
}

fn main() -> i64 { 0 }
