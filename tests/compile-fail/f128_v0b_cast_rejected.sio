//@ compile-fail
//@ requires: madaros
//@ description: f64↔f128 casts must not be accepted as a finished surface (V0-B: E248)
//@ error-pattern: error[E248]
//@ ladder-stage: V0-B
//@ semantic-lane: WS-G-V0B-LITERALS-CHECK
//
// Under Madaros V0-B, wide-float casts fail closed. lean_single implements
// f64<->f128 casts (#2387), so this refusal is Madaros-only. Re-measured 2026-09-26: Madaros built from source at 98315edcd (no self-hosted change up to 1f4bff097) and lean_single.
// The known-failure tag was stale: the test passes on Madaros (XPAS).

fn cast_up(x: f64) -> f128 {
    x as f128
}

fn cast_down(x: f128) -> f64 {
    x as f64
}

fn main() {
    let _ = cast_up(1.0)
    let _ = cast_down(1.0)
}
