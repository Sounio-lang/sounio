//@ compile-fail
//@ requires: madaros
//@ error-pattern: fail-closed, #1542
//@ description: a capturing closure handed to a HOF that does more than forward is refused, not run with its capture read as 0 (#1542)

fn twice(f: fn(i64) -> i64 with Mut, a: i64) -> i64 with Mut {
    let first = f(a)
    f(first)
}

fn main() -> i32 with IO, Mut {
    let bias = 100
    print_int(twice(|x: i64| x + bias, 1))
    print("\n")
    0
}
