//@ compile-fail
//@ error-pattern: argument type does not match parameter
// Observation-feature use is not an identification receipt.

use epistemic::observation_provenance::*

struct IdentificationReceipt { assumption_id: i64 }

fn identification_id(receipt: IdentificationReceipt) -> i64 {
    receipt.assumption_id
}

fn main() with Panic {
    let presence = op_encounter_presence_i64(20, 21)
    let selection = op_measurement_selection_i64(30, 31)
    let feature = op_observation_feature_i64(presence, selection)
    identification_id(feature)
}
