//@ compile-fail
//@ requires: madaros
//@ description: KL-20 -- a payload binding has the declared field type (here string), so using it as an i64 is a type error
//@ error-pattern: error[E004]

enum Tok { Word(string), Empty }

fn f(t: Tok) -> i64 {
    match t {
        Tok::Word(s) => s + 1,
        Tok::Empty => 0,
    }
}

fn main() -> i64 { f(Tok::Empty) }
