//@ compile-fail
//@ requires: madaros
//@ error-pattern: confidence gate violation
// E214 call-site confidence gate, Madaros (the default engine of ./bin/souc).
// Before the fix Madaros accepted this program and printed dose=50.000000;
// lean_single refused it. measure(10.0, uncertainty: 5.0) has confidence 500,
// measure(5.0, uncertainty: 0.1) has 980, `.value` keeps the confidence of the
// Knowledge it reads, so the arguments multiply to 490 < Epistemic(950).

fn safe_dosing(weight: f64, clearance: f64) -> f64 with Mut, Epistemic(950) {
    return weight * clearance
}

fn main() with IO, Mut, Epistemic {
    let kw: Knowledge<f64> = measure(10.0, uncertainty: 5.0)
    let kc: Knowledge<f64> = measure(5.0, uncertainty: 0.1)
    let w = kw.value
    let c = kc.value
    let dose = safe_dosing(w, c)
    print("dose="); println(dose)
}
