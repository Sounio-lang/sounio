use llm::epistemic_clinical_pbpk::*
use epistemic::sound_enclosure::*

fn dispense(a: PbpkAuthorization) -> f64 { pbpk_auth_window_lo(a) }

fn main() with Panic {
    let generic = se_authorize_window(se_point(4.0), 0.0, 0.0, 3.0, 5.0)
    let forged = PbpkAuthorization { tok: generic }
    let w = dispense(forged)
}
