use epistemic::dyadic_non_reduction::*

fn claim_global_equivalence(receipt: GlobalDyadicEquivalenceReceipt) -> i64 {
    receipt.equivalence_id
}

fn main() -> i64 {
    let ambiguity = HorizonLimitedDyadicAmbiguityReceipt {
        family_id: 5710,
        horizon_bound: 2,
        residual_block_count: 1,
        bounded_search_complete: true,
        global_equivalence_established: false,
    }
    claim_global_equivalence(ambiguity)
}
