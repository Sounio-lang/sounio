//@ compile-fail
//@ error-pattern: defer_action(...) requires Contest<T, Family, Policy> or proof-carrying Robust<T> evidence
//@ error-pattern: pass the result of prove_robust(...)
// Shorthand Robust<T> remains parser-compatible, but deferral requires proof-carrying robustness.

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {
    require relative_band <= 0.15
}
deferral_policy ReviewPolicy for i64 route review {
    require relative_band <= 0.15
}
audit ReviewAudit for Contest<i64, DefaultModels, DefaultPolicy> {
    metrics {
        relative_band: 0.10
    }
}

fn main() {
    let d = 1
    let c: Contest<i64, DefaultModels, DefaultPolicy> = (contest [M1] on d) audit ReviewAudit
    let r: Robust<i64> = prove_robust(c, DefaultPolicy)
    let x: Deferred<i64> = defer_action(d, r, ReviewPolicy)
}
