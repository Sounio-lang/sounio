//@ compile-fail
//@ error-pattern: argument type does not match parameter
// A preregistered representation contest plan is not a sensitivity result.

use epistemic::observation_provenance::*
use epistemic::parenthesization_receipts::*
use epistemic::state_aliasing_receipts::*

fn sensitivity_tag(receipt: ParenthesizationSensitivityI64) -> i64 {
    pr_parenthesization_sensitivity_feature_tag_i64(receipt)
}

fn main() with Mut, Div, Panic, NonAssoc {
    let opportunity = op_observation_opportunity_i64(10, 11)
    let presence = op_encounter_presence_i64(20, 21)
    let selection = op_measurement_selection_i64(30, 31)
    let act = op_measurement_act_i64(40, 41)
    let recorded = op_record_measurement_i64(opportunity, presence, selection, act)
    let left_history = op_observation_history_from_recorded_i64(recorded, 1001)
    let right_history = op_observation_history_from_recorded_i64(recorded, 1002)
    let path = pr_ordered_transformation_path_i64(left_history, 2001)
    let boundary = pr_aggregation_boundary_i64(path, 3001, 3002)
    let design = pr_bracketing_design_i64(boundary, 4001, 4002, 4003)
    let left_proxy = sar_observed_proxy_i64(left_history, 9001)
    let right_proxy = sar_observed_proxy_i64(right_history, 9001)
    let collision = sar_observed_proxy_collision_i64(left_proxy, right_proxy)
    let challenge = sar_predictive_challenge_i64(collision, 9101, 4003, 9103)
    let separation = sar_predictive_separation_i64(challenge, 9201, 9202)
    let refinement = sar_state_refinement_request_i64(challenge, separation, 9301)
    let plan = pr_refined_state_representation_contest_plan_i64(
        design,
        refinement,
        9401,
        9402,
        9403,
        9404,
        9405,
        9406,
        9407,
        9408
    )

    sensitivity_tag(plan)
}
