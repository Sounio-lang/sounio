//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E010]
//@ description: en_of compares exactly two sources; three are refused at compile time (the many-source statistic is birge_of).
fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    let k0 = measure(1.0, uncertainty: 0.1)
    let k1 = measure(1.3, uncertainty: 0.1)
    let k2 = measure(1.1, uncertainty: 0.1)
    print_f64(en_of(k0.value, k1.value, k2.value))
    0
}
