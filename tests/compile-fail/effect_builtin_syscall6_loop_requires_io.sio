//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: error[E035
//@ description: #2760 review -- syscall6 owes IO inside a `loop` body too. The in-place spine has a dedicated arm for it; loop bodies are checked by-value, which had none, so a pure function could issue a raw syscall from a loop.

fn leaf() -> i64 {
    loop {
        let r = syscall6(39, 0, 0, 0, 0, 0, 0)
        break
    }
    0
}

fn main() -> i64 with IO {
    leaf()
}
