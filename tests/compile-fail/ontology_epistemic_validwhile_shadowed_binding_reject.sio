//@ compile-fail
//@ requires: madaros
//@ error-pattern: this binding expects a different type
// Soundness witness: a bare identifier reference inside ValidWhile(expr) is
// NOT interned by spelling -- this checker has no per-binding symbol/slot
// id available at the pure, Checker-free predicate-identity call site to
// tell apart two references that merely happen to be spelled the same, so
// treating "same spelling" as "same predicate" would be unsound (it would
// wrongly equate references to different bindings). Conservatively, any
// predicate containing a bare identifier reference is "not comparable" --
// it never subsumes anything, including a value declared with the exact
// same textual annotation. This must be rejected, not silently accepted.

ontology ChemicalOntology {
    class Chemical
    class CHEBI_15377 subclass_of Chemical
}

fn test_validwhile_identifier_never_self_comparable(
    flag: bool,
    src: Knowledge[CHEBI_15377, ValidWhile(flag), Derived]
) {
    let dst: Knowledge[CHEBI_15377, ValidWhile(flag), Derived] = src
}

fn main() {
}
