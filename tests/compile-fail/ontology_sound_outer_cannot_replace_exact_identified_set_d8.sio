//@ compile-fail
//@ error-pattern: cannot prove ontology subsumption
ontology D8NegativeOuterExact {
    class IdentifiedSetArtifact
    class ExactIdentifiedSet subclass_of IdentifiedSetArtifact
    class SoundOuterIdentifiedSet subclass_of IdentifiedSetArtifact
}
fn require(v: ExactIdentifiedSet) -> i32 { 0 }
fn reject(v: SoundOuterIdentifiedSet) -> i32 { require(v) }
