//@ compile-fail
//@ error-pattern: E175
//@ requires: madaros
//
// PR #2515 review finding C (comment_id 4058669347): a module-qualified path
// to a NON-public free function only reached the W044 "unresolved path"
// suppression in checker_check_expr_call_inplace (self-hosted/check/check.sio,
// the "Type::method associated-function path" branch): when
// `path_type_name` (here `dd64`) named no known struct/enum and
// `checker_fn_sigs_find_inplace` found a real signature for the terminal
// name, the warning was suppressed but `direct_sig_id` stayed at -1, so none
// of the checks gated on `direct_sig_id >= 0` -- including
// `checker_fn_sig_visible_inplace` -- ever ran. `mod::private_fn()` compiled
// clean despite the callee being private to its defining module.
//
// `dd64::dd64_sqrt_f64` (stdlib/math/dd64.sio) is a non-pub free fn private
// to the dd64 module, used internally by `dd_sqrt`. Calling it through its
// module-qualified path from outside the module must be rejected (E175),
// the same as calling any other private fn.
use math::dd64;

fn main() -> f64 with IO, Mut, Panic {
    dd64::dd64_sqrt_f64(4.0)
}
