//@ compile-fail
//@ requires: madaros
//@ error-pattern: branches have incompatible types
// Soundness witness: control-flow join of Knowledge<Child> (then) and
// Knowledge<Parent> (else) must NOT unsoundly narrow to Knowledge<Child>.
// Sounio requires branches of an if-expression to be symmetrically compatible (E007),
// preventing unsound direction-biased joins.
//
// Branch order matters here: the old unsound rule injected DIRECTIONAL subclass
// covariance into the symmetric compatibility check the if/else join uses, so
// `then = Knowledge<Child>, else = Knowledge<Parent>` (Child IS a subclass of
// Parent) was the shape that slipped through -- checker_onto_name_subclass_walk
// found then's inner type a subclass of else's and accepted the join, returning
// then's (narrower) type. The reverse order (then = Parent, else = Child) is
// NOT a subclass in that direction and was already correctly rejected even
// under the old bug, so it does not regression-test anything.

ontology ChemicalOntology {
    class Chemical
    class CHEBI_25806 subclass_of Chemical
    class CHEBI_15377 subclass_of CHEBI_25806
    class ChEBI_0036060 subclass_of CHEBI_15377
}

fn test_join_not_narrowed(cond: bool, child: Knowledge<ChEBI_0036060>, parent: Knowledge<CHEBI_15377>) {
    let x: Knowledge<ChEBI_0036060> = if cond {
        child
    } else {
        parent
    }
}

fn main() {
}
