//@ compile-fail
//@ requires: madaros
//@ error-pattern: branches have incompatible types
// Soundness witness: control-flow join of Knowledge<Child> and Knowledge<Parent>
// must NOT unsoundly narrow to Knowledge<Child>.
// Sounio requires branches of an if-expression to be symmetrically compatible (E007),
// preventing unsound direction-biased joins.

ontology ChemicalOntology {
    class Chemical
    class CHEBI_25806 subclass_of Chemical
    class CHEBI_15377 subclass_of CHEBI_25806
    class ChEBI_0036060 subclass_of CHEBI_15377
}

fn test_join_not_narrowed(cond: bool, child: Knowledge<ChEBI_0036060>, parent: Knowledge<CHEBI_15377>) {
    let x: Knowledge<ChEBI_0036060> = if cond {
        parent
    } else {
        child
    }
}

