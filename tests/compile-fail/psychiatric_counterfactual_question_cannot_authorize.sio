//@ compile-fail
//@ error-pattern: expected ResearchDecisionCandidate
// A counterfactual question is not a research decision candidate.

struct CounterfactualQuestionReceipt { question_id: i64 }
struct ResearchDecisionCandidate { research_id: i64 }

fn research_id(candidate: ResearchDecisionCandidate) -> i64 {
    candidate.research_id
}

fn main() -> i64 {
    let question = CounterfactualQuestionReceipt { question_id: 10 }
    research_id(question)
}
