//@ compile-fail
//@ error-pattern: string literal exceeds maximum of 2048 bytes

// Regression test for the print("...") fast-path decoder (emit_print),
// a sibling of compile_primary()'s call-argument decoder discovered during
// review of the rel8-jmp-overflow segfault fix. emit_print packs 8 decoded
// bytes per SQW slot (SQW is [i64; 256]), so its overflow threshold is
// ~2048 bytes rather than compile_primary's 256 -- previously unguarded.

fn main() -> i64 with IO, Mut, Panic, Div {
    print("")
    return 0
}
