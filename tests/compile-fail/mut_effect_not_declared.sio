//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E035]

// SIO-27: a store through an exclusive reference in a function without
// `with Mut` must be refused with E035 (missing: Mut), as lean_single
// refuses it. Mutating a function-local `var` is the spec section 7.2.1
// escape rule and requires nothing; a write through &!T is observable by
// the caller and does.

fn poke(x: &!i64) {
    *x = 42
}

fn main() -> i64 with IO, Mut {
    var v = 0
    poke(&!v)
    0
}
