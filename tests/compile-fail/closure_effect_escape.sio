//@ compile-fail
// Effect transparency check: passing IO closure to unannotated HOF from pure context.
// The HOF is transparent — it propagates the closure's IO effect to the call site.
// pure_fn() has no IO declared, so this is a compile error.

fn map_apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }

fn pure_fn() -> i64 {
    map_apply(|x: i64| -> i64 { print("io\n"); x }, 5)
}

fn main() -> i32 with IO {
    let r = pure_fn()
    0
}
