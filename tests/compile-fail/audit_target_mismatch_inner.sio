type M1I = Model<i64, i64>
type M1F = Model<i64, f64>
models IntModels = [M1I]
models FloatModels = [M1F]
policy IntPolicy for i64 level Stable scope InDistribution {}
policy FloatPolicy for f64 level Stable scope InDistribution {}

audit IntAudit for Contest<i64, IntModels, IntPolicy> {
    metrics { sign_consensus: 1.0 }
}

