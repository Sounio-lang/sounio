//@ compile-fail
//@ requires: lean_single
//@ error-pattern: cannot compile an assignment to this target
//@ description: lean_single has no handler for `a[i].f[j] = v`. It used to compile the target as a value and drop the write, leaving the element 0; it now refuses the assignment. Madaros compiles it (prints 77).

struct W { text: [i64; 4], n: i64 }

fn main() with IO, Mut {
    var ws: [W; 2] = [W { text: [0; 4], n: 0 }; 2]
    ws[1].text[2] = 77
    println(ws[1].text[2])
}
