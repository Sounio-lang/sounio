//@ compile-fail
//@ requires: madaros
//@ error-pattern: refused instead of reading 0
//@ description: A method (resolved through the receiver type) that has no tangent clone because its body asks for an uncertainty, and measures inside itself, called with a certain argument: a query on the result read 0 (the value has first-order variance 4 * 0.09 = 0.36). The call is refused at compile time, as a free function is.

struct Rig { k: f64 }
impl Rig {
    fn noisy(self: &Rig, a: f64) -> f64 with Epistemic, Mut, Div {
        let km = measure(2.0, uncertainty: 0.3)
        let m: f64 = km.value
        let v = variance_of(m)
        a * m + v + self.k
    }
}
fn main() -> i32 with IO, Mut, Div, Epistemic {
    let rig = Rig { k: 1.0 }
    let a0: f64 = 2.0
    let r = rig.noisy(a0)
    print_f64(variance_of(r))
    print("\n")
    0
}
