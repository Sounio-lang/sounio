//@ compile-fail
//@ error-pattern: affine value used more than once

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 {
    let permit = Permit { id: 7 }
    let enabled = true
    if enabled {
        let spent = spend(permit)
        let _keep = spent
    }
    let again = spend(permit)
    again as i32
}
