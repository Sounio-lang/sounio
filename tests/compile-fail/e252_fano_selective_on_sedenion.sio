//@ compile-fail
//@ requires: madaros
//@ error-pattern: algebra declares a reassociation strategy its multiplication law cannot certify
//
// `fano_selective` licenses re-association when the three basis supports lie in one
// quaternionic (Fano-line) subalgebra of the OCTONIONS (`assocCert` at n = 3). The
// sedenions are not alternative and have no such certificate (`assocCert` is false for
// every n ≥ 4); claiming Fano selectivity there is an order-fabrication licence — E252.
// A sedenion product must be `blocked` (or the clause omitted: the checker then derives
// `blocked` itself).

algebra Sedenion over f64 {
    add: commutative, associative
    mul: non_commutative, non_associative
    reassociate: fano_selective
}

fn main() -> i64 with IO { 0 }
