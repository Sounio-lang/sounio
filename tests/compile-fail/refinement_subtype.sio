//@ compile-fail
//@ ignore
//@ error-pattern: refinement type violation
//@ description: Refinement strictness witness — 0 is non-negative but not positive

fn takes_positive(x: { n: i32 | n > 0 }) -> i32 {
    x
}

fn provide_non_negative(x: { n: i32 | n >= 0 }) -> i32 {
    // Witness of strictness: this value satisfies >= 0 but violates > 0.
    takes_positive(0)
}

fn main() {
    let result = provide_non_negative(0)
}
