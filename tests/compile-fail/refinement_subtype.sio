//@ compile-fail
//@ ignore
//@ error-pattern: subtype
//@ description: Refinement subtyping - narrower type not wider (subtype checking not enforced)

fn takes_positive(x: { n: i32 | n > 0 }) -> i32 {
    x
}

fn provide_non_negative(x: { n: i32 | n >= 0 }) -> i32 {
    // ERROR: non-negative (>= 0) is wider than positive (> 0)
    // 0 satisfies n >= 0 but not n > 0
    takes_positive(x)
}

fn main() {
    let result = provide_non_negative(0)
}
