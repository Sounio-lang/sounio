//@ compile-fail
//@ error-pattern: unit mismatch in call argument
//@ description: PR-1 — passing a value with wrong unit to a unit-typed fn parameter must fail

fn takes_mg(d: mg) -> f64 with Mut {
    d
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let volume: mL = 10.0
    let r = takes_mg(volume)  // ERROR: mL passed where mg expected
    return 0
}
