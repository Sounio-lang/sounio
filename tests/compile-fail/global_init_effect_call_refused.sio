//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E309]
//@ description: a module-level initializer that calls a fn with effects is refused (E309); Madaros used to skip the call
// tests/run-pass/madaros_global_zero_initializer_order.sio pins lean_single's
// source-order initialization. Madaros never ran `touch_later_zero()`: the
// initializer was dropped, EFFECT_RESULT read 0 and EARLY_ZERO kept its zero.
var EARLY_ZERO: [i64; 4] = [0; 4]

fn touch_early() -> i64 with Mut, Panic {
    EARLY_ZERO[0] = 11
    31
}

var EFFECT_RESULT: i64 = touch_early()

fn main() -> i32 with IO, Mut, Panic {
    if EARLY_ZERO[0] != 11 { return 1 }
    if EFFECT_RESULT != 31 { return 2 }
    println("OK")
    0
}
