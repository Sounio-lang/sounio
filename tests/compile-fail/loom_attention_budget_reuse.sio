use coordination::loom_attention_compiler::{
    acquire_attention_budget,
    close_attention_budget,
}

fn reuse_budget() -> i64 with Panic {
    let budget = acquire_attention_budget(100)
    let first = close_attention_budget(budget)
    let second = close_attention_budget(budget)
    first + second
}

fn main() -> i64 { 0 }
