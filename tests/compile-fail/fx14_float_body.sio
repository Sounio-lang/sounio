//@ compile-fail
//@ requires: madaros
//@ error-pattern: E299
//@ description: FX-1 v1 limit: a handle whose body result is not an i64 word is refused at compile time (SIO-417)

effect Ask { fn get() -> i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<Ask> { 1.5 } with { on get() -> resume(0) }
    0
}
