//@ compile-fail
//@ requires: lean_single
//@ error-pattern: refinement type violation
// #2817 review: an initializer-less `var` of a refined f64 is bound to 0.0, so
// the predicate must be checked against 0.0. The zero synthesizer used to keep
// the previous expression's literal state: here the stale `2.0` from the line
// above satisfied `q >= 1.0` and the declaration was accepted while holding
// 0.0 (and with no preceding f64 literal the check did not run at all).
// lean_single now records the zero exactly as it records the literal `0.0`.
// (Madaros accepts this program; it does not check let-binding refinements.)
fn main() -> i64 {
    let a: f64 = 2.0
    var p: { q: f64 | q >= 1.0 }
    return 0
}
