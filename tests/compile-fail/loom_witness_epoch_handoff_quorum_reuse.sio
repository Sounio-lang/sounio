use coordination::loom_witness_epoch_handoff::{
    LoomWitnessEpochHandoffHostTrust,
    admit_witness_epoch_digest256,
    admit_verified_old_epoch_quorum,
    admit_verified_new_epoch_quorum,
    join_verified_witness_epoch_quorums,
    consume_verified_witness_epoch_handoff,
    close_host_witness_epoch_handoff_receipt,
}

fn reuse_old_quorum() -> i64 with LoomWitnessEpochHandoffHostTrust, Panic {
    let old_membership = admit_witness_epoch_digest256(1, 2, 3, 4, 5, 6, 7, 8)
    let old_root = admit_witness_epoch_digest256(11, 12, 13, 14, 15, 16, 17, 18)
    let new_membership = admit_witness_epoch_digest256(21, 22, 23, 24, 25, 26, 27, 28)
    let new_root = admit_witness_epoch_digest256(31, 32, 33, 34, 35, 36, 37, 38)
    let head = admit_witness_epoch_digest256(41, 42, 43, 44, 45, 46, 47, 48)
    let old_certificate = admit_witness_epoch_digest256(51, 52, 53, 54, 55, 56, 57, 58)
    let new_certificate = admit_witness_epoch_digest256(61, 62, 63, 64, 65, 66, 67, 68)
    let alternative_certificate = admit_witness_epoch_digest256(71, 72, 73, 74, 75, 76, 77, 78)
    let zero = admit_witness_epoch_digest256(0, 0, 0, 0, 0, 0, 0, 0)
    let old_quorum = admit_verified_old_epoch_quorum(
        1, 1, 3, 4,
        old_membership, old_root, 501, 7, 12, head, old_certificate,
    )
    let new_quorum = admit_verified_new_epoch_quorum(
        2, 1, 3, 4,
        new_membership, new_root, 501, 1, 12, head, new_certificate,
    )
    let alternative = admit_verified_new_epoch_quorum(
        2, 1, 3, 4,
        new_membership, new_root, 501, 1, 12, head, alternative_certificate,
    )
    let first = join_verified_witness_epoch_quorums(
        old_quorum, new_quorum, 1, 2, zero,
    )
    let receipt = consume_verified_witness_epoch_handoff(first)
    let closed = close_host_witness_epoch_handoff_receipt(receipt)
    let reused = join_verified_witness_epoch_quorums(
        old_quorum, alternative, 1, 2, zero,
    )
    let second = consume_verified_witness_epoch_handoff(reused)
    closed + close_host_witness_epoch_handoff_receipt(second)
}

fn main() -> i64 { 0 }
