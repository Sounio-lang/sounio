//@ compile-fail
//@ error-pattern: requested channel not in expression's gradient topology
//
// Gradient Topology Types (GTT) — Phase β⁹ inaugural compile-fail regression.
//
// The expression `k1.value * k2.value` has gradient topology ch[0,1] — two
// .value accesses seed channels 0 and 1 via MEAS_KNOW_IDX, and scalar
// multiplication unions the topologies.  Asking for H_{2,3} of a value that
// does not depend on channels 2 or 3 is a type error, not a zero-returning
// query.
//
// Before GTT: the compiler silently returned 0.0 (reading uninitialized
// shadow slots).  After GTT: the compiler refuses the query at type-check
// time, pointing the user to the missing dependency.

fn main() with IO, Epistemic, Mut, Div {
    let k1: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let k2: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
    // Inline: .value * .value seeds ch0 and ch1, unions to ch[0,1].
    // Asking for H_{2,3} is out-of-topology → GTT refusal.
    println(hessian_of(k1.value * k2.value, 2, 3))
}
