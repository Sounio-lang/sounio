//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: E007
//@ description: #830 — by-value if joins must refuse an f64 literal outside the f32 range

fn handle_out_of_range(x: f32, flag: bool) -> f32 {
    handle<IO> {
        if flag { x } else { 1e300 }
    } with {
        0
    }
}

fn main() -> i64 {
    0
}
