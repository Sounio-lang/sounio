//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E313]
//@ error-pattern: is not a compile-time constant
//@ description: a runtime f64 is not promoted to an exact Knowledge operand

// lean_single accepts this and treats `s` as exact (variance 0). Madaros
// refuses: nothing in the type of `s` says it has no uncertainty, so the
// claim has to be written (`Knowledge(s, ...)` or `measure(s, uncertainty: 0.0)`).

fn scale_of(n: i64) -> f64 {
    if n > 0 { 2.0 } else { 3.0 }
}

fn main() -> i64 with IO, Epistemic {
    let x: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    let s: f64 = scale_of(1)
    let r = x * s
    print_f64(r.value)
    0
}
