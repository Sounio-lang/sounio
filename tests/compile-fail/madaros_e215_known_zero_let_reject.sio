//@ compile-fail
//@ requires: madaros
//@ error-pattern: EpistemicComplete violation
// #3601 review: inside a function with its own floor, a let whose initialiser has a KNOWN
// confidence of zero (u = v) must be refused by E215, not recorded as "unknown".
fn dose() -> f64 with Mut, Epistemic(950) {
    let w = measure(10.0, uncertainty: 10.0).value
    return w * 2.0
}
fn main() with IO, Mut, Epistemic {
    print("d="); println(dose())
}
