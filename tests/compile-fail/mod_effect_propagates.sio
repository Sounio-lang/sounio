//@ compile-fail
//@ error-pattern: E035
// R5 witness: `Mod` is a recognised effect id (29), so `with Mod` on a
// callee propagates to its caller exactly as `Div` and `Panic` do.
// Before the hold was lifted, `Mod` resolved to -1: accepted, inert, and
// this file compiled clean. That silence is the defect this test pins.

fn take_mod(a: i64, b: i64) -> i64 with Mod {
    a % b
}

fn caller_without_mod(x: i64) -> i64 {
    take_mod(x, 7)
}

fn main() -> i64 with IO {
    println("unreachable")
    caller_without_mod(30)
}
