//@ compile-fail
//@ requires: madaros
//@ error-pattern: refused instead of reading 0
//@ description: A `var` declared before the first measure() is given its private sensitivity and Hessian slots in the block it was declared in. When the first measure() sits in a nested block, the slots cannot be placed there (the stores would not dominate later reads), and a loop-carried update of the var cannot be carried: a query that reads it is refused at compile time. Before, variance_of(s) read 0.48 (three independent terms) where s = 3 a^2 has variance (6a)^2 u^2 = 1.44 and hessian_of(s, 0, 0) read 0 where it is 6.

fn main() -> i32 with IO, Mut, Div, Epistemic {
    var s = 0.0
    let n: i64 = 3
    if n > 1 {
        let ka = measure(2.0, uncertainty: 0.1)
        let a: f64 = ka.value
        var i: i64 = 0
        while i < 3 {
            s = s + a * a
            i = i + 1
        }
    }
    print_f64(variance_of(s))
    print("\n")
    print_f64(hessian_of(s, 0, 0))
    print("\n")
    0
}
