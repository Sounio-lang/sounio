//@ compile-fail
//@ requires: madaros
//@ error-pattern: transcendental function argument must be dimensionless
// #3549: transcendental builtins require a zero SI dimension vector.

// The dimension check fires before lowering. (They used to also hit E221 on
// Linux because native lowering was unavailable; they are now emitted, see
// run-pass/math_trans_values.sio.)
fn main() -> i32 with IO, Mut, Panic, Div {
    let a: m = 0.5
    let t = tan(a)
    let at = atan(a)
    let th = tanh(a)
    let ai = asin(a)
    let ac = acos(a)
    return 0
}
