//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: error[E035
//@ description: #2760 review -- a parameter named println is the user's value, not the builtin, so inside a `loop` body its own effect row (`with IO`) is enforced against a caller that declares only Observe. The by-value println arm used to match on the name alone and return before that check.

fn leaf(println: fn(Unobserved<i64>) -> i64 with IO, x: Unobserved<i64>) -> i64 with Observe {
    loop {
        println(x)
        break
    }
    0
}

fn main() -> i64 with IO {
    0
}
