//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E300]
//@ description: ADR-031 R1 -- a module-level i64 initializer that overflows is refused whatever the operands; the two operands differ, so a fold that reads the right operand in place of the left one (seen on macOS arm64, 2026-11-15: checked as 10 * 10) accepts it
// 10^18 * 10 = 10^19 exceeds i64::MAX (about 9.22 * 10^18).
var G = 1000000000000000000 * 10

fn main() -> i64 with IO {
    print_int(G)
    0
}
