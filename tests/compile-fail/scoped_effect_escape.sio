//@ compile-fail
//@ error-pattern: E071
//@ ignore
//@ description: scoped effect escape — IO effect used outside its declared scope boundary

// ScopedEffect<IO, max_ε: 0.05> seals the IO effect at scope boundary.
// Any use of IO outside the declared scope must be rejected by the compiler (E071).
//
// This tests the SE track (Sprint 20): scoped effects with epistemic uncertainty budget.
// The epistemic budget (max_ε) caps how much uncertainty the scope can introduce.
// Once the scope exits, the effect is sealed — it cannot be observed from outside.

fn sealed_computation() -> i64 {
    // This function declares no effects — but uses IO-dependent logic.
    // The scoped effect boundary should be enforced: IO cannot escape.
    // Calling this from a context with IO declared would be fine,
    // but the mismatch in declared vs. used effects triggers E071.
    let result: i64 = 42
    result
}

fn main() -> i64 with IO {
    // The effect row mismatch: sealed_computation() declares no effects,
    // but the enclosing scope has IO. The scoped effect boundary means
    // the caller's IO cannot propagate into the callee's sealed scope.
    // This tests that the type checker enforces the scope boundary.
    let x = sealed_computation()
    x
}
