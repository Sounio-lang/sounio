//@ compile-fail
//@ error-pattern: cannot prove ontology subsumption
ontology D8NegativeMissingness {
    class Artifact
    class NotMeasured subclass_of Artifact
    class ObservedFalse subclass_of Artifact
}
fn require(v: ObservedFalse) -> i32 { 0 }
fn reject(v: NotMeasured) -> i32 { require(v) }
