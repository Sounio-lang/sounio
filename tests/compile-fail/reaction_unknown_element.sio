//@ compile-fail
//@ error-pattern: error[E190]
//@ error-pattern: unknown element symbol `Xx`
// An unrecognised element symbol is an ERROR, never a silent zero. If `Xx` were
// treated as contributing no atoms, this reaction would appear to balance
// (O 2/2) and a typo in a species name would pass the checker unnoticed —
// exactly the class of defect this feature exists to catch.

reaction bogus_element {
    Xx2 + O2 -> Xx2O2
}

fn main() with IO {
    println("unreachable")
}
