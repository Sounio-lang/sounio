//@ compile-fail
//@ requires: madaros
//@ error-pattern: this binding expects a different type
// Soundness witness: a Knowledge<T> nested INSIDE a container type (here, an
// array element type in a `let` annotation) must get the same validity/
// provenance subsumption as a directly-epistemic annotation. Before this
// fix, types_compatible's TyKnowledge branch -- the single recursive
// dispatch point every composite-type element comparison (array, slice,
// ref, tuple) funnels through -- only checked inner type + epsilon, so a
// container of weaker-validity Knowledge values silently satisfied an
// annotation demanding stronger validity.

ontology ChemicalOntology {
    class Chemical
    class CHEBI_15377 subclass_of Chemical
}

fn test_array_element_validity_downgrade(
    weak: Knowledge[CHEBI_15377, Valid(10.0), Derived]
) {
    let arr: [Knowledge[CHEBI_15377, Valid(30.0), Measured]; 1] = [weak]
}

fn main() {
}
