//@ compile-fail
//@ error-pattern: cannot prove ontology subsumption

ontology RelationalDynamicsNegativeGrouping {
    class ModelArtifact
    class RelationalProcess subclass_of ModelArtifact
    class MediatedHistory subclass_of RelationalProcess
    class GroupingSensitiveProcess subclass_of MediatedHistory
    class AssociativeControlProcess subclass_of MediatedHistory
}

fn requires_grouping_sensitive(p: GroupingSensitiveProcess) -> i32 { 0 }
fn reject_associative_control(p: AssociativeControlProcess) -> i32 {
    requires_grouping_sensitive(p)
}
