//@ compile-fail
//@ error-pattern: affine value cannot be consumed in a match guard

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 {
    let permit = Permit { id: 181 }
    let selector = 0
    let result = match selector {
        0 if spend(permit) > 0 => 1
        _ => spend(permit)
    }
    if result > 0 { 0 } else { 1 }
}
