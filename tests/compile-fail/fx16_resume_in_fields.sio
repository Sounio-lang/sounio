//@ compile-fail
//@ requires: madaros
//@ error-pattern: E294
//@ description: FX-7 resume uses inside struct-field initializers count toward the linear one-shot limit (SIO-417)

effect Ask { fn get() -> i64 }

struct Pair { x: i64, y: i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<Ask> { perform Ask.get() } with {
        on get() -> {
            let s = Pair { x: resume(1), y: resume(2) }
            s.x
        }
    }
    println(r)
    0
}
