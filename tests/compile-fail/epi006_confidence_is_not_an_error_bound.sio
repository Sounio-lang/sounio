//@ compile-fail
//@ requires: madaros
//@ error-pattern: this binding expects a different type
// `Knowledge(v, ε = c)` is a declared point value with confidence c (EPI-008).
// It states no variance, so it cannot meet the error bound `epsilon < 1.0`.
// The checker stored c in the error-bound slot, so a 5% confidence read as a
// variance of 0.05 and passed. EPI-006: c now goes to the confidence field.

fn main() -> i64 with IO {
    let w: Knowledge[f64, epsilon < 1.0] = Knowledge(0.0, ε = 0.05)
    println("unreachable")
    0
}
