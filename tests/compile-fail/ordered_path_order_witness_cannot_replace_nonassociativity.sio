//@ compile-fail
//@ error-pattern: expected NonAssociativityWitness

ontology OrderedPathWitnessCategory {
    class PathDistinctionWitness
    class OrderSensitivityWitness subclass_of PathDistinctionWitness
    class NonAssociativityWitness subclass_of PathDistinctionWitness
}

fn requires_nonassociativity(witness: NonAssociativityWitness) -> i64 { witness as i64 }
fn misuse(witness: OrderSensitivityWitness) -> i64 { requires_nonassociativity(witness) }
fn main() -> i32 { 0 }
