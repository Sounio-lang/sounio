//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: error[E035
//@ description: #2760 review -- a builtin call inside a `loop` body owes its effect. `loop` is checked through the by-value call spine, which did not apply the builtin effect table, so this used to check clean while the same call in a `while`/`for`/`if` body was E035.

fn leaf() -> i64 {
    loop {
        println("hello")
        break
    }
    0
}

fn main() -> i64 with IO {
    leaf()
}
