//@ compile-fail
//@ requires: lean_single
//@ error-pattern: unit mismatch in call argument
// D-24 (ADR-020), lean_single side: a dimensionless variable into a
// unit-bearing parameter is refused. Only pure literal expressions adopt
// the parameter unit.

unit pressure = kg / m / s / s

fn pressure_echo(delta: pressure) -> pressure { delta }

fn main() -> i64 with IO {
    let plain: f64 = 1000.0
    let returned = pressure_echo(plain)
    print("should not reach here\n")
    0
}
