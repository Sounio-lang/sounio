use coordination::loom_portfolio_attention::{
    acquire_portfolio_budget,
    close_portfolio_budget,
}

fn reuse_budget() -> i64 with Panic {
    let budget = acquire_portfolio_budget(100, 100, 10, 10)
    let first = close_portfolio_budget(budget)
    let second = close_portfolio_budget(budget)
    first + second
}

fn main() -> i64 { 0 }
