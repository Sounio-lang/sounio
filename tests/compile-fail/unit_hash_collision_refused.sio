//@ compile-fail
//@ error-pattern: unit name collides with a different unit's hash
//@ description: unit_call_arg_mismatch trusted `expr_unit == param_hash` as unit identity for nominal (dimension-0) units; UNIT_HASH_TABLE keys entries by gl_name_hash alone, so two DIFFERENT declared names that happen to share a hash silently alias each other -- a value declared with one satisfies a parameter declared with the other, unchecked. `DWzKZgBm` and `hHk5` are a genuine gl_name_hash (37-bit FNV-1a) collision, found by random search, not a synthetic one.

unit DWzKZgBm;
unit hHk5;

fn takes_first(x: DWzKZgBm) -> f64 with Mut { x as f64 }

fn main() with IO, Mut, Div, Panic {
    let b: hHk5 = 2.0
    let leak = takes_first(b)
    println("LEAK: hHk5 satisfied DWzKZgBm")
}
