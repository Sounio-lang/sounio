//@ compile-fail
//@ error-pattern: unit mismatch in call argument
// The bare literal 9.0 carries no unit and must be rejected. It used to be
// ACCEPTED here purely because the preceding line read a molal variable and the
// dimension survived into an unrelated expression. Removing the two middle lines
// changes nothing about the call, which is what makes the leak visible.

unit molal = mol / kg;

fn takes_molal(y: molal) -> f64 with Mut {
    2.0
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let m: molal = 2.0
    let q = m
    let r = takes_molal(9.0)
    return 0
}
