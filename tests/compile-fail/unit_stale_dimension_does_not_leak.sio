//@ compile-fail
//@ error-pattern: unit mismatch in call argument
// A plain f64 value carries no unit and must be refused by a molal parameter.
// The leak this guards against: the preceding line reads a molal variable, and
// that dimension must not survive into the unrelated argument expression.
// A bare literal would adopt the parameter unit (ADR-020 D-24), so the
// argument is a plain f64 binding, not a literal.

unit molal = mol / kg;

fn takes_molal(y: molal) -> f64 with Mut {
    2.0
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let plain: f64 = 9.0
    let m: molal = 2.0
    let q = m
    let r = takes_molal(plain)
    return 0
}
