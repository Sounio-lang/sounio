//@ compile-fail
//@ error-pattern: E035
//@ description: #2834 guard — a write through `&!T` is observable by the caller and still requires `Mut` on both engines (spec §7.2.1)

fn poke(x: &!i64) {
    *x = 42
}

fn main() -> i64 with IO, Mut {
    var v: i64 = 0
    poke(&!v)
    println(v)
    0
}
