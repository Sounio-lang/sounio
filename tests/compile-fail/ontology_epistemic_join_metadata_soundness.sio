//@ compile-fail
//@ requires: madaros
//@ error-pattern: branches have incompatible types
// Soundness witness: even with IDENTICAL ontology and epsilon, an if/else join
// must not silently accept mismatched validity/provenance metadata and mistype
// the join as the (possibly stronger) then-branch. types_compatible's
// TyKnowledge branch only compares inner type + epsilon, so this shape used to
// slip through and the if-expression returned then_ty's metadata even though
// the else branch could not actually provide it.

ontology ChemicalOntology {
    class Chemical
    class CHEBI_15377 subclass_of Chemical
}

fn test_join_metadata_mismatch(
    cond: bool,
    strong: Knowledge[CHEBI_15377, Valid(60.0), Measured],
    weak: Knowledge[CHEBI_15377, Valid(10.0), Derived]
) {
    let x = if cond {
        strong
    } else {
        weak
    }
}

fn main() {
}
