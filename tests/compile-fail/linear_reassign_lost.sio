//@ compile-fail
//@ description: SELFHOST_PASS
//@ error-pattern: not consumed
//@ description: SELFHOST_PASS

linear struct Lock {
    id: i32,
}

fn release(l: Lock) -> i32 {
    l.id  // consumes by using field
}

fn main() with Mut {
    var l = Lock { id: 1 }
    l = Lock { id: 2 }  // original lock lost!
    let result = release(l)
}
