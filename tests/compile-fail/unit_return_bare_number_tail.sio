//@ compile-fail
//@ error-pattern: unit mismatch in return value
// The tail-expression form of unit_return_bare_number.sio. A body's last
// expression is its return value as much as `return` is, but only the `return`
// statement was checked, so this spelling compiled.

unit molal = mol / kg;

fn bare() -> molal with Mut {
    5.0
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let r = bare()
    return 0
}
