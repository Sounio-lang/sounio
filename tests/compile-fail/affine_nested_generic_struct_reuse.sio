//@ compile-fail
//@ error-pattern: affine value has already been used

affine struct Permit {
    id: i64,
}

struct Inner<T> {
    value: T,
}

struct Outer<T> {
    inner: Inner<T>,
}

fn main() -> i32 {
    let permit = Permit { id: 197 }
    let inner: Inner<Permit> = Inner { value: permit }
    let outer: Outer<Permit> = Outer { inner: inner }
    let first = outer
    let second = outer
    0
}
