//@ compile-fail
//@ error-pattern: affine value consumed in potentially repeating loop

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 with Mut {
    let permit = Permit { id: 29 }
    var i: i64 = 0
    var total: i64 = 0
    while i < 3 {
        total = total + spend(permit)
        i = i + 1
    }
    total as i32
}
