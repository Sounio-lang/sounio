//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E040]
// A linear value must be consumed on EVERY path. Here the else path leaves
// `t` alive, so its fate depends on a runtime condition — which linearity
// forbids. Before the branch-aware merge this was silently ACCEPTED, because
// the checker threaded consumption sequentially and saw `t` consumed once.
//
// The sound counterpart (consumed in both arms) is
// tests/run-pass/linear_balanced_branches.sio.

linear struct Token { id: i64 }

fn consume(t: Token) -> i64 { t.id }

fn main() with IO, Panic {
    let t = Token { id: 1 }
    if 1 > 0 {
        consume(t)
    }
}
