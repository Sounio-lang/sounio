//@ compile-fail
//@ requires: madaros
//@ error-pattern: args confidence 500 < minconf 900
// E214 through derived values: a low-confidence reading stays low-confidence
// through a let copy and through arithmetic (GUM product with a literal 1000),
// so passing the derived value to an Epistemic(900) function is refused.

fn gated(x: f64) -> f64 with Epistemic(900) {
    return x
}

fn main() with IO, Mut, Epistemic {
    let k: Knowledge<f64> = measure(10.0, uncertainty: 5.0)
    let v = k.value
    let w = v * 2.0
    println(gated(w))
}
