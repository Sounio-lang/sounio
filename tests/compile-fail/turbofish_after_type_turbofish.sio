//@ compile-fail
//@ error-pattern: a second turbofish after `Type::<...>::name` is not supported
// `Type::<A>::name` parses as an associated fn of a generic type; a turbofish on
// the fn segment as well is refused with a positioned message rather than parsed
// into something the checker would misread.

struct Box2<T> {
    v: T,
}

impl Box2<T> {
    fn make(v: T) -> Box2<T> {
        Box2 { v: v }
    }
}

fn main() -> i32 {
    let b = Box2::<i64>::make::<i64>(1)
    return 0
}
