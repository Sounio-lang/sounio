//@ typecheck-fail
//@ error-pattern: error[E035
//@ description: #2760 -- the builtin `read_file` carries the IO effect; a caller that does not declare it is rejected on both engines.

fn leaf(n: i64) -> i64 {
    let v = read_file("a")
    n + 1
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    leaf(1)
}
