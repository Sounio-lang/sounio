//@ compile-fail
//@ error-pattern: cannot infer the type arguments of this generic function call
// `T` appears in no parameter, so nothing at the call site determines it. The call
// used to be checked against the unsubstituted template (E009 "expected T") while
// the template itself was lowered with T erased; it is now refused with the fix.

fn null_of<T>(x: i64) -> *mut T {
    0 as *mut T
}

fn main() -> i32 {
    let p: *mut i64 = null_of(0)
    return 0
}
