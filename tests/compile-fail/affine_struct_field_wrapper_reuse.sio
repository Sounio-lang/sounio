//@ compile-fail
//@ error-pattern: affine value used more than once
//@ description: #1263 — an affine value passed by value twice through a helper is refused on both engines

affine struct Permit {
    id: i64,
}

fn open(p: Permit) -> i64 {
    p.id
}

fn twice(p: Permit) -> i64 {
    let first = open(p)
    let second = open(p)
    first + second
}

fn main() -> i32 {
    let permit = Permit { id: 71 }
    twice(permit) as i32
}
