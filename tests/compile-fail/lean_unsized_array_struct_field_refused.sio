//@ compile-fail
//@ requires: lean_single
//@ error-pattern: unsized array struct field
//@ description: lean_single refuses an unsized `[T]` struct field built from an array literal (#2779)
//
// lean_single gives an unsized array field 0 slots in the struct layout, so the
// literal's array pointer landed on the next field: `c.entries[1].message`
// printed a frame address (rc 0) and an indexed write crashed
// (examples/showcase/effect_test_harness.sio, SIGSEGV). It now refuses the
// construction instead of emitting that code. Madaros represents `[T]` fields
// and runs this program, hence `requires: lean_single`.
struct LogEntry { level: i32, message: i32 }
struct LogCapture { entries: [LogEntry], count: i32 }

fn main() with IO {
    let e = LogEntry { level: 1, message: 2 }
    let c = LogCapture { entries: [e, e], count: 2 }
    println(c.entries[1].message)
}
