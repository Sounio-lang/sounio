//@ compile-fail
//@ error-pattern: unit mismatch in call argument
//@ description: KL-13 — a unit-typed value must not enter a bare f64 parameter without an explicit cast

fn takes_f64(x: f64) -> f64 { x * 2.0 }
fn main() with IO, Mut, Div, Panic {
    let t_k: K = 1500.0
    let a = takes_f64(t_k as f64)
    println("cast K->f64 ok")
    let b = takes_f64(t_k)
    println("implicit K->f64 must not be accepted")
}
