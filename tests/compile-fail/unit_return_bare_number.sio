//@ compile-fail
//@ error-pattern: unit mismatch in return value
// A bare number does not satisfy a unit-typed return, for the same reason it
// does not satisfy a unit-typed parameter.

unit molal = mol / kg;

fn bare() -> molal with Mut {
    return 5.0
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let r = bare()
    return 0
}
