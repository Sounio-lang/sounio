//@ compile-fail
//@ requires: madaros
//@ error-pattern: refused instead of reading 0
//@ description: A function passed as a function pointer to a helper that calls it, where the pointed-to function measures inside itself and the argument is certain: the call through the parameter cannot be resolved, so it is assumed to draw, and a query on the result is refused at compile time. Before it read 0 (the value has first-order variance 4 * 0.09 = 0.36).

fn noisy_f(y: f64) -> f64 with Epistemic, Mut, Div {
    let km = measure(2.0, uncertainty: 0.3)
    let m: f64 = km.value
    y * m
}
fn apply1(f: fn(f64) -> f64 with Epistemic, Mut, Div, x: f64) -> f64 with Epistemic, Mut, Div {
    var s = 0.0
    var i: i64 = 0
    while i < 1 {
        s = s + f(x)
        i = i + 1
    }
    s
}
fn main() -> i32 with IO, Mut, Div, Epistemic {
    let a0: f64 = 2.0
    let r = apply1(noisy_f, a0)
    print_f64(variance_of(r))
    print("\n")
    0
}
