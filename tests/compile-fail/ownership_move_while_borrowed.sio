//@ compile-fail
//@ description: SELFHOST_PASS
//@ error-pattern: cannot move while borrowed
//@ description: Cannot move a value while it is borrowed

linear struct Container {
    items: i32,
}

fn consume(c: Container) {
    // takes ownership
}

fn main() {
    let c = Container { items: 10 }
    let r = &c           // shared borrow
    consume(c)           // ERROR: cannot move while borrowed
    let x = r.items      // r is still in use
}
