//@ compile-fail
//@ requires: madaros
//@ error-pattern: does not lower as f64
//@ description: a module-level i64 constant is not taken as the f64 operand of Knowledge arithmetic

// A module-level constant is typed unknown inside a function, so the checker
// admits it as a constant and the lowerer must refuse it when it does not
// lower as a float (its integer bits would otherwise be stored as the value).

let N: i64 = 2

fn main() -> i64 with IO, Epistemic {
    let x: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    let r = x * N
    print_f64(r.value)
    0
}
