//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E313]
//@ description: a module-level i64 constant is not taken as the f64 operand of Knowledge arithmetic

// Only a float-literal initialiser makes a module-level constant exact, so an
// i64 constant is refused by the checker (E313). The lowerer still refuses a
// constant operand that does not lower as f64, as a second line.

let N: i64 = 2

fn main() -> i64 with IO, Epistemic {
    let x: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    let r = x * N
    print_f64(r.value)
    0
}
