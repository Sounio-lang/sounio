//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E004]
//@ description: a module-level i64 constant is not taken as the f64 operand of Knowledge arithmetic

// A module-level i64 now has its declared type inside functions, so
// Knowledge<f64> * i64 is a type error (E004), the same as with an integer
// literal. Before globals were typed, the checker saw an unknown and the
// exactness gate refused it with E313.

let N: i64 = 2

fn main() -> i64 with IO, Epistemic {
    let x: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    let r = x * N
    print_f64(r.value)
    0
}
