//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E041]: unit mismatch in arithmetic operation

// Scaling a Knowledge object must scale its uncertainty as well as its value.
// Until that lowering exists, differing unit scales must report E041, not E036.
fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let a: Knowledge<m> = measure(1.0, uncertainty: 0.1)
    let b: Knowledge<cm> = measure(2.0, uncertainty: 0.0)
    let c = a + b
    return 0
}
