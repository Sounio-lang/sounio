//@ compile-fail
//@ error-pattern: unit mismatch in call argument
//@ description: a nominal unit (`unit mg_dL;`, no dimensional right-hand side) has dimension zero, so it must still take an explicit cast to enter a bare f64 parameter

unit mg_dL;

fn takes_f64(x: f64) -> f64 { x * 2.0 }

fn main() with IO, Mut, Div, Panic {
    let glucose = 140.0<mg_dL>
    let ok = takes_f64(glucose as f64)
    println("cast mg_dL->f64 ok")
    let bad = takes_f64(glucose)
    println("implicit mg_dL->f64 must not be accepted")
}
