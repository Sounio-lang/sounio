//@ compile-fail
//@ requires: madaros
//@ error-pattern: not declared in function signature
//@ description: a declared user effect is enforced on Madaros once it is registered
// Discriminating control for tests/run-pass/user_effect_declared_madaros.sio.
// Before the ItemEffect arm, `with HostT` itself was refused (E246), so this
// file failed for the wrong reason. Now HostT is a real effect, and calling
// a `with HostT` function from one that does not declare it is E035.

effect HostT {}

fn trusted_add(x: i64) -> i64 with HostT { x + 1 }

fn untrusted(x: i64) -> i64 { trusted_add(x) }

fn main() -> i64 with IO {
    println(untrusted(1))
    0
}
