// #1386 fixture: a capability whose only field is private to this module,
// and a linear capability that can be redeemed once. Imported by the
// private_field_*_cross_module_1386 and linear_capability_*_1386 tests.
pub struct Token {
    scope: i64,
}

pub struct Mixed {
    pub label: i64,
    secret: i64,
}

pub fn issue() -> Token {
    Token { scope: 1 }
}

pub fn scope_of(t: &Token) -> i64 {
    t.scope
}

pub fn mixed() -> Mixed {
    Mixed { label: 7, secret: 9 }
}

pub linear struct Cap { k: i64 }

pub fn mint() -> Cap { Cap { k: 1 } }

pub fn redeem(c: Cap) -> i64 {
    let Cap { k } = c
    k
}
