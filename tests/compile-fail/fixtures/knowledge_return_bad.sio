use fixtures::knowledge_return_tail::{tail_value}

struct Payload { count: i64 }
struct IntegerValueCollision { value: i64 }

fn make_unknown() -> Knowledge<Payload> with Epistemic {
    Knowledge { value: Payload { count: 7 } }
}

pub fn keep_tail_reachable() -> i64 { tail_value() }

pub fn trigger() -> i64 with Epistemic {
    let decoy = IntegerValueCollision { value: 42 }
    let known = decoy.value
    let unknown = make_unknown()
    let must_fail = unknown.value
    known
}
