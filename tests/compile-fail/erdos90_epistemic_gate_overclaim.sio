//@ compile-fail
//@ error-pattern: EpistemicComplete violation

// Noisy measurement chain cannot support Epistemic(950). The uncertainty of the
// coord prior (σ=0.08) propagates into every vertex measure.

fn certified_summary() -> i64 with Epistemic(950), IO, Mut, Div, Epistemic {
    let unc = measure(2.0, uncertainty: 0.08)
    let p0x = measure(2.0, uncertainty: unc.value)
    let p0y = measure(2.0, uncertainty: unc.value)
    let p1x = measure(3.0, uncertainty: unc.value)
    let p1y = measure(2.0, uncertainty: unc.value)
    let dx = p0x.value - p1x.value
    let dy = p0y.value - p1y.value
    let d2 = dx * dx + dy * dy
    return 1
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    return certified_summary()
}