// Prediction (ADR-032 decision 3, fail-closed Unknown on untracked struct field):
// An untracked struct parameter `h: Holder` whose field `k` has unannotated
// type `Knowledge<f64>` widens `h.k`'s Knightian set to `Unknown` (-1).
// Passing `h.k` to a precise consumer (`ε < 0.5`) must refuse with E314.

struct Holder {
    k: Knowledge<f64>,
}

fn precise(x: Knowledge[f64, ε < 0.5]) -> f64 with Epistemic {
    x.value
}

fn leak(h: Holder) -> f64 with Epistemic {
    precise(h.k)
}

fn main() -> i64 with IO, Epistemic {
    let a = knight("k", 0.0, 1.0)
    let h = Holder { k: a }
    println(leak(h))
