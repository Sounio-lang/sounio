//@ compile-fail
//@ requires: madaros
//@ error-pattern: argument type does not match parameter
// A measurement's static epsilon is its variance bound (u² = 0.81 here), not a
// confidence. The floor `ε >= 0.5` compared the variance against the floor and
// accepted it, so a larger uncertainty met a stricter confidence floor.
// EPI-006: a confidence requirement reads the stated confidence, which a bare
// measure() does not have.

fn gated(k: Knowledge[f64, ε >= 0.5]) -> f64 with Epistemic {
    k.value
}

fn main() -> i64 with IO, Epistemic {
    println(gated(measure(10.0, uncertainty: 0.9)))
    0
}
