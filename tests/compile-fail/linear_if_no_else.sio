//@ compile-fail
//@ error-pattern: linear value consumed in if-branch with no else

// Consuming a linear value in an if-branch with no else means
// the value is only consumed on one path — unsound.

linear struct Handle { fd: i64 }

fn close(h: Handle) { }

fn main() with IO, Panic {
    let h = Handle { fd: 3 }
    if 1 > 0 {
        close(h)
    }
    // No else: h not consumed when condition is false
}
