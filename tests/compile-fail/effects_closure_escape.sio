//@ compile-fail
//@ error-pattern: effect
//@ description: Effectful closure cannot escape to pure higher-order function

fn pure_map(items: [i32], f: fn(i32) -> i32) -> [i32] {
    // pure HOF - f must be pure
    []
}

fn log(x: i32) with IO {
    // effectful
}

fn main() with IO {
    let nums = [1, 2, 3]
    // ERROR: closure performs IO but pure_map expects pure function
    let result = pure_map(nums, fn(x) {
        log(x)
        x * 2
    })
}
