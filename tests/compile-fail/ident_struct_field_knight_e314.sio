//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E314]
//
// Prediction (struct field round trip, Knightian E314):
// Storing a named Knightian value into `h.k` and reading it back keeps
// `knight_set_id = {"k"}`. Passing `h.k` to a precise bound (`ε < 0.5`)
// must fail with E314.

struct Holder {
    k: Knowledge<f64>,
}

fn precise(x: Knowledge[f64, ε < 0.5]) -> f64 with Epistemic {
    x.value
}

fn main() -> i64 with IO, Epistemic {
    let a = knight("k", 0.0, 1.0)
    let h = Holder { k: a }
    let r = h.k
    println(precise(r))
    0
}
