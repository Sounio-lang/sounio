//@ compile-fail
//@ requires: madaros
//@ error-pattern: argument type does not match parameter
// A confidence floor `ε >= 0.5` does not prove an exact confidence `ε = 0.5`:
// the value may be 0.8. Forwarding a floor-typed parameter to an exact-typed
// one at the same threshold used to pass, because both compared equal numbers.

fn exact(k: Knowledge[f64, ε = 0.5]) -> f64 with Epistemic {
    k.value
}

fn forward(k: Knowledge[f64, ε >= 0.5]) -> f64 with Epistemic {
    exact(k)
}

fn main() -> i64 with IO, Epistemic {
    let v = forward(Knowledge(1.0, ε = 0.8))
    println(v)
    0
}
