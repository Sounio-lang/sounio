//@ compile-fail
//@ ignore
//@ error-pattern: ontology classes are disjoint
// NOTE: requires full type checker (check.sio) — lean_single skips ontology type checking

ontology Medicine {
    class Drug
    class Food
    disjoint Drug, Food
}

fn treat(d: Drug) -> i32 { 0 }

fn main() -> i32 {
    let f: Food = make_food()
    treat(f)
    0
}
