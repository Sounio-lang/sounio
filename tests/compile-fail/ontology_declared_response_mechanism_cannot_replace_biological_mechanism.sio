//@ compile-fail
//@ error-pattern: cannot prove ontology subsumption
ontology EndogenousObservabilityNegative {
    class InferenceArtifact
    class DeclaredResponseMechanismIdentification subclass_of InferenceArtifact
    class BiologicalResponseMechanismReceipt subclass_of InferenceArtifact
}

fn require_biology(m: BiologicalResponseMechanismReceipt) -> i32 { 0 }

fn reject_category_error(declared: DeclaredResponseMechanismIdentification) -> i32 {
    require_biology(declared)
}
