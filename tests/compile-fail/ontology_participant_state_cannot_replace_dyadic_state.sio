//@ compile-fail
//@ error-pattern: cannot prove ontology subsumption

ontology RelationalDynamicsNegativeParticipant {
    class ModelArtifact
    class ParticipantState subclass_of ModelArtifact
    class RelationalEntity subclass_of ModelArtifact
    class DyadicRelationalState subclass_of RelationalEntity
}

fn requires_dyadic_state(s: DyadicRelationalState) -> i32 { 0 }
fn reject_participant_state(s: ParticipantState) -> i32 {
    requires_dyadic_state(s)
}
