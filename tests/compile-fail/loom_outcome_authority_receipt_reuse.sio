use coordination::loom_outcome_authority::{
    LoomOutcomeAuthorityHostTrust,
    admit_outcome_authority_digest256,
    admit_verified_measurement_receipt,
    classify_verified_measurement,
    consume_verified_outcome,
    close_host_outcome_authority_receipt,
}

fn reuse_receipt() -> i64 with LoomOutcomeAuthorityHostTrust, Panic {
    let digest = admit_outcome_authority_digest256(1, 2, 3, 4, 5, 6, 7, 8)
    let measurement = admit_verified_measurement_receipt(
        101, 201, 301, 401, 701, 750, 1201, digest,
    )
    let evidence = classify_verified_measurement(measurement, 501, digest)
    let first = consume_verified_outcome(evidence)
    let closed = close_host_outcome_authority_receipt(first)
    let second = consume_verified_outcome(evidence)
    closed + close_host_outcome_authority_receipt(second)
}

fn main() -> i64 { 0 }
