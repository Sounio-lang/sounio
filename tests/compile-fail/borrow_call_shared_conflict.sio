//@ compile-fail
//@ error-pattern: cannot borrow as shared because it is also borrowed as mutable

fn read_shared(r: &i64) -> i64 {
    *r
}

fn main() -> i32 with Mut {
    var x: i64 = 12
    let hold = &!x

    // Exclusive borrow is active, so a shared call-boundary borrow must fail.
    let y = read_shared(&x)
    if y >= 0 {
        return 0
    }
    0
}
