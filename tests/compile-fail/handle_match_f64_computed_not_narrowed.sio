//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: E018
//@ description: #830 — a computed f64 arm must not adopt a sibling f32 type

fn handle_computed_f64(k: i64, x: f32, y: f64) -> f64 {
    handle<IO> {
        match k {
            0 => y + 0.0,
            _ => x,
        }
    } with {
        0
    }
}

fn main() -> i64 {
    0
}
