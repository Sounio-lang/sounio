//@ compile-fail
//@ error-pattern: E232
//@ description: independence claim mentions a variable the causal graph does not declare

// Renumbered from E175 (this feature's original number, commit 8d7dccec05):
// under Madaros's modular checker, E175 is already "function is private in
// its defining module" (self-hosted/check/check.sio ~13793) — same
// collision-and-renumber pattern cdc4169ebe used for E209 (was E174).

// A claim about a variable outside the model is not a claim the model can
// support. Rejected rather than waved through, because silently treating an
// unknown variable as independent of everything is the most permissive possible
// reading and the one that licenses the tightest bound.

causal graph mundo {
    hora -> hrv
}

fn main() -> i64 with IO {
    let bad: IndepKnowledge<f64, hrv, temperatura_de_marte> = 1.0
    println("this line must never be reached")
    0
}
