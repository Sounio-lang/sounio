//@ compile-fail
// Shorthand Contest<T> is parser-compatible, but it is not admissible deferral evidence.

type M1 = Model<i64, i64>
models DefaultModels = [M1]
deferral_policy ReviewPolicy for i64 route review {
    require relative_band >= 0.20
}

fn main() {
    let d = 1
    let c: Contest<i64> = contest [M1] on d
    let x: Deferred<i64> = defer_action(d, c, ReviewPolicy)
}
