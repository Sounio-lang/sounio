fn main() -> i64 with IO {
    let zero: i256 = 0 as i256
    let one: i256 = 1 as i256
    let neg_one: i256 = (0 - 1) as i256
    let two32: i256 = 4294967296 as i256
    let two64: i256 = two32 * two32
    let two128: i256 = two64 * two64
    let max128: i256 = two128 - one
    let two200: i256 = two128 * two64 * (256 as i256)
    let neg_two200: i256 = -two200
    let lorenz_peak: i256 = (217041893 as i256) * two64 * (2 as i256)
    let big512: i512 = (two128 as i512) * (two128 as i512)

    println(zero)
    println(one)
    println(neg_one)
    println(two64)
    println(max128)
    println(neg_two200)
    println(lorenz_peak)
    println(big512)
    0
}
