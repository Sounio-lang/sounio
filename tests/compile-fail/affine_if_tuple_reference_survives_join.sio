affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 {
    let left = Permit { id: 223 }
    let right = Permit { id: 227 }
    let choose_left = false
    let carried = if choose_left {
        (&left, 0)
    } else {
        (&right, 1)
    }
    let consumed = spend(left)
    consumed as i32
}
