//@ compile-fail
//@ requires: madaros
//@ description: KL-20 -- a payload sub-pattern on a user enum reached through `&` is refused with E264 like the by-value form; it was accepted, the payload binding was typed as the enum itself, and the arm compared only the discriminant
//@ error-pattern: error[E264]

enum Shape { Circle(i64), Empty }

fn tag(s: &Shape) -> i64 {
    match s {
        Shape::Circle(_) => 1,
        Shape::Empty => 0,
    }
}

fn main() -> i64 { tag(&Shape::Empty) }
