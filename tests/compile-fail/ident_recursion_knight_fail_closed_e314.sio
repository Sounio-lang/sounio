//
// Prediction (recursion fail closed, Knightian):
// A recursive function returning unannotated Knowledge<f64> widens its
// `knight_set_id` to unknown (-1), which precise bounds (`ε < 0.5`) must
// refuse with E314.

fn rec_id(x: Knowledge<f64>, n: i64) -> Knowledge<f64> {
    if n <= 0 {
        x
    } else {
        rec_id(x, n - 1)
    }
}

fn precise(x: Knowledge[f64, ε < 0.5]) -> f64 with Epistemic {
    x.value
}

fn main() -> i64 with IO, Epistemic {
    let k = knight("rk", 0.0, 1.0)
    let r = rec_id(k, 1)
    println(precise(r))
