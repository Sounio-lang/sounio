//@ compile-fail
//@ requires: madaros
//@ error-pattern: an associated function of a generic struct must be called with explicit type arguments
// `G::new()` without type arguments cannot name a per-instance impl clone.
// Without this refusal the call compiled to a body-less `G_new` and the
// program died on the ud2 stub (SIGILL, rc=132).

struct G<T> {
    n: i64,
}

impl G<T> {
    fn new() -> G<T> {
        G { n: 9 }
    }
    fn size(self: &G<T>) -> i64 {
        self.n
    }
}

fn main() -> i32 with IO {
    let a: G<i64> = G::new()
    print_int(a.size())
    return 0
}
