//@ compile-fail
//@ error-pattern: linear value has already been used

use quantum::linear::{
    quantum_state_new,
    qubit_alloc,
    measure_qubit,
}

fn main() -> i32 with Mut, Div, Panic {
    var qs = quantum_state_new()
    let q = qubit_alloc(&!qs)
    let a = measure_qubit(q, &!qs, 0.0)
    let b = measure_qubit(q, &!qs, 0.0)
    if a.outcome == b.outcome {
        return 0
    }
    0
}
