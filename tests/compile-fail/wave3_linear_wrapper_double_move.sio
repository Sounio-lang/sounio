//@ compile-fail
//@ error-pattern: linear value
linear struct WaveResource { id: i64 }
struct WaveWrapper { resource: WaveResource }
fn close(resource: WaveResource) -> i64 { resource.id }
fn close_wrapper(wrapper: WaveWrapper) -> i64 { close(wrapper.resource) }
fn main() {
    let wrapper = WaveWrapper { resource: WaveResource { id: 42 } }
    let first = close_wrapper(wrapper)
    let second = close_wrapper(wrapper)
}
