//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: E018
//@ description: #830 guard — a match arm literal joins an f32 sibling only when it fits f32; 1e300 must still be refused

fn bad(k: i64, x: f32) -> f32 {
    match k {
        0 => x,
        _ => 1e300,
    }
}

fn main() -> i64 with IO {
    let a: f32 = 2.5
    println(bad(1, a) as f64)
    0
}
