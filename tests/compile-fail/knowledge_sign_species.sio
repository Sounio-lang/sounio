//@ compile-fail
//@ requires: madaros
//@ error-pattern: E151
//@ description: sign refuses two Knowledge values of different species

ontology Lab {
    class Quantity { property amount: f64 where amount >= 0.0 }
    class Pressure subclass_of Quantity
    class Enthalpy subclass_of Quantity
    disjoint Enthalpy, Pressure
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let p0: Pressure = 10.0
    let e0: Enthalpy = 30.0
    let a: Knowledge<Pressure> = measure(p0, uncertainty: 1.0)
    let b: Knowledge<Enthalpy> = measure(e0, uncertainty: 1.0)
    let _s = sign(a, b)
    0
}
