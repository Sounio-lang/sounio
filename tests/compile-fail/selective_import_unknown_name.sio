//@ compile-fail
//@ requires: madaros
//@ error-pattern: no_such_fn

// SIO-346: a selective import of a name the target module does not define
// must be refused at check time, naming the phantom name. Before this, the
// name was bound import-unknown, checked clean, and a call to it lowered to
// a body-less stub that died with Illegal instruction at run time.

use cmp::lib::{max_i64, no_such_fn}

fn main() -> i32 with IO {
    print_int(no_such_fn(3, 9))
    println("")
    return 0
}
