//@ compile-fail
//@ error-pattern: requested channel not in expression's gradient topology
//
// Gradient Topology Types (GTT) — β⁹ week-4 compile-fail regression.
//
// proj_a(a, b) = a has FN_USED_PARAMS = {arg₀} under body-precision:
// the return expression references only the first parameter.  At the
// call site, the week-4 rule unions only B9_ARG_CH_SET[0], giving
// EXPR_CH_SET = {ch0}.  Asking for H_{1,1} is now out-of-topology and
// MUST be refused at type-check time.
//
// Under the week-3 union-all rule this query would have been accepted
// (EXPR_CH_SET = {ch0, ch1} because both arg expressions carried a
// channel).  This is the regression that witnesses the tightening.

fn proj_a(a: f64, b: f64) -> f64 with Epistemic {
    a
}

fn main() with IO, Epistemic, Mut, Div {
    let k0: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let k1: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
    // proj_a's body uses only arg 0, so EXPR_CH_SET(r) = {ch0} only.
    // Hessian wrt channel 1 (k1) is out-of-topology → GTT refusal.
    let r = proj_a(k0.value, k1.value)
    println(hessian_of(r, 1, 1))
}
