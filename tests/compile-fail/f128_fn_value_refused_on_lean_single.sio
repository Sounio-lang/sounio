//@ compile-fail
//@ requires: lean_single
//@ error-pattern: f128 through a function value is not implemented
// #2387: indirect calls pass one word per argument; only direct calls use the two-limb ABI.
fn g(a: f128) -> f128 { a }

fn main() with IO {
    let f = g
    let x: f128 = 1.5
    println(f(x) as f64)
}
