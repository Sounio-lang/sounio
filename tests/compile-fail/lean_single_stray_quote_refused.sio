//@ compile-fail
//@ requires: lean_single
//@ error-pattern: Unexpected character `'`
//@ description: A `'` that does not start a lifetime (no identifier follows it) used to be skipped, so `'12' + 0` compiled as `12 + 0` and printed 12. lean_single now refuses the quote.

fn main() -> i32 with IO, Mut, Panic, Div {
    let x = '12' + 0
    println(x)
    return 0
}
