//@ compile-fail
//@ requires: lean_single
//@ error-pattern: unterminated or malformed character literal
//@ description: A `'` that does not start a character literal or a lifetime used to be skipped, so `'12' + 0` compiled as `12 + 0` and printed 12. It is refused at the lexer (E281, ADR-015 row 4).

fn main() -> i32 with IO, Mut, Panic, Div {
    let x = '12' + 0
    println(x)
    return 0
}
