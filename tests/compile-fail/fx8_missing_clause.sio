//@ compile-fail
//@ error-pattern: E295
//@ description: FX-8 exhaustivity: every op performable in the body needs a clause or a catch-all; a missing clause is a compile error (SIO-417)

effect Ask {
    fn get() -> i64
    fn put() -> i64
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<Ask> {
        perform Ask.put()
    } with {
        on get() -> resume(1)
    }
    0
}
