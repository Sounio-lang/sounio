use coordination::loom_witness_mesh_v1::{
    HostWitnessMeshV1Receipt,
    admit_witness_mesh_v1_digest256,
}

fn forge_witness_mesh_v1_receipt() -> i64 {
    let digest = admit_witness_mesh_v1_digest256(1, 2, 3, 4, 5, 6, 7, 8)
    let forged = HostWitnessMeshV1Receipt {
        domain_token: 501,
        anchor_sequence: 1,
        event_count: 3,
        journal_head: digest,
    }
    0
}

