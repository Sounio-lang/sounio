//@ compile-fail
//@ ignore
//@ error-pattern: consumed
//@ description: Linear value cannot be used inside a loop (loop consumption not fully implemented)

linear struct Counter {
    value: i32,
}

fn use_counter(c: Counter) -> i32 {
    c.value
}

fn main() {
    let counter = Counter { value: 1 }
    var i = 0
    // This should fail: counter might be consumed multiple times in loop
    while i < 3 {
        let x = use_counter(counter)  // ERROR in iteration 2+
        i = i + 1
    }
}
