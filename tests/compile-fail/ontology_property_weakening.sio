//@ compile-fail
//@ error-pattern: ontology subsumption could not be verified
// Test: child property WEAKENS parent — should warn W041
// (Child declares potency >= -1.0 which does NOT imply parent's potency >= 0.0)

ontology BadPharma {
    class Drug {
        property potency: f64 where potency >= 0.0
    }
    class WeakDrug subclass_of Drug {
        property potency: f64 where potency >= -1.0
    }
}

fn main() -> i32 {
    0
}
