//@ compile-fail
//@ requires: madaros
//@ error-pattern: GUM_UNTRACKED_CONTAINER
// #3546: an if-expression copies the array handle into a fresh merge register.

fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    var arr: [f64; 4] = [0.0; 4]
    let ka: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    arr[0] = ka.value
    let other = if true { arr } else { [0.0; 4] }
    print_f64(variance_of(other[0]))
    return 0
}
