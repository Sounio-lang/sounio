//@ compile-fail
//@ error-pattern: cannot prove ontology subsumption
ontology ReflexiveInquiryNegative {
    class InferenceReceipt
    class ReactiveLocusAmbiguity subclass_of InferenceReceipt
    class BiologicalMechanismReceipt subclass_of InferenceReceipt
}

fn require_biological_mechanism(r: BiologicalMechanismReceipt) -> i32 { 0 }

fn reject_locus_collapse(receipt: ReactiveLocusAmbiguity) -> i32 {
    require_biological_mechanism(receipt)
}
