//@ compile-fail
//@ error-pattern: unit mismatch
//@ requires: madaros
// Negative control for the literal-absorbs-unit rule: a COMPUTED f64 with no
// unit compared against mg is a real dimensional error and must keep failing.
// Only a literal may absorb the peer's unit.
fn scalar() -> f64 { 3.0 }

fn main() -> i64 with IO {
    let dose: mg = 500.0
    let bare = scalar()
    if dose == bare {
        println("should not typecheck")
    }
    0
}
