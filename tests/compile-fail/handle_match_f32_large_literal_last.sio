//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: E018
//@ description: #830 — an oversized literal after a typed f32 arm must remain incompatible

fn handle_large_last(k: i64, x: f32) -> f32 {
    handle<IO> {
        match k {
            0 => x,
            _ => 1e300,
        }
    } with {
        0
    }
}

fn main() -> i64 {
    0
}
