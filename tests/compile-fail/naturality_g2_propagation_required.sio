//@ compile-fail
//@ error-pattern: effect not declared in function signature
//
// M2c — pins that the NaturalityG2 effect propagates through the call
// graph like every other algebraic effect (Mut, Div, …). A caller that
// invokes a NaturalityG2-declared callee must itself declare the
// effect, or the compiler must reject.

fn f_g2(x: i64) -> i64 with NaturalityG2 {
    return x + 1
}

// MISSING: this function calls f_g2 but does NOT declare NaturalityG2.
fn caller(x: i64) -> i64 {
    return f_g2(x)
}

fn main() -> i64 with IO, NaturalityG2 {
    let r: i64 = caller(5)
    return r
}
