//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E009]

// SIO-352 / ADR-020 (D-26): implicit borrow at a call is for identifiers
// only. A field access passed where `&Point` is expected must be refused
// with a diagnostic (write `sum(&o.inner)`), never compiled into a
// segfault.

struct Point { x: i64, y: i64 }

struct Outer { inner: Point }

fn sum(p: &Point) -> i64 {
    return p.x + p.y
}

fn main() -> i32 with IO {
    let o = Outer { inner: Point { x: 3, y: 4 } }
    print_int(sum(o.inner))
    println("")
    return 0
}
