//@ compile-fail
//@ error-pattern: a `where` refinement on Knowledge<T> is not enforced by this compiler yet
//@ description: #2753 — `Knowledge<T where { ... }>` is refused on both engines until the predicate is enforced; the invalid value (age = 13) is refused too, because neither engine checks it (Madaros used to run age = 13 to rc 0; lean_single refused every value with an unrelated P0003)

struct Patient {
    age: i64,
}

fn observed_age() -> i64 {
    return 13
}

fn make_patient() -> Knowledge<Patient where { age >= 18 }> with Panic, Epistemic {
    let k: Knowledge<Patient where { age >= 18 }> = measure(Patient { age: observed_age() }, uncertainty: 0.0)
    k
}

fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    let p = make_patient()
    print("age=")
    print_int(p.value.age)
    print("\n")
    println("REFINEMENT_NOT_ENFORCED")
    0
}
