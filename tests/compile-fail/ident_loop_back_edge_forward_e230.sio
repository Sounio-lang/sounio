//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E230]
//@ sabotage: SOUNIO_NS_DISABLE
//
// Prediction (loop back edge, fail-closed):
// `acc` is reassigned inside the loop, so a use of `acc` in the body may see
// the PREVIOUS iteration's value, not the pre-loop one. Before the body is
// checked, `acc` is widened to Unknown. `cur - acc` cannot be shown to be an
// exact same-identity operation, so it must be refused with E230.
//
// Measured before the fix (#3748 at 33f953e3e1): the body was checked once,
// with acc = {a} from before the loop and cur = {a}. The subtraction was
// accepted as an exact same-identity operation, and the program printed
// Var(cur - acc) = 2.0 on every iteration. The true value is 0: both are `a`.
// Main accepts it too and also prints 2.0 (measured): the hole in the loop
// analysis predates #3748, which reached it from a new path.

fn fwd(x: Knowledge<f64>) -> Knowledge<f64> {
    x
}

fn main() -> i64 with IO, Epistemic {
    let a = measure(10.0, uncertainty: 1.0)
    var acc = fwd(a)
    var i = 0
    while i < 2 {
        let cur = fwd(a)
        let s = cur - acc
        println(variance_of(s.value))
        acc = cur
        i = i + 1
    }
    0
}
