//@ compile-fail
//@ error-pattern: not declared in function signature

// Caller declares IO but callee requires IO + Mut — should fail on Mut
fn needs_io_and_mut(x: i64) -> i64 with IO, Mut {
    print("mutating\n")
    x + 1
}

fn only_io() -> i64 with IO {
    needs_io_and_mut(5)
}

fn main() -> i32 {
    return 0
}
