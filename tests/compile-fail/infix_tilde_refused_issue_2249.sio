//@ compile-fail
//@ error-pattern: `~` is not a binary operator
//@ description: #2249 — `x ~ y` is refused on both engines (Madaros computed x + y = 42; lean_single bound x = 20 and evaluated `~y` as a separate statement)

fn main() -> i64 with IO {
    let x = 20
    let y = 22
    let b = x ~ y
    println(b)
    0
}
