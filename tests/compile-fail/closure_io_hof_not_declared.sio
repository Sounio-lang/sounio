//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E035]

// SIO-27 (#2760): an IO builtin inside a closure is effect-transparent -- the
// obligation lands on the enclosing named fn. pure_fn declares no IO, so the
// print inside the closure it builds must be refused with E035, even though
// the closure flows through a pure fn-typed parameter and main declares IO.
// Mirror of witness w17 (tests/witness_matrix/cases/w17_effect_leak_via_hof.sio).

fn map_apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }

fn pure_fn() -> i64 {
    map_apply(|x: i64| -> i64 { print("io\n"); x }, 5)
}

fn main() -> i32 with IO {
    let r = pure_fn()
    0
}
