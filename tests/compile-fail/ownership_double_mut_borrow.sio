//@ compile-fail
//@ error-pattern: exclusive borrow already active
//@ description: Cannot have two mutable borrows at the same time

struct State {
    value: i32,
}

fn main() {
    var s = State { value: 0 }
    let r1 = &!s    // first mutable borrow
    let r2 = &!s    // ERROR: cannot borrow mutably twice
    r1.value = 1
    r2.value = 2
}
