// Knowledge<f64, eps=0.2> should NOT be assignable to Knowledge<f64, eps=0.05>
// because 0.2 > 0.05 (looser bound cannot satisfy tighter requirement)

fn needs_precise(k: Knowledge<f64, epsilon < 0.05>) -> f64 {
    k.value
}

fn main() -> i32 with IO, Epistemic {
    let loose: Knowledge<f64, epsilon < 0.2> = measure(500.0, uncertainty: 100.0)
    let result = needs_precise(loose)
    return 0
}
