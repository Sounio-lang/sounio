//@ compile-fail
//
// Gradient Topology Types (GTT) — β⁹ week-10 compile-fail (reassignment replaces topology).
//
// After the scalar-reassignment fix, `x = new_expr` REPLACES VAR_CH_SET[x]
// with EXPR_CH_SET of the new expression (not unioned).  So:
//
//     var r = k0.value     // r: {ch0}
//     r = k1.value         // r: {ch1}  (ch0 is gone)
//     hessian_of(r, 0, 0)  // REFUSED: channel 0 not in {ch1}
//
// This matches the semantics of let-binding — the variable's topology
// reflects its *current* value's topology, not its history.

fn main() with IO, Epistemic, Mut, Div {
    let k0: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let k1: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
    var r: f64 = k0.value    // r: channel 0
    r = k1.value             // r: channel 1 only (replaces ch0)
    let h00 = hessian_of(r, 0, 0)  // ERROR: channel 0 not in topology
    println(h00)
}
