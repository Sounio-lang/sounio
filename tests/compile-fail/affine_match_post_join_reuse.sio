//@ compile-fail
//@ requires: madaros
//@ error-pattern: affine value has already been used

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 {
    let permit = Permit { id: 53 }
    let selector = 0
    let first = match selector {
        0 => spend(permit)
        _ => 0
    }
    let second = spend(permit)
    (first + second) as i32
}
