//@ compile-fail
ontology D9NegativeCalibrationKinds {
    class Artifact
    class StatisticalCoverageCalibration subclass_of Artifact
    class InstrumentCalibration subclass_of Artifact
}
fn require(v: InstrumentCalibration) -> i32 { 0 }
fn reject(v: StatisticalCoverageCalibration) -> i32 { require(v) }
