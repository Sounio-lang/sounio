//@ compile-fail
//@ error-pattern: effect not declared in function signature
//@ description: Exact function cannot call Approx function without declaring Approx

fn approx_value() -> f64 with Approx { 1.414 }

fn exact_caller() -> f64 {
    approx_value()
}

fn main() -> i64 with IO {
    exact_caller()
    0
}
