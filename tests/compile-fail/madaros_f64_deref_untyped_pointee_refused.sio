//@ compile-fail
//@ requires: madaros
//@ description: a dereference whose pointee Madaros cannot type, used as an operand next to an f64, is refused instead of computed on its IEEE-754 bit pattern
//@ error-pattern: cannot type the pointee of a dereference used as an f64 operand

// Fail-closed companion to tests/run-pass/madaros_f64_deref_operand.sio.
// Madaros types `*r` only when r is a local or parameter of type &f64 / &!f64.
// `*get(&x)` and `*(&x)` are well-typed f64 (lean_single prints 3.5 for both),
// but their pointee is not visible to the lowering classifier. Before the fix
// they lowered as an integer operand and printed 4612811918334230528.0; the
// lowering now refuses them with a diagnostic. Binding the value first
// (`let v: f64 = *get(&x)`) compiles and is correct.

fn get(p: &f64) -> &f64 { p }

fn via_call(v: f64) -> f64 {
    var x: f64 = 2.5
    *get(&x) + v
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print_f64(via_call(1.0)) println("")
    0
}
