//@ compile-fail
//@ error-pattern: argument type does not match parameter

ontology ProofCarryingInferenceNegativeTruth {
    class EpistemicArtifact
    class InferenceReceipt subclass_of EpistemicArtifact
    class DeclaredFamilyRefutation subclass_of InferenceReceipt
    class GlobalTruthReceipt subclass_of InferenceReceipt
}

fn requires_global_truth(r: GlobalTruthReceipt) -> i32 { 0 }
fn reject_refutation(r: DeclaredFamilyRefutation) -> i32 {
    requires_global_truth(r)
}
