//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E285]
// #3552: ontology property weakening must not reuse the unit-mismatch code.
ontology BadPharma {
    class Drug {
        property potency: f64 where potency >= 0.0
    }
    class WeakDrug subclass_of Drug {
        property potency: f64 where potency >= -1.0
    }
}

fn main() -> i32 { 0 }
