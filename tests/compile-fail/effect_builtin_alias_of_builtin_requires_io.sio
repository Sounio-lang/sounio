//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: error[E035
//@ description: #2760 review -- `let print = print` is an alias, not a user function: the second binding copies the builtin's unknown type, so it must not count as a shadow. Exempting it let a function print with no IO (the unknown-callee fallback never enforces effects).

fn leaf() -> i64 {
    let print = print
    print("x")
    0
}

fn main() -> i64 with IO {
    leaf()
}
