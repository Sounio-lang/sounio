//@ compile-fail
//@ requires: lean_single
//@ error-pattern: character literals are not supported by lean_single
//@ description: A quoted run of identifier characters, `'ab'`, is not a lifetime and not a character literal. lean_single used to skip both quotes and read the identifier `ab`, so this program printed 7. It is now refused at the lexer, as `'b'` already was.

fn main() -> i32 with IO, Mut, Panic, Div {
    let ab = 7
    let x = 'ab'
    println(x)
    return 0
}
