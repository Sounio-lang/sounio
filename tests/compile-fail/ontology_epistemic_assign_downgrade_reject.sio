//@ compile-fail
//@ requires: madaros
//@ error-pattern: cannot assign this value to the target
// Negative witness: simple reassignment (`x = ...`), not just let/return/call,
// must go through the same authoritative four-axis subsumption check. A
// variable declared with a 30s validity window must not be silently
// downgradeable via `=` to a value only valid for 10s, even though the inner
// ontology type and epsilon are identical.
//
// The diagnostic here is the generic E002 ("cannot assign this value to the
// target"), not the axis-specific E263 ("Temporal validity window
// mismatch") call boundaries get -- E263/E244/E036 classification is wired
// up only at checker_check_call_arg_knowledge_boundary_inplace (call
// arguments), not at assignment or let/var initializers. The four-axis
// REJECTION itself is what this fixture proves; extending the same
// axis-specific diagnostic to assignment/initializer sites is tracked as a
// follow-up, not done in this pass.

ontology ChemicalOntology {
    class Chemical
    class CHEBI_15377 subclass_of Chemical
}

fn test_assign_validity_downgrade(
    fresh: Knowledge[CHEBI_15377, Valid(30.0), Derived],
    stale: Knowledge[CHEBI_15377, Valid(10.0), Derived]
) {
    var w: Knowledge[CHEBI_15377, Valid(30.0), Derived] = fresh
    w = stale
}

fn main() {
}
