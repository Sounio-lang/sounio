//@ compile-fail
//@ requires: lean_single
//@ error-pattern: integer literal does not fit any 64-bit integer type
//@ description: lean_single twin of madaros_int_hex_over_64bit_refused.sio — 0x1FFFFFFFFFFFFFFFF is 65 bits and used to wrap to -1. Bit patterns that do fit 64 bits (0xBF31A9BDE18F45C7 in the codegen emitters) stay accepted: the refusal is about width, not sign.

fn main() with IO {
    println(0x1FFFFFFFFFFFFFFFF)
}
