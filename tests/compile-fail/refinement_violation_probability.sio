//@ compile-fail
//@ error-pattern: refinement type violation
//@ description: Invalid probability value violates refinement

fn takes_probability(p: { prob: f64 | prob >= 0.0 && prob <= 1.0 }) -> f64 {
    p
}

fn main() {
    let result = takes_probability(1.5)  // ERROR: 1.5 violates prob <= 1.0
}
