//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E307]
//@ description: retract removes a source of the contest; naming a value that is not one of its sources is refused at compile time, not ignored.
fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    let k0 = measure(1.0, uncertainty: 0.1)
    let k1 = measure(1.3, uncertainty: 0.1)
    let k2 = measure(0.9, uncertainty: 0.1)
    let a = k0.value
    let b = k1.value
    let d = k2.value
    let c = contest(a, b)
    let r = retract(c, d, because: "not in the contest")
    print_f64(meet(r))
    0
}
