//@ compile-fail
// A numerical callback contract must not admit IO.
use functional::calculus::{deriv}
fn io_callback(x: f64) -> f64 with IO { println("IO_MUST_BE_REJECTED") x }
fn main() -> i32 with IO, Mut, Div, Panic {
    let result = deriv(io_callback, 1.0)
    if result == 0.0 { return 0 }
    1
}
