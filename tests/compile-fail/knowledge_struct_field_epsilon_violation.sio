//@ compile-fail
//
// Struct-field Knowledge<T> — β¹⁰ compile-fail (epsilon violation on construction).
//
// A struct field declared as Knowledge<f64, epsilon(0.1)> requires the stored
// value to have epsilon ≤ 0.1.  Providing a Knowledge<f64> value produced by
// measure(x, uncertainty: 0.5) has epsilon ≈ 0.5 > 0.1 — this must be refused.

struct TightPair { k: Knowledge<f64, epsilon(0.1)>, n: i64 }

fn main() with IO, Epistemic, Mut {
    let wide: Knowledge<f64> = measure(2.0, uncertainty: 0.5)
    let p = TightPair { k: wide, n: 1 }  // ERROR: epsilon 0.5 > 0.1
    println(0)
}
