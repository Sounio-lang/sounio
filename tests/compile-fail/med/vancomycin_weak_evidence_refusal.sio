//@ compile-fail
//@ error-pattern: StrongEvidence
// Weak evidence tier must be rejected when strong evidence is required.

type StrongEvidence = RCT_Level1A | MetaAnalysis;
type EvidenceLevel = RCT_Level1A | MetaAnalysis | Observational | ExpertOpinion;

fn prescribe_vancomycin(
    final_dose: Knowledge[f64, ε >= 0.82],
    evidence: StrongEvidence
) {
    println(final_dose);
    println(evidence);
}

fn main() with IO {
    let adjusted_dose: Knowledge[f64, ε=0.90] = Knowledge {
        value: 935.0,
        epsilon: 0.90,
        provenance: "bayesian_tdm_high_quality"
    };

    let weak_evidence: EvidenceLevel = EvidenceLevel::ExpertOpinion;
    prescribe_vancomycin(adjusted_dose, weak_evidence)
}
