//@ compile-fail
//@ error-pattern: epsilon
// Low-confidence vancomycin order must be rejected at compile time.

type StrongEvidence = RCT_Level1A | MetaAnalysis;

fn prescribe_vancomycin(
    final_dose: Knowledge[f64, ε >= 0.82],
    evidence: StrongEvidence
) {
    println(evidence);
    println(final_dose);
}

fn main() with IO {
    let unsafe_dose: Knowledge[f64, ε=0.71] = Knowledge {
        value: 980.0,
        epsilon: 0.71,
        provenance: "low_quality_update"
    };

    prescribe_vancomycin(unsafe_dose, StrongEvidence::RCT_Level1A)
}
