//@ compile-fail
//@ requires: madaros
//@ error-pattern: a computed value may not claim it was obtained
//
// R-ORIGIN. A sum is not a measurement.
//
// Measured, Literature, Source and Input are claims about where a value CAME
// FROM. Arithmetic does not obtain a value from anywhere -- nobody measured a
// sum. Ascribing one of those four to the result of a Knowledge arithmetic
// operation is origin laundering: a Literature quantity goes in, arithmetic
// happens, and a Measured quantity comes out with nobody having measured
// anything. Reviewers look for this by hand; no compiler refuses it.

fn main() -> i64 with IO {
    let a: Knowledge[f64, Measured] = measure(1.0, uncertainty: 0.1)
    let b: Knowledge[f64, Measured] = measure(2.0, uncertainty: 0.1)
    let s: Knowledge[f64, Measured] = a + b
    println("unreachable")
    0
}
