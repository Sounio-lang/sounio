//@ compile-fail
// Shorthand Contest<T>/Robust<T> cannot bypass explicit deferral at the resolution layer.

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}
acquisition_policy RenalClarify for i64 objective ModelDiscrimination route review {}
recourse_policy ConservativeFallback for i64 strategy dose_reduction route review {}

fn main() {
    let d = 1
    let c: Contest<i64> = contest [M1] on d
    let r: Robust<i64> = prove_robust(c, DefaultPolicy)
    let _a: AcquisitionPlan<i64> = plan_acquisition(d, c, RenalClarify)
    let _b: RecoursePlan<i64> = plan_recourse(d, r, ConservativeFallback)
}
