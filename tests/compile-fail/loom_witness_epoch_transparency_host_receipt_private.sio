use coordination::loom_witness_epoch_transparency::{
    HostEpochTransparencyReceipt,
    admit_epoch_transparency_digest256,
}

fn forge_epoch_transparency_receipt() -> i64 {
    let digest = admit_epoch_transparency_digest256(1, 2, 3, 4, 5, 6, 7, 8)
    let forged = HostEpochTransparencyReceipt {
        from_epoch: 1,
        to_epoch: 2,
        tree_size: 1,
        tree_root: digest,
        handoff: digest,
        journal_head: digest,
        certificate: digest,
    }
    0
}

fn main() -> i64 { 0 }
