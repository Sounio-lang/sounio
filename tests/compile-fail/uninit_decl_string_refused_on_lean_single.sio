//@ compile-fail
//@ requires: lean_single
//@ error-pattern: declaration without an initializer
// #2817: lean_single zero-initializes only integer, float and bool locals that
// have no initializer. A string has no valid zero here, so the declaration is
// refused rather than bound to whatever was in rax. (Madaros accepts it.)
fn main() with IO {
    var s: string
    println("unreachable")
}
