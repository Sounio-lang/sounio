//@ compile-fail
//@ error-pattern: affine value has already been used

affine struct OptionalPermit {
    id: i64,
}

fn spend(permit: OptionalPermit) -> i64 {
    permit.id
}

fn main() -> i32 {
    let permit = OptionalPermit { id: 7 }
    let enabled = true
    let first = if enabled {
        spend(permit)
    } else {
        0
    }
    let second = spend(permit)
    (first + second) as i32
}
