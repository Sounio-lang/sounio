//@ compile-fail
//@ requires: madaros
//@ description: #2787 a Some(x) payload Madaros cannot type, used next to an f64, is refused instead of computed on its IEEE-754 bit pattern
//@ error-pattern: cannot type a `Some(x)` payload used as an f64 operand

// Fail-closed companion to tests/run-pass/option_payload_kinds_2787.sio.
// Madaros types the payload of `Some(x)` only when the matched value is a
// local or parameter declared `Option<T>`. Here the scrutinee is a call, so x
// is an untyped word. Before #2787 this printed 9218868437227405312.000000;
// `let o: Option<f64> = mk(1)` and `match o { .. }` compiles and prints 3.0.

fn mk(i: i64) -> Option<f64> {
    if i > 0 { Some(1.5) } else { None }
}

fn main() -> i32 with IO {
    match mk(1) {
        Some(x) => println(x * 2.0),
        None => println(0.0),
    }
    0
}
