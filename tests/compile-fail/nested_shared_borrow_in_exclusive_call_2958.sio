//@ compile-fail
//@ error-pattern: E037
//@ requires: madaros
//@ note: #2958 -- `set(&! v, i, get(&v, j))` borrows `v` both ways in one call. self-hosted/ir/layout.sio did this in layout_reorder_functions and Madaros could no longer typecheck its own entry point; the fix hoists the read into a `let`.

struct Box { a: i64, b: i64 }

fn get(v: &Box, i: i64) -> i64 { if i == 0 { v.a } else { v.b } }

fn set(v: &!Box, i: i64, x: i64) with Mut {
    if i == 0 { v.a = x } else { v.b = x }
}

fn main() -> i32 with IO, Mut {
    var v = Box { a: 1, b: 2 }
    set(&! v, 0, get(&v, 1))
    0
}
