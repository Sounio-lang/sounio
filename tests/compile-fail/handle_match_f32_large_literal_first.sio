//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: E018
//@ description: #830 — an oversized literal before a typed f32 arm must prevent retroactive narrowing

fn handle_large_first(k: i64, x: f32) -> f32 {
    handle<IO> {
        match k {
            0 => 1e300,
            _ => x,
        }
    } with {
        0
    }
}

fn main() -> i64 {
    0
}
