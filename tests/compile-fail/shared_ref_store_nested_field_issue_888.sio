//@ compile-fail
//@ error-pattern: E267
//@ description: #888 — a nested field store `w.inner.value = v` through a shared `&T` is refused on both engines

struct P { value: i64, arr: [i64; 4] }
struct W { inner: P }

fn bad(w: &W) with Mut {
    w.inner.value = 7
}

fn main() -> i64 with IO, Mut {
    var p = P { value: 1, arr: [0; 4] }
    var w = W { inner: P { value: 1, arr: [0; 4] } }
    bad(&w)
    println(p.value + p.arr[1] + w.inner.value)
    0
}
