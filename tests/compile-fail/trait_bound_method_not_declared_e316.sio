//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E316]

// A method that no bound of the type parameter declares is refused, even when
// another trait in scope declares it.
trait A { fn a(self) -> i64 }
trait B { fn b(self) -> i64 }

fn f<T: A>(x: T) -> i64 { x.b() }

fn main() -> i32 {
    return 0
}
