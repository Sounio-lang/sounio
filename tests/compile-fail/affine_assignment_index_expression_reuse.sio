//@ compile-fail
//@ requires: madaros
//@ error-pattern: affine value has already been used

affine struct IndexPermit {
    id: i64,
}

fn spend(index: IndexPermit) -> i64 {
    index.id
}

fn main() -> i32 with Mut {
    var values = [0, 0]
    let index = IndexPermit { id: 0 }
    values[index.id] = 1
    spend(index) as i32
}
