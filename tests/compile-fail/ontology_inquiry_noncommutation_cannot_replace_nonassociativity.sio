ontology ReflexiveInquiryNegative {
    class EffectArtifact
    class ExactNonCommutationReceipt subclass_of EffectArtifact
    class NonAssociativityReceipt subclass_of EffectArtifact
}

fn require_nonassociativity(r: NonAssociativityReceipt) -> i32 { 0 }

fn reject_category_error(receipt: ExactNonCommutationReceipt) -> i32 {
    require_nonassociativity(receipt)
}
