//@ compile-fail
//@ ignore
//@ error-pattern: not consumed
//@ description: Struct containing linear field must be consumed (linear field propagation not implemented)

linear struct Inner {
    value: i32,
}

struct Wrapper {
    inner: Inner,
}

fn main() {
    let w = Wrapper { inner: Inner { value: 42 } }
    // ERROR: w contains linear field and is not consumed
}
