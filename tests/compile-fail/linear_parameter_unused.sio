//@ typecheck-fail
//@ error-pattern: linear value not consumed
//@ description: Linear function parameter must be consumed

linear struct Permit {
    level: i32,
}

fn ignores_permit(p: Permit) -> i32 {
    // ERROR: p is not consumed in function body
    42
}

fn main() {
    let permit = Permit { level: 5 }
    let result = ignores_permit(permit)
}
