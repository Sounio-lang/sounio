//@ compile-fail
//@ requires: madaros
//@ description: P1.3 -- payload sub-patterns on a user enum never bind in Madaros (the arm compares only the discriminant); refused with E264
//@ error-pattern: error[E264]

enum Shape { Circle(i64), Empty }

fn area(s: Shape) -> i64 {
    match s {
        Shape::Circle(r) => r,
        Shape::Empty => 0,
    }
}

fn main() -> i64 { area(Shape::Empty) }
