//@ compile-fail
//@ requires: madaros
//@ error-pattern: refused instead of reading 0
//@ description: An uncertainty query whose argument reaches a call the compiler cannot differentiate (here a higher-order call through a function parameter) is refused at compile time. Before, Madaros answered variance_of(apply1(dbl, x)) with 0.0 while the first-order value is 4 * 0.09 = 0.36.

fn dbl(y: f64) -> f64 with Mut, Div { 2.0 * y }

fn apply1(f: fn(f64) -> f64 with Mut, Div, x: f64) -> f64 with Mut, Div {
    var s = 0.0
    var i: i64 = 0
    while i < 1 {
        s = s + f(x)
        i = i + 1
    }
    s
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let k = measure(5.0, uncertainty: 0.3)
    let x: f64 = k.value
    print_f64(variance_of(apply1(dbl, x)))
    print("\n")
    0
}
