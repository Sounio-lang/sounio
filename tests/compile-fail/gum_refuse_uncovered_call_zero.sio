//@ compile-fail
//@ requires: madaros
//@ error-pattern: refused instead of reading 0
//@ description: An uncertainty query whose argument reaches a call the compiler cannot differentiate is refused at compile time, never answered 0. Here the function argument of a higher-order call is selected at run time (`if sel == 0 { dbl } else { tri }`), so no clone can be specialised to it: which function runs, and hence the derivative, is only known when the program runs. (A named function, a `let` alias of one, or a function parameter of an enclosing specialised clone is resolved at compile time and covered: tests/run-pass/gum_fo_tangent_clone_hof.sio.) Before, Madaros answered such a query with 0.0 where the first-order value is 4 * 0.09 = 0.36 for dbl and 9 * 0.09 = 0.81 for tri.

fn dbl(y: f64) -> f64 with Mut, Div { 2.0 * y }
fn tri(y: f64) -> f64 with Mut, Div { 3.0 * y }

fn apply1(f: fn(f64) -> f64 with Mut, Div, x: f64) -> f64 with Mut, Div {
    var s = 0.0
    var i: i64 = 0
    while i < 1 {
        s = s + f(x)
        i = i + 1
    }
    s
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let k = measure(5.0, uncertainty: 0.3)
    let x: f64 = k.value
    let sel: i64 = 0
    let g = if sel == 0 { dbl } else { tri }
    print_f64(variance_of(apply1(g, x)))
    print("\n")
    0
}
