//@ compile-fail
//@ ignore
//@ error-pattern: effect
//@ description: SELFHOST_PASS

effect Fail {
    fn fail(msg: string) -> !
}

fn might_fail() with Fail {
    Fail.fail("something went wrong")
}

// main() has no effect declaration and no handler
fn main() {
    might_fail()  // ERROR: Fail effect not handled
}
