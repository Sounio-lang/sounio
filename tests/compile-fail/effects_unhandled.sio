//@ compile-fail
//@ error-pattern: effect not declared in function signature
//@ description: SELFHOST_PASS — user-defined effect enforcement; effect op defs require trailing semicolons

effect Fail {
    fn fail(code: i64) -> i64;
}

fn might_fail() -> i64 with Fail {
    Fail.fail(1)
}

// main() has no effect declaration and no handler
fn main() -> i64 {
    might_fail()  // ERROR: Fail effect not handled
}
