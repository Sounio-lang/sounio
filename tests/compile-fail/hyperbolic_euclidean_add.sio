//@ compile-fail
//@ error-pattern: arithmetic operands must have matching numeric types
// Feature C-a: a HypPoint carries its manifold nominally, so adding two hyperboloid
// points as if they were ℝⁿ vectors is a type error (Euclidean + is not a manifold op).
use math::hyperbolic::*
fn euclidean_add(a: HypPoint, b: HypPoint) -> HypPoint { a + b }
