//@ compile-fail
//@ error-pattern: E072
//@ description: conditional independence violation — X not d-separated from Y without conditioning

// In a causal graph where X directly causes Y (X -> Y),
// X is NOT conditionally independent of Y on the empty conditioning set.
// Claiming X ⊥⊥ Y | {} (no conditioning variables) must be rejected as a type error (E072).
//
// This tests the CI track (Sprint 20): TyCondIndep / IndepKnowledge<T, X, Y | Z>.
// The Pearl d-separation check (Bayes Ball algorithm) must detect that:
//   - In the causal DAG with edge X -> Y, there is an active path X -> Y
//   - Conditioning on {} does NOT block this path
//   - Therefore X ⊥⊥ Y | {} is FALSE and must be rejected
//
// Reference: Pearl 1995, d-separation; Bayes Ball (Shachter 1998).

fn direct_cause(x: f64) -> f64 with IO {
    // Y = 2 * X — direct functional dependence, no d-separation possible without conditioning
    x * 2.0
}

fn compute_marginals(x_val: f64) -> f64 with IO {
    // Computes Y from X — establishing the direct causal link in the DAG
    direct_cause(x_val)
}

fn main() -> i64 with IO {
    let x: f64 = 1.0
    let y: f64 = compute_marginals(x)
    // The following claim would be a type error if the user annotated:
    //   let ci: IndepKnowledge<f64, x, y | {}> = assert_indep(x, y, cond: empty)
    // Because x -> y is a direct edge — Bayes Ball finds an active path.
    // E072 is emitted when the claimed independence contradicts the causal DAG structure.
    42
}
