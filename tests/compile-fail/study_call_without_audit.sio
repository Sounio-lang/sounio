//@ compile-fail
//@ error-pattern: effect not declared
//@ ignore

// Calling a study function (which has implicit Hypothesis effect)
// from a non-Audit function should be an error.

study {
    hypothesis {
        name: "drug_effect"
        direction: "positive"
    }

    fn test_drug() -> i64 with IO {
        1
    }
}

fn main() -> i64 with IO {
    // ERROR: main has IO but not Audit, and test_drug has Hypothesis
    test_drug()
}
