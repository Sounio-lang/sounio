//@ compile-fail
//@ requires: madaros
//@ error-pattern: unit mismatch in arithmetic operation
//@ description: unit_registry_intern_dim gates its own capacity check at 32 (a leftover from before the registry grew to 128 -- see UnitRegistry below) and never sets UNIT_REGISTRY_OVERFLOW, so once register_builtin_units's 27 entries plus five new `unit NAME = BASE;` declarations reach the table's OLD 32-entry ceiling, a genuinely new product dimension (m * s, from QDeriv1 * QDeriv2) comes back UNBRANDED -- checker_brand_with_dim's -1 path, the same one dimensionless quantities take. The pre-patch compiler then accepted adding that value to a bare 1.0 as if it were dimensionless, when it is m*s and must be rejected exactly like any other unit mismatch.

unit QDeriv1 = m;
unit QDeriv2 = s;
unit QDeriv3 = K;
unit QDeriv4 = mol;
unit QDeriv5 = m;

fn main() with IO, Mut, Div, Panic {
    let a: QDeriv1 = 2.0
    let b: QDeriv2 = 3.0
    let prod = a * b
    let bad = prod + 1.0
    println("must not compile: prod is m*s, not dimensionless")
}
