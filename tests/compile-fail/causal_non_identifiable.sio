//@ compile-fail
//@ error-pattern: E067
//@ description: causal query is non-identifiable due to unblocked confounding path

// This query fails because X and Y share a hidden common cause (X <-> Y bidirected arc),
// making P(Y|do(X)) non-identifiable from observational data alone.
// E067: non_identifiable_query

fn confounded_ate(treated: f64, control: f64) -> f64 with IO {
    // If X <-> Y (confounding), ATE is not identifiable without RCT
    treated + (0.0 - control)
}

fn main() -> i64 with IO {
    42
}
