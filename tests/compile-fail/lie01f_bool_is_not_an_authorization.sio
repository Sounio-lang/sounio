//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E009]
//@ error-pattern: expected SafeAuthorization
//@ error-pattern: found bool
//@ description: lie corpus 1c - a yes/no flag read off a receipt is not an authorization to act

use llm::epistemic_clinical_pbpk::*
use epistemic::sound_enclosure::*

fn dispense(a: SafeAuthorization) -> f64 { sa_window_lo(a) }

fn main() with Mut, Div, Panic {
    let p = clinical_pbpk_default_params()
    let priors = ClinicalEpistemicPriors { cl_var: 1.0, kp_var: 0.0001, fu_var: 0.000025, rho_cl_fu: 0.0 }
    let r = clinical_pbpk_evaluate_gate(&p, &priors, 5.0, 0.05, 0.0, 0.1, 0.05, 3.0, 5.0)
    // The bool says "authorized"; it is a report, not an authorization to act.
    let w = dispense(epr_authorized(r))
}
