//@ compile-fail
//@ requires: madaros
//@ description: KL-20 -- an arm with a guard or a refutable payload sub-pattern does not cover its variant, so this match is E280
//@ error-pattern: error[E280]

enum Shape { Circle(i64), Empty }

fn f(s: Shape) -> i64 {
    match s {
        Shape::Circle(r) if r > 0 => r,
        Shape::Circle(0) => 0,
        Shape::Empty => 0,
    }
}

fn main() -> i64 { f(Shape::Empty) }
