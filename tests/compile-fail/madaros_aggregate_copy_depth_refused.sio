//@ compile-fail
//@ requires: madaros
//@ error-pattern: by-value copy of `L0` in function `main` cannot be made complete
//@ error-pattern: structs nest more than 3 levels deep
//@ error-pattern: in field `L2.l3`
//@ description: a by-value copy nesting past the deep-copy depth limit is refused with the blocking field path, not silently aliased
//
// Madaros from the #2700 head compiled this and printed b=9: the innermost
// array stayed shared between `a` and `b`. Refusing is the fail-closed answer
// until the depth limit is lifted; the diagnostic names the type, the function
// and the field chain so the copy site can be found without a source span.

struct L3 { v: [i64; 2] }
struct L2 { l3: L3 }
struct L1 { l2: L2 }
struct L0 { l1: L1 }

fn main() -> i32 with IO, Mut {
    var a = L0 { l1: L1 { l2: L2 { l3: L3 { v: [1, 1] } } } }
    var b = a
    a.l1.l2.l3.v[0] = 9
    println(b.l1.l2.l3.v[0])
    0
}
