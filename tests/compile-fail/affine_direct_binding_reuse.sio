//@ compile-fail
//@ error-pattern: affine value has already been used

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 {
    let permit = Permit { id: 11 }
    let moved = permit
    let invalid = spend(permit)
    (moved.id + invalid) as i32
}
