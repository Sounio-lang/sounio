//@ compile-fail
//@ error-pattern: confidence gate violation
// Confidence gate: low-confidence measurement REJECTED by the gate.
// measure(10.0, uncertainty: 5.0) → relative uncertainty = 5.0/10 = 0.5
// confidence = 1.0 - 0.5 = 0.5 (500/1000) → FAILS minconf: 0.95 (950/1000)

fn safe_dosing(weight: f64, clearance: f64) -> f64 with Mut, Epistemic(950) {
    return weight * clearance
}

fn main() with IO, Mut, Epistemic {
    let kw: Knowledge<f64> = measure(10.0, uncertainty: 5.0)
    let kc: Knowledge<f64> = measure(5.0, uncertainty: 0.1)
    let w = kw.value
    let c = kc.value
    let dose = safe_dosing(w, c)
    print("dose="); println(dose)
}
