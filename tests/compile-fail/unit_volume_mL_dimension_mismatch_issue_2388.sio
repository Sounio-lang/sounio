//@ compile-fail
//@ requires: madaros
//@ error-pattern: E041
//@ error-pattern: left unit: length^3
//@ description: #2388 — `mL` is a volume: adding it to a mass is refused (the new units are dimensioned, not opaque f64 aliases)

fn main() -> i32 with IO, Mut, Panic, Div {
    let volume: mL = 250.0
    let dose: mg = 500.0
    let bad = volume + dose
    print_f64(bad); print("\n")
    return 0
}
