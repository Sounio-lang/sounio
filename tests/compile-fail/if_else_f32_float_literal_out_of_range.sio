//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: E007
//@ description: #830 guard — the f32 join only adopts literals that fit f32; 1e300 must still be refused

fn bad(x: f32, flag: bool) -> f32 {
    if flag { x } else { 1e300 }
}

fn main() -> i64 with IO {
    let a: f32 = 2.5
    println(bad(a, false) as f64)
    0
}
