//@ compile-fail
//@ error-pattern: Type mismatch
// Verify that turbofish instantiation enforces concrete argument types.
//
// When identity::<bool>(42) is called, the checker substitutes T=bool,
// making the parameter type bool. But 42 is i32, causing a type mismatch.

fn identity<T>(x: T) -> T {
    x
}

fn main() {
    // T is instantiated to bool, but 42 is i32 — mismatch
    let y: bool = identity::<bool>(42)
}
