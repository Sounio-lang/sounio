//@ compile-fail
//@ error-pattern: cannot prove ontology subsumption
ontology D8NegativeOuterOverlap {
    class Artifact
    class OuterOnlyOverlapUndecided subclass_of Artifact
    class RealIdentifiedSetOverlap subclass_of Artifact
}
fn require(v: RealIdentifiedSetOverlap) -> i32 { 0 }
fn reject(v: OuterOnlyOverlapUndecided) -> i32 { require(v) }
