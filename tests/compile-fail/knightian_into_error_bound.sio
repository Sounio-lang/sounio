//@ compile-fail
//@ requires: madaros
//@ error-pattern: Knightian uncertainty (ε=⊥) cannot satisfy required confidence
// Knightian ignorance has no distribution, so it states no error bound either:
// a `ε=⊥` value passed where `ε < 0.5` is required is refused, like the
// confidence-floor case in knightian_mixed.

fn bounded(k: Knowledge[f64, ε < 0.5]) -> f64 with Epistemic {
    k.value
}

fn main() -> i64 with IO, Epistemic {
    let unknown: Knowledge[f64, ε=⊥] = Knowledge { value: 0.7 }
    println(bounded(unknown))
    0
}
