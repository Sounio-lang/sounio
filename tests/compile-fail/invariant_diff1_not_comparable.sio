//@ check-only
//@ requires: madaros
// Madaros-only checker feature; the lean_single bootstrap suite skips it (Madaros-official migration).
//@ compile-fail
//@ error-pattern: cannot be combined
// Feature B (Invariant<T,G>): two Lyapunov-based depths (Group::Diff1) related only
// by the conservative Homeo-default frame relation are NOT comparable — a type error,
// because a mere topological (Homeo) relation does not lie in Diff1.
fn lyapunov_depth_ratio(a: Invariant<f64, Diff1>, b: Invariant<f64, Diff1>) -> bool {
    a == b
}
