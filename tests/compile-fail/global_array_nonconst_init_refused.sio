//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E309]
//@ description: a module-level array whose initializer calls a fn is refused (E309), not zero-filled
// The call cannot be folded at compile time, and running it before `main` from
// outside its module could bind another module's `impure`. Madaros used to drop
// the whole initializer and the array read `0 0 0` with exit 0; lean_single
// runs it and prints `10 20 30`. Neither engine may silently pick zero.
fn impure() -> i64 with IO {
    10
}

var A: [i64; 3] = [impure(), 20, 30]

fn main() -> i64 with IO {
    print_int(A[0])
    print("\n")
    0
}
