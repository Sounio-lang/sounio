//@ compile-fail
//@ error-pattern: unit mismatch in call argument
// A call result must carry the unit of its RETURN type, not of its last
// argument. plain returns a bare f64, so its result cannot satisfy a molal
// parameter -- but the brand of the argument m used to outlive the call and
// stand in for it.

unit molal = mol / kg;

fn plain(x: molal) -> f64 with Mut {
    1.0
}

fn takes_molal(y: molal) -> f64 with Mut {
    2.0
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let m: molal = 2.0
    let r = takes_molal(plain(m))
    return 0
}
