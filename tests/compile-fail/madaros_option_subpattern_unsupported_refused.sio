//@ compile-fail
//@ requires: madaros
//@ description: #2787 a Some(..) sub-pattern Madaros cannot test is refused instead of matching every Some value
//@ error-pattern: cannot lower the pattern inside `Some(..)`

// Before #2787 every sub-pattern of Some other than a binding was ignored, so
// `Some((0, y)) =>` matched every Some. Literal, bool, None, nested Some and
// unit enum sub-patterns are tested now (tests/run-pass/option_payload_kinds_2787.sio);
// a tuple pattern is not, and lowering refuses it.

fn f(a: Option<(i64, i64)>) -> i64 {
    match a {
        Some((0, y)) => y,
        Some(_) => 1,
        None => 2,
    }
}

fn main() -> i32 with IO {
    println(f(Some((5, 6))))
    0
}
