//@ compile-fail
//@ requires: madaros
//@ error-pattern: GUM_UNTRACKED_CONTAINER
// #3546: a genuine Knowledge parameter still taints an unsupported index store.

fn project(k: Knowledge<f64>, index: i64) -> f64 with Mut, Div, Panic, Epistemic {
    var arr: [f64; 4] = [0.0; 4]
    arr[index] = k.value
    variance_of(arr[0])
}
fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    let k: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    print_f64(project(k, 0))
    return 0
}
