//@ compile-fail
//@ error-pattern: refinement type violation
//@ description: PR-5 — return of let-bound literal propagated through immutable var

type Pos = { v: i32 | v > 0 }

fn make_pos() -> Pos {
    let bad = -7
    return bad  // ERROR: -7 propagated through let, violates v > 0
}

fn main() {
    let _ = make_pos()
