//@ compile-fail
//@ requires: lean_single
//@ error-pattern: f128 struct fields are not implemented
// #2387: struct layout has one word per scalar field; an f128 field would drop its high limb.
struct P {
    v: f128,
}

fn main() with IO {
    let x: f128 = 1.5
    let p = P { v: x }
    println(p.v as f64)
}
