//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E232

// The same array local may not initialise two fields of one struct literal.
//
// `Trajectory { speakers: zi, hashes: zi, ... }` reads as "both start zeroed"
// and is exactly that under lean_single. Under Madaros the value copy is
// shallow, so the two fields are ONE array: traj_push's five writes landed in
// the same place, only the last survived, and every read of speakers returned
// the dim. The test that would have caught it printed FAIL and exited 0 for
// months (#2150, #2152).
//
// The engines disagree about whether a struct literal copies an array field by
// value. lean_single -- the fixed point the shipped compiler is built from --
// already answers that: deep. Until Madaros agrees, neither reading may be
// depended on, so the ambiguous form is refused instead of being resolved
// silently in one direction on one engine.

struct Pair {
    u: [i64; 4],
    v: [i64; 4],
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let z: [i64; 4] = [0; 4]
    let p = Pair { u: z, v: z }
    print_int(p.u[0])
    0
}
