//@ compile-fail
//@ error-pattern: affine value used more than once

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn observe(n: &i64) -> i64 {
    *n
}

fn main() -> i32 {
    let permit = Permit { id: 4 }
    let seen = observe(&(spend(permit)))
    let again = spend(permit)
    (seen + again) as i32
}
