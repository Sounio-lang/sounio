//@ compile-fail
//@ requires: madaros
//@ error-pattern: linear value not consumed

use net::socket::*

fn main() -> i64 with IO {
    // Raw IPv4 octets (per Finding 10 of the TLS-prereq audit doc), not
    // ASCII dotted-decimal text -- tcp_connect/build_sockaddr consume `ip`
    // as 4 raw octet bytes directly, never as parsed text.
    let ip = rawbuf_new(16)
    rawbuf_set(&ip, 0, 127)
    rawbuf_set(&ip, 1, 0)
    rawbuf_set(&ip, 2, 0)
    rawbuf_set(&ip, 3, 1)
    let (sock, err) = tcp_connect(&ip, 18091)
    // sock is never passed to tcp_send/tcp_recv/tcp_close -- must be a compile error
    return 0
}
