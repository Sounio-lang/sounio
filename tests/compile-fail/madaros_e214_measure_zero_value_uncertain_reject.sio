//@ compile-fail
//@ requires: madaros
//@ error-pattern: args confidence 1 < minconf 900
// measure(0.0, uncertainty: 0.5): the relative uncertainty u/|v| is unbounded,
// so the reading is worthless as a confidence, like u >= |v|. It used to keep
// the 990 default and clear an Epistemic(900) gate.

fn gated(x: f64) -> f64 with Epistemic(900) {
    return x
}

fn main() with IO, Mut, Epistemic {
    let k: Knowledge<f64> = measure(0.0, uncertainty: 0.5)
    println(gated(k.value))
}
