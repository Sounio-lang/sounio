//@ compile-fail
//@ ignore BLOCKED: pinned binary does not enforce linear/ownership checking
//@ error-pattern: not consumed
//@ description: Linear value cannot be implicitly dropped

linear struct Resource {
    data: i32,
}

fn process() -> i32 {
    let r = Resource { data: 100 }
    // ERROR: r is linear and must be consumed, not dropped
    42
}

fn main() {
    let result = process()
}
