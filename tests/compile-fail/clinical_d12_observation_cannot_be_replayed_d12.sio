//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: error[E039
// Replay: the same monitoring observation consumed twice. A stale observation
// must not be re-presentable to renew authority a second time.
// (Shippable since the spurious-E039 defect on single use was fixed; before
// that, this test would have passed for the wrong reason.)
use epistemic::proof_carrying_linear_target_monitor::*
fn reject() -> i64 with Panic, Div {
    let obs = certify_d12_monitor_observation(31204, 0)
    let first = d12_account_renew(obs)
    let second = d12_account_renew(obs)
    d12_outcome_id(first) + d12_outcome_id(second)
}
