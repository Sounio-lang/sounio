//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: linear value has already been used
//@ description: Creating a closure transfers each captured linear value into that closure

linear struct Permit {
    level: i32,
}

fn consume(p: Permit) -> i32 {
    p.level
}

fn main() -> i32 {
    let permit = Permit { level: 5 }
    let captured = || consume(permit)
    let invalid = consume(permit)
    captured() + invalid
}
