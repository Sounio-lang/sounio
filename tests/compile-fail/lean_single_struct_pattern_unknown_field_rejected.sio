// lean_single_struct_pattern_unknown_field_rejected
//@ compile-fail
//@ requires: lean_single
//@ error-pattern: E265
//@ description: an unknown field in a struct pattern is an error, not a warning
//
// lean_single used to print only `warning: unknown struct field in pattern`
// and carry on. Here the misspelt `frist` was skipped, so the outer `frist`
// (3) was read instead of the field (7): measured on the pre-E265 seed, the
// program compiled cleanly and printed 14. It is now refused with E265.
//
// `requires: lean_single`: Madaros reports unknown pattern fields under its
// own diagnostic code.

struct QubitPair { first: i64, second: i64 }

fn main() -> i32 with IO, Panic {
    let pair = QubitPair { first: 7, second: 11 }
    let frist: i64 = 3
    let QubitPair { frist, second } = pair
    print_int(frist + second)
    0
}
