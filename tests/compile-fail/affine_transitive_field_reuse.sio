//@ compile-fail
//@ requires: madaros
//@ error-pattern: affine value has already been used

affine struct Permit {
    id: i64,
}

struct Envelope {
    permit: Permit,
}

fn open(envelope: Envelope) -> i64 {
    envelope.permit.id
}

fn main() -> i32 {
    let envelope = Envelope { permit: Permit { id: 37 } }
    let first = open(envelope)
    let second = open(envelope)
    (first + second) as i32
}
