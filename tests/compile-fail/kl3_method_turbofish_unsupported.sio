//@ compile-fail
//@ error-pattern: generic method specialization requires one unambiguous explicit turbofish
//@ requires: madaros

struct Selector {
    tag: i64,
}

impl Selector {
    fn pick<T>(self: &Selector, a: T, b: T) -> T {
        a
    }
}

fn main() -> i64 {
    let s = Selector { tag: 0 }
    s.pick(7, 9)
}
