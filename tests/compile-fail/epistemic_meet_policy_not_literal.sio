//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E305]
//@ description: The E_n limit of meet is a declared modelling choice (ADR-016, decision 3.3), so it must be a positive numeric literal; a value computed at run time is refused at compile time.
fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    let k0 = measure(1.0, uncertainty: 0.1)
    let k1 = measure(1.3, uncertainty: 0.1)
    let a = k0.value
    let b = k1.value
    let lim = 1.0 + a * 0.0
    let m = meet(a, b, consistency: lim)
    print_f64(m)
    0
}
