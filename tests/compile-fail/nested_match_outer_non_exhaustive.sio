//@ compile-fail
//@ error-pattern: match must be exhaustive
// A nested match must not replace the outer match's scrutinee identity.

enum Outer {
    First,
    Second,
    Third,
}

enum Inner {
    Left,
    Right,
}

fn classify(outer: Outer, inner: Inner) -> i64 {
    match outer {
        Outer::First => {
            match inner {
                Inner::Left => 1,
                Inner::Right => 2,
            }
        }
        Outer::Second => 3,
    }
}

fn main() -> i64 {
    classify(Outer::First, Inner::Left)
}
