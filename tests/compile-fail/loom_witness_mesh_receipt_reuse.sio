use coordination::loom_witness_mesh::{
    LoomWitnessMeshHostTrust,
    admit_witness_mesh_digest256,
    admit_verified_witness_share,
    combine_verified_witness_shares,
    consume_verified_witness_mesh_checkpoint,
    close_host_witness_mesh_receipt,
}

fn reuse_share() -> i64 with LoomWitnessMeshHostTrust, Panic {
    let digest = admit_witness_mesh_digest256(1, 2, 3, 4, 5, 6, 7, 8)
    let first = admit_verified_witness_share(101, 401, 1, 3, digest)
    let second = admit_verified_witness_share(201, 401, 1, 3, digest)
    let third = admit_verified_witness_share(301, 401, 1, 3, digest)
    let checkpoint = combine_verified_witness_shares(first, second)
    let receipt = consume_verified_witness_mesh_checkpoint(checkpoint)
    let closed = close_host_witness_mesh_receipt(receipt)
    let reused = combine_verified_witness_shares(first, third)
    let second_receipt = consume_verified_witness_mesh_checkpoint(reused)
    closed + close_host_witness_mesh_receipt(second_receipt)
}

fn main() -> i64 { 0 }
