//@ compile-fail
//@ error-pattern: private
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set}
use physics::phonon_factor::{phonon_from_factor,phonon_default_si_params,phonon_close}
fn main() with Alloc,Mut,Div,Panic {
 var values=numeric_buffer_new(1,8);numeric_buffer_set(&!values,0,1.0)
 let factor=numeric_buffer_new(0,0)
 var state=phonon_from_factor(values,factor,phonon_default_si_params(),0,0.0)
 // This would invalidate state/factor consistency if the mutable owner escaped.
 numeric_buffer_set(&!state.values,0,-1.0)
 phonon_close(state)
}
