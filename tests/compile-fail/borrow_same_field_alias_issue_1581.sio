//@ compile-fail
//@ description: #1581 — `&s.y` with `&!s.y` in one call aliases the same field and is refused on both engines
//@ error-pattern: borrow

struct St { y: [f64; 4] }

fn sub(a: &[f64; 4], out: &![f64; 4]) with Mut {
    (*out)[0] = (*a)[1] * 2.0
}

fn main() -> i32 with IO, Mut {
    var s = St { y: [1.0, 2.0, 3.0, 4.0] }
    sub(&s.y, &!s.y)
    println(s.y[0])
    0
}
