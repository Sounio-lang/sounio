//@ compile-fail
//@ requires: madaros
//@ error-pattern: E042
//
// An impl METHOD's implicit tail return carries the same obligation as a free
// function's. checker_check_impl_method_inplace is a third, separate call site
// from checker_check_fn_item_inplace and checker_check_return_expr_inplace, so
// it needs its own pin: without one, `impl` is a fourth spelling of the same
// laundering hole.
//
// Inline refinement, not a `type` alias -- see refinement_holds_at_return.sio.

struct Meter {
    raw: i64,
}

impl Meter {
    fn launder(self) -> { n: i64 | n >= 0 && n < 1000000007 } {
        2000000000
    }
}

fn main() -> i64 with IO {
    println("unreachable")
    0
}
