//@ compile-fail
//@ ignore
//@ description: SELFHOST_PASS
//@ error-pattern: linear
//@ description: SELFHOST_PASS

linear struct Mutex {
    locked: i32,
}

fn use_mutex(m: Mutex) -> i32 {
    m.locked
}

fn main() {
    let mutex = Mutex { locked: 1 }
    // Closure captures linear value - should be an error
    let f = || use_mutex(mutex)
    // f could be called multiple times
}
