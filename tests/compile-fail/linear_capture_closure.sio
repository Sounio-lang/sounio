//@ typecheck-fail
//@ requires: madaros
//@ error-pattern: linear value not consumed
//@ description: A closure that captures a linear value must itself be consumed

linear struct Mutex {
    locked: i32,
}

fn use_mutex(m: Mutex) -> i32 {
    m.locked
}

fn main() {
    let mutex = Mutex { locked: 1 }
    // The capture makes f linear, so leaving f unused is an error.
    let f = || use_mutex(mutex)
}
