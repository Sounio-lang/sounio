//@ typecheck-fail
//@ error-pattern: linear value

// Linear value consumed in only one branch of if/else is an error.
// Both branches must consume the value for the consumption to be sound.

linear struct Token { id: i64 }

fn consume(t: Token) -> i64 { t.id }

fn main() with IO, Panic {
    let t = Token { id: 1 }
    if 1 > 0 {
        consume(t)
    } else {
        // t not consumed here — asymmetry!
        0
    }
}
