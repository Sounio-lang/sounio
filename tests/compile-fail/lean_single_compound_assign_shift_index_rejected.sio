// lean_single_compound_assign_shift_index_rejected
//@ compile-fail
//@ requires: lean_single
//@ error-pattern: compound assignment `<<=` is not supported by lean_single
//@ description: E260 covers the three-byte shift forms and non-identifier targets
//
// Companion to lean_single_compound_assign_rejected.sio. The refusal lives in
// the lexer, so it does not depend on which compile_stmt arm the left-hand
// side would have reached (identifier, array element, field). `<<=` exercises
// the three-byte path, which must be checked before `<<` is consumed.

fn main() with IO {
    var a: [i64; 2] = [1, 2]
    a[0] <<= 3
    println(a[0])
}
