//@ compile-fail
//@ requires: madaros
//@ error-pattern: E039
//@ description: the destructure consumes the source; a later use of it is still E039 (#2766 negative control)

linear struct Qubit { a: f64, b: f64 }

fn twice(q: Qubit) -> f64 {
    let Qubit { a, b } = q
    let again = q
    a + b
}

fn main() -> i32 with IO {
    println(twice(Qubit { a: 0.5, b: 0.5 }))
    0
}
