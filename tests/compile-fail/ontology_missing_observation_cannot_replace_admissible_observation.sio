//@ compile-fail
//@ error-pattern: argument type does not match parameter

ontology ProofCarryingInferenceNegativeMissing {
    class EpistemicArtifact
    class EvidenceArtifact subclass_of EpistemicArtifact
    class Observation subclass_of EvidenceArtifact
    class AdmissibleObservation subclass_of Observation
    class MissingObservation subclass_of Observation
}

fn requires_admissible(o: AdmissibleObservation) -> i32 { 0 }
fn reject_missing(o: MissingObservation) -> i32 {
    requires_admissible(o)
}
