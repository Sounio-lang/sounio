//@ compile-fail
//@ error-pattern: EpistemicComplete violation
//@ description: PBPK28 over-claim — a rapamycin dosing function demanding 95% confidence
//@ (with Epistemic(950)) built from a 65%-confidence hepatic-clearance prior is REJECTED at
//@ compile time. The honest counterpart compiles: run-pass/dissertation_pbpk28_confidence_gate.sio.
//
// Dissertation Contribution 2: the type system prevents over-confident dosing.
// cl_hepatic carries ε=0.65 (Jiao/Zhang 2009 pop-PK, CV≈38%). Declaring the dosing
// function `with Epistemic(950)` asserts the result is ≥95% confident — but it is
// built from a 65%-confidence input. The EpistemicComplete gate rejects the
// compile (conf=650 < 950), so no binary is emitted. You cannot manufacture
// confidence the evidence does not support.

fn rapa_overclaimed_dose() -> f64 with Epistemic(950), Mut, Div, Panic {
    let cl_hepatic: Knowledge[f64] = Knowledge(12.4, ε=0.65, prov="Jiao2009_popPK_CV38");
    cl_hepatic.value
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    println(rapa_overclaimed_dose());
}
