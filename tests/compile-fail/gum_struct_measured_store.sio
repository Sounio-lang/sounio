//@ compile-fail
//@ requires: madaros
//@ error-pattern: GUM_UNTRACKED_CONTAINER
// #3546: refuse unsupported measured container provenance instead of zero.

struct Cell { x: f64 }
fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    var cell = Cell { x: 0.0 }
    let ka: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    cell.x = ka.value
    let y = cell.x * 2.0
    print_f64(variance_of(y))
    return 0
}
