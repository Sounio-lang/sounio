//@ compile-fail
// The deferred value, evidence, and deferral policy must agree on the same underlying T.

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}
deferral_policy ReviewPolicy for i64 route review {
    require relative_band >= 0.20
}
audit ReviewAudit for Contest<i64, DefaultModels, DefaultPolicy> {
    metrics {
        relative_band: 0.25
    }
}

fn main() {
    let d = 1
    let c: Contest<i64, DefaultModels, DefaultPolicy> = (contest [M1] on d) audit ReviewAudit
    let x: Deferred<i64> = defer_action(true, c, ReviewPolicy)
}
