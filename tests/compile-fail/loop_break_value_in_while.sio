//@ compile-fail
//@ requires: madaros
//@ error-pattern: E302
//@ description: `break v` inside `while`: only `loop` is an expression a break can give a value to. Refused (E302); the value used to be lowered and dropped.

fn main() with IO {
    var i: i64 = 0
    while i < 3 {
        i = i + 1
        break 1
    }
}
