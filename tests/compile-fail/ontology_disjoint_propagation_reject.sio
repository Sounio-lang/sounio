//@ compile-fail
//@ error-pattern: ontology classes are disjoint

// Test: disjointness propagates down subclass hierarchy.
// If Drug || Food and ExperimentalDrug ⊂ Drug,
// then ExperimentalDrug || Food should also hold.

ontology Pharma {
    class Entity
    class Drug subclass_of Entity
    class Food subclass_of Entity
    class ExperimentalDrug subclass_of Drug
    disjoint Drug, Food
}

fn ingest(f: Food) -> i32 { 0 }

fn test(x: ExperimentalDrug) -> i32 {
    ingest(x)
}

fn main() -> i32 {
    0
}
