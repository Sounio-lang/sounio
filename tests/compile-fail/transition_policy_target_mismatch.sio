//@ compile-fail
//@ ignore
//@ error-pattern: transition policy target does not match the supplied alternative type
//@ error-pattern: expects f64, found i64

transition_policy FloatStepdown for f64 route outpatient_review {
    max_steps 2
}

transition_protocol Reduce10Now for AlternativeOption<i64> under FloatStepdown {
    step baseline { value: 50 }
    step reduce_once { value: 45 }
}

fn main() -> i64 {
    0
}
