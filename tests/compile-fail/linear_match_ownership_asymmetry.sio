//@ compile-fail
//@ error-pattern: linear value consumed in some match arms but not all match arms

linear struct Token {
    id: i64,
}

fn spend(token: Token) -> i64 {
    token.id
}

fn main() -> i32 {
    let token = Token { id: 47 }
    let selector = 0
    let result = match selector {
        0 => spend(token)
        _ => 0
    }
    result as i32
}
