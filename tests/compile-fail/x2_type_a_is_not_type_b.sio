//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E313]
//@ description: X2 residual scatter is not declared measurement uncertainty - Type A cannot satisfy a Type B requirement
// PREDICTION (written before compiling): the checker refuses this with
// E313 because the Knowledge produced by residual_knowledge carries
// GUM Type A provenance on its standard uncertainty (estimated from
// residual scatter, like scipy curve_fit absolute_sigma=False
// rescaling), while requires_type_b requires declared (Type B)
// uncertainty for propagation. The function must not silently treat
// residual scatter as a declared sigma.

fn requires_type_b(k: Knowledge<f64>) -> f64 with Epistemic {
    k.value
}

fn main() -> i64 with IO, Epistemic {
    let fit = residual_knowledge(2.0, uncertainty: 0.1)
    let value = requires_type_b(fit)
    if value > 0.0 { println("unreachable") }
    return 0
}
