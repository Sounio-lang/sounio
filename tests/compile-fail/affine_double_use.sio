//@ compile-fail
//@ description: SELFHOST_PASS
//@ error-pattern: affine value used more than once
//@ description: SELFHOST_PASS

affine struct UniqueId {
    id: i32,
}

fn use_id(u: UniqueId) -> i32 {
    u.id
}

fn main() {
    let uid = UniqueId { id: 42 }
    let a = use_id(uid)
    let b = use_id(uid)  // ERROR: affine value already used
}
