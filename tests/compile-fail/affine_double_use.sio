//@ compile-fail
//@ ignore
//@ error-pattern: affine
//@ description: Affine value cannot be used more than once (affine checking not implemented)

affine struct UniqueId {
    id: i32,
}

fn use_id(u: UniqueId) -> i32 {
    u.id
}

fn main() {
    let uid = UniqueId { id: 42 }
    let a = use_id(uid)
    let b = use_id(uid)  // ERROR: affine value already used
}
