//@ compile-fail
//@ error-pattern: E170
// Static unwrap-safety witness for the epistemic unit-distance study: extracting
// Knowledge<f64>.value WITHOUT `with Epistemic` is a COMPILE error (E170). This is the
// one static guarantee erdos90_epistemic.sio relies on. (Remove `with Epistemic` from
// dist2_gum and you get exactly this error.)
module research::erdos90_unwrap_unsafe

fn dist2_unsafe(ax: Knowledge<f64>, bx: Knowledge<f64>) -> f64 with Mut {
    let dx = ax.value - bx.value   // E170: .value requires `with Epistemic`
    return dx * dx
}

fn main() -> i32 with IO, Mut, Epistemic {
    let a: Knowledge<f64> = measure(2.0, uncertainty: 0.01)
    let b: Knowledge<f64> = measure(3.0, uncertainty: 0.01)
    let d = dist2_unsafe(a, b)
    print("unreachable\n")
    return 0
}
