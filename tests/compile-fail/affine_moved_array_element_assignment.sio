//@ compile-fail
//@ requires: madaros
//@ error-pattern: affine value has already been used

affine struct Permit {
    id: i64,
}

fn take(values: [Permit; 1]) -> i64 {
    values[0].id
}

fn main() -> i32 with Mut {
    var values = [Permit { id: 151 }]
    let spent = take(values)
    values[0] = Permit { id: 157 }
    spent as i32
}
