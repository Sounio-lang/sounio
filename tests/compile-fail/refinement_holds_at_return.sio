//@ compile-fail
//@ requires: madaros
//@ error-pattern: E042
//
// A refinement must hold at the RETURN, not only at a binding.
//
// Measured 2026-08-21: checker_check_refinement_literal_inplace had exactly two
// callers, both in the let/var handlers, and check/compat.sio has zero
// references to refinement_id. So a refinement was enforced where a value is
// bound and NOWHERE else, and this file compiled clean.
//
// That made every refinement escapable in three words -- wrap the value in a
// function whose return type is the refined one and the predicate is gone:
//
//     fn lift(x: i64) -> Fp { x }
//
// A refinement you can launder is not a refinement. It also blocks modular
// arithmetic as a refinement type, where the reduction is exactly what a
// function returns.

type Fp = { n: i64 | n >= 0 && n < 1000000007 }

fn escape() -> Fp {
    return 2000000000
}

fn main() -> i64 with IO {
    println("unreachable")
    0
}
