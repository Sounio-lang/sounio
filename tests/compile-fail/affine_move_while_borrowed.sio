//@ compile-fail
//@ requires: madaros
//@ error-pattern: cannot move affine value while borrowed

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 {
    let permit = Permit { id: 23 }
    let borrowed = &permit
    let invalid = spend(permit)
    (borrowed.id + invalid) as i32
}
