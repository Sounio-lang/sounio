//@ compile-fail
//@ error-pattern: error[E043]
//@ error-pattern: Sounio does not use Rust macros
//@ description: The path-qualified Rust macro shape is rejected too, not only the bare one

// E043 originally fired only on a BARE identifier followed by a tight bang-call,
// while its message said "Sounio does not use Rust macros". So `foo::bar!(..)`
// -- the shape Rust actually uses for anything namespaced -- fell through to
// E004 and the message was wider than the rule that produced it.
//
// Adjacency still decides. Measured on both engines:
//
//   math::pure::abs_i64!(x)   -> error[E043]
//   math::pure::abs_i64! (x)  -> check: OK      right boundary spaced
//   math::pure::abs_i64 (x)   -> check: OK      no bang at all
use math::pure::*

fn main() -> i64 with IO {
    print_int(math::pure::abs_i64!(0 - 42))
    0
}
