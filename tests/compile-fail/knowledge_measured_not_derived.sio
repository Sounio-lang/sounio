//@ compile-fail
//@ requires: madaros
//@ error-pattern: E036
//@ description: a measured pressure is not a derived one

ontology Lab {
    class Quantity { property amount: f64 where amount >= 0.0 }
    class Pressure subclass_of Quantity
}

fn onward(p: Knowledge[Pressure, ValidUntil("2026-12-31"), epsilon < 0.05, Derived]) -> f64 with Epistemic {
    p.value
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let tag: Pressure = 14.0
    let k: Knowledge<Pressure> = measure(tag, uncertainty: 0.6)
    let _x = onward(k)
    0
}
