//@ compile-fail
//@ error-pattern: error[module_struct_identity]
//@ error-pattern: NrRes
//@ description: #2773 -- two loaded modules defining one struct name with different fields are refused with a diagnostic naming both modules, instead of being merged into one type.
//
// testmod::nr_sa and testmod::nr_sb both define `pub struct NrRes`, with
// different fields. Struct names are not module-qualified in Madaros, so the
// checker and the lowering would treat them as ONE type: before #2773 nr_sb's
// correct literal was rejected with a misleading E012/E046 against nr_sa's
// layout (and with agreeing field names one layout would silently serve both).
// Both engines: lean_single has the same check (lmr_struct_identity).
use testmod::nr_sa::{nr_sa_res}
use testmod::nr_sb::{nr_sb_res}

fn main() -> i32 with IO {
    print_f64(nr_sa_res(1.5))
    println("")
    print_f64(nr_sb_res(2.25))
    println("")
    0
}
