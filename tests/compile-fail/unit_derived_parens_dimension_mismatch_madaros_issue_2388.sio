//@ compile-fail
//@ requires: madaros
//@ description: #2388 guard — `cal/(mol*K)` is a real dimension, not a dimensionless brand: cal/mol does not bind to it
//@ error-pattern: error[E001]

fn main() -> i32 with IO, Mut, Panic, Div {
    let e: cal = 1.987204
    let amount: mol = 1.0
    let r: cal/(mol*K) = e / amount
    print_f64(r); print("\n")
    return 0
}
