//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E306]
//@ description: retract is the only exit from a contest, and it is explicit: the reason must be written as `because: "..."` (ADR-016, decision 4.3).
fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    let k0 = measure(1.0, uncertainty: 0.1)
    let k1 = measure(1.3, uncertainty: 0.1)
    let a = k0.value
    let b = k1.value
    let c = contest(a, b)
    let r = retract(c, b)
    print_f64(meet(r))
    0
}
