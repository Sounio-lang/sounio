    DyadicNonReductionWitness {
        witness_id: 6201,
        collision_id: 5801,
        common_input_id: 5901,
        exact_separation: DyadicExactSeparationReceipt {
            separation_id: 6201,
            left_numerator: 400,
            left_denominator: 1000,
            right_numerator: 600,
            right_denominator: 1000,
            signed_cross_difference: -200000,
            cross_denominator: 1000000,
            exact_nonzero: true,
