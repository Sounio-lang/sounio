//@ compile-fail
//@ error-pattern: refinement
// Reinhart-Rogoff Failure 1: Unit Confusion
//
// GDP growth as a fraction must be in [0.0, 1.0] for the debt-ratio comparison.
// R-R's data stored growth in percentage-point form (e.g. 2.2 means 2.2%).
// If a function expects fraction form, passing 2.2 is a 100x scaling error.
//
// Sounio's refinement type catches this at compile time.

fn analyze_growth(g: { rate: f64 | rate >= 0.0 && rate <= 1.0 }) -> f64 {
    return g
}

fn main() {
    // This is what R-R did: percentage-point value (2.2) where fraction (0.022) was expected
    let result = analyze_growth(2.2)
}
