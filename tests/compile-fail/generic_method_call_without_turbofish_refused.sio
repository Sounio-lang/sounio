//@ compile-fail
//@ requires: madaros
//@ description: once the generic owner type is named outside its own impl, a turbofish-less call of its generic method can reach it, and the specializer still refuses rather than hand a free type variable to lowering
//@ error-pattern: generic method specialization requires one unambiguous explicit turbofish

struct Gen<T> { n: i64 }

impl Gen<T> {
    fn push(self: &!Gen<T>, v: T) with Mut {
        self.n = self.n + 1
    }
}

fn main() -> i32 with Mut {
    var g = Gen { n: 0 }
    g.push(5)
    0
}
