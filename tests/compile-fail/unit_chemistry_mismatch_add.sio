//@ compile-fail
//@ requires: madaros
//@ error-pattern: unit mismatch in arithmetic operation
//@ description: adding an amount concentration to an energy must fail

fn main() -> i32 with IO, Mut, Panic, Div {
    let c: mol_L = 0.1
    let e: kJ = 2.0
    let bad = c + e
    if bad == 2.1 {
        print("unreachable\n")
    }
    return 0
}
