//@ compile-fail
//@ error-pattern: undeclared
// An extern "C" declaration whose ffi_<name> intrinsic has no checker or
// registry entry must FAIL AT CHECK TIME (E137 at the wrapper's inner call)
// instead of compiling to a silent no-op that returns a fabricated 0 —
// the fail-closed half of the Track A dispatch
// (MADAROS_EXTERN_C_BUILTIN_PORT_DISPATCH_2026-08-16, Fase 3.4).

extern "C" {
    fn zzz_no_such_c_fn(x: i64) -> i64
}

fn main() -> i32 with IO, Panic {
    let v = zzz_no_such_c_fn(1)
    if v == 0 { return 1 }
    return 0
}
