//@ compile-fail
//@ requires: madaros
//@ error-pattern: call to an `extern "C"` function the native backend does not implement
// Calling an `extern "C"` name the backend cannot implement must FAIL AT CHECK
// TIME instead of compiling to a silent no-op returning a fabricated 0 — the
// fail-closed half of the Track A dispatch
// (MADAROS_EXTERN_C_BUILTIN_PORT_DISPATCH_2026-08-16, Fase 3.4).
//
// The diagnostic is E250, raised at the CALL by check/check.sio. It used to be
// E137 "use of undeclared variable" raised at the DECLARATION, because the
// parser gave every extern a body forwarding to an unbound ffi_<name>. That
// spelling of the refusal was fail-closed but wrong in its scope: it also
// refused declarations nobody calls, which is what a bindings module is made
// of. See tests/run-pass/ffi_declared_never_called_is_legal.sio for the other
// half of the pair — same name shape, no call, must compile.
//
// requires: madaros because E250 lives in check/check.sio and the suite's
// stage2 binary is built by lean_single, which rewrites externs into stubs and
// does not carry the constructor. Same guard, same reason, as the sibling
// fixture extern_c_unimplemented_builtin.sio.

extern "C" {
    fn zzz_no_such_c_fn(x: i64) -> i64
}

fn main() -> i32 with IO, Panic {
    let v = zzz_no_such_c_fn(1)
    if v == 0 { return 1 }
    return 0
}
