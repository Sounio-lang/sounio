//@ compile-fail
//
// Gradient Topology Types (GTT) — β⁹ week-10 compile-fail (loop never-entered channel).
//
// The loop snapshot+union is a conservative UPPER BOUND, not an exact set.
// A channel that was NEVER in the expression topology before OR inside the
// loop body is still absent after the loop.
//
// Here: r starts with channel 0 ({ch0}).  Inside the loop, r is reassigned
// to k1.value ({ch1}) but ONLY when a flag is true.  The loop topology
// union gives r: {ch0} | {ch1} = {ch0, ch1} — channel 1 IS in the set.
//
// However, channel 2 (from k2.value) is never assigned to r at all.
// hessian_of(r, 2, 2) must be refused.

fn main() with IO, Epistemic, Mut, Div {
    let k0: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k1: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let k2: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
    var r: f64 = k0.value    // r: {ch0}
    var i: i64 = 0
    while i < 1 {
        r = k1.value         // r: {ch1} (ch0 unioned in by snapshot)
        i = i + 1
    }
    // k2.value was never assigned to r — channel 2 absent from topology
    let h22 = hessian_of(r, 2, 2)  // ERROR: channel 2 not in {ch0, ch1}
    println(h22)
}
