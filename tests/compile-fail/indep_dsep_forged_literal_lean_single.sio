// indep_dsep_forged_literal_lean_single
//@ compile-fail
//@ requires: lean_single
//@ error-pattern: E257
//
// The lean_single variant of indep_dsep_forged_literal_madaros.sio -- see
// that file for the underlying defect this guards against: `indep_dsep(1)`
// used to be accepted identically to a discharged
// `indep_dsep(d_separated(A, B | Z))` witness.
//
// lean_single has no opaque-type mechanism to lean on: its type checker
// (scan_type / call_arg_type_compatible) treats `DsepProof` as an
// unregistered name and skips the argument check entirely, so the fix here
// is syntactic instead of type-level. dsep_lower() records the token
// position of every `d_separated(...)` call it rewrites AND verifies true;
// dsep_witness_gate() then requires indep_dsep's sole argument to be,
// token-for-token, one of those exact recorded positions. A bare literal
// fails that check regardless of its declared or inferred type -- E257.
//
// `requires: lean_single` because the diagnostic is a genuine engine
// difference -- see the madaros-only sibling file for that variant (E009,
// via a real opaque type there instead).

use epistemic::graded_effects::{graded_epistemic, graded_compose_indep, indep_dsep}

fn main() -> i64 with IO, Mut, Div, Panic {
    let a = graded_epistemic(10.0, 0.3)
    let b = graded_epistemic(4.0, 0.3)
    let forged = graded_compose_indep(a, b, indep_dsep(1))
    print("forged epsilon = ")
    println(forged.epsilon)
    0
}
