// Family output and policy target must agree with the Contest inner type.

type FloatModel = Model<i64, f64>
models FloatModels = [FloatModel]
policy FloatPolicy for f64 level Stable scope InDistribution {}

fn mismatched_contest() -> Contest<i64, FloatModels, FloatPolicy> {
    let datum: i64 = 1
    let contested: Contest<i64, FloatModels, FloatPolicy> = contest [FloatModel] on datum
    contested
}

fn main() -> i64 {
    let _ = mismatched_contest()
    0
}
