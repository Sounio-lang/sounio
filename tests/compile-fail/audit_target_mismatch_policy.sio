//@ compile-fail

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy PolicyA for i64 level Stable scope InDistribution {}
policy PolicyB for i64 level Stable scope InDistribution {}

audit PolicyAAudit for Contest<i64, DefaultModels, PolicyA> {
    metrics { sign_consensus: 1.0 }
}

fn main() -> i64 {
    let d: i64 = 42
    let c: Contest<i64, DefaultModels, PolicyA> = (contest [M1] on d) audit PolicyAAudit
    let r: Robust<i64, Stable, InDistribution> = prove_robust(c, PolicyB)
    0
}
