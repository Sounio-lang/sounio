//@ compile-fail
//@ error-pattern: cannot prove ontology subsumption

// Test: a superclass cannot be substituted where a subclass is expected.
// Drug ⊂ ChemicalEntity, but ChemicalEntity is NOT ⊂ Drug.

ontology Bio {
    class ChemicalEntity
    class Drug subclass_of ChemicalEntity
}

fn requires_drug(d: Drug) -> i32 { 0 }

fn test(c: ChemicalEntity) -> i32 {
    requires_drug(c)
}

fn main() -> i32 {
    0
}
