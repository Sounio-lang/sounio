//@ compile-fail
//@ ignore BLOCKED: pinned binary does not enforce linear move/use-after-move consistently
//@ error-pattern: linear

linear struct Token {
    value: i64,
}

fn consume(t: Token) -> i64 {
    t.value
}

fn main() -> i32 {
    let t = Token { value: 3 }
    let a = consume(t)
    let b = consume(t)
    if a + b >= 0 {
        return 0
    }
    0
}
