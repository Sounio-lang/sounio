//@ compile-fail
//@ description: SELFHOST_PASS
//@ error-pattern: linear value used more than once

linear struct Token {
    value: i64,
}

fn consume(t: Token) -> i64 {
    t.value
}

fn main() -> i32 {
    let t = Token { value: 3 }
    let a = consume(t)
    let b = consume(t)
    if a + b >= 0 {
        return 0
    }
    0
}
