//@ compile-fail
//@ error-pattern: cannot borrow as mutable
//@ error-pattern: also borrowed as shared
//@ description: Cannot have mutable and shared borrows simultaneously

struct Counter {
    count: i32,
}

fn main() {
    var c = Counter { count: 0 }
    let shared = &c       // shared borrow
    let mutable = &!c     // ERROR: cannot borrow mutably while shared borrow exists
    c.count = c.count + 1
}
