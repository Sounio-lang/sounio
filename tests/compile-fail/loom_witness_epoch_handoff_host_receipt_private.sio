use coordination::loom_witness_epoch_handoff::{
    HostWitnessEpochHandoffReceipt,
    admit_witness_epoch_digest256,
}

fn forge_epoch_handoff_receipt() -> i64 {
    let digest = admit_witness_epoch_digest256(1, 2, 3, 4, 5, 6, 7, 8)
    let forged = HostWitnessEpochHandoffReceipt {
        from_epoch: 1,
        to_epoch: 2,
        old_membership: digest,
        new_membership: digest,
        old_state_root: digest,
        new_state_root: digest,
        domain_token: 501,
        old_anchor_sequence: 7,
        new_anchor_sequence: 1,
        event_count: 12,
        journal_head: digest,
        old_certificate: digest,
        new_certificate: digest,
        previous_handoff: digest,
    }
    0
}

fn main() -> i64 { 0 }
