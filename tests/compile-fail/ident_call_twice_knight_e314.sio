//@ compile-fail
//@ requires: madaros
//@ error-pattern: error[E314]
//
// Prediction (source identity across calls, Knightian E314):
// `twice(a) + twice(b)` over Knightian sources propagates `knight_set_id = {"a", "b"}`.
// Passing the result to a precise bound (`ε < 0.5`) must fail with E314.

fn twice(x: Knowledge<f64>) -> Knowledge<f64> {
    x * 2.0
}

fn precise(x: Knowledge[f64, ε < 0.5]) -> f64 with Epistemic {
    x.value
}

fn main() -> i64 with IO, Epistemic {
    let a = knight("a", 0.0, 1.0)
    let b = knight("b", 0.0, 2.0)
    let s = twice(a) + twice(b)
    println(precise(s))
    0
}
