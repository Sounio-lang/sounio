//@ description: Frame size calculation for nested arrays should compute exact size
//@ expect: pass
//@ tags: checker,frame-size,regression

// Test exact frame size calculation for nested arrays.
// This is a simplified model of HlirFunction/HlirBlock/HlirInstr.

// Instr: 60 bytes (approximation)
struct Instr {
    data: [i64; 7],    // 56 bytes
    extra: i32         // 4 bytes
}                      // Total: 60 bytes

// Block: 16384 × 60 = 983,040 bytes (~960 KB)
struct Block {
    instrs: [Instr; 16384]
}

// DeepNested: 4096 × 960 KB = 3,932,160,000 bytes (~3.66 GB)
struct DeepNested {
    blocks: [Block; 4096]
}

fn by_value(s: DeepNested) -> DeepNested {
    s
}

fn main() with IO {
    println("Frame size calculation test for nested arrays")
}

// Expected warning: ~3,932,160,000 bytes (3.66 GB), NOT TB-range
