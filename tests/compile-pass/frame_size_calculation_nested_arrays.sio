//@ description: Frame size calculation for deeply nested arrays should cap at 16 GiB
//@ expect: pass
//@ tags: checker,frame-size,regression

// Regression test for bug where nested arrays caused ~1000× overflow
// in frame size calculation (showing TB instead of GB).

struct DeepNested {
    blocks: [Block; 4096]
}

struct Block {
    instrs: [Instr; 16384]
}

struct Instr {
    data: i64,
    extra: i64
}

// This struct is ~4 GB by correct calculation:
// - Instr: 16 bytes
// - Block: 16384 × 16 = 262,144 bytes
// - DeepNested: 4096 × 262,144 = 1,073,741,824 bytes (1 GB)
//
// Bug was showing ~4 TB (1000× larger).
// With cap at 16 GiB, warning should show at most 16 GiB, not TB.

fn by_value(s: DeepNested) -> DeepNested {
    s
}

fn main() with IO {
    println("Frame size calculation test for nested arrays")
}
