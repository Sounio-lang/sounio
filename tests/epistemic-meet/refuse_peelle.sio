// Refused even under E_n <= 20: H2 per sII cell at 200 K / 300 MPa for TIP4P/Ice
// and SPC/E share the H2 Lennard-Jones channels (rho = 0.995), and the GLS weight
// of TIP4P/Ice is -0.8497 (tests/oracles/epistemic_meet, formal/EpistemicCorr.lean).
fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    let ca = 2.23364425696364341
    let cb = 0.0 - 2.52912550826065453e-02
    let cd = 1.12653584638716957e-03
    let kz1 = measure(0.0, uncertainty: 1.0)
    let kz2 = measure(0.0, uncertainty: 1.0)
    let z1 = kz1.value
    let z2 = kz2.value
    let km0 = measure(0.0, uncertainty: 0.038)
    let km1 = measure(0.0, uncertainty: 0.058)
    let spce = 31.820 + km0.value + (0.0950 * ca + (0.0 - 19.059) * cb) * z1 + (0.0 - 19.059) * cd * z2
    let tip4 = 33.080 + km1.value + (0.0813 * ca + (0.0 - 20.585) * cb) * z1 + (0.0 - 20.585) * cd * z2
    let m = meet(tip4, spce, consistency: 20.0)
    print("NOT_REACHED ")
    print_f64(m)
    print("\n")
    0
}
