// Control for refuse_inconsistent.sio: the same pair under E_n <= 1.1 fuses to
// the mean, 1.15, with variance 0.005.
fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    let k0 = measure(1.0, uncertainty: 0.1)
    let k1 = measure(1.3, uncertainty: 0.1)
    let a = k0.value
    let b = k1.value
    let m = meet(a, b, consistency: 1.1)
    let d = m - 1.15
    let v = variance_of(m) - 0.005
    if d * d < 1.0e-24 && v * v < 1.0e-30 {
        print("MEET_POLICY_ACCEPT_OK\n")
        return 0
    }
    print("MEET_POLICY_ACCEPT_FAIL\n")
    1
}
