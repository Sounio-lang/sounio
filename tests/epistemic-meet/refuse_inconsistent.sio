// Refused: two independent sources 1.0 +- 0.1 and 1.3 +- 0.1 have
// E_n = 0.3 / (2 sqrt(0.02)) = 1.06 > 1 (ISO 13528 default, k = 2).
// The same pair is accepted under `consistency: 1.1` (accept_policy.sio).
fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    let k0 = measure(1.0, uncertainty: 0.1)
    let k1 = measure(1.3, uncertainty: 0.1)
    let a = k0.value
    let b = k1.value
    let m = meet(a, b)
    print("NOT_REACHED ")
    print_f64(m)
    print("\n")
    0
}
