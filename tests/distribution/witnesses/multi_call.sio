//@ run-pass
// Acceptance test 3 for compiler prerequisite #3 (trait-bounded generic method dispatch).
// Tests multiple trait methods, multiple type instantiations, and generic->generic chaining.
// Expected output: 8, 5, 9, then "multi_call PASS"

struct Pair {
    x: i64,
    y: i64,
}

trait R {
    fn radd(self, o: Self) -> Self
    fn rsub(self, o: Self) -> Self
}

impl R for i64 {
    fn radd(self, o: Self) -> Self { self + o }
    fn rsub(self, o: Self) -> Self { self - o }
}

impl R for Pair {
    fn radd(self, o: Self) -> Self {
        Pair { x: self.x + o.x, y: self.y + o.y }
    }
    fn rsub(self, o: Self) -> Self {
        Pair { x: self.x - o.x, y: self.y - o.y }
    }
}

// First bounded function: calls two different trait methods
fn compute<F: R>(a: F, b: F) -> F {
    a.radd(b)
}

// Second bounded function: calls another bounded function internally
fn combine<F: R>(a: F, b: F, c: F) -> F {
    let intermediate = compute::<F>(a, b)
    intermediate.rsub(c)
}

fn main() with IO {
    let i1 = 10
    let i2 = 2
    let i3 = 1

    let p1 = Pair { x: 4, y: 5 }
    let p2 = Pair { x: 2, y: 2 }
    let p3 = Pair { x: 1, y: 1 }

    let res_i = combine::<i64>(i1, i2, i3)
    println(res_i)

    let res_p = combine::<Pair>(p1, p2, p3)
    println(res_p.x)
    println(res_p.y)

    println("multi_call PASS")
}
