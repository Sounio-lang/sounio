use math::sedenion::*;

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    x
}

fn main() with IO, Panic {
    let a = sed_known_zero_divisor()
    let b = sed_complementary_zero_divisor()
    let lhs = sed_norm_sq(sed_mul(a, b))
    let rhs = sed_norm_sq(a) * sed_norm_sq(b)

    if abs_f64(lhs - rhs) > 0.0001 {
        println("HYPER_WAVE3_NORM_LIFT_FORBIDDEN_OK")
    } else {
        println("HYPER_WAVE3_NORM_LIFT_UNEXPECTED")
    }
}
