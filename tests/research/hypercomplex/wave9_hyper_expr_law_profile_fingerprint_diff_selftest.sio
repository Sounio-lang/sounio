// Wave 9 hyper-expression law profile fingerprint differential self-test

use check::mod::{check_hyper_expr_law_profile_probe}
use ir::algebra::{ir_forbidden_law_mask, ir_hyper_law_profile_fingerprint}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let registry_mask = ir_forbidden_law_mask(3, 2)
    let fallback_mask = ir_forbidden_law_mask(4, 1)
    let expected_registry_fingerprint: i64 = 4613865731
    let expected_fallback_fingerprint: i64 = 520159492

    let registry_expr = check_hyper_expr_law_profile_probe(3, 2, registry_mask, true)
    let fallback_expr = check_hyper_expr_law_profile_probe(4, 1, fallback_mask, false)

    if registry_expr.law_profile_source != 1 {
        print("FAIL: registry law-profile source\n")
        return 1
    }
    if registry_expr.reassoc_strategy != 2 {
        print("FAIL: registry reassoc strategy\n")
        return 2
    }
    if registry_expr.forbidden_law_mask != registry_mask {
        print("FAIL: registry forbidden-law mask\n")
        return 3
    }
    if registry_expr.law_profile_fingerprint != expected_registry_fingerprint {
        print("FAIL: registry law-profile fingerprint\n")
        return 4
    }
    if ir_hyper_law_profile_fingerprint(
        registry_expr.algebra_tag,
        registry_expr.op_kind,
        registry_expr.reassoc_strategy,
        registry_expr.forbidden_law_mask,
        registry_expr.law_profile_source,
    ) != registry_expr.law_profile_fingerprint {
        print("FAIL: registry fingerprint derivation\n")
        return 5
    }

    if fallback_expr.law_profile_source != 0 {
        print("FAIL: fallback law-profile source\n")
        return 6
    }
    if fallback_expr.reassoc_strategy != 1 {
        print("FAIL: fallback reassoc strategy\n")
        return 7
    }
    if fallback_expr.forbidden_law_mask != fallback_mask {
        print("FAIL: fallback forbidden-law mask\n")
        return 8
    }
    if fallback_expr.law_profile_fingerprint != expected_fallback_fingerprint {
        print("FAIL: fallback law-profile fingerprint\n")
        return 9
    }
    if registry_expr.law_profile_fingerprint == fallback_expr.law_profile_fingerprint {
        print("FAIL: differential fingerprint compare\n")
        return 10
    }
    if ir_hyper_law_profile_fingerprint(
        fallback_expr.algebra_tag,
        fallback_expr.op_kind,
        fallback_expr.reassoc_strategy,
        fallback_expr.forbidden_law_mask,
        fallback_expr.law_profile_source,
    ) != fallback_expr.law_profile_fingerprint {
        print("FAIL: fallback fingerprint derivation\n")
        return 11
    }

    print("HYPER_WAVE9_DIFF_SELFTEST_OK\n")
    0
}
