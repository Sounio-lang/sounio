algebra Quaternion over f64 {
    add: commutative, associative
    mul: associative, non_commutative
    reassociate: free
}

algebra Sedenion over f64 {
    add: commutative, associative
    mul: non_associative, non_commutative
    reassociate: blocked
}

struct ReassocLedger {
    free_lane: Hyper<Quaternion, f64>,
    blocked_lane: Hyper<Sedenion, f64>,
}

fn carry_free(x: Hyper<Quaternion, f64>) -> Hyper<Quaternion, f64> {
    x
}

fn carry_blocked(x: Hyper<Sedenion, f64>) -> Hyper<Sedenion, f64> {
    x
}

fn carry_ledger(x: ReassocLedger) -> ReassocLedger {
    x
}

fn main() -> i32 {
    0
}
