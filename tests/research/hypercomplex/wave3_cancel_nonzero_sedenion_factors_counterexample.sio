use math::sedenion::*;

fn main() with IO, Panic {
    let a = sed_known_zero_divisor()
    let b = sed_complementary_zero_divisor()
    let product = sed_mul(a, b)
    let a_norm_sq = sed_norm_sq(a)
    let b_norm_sq = sed_norm_sq(b)
    let product_norm_sq = sed_norm_sq(product)

    if a_norm_sq > 0.0001 && b_norm_sq > 0.0001 && product_norm_sq < 0.0001 {
        println("HYPER_WAVE3_CANCEL_FORBIDDEN_OK")
    } else {
        println("HYPER_WAVE3_CANCEL_UNEXPECTED")
    }
}
