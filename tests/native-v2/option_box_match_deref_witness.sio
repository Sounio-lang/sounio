//@ run-pass
// Witness: Option<Box<Struct>> match destructure + multi-field deref read.
// Tests that all fields of the boxed struct are readable after match binding.

struct Point {
    x: i64,
    y: i64,
    z: i64,
}

fn make_point(x: i64, y: i64, z: i64) -> Box<Point> with Mut, Alloc {
    Box::new(Point { x: x, y: y, z: z })
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var exit_fails: i64 = 0
    let opt: Option<Box<Point>> = Some(make_point(10, 20, 30))
    match opt {
        Some(p) => {
            let px = (*p).x
            let py = (*p).y
            let pz = (*p).z
            assert(px == 10)
            assert(py == 20)
            assert(pz == 30)
            assert(px + py + pz == 60)
            print("multi-field deref PASS\n")
        },
        None => {
            print("FAIL\n")
            exit_fails = exit_fails + 1
        },
    }

    // None branch: default value
    let opt2: Option<Box<Point>> = None
    match opt2 {
        Some(_) => { print("FAIL\n"); exit_fails = exit_fails + 1 },
        None => { print("none branch PASS\n") },
    }

    if exit_fails > 0 { 1 } else { 0 }
}
