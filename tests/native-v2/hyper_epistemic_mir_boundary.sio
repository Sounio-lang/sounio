// Native-v2 hyper epistemic MIR boundary witness.
//
// IrHyperEpistemicMul is reachable from IR lowering, and AArch64 has a scalar
// lane instruction preview, but native-v2 does not yet have the value layout
// and legal MIR form for the fused hyper-epistemic product.  Pin the current
// behavior as fail-closed with a stable diagnostic instead of silently lowering
// to an incomplete backend path.

use ir::ir::{IrFunction, IrOpcode, ir_empty_function, ir_instr_new}
use native::machine_ir::{native_v2_legalize_ir_summary_ref, native_v2_lower_function_to_machine}

fn make_hyper_func() -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    func.reg_count = 6
    var instr = ir_instr_new(IrOpcode::IrHyperEpistemicMul)
    instr.dst = 4
    instr.src1 = 0
    instr.src2 = 2
    func.instrs[0] = instr
    func.instr_count = 1
    func
}

fn expect_hyper_detail(label: string, supported: bool, detail: string) -> bool with IO, Mut, Panic, Div {
    if supported {
        print("  FAIL ")
        print(label)
        print(": unexpectedly supported\n")
        return false
    }
    if detail == "hyper_epistemic_mul" {
        print("  OK ")
        print(label)
        print(": fail-closed detail=hyper_epistemic_mul\n")
        return true
    }
    print("  FAIL ")
    print(label)
    print(": detail=")
    print(detail)
    print("\n")
    false
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("=== native-v2 hyper epistemic MIR boundary ===\n")

    var passed: i64 = 0

    var summary_func = make_hyper_func()
    let summary = native_v2_legalize_ir_summary_ref(&summary_func)
    if expect_hyper_detail("legalize_ir_summary_ref", summary.supported, summary.unsupported_detail) {
        passed = passed + 1
    }

    let lowered = native_v2_lower_function_to_machine(make_hyper_func())
    if expect_hyper_detail("lower_function_to_machine", lowered.supported, lowered.unsupported_detail) {
        passed = passed + 1
    }

    print("hyper_epistemic_mir_boundary: ")
    print_int(passed)
    print("/2 passed\n")

    if passed == 2 {
        print("RESULT: native-v2 rejects IrHyperEpistemicMul before incomplete MIR lowering\n")
        return 0
    }

    print("RESULT: FAIL\n")
    1
}
