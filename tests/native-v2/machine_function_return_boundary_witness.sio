// Native-v2 MachineFunction return boundary witness.
//
// This pins the current blocker below legalization: returning the large nested
// MachineFunction value from lowering corrupts block metadata/instruction
// storage at runtime.

use parser::ast::{BinaryOp}
use ir::ir::{ir_empty_function, ir_binop, ir_return}
use native::machine_ir::{MIR_OP_PSEUDO_BINOP, MIR_OP_PSEUDO_RET, native_v2_lower_function_to_machine}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("native-v2 MachineFunction return boundary witness\n")
    var func = ir_empty_function()
    func.reg_count = 3
    func.instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    func.instrs[1] = ir_return(2)
    func.instr_count = 2

    let lowered = native_v2_lower_function_to_machine(func)
    if !lowered.supported {
        print("lower unsupported: ")
        print(lowered.unsupported_detail)
        print("\n")
        return 1
    }

    print("count=")
    print_int(lowered.blocks[0].instr_count)
    print(" op0=")
    print_int(lowered.blocks[0].instrs[0].opcode)
    print(" op1=")
    print_int(lowered.blocks[0].instrs[1].opcode)
    print("\n")

    if lowered.blocks[0].instr_count == 2 && lowered.blocks[0].instrs[0].opcode == MIR_OP_PSEUDO_BINOP && lowered.blocks[0].instrs[1].opcode == MIR_OP_PSEUDO_RET {
        print("RESULT: return boundary stable\n")
        return 0
    }

    print("RESULT: return boundary corrupt\n")
    1
}
