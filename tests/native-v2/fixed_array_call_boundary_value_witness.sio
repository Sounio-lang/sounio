//@ run-pass
//@ native-v2

fn mutate_i64(values: [i64; 2]) with Mut, Panic, Div {
    values[0] = 101
}

fn mutate_i8(values: [i8; 2]) with Mut, Panic, Div {
    values[0] = 102 as i8
}

fn mutate_bool(values: [bool; 2]) with Mut, Panic, Div {
    values[0] = false
}

fn mutate_f64(values: [f64; 2]) with Mut, Panic, Div {
    values[0] = 103.0
}

fn mutate_by_reference(values: &![i64; 2]) with Mut, Panic, Div {
    values[0] = 104
}

fn mutate_middle_parameter(prefix: i64, values: [i64; 2], suffix: f64) -> i64 with Mut, Panic, Div {
    if prefix != 31 { return 1 }
    if suffix != 32.0 { return 2 }
    values[0] = 105
    0
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var ints: [i64; 2] = [0; 2]
    ints[0] = 11
    mutate_i64(ints)
    if ints[0] != 11 {
        print("FAIL fixed_array_call_boundary_value i64=aliased\n")
        return 71
    }

    var bytes: [i8; 2] = [0; 2]
    bytes[0] = 12 as i8
    mutate_i8(bytes)
    if bytes[0] != 12 as i8 {
        print("FAIL fixed_array_call_boundary_value i8=aliased\n")
        return 72
    }

    var flags: [bool; 2] = [true; 2]
    mutate_bool(flags)
    if !flags[0] {
        print("FAIL fixed_array_call_boundary_value bool=aliased\n")
        return 73
    }

    var floats: [f64; 2] = [0.0; 2]
    floats[0] = 13.0
    mutate_f64(floats)
    if floats[0] != 13.0 {
        print("FAIL fixed_array_call_boundary_value f64=aliased\n")
        return 74
    }

    mutate_by_reference(&! ints)
    if ints[0] != 104 {
        print("FAIL fixed_array_call_boundary_value mutable_ref=not_visible\n")
        return 75
    }

    ints[0] = 14
    let middle_status = mutate_middle_parameter(31, ints, 32.0)
    if middle_status != 0 || ints[0] != 14 {
        print("FAIL fixed_array_call_boundary_value multi_param=unstable\n")
        return 76
    }

    print("PASS fixed_array_call_boundary_value i64=owned i8=owned bool=owned f64=owned mutable_ref=caller_visible multi_param=stable\n")
    0
}
