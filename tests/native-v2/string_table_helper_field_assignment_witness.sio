//@ run-pass
use native::elf::{StringTable, string_table_new}

fn force_len(data: StringTable, len: i64) -> StringTable with Mut {
    var out: StringTable = data
    out.len = len
    out
}

fn main() -> i64 with Mut {
    let st = force_len(string_table_new(), 8)
    if st.len == 8 {
        return 0
    }
    return 1
}
