pub fn poison_float_bits() -> f64 with Mut {
    var x = 1.0
    x = x + 1.0
    x = x + 2.0
    x = x + 3.0
    x = x + 4.0
    x = x + 5.0
    x = x + 6.0
    x = x + 7.0
    x = x + 8.0
    x = x + 9.0
    x = x + 10.0
    x = x + 11.0
    x = x + 12.0
    x = x + 13.0
    x = x + 14.0
    x = x + 15.0
    x = x + 16.0
    x = x + 17.0
    x = x + 18.0
    x = x + 19.0
    x = x + 20.0
    x = x + 21.0
    x = x + 22.0
    x = x + 23.0
    x = x + 24.0
    x = x + 25.0
    x = x + 26.0
    x = x + 27.0
    x = x + 28.0
    x = x + 29.0
    x = x + 30.0
    x
}

pub fn read_dense_row(r: i64, eff: &[f64; 106], c: &[f64; 53]) -> f64 with Mut {
    var total = 0.0
    var i: i64 = 0
    while i < 53 {
        total = total + eff[r*53+i] * c[i]
        i = i + 1
    }
    total
}
