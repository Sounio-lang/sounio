pub fn ordered_sum_20(
    a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, a8: i64, a9: i64, a10: i64,
    a11: i64, a12: i64, a13: i64, a14: i64, a15: i64,
    a16: i64, a17: i64, a18: i64, a19: i64, a20: i64
) -> i64 {
    a1 + a2 * 2 + a3 * 3 + a4 * 4 + a5 * 5 +
    a6 * 6 + a7 * 7 + a8 * 8 + a9 * 9 + a10 * 10 +
    a11 * 11 + a12 * 12 + a13 * 13 + a14 * 14 + a15 * 15 +
    a16 * 16 + a17 * 17 + a18 * 18 + a19 * 19 + a20 * 20
}

pub fn ordered_sum_21(
    a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, a8: i64, a9: i64, a10: i64,
    a11: i64, a12: i64, a13: i64, a14: i64, a15: i64,
    a16: i64, a17: i64, a18: i64, a19: i64, a20: i64,
    a21: i64
) -> i64 {
    ordered_sum_20(
        a1, a2, a3, a4, a5, a6, a7, a8, a9, a10,
        a11, a12, a13, a14, a15, a16, a17, a18, a19, a20
    ) + a21 * 21
}

pub fn ordered_sum_22(
    a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, a8: i64, a9: i64, a10: i64,
    a11: i64, a12: i64, a13: i64, a14: i64, a15: i64,
    a16: i64, a17: i64, a18: i64, a19: i64, a20: i64,
    a21: i64, a22: i64
) -> i64 {
    ordered_sum_21(
        a1, a2, a3, a4, a5, a6, a7, a8, a9, a10,
        a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21
    ) + a22 * 22
}

pub fn ordered_sum_23(
    a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, a8: i64, a9: i64, a10: i64,
    a11: i64, a12: i64, a13: i64, a14: i64, a15: i64,
    a16: i64, a17: i64, a18: i64, a19: i64, a20: i64,
    a21: i64, a22: i64, a23: i64
) -> i64 {
    ordered_sum_22(
        a1, a2, a3, a4, a5, a6, a7, a8, a9, a10,
        a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22
    ) + a23 * 23
}

pub fn ref_at_20(
    a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, a8: i64, a9: i64, a10: i64,
    a11: i64, a12: i64, a13: i64, a14: i64, a15: i64,
    a16: i64, a17: i64, a18: i64, a19: i64,
    out: &![i64; 2]
) with Mut, Panic {
    out[0] = a1
    out[1] = a19
}

pub fn ref_at_21(
    a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, a8: i64, a9: i64, a10: i64,
    a11: i64, a12: i64, a13: i64, a14: i64, a15: i64,
    a16: i64, a17: i64, a18: i64, a19: i64, a20: i64,
    out: &![i64; 2]
) with Mut, Panic {
    out[0] = a2
    out[1] = a20
}

pub fn ref_at_22(
    a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, a8: i64, a9: i64, a10: i64,
    a11: i64, a12: i64, a13: i64, a14: i64, a15: i64,
    a16: i64, a17: i64, a18: i64, a19: i64, a20: i64,
    a21: i64, out: &![i64; 2]
) with Mut, Panic {
    out[0] = a3
    out[1] = a21
}

pub fn ref_at_23(
    a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, a8: i64, a9: i64, a10: i64,
    a11: i64, a12: i64, a13: i64, a14: i64, a15: i64,
    a16: i64, a17: i64, a18: i64, a19: i64, a20: i64,
    a21: i64, a22: i64, out: &![i64; 2]
) with Mut, Panic {
    out[0] = a4
    out[1] = a22
}

pub fn chemistry_leaf(
    a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, a8: i64, a9: i64, a10: i64,
    a11: i64, a12: i64, a13: i64, a14: i64, a15: i64,
    a16: i64, a17: i64, a18: i64, a19: i64, a20: i64,
    fwd: &![i64; 325], rev: &![i64; 325], dc: &![i64; 53]
) with Mut, Panic {
    fwd[0] = a1
    fwd[324] = a20
    rev[0] = a2
    rev[324] = a19
    dc[0] = a3 + a18
    dc[52] = a10 + a11
}

pub fn chemistry_bare_forward(
    a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, a8: i64, a9: i64, a10: i64,
    a11: i64, a12: i64, a13: i64, a14: i64, a15: i64,
    a16: i64, a17: i64, a18: i64, a19: i64, a20: i64,
    fwd: &![i64; 325], rev: &![i64; 325], dc: &![i64; 53]
) with Mut, Panic {
    chemistry_leaf(
        a1, a2, a3, a4, a5, a6, a7, a8, a9, a10,
        a11, a12, a13, a14, a15, a16, a17, a18, a19, a20,
        fwd, rev, dc
    )
}
