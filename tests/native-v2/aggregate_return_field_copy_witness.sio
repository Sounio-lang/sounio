//@ run-pass

use lexer::token::TokenKind

struct CursorMini {
    source_len: i64,
    pos: i64,
    line: i64,
    col: i64,
    current: i8,
}

struct ScanMini {
    cursor: CursorMini,
    kind: TokenKind,
    start: i64,
    end: i64,
    text: [i8; 256],
    text_len: i64,
}

fn make_cursor(pos: i64) -> CursorMini {
    CursorMini { source_len: 64, pos: pos, line: 1, col: 1, current: 102 as i8 }
}

fn make_scan(c: CursorMini) -> ScanMini with Mut, Panic, Div {
    var text: [i8; 256] = [0; 256]
    text[0 as usize] = 102 as i8
    text[1 as usize] = 110 as i8
    ScanMini {
        cursor: CursorMini {
            source_len: c.source_len,
            pos: c.pos + 2,
            line: c.line,
            col: c.col + 2,
            current: 40 as i8,
        },
        kind: TokenKind::Fn,
        start: c.pos,
        end: c.pos + 2,
        text: text,
        text_len: 2,
    }
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var cur = make_cursor(25)
    let result = make_scan(cur)
    if result.kind != TokenKind::Fn {
        print("RESULT: aggregate return enum field failed\n")
        return 3
    }
    cur = result.cursor
    if cur.pos != 27 {
        print("RESULT: aggregate return field copy failed\n")
        return 1
    }
    if cur.current != 40 as i8 {
        print("RESULT: aggregate return field copy current failed\n")
        return 2
    }
    print("RESULT: aggregate return field copy stable\n")
    0
}
