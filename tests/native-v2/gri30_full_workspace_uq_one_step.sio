use chemistry::gri30_full::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let t = 1500.0
    let m = 1.0 / (82.057 * t)
    var c: [f64; 53] = [0.0; 53]
    var u0: [f64; 53] = [0.0; 53]
    c[0] = m * 0.02
    c[3] = m * 0.01
    c[47] = m * 0.97
    c[1] = 1.0e-11
    u0[0] = 0.01 * c[0]
    u0[3] = 0.01 * c[3]

    let (y, u) = simulate_gri30_full_epistemic(&c, &u0, t, 2.0e-9, 1)
    if y[0] <= 0.0 || u[0] <= 0.0 {
        print("UQ1 FAIL\n")
        return 1
    }
    print("UQ1 PASS\n")
    0
}
