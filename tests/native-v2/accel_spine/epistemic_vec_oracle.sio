struct Knowledge<T> {
    value: T,
    uncertainty: T,
    confidence: T,
}

fn knowledge(value: f64, uncertainty: f64, confidence: f64) -> Knowledge<f64> {
    Knowledge<f64> { value: value, uncertainty: uncertainty, confidence: confidence }
}

fn add_knowledge(a: Knowledge<f64>, b: Knowledge<f64>) -> Knowledge<f64> {
    knowledge(a.value + b.value, a.uncertainty + b.uncertainty, a.confidence)
}

fn main() -> i64 with IO {
    let a0 = knowledge(1.500, 0.125, 0.875)
    let a1 = knowledge(2.250, 0.250, 0.875)
    let b0 = knowledge(3.750, 0.375, 0.750)
    let b1 = knowledge(4.500, 0.500, 0.750)
    let c0 = add_knowledge(a0, b0)
    let c1 = add_knowledge(a1, b1)
    print_f64(c0.value + c1.value)
    print_char(10)
    print_f64(c0.uncertainty + c1.uncertainty)
    print_char(10)
    print_f64(c0.confidence)
    print_char(10)
    0
}
