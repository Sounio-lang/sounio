struct Knowledge<T> {
    value: T,
    uncertainty: T,
    confidence: T,
}

struct Compartments {
    plasma: Knowledge<f64>,
    brain: Knowledge<f64>,
}

fn knowledge(value: f64, uncertainty: f64, confidence: f64) -> Knowledge<f64> {
    Knowledge<f64> { value: value, uncertainty: uncertainty, confidence: confidence }
}

fn step_pbpk(s: Compartments) -> Compartments {
    let k12 = knowledge(0.250, 0.125, 0.750)
    let k21 = knowledge(0.500, 0.250, 0.750)
    let brain_in = s.plasma.value * k12.value
    let brain_out = s.brain.value * k21.value
    let next_plasma = knowledge(s.plasma.value - brain_in + brain_out, s.plasma.uncertainty + k12.uncertainty, s.plasma.confidence)
    let next_brain = knowledge(s.brain.value + brain_in - brain_out, s.brain.uncertainty + k21.uncertainty, s.brain.confidence)
    Compartments { plasma: next_plasma, brain: next_brain }
}

fn main() -> i64 with IO {
    let s0 = Compartments {
        plasma: knowledge(10.000, 0.250, 0.875),
        brain: knowledge(2.000, 0.125, 0.875),
    }
    let s1 = step_pbpk(s0)
    print_f64(s1.plasma.value)
    print_char(10)
    print_f64(s1.brain.value)
    print_char(10)
    print_f64(s1.plasma.uncertainty + s1.brain.uncertainty)
    print_char(10)
    0
}
