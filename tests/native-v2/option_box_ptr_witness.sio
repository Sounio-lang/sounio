//@ run-pass

use lexer::span::{Span}
use parser::ast::{Expr, ExprKind}
use parser::parser::{mk_expr}

struct HolderExprOpt {
    left: Option<Box<Expr>>,
}

fn make_int_expr(v: i64) -> Box<Expr> with Mut, Alloc {
    let span = Span { file_id: 0, start: 0, end: 0 }
    var e = mk_expr(ExprKind::ExprIntLit, span)
    e.int_val = v
    Box::new(e)
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let child = make_int_expr(88)
    print("child_ptr=")
    print_int(child as i64)
    print("\n")
    let o: Option<Box<Expr>> = Some(child)
    match o {
        Some(v) => {
            print("v_ptr=")
            print_int(v as i64)
            print("\n")
            print("kind=")
            print_int((*v).kind as i64)
            print(" int=")
            print_int((*v).int_val)
            print("\n")
        },
        None => {},
    }
    let span = Span { file_id: 0, start: 0, end: 0 }
    var e: Expr = mk_expr(ExprKind::ExprReturn, span)
    let child2 = make_int_expr(99)
    print("child2_ptr=")
    print_int(child2 as i64)
    print("\n")
    e.left = Some(child2)
    match e.left {
        Some(w) => {
            print("w_ptr=")
            print_int(w as i64)
            print("\n")
        },
        None => {},
    }
    var h = HolderExprOpt { left: None }
    let child3 = make_int_expr(77)
    print("child3_ptr=")
    print_int(child3 as i64)
    print("\n")
    h.left = Some(child3)
    match h.left {
        Some(q) => {
            print("q_ptr=")
            print_int(q as i64)
            print("\n")
            print("q_kind=")
            print_int((*q).kind as i64)
            print(" q_int=")
            print_int((*q).int_val)
            print("\n")
        },
        None => {},
    }
    0
}
