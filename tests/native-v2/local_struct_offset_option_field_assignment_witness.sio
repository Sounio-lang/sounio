//@ run-pass

struct TinyOffsetOpt {
    value: i64,
}

struct HolderOffsetOpt {
    prefix: [i8; 128],
    count: i64,
    left: Option<Box<TinyOffsetOpt>>,
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var prefix: [i8; 128] = [0; 128]
    prefix[0 as usize] = 88 as i8
    var h = HolderOffsetOpt {
        prefix: prefix,
        count: 7,
        left: None,
    }
    h.left = Some(Box::new(TinyOffsetOpt { value: 456 }))
    match h.left {
        Some(v) => {
            if (*v).value == 456 && h.count == 7 && h.prefix[0 as usize] as i64 == 88 {
                print("RESULT: local struct offset option field assignment stable\n")
                return 0
            }
        },
        None => {},
    }
    print("RESULT: local struct offset option field assignment corrupt\n")
    1
}
