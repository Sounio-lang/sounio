//@ run-pass

use parser::ast::{Name}
use ir::ir::{IrFunction, ir_empty_function}

struct NameCarrier2 {
    name: Name,
}

fn make_name2() -> Name with Mut {
    var buf: [i8; 128] = [0; 128]
    buf[0 as usize] = 109 as i8
    Name { buf: buf, len: 1 }
}

fn write_name(out: &! IrFunction, src: &NameCarrier2) with Mut, Panic {
    (*out).name = (*src).name
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var func = ir_empty_function()
    let src = NameCarrier2 { name: make_name2() }
    write_name(&! func, &src)
    if func.name.buf[0 as usize] as i64 == 109 {
        print("RESULT: deref struct field copy stable\n")
        return 0
    }
    print("RESULT: deref struct field copy corrupt\n")
    print_int(func.name.buf[0 as usize] as i64)
    print("\n")
    1
}
