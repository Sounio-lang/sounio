struct KnowledgeF64 {
    value: f64,
    uncertainty: f64,
    confidence: f64,
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { return a }
    b
}

fn gum_mul(a: KnowledgeF64, b: KnowledgeF64) -> KnowledgeF64 {
    let product = a.value * b.value
    let rel_a = a.uncertainty / a.value
    let rel_b = b.uncertainty / b.value
    let ra2 = rel_a * rel_a
    let rb2 = rel_b * rel_b
    let sum2 = ra2 + rb2
    let u_c = product * sqrt_f64(sum2)
    KnowledgeF64 {
        value: product,
        uncertainty: u_c,
        confidence: min_f64(a.confidence, b.confidence),
    }
}

fn main() -> i64 with IO, Div {
    let a = KnowledgeF64 { value: 10.0, uncertainty: 1.0, confidence: 0.9 }
    let b = KnowledgeF64 { value: 2.0, uncertainty: 0.2, confidence: 0.9 }
    let c = gum_mul(a, b)
    print_f64(c.value)
    print_char(10)
    print_f64(c.uncertainty)
    print_char(10)
    print_f64(c.confidence)
    print_char(10)
    0
}
