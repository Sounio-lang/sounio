struct KnowledgeF64 {
    value: f64,
    uncertainty: f64,
    confidence: f64,
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { return a }
    b
}

fn gum_add(a: KnowledgeF64, b: KnowledgeF64) -> KnowledgeF64 {
    let ua2 = a.uncertainty * a.uncertainty
    let ub2 = b.uncertainty * b.uncertainty
    let sum2 = ua2 + ub2
    let u_c = sqrt_f64(sum2)
    KnowledgeF64 {
        value: a.value + b.value,
        uncertainty: u_c,
        confidence: min_f64(a.confidence, b.confidence),
    }
}

fn main() -> i64 with IO {
    let a = KnowledgeF64 { value: 1.0, uncertainty: 0.3, confidence: 0.9 }
    let b = KnowledgeF64 { value: 2.0, uncertainty: 0.4, confidence: 0.8 }
    let c = gum_add(a, b)
    print_f64(c.value)
    print_char(10)
    print_f64(c.uncertainty)
    print_char(10)
    print_f64(c.confidence)
    print_char(10)
    0
}
