//@ run-pass

use lexer::span::{Span}
use parser::ast::{Expr, ExprKind}
use parser::parser::{mk_expr}

struct HolderExprOpt {
    left: Option<Box<Expr>>,
}

fn make_expr_box(v: i64) -> Box<Expr> with Mut, Alloc {
    let span = Span { file_id: 0, start: 0, end: 0 }
    var e = mk_expr(ExprKind::ExprIntLit, span)
    e.int_val = v
    Box::new(e)
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var h = HolderExprOpt { left: None }
    let child = make_expr_box(333)
    h.left = Some(child)
    match h.left {
        Some(v) => {
            if (*v).kind == ExprKind::ExprIntLit && (*v).int_val == 333 {
                print("RESULT: local struct option box expr field stable\n")
                return 0
            }
        },
        None => {},
    }
    print("RESULT: local struct option box expr field corrupt\n")
    1
}
