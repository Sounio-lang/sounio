struct KnowledgeI64 {
    value: i64,
    uncertainty: i64,
    confidence: i64,
}

fn knowledge(value: i64, uncertainty: i64, confidence: i64) -> KnowledgeI64 {
    KnowledgeI64 { value: value, uncertainty: uncertainty, confidence: confidence }
}

fn min_i64(a: i64, b: i64) -> i64 {
    if a < b { return a }
    b
}

fn add_knowledge(a: KnowledgeI64, b: KnowledgeI64) -> KnowledgeI64 {
    KnowledgeI64 {
        value: a.value + b.value,
        uncertainty: a.uncertainty + b.uncertainty,
        confidence: min_i64(a.confidence, b.confidence),
    }
}

fn main() -> i64 with IO {
    let dose = knowledge(15000, 300, 9200)
    let adjustment = knowledge(1800, 120, 8700)
    let total = add_knowledge(dose, adjustment)
    print_int(total.value)
    print_char(32)
    print_int(total.uncertainty)
    print_char(32)
    print_int(total.confidence)
    print_char(10)
    0
}
