struct Triple {
    a: i64,
    b: i64,
    c: i64,
}

fn make_triple(a: i64, b: i64, c: i64) -> Triple {
    Triple { a: a, b: b, c: c }
}

fn main() -> i64 with IO {
    let t = make_triple(11, 22, 33)
    print_int(t.a)
    print_char(32)
    print_int(t.b)
    print_char(32)
    print_int(t.c)
    print_char(10)
    0
}
