//@ run-pass

use lexer::token::{TokenKind}

struct CursorLike {
    source_len: i64,
    pos: i64,
    line: i64,
    col: i64,
    current: i8,
}

struct SourceWithArray {
    cursor: CursorLike,
    kind: TokenKind,
    start: i64,
    end: i64,
    text: [i8; 256],
    len: i64,
}

struct TokenLike {
    kind: TokenKind,
    start: i64,
    end: i64,
    line: i64,
    col: i64,
    text: [i8; 256],
    len: i64,
    int_value: i64,
    float_value: f64,
}

impl TokenLike {
    fn with_kind(kind: TokenKind, start: i64, end: i64, line: i64, col: i64) -> TokenLike {
        TokenLike {
            kind: kind,
            start: start,
            end: end,
            line: line,
            col: col,
            text: [0; 256],
            len: 0,
            int_value: 0,
            float_value: 0.0,
        }
    }
}

struct OtherNamed {
    name: i64,
    pad: i64,
}

struct NameLike {
    buf: [i8; 8],
    len: i64,
}

struct FunctionLike {
    name: NameLike,
    regs: [i64; 4],
    strategy: i64,
}

struct ModuleLike {
    functions: [FunctionLike; 2],
    fn_count: i64,
}

fn make_source() -> SourceWithArray with Mut {
    var text: [i8; 256] = [0; 256]
    text[0 as usize] = 102 as i8
    text[1 as usize] = 110 as i8
    SourceWithArray {
        cursor: CursorLike { source_len: 64, pos: 2, line: 1, col: 3, current: 40 as i8 },
        kind: TokenKind::Fn,
        start: 0,
        end: 2,
        text: text,
        len: 2,
    }
}

fn empty_name_like() -> NameLike {
    NameLike { buf: [0; 8], len: 0 }
}

fn main_name_like() -> NameLike with Mut {
    var buf: [i8; 8] = [0; 8]
    buf[0 as usize] = 109 as i8
    buf[1 as usize] = 97 as i8
    buf[2 as usize] = 105 as i8
    buf[3 as usize] = 110 as i8
    NameLike { buf: buf, len: 4 }
}

fn empty_function_like() -> FunctionLike {
    FunctionLike {
        name: empty_name_like(),
        regs: [0; 4],
        strategy: 0,
    }
}

fn empty_module_like() -> ModuleLike {
    ModuleLike {
        functions: [empty_function_like(); 2],
        fn_count: 0,
    }
}

fn indexed_field_field_store_witness() -> i64 with IO, Mut, Panic, Div {
    let unused = OtherNamed { name: 99, pad: 1 }
    if unused.name != 99 { return 10 }
    var module = empty_module_like()
    var idx: i64 = 0
    let nm = main_name_like()
    module.functions[idx as usize].name = nm
    module.functions[idx as usize].regs = [0 - 1; 4]
    module.functions[idx as usize].strategy = 7
    module.fn_count = idx + 1
    if module.fn_count != 1 {
        print("RESULT: indexed field-field store corrupt fn_count\n")
        return 11
    }
    if module.functions[idx as usize].name.len != 4 {
        print("RESULT: indexed field-field store corrupt name len\n")
        return 12
    }
    if module.functions[idx as usize].name.buf[0 as usize] as i64 != 109 {
        print("RESULT: indexed field-field store corrupt name byte\n")
        return 13
    }
    if module.functions[idx as usize].regs[0 as usize] != 0 - 1 {
        print("RESULT: indexed field-field store corrupt regs\n")
        return 14
    }
    if module.functions[idx as usize].strategy != 7 {
        print("RESULT: indexed field-field store corrupt strategy\n")
        return 15
    }
    if module.functions[1 as usize].name.len != 0 {
        print("RESULT: indexed field-field store aliases repeated aggregate elements\n")
        return 16
    }
    return 0
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var cur = CursorLike { source_len: 64, pos: 0, line: 1, col: 1, current: 102 as i8 }
    let result = make_source()
    cur = result.cursor
    var tok = TokenLike::with_kind(result.kind, result.start, result.end, cur.line, cur.col)
    tok.text = result.text
    tok.len = result.len
    if tok.text[0 as usize] as i64 != 102 {
        print("RESULT: aggregate array field assignment corrupt text0\n")
        return 1
    }
    if tok.text[1 as usize] as i64 != 110 {
        print("RESULT: aggregate array field assignment corrupt text1\n")
        return 2
    }
    if tok.len != 2 {
        print("RESULT: aggregate array field assignment corrupt len\n")
        return 3
    }
    let indexed_status = indexed_field_field_store_witness()
    if indexed_status != 0 { return indexed_status }
    print("RESULT: aggregate array field assignment stable\n")
    0
}
