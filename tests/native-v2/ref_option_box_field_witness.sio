//@ run-pass
// Witness: field access through &Option<Box<Node>> — the 3rd pointer level
// (&) over Option<Box<Struct>> previously overflowed the i64 type hash
// (ref_hash_make compounds ×256 per level), corrupting the inner struct hash
// so the field lookup reported "unknown field". Composite-inner interning
// keeps the hash in band at arbitrary nesting depth.

struct Node {
    val: i64,
    next: Option<Box<Node>>,
}

fn top_val(slot: &Option<Box<Node>>) -> i64 with Mut, Panic, Div {
    match *slot {
        Some(n) => (*n).val,
        None => 0 - 1,
    }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let n1 = Box::new(Node { val: 1, next: None })
    let head: Option<Box<Node>> = Some(n1)

    let v = top_val(&head)
    assert(v == 1)
    print("ref-option-box PASS\n")
    0
}
