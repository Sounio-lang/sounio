// Native-v2 large-value boundary witness.
//
// This is intentionally ignored in the normal suite because the final call
// currently crashes under `run`.  It captures the next blocker after import
// health: lowering can produce a MachineFunction, but passing that large
// fixed-array value into native_v2_legalize_function is not runtime-stable yet.

use parser::ast::{BinaryOp}
use ir::ir::{ir_empty_function, ir_binop, ir_return}
use native::machine_ir::{native_v2_lower_function_to_machine, native_v2_legalize_function}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("native-v2 large-value legalize witness\n")
    var func = ir_empty_function()
    func.reg_count = 3
    func.instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    func.instrs[1] = ir_return(2)
    func.instr_count = 2
    let lowered = native_v2_lower_function_to_machine(func)
    if !lowered.supported {
        print("lower failed: ")
        print(lowered.unsupported_detail)
        print("\n")
        return 1
    }
    print("lower ok\n")

    // Current expected behavior when run manually: runtime crash before this
    // function returns.  Once fixed, this witness should be unignored and
    // tightened to assert legal.legal_instr_count > 0.
    let legal = native_v2_legalize_function(lowered)
    if !legal.supported {
        print("legalize failed: ")
        print(legal.unsupported_detail)
        print("\n")
        return 1
    }
    print("legalize ok instrs=")
    print_int(legal.legal_instr_count)
    print("\n")
    0
}
