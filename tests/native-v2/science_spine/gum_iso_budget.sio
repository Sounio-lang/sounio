// Native-v2 science spine: ISO GUM uncertainty budget output.
// Demonstrates ISO JCGM 100:2008 Table 1 structure: per-compartment
// uncertainty budget with combined total via GUM quadrature.
// Three-compartment rapamycin model (plasma, stent-polymer, peripheral).

fn sqrt_f64(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    var i = 0
    while i < 24 {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    return guess
}

struct KnowledgeF64 {
    value: f64,
    uncertainty: f64,
    confidence: f64,
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { return a }
    b
}

fn gum_add(a: KnowledgeF64, b: KnowledgeF64) -> KnowledgeF64 with Mut, Div {
    let ua2 = a.uncertainty * a.uncertainty
    let ub2 = b.uncertainty * b.uncertainty
    let u_c = sqrt_f64(ua2 + ub2)
    let conf = min_f64(a.confidence, b.confidence)
    KnowledgeF64 { value: a.value + b.value, uncertainty: u_c, confidence: conf }
}

fn scale(k: KnowledgeF64, f: f64) -> KnowledgeF64 {
    KnowledgeF64 { value: k.value * f, uncertainty: k.uncertainty * f, confidence: k.confidence }
}

fn main() -> i64 with IO, Mut, Div {
    // Initial conditions (rapamycin Cypher DES class)
    var plasma = KnowledgeF64 { value: 100.0, uncertainty: 2.0, confidence: 0.9 }
    var stent  = KnowledgeF64 { value: 0.0,   uncertainty: 0.0, confidence: 0.9 }
    var tissue = KnowledgeF64 { value: 0.0,   uncertainty: 0.0, confidence: 0.9 }

    // 5 Euler steps: k_clear=0.045, k_ps=0.08, k_st=0.05
    var i: i64 = 0
    while i < 5 {
        let cleared   = scale(plasma, 0.045)
        let to_stent  = scale(plasma, 0.08)
        let to_tissue = scale(stent,  0.05)

        let neg_cleared   = scale(cleared,   -1.0)
        let neg_to_stent  = scale(to_stent,  -1.0)
        let neg_to_tissue = scale(to_tissue, -1.0)

        let p1 = gum_add(plasma, neg_cleared)
        let new_plasma = gum_add(p1, neg_to_stent)

        let s1 = gum_add(stent, to_stent)
        let new_stent = gum_add(s1, neg_to_tissue)

        let new_tissue = gum_add(tissue, to_tissue)

        plasma = new_plasma
        stent  = new_stent
        tissue = new_tissue
        i = i + 1
    }

    // ISO GUM budget: per-compartment values + combined total
    print("plasma: ")
    print_f64(plasma.value)
    print_char(32)
    print_f64(plasma.uncertainty)
    print_char(10)
    print("stent: ")
    print_f64(stent.value)
    print_char(32)
    print_f64(stent.uncertainty)
    print_char(10)
    print("tissue: ")
    print_f64(tissue.value)
    print_char(32)
    print_f64(tissue.uncertainty)
    print_char(10)
    let u1 = plasma.uncertainty * plasma.uncertainty
    let u2 = stent.uncertainty * stent.uncertainty
    let u3 = tissue.uncertainty * tissue.uncertainty
    let budget = sqrt_f64(u1 + u2 + u3)
    print("budget: ")
    print_f64(budget)
    print_char(10)
    0
}
