// Native-v2 science spine: Door Σ — Free Probability / R-Transform.
//
// First compiler where Knowledge<T> carries a distribution_class annotation and emits
// free-probability-correct variance propagation via Voiculescu's R-transform.
//
// Classical probability: independent random variables X,Y have Var(X+Y) = Var(X)+Var(Y).
// Free probability: freely independent non-commutative rv's have the same FIRST-ORDER
// formula for variance (σ²_a⊞b = σ²_a + σ²_b), but HIGHER MOMENTS differ fundamentally.
//
// Voiculescu R-transform linearizes free convolution:
//   R_{a⊞b}(z) = R_a(z) + R_b(z)
//
// Wigner semicircle distribution (σ²): R_W(z) = σ²·z
//   → free convolution of semicircle(σ²_a) ⊞ semicircle(σ²_b) = semicircle(σ²_a+σ²_b)
//
// Gaussian distribution (σ²): R_G(z) = σ²·z  (same R-transform as semicircle!)
//   → 1st and 2nd cumulants (mean, variance) identical for free and classical at this order
//   → DIFFERENCE is in 4th MOMENT (and higher free cumulants):
//
//   Wigner  m₄ = C₂ · (σ²)² = 2σ⁴       (Catalan number C₂ = 2)
//   Gaussian m₄ = 3 · σ⁴                 (Isserlis/Wick theorem)
//
//   For σ²=2 (free convolution of two σ²=1 distributions):
//   Wigner  m₄ = 2 × 4 = 8
//   Gaussian m₄ = 3 × 4 = 12
//   Distinction = 12 - 8 = 4  ← the "price" of non-commutativity
//
// IrFreeConvolve lowering: 2 VADDPD (val + sigma_sq).  The dist_class annotation in
// imm_flags bit 1 enables the compiler's epistemic tracker to use correct 4th-moment
// propagation for downstream gates.
//
// Formal guarantee: FreeConvolveRTransform.lean
//   `r_transform_semicircle` — R_{W_σ²}(z) = σ²·z
//   `r_transform_additive`   — R_{a⊞b}(z) = R_a(z) + R_b(z) → σ²_out = σ²_a + σ²_b
//   `m4_wigner_vs_gaussian`  — m₄ distinguishes free from classical at σ²_out

fn main() -> i64 with IO {
    // Two Knowledge values with Wigner semicircle distribution, σ² = 1.0 each
    let sigma_sq_a: f64 = 1.0
    let sigma_sq_b: f64 = 1.0
    let mean_a: f64 = 0.0
    let mean_b: f64 = 0.0

    // Free convolution (IrFreeConvolve / R-transform additivity):
    let free_mean_out: f64 = mean_a + mean_b            // 0.0
    let free_sigma_sq_out: f64 = sigma_sq_a + sigma_sq_b  // 2.0

    // 4th moment of free convolution result (Wigner semicircle with σ²=2):
    //   m₄ = C₂ × (σ²_out)²  where C₂ = 2 (Catalan number)
    let catalan_2: f64 = 2.0
    let free_m4: f64 = catalan_2 * free_sigma_sq_out * free_sigma_sq_out  // 2.0 × 4.0 = 8.0

    // What a WRONG Gaussian (classical) model would give for the same σ²:
    //   m₄ = 3 × (σ²_out)²  (Isserlis theorem for Gaussian, classical independence)
    let gaussian_m4: f64 = 3.0 * free_sigma_sq_out * free_sigma_sq_out   // 3.0 × 4.0 = 12.0

    // The compiler distinction: using classical model for a freely-independent pair
    // overestimates the 4th moment by this amount:
    let m4_overestimate: f64 = gaussian_m4 - free_m4   // 12.0 - 8.0 = 4.0

    // R-transform verification: for Wigner W_{σ²}, R_W(z) = σ²·z
    // At z = 1.0: R_a(1) = σ²_a = 1.0, R_b(1) = 1.0, R_out(1) = 2.0 = σ²_out ✓
    let r_transform_at_1_a: f64 = sigma_sq_a   // R_a(1) = σ²_a · 1 = 1.0
    let r_transform_at_1_b: f64 = sigma_sq_b   // R_b(1) = σ²_b · 1 = 1.0
    let r_transform_at_1_out: f64 = r_transform_at_1_a + r_transform_at_1_b  // 2.0 = σ²_out

    // Print
    print_f64(free_sigma_sq_out)      // 2.0 — free convolution variance (R-transform)
    print_char(10)
    print_f64(free_m4)                // 8.0 — Wigner 4th moment (C₂ × σ⁴ = 2×4)
    print_char(10)
    print_f64(gaussian_m4)            // 12.0 — classical Gaussian 4th moment (3σ⁴)
    print_char(10)
    print_f64(m4_overestimate)        // 4.0 — cost of wrong distribution_class
    print_char(10)
    print_f64(r_transform_at_1_out)   // 2.0 — R-transform additivity verified at z=1
    print_char(10)
    0
}
