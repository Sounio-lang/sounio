// Native-v2 science spine: Knowledge<f64>-shaped struct values through stage1.
// This is a stage1-native witness for value/uncertainty/confidence propagation.

struct KnowledgeF64 {
    value: f64,
    uncertainty: f64,
    confidence: f64,
}

fn measure_f64(value: f64, uncertainty: f64, confidence: f64) -> KnowledgeF64 {
    KnowledgeF64 { value: value, uncertainty: uncertainty, confidence: confidence }
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { return a }
    b
}

fn knowledge_add(a: KnowledgeF64, b: KnowledgeF64) -> KnowledgeF64 {
    KnowledgeF64 {
        value: a.value + b.value,
        uncertainty: a.uncertainty + b.uncertainty,
        confidence: min_f64(a.confidence, b.confidence),
    }
}

fn main() -> i64 with IO {
    let a = measure_f64(10.0, 0.3, 0.8)
    let b = measure_f64(20.0, 0.4, 0.6)
    let sum = knowledge_add(a, b)
    if sum.value != 30.0 { return 1 }
    if sum.uncertainty != 0.7 { return 2 }
    if sum.confidence != 0.6 { return 3 }
    print_int(42)
    print_char(10)
    0
}
