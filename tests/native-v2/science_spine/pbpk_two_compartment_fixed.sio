// Native-v2 science spine: deterministic fixed-point two-compartment PBPK smoke.
// Amounts are scaled integer units. Rates are per-mille per step.

struct Compartments {
    central: i64,
    tissue: i64,
}

fn step_pbpk(state: Compartments, clearance_permille: i64, exchange_permille: i64) -> Compartments {
    let cleared = (state.central * clearance_permille) / 1000
    let to_tissue = (state.central * exchange_permille) / 1000
    let to_central = (state.tissue * exchange_permille) / 1000
    Compartments {
        central: state.central - cleared - to_tissue + to_central,
        tissue: state.tissue + to_tissue - to_central,
    }
}

fn main() -> i64 with IO, Mut, Div {
    var state = Compartments { central: 100000, tissue: 0 }
    var i: i64 = 0
    while i < 8 {
        state = step_pbpk(state, 45, 120)
        i = i + 1
    }
    print_int(state.central)
    print_char(32)
    print_int(state.tissue)
    print_char(10)
    0
}
