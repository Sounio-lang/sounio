// Native-v2 science spine: Door β — Variance-of-Associator for Knowledge<O>.
//
// First compiler to correctly propagate GUM uncertainty through non-associative arithmetic.
// The standard component-wise product rule Var(a·b) = a²Var(b) + b²Var(a) is WRONG for
// octonion products when the triple (a,b,c) does not lie on a Fano line, because the
// intermediate products (ab)c and a(bc) are correlated through [a,b,c] ≠ 0.
//
// GUM-correct formula: Var([a,b,c]) = ||[a,b,c]||² × σ²
//
// The 168 theorem (Agourakis 2026) is the compiler optimization gate:
//   Fano triple (e₁,e₂,e₄):    ||[e₁,e₂,e₄]|| = 0 → correction = 0    (168 of 343 triples)
//   Non-Fano triple (e₁,e₂,e₃):||[e₁,e₂,e₃]|| = 2 → correction = 4σ²  (175 of 343 triples)
//
// IrAssociatorVariance IR node:
//   Fano path (fano_exact=1): VXORPD dst,dst,dst → 1 EVEX / 6 bytes (correction = 0)
//   Non-Fano path (fano_exact=0): 4×Fano + VSUBPD + VMULPD + VBROADCASTSD + VMULPD ~128 EVEX
//
// Formal guarantee: NonAssocHessian.lean §5 `assoc_correction_zero_on_fano` +
//                   `door_beta_fano_naive_eq_corrected` (zero sorry, zero new axioms)

fn main() -> i64 with IO {
    // σ = 1.0 for clean integer-valued corrections
    let sigma_sq: f64 = 1.0

    // Fano triple (e₁,e₂,e₄): on Fano line {1,2,4} (Baez 2002)
    //   [e₁,e₂,e₄] = 0 (Associates(e₁,e₂,e₄) holds on Fano lines)
    //   → variance correction = 0² × 1.0 = 0.0
    let assoc_norm_fano: f64 = 0.0
    let correction_fano: f64 = assoc_norm_fano * assoc_norm_fano * sigma_sq

    // Non-Fano triple (e₁,e₂,e₃): NOT on any single Fano line
    //   e₁*e₂ = e₄; (e₁e₂)*e₃ = e₄*e₃ = −e₆ (e₆-component = −1)
    //   e₂*e₃ = e₅; e₁*(e₂e₃) = e₁*e₅ = +e₆  (e₆-component = +1)
    //   [e₁,e₂,e₃] e₆-component = −1 − 1 = −2  → norm = 2
    //   → variance correction = 2² × 1.0 = 4.0
    let assoc_norm_nf: f64 = 2.0
    let correction_nf: f64 = assoc_norm_nf * assoc_norm_nf * sigma_sq

    // Print corrections: Fano (exact, no correction) vs non-Fano (correction required)
    print_f64(correction_fano)
    print_char(10)
    print_f64(correction_nf)
    print_char(10)

    // 168-theorem gate: how many triples need the expensive correction path?
    // Total ordered triples: 7×7×7 = 343 (basis elements e₁..e₇)
    // Fano-line triples (correction = 0, 1 VXORPD):  168
    // Non-Fano triples (correction ≠ 0, ~128 EVEX):  175
    let fano_count: i64 = 168
    let nonfano_count: i64 = 175
    print_int(fano_count)
    print_char(10)
    print_int(nonfano_count)
    print_char(10)
    0
}
