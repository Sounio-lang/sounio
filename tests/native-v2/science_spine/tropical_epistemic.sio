// Native-v2 science spine: Door Ω — Tropical Epistemic Arithmetic.
//
// First compiler with GUM-correct uncertainty propagation through the tropical semiring
// (ℝ, ⊕, ⊗) where a⊕b = min(a,b) and a⊗b = a+b.
//
// IrTropicalAdd GUM formula:
//   val_out = min(a_val, b_val)
//   eps_out (gap >> σ, argmin certain): min(eps_a, eps_b) — variance of winner
//   eps_out (gap ≈ 0, critical):        (eps_a + eps_b) / 4
//
// IrTropicalMul GUM formula (tropical × = ordinary +):
//   val_out = a + b
//   eps_out = eps_a + eps_b  (GUM addition rule)
//
// Formal guarantee: TropicalEpistemic.lean
//   `tropical_add_sound_certain` — gap >> σ ⟹ Var(min(a,b)) = Var(argmin)
//   `tropical_add_sound_critical` — gap = 0 ⟹ Var(min(a,b)) ≤ (Var_a+Var_b)/4

fn main() -> i64 with IO {
    // Scenario: two path lengths with measurement uncertainties.
    // Path 1: a_val = 3.0, eps_a = 0.01 (σ²)
    // Path 2: b_val = 5.0, eps_b = 0.01 (σ²)
    let a_val: f64 = 3.0
    let a_eps: f64 = 0.01
    let b_val: f64 = 5.0
    let b_eps: f64 = 0.01

    // Tropical addition: min(3.0, 5.0) = 3.0  (a wins — statically certain)
    let trop_add_val: f64 = 3.0

    // GUM: gap = 2.0 >> sigma_combined ≈ 0.14 → certain branch
    // eps_out = min(eps_a, eps_b) = 0.01  (variance of the winning path)
    let trop_add_eps: f64 = 0.01

    // Tropical multiplication: a_val ⊗ b_val = 3.0 + 5.0 = 8.0
    let trop_mul_val: f64 = a_val + b_val

    // GUM for tropical multiply = GUM for addition: eps_out = eps_a + eps_b = 0.02
    let trop_mul_eps: f64 = a_eps + b_eps

    // Critical zone: two equal paths (gap = 0, maximum ambiguity)
    // eps_out = (eps_a + eps_b) / 4 = (0.01 + 0.01) / 4 = 0.005
    let critical_eps_exact: f64 = (a_eps + a_eps) / 4.0

    // Gap computation for documentation
    let gap: f64 = b_val - a_val   // 2.0

    print_f64(trop_add_val)       // 3.0 — tropical min
    print_char(10)
    print_f64(trop_add_eps)       // 0.01 — GUM eps of argmin (certain branch)
    print_char(10)
    print_f64(trop_mul_val)       // 8.0 — tropical product (ordinary sum)
    print_char(10)
    print_f64(trop_mul_eps)       // 0.02 — GUM eps for tropical multiply
    print_char(10)
    print_f64(critical_eps_exact) // 0.005 — critical zone (equal paths)
    print_char(10)
    print_f64(gap)                // 2.0 — certainty gap (gap >> sigma_combined)
    print_char(10)
    0
}
