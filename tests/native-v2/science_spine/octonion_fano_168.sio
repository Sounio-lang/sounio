// Native-v2 science spine: Fano-plane combinatorics for octonion basis triples.
// There are 7 imaginary units, 6 ordered partners per unit, and 4 ordered
// non-collinear third choices per ordered pair: 7 * 6 * 4 = 168.

fn main() -> i64 with IO, Mut {
    var count: i64 = 0
    var i: i64 = 1
    while i < 8 {
        var j: i64 = 1
        while j < 8 {
            if i != j {
                var k: i64 = 0
                while k < 4 {
                    count = count + 1
                    k = k + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    print_int(count)
    print_char(10)
    0
}
