// Native-v2 driver test: for-in array iteration
// Expected: prints "100", exit 0

fn main() -> i64 with IO, Mut, Panic, Div {
    var arr: [i64; 4] = [10; 4]
    arr[1] = 20
    arr[2] = 30
    arr[3] = 40

    var sum: i64 = 0
    for x in arr {
        sum = sum + x
    }
    print_int(sum)
    print_char(10)
    0
}
