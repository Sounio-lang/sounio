// Native-v2 science spine: Quaternion Julia set — escape-time verification.
// IrFractalEscape: first compiler primitive for hypercomplex fractal iteration.
// Algebra-specialized codegen: compile-time algebra dispatch, no virtual dispatch in loop.
//
// Test point z0 = (1.5, 0, 0, 0), c = (-0.2, 0.8, 0, 0), escape radius = 2.0.
// For z0 = (r, 0, 0, 0): z0² = (r², 0, 0, 0)  (real quaternion, squaring is scalar).
// Iteration 1: z1 = z0² + c = (r²-0.2, 0.8, 0, 0)
//   |z1|² = (r²-0.2)² + 0.64  for r=1.5: = (2.25-0.2)² + 0.64 = 2.05² + 0.64 = 4.8425
//   4.8425 > 4.0 → escaped after 1 iteration ✓
//
// EscapeData epistemic return: basin_confidence = u_radius / sqrt(2 * iters)
//   u_radius = 0.01 (1% uncertainty on escape radius 2.0)
//   iters_approx = 1 → basin_conf = 0.01 / sqrt(2) ≈ 0.007071
//
// NB: stage1 left-to-right parser; explicit let bindings for all multi-op f64 chains.

fn sqrt_f64(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    var i = 0
    while i < 24 {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    return guess
}

fn main() -> i64 with IO, Mut, Div {
    // Quaternion iteration step for z0 = (1.5, 0, 0, 0), c = (-0.2, 0.8, 0, 0)
    // z0 is real (x=y=z=0), so z0² = (1.5², 0, 0, 0) exactly
    let z0w: f64 = 1.5
    let z0_sq_w: f64 = z0w * z0w   // 2.25

    // z1 = z0² + c
    let z1w: f64 = z0_sq_w - 0.2  // 2.05
    let z1x: f64 = 0.8            // 0 + 0.8

    // |z1|² = z1w² + z1x² (y=z=0)
    let z1w_sq: f64 = z1w * z1w   // 2.05² = 4.2025
    let z1x_sq: f64 = z1x * z1x  // 0.64
    let norm_sq: f64 = z1w_sq + z1x_sq  // 4.8425 > 4.0 → escaped

    var escaped: i64 = 0
    if norm_sq > 4.0 { escaped = 1 }

    // GUM: basin_confidence = u_radius / sqrt(2 * iters_taken)
    // iters_taken = 1, u_radius = 0.01
    let u_radius: f64 = 0.01
    let two: f64 = 2.0
    let sqrt_two = sqrt_f64(two)
    let basin_conf: f64 = u_radius / sqrt_two

    print_int(escaped)
    print_char(10)
    print_f64(basin_conf)
    print_char(10)
    0
}
