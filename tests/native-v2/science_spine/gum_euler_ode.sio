// Native-v2 science spine: GUM-through-ODE.
// Demonstrates ISO JCGM 100:2008 GUM uncertainty propagation *through* an
// Euler derivative step — not just carried, but computed from rate uncertainty.
// Single-compartment exponential decay: dx/dt = -k * x
// GUM for flux = k*x: u_flux = sqrt((u_k * x)^2 + (k * u_x)^2)
// GUM for state update (subtraction): u_new = sqrt(u_x^2 + (dt * u_flux)^2)

fn sqrt_f64(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    var i = 0
    while i < 24 {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    return guess
}

struct KnowledgeF64 {
    value: f64,
    uncertainty: f64,
    confidence: f64,
}

// GUM step: k=0.100, u_k=0.005, dt=1.0 baked in.
// u_flux = sqrt((u_k*x)^2 + (k*u_x)^2); u_new = sqrt(u_x^2 + u_flux^2)
// NB: stage1 is left-to-right; all multi-op chains use explicit let bindings.
fn step_euler(x: KnowledgeF64) -> KnowledgeF64 with Mut, Div {
    let flux_val = 0.1 * x.value
    let term1 = 0.005 * x.value
    let term2 = 0.1 * x.uncertainty
    let t1sq = term1 * term1
    let t2sq = term2 * term2
    let sum_sq = t1sq + t2sq
    let u_flux = sqrt_f64(sum_sq)
    let new_val = x.value - flux_val
    let unc_sq = x.uncertainty * x.uncertainty
    let uflux_sq = u_flux * u_flux
    let sum2 = unc_sq + uflux_sq
    let new_u = sqrt_f64(sum2)
    KnowledgeF64 { value: new_val, uncertainty: new_u, confidence: x.confidence }
}

fn main() -> i64 with IO, Mut, Div {
    var state = KnowledgeF64 { value: 100.0, uncertainty: 2.0, confidence: 0.9 }
    var i: i64 = 0
    while i < 5 {
        state = step_euler(state)
        i = i + 1
    }
    print_f64(state.value)
    print_char(10)
    print_f64(state.uncertainty)
    print_char(10)
    print_f64(state.confidence)
    print_char(10)
    0
}
