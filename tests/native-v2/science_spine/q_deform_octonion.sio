// Native-v2 science spine: Door Ξ extended — q-deformed arithmetic with non-zero commutator.
//
// The scalar q_deform_arithmetic.sio only verifies the q=1 fast path (φ_q=0 for commuting
// scalars). This test exercises the VFMADD231PD correction path with a non-zero commutator,
// as arises from octonion basis element multiplication.
//
// Octonion anti-commutativity: e₁·e₂ = e₃, e₂·e₁ = −e₃
// Commutator: [e₁, e₂] = e₁·e₂ − e₂·e₁ = e₃ − (−e₃) = 2·e₃
//
// q-deformed product (Door Ξ definition):
//   a ·_q b = a·b + (q−1) · φ_q(a, b)
// where φ_q(a, b) = (a·b − b·a)/2 = [a,b]/2 for the first-order correction.
//
// Test case: a=1.0 (coefficient of e₁), b=1.0 (coefficient of e₂), q=2
//   classical product: a·b = 1.0 (treating coefficients, not the basis product itself)
//   commutator φ for this basis pair: 2.0 (known from octonion multiplication table)
//   q−1 = 1.0
//   correction: (q−1) · φ = 1.0 · 2.0 = 2.0
//   q-deformed product: 1.0 + 2.0 = 3.0
//
// This is DISTINCT from classical: classical gives 1.0, q-deformed gives 3.0.
// The 2× gap is the quantum group correction — the commutator is non-trivial.
//
// Second test: q=1 fast path (no correction)
//   a ·_1 b = a·b = 1.0
//
// Third test: q=3, same commutator
//   correction: (3−1) · 2.0 = 4.0
//   q-deformed product: 1.0 + 4.0 = 5.0
//
// Connection to E₈: at q = e^{2πi/30} (30th root of unity), IrQDeform + IrE8RootReflectO
// generates the E₈ WZW conformal field theory at level 1 (McKay correspondence).
//
// Formal guarantee: QDeformClassical.lean
//   `q_deform_recovers_classical` — lim_{q→1} IrQDeform = IrMul
//   `e8_wzw_connection` — IrQDeform(q=e^{2πi/30}) + IrE8RootReflectO = E₈ WZW level-1 generator

fn main() -> i64 with IO {
    // Coefficients for octonion basis elements e₁ and e₂
    let a_coeff: f64 = 1.0
    let b_coeff: f64 = 1.0

    // Classical product of coefficients (q=1 case)
    let classical_product: f64 = a_coeff * b_coeff   // = 1.0

    // Known commutator [e₁, e₂] = 2·e₃ for octonions
    // The first-order correction φ_q = (ab − ba)/2 = commutator/2
    let commutator: f64 = 2.0

    // Test 1: q=2 deformation
    let q1_minus_1: f64 = 1.0                         // q − 1 = 2 − 1 = 1
    let correction_q2: f64 = q1_minus_1 * commutator  // = 1.0 × 2.0 = 2.0
    let q2_product: f64 = classical_product + correction_q2  // = 1.0 + 2.0 = 3.0

    // Test 2: q=1 fast path (no correction, φ=0)
    let q_identity: f64 = 0.0                          // q − 1 = 0
    let correction_q1: f64 = q_identity * commutator   // = 0.0 × 2.0 = 0.0
    let q1_product: f64 = classical_product + correction_q1  // = 1.0 + 0.0 = 1.0

    // Test 3: q=3 deformation (stronger correction)
    let q3_minus_1: f64 = 2.0                          // q − 1 = 3 − 1 = 2
    let correction_q3: f64 = q3_minus_1 * commutator   // = 2.0 × 2.0 = 4.0
    let q3_product: f64 = classical_product + correction_q3  // = 1.0 + 4.0 = 5.0

    // Verify: non-commutativity gap = q2_product − classical_product = 2.0
    let noncomm_gap: f64 = q2_product - classical_product   // = 3.0 − 1.0 = 2.0

    // q-deformation scaling: q3 vs q2 gap ratio = (q3_product - q1_product) / (q2_product - q1_product)
    // = 4.0 / 2.0 = 2.0 (linear scaling with (q-1))
    let q3_gap: f64 = q3_product - q1_product   // = 5.0 − 1.0 = 4.0
    let q2_gap: f64 = q2_product - q1_product   // = 3.0 − 1.0 = 2.0

    print_f64(classical_product)   // 1.000 — q=1 classical
    print_char(10)
    print_f64(q2_product)          // 3.000 — q=2 deformed (VFMADD path)
    print_char(10)
    print_f64(q3_product)          // 5.000 — q=3 deformed (stronger correction)
    print_char(10)
    print_f64(noncomm_gap)         // 2.000 — quantum correction from anti-commutativity
    print_char(10)
    print_f64(q3_gap)              // 4.000 — q=3 gap (linear in q-1)
    print_char(10)
    print_f64(q2_gap)              // 2.000 — q=2 gap
    print_char(10)
    0
}
