// Native-v2 science spine: Door Φ — Wasserstein Distance + Ollivier-Ricci Curvature.
//
// First compiler where W₁ (Earth Mover's Distance) and Ollivier-Ricci Curvature (ORC)
// are IR primitives. Sounio could model distributions (Knowledge<T>) but could not
// COMPARE them. W₁ is the canonical metric on probability distributions.
//
// W₁(N(μ_a,σ²_a), N(μ_b,σ²_b)) ≈ |μ_a - μ_b| + |σ_a - σ_b|  (1D Gaussian approx)
//   where σ_i = sqrt(σ²_i).
//
// Ollivier-Ricci curvature (ORC):
//   κ(x,y) = 1 − W₁(mₓ, mᵧ) / d(x,y)
// κ > 0: positive curvature (well-connected, fast mixing)
// κ = 0: flat (Euclidean-like)
// κ < 0: negative curvature (bottleneck)
//
// Research connection: Paper 4 (Brain ORC + Associator Field) computes ORC on
// ABIDE-I connectomes. Making ORC an IR primitive means the compiler certifies
// ORC-based claims about brain graph topology at compile time.
//
// IrWassersteinDist lowering: 10 EVEX (VSUBPD×4, VSQRTPD×2, VMAXPD×2, VADDPD×2)
// IrORC lowering: IrWassersteinDist inline + VMULPD + VBROADCASTSD + VSUBPD
//
// Formal guarantees: WassersteinORC.lean
//   `wasserstein_triangle_inequality` — W₁(P,R) ≤ W₁(P,Q) + W₁(Q,R)
//   `orc_positive_implies_mixing_bound` — κ > 0 → mixing time ≤ 1/(κ·n)
//   `gum_wasserstein_bound` — Δ(W₁) ≤ ½(Δσ_P + Δσ_Q) under Gaussian approx

fn sqrt_f64(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    var i = 0
    while i < 24 {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    return guess
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn w1_gaussian(mu_a: f64, sigma_sq_a: f64, mu_b: f64, sigma_sq_b: f64) -> f64 with Mut, Div {
    let sigma_a = sqrt_f64(sigma_sq_a)
    let sigma_b = sqrt_f64(sigma_sq_b)
    let mean_diff = abs_f64(mu_a - mu_b)
    let sigma_diff = abs_f64(sigma_a - sigma_b)
    mean_diff + sigma_diff
}

fn main() -> i64 with IO, Mut, Div {
    // ─── Test 1: Flat geometry — κ = 0 ───────────────────────────────────────
    // Node x: μ=0.0, σ²=1.0  Node y: μ=1.0, σ²=1.0  d(x,y)=1.0
    // W₁ = |0-1| + |1-1| = 1.0 + 0.0 = 1.0
    // κ = 1 - 1.0/1.0 = 0.0  (flat: distributions differ only in mean by exactly d)
    let w1_flat: f64 = w1_gaussian(0.0, 1.0, 1.0, 1.0)  // 1.0
    let kappa_flat: f64 = 1.0 - w1_flat / 1.0            // 0.0

    // ─── Test 2: Maximally positive curvature — κ = 1 ────────────────────────
    // Identical distributions → W₁ = 0 → κ = 1.0
    // Perfectly connected: any path is equivalent (no information gradient)
    let w1_identical: f64 = w1_gaussian(0.5, 1.0, 0.5, 1.0)  // 0.0
    let kappa_identical: f64 = 1.0 - w1_identical / 1.0       // 1.0

    // ─── Test 3: Positive curvature — κ = 0.5 ────────────────────────────────
    // Node x: μ=0.0, σ²=1.0  Node y: μ=0.5, σ²=1.0  d=1.0
    // W₁ = |0-0.5| + |1-1| = 0.5 + 0.0 = 0.5
    // κ = 1 - 0.5/1.0 = 0.5  (positive curvature — well-connected region)
    // This models a brain hub: nearby distributions → small W₁ → κ > 0
    let w1_pos: f64 = w1_gaussian(0.0, 1.0, 0.5, 1.0)  // 0.5
    let kappa_pos: f64 = 1.0 - w1_pos / 1.0             // 0.5

    // ─── Test 4: Triangle inequality ─────────────────────────────────────────
    // P=(μ=0,σ²=1), Q=(μ=1,σ²=1), R=(μ=2,σ²=1) — collinear in mean space
    // W₁(P,Q) = 1.0, W₁(Q,R) = 1.0, W₁(P,R) = 2.0
    // Triangle: W₁(P,R) ≤ W₁(P,Q) + W₁(Q,R) = 2.0 → slack = 0.0 (equality)
    let w1_pq: f64 = w1_gaussian(0.0, 1.0, 1.0, 1.0)   // 1.0
    let w1_qr: f64 = w1_gaussian(1.0, 1.0, 2.0, 1.0)   // 1.0
    let w1_pr: f64 = w1_gaussian(0.0, 1.0, 2.0, 1.0)   // 2.0
    let pq_qr_sum: f64 = w1_pq + w1_qr
    let triangle_slack: f64 = pq_qr_sum - w1_pr         // 0.0 (tight at collinear)

    // ─── Test 5: GUM bound verification ─────────────────────────────────────
    // Δ(W₁) ≤ Δσ_a + Δσ_b (conservative GUM bound for W₁ uncertainty)
    // With eps_a = eps_b = 0.5: Δ(W₁) ≤ 0.5 + 0.5 = 1.0
    let eps_a: f64 = 0.5
    let eps_b: f64 = 0.5
    let gum_w1_bound: f64 = eps_a + eps_b   // 1.0 (conservative GUM bound)

    print_f64(w1_flat)          // 1.0 — W₁ for flat geometry
    print_char(10)
    print_f64(kappa_flat)       // 0.0 — ORC flat (κ=0)
    print_char(10)
    print_f64(w1_identical)     // 0.0 — W₁ = 0 for identical distributions
    print_char(10)
    print_f64(kappa_identical)  // 1.0 — ORC maximally positive (κ=1)
    print_char(10)
    print_f64(w1_pos)           // 0.5 — W₁ for positive curvature case
    print_char(10)
    print_f64(kappa_pos)        // 0.5 — ORC positive (κ=0.5)
    print_char(10)
    print_f64(w1_pr)            // 2.0 — W₁(P,R) = W₁(P,Q) + W₁(Q,R)
    print_char(10)
    print_f64(triangle_slack)   // 0.0 — triangle inequality tight
    print_char(10)
    print_f64(gum_w1_bound)     // 1.0 — GUM bound with eps=0.5
    print_char(10)

    // ─── Test 6: Negative curvature — κ = −0.5 ───────────────────────────────
    // Node pair: μ_a=0.0, σ²_a=1.0, μ_b=0.5, σ²_b=4.0  d(x,y)=1.0
    // W₁ = |0.0−0.5| + |√1.0 − √4.0| = 0.5 + |1.0−2.0| = 0.5 + 1.0 = 1.5
    // κ = 1 − 1.5/1.0 = −0.5  (bottleneck: slow-mixing, negative curvature)
    // Brain interpretation: disconnected region between two community clusters
    // print_f64 fix validated this path — negative output now emits "-0.500"
    let w1_bottleneck: f64 = w1_gaussian(0.0, 1.0, 0.5, 4.0)  // 1.5
    let kappa_bottleneck: f64 = 1.0 - w1_bottleneck / 1.0      // -0.5

    print_f64(w1_bottleneck)     // 1.500 — W₁ for bottleneck geometry
    print_char(10)
    print_f64(kappa_bottleneck)  // -0.500 — ORC negative (κ<0, bottleneck)
    print_char(10)
    0
}
