//@ run-pass

use parser::ast::{Name}
use ir::ir::{IrFunction, ir_empty_function}

struct NameCarrier {
    name: Name,
}

fn make_carrier() -> Box<NameCarrier> with Mut, Alloc {
    var buf: [i8; 128] = [0; 128]
    buf[0 as usize] = 109 as i8
    Box::new(NameCarrier { name: Name { buf: buf, len: 1 } })
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let carrier = make_carrier()
    var func = ir_empty_function()
    func.name = (*carrier).name
    if func.name.buf[0 as usize] as i64 == 109 {
        print("RESULT: irfunction name field copy stable\n")
        return 0
    }
    print("RESULT: irfunction name field copy corrupt\n")
    print_int(func.name.buf[0 as usize] as i64)
    print("\n")
    1
}
