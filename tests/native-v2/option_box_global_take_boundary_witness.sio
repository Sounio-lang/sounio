//@ run-pass

struct TinyOptionPayload {
    value: i64,
}

var LAST_PAYLOAD: Option<Box<TinyOptionPayload>> = None

fn store_payload(v: i64) with Mut, Alloc {
    LAST_PAYLOAD = Some(Box::new(TinyOptionPayload { value: v }))
}

fn take_payload_box() -> Box<TinyOptionPayload> with Mut, Alloc {
    match LAST_PAYLOAD {
        Some(b) => {
            LAST_PAYLOAD = None
            b
        },
        None => {
            LAST_PAYLOAD = None
            Box::new(TinyOptionPayload { value: -1 })
        },
    }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    store_payload(77)
    let b = take_payload_box()
    let v = (*b).value
    if v == 77 {
        print("RESULT: option box global take boundary stable\n")
        return 0
    }
    print("RESULT: option box global take boundary corrupt\n")
    print_int(v)
    print("\n")
    1
}
