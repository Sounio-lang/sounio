//@ run-pass

struct TinyManyOpt {
    value: i64,
}

struct HolderManyOpt {
    a: Option<Box<TinyManyOpt>>,
    b: Option<Box<TinyManyOpt>>,
    c: Option<Box<TinyManyOpt>>,
    left: Option<Box<TinyManyOpt>>,
    d: Option<Box<TinyManyOpt>>,
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var h = HolderManyOpt {
        a: None,
        b: None,
        c: None,
        left: None,
        d: None,
    }
    let child = Box::new(TinyManyOpt { value: 222 })
    h.left = Some(child)
    match h.left {
        Some(v) => {
            if (*v).value == 222 {
                print("RESULT: local struct many option field assignment stable\n")
                return 0
            }
        },
        None => {},
    }
    print("RESULT: local struct many option field assignment corrupt\n")
    1
}
