use ir::arena_v2_shadow::*

fn fail(code: i64) -> i64 with IO {
    print("IR_STORAGE_IDENTITY_ARENA_V2_FAIL code=")
    print_int(code)
    print("\n")
    code
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var arena = ir_module_arena_v2_new(101, 501)
    let function_result = ir_module_arena_v2_add_function(&! arena, 77)
    if function_result.0 != IR_MODULE_ARENA_V2_OK { return fail(101) }

    // The handle stores identity, slot, and generation, but no reg_count.
    // This getter therefore performs a fresh lookup in the arena authority.
    let function_handle = function_result.1
    if ir_module_arena_v2_configure_function_reg_count(&! arena, &function_handle, 1) != IR_MODULE_ARENA_V2_OK {
        return fail(102)
    }
    let fresh_lookup = ir_module_arena_v2_function_reg_count(&arena, &function_handle)
    if fresh_lookup.0 != IR_MODULE_ARENA_V2_OK { return fail(103) }
    if fresh_lookup.1 != 1 { return fail(104) }

    print("IR_STORAGE_IDENTITY_ARENA_V2 operation=scalar_mutation_fresh_lookup mutation=1 observed=")
    print_int(fresh_lookup.1)
    print(" status=preserved\n")
    print("IR_STORAGE_IDENTITY_ARENA_V2_PASS\n")
    0
}
