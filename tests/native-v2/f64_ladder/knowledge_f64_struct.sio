struct KnowledgeF64 {
    value: f64,
    uncertainty: f64,
    confidence: f64,
}

fn knowledge_f64(value: f64, uncertainty: f64, confidence: f64) -> KnowledgeF64 {
    KnowledgeF64 { value: value, uncertainty: uncertainty, confidence: confidence }
}

fn add_knowledge_f64(a: KnowledgeF64, b: KnowledgeF64) -> KnowledgeF64 {
    knowledge_f64(a.value + b.value, a.uncertainty + b.uncertainty, a.confidence)
}

fn main() -> i64 with IO {
    let a = knowledge_f64(1.500, 0.250, 0.875)
    let b = knowledge_f64(2.250, 0.125, 0.750)
    let c = add_knowledge_f64(a, b)
    print_f64(c.value)
    print_char(10)
    print_f64(c.uncertainty)
    print_char(10)
    print_f64(c.confidence)
    print_char(10)
    0
}
