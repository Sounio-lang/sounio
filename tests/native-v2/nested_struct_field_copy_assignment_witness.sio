//@ run-pass
struct NestedNativeV2Data {
    bytes: [i8; 8192],
    len: i64,
    last_offset: i64,
}

struct NestedNativeV2Holder {
    data: NestedNativeV2Data,
    count: i64,
}

fn main() -> i64 with Mut {
    var h: NestedNativeV2Holder
    var d = h.data
    d.len = 8
    if d.len == 8 {
        return 0
    }
    return 1
}
