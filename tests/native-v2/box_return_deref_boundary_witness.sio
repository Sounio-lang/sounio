//@ run-pass

struct TinyBoxPayload {
    value: i64,
}

fn make_payload_box(v: i64) -> Box<TinyBoxPayload> with Alloc {
    Box::new(TinyBoxPayload { value: v })
}

fn read_payload_box(b: Box<TinyBoxPayload>) -> i64 {
    (*b).value
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let b = make_payload_box(42)
    let v = read_payload_box(b)
    if v == 42 {
        print("RESULT: box return deref boundary stable\n")
        return 0
    }
    print("RESULT: box return deref boundary corrupt\n")
    print_int(v)
    print("\n")
    1
}
