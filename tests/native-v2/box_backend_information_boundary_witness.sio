// Machine-IR boundary witness for Box<T> auto-deref.
//
// A field read enters this boundary with a field name and label_id, but the
// pseudo instruction retains only dst, base and field index. This proves that
// the backend cannot recover an erased Box<T> inner layout from Machine IR.

use parser::ast::{make_name}
use ir::ir::{ir_field_get}
use native::machine_ir::{MIR_OP_PSEUDO_FIELD_GET, native_v2_pseudo_from_ir}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var ir = ir_field_get(9, 4, 52, make_name("tag"))
    ir.label_id = 1

    let mir = native_v2_pseudo_from_ir(ir)
    print("opcode=")
    print_int(mir.opcode)
    print(" dst=")
    print_int(mir.dst.value)
    print(" base=")
    print_int(mir.src1.value)
    print(" idx=")
    print_int(mir.aux.value)
    print(" name_len=")
    print_int(mir.name.len)
    print(" cond=")
    print_int(mir.cond)
    print(" arg_index=")
    print_int(mir.arg_index)
    print("\n")

    if mir.opcode != MIR_OP_PSEUDO_FIELD_GET { return 10 }
    if mir.dst.value != 9 || mir.src1.value != 4 || mir.aux.value != 52 { return 11 }
    if mir.name.len != 0 { return 12 }
    if mir.cond != 0 || mir.arg_index != -1 { return 13 }
    print("BOX_BACKEND_INFORMATION_ERASED\n")
    0
}
