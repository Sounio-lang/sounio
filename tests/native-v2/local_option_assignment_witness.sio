//@ run-pass

struct TinyLocalOption {
    value: i64,
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var opt: Option<Box<TinyLocalOption>> = None
    opt = Some(Box::new(TinyLocalOption { value: 321 }))
    match opt {
        Some(v) => {
            print("branch=some value=")
            print_int((*v).value)
            print("\n")
            if (*v).value == 321 {
                print("RESULT: local option assignment stable\n")
                return 0
            }
        },
        None => {
            print("branch=none\n")
        },
    }
    print("RESULT: local option assignment corrupt\n")
    1
}
