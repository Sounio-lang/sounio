//@ run-pass

use lexer::span::{Span}
use parser::ast::{Expr, ExprKind}
use parser::parser::{mk_expr}

var LAST_EXPR_WITNESS: Option<Box<Expr>> = None

fn make_expr_value(v: i64) -> Expr with Mut {
    let span = Span { file_id: 0, start: 0, end: 0 }
    var e = mk_expr(ExprKind::ExprIntLit, span)
    e.int_val = v
    e
}

fn store_expr_value(v: i64) with Mut, Alloc {
    let e = make_expr_value(v)
    LAST_EXPR_WITNESS = Some(Box::new(e))
}

fn take_expr_box() -> Box<Expr> with Mut, Alloc {
    match LAST_EXPR_WITNESS {
        Some(e) => {
            LAST_EXPR_WITNESS = None
            e
        },
        None => {
            LAST_EXPR_WITNESS = None
            Box::new(make_expr_value(-1))
        },
    }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    store_expr_value(77)
    let e = take_expr_box()
    if (*e).kind == ExprKind::ExprIntLit && (*e).int_val == 77 {
        print("RESULT: option box expr payload boundary stable\n")
        return 0
    }
    print("RESULT: option box expr payload boundary corrupt\n")
    1
}
