//@ run-pass
// Native-v2 IR payload boundary witness.
//
// This keeps the root IR aggregate boundary separate from the MachineFunction
// boundary. If this fails, native-v2 lowering is receiving corrupt IR before it
// even writes MachineFunction storage.

use parser::ast::{BinaryOp}
use ir::ir::{IrFunction, IrOpcode, ir_empty_function}

fn check_ir_payload_code(func: &IrFunction) -> i64 with Mut, Panic, Div {
    if (*func).reg_count != 3 { return 1 }
    if (*func).instr_count != 2 { return 2 }
    if (*func).instrs[0].op != IrOpcode::IrBinOp { return 3 }
    if (*func).instrs[0].dst != 2 { return 4 }
    if (*func).instrs[0].src1 != 0 { return 5 }
    if (*func).instrs[0].src2 != 1 { return 6 }
    if (*func).instrs[0].bin_op != BinaryOp::OpAdd { return 7 }
    if (*func).instrs[1].op != IrOpcode::IrReturn { return 8 }
    if (*func).instrs[1].src1 != 2 { return 9 }
    0
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("native-v2 IR payload boundary witness\n")
    var func = ir_empty_function()
    func.reg_count = 3
    var i0 = func.instrs[0]
    i0.op = IrOpcode::IrBinOp
    i0.dst = 2
    i0.src2 = 1
    i0.bin_op = BinaryOp::OpAdd
    i0.src1 = 0
    func.instrs[0] = i0
    var i1 = func.instrs[1]
    i1.op = IrOpcode::IrReturn
    i1.src1 = 2
    func.instrs[1] = i1
    func.instr_count = 2

    let code = check_ir_payload_code(&func)
    if code == 0 {
        print("RESULT: IR payload boundary stable\n")
        return 0
    }

    print("failure_code=")
    print_int(code)
    print(" reg_count=")
    print_int(func.reg_count)
    print(" instr_count=")
    print_int(func.instr_count)
    print(" dst0=")
    print_int(func.instrs[0].dst)
    print(" src10=")
    print_int(func.instrs[0].src1)
    print(" src20=")
    print_int(func.instrs[0].src2)
    print(" src11=")
    print_int(func.instrs[1].src1)
    print("\n")
    print("RESULT: IR payload boundary corrupt\n")
    1
}
