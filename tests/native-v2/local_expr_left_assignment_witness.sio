//@ run-pass

use lexer::span::{Span}
use parser::ast::{Expr, ExprKind}
use parser::parser::{mk_expr}

fn make_int_expr(v: i64) -> Box<Expr> with Mut, Alloc {
    let span = Span { file_id: 0, start: 0, end: 0 }
    var e = mk_expr(ExprKind::ExprIntLit, span)
    e.int_val = v
    Box::new(e)
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let span = Span { file_id: 0, start: 0, end: 0 }
    var e: Expr = mk_expr(ExprKind::ExprReturn, span)
    let child = make_int_expr(88)
    e.left = Some(child)
    match e.left {
        Some(v) => {
            if (*v).kind == ExprKind::ExprIntLit && (*v).int_val == 88 {
                print("RESULT: local expr left assignment stable\n")
                return 0
            }
        },
        None => {},
    }
    print("RESULT: local expr left assignment corrupt\n")
    1
}
