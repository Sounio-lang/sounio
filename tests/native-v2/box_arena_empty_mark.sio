// A mark before lazy pool initialization must remain a usable empty token.
fn main() -> i64 with IO, Mut, Alloc, Panic {
    let empty = __arena_mark()
    let first = Box::new(17)
    if *first != 17 { return 1 }
    __arena_reset(empty)
    let next = Box::new(29)
    if *next != 29 { return 2 }
    println("BOX_ARENA_EMPTY_MARK_OK")
    0
}
