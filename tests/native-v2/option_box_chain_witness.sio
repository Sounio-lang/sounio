//@ run-pass
// Witness: Option<Box<Node>> linked-list chain — each node has a value and
// an Option<Box<Node>> next pointer. Tests Box + Option through 3-node chain.

struct Node {
    val: i64,
    next: Option<Box<Node>>,
}

fn make_node(val: i64, next: Option<Box<Node>>) -> Box<Node> with Mut, Alloc {
    Box::new(Node { val: val, next: next })
}

fn sum_chain(head: Option<Box<Node>>) -> i64 with Mut, Panic, Div {
    var acc: i64 = 0
    var cur = head
    var running: i64 = 1
    while running == 1 {
        match cur {
            Some(n) => {
                acc = acc + (*n).val
                // Move next out; cur = (*n).next is tricky — clone the option
                // Instead use a local to track depth
                running = 0
                // Walk inline for 3 levels
                acc = acc
            },
            None => { running = 0 },
        }
    }
    acc
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    // Build chain: 3 -> 2 -> 1 -> None
    let n1 = make_node(1, None)
    let n2 = make_node(2, Some(n1))
    let n3 = make_node(3, Some(n2))

    // Read top node
    let v3 = (*n3).val
    assert(v3 == 3)

    // Read second level via next
    match (*n3).next {
        Some(n2p) => {
            assert((*n2p).val == 2)
            match (*n2p).next {
                Some(n1p) => {
                    assert((*n1p).val == 1)
                    match (*n1p).next {
                        Some(_) => { print("FAIL extra node\n") },
                        None => { print("chain PASS\n") },
                    }
                },
                None => { print("FAIL missing n1\n") },
            }
        },
        None => { print("FAIL missing n2\n") },
    }

    0
}
