//@ run-pass

struct TinyLocalOpt {
    value: i64,
}

struct HolderLocalOpt {
    left: Option<Box<TinyLocalOpt>>,
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var h = HolderLocalOpt { left: None }
    h.left = Some(Box::new(TinyLocalOpt { value: 123 }))
    match h.left {
        Some(v) => {
            print("branch=some value=")
            print_int((*v).value)
            print("\n")
            if (*v).value == 123 {
                print("RESULT: local struct option field assignment stable\n")
                return 0
            }
        },
        None => {
            print("branch=none\n")
        },
    }
    print("RESULT: local struct option field assignment corrupt\n")
    1
}
