//@ run-pass

use parser::ast::{Block, FnDef, Name}
use lexer::span::{Span}
use ir::ir::{ir_empty_function}

var LAST_FN_WITNESS: Option<Box<FnDef>> = None

fn make_name() -> Name with Mut {
    var buf: [i8; 128] = [0; 128]
    buf[0 as usize] = 109 as i8
    Name { buf: buf, len: 1 }
}

fn make_fn_def() -> FnDef with Mut {
    let span = Span { file_id: 0, start: 0, end: 0 }
    FnDef {
        name: make_name(),
        params: None,
        return_type: None,
        effects: None,
        body: Block { stmts: None, span: span },
        span: span,
        is_kernel: false, is_extern: false,
    }
}

fn store_fn_def() with Mut, Alloc {
    let fd = make_fn_def()
    LAST_FN_WITNESS = Some(Box::new(fd))
}

fn take_fn_def_box() -> Box<FnDef> with Mut, Alloc {
    match LAST_FN_WITNESS {
        Some(fd) => {
            LAST_FN_WITNESS = None
            fd
        },
        None => {
            LAST_FN_WITNESS = None
            Box::new(make_fn_def())
        },
    }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    store_fn_def()
    let fd = take_fn_def_box()
    var func = ir_empty_function()
    func.name = (*fd).name
    match (*fd).params {
        Some(_p) => {
            print("RESULT: option box fndef payload params corrupt\n")
            return 2
        },
        None => {},
    }
    if func.name.buf[0 as usize] as i64 == 109 {
        print("RESULT: option box fndef payload boundary stable\n")
        return 0
    }
    print("RESULT: option box fndef payload boundary corrupt\n")
    print_int(func.name.buf[0 as usize] as i64)
    print("\n")
    1
}
