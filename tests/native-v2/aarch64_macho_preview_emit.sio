// native-v2 AArch64 Mach-O emission smoke
//
// Purpose: prove the narrow Apple Silicon preview emitter can produce a
// minimal arm64 macOS executable artifact without importing the full native
// codegen module.

use native::apple_arm64_preview::{apple_arm64_preview_write_scalar_exit}

fn main() -> i64 with IO, Alloc, Mut, Panic, Div {
    let target = "aarch64-macos"
    let out_path = "artifacts/omega/native_backend_v2_scalar_smoke.aarch64-macos.bin"
    let _target = target
    let len = apple_arm64_preview_write_scalar_exit(out_path, 13)
    if len <= 0 {
        print("aarch64_macho_preview_emit: binary_write_failed\n")
        return 4
    }

    print("aarch64_macho_preview_emit: wrote ")
    print(out_path)
    print(" bytes=")
    print_int(len)
    print("\n")
    0
}
