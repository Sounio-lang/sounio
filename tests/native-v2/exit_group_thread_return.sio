// Linux x86-64 regression, driven by scripts/ci/madaros_exit_group_thread_gate.sh.
// The DSO starts a pthread and waits for its readiness handshake. No CUDA or
// timing-dependent choice of main's return code is involved.
extern "C" {
    fn dlopen(filename: *mut u8, flags: i32) -> *mut u8
    fn dlsym(handle: *mut u8, symbol: *mut u8) -> *mut u8
}

fn main() -> i32 with IO, Alloc, Mut, Panic, Div {
    // libexit_group_probe.so\0
    let path = heap_alloc(24) as *mut i64
    write_i64(path, 0, 0x5f7469786562696c)
    write_i64(path, 1, 0x72705f70756f7267)
    write_i64(path, 2, 0x00006f732e65626f)
    // start_blocked_thread\0
    let sym = heap_alloc(24) as *mut i64
    write_i64(sym, 0, 0x6c625f7472617473)
    write_i64(sym, 1, 0x68745f64656b636f)
    write_i64(sym, 2, 0x0000000064616572)
    let h = dlopen(path as *mut u8, 1)
    if (h as i64) == 0 { return 2 }
    let raw = dlsym(h, sym as *mut u8)
    if (raw as i64) == 0 { return 3 }
    let start = raw as fn() -> i32
    if start() != 0 { return 4 }
    // DSO remains loaded while its pthread is blocked; do not dlclose it.
    println("THREAD_READY_RETURN_37")
    37
}
