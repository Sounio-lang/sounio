//@ run-pass

use lexer::span::{Span}
use parser::ast::{Expr, ExprKind}
use parser::parser::{mk_expr}

fn make_expr_box_local_opt(v: i64) -> Box<Expr> with Mut, Alloc {
    let span = Span { file_id: 0, start: 0, end: 0 }
    var e = mk_expr(ExprKind::ExprIntLit, span)
    e.int_val = v
    Box::new(e)
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var opt: Option<Box<Expr>> = None
    let child = make_expr_box_local_opt(444)
    opt = Some(child)
    match opt {
        Some(v) => {
            if (*v).kind == ExprKind::ExprIntLit && (*v).int_val == 444 {
                print("RESULT: local option box expr assignment stable\n")
                return 0
            }
        },
        None => {},
    }
    print("RESULT: local option box expr assignment corrupt\n")
    1
}
