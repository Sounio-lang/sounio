//@ run-pass

struct LargePayload {
    name: [i8; 128],
    len: i64,
    a: i64,
    b: i64,
    c: i64,
    d: i64,
    e: i64,
    f: i64,
    g: i64,
    h: i64,
    nested: Option<Box<TinyPayload>>,
}

struct TinyPayload {
    value: i64,
}

struct NameSink {
    name: [i8; 128],
}

var LAST_LARGE: Option<Box<LargePayload>> = None

fn make_large(v: i64) -> LargePayload with Mut, Alloc {
    var name: [i8; 128] = [0; 128]
    name[0 as usize] = 109 as i8
    LargePayload {
        name: name,
        len: 1,
        a: v,
        b: v + 1,
        c: v + 2,
        d: v + 3,
        e: v + 4,
        f: v + 5,
        g: v + 6,
        h: v + 7,
        nested: Some(Box::new(TinyPayload { value: 99 })),
    }
}

fn store_large(v: i64) with Mut, Alloc {
    let payload = make_large(v)
    LAST_LARGE = Some(Box::new(payload))
}

fn take_large_box() -> Box<LargePayload> with Mut, Alloc {
    match LAST_LARGE {
        Some(b) => {
            LAST_LARGE = None
            b
        },
        None => {
            LAST_LARGE = None
            Box::new(make_large(-1))
        },
    }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    store_large(42)
    let b = take_large_box()
    let first = (*b).name[0 as usize] as i64
    if first != 109 {
        print("RESULT: option box large payload corrupt name\n")
        print_int(first)
        print("\n")
        return 3
    }
    var sink = NameSink { name: [0; 128] }
    sink.name = (*b).name
    if sink.name[0 as usize] as i64 != 109 {
        print("RESULT: option box large payload corrupt name copy\n")
        return 4
    }
    let v = (*b).a
    if v != 42 {
        print("RESULT: option box large payload corrupt a\n")
        print_int(v)
        print("\n")
        return 1
    }
    match (*b).nested {
        Some(n) => {
            if (*n).value == 99 {
                print("RESULT: option box large payload boundary stable\n")
                return 0
            }
        },
        None => {},
    }
    print("RESULT: option box large payload corrupt nested\n")
    2
}
