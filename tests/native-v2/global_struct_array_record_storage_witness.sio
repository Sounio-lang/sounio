// Diagnostic witness for native-v2 global array-of-struct storage.
//
// Expected when fixed: exit 42.
// Current blocker observed in the Madaros lane: raw ./bin/souc compiles this
// source, but the emitted ELF exits 10 because RECORD_CELLS[0].name_hash is not
// preserved after storing a RecordCell into a global array slot.

struct RecordCell {
    name_hash: i64,
    kind: i64,
    target_hash: i64,
    value: i64,
    arity: i64,
}

fn record_cell_empty() -> RecordCell {
    RecordCell { name_hash: 0, kind: 0, target_hash: 0, value: 0, arity: 0 }
}

fn record_cell_make(name_hash: i64, kind: i64, target_hash: i64, value: i64, arity: i64) -> RecordCell {
    RecordCell { name_hash: name_hash, kind: kind, target_hash: target_hash, value: value, arity: arity }
}

var RECORD_CELLS: [RecordCell; 4] = [record_cell_empty(); 4]

fn record_cell_store(idx: i64, cell: RecordCell) with Mut, Panic {
    RECORD_CELLS[idx as usize] = cell
}

fn record_cell_load(idx: i64) -> RecordCell with Panic {
    RECORD_CELLS[idx as usize]
}

fn main() -> i64 with Mut, Panic {
    record_cell_store(0, record_cell_make(109, 11, 0, 0, 0))
    record_cell_store(1, record_cell_make(97, 30, 42, 7, 3))
    record_cell_store(2, record_cell_make(105, 29, 127, 255, 7))

    let a = record_cell_load(0)
    let b = record_cell_load(1)
    let c = record_cell_load(2)
    let d = record_cell_load(3)

    if a.name_hash != 109 { return 10 }
    if a.kind != 11 { return 11 }
    if a.target_hash != 0 { return 12 }
    if a.value != 0 { return 13 }
    if a.arity != 0 { return 14 }

    if b.name_hash != 97 { return 20 }
    if b.kind != 30 { return 21 }
    if b.target_hash != 42 { return 22 }
    if b.value != 7 { return 23 }
    if b.arity != 3 { return 24 }

    if c.name_hash != 105 { return 30 }
    if c.kind != 29 { return 31 }
    if c.target_hash != 127 { return 32 }
    if c.value != 255 { return 33 }
    if c.arity != 7 { return 34 }

    if d.name_hash != 0 { return 40 }
    if d.kind != 0 { return 41 }
    if d.target_hash != 0 { return 43 }
    if d.value != 0 { return 44 }
    if d.arity != 0 { return 45 }

    42
}
