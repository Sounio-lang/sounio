// Struct-variant pattern with a CONDITION sub-pattern (literal). The arm fires on
// tag-match alone, so the `x: 5` condition is never emitted -> at base this arm
// matched even though x is 7 (silent miscompile, exit 1 not 42). Now REJECTED in
// lower.sio: only plain-binding (E::C{x}) or wildcard (E::C{x:_}) field sub-patterns
// are sound. R1 closure for the binding code this round introduced.
enum E { A, C { x: i64, y: i64 } }
fn main() -> i64 {
    let e = E::C { x: 7, y: 35 };
    match e {
        E::C { x: 5, y } => 1,
        E::C { x, y } => x + y,
        E::A => 0,
    }
}
