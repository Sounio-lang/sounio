// Struct-variant pattern with WRONG field names (right count). The checker accepted
// this at base; the native-v2 binding reads each field by the pattern NAME's hashed
// slot, so wrong names read unwritten slots -> silent miscompile (exit 0 not 42).
// Now checker-REJECTED (field names validated against the variant's declared fields).
// R1 closure for the binding code this round introduced.
enum E { A, C { x: i64, y: i64 } }
fn main() -> i64 {
    let e = E::C { x: 7, y: 35 };
    match e {
        E::A => 0,
        E::C { a, b } => a + b,
    }
}
