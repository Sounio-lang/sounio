// Wildcard field sub-pattern E::C { x: _, y }: match-anything for x, bind y. This
// is sound (no condition imposed) and must compile -> y = 35.
enum E { A, C { x: i64, y: i64 } }
fn main() -> i64 {
    let e = E::C { x: 7, y: 35 };
    match e {
        E::C { x: _, y } => y,
        E::A => 0,
    }
}
