// Tagged struct variant passed as a fn param + second-arm dispatch: proves the
// tagged handle (pointer) survives the call ABI.
enum Shape { Circle { r: i64 }, Rect { w: i64, h: i64 } }
fn area(s: Shape) -> i64 {
    match s {
        Shape::Circle { r } => r * 3,
        Shape::Rect { w, h } => w * h,
    }
}
fn main() -> i64 { area(Shape::Rect { w: 6, h: 7 }) }
