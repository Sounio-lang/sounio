// == between two tagged-enum VARIABLES. The lowerer path-guard cannot catch this
// (both operands are idents), so the operand-type-based checker rejection closes
// it uniformly (no ELF).
enum E { A, C { x: i64, y: i64 } }
fn main() -> i64 {
    let a = E::A;
    let b = E::A;
    if a == b { 1 } else { 0 }
}
