// MANDATORY mixed-enum UNIT witness (representation-collision trap):
// E::A is a unit variant of the SAME tagged enum that has a struct variant C.
// If C were a tagged aggregate-pointer while A stayed bare-int, the "load tag
// from slot 64" dispatch would deref a bare int for A -> garbage/segfault.
// A correct uniform boxing makes the A arm return 7.
enum E { A, C { x: i64, y: i64 } }
fn main() -> i64 {
    let e = E::A;
    match e {
        E::A => 7,
        E::C { x, y } => x + y,
    }
}
