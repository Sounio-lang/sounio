// Three-phase modular liveness probe.
// Imports ir/, native/, and emit/ phase entries together, proving the
// module loader walks all three directory roots and the canonical phase
// namespaces are visible from a single program.
// (hlir/mod.sio is docstring-only; its impl files have not yet been pub'd
//  to library callers — separate sub-task.)

use ir::ir::*
use emit::mod::*
use native::mod::*

fn main() with IO, Mut, Panic, Div, Alloc {
    // ir/ phase
    let m: IrModule = ir_empty_module()

    // native/ phase (free fn — wildcard import unnecessary, just call qualified)
    let nat_ver = native_codegen_version()

    println("three-phase modular pipeline: ALIVE")
    print("  ir::ir::ir_empty_module().fn_count        = "); print_int(m.fn_count)
    print("  native::mod::native_codegen_version()     = "); print_int(nat_ver)

    // emit/ phase
    emit_set_silent(true)
    emit_module(m)
    emit_set_silent(false)
    println("  emit::mod::emit_module(m) returned cleanly")

    println("three phases composed and executed in one program.")
}
