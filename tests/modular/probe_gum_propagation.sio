// Deeper modular + SOTA probe.
// Exercises GUM uncertainty propagation through multiple ops, reads
// out `.value` AND `.variance`, confirms inline GUM codegen runs through
// the metrological compilation pipeline imported alongside a modular phase.

use emit::mod::*

fn main() with IO, Mut, Panic, Div, Alloc, Epistemic {
    emit_set_silent(false)

    // Two independent measurements with GUM uncertainties (variance = σ²).
    let mass: Knowledge<f64> = measure(500.0, uncertainty: 2.5)    // σ² = 6.25
    let dose: Knowledge<f64> = measure(120.0, uncertainty: 1.0)    // σ² = 1.0

    // Multi-op chain — each op propagates variance via the delta method.
    //   r1 = dose / mass        σ²(r1) = (1/m)² σ²(d) + (d/m²)² σ²(m)
    //   r2 = r1 + r1            σ²(r2) = 4 σ²(r1)          (correlated path)
    //   r3 = r2 - dose / mass
    let r1 = dose / mass
    let r2 = r1 + r1
    let r3 = r2 - dose / mass

    println("modular + SOTA frontier (GUM chain): ALIVE")
    print("  r1.value      = "); print_f64(r1.value); println("")
    print("  r1.variance   = "); print_f64(r1.variance); println("")
    print("  r2.value      = "); print_f64(r2.value); println("")
    print("  r2.variance   = "); print_f64(r2.variance); println("")
    print("  r3.value      = "); print_f64(r3.value); println("")
    print("  r3.variance   = "); print_f64(r3.variance); println("")
}
