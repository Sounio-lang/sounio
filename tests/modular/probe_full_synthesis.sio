// Full synthesis modular + SOTA probe.
// Combines: modular ir/ + native/ + emit/ phase imports AND the SOTA
// frontier (Knowledge<T> + measure + GUM propagation + .value gated by
// `with Epistemic`). Demonstrates that the metrological compilation
// pipeline runs alongside arbitrary modular-phase API calls in one
// linkage unit, without breaking either surface.

use ir::ir::*
use emit::mod::*
use native::mod::*

fn main() with IO, Mut, Panic, Div, Alloc, Epistemic {
    // ===================================================================
    // Modular surface
    // ===================================================================
    var m: IrModule = ir_empty_module()
    var f: IrFunction = ir_empty_function()
    f.param_count = 2
    f.reg_count = 32
    m.functions[0] = f
    m.fn_count = 1

    let codegen_ver = native_codegen_version()
    emit_set_silent(true)
    emit_module(m)
    emit_set_silent(false)

    // ===================================================================
    // SOTA frontier (Knowledge<T> + GUM)
    // ===================================================================
    // Pharmacokinetic toy: dose / clearance -> exposure, with measurement
    // uncertainties propagated through the divide.
    let dose: Knowledge<f64> = measure(120.0, uncertainty: 1.0)
    let clearance: Knowledge<f64> = measure(8.0, uncertainty: 0.4)
    let exposure = dose / clearance

    println("FULL SYNTHESIS — modular + SOTA: ALIVE")
    print("  modular ir::fn_count       = "); print_int(m.fn_count)
    print("  modular native::codegen v  = "); print_int(codegen_ver)
    print("  SOTA exposure.value        = "); print_f64(exposure.value); println("")
    print("  SOTA exposure.variance     = "); print_f64(exposure.variance); println("")
    println("  Knowledge<T> traversed the same linkage unit that imports modular phases.")
}
