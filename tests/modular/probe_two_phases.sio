// Two-phase modular liveness probe.
// Imports BOTH ir/ and emit/ phases, constructs an IrModule via the
// modular ir/ phase, then passes it to the modular emit/ phase.
// This is the smallest cross-phase end-to-end demonstration.

use ir::ir::*
use emit::mod::*

fn main() with IO, Mut, Panic, Div, Alloc {
    // Phase 1: modular ir/ phase produces an empty IrModule.
    let m: IrModule = ir_empty_module()

    println("two-phase modular pipeline: ALIVE")
    print("  IrModule.fn_count    = "); print_int(m.fn_count)
    print("  IrModule.string_count = "); print_int(m.string_count)

    // Phase 2: modular emit/ phase consumes the IrModule.
    // emit_module is silent when EMIT_SILENT=true; toggle to prove the call wires.
    emit_set_silent(true)
    emit_module(m)
    emit_set_silent(false)

    println("  emit_module(m) returned cleanly — emit/ phase executed.")
}
