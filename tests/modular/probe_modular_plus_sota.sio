// SOTA + modular liveness probe.
// Demonstrates that Sounio's SOTA frontier feature — Knowledge<T> with
// compile-time epistemic gate (the E170/E171 admissibility judgement) —
// runs in a program that imports the modular emit phase.

use emit::mod::*

fn main() with IO, Mut, Panic, Div, Alloc, Epistemic {
    // Touch the modular emit phase to prove the loader walked it.
    emit_set_silent(false)

    // Construct two measured values with GUM uncertainties.
    let mass: Knowledge<f64> = measure(500.0, uncertainty: 2.5)
    let dose: Knowledge<f64> = measure(120.0, uncertainty: 1.0)

    // Native arithmetic — the compiler emits inline GUM uncertainty propagation.
    let ratio = dose / mass

    // .value access requires `with Epistemic` (E170 — admissibility gate).
    println("modular + SOTA frontier: ALIVE")
    print("  ratio.value = ")
    print_f64(ratio.value)
    println("")
}
