// Real-data modular probe.
// Builds a non-trivial IrModule via the modular ir/ phase: synthesizes
// 3 functions (named via the modular Name/string-table API) and pushes
// them into the module's functions array, then hands the result to the
// modular emit/ phase. Reads back module state through the public API.

use ir::ir::*
use emit::mod::*

fn main() with IO, Mut, Panic, Div, Alloc {
    var m: IrModule = ir_empty_module()

    // Build 3 empty IrFunction entries with distinct synthetic ids.
    var i: i64 = 0
    while i < 3 {
        var f: IrFunction = ir_empty_function()
        f.param_count = i + 1                  // distinct param counts
        f.reg_count = 16 + i                   // distinct reg counts
        f.hyper_algebra_kind = 0 - 1           // ALG absent
        m.functions[i] = f
        i = i + 1
    }
    m.fn_count = 3

    println("ir-data-flow modular probe: ALIVE")
    print("  populated IrModule.fn_count = "); print_int(m.fn_count)

    // Read back from the module via field access — confirms struct layout
    // is consistent across ir_empty_module / ir_empty_function / direct mutation.
    var k: i64 = 0
    while k < m.fn_count {
        print("    fn["); print_int(k)
        print("      param_count = "); print_int(m.functions[k].param_count)
        print("      reg_count   = "); print_int(m.functions[k].reg_count)
        k = k + 1
    }

    // Hand to modular emit/ — silent mode so we don't dump full IR text,
    // but the call exercises the cross-phase data hand-off.
    emit_set_silent(true)
    emit_module(m)
    emit_set_silent(false)

    println("  cross-phase data hand-off (ir/ -> emit/) succeeded.")
}
