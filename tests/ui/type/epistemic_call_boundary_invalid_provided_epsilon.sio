//@ compile-fail
//@ error-pattern: P0003
//@ description: Invalid provided epsilon metadata must be rejected at Knowledge call boundaries

fn needs_precise(k: Knowledge<f64, epsilon < 0.05>) -> f64 {
    k.value
}

fn main() -> i32 with IO, Epistemic {
    let invalid_eps: Knowledge<f64, epsilon < 1.5>> = measure(500.0, uncertainty: 2.5)
    let _result = needs_precise(invalid_eps)
    0
}
