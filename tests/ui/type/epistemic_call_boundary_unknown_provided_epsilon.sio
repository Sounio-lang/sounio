//@ compile-fail
//@ error-pattern: P0003
//@ description: Unknown provided epsilon must not satisfy a bounded Knowledge call boundary

fn needs_precise(k: Knowledge<f64, epsilon < 0.05>) -> f64 {
    k.value
}

fn main() -> i32 with IO, Epistemic {
    let unknown_eps: Knowledge<f64> = measure(500.0, uncertainty: 2.5)
    let _result = needs_precise(unknown_eps)
    0
}
