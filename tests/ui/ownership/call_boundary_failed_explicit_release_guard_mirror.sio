//@ compile-fail
//@ error-pattern: more than once
//@ error-pattern: already borrowed
//@ description: Failed explicit exclusive call-boundary borrow must not release an existing exclusive borrow

fn take_exclusive(r: &!i64) -> i64 with Mut {
    *r
}

fn main() -> i32 with Mut {
    var x: i64 = 1
    let held = &!x

    // Explicit exclusive borrow in call arg fails under the active exclusive borrow.
    let a = take_exclusive(&!x)

    // Must still fail: failed call-site borrow should not clear `held`.
    let s = &x

    if a >= 0 && *s >= 0 {
        return 0
    }
    0
}
