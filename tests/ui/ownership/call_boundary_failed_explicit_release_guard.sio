//@ compile-fail
//@ error-pattern: already borrowed
//@ error-pattern: more than once
//@ description: Failed explicit call-boundary borrow must not release an existing exclusive borrow

fn take_shared(r: &i64) -> i64 {
    *r
}

fn main() -> i32 with Mut {
    var x: i64 = 1
    let held = &!x

    // Explicit shared borrow in call arg fails under the active exclusive borrow.
    let a = take_shared(&x)

    // Must still fail: failed call-site borrow should not clear `held`.
    let again = &!x

    if a >= 0 && *again >= 0 {
        return 0
    }
    0
}
