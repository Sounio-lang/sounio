//@ compile-fail
//@ error-pattern: cannot borrow sharedly while exclusive borrow is active
//@ error-pattern: cannot borrow exclusively while other borrows are active
//@ description: BLOCKED: pinned binary does not support implicit call-boundary borrow syntax (f(&T) <- x)

fn take_shared(r: &i64) -> i64 {
    *r
}

fn main() -> i32 with Mut {
    var x: i64 = 1
    let held = &!x

    // This implicit borrow fails because `held` keeps x exclusively borrowed.
    let a = take_shared(x)

    // Must still fail: the failed call above must not drop `held`.
    let again = &!x

    if a >= 0 && *again >= 0 {
        return 0
    }
    0
}
