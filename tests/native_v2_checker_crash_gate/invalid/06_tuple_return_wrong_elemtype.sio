// Ill-typed twin of valid/06_tuple_return.sio: the body returns (i64, bool) but
// the declared return type is (i64, i64). The checker MUST reject this with a
// return-type mismatch (E008), proving tuple_types_compatible compares element
// types structurally (not just "both are tuples").
fn pair(a: i64, b: bool) -> (i64, i64) {
    (a, b)
}

fn main() -> i64 {
    let t = pair(10, true)
    t.0
}
