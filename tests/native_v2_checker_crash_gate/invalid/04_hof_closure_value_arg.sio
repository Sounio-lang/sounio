// R1 soundness witness: a closure value (here bound to a local and passed by
// ident) used where a fn-type parameter is expected is REJECTED, because the
// native-v2 backend cannot lower a closure passed as a fn-type argument to a
// correct exit. Only a top-level function reference is accepted structurally.
fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn main() -> i64 {
    let g = |x: i64| x * 2
    apply(g, 21)
}
