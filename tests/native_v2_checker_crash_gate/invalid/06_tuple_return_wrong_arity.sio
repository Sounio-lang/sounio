// Ill-typed twin of valid/06_tuple_return.sio: the body returns a 2-tuple but
// the declared return type is a 3-tuple. The checker MUST reject this with a
// return-type mismatch (E008), proving the new TypeTuple lowering arm did not
// turn into an accept-everything hole (tuple_types_compatible is arity-checked).
fn pair(a: i64, b: i64) -> (i64, i64, i64) {
    (a, b)
}

fn main() -> i64 {
    let t = pair(10, 32)
    t.0 + t.1
}
