// Ill-typed twin exercising the tuple-PARAM path the fix newly enabled: a
// 3-tuple argument is passed to a function whose parameter type is a 2-tuple.
// The checker MUST reject this with an argument-type mismatch (E009), proving
// the newly-lowerable tuple parameter type is still arity-checked at the call.
fn takes(t: (i64, i64)) -> i64 {
    t.0 + t.1
}

fn main() -> i64 {
    takes((40, 2, 9))
}
