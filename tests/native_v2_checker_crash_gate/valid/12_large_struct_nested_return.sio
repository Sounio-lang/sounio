struct Wide {
    a: i64,
    b: i64,
    c: i64,
}

struct Wrap {
    left: Wide,
    right: Wide,
}

fn make_wide(a: i64, b: i64, c: i64) -> Wide {
    Wide { a: a, b: b, c: c }
}

fn make_wrap() -> Wrap {
    Wrap { left: make_wide(1, 2, 3), right: make_wide(4, 5, 27) }
}

fn main() -> i64 {
    let w = make_wrap()
    w.left.a + w.left.b + w.left.c + w.right.a + w.right.b + w.right.c
}
