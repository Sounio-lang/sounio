// Driven by scripts/ci/print_f64_callee_saved_gate.sh, which runs it under
// scripts/ci/print_f64_callee_saved_probe.cpp. Eight println(f64) calls, one
// per print_f64 exit: >= 2^63 (both signs), below 2^63 (both signs), zero,
// NaN, +inf and -inf. Not a run-pass test: what it checks is register state.
fn main() -> i32 with IO, Div {
    let zero = 0.0
    println(1.0e19)
    println(-1.0e30)
    println(1.5)
    println(-2.25)
    println(zero)
    println(zero / zero)
    println(1.0 / zero)
    println(-1.0 / zero)
    0
}
