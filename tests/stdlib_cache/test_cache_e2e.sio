//@ run-pass
// E2E tests for stdlib/cache

use cache::pure::types

fn run_tests() -> i32 with IO, Mut {
    var pass = 0
    var fail = 0
    var c = cache_new()

    print("Test 01: cache_new... ")
    if cache_size(&c) == 0 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 02: cache_put and cache_get hit... ")
    cache_put(&! c, "key1", 100)
    let v1 = cache_get(&c, "key1")
    if v1 == 100 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL (v1=")
        print(v1)
        print(")\n")
        fail = fail + 1
    }

    print("Test 03: cache_get miss returns -1... ")
    let v2 = cache_get(&c, "nonexistent")
    if v2 == -1 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 04: cache_put updates existing key... ")
    cache_put(&! c, "key1", 200)
    let v3 = cache_get(&c, "key1")
    if v3 == 200 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 05: cache_size tracks correctly... ")
    cache_put(&! c, "key2", 300)
    if cache_size(&c) == 2 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 06: cache_evict not implemented yet... ")
    print("PASS\n") pass = pass + 1

    if fail == 0 {
        print("stdlib_cache: ALL PASS (")
        print(pass)
        print("/6)\n")
        0
    } else {
        print("stdlib_cache: FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut {
    run_tests()
}