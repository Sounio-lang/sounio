// EXPECTED: passes `souc check` on lean_single. That is the defect.
// A quotient of unit-typed values loses its dimension, so mol/cm3 + K is accepted.
fn main() with IO, Mut, Div, Panic {
    let n: mol = 0.0000081
    let v: cm3 = 1.0
    let t: K = 1500.0
    let c = n / v
    let bad_inferred = c + t
    println("accepted: (mol/cm3) + K")
}
