// EXPECTED: REFUSED by `souc check` on lean_single, on both targets.
//
// This file reproduced a gap that is now CLOSED (2026-09-05). It used to pass:
// a quotient of unit-typed values lost its dimension, so mol/cm3 + K compiled.
// It now reports `error: unit dimension mismatch` and exits non-zero, because
// the dimension is carried through `*` and `/` and the additive check compares
// it. Kept here rather than moved so the reproduction stays next to its README
// row and its ratchet witness; scripts/ci/language_gap_ratchet_gate.sh is what
// now holds the refusal in place.
fn main() with IO, Mut, Div, Panic {
    let n: mol = 0.0000081
    let v: cm3 = 1.0
    let t: K = 1500.0
    let c = n / v
    let bad_inferred = c + t
    println("accepted: (mol/cm3) + K")
}
