// EXPECTED: passes `souc check` on lean_single. That is the defect: K flows into an f64 parameter unchecked.
use chemistry::gri30_h2::*
fn takes_f64(x: f64) -> f64 { x * 2.0 }
fn main() with IO, Mut, Div, Panic {
    let t_k: K = 1500.0
    let a = takes_f64(t_k as f64)
    println("cast K->f64 ok")
    let b = takes_f64(t_k)
    println("implicit K->f64 accepted (units not enforced across calls)")
}
