// EXPECTED: lean_single -- prints a byte string that is not a number (observed: "-0.\xef\xbf\xbd)+(0(").
//           Madaros    -- prints -9223372036854775808.000000 (the -2^63 integer-indefinite pattern).
// Measured 2026-09-02.  Neither engine prints "nan".
fn main() -> i32 with IO, Mut, Div, Panic {
    let inf: f64 = 1.0 / 0.0
    let nan: f64 = inf - inf
    println("START")
    println(nan)
    println("END")
    0
}
