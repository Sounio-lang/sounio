// EXPECTED: RUNS on both engines and prints 1 / 0 / 1 -- the IEEE 754 answers are 0 / 1 / 0.
// `nan == nan` is true, `nan != nan` is false, `nan < 1.0` is true (unordered
// compares as less-than-and-equal).  Measured 2026-09-02, lean_single and Madaros.
fn main() -> i32 with IO, Mut, Div, Panic {
    let inf: f64 = 1.0 / 0.0
    let nan: f64 = inf - inf
    println(nan == nan)
    println(nan != nan)
    println(nan < 1.0)
    0
}
