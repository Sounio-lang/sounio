// EXPECTED: lean_single -- prints START and never returns from println(inf) (killed by timeout).
//           Madaros    -- prints 9223372036854775808.000000 (the 2^63 integer-indefinite pattern).
// Measured 2026-09-02.  Neither engine prints "inf".
fn main() -> i32 with IO, Mut, Div, Panic {
    let inf: f64 = 1.0 / 0.0
    println("START")
    println(inf)
    println("END")
    0
}
