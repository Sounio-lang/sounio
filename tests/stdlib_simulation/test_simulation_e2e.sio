//@ run-pass
// E2E tests for stdlib/simulation

use simulation::pure::types

fn run_tests() -> i32 with IO, Mut, Div {
    var pass = 0
    var fail = 0

    print("Test 01: TimeSeries creation... ")
    var ts = timeseries_new()
    if ts.n_points == 0 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 02: TimeSeries push... ")
    timeseries_push(&! ts, 0.0, 10.0)
    timeseries_push(&! ts, 1.0, 20.0)
    timeseries_push(&! ts, 2.0, 30.0)
    if ts.n_points == 3 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 03: TimeSeries mean... ")
    let m = timeseries_mean(&! ts)
    if m > 19.9 && m < 20.1 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL (mean=")
        print(m)
        print(")\n")
        fail = fail + 1
    }

    if fail == 0 {
        print("stdlib_simulation: ALL PASS (")
        print(pass)
        print("/3)\n")
        0
    } else {
        print("stdlib_simulation: FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut, Div {
    run_tests()
}