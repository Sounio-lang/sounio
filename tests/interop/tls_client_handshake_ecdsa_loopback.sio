// MANUAL SETUP REQUIRED -- not part of the default run-pass suite.
//
// Repeats tests/interop/tls_client_handshake_loopback.sio with an ECDSA
// P-256 test certificate on a second port, confirming the
// ecdsa_p256_verify path (Task 2) and the EC-public-key parsing path
// (Task 3) both work end-to-end against a real, independently-generated
// certificate and signature.
//
// See tests/interop/tls_client_handshake_loopback.sio's header for why
// this lives under tests/interop/ rather than tests/run-pass/ (no
// execve/fork+exec-a-subprocess primitive in Madaros today).
//
// To run:
//   1. Start the server against the COMMITTED fixture key+cert (leave it
//      running in another terminal -- the DER embedded below is this exact
//      certificate, not a placeholder):
//        openssl s_server \
//          -key tests/interop/fixtures/tls/ec_key.pem \
//          -cert tests/interop/fixtures/tls/ec_cert.pem \
//          -accept 44331 -tls1_3 -www
//   2. SOUNIO_STDLIB_PATH=$(pwd)/stdlib ./bin/souc run tests/interop/tls_client_handshake_ecdsa_loopback.sio
//
// The fixture pair (tests/interop/fixtures/tls/ec_{key,cert}.pem) is a
// throwaway, self-signed, non-secret test key -- committing it is normal
// practice for test material, not a real credential. Generated long-lived
// (-days 8400, roughly 23 years, notAfter 2049-08-25) but deliberately kept
// under the year-2050 UTCTime boundary -- see the RSA test's header for why
// (stdlib/x509/cert.sio's date parser doesn't implement GeneralizedTime,
// which any notBefore/notAfter at or past 2050 would require):
//   openssl ecparam -name prime256v1 -genkey -noout -out tests/interop/fixtures/tls/ec_key.pem
//   openssl req -new -x509 -key tests/interop/fixtures/tls/ec_key.pem \
//     -out tests/interop/fixtures/tls/ec_cert.pem -days 8400 \
//     -subj "/CN=localhost" -addext "subjectAltName=DNS:127.0.0.1"
//   openssl x509 -in tests/interop/fixtures/tls/ec_cert.pem -outform DER -out ec_cert.der
//
// `now_unix` is read from the real wall clock via the `time(2)` syscall
// (syscall6(201, ...) with a NULL `tloc`) rather than a hardcoded literal --
// see the RSA test's header for why `extern "C" clock_gettime` is not
// usable under Madaros's native backend.

use tls::client::*
use x509::trust_store::*
use x509::cert::*
use net::socket::*

fn now_unix() -> i64 with IO {
    syscall6(201, 0, 0, 0, 0, 0, 0)
}

fn main() -> i64 with IO, Mut {
    let der_len: i64 = 407
    let der_bytes: [u8; 407] = [
        0x30, 0x82, 0x1, 0x93, 0x30, 0x82, 0x1, 0x39, 0xa0, 0x3, 0x2, 0x1,
        0x2, 0x2, 0x14, 0x23, 0x7a, 0x79, 0x98, 0x7, 0xbc, 0x89, 0x18, 0x6c,
        0xa0, 0xf3, 0x8b, 0x5f, 0xc0, 0xa0, 0xb9, 0x88, 0xde, 0x5b, 0x21, 0x30,
        0xa, 0x6, 0x8, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x4, 0x3, 0x2, 0x30,
        0x14, 0x31, 0x12, 0x30, 0x10, 0x6, 0x3, 0x55, 0x4, 0x3, 0xc, 0x9,
        0x6c, 0x6f, 0x63, 0x61, 0x6c, 0x68, 0x6f, 0x73, 0x74, 0x30, 0x1e, 0x17,
        0xd, 0x32, 0x36, 0x30, 0x38, 0x32, 0x36, 0x31, 0x30, 0x30, 0x36, 0x31,
        0x30, 0x5a, 0x17, 0xd, 0x34, 0x39, 0x30, 0x38, 0x32, 0x35, 0x31, 0x30,
        0x30, 0x36, 0x31, 0x30, 0x5a, 0x30, 0x14, 0x31, 0x12, 0x30, 0x10, 0x6,
        0x3, 0x55, 0x4, 0x3, 0xc, 0x9, 0x6c, 0x6f, 0x63, 0x61, 0x6c, 0x68,
        0x6f, 0x73, 0x74, 0x30, 0x59, 0x30, 0x13, 0x6, 0x7, 0x2a, 0x86, 0x48,
        0xce, 0x3d, 0x2, 0x1, 0x6, 0x8, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x3,
        0x1, 0x7, 0x3, 0x42, 0x0, 0x4, 0xa5, 0xe4, 0x89, 0x4d, 0xf4, 0x6c,
        0xdf, 0x1c, 0xde, 0x6a, 0x4f, 0xfe, 0xaf, 0xae, 0x58, 0x96, 0xc2, 0xd6,
        0x49, 0x1c, 0x35, 0xb3, 0x10, 0xe9, 0x91, 0x32, 0xd8, 0xfc, 0x3e, 0x54,
        0x6e, 0xe4, 0x21, 0x37, 0x2a, 0xb9, 0x96, 0x88, 0x80, 0x17, 0x75, 0x27,
        0xe6, 0x25, 0x22, 0x48, 0xaa, 0x4b, 0x70, 0x5e, 0x55, 0x55, 0x62, 0x28,
        0x50, 0x75, 0x90, 0xc5, 0xb7, 0x69, 0x8a, 0x12, 0xd6, 0x55, 0xa3, 0x69,
        0x30, 0x67, 0x30, 0x1d, 0x6, 0x3, 0x55, 0x1d, 0xe, 0x4, 0x16, 0x4,
        0x14, 0x41, 0x56, 0x64, 0xcf, 0xf1, 0xa4, 0x35, 0x0, 0xc, 0xe8, 0xbb,
        0xd6, 0x8b, 0xbd, 0x18, 0x1f, 0x8, 0xf5, 0x4e, 0x33, 0x30, 0x1f, 0x6,
        0x3, 0x55, 0x1d, 0x23, 0x4, 0x18, 0x30, 0x16, 0x80, 0x14, 0x41, 0x56,
        0x64, 0xcf, 0xf1, 0xa4, 0x35, 0x0, 0xc, 0xe8, 0xbb, 0xd6, 0x8b, 0xbd,
        0x18, 0x1f, 0x8, 0xf5, 0x4e, 0x33, 0x30, 0xf, 0x6, 0x3, 0x55, 0x1d,
        0x13, 0x1, 0x1, 0xff, 0x4, 0x5, 0x30, 0x3, 0x1, 0x1, 0xff, 0x30,
        0x14, 0x6, 0x3, 0x55, 0x1d, 0x11, 0x4, 0xd, 0x30, 0xb, 0x82, 0x9,
        0x31, 0x32, 0x37, 0x2e, 0x30, 0x2e, 0x30, 0x2e, 0x31, 0x30, 0xa, 0x6,
        0x8, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x4, 0x3, 0x2, 0x3, 0x48, 0x0,
        0x30, 0x45, 0x2, 0x20, 0x5c, 0x18, 0x3f, 0x82, 0xdc, 0xd, 0xc8, 0x3e,
        0x67, 0x61, 0x9c, 0xd9, 0xd2, 0x15, 0xea, 0x6d, 0x72, 0xf4, 0xd0, 0xef,
        0xe7, 0x87, 0x40, 0xa8, 0xf3, 0xf9, 0x56, 0x1, 0xf9, 0x5b, 0xa9, 0xa6,
        0x2, 0x21, 0x0, 0xf2, 0x41, 0x36, 0xc2, 0xc0, 0x1d, 0x9e, 0x8c, 0x81,
        0xd7, 0x5b, 0x3d, 0x90, 0x2d, 0x9e, 0xe4, 0xd7, 0xc2, 0x8d, 0x15, 0x63,
        0x34, 0x88, 0x35, 0xe2, 0x6b, 0x72, 0x88, 0x39, 0x5d, 0x91, 0xd1,
    ]

    let der_buf = rawbuf_new(der_len + 8)
    var i: i64 = 0
    while i < der_len {
        rawbuf_set(&der_buf, i, der_bytes[i as usize] as i64)
        i = i + 1
    }

    let (cert, perr) = x509_parse_certificate(&der_buf, der_len)
    if perr != 0 {
        println("tls_client_handshake_ecdsa_loopback: failed to parse test certificate")
        return 1
    }

    var store = TrustStore { certs: [certificate_zero(); 512], bufs: [rawbuf_new(1); 512], count: 1 }
    store.certs[0] = cert
    store.bufs[0] = der_buf

    let host_text = "127.0.0.1"
    let host_len = str_len(host_text)
    let host = rawbuf_new(host_len + 8)
    var hi: i64 = 0
    while hi < host_len {
        rawbuf_set(&host, hi, str_char_at(host_text, hi))
        hi = hi + 1
    }

    let (conn, result_code) = tls_connect(&host, host_len, 44331 as u16, &store, now_unix())
    if result_code != 0 {
        println("tls_client_handshake_ecdsa_loopback: handshake failed")
        print_int(result_code)
        return 1
    }
    println("tls_client_handshake_ecdsa_loopback: handshake reached application keys")
    return 0
}
