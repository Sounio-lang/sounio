// MANUAL -- arena-cost probe for trust_store_load() (no network).
//
// D12 measured the per-HANDSHAKE arena cost with a probe that loaded the
// system trust store exactly ONCE, outside its handshake loop
// (tests/interop/tls_arena_multi_handshake_probe.sio:36). Real consumers
// (Sounio-lang/conclave-search) call trust_store_load() fresh inside every
// stage that opens a TLS connection, so the per-LOAD cost is a separate,
// unmeasured lever. This probe measures it.
//
// The iteration number is printed BEFORE each load, so the last number
// printed is the number of trust_store_load() calls one process survives.
//
//   SOUNIO_STDLIB_PATH=$(pwd)/stdlib ./bin/souc run \
//     tests/interop/trust_store_load_arena_cost_probe.sio

use x509::cert::*
use x509::trust_store::*

fn main() -> i64 with IO, Mut, Div, Panic {
    var n: i64 = 0
    while n < 500 {
        println("trust_store_load iter")
        print_int(n + 1)
        let (store, terr) = trust_store_load()
        if terr != 0 {
            println("trust_store_load failed")
            print_int(terr)
            return 1
        }
        if store.count == 999999 { println("unreachable") }
        n = n + 1
    }
    println("completed 500 loads without arena exhaustion")
    0
}
