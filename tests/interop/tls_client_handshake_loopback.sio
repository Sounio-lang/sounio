// MANUAL SETUP REQUIRED -- not part of the default run-pass suite.
//
// Drives a real TLS 1.3 handshake against a local openssl s_server on
// loopback, using an RSA test certificate (openssl's default key type),
// confirming the connection reaches the application-key-derived state.
//
// This test lives under tests/interop/ (not tests/run-pass/) because it
// needs a real openssl process listening on 127.0.0.1:44330 for the
// duration of the run -- Madaros has no execve/fork+exec-a-subprocess
// primitive today (checked 2026-08-26: no `extern "C" execve`/`fork`+exec
// precedent anywhere in this repo, unlike tests/run-pass/
// net_http_client_hostname.sio's fork()-based loopback server, which forks
// a child that speaks the test protocol IN SOUNIO -- it never execs an
// external binary). Building and hardening a real execve/argv/envp FFI
// wrapper from scratch was judged out of scope for this fix; if that
// primitive is ever added, this test is the natural first candidate to
// convert to a self-forking test like net_http_client_hostname.sio.
//
// To run:
//   1. Start the server against the COMMITTED fixture key+cert (leave it
//      running in another terminal -- the DER embedded below is this exact
//      certificate, not a placeholder):
//        openssl s_server \
//          -key tests/interop/fixtures/tls/rsa_key.pem \
//          -cert tests/interop/fixtures/tls/rsa_cert.pem \
//          -accept 44330 -tls1_3 -www
//   2. SOUNIO_STDLIB_PATH=$(pwd)/stdlib ./bin/souc run tests/interop/tls_client_handshake_loopback.sio
//
// The fixture pair (tests/interop/fixtures/tls/rsa_{key,cert}.pem) is a
// throwaway, self-signed, non-secret test key -- committing it is normal
// practice for test material, not a real credential. It was generated
// long-lived (-days 8400, roughly 23 years, notAfter 2049-08-25) so this
// fixture doesn't expire on any near-term date the way the original
// tests/run-pass/ version did (that one's notAfter was one day past
// generation). It is deliberately NOT pushed out to something like -days
// 36500 (~100 years): stdlib/x509/cert.sio's date parser only implements
// UTCTime (two-digit year, RFC 5280 SS4.1.2.5.1), not GeneralizedTime --
// any notBefore/notAfter at or past 2050 requires GeneralizedTime and this
// parser is documented NOT to support it (see the comment above
// `parse_utc_time_to_unix` in stdlib/x509/cert.sio). Measured 2026-08-26: a
// first attempt at this fixture used -days 36500 (notAfter 2126) and made
// `x509_verify_chain` return `CHAIN_ERR_EXPIRED` even at the real current
// time, because the GeneralizedTime-encoded notAfter silently failed to
// parse. -days 8400 keeps both dates safely inside UTCTime's supported
// range while still being "effectively permanent" for a test fixture.
//   openssl req -x509 -newkey rsa:2048 \
//     -keyout tests/interop/fixtures/tls/rsa_key.pem \
//     -out tests/interop/fixtures/tls/rsa_cert.pem \
//     -days 8400 -nodes -subj "/CN=localhost" -addext "subjectAltName=DNS:127.0.0.1"
//   openssl x509 -in tests/interop/fixtures/tls/rsa_cert.pem -outform DER -out rsa_cert.der
//
// The SAN carries the literal text "127.0.0.1" as a DNS-type GeneralName
// (openssl accepts this without validating it looks like an IP) so that
// x509_verify_hostname's DNS-type exact-match path succeeds against the
// "127.0.0.1" text this test passes as `host` -- stdlib/x509/chain.sio's
// hostname checker has no separate IP-address SAN type support.
//
// `now_unix` is read from the real wall clock (the `time(2)` syscall)
// rather than a hardcoded literal, since the fixture above no longer
// expires on any predictable date -- there is no longer a "regenerate this
// by <date>" deadline attached to this test.
//
// NOTE: stdlib/profile/profiler.sio's `extern "C" clock_gettime` is NOT
// usable here -- Madaros's native backend only implements a fixed allowlist
// of body-less extern functions (verified 2026-08-26: `./bin/souc check`
// rejects `clock_gettime` with `error[E219]: call to an extern "C" function
// the native backend does not implement`, listing the allowlist, which
// includes `syscall6` but no libc time function). `syscall6` IS on that
// allowlist and is already used elsewhere in this test suite (e.g.
// tests/run-pass/net_http_client_hostname.sio's fork()/kill()/wait4()), so
// `time(2)` (x86-64 syscall number 201) is called directly instead: with a
// NULL `tloc` argument it returns the current UNIX epoch second as its
// ordinary return value, needing no output buffer.

use tls::client::*
use x509::trust_store::*
use x509::cert::*
use net::socket::*

fn now_unix() -> i64 with IO {
    syscall6(201, 0, 0, 0, 0, 0, 0)
}

fn main() -> i64 with IO, Mut {
    let der_len: i64 = 803
    let der_bytes: [u8; 803] = [
        0x30, 0x82, 0x3, 0x1f, 0x30, 0x82, 0x2, 0x7, 0xa0, 0x3, 0x2, 0x1,
        0x2, 0x2, 0x14, 0x49, 0x9f, 0xad, 0xaf, 0x8d, 0xdf, 0xfb, 0x86, 0x97,
