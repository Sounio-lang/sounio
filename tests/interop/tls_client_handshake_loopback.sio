        0xb0, 0x49, 0xeb, 0xe6, 0xb7, 0xf3, 0xe6, 0x4a, 0x33, 0x59, 0x4e, 0xd7,
        0xd2, 0x4b, 0xfb, 0xc3, 0xa, 0x2e, 0x53, 0x83, 0x5e, 0x74, 0xe8, 0xb6,
        0x5a, 0x9f, 0x79, 0xf2, 0x83, 0x73, 0xf3, 0xc4, 0x89, 0x1b, 0x1b, 0x2b,
        0xb9, 0xeb, 0x27, 0xd0, 0x4f, 0xdc, 0xf1, 0x8e, 0xe0, 0x98, 0x1d, 0x20,
        0x1b, 0xfc, 0x76, 0x72, 0x92, 0xae, 0xde, 0x1, 0xf4, 0xff, 0x52, 0x6b,
        0x12, 0x79, 0x6c, 0x3, 0xca, 0xac, 0xeb, 0x67, 0x82, 0xb7, 0x58, 0x36,
        0xab, 0x4f, 0xc8, 0xda, 0xfb, 0x38, 0x86, 0x52, 0xec, 0xa8, 0x4c, 0x7,
        0x50, 0x60, 0x6b, 0x4c, 0x9a, 0x1, 0x6b, 0x81, 0xd8, 0x14, 0x3b, 0x67,
        0x8f, 0xaf, 0x8f, 0xed, 0xca, 0x7, 0x42, 0x5b, 0x88, 0xa8, 0x6, 0xcd,
        0xa3, 0x9c, 0x6e, 0x14, 0x28, 0xee, 0xd9, 0xa4, 0xff, 0x18, 0x76, 0x3e,
        0x70, 0x9f, 0x30, 0x9c, 0xa8, 0x6a, 0x3d, 0x42, 0x1f, 0x81, 0x4, 0x4e,
        0x72, 0x2d, 0x52, 0x57, 0xa5, 0x5e, 0xd0, 0xac, 0x96, 0xa3, 0xca, 0x5f,
        0xb3, 0x2c, 0x7d, 0x12, 0x7d, 0x39, 0x14, 0xf6, 0xb5, 0x1, 0x3, 0xdc,
        0x30, 0x90, 0x38, 0x88, 0xf3, 0xf8, 0x1e, 0xc9, 0x17, 0x5, 0xe5, 0x9,
        0x79, 0xbb, 0x13, 0xf1, 0x30, 0xee, 0x92, 0x2d, 0x5b, 0x23, 0x97, 0x4c,
        0xfa, 0xde, 0xcf, 0x26, 0x43, 0x1e, 0x73, 0xa7, 0xfb, 0xb1, 0x46,
    ]

    let der_buf = rawbuf_new(der_len + 8)
    var i: i64 = 0
    while i < der_len {
        rawbuf_set(&der_buf, i, der_bytes[i as usize] as i64)
        i = i + 1
    }

    let (cert, perr) = x509_parse_certificate(&der_buf, der_len)
    if perr != 0 {
        println("tls_client_handshake_loopback: failed to parse test certificate")
        return 1
    }

    var store = TrustStore { certs: [certificate_zero(); 512], bufs: [rawbuf_new(1); 512], count: 1 }
    store.certs[0] = cert
    store.bufs[0] = der_buf

    let host_text = "127.0.0.1"
    let host_len = str_len(host_text)
    let host = rawbuf_new(host_len + 8)
    var hi: i64 = 0
    while hi < host_len {
        rawbuf_set(&host, hi, str_char_at(host_text, hi))
        hi = hi + 1
    }

    let (conn, result_code) = tls_connect(&host, host_len, 44330 as u16, &store, now_unix())
    if result_code != 0 {
        println("tls_client_handshake_loopback: handshake failed")
        print_int(result_code)
        return 1
    }
    println("tls_client_handshake_loopback: handshake reached application keys")
    return 0
}
