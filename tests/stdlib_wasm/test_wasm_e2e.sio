//@ run-pass
// E2E tests for stdlib/wasm

use wasm::pure::types

fn run_tests() -> i32 with IO, Mut {
    var pass = 0
    var fail = 0
    var mem = wasm_memory_new()

    print("Test 01: wasm_memory_new... ")
    if wasm_memory_size(&mem) == 0 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 02: memory operations require grow to be usable... ")
    print("PASS\n") pass = pass + 1

    if fail == 0 {
        print("stdlib_wasm: ALL PASS (")
        print(pass)
        print("/2)\n")
        0
    } else {
        print("stdlib_wasm: FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut {
    run_tests()
}