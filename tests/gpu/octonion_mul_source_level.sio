// Source-level first-class octonion multiply, lowered by souc to a GPU kernel.
//
// `souc build --backend gpu tests/gpu/octonion_mul_source_level.sio -o oct.ptx` emits the
// cd_sigma/XOR octonion product (Convention X): pout = pa ⊗ ph, as 8 f64 loads from each
// operand, 64 products with the octonion sign table, and 8 f64 stores. HW-validated on the
// DGX Spark GB10 (sm_121a): bit-exact vs the scalar reference r[i⊕j] += σ(i,j,3)·a[i]·b[j].
// See docs/gpu/run_oct_mul_ptx.cu for the Driver-API validation harness.
kernel fn step(
    pa: &Hyper<Octonion, f64>,
    ph: &Hyper<Octonion, f64>,
    pout: &! Hyper<Octonion, f64>
) with GPU, NonAssoc {
    let a = *pa
    let h = *ph
    let ah = a * h
    *pout = ah
}

fn main() -> i32 with IO { 0 }
