// VJP of the batched SEDENION associator w.r.t. its input H (dim=16, bits=4) — array-of-Hyper.
// dH = L(a⊗b)ᵀ·dD − L(b)ᵀ·(L(a)ᵀ·dD). Output dH is D-layout [comp*16+batch].
fn sed_assoc_bwd_dh(pa: &Hyper<Sedenion, f64>, pb: &Hyper<Sedenion, f64>, pdD: &[f64; 256], pdH: &! [f64; 256]) with GPU { }

kernel fn step(pa: &Hyper<Sedenion, f64>, pb: &Hyper<Sedenion, f64>, pdD: &[f64; 256], pdH: &! [f64; 256]) with GPU {
    sed_assoc_bwd_dh(pa, pb, pdD, pdH)
}
fn main() -> i32 with IO { 0 }
