// Public GPU-profile fixture for an S-SSM-shaped sedenion/Cayley-Dickson step.
//
// The full compiler-owned emitter covers the sixteen-component surface. This
// witness keeps a compact public GPU source shape that still forces
// Cayley-Dickson split multiplication, zero-divisor-adjacent norm checks, and
// state-space recurrence arithmetic through emitted PTX.

kernel fn sedenion_cd_step_f64(
    n: i64,
    lo0: f64,
    lo1: f64,
    hi0: f64,
    hi1: f64,
    x0: f64,
    x1: f64,
    gate0: f64,
    gate1: f64
) with GPU, Mut, Div {
    var i: i64 = 0
    while i < n {
        let lo_mul0 = (lo0 * x0) - (lo1 * x1)
        let lo_mul1 = (lo0 * x1) + (lo1 * x0)
        let hi_mul0 = (gate0 * hi0) - (gate1 * hi1)
        let hi_mul1 = (gate0 * hi1) + (gate1 * hi0)
        let cd_lo0 = lo_mul0 - hi_mul0
        let cd_hi0 = hi_mul1 + lo_mul1
        let norm_shadow = (cd_lo0 * cd_lo0) + (cd_hi0 * cd_hi0)
        let zero_divisor_margin = norm_shadow + (gate1 * gate1)
        i = i + 1
    }
}

fn main() -> i32 with IO {
    0
}
