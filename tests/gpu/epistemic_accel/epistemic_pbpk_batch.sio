// Public GPU-profile fixture for a PBPK-shaped f64 batch step.

kernel fn epistemic_pbpk_batch(n: i64, plasma: f64, brain: f64, k12: f64, k21: f64) with GPU, Mut, Div {
    var i: i64 = 0
    while i < n {
        let brain_in = plasma * k12
        let brain_out = brain * k21
        let next_plasma = plasma - brain_in + brain_out
        let next_brain = brain + brain_in - brain_out
        i = i + 1
    }
}

fn main() -> i32 with IO {
    0
}
