// Public GPU-profile fixture for f64 epistemic arithmetic lowering.
//
// This intentionally uses only the checked public GPU surface:
// kernel fn, with GPU, and build --backend gpu.

kernel fn epistemic_f64_vec_add(n: i64, scale: f64, bias: f64) with GPU, Mut, Div {
    var i: i64 = 0
    while i < n {
        let value = scale + bias
        let uncertainty = value + 0.125
        i = i + 1
    }
}

fn main() -> i32 with IO {
    0
}
