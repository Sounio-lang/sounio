// Public GPU-profile fixture for GUM-style f64 uncertainty arithmetic.

kernel fn epistemic_gum_vec(n: i64, a: f64, b: f64) with GPU, Mut, Div {
    var i: i64 = 0
    while i < n {
        let value = a * b
        let uncertainty = (a * a) + (b * b)
        i = i + 1
    }
}

fn main() -> i32 with IO {
    0
}
