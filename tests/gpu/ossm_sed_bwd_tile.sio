// One BPTT backward step of the batched SEDENION recurrence (dim=16, bits=4) — array-of-Hyper.
// dHprev = L(A)ᵀ·dH_t (transposed tensor-core tile, D-layout) + dA += da(H_{t-1}, dH_t) in-place.
fn ossm_sed_bwd(pA: &Hyper<Sedenion, f64>, pHprev: &[Hyper<Sedenion, f64>; 16],
                pdHt: &[f64; 256], pdHprev: &! [f64; 256], pdA: &! [f64; 16]) with GPU { }

kernel fn step(pA: &Hyper<Sedenion, f64>, pHprev: &[Hyper<Sedenion, f64>; 16],
               pdHt: &[f64; 256], pdHprev: &! [f64; 256], pdA: &! [f64; 16]) with GPU {
    ossm_sed_bwd(pA, pHprev, pdHt, pdHprev, pdA)
}
fn main() -> i32 with IO { 0 }
