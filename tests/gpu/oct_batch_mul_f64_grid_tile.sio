// GRID (multi-block) batched octonion multiply D = L(a)·H on f64 TENSOR CORES — array-of-Hyper.
// Each block (indexed by blockIdx.x) processes one INDEPENDENT problem: a[dim], H[16·dim], D[256] at
// per-block offsets. Launch <<<B, 32>>> to run B tiles concurrently → multi-block throughput. Same f64
// m8n8k4 tile as oct_batch_mul_f64, block-indexed via %ctaid.x.
fn oct_batch_mul_f64_grid(pa: &Hyper<Octonion, f64>, pH: &[Hyper<Octonion, f64>; 16], pout: &! [f64; 256]) with GPU { }

kernel fn step(pa: &Hyper<Octonion, f64>, pH: &[Hyper<Octonion, f64>; 16], pout: &! [f64; 256]) with GPU {
    oct_batch_mul_f64_grid(pa, pH, pout)
}
fn main() -> i32 with IO { 0 }
