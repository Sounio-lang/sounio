// O-SSM SEDENION linear step S = A⊗H + B·x on tensor cores (dim=16, bits=4) — array-of-Hyper.
// Stage L(A)+H → wmma tile D=L(A)·H → post-add B·x. The forward half of the sedenion training loop
// (the backward half ossm_sed_bwd is already validated). Same shape as ossm_oct_step, dim=16.
fn ossm_sed_step(pA: &Hyper<Sedenion, f64>, pB: &Hyper<Sedenion, f64>, px: &[f64; 16],
                 pH: &[Hyper<Sedenion, f64>; 16], pout: &! [f64; 256]) with GPU { }

kernel fn step(pA: &Hyper<Sedenion, f64>, pB: &Hyper<Sedenion, f64>, px: &[f64; 16],
               pH: &[Hyper<Sedenion, f64>; 16], pout: &! [f64; 256]) with GPU {
    ossm_sed_step(pA, pB, px, pH, pout)
}
fn main() -> i32 with IO { 0 }
