// Two readonly inputs plus one output. This is the shape that used to need the
// literal names `a`, `b` and `c`.
kernel fn two_input_add(count: i64, left: &[f64], right: &[f64], total: &![f64]) with GPU {
    let lane = gpu_thread_id_x()
    if lane < count {
        total[lane as usize] = left[lane as usize] + right[lane as usize]
    }
}

fn main() -> i32 with IO { 0 }
