// extent + input slice + output slice, nonstandard parameter names.
// The plan must classify this from the signature alone: no `n`, no `a`/`b`/`c`.
kernel fn pair_scale(count: i64, source: &[f64], sink: &![f64]) with GPU {
    let lane = gpu_thread_id_x()
    if lane < count {
        sink[lane as usize] = source[lane as usize] * 2.0
    }
}

fn main() -> i32 with IO { 0 }
