// Scalar f32 parameter: the plan classifies i64, f64 and slices only.
// (An f32 *slice* is a pointer and is supported; a bare f32 scalar is not.)
kernel fn f32_scalar(count: i64, factor: f32, values: &![f64]) with GPU {
    let lane = gpu_thread_id_x()
    if lane < count {
        values[lane as usize] = 1.0
    }
}

fn main() -> i32 with IO { 0 }
