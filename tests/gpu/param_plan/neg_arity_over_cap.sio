// Nine parameters: one more than the 8-slot kernel IR holds.
kernel fn nine_params(n: i64, a: &[f64], b: &[f64], c: &[f64], d: &[f64], e: &[f64], f: &[f64], g: &[f64], out: &![f64]) with GPU {
    let lane = gpu_thread_id_x()
    if lane < n {
        out[lane as usize] = a[lane as usize] + b[lane as usize] + c[lane as usize] + d[lane as usize] + e[lane as usize] + f[lane as usize] + g[lane as usize]
    }
}

fn main() -> i32 with IO { 0 }
