// Scalar f64 between an input slice and the output slice.
kernel fn scaled_copy(count: i64, input: &[f64], factor: f64, output: &![f64]) with GPU {
    let lane = gpu_thread_id_x()
    if lane < count {
        output[lane as usize] = input[lane as usize] * factor
    }
}

fn main() -> i32 with IO { 0 }
