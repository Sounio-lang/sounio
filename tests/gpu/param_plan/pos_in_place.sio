// Single slice, read and written in place. The plan must classify it as an
// output slice because a store reaches it.
kernel fn bump_in_place(count: i64, values: &![f64]) with GPU {
    let lane = gpu_thread_id_x()
    if lane < count {
        values[lane as usize] = values[lane as usize] + 1.0
    }
}

fn main() -> i32 with IO { 0 }
