// The i64 extent sits after a scalar. `saxpy(a: f64, n: i64)` is a real kernel
// in the corpus, so the plan records the extent index instead of demanding it
// be parameter 0.
kernel fn extent_later(factor: f64, count: i64, values: &![f64]) with GPU {
    let lane = gpu_thread_id_x()
    if lane < count {
        values[lane as usize] = factor
    }
}

fn main() -> i32 with IO { 0 }
