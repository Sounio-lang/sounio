// FULL-f64 O-SSM octonion step S = A⊗H + B·x, computed entirely in f64 (no f16 tile) — array-of-Hyper.
// S[k,b] = Σ_j σ(k⊕j,j)·A[k⊕j]·H[b*dim+j] + B[k]·x[b], EXACT (vs the ~0.02 error of the f16→f32 tile) →
// sharp gradients and a clean finite-difference check. Output S is f64 D-layout [k*16+b].
fn ossm_oct_step_f64(pA: &Hyper<Octonion, f64>, pB: &Hyper<Octonion, f64>, px: &[f64; 16],
                     pH: &[Hyper<Octonion, f64>; 16], pout: &! [f64; 256]) with GPU { }

kernel fn step(pA: &Hyper<Octonion, f64>, pB: &Hyper<Octonion, f64>, px: &[f64; 16],
               pH: &[Hyper<Octonion, f64>; 16], pout: &! [f64; 256]) with GPU {
    ossm_oct_step_f64(pA, pB, px, pH, pout)
}
fn main() -> i32 with IO { 0 }
