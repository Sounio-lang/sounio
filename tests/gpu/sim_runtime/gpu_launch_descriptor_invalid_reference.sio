//@ run-pass
// Deterministic fail-closed reference for invalid launch descriptors.

struct GpuLaunchConfigRef {
    grid_dim_x: i64,
    grid_dim_y: i64,
    grid_dim_z: i64,
    block_dim_x: i64,
    block_dim_y: i64,
    block_dim_z: i64,
}

fn ref_gpu_launch_descriptor_valid(cfg: GpuLaunchConfigRef) -> bool {
    cfg.grid_dim_x > 0 &&
    cfg.grid_dim_y > 0 &&
    cfg.grid_dim_z > 0 &&
    cfg.block_dim_x > 0 &&
    cfg.block_dim_y > 0 &&
    cfg.block_dim_z > 0
}

fn test_zero_grid_rejected() -> bool {
    !ref_gpu_launch_descriptor_valid(GpuLaunchConfigRef {
        grid_dim_x: 0,
        grid_dim_y: 1,
        grid_dim_z: 1,
        block_dim_x: 64,
        block_dim_y: 1,
        block_dim_z: 1,
    })
}

fn test_zero_block_rejected() -> bool {
    !ref_gpu_launch_descriptor_valid(GpuLaunchConfigRef {
        grid_dim_x: 4,
        grid_dim_y: 1,
        grid_dim_z: 1,
        block_dim_x: 0,
        block_dim_y: 1,
        block_dim_z: 1,
    })
}

fn test_negative_lane_rejected() -> bool {
    !ref_gpu_launch_descriptor_valid(GpuLaunchConfigRef {
        grid_dim_x: 2,
        grid_dim_y: -1,
        grid_dim_z: 1,
        block_dim_x: 32,
        block_dim_y: 1,
        block_dim_z: 1,
    })
}

fn main() -> i32 with IO {
    if !test_zero_grid_rejected() {
        print("gpu_launch_descriptor_invalid_reference failed: zero grid accepted\n")
        return 1
    }
    if !test_zero_block_rejected() {
        print("gpu_launch_descriptor_invalid_reference failed: zero block accepted\n")
        return 1
    }
    if !test_negative_lane_rejected() {
        print("gpu_launch_descriptor_invalid_reference failed: negative lane accepted\n")
        return 1
    }
    print("gpu_launch_descriptor_invalid_reference ok\n")
    0
}
