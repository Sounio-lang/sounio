//@ run-pass
// Deterministic reference for the source-tree nonpositive launch-count guard.

struct GpuLaunchCountGuardRef {
    valid: bool,
    byte_count: i64,
}

fn ref_gpu_launch_count_guard(n: i64) -> GpuLaunchCountGuardRef {
    if n <= 0 {
        return GpuLaunchCountGuardRef { valid: false, byte_count: 0 }
    }
    GpuLaunchCountGuardRef { valid: true, byte_count: n * 4 }
}

fn test_zero_count_rejected() -> bool {
    let out = ref_gpu_launch_count_guard(0)
    !out.valid && out.byte_count == 0
}

fn test_negative_count_rejected() -> bool {
    let out = ref_gpu_launch_count_guard(-3)
    !out.valid && out.byte_count == 0
}

fn test_positive_count_marshaled() -> bool {
    let out = ref_gpu_launch_count_guard(11)
    out.valid && out.byte_count == 44
}

fn main() -> i32 with IO {
    if !test_zero_count_rejected() {
        print("gpu_launch_nonpositive_count_reference failed: zero count accepted\n")
        return 1
    }
    if !test_negative_count_rejected() {
        print("gpu_launch_nonpositive_count_reference failed: negative count accepted\n")
        return 1
    }
    if !test_positive_count_marshaled() {
        print("gpu_launch_nonpositive_count_reference failed: positive byte count mismatch\n")
        return 1
    }
    print("gpu_launch_nonpositive_count_reference ok\n")
    0
}
