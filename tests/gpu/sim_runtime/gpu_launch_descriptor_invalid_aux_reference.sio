//@ run-pass
// Deterministic fail-closed reference for negative shared-memory and stream metadata.

struct GpuLaunchConfigRef {
    grid_dim_x: i64,
    grid_dim_y: i64,
    grid_dim_z: i64,
    block_dim_x: i64,
    block_dim_y: i64,
    block_dim_z: i64,
    shared_mem_bytes: i64,
    stream_handle: i64,
}

fn ref_gpu_launch_descriptor_valid(cfg: GpuLaunchConfigRef) -> bool {
    cfg.grid_dim_x > 0 &&
    cfg.grid_dim_y > 0 &&
    cfg.grid_dim_z > 0 &&
    cfg.block_dim_x > 0 &&
    cfg.block_dim_y > 0 &&
    cfg.block_dim_z > 0 &&
    cfg.shared_mem_bytes >= 0 &&
    cfg.stream_handle >= 0
}

fn test_negative_shared_memory_rejected() -> bool {
    !ref_gpu_launch_descriptor_valid(GpuLaunchConfigRef {
        grid_dim_x: 2,
        grid_dim_y: 1,
        grid_dim_z: 1,
        block_dim_x: 32,
        block_dim_y: 1,
        block_dim_z: 1,
        shared_mem_bytes: -64,
        stream_handle: 0,
    })
}

fn test_negative_stream_rejected() -> bool {
    !ref_gpu_launch_descriptor_valid(GpuLaunchConfigRef {
        grid_dim_x: 2,
        grid_dim_y: 1,
        grid_dim_z: 1,
        block_dim_x: 32,
        block_dim_y: 1,
        block_dim_z: 1,
        shared_mem_bytes: 0,
        stream_handle: -3,
    })
}

fn main() -> i32 with IO {
    if !test_negative_shared_memory_rejected() {
        print("gpu_launch_descriptor_invalid_aux_reference failed: negative shared memory accepted\n")
        return 1
    }
    if !test_negative_stream_rejected() {
        print("gpu_launch_descriptor_invalid_aux_reference failed: negative stream accepted\n")
        return 1
    }
    print("gpu_launch_descriptor_invalid_aux_reference ok\n")
    0
}
