//@ run-pass
// Deterministic reference for the axis-sensitive GPU builtin semantics used by
// the source-tree HLIR→GPU lowering model. This is not a public gpu.* syntax
// claim; it is a reference contract for internal lowering correctness.

struct GpuAxis3Ref {
    x: i64,
    y: i64,
    z: i64,
}

fn ref_axis_component(v: GpuAxis3Ref, axis: i64) -> i64 {
    if axis == 0 { v.x }
    else if axis == 1 { v.y }
    else { v.z }
}

fn ref_axis_global_idx(tid: GpuAxis3Ref, bid: GpuAxis3Ref, bdim: GpuAxis3Ref, axis: i64) -> i64 {
    (ref_axis_component(bid, axis) * ref_axis_component(bdim, axis)) + ref_axis_component(tid, axis)
}

fn ref_flattened_3d_thread(tid: GpuAxis3Ref, bdim: GpuAxis3Ref) -> i64 {
    tid.x + (tid.y * bdim.x) + (tid.z * bdim.x * bdim.y)
}

fn test_axis_components() -> bool {
    let tid = GpuAxis3Ref { x: 5, y: 2, z: 1 }
    ref_axis_component(tid, 0) == 5 &&
    ref_axis_component(tid, 1) == 2 &&
    ref_axis_component(tid, 2) == 1
}

fn test_axis_global_indices() -> bool {
    let tid = GpuAxis3Ref { x: 5, y: 2, z: 1 }
    let bid = GpuAxis3Ref { x: 3, y: 4, z: 1 }
    let bdim = GpuAxis3Ref { x: 8, y: 6, z: 4 }
    ref_axis_global_idx(tid, bid, bdim, 0) == 29 &&
    ref_axis_global_idx(tid, bid, bdim, 1) == 26 &&
    ref_axis_global_idx(tid, bid, bdim, 2) == 5
}

fn test_flattened_3d_thread() -> bool {
    let tid = GpuAxis3Ref { x: 3, y: 2, z: 1 }
    let bdim = GpuAxis3Ref { x: 8, y: 6, z: 4 }
    ref_flattened_3d_thread(tid, bdim) == 67
}

fn main() -> i32 with IO {
    if !test_axis_components() {
        print("gpu_builtin_axis_reference failed: axis component decode\n")
        return 1
    }
    if !test_axis_global_indices() {
        print("gpu_builtin_axis_reference failed: axis global indices\n")
        return 1
    }
    if !test_flattened_3d_thread() {
        print("gpu_builtin_axis_reference failed: flattened 3d thread\n")
        return 1
    }
    print("gpu_builtin_axis_reference ok\n")
    0
}
