//@ run-pass
// Deterministic reference model for the source-tree PTX launch descriptor path.
//
// This fixture mirrors the Wave 4 runtime/helper contract in
// self-hosted/gpu/runtime/launch.sio:
// - 1D helper configs resolve to explicit x/y/z launch descriptors
// - explicit 3D grid/block descriptors are preserved as-is
// - shared memory, stream handle, and parameter count are carried through

struct GpuLaunchConfigRef {
    grid_dim_x: i64,
    grid_dim_y: i64,
    grid_dim_z: i64,
    block_dim_x: i64,
    block_dim_y: i64,
    block_dim_z: i64,
    shared_mem_bytes: i64,
    stream_handle: i64,
}

struct GpuLaunchDescriptorRef {
    grid_dim_x: i64,
    grid_dim_y: i64,
    grid_dim_z: i64,
    block_dim_x: i64,
    block_dim_y: i64,
    block_dim_z: i64,
    shared_mem_bytes: i64,
    stream_handle: i64,
    param_count: i64,
}

fn ref_cuda_grid_dim(n: i64, block_dim: i64) -> i64 with Div {
    if block_dim <= 0 { return 0 }
    (n + block_dim - 1) / block_dim
}

fn ref_gpu_launch_config_with_stream(
    n: i64,
    block_x: i64,
    smem: i64,
    stream_handle: i64
) -> GpuLaunchConfigRef with Div {
    GpuLaunchConfigRef {
        grid_dim_x: ref_cuda_grid_dim(n, block_x),
        grid_dim_y: 1,
        grid_dim_z: 1,
        block_dim_x: block_x,
        block_dim_y: 1,
        block_dim_z: 1,
        shared_mem_bytes: smem,
        stream_handle: stream_handle,
    }
}

fn ref_gpu_launch_config_explicit(
    grid_x: i64,
    grid_y: i64,
    grid_z: i64,
    block_x: i64,
    block_y: i64,
    block_z: i64,
    smem: i64,
    stream_handle: i64
) -> GpuLaunchConfigRef {
    GpuLaunchConfigRef {
        grid_dim_x: grid_x,
        grid_dim_y: grid_y,
        grid_dim_z: grid_z,
        block_dim_x: block_x,
        block_dim_y: block_y,
        block_dim_z: block_z,
        shared_mem_bytes: smem,
        stream_handle: stream_handle,
    }
}

fn ref_gpu_launch_descriptor(
    param_count: i64,
    cfg: GpuLaunchConfigRef
) -> GpuLaunchDescriptorRef {
    GpuLaunchDescriptorRef {
        grid_dim_x: cfg.grid_dim_x,
        grid_dim_y: cfg.grid_dim_y,
        grid_dim_z: cfg.grid_dim_z,
        block_dim_x: cfg.block_dim_x,
        block_dim_y: cfg.block_dim_y,
        block_dim_z: cfg.block_dim_z,
        shared_mem_bytes: cfg.shared_mem_bytes,
        stream_handle: cfg.stream_handle,
        param_count: param_count,
    }
}

fn descriptor_shape_ok(d: GpuLaunchDescriptorRef) -> bool {
    d.grid_dim_x > 0 &&
    d.grid_dim_y > 0 &&
    d.grid_dim_z > 0 &&
    d.block_dim_x > 0 &&
    d.block_dim_y > 0 &&
    d.block_dim_z > 0
}

fn test_1d_helper_descriptor() -> bool with Div {
    let cfg = ref_gpu_launch_config_with_stream(130, 128, 96, 7)
    let d = ref_gpu_launch_descriptor(3, cfg)
    descriptor_shape_ok(d) &&
    d.grid_dim_x == 2 &&
    d.grid_dim_y == 1 &&
    d.grid_dim_z == 1 &&
    d.block_dim_x == 128 &&
    d.block_dim_y == 1 &&
    d.block_dim_z == 1 &&
    d.shared_mem_bytes == 96 &&
    d.stream_handle == 7 &&
    d.param_count == 3
}

fn test_explicit_3d_descriptor() -> bool {
    let cfg = ref_gpu_launch_config_explicit(3, 2, 1, 8, 4, 2, 64, 11)
    let d = ref_gpu_launch_descriptor(4, cfg)
    descriptor_shape_ok(d) &&
    d.grid_dim_x == 3 &&
    d.grid_dim_y == 2 &&
    d.grid_dim_z == 1 &&
    d.block_dim_x == 8 &&
    d.block_dim_y == 4 &&
    d.block_dim_z == 2 &&
    d.shared_mem_bytes == 64 &&
    d.stream_handle == 11 &&
    d.param_count == 4
}

fn main() -> i32 with IO, Div {
    if !test_1d_helper_descriptor() {
        print("gpu_launch_descriptor_reference failed: 1d helper descriptor\n")
        return 1
    }
    if !test_explicit_3d_descriptor() {
        print("gpu_launch_descriptor_reference failed: explicit 3d descriptor\n")
        return 1
    }
    print("gpu_launch_descriptor_reference ok\n")
    0
}
