//@ run-pass
// Deterministic reference for the source-tree launch marshaling count guard.
//
// The launch helpers derive a byte count from the element count before any
// host/device marshaling occurs. This reference keeps that derivation
// fail-closed for zero, negative, and overflow-prone counts.

fn gpu_launch_max_f32_elements() -> i64 {
    2305843009213693951
}

struct GpuLaunchMarshaledCountRef {
    valid: bool,
    byte_count: i64,
}

fn ref_gpu_launch_marshaled_count(n: i64) -> GpuLaunchMarshaledCountRef {
    if n <= 0 {
        return GpuLaunchMarshaledCountRef { valid: false, byte_count: 0 }
    }
    if n > gpu_launch_max_f32_elements() {
        return GpuLaunchMarshaledCountRef { valid: false, byte_count: 0 }
    }
    GpuLaunchMarshaledCountRef { valid: true, byte_count: n * 4 }
}

fn test_zero_count_rejected() -> bool {
    let out = ref_gpu_launch_marshaled_count(0)
    !out.valid && out.byte_count == 0
}

fn test_negative_count_rejected() -> bool {
    let out = ref_gpu_launch_marshaled_count(-7)
    !out.valid && out.byte_count == 0
}

fn test_positive_count_marshaled() -> bool {
    let out = ref_gpu_launch_marshaled_count(19)
    out.valid && out.byte_count == 76
}

fn test_max_count_marshaled() -> bool {
    let out = ref_gpu_launch_marshaled_count(gpu_launch_max_f32_elements())
    out.valid && out.byte_count == 9223372036854775804
}

fn test_overflow_count_rejected() -> bool {
    let out = ref_gpu_launch_marshaled_count(gpu_launch_max_f32_elements() + 1)
    !out.valid && out.byte_count == 0
}

fn main() -> i32 with IO {
    if !test_zero_count_rejected() {
        print("gpu_launch_marshaled_count_reference failed: zero count accepted\n")
        return 1
    }
    if !test_negative_count_rejected() {
        print("gpu_launch_marshaled_count_reference failed: negative count accepted\n")
        return 1
    }
    if !test_positive_count_marshaled() {
        print("gpu_launch_marshaled_count_reference failed: positive byte count mismatch\n")
        return 1
    }
    if !test_max_count_marshaled() {
        print("gpu_launch_marshaled_count_reference failed: max count byte count mismatch\n")
        return 1
    }
    if !test_overflow_count_rejected() {
        print("gpu_launch_marshaled_count_reference failed: overflow count accepted\n")
        return 1
    }
    print("gpu_launch_marshaled_count_reference ok\n")
    0
}
