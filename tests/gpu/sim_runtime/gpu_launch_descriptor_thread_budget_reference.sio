//@ run-pass
// Deterministic reference for the source-tree launch thread-budget contract.

struct GpuLaunchConfigRef {
    grid_dim_x: i64,
    grid_dim_y: i64,
    grid_dim_z: i64,
    block_dim_x: i64,
    block_dim_y: i64,
    block_dim_z: i64,
    shared_mem_bytes: i64,
    stream_handle: i64,
}

fn gpu_runtime_max_threads_per_block_ref() -> i64 {
    1024
}

fn ref_gpu_launch_block_threads(cfg: GpuLaunchConfigRef) -> i64 {
    cfg.block_dim_x * cfg.block_dim_y * cfg.block_dim_z
}

fn ref_gpu_launch_descriptor_valid(cfg: GpuLaunchConfigRef) -> bool {
    cfg.grid_dim_x > 0 &&
    cfg.grid_dim_y > 0 &&
    cfg.grid_dim_z > 0 &&
    cfg.block_dim_x > 0 &&
    cfg.block_dim_y > 0 &&
    cfg.block_dim_z > 0 &&
    ref_gpu_launch_block_threads(cfg) <= gpu_runtime_max_threads_per_block_ref() &&
    cfg.shared_mem_bytes >= 0 &&
    cfg.stream_handle >= 0
}

fn test_thread_budget_boundary_accepts() -> bool {
    ref_gpu_launch_descriptor_valid(GpuLaunchConfigRef {
        grid_dim_x: 2,
        grid_dim_y: 1,
        grid_dim_z: 1,
        block_dim_x: 32,
        block_dim_y: 8,
        block_dim_z: 4,
        shared_mem_bytes: 0,
        stream_handle: 0,
    })
}

fn test_thread_budget_1d_overflow_rejected() -> bool {
    !ref_gpu_launch_descriptor_valid(GpuLaunchConfigRef {
        grid_dim_x: 1,
        grid_dim_y: 1,
        grid_dim_z: 1,
        block_dim_x: 2048,
        block_dim_y: 1,
        block_dim_z: 1,
        shared_mem_bytes: 0,
        stream_handle: 0,
    })
}

fn test_thread_budget_multidim_overflow_rejected() -> bool {
    !ref_gpu_launch_descriptor_valid(GpuLaunchConfigRef {
        grid_dim_x: 1,
        grid_dim_y: 1,
        grid_dim_z: 1,
        block_dim_x: 64,
        block_dim_y: 32,
        block_dim_z: 1,
        shared_mem_bytes: 0,
        stream_handle: 0,
    })
}

fn main() -> i32 with IO {
    if !test_thread_budget_boundary_accepts() {
        print("gpu_launch_descriptor_thread_budget_reference failed: 1024-thread boundary rejected\n")
        return 1
    }
    if !test_thread_budget_1d_overflow_rejected() {
        print("gpu_launch_descriptor_thread_budget_reference failed: 1d overflow accepted\n")
        return 1
    }
    if !test_thread_budget_multidim_overflow_rejected() {
        print("gpu_launch_descriptor_thread_budget_reference failed: multidim overflow accepted\n")
        return 1
    }
    print("gpu_launch_descriptor_thread_budget_reference ok\n")
    0
}
