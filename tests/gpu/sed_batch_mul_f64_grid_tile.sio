// GRID (multi-block) batched SEDENION multiply D = L(a)·H on f64 TENSOR CORES (dim=16) — array-of-Hyper.
// Each block does one independent problem (a[16], H[256], D[256]) at per-block offsets; launch <<<B,32>>>.
fn sed_batch_mul_f64_grid(pa: &Hyper<Sedenion, f64>, pH: &[Hyper<Sedenion, f64>; 16], pout: &! [f64; 256]) with GPU { }

kernel fn step(pa: &Hyper<Sedenion, f64>, pH: &[Hyper<Sedenion, f64>; 16], pout: &! [f64; 256]) with GPU {
    sed_batch_mul_f64_grid(pa, pH, pout)
}
fn main() -> i32 with IO { 0 }
