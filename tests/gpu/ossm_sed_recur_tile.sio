kernel fn step(pA:&[f64;16], pB:&[f64;16], px:&[f64;256], pC:&[f64;16], pH:&[f64;256], py:&![f64;256], T:i64) with GPU {
    ossm_sed_recur(pA, pB, px, pC, pH, py, T)
