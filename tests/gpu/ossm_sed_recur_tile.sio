kernel fn step(pA:&Hyper<Sedenion,f64>, pB:&Hyper<Sedenion,f64>, px:&[f64;256], pC:&Hyper<Sedenion,f64>, pH:&[Hyper<Sedenion,f64>;16], py:&![f64;256], T:i64) with GPU {
    ossm_sed_recur(pA, pB, px, pC, pH, py, T)
}
fn main() -> i32 with IO { 0 }
