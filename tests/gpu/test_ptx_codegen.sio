//@ run-pass
// tests/gpu/test_ptx_codegen.sio — PTX text emitter gate test
//
// Tests the ptx.sio emitter directly (self-contained, no imports needed).
// Validates the PtxBuf builder functions that form the foundation of all
// three GPU backends (PTX/Metal/SPIR-V share the same buffer pattern).
//
// This test runs entirely in the JIT — no GPU hardware required.

// ============================================================================
// Inline copy of PtxBuf (from self-hosted/gpu/ptx.sio)
// Tests the same data structures and helpers the real backends use.
// ============================================================================

struct PtxBuf {
    data: [i8; 65536],
    len: i64,
}

fn ptx_buf_new() -> PtxBuf {
    PtxBuf { data: [0; 65536], len: 0 }
}

fn ptx_push_byte(buf: PtxBuf, b: i8) -> PtxBuf with Mut, Panic {
    var out = buf
    if out.len < 65535 {
        out.data[out.len as usize] = b
        out.len = out.len + 1
    }
    out
}

fn ptx_push_str(buf: PtxBuf, s: string) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        if out.len < 65536 {
            out.data[out.len as usize] = str_char_at(s, i) as i8
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

fn ptx_buf_contains(buf: PtxBuf, needle: string) -> bool with Mut, Panic, Div {
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if buf.len < nlen { return false }
    var i: i64 = 0
    while i <= (buf.len - nlen) {
        var match_ok = true
        var j: i64 = 0
        while j < nlen {
            let bc: i8 = buf.data[(i + j) as usize]
            let nc: i8 = str_char_at(needle, j) as i8
            if bc != nc {
                match_ok = false
                break
            }
            j = j + 1
        }
        if match_ok { return true }
        i = i + 1
    }
    false
}

fn ptx_emit_header(buf: PtxBuf) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, ".version 7.0\n")
    out = ptx_push_str(out, ".target sm_80\n")
    out = ptx_push_str(out, ".address_size 64\n")
    out
}

fn ptx_emit_entry(buf: PtxBuf, name: string) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, ".visible .entry ")
    out = ptx_push_str(out, name)
    out = ptx_push_str(out, "(\n")
    out
}

// ============================================================================
// Tests
// ============================================================================

fn test_empty_buf_len_zero() -> bool {
    let buf = ptx_buf_new()
    buf.len == 0
}

fn test_push_byte_increments_len() -> bool with Mut, Panic {
    let buf = ptx_buf_new()
    let buf2 = ptx_push_byte(buf, 65)  // 'A'
    buf2.len == 1
}

fn test_push_str_correct_length() -> bool with Mut, Panic, Div {
    let buf = ptx_buf_new()
    let buf2 = ptx_push_str(buf, "hello")
    buf2.len == 5
}

fn test_buf_contains_exact_match() -> bool with Mut, Panic, Div {
    let buf = ptx_buf_new()
    let buf2 = ptx_push_str(buf, ".version 7.0")
    ptx_buf_contains(buf2, ".version")
}

fn test_buf_not_contains_absent() -> bool with Mut, Panic, Div {
    let buf = ptx_buf_new()
    let buf2 = ptx_push_str(buf, ".version 7.0")
    !ptx_buf_contains(buf2, ".target")
}

fn test_emit_header_version() -> bool with Mut, Panic, Div {
    let buf = ptx_buf_new()
    let buf2 = ptx_emit_header(buf)
    ptx_buf_contains(buf2, ".version")
}

fn test_emit_header_target() -> bool with Mut, Panic, Div {
    let buf = ptx_buf_new()
    let buf2 = ptx_emit_header(buf)
    ptx_buf_contains(buf2, ".target")
}

fn test_emit_header_address_size() -> bool with Mut, Panic, Div {
    let buf = ptx_buf_new()
    let buf2 = ptx_emit_header(buf)
    ptx_buf_contains(buf2, ".address_size 64")
}

fn test_emit_entry_directive() -> bool with Mut, Panic, Div {
    let buf = ptx_buf_new()
    let buf2 = ptx_emit_entry(buf, "vec_add")
    ptx_buf_contains(buf2, ".visible .entry")
}

fn test_emit_full_kernel_structure() -> bool with Mut, Panic, Div {
    var buf = ptx_buf_new()
    buf = ptx_emit_header(buf)
    buf = ptx_emit_entry(buf, "vec_add")
    // param block
    buf = ptx_push_str(buf, "  .param .u64 param_a,\n")
    buf = ptx_push_str(buf, "  .param .u64 param_b,\n")
    buf = ptx_push_str(buf, "  .param .u64 param_c\n")
    buf = ptx_push_str(buf, ")\n")
    buf = ptx_push_str(buf, "{\n")
    buf = ptx_push_str(buf, "  ret;\n")
    buf = ptx_push_str(buf, "}\n")

    // Validate all structural markers are present
    let ok1 = ptx_buf_contains(buf, ".version")
    let ok2 = ptx_buf_contains(buf, ".target")
    let ok3 = ptx_buf_contains(buf, ".visible .entry")
    let ok4 = ptx_buf_contains(buf, ".param")
    let ok5 = ptx_buf_contains(buf, "ret;")
    let ok6 = ptx_buf_contains(buf, "}")
    ok1 && ok2 && ok3 && ok4 && ok5 && ok6
}

// ============================================================================
// Entry point
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    if !test_empty_buf_len_zero() {
        println("FAIL test_empty_buf_len_zero")
        return 1
    }
    if !test_push_byte_increments_len() {
        println("FAIL test_push_byte_increments_len")
        return 2
    }
    if !test_push_str_correct_length() {
        println("FAIL test_push_str_correct_length")
        return 3
    }
    if !test_buf_contains_exact_match() {
        println("FAIL test_buf_contains_exact_match")
        return 4
    }
    if !test_buf_not_contains_absent() {
        println("FAIL test_buf_not_contains_absent")
        return 5
    }
    if !test_emit_header_version() {
        println("FAIL test_emit_header_version")
        return 6
    }
    if !test_emit_header_target() {
        println("FAIL test_emit_header_target")
        return 7
    }
    if !test_emit_header_address_size() {
        println("FAIL test_emit_header_address_size")
        return 8
    }
    if !test_emit_entry_directive() {
        println("FAIL test_emit_entry_directive")
        return 9
    }
    if !test_emit_full_kernel_structure() {
        println("FAIL test_emit_full_kernel_structure")
        return 10
    }

    println("PASS 10/10 PTX emitter gate tests")
    0
}
