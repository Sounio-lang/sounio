// A spelling is not an operator contract. This deliberately reuses the old
// intrinsic-like name with scalar arguments and must remain an ordinary call.
fn pireus_sed_xor_convolution_f64(a: i64, b: i64, c: i64) -> i64 with GPU {
    a + b + c
}

kernel fn harbor_name_poison() with GPU {
    let value = pireus_sed_xor_convolution_f64(1, 2, 3)
}

fn main() -> i32 with IO { 0 }
