// Metamorphic twin of sedenion_mul_source_level.sio. Only identifiers differ;
// semantic and material selection must therefore be identical.
kernel fn harbor_fold(
    left: &Hyper<Sedenion, f64>,
    right: &Hyper<Sedenion, f64>,
    destination: &! Hyper<Sedenion, f64>
) with GPU, NonAssoc {
    let port = *left
    let starboard = *right
    let cargo = port * starboard
    *destination = cargo
}

fn main() -> i32 with IO { 0 }
