// One BPTT backward step of the batched octonion recurrence H_t = A⊗H_{t-1} + B·x_t — array-of-Hyper.
// Given dH_t (D-layout), computes dHprev = L(A)ᵀ·dH_t (transposed tensor-core tile, D-layout output
// that chains directly as the previous step's dH_t) and accumulates dA += da(H_{t-1}, dH_t) IN-PLACE
// across timesteps. This is the atom of backprop-through-time; the forward step reuses ossm_oct_step.
fn ossm_oct_bwd(pA: &Hyper<Octonion, f64>, pHprev: &[Hyper<Octonion, f64>; 16],
                pdHt: &[f64; 256], pdHprev: &! [f64; 256], pdA: &! [f64; 16]) with GPU { }

kernel fn step(pA: &Hyper<Octonion, f64>, pHprev: &[Hyper<Octonion, f64>; 16],
               pdHt: &[f64; 256], pdHprev: &! [f64; 256], pdA: &! [f64; 16]) with GPU {
    ossm_oct_bwd(pA, pHprev, pdHt, pdHprev, pdA)
}
fn main() -> i32 with IO { 0 }
