// Public checked-artifact negative fixture:
// the checked GPU profile does not currently resolve the gpu.* builtin namespace.

kernel fn vec_scale(n: i64) with GPU, Div, Mut, Panic {
    let tid = gpu.thread_id.x
    let bid = gpu.block_id.x
    let bdim = gpu.block_dim.x
    let idx = tid + bid * bdim
    if idx < n {
        gpu.sync_threads()
    }
}

fn main() -> i32 with IO {
    0
}
