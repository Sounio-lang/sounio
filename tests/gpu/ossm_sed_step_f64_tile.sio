// FULL-f64 O-SSM SEDENION step S = A⊗H + B·x (dim=16, bits=4), computed entirely in f64 — array-of-Hyper.
// S[k,b] = Σ_j σ(k⊕j,j)·A[k⊕j]·H[b*dim+j] + B[k]·x[b], EXACT. Output S is f64 D-layout [k*16+b].
fn ossm_sed_step_f64(pA: &Hyper<Sedenion, f64>, pB: &Hyper<Sedenion, f64>, px: &[f64; 16],
                     pH: &[Hyper<Sedenion, f64>; 16], pout: &! [f64; 256]) with GPU { }

kernel fn step(pA: &Hyper<Sedenion, f64>, pB: &Hyper<Sedenion, f64>, px: &[f64; 16],
               pH: &[Hyper<Sedenion, f64>; 16], pout: &! [f64; 256]) with GPU {
    ossm_sed_step_f64(pA, pB, px, pH, pout)
}
fn main() -> i32 with IO { 0 }
