// Source-level first-class SEDENION multiply, lowered by souc to a GPU kernel.
// `souc build --backend gpu` emits the cd_sigma product (Convention X, bits=4): pout = pa ⊗ ph,
// as 16 f64 loads from each operand, 256 products with the sedenion sign table, and 16 f64 stores.
// HW-validated on the DGX Spark GB10 (sm_121a): bit-exact vs scalar reference AND reproduces the
// canonical zero divisor (e3+e10)(e6−e15) = 0. Harness: docs/gpu/run_sed_mul_ptx.cu.
// Source-level first-class sedenion multiply, lowered by souc to a GPU kernel.
kernel fn step(
    pa: &Hyper<Sedenion, f64>,
    ph: &Hyper<Sedenion, f64>,
    pout: &! Hyper<Sedenion, f64>
) with GPU, NonAssoc {
    let a = *pa
    let h = *ph
    let ah = a * h
    *pout = ah
}
fn main() -> i32 with IO { 0 }
