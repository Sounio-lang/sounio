      ],
      "evidence_paths": [
        "tests/gpu/sim_runtime/gpu_launch_descriptor_reference.sio",
        "tests/gpu/sim_runtime/manifest.tsv"
      ],
      "notes": [
        "This is a deterministic reference fixture, not a physical GPU runtime claim."
      ]
    },
    {
      "entry_id": "hardware-runtime-attestation",
      "stage": "hardware-info",
      "support_class": "gpu-hardware-runtime-supported",
      "summary": "Physical GPU runtime evidence stays informational and remote-attested through the omega wrapper lane.",
      "descriptor_fields": [
        "status_summary",
        "reason",
        "delegate_log_path"
      ],
      "symbol_refs": [
        {
          "path": "scripts/gpu/gpu_hardware_runtime_gate.sh",
          "symbols": [
            "write_wrapper_json",
            "GPU_HARDWARE_RUNTIME_GATE"
          ]
        },
        {
          "path": "artifacts/omega/gpu_runtime_attest_gate.v1.json",
          "symbols": [
            "\"status_summary\"",
            "\"blockers\""
          ]
        }
      ],
      "evidence_paths": [
        "scripts/gpu/gpu_hardware_runtime_gate.sh",
        "artifacts/omega/gpu_runtime_attest_gate.v1.json"
      ],
      "notes": [
        "The hardware lane remains informational in auto mode and does not make baseline mergeability depend on live hardware."
      ]
    }
  ]
}
