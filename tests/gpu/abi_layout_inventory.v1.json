{
  "schema": "sounio.gpu.abi_layout_inventory.v1",
  "required_support_classes": [
    "gpu-surface-supported",
    "gpu-lowering-supported",
    "gpu-compile-proof",
    "gpu-sim-runtime-supported",
    "gpu-hardware-runtime-supported",
    "gpu-explicit-unsupported"
  ],
  "entries": [
    {
      "entry_id": "public-launch-surface",
      "stage": "surface",
      "support_class": "gpu-surface-supported",
      "summary": "Source surface accepts kernel launch and sync statements; selfhost source now fail-closes malformed launch-config arity.",
      "descriptor_fields": [
        "GPU.launch launch-config list arity = 3",
        "GPU.launch kernel-argument list is a second parenthesized list",
        "GPU.sync argument list arity = 0"
      ],
      "symbol_refs": [
        {
          "path": "self-hosted/compiler/lean_single.sio",
          "symbols": [
            "stmt_is_gpu_perform",
            "compile_gpu_perform_stmt_x86",
            "compile_gpu_perform_stmt_a64"
          ]
        },
        {
          "path": "tests/run-pass/gpu_launch_surface.sio",
          "symbols": [
            "GPU.launch",
            "GPU.sync"
          ]
        },
        {
          "path": "tests/gpu/compile_proof/gpu_launch_missing_block.sio",
          "symbols": [
            "GPU.launch"
          ]
        }
      ],
      "evidence_paths": [
        "tests/run-pass/gpu_launch_surface.sio",
        "tests/gpu/compile_proof/gpu_launch_missing_block.sio",
        "tests/gpu/compile_proof/gpu_launch_extra_config.sio"
      ],
      "notes": [
        "The checked public GPU artifact still accepts malformed launch-config arity until a future promoted artifact refresh lands.",
        "Wave 3 hardens the selfhost source lane without expanding public support claims."
      ]
    },
    {
      "entry_id": "public-intrinsics-explicit-unsupported",
      "stage": "surface",
      "support_class": "gpu-explicit-unsupported",
      "summary": "The checked public artifact still rejects gpu.thread_id.*, gpu.block_id.*, gpu.block_dim.*, and gpu.alloc<T>(...).",
      "descriptor_fields": [
        "Intrinsic namespace is not yet public in the checked GPU artifact"
      ],
      "symbol_refs": [
        {
          "path": "tests/gpu/fixtures/gpu_public_builtin_not_yet_supported.sio",
          "symbols": [
            "gpu.thread_id.x",
            "gpu.sync_threads"
          ]
        },
        {
          "path": "tests/gpu/surface_lowering/manifest.tsv",
          "symbols": [
            "builtin_surface_not_public",
            "gpu-explicit-unsupported"
          ]
        }
      ],
      "evidence_paths": [
        "tests/gpu/fixtures/gpu_public_builtin_not_yet_supported.sio",
        "tests/gpu/surface_lowering/manifest.tsv"
      ],
      "notes": [
        "This entry prevents implementation breadth in self-hosted/gpu from being read as public support."
      ]
    },
    {
      "entry_id": "kernel-param-lowering",
      "stage": "lowering",
      "support_class": "gpu-lowering-supported",
      "summary": "Kernel parameters flow from GpuKernelIr.params/param_count through PTX .param declarations and ld.param loads.",
      "descriptor_fields": [
        "GpuKernelIr.params[8]",
        "GpuKernelIr.param_count",
        "GpuParam.name",
        "GpuParam.ty",
        "GpuOp.param_idx"
      ],
      "symbol_refs": [
        {
          "path": "self-hosted/gpu/kernel_ir.sio",
          "symbols": [
            "struct GpuParam",
            "struct GpuKernelIr",
            "param_count",
            "param_idx"
          ]
        },
        {
          "path": "self-hosted/gpu/lower_to_ptx.sio",
          "symbols": [
            "kernel.param_count",
            "GpuOpcode::GpuLoadParam",
            "name_to_string(param_name)"
          ]
        },
        {
          "path": "tests/gpu/surface_lowering/manifest.tsv",
          "symbols": [
            "gpu-lowering-supported"
          ]
        }
      ],
      "evidence_paths": [
        "examples/gpu.sio",
        "examples/kernel_vec_add.sio",
        "examples/kernel_matmul.sio",
        "examples/kernel_epistemic_vec_add.sio"
      ],
      "notes": [
        "The lowering lane is evidence-backed through build --backend gpu on the checked public artifact."
      ]
    },
    {
      "entry_id": "ptx-runtime-launch-1d",
      "stage": "descriptor-runtime",
      "support_class": "gpu-compile-proof",
      "summary": "The source-tree PTX runtime path is currently a 1D launch ABI: gridDimX derives from n and block_dim, while Y/Z dimensions are fixed to 1.",
      "descriptor_fields": [
        "GpuLaunchConfig.block_dim",
        "GpuLaunchConfig.shared_mem_bytes",
        "GpuLaunchConfig.stream_handle",
        "cuda_grid_dim(n, block_dim) -> gridDimX",
        "gridDimY = 1",
        "gridDimZ = 1",
        "blockDimY = 1",
        "blockDimZ = 1"
      ],
      "symbol_refs": [
        {
          "path": "self-hosted/gpu/runtime/launch.sio",
          "symbols": [
            "struct GpuLaunchConfig",
            "gpu_launch_ptx_map",
            "gpu_launch_config_default"
          ]
        },
        {
          "path": "self-hosted/gpu/runtime/cuda.sio",
          "symbols": [
            "cuda_launch_kernel_1d",
            "cuda_grid_dim",
            "cuLaunchKernel"
          ]
        },
        {
          "path": "self-hosted/gpu/hlir_to_gpu.sio",
          "symbols": [
            "GpuLaunchConfig",
            "gpu_launch_ptx_map"
          ]
        }
      ],
      "evidence_paths": [
        "self-hosted/gpu/runtime/launch.sio",
        "self-hosted/gpu/runtime/cuda.sio",
        "self-hosted/gpu/hlir_to_gpu.sio"
      ],
      "notes": [
        "The runtime/helper path exists in source, but Wave 3 does not promote it beyond compile-proof without stronger backend evidence.",
        "cuLaunchKernel extra-pointer handling remains a hardware-lane hazard until dedicated attestation proves it clean."
      ]
    },
    {
      "entry_id": "sim-reference-launch-descriptor",
      "stage": "sim-reference",
      "support_class": "gpu-sim-runtime-supported",
      "summary": "The deterministic reference plane now includes a launch-descriptor fixture aligned to the current 1D PTX runtime contract.",
      "descriptor_fields": [
        "ref_cuda_grid_dim",
        "GpuLaunchConfigRef.block_dim",
        "GpuLaunchConfigRef.shared_mem_bytes",
        "GpuLaunchConfigRef.stream_handle",
        "GpuLaunchDescriptorRef.param_count"
      ],
      "symbol_refs": [
        {
          "path": "tests/gpu/sim_runtime/gpu_launch_descriptor_reference.sio",
          "symbols": [
            "ref_cuda_grid_dim",
            "GpuLaunchConfigRef",
