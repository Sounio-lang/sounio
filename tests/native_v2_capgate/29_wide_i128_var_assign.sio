// Wide var REASSIGNMENT (in-place 2-limb copy): x starts 2^64, reassigned to 2^65; (x>>64)==2.
// A single-limb copy (the old assign path) would leave the high limb stale (=1) -> wrong.
fn main() -> i64 {
    var x: i128 = (4294967296 as i128) * (4294967296 as i128)
    x = (8589934592 as i128) * (4294967296 as i128)
    ((x >> 64) as i64)
}
