// FULL N/N division by a MULTI-LIMB divisor (Increment D). Divisor B = 2^33 * 2^33 = 2^66
// (a genuine 2-limb value, NOT a single `X as i128` cast, so it takes the full divmod path,
// not the schoolbook fast path). Dividend A = (5*2^33)*2^33 = 5*2^66, so A / B = 5.
// A low-limb-only impl (dividing by B's limb0 = 0) would #DE/crash, never return 5.
fn main() -> i64 {
    (((42949672960 as i128) * (8589934592 as i128)) / ((8589934592 as i128) * (8589934592 as i128))) as i64
}
