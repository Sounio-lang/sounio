// Funnel shift exercising the CROSS-LIMB merge: (2^64 + 2^63) >> 63 = 3.
// V = 2^64 + 2^63 -> limbs lo=2^63, hi=1. >>63 (q=0, r=63): (lo>>63)|(hi<<1) = 1|2 = 3.
// Test 25 (>>96) only shifts the high limb down (high source = 0), so it does NOT exercise
// the `(src[k+q+1] << (64-r))` term; this one does. A broken funnel (dropping it) -> 1.
// 2^64 = (2^32)*(2^32) ; 2^63 = (2^32)*(2^31) = 4294967296 * 2147483648.
fn main() -> i64 {
    (((((4294967296 as i128) * (4294967296 as i128)) + ((4294967296 as i128) * (2147483648 as i128))) >> 63) as i64)
}
