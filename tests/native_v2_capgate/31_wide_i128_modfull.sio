// FULL N/N remainder by a MULTI-LIMB divisor (Increment D). Divisor D = 2^32 * (2^32+2)
// = 2^64 + 2^33, a 2-limb value with BOTH limbs nonzero (lo=2^33, hi=1) — exercises the
// cross-limb compare/subtract. Dividend A = 7012345 * 999983 = 7012225790135 < D, so the
// quotient is 0 and A % D = A; low limb mod 256 = 183.
fn main() -> i64 {
    (((7012345 as i128) * (999983 as i128)) % ((4294967296 as i128) * (4294967298 as i128))) as i64
}
