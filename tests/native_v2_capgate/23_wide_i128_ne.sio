// Wide compare: 15*2^64 != 16*2^64 -> 1. High limb decides (both low limbs 0).
// 15*2^64 = (3*2^32)*(5*2^32) ; 16*2^64 = (4*2^32)*(4*2^32).
// A low-limb-only (broken) impl would compute 0 != 0 = 0.
fn main() -> i64 {
    if ((12884901888 as i128) * (21474836480 as i128)) != ((17179869184 as i128) * (17179869184 as i128)) { 1 } else { 0 }
}
