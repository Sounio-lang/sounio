// Wide unsigned compare: 2^64 < 2^65 -> 1. High limb decides (both low limbs 0).
// (4*2^30)... built via mul: 2^32*2^32 = 2^64 ; (2^33)*(2^32) = 2^65.
// A low-limb-only (broken) impl would compute 0 < 0 = 0.
fn main() -> i64 {
    if ((4294967296 as i128) * (4294967296 as i128)) < ((8589934592 as i128) * (4294967296 as i128)) { 1 } else { 0 }
}
