// Two i128 variables, each surviving the other's allocation, multiplied: a=3*2^32, b=5*2^32,
// (a*b)>>64 == 15. If frame slots recycled (they must not), b's init would clobber a -> wrong.
fn main() -> i64 {
    let a: i128 = (3 as i128) * (4294967296 as i128)
    let b: i128 = (5 as i128) * (4294967296 as i128)
    (((a * b) >> 64) as i64)
}
