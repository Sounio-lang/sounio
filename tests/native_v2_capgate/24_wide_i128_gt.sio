// Wide compare: 2^65 > 2^64 -> 1. High limb decides (both low limbs 0).
// 2^65 = (2^33)*(2^32) ; 2^64 = (2^32)*(2^32).
// A low-limb-only (broken) impl would compute 0 > 0 = 0.
fn main() -> i64 {
    if ((8589934592 as i128) * (4294967296 as i128)) > ((4294967296 as i128) * (4294967296 as i128)) { 1 } else { 0 }
}
