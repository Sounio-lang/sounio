// Non-limb-aligned funnel shift: (2^40 * 2^60) >> 96 = 2^100 >> 96 = 2^4 = 16.
// 2^40 = 1099511627776 ; 2^60 = 1152921504606846976. shift 96 = 64+32 (q=1, r=32).
// A limb-aligned-only (broken) shift would do >>64 = 2^36; a low-limb-only impl -> 0.
fn main() -> i64 {
    ((((1099511627776 as i128) * (1152921504606846976 as i128)) >> 96) as i64)
}
