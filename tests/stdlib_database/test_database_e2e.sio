use database::pure::engine
use database::pure::types

fn main() -> i32 with IO, Mut, Panic, Div {
    var db = in_memory_db_new()
    var name = "users".to_string()
    var created = engine_create_table(&! db, CreateTableStmt { name: name })
    print("create result=")
    print(created)
    print("\n")
    var tables = engine_list_tables(&! db)
    print("tables.len()=")
    print(tables.len())
    print("\n")
    var dropped = engine_drop_table(&! db, DropTableStmt { name: name })
    print("drop result=")
    print(dropped)
    print("\n")
    0
}