//@ run-pass
// E2E tests for stdlib/database

use database::pure::types
use database::pure::engine

fn run_tests() -> i32 with IO, Mut {
    var pass = 0
    var fail = 0
    var db = in_memory_db_new()

    print("Test 01: create_table... ")
    if engine_create_table(&! db, "users") == 1 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 02: duplicate create returns 0... ")
    if engine_create_table(&! db, "users") == 0 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 03: insert two rows... ")
    let ri1 = engine_insert_row(&! db, "users", 1, 42)
    let ri2 = engine_insert_row(&! db, "users", 2, 30)
    if ri1 == 1 && ri2 == 1 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 04: row_count == 2... ")
    if engine_table_row_count(&! db, "users") == 2 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 05: get_cell(row=0,col=1) == 42... ")
    if engine_get_cell(&! db, "users", 0, 1) == 42 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 06: get_cell(row=1,col=0) == 2... ")
    if engine_get_cell(&! db, "users", 1, 0) == 2 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 07: second table 'orders'... ")
    let rc_ord = engine_create_table(&! db, "orders")
    let ri_ord = engine_insert_row(&! db, "orders", 100, 999)
    let v_ord = engine_get_cell(&! db, "orders", 0, 1)
    if rc_ord == 1 && ri_ord == 1 && v_ord == 999 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 08: find nonexistent table returns -1... ")
    if db_find_table(&! db, "ghost") == -1 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 09: drop_table removes 'users'... ")
    let rd = engine_drop_table(&! db, "users")
    let rc_gone = engine_table_row_count(&! db, "users")
    let tc = db.table_count
    if rd == 1 && rc_gone == -1 && tc == 1 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 10: orders data intact after drop... ")
    if engine_get_cell(&! db, "orders", 0, 1) == 999 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    if fail == 0 {
        print("stdlib_database: ALL PASS (")
        print(pass)
        print("/10)\n")
        0
    } else {
        print("stdlib_database: FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut {
    run_tests()
}