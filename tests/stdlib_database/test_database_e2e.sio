//@ run-pass
// E2E tests for stdlib/database

use database::pure::engine
use database::pure::types

fn run_tests() -> i32 with IO, Mut, Panic, Div {
    var pass = 0
    var fail = 0

    print("Test 01: CREATE TABLE... ")
    var db = in_memory_db_new()
    let sql1 = "CREATE TABLE users".to_string()
    let qr1 = engine_execute_sql(&! db, sql1)
    match qr1.result {
        QueryOutcome::Affected(n) => {
            if n == 1 {
                print("PASS\n")
                pass = pass + 1
            } else { print("FAIL (affected={})\n", n); fail = fail + 1 }
        }
        _ => { print("FAIL (wrong result type)\n"); fail = fail + 1 }
    }

    print("Test 02: Table list... ")
    let tables = engine_list_tables(&! db)
    if tables.len() == 1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (len={})\n", tables.len())
        fail = fail + 1
    }

    print("Test 03: DROP TABLE... ")
    let drop = "DROP TABLE users".to_string()
    let qr3 = engine_execute_sql(&! db, drop)
    match qr3.result {
        QueryOutcome::Affected(n) => {
            if n == 1 {
                print("PASS\n")
                pass = pass + 1
            } else { print("FAIL (affected={})\n", n); fail = fail + 1 }
        }
        _ => { print("FAIL (wrong result type)\n"); fail = fail + 1 }
    }

    print("Test 04: SQL validation... ")
    if validate_sql("SELECT * FROM t".to_string()) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    if fail == 0 {
        print("All tests passed!\n")
        0
    } else {
        print("{} tests FAILED\n", fail)
        1
    }
}

fn main() -> i32 with Mut, Panic, Div {
    run_tests()
}