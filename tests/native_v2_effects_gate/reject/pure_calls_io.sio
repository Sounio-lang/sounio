// REJECT (E035): pure `main` calls `emit`, which declares `with IO`. The callee's IO
// effect is not a subset of main's (empty) declared effects, so enforcement fires.
// Cardinal twin of accept/io_io.sio — identical except main lacks `with IO`.
// PRE-HOOK enforcement path: check_callee_effects (committed at branch base).
fn emit(x: i64) -> i64 with IO {
    print_int(x)
    x
}

fn main() -> i64 {
    emit(42)
}
