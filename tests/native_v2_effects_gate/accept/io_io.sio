// ACCEPT: caller declares `with IO`, matching the IO effect of the callee `emit`.
// Cardinal twin of reject/pure_calls_io.sio — identical except main's effect clause.
// Exercises the pre-existing callee-effect-subset enforcement (check_callee_effects).
fn emit(x: i64) -> i64 with IO {
    print_int(x)
    x
}

fn main() -> i64 with IO {
    emit(42)
}
