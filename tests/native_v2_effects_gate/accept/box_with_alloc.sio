// ACCEPT (clean): `Box::new(...)` requires `with Alloc`, which main declares, so no
// W035 fires. Cardinal twin of reject/box_no_alloc.sio — identical except `with Alloc`.
// NOTE: no `*b` deref — Box deref is independently rejected (E008) by this checker;
// binding + returning a scalar keeps the program well-typed so the gate isolates the
// Alloc effect tag.
fn main() -> i64 with Alloc {
    let b = Box::new(7)
    0
}
