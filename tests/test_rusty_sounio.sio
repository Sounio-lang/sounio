// Test file with Rust-isms for check_sounio.sh to catch

// Rust-style mutable reference (should be &!)
fn bad_mut_ref(x: &mut i32) -> i32 {
    *x + 1
}

// Using Vec (should be fixed array)
fn bad_vec_usage() {
    let v: Vec<i32> = Vec::new();
    v.push(1);
    v.push(2);
    let len = v.len();
}

// Rust method calls (should use manual iteration)
fn bad_method_calls(arr: &[i32; 10]) {
    let first = arr.first();
    let last = arr.last();
    let sum = arr.iter().sum();
}

// Unnecessary semicolons
fn bad_semicolons() -> i32 {
    let x = 10;
    let y = 20;
    return x + y;
}

// Missing effects
fn bad_division(a: i32, b: i32) -> i32 {
    a / b  // Should have 'with Div' effect
}

// Good Sounio code for comparison
fn good_sounio(x: &!i32) -> i32 with Mut {
    *x = *x + 1
    return *x
}

fn good_array() -> i32 {
    let arr: [i32; 5] = [1, 2, 3, 4, 5]
    var sum = 0
    for i in 0..5 {
        sum = sum + arr[i]
    }
    return sum
}

// Array literal with semicolon (this is OK)
fn good_array_literal() -> [i32; 10] {
    [0; 10]
}

// Knowledge type usage (good Sounio)
fn good_knowledge() -> Knowledge[f64] {
    Knowledge(42.0, ε=0.95, prov="test")
}

fn main() -> i32 {
    println("Testing Rust vs Sounio patterns")
    0
}