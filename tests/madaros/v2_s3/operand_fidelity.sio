fn seed() -> i64 {
    7
}

fn f_param_plus_zero(x: i64) -> i64 {
    x + 0
}

fn f_zero_plus_param(x: i64) -> i64 {
    0 + x
}

fn f_param_minus_zero(x: i64) -> i64 {
    x - 0
}

fn f_param_minus_self(x: i64) -> i64 {
    x - x
}

fn f_call_plus_zero() -> i64 {
    let x = seed()
    x + 0
}

fn f_zero_plus_call() -> i64 {
    let x = seed()
    0 + x
}

fn main() -> i64 {
    f_param_plus_zero(41)
}
