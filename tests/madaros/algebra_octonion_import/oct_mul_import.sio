//@ run-pass
//@ requires: madaros
// Default Madaros: import algebra::octonion and call exclusive-ref oct_mul.
//
// Pre-fix (2026-07-20): native compile succeeded then the ELF SEGV'd at
// runtime. Root cause was large-frame allocation without stack probes —
// full oct_mul needs ~0x23e0 of spill frame; a single `sub rsp, large`
// left rsp in unmapped stack and the first mid-frame store / push faulted
// (MAPERR). Fix: page-wise probes in emit_prologue_with_preg_mask.
//
// Product e1*e2 = e3 under Convention X → out[3] == 1.0, out[0] == 0.0.
// Scaled micro-units printed via print_int (print_f64 is E137 under Madaros).

use algebra::octonion::{oct_mul}

fn main() -> i32 with Mut, Div, IO, NonAssoc {
    var a: [f64; 8] = [0.0; 8]
    var b: [f64; 8] = [0.0; 8]
    a[1] = 1.0
    b[2] = 1.0
    var out: [f64; 8] = [0.0; 8]
    oct_mul(&a, &b, &!out)
    // e3 component * 1000 → 1000; real part → 0
    print_int((out[3] * 1000.0) as i64)
    print("\n")
    print_int((out[0] * 1000.0) as i64)
    print("\n")
    print("ALGEBRA_OCTONION_IMPORT_OK\n")
    return 0
}
