fn pure_seed() -> i64 {
    11
}

fn pure_call_add_zero_rhs() -> i64 {
    let x = pure_seed()
    x + 0
}

fn pure_call_add_zero_lhs() -> i64 {
    let x = pure_seed()
    0 + x
}

fn pure_call_mul_one_rhs() -> i64 {
    let x = pure_seed()
    x * 1
}

fn pure_call_mul_one_lhs() -> i64 {
    let x = pure_seed()
    1 * x
}

fn pure_call_sub_zero_rhs() -> i64 {
    let x = pure_seed()
    x - 0
}

fn main() -> i64 {
    0
}
