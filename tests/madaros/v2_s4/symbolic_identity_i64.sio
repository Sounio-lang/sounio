fn seed() -> i64 {
    9
}

fn add_zero_rhs(x: i64) -> i64 {
    x + 0
}

fn add_zero_lhs(x: i64) -> i64 {
    0 + x
}

fn mul_one_rhs(x: i64) -> i64 {
    x * 1
}

fn mul_one_lhs(x: i64) -> i64 {
    1 * x
}

fn sub_zero_rhs(x: i64) -> i64 {
    x - 0
}

fn call_chain() -> i64 {
    let x = seed()
    let y = x + 0
    let z = y * 1
    z - 0
}

fn main() -> i64 {
    call_chain()
}
