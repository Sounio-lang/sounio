fn pure_seed() -> i64 {
    7
}

fn pure_call_eq_self() -> bool {
    let x = pure_seed()
    x == x
}

fn pure_call_ne_self() -> bool {
    let x = pure_seed()
    x != x
}

fn pure_call_le_self() -> bool {
    let x = pure_seed()
    x <= x
}

fn pure_call_ge_self() -> bool {
    let x = pure_seed()
    x >= x
}

fn pure_call_lt_self() -> bool {
    let x = pure_seed()
    x < x
}

fn pure_call_gt_self() -> bool {
    let x = pure_seed()
    x > x
}

fn main() -> i64 {
    0
}
