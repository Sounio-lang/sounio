fn eq_distinct_params(x: i64, y: i64) -> bool {
    x == y
}

fn ne_distinct_params(x: i64, y: i64) -> bool {
    x != y
}

fn le_distinct_params(x: i64, y: i64) -> bool {
    x <= y
}

fn ge_distinct_params(x: i64, y: i64) -> bool {
    x >= y
}

fn lt_distinct_params(x: i64, y: i64) -> bool {
    x < y
}

fn gt_distinct_params(x: i64, y: i64) -> bool {
    x > y
}

fn main() -> i64 {
    0
}
