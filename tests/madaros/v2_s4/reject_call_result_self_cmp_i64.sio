fn noisy_seed() -> i64 with IO {
    println(7)
    7
}

fn noisy_call_eq_self() -> bool with IO {
    let x = noisy_seed()
    x == x
}

fn noisy_call_ne_self() -> bool with IO {
    let x = noisy_seed()
    x != x
}

fn noisy_call_le_self() -> bool with IO {
    let x = noisy_seed()
    x <= x
}

fn noisy_call_ge_self() -> bool with IO {
    let x = noisy_seed()
    x >= x
}

fn noisy_call_lt_self() -> bool with IO {
    let x = noisy_seed()
    x < x
}

fn noisy_call_gt_self() -> bool with IO {
    let x = noisy_seed()
    x > x
}

fn main() -> i64 {
    0
}
