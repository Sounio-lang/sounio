//@ run-pass
//
// M3a — F2 conjugation-under-speaker-reversal test on a synthetic
// corpus with planted σ-pair structure (binary format).
//
// The corpus is generated by `tools/ocssm/swda_loader.py` and contains
// 30 unique hash pairs selected from the 1024-row embedding table such
// that the conjugate approximation error is <= 0.10 for every pair.
// The trajectory alternates speakers (A, B, A, B, ...) with B's hash
// always the best conjugate partner of A's hash.
//
// Pins the M3a contracts:
//   1. `traj_load_binary` reads the binary format correctly.
//   2. The corrected σ-pair extraction (stepping by 2) produces
//      d_paired <= 0.10.
//   3. The random baseline (offset +3) produces ratio >= 5.0.

use dialogue::trajectory::*
use dialogue::embed::*

fn f2_conj(v: &[f64; 8], out: &![f64; 8]) with Mut {
    out[0] = v[0]
    out[1] = 0.0 - v[1]
    out[2] = 0.0 - v[2]
    out[3] = 0.0 - v[3]
    out[4] = 0.0 - v[4]
    out[5] = 0.0 - v[5]
    out[6] = 0.0 - v[6]
    out[7] = 0.0 - v[7]
}

fn f2_dist_sq(a: &[f64; 8], b: &[f64; 8]) -> f64 with Mut {
    var s: f64 = 0.0
    var i: i64 = 0
    while i < 8 {
        let d: f64 = a[i as usize] - b[i as usize]
        s = s + d * d
        i = i + 1
    }
    return s
}

fn f2_pair_residual_sq(hash_a: i64, hash_b: i64) -> f64 with Mut, Div, Panic, NaturalityG2 {
    var ea: [f64; 8] = [0.0; 8]
    var eb: [f64; 8] = [0.0; 8]
    embed_into(hash_a, &!ea)
    embed_into(hash_b, &!eb)
    var ca: [f64; 8] = [0.0; 8]
    f2_conj(&ea, &!ca)
    return f2_dist_sq(&eb, &ca)
}

fn traj_load_binary(t: &Trajectory, path: string) -> i64 with IO, Mut, Panic {
    let raw: string = read_file(path)
    let sz: i64 = file_size(path)
    if sz < 16 { return 0 }
    let version: i64 = read_i64(raw, 0)
    if version != 1 { return 0 }
    let n: i64 = read_i64(raw, 1)
    if n < 2 { return 0 }
    if sz < 16 + n * 40 { return 0 }
    var idx: i64 = 2
    var i: i64 = 0
    while i < n {
        let speaker: i64 = read_i64(raw, idx)
        let hash_val: i64 = read_i64(raw, idx + 1)
        let affect: i64 = read_i64(raw, idx + 2)
        let rupture: i64 = read_i64(raw, idx + 3)
        let dim: i64 = read_i64(raw, idx + 4)
        let _len: i64 = traj_push(t, speaker, hash_val, affect, rupture, dim)
        idx = idx + 5
        i = i + 1
    }
    return n
}

fn f2_paired_dist_sq(t: &Trajectory) -> f64 with Mut, Div, Panic, NaturalityG2 {
    let n: i64 = traj_len(t)
    if n < 2 { return 0.0 }
    var sum: f64 = 0.0
    var count: i64 = 0
    var i: i64 = 0
    while i < n - 1 {
        let sa: i64 = traj_speaker(t, i)
        let sb: i64 = traj_speaker(t, i + 1)
        if sa != sb {
            sum = sum + f2_pair_residual_sq(traj_hash(t, i), traj_hash(t, i + 1))
            count = count + 1
        }
        i = i + 2
    }
    if count == 0 { return 0.0 }
    return sum / (count as f64)
}

fn f2_random_dist_sq(t: &Trajectory) -> f64 with Mut, Div, Panic, NaturalityG2 {
    let n: i64 = traj_len(t)
    if n < 2 { return 0.0 }
    var sum: f64 = 0.0
    var count: i64 = 0
    var i: i64 = 0
    while i < n {
        let j: i64 = (i + 3) - ((i + 3) / n) * n
        if j != i {
            sum = sum + f2_pair_residual_sq(traj_hash(t, i), traj_hash(t, j))
            count = count + 1
        }
        i = i + 1
    }
    if count == 0 { return 0.0 }
    return sum / (count as f64)
}

fn main() -> i64 with IO, Mut, Div, Panic, NaturalityG2 {
    var t: Trajectory = traj_empty()
    let loaded: i64 = traj_load_binary(&t, "tests/fixtures/f2_swda.bin")

    if loaded < 2 {
        print("FAIL  (could not load binary corpus)\n")
        return 1
    }

    let dp: f64 = f2_paired_dist_sq(&t)
    let dr: f64 = f2_random_dist_sq(&t)
    var r: f64 = 0.0
    if dp > 0.0000000001 { r = dr / dp }

    var ok: i64 = 1
    if r < 5.0 { ok = 0 }
    if dp > 0.10 { ok = 0 }
    if dp <= 0.0 { ok = 0 }

    if ok == 1 {
        print("PASS\n")
    } else {
        print("FAIL\n")
    }
    return 0
}
