.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_mem
)
{
    .reg .b64 %rd<260>;
    .reg .f64 %fd<70>;
    .reg .f32 %f<260>;
    .reg .b32 %r<260>;
    .reg .pred %p<64>;

    ld.param.u64 %rd258, [param_mem];
L0:
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd0, %r1;
L1:
    mul.lo.u64 %rd256, %rd0, 8;
    add.u64 %rd256, %rd258, %rd256;
    ld.global.u64 %rd1, [%rd256];
L2:
    mul.lo.u64 %rd256, %rd0, 8;
    add.u64 %rd256, %rd258, %rd256;
    ld.global.u64 %rd2, [%rd256];
L3:
    add.u64 %rd3, %rd1, %rd2;
L4:
    mul.lo.u64 %rd4, %rd2, %rd2;
L5:
    mul.lo.u64 %rd256, %rd0, 8;
    add.u64 %rd256, %rd258, %rd256;
    st.global.u64 [%rd256], %rd3;
L6:
    mul.lo.u64 %rd256, %rd0, 8;
    add.u64 %rd256, %rd258, %rd256;
    st.global.u64 [%rd256], %rd4;
L7:
    ret;
}
