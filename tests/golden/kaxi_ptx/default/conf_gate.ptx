.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_mem
)
{
    .reg .b64 %rd<260>;
    .reg .f64 %fd<70>;
    .reg .f32 %f<260>;
    .reg .b32 %r<260>;
    .reg .pred %p<64>;

    ld.param.u64 %rd258, [param_mem];
L0:
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd0, %r1;
L1:
    mul.lo.u64 %rd256, %rd0, 8;
    add.u64 %rd256, %rd258, %rd256;
    ld.global.u64 %rd1, [%rd256];
L2:
    mov.u64 %rd2, 3;
L3:
    mov.u64 %rd3, 3;
L4:
    mov.u64 %rd4, 0;
L5:
    setp.le.u64 %p0, %rd1, %rd2;
L6:
    selp.b64 %rd5, %rd3, %rd4, %p0;
L7:
    mov.u32 %r1, %ntid.x;
    cvt.u64.u32 %rd6, %r1;
L8:
    add.u64 %rd7, %rd6, %rd0;
L9:
    mul.lo.u64 %rd256, %rd7, 8;
    add.u64 %rd256, %rd258, %rd256;
    st.global.u64 [%rd256], %rd5;
L10:
    ret;
}
