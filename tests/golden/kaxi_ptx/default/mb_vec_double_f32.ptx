.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_mem
)
{
    .reg .b64 %rd<260>;
    .reg .f64 %fd<70>;
    .reg .f32 %f<260>;
    .reg .b32 %r<260>;
    .reg .pred %p<64>;

    ld.param.u64 %rd258, [param_mem];
L0:
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd0, %r1;
L1:
    mov.u32 %r1, %ctaid.x;
    cvt.u64.u32 %rd1, %r1;
L2:
    mov.u32 %r1, %ntid.x;
    cvt.u64.u32 %rd2, %r1;
L3:
    mul.lo.u64 %rd3, %rd1, %rd2;
L4:
    add.u64 %rd4, %rd3, %rd0;
L5:
    mul.lo.u64 %rd256, %rd4, 8;
    add.u64 %rd256, %rd258, %rd256;
    ld.global.u64 %rd5, [%rd256];
L6:
    add.u64 %rd6, %rd5, %rd5;
L7:
    mul.lo.u64 %rd256, %rd4, 8;
    add.u64 %rd256, %rd258, %rd256;
    st.global.u64 [%rd256], %rd6;
L8:
    ret;
}
