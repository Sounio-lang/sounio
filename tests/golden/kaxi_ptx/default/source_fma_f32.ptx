.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_mem
)
{
    .reg .b64 %rd<70>;
    .reg .f64 %fd<70>;
    .reg .b32 %r<8>;
    .reg .pred %p<8>;

    ld.param.u64 %rd63, [param_mem];
L0:
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd0, %r1;
L1:
    mul.lo.u64 %rd64, %rd0, 8;
    add.u64 %rd64, %rd63, %rd64;
    ld.global.u64 %rd1, [%rd64];
L2:
    mul.lo.u64 %rd64, %rd0, 8;
    add.u64 %rd64, %rd63, %rd64;
    ld.global.u64 %rd2, [%rd64];
L3:
    mul.lo.u64 %rd64, %rd0, 8;
    add.u64 %rd64, %rd63, %rd64;
    ld.global.u64 %rd3, [%rd64];
L4:
    mul.lo.u64 %rd4, %rd1, %rd2;
L5:
    add.u64 %rd5, %rd4, %rd3;
L6:
    mul.lo.u64 %rd64, %rd0, 8;
    add.u64 %rd64, %rd63, %rd64;
    st.global.u64 [%rd64], %rd5;
L7:
    ret;
}
