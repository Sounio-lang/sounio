.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_mem,
    .param .u64 param_var
)
{
    .reg .b64 %rd<260>;
    .reg .f64 %fd<8>;
    .reg .b32 %r<8>;
    .reg .pred %p<64>;

    ld.param.u64 %rd258, [param_mem];
    ld.param.u64 %rd259, [param_var];
L0:
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd0, %r1;
    mov.u64 %rd128, 0;
L1:
    add.u64 %rd1, %rd0, %rd0;
    add.u64 %rd129, %rd128, %rd128;
L2:
    ret;
}
