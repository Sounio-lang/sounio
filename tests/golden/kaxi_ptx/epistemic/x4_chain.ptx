.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_mem,
    .param .u64 param_var
)
{
    .reg .b64 %rd<128>;
    .reg .b32 %r<8>;
    .reg .pred %p<8>;

    ld.param.u64 %rd96, [param_mem];
    ld.param.u64 %rd97, [param_var];
L0:
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd0, %r1;
    mov.u64 %rd32, 0;
L1:
    mul.lo.u64 %rd64, %rd0, 8;
    add.u64 %rd65, %rd96, %rd64;
    ld.global.u64 %rd1, [%rd65];
    add.u64 %rd65, %rd97, %rd64;
    ld.global.u64 %rd33, [%rd65];
L2:
    mul.lo.u64 %rd2, %rd1, %rd1;
    mul.lo.u64 %rd64, %rd1, %rd1;
    mul.lo.u64 %rd64, %rd64, %rd33;
    shl.b64 %rd34, %rd64, 2;
L3:
    mul.lo.u64 %rd3, %rd2, %rd1;
    mul.lo.u64 %rd64, %rd2, %rd2;
    mul.lo.u64 %rd64, %rd64, %rd33;
    mul.lo.u64 %rd65, %rd1, %rd1;
    mul.lo.u64 %rd65, %rd65, %rd34;
    add.u64 %rd35, %rd64, %rd65;
L4:
    mul.lo.u64 %rd4, %rd3, %rd1;
    mul.lo.u64 %rd64, %rd3, %rd3;
    mul.lo.u64 %rd64, %rd64, %rd33;
    mul.lo.u64 %rd65, %rd1, %rd1;
    mul.lo.u64 %rd65, %rd65, %rd35;
    add.u64 %rd36, %rd64, %rd65;
L5:
    mul.lo.u64 %rd64, %rd0, 8;
    add.u64 %rd65, %rd96, %rd64;
    st.global.u64 [%rd65], %rd4;
    add.u64 %rd65, %rd97, %rd64;
    st.global.u64 [%rd65], %rd36;
L6:
    ret;
}
