.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_mem
)
{
    .reg .b64 %rd<128>;
    .reg .b32 %r<8>;
    .reg .f32 %f<128>;
    .reg .pred %p<8>;

    ld.param.u64 %rd63, [param_mem];
L0:
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd0, %r1;
    cvt.rn.f32.u32 %f0, %r1;
L1:
    mov.u64 %rd1, 0;
    mov.u32 %r2, 0;
    cvt.rn.f32.s32 %f1, %r2;
L2:
    mul.lo.u64 %rd64, %rd1, 4;
    add.u64 %rd64, %rd63, %rd64;
    atom.global.add.f32 %f2, [%rd64], %f0;
L3:
    ret;
}
