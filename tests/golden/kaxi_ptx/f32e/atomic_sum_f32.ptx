.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_mem,
    .param .u64 param_var
)
{
    .reg .b64 %rd<128>;
    .reg .b32 %r<8>;
    .reg .f32 %f<128>;
    .reg .pred %p<8>;

    ld.param.u64 %rd96, [param_mem];
    ld.param.u64 %rd97, [param_var];
L0:
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd0, %r1;
    cvt.rn.f32.u32 %f0, %r1;
    mov.f32 %f32, 0f00000000;
L1:
    mov.u64 %rd1, 0;
    mov.u32 %r2, 0;
    cvt.rn.f32.s32 %f1, %r2;
    mov.f32 %f33, 0f00000000;
L2:
    // unhandled
L3:
    ret;
}
