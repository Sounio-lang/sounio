.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_a,
    .param .u64 param_b
)
{
    .reg .b64 %rd<260>;
    .reg .b32 %r<8>;
    .reg .f32 %f<260>;
    .reg .pred %p<64>;

    ld.param.u64 %rd258, [param_a];
    ld.param.u64 %rd259, [param_b];
L0:
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd0, %r1;
    cvt.rn.f32.u32 %f0, %r1;
L1:
    mul.lo.u64 %rd256, %rd0, 4;
    add.u64 %rd256, %rd258, %rd256;
    ld.global.f32 %f1, [%rd256];
L2:
    mov.f32 %f2, 0f3FC00000;
L3:
    mov.f32 %f3, 0f3F800000;
L4:
    mov.f32 %f4, 0f00000000;
L5:
    setp.le.f32 %p0, %f1, %f2;
L6:
    selp.f32 %f5, %f3, %f4, %p0;
L7:
    mov.u32 %r1, %ntid.x;
    cvt.u64.u32 %rd6, %r1;
    cvt.rn.f32.u32 %f6, %r1;
L8:
    add.u64 %rd7, %rd6, %rd0;
    add.rn.f32 %f7, %f6, %f0;
L9:
    mul.lo.u64 %rd256, %rd7, 4;
    add.u64 %rd256, %rd258, %rd256;
    st.global.f32 [%rd256], %f5;
L10:
    ret;
}
