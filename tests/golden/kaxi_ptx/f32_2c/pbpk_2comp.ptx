.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_a,
    .param .u64 param_b
)
{
    .reg .b64 %rd<260>;
    .reg .b32 %r<8>;
    .reg .f32 %f<260>;
    .reg .pred %p<64>;

    ld.param.u64 %rd258, [param_a];
    ld.param.u64 %rd259, [param_b];
L0:
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd0, %r1;
    cvt.rn.f32.u32 %f0, %r1;
L1:
    mul.lo.u64 %rd256, %rd0, 4;
    add.u64 %rd256, %rd258, %rd256;
    ld.global.f32 %f1, [%rd256];
L2:
    mul.lo.u64 %rd256, %rd0, 4;
    add.u64 %rd256, %rd259, %rd256;
    ld.global.f32 %f2, [%rd256];
L3:
    mov.f32 %f3, 0f3F800000;
L4:
    mov.f32 %f4, 0f3F000000;
L5:
    mov.f32 %f5, 0f3E800000;
L6:
    mov.f32 %f6, 0f3F000000;
L7:
    mul.lo.u64 %rd7, %rd4, %rd1;
    mul.rn.f32 %f7, %f4, %f1;
L8:
    mul.lo.u64 %rd8, %rd5, %rd2;
    mul.rn.f32 %f8, %f5, %f2;
L9:
    sub.u64 %rd9, %rd3, %rd7;
    sub.rn.f32 %f9, %f3, %f7;
L10:
    add.u64 %rd10, %rd9, %rd8;
    add.rn.f32 %f10, %f9, %f8;
L11:
    mul.lo.u64 %rd11, %rd6, %rd10;
    mul.rn.f32 %f11, %f6, %f10;
L12:
    add.u64 %rd12, %rd1, %rd11;
    add.rn.f32 %f12, %f1, %f11;
L13:
    sub.u64 %rd13, %rd7, %rd8;
    sub.rn.f32 %f13, %f7, %f8;
L14:
    mul.lo.u64 %rd14, %rd6, %rd13;
    mul.rn.f32 %f14, %f6, %f13;
L15:
    add.u64 %rd15, %rd2, %rd14;
    add.rn.f32 %f15, %f2, %f14;
L16:
    mul.lo.u64 %rd256, %rd0, 4;
    add.u64 %rd256, %rd258, %rd256;
    st.global.f32 [%rd256], %f12;
L17:
    mul.lo.u64 %rd256, %rd0, 4;
    add.u64 %rd256, %rd259, %rd256;
    st.global.f32 [%rd256], %f15;
L18:
    ret;
}
