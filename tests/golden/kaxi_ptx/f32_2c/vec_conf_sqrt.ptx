.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_a,
    .param .u64 param_b
)
{
    .reg .b64 %rd<260>;
    .reg .b32 %r<8>;
    .reg .f32 %f<260>;
    .reg .pred %p<64>;

    ld.param.u64 %rd258, [param_a];
    ld.param.u64 %rd259, [param_b];
L0:
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd0, %r1;
    cvt.rn.f32.u32 %f0, %r1;
L1:
    mul.lo.u64 %rd256, %rd0, 4;
    add.u64 %rd256, %rd258, %rd256;
    ld.global.f32 %f1, [%rd256];
L2:
    mul.lo.u64 %rd256, %rd0, 4;
    add.u64 %rd256, %rd259, %rd256;
    ld.global.f32 %f2, [%rd256];
L3:
    mov.f32 %f3, 0f3FC00000;
L4:
    mov.f32 %f4, 0f7FC00000;
L5:
    sqrt.approx.f32 %f5, %f1;
L6:
    setp.lt.f32 %p0, %f2, %f3;
L7:
    selp.f32 %f6, %f5, %f4, %p0;
L8:
    mul.lo.u64 %rd256, %rd0, 4;
    add.u64 %rd256, %rd258, %rd256;
    st.global.f32 [%rd256], %f6;
L9:
    ret;
}
