.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_a,
    .param .u64 param_b
)
{
    .reg .b64 %rd<260>;
    .reg .b32 %r<8>;
    .reg .f32 %f<260>;
    .reg .pred %p<64>;

    ld.param.u64 %rd258, [param_a];
    ld.param.u64 %rd259, [param_b];
L0:
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd0, %r1;
    cvt.rn.f32.u32 %f0, %r1;
L1:
    mul.lo.u64 %rd256, %rd0, 4;
    add.u64 %rd256, %rd258, %rd256;
    ld.global.f32 %f10, [%rd256];
L2:
    sqrt.approx.f32 %f20, %f10;
L3:
    // unhandled
L4:
    mov.f32 %f40, 0f3F800000;
L5:
    mov.f32 %f50, 0f7FC00000;
L6:
    setp.lt.f32 %p0, %f30, %f40;
L7:
    selp.f32 %f60, %f20, %f50, %p0;
L8:
    mul.lo.u64 %rd256, %rd0, 4;
    add.u64 %rd256, %rd258, %rd256;
    st.global.f32 [%rd256], %f60;
L9:
    ret;
}
