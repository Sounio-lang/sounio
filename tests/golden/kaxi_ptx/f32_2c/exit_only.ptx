.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_a,
    .param .u64 param_b
)
{
    .reg .b64 %rd<128>;
    .reg .b32 %r<8>;
    .reg .f32 %f<70>;
    .reg .pred %p<8>;

    ld.param.u64 %rd96, [param_a];
    ld.param.u64 %rd97, [param_b];
L0:
    ret;
}
