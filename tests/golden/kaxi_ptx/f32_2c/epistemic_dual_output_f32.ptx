.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_a,
    .param .u64 param_b
)
{
    .reg .b64 %rd<128>;
    .reg .b32 %r<8>;
    .reg .f32 %f<70>;
    .reg .pred %p<8>;

    ld.param.u64 %rd96, [param_a];
    ld.param.u64 %rd97, [param_b];
L0:
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd0, %r1;
    cvt.rn.f32.u32 %f0, %r1;
L1:
    mul.lo.u64 %rd64, %rd0, 4;
    add.u64 %rd64, %rd96, %rd64;
    ld.global.f32 %f1, [%rd64];
L2:
    mul.lo.u64 %rd64, %rd0, 4;
    add.u64 %rd64, %rd96, %rd64;
    ld.global.f32 %f2, [%rd64];
L3:
    add.u64 %rd3, %rd1, %rd2;
    add.rn.f32 %f3, %f1, %f2;
L4:
    mul.lo.u64 %rd4, %rd2, %rd2;
    mul.rn.f32 %f4, %f2, %f2;
L5:
    mul.lo.u64 %rd64, %rd0, 4;
    add.u64 %rd64, %rd96, %rd64;
    st.global.f32 [%rd64], %f3;
L6:
    mul.lo.u64 %rd64, %rd0, 4;
    add.u64 %rd64, %rd96, %rd64;
    st.global.f32 [%rd64], %f4;
L7:
    ret;
}
