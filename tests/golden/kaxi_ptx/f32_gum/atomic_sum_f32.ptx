.version 7.0
.target sm_50
.address_size 64

.visible .entry kaxi_kernel(
    .param .u64 param_a,
    .param .u64 param_b,
    .param .u64 param_c,
    .param .u64 param_d
)
{
    .reg .b64 %rd<262>;
    .reg .b32 %r<8>;
    .reg .f32 %f<260>;
    .reg .pred %p<64>;

    ld.param.u64 %rd258, [param_a];
    ld.param.u64 %rd259, [param_b];
    ld.param.u64 %rd260, [param_c];
    ld.param.u64 %rd261, [param_d];
L0:
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd0, %r1;
    cvt.rn.f32.u32 %f0, %r1;
L1:
    mov.u64 %rd1, 0;
    mov.u32 %r2, 0;
    cvt.rn.f32.s32 %f1, %r2;
L2:
    mul.lo.u64 %rd256, %rd1, 4;
    add.u64 %rd256, %rd258, %rd256;
    atom.global.add.f32 %f2, [%rd256], %f0;
L3:
    ret;
}
