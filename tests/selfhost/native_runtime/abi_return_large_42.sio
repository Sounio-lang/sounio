struct Large {
    vals: [i64; 256],
    tag: i64,
}

fn make_large() -> Large with Mut, Panic, Div {
    var m = Large {
        vals: [0; 256],
        tag: 0,
    }
    m.vals[0] = 10
    m.vals[255] = 32
    m.tag = 2
    return m
}

fn main() -> i32 with Mut, Panic, Div {
    let m = make_large()
    if m.tag != 2 { return 1 }
    return (m.vals[0] + m.vals[255]) as i32
}
