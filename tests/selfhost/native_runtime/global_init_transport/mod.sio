use global_init_transport::nested::{NESTED_VALUE}

pub let DEP_NEGATIVE: i64 = -3
pub let DEP_POSITIVE: i64 = 131072
pub let DEP_VERSION: i64 = 5
pub let DEP_ZERO: i64 = 0
pub var DEP_MUTABLE: i64 = 7

pub fn read_negative() -> i64 { DEP_NEGATIVE }
pub fn read_positive() -> i64 { DEP_POSITIVE }
pub fn read_version() -> i64 { DEP_VERSION }
pub fn read_zero() -> i64 { DEP_ZERO }
pub fn read_mutable() -> i64 { DEP_MUTABLE }
pub fn read_nested() -> i64 { NESTED_VALUE }
