struct Mixed {
    head: i64,
    vals: [i64; 2],
    tail: i64,
}

fn make_mixed() -> Mixed with Mut, Panic, Div {
    var s = Mixed {
        head: 0,
        vals: [0; 2],
        tail: 0,
    }
    s.head = 7
    s.vals[0] = 10
    s.vals[1] = 32
    s.tail = 5
    return s
}

fn main() -> i32 with Mut, Panic, Div {
    let s = make_mixed()
    if s.head != 7 { return 1 }
    if s.tail != 5 { return 2 }
    return (s.vals[0] + s.vals[1]) as i32
}
