struct S40 {
    a: i64,
    b: i64,
    c: i64,
    d: i64,
    e: i64,
}

fn make_s40() -> S40 with Mut, Panic, Div {
    var s = S40 { a: 0, b: 0, c: 0, d: 0, e: 0 }
    s.a = 10
    s.e = 32
    return s
}

fn main() -> i32 with Mut, Panic, Div {
    let s = make_s40()
    return (s.a + s.e) as i32
}
