extern "C" {
    fn malloc(size: usize) -> *mut u8;
}

struct Pair {
    a: i64,
    b: i64,
}

fn fill_pair(raw: *mut Pair) with Mut {
    (*raw).a = 10
    (*raw).b = 32
}

fn main() -> i32 with Alloc, Mut, Panic, Div {
    let raw = malloc(16) as *mut Pair
    fill_pair(raw)
    return ((*raw).a + (*raw).b) as i32
}
