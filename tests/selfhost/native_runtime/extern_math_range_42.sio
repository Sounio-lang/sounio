extern "C" {
    fn sqrt(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn log(x: f64) -> f64;
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() -> i32 with Mut {
    var score: i32 = 0
    let e1 = exp(0.0 - 10.0)
    let l1 = log(1.0e-12)
    let s1 = sqrt(1.0e-12)
    if abs_f64(e1 - 0.0000453999) < 0.000001 { score = score + 14 }
    if abs_f64(l1 - (0.0 - 27.6310211)) < 0.01 { score = score + 14 }
    if abs_f64(s1 - 0.000001) < 0.000001 { score = score + 14 }
    score
}
