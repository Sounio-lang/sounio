//@ run-pass

struct Dual {
    val: f64,
    dot: f64,
}

fn mk(x: f64) -> Dual with Mut, Panic {
    Dual { val: x, dot: 0.0 }
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn approx_eq(a: f64, b: f64, tol: f64) -> bool {
    abs_f64(a - b) < tol
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let c = mk(42.0)
    let tol = 1.0e-12
    let val_ok = approx_eq(c.val, 42.0, tol)
    let dot_ok = approx_eq(c.dot, 0.0, tol)
    if val_ok && dot_ok { return 42 }
    return 0
}
