extern "C" {
    fn sqrt(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn log(x: f64) -> f64;
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() -> i32 with Mut {
    let a = sqrt(25.0)
    let b = log(exp(1.0))
    let c = exp(log(4.0))
    var score: i32 = 0
    if abs_f64(a - 5.0) < 0.01 { score = score + 14 }
    if abs_f64(b - 1.0) < 0.01 { score = score + 14 }
    if abs_f64(c - 4.0) < 0.05 { score = score + 14 }
    score
}
