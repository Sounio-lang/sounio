struct Source {
    head: f64,
    vals: [f64; 8],
    tail: i64,
}

struct Result {
    head: f64,
    vals: [f64; 8],
    count: i64,
    success: i64,
}

fn make_source() -> Source with Mut, Panic, Div {
    var vals: [f64; 8] = [0.0; 8]
    vals[0] = 11.0
    vals[1] = 31.0
    return Source {
        head: 3.0,
        vals: vals,
        tail: 7,
    }
}

fn make_result() -> Result with Mut, Panic, Div {
    let src = make_source()
    return Result {
        head: src.head,
        vals: src.vals,
        count: src.tail + 35,
        success: 1,
    }
}

fn main() -> i32 with Mut, Panic, Div {
    let result = make_result()
    if result.vals[0] != 11.0 { return 1 }
    if result.vals[1] != 31.0 { return 2 }
    if result.count != 42 { return 3 }
    if result.success != 1 { return 4 }
    return result.count as i32
}
