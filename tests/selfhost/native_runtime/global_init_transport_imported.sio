use global_init_transport::mod::{DEP_NEGATIVE, DEP_ZERO, DEP_MUTABLE, read_negative, read_positive, read_version, read_zero, read_mutable, read_nested}

fn main() -> i32 with IO {
    print("GLOBAL_INIT_IMPORTED neg=")
    print_int(read_negative())
    print(" direct_neg=")
    print_int(DEP_NEGATIVE)
    print(" pos=")
    print_int(read_positive())
    print(" version=")
    print_int(read_version())
    print(" zero=")
    print_int(read_zero())
    print(" mutable=")
    print_int(read_mutable())
    print(" direct_mutable=")
    print_int(DEP_MUTABLE)
    DEP_MUTABLE = 41
    print(" shared_after=")
    print_int(read_mutable())
    print(" nested=")
    print_int(read_nested())
    print("\n")
    0
}
