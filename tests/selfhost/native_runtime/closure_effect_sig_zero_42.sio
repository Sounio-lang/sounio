fn run0(f: fn() -> i64) -> i64 {
    f()
}

fn apply_io(f: fn(i64) -> i64 with IO, x: i64) -> i64 with IO {
    f(x)
}

fn main() -> i32 with IO {
    let const42 = || 42
    let echo = |x: i64| -> i64 with IO { x }
    let a = run0(const42)
    let b = apply_io(echo, 42)
    if a == 42 && b == 42 { 42 } else { 0 }
}
