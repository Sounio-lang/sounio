struct CoreTriple {
    a: i64,
    b: i64,
    c: i64,
}

fn make_triple() -> CoreTriple {
    CoreTriple { a: 7, b: 11, c: 13 }
}

fn double(x: i64) -> i64 {
    x * 2
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn pass_through(f: fn(i64) -> i64) -> fn(i64) -> i64 {
    f
}

fn select_unary(which: i64) -> fn(i64) -> i64 with Mut, Panic, Div {
    if which == 0 { double } else { double }
}

fn entry(f: fn(i64) -> i64, x: i64) -> i64 {
    apply(f, x)
}
