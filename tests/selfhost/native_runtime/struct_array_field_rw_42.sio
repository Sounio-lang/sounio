struct Buf {
    ints: [i32; 4],
    vals: [f64; 4],
    len: i32,
}

fn main() -> i32 with Mut, Panic {
    var b = Buf {
        ints: [0; 4],
        vals: [0.0; 4],
        len: 0,
    }
    b.ints[0] = 7
    b.vals[0] = 2.5
    if b.ints[0] != 7 { return 11 }
    if b.vals[0] <= 2.0 { return 12 }
    if b.len != 0 { return 13 }
    return 42
}
