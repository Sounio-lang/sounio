extern "C" {
    fn malloc(size: usize) -> *mut u8;
}

struct Pair {
    a: i64,
    b: i64,
}

fn fill_pair(raw: *mut Pair) with Mut {
    (*raw).a = 10
    (*raw).b = 32
}

fn load_pair(raw: *mut Pair) -> Pair with Mut, Panic, Div {
    return *raw
}

fn main() -> i32 with Alloc, Mut, Panic, Div {
    let raw = malloc(16) as *mut Pair
    fill_pair(raw)
    let p = load_pair(raw)
    return (p.a + p.b) as i32
}
