struct S48 {
    a: i64,
    b: i64,
    c: i64,
    d: i64,
    e: i64,
    f: i64,
}

fn make_s48() -> S48 with Mut, Panic, Div {
    var s = S48 { a: 0, b: 0, c: 0, d: 0, e: 0, f: 0 }
    s.a = 10
    s.f = 32
    return s
}

fn main() -> i32 with Mut, Panic, Div {
    let s = make_s48()
    return (s.a + s.f) as i32
}
