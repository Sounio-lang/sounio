struct S48 {
    a: i64,
    b: i64,
    c: i64,
    d: i64,
    e: i64,
    f: i64,
}

fn write_s48(out: &! S48) with Mut {
    out.a = 10
    out.f = 32
}

fn main() -> i32 with Mut, Panic, Div {
    var s = S48 { a: 0, b: 0, c: 0, d: 0, e: 0, f: 0 }
    write_s48(&!s)
    return (s.a + s.f) as i32
}
