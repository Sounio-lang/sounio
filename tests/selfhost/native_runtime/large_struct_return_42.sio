struct LargeRet {
    times: [f64; 256],
    states: [f64; 2048],
    n_points: i32,
    n_eqs: i32
}

fn make_large() -> LargeRet with Mut, Panic, Div {
    var out = LargeRet {
        times: [0.0; 256],
        states: [0.0; 2048],
        n_points: 0,
        n_eqs: 8
    }
    out.times[0] = 1.0
    out.times[1] = 2.0
    out.states[0] = 10.0
    out.states[17] = 32.0
    out.n_points = 2
    return out
}

fn main() -> i32 with Mut, Panic, Div {
    let traj = make_large()
    let ok0 = traj.n_points == 2
    let ok1 = traj.n_eqs == 8
    let ok2 = traj.times[1] > 1.5
    let ok3 = traj.states[17] > 31.0
    if ok0 && ok1 && ok2 && ok3 {
        return 42
    }
    return 1
}
