struct Inner {
    vals: [i64; 2],
}

struct OuterOnly {
    inner: Inner,
}

fn make_outer() -> OuterOnly with Mut, Panic, Div {
    var s = OuterOnly {
        inner: Inner { vals: [0; 2] },
    }
    s.inner.vals[0] = 10
    s.inner.vals[1] = 32
    return s
}

fn main() -> i32 with Mut, Panic, Div {
    let s = make_outer()
    return (s.inner.vals[0] + s.inner.vals[1]) as i32
}
