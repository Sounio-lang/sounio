struct Tape {
    op: [i32; 64]
    arg1: [i32; 64]
    arg2: [i32; 64]
    val: [f64; 64]
    adj: [f64; 64]
    len: i32
}

fn tape_new() -> Tape with Mut, Panic {
    Tape {
        op: [0; 64],
        arg1: [-1; 64],
        arg2: [-1; 64],
        val: [0.0; 64],
        adj: [0.0; 64],
        len: 0,
    }
}

fn tape_input(tape: Tape, x: f64) -> Tape with Mut, Panic {
    var t = tape
    let idx = t.len
    t.op[idx] = 0
    t.arg1[idx] = -1
    t.arg2[idx] = -1
    t.val[idx] = x
    t.adj[idx] = 0.0
    t.len = idx + 1
    return t
}

fn main() -> i32 with Mut, Panic, Div {
    var t = tape_new()
    t = tape_input(t, 3.0)
    t = tape_input(t, 4.0)
    if t.val[0] != 3.0 { return 11 }
    if t.val[1] != 4.0 { return 12 }
    if t.arg1[0] != -1 { return 13 }
    if t.arg1[1] != -1 { return 14 }
    if t.len != 2 { return 15 }
    return 42
}
