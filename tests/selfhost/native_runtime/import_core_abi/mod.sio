struct CorePair {
    left: i64,
    right: i64,
}

struct CoreTriple {
    a: i64,
    b: i64,
    c: i64,
}

fn make_pair() -> CorePair {
    CorePair { left: 10, right: 5 }
}

fn make_triple() -> CoreTriple {
    CoreTriple { a: 7, b: 11, c: 13 }
}

fn array_tail_sum() -> i64 with Mut, Panic, Div {
    var xs: [i64; 3] = [0; 3]
    xs[0] = 2
    xs[1] = 3
    xs[2] = 4
    xs[0 as usize] + xs[2 as usize]
}

fn add_bias(x: i64) -> i64 {
    x + 1
}

fn entry() -> i64 with Mut, Panic, Div {
    let pair = make_pair()
    let array_sum = array_tail_sum()
    add_bias(pair.left + pair.right + array_sum)
}
