struct Holder {
    y: [f64; 8],
    n: i32
}

fn main() -> i32 with Mut, Panic, Div {
    var h = Holder {
        y: [0.0; 8],
        n: 2
    }
    var src: [f64; 8] = [0.0; 8]
    src[0] = 11.0
    src[1] = 31.0
    h.y = src
    if h.y[0] > 10.0 && h.y[1] > 30.0 && h.n == 2 {
        return 42
    }
    return 1
}
