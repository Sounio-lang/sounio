struct Inner3 {
    vals: [i64; 3],
}

struct Outer3 {
    inner: Inner3,
}

fn make_outer() -> Outer3 with Mut, Panic, Div {
    var s = Outer3 {
        inner: Inner3 { vals: [0; 3] },
    }
    s.inner.vals[0] = 10
    s.inner.vals[1] = 20
    s.inner.vals[2] = 12
    return s
}

fn main() -> i32 with Mut, Panic, Div {
    let s = make_outer()
    return (s.inner.vals[0] + s.inner.vals[1] + s.inner.vals[2]) as i32
}
