struct WithArray {
    vals: [i64; 2],
    tag: i64,
}

fn write_vals(out: &! WithArray) with Mut, Panic, Div {
    out.vals[0] = 10
    out.vals[1] = 32
    out.tag = 1
}

fn main() -> i32 with Mut, Panic, Div {
    var s = WithArray {
        vals: [0; 2],
        tag: 0,
    }
    write_vals(&!s)
    if s.tag != 1 { return 1 }
    return (s.vals[0] + s.vals[1]) as i32
}
