struct BigTrace {
    times: [f64; 256]
    states: [f64; 2048]
    n_points: i32
    n_eqs: i32
}

fn build_trace() -> BigTrace with Mut, Panic, Div {
    var out = BigTrace {
        times: [0.0; 256],
        states: [0.0; 2048],
        n_points: 0,
        n_eqs: 8
    }
    var i: i32 = 0
    while i < 255 {
        out.times[i] = i as f64
        out.states[i * 8] = (i + 1000) as f64
        i = i + 1
    }
    out.n_points = 255
    return out
}

fn main() -> i32 with Mut, Panic, Div {
    let trace = build_trace()
    if trace.n_points != 255 { return 11 }
    if trace.n_eqs != 8 { return 12 }
    if trace.times[46] != 46.0 { return 13 }
    if trace.times[47] != 47.0 { return 14 }
    if trace.times[254] != 254.0 { return 15 }
    if trace.states[46 * 8] != 1046.0 { return 16 }
    if trace.states[47 * 8] != 1047.0 { return 17 }
    if trace.states[254 * 8] != 1254.0 { return 18 }
    return 42
}
