struct Medium {
    vals: [i64; 16],
    tag: i64,
}

fn make_medium() -> Medium with Mut, Panic, Div {
    var m = Medium {
        vals: [0; 16],
        tag: 0,
    }
    m.vals[0] = 10
    m.vals[15] = 32
    m.tag = 2
    return m
}

fn main() -> i32 with Mut, Panic, Div {
    let m = make_medium()
    if m.tag != 2 { return 1 }
    return (m.vals[0] + m.vals[15]) as i32
}
