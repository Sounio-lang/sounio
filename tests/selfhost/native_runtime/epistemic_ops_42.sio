fn abs_f64_local(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() -> i64 with IO, Mut, Panic, Div, Epistemic {
    let a: Knowledge<f64> = measure(10.0, uncertainty: 0.3, confidence: 0.8)
    let b: Knowledge<f64> = measure(20.0, uncertainty: 0.4, confidence: 0.6)
    let sum = a + b
    let prod = a * b
    let quot = a / b

    if abs_f64_local(sum.value - 30.0) > 0.000001 { return 1 }
    if abs_f64_local(sum.uncertainty - 0.5) > 0.001 { return 2 }
    if abs_f64_local(sum.confidence - 0.6) > 0.000001 { return 3 }

    if abs_f64_local(prod.value - 200.0) > 0.000001 { return 4 }
    if abs_f64_local(prod.uncertainty - 7.21110255) > 0.01 { return 5 }
    if abs_f64_local(prod.confidence - 0.6) > 0.000001 { return 6 }

    if abs_f64_local(quot.value - 0.5) > 0.000001 { return 7 }
    if abs_f64_local(quot.uncertainty - 0.018027756) > 0.001 { return 8 }
    if abs_f64_local(quot.confidence - 0.6) > 0.000001 { return 9 }

    return 42
}
