struct Inner {
    vals: [i64; 2],
}

struct Outer {
    inner: Inner,
    tag: i64,
}

fn make_outer() -> Outer with Mut, Panic, Div {
    var s = Outer {
        inner: Inner { vals: [0; 2] },
        tag: 0,
    }
    s.inner.vals[0] = 10
    s.inner.vals[1] = 32
    s.tag = 1
    return s
}

fn main() -> i32 with Mut, Panic, Div {
    let s = make_outer()
    if s.tag != 1 { return 1 }
    return (s.inner.vals[0] + s.inner.vals[1]) as i32
}
