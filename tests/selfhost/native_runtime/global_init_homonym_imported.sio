use global_init_homonym::a::{read_a, write_a}
use global_init_homonym::b::{read_b, write_b}

fn main() -> i32 with IO, Mut {
    print("GLOBAL_INIT_HOMONYM a_before=")
    print_int(read_a())
    print(" b_before=")
    print_int(read_b())
    write_a(31)
    write_b(42)
    print(" a_after=")
    print_int(read_a())
    print(" b_after=")
    print_int(read_b())
    print("\n")
    0
}
