fn main() -> i32 with IO, Panic {
    print("GPU_RUNTIME_SLICE_START\n")
    let raw = read_file("tests/fixtures/fmri/tiny_real_motion.tsv")
    let b = raw.as_bytes()
    let n = b.len() as i64
    let k = if n > 12 { 12 } else { n }
    let head = &b[..k as usize]
    print("GPU_RUNTIME_SLICE_LEN ")
    print(head.len() as i64)
    print("\n")
    print("GPU_RUNTIME_SLICE_AFTER\n")
    0
}
