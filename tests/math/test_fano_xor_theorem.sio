// tests/math/test_fano_xor_theorem.sio
//
// CLAIM: For all ordered triples (i,j,k) with i,j,k in {1..7}, all distinct,
// the octonion Fano predicate coincides exactly with GF(2) linear independence:
//
//   ir_can_reassociate_triple(3, i, j, k) == true
//   iff
//   i XOR j XOR k == 0
//
// If true, the 168 non-Fano triples biject with GL(3,2) = PSL(2,7)
// via the matrix whose columns are bin(i), bin(j), bin(k) in GF(2)^3.
//
// Counts: Fano = 42, non-Fano = 168, total ordered = 210 = 7*6*5
//
// Connection:
//   PSL(2,7) = GL(3,2) = Aut(Fano plane) = finite subgroup of G_2
//   G_2 = Aut(O) = zero divisor variety of S (Moreno 1998)
//   => 168 non-Fano triples embed into the sedenion zero divisor variety.

// --- Inlined from self-hosted/ir/algebra.sio ---
// (No cross-file import; standalone for souc run)

fn cd_sigma(a: i64, b: i64, bits: i64) -> i64 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma(a_lo, b_lo, bits - 1) }
        else { return 0 - cd_sigma(a_lo, b_lo, bits - 1) }
    }
    if b_lo == 0 { return 0 - cd_sigma(b_lo, a_lo, bits - 1) }
    return cd_sigma(b_lo, a_lo, bits - 1)
}

fn fano_triple(bits: i64, i: i64, j: i64, k: i64) -> bool with Mut, Panic, Div {
    if bits < 3 { return true }
    if i == 0 || j == 0 || k == 0 { return true }
    if i == j || j == k || i == k { return true }
    let alpha = cd_sigma(i, j, bits) * cd_sigma(i ^ j, k, bits)
    let beta  = cd_sigma(j, k, bits) * cd_sigma(i, j ^ k, bits)
    alpha == beta
}

// --- Verification ---

fn main() -> i64 with IO, Mut, Div, Panic {
    var fano_count    = 0
    var non_fano_count = 0
    var mismatches    = 0

    var i = 1
    while i <= 7 {
        var j = 1
        while j <= 7 {
            var k = 1
            while k <= 7 {
                if i != j && j != k && i != k {
                    let sigma_fano = fano_triple(3, i, j, k)
                    let xor_fano   = (i ^ j ^ k) == 0

                    if sigma_fano != xor_fano {
                        mismatches = mismatches + 1
                        print("MISMATCH (")
                        print_int(i)
                        print(",")
                        print_int(j)
                        print(",")
                        print_int(k)
                        print("): sigma=")
                        if sigma_fano { print("T") } else { print("F") }
                        print(" xor=")
                        if xor_fano  { print("T") } else { print("F") }
                        print("\n")
                    }

                    if sigma_fano { fano_count = fano_count + 1 }
                    else          { non_fano_count = non_fano_count + 1 }
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    print("Fano triples (sigma):     ") print_int(fano_count)     print(" (expect 42)\n")
    print("Non-Fano triples (sigma): ") print_int(non_fano_count) print(" (expect 168)\n")
    print("XOR characterisation mismatches: ") print_int(mismatches) print("\n")

    if fano_count == 42 && non_fano_count == 168 && mismatches == 0 {
        print("THEOREM VERIFIED: Fano(i,j,k) <=> i XOR j XOR k == 0\n")
        print("168 non-Fano triples biject with GL(3,2) = PSL(2,7)\n")
        print("=> 168 theorem is a sedenion zero-divisor geometry theorem\n")
        return 0
    }

    print("VERIFICATION FAILED\n")
    return 1
}
