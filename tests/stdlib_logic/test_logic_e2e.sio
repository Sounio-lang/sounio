//@ run-pass
// E2E tests for stdlib/logic

use logic::pure::types

fn run_tests() -> i32 with IO, Mut {
    var pass = 0
    var fail = 0

    print("Test 01: expr_new_literal and expr_type... ")
    var lit = expr_new_literal(true)
    if expr_type(&lit) == ExprType::literal() {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 02: expr_new_var and expr_type... ")
    var v = expr_new_var("x")
    if expr_type(&v) == ExprType::variable() {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 03: expr_new_not... ")
    var not_expr = expr_new_not(lit)
    if expr_type(&not_expr) == ExprType::not() {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 04: expr_new_and... ")
    var and_expr = expr_new_and(lit, v)
    if expr_type(&and_expr) == ExprType::and() {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 05: expr_new_or... ")
    var or_expr = expr_new_or(and_expr, not_expr)
    if expr_type(&or_expr) == ExprType::or() {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    if fail == 0 {
        print("stdlib_logic: ALL PASS (")
        print(pass)
        print("/5)\n")
        0
    } else {
        print("stdlib_logic: FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut {
    run_tests()
}