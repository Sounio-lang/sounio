//@ run-pass
// E2E tests for stdlib/serial

use serial::pure::types

fn run_tests() -> i32 with IO, Mut {
    var pass = 0
    var fail = 0

    print("Test 01: serial_config_new sets baud rate... ")
    var cfg = serial_config_new(9600)
    if cfg.baud_rate == 9600 && cfg.data_bits == 8 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 02: serial_buffer_new creates empty buffers... ")
    var buf = serial_buffer_new()
    if buf.rx_len == 0 && buf.tx_len == 0 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 03: serial_buffer_push_rx increments rx_len... ")
    serial_buffer_push_rx(&! buf, 0x42)
    if buf.rx_len == 1 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 04: serial_buffer_push_rx adds multiple bytes... ")
    serial_buffer_push_rx(&! buf, 0xFF)
    serial_buffer_push_rx(&! buf, 0x00)
    if buf.rx_len == 3 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 05: serial_buffer_push_rx respects capacity... ")
    var buf2 = serial_buffer_new()
    var i = 0
    while i < 260 {
        serial_buffer_push_rx(&! buf2, 0xAA)
        i = i + 1
    }
    if buf2.rx_len == 256 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL (len=")
        print(buf2.rx_len)
        print(")\n")
        fail = fail + 1
    }

    if fail == 0 {
        print("stdlib_serial: ALL PASS (")
        print(pass)
        print("/5)\n")
        0
    } else {
        print("stdlib_serial: FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut {
    run_tests()
}