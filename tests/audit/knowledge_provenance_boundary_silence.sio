//@ description: provenance-only mismatch at a fn boundary — Knowledge[f64, eps < 0.05, Computed] passed where Knowledge[f64, eps < 0.05, Measured] is required
// De-confounded design: inner type, epsilon bound, and validity are IDENTICAL
// on both sides (f64, eps < 0.05, no ValidUntil → always-valid). The two
// annotations differ ONLY in the provenance word (Computed vs Measured).
// Any refusal of this program is therefore attributable to provenance alone.
//
// Measured 2026-08-31 (from-source Madaros, Slurm r770): raw mode silent.
// A first version of this probe carried validity/epsilon fields that tripped
// E036 (epsilon/validity boundary legs) in check mode — a refusal, but not a
// provenance refusal. This version removes those confounds.
//
// Basis: knowledge_call_boundary_compatible (self-hosted/check/epistemic.sio:908-924)
// DOES call provenance_subsumes — but knowledge_meta_from_ty (:497-530) rebuilds
// both metas as always-valid/DERIVED first, so the comparison is structurally
// blind: the socket exists, the wire carries nothing.

fn requires_measured(x: Knowledge[f64, eps < 0.05, Measured]) -> i64 {
    0
}

fn main() -> i64 {
    let computed_value: Knowledge[f64, eps < 0.05, Computed] = Knowledge {
        value: 3.14,
        epsilon: 0.01,
        validity: "2026-08-31",
        provenance: "deterministic_recurrence"
    }
    requires_measured(computed_value)
}
