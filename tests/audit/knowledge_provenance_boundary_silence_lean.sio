//@ description: lean_single leg — provenance-only mismatch at a fn boundary (Knowledge[f64, Computed] into Knowledge[f64, Measured])
// Shape differs from knowledge_provenance_boundary_silence.sio by design:
// lean_single's ty_eq is annotation-hash-based, and an explicit eps bound on
// the annotation trips its generic P0003 epistemic-boundary error at the `let`
// (measured 2026-08-31, Slurm r770, from-source build). This shape carries no
// eps bound, so lean_single accepts the epsilon surface and the ONLY thing
// left to disagree on is the provenance word.
// lean_single is the bootstrap engine, not the semantic clock (ADR-008); this
// leg measures whether the legacy path carries the same silence.

fn requires_measured(x: Knowledge[f64, Measured]) -> i64 {
    0
}

fn main() -> i64 {
    let computed_value: Knowledge[f64, Computed] = Knowledge {
        value: 3.14,
        epsilon: 0.01,
        validity: "2026-08-31",
        provenance: "deterministic_recurrence"
    }
    requires_measured(computed_value)
}
