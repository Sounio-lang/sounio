//@ description: Madaros-leg CONTROL — validity mismatch with the epsilon surface satisfied on both sides
// Same isolation discipline as the silence probe: inner type identical,
// eps < 0.05 declared on both sides and satisfied by the literal (0.01),
// provenance identical (Derived). The ONLY disagreement is the validity
// window (2020-03-10 cannot satisfy a 2020-03-31 requirement). Any refusal
// is therefore attributable to validity alone. If this control does NOT
// refuse under Madaros, the Madaros legs of this gate measure nothing.

fn require_march_window(
    signal: Knowledge[f64, eps < 0.05, ValidUntil("2020-03-31"), Derived]
) -> Knowledge[f64, eps < 0.05, ValidUntil("2020-03-31"), Derived] {
    signal
}

fn main() -> i64 {
    let stale_signal: Knowledge[f64, eps < 0.05, ValidUntil("2020-03-10"), Derived] = Knowledge {
        value: 1.7,
        epsilon: 0.01,
        validity: "2020-03-10",
        provenance: "icu_report_2020_03_10"
    }
    let _ = require_march_window(stale_signal)
    0
}
