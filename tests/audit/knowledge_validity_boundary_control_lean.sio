//@ description: lean_single-leg CONTROL — validity mismatch (covid-style shape, no eps bound)
// lean_single's annotation-hash ty_eq rejects explicit eps bounds with a
// generic P0003, so this leg keeps the covid_2020 fixture shape: no eps
// component, validity windows mismatched. Refusal with the dedicated
// "Temporal validity window" message is the lean_single dialect of the
// control. If this does not refuse, the lean leg measures nothing.

fn require_march_window(
    signal: Knowledge[f64, ValidUntil("2020-03-31"), Derived]
) -> Knowledge[f64, ValidUntil("2020-03-31"), Derived] {
    signal
}

fn main() -> i64 {
    let stale_signal: Knowledge[f64, ValidUntil("2020-03-10"), Derived] = Knowledge {
        value: 1.7,
        epsilon: 0.86,
        validity: "2020-03-10",
        provenance: "icu_report_2020_03_10"
    }
    let _ = require_march_window(stale_signal)
    0
}
