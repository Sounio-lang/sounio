// ADR-023 §1 probe: a store through a struct field array at index 8 of 8.
// Without the check it would overwrite the neighbouring field `b`.
struct S {
    a: [i64; 8],
    b: [i64; 8],
}

fn main() -> i32 with IO, Mut, Panic {
    var s = S { a: [0; 8], b: [0; 8] }
    var i: i64 = 8
    s.a[i as usize] = 4242
    print_int(s.b[0])
    println("")
    println("NOT_REACHED")
    0
}
