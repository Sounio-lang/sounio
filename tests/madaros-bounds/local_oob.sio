// ADR-023 §1 probe: a local [i64; 3] read at index 5. Built with
// SOUNIO_NV2_BOUNDS_CHECK=1 the program must exit 101 before printing.
fn main() -> i32 with IO, Mut, Panic {
    var a: [i64; 3] = [1, 2, 3]
    var i: i64 = 5
    print_int(a[i as usize])
    println("")
    println("NOT_REACHED")
    0
}
