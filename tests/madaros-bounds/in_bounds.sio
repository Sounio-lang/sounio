// ADR-023 §1 probe control: every index in range, including the last one and
// tuple element access (tuples carry no header length and are not checked).
struct S {
    a: [i64; 8],
}

fn sum(a: [i64; 4]) -> i64 with Mut, Panic {
    var t: i64 = 0
    var i: i64 = 0
    while i < 4 {
        t = t + a[i as usize]
        i = i + 1
    }
    t
}

fn main() -> i32 with IO, Mut, Panic {
    var a: [i64; 4] = [1, 2, 3, 4]
    var s = S { a: [5; 8] }
    s.a[7] = 9
    let t: ([i64; 4], i64) = (a, 2)
    let x = t.0
    if sum(a) == 10 && s.a[7] == 9 && x[3] == 4 && t.1 == 2 {
        println("BOUNDS_IN_RANGE_OK")
        return 0
    }
    1
}
