// ADR-023 §1 probe: a by-value array parameter read at index -1. The check is
// unsigned, so a negative index fails like one at or above the length.
fn get(a: [i64; 3], i: i64) -> i64 with Panic {
    a[i as usize]
}

fn main() -> i32 with IO, Mut, Panic {
    var a: [i64; 3] = [1, 2, 3]
    print_int(get(a, -1))
    println("")
    println("NOT_REACHED")
    0
}
