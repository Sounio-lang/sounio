//@ run-pass

fn keep_f64(value: f64) -> f64 {
    value
}

fn keep_i64(value: i64) -> i64 {
    value
}

fn main() -> i64 with IO {
    println(keep_f64(0.0 - 0.2))
    println(keep_f64(0.0 - 1.5))
    println(keep_f64(0.2))
    print_int(keep_i64(42))
    print("\n")
    print("PRINT_F64_NEGATIVE_SIGN_PASS\n")
    0
}
