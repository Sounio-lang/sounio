struct Octonion {
    a: f64,
    b: f64
}

fn oct_norm_sq(o: Octonion) -> f64 {
    return o.a*o.a + o.b*o.b
}

fn oct_conj(o: Octonion) -> Octonion {
    return Octonion { a: o.a, b: -o.b }
}

fn main() {
    let o1 = Octonion { a: 3.0, b: 4.0 }

    println("o1.a = ")
    println(o1.a)
    println("o1.b = ")
    println(o1.b)

    let norm1 = oct_norm_sq(o1)
    println("norm_sq(o1) = ")
    println(norm1)

    let o1c = oct_conj(o1)
    println("o1c.a = ")
    println(o1c.a)
    println("o1c.b = ")
    println(o1c.b)

    let norm1c = oct_norm_sq(o1c)
    println("norm_sq(conj(o1)) = ")
    println(norm1c)

    if norm1 > norm1c - 0.1 && norm1 < norm1c + 0.1 {
        print("✓ Norms equal!")
    }
}
