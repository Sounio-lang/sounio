//@ run-pass
//@ expect-stdout: direct=4
//@ expect-stdout: copied=9
//@ expect-stdout: second=3
//@ expect-stdout: negative=-2
//@ expect-stdout: F64_PARAM_CAST_NUMERIC_TRUNCATION_PASS

fn direct_param_cast(x: f64) -> i64 {
    return x as i64
}

fn copied_param_cast(x: f64) -> i64 {
    let copied = x
    return copied as i64
}

fn second_position_param_cast(first: i64, x: f64) -> i64 {
    return x as i64
}

fn negative_param_cast(x: f64) -> i64 {
    return x as i64
}

fn main() -> i32 with IO {
    let direct_result = direct_param_cast(4.172)
    let copied_result = copied_param_cast(9.99)
    let second_result = second_position_param_cast(7, 3.5)
    let negative_result = negative_param_cast(0.0 - 2.9)

    print("direct=")
    print_int(direct_result)
    print("\n")

    print("copied=")
    print_int(copied_result)
    print("\n")

    print("second=")
    print_int(second_result)
    print("\n")

    print("negative=")
    print_int(negative_result)
    print("\n")

    if direct_result != 4 { return 11 }
    if copied_result != 9 { return 12 }
    if second_result != 3 { return 13 }
    if negative_result != 0 - 2 { return 14 }

    print("F64_PARAM_CAST_NUMERIC_TRUNCATION_PASS\n")
    return 0
}
