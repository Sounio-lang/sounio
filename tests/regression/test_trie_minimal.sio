//@ run-pass
extern "C" {
    fn malloc(size: usize) -> *mut u8;
}

pub struct Trie_i64 {
    root: *mut i32,
    len: usize,
}

pub fn trie_i64_new() -> Trie_i64 with Alloc {
    let root = malloc(8) as *mut i32
    let result = Trie_i64 {
        root: root,
        len: 0,
    }
    return result
}

fn main() with Alloc {
    let t = trie_i64_new()
    let n = null_mut()
    if t.root == n {
        return
    }
}
