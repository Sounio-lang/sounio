fn main() {
    let x = 25.0

    print("Test 1: && with both true")
    if x > 24.99 && x < 25.01 {
        print("PASS: && works with both true")
    }

    print("Test 2: && with left false")
    if x > 99.0 && x < 25.01 {
        print("FAIL: should not reach here")
    }
    print("PASS: && correctly short-circuits when left is false")

    print("Test 3: && with right false")
    if x > 24.99 && x > 99.0 {
        print("FAIL: should not reach here")
    }
    print("PASS: && correctly evaluates when right is false")

    print("All && tests passed!")
}
