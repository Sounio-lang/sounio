//@ run-pass
extern "C" {
    fn malloc(size: usize) -> *mut u8;
    fn memset(ptr: *mut u8, value: i32, count: usize);
}

pub struct TrieNode_i64 {
    children: *mut *mut TrieNode_i64,
    value: i64,
    has_value: bool,
}

fn trie_node_i64_new() -> *mut TrieNode_i64 with Alloc, Mut {
    let ptr = malloc(32) as *mut TrieNode_i64
    let children_ptr = malloc(26 * 8) as *mut *mut TrieNode_i64

    memset(children_ptr as *mut u8, 0, 26 * 8)

    (*ptr).children = children_ptr
    (*ptr).value = 0
    (*ptr).has_value = false

    return ptr
}

fn main() with Alloc, Mut {
    let n = trie_node_i64_new()
}
