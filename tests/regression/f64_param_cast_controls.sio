//@ run-pass
//@ expect-stdout: local=6
//@ expect-stdout: arithmetic=8
//@ expect-stdout: int=-11
//@ expect-stdout: F64_PARAM_CAST_CONTROLS_PASS

fn local_f64_cast() -> i64 {
    let local: f64 = 6.75
    return local as i64
}

fn arithmetic_f64_cast(x: f64) -> i64 {
    return (x + 0.0) as i64
}

fn int_identity_cast(x: i64) -> i64 {
    return x as i64
}

fn main() -> i32 with IO {
    let local_result = local_f64_cast()
    let arithmetic_result = arithmetic_f64_cast(8.25)
    let int_result = int_identity_cast(0 - 11)

    print("local=")
    print_int(local_result)
    print("\n")

    print("arithmetic=")
    print_int(arithmetic_result)
    print("\n")

    print("int=")
    print_int(int_result)
    print("\n")

    if local_result != 6 { return 21 }
    if arithmetic_result != 8 { return 22 }
    if int_result != 0 - 11 { return 23 }

    print("F64_PARAM_CAST_CONTROLS_PASS\n")
    return 0
}
