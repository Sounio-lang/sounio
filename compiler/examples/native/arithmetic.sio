// Simple arithmetic example for native backend testing

fn add(a: i32, b: i32) -> i32 {
    a + b
}

fn multiply(a: i32, b: i32) -> i32 {
    a * b
}

fn main() -> i32 {
    let x = 10
    let y = 5
    let sum = add(x, y)      // 15
    let prod = multiply(x, y) // 50
    sum + prod               // 65
}
