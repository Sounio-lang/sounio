// Example: ODE solver with native backend
// Demonstrates codegen for scientific operations

fn exponential_decay(t: f64, y: f64) -> f64 {
    // dy/dt = -k * y, where k = 0.1
    -0.1 * y
}

fn solve_ode() -> f64 {
    let mut y = 1.0  // Initial condition: y(0) = 1.0
    let t_final = 10.0
    let dt = 0.1
    let mut t = 0.0
    
    // Solve using Euler method (inline)
    while t < t_final {
        let dy = exponential_decay(t, y) * dt
        y = y + dy
        t = t + dt
    }
    
    y
}

fn main() -> f64 {
    solve_ode()
}
