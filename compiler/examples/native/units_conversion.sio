// Example: Unit conversion at runtime
// Demonstrates zero-cost abstractions for units

fn convert_mg_to_g(mass_mg: f64) -> f64 {
    // Unit conversion: mg to g
    // Scale factor: 1 mg = 0.001 g
    // This is optimized away at compile-time when possible
    mass_mg * 0.001
}

fn compute_concentration(dose: f64, volume: f64) -> f64 {
    // Units: dose (mg), volume (L), result (mg/L)
    // Unit checking ensures dimensional correctness
    dose / volume
}

fn main() -> f64 {
    let dose_mg = 500.0  // 500 mg
    let volume_l = 2.0   // 2 L
    
    // Compute concentration: 500 mg / 2 L = 250 mg/L
    compute_concentration(dose_mg, volume_l)
}
