// Example: Loop that can be vectorized with SIMD
// Demonstrates auto-vectorization pass

fn vector_add(a: &[f64], b: &[f64], result: &![f64], n: i32) {
    // This loop can be vectorized: independent iterations, stride-1 access
    for i in 0..n {
        result[i] = a[i] + b[i]
    }
}

fn dot_product(a: &[f64], b: &[f64], n: i32) -> f64 {
    // Dot product - can use SIMD for large arrays
    var sum = 0.0
    for i in 0..n {
        sum = sum + a[i] * b[i]
    }
    sum
}

fn main() -> f64 {
    // Example usage
    let n = 1000
