// Example: Epistemic arithmetic operations
// Demonstrates confidence propagation in add, sub, mul, div

fn add_measurements(a: Knowledge<f64>, b: Knowledge<f64>) -> Knowledge<f64> {
    // Addition: confidence = min(a.conf, b.conf)
    a + b
}

fn multiply_measurements(a: Knowledge<f64>, b: Knowledge<f64>) -> Knowledge<f64> {
    // Multiplication: confidence = a.conf * b.conf
    a * b
}

fn divide_measurements(a: Knowledge<f64>, b: Knowledge<f64>) -> Knowledge<f64> {
    // Division: confidence = a.conf * b.conf
    a / b
}

fn main() -> Knowledge<f64> {
    let x = measure(10.0, uncertainty: 0.5)  // confidence ~0.95
    let y = measure(2.0, uncertainty: 0.1)     // confidence ~0.99
    
    // Test all operations
    let sum = add_measurements(x, y)           // conf = min(0.95, 0.99) = 0.95
    let prod = multiply_measurements(x, y)     // conf = 0.95 * 0.99 = 0.9405
    let quot = divide_measurements(x, y)      // conf = 0.95 * 0.99 = 0.9405
    
    // Return product
    prod
}
