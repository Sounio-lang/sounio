// Sprint 40 probe: variance-reduction N_crit sensitivity
// Scenarios: baseline, ka/2, F/2, ke/2, peripheral/2, ka=0, all/2
// Five strata: std, slow, fast, inh, ind

module main

use pbpk::rapamycin_assay::{as_trough_mg_l}
use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

fn find_ncrit(d: f64, ke: f64, f: f64,
              ka_v: f64, f_v: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> i64
    with Mut, Div, Panic {
    let floor = trough_floor_mg_l(); let ceil = trough_ceil_mg_l()
    var n = 1; var found = 0
    while n <= 60 && found == 0 {
        let c  = as_trough_mg_l(d, n, ke, f)
        let uc = eu_u_c(d, n, ke, f, ka_v, f_v, ke_v, k12_v, k21_v)
        let zf = (c - floor) / uc
        let zc = (ceil - c)  / uc
        if zf >= 2.0 && zc >= 2.0 { found = n }
        else { n = n + 1 }
    }
    found
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    let ka  = ob_ka_var_std()
    let fv  = ob_f_var_std()
    let ke  = ob_ke_var_std()
    let k12 = ob_k12_var_std()
    let k21 = ob_k21_var_std()
    let ke_inh = ob_ke_var_inh()
    let ke_ind = ob_ke_var_ind()

    // Scenario short names: base / ka2 / F2 / ke2 / per2 / ka0 / all2
    print("Variance components (ka,F,ke,k12,k21):\n")
    print("ka="); print_f64(ka)
    print(" F="); print_f64(fv)
    print(" ke="); print_f64(ke)
    print(" k12="); print_f64(k12)
    print(" k21="); print_f64(k21)
    print("\n\n")

    // === std stratum D=5 ke=0.01118 F=0.141 ===
    print("std D=5mg:\n")
    print("  base="); pi(find_ncrit(5.0,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" ka/2="); pi(find_ncrit(5.0,0.01118,0.141,ka/2.0,fv,ke,k12,k21))
    print(" F/2=");  pi(find_ncrit(5.0,0.01118,0.141,ka,fv/2.0,ke,k12,k21))
    print(" ke/2="); pi(find_ncrit(5.0,0.01118,0.141,ka,fv,ke/2.0,k12,k21))
    print(" per/2=");pi(find_ncrit(5.0,0.01118,0.141,ka,fv,ke,k12/2.0,k21/2.0))
    print(" ka=0="); pi(find_ncrit(5.0,0.01118,0.141,0.0,fv,ke,k12,k21))
    print(" all/2=");pi(find_ncrit(5.0,0.01118,0.141,ka/2.0,fv/2.0,ke/2.0,k12/2.0,k21/2.0))
    print("\n")

    // === slow stratum D=5 ke=0.00838 F=0.188 ===
    print("slow D=5mg:\n")
    print("  base="); pi(find_ncrit(5.0,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" ka/2="); pi(find_ncrit(5.0,0.00838,0.188,ka/2.0,fv,ke,k12,k21))
    print(" F/2=");  pi(find_ncrit(5.0,0.00838,0.188,ka,fv/2.0,ke,k12,k21))
    print(" ke/2="); pi(find_ncrit(5.0,0.00838,0.188,ka,fv,ke/2.0,k12,k21))
    print(" per/2=");pi(find_ncrit(5.0,0.00838,0.188,ka,fv,ke,k12/2.0,k21/2.0))
    print(" ka=0="); pi(find_ncrit(5.0,0.00838,0.188,0.0,fv,ke,k12,k21))
    print(" all/2=");pi(find_ncrit(5.0,0.00838,0.188,ka/2.0,fv/2.0,ke/2.0,k12/2.0,k21/2.0))
    print("\n")

    // === fast stratum D=5 ke=0.01677 F=0.094 ===
    print("fast D=5mg:\n")
    print("  base="); pi(find_ncrit(5.0,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" ka/2="); pi(find_ncrit(5.0,0.01677,0.094,ka/2.0,fv,ke,k12,k21))
    print(" F/2=");  pi(find_ncrit(5.0,0.01677,0.094,ka,fv/2.0,ke,k12,k21))
    print(" ke/2="); pi(find_ncrit(5.0,0.01677,0.094,ka,fv,ke/2.0,k12,k21))
    print(" per/2=");pi(find_ncrit(5.0,0.01677,0.094,ka,fv,ke,k12/2.0,k21/2.0))
    print(" ka=0="); pi(find_ncrit(5.0,0.01677,0.094,0.0,fv,ke,k12,k21))
    print(" all/2=");pi(find_ncrit(5.0,0.01677,0.094,ka/2.0,fv/2.0,ke/2.0,k12/2.0,k21/2.0))
    print("\n")

    // === inh stratum D=1.5 ke=0.002236 F=0.282 ===
    print("inh D=1.5mg:\n")
    print("  base="); pi(find_ncrit(1.5,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" ka/2="); pi(find_ncrit(1.5,0.002236,0.282,ka/2.0,fv,ke_inh,k12,k21))
    print(" F/2=");  pi(find_ncrit(1.5,0.002236,0.282,ka,fv/2.0,ke_inh,k12,k21))
    print(" ke/2="); pi(find_ncrit(1.5,0.002236,0.282,ka,fv,ke_inh/2.0,k12,k21))
    print(" per/2=");pi(find_ncrit(1.5,0.002236,0.282,ka,fv,ke_inh,k12/2.0,k21/2.0))
    print(" ka=0="); pi(find_ncrit(1.5,0.002236,0.282,0.0,fv,ke_inh,k12,k21))
    print(" all/2=");pi(find_ncrit(1.5,0.002236,0.282,ka/2.0,fv/2.0,ke_inh/2.0,k12/2.0,k21/2.0))
    print("\n")

    // === ind stratum D=34 ke=0.05590 F=0.047 ===
    print("ind D=34mg:\n")
    print("  base="); pi(find_ncrit(34.0,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" ka/2="); pi(find_ncrit(34.0,0.05590,0.047,ka/2.0,fv,ke_ind,k12,k21))
    print(" F/2=");  pi(find_ncrit(34.0,0.05590,0.047,ka,fv/2.0,ke_ind,k12,k21))
    print(" ke/2="); pi(find_ncrit(34.0,0.05590,0.047,ka,fv,ke_ind/2.0,k12,k21))
    print(" per/2=");pi(find_ncrit(34.0,0.05590,0.047,ka,fv,ke_ind,k12/2.0,k21/2.0))
    print(" ka=0="); pi(find_ncrit(34.0,0.05590,0.047,0.0,fv,ke_ind,k12,k21))
    print(" all/2=");pi(find_ncrit(34.0,0.05590,0.047,ka/2.0,fv/2.0,ke_ind/2.0,k12/2.0,k21/2.0))
    print("\n")

    // Bonus: u_c at baseline for each stratum at their critical N
    print("\nu_c at baseline N_crit:\n")
    print("std N=6:  uc="); print_f64(eu_u_c(5.0,6,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" c="); print_f64(as_trough_mg_l(5.0,6,0.01118,0.141)); print("\n")
    print("fast N=15: uc="); print_f64(eu_u_c(5.0,15,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" c="); print_f64(as_trough_mg_l(5.0,15,0.01677,0.094)); print("\n")
    print("inh N=7:  uc="); print_f64(eu_u_c(1.5,7,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" c="); print_f64(as_trough_mg_l(1.5,7,0.002236,0.282)); print("\n")
    print("ind N=26: uc="); print_f64(eu_u_c(34.0,26,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" c="); print_f64(as_trough_mg_l(34.0,26,0.05590,0.047)); print("\n")
}
