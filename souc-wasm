#!/usr/bin/env bash
# souc-wasm — Compile a Sounio source file to WASM using the self-hosted driver
#
# Usage: souc-wasm [input.sio] <output.wasm>
#   With input:   souc-wasm hello.sio hello.wasm  (future: full pipeline)
#   Standalone:   souc-wasm out.wasm              (emit built-in demo program)
#
# Currently emits the built-in demo (add, fib, main) to <output.wasm>.
# Full source→WASM pipeline requires importing wasm/lower.sio (coming soon).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOUC="${SCRIPT_DIR}/target/debug/souc"
DRIVER="${SCRIPT_DIR}/self-hosted/wasm/driver.sio"

if [[ $# -lt 1 ]]; then
    echo "Usage: souc-wasm <output.wasm>" >&2
    echo "       souc-wasm <input.sio> <output.wasm>  (pipeline mode, coming soon)" >&2
    exit 1
fi

OUTPUT="${@: -1}"  # last arg is always output

if [[ $# -eq 1 ]]; then
    # Standalone demo mode
    exec "${SOUC}" run "${DRIVER}" "${OUTPUT}"
else
    # Pipeline mode (reserved for when import timeout is resolved)
    echo "souc-wasm: pipeline mode not yet available (import timeout)" >&2
    echo "souc-wasm: use standalone mode: souc-wasm <output.wasm>" >&2
    exit 1
fi
