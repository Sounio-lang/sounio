private def xsNext (x : UInt64) : UInt64 :=
  let x := x ^^^ (x <<< 13)
  let x := x ^^^ (x >>> 7)
  x ^^^ (x <<< 17)

private def isSafeBranchTarget (t len : Nat) : Bool :=
  CODE_PAGE ≤ t && t < CODE_PAGE + 4096 && (t < INS_ADDR || INS_ADDR + len ≤ t)

private def isParityCc (cc : Nat) : Bool := cc == 10 || cc == 11

private def writeLe64 (mem : List Nat) (off v : Nat) : List Nat :=
  let bs := X86Int.bytes8 v
  (List.range 8).foldl (fun m i => m.set (off + i) (bs[i]!)) mem

/-- Build a hardware-safe pre-state for a decoded Hamming-1 neighbour `ins` of
length `len`, or `none` if the neighbour is a host `syscall`, parity `cc`,
same-register indexed memory op, or out-of-sandbox branch target. -/
private def mkSweepPreState (seed : UInt64) (ins : Ins) (len : Nat) :
    Option (List Nat × String × List Nat) :=
  Id.run do
    let mut s := if seed == 0 then 0x9e3779b97f4a7c15 else seed
    let mut regs : Array Nat := Array.replicate 16 0
    for r in [:16] do
      s := xsNext s
      regs := regs.set! r s.toNat
    regs := regs.set! 4 (WIN_LO + 32) -- safe rsp with 32B room above & below
    s := xsNext s
    let flBits := s.toNat
    let flStr := String.ofList
      [ if flBits % 2 == 1 then '1' else '0'
      , if (flBits / 2) % 2 == 1 then '1' else '0'
      , if (flBits / 4) % 2 == 1 then '1' else '0'
      , if (flBits / 8) % 2 == 1 then '1' else '0'
      ]
    let mut mem : List Nat := []
    for _ in [:WIN_SIZE] do
      s := xsNext s
      mem := mem ++ [(s.toNat % 256)]
    match ins with
    | .ofInt .syscall => return none
    | .ofInt (.jcc cc t) =>
      if isParityCc cc || !isSafeBranchTarget t len then return none
      return some (regs.toList, flStr, mem)
    | .ofInt (.jmp t) | .ofInt (.call t) =>
      if !isSafeBranchTarget t len then return none
      return some (regs.toList, flStr, mem)
    | .ofInt (.jmpR r) =>
      regs := regs.set! (r % 16) SAFE_TGT
      return some (regs.toList, flStr, mem)
    | .ofInt .ret =>
      mem := writeLe64 mem 32 SAFE_TGT
      return some (regs.toList, flStr, mem)
    | .ofInt (.jtab b i disp) =>
      if b % 16 == i % 16 then return none
      regs := regs.set! (i % 16) 1
      regs := regs.set! (b % 16) ((WIN_LO + 16 + W64 - (8 + disp) % W64) % W64)
      mem := writeLe64 mem 16 SAFE_TGT
      return some (regs.toList, flStr, mem)
    | .ofInt (.ld _ b disp) | .ofInt (.st b disp _) | .ofInt (.ld32 _ b disp)
    | .ofInt (.ld8 _ b disp) | .ofInt (.st8 b disp _)
    | .ld16 _ b disp | .st16 b disp _ | .st32 b disp _ =>
      regs := regs.set! (b % 16) ((WIN_LO + 16 + W64 - disp % W64) % W64)
      return some (regs.toList, flStr, mem)
    | .ldIdx _ _ b i sc disp | .stIdx _ b i sc disp _ =>
      if b % 16 == i % 16 then return none
      regs := regs.set! (i % 16) 1
      regs := regs.set! (b % 16) ((WIN_LO + 16 + W64 - (sc + disp) % W64) % W64)
      return some (regs.toList, flStr, mem)
    | .setcc cc _ | .cmovcc cc _ _ =>
      if isParityCc cc then return none
      return some (regs.toList, flStr, mem)
    | _ =>
      return some (regs.toList, flStr, mem)

def emitHamming1Sweep (outPath : System.FilePath) : IO UInt32 := do
  let mut totalFlips : Nat := 0
  let mut decodedAlts : Nat := 0
  let mut rejectedAlts : Nat := 0
  let mut emitted : Nat := 0
  let mut skipped : Nat := 0
  let mut outLines : Array String := #[]
  let mut idx : Nat := 0
  for baseBytes in sweepCorpus do
    idx := idx + 1
    let padded := baseBytes ++ List.replicate 12 0
    let bFn : Nat → Option Nat := fun i => padded[i]?
    let alts := X86Vm.altsAt bFn INS_ADDR baseBytes.length
    let mut bitK : Nat := 0
    for alt in alts do
      totalFlips := totalFlips + 1
      match alt with
      | none => rejectedAlts := rejectedAlts + 1
      | some (ins', len') =>
        decodedAlts := decodedAlts + 1
        let byteIdx := bitK / 8
        let mask := 2 ^ (bitK % 8)
        let flipped := padded.modify byteIdx (fun v => Nat.xor v mask)
        let pertBytes := flipped.take len'
        -- Ensure exact self-consistent re-decode on the trimmed `len'` slice.
        match X86Vm.decode (fun i => pertBytes[i]?) INS_ADDR with
        | some (ins2, len2) =>
          if ins2 == ins' && len2 == len' then
            let seed : UInt64 := UInt64.ofNat (idx * 65537 + bitK * 257 + 0x58383656)
            match mkSweepPreState seed ins' len' with
            | none => skipped := skipped + 1
            | some (regs, flStr, mem) =>
              let regStr := String.intercalate " " (regs.map hex16)
              let line := s!"hamming1 {bytesHex pertBytes} {regStr} {flStr} {bytesHex mem}"
              outLines := outLines.push line
              emitted := emitted + 1
          else
            skipped := skipped + 1
        | none => skipped := skipped + 1
      bitK := bitK + 1
  IO.FS.writeFile outPath (String.intercalate "\n" outLines.toList ++ "\n")
  IO.println s!"X86VmDiffModel sweep: corpus={sweepCorpus.length} total_flips={totalFlips} decoded_alts={decodedAlts} rejected_alts={rejectedAlts} emitted={emitted} skipped={skipped}"
  return 0

end X86VmDiffModel

def main (args : List String) : IO UInt32 := do
  match args with
  | ["--emit-sweep", outPath] => X86VmDiffModel.emitHamming1Sweep outPath
  | [path] => X86VmDiffModel.runDiffFile path 60000 1000
  | [path, minTot] =>
    match minTot.toNat? with
    | some n => X86VmDiffModel.runDiffFile path n (if n ≥ 40000 then 1000 else 0)
    | none => IO.eprintln "usage: X86VmDiffModel [--emit-sweep <out.txt> | <cases.txt> [min_total] [min_vm]]"; pure 2
  | [path, minTot, minVm] =>
    match minTot.toNat?, minVm.toNat? with
    | some n, some m => X86VmDiffModel.runDiffFile path n m
    | _, _ => IO.eprintln "usage: X86VmDiffModel [--emit-sweep <out.txt> | <cases.txt> [min_total] [min_vm]]"; pure 2
  | _ =>
    IO.eprintln "usage: X86VmDiffModel [--emit-sweep <out.txt> | <cases.txt> [min_total] [min_vm]]"
    pure 2
