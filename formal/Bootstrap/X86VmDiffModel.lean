import Bootstrap.X86Vm

/-!
Differential model runner and Hamming-1 single-site disturbance sweep generator
for `X86Vm` against real x86-64 hardware traces generated by
`bootstrap/model/x86vm_diff_cpu.cpp`.

Modes:
  1. Verification (default):
       X86VmDiffModel <cases.txt> [min_total=60000] [min_vm=1000]
     Each line has one of two forms:
       - Normal retirement (40 tokens):
           <tag> <instrHex> <r0> ... <r15> <cszo> <mem128hex> | <afterRip> <r0'> ... <r15'> <cszo'> <mem128hex'>
       - Hardware `#DE` trap (`SIGFPE`, 22 tokens):
           <tag> <instrHex> <r0> ... <r15> <cszo> <mem128hex> | TRAP_DE
     Decodes `<instrHex>` via `X86Vm.decode` at `INS_ADDR = 0x20180`, executes
     `X86Vm.exec`, asserts 0 disagreements across RIP, all 16 GPRs, all defined
     flags, and all 64 memory bytes (or `.stuck` on `TRAP_DE`), and enforces
     coverage across all 31 new `X86Vm` forms and all 33 `X86Dec`/`X86Int` forms.

  2. Hamming-1 single-site disturbance sweep generation:
       X86VmDiffModel --emit-sweep <sweep_in.txt>
     Enumerates every Hamming-distance-1 single-bit flip (`X86Vm.altsAt`) across
     a 64-instruction corpus spanning every `X86Vm` and `X86Dec` encoding family,
     writes safe executable pre-states for every decoded neighbour to
     `<sweep_in.txt>` for real-CPU execution via `x86vm_diff_cpu --exec`, and
     prints exact flip/decode/reject counts.
-/

namespace X86VmDiffModel

open X86Env X86Vm

def WIN_LO : Nat := 0x117e0
def WIN_SIZE : Nat := 64
def INS_ADDR : Nat := 0x20180
def CODE_PAGE : Nat := 0x20000
def SAFE_TGT : Nat := 0x20240
def W64 : Nat := 2 ^ 64

private def hexVal? (c : Char) : Option Nat :=
  if '0' ≤ c && c ≤ '9' then some (c.toNat - '0'.toNat)
  else if 'a' ≤ c && c ≤ 'f' then some (c.toNat - 'a'.toNat + 10)
  else if 'A' ≤ c && c ≤ 'F' then some (c.toNat - 'A'.toNat + 10)
  else none

private def parseHexNat? (s : String) : Option Nat :=
  if s.isEmpty then none
  else
    s.toList.foldlM (fun acc c => do
      let d ← hexVal? c
      pure (acc * 16 + d)) 0

private def parseHexBytes? (s : String) : Option (List Nat) :=
  let cs := s.toList
  if cs.length % 2 ≠ 0 || cs.isEmpty then none
  else
    let rec go : List Char → Option (List Nat)
      | [] => some []
      | a :: b :: rest => do
        let hi ← hexVal? a
        let lo ← hexVal? b
        let tl ← go rest
        pure ((hi * 16 + lo) :: tl)
      | _ => none
    go cs

private def parseFlags? (s : String) : Option Flags :=
  match s.toList with
  | [c, z, sf, o] =>
    let bit? : Char → Option Bool
      | '0' => some false
      | '1' => some true
      | _ => none
    do
      let cf ← bit? c
      let zf ← bit? z
      let sfb ← bit? sf
      let ofb ← bit? o
      pure ⟨some cf, some zf, some sfb, some ofb⟩
  | _ => none

private def flagMatch (m : Option Bool) (cpu : Bool) : Bool :=
  match m with
  | none => true
  | some b => b == cpu

private def flagsAgree (m cpu : Flags) : Bool :=
  match cpu.cf, cpu.zf, cpu.sf, cpu.of with
  | some c, some z, some s, some o =>
    flagMatch m.cf c && flagMatch m.zf z && flagMatch m.sf s && flagMatch m.of o
  | _, _, _, _ => false

private def extractMemWindow (mem : Mem) : Option (List Nat) :=
  (List.range WIN_SIZE).mapM fun off => mem.rd (WIN_LO + off)

private def extractRegs (s : St) : Option (List Nat) :=
  (List.range 16).mapM fun r => s.reg r

private def hexDigit (d : Nat) : Char :=
  if d < 10 then Char.ofNat ('0'.toNat + d) else Char.ofNat ('a'.toNat + d - 10)

private def hex2 (b : Nat) : String :=
  String.ofList [hexDigit ((b / 16) % 16), hexDigit (b % 16)]

private def hex16 (n : Nat) : String :=
  let digits := (List.range 16).reverse.map fun i => hexDigit ((n / 16 ^ i) % 16)
  String.ofList digits

private def bytesHex (bs : List Nat) : String :=
  String.join (bs.map hex2)

private def memWSuffix : MemW → String
  | .w8 => "w8"
  | .w16 => "w16"
  | .w32 => "w32"
  | .w64 => "w64"

private def classifyForm (bytes : List Nat) (ins : Ins) (isTrap : Bool) : String :=
  match ins with
  | .mul _ => "vm_mul"
  | .imul _ _ => "vm_imul"
  | .div _ => if isTrap then "vm_div_trap" else "vm_div"
  | .idiv _ => if isTrap then "vm_idiv_trap" else "vm_idiv"
  | .cqo => "vm_cqo"
  | .neg _ => "vm_neg"
  | .not _ => "vm_not"
  | .shlR _ => "vm_shlR"
  | .shrR _ => "vm_shrR"
  | .sarR _ => "vm_sarR"
  | .sarI _ _ => "vm_sarI"
  | .ld16 _ _ _ => "vm_ld16"
  | .st16 _ _ _ => "vm_st16"
  | .st32 _ _ _ => "vm_st32"
  | .ldIdx w _ _ _ _ _ => s!"vm_ldIdx_{memWSuffix w}"
  | .stIdx w _ _ _ _ _ => s!"vm_stIdx_{memWSuffix w}"
  | .leaIdx _ _ _ _ _ => "vm_leaIdx"
  | .testI _ _ => "vm_testI"
  | .cmpAlI _ => "vm_cmpAlI"
  | .testAlI _ => "vm_testAlI"
  | .setcc _ _ => "vm_setcc"
  | .cmovcc _ _ _ => "vm_cmovcc"
  | .ofInt (.jmpR _) => "vm_jmpR"
  | .ofInt i =>
      let s := String.ofList ((reprStr i).toList.drop 11) -- strip "X86Int.Ins."
      let parts := s.splitOn " "
      match parts with
      | [] => "int_unknown"
      | ctor :: rest =>
        if ctor == "alu" || ctor == "aluI" then
          let op := (rest.headD "").replace "(" "" |>.replace ")" ""
          let opShort := (op.splitOn ".").getLastD op
          s!"int_{ctor}_{opShort}"
        else if ctor == "movI" then
          if bytes.length <= 6 then "int_movI32" else "int_movI64"
        else
          s!"int_{ctor}"

