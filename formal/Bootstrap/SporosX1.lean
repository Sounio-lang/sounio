    · intro q h0 h1 h2 h4 h6 h8 h9 h12
      rw [hg17]; show ({ g16 with rip := walk }).reg q = s.reg q
      rw [reg_with_rip]; exact gg16 q h0 h1 h2 h4 h6 h8 h9 h12
    · intro x m hx
      have hm17 : g17.mem = m5 := by
