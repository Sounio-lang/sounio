/-- The fall-through tail's spec: entered at instruction `i` with
the height `h'` its fall-through instruction produced (in
`r8`/`r9`, here written `h`) and the cursor already past it. The
next instruction exists, and an ann there, if any, announces
exactly `h`; the tail reaches the walk top with the index at
`i+1` and the height unchanged. -/
def FallSpec (im : Nat → Option (Ins × Nat)) (entry walk l32 annl : Nat) : Prop :=
  ∀ (wd : Word) (h : Height) (c i w p sp : Nat),
    i + 1 < wd.code.length → wd.code.length < W →
    (wd.ann.lookup (i + 1) = none ∨ wd.ann.lookup (i + 1) = some h) →
    0 < p → w + 56 ≤ W → p + 12 * wd.ann.length < W → h.d < W → h.a < W →
    32 ≤ sp → sp < W →
    (sp ≤ w ∨ w + 56 ≤ sp - 32) → (sp ≤ p ∨ p + 12 * wd.ann.length ≤ sp - 32) →
    ∀ s, s.rip = entry → s.reg 8 = some h.d → s.reg 9 = some h.a → s.reg 6 = some c →
      s.reg 4 = some sp → s.reg 7 = some w → s.reg 1 = some i → 16 ≤ s.regs.length →
      rd64 s.mem (w + 48) = some p → rd64 s.mem (w + 32) = some wd.ann.length →
      rd64 s.mem (w + 24) = some wd.code.length →
      AnnLayout s wd.ann p → StackRoom s 4 →
      ∃ k s', run im k (Out.ok s) = Out.ok s' ∧ s'.rip = walk ∧
        s'.reg 1 = some (i + 1) ∧ s'.reg 8 = some h.d ∧ s'.reg 9 = some h.a ∧
        s'.reg 6 = some c ∧ s'.reg 4 = some sp ∧
        (∀ q, q ≠ 0 → q ≠ 1 → q ≠ 2 → q ≠ 4 → q ≠ 6 → q ≠ 8 → q ≠ 9 → q ≠ 12 →
          s'.reg q = s.reg q) ∧
        (∀ x m, x + m ≤ sp - 32 ∨ sp ≤ x → s'.mem.rdN x m = s.mem.rdN x m) ∧
        wshape s'.mem = wshape s.mem

/-- Decode facts for `fall_tail`, with the two `ret`s of `ANNL`. -/
structure FallCode (im : Nat → Option (Ins × Nat)) (entry walk l32 annl : Nat) : Prop where
  d0 : im entry = some (.aluI .add 1 1, 4)
  d1 : im (entry + 4) = some (.ld 0 7 24, 4)
  d2 : im (entry + 8) = some (.cmp 1 0, 3)
  d3 : im (entry + 11) = some (.jcc 2 (entry + 18), 2)
  d4 : im (entry + 18) = some (.mov 12 1, 3)
  d5 : im (entry + 21) = some (.call annl, 5)
  d6 : im (entry + 26) = some (.test 0 0, 3)
  d7 : im (entry + 29) = some (.jcc 5 (entry + 36), 2)
  d8 : im (entry + 31) = some (.jmp walk, 5)
  d9 : im (entry + 36) = some (.push 0, 1)
  d10 : im (entry + 37) = some (.mov 2 0, 3)
  d11 : im (entry + 40) = some (.aluI .add 2 4, 4)
  d12 : im (entry + 44) = some (.call l32, 5)
  d13 : im (entry + 49) = some (.cmp 0 8, 3)
  d14 : im (entry + 52) = some (.jcc 4 (entry + 59), 2)
  d15 : im (entry + 59) = some (.pop 2, 1)
  d16 : im (entry + 60) = some (.aluI .add 2 8, 4)
  d17 : im (entry + 64) = some (.call l32, 5)
  d18 : im (entry + 69) = some (.cmp 0 9, 3)
  d19 : im (entry + 72) = some (.jcc 4 (entry + 79), 2)
  d20 : im (entry + 79) = some (.jmp walk, 5)
  dret : im (l32 + 2) = some (.ret, 1)
  dretA1 : im (annl + 45) = some (.ret, 1)
  dretA2 : im (annl + 50) = some (.ret, 1)

