    · rw [hg17]; show ({ g16 with rip := walk }).reg 9 = some h.a
      rw [reg_with_rip]; exact hg16r9
    · rw [hg17]; show ({ g16 with rip := walk }).reg 6 = some c
      rw [reg_with_rip]; exact hg16r6
    · rw [hg17]; show ({ g16 with rip := walk }).reg 4 = some sp
