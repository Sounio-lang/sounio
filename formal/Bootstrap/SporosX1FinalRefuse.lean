        (X86Env.initStack top [argv0, path]).2 + 24 + 48 - 16 ∨
      (X86Env.initStack top [argv0, path]).2 + 24 + 48 ≤
        S +
          (A + 16 + dataBytes pr.data - A) := by
    have h := hdisjS c2 (by simp)
    have hpgf := pages_ge f.length
