              omega)
          · exact Or.inl (by omega)
        have hdisjEffX : aEff + 114 ≤
              (X86Env.initStack top [argv0, path]).2 + 24 + 48 -
                48 ∨
            (X86Env.initStack top [argv0, path]).2 + 24 + 48 ≤
              aEff :=
          Or.inl (by
            have hcl := stage1Code_length
            unfold aEff
