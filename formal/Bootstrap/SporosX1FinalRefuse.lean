  have gf3 : ∀ q, q ≠ 0 → q ≠ 1 → q ≠ 2 → q ≠ 4 → q ≠ 6 → q ≠ 8 → q ≠ 9 → q ≠ 12 → f3.reg q = s.reg q := by
