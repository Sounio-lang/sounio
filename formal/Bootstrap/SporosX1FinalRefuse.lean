  have ht4len : t4.regs.length = 16 := by
    rw [ht4]
    show ({ t3.set 2 (some (3 % W)) with rip := t3.rip + 5 }).regs.length =
      16
    rw [len_with_rip, len_set]; exact ht3len
  have ht4k : t4.k = s.k := by
    rw [ht4]
    show ({ t3.set 2 (some (3 % W)) with rip := t3.rip + 5 }).k = s.k
