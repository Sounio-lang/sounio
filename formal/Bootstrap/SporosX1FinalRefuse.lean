  obtain ⟨hfenc, hbmn, hbnw, hbnd, hwB, hdB⟩ := decode_inv hdec hfB
  obtain ⟨hmn, hins0⟩ := checkProg_main hchk
  have hnw0 : pr.words.length ≠ 0 := by omega
