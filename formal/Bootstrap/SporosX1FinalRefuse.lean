      rw [hs2sh, hs1mem]
    have hs2lay' : WordsLay s2.mem
        (c + 20 + codeBytes wd.code + 12 * wd.ann.length) wds := by
      apply WordsLay_of_frame wds hrest
      intro y k hy hk
      rw [hs2memfr y k (by omega) (by omega) (by omega), hs1mem]
    have hs2wrE : ∀ (off v : Nat), off + 8 ≤ 64 * wds.length →
