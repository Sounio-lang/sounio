      have ht2leg : OracleLegalAt t2 := hadm _ _ hrunt2tot
      have ht2memsys : AtMemSyscall t2 :=
        ⟨by rw [ht2rip]; exact hc.p249, Or.inl ht2r0⟩
      rcases head_cases_of_legal_mmap ht2leg ht2memsys ht2r0
