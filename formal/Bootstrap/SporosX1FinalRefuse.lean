  have ht3r6 : t3.reg 6 = some c := by
    rw [ht3]
    show ({ t2.set 0 (some na) with rip := t2.rip + 4 }).reg 6 = some c
    rw [reg_with_rip, reg_set_other (by decide), ht2fr 6]
