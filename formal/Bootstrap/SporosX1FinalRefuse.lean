          hmemc1 with
        h | h
      · exact Or.inr h
      · exact Or.inl h
    have hmemstk1 : stk1 ∈ s1.mem := by
      rw [hs1memC]
      exact List.mem_cons_of_mem _ List.mem_cons_self
    have hdisjA2 : stk1.hi ≤ A ∨ A + 65536 ≤ stk1.base := by
      rcases free_spec hpf.2.2.2 stk1 hmemstk1 with
