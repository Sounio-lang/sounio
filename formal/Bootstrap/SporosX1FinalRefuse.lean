      reg_set_self (hlen 4 (by decide)), Nat.mod_eq_of_lt hspW]
  have ht1fr : ∀ i, i ≠ 0 → i ≠ 1 → i ≠ 2 → i ≠ 4 → i ≠ 6 → i ≠ 7 →
      t1.reg i = s.reg i := by
    intro i _ hi1 _ hi4 _ _
    rw [ht1]
    show ({ (s.set 4 (some ((sp1 + 8) % W))).set 1 (some (r + 1)) with
