      (hs8r 14 _ (by decide) hs7r14))
  have hs10r4 : s10.reg 4 =
      some ((X86Env.initStack top [argv0, path]).2 + 24 + 48) :=
    hs10r 4 _ hs9r4
  have hslot : rd64 s10.mem
