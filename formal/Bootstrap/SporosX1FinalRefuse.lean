    refine ⟨2 + k1 + k2, (by
      rw [List.map_cons, List.sum_cons]; omega), s3, hrun, hs3rip,
      hs3r1, ?_, ?_, hs3r4, htab,
      ?_, hs3len, ?_, ?_, hs3room, ?_, hNH⟩
    · show s3.reg 6 = some (c + wordsBytes (wd :: wds))
