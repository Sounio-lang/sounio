  obtain ⟨a5, ha5⟩ : ∃ u : X86Int.St, u = { a4.set 4 (some ((sp - 8 + 8) % W)) with
    rip := entry + 12 } := ⟨_, rfl⟩
  have ha5rip : a5.rip = entry + 12 := by rw [ha5]
  have ha5r4 : a5.reg 4 = some sp := by
    rw [ha5]
    show ({ a4.set 4 (some ((sp - 8 + 8) % W)) with rip := entry + 12 }).reg 4 = some sp
