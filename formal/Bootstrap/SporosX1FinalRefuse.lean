      s.k.oracle.head? = some .nomem := by
  cases hor : s.k.oracle with
  | nil =>
    exfalso
    obtain ⟨rax, k', m', hsc⟩ :=
      legal_mremap_ret hleg hmem hr0 hr7 hr6 hr2 hr10 hr8 hr9
    have hp : X86Env.place (s.mem.eraseIdx i) (Kern.next s.k).1
