/-- Transport of a data-segment layout along pointwise `rd32`
agreement. -/
theorem DataSeq_of_rd32 {m m' : Mem} : ∀ {c : Nat}
    {ds : List Nat} {c' : Nat}, DataSeq m c ds c' →
    (∀ a d, rd32 m a = some d → c ≤ a → a + 4 ≤ c' →
      rd32 m' a = some d) → DataSeq m' c ds c' := by
  intro c ds c' h
  induction h with
  | nil c =>
    intro _
    exact DataSeq.nil c
  | cons hd hrest ih =>
    intro hfr
    rename_i c d ds c'
    have hle : c + 4 + d ≤ c' := hrest.le
    exact DataSeq.cons (hfr c d hd (by omega) (by omega))
      (ih (fun a d' hd' ha hac =>
        hfr a d' hd' (by omega) hac))

