    -- test rax, rax ; jz walk_top
    have hb6r0' : b6.reg 0 = some 0 := by rw [hb6r0, he0]
    have e7 : X86Int.step im b6 =
        .ok { b6 with fl := (aluF .and 0 0).2, rip := b6.rip + 3 } :=
