theorem chkAnn_addr_bnd : ∀ e ∈ chkAnn, e.1 + e.2.2.1 ≤ base + 2447 := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem annlAnn_addr_bnd : ∀ e ∈ annlAnn, e.1 + e.2.2.1 ≤ base + 2447 := by
