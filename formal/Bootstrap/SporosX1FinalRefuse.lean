  have hb5rip : b5.rip = aCodewalk + 15 := by
    rw [hb5]; show b4.rip + 3 = aCodewalk + 15; rw [hb4rip]
  have gb5 : ∀ q, q ≠ 12 → b5.reg q = b4.reg q := by
    intro q hq
    rw [hb5]
    show (b4.set 12 (some (aluF .xor v12 v12).1)).reg q = b4.reg q
