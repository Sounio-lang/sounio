  have hs2sh' : wshape s2.mem = wshape s.mem := by rw [hs2sh, hs1sh]
  have hrunP2 : run stage1Im (nf + 2) (Out.ok s) = Out.ok s2 := by
    rw [run_add stage1Im nf 2, hrunf, hrun2]
  have hnhP2 : NoHitUpTo s (nf + 2) :=
