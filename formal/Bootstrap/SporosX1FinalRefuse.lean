        some stage1Code := by
      rw [hs6mem]; exact rdN_append_left hm1c
    have hs8c : s8.mem.rdN base stage1Code.length =
        some stage1Code := by
      rw [hs8mem, hs7mem]; exact hs6c
    have hs9c : s9.mem.rdN base stage1Code.length =
        some stage1Code := by
      rw [hs9memfr base _ (Or.inl (by omega)) ?_ ?_]; exact hs8c
