        have hfreeS : ∀ r ∈ ([⟨base, stage1Code, false⟩, c2,
              buf'] ++
              [⟨T, List.replicate (X86Env.pages (64 * pr.words.length)) 0,
                true⟩] : Mem),
            S + X86Env.pages f.length ≤ r.base ∨ r.hi ≤ S := by
          have hf : Mem.free ([⟨base, stage1Code, false⟩, c2,
