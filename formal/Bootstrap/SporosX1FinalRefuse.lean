            (noHitUpTo_add hnh4 hrun4 hnh5)))) (by omega)
  refine ⟨nf + 2 + k3 + 3 + 18, by omega, s5, hrun, hs5rip, hs5r1,
    hs5r6, hs5r7,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, hs5s48, ?_, ?_, ?_, ?_, hs5len, ?_,
    hs5sh', hroom5, ?_, hNH⟩
  · have h1 : sp - 8 + 8 = sp := by omega
    rw [hs5r4, h1]
  · have h := slot5 (off := 0) (by decide) (by simpa using hs1s0)
