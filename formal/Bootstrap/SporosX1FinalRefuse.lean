  have ht13rip : t13.rip = base + 0x402 := by
    rw [ht13]; show t12.rip + 3 = base + 0x402; rw [ht12rip]
  have ht13fl : X86Int.cond t13.fl 3 = some false := by
    have hcf : t13.fl.cf = some true := by
      rw [ht13]
      show (aluF .sub (e - c) (12 * na)).2.cf = some true
