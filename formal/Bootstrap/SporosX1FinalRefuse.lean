        (X86Env.initStack top [argv0, path]).1.data.length := by
      rw [initStack_data_length]
      have hp : 4096 ≤ X86Env.pages
          (56 + ((argv0.length + 1) + (path.length + 1)) + 1) := by
        unfold X86Env.pages X86Env.page
