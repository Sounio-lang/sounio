    step_cmpI (by rw [hrip]; exact hc.p330) hr0
  obtain ⟨t1, ht1⟩ : ∃ t : X86Int.St, t =
      { s with fl := (aluF .sub op (57 % W)).2, rip := s.rip + 4 } :=
    ⟨_, rfl⟩
