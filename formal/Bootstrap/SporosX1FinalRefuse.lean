    rw [ht2]; show t1.rip + 3 = base + 0x31b; rw [ht1rip]
  have ht2r2 : t2.reg 2 = some (e - c) := by
    rw [ht2]
    show (t1.set 2 (some (aluF .sub e c).1)).reg 2 = some (e - c)
    rw [reg_set_self (by rw [ht1len]; decide), hsub]
  have ht2fr : ∀ i, i ≠ 2 → t2.reg i = s.reg i := by
    intro i hi
