    exact hs2r15
  have hs4pop : rd64 s4.mem (sp - 8) = some (r + 1) := by
    rw [hs4mem]; exact hs3pop
  have hs4s32 : rd64 s4.mem (p + 32) = some wd.ann.length := by
    rw [hs4mem]; exact hs3s32
  have hs4sh : wshape s4.mem = wshape s1.mem := by
    rw [hs4mem, hs3sh, hs2sh]
