      have hwbound : WordBound (⟨leVal (bs.take 4) % W,
          leVal ((bs.drop 4).take 4) % W,
          leVal ((bs.drop 8).take 4) % W, code, ann⟩ : Word) :=
        ⟨by simpa using hfb 0 (by decide), hfb 4 (by decide),
