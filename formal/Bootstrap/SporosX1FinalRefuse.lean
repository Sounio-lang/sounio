  have hb5mem : b5.mem = s.mem := by
    rw [hb5]; show b4.mem = s.mem; exact hb4mem
  have hlen5 : b5.regs.length = s.regs.length := by
    rw [hb5]
    show (b4.set 12 (some (aluF .xor v12 v12).1)).regs.length =
