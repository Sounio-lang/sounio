    step_pop (by rw [hrip]; exact hc.p258) hr4 hcur
  obtain ⟨t1, ht1⟩ : ∃ t : X86Int.St, t =
      { (s.set 4 (some ((sp1 + 8) % W))).set 6 (some c) with
        rip := s.rip + 1 } := ⟨_, rfl⟩
