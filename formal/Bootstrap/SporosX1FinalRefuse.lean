    intro i v h0 h2 h
    rw [hs11fr i h0 h2]; exact h
  -- assemble the whole run
  have hrunA : run stage1Im (12 + 11) (Out.ok s) = Out.ok s7 := by
    rw [run_add, hrun6, hrun7]
  have hrunB : run stage1Im (12 + 11 + 1) (Out.ok s) = Out.ok s8 := by
