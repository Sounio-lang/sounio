  (4195010, .pop 1, 1, [none], some 0),
  (4195011, .ret, 1, [], some 0),
  (4195012, .mov 0 2, 3, [none], none),
  (4195015, .pop 1, 1, [none], none),
  (4195016, .ret, 1, [], none)]

