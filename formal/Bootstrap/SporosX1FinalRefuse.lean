  have hea0 : ea (eff + 2 * p.code) 0 = eff + 2 * p.code := Nat.mod_eq_of_lt (by omega)
  have e4 : X86Int.step im a3 = .ok { a3.set 10 (some p.eff.1) with rip := a3.rip + 4 } :=
