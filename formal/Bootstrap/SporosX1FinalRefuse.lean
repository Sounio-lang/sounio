  have ht11fr : ∀ i, i ≠ 0 → i ≠ 2 → t11.reg i = t3.reg i := by
    intro i hi0 hi2
    rw [ht11]
    show ({ t10.set 2 (some e) with rip := t10.rip + 3 }).reg i =
