  have hnohit : NoHitUpTo s 4 := by
    intro j t hj hr hmem
    rcases (by omega : j = 0 ∨ j = 1 ∨ j = 2 ∨ j = 3 ∨ j = 4) with
      rfl | rfl | rfl | rfl | rfl
    · rw [run_zero] at hr
      simp only [Out.ok.injEq] at hr
      subst hr
      have h1 := hmem.1
      rw [hrip, hc.p330] at h1
      simp at h1
