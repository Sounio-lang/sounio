  have ht12fr : ∀ i, i ≠ 0 → i ≠ 2 → t12.reg i = t3.reg i := by
    intro i hi0 hi2
    rw [ht12]
    show (t11.set 2 (some (aluF .sub e c).1)).reg i = t3.reg i
