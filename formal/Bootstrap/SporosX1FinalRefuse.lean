  have ht5k : t5.k = s.k := by rw [ht5]; exact ht4k
  -- 0x328: jmp fail1
  obtain ⟨t6, r6, ht6rip, ht6fr, ht6mem, ht6len, ht6k⟩ :=
    jmp_step hc.p328 ht5rip
  -- compose
