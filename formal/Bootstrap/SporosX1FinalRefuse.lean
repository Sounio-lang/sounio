    · rw [hs3sh, hs2sh, hs1sh]
set_option maxHeartbeats 3200000 in
theorem parser_words_loop_classify_nh : ∀ (n : Nat)
    {B e S sp p c : Nat} {s : X86Int.St},
    s.rip = base + 0x2cc → s.reg 1 = some n →
    s.reg 6 = some c → s.reg 7 = some p →
    s.reg 15 = some e → s.reg 4 = some sp →
    s.reg 3 = some B → s.reg 11 = some S →
    B ≤ c → c ≤ e → e < W →
    p + 64 * n < W → S + (e - B) < W → n < W →
    StackRoom s 2 → 16 ≤ sp → sp < W → s.regs.length = 16 →
    (p + 64 * n ≤ c ∨ e ≤ p) →
    (p + 64 * n ≤ sp - 16 ∨ sp ≤ p) →
    (S + (e - B) ≤ p ∨ p + 64 * n ≤ S + (c - B)) →
    (e ≤ sp - 16 ∨ sp ≤ c) →
    (S + (e - B) ≤ c ∨ e ≤ S + (c - B)) →
    (S + (e - B) ≤ sp - 16 ∨ sp ≤ S + (c - B)) →
    (∀ (off v : Nat), off + 8 ≤ 64 * n →
      (wr64 s.mem (p + off) v).isSome) →
    (∀ a v, S + (c - B) ≤ a → a < S + (e - B) →
      (s.mem.wr a v).isSome) →
    (∀ a l, c ≤ a → l ≤ e - a →
      ∃ bs, s.mem.rdN a l = some bs ∧ ∀ b ∈ bs, b < 256) →
    (∃ (wds : List Word) (k : Nat) (s' : X86Int.St),
      k ≤ (wds.map (fun wd => 91 + 37 * wd.code.length)).sum ∧
      wds.length = n ∧
      run stage1Im k (Out.ok s) = Out.ok s' ∧
      s'.rip = base + 0x2cc ∧ s'.reg 1 = some 0 ∧
      s'.reg 6 = some (c + wordsBytes wds) ∧
      s'.reg 7 = some (p + 64 * n) ∧
      s'.reg 4 = some sp ∧
      c + wordsBytes wds ≤ e ∧
      WordsLay s.mem c wds ∧ TabLay s'.mem B S p c wds ∧
      (∀ wd ∈ wds, WordBound wd) ∧
      (∀ i, i ≠ 0 → i ≠ 1 → i ≠ 2 → i ≠ 4 → i ≠ 6 → i ≠ 7 →
        i ≠ 10 → s'.reg i = s.reg i) ∧
      s'.regs.length = 16 ∧ s'.k = s.k ∧
      wshape s'.mem = wshape s.mem ∧ StackRoom s' 2 ∧
      (∀ x k, (x + k ≤ sp - 16 ∨ sp ≤ x) →
        (p + 64 * n ≤ x ∨ x + k ≤ p) →
        (S + (c + wordsBytes wds - B) ≤ x ∨
          x + k ≤ S + (c - B)) →
        s'.mem.rdN x k = s.mem.rdN x k) ∧ NoHitUpTo s k) ∨
    (∃ (wds : List Word) (code' : List Instr) (k : Nat)
      (s' : X86Int.St),
      wds.length ≤ n ∧ c + wordsBytes wds ≤ e ∧
      codeBytes code' ≤ e - (c + wordsBytes wds) ∧
      k ≤ (wds.map (fun wd => 91 + 37 * wd.code.length)).sum +
        91 + 37 * (code'.length + 1) ∧
      run stage1Im k (Out.ok s) = Out.ok s' ∧
      s'.rip = aFail1 ∧
      (s'.reg 4 = some sp ∨ s'.reg 4 = some (sp - 8)) ∧
      (∀ i, i ≠ 0 → i ≠ 1 → i ≠ 2 → i ≠ 4 → i ≠ 6 → i ≠ 7 →
        i ≠ 10 → s'.reg i = s.reg i) ∧
      s'.regs.length = 16 ∧ s'.k = s.k ∧
      wshape s'.mem = wshape s.mem ∧ NoHitUpTo s k) := by
  intro n
  induction n with
  | zero =>
    intro B e S sp p c s hrip hr1 hr6 hr7 _ hr4 _ _ _ hce _ _ _ _
      hroom _ _ hlen16 _ _ _ _ _ _ _ _ _
    refine Or.inl ⟨[], 0, s, by simp, rfl, rfl, hrip, hr1, ?_,
      ?_, hr4, ?_,
      trivial, trivial, fun wd hwd => (List.not_mem_nil hwd).elim,
      ?_, hlen16, rfl, rfl, hroom, ?_, ?_⟩
    · show s.reg 6 = some (c + wordsBytes [])
      exact hr6
    · show s.reg 7 = some (p + 64 * 0)
      exact hr7
    · have hz : wordsBytes [] = 0 := rfl
      omega
    · intro i _ _ _ _ _ _ _; exact rfl
    · intro x k _ _ _; exact rfl
    · intro j t hj hr hmem
      rcases (by omega : j = 0) with rfl
      rw [run_zero] at hr
      simp only [Out.ok.injEq] at hr
      subst hr
      have hc := stage1_parserCode
      have h1 := hmem.1
      rw [hrip, hc.p2cc] at h1
      simp at h1
  | succ r ih =>
    intro B e S sp p c s hrip hr1 hr6 hr7 hr15 hr4 hr3 hr11 hBc hce
      heW hpW hSW hnW hroom hsp16 hspW hlen16 hTB hTStk hTScr hSB
      hScrB hScrStk hwrE hwrS hrdN
    have hcW : c < W := by omega
    -- head: enter the body
    obtain ⟨s1, hrun1, hs1rip, hs1fr, hs1mem, hs1len, hs1k,
        hs1nh⟩ :=
      parser_words_head_pos_nh hrip hr1 (by omega) hnW
    have hs1len16 : s1.regs.length = 16 := by rw [hs1len]; exact hlen16
    have hs1r : ∀ i v, s.reg i = some v → s1.reg i = some v := by
      intro i v h
      rw [hs1fr i]; exact h
    -- one word step, classified
    rcases parser_word_step_classify_nh hs1rip (hs1r 1 _ hr1)
        (hs1r 6 _ hr6) (hs1r 15 _ hr15) (hs1r 7 _ hr7)
        (hs1r 4 _ hr4) (hs1r 3 _ hr3) (hs1r 11 _ hr11) hcW heW
        (by omega) hnW hBc hSW
        (StackRoom_of_mem hs1mem (hs1fr 4) hroom)
        hsp16 hspW hs1len16 (by omega) hSB (by omega) hScrB
        (by omega) (by omega)
        (by
          intro off v hoff
          rw [hs1mem]
          exact hwrE off v (by omega))
        (by
          intro a v ha1 ha2
          rw [hs1mem]
          exact hwrS a v (by omega) ha2)
        (by
          intro a l ha hl
          obtain ⟨bs, hbs, hb⟩ := hrdN a l ha hl
          exact ⟨bs, by rwa [hs1mem], hb⟩) with hstep | hstepfail
    · obtain ⟨wd, k1, s2, hk1, hrun2, hs2rip, hs2r1, hs2r6, hs2r7,
          hs2r4,
          hs2head, hs2fit, hs2s0, hs2s8, hs2s16, hs2s24, hs2s32,
          hs2s40, hs2s48, hs2seq, hs2lay, hs2annlay, hs2annb, -,
          hs2fr, hs2len, hs2k, hs2sh, hs2room, hs2memfr,
          hs2nh⟩ := hstep
      have hrunP : run stage1Im (2 + k1) (Out.ok s) = Out.ok s2 := by
        rw [run_add stage1Im 2 k1, hrun1, hrun2]
      have hnhP : NoHitUpTo s (2 + k1) :=
        noHitUpTo_add hs1nh hrun1 hs2nh
      have hs2sh' : wshape s2.mem = wshape s.mem := by
        rw [hs2sh, hs1mem]
      have hs2r15 : s2.reg 15 = some e := by
        rw [hs2fr 15 (by decide) (by decide) (by decide)
          (by decide) (by decide) (by decide) (by decide), hs1fr 15]
        exact hr15
      have hs2r3 : s2.reg 3 = some B := by
        rw [hs2fr 3 (by decide) (by decide) (by decide) (by decide)
          (by decide) (by decide) (by decide), hs1fr 3]
        exact hr3
      have hs2r11 : s2.reg 11 = some S := by
        rw [hs2fr 11 (by decide) (by decide) (by decide)
          (by decide) (by decide) (by decide) (by decide), hs1fr 11]
        exact hr11
      have hs2wrE : ∀ (off v : Nat), off + 8 ≤ 64 * r →
          (wr64 s2.mem (p + 64 + off) v).isSome := by
        intro off v hoff
        have h1 : (s.mem.wrN (p + 64 + off) (bytes8 v)).isSome := by
          have h2 := hwrE (64 + off) v (by omega)
          rwa [show p + (64 + off) = p + 64 + off by omega] at h2
        exact wrN_some_of_wshape _ s.mem s2.mem hs2sh' _ h1
      have hs2wrS : ∀ a v,
          S + (c + 20 + codeBytes wd.code + 12 * wd.ann.length -
            B) ≤ a → a < S + (e - B) → (s2.mem.wr a v).isSome := by
        intro a v ha1 ha2
        have h1 : (s.mem.wrN a [v]).isSome := by
          rw [← wr_eq_wrN]
          exact hwrS a v (by omega) ha2
        have h2 := wrN_some_of_wshape _ s.mem s2.mem hs2sh' _ h1
        rwa [← wr_eq_wrN] at h2
      have hs2rdN : ∀ a l,
          c + 20 + codeBytes wd.code + 12 * wd.ann.length ≤ a →
          l ≤ e - a →
          ∃ bs, s2.mem.rdN a l = some bs ∧
            ∀ b ∈ bs, b < 256 := by
        intro a l ha hl
        by_cases hl0 : l = 0
        · subst hl0
          exact ⟨[], rfl, fun b hb => (List.not_mem_nil hb).elim⟩
        obtain ⟨bs, hbs, hb⟩ := hrdN a l (by omega) hl
        refine ⟨bs, ?_, hb⟩
        rw [hs2memfr a l (by omega) (by omega) (by omega), hs1mem]
        exact hbs
      -- induction over the rest
      rcases ih hs2rip hs2r1 hs2r6 hs2r7 hs2r15 hs2r4 hs2r3 hs2r11
          (by omega) hs2fit heW (by omega) hSW (by omega) hs2room
          hsp16 hspW hs2len (by omega) (by omega) (by omega)
          (by omega) (by omega) (by omega) hs2wrE hs2wrS hs2rdN with
        hrest | hrestfail
      · obtain ⟨wds, k2, s3, hk2, hwdslen, hrun3, hs3rip, hs3r1,
            hs3r6,
            hs3r7, hs3r4, hs3fit, hs3layW, hs3tab, hs3annb, hs3fr,
            hs3len, hs3k, hs3sh, hs3room, hs3memfr, hs3nh⟩ := hrest
        have hwb : wordsBytes (wd :: wds) =
            (20 + codeBytes wd.code + 12 * wd.ann.length) +
              wordsBytes wds := rfl
        have hrun : run stage1Im (2 + k1 + k2) (Out.ok s) =
            Out.ok s3 := by
          rw [show 2 + k1 + k2 = 2 + (k1 + k2) by omega,
            run_add stage1Im 2 _, hrun1, run_add stage1Im k1 k2,
            hrun2, hrun3]
        have slot3 : ∀ {off w : Nat}, off + 8 ≤ 56 →
            rd64 s2.mem (p + off) = some w →
            rd64 s3.mem (p + off) = some w := by
          intro off w hoff h
          unfold rd64
          rw [hs3memfr (p + off) 8 (by omega) (by omega) (by omega)]
          have h' := h
          unfold rd64 at h'
          exact h'
        have hseq3 : CodeSeq s3.mem (c + 20) wd.code := by
          apply CodeSeq_of_frame hs2seq
          intro y k hy hk
          apply hs3memfr <;> omega
        have hlay3 : LenLay s3.mem B S (c + 20) wd.code := by
          apply LenLay_of_frame wd.code (by omega) hs2lay
          intro a ha1 ha2
          apply rd_eq_of_rdN1
          apply hs3memfr
          · rcases hScrStk with h | h
            · exact Or.inl (by omega)
            · exact Or.inr (by omega)
          · rcases hTScr with h | h
            · exact Or.inr (by omega)
            · exact Or.inl (by omega)
          · exact Or.inr (by omega)
        have hann3 : AnnLayB s3.mem (c + 20 + codeBytes wd.code)
            wd.ann := by
          apply AnnLayB_of_frame hs2annlay
          intro y k hy hk
          apply hs3memfr <;> omega
        have htab : TabLay s3.mem B S p c (wd :: wds) :=
          ⟨slot3 (off := 0) (by decide) (by simpa using hs2s0),
            slot3 (by decide) hs2s8, slot3 (by decide) hs2s16,
            slot3 (by decide) hs2s24, slot3 (by decide) hs2s32,
            slot3 (by decide) hs2s40, slot3 (by decide) hs2s48,
            hseq3, hlay3, hann3, hs3tab⟩
        have hlayW : WordsLay s.mem c (wd :: wds) := by
          obtain ⟨bs, h20, e0, e1, e2, e3, e4⟩ := hs2head
          refine ⟨⟨bs, by rwa [hs1mem] at h20, e0, e1, e2, e3, e4⟩,
            ?_, ?_, ?_⟩
          · apply CodeSeq_of_frame hs2seq
            intro y k hy hk
            rw [← hs1mem]
            exact (hs2memfr y k (by omega) (by omega)
              (by omega)).symm
          · apply AnnLayB_of_frame hs2annlay
            intro y k hy hk
            rw [← hs1mem]
            exact (hs2memfr y k (by omega) (by omega)
              (by omega)).symm
          · apply WordsLay_of_frame wds hs3layW
            intro y k hy hk
            rw [← hs1mem]
            exact (hs2memfr y k (by omega) (by omega)
              (by omega)).symm
        refine Or.inl ⟨wd :: wds, 2 + k1 + k2, s3, by
            simp only [List.map_cons, List.sum_cons]; omega, by
            rw [List.length_cons, hwdslen], hrun, hs3rip, hs3r1,
          ?_, ?_, hs3r4, by rw [hwb]; omega, hlayW, htab, ?_, ?_,
          hs3len, ?_, ?_, hs3room, ?_,
          noHitUpTo_add hnhP hrunP hs3nh⟩
        · show s3.reg 6 = some (c + wordsBytes (wd :: wds))
          rw [hwb]
          have h := hs3r6
          rwa [show c + 20 + codeBytes wd.code +
              12 * wd.ann.length + wordsBytes wds =
            c + (20 + codeBytes wd.code + 12 * wd.ann.length +
              wordsBytes wds) by omega] at h
        · show s3.reg 7 = some (p + 64 * (r + 1))
          have h := hs3r7
          rwa [show p + 64 + 64 * r = p + 64 * (r + 1) by omega]
            at h
        · intro wd' hwd
          rcases List.mem_cons.mp hwd with rfl | hwd
          · exact hs2annb
          · exact hs3annb wd' hwd
        · intro i hi0 hi1 hi2 hi4 hi6 hi7 hi10
          rw [hs3fr i hi0 hi1 hi2 hi4 hi6 hi7 hi10,
            hs2fr i hi0 hi1 hi2 hi4 hi6 hi7 hi10, hs1fr i]
        · rw [hs3k, hs2k, hs1k]
        · rw [hs3sh, hs2sh, hs1mem]
        · intro x k hd1 hd2 hd3
          rw [hs3memfr x k hd1 (by omega) (by omega),
            hs2memfr x k hd1 (by omega) (by omega), hs1mem]
      · obtain ⟨wds, code', k2, s3, hwdslen, hwdsfit, hcodefit,
            hk2, hrun3, hs3rip, hs3r4, hs3fr, hs3len, hs3k,
            hs3sh, hs3nh⟩ := hrestfail
        exact Or.inr ⟨wd :: wds, code', 2 + k1 + k2, s3,
          by simp only [List.length_cons]; omega,
          by show c + ((20 + codeBytes wd.code +
              12 * wd.ann.length) + wordsBytes wds) ≤ e; omega,
          by show codeBytes code' ≤ e - (c +
              ((20 + codeBytes wd.code + 12 * wd.ann.length) +
                wordsBytes wds)); omega,
          by simp only [List.map_cons, List.sum_cons]; omega, by
            rw [show 2 + k1 + k2 = (2 + k1) + k2 by omega,
              run_add stage1Im (2 + k1) k2, hrunP, hrun3], hs3rip,
          hs3r4,
          fun i hi0 hi1 hi2 hi4 hi6 hi7 hi10 =>
            (hs3fr i hi0 hi1 hi2 hi4 hi6 hi7 hi10).trans
              ((hs2fr i hi0 hi1 hi2 hi4 hi6 hi7 hi10).trans
                (hs1fr i)),
          hs3len, (hs3k.trans hs2k).trans hs1k,
          by rw [hs3sh, hs2sh, hs1mem],
          noHitUpTo_add hnhP hrunP hs3nh⟩
    · obtain ⟨code', k1, s2, hcodefit, hk1, hrun2, hs2rip, hs2r4,
          hs2fr, hs2len, hs2k, hs2sh, hs2nh⟩ := hstepfail
      exact Or.inr ⟨[], code', 2 + k1, s2, Nat.zero_le _,
        by show c + 0 ≤ e; omega,
        by show codeBytes code' ≤ e - (c + 0); omega,
        by show 2 + k1 ≤ 0 + 91 + 37 * (code'.length + 1); omega,
        by
          rw [run_add stage1Im 2 k1, hrun1, hrun2], hs2rip, hs2r4,
        fun i hi0 hi1 hi2 hi4 hi6 hi7 hi10 =>
          (hs2fr i hi0 hi1 hi2 hi4 hi6 hi7 hi10).trans (hs1fr i),
        hs2len, hs2k.trans hs1k, by rw [hs2sh, hs1mem],
        noHitUpTo_add hs1nh hrun1 hs2nh⟩
/-- `shapeBnd` transports across equal write shapes. -/
theorem shapeBnd_of_wshape {m m' : Mem}
    (h : wshape m' = wshape m) (hb : shapeBnd m) :
    shapeBnd m' := by
  intro p hp
  obtain ⟨r, hr, hpr⟩ := List.mem_map.mp hp
  apply hb
  have h3 : (r.base, r.hi, r.rw) ∈ wshape m := by
    rw [← h]
    exact List.mem_map.mpr ⟨r, hr, rfl⟩
  obtain ⟨r2, hr2, h2⟩ := List.mem_map.mp h3
  apply List.mem_map.mpr
  refine ⟨r2, hr2, ?_⟩
  rw [← hpr]
  simp only [Prod.mk.injEq] at h2 ⊢
  exact ⟨h2.1, h2.2.1⟩

/-- The per-word budget sum is bounded by the byte budget. -/
theorem word_budget_sum_le : ∀ (wds : List Word),
    (wds.map (fun wd => 91 + 37 * wd.code.length)).sum ≤
      91 * wds.length + 37 * wordsBytes wds
  | [] => by simp [wordsBytes]
  | wd :: wds => by
    have ih := word_budget_sum_le wds
    have hcb := code_length_le_bytes wd.code
    simp only [List.map_cons, List.sum_cons, List.length_cons,
      wordsBytes]
    omega

/-- Bounded `NoHitUpTo` back classification: from the state
after the scratch `mmap` (scratch at `r11`, table at `r14`),
either exit 1, or the checker entry with the shape bound the
checker invariant needs. -/
theorem parser_back_classify_nh {A L sp1 T S c nw mn : Nat}
    {s : X86Int.St}
    (hrip : s.rip = base + 0x258) (hr4 : s.reg 4 = some sp1)
    (hr14 : s.reg 14 = some T) (hr3 : s.reg 3 = some A)
    (hr12 : s.reg 12 = some mn) (hr15 : s.reg 15 = some (A + L))
    (hr11 : s.reg 11 = some S)
    (hspW : sp1 + 56 < W) (hAW : A + 8 < W)
    (hcur : rd64 s.mem sp1 = some c)
    (hnwv : ∃ v, rd64 s.mem (A + 8) = some v ∧ v % 2 ^ 32 = nw)
    (hpop : ∀ off : Nat, off ≤ 48 →
      ∃ w, rd64 s.mem (sp1 + off) = some w)
    (hlen16 : s.regs.length = 16) (hregs : RegsOk s)
    (hbnd : shapeBnd s.mem)
    (hstk : (∀ v, (wr64 s.mem (sp1 + 48) v).isSome) ∧
      ∀ v, (wr64 s.mem (sp1 + 40) v).isSome)
    (hBc : A ≤ c) (hce : c ≤ A + L) (heW : A + L < W)
    (hpWn : T + 64 * nw < W) (hSW : S + (A + L - A) < W) (hnwW : nw < W)
    (hmnW : T + 64 * mn < W)
    (hT1 : T + 64 * nw ≤ c ∨ A + L ≤ T)
    (hT2 : T + 64 * nw ≤ sp1 + 56 - 16 ∨ sp1 + 56 ≤ T)
    (hT3 : S + (A + L - A) ≤ T ∨ T + 64 * nw ≤ S + (c - A))
    (hSB : A + L ≤ sp1 + 56 - 16 ∨ sp1 + 56 ≤ c)
    (hScrB : S + (A + L - A) ≤ c ∨ A + L ≤ S + (c - A))
    (hScrStk : S + (A + L - A) ≤ sp1 + 56 - 16 ∨ sp1 + 56 ≤ S + (c - A))
    (hwrE : ∀ (off v : Nat), off + 8 ≤ 64 * nw →
      (wr64 s.mem (T + off) v).isSome)
    (hwrS : ∀ a v, S + (c - A) ≤ a → a < S + (A + L - A) →
      (s.mem.wr a v).isSome)
    (hrdN : ∀ a l, c ≤ a → l ≤ A + L - a →
      ∃ bs, s.mem.rdN a l = some bs ∧ ∀ b ∈ bs, b < 256) :
    (∃ k, k ≤ 200 + 200 * L ∧
      run stage1Im k (Out.ok s) = Out.exit 1 ∧ NoHitUpTo s k) ∨
    (∃ N s', N ≤ 200 + 200 * L ∧
      run stage1Im N (Out.ok s) = Out.ok s' ∧
      s'.rip = base + 0x452 ∧ s'.reg 4 = some (sp1 + 56) ∧
      s'.k = s.k ∧ s'.regs.length = 16 ∧ shapeBnd s'.mem ∧
      NoHitUpTo s N) := by
  obtain ⟨v, hnw, hvmod⟩ := hnwv
  obtain ⟨w1, hp1⟩ := hpop 8 (by decide)
  obtain ⟨w2, hp2⟩ := hpop 16 (by decide)
  obtain ⟨w3, hp3⟩ := hpop 24 (by decide)
  obtain ⟨w4, hp4⟩ := hpop 32 (by decide)
  obtain ⟨w5, hp5⟩ := hpop 40 (by decide)
  obtain ⟨w6, hp6⟩ := hpop 48 (by decide)
  obtain ⟨s7, hrun7, hs7rip, hs7r6, hs7r7, hs7r13, hs7r4, -,
      hs7mem, hs7fr, hs7len, hs7k, hs7nh⟩ :=
    parser_setup_ok_nh hrip hr4 hr14 hr3 hspW hAW hcur hnw hp1
      hp2 hp3 hp4 hp5 hp6 hlen16
  have hs7r13' : s7.reg 13 = some nw := by rw [hs7r13, hvmod]
  obtain ⟨s8, hrun8, hs8rip, hs8r1, hs8fr, hs8mem, hs8len, hs8k,
      hs8nh⟩ :=
    parser_words_init_nh hs7rip hs7r13' hs7len
  have hrun78 : run stage1Im 12 (Out.ok s) = Out.ok s8 := by
    rw [show (12 : Nat) = 11 + 1 by omega, run_add stage1Im 11 1,
      hrun7, hrun8]
  have hnh78 : NoHitUpTo s 12 := noHitUpTo_add hs7nh hrun7 hs8nh
  have hs8mem' : s8.mem = s.mem := hs8mem.trans hs7mem
  have hs8r : ∀ i v, i ≠ 0 → i ≠ 1 → i ≠ 4 → i ≠ 6 → i ≠ 7 →
      i ≠ 13 → s.reg i = some v → s8.reg i = some v := by
    intro i v hi0 hi1 hi4 hi6 hi7 hi13 hv
    rw [hs8fr i hi1, hs7fr i hi0 hi4 hi6 hi7 hi13]
    exact hv
  have hs8r4 : s8.reg 4 = some (sp1 + 56) := by
    rw [hs8fr 4 (by decide)]; exact hs7r4
  have hs8r6 : s8.reg 6 = some c := by
    rw [hs8fr 6 (by decide)]; exact hs7r6
  have hs8r7 : s8.reg 7 = some T := by
    rw [hs8fr 7 (by decide)]; exact hs7r7
  have hs8r15 : s8.reg 15 = some (A + L) :=
    hs8r 15 _ (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) hr15
  have hs8r3 : s8.reg 3 = some A :=
    hs8r 3 _ (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) hr3
  have hs8r11 : s8.reg 11 = some S :=
    hs8r 11 _ (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) hr11
  have hs8room : StackRoom s8 2 := by
    intro sp hsp i hi v
    have hspEq : sp = sp1 + 56 := by
      rw [hs8r4] at hsp
      exact (Option.some.inj hsp).symm
    subst hspEq
    rw [hs8mem']
    rcases (by omega : i = 0 ∨ i = 1) with rfl | rfl
    · have e : (sp1 + 56 + W - 8 * (0 + 1)) % W = sp1 + 48 := by
        rw [show sp1 + 56 + W - 8 * (0 + 1) = (sp1 + 48) + W by
          omega, Nat.add_mod_right,
          Nat.mod_eq_of_lt (by omega)]
      rw [e]
      exact hstk.1 v
    · have e : (sp1 + 56 + W - 8 * (1 + 1)) % W = sp1 + 40 := by
        rw [show sp1 + 56 + W - 8 * (1 + 1) = (sp1 + 40) + W by
          omega, Nat.add_mod_right,
          Nat.mod_eq_of_lt (by omega)]
      rw [e]
      exact hstk.2 v
  -- exit-1 closer for back failures
  have hexit : ∀ (z : X86Int.St) (kz : Nat),
      run stage1Im kz (Out.ok s) = Out.ok z →
      z.rip = aFail1 → wshape z.mem = wshape s.mem →
      (z.reg 4 = some (sp1 + 56) ∨ z.reg 4 = some (sp1 + 48)) →
      NoHitUpTo s kz → kz ≤ 195 + 200 * L →
      ∃ k, k ≤ 200 + 200 * L ∧
        run stage1Im k (Out.ok s) = Out.exit 1 ∧
        NoHitUpTo s k := by
    intro z kz hzrun hzrip hzsh hzr4 hznh hkz
    have hzroom : StackRoom z 1 := by
      intro sp hsp i hi v
      have hi0 : i = 0 := by omega
      subst hi0
      have h1 : (s.mem.wrN ((sp + W - 8) % W) (bytes8 v)).isSome := by
        rcases hzr4 with h4 | h4
        · have hspEq : sp = sp1 + 56 := by
            rw [h4] at hsp
            exact (Option.some.inj hsp).symm
          subst hspEq
          have e : (sp1 + 56 + W - 8) % W = sp1 + 48 := by
            rw [show sp1 + 56 + W - 8 = (sp1 + 48) + W by omega,
              Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
          rw [e]
          exact hstk.1 v
        · have hspEq : sp = sp1 + 48 := by
            rw [h4] at hsp
            exact (Option.some.inj hsp).symm
          subst hspEq
          have e : (sp1 + 48 + W - 8) % W = sp1 + 40 := by
            rw [show sp1 + 48 + W - 8 = (sp1 + 40) + W by omega,
              Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
          rw [e]
          exact hstk.2 v
      have h2 := wrN_some_of_wshape _ s.mem z.mem hzsh _ h1
      exact h2
    rcases hzr4 with h4 | h4
    · obtain ⟨h5, hnh5⟩ := exit1_of_fail1_bnd (by omega)
        (by omega) z hzrip h4 (run_regs_ok hzrun hregs) hzroom
      exact ⟨kz + 5, by omega,
        by rw [run_add stage1Im kz 5, hzrun, h5],
        noHitUpTo_add hznh hzrun hnh5⟩
    · obtain ⟨h5, hnh5⟩ := exit1_of_fail1_bnd (by omega)
        (by omega) z hzrip h4 (run_regs_ok hzrun hregs) hzroom
      exact ⟨kz + 5, by omega,
        by rw [run_add stage1Im kz 5, hzrun, h5],
        noHitUpTo_add hznh hzrun hnh5⟩
  rcases parser_words_loop_classify_nh nw hs8rip hs8r1 hs8r6
      hs8r7 hs8r15 hs8r4 hs8r3 hs8r11 hBc hce heW hpWn hSW hnwW
      hs8room (by omega) (by omega) hs8len hT1 hT2 hT3 hSB hScrB
      hScrStk
      (by rw [hs8mem']; exact hwrE)
      (by rw [hs8mem']; exact hwrS)
      (by
        intro a l ha hl
        obtain ⟨bs, hbs, hb⟩ := hrdN a l ha hl
        exact ⟨bs, by rwa [hs8mem'], hb⟩) with hloop | hloopfail
  · obtain ⟨wds, k9, s9, hk9, hwdslen, hrun9, hs9rip, hs9r1,
        hs9r6, hs9r7, hs9r4, hs9fit, hs9layW, hs9tab, hs9b, hs9fr,
        hs9len, hs9k, hs9sh, hs9room, hs9memfr, hs9nh⟩ := hloop
    have hrun89 : run stage1Im (12 + k9) (Out.ok s) =
        Out.ok s9 := by
      rw [run_add stage1Im 12 k9, hrun78, hrun9]
    have hnh89 : NoHitUpTo s (12 + k9) :=
      noHitUpTo_add hnh78 hrun78 hs9nh
    have hk9L : k9 ≤ 128 * L := by
      have h1 := word_budget_sum_le wds
      have h2 := wordsBytes_ge wds
      omega
    obtain ⟨s10, hrun10, hs10rip, hs10fr, hs10mem, hs10len,
        hs10k, hs10nh⟩ :=
      parser_words_head_zero_nh hs9rip hs9r1
    have hrun810 : run stage1Im (12 + k9 + 3) (Out.ok s) =
        Out.ok s10 := by
      rw [show 12 + k9 + 3 = (12 + k9) + 3 by omega,
        run_add stage1Im (12 + k9) 3, hrun89, hrun10]
    have hnh810 : NoHitUpTo s (12 + k9 + 3) :=
      noHitUpTo_add hnh89 hrun89 hs10nh
    have hs10r : ∀ i v, s9.reg i = some v → s10.reg i = some v := by
      intro i v hv
      rw [hs10fr i]; exact hv
    have hs10r6 : s10.reg 6 = some (c + wordsBytes wds) :=
      hs10r 6 _ hs9r6
    have hs10r15 : s10.reg 15 = some (A + L) :=
      hs10r 15 _ (by
        rw [hs9fr 15 (by decide) (by decide) (by decide)
          (by decide) (by decide) (by decide) (by decide)]
        exact hs8r15)
    have hs10r12 : s10.reg 12 = some mn :=
      hs10r 12 _ (by
        rw [hs9fr 12 (by decide) (by decide) (by decide)
          (by decide) (by decide) (by decide) (by decide)]
        exact hs8r 12 _ (by decide) (by decide) (by decide)
          (by decide) (by decide) (by decide) hr12)
    have hs10r13 : s10.reg 13 = some nw :=
      hs10r 13 _ (by
        rw [hs9fr 13 (by decide) (by decide) (by decide)
          (by decide) (by decide) (by decide) (by decide),
          hs8fr 13 (by decide)]
        exact hs7r13')
    have hs10r14 : s10.reg 14 = some T :=
      hs10r 14 _ (by
        rw [hs9fr 14 (by decide) (by decide) (by decide)
          (by decide) (by decide) (by decide) (by decide)]
        exact hs8r 14 _ (by decide) (by decide) (by decide)
          (by decide) (by decide) (by decide) hr14)
    have hs10r4 : s10.reg 4 = some (sp1 + 56) := hs10r 4 _ hs9r4
    have hs10len16 : s10.regs.length = 16 := by
      rw [hs10len]; exact hs9len
    have hs10sh : wshape s10.mem = wshape s.mem := by
      rw [hs10mem, hs9sh, hs8mem']
    have htrailExit : ∀ (z : X86Int.St) (kz : Nat),
        run stage1Im kz (Out.ok s10) = Out.ok z →
        z.rip = aFail1 → z.reg 4 = some (sp1 + 56) →
        z.mem = s10.mem → NoHitUpTo s10 kz → kz ≤ 16 →
        ∃ k, k ≤ 200 + 200 * L ∧
          run stage1Im k (Out.ok s) = Out.exit 1 ∧
          NoHitUpTo s k := by
      intro z kz hzrun hzrip hzr4 hzmem hznh hkz
      apply hexit z (12 + k9 + 3 + kz)
      · rw [show 12 + k9 + 3 + kz = (12 + k9 + 3) + kz by omega,
          run_add stage1Im (12 + k9 + 3) kz, hrun810, hzrun]
      · exact hzrip
      · rw [hzmem]; exact hs10sh
      · exact Or.inl hzr4
      · exact noHitUpTo_add hnh810 hrun810 hznh
      · omega
    by_cases hcurN : c + wordsBytes wds ≠ A + L
    · obtain ⟨z, hzrun, hzrip, hzfr, hzmem, hzlen, hzk, hznh⟩ :=
        parser_trailing_cursor_fail_nh hs10rip hs10r6 hs10r15
          hcurN (by omega) heW
      exact Or.inl (htrailExit z 3 hzrun hzrip
        (by rw [hzfr 4]; exact hs10r4) hzmem hznh (by omega))
    have hcurE : c + wordsBytes wds = A + L := by omega
    by_cases hmnN : ¬ mn < nw
    · obtain ⟨z, hzrun, hzrip, hzfr, hzmem, hzlen, hzk, hznh⟩ :=
        parser_trailing_main_ge_nh hs10rip hs10r6 hs10r15
          hs10r12 hs10r13 hcurE (by omega) heW (by omega)
          hs10len16
      exact Or.inl (htrailExit z 5 hzrun hzrip
        (by rw [hzfr 4]; exact hs10r4) hzmem hznh (by omega))
    have hmnlt : mn < nw := by omega
    have hslot10 : rd64 s10.mem (T + 64 * mn) =
        some wds[mn].ins := by
      rw [hs10mem]
      have hj : mn < wds.length := by omega
      exact TabLay_ins_at hs9tab mn hj
    by_cases hins : wds[mn].ins = 0
    · obtain ⟨z, hzrun, hzrip, hzr0, hzfr, hzmem, hzlen, hzk,
          hznh⟩ :=
        parser_trailing_ok_nh hs10rip hs10r6 hs10r15 hs10r12
          hs10r13 hs10r14 hcurE (by omega) heW hmnlt hmnW
          (by rw [hslot10, hins]) hs10len16
      refine Or.inr ⟨12 + k9 + 3 + 15, z, by omega, by
        rw [show 12 + k9 + 3 + 15 = (12 + k9 + 3) + 15 by omega,
          run_add stage1Im (12 + k9 + 3) 15, hrun810, hzrun],
        hzrip,
        by rw [hzfr 4 (by decide) (by decide)]; exact hs10r4,
        by rw [hzk, hs10k, hs9k, hs8k, hs7k], hzlen,
        shapeBnd_of_wshape (by rw [hzmem]; exact hs10sh) hbnd,
        noHitUpTo_add hnh810 hrun810 hznh⟩
    · obtain ⟨z, hzrun, hzrip, hzfr, hzmem, hzlen, hzk, hznh⟩ :=
        parser_trailing_slot_fail_nh hs10rip hs10r6 hs10r15
          hs10r12 hs10r13 hs10r14 hcurE (by omega) heW hmnlt
