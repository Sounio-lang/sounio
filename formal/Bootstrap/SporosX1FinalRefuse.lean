  have ht11r6 : t11.reg 6 = some c := by
    rw [ht11fr 6 (by decide) (by decide)]; exact ht3r6
  have ht11r0 : t11.reg 0 = some (12 * na) := by
    rw [ht11]
    show ({ t10.set 2 (some e) with rip := t10.rip + 3 }).reg 0 =
