/-- Every abstract checker decode fact holds for the real image. -/
theorem stage1_allCode : AllCode stage1Im :=
  ⟨stage1_l32, stage1_annl, stage1_walk, stage1_lit, stage1_str,
   stage1_tor, stage1_fromr, stage1_rfetch, stage1_pick, stage1_locget,
