  constructor <;> decide +kernel

set_option maxHeartbeats 0 in
/-- Every refusal-only decode fact holds for the real image. -/
theorem stage1_refuseCode : RefuseCode stage1Im := by
  refine ⟨?_, by decide +kernel, by decide +kernel⟩
  constructor <;> decide +kernel

