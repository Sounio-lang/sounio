/-
SporosX1Image: the abstract checker layout of `Bootstrap.SporosX1Comp`
instantiated at the real stage-1 image.

`X86Min.Data.sporosStage1Hex` and `X86Min.Data.sporosStage1` are generated
from `bootstrap/roots/sporos/sporos-stage1.hex` by
`bootstrap/model/gen_seed_data.sh`; CI regenerates `SeedData.lean` and fails
on any difference.  One theorem below ties the generated byte list to
the reference format-A decoder `X86Min.Formats.decA`, once, by the kernel.
Every layout field is then discharged against `X86Dec.imageOf` by
`decide +kernel`, split by region so a mismatch names its region.
-/
import Bootstrap.Formats
import Bootstrap.SeedData
import Bootstrap.SporosX1Comp

open X86Env X86Int X86Dec Sporos X86Min.Formats

namespace SporosX1

/-- The bytes of `bootstrap/roots/sporos/sporos-stage1.hex`, decoded
from format A by the generator. -/
def stage1Code : List Nat := X86Min.Data.sporosStage1

/-- The stage-1 image as the semantics see it: `stage1Code` loaded
at the ELF base. -/
def stage1Im : Nat → Option (Ins × Nat) := X86Dec.imageOf stage1Code 0x400000

/-! ### ELF header fields, read from the code itself

The Linux loader does not know the constants `base` and `base + 0x78`;
it reads them from the ELF and program headers.  These definitions do
the same, and the theorems pin the values by `decide +kernel`, so the
initial-state definition in the final-theorem file can be written in
terms of the fields the kernel actually uses. -/

/-- `e_entry` (ELF header, offset `0x18`, 8 bytes). -/
def elfEntry : Nat := leVal ((stage1Code.drop 0x18).take 8)

/-- `e_phnum` (ELF header, offset `0x38`, 2 bytes). -/
def elfPhnum : Nat := leVal ((stage1Code.drop 0x38).take 2)

/-- `p_flags` (program header at `0x40`, offset `0x44`, 4 bytes). -/
def phFlags : Nat := leVal ((stage1Code.drop 0x44).take 4)

/-- `p_offset` (program header, offset `0x48`, 8 bytes). -/
def phOffset : Nat := leVal ((stage1Code.drop 0x48).take 8)

/-- `p_vaddr` (program header, offset `0x50`, 8 bytes). -/
def phVaddr : Nat := leVal ((stage1Code.drop 0x50).take 8)

/-- `p_filesz` (program header, offset `0x60`, 8 bytes). -/
def phFilesz : Nat := leVal ((stage1Code.drop 0x60).take 8)

/-- `p_memsz` (program header, offset `0x68`, 8 bytes). -/
def phMemsz : Nat := leVal ((stage1Code.drop 0x68).take 8)

theorem elfEntry_eq : elfEntry = base + 0x78 := by decide +kernel

theorem elfPhnum_eq : elfPhnum = 1 := by decide +kernel

/-- `p_flags = 5` is R+X (`PF_R = 4`, `PF_X = 1`). -/
theorem phFlags_eq : phFlags = 5 := by decide +kernel

theorem phOffset_eq : phOffset = 0 := by decide +kernel

theorem phVaddr_eq : phVaddr = base := by decide +kernel

theorem phFilesz_eq : phFilesz = stage1Code.length := by decide +kernel

theorem phMemsz_eq : phMemsz = stage1Code.length := by decide +kernel

set_option maxHeartbeats 0 in
/-- The decoded stage-1 image is 2447 bytes. -/
theorem stage1Code_length : stage1Code.length = 2447 := by decide +kernel

/-! ### The generated bytes are the `decA` reading of the listing -/

abbrev HexSt := Bool × Option Nat × List Nat

def decASt : List Nat → Bool → Option Nat → List Nat → Option HexSt
  | [], com, p, acc => some (com, p, acc)
  | c :: l, true, p, acc => decASt l (c != 10) p acc
  | c :: l, false, p, acc =>
    if c = 35 then decASt l true p acc
    else if isSep c then decASt l false p acc
    else match hexVal c, p with
      | some v, none => decASt l false (some v) acc
      | some v, some h => decASt l false none ((h * 16 + v) :: acc)
      | none, _ => none

def hexFinish : Option HexSt → Option (List Nat)
  | some (_, none, acc) => some acc.reverse
  | _ => none

theorem decASt_finish :
    ∀ (L : List Nat) (com : Bool) (p : Option Nat) (acc : List Nat),
      hexFinish (decASt L com p acc) = decA L com p acc := by
  intro L
  induction L with
  | nil =>
    intro com p acc
    cases p <;> rfl
  | cons c L ih =>
    intro com p acc
    cases com with
    | true =>
      by_cases h : c = 10
      · simp [decASt, decA, h, ih]
      · have hne : (c != 10) = true := by simp [h]
        simp [decASt, decA, h, hne, ih]
    | false =>
      by_cases h35 : c = 35
      · simp [decASt, decA, h35, ih]
      · by_cases hs : isSep c = true
        · simp [decASt, decA, h35, hs, ih]
        · cases hv : hexVal c with
          | none =>
            cases p <;> simp [decASt, decA, h35, hs, hv, hexFinish]
          | some v =>
            cases p with
            | none => simp [decASt, decA, h35, hs, hv, ih]
            | some h => simp [decASt, decA, h35, hs, hv, ih]

theorem decASt_append :
    ∀ (L1 L2 : List Nat) (com : Bool) (p : Option Nat) (acc : List Nat),
      decASt (L1 ++ L2) com p acc =
        match decASt L1 com p acc with
        | some (com', p', acc') => decASt L2 com' p' acc'
        | none => none := by
  intro L1
  induction L1 with
  | nil =>
    intro L2 com p acc
    rfl
  | cons c L1 ih =>
    intro L2 com p acc
    cases com with
    | true =>
      simp only [List.cons_append, decASt, ih]
    | false =>
      by_cases h35 : c = 35
      · simp [List.cons_append, decASt, h35, ih]
      · by_cases hs : isSep c = true
        · simp [List.cons_append, decASt, h35, hs, ih]
        · cases hv : hexVal c with
          | none =>
            cases p <;> simp [List.cons_append, decASt, h35, hs, hv]
          | some v =>
            cases p with
            | none => simp [List.cons_append, decASt, h35, hs, hv, ih]
            | some h => simp [List.cons_append, decASt, h35, hs, hv, ih]

def runChunks : List (List Nat) → Option HexSt → Option HexSt
  | [], st => st
  | _ :: _, none => none
  | chunk :: rest, some (com, p, acc) => runChunks rest (decASt chunk com p acc)

theorem runChunks_none : ∀ chunks : List (List Nat),
    runChunks chunks none = none
  | [] => rfl
  | _ :: _ => rfl

theorem runChunks_eq :
    ∀ (chunks : List (List Nat)) (com : Bool) (p : Option Nat)
      (acc : List Nat),
      runChunks chunks (some (com, p, acc)) =
        decASt chunks.flatten com p acc := by
  intro chunks
  induction chunks with
  | nil =>
    intro com p acc
    rfl
  | cons chunk rest ih =>
    intro com p acc
    simp only [runChunks, List.flatten_cons, decASt_append]
    cases h : decASt chunk com p acc with
    | none => exact runChunks_none rest
    | some st =>
      obtain ⟨com', p', acc'⟩ := st
      exact ih com' p' acc'

def stage1HexChunks : List (List Nat) := X86Min.Data.sporosStage1HexChunks

set_option maxRecDepth 10000 in
theorem hex_flatten : X86Min.Data.sporosStage1Hex = stage1HexChunks.flatten := by
  simp only [stage1HexChunks, X86Min.Data.sporosStage1HexChunks, X86Min.Data.sporosStage1Hex, List.flatten_cons,
    List.flatten_nil, List.append_nil, List.append_assoc]

set_option maxHeartbeats 0 in
theorem chunks_finish :
    hexFinish (runChunks stage1HexChunks (some (false, none, []))) =
      some X86Min.Data.sporosStage1 := by
  decide +kernel

/-- The generated byte list is the `decA` reading of the real
listing.  A direct whole-list `decide +kernel` is too slow in the
kernel; the chunked run above evaluates the same decoder state
machine over the generator's 256-byte chunks. -/
theorem stage1Code_decA :
    X86Min.Formats.decA X86Min.Data.sporosStage1Hex false none [] =
      some stage1Code := by
  rw [← decASt_finish, hex_flatten, ← runChunks_eq]
  exact chunks_finish

