/-
Writes a kernel-checkable proof that one seed run ends as the model says, split
into checkpoint lemmas so that no single declaration makes the kernel hold the
whole run.

  lean --run Bootstrap/GenProof.lean <name> <program> <input> <expected> <chunk>

prints Lean source: the decode table and the entry state as literals; the lemma
that `load` produces them; one lemma `runS im <chunk> sᵢ = .inl sᵢ₊₁` per chunk;
the last chunk, which ends the run; and the theorem about `exec`, assembled with
`run_chain`. Nothing printed here is trusted: the kernel checks every lemma, so a
wrong checkpoint fails the build instead of proving anything. The generator only
saves the search for the checkpoints.

<program>, <input> and <expected> are names of lists in Bootstrap/SeedData.lean;
the theorem states `exec … <program> <input> = .exit 0 <expected>`, so the
generator fails if the run does not end with exit 0 and exactly those bytes.
-/
import Bootstrap.X86Min
import Bootstrap.SeedData
open X86Min X86Min.Data

def dataOf : String → Option (List Nat)
  | "seedA" => some seedA | "seedAHex" => some seedAHex | "seedAOct" => some seedAOct
  | "seedB" => some seedB | "seedBOct" => some seedBOct | "seedBHex" => some seedBHex
  | _ => none

def natList (l : List Nat) : String :=
  -- in chunks, so that the elaborator does not recurse too deeply on a long literal
  let rec go (l : List Nat) (acc : List String) (fuel : Nat) : List String :=
    match fuel with
    | 0 => acc.reverse
    | fuel + 1 =>
      if l.isEmpty then acc.reverse
      else go (l.drop 200) (("[" ++ ", ".intercalate ((l.take 200).map toString) ++ "]") :: acc) fuel
  match go l [] (l.length / 200 + 1) with
  | [] => "[]"
  | parts => "(" ++ " ++ ".intercalate parts ++ ")"

def optNat : Option Nat → String
  | none => "none"
  | some v => s!"(some {v})"

def optBool : Option Bool → String
  | none => "none"
  | some b => s!"(some {b})"

def opName : Op → String
  | .add => "Op.add" | .sub => "Op.sub" | .cmp => "Op.cmp" | .xor => "Op.xor"
  | .or => "Op.or" | .test => "Op.test" | .mov => "Op.mov"

def insStr : Ins → String
  | .movImm d i => s!"Ins.movImm {d} {i}"
  | .rr op w d s => s!"Ins.rr {opName op} {w} {d} {s}"
  | .ri op w d i => s!"Ins.ri {opName op} {w} {d} {i}"
  | .shlI w d c => s!"Ins.shlI {w} {d} {c}"
  | .inc w d => s!"Ins.inc {w} {d}"
  | .push i => s!"Ins.push {i}"
  | .pop d => s!"Ins.pop {d}"
  | .syscall => "Ins.syscall"
  | .jcc cc r => s!"Ins.jcc {cc} {r}"
  | .jmp r => s!"Ins.jmp {r}"
  | .jmpReg r => s!"Ins.jmpReg {r}"
  | .ldRsp8 d => s!"Ins.ldRsp8 {d}"
  | .stRsp8 s => s!"Ins.stRsp8 {s}"

def entryStr : Option (Ins × Nat) → String
  | none => "none"
  | some (i, n) => s!"(some ({insStr i}, {n}))"

def treeStr : Tree (Option (Ins × Nat)) → String
  | .leaf v => s!"(Tree.leaf {entryStr v})"
  | .node l r => s!"(Tree.node {treeStr l} {treeStr r})"

def stStr (s : St) (inpName : String) (consumed : Nat) : String :=
  let regs := "[" ++ ", ".intercalate (s.regs.map optNat) ++ "]"
  let mem := "[" ++ ", ".intercalate (s.mem.map optNat) ++ "]"
  let fl := s!"⟨{optBool s.fl.cf}, {optBool s.fl.zf}, {optBool s.fl.sf}, {optBool s.fl.of}⟩"
  let inp := if consumed == 0 then inpName else s!"({inpName}.drop {consumed})"
  s!"\{ regs := {regs}, rip := {s.rip}, fl := {fl}, mem := {mem}, lo := {s.lo}, inp := {inp}, out := {natList s.out} }"

def outcomeStr : Outcome → String
  | .exit st out => s!"Outcome.exit {st} {natList out}"
  | .stuck r w => s!"Outcome.stuck {r} {w}"
  | .outOfFuel => "Outcome.outOfFuel"

def main (args : List String) : IO UInt32 := do
  let [name, progN, inpN, expN, kS] := args
    | IO.eprintln "usage: GenProof <name> <program> <input> <expected> <chunk>"; return 2
  let some expected := dataOf expN | IO.eprintln s!"unknown list {expN}"; return 2
  let some prog := dataOf progN | IO.eprintln s!"unknown list {progN}"; return 2
  let some inp := dataOf inpN | IO.eprintln s!"unknown list {inpN}"; return 2
  let some k := kS.toNat? | IO.eprintln "chunk must be a number"; return 2
  let some (im, s0) := load prog 0x7ffffffde000 inp | IO.eprintln "load failed"; return 1
  let out ← IO.getStdout
  out.putStrLn s!"/- Generated by `lean --run Bootstrap/GenProof.lean {name} {progN} {inpN} {k}`; do not edit. -/"
  out.putStrLn "import Bootstrap.X86Min\nimport Bootstrap.SeedData\nopen X86Min X86Min.Data\n"
  out.putStrLn s!"namespace X86Min.Proof.{name}\n"
  out.putStrLn s!"def im : Img := ⟨{progN}, {im.vbase}, {im.len},\n  {treeStr im.dec}⟩\n"
  out.putStrLn s!"def s0 : St := {stStr s0 inpN 0}\n"
  out.putStrLn s!"theorem load_eq : load {progN} 0x7ffffffde000 {inpN} = some (im, s0) := by decide +kernel\n"
  let total := inp.length
  let mut s := s0
  let mut i := 0
  let mut fin : Option Outcome := none
  while fin.isNone do
    match runS im k s with
    | .inl t =>
      let consumed := total - t.inp.length
      out.putStrLn s!"def s{i+1} : St := {stStr t inpN consumed}\n"
      out.putStrLn s!"theorem c{i} : runS im {k} s{i} = .inl s{i+1} := by decide +kernel\n"
      s := t
      i := i + 1
    | .inr o =>
      out.putStrLn s!"theorem last : run im {k} s{i} = {outcomeStr o} := by decide +kernel\n"
      fin := some o
  let some o := fin | return 1
  if o != .exit 0 expected then
    IO.eprintln s!"{name}: the run does not end with exit 0 and {expN}"; return 1
  let n := i
  let fuel := k * (n + 1)
  let sum := (List.replicate (n + 1) (toString k)).foldr (fun a acc => if acc == "" then a else s!"{a} + ({acc})") ""
  out.putStrLn s!"end X86Min.Proof.{name}\n\nopen X86Min.Proof.{name} in"
  out.putStrLn s!"theorem X86Min.{name} : exec {fuel} {progN} {inpN} = Outcome.exit 0 {expN} := by"
  out.putStrLn s!"  rw [exec_of_load load_eq, show ({fuel} : Nat) = {sum} from rfl]"
  for j in [0:n] do
    out.putStrLn s!"  rw [run_chain c{j}]"
  out.putStrLn "  rw [last]\n  decide +kernel"
  IO.eprintln s!"{name}: {n + 1} chunks of {k} steps, outcome {match o with | .exit st _ => s!"exit {st}" | _ => "not exit"}"
  return 0
