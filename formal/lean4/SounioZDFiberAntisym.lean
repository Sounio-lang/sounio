    `U = (2^k−1)(2^k−2)`. -/
theorem ordQualOrbit_rec (k : Nat) :
    ordQualOrbit (k+1)
      = 8 * ordQualOrbit k + 18 * ((((2^k:Nat):Int) - 1) * (((2^k:Nat):Int) - 2)) := by
  have hHp : (0:Nat) < 2^k := Nat.two_pow_pos k
  have hpow : (2:Nat)^(k+1) = 2^k + 2^k := by rw [Nat.pow_succ]; omega
  unfold ordQualOrbit
