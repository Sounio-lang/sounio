/-- The twoeq-indicator splits into its three (mutually exclusive) disjuncts. -/
theorem twoeqC_ind (A1 A2 A3 : Nat) :
    (if twoeqC A1 A2 A3 then (1:Int) else 0)
    = (if (A1 = A2 ∧ A1 ≠ 0 ∧ A3 ≠ 0 ∧ A3 ≠ A1) then (1:Int) else 0)
