    intro A1 A3 hA1
    rw [sumLtI_congr (2^k) _ (fun A2 => if A2 = A1 then
          (if (A1 ≠ 0 ∧ A3 ≠ 0 ∧ A3 ≠ A1) then (1:Int) else 0) else 0)
      (fun A2 _ => by
        by_cases h : A2 = A1
        · subst h
