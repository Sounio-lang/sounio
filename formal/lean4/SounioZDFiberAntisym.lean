  rw [sumLtI_congr (2^k) _ _ (fun A1 _ => sumLtI_swap (2^k) (2^k) (fun A2 A3 =>
      if (A1 = A2 ∧ A1 ≠ 0 ∧ A3 ≠ 0 ∧ A3 ≠ A1) then (1:Int) else 0))]
  have hcol : ∀ A1 A3 : Nat, A1 < 2^k →
