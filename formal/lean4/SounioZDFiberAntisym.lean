  | 161, _ => exact ⟨_, _, (LowCob.comp LowCob.trans (LowCob.comp LowCob.cyc (LowCob.comp LowCob.cyc (LowCob.comp LowCob.cyc (LowCob.comp LowCob.trans (LowCob.comp LowCob.cyc LowCob.trans))))))
