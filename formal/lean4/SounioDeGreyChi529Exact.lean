def g529_color (v : Fin 529) : Fin 5 :=
  g529_color_table.getD v.val 0

theorem g529_proper_5colouring :
    ∀ e ∈ g529_edges, ∀ (h1 : e.1 < 529) (h2 : e.2 < 529),
      g529_color ⟨e.1, h1⟩ ≠ g529_color ⟨e.2, h2⟩ := by
  native_decide

theorem g529_not_4colourable :
    ¬ ∃ f : Fin 529 → Fin 4,
        ∀ e ∈ g529_edges, ∀ (h1 : e.1 < 529) (h2 : e.2 < 529),
          f ⟨e.1, h1⟩ ≠ f ⟨e.2, h2⟩ := g529_not_colourable

/- The chromatic number of the de Grey graph G529 is exactly 5. -/
theorem g529_chi_eq_5 :
    (∃ f : Fin 529 → Fin 5,
       ∀ e ∈ g529_edges, ∀ (h1 : e.1 < 529) (h2 : e.2 < 529),
         f ⟨e.1, h1⟩ ≠ f ⟨e.2, h2⟩) ∧
    (¬ ∃ f : Fin 529 → Fin 4,
       ∀ e ∈ g529_edges, ∀ (h1 : e.1 < 529) (h2 : e.2 < 529),
         f ⟨e.1, h1⟩ ≠ f ⟨e.2, h2⟩) :=
  ⟨⟨g529_color, g529_proper_5colouring⟩, g529_not_4colourable⟩

#print axioms g529_chi_eq_5

