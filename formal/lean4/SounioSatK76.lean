/-- The verified LRAT checker accepts souc_sat's certificate (reflective eval). -/
theorem k76_check : check k76_prf k76_cnf = true := by native_decide

/-- Hence the colouring CNF is genuinely unsatisfiable — machine-checked in Lean. -/
theorem k76_unsat : k76_cnf.Unsat :=
  check_sound k76_prf k76_cnf k76_check

/-- **Chromatic corollary.** The graph admits no proper 6-colouring
`Fin 7 → Fin 6` (i.e. its chromatic number is ≥ 7). -/
theorem k76_not_colourable :
    ¬ ∃ c : Fin 7 → Fin 6,
        ∀ e ∈ k76_edges, ∀ (h1 : e.1 < 7) (h2 : e.2 < 7), c ⟨e.1, h1⟩ ≠ c ⟨e.2, h2⟩ :=
  not_colourable_of_unsat (by decide) (by decide) k76_unsat

#print axioms k76_not_colourable
