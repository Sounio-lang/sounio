// Sprint 44 supplemental: Z values at certification window boundaries

module main

use pbpk::rapamycin_assay::{as_trough_mg_l}
use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

fn zf(d: f64, n: i64, ke: f64, f: f64,
      ka_v: f64, fv: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> f64
    with Mut, Div, Panic {
    let c  = as_trough_mg_l(d, n, ke, f)
    let uc = eu_u_c(d, n, ke, f, ka_v, fv, ke_v, k12_v, k21_v)
    (c - trough_floor_mg_l()) / uc
}
fn zc(d: f64, n: i64, ke: f64, f: f64,
      ka_v: f64, fv: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> f64
    with Mut, Div, Panic {
    let c  = as_trough_mg_l(d, n, ke, f)
    let uc = eu_u_c(d, n, ke, f, ka_v, fv, ke_v, k12_v, k21_v)
    (trough_ceil_mg_l() - c) / uc
}

fn main() with Mut, Div, Panic, IO {
    let ka  = ob_ka_var_std()
    let fv  = ob_f_var_std()
    let ke  = ob_ke_var_std()
    let k12 = ob_k12_var_std()
    let k21 = ob_k21_var_std()
    let ke_inh = ob_ke_var_inh()

    print("=== std D=5mg window boundary (N_last_cert=36) ===\n")
    print("std N=34: zf="); print_f64(zf(5.0,34,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,34,0.01118,0.141,ka,fv,ke,k12,k21)); print("\n")
    print("std N=35: zf="); print_f64(zf(5.0,35,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,35,0.01118,0.141,ka,fv,ke,k12,k21)); print("\n")
    print("std N=36: zf="); print_f64(zf(5.0,36,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,36,0.01118,0.141,ka,fv,ke,k12,k21)); print("\n")
    print("std N=37: zf="); print_f64(zf(5.0,37,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,37,0.01118,0.141,ka,fv,ke,k12,k21)); print("\n")
    print("std N=38: zf="); print_f64(zf(5.0,38,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,38,0.01118,0.141,ka,fv,ke,k12,k21)); print("\n")

    print("\n=== slow D=5mg window boundary (N_last_cert=18) ===\n")
    print("slow N=17: zf="); print_f64(zf(5.0,17,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,17,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")
    print("slow N=18: zf="); print_f64(zf(5.0,18,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,18,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")
    print("slow N=19: zf="); print_f64(zf(5.0,19,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,19,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")

    print("\n=== inh D=1.5mg window boundary (N_last_cert=37) ===\n")
    print("inh N=35: zf="); print_f64(zf(1.5,35,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" zc="); print_f64(zc(1.5,35,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")
    print("inh N=36: zf="); print_f64(zf(1.5,36,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" zc="); print_f64(zc(1.5,36,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")
    print("inh N=37: zf="); print_f64(zf(1.5,37,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" zc="); print_f64(zc(1.5,37,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")
    print("inh N=38: zf="); print_f64(zf(1.5,38,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" zc="); print_f64(zc(1.5,38,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")
    print("inh N=39: zf="); print_f64(zf(1.5,39,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" zc="); print_f64(zc(1.5,39,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")

    print("\n=== fast at SS (N=60): zf/zc for ceiling-safe confirmation ===\n")
    print("fast N=50: zf="); print_f64(zf(5.0,50,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,50,0.01677,0.094,ka,fv,ke,k12,k21)); print("\n")
    print("fast N=60: zf="); print_f64(zf(5.0,60,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,60,0.01677,0.094,ka,fv,ke,k12,k21)); print("\n")

    print("\n=== ind steady-state zf/zc ===\n")
    let ke_ind = ob_ke_var_ind()
    print("ind N=60: zf="); print_f64(zf(34.0,60,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" zc="); print_f64(zc(34.0,60,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")
}
