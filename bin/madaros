#!/usr/bin/env bash
# bin/madaros — launcher for the Madaros modular compiler raw ELF.
#
# Madaros is the Stage1 self-hosted compiler built from
# self-hosted/compiler/main.sio. It is distinct from the Stage0 bootstrap
# compiler (lean_single.sio) which is exposed as bin/souc.
#
# The raw modular compiler exposes backend-specific modes. This launcher adds a
# small stable CLI for normal use and still passes raw modes through unchanged.
#
# Usage:
#   madaros --version
#   madaros info
#   madaros check input.sio
#   madaros build input.sio [-o OUT] [--backend native|gpu]
#   madaros run input.sio
#   madaros s1-receipt input.sio [--out-dir OUT]
#   madaros s3-receipt input.sio [--out-dir OUT]
#   madaros s4-receipt input.sio [--out-dir OUT]
#   madaros pkg ...
#
# Environment:
#   SOUNIO_STDLIB_PATH     — forwarded to the raw ELF unchanged
#   MADAROS_RAW_BIN        — override the underlying modular raw ELF
#   SOUNIO_MADAROS_BIN     — alias for MADAROS_RAW_BIN
#
# To obtain the raw ELF, run:
#   make build-madaros

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Resolve the underlying modular raw ELF.
# Resolution order:
#   1. MADAROS_RAW_BIN / SOUNIO_MADAROS_BIN env var
#   2. artifacts/self-hosted/madaros, only with a matching .gate-receipt
#      proving the SMT gate was not skipped
#   3. bin/madaros-relocgate (verified-green fallback)
#   4. bin/madaros-linux-x86_64 (checked-in prebuilt)
_is_modular_elf() {
  [[ -n "${1:-}" && -x "$1" && "$(head -c 2 "$1" 2>/dev/null)" != "#!" ]]
}

_madaros_receipt_ok() {
  local elf="$1"
  local receipt="$elf.gate-receipt"
  [[ -f "$receipt" ]] || return 1
  local want
  want="$(sha256sum "$elf" 2>/dev/null | cut -d' ' -f1)"
  [[ -n "$want" ]] || return 1
  grep -Fq "$want" "$receipt" || return 1
  grep -Fxq "smt_skip=0" "$receipt"
}

_resolve_modular_elf() {
  local cand
  for cand in "${MADAROS_RAW_BIN:-}" "${SOUNIO_MADAROS_BIN:-}"; do
    if _is_modular_elf "$cand"; then
      echo "$cand"
      return 0
    fi
  done

  local artifact="$ROOT_DIR/artifacts/self-hosted/madaros"
  if _is_modular_elf "$artifact"; then
    if _madaros_receipt_ok "$artifact"; then
      echo "$artifact"
      return 0
    fi
    echo "warning: using ungated $artifact skipped; export MADAROS_RAW_BIN=$ROOT_DIR/bin/madaros-relocgate for the verified-green binary" >&2
  fi

  for cand in "$ROOT_DIR/bin/madaros-relocgate" "$ROOT_DIR/bin/madaros-linux-x86_64"; do
    if _is_modular_elf "$cand"; then
      echo "$cand"
      return 0
    fi
  done

  echo "error: madaros: no modular compiler raw ELF found" >&2
  echo "  tried: MADAROS_RAW_BIN, SOUNIO_MADAROS_BIN, $artifact (receipt-gated), $ROOT_DIR/bin/madaros-relocgate, $ROOT_DIR/bin/madaros-linux-x86_64" >&2
  echo "  run: make build-madaros" >&2
  return 1
}

if ! RAW_MADAROS="$(_resolve_modular_elf)"; then
  exit 127
fi

# Madaros rebuilt after IR_MAX_INSTRS=512 uses compiler frames that can exceed
# the default 8 MB thread stack. Lift the limit so the compiler does not segfault
# while compiling normal user programs. This is a conservative runtime guard; it
# does not change compiler semantics.
ulimit -s unlimited 2>/dev/null || true

usage() {
  cat <<USAGE
madaros — launcher for the Madaros modular compiler ($RAW_MADAROS)

Usage:
  madaros --version                     print compiler identity
  madaros info                          print resolution path
  madaros check <source.sio|project-dir>
                                      parse, resolve and typecheck
  madaros build <source.sio|project-dir> [-o OUT] [--backend native|gpu]
                                      compile source to native ELF or GPU artifact
  madaros compile <source.sio|project-dir> [-o OUT]
                                      alias for build
  madaros run <source.sio|project-dir>
                                      compile to a temp ELF and run it
  madaros s1-receipt <source.sio|project-dir> [--out-dir OUT]
                                      emit Madaros v2 S1 JSON+TSV receipt
  madaros s2-receipt <source.sio|project-dir> [--out-dir OUT]
                                      emit Madaros v2 S2 contract scaffold receipt
  madaros s3-receipt <source.sio|project-dir> [--out-dir OUT]
                                      emit Madaros v2 S3 compiler-native HLIR receipt
  madaros s4-receipt <source.sio|project-dir> [--out-dir OUT]
                                      emit Madaros v2 S4 e-graph/E-KAN rewrite receipt
  madaros s5-receipt <source.sio|project-dir> [--out-dir OUT] [--expected-exit N] [--case-id ID]
                                      emit Madaros v2 S5 scalar MIR/ABI receipt
  madaros pkg <subcommand>...           package-manager commands
  madaros <raw-compiler-args>...        pass through to the raw ELF

Common modular-compiler modes:
  madaros --check <source.sio>          raw check mode
  madaros --native-v2-compile SRC OUT   raw source-to-ELF native-v2 path
  madaros --native-v2-emit13            emit artifacts/omega/emit13.elf
  madaros --native-v2-emit-scalar N     emit a scalar witness
  madaros --version-json                emit version metadata
  madaros pkg ...                       package manager commands

GPU build options:
  --backend gpu                         emit PTX via the public GPU build path
  --gpu-target <target>                 raw GPU target (default: cuda-sm80)
  --gpu-binary-format <fmt>             raw GPU format/mode selector
  --gpu-precision <f32|f64>             compatibility alias for GPU mode

Environment:
  SOUNIO_STDLIB_PATH=<dir>     forwarded to raw ELF
  MADAROS_RAW_BIN=<path>       override raw ELF
  SOUNIO_MADAROS_BIN=<path>    override raw ELF (alias)
USAGE
}

info() {
  echo "wrapper:      $0"
  echo "raw_elf:      $RAW_MADAROS"
  echo "stdlib:       ${SOUNIO_STDLIB_PATH:-<unset>}"
  local identity
  identity="$("$RAW_MADAROS" /dev/null /dev/null 2>/dev/null)" || true
  echo "identity:     $(echo "$identity" | head -n 1)"
}

version() {
  local out
  out="$("$RAW_MADAROS" /dev/null /dev/null 2>/dev/null)" || true
  echo "$out" | head -n 1
}

find_project_root() {
  local start="${1:-$PWD}"
  if [[ -f "$start" ]]; then
    start="$(dirname "$start")"
  fi
  if [[ -d "$start" ]]; then
    start="$(cd "$start" && pwd)"
  else
    return 1
  fi
  while [[ "$start" != "/" ]]; do
    if [[ -f "$start/sounio.toml" ]]; then
      printf '%s\n' "$start"
      return 0
    fi
    start="$(dirname "$start")"
  done
  return 1
}

project_manifest_value() {
  local root="$1"
  local key="$2"
  python3 - "$root/sounio.toml" "$key" <<'PY'
import sys
try:
    import tomllib
except ModuleNotFoundError:
    raise SystemExit(3)
path, key = sys.argv[1], sys.argv[2]
text = open(path, "rb").read().decode("utf-8")
data = tomllib.loads(text)
if key == "package.name":
    print(data.get("package", {}).get("name", "sounio-project"))
elif key == "entry":
    bins = data.get("bin", [])
    if isinstance(bins, list) and bins:
        value = bins[0].get("path", "")
        if value:
            print(value)
            raise SystemExit(0)
    value = data.get("project", {}).get("entry", "")
    if value:
        print(value)
        raise SystemExit(0)
    value = data.get("lib", {}).get("path", "")
    if value and "[[bin]]" not in text:
        print(value)
        raise SystemExit(0)
    print("src/main.sio")
else:
    raise SystemExit(2)
PY
}

resolve_source_or_project() {
  local candidate="${1:-}"
  if [[ -n "$candidate" && -f "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  local root=""
  if [[ -n "$candidate" && -d "$candidate" ]]; then
    root="$(find_project_root "$candidate" || true)"
  else
    root="$(find_project_root "$PWD" || true)"
  fi
  if [[ -z "$root" ]]; then
    return 1
  fi

  local entry
  entry="$(project_manifest_value "$root" entry)"
  if [[ ! -f "$root/$entry" ]]; then
    echo "error: project entry not found: $root/$entry" >&2
    return 1
  fi
  printf '%s\n' "$root/$entry"
}

project_default_output() {
  local root="$1"
  local name
  name="$(project_manifest_value "$root" package.name)"
  mkdir -p "$root/target"
  printf '%s\n' "$root/target/$name"
}

args_have_output() {
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "-o" || "$arg" == "--output" ]]; then
      return 0
    fi
  done
  return 1
}

_check_source_arg() {
  local src="$1"
  if [[ ! -e "$src" ]]; then
    echo "error: at $src:0:0 - could not read input file" >&2
    return 1
  fi
}

_run_raw_check() {
  local src="$1"
  shift
  _check_source_arg "$src"
  if [[ ! -s "$src" ]]; then
    local tmp_empty
    tmp_empty="$(mktemp "${TMPDIR:-/tmp}/madaros-empty-check.XXXXXX.sio")"
    printf '\n' > "$tmp_empty"
    "$RAW_MADAROS" --check "$tmp_empty" "$@"
    local rc=$?
    rm -f "$tmp_empty"
    return "$rc"
  fi
  # Guard: 8 GB vmem + 120 s timeout
  ( ulimit -v 8388608 2>/dev/null || true; exec timeout 120 "$RAW_MADAROS" --check "$src" "$@" )
}

_parse_build_options() {
  BUILD_OUT="a.out"
  BUILD_BACKEND="native"
  BUILD_GPU_TARGET="cuda-sm80"
  BUILD_GPU_BINARY_FORMAT=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--output)
        if [[ $# -lt 2 ]]; then
          echo "error: madaros build: $1 requires a path" >&2
          return 2
        fi
        BUILD_OUT="$2"
        shift 2
        ;;
      --backend)
        if [[ $# -lt 2 ]]; then
          echo "error: madaros build: --backend requires native or gpu" >&2
          return 2
        fi
        BUILD_BACKEND="$2"
        shift 2
        ;;
      --gpu-target)
        if [[ $# -lt 2 ]]; then
          echo "error: madaros build: --gpu-target requires a target" >&2
          return 2
        fi
        BUILD_GPU_TARGET="$2"
        shift 2
        ;;
      --gpu-binary-format)
        if [[ $# -lt 2 ]]; then
          echo "error: madaros build: --gpu-binary-format requires a format" >&2
          return 2
        fi
        BUILD_GPU_BINARY_FORMAT="$2"
        shift 2
        ;;
      --gpu-precision)
        if [[ $# -lt 2 ]]; then
          echo "error: madaros build: --gpu-precision requires f32 or f64" >&2
          return 2
        fi
        case "$2" in
          f32) BUILD_GPU_BINARY_FORMAT="f32" ;;
          f64) BUILD_GPU_BINARY_FORMAT="" ;;
          *)
            echo "error: madaros build: unsupported --gpu-precision: $2" >&2
            return 2
            ;;
        esac
        shift 2
        ;;
      *)
        echo "error: madaros build: unsupported option: $1" >&2
        return 2
        ;;
    esac
  done
  case "$BUILD_BACKEND" in
    native|"") BUILD_BACKEND="native" ;;
    gpu) ;;
    *)
      echo "error: madaros build: unsupported backend: $BUILD_BACKEND" >&2
      return 2
      ;;
  esac
}

_build_source() {
  local src="$1"
  shift
  _check_source_arg "$src"
  if [[ ! -s "$src" ]]; then
    echo "error: madaros build: source is empty: $src" >&2
    return 1
  fi
  _parse_build_options "$@"
  local out="$BUILD_OUT"
  mkdir -p "$(dirname "$out")"
  rm -f "$out"
  if [[ "$BUILD_BACKEND" == "gpu" ]]; then
    local gpu_args=("$src" -o "$out" --gpu-target "$BUILD_GPU_TARGET")
    if [[ -n "$BUILD_GPU_BINARY_FORMAT" ]]; then
      gpu_args+=(--gpu-binary-format "$BUILD_GPU_BINARY_FORMAT")
    fi
    # Guard: 16 GB vmem + 300 s timeout
    ( ulimit -v 16777216 2>/dev/null || true; exec timeout 300 "$RAW_MADAROS" "${gpu_args[@]}" )
    if [[ ! -s "$out" ]]; then
      echo "error: madaros build: compiler produced no GPU artifact at $out" >&2
      return 1
    fi
    return 0
  fi
  # Guard: 16 GB vmem + 300 s timeout
  ( ulimit -v 16777216 2>/dev/null || true; exec timeout 300 "$RAW_MADAROS" "$src" -o "$out" )
  if [[ ! -s "$out" ]]; then
    echo "error: madaros build: compiler produced no ELF at $out" >&2
    return 1
  fi
  chmod +x "$out"
}

_run_source() {
  local src="$1"
  shift
  local tmp_dir out
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/madaros-run.XXXXXX")"
  out="$tmp_dir/main.elf"
  _build_source "$src" -o "$out"
  "$out" "$@"
  local rc=$?
  rm -rf "$tmp_dir"
  return "$rc"
}

_emit_s1_receipt() {
  local src="$1"
  shift
  local out_dir=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --out-dir|-o)
        if [[ $# -lt 2 ]]; then
          echo "error: madaros s1-receipt: $1 requires a directory" >&2
          return 2
        fi
        out_dir="$2"
        shift 2
        ;;
      *)
        echo "error: madaros s1-receipt: unsupported option: $1" >&2
        return 2
        ;;
    esac
  done
  if [[ -z "$out_dir" ]]; then
    out_dir="${TMPDIR:-/tmp}/madaros-v2-s1-receipts"
  fi
  python3 "$ROOT_DIR/scripts/dev/madaros_v2_s1_receipt.py" emit \
    --source "$src" \
    --out-dir "$out_dir" \
    --compiler "$0" \
    --compiler-route-kind "madaros-wrapper" \
    --parser-sha "$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
}

_emit_s2_receipt() {
  local src="$1"
  shift
  local out_dir=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --out-dir|-o)
        if [[ $# -lt 2 ]]; then
          echo "error: madaros s2-receipt: $1 requires a directory" >&2
          return 2
        fi
        out_dir="$2"
        shift 2
        ;;
      *)
        echo "error: madaros s2-receipt: unsupported option: $1" >&2
        return 2
        ;;
    esac
  done
  if [[ -z "$out_dir" ]]; then
    out_dir="${TMPDIR:-/tmp}/madaros-v2-s2-receipts"
  fi
  python3 "$ROOT_DIR/scripts/dev/madaros_v2_s2_receipt.py" emit \
    --source "$src" \
    --out-dir "$out_dir" \
    --compiler "$0" \
    --compiler-route-kind "madaros-wrapper" \
    --parser-sha "$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
}

_emit_s3_receipt() {
  local src="$1"
  shift
  local out_dir=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --out-dir|-o)
        if [[ $# -lt 2 ]]; then
          echo "error: madaros s3-receipt: $1 requires a directory" >&2
          return 2
        fi
        out_dir="$2"
        shift 2
        ;;
      *)
        echo "error: madaros s3-receipt: unsupported option: $1" >&2
        return 2
        ;;
    esac
  done
  if [[ -z "$out_dir" ]]; then
    out_dir="${TMPDIR:-/tmp}/madaros-v2-s3-receipts"
  fi
  python3 "$ROOT_DIR/scripts/dev/madaros_v2_s3_receipt.py" emit \
    --source "$src" \
    --out-dir "$out_dir" \
    --compiler "$0" \
    --compiler-route-kind "madaros-wrapper" \
    --parser-sha "$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
}

_emit_s4_receipt() {
  local src="$1"
  shift
  local out_dir=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --out-dir|-o)
        if [[ $# -lt 2 ]]; then
          echo "error: madaros s4-receipt: $1 requires a directory" >&2
          return 2
        fi
        out_dir="$2"
        shift 2
        ;;
      *)
        echo "error: madaros s4-receipt: unsupported option: $1" >&2
        return 2
        ;;
    esac
  done
  if [[ -z "$out_dir" ]]; then
    out_dir="${TMPDIR:-/tmp}/madaros-v2-s4-receipts"
  fi
  python3 "$ROOT_DIR/scripts/dev/madaros_v2_s4_receipt.py" emit \
    --source "$src" \
    --out-dir "$out_dir" \
    --compiler "$0"
}

_emit_s5_receipt() {
  local src="$1"
  shift
  local out_dir=""
  local expected_exit=""
  local case_id=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --out-dir|-o)
        if [[ $# -lt 2 ]]; then
          echo "error: madaros s5-receipt: $1 requires a directory" >&2
          return 2
        fi
        out_dir="$2"
        shift 2
        ;;
      --expected-exit)
        if [[ $# -lt 2 ]]; then
          echo "error: madaros s5-receipt: $1 requires an integer" >&2
          return 2
        fi
        expected_exit="$2"
        shift 2
        ;;
      --case-id)
        if [[ $# -lt 2 ]]; then
          echo "error: madaros s5-receipt: $1 requires an identifier" >&2
          return 2
        fi
        case_id="$2"
        shift 2
        ;;
      *)
        echo "error: madaros s5-receipt: unsupported option: $1" >&2
        return 2
        ;;
    esac
  done
  if [[ -z "$out_dir" ]]; then
    out_dir="${TMPDIR:-/tmp}/madaros-v2-s5-receipts"
  fi
  local cmd=(
    python3 "$ROOT_DIR/scripts/dev/madaros_v2_s5_receipt.py" emit
    --source "$src"
    --out-dir "$out_dir"
    --compiler "$0"
    --compiler-route-kind "madaros-wrapper"
    --parser-sha "$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  )
  if [[ -n "$expected_exit" ]]; then
    cmd+=(--expected-exit "$expected_exit")
  fi
  if [[ -n "$case_id" ]]; then
    cmd+=(--case-id "$case_id")
  fi
  "${cmd[@]}"
}

# Parse subcommands.
if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

case "$1" in
  --version|-V)
    version
    ;;
  info)
    info
    ;;
  check)
    shift
    candidate="${1:-}"
    if ! src="$(resolve_source_or_project "$candidate")"; then
      echo "error: madaros check requires <source.sio> or a project with sounio.toml" >&2
      exit 2
    fi
    if [[ -n "$candidate" ]]; then
      shift
    fi
    _run_raw_check "$src" "$@"
    ;;
  build|compile)
    shift
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
      usage
      exit 0
    fi
    candidate="${1:-}"
    if [[ -n "$candidate" && "$candidate" != -* ]]; then
      shift
    else
      candidate=""
    fi
    if ! src="$(resolve_source_or_project "$candidate")"; then
      echo "error: madaros build requires <source.sio> or a project with sounio.toml" >&2
      exit 2
    fi
    project_root=""
    if [[ -z "$candidate" || -d "$candidate" ]]; then
      project_root="$(find_project_root "${candidate:-$PWD}" || true)"
    fi
    if [[ -n "$project_root" ]] && ! args_have_output "$@"; then
      set -- "$@" -o "$(project_default_output "$project_root")"
    fi
    _build_source "$src" "$@"
    ;;
  run)
    shift
    candidate="${1:-}"
    if ! src="$(resolve_source_or_project "$candidate")"; then
      echo "error: madaros run requires <source.sio> or a project with sounio.toml" >&2
      exit 2
    fi
    if [[ -n "$candidate" ]]; then
      shift
    fi
    _run_source "$src" "$@"
    ;;
  s1-receipt)
    shift
    candidate="${1:-}"
    if ! src="$(resolve_source_or_project "$candidate")"; then
      echo "error: madaros s1-receipt requires <source.sio> or a project with sounio.toml" >&2
      exit 2
    fi
    if [[ -n "$candidate" ]]; then
      shift
    fi
    _emit_s1_receipt "$src" "$@"
    ;;
  s2-receipt)
    shift
    candidate="${1:-}"
    if ! src="$(resolve_source_or_project "$candidate")"; then
      echo "error: madaros s2-receipt requires <source.sio> or a project with sounio.toml" >&2
      exit 2
    fi
    if [[ -n "$candidate" ]]; then
      shift
    fi
    _emit_s2_receipt "$src" "$@"
    ;;
  s3-receipt)
    shift
    candidate="${1:-}"
    if ! src="$(resolve_source_or_project "$candidate")"; then
      echo "error: madaros s3-receipt requires <source.sio> or a project with sounio.toml" >&2
      exit 2
    fi
    if [[ -n "$candidate" ]]; then
      shift
    fi
    _emit_s3_receipt "$src" "$@"
    ;;
  s4-receipt)
    shift
    candidate="${1:-}"
    if ! src="$(resolve_source_or_project "$candidate")"; then
      echo "error: madaros s4-receipt requires <source.sio> or a project with sounio.toml" >&2
      exit 2
    fi
    if [[ -n "$candidate" ]]; then
      shift
    fi
    _emit_s4_receipt "$src" "$@"
    ;;
  s5-receipt)
    shift
    candidate="${1:-}"
    if ! src="$(resolve_source_or_project "$candidate")"; then
      echo "error: madaros s5-receipt requires <source.sio> or a project with sounio.toml" >&2
      exit 2
    fi
    if [[ -n "$candidate" ]]; then
      shift
    fi
    _emit_s5_receipt "$src" "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    if [[ "$1" == "--check" && $# -ge 2 ]]; then
      _run_raw_check "$2" "${@:3}"
      exit $?
    fi
    # Pass everything through to the raw ELF unchanged (guarded).
    ( ulimit -v 16777216 2>/dev/null || true; exec timeout 300 "$RAW_MADAROS" "$@" )
    ;;
esac
