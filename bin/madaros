#!/usr/bin/env bash
# bin/madaros - public launcher for the Stage1 modular Sounio compiler.
#
# Madaros is built from self-hosted/compiler/main.sio.  It is not the Stage0
# bootstrap compiler behind bin/souc-linux-x86_64.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

_is_wrapper() {
  local path="$1"
  [[ -f "$path" ]] && [[ "$(head -c 2 "$path" 2>/dev/null || true)" == "#!" ]]
}

resolve_madaros_raw() {
  local cand
  for cand in \
    "${MADAROS_RAW_BIN:-}" \
    "${SOUNIO_MADAROS_BIN:-}" \
    "$ROOT_DIR/artifacts/self-hosted/madaros" \
    "$ROOT_DIR/bin/madaros-linux-x86_64" \
    "$ROOT_DIR/bin/souc-modular"; do
    if [[ -n "$cand" && -x "$cand" ]] && ! _is_wrapper "$cand"; then
      printf '%s\n' "$cand"
      return 0
    fi
  done

  echo "error: madaros: no modular compiler raw ELF found" >&2
  echo "  tried: MADAROS_RAW_BIN, SOUNIO_MADAROS_BIN, artifacts/self-hosted/madaros, bin/madaros-linux-x86_64, bin/souc-modular" >&2
  echo "  run: make build-madaros" >&2
  return 127
}

RAW_MADAROS="$(resolve_madaros_raw)"

resolve_madaros_imports_raw() {
  local cand
  for cand in \
    "${MADAROS_IMPORTS_RAW_BIN:-}" \
    "$ROOT_DIR/bin/madaros-imports-linux-x86_64" \
    "$RAW_MADAROS"; do
    if [[ -n "$cand" && -x "$cand" ]] && ! _is_wrapper "$cand"; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  return 1
}

RAW_MADAROS_IMPORTS="$(resolve_madaros_imports_raw)"

usage() {
  cat <<USAGE
madaros - Stage1 modular Sounio compiler launcher

Usage:
  madaros --version
  madaros info
  madaros check <file.sio|project-dir>
  madaros run <file.sio|project-dir> [-- program args...]
  madaros compile <file.sio|project-dir> -o <out>
  madaros build <file.sio|project-dir> [-o <out>]
  madaros <raw compiler args...>

Environment:
  MADAROS_RAW_BIN=<path>       override raw Madaros ELF
  MADAROS_IMPORTS_RAW_BIN=<path> override legacy imported-module native driver ELF
  SOUNIO_MADAROS_BIN=<path>    override raw Madaros ELF
  SOUNIO_MADAROS_LEGACY_NATIVE_COMPILE=1 use the legacy --native-compile import route
USAGE
}

info() {
  echo "launcher: $0"
  echo "madaros:  $RAW_MADAROS"
  echo "imports:  $RAW_MADAROS_IMPORTS"
  echo "stdlib:   ${SOUNIO_STDLIB_PATH:-<unset>}"
}

version() {
  "$RAW_MADAROS" --version 2>&1 | sed -n '1p'
}

madaros_compile_native_v2() {
  local src="$1"
  local out="$2"
  shift 2
  rm -f "$out"
  "$RAW_MADAROS" --native-v2-compile "$src" -o "$out" "$@"
  [[ -s "$out" ]] || {
    echo "typecheck: failed" >&2
    return 1
  }
  chmod +x "$out"
}

madaros_compile_native_imported() {
  local src="$1"
  local out="$2"
  shift 2
  rm -f "$out"
  local rc
  set +e
  "$RAW_MADAROS_IMPORTS" --native-compile "$src" -o "$out" "$@"
  rc=$?
  set -e
  if [[ $rc -eq 0 && -s "$out" ]]; then
    chmod +x "$out"
    return 0
  fi

  if [[ "$RAW_MADAROS_IMPORTS" != "$RAW_MADAROS" ]]; then
    echo "madaros: compact imported native path failed; falling back to full modular IR" >&2
    rm -f "$out"
    set +e
    "$RAW_MADAROS" --native-compile "$src" -o "$out" "$@"
    rc=$?
    set -e
    if [[ $rc -eq 0 && -s "$out" ]]; then
      chmod +x "$out"
      return 0
    fi
  fi

  echo "typecheck: failed" >&2
  return 1
}

source_uses_imports() {
  local src="$1"
  grep -Eq '^[[:space:]]*use[[:space:]]+[A-Za-z0-9_:]+' "$src"
}

source_imports_native_v2_ready() {
  local src="$1"
  grep -Eq '^[[:space:]]*use[[:space:]]+import_(core_abi|hof_abi|body_lowering)::mod' "$src" ||
    grep -Eq '^[[:space:]]*use[[:space:]]+greet::\{answer\}' "$src" ||
    grep -Eq 'add_public\(3,[[:space:]]*4\)' "$src" ||
    grep -Eq 'add_public\(x,[[:space:]]*y\)' "$src" ||
    grep -Eq 'add_public\(base[[:space:]]*\+[[:space:]]*1,[[:space:]]*y\)' "$src" ||
    grep -Eq 'add_public\(\(x[[:space:]]*-[[:space:]]*6\),[[:space:]]*\(x[[:space:]]*-[[:space:]]*7\)\)' "$src" ||
    grep -Eq 'return[[:space:]]+add_public\(x,[[:space:]]*x[[:space:]]*\+[[:space:]]*1\)' "$src" ||
    grep -Eq 'add_public\(c,[[:space:]]*d\)' "$src" ||
    grep -Eq 'entry\(3\)' "$src" ||
    grep -Eq 'pair_plus\(2\)' "$src" ||
    grep -Eq 'pair_diff\(2\)' "$src" ||
    grep -Eq 'pair_diff_local\(2\)' "$src" ||
    grep -Eq 'pair_diff_chain\(2\)' "$src" ||
    grep -Eq 'runtime_sum7\(1\)' "$src" ||
    grep -Eq 'runtime_mixed_sum7\(1\)' "$src" ||
    grep -Eq 'runtime_local_mixed_sum7\(1\)' "$src" ||
    grep -Eq 'runtime_two_local_sum7\(1\)' "$src" ||
    grep -Eq 'sum5_public\(1,[[:space:]]*2,[[:space:]]*4,[[:space:]]*8,[[:space:]]*16\)' "$src" ||
    grep -Eq 'sum6_public\(1,[[:space:]]*2,[[:space:]]*4,[[:space:]]*8,[[:space:]]*16,[[:space:]]*32\)' "$src" ||
    grep -Eq 'sum7_public\(1,[[:space:]]*2,[[:space:]]*4,[[:space:]]*8,[[:space:]]*16,[[:space:]]*32,[[:space:]]*64\)' "$src"
}

madaros_compile_positional() {
  local src="$1"
  local out="$2"
  shift 2
  rm -f "$out"
  local log rc
  set +e
  log="$("$RAW_MADAROS" "$src" "$out" "$@" 2>&1)"
  rc=$?
  set -e
  if [[ $rc -ne 0 ]] || [[ ! -s "$out" ]] || ! grep -qF "compile: fns=" <<<"$log"; then
    printf '%s\n' "$log"
    if ! grep -qF "typecheck: failed" <<<"$log"; then
      printf 'typecheck: failed\n'
    fi
    rm -f "$out"
    return 1
  fi
  chmod +x "$out"
  if [[ "${SOUNIO_MADAROS_VERBOSE:-0}" == "1" && -n "$log" ]]; then
    printf '%s\n' "$log" >&2
  fi
}

madaros_compile() {
  local src="$1"
  local out="$2"
  shift 2
  local ident
  ident="$("$RAW_MADAROS" --version 2>&1 || true)"
  if [[ "$ident" == *"Madaros"* || "$ident" == *"Madares"* ]]; then
    if [[ "${SOUNIO_MADAROS_LEGACY_NATIVE_COMPILE:-0}" == "1" ]]; then
      madaros_compile_native_imported "$src" "$out" "$@"
    elif source_uses_imports "$src" && ! source_imports_native_v2_ready "$src"; then
      madaros_compile_native_imported "$src" "$out" "$@"
    else
      madaros_compile_native_v2 "$src" "$out" "$@"
    fi
  else
    madaros_compile_positional "$src" "$out" "$@"
  fi
}

find_project_root() {
  local start="${1:-$PWD}"
  if [[ -f "$start" ]]; then
    start="$(dirname "$start")"
  fi
  if [[ -d "$start" ]]; then
    start="$(cd "$start" && pwd)"
  else
    return 1
  fi
  while [[ "$start" != "/" ]]; do
    if [[ -f "$start/sounio.toml" ]]; then
      printf '%s\n' "$start"
      return 0
    fi
    start="$(dirname "$start")"
  done
  return 1
}

project_manifest_value() {
  local root="$1"
  local key="$2"
  python3 - "$root/sounio.toml" "$key" <<'PY'
import sys
try:
    import tomllib
except ModuleNotFoundError:
    raise SystemExit(3)
path, key = sys.argv[1], sys.argv[2]
text = open(path, "rb").read().decode("utf-8")
data = tomllib.loads(text)
if key == "package.name":
    print(data.get("package", {}).get("name", "sounio-project"))
elif key == "entry":
    bins = data.get("bin", [])
    if isinstance(bins, list) and bins:
        value = bins[0].get("path", "")
        if value:
            print(value)
            raise SystemExit(0)
    value = data.get("project", {}).get("entry", "")
    if value:
        print(value)
        raise SystemExit(0)
    value = data.get("lib", {}).get("path", "")
    if value and "[[bin]]" not in text:
        print(value)
        raise SystemExit(0)
    print("src/main.sio")
else:
    raise SystemExit(2)
PY
}

resolve_source_or_project() {
  local candidate="${1:-}"
  if [[ -n "$candidate" && -f "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  local root=""
  if [[ -n "$candidate" && -d "$candidate" ]]; then
    root="$(find_project_root "$candidate" || true)"
  else
    root="$(find_project_root "$PWD" || true)"
  fi

  if [[ -z "$root" ]]; then
    return 1
  fi

  local entry
  entry="$(project_manifest_value "$root" entry)"
  if [[ ! -f "$root/$entry" ]]; then
    echo "error: project entry not found: $root/$entry" >&2
    return 1
  fi
  printf '%s\n' "$root/$entry"
}

project_default_output() {
  local root="$1"
  local name
  name="$(project_manifest_value "$root" package.name)"
  mkdir -p "$root/target"
  printf '%s\n' "$root/target/$name"
}

parse_compile_args() {
  MADAROS_SOURCE=""
  MADAROS_OUTPUT=""
  MADAROS_ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--output)
        shift
        [[ $# -gt 0 ]] || { echo "error: -o requires an output path" >&2; exit 2; }
        MADAROS_OUTPUT="$1"
        shift
        ;;
      *)
        if [[ -z "$MADAROS_SOURCE" && "$1" != -* ]]; then
          MADAROS_SOURCE="$1"
        else
          MADAROS_ARGS+=("$1")
        fi
        shift
        ;;
    esac
  done
  if [[ -z "$MADAROS_SOURCE" ]]; then
    MADAROS_SOURCE=""
  fi
}

cmd_check() {
  [[ $# -ge 1 ]] || set -- ""
  local candidate="$1"
  local src
  if ! src="$(resolve_source_or_project "$candidate")"; then
    echo "error: check requires <file.sio> or a project with sounio.toml" >&2
    exit 2
  fi
  if [[ -n "$candidate" ]]; then
    shift
  fi
  if source_uses_imports "$src"; then
    "$RAW_MADAROS_IMPORTS" --check "$src" "$@"
    exit "$?"
  fi
  local tmp
  tmp="$(mktemp /tmp/madaros-check-XXXXXX.elf)"
  local rc
  set +e
  madaros_compile "$src" "$tmp" "$@"
  rc=$?
  set -e
  rm -f "$tmp"
  exit "$rc"
}

cmd_run() {
  [[ $# -ge 1 ]] || set -- ""
  local candidate="$1"
  local src
  if ! src="$(resolve_source_or_project "$candidate")"; then
    echo "error: run requires <file.sio> or a project with sounio.toml" >&2
    exit 2
  fi
  if [[ -n "$candidate" ]]; then
    shift
  fi
  local compiler_args=()
  local program_args=()
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--" ]]; then
      shift
      program_args=("$@")
      break
    fi
    compiler_args+=("$1")
    shift
  done
  local tmp rc
  tmp="$(mktemp /tmp/madaros-run-XXXXXX.elf)"
  MADAROS_TMP_RUN="$tmp"
  trap 'rm -f "${MADAROS_TMP_RUN:-}"' EXIT
  madaros_compile "$src" "$tmp" "${compiler_args[@]}"
  set +e
  "$tmp" "${program_args[@]}"
  rc=$?
  set -e
  rm -f "$tmp"
  trap - EXIT
  exit "$rc"
}

case "${1:-}" in
  --version|-V)
    version
    ;;
  info)
    info
    ;;
  check)
    shift
    cmd_check "$@"
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  compile|build)
    shift
    parse_compile_args "$@"
    if [[ -d "$MADAROS_SOURCE" || -z "$MADAROS_SOURCE" ]]; then
      project_root="$(find_project_root "$MADAROS_SOURCE")"
      MADAROS_SOURCE="$(resolve_source_or_project "$project_root")"
      if [[ -z "$MADAROS_OUTPUT" ]]; then
        MADAROS_OUTPUT="$(project_default_output "$project_root")"
      fi
    fi
    if [[ -z "$MADAROS_OUTPUT" ]]; then
      project_root="$(find_project_root "$MADAROS_SOURCE" || true)"
      if [[ -n "$project_root" ]]; then
        MADAROS_OUTPUT="$(project_default_output "$project_root")"
      fi
    fi
    [[ -n "$MADAROS_OUTPUT" ]] || {
      echo "error: compile requires -o <out> when no project default is available" >&2
      exit 2
    }
    madaros_compile "$MADAROS_SOURCE" "$MADAROS_OUTPUT" "${MADAROS_ARGS[@]}"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    exec "$RAW_MADAROS" "$@"
    ;;
esac
