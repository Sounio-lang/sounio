#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPL_DIR="$ROOT_DIR/tools/sounio-repl"
RELEASE_BIN="$REPL_DIR/target/release/sounio-repl"
DEBUG_BIN="$REPL_DIR/target/debug/sounio-repl"

if [[ -x "$RELEASE_BIN" ]]; then
  exec "$RELEASE_BIN" "$@"
fi

if [[ -x "$DEBUG_BIN" ]]; then
  exec "$DEBUG_BIN" "$@"
fi

if command -v cargo >/dev/null 2>&1; then
  exec cargo run --quiet --manifest-path "$REPL_DIR/Cargo.toml" -- "$@"
fi

echo "error: sounio-repl is not built and cargo is not available" >&2
echo "hint: build it with: cd tools/sounio-repl && cargo build --release" >&2
exit 1
