#!/usr/bin/env bash

set -euo pipefail

CLIENT_PROTOCOL=1
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SOURCE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

manifest_value() {
  local manifest="$1" key="$2"
  sed -n "s/^${key}=//p" "$manifest" | head -1
}

WORKTREE="$(git -C "$SOURCE_ROOT" rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$WORKTREE" ]] || die "Loom launcher is not inside a Git worktree"
WORKTREE="$(cd "$WORKTREE" && pwd -P)"
GIT_COMMON_DIR="$(git -C "$WORKTREE" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
[[ -n "$GIT_COMMON_DIR" ]] || die "cannot resolve the shared Git directory"

RUNTIME_ROOT="${SOUNIO_COORD_RUNTIME_DIR:-$GIT_COMMON_DIR/sounio-coord-runtime}"
LOCAL_RUNTIME="$SOURCE_ROOT/tools/loom/_build/default/src/loom.exe"
LOCAL_MESSAGE_RUNTIME="$SOURCE_ROOT/tools/loom/_build/default/message_bridge/loom_message_bridge.exe"
message_bridge=0
if [[ "${1:-}" == message-serve ]]; then
  message_bridge=1
fi
selection=local
selected="$([[ "$message_bridge" == 1 ]] && printf '%s' "$LOCAL_MESSAGE_RUNTIME" || printf '%s' "$LOCAL_RUNTIME")"
manifest=''

if [[ "${SOUNIO_COORD_RUNTIME_MODE:-shared}" != local && \
  ( -e "$RUNTIME_ROOT/current" || -L "$RUNTIME_ROOT/current" ) ]]; then
  current="$(readlink -f "$RUNTIME_ROOT/current" 2>/dev/null || true)"
  [[ -n "$current" ]] || die "shared coordination runtime has a broken current link: $RUNTIME_ROOT/current"
  manifest="$current/manifest"
  if [[ "$message_bridge" == 1 ]]; then
    selected="$current/bin/sounio-loom-message-runtime"
  else
    selected="$current/bin/sounio-loom-runtime"
  fi
  [[ -f "$manifest" && -x "$selected" ]] || \
    die "shared coordination runtime has no requested Loom runtime: $current"
  protocol="$(manifest_value "$manifest" loom_protocol_version)"
  [[ "$protocol" == "$CLIENT_PROTOCOL" ]] || \
    die "incompatible shared Loom runtime: client_protocol=$CLIENT_PROTOCOL runtime_protocol=${protocol:-missing}"
  selection=shared
else
  needs_build=0
  [[ -x "$selected" ]] || needs_build=1
  if [[ "$message_bridge" == 1 ]]; then
    source_roots=("$SOURCE_ROOT/tools/loom/message_bridge" "$SOURCE_ROOT/tools/loom/dune-project")
  else
    source_roots=("$SOURCE_ROOT/tools/loom/src" "$SOURCE_ROOT/tools/loom/dune-project")
  fi
  if [[ "$needs_build" == 0 ]] && \
    find "${source_roots[@]}" -type f \
      \( -name '*.ml' -o -name '*.c' -o -name dune -o -name dune-project \) \
      -newer "$selected" -print -quit | grep -q .; then
    needs_build=1
  fi
  if [[ "$needs_build" == 1 ]]; then
    "$SOURCE_ROOT/scripts/dev/build_sounio_loom.sh" >/dev/null
  fi
fi
[[ -x "$selected" ]] || die "Loom runtime missing or not executable: $selected"

if [[ "${1:-}" == runtime-info ]]; then
  printf 'selection=%s\n' "$selection"
  printf 'client_protocol=%s\n' "$CLIENT_PROTOCOL"
  printf 'runtime_root=%s\n' "$RUNTIME_ROOT"
  printf 'runtime_path=%s\n' "$selected"
  if [[ -n "$manifest" ]]; then
    printf 'runtime_id=%s\n' "$(manifest_value "$manifest" runtime_id)"
    printf 'bundle_sha256=%s\n' "$(manifest_value "$manifest" bundle_sha256)"
    printf 'source_sha=%s\n' "$(manifest_value "$manifest" source_sha)"
  fi
  exec "$selected" runtime-version
fi

if [[ "$message_bridge" == 1 ]]; then
  shift
  if [[ "$selection" == shared ]]; then
    export SOUNIO_COORD_COMMAND="${SOUNIO_COORD_COMMAND:-$current/bin/sounio-coord-runtime}"
  else
    export SOUNIO_COORD_COMMAND="${SOUNIO_COORD_COMMAND:-$SOURCE_ROOT/scripts/dev/sounio_coord_runtime.sh}"
  fi
fi

exec "$selected" "$@"
