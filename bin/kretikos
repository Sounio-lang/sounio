#!/bin/bash
# Kretikos GPU Compiler — bounded GPU compilation wrapper
#
# Kretikos (Κρητικός) = Cretan. Like Ariadne's thread through the Labyrinth,
# this compiler is the named path for Sounio's GPU work: source-level thread
# builtins today, deterministic CPU fallback, in-tree PTX/CUBIN artifact
# templates, and bundles that keep runtime claims explicit.
#
# Usage:
#   kretikos check <source.sio>                 - compile-check a GPU kernel source file
#   kretikos run <source.sio>                   - native CPU fallback, serial thread IDs
#   kretikos build <source.sio> [opts] -o <out>  - PTX via checked GPU artifact if present
#   kretikos emit-ptx <pattern> -o <file.ptx>   - emit PTX template from in-tree emitter
#   kretikos emit-metal <pattern> -o <file.metal> - emit MSL template from in-tree emitter
#   kretikos emit-spirv <pattern> -o <file.spv>  - emit SPIR-V template from in-tree emitter
#   kretikos emit-kaxi <pattern> -o <file.kaxi>  - emit K-AXI epistemic assembly template
#   kretikos kaxi-witness <pattern> -o <file.json> - emit K-AXI assembly plus evidence JSON
#   kretikos kaxi-source-witness <source.sio> -o <file.json> - link checked source to K-AXI evidence
#   kretikos kaxi-lower-source <source.sio> -o <file.json> - recognize checked source and lower to K-AXI evidence
#   kretikos kaxi-lowering-certificate <source.sio> -o <file.json> - braid source lowering, K-AXI, and runtime evidence
#   kretikos kaxi-certificate <source.sio> -o <file.json> - braid source, K-AXI, and runtime bundle evidence
#   kretikos emulate                            - run CPU emulation self-check
#   kretikos emit-cubin <kind> -o <file.cubin>  - emit CUBIN template from in-tree emitter
#   kretikos bundle [-o <dir>] [validation]     - emit PTX+CUBIN plus bundle manifest
#   kretikos profile-source <source.sio>         - classify a real source file for Kretikos
#   kretikos run-source <source.sio> -o <dir>    - check and validate a source profile
#   kretikos hpc source <source.sio>             - run source runtime proof on Slurm GPU worker
#   kretikos hpc manifest <manifest.tsv>         - run manifest runtime proof on Slurm GPU workers
#
# Supported PTX patterns: vec_add, vec_sub, vec_mul, vec_div, vec_add_f64, vec_sub_f64, vec_mul_f64, vec_div_f64, fma, fma_f64, store_u32_const
# Supported Metal patterns: vec_add, ossm_oct_step, sedenion_cd_step, self-check
# Supported CUBIN kinds: exit_only, store_u32_const, vec_add_f32, vec_add_f64, vec_sub_f64, vec_mul_f64, vec_div_f64, fma_f64, vec_sub_f32, vec_mul_f32, vec_div_f32, fma_f32, epistemic_dual_f32
#
# Runtime-backed source profiles:
#   store_u32_const, vec_add_f32, vec_add_f64, vec_sub_f64, vec_mul_f64, vec_div_f64, fma_f64, vec_sub_f32, vec_mul_f32, vec_div_f32, fma_f32, epistemic_elementwise_f32, epistemic_dual_output_f32
#
# Structural-only source profiles:
#   none
#
# GPU builtins recognized in kernel fn bodies:
#   gpu_thread_id_x()  gpu_thread_id_y()  gpu_thread_id_z()
#   gpu_block_id_x()   gpu_block_id_y()   gpu_block_id_z()
#   gpu_block_dim_x()  gpu_block_dim_y()  gpu_block_dim_z()
#   gpu_sync_threads()

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
KRETIKOS_SELF="$SCRIPT_DIR/kretikos"

# Resolve the compiler binary
SOUC_BIN="${SOUNIO_KRETIKOS_COMPILER:-$SCRIPT_DIR/souc-linux-x86_64}"
if [[ ! -x "$SOUC_BIN" ]]; then
    SOUC_BIN="$SCRIPT_DIR/souc"
fi
if [[ ! -x "$SOUC_BIN" ]]; then
    echo "error: Kretikos compiler not found. Set SOUNIO_KRETIKOS_COMPILER." >&2
    exit 1
fi

export SOUNIO_STDLIB_PATH="${SOUNIO_STDLIB_PATH:-$ROOT_DIR/stdlib}"

__kretikos_file_size() {
    if [[ ! -f "$1" ]]; then
        echo "error: file not found: $1" >&2
        return 1
    fi
    stat -c%s "$1" 2>/dev/null || stat -f%z "$1" 2>/dev/null || {
        echo "error: could not stat file: $1" >&2
        return 1
    }
}

__kretikos_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        echo "error: sha256sum or shasum is required" >&2
        return 1
    fi
}

__kretikos_repo_path() {
    local path="$1"
    if [[ "$path" == "$ROOT_DIR" ]]; then
        echo "."
    elif [[ "$path" == "$ROOT_DIR/"* ]]; then
        echo "${path#$ROOT_DIR/}"
    else
        echo "$path"
    fi
}

__kretikos_token_value() {
    local text="$1"
    local key="$2"
    tr ' ' '\n' <<<"$text" | awk -F= -v k="$key" '$1 == k { print $2; exit }'
}

__kretikos_check_source() {
    local src="$1"
    if [[ -x "$SCRIPT_DIR/souc" ]]; then
        "$SCRIPT_DIR/souc" check "$src"
    else
        local out="${TMPDIR:-/tmp}/kretikos-check.elf"
        rm -f "$out"
        "$SOUC_BIN" "$src" "$out" >/dev/null
        rm -f "$out"
    fi
}

__kretikos_hpc_require_script() {
    local script="$1"
    if [[ ! -x "$script" ]]; then
        echo "error: missing executable Kretikos HPC bridge: $script" >&2
        return 1
    fi
}

__kretikos_hpc_doctor() {
    local ns="${NS:-slurm-pilot}"
    local kubectl_bin="${KUBECTL_BIN:-kubectl}"
    local login_pod_name="${LOGIN_POD_NAME:-}"
    local login_selector="${LOGIN_SELECTOR:-app.kubernetes.io/name=login}"
    local login_pod=""

    echo "Kretikos HPC Runtime Bridge"
    echo "==========================="
    echo "namespace: $ns"

    if ! command -v "$kubectl_bin" >/dev/null 2>&1; then
        echo "kubectl:   NOT FOUND ($kubectl_bin)" >&2
        return 1
    fi
    echo "kubectl:   FOUND at $(command -v "$kubectl_bin")"

    if [[ -n "$login_pod_name" ]]; then
        login_pod="$login_pod_name"
    else
        login_pod="$("$kubectl_bin" -n "$ns" get pods \
            -l "$login_selector" \
            --field-selector=status.phase=Running \
            -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
    fi

    if [[ -z "$login_pod" ]]; then
        echo "login pod: NOT FOUND selector=$login_selector" >&2
        return 1
    fi
    echo "login pod: $login_pod"

    "$kubectl_bin" -n "$ns" exec "$login_pod" -- bash -lc '
        set -euo pipefail
        test -S /run/slurm/sack.socket
        scontrol ping >/dev/null
        printf "slurm:     READY\n"
        printf "sbatch:    "
        command -v sbatch
        if command -v sinfo >/dev/null 2>&1; then
            printf "gpu view:\n"
            sinfo -h -o "%P %a %l %D %G" | head -10
        fi
    '
}

__kretikos_normalize_profile() {
    tr '[:upper:]' '[:lower:]' <<<"$1" | tr '-' '_'
}

__kretikos_source_profile_record() {
    local src="$1"
    if [[ ! -f "$src" ]]; then
        echo "error: source not found: $src" >&2
        return 1
    fi

    local directive profile
    directive="$(awk '
        /^[[:space:]]*\/\/[[:space:]]*kretikos:[[:space:]]*profile[[:space:]]*=/ {
            sub(/^[[:space:]]*\/\/[[:space:]]*kretikos:[[:space:]]*profile[[:space:]]*=[[:space:]]*/, "")
            print $1
            exit
        }
    ' "$src")"
    profile="$(__kretikos_normalize_profile "$directive")"

    if [[ -z "$profile" ]]; then
        if grep -Eq 'kernel[[:space:]]+fn[[:space:]]+.*(epistemic_dual|knowledge_dual)' "$src"; then
            profile="epistemic_dual_output_f32"
        elif grep -Eq 'kernel[[:space:]]+fn[[:space:]]+.*epistemic.*vec.*add' "$src"; then
            profile="epistemic_elementwise_f32"
        elif grep -Eq 'kernel[[:space:]]+fn[[:space:]]+.*(vec_add|vector_add|add_vec)' "$src"; then
            profile="vec_add_f32"
        elif grep -Eq 'kernel[[:space:]]+fn[[:space:]]+.*store.*(u32|const)' "$src"; then
            profile="store_u32_const"
        fi
    fi

    case "$profile" in
        store|store_u32|store_const|store_u32_const)
            echo "store_u32_const|store_u32_const|store_u32_const|sounio_bare_store_u32_const_sm80|source_profile||1"
            ;;
        vec_add|vector_add|add_vec|vec_add_f32)
            echo "vec_add_f32|vec_add_f32|vec_add_f32|sounio_bare_vec_add_f32_sm80|source_profile|vec_add|1"
            ;;
        vec_sub|vector_sub|sub_vec|vec_sub_f32)
            echo "vec_sub_f32|vec_sub_f32|vec_sub_f32|sounio_bare_vec_sub_f32_sm80|source_profile|vec_sub|1"
            ;;
        epistemic_elementwise|epistemic_elementwise_f32|epistemic_vec_add|epistemic_vec_add_f32)
            echo "epistemic_elementwise_f32|vec_add_f32|epistemic_elementwise_f32|sounio_bare_vec_add_f32_sm80|source_profile|vec_add|1"
            ;;
        epistemic_dual|epistemic_dual_f32|epistemic_dual_output|epistemic_dual_output_f32)
            echo "epistemic_dual_output_f32|epistemic_dual_f32|epistemic_dual_output_f32|sounio_bare_epistemic_dual_output_f32_sm80|source_profile||1"
            ;;
        vec_mul|vector_mul|mul_vec|vec_mul_f32)
            echo "vec_mul_f32|vec_mul_f32|vec_mul_f32|sounio_bare_vec_mul_f32_sm80|source_profile|vec_mul|1"
            ;;
        vec_div|vector_div|div_vec|vec_div_f32)
            echo "vec_div_f32|vec_div_f32|vec_div_f32|sounio_bare_vec_div_f32_sm80|source_profile|vec_div|1"
            ;;
        vec_add_f64|vector_add_f64|add_vec_f64)
            echo "vec_add_f64|vec_add_f64|vec_add_f64|sounio_bare_vec_add_f64_sm80|source_profile|vec_add_f64|1"
            ;;
        vec_sub_f64|vector_sub_f64|sub_vec_f64)
            echo "vec_sub_f64|vec_sub_f64|vec_sub_f64|sounio_bare_vec_sub_f64_sm80|source_profile|vec_sub_f64|1"
            ;;
        vec_mul_f64|vector_mul_f64|mul_vec_f64)
            echo "vec_mul_f64|vec_mul_f64|vec_mul_f64|sounio_bare_vec_mul_f64_sm80|source_profile|vec_mul_f64|1"
            ;;
        vec_div_f64|vector_div_f64|div_vec_f64)
            echo "vec_div_f64|vec_div_f64|vec_div_f64|sounio_bare_vec_div_f64_sm80|source_profile|vec_div_f64|1"
            ;;
        fma_f64|vec_fma_f64)
            echo "fma_f64|fma_f64|fma_f64|sounio_bare_vec_fma_f64_sm80|source_profile|fma_f64|1"
            ;;
        fma|fma_f32|vec_fma|vec_fma_f32)
            echo "fma_f32|fma_f32|fma_f32|sounio_bare_vec_fma_f32_sm80|source_profile|fma|1"
            ;;
        *)
            echo "error: unsupported Kretikos source profile for $src" >&2
            echo "hint: add one of these directives near the top of the file:" >&2
            echo "  // kretikos: profile=vec_add_f32" >&2
            echo "  // kretikos: profile=vec_sub_f32" >&2
            echo "  // kretikos: profile=vec_mul_f32" >&2
            echo "  // kretikos: profile=vec_div_f32" >&2
            echo "  // kretikos: profile=vec_add_f64" >&2
            echo "  // kretikos: profile=vec_sub_f64" >&2
            echo "  // kretikos: profile=vec_mul_f64" >&2
            echo "  // kretikos: profile=vec_div_f64" >&2
            echo "  // kretikos: profile=fma_f64" >&2
            echo "  // kretikos: profile=fma_f32" >&2
            echo "  // kretikos: profile=epistemic_elementwise_f32" >&2
            echo "  // kretikos: profile=epistemic_dual_output_f32" >&2
            echo "  // kretikos: profile=store_u32_const" >&2
            return 1
            ;;
    esac
}

CMD="${1:-}"
shift 2>/dev/null || true

case "$CMD" in
    check)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos check <source.sio>" >&2
            exit 1
        fi
        __kretikos_check_source "$1" >/dev/null 2>&1
        echo "kretikos: check OK — GPU builtin surface accepted"
        echo "kretikos: CPU fallback is serial: thread/block IDs are deterministic stubs"
        ;;
    run)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos run <source.sio>" >&2
            exit 1
        fi
        OUT="/tmp/kretikos-run.elf"
        rm -f "$OUT"
        "$SOUC_BIN" "$1" "$OUT"
        chmod +x "$OUT"
        "$OUT"
        ;;
    profile-source)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos profile-source <source.sio>" >&2
            exit 1
        fi
        SRC="$1"
        record="$(__kretikos_source_profile_record "$SRC")"
        IFS='|' read -r PROFILE CUBIN_KIND RUNTIME_RUNG KERNEL_NAME CLASS PTX_PATTERN RUNTIME_BACKED <<<"$record"
        echo "kretikos: source profile - profile=$PROFILE cubin_kind=$CUBIN_KIND runtime_rung=$RUNTIME_RUNG kernel=$KERNEL_NAME class=$CLASS ptx_pattern=$PTX_PATTERN runtime_backed=$RUNTIME_BACKED"
        if [[ "$RUNTIME_BACKED" == "1" ]]; then
            echo "kretikos: source contract - checked Sounio file selects a runtime-backed GPU profile"
        else
            echo "kretikos: source contract - checked Sounio file selects a structural-only PTX profile"
            echo "kretikos: source blocker - profile_not_runtime_backed"
        fi
        ;;
    run-source)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos run-source <source.sio> [-o <dir>] [--force] [--validate-toolchain] [--require-runtime]" >&2
            exit 1
        fi
        SRC="$1"
        shift
        OUT_DIR=""
        FORCE=0
        TOOLCHAIN_ARGS=()
        TOOLCHAIN_MODE="off"
        REQUIRE_TOOLCHAIN=0
        RUNTIME_ARGS=(--validate-runtime)
        RUNTIME_MODE="auto"
        REQUIRE_RUNTIME=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o|--output-dir)
                    OUT_DIR="$2"
                    shift 2
                    ;;
                -f|--force)
                    FORCE=1
                    shift
                    ;;
                --validate-toolchain)
                    TOOLCHAIN_ARGS=(--validate-toolchain)
                    TOOLCHAIN_MODE="auto"
                    shift
                    ;;
                --require-toolchain)
                    TOOLCHAIN_ARGS=(--require-toolchain)
                    TOOLCHAIN_MODE="required"
                    REQUIRE_TOOLCHAIN=1
                    shift
                    ;;
                --validate-runtime)
                    RUNTIME_ARGS=(--validate-runtime)
                    RUNTIME_MODE="auto"
                    REQUIRE_RUNTIME=0
                    shift
                    ;;
                --require-runtime)
                    RUNTIME_ARGS=(--require-runtime)
                    RUNTIME_MODE="required"
                    REQUIRE_RUNTIME=1
                    shift
                    ;;
                -*)
                    echo "error: unknown option $1" >&2
                    exit 1
                    ;;
                *)
                    echo "error: unexpected argument $1" >&2
                    exit 1
                    ;;
            esac
        done

        if [[ ! -f "$SRC" ]]; then
            echo "error: source not found: $SRC" >&2
            exit 1
        fi
        if [[ -z "$OUT_DIR" ]]; then
            OLD_UMASK="$(umask)"
            umask 077
            OUT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/kretikos-source.XXXXXX")" || {
                echo "error: failed to create temporary source-run directory" >&2
                exit 1
            }
            umask "$OLD_UMASK"
        fi

        __kretikos_check_source "$SRC" >/dev/null
        record="$(__kretikos_source_profile_record "$SRC")"
        IFS='|' read -r PROFILE CUBIN_KIND RUNTIME_RUNG KERNEL_NAME CLASS PTX_PATTERN RUNTIME_BACKED <<<"$record"

        SOURCE_SHA="$(__kretikos_sha256 "$SRC")" || exit 1
        SOURCE_BYTES="$(__kretikos_file_size "$SRC")" || exit 1
        SOURCE_PATH="$(__kretikos_repo_path "$(cd "$(dirname "$SRC")" && pwd)/$(basename "$SRC")")"
        SOURCE_MANIFEST="$OUT_DIR/kretikos_source_profile.v1.json"

        if [[ "$RUNTIME_BACKED" != "1" ]]; then
            if [[ -z "$PTX_PATTERN" ]]; then
                echo "error: structural profile $PROFILE has no PTX pattern" >&2
                exit 1
            fi
            PTX_OUT="$OUT_DIR/kretikos_${PTX_PATTERN}.ptx"
            if [[ "$FORCE" -ne 1 ]] && [[ -e "$PTX_OUT" || -e "$SOURCE_MANIFEST" ]]; then
                echo "error: source output already exists in $OUT_DIR; use --force to overwrite" >&2
                exit 1
            fi

            "$KRETIKOS_SELF" emit-ptx "$PTX_PATTERN" -o "$PTX_OUT"
            PTX_SHA="$(__kretikos_sha256 "$PTX_OUT")" || exit 1
            PTX_BYTES="$(__kretikos_file_size "$PTX_OUT")" || exit 1
            python3 - "$SOURCE_MANIFEST" "$SOURCE_PATH" "$SOURCE_BYTES" "$SOURCE_SHA" \
                "$PROFILE" "$PTX_PATTERN" "$(basename "$PTX_OUT")" "$PTX_BYTES" "$PTX_SHA" \
                "$TOOLCHAIN_MODE" "$RUNTIME_MODE" <<'PY'
import json
import sys
from datetime import datetime, timezone

(
    manifest_out,
    source_path,
    source_bytes,
    source_sha,
    profile,
    ptx_pattern,
    ptx_path,
    ptx_bytes,
    ptx_sha,
    toolchain_mode,
    runtime_mode,
) = sys.argv[1:]

payload = {
    "schema": "sounio.kretikos.source-profile.v1",
    "generated_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "source": {
        "path": source_path,
        "bytes": int(source_bytes),
        "sha256": source_sha,
    },
    "profile": profile,
    "profile_kind": "structural_only",
    "runtime_backed": False,
    "ptx_pattern": ptx_pattern,
    "cubin_kind": None,
    "runtime_rung": None,
    "kernel": None,
    "bundle_manifest": None,
    "bundle_root": ".",
    "status": "structural_only",
    "ptx_artifact": {
        "path": ptx_path,
        "bytes": int(ptx_bytes),
        "sha256": ptx_sha,
    },
    "toolchain_validation": {
        "mode": toolchain_mode,
        "status": "not_run",
        "reason": "source_profile_not_runtime_backed",
    },
    "runtime_validation": {
        "mode": runtime_mode,
        "validation_scope": "not_available_for_structural_only_profile",
        "status": "not_run",
        "reason": "profile_not_runtime_backed",
        "rung": None,
        "kernel": None,
    },
    "boundaries": [
        "source_must_typecheck_before_profile_selection",
        "profile_selection_is_explicit_or_shape_limited",
        "does_not_claim_arbitrary_sounio_gpu_lowering",
        "does_not_claim_general_pointer_or_allocator_lowering",
        "does_not_claim_runtime_execution_for_structural_only_profile",
        "does_not_claim_cubin_emission_for_structural_only_profile",
    ],
}
with open(manifest_out, "w", encoding="utf-8") as fh:
    json.dump(payload, fh, indent=2, sort_keys=True)
    fh.write("\n")
PY
            echo "kretikos: source profile manifest - $SOURCE_MANIFEST"
            echo "kretikos: source runtime validation - not_run/profile_not_runtime_backed rung= kernel="
            if [[ "$REQUIRE_TOOLCHAIN" -eq 1 ]]; then
                echo "kretikos: required toolchain validation failed - source profile is structural-only" >&2
                exit 1
            fi
            if [[ "$REQUIRE_RUNTIME" -eq 1 ]]; then
                echo "kretikos: required runtime validation failed - profile_not_runtime_backed" >&2
                exit 1
            fi
            exit 0
        fi

        BUNDLE_ARGS=(bundle -o "$OUT_DIR" --cubin-kind "$CUBIN_KIND" --runtime-rung "$RUNTIME_RUNG")
        if [[ -n "$PTX_PATTERN" ]]; then
            BUNDLE_ARGS+=(--ptx-pattern "$PTX_PATTERN")
        fi
        if [[ "$FORCE" -eq 1 ]]; then
            BUNDLE_ARGS+=(--force)
        fi
        BUNDLE_ARGS+=("${TOOLCHAIN_ARGS[@]}" "${RUNTIME_ARGS[@]}")
        "$KRETIKOS_SELF" "${BUNDLE_ARGS[@]}"

        python3 - "$SOURCE_MANIFEST" "$SOURCE_PATH" "$SOURCE_BYTES" "$SOURCE_SHA" \
            "$PROFILE" "$CUBIN_KIND" "$RUNTIME_RUNG" "$KERNEL_NAME" "$(basename "$OUT_DIR")" "$PTX_PATTERN" <<'PY'
import json
import sys
from datetime import datetime, timezone

(
    manifest_out,
    source_path,
    source_bytes,
    source_sha,
    profile,
    cubin_kind,
    runtime_rung,
    kernel_name,
    bundle_root,
    ptx_pattern,
) = sys.argv[1:]

payload = {
    "schema": "sounio.kretikos.source-profile.v1",
    "generated_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "source": {
        "path": source_path,
        "bytes": int(source_bytes),
        "sha256": source_sha,
    },
    "profile": profile,
    "profile_kind": "runtime_backed",
    "runtime_backed": True,
    "ptx_pattern": ptx_pattern,
    "cubin_kind": cubin_kind,
    "runtime_rung": runtime_rung,
    "kernel": kernel_name,
    "bundle_manifest": "kretikos_bundle.v1.json",
    "bundle_root": bundle_root,
    "status": "profiled",
    "boundaries": [
        "source_must_typecheck_before_profile_selection",
        "profile_selection_is_explicit_or_shape_limited",
        "does_not_claim_arbitrary_sounio_gpu_lowering",
        "does_not_claim_general_pointer_or_allocator_lowering",
        "runtime_validation_applies_to_selected_profile_only",
    ],
}
with open(manifest_out, "w", encoding="utf-8") as fh:
    json.dump(payload, fh, indent=2, sort_keys=True)
    fh.write("\n")
PY
        runtime_summary="$(python3 - "$OUT_DIR/kretikos_bundle.v1.json" <<'PY'
import json
import sys
obj = json.load(open(sys.argv[1], encoding="utf-8"))
runtime = obj.get("runtime_validation") or {}
print("{}/{} rung={} kernel={}".format(
    runtime.get("status"),
    runtime.get("reason"),
    runtime.get("rung"),
    runtime.get("kernel"),
))
PY
        )"
        echo "kretikos: source profile manifest - $SOURCE_MANIFEST"
        echo "kretikos: source runtime validation - $runtime_summary"
        ;;
    run-manifest)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos run-manifest <manifest.tsv> [-o <dir>] [--force] [--validate-toolchain] [--require-runtime]" >&2
            exit 1
        fi
        MANIFEST="$1"
        shift
        OUT_DIR=""
        FORCE=0
        TOOLCHAIN_ARGS=()
        RUNTIME_ARGS=(--validate-runtime)
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o|--output-dir)
                    OUT_DIR="$2"
                    shift 2
                    ;;
                -f|--force)
                    FORCE=1
                    shift
                    ;;
                --validate-toolchain)
                    TOOLCHAIN_ARGS=(--validate-toolchain)
                    shift
                    ;;
                --require-toolchain)
                    TOOLCHAIN_ARGS=(--require-toolchain)
                    shift
                    ;;
                --validate-runtime)
                    RUNTIME_ARGS=(--validate-runtime)
                    shift
                    ;;
                --require-runtime)
                    RUNTIME_ARGS=(--require-runtime)
                    shift
                    ;;
                -*)
                    echo "error: unknown option $1" >&2
                    exit 1
                    ;;
                *)
                    echo "error: unexpected argument $1" >&2
                    exit 1
                    ;;
            esac
        done

        if [[ ! -f "$MANIFEST" ]]; then
            echo "error: manifest not found: $MANIFEST" >&2
            exit 1
        fi
        if [[ -z "$OUT_DIR" ]]; then
            OLD_UMASK="$(umask)"
            umask 077
            OUT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/kretikos-corpus.XXXXXX")" || {
                echo "error: failed to create temporary corpus directory" >&2
                exit 1
            }
            umask "$OLD_UMASK"
        fi
        mkdir -p "$OUT_DIR"

        MANIFEST_DIR="$(cd "$(dirname "$MANIFEST")" && pwd)"
        SUMMARY_TSV="$OUT_DIR/kretikos_source_corpus.tsv"
        CORPUS_JSON="$OUT_DIR/kretikos_source_corpus.v1.json"
        printf 'label\tsource\trc\tprofile_kind\truntime_backed\tptx_pattern\truntime_status\truntime_reason\truntime_rung\tkernel\tdevice_name\tcc_major\tcc_minor\tcase_dir\n' >"$SUMMARY_TSV"

        total=0
        failed=0
        while IFS=$'\t' read -r label source rest || [[ -n "${label:-}" ]]; do
            [[ -z "${label:-}" ]] && continue
            [[ "$label" == \#* ]] && continue
            if [[ -z "${source:-}" ]]; then
                source="$label"
                label="$(basename "$source" .sio)"
            fi
            case "$source" in
                /*) SRC="$source" ;;
                *)
                    if [[ -f "$MANIFEST_DIR/$source" ]]; then
                        SRC="$MANIFEST_DIR/$source"
                    else
                        SRC="$ROOT_DIR/$source"
                    fi
                    ;;
            esac
            SAFE_LABEL="$(printf '%s' "$label" | tr -cs 'A-Za-z0-9_.-' '_' | sed 's/^_*//;s/_*$//')"
            if [[ -z "$SAFE_LABEL" ]]; then
                SAFE_LABEL="case_$total"
            fi
            CASE_DIR="$OUT_DIR/$SAFE_LABEL"
            mkdir -p "$CASE_DIR"

            RUN_ARGS=(run-source "$SRC" -o "$CASE_DIR" --force)
            RUN_ARGS+=("${TOOLCHAIN_ARGS[@]}" "${RUNTIME_ARGS[@]}")
            set +e
            "$KRETIKOS_SELF" "${RUN_ARGS[@]}" >"$CASE_DIR/kretikos_run_source.stdout" 2>"$CASE_DIR/kretikos_run_source.stderr"
            case_rc=$?
            set -e
            total=$((total + 1))

            if [[ -f "$CASE_DIR/kretikos_bundle.v1.json" ]]; then
                row="$(python3 - "$label" "$SRC" "$case_rc" "$CASE_DIR" "$CASE_DIR/kretikos_bundle.v1.json" "$CASE_DIR/kretikos_source_profile.v1.json" <<'PY'
import json
import os
import sys

label, source, rc, case_dir, bundle_path, source_profile_path = sys.argv[1:]
obj = json.load(open(bundle_path, encoding="utf-8"))
source_profile = {}
if os.path.exists(source_profile_path):
    source_profile = json.load(open(source_profile_path, encoding="utf-8"))
runtime = obj.get("runtime_validation") or {}
fields = [
    label,
    source,
    rc,
    source_profile.get("profile_kind", "runtime_backed"),
    source_profile.get("runtime_backed", True),
    source_profile.get("ptx_pattern"),
    runtime.get("status"),
    runtime.get("reason"),
    runtime.get("rung"),
    runtime.get("kernel"),
    runtime.get("device_name"),
    runtime.get("cc_major"),
    runtime.get("cc_minor"),
    case_dir,
]
print("\t".join("" if value is None else str(value) for value in fields))
PY
                )"
            elif [[ -f "$CASE_DIR/kretikos_source_profile.v1.json" ]]; then
                row="$(python3 - "$label" "$SRC" "$case_rc" "$CASE_DIR" "$CASE_DIR/kretikos_source_profile.v1.json" <<'PY'
import json
import sys

label, source, rc, case_dir, source_profile_path = sys.argv[1:]
obj = json.load(open(source_profile_path, encoding="utf-8"))
runtime = obj.get("runtime_validation") or {}
fields = [
    label,
    source,
    rc,
    obj.get("profile_kind"),
    obj.get("runtime_backed"),
    obj.get("ptx_pattern"),
    runtime.get("status"),
    runtime.get("reason"),
    runtime.get("rung"),
    runtime.get("kernel"),
    runtime.get("device_name"),
    runtime.get("cc_major"),
    runtime.get("cc_minor"),
    case_dir,
]
print("\t".join("" if value is None else str(value) for value in fields))
PY
                )"
            else
                row="$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$label" "$SRC" "$case_rc" "" "" "" "fail" "bundle_manifest_missing" "" "" "" "" "" "$CASE_DIR")"
            fi
            printf '%s\n' "$row" >>"$SUMMARY_TSV"
            if [[ "$case_rc" -ne 0 ]]; then
                failed=$((failed + 1))
            fi
        done <"$MANIFEST"

        python3 - "$CORPUS_JSON" "$MANIFEST" "$SUMMARY_TSV" "$total" "$failed" <<'PY'
import csv
import json
import sys
from datetime import datetime, timezone

out, manifest, summary_tsv, total, failed = sys.argv[1:]
with open(summary_tsv, encoding="utf-8") as fh:
    rows = list(csv.DictReader(fh, delimiter="\t"))
payload = {
    "schema": "sounio.kretikos.source-corpus.v1",
    "generated_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "manifest": manifest,
    "summary_tsv": "kretikos_source_corpus.tsv",
    "total": int(total),
    "failed": int(failed),
    "status": "pass" if int(failed) == 0 else "fail",
    "cases": rows,
    "boundaries": [
        "corpus_contains_supported_source_profiles_only",
        "each_source_must_typecheck_before_profile_selection",
        "runtime_validation_applies_per_selected_profile",
        "does_not_claim_arbitrary_sounio_gpu_lowering",
    ],
}
with open(out, "w", encoding="utf-8") as fh:
    json.dump(payload, fh, indent=2, sort_keys=True)
    fh.write("\n")
PY

        echo "kretikos: source corpus summary - $SUMMARY_TSV"
        echo "kretikos: source corpus manifest - $CORPUS_JSON"
        echo "kretikos: source corpus result - total=$total failed=$failed"
        [[ "$failed" -eq 0 ]]
        ;;
    hpc|slurm)
        SUBCMD="${1:-}"
        shift 2>/dev/null || true
        case "$SUBCMD" in
            doctor)
                __kretikos_hpc_doctor
                ;;
            source|run-source)
                if [[ $# -lt 1 ]]; then
                    echo "usage: kretikos hpc source <source.sio>" >&2
                    exit 1
                fi
                HPC_SOURCE_SCRIPT="$ROOT_DIR/slurm-jobs/kretikos/submit-kretikos-source.sh"
                __kretikos_hpc_require_script "$HPC_SOURCE_SCRIPT"
                "$HPC_SOURCE_SCRIPT" "$@"
                ;;
            manifest|run-manifest)
                if [[ $# -lt 1 ]]; then
                    echo "usage: kretikos hpc manifest <manifest.tsv>" >&2
                    exit 1
                fi
                HPC_MANIFEST_SCRIPT="$ROOT_DIR/slurm-jobs/kretikos/submit-kretikos-manifest.sh"
                __kretikos_hpc_require_script "$HPC_MANIFEST_SCRIPT"
                "$HPC_MANIFEST_SCRIPT" "$@"
                ;;
            ""|-h|--help)
                echo "usage: kretikos hpc <doctor|source|manifest> [args]" >&2
                echo "  kretikos hpc doctor" >&2
                echo "  kretikos hpc source <source.sio>" >&2
                echo "  kretikos hpc manifest <manifest.tsv>" >&2
                ;;
            *)
                echo "error: unknown Kretikos HPC subcommand: $SUBCMD" >&2
                echo "usage: kretikos hpc <doctor|source|manifest> [args]" >&2
                exit 1
                ;;
        esac
        ;;
    hpc-doctor|slurm-doctor)
        __kretikos_hpc_doctor
        ;;
    hpc-source|slurm-source)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos hpc-source <source.sio>" >&2
            exit 1
        fi
        HPC_SOURCE_SCRIPT="$ROOT_DIR/slurm-jobs/kretikos/submit-kretikos-source.sh"
        __kretikos_hpc_require_script "$HPC_SOURCE_SCRIPT"
        "$HPC_SOURCE_SCRIPT" "$@"
        ;;
    hpc-manifest|slurm-manifest)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos hpc-manifest <manifest.tsv>" >&2
            exit 1
        fi
        HPC_MANIFEST_SCRIPT="$ROOT_DIR/slurm-jobs/kretikos/submit-kretikos-manifest.sh"
        __kretikos_hpc_require_script "$HPC_MANIFEST_SCRIPT"
        "$HPC_MANIFEST_SCRIPT" "$@"
        ;;
    build)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos build <source.sio> [options] -o <output.ptx>" >&2
            echo "note: requires artifacts/omega/souc-bin/souc-linux-x86_64-gpu for full kernel lowering" >&2
            exit 1
        fi
        SRC="$1"
        shift
        # Delegate to checked GPU artifact if available
        GPU_ARTIFACT="$ROOT_DIR/artifacts/omega/souc-bin/souc-linux-x86_64-gpu"
        if [[ -x "$GPU_ARTIFACT" ]]; then
            "$GPU_ARTIFACT" build "$SRC" --backend gpu "$@"
        else
            echo "error: GPU artifact not found at $GPU_ARTIFACT" >&2
            echo "hint: 'kretikos run' executes a serial native CPU fallback" >&2
            echo "hint: 'kretikos emit-ptx <pattern> -o kernel.ptx' emits PTX for built-in patterns" >&2
            echo "hint: supported PTX patterns: vec_add, vec_sub, vec_mul, vec_div, vec_add_f64, vec_sub_f64, vec_mul_f64, vec_div_f64, fma, fma_f64" >&2
            echo "hint: 'kretikos emit-metal <pattern> -o kernel.metal' emits MSL for built-in patterns" >&2
            echo "hint: supported Metal patterns: vec_add, ossm_oct_step, sedenion_cd_step, self-check" >&2
            echo "hint: 'kretikos emit-spirv exit_only -o kernel.spv' emits a SPIR-V template" >&2
            echo "hint: 'kretikos emit-kaxi exit_only -o kernel.kaxi' emits a K-AXI assembly template" >&2
            echo "hint: 'kretikos kaxi-witness epistemic_dual_output_f32 -o witness.json' emits K-AXI evidence" >&2
            echo "hint: 'kretikos kaxi-source-witness examples/kretikos/real_epistemic_dual_output.sio -o source-witness.json' links source to K-AXI evidence" >&2
            echo "hint: 'kretikos kaxi-lower-source examples/kretikos/lower_vec_add_f32.sio -o lowering.json' recognizes source and emits K-AXI evidence" >&2
            echo "hint: 'kretikos kaxi-lowering-certificate examples/kretikos/lower_epistemic_dual_output_f32.sio -o lowering-certificate.json' braids source lowering, K-AXI, and runtime evidence" >&2
            echo "hint: 'kretikos kaxi-certificate examples/kretikos/real_epistemic_dual_output.sio -o certificate.json' braids source, K-AXI, and runtime bundle evidence" >&2
            echo "hint: 'kretikos emulate' runs CPU emulation self-check" >&2
            echo "hint: 'kretikos emit-cubin <kind> -o kernel.cubin' emits a CUBIN template from in-tree emitters" >&2
            exit 1
        fi
        ;;
    emit-ptx)
        DRIVER_SRC="$ROOT_DIR/self-hosted/gpu/kretikos_emit_ptx.sio"
        OLD_UMASK="$(umask)"
        umask 077
        DRIVER_DIR="$(mktemp -d "${TMPDIR:-/tmp}/kretikos-emit-ptx.XXXXXX")" || {
            echo "error: failed to create temporary PTX driver directory" >&2
            exit 1
        }
        umask "$OLD_UMASK"
        DRIVER_ELF="$DRIVER_DIR/driver.elf"
        trap 'rm -rf "$DRIVER_DIR"' EXIT INT TERM

        # Parse args: emit-ptx <pattern> -o <file> [--validate-toolchain]
        PATTERN=""
        OUT=""
        VALIDATE_TOOLCHAIN=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o|--output)
                    OUT="$2"
                    shift 2
                    ;;
                --validate-toolchain)
                    VALIDATE_TOOLCHAIN=1
                    shift
                    ;;
                -*)
                    echo "error: unknown option $1" >&2
                    exit 1
                    ;;
                *)
                    if [[ -z "$PATTERN" ]]; then
                        PATTERN="$1"
                    else
                        echo "error: unexpected argument $1" >&2
                        exit 1
                    fi
                    shift
                    ;;
            esac
        done

        if [[ -n "$VALIDATE_TOOLCHAIN" ]]; then
            if ! command -v nvcc >/dev/null 2>&1; then
                echo "error: --validate-toolchain requires nvcc, but it was not found" >&2
                echo "hint: run 'kretikos detect-cuda' to check your CUDA installation" >&2
                exit 1
            fi
            if ! command -v ptxas >/dev/null 2>&1; then
                echo "error: --validate-toolchain requires ptxas, but it was not found" >&2
                echo "hint: run 'kretikos detect-cuda' to check your CUDA installation" >&2
                exit 1
            fi
            echo "kretikos: toolchain validation OK - nvcc and ptxas found"
        fi

        if [[ -z "$PATTERN" ]]; then
            echo "usage: kretikos emit-ptx <pattern> -o <file.ptx>" >&2
            echo "" >&2
            echo "Supported patterns:" >&2
            echo "  vec_add         - f32 vector addition (SM50 PTX target)" >&2
            echo "  vec_sub         - f32 vector subtraction" >&2
            echo "  vec_mul         - f32 vector multiplication" >&2
            echo "  vec_div         - f32 vector division" >&2
            echo "  vec_add_f64     - f64 vector addition" >&2
            echo "  vec_sub_f64     - f64 vector subtraction" >&2
            echo "  vec_mul_f64     - f64 vector multiplication" >&2
            echo "  vec_div_f64     - f64 vector division" >&2
            echo "  fma             - f32 fused multiply-add (a*b+c)" >&2
            echo "  fma_f64         - f64 fused multiply-add (a*b+c)" >&2
            echo "  store_u32_const - store constant u32 per thread" >&2
            exit 1
        fi

        case "$PATTERN" in
            vec_add|vec_sub|vec_mul|vec_div|vec_add_f64|vec_sub_f64|vec_mul_f64|vec_div_f64|fma|fma_f64|store_u32_const) ;;
            *)
                echo "error: unsupported PTX pattern '$PATTERN'" >&2
                echo "supported PTX patterns: vec_add, vec_sub, vec_mul, vec_div, vec_add_f64, vec_sub_f64, vec_mul_f64, vec_div_f64, fma, fma_f64, store_u32_const" >&2
                exit 1
                ;;
        esac

        if [[ -z "$OUT" ]]; then
            echo "error: -o <output> is required" >&2
            exit 1
        fi

        "$SOUC_BIN" "$DRIVER_SRC" "$DRIVER_ELF" >/dev/null 2>&1 || {
            echo "error: failed to compile PTX emitter driver" >&2
            exit 1
        }
        chmod +x "$DRIVER_ELF"

        "$DRIVER_ELF" "$PATTERN" > "$OUT"

        bytes=$(stat -c%s "$OUT" 2>/dev/null || stat -f%z "$OUT" 2>/dev/null || echo "?")
        echo "kretikos: PTX template emitted - $OUT ($bytes bytes)"

        # Structural validation. This is intentionally not a ptxas/runtime claim.
        if grep -Eq "^\\.version [0-9]+\\.[0-9]+" "$OUT" && grep -Eq "^\\.target sm_[0-9]+" "$OUT" && grep -q "\\.visible .entry" "$OUT" && grep -Eq "(ret;|exit;|trap;|bra)" "$OUT"; then
            echo "kretikos: structural validation OK - PTX directives present"
        else
            echo "kretikos: structural validation failed - PTX markers missing" >&2
            exit 1
        fi
        ;;

    emit-metal)
        DRIVER_SRC="$ROOT_DIR/self-hosted/gpu/kretikos_emit_metal.sio"
        OLD_UMASK="$(umask)"
        umask 077
        DRIVER_DIR="$(mktemp -d "${TMPDIR:-/tmp}/kretikos-emit-metal.XXXXXX")" || {
            echo "error: failed to create temporary Metal driver directory" >&2
            exit 1
        }
        umask "$OLD_UMASK"
        DRIVER_ELF="$DRIVER_DIR/driver.elf"
        trap 'rm -rf "$DRIVER_DIR"' EXIT INT TERM

        # Parse args: emit-metal <pattern> -o <file>
        PATTERN=""
        OUT=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o|--output)
                    OUT="$2"
                    shift 2
                    ;;
                -*)
                    echo "error: unknown option $1" >&2
                    exit 1
                    ;;
                *)
                    if [[ -z "$PATTERN" ]]; then
                        PATTERN="$1"
                    else
                        echo "error: unexpected argument $1" >&2
                        exit 1
                    fi
                    shift
                    ;;
            esac
        done

        if [[ -z "$PATTERN" ]]; then
            echo "usage: kretikos emit-metal <pattern> -o <file.metal>" >&2
            echo "" >&2
            echo "Supported patterns:" >&2
            echo "  vec_add          - f32 vector addition (MSL compute kernel)" >&2
            echo "  ossm_oct_step    - octonion OSSM step with f64-checked f32 policy" >&2
            echo "  sedenion_cd_step - sedenion Cayley-Dickson step with f64-checked f32 policy" >&2
            echo "  self-check       - run internal smoke tests" >&2
            exit 1
        fi

        case "$PATTERN" in
            vec_add|ossm_oct_step|sedenion_cd_step|self-check) ;;
            *)
                echo "error: unsupported Metal pattern '$PATTERN'" >&2
                echo "supported Metal patterns: vec_add, ossm_oct_step, sedenion_cd_step, self-check" >&2
                exit 1
                ;;
        esac

        if [[ -z "$OUT" ]]; then
            echo "error: -o <output> is required" >&2
            exit 1
        fi

        "$SOUC_BIN" "$DRIVER_SRC" "$DRIVER_ELF" >/dev/null 2>&1 || {
            echo "error: failed to compile Metal emitter driver" >&2
            exit 1
        }
        chmod +x "$DRIVER_ELF"

        "$DRIVER_ELF" "$PATTERN" > "$OUT"

        bytes=$(stat -c%s "$OUT" 2>/dev/null || stat -f%z "$OUT" 2>/dev/null || echo "?")
        echo "kretikos: MSL template emitted - $OUT ($bytes bytes)"

        # Structural validation for MSL compute shaders (skip for self-check)
        if [[ "$PATTERN" == "self-check" ]]; then
            if grep -q "PASS metal_self_check\|FAIL metal_self_check" "$OUT"; then
                echo "kretikos: self-check result captured in $OUT"
            else
                echo "kretikos: self-check result missing" >&2
                exit 1
            fi
        else
            if grep -q "#include <metal_stdlib>" "$OUT" && grep -q "kernel void" "$OUT" && grep -q "using namespace metal" "$OUT"; then
                echo "kretikos: structural validation OK - MSL compute markers present"
            else
                echo "kretikos: structural validation failed - MSL markers missing" >&2
                exit 1
            fi
        fi
        ;;

    emit-spirv)
        DRIVER_SRC="$ROOT_DIR/self-hosted/gpu/kretikos_emit_spirv.sio"
        OLD_UMASK="$(umask)"
        umask 077
        DRIVER_DIR="$(mktemp -d "${TMPDIR:-/tmp}/kretikos-emit-spirv.XXXXXX")" || {
            echo "error: failed to create temporary SPIR-V driver directory" >&2
            exit 1
        }
        umask "$OLD_UMASK"
        DRIVER_ELF="$DRIVER_DIR/driver.elf"
        trap 'rm -rf "$DRIVER_DIR"' EXIT INT TERM

        # Parse args: emit-spirv <pattern> -o <file>
        PATTERN=""
        OUT=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o|--output)
                    OUT="$2"
                    shift 2
                    ;;
                -*)
                    echo "error: unknown option $1" >&2
                    exit 1
                    ;;
                *)
                    if [[ -z "$PATTERN" ]]; then
                        PATTERN="$1"
                    else
                        echo "error: unexpected argument $1" >&2
                        exit 1
                    fi
                    shift
                    ;;
            esac
        done

        if [[ -z "$PATTERN" ]]; then
            echo "usage: kretikos emit-spirv <pattern> -o <file.spv>" >&2
            echo "" >&2
            echo "Supported patterns:" >&2
            echo "  exit_only  - minimal kernel that returns immediately" >&2
            echo "  vec_add    - kernel with GetTid + Add ops" >&2
            echo "  tid_kernel - kernel with GetTid only" >&2
            echo "  self-check - run SPIR-V self-check suite" >&2
            exit 1
        fi

        case "$PATTERN" in
            exit_only|vec_add|tid_kernel|self-check) ;;
            *)
                echo "error: unsupported SPIR-V pattern '$PATTERN'" >&2
                echo "supported SPIR-V patterns: exit_only, vec_add, tid_kernel, self-check" >&2
                exit 1
                ;;
        esac

        if [[ -z "$OUT" ]]; then
            echo "error: -o <output> is required" >&2
            exit 1
        fi

        "$SOUC_BIN" "$DRIVER_SRC" "$DRIVER_ELF" >/dev/null 2>&1 || {
            echo "error: failed to compile SPIR-V emitter driver" >&2
            exit 1
        }
        chmod +x "$DRIVER_ELF"

        "$DRIVER_ELF" "$PATTERN" > "$OUT"

        bytes=$(stat -c%s "$OUT" 2>/dev/null || stat -f%z "$OUT" 2>/dev/null || echo "?")
        echo "kretikos: SPIR-V template emitted - $OUT ($bytes bytes)"

        # Structural validation: first word must be SPIR-V magic (119734787 = 0x07230203)
        # Skip validation for self-check pattern (prints text, not SPIR-V words)
        if [[ "$PATTERN" != "self-check" ]]; then
            first_word="$(head -n1 "$OUT")"
            if [[ "$first_word" == "119734787" ]]; then
                echo "kretikos: structural validation OK - SPIR-V magic word present"
            else
                echo "kretikos: structural validation failed - SPIR-V magic word missing (got '$first_word')" >&2
                exit 1
            fi
        fi
        ;;

    emit-kaxi)
        DRIVER_SRC="$ROOT_DIR/self-hosted/gpu/kretikos_emit_kaxi.sio"
        OLD_UMASK="$(umask)"
        umask 077
        DRIVER_DIR="$(mktemp -d "${TMPDIR:-/tmp}/kretikos-emit-kaxi.XXXXXX")" || {
            echo "error: failed to create temporary K-AXI driver directory" >&2
            exit 1
        }
        umask "$OLD_UMASK"
        DRIVER_ELF="$DRIVER_DIR/driver.elf"
        trap 'rm -rf "$DRIVER_DIR"' EXIT INT TERM

        # Parse args: emit-kaxi <pattern> -o <file>
        PATTERN=""
        OUT=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o|--output)
                    OUT="$2"
                    shift 2
                    ;;
                -*)
                    echo "error: unknown option $1" >&2
                    exit 1
                    ;;
                *)
                    if [[ -z "$PATTERN" ]]; then
                        PATTERN="$1"
                    else
                        echo "error: unexpected argument $1" >&2
                        exit 1
                    fi
                    shift
                    ;;
            esac
        done

        if [[ -z "$PATTERN" ]]; then
            echo "usage: kretikos emit-kaxi <pattern> -o <file.kaxi>" >&2
            echo "" >&2
            echo "Supported patterns:" >&2
            echo "  exit_only                 - minimal kernel that returns immediately" >&2
            echo "  vec_add                   - kernel with GetTid + Add ops" >&2
            echo "  vec_sub                   - kernel with GetTid + Sub ops" >&2
            echo "  vec_mul                   - kernel with GetTid + Mul ops" >&2
            echo "  vec_div                   - kernel with GetTid + Div ops" >&2
            echo "  fma                       - kernel with GetTid + FMA ops" >&2
            echo "  source_vec_add_f32        - checked-source vec-add lowering sketch" >&2
            echo "  source_vec_sub_f32        - checked-source vec-sub lowering sketch" >&2
            echo "  source_vec_mul_f32        - checked-source vec-mul lowering sketch" >&2
            echo "  source_vec_div_f32        - checked-source vec-div lowering sketch" >&2
            echo "  source_fma_f32            - checked-source affine multiply-add sketch" >&2
            echo "  source_epistemic_dual_output_f32 - checked-source value+uncertainty lanes" >&2
            echo "  epistemic_elementwise_f32 - value+epsilon lane arithmetic sketch" >&2
            echo "  epistemic_dual_output_f32 - separate value/uncertainty output sketch" >&2
            echo "  self-check                - run K-AXI self-check suite" >&2
            exit 1
        fi

        case "$PATTERN" in
            exit_only|vec_add|vec_sub|vec_mul|vec_div|fma|source_vec_add_f32|source_vec_sub_f32|source_vec_mul_f32|source_vec_div_f32|source_fma_f32|source_epistemic_dual_output_f32|epistemic_elementwise_f32|epistemic_dual_output_f32|mb_vec_double_f32|self-check) ;;
            *)
                echo "error: unsupported K-AXI pattern '$PATTERN'" >&2
                echo "supported K-AXI patterns: exit_only, vec_add, vec_sub, vec_mul, vec_div, fma, source_vec_add_f32, source_vec_sub_f32, source_vec_mul_f32, source_vec_div_f32, source_fma_f32, source_epistemic_dual_output_f32, epistemic_elementwise_f32, epistemic_dual_output_f32, self-check" >&2
                exit 1
                ;;
        esac

        "$SOUC_BIN" "$DRIVER_SRC" "$DRIVER_ELF" >/dev/null 2>&1 || {
            echo "error: failed to compile K-AXI emitter driver" >&2
            exit 1
        }
        chmod +x "$DRIVER_ELF"

        if [[ "$PATTERN" == "self-check" ]]; then
            "$DRIVER_ELF" "$PATTERN"
            exit 0
        fi

        if [[ -z "$OUT" ]]; then
            echo "error: -o <output> is required" >&2
            exit 1
        fi

        "$DRIVER_ELF" "$PATTERN" > "$OUT"

        bytes=$(stat -c%s "$OUT" 2>/dev/null || stat -f%z "$OUT" 2>/dev/null || echo "?")
        echo "kretikos: K-AXI template emitted - $OUT ($bytes bytes)"

        # Structural validation: must contain K-AXI header
        if [[ "$PATTERN" != "self-check" ]]; then
            if grep -q "K-AXI epistemic kernel assembly" "$OUT"; then
                echo "kretikos: structural validation OK - K-AXI header present"
            else
                echo "kretikos: structural validation failed - K-AXI header missing" >&2
                exit 1
            fi
        fi
        ;;

    kaxi-emit-ptx)
        DRIVER_SRC="$ROOT_DIR/self-hosted/gpu/kretikos_kaxi_to_ptx.sio"
        OLD_UMASK="$(umask)"
        umask 077
        DRIVER_DIR="$(mktemp -d "${TMPDIR:-/tmp}/kretikos-kaxi-to-ptx.XXXXXX")" || {
            echo "error: failed to create temporary K-AXI→PTX driver directory" >&2
            exit 1
        }
        umask "$OLD_UMASK"
        DRIVER_ELF="$DRIVER_DIR/driver.elf"
        trap 'rm -rf "$DRIVER_DIR"' EXIT INT TERM

        PATTERN=""
        OUT=""
        VALIDATE_PTXAS=1
        EPISTEMIC=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o|--output)
                    OUT="$2"
                    shift 2
                    ;;
                --no-ptxas)
                    VALIDATE_PTXAS=0
                    shift
                    ;;
                --epistemic)
                    EPISTEMIC=1
                    shift
                    ;;
                -*)
                    echo "error: unknown option $1" >&2
                    exit 1
                    ;;
                *)
                    if [[ -z "$PATTERN" ]]; then
                        PATTERN="$1"
                    else
                        echo "error: unexpected argument $1" >&2
                        exit 1
                    fi
                    shift
                    ;;
            esac
        done

        if [[ -z "$PATTERN" || -z "$OUT" ]]; then
            echo "usage: kretikos kaxi-emit-ptx <pattern> -o <file.ptx> [--epistemic] [--no-ptxas]" >&2
            echo "" >&2
            echo "Lowers a K-AXI pattern through the kaxi_to_ptx transpiler to" >&2
            echo "ptxas-assemblable PTX (.target sm_50)." >&2
            echo "" >&2
            echo "Supported patterns (mirror of emit-kaxi):" >&2
            echo "  exit_only, vec_add, vec_sub, vec_mul, vec_div, fma" >&2
            echo "  source_{vec_add,vec_sub,vec_mul,vec_div,fma,epistemic_dual_output}_f32" >&2
            echo "  epistemic_elementwise_f32, epistemic_dual_output_f32" >&2
            exit 1
        fi

        case "$PATTERN" in
            exit_only|vec_add|vec_sub|vec_mul|vec_div|fma|source_vec_add_f32|source_vec_sub_f32|source_vec_mul_f32|source_vec_div_f32|source_fma_f32|source_epistemic_dual_output_f32|epistemic_elementwise_f32|epistemic_dual_output_f32|mb_vec_double_f32) ;;
            *)
                echo "error: unsupported K-AXI→PTX pattern '$PATTERN'" >&2
                exit 1
                ;;
        esac

        "$SOUC_BIN" "$DRIVER_SRC" "$DRIVER_ELF" >/dev/null 2>&1 || {
            echo "error: failed to compile K-AXI→PTX driver" >&2
            exit 1
        }
        chmod +x "$DRIVER_ELF"

        mkdir -p "$(dirname "$OUT")"
        if [[ "$EPISTEMIC" -eq 1 ]]; then
            "$DRIVER_ELF" "$PATTERN" epistemic > "$OUT"
        else
            "$DRIVER_ELF" "$PATTERN" > "$OUT"
        fi

        bytes=$(stat -c%s "$OUT" 2>/dev/null || stat -f%z "$OUT" 2>/dev/null || echo "?")
        if [[ "$EPISTEMIC" -eq 1 ]]; then
            echo "kretikos: K-AXI→PTX (epistemic) emitted - $OUT ($bytes bytes)"
        else
            echo "kretikos: K-AXI→PTX emitted - $OUT ($bytes bytes)"
        fi

        # Structural validation
        if ! grep -q ".visible .entry" "$OUT"; then
            echo "kretikos: structural validation failed - .visible .entry missing" >&2
            exit 1
        fi
        if ! grep -q "ret;" "$OUT"; then
            echo "kretikos: structural validation failed - ret; missing" >&2
            exit 1
        fi
        echo "kretikos: structural validation OK - PTX directives present"

        # ptxas validation
        if [[ "$VALIDATE_PTXAS" -eq 1 ]] && command -v ptxas >/dev/null 2>&1; then
            CUBIN_OUT="${OUT%.ptx}.cubin"
            if ptxas -arch=sm_50 -o "$CUBIN_OUT" "$OUT" 2>"$DRIVER_DIR/ptxas.err"; then
                cubin_bytes=$(stat -c%s "$CUBIN_OUT" 2>/dev/null || stat -f%z "$CUBIN_OUT" 2>/dev/null || echo "?")
                echo "kretikos: ptxas validation OK - $CUBIN_OUT ($cubin_bytes bytes, sm_50)"
            else
                echo "kretikos: ptxas validation FAILED" >&2
                cat "$DRIVER_DIR/ptxas.err" >&2
                exit 1
            fi
        fi
        ;;

    kaxi-witness)
        PATTERN=""
        OUT=""
        ASM_OUT=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o|--output)
                    OUT="$2"
                    shift 2
                    ;;
                --asm-output)
                    ASM_OUT="$2"
                    shift 2
                    ;;
                -*)
                    echo "error: unknown option $1" >&2
                    exit 1
                    ;;
                *)
                    if [[ -z "$PATTERN" ]]; then
                        PATTERN="$1"
                    else
                        echo "error: unexpected argument $1" >&2
                        exit 1
                    fi
                    shift
                    ;;
            esac
        done

        if [[ -z "$PATTERN" || -z "$OUT" ]]; then
            echo "usage: kretikos kaxi-witness <pattern> -o <file.json> [--asm-output <file.kaxi>]" >&2
            echo "supported K-AXI witness patterns: exit_only, vec_add, vec_sub, vec_mul, vec_div, fma, source_vec_add_f32, source_vec_sub_f32, source_vec_mul_f32, source_vec_div_f32, source_fma_f32, source_epistemic_dual_output_f32, epistemic_elementwise_f32, epistemic_dual_output_f32" >&2
            exit 1
        fi

        case "$PATTERN" in
            exit_only|vec_add|vec_sub|vec_mul|vec_div|fma|source_vec_add_f32|source_vec_sub_f32|source_vec_mul_f32|source_vec_div_f32|source_fma_f32|source_epistemic_dual_output_f32|epistemic_elementwise_f32|epistemic_dual_output_f32) ;;
            *)
                echo "error: unsupported K-AXI witness pattern '$PATTERN'" >&2
                echo "supported K-AXI witness patterns: exit_only, vec_add, vec_sub, vec_mul, vec_div, fma, source_vec_add_f32, source_vec_sub_f32, source_vec_mul_f32, source_vec_div_f32, source_fma_f32, source_epistemic_dual_output_f32, epistemic_elementwise_f32, epistemic_dual_output_f32" >&2
                exit 1
                ;;
        esac

        if [[ -z "$ASM_OUT" ]]; then
            case "$OUT" in
                *.json) ASM_OUT="${OUT%.json}.kaxi" ;;
                *) ASM_OUT="$OUT.kaxi" ;;
            esac
        fi

        mkdir -p "$(dirname "$OUT")" "$(dirname "$ASM_OUT")"
        LOG_OUT="${OUT}.emit.log"
        "$0" emit-kaxi "$PATTERN" -o "$ASM_OUT" >"$LOG_OUT" 2>&1 || {
            cat "$LOG_OUT" >&2
            echo "error: failed to emit K-AXI assembly for witness pattern '$PATTERN'" >&2
            exit 1
        }

        python3 - "$PATTERN" "$ASM_OUT" "$OUT" "$LOG_OUT" <<'PY'
import hashlib
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

pattern, asm_path, out_path, log_path = sys.argv[1:]
asm = Path(asm_path)
out = Path(out_path)
log = Path(log_path)
text = asm.read_text(encoding="utf-8")
raw_lines = text.splitlines()
instructions = [line.strip() for line in raw_lines if line.strip() and not line.lstrip().startswith(";")]
opcodes = [line.split()[0] for line in instructions]
seqs = []
for line in instructions:
    match = re.search(r"seq=([0-9]+)", line)
    if match:
        seqs.append(int(match.group(1)))

def contains(prefix):
    return any(line.startswith(prefix) for line in instructions)

def count(prefix):
    return sum(1 for line in instructions if line.startswith(prefix))

expectations = {
    "exit_only": {
        "required": ["ret"],
        "forbidden": ["add", "sub", "mul", "div", "fma", "store_global"],
        "semantic": "control_minimal",
    },
    "vec_add": {
        "required": ["get_tid", "add", "ret"],
        "forbidden": [],
        "semantic": "value_lane_add",
    },
    "vec_sub": {
        "required": ["get_tid", "sub", "ret"],
        "forbidden": [],
        "semantic": "value_lane_sub",
    },
    "vec_mul": {
        "required": ["get_tid", "mul", "ret"],
        "forbidden": [],
        "semantic": "value_lane_mul",
    },
    "vec_div": {
        "required": ["get_tid", "div", "ret"],
        "forbidden": [],
        "semantic": "value_lane_div",
    },
    "fma": {
        "required": ["get_tid", "fma", "ret"],
        "forbidden": [],
        "semantic": "value_lane_fma",
    },
    "source_vec_add_f32": {
        "required": ["get_tid", "load_global", "add", "store_global", "ret"],
        "forbidden": [],
        "semantic": "lowered_indexed_f32_vector_add",
    },
    "source_vec_sub_f32": {
        "required": ["get_tid", "load_global", "sub", "store_global", "ret"],
        "forbidden": [],
        "semantic": "lowered_indexed_f32_vector_sub",
    },
    "source_vec_mul_f32": {
        "required": ["get_tid", "load_global", "mul", "store_global", "ret"],
        "forbidden": [],
        "semantic": "lowered_indexed_f32_vector_mul",
    },
    "source_vec_div_f32": {
        "required": ["get_tid", "load_global", "div", "store_global", "ret"],
        "forbidden": [],
        "semantic": "lowered_indexed_f32_vector_div",
    },
    "source_fma_f32": {
        "required": ["get_tid", "load_global", "mul", "add", "store_global", "ret"],
        "forbidden": [],
        "semantic": "lowered_indexed_f32_affine_mad",
    },
    "source_epistemic_dual_output_f32": {
        "required": ["get_tid", "load_global", "add", "mul", "store_global", "ret"],
        "forbidden": [],
        "semantic": "lowered_epistemic_dual_value_uncertainty_outputs",
    },
    "epistemic_elementwise_f32": {
        "required": ["get_tid", "load_global", "fma", "store_global", "ret"],
        "forbidden": [],
        "semantic": "value_with_epsilon_lane",
    },
    "epistemic_dual_output_f32": {
        "required": ["get_tid", "load_global", "add", "mul", "store_global", "ret"],
        "forbidden": [],
        "semantic": "separate_value_and_uncertainty_outputs",
    },
}
spec = expectations[pattern]
missing = [name for name in spec["required"] if not contains(name)]
forbidden_present = [name for name in spec["forbidden"] if contains(name)]
seq_monotonic = seqs == list(range(len(seqs)))
variance_lines = [line for line in instructions if "var=+" in line or "var=0%" in line]
stores = [line for line in instructions if line.startswith("store_global")]
value_lane = ""
uncertainty_lane = ""
if pattern == "epistemic_dual_output_f32":
    value_lane = next((line for line in instructions if line.startswith("add ")), "")
    uncertainty_lane = next((line for line in instructions if line.startswith("mul ")), "")
elif pattern == "epistemic_elementwise_f32":
    value_lane = next((line for line in instructions if line.startswith("fma ")), "")
elif pattern == "source_vec_add_f32":
    value_lane = next((line for line in instructions if line.startswith("add ")), "")
elif pattern == "source_vec_sub_f32":
    value_lane = next((line for line in instructions if line.startswith("sub ")), "")
elif pattern == "source_vec_mul_f32":
    value_lane = next((line for line in instructions if line.startswith("mul ")), "")
elif pattern == "source_vec_div_f32":
    value_lane = next((line for line in instructions if line.startswith("div ")), "")
elif pattern == "source_fma_f32":
    value_lane = next((line for line in instructions if line.startswith("add ")), "")
elif pattern == "source_epistemic_dual_output_f32":
    add_lines = [line for line in instructions if line.startswith("add ")]
    value_lane = add_lines[0] if add_lines else ""
    uncertainty_lane = add_lines[1] if len(add_lines) > 1 else next((line for line in instructions if line.startswith("mul ")), "")
elif pattern in {"vec_add", "vec_sub", "vec_mul", "vec_div", "fma"}:
    value_lane = next((line for line in instructions if line.startswith(spec["required"][1] + " ")), "")

failures = []
if missing:
    failures.append({"kind": "missing_required_opcode", "opcodes": missing})
if forbidden_present:
    failures.append({"kind": "forbidden_opcode_present", "opcodes": forbidden_present})
if not seq_monotonic:
    failures.append({"kind": "sequence_not_dense_zero_based", "seqs": seqs})
if pattern.startswith("epistemic_") and not variance_lines:
    failures.append({"kind": "missing_variance_annotations"})
if pattern == "epistemic_dual_output_f32" and len(stores) < 2:
    failures.append({"kind": "dual_output_requires_two_store_global_ops", "stores": stores})
if pattern == "source_epistemic_dual_output_f32" and len(stores) < 2:
    failures.append({"kind": "dual_output_requires_two_store_global_ops", "stores": stores})

payload = {
    "schema": "sounio.kretikos.kaxi-witness.v1",
    "generated_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "status": "pass" if not failures else "fail",
    "pattern": pattern,
    "semantic_profile": spec["semantic"],
    "assembly": {
        "path": str(asm),
        "bytes": asm.stat().st_size,
        "sha256": hashlib.sha256(asm.read_bytes()).hexdigest(),
        "instruction_count": len(instructions),
        "opcodes": opcodes,
        "seqs": seqs,
        "seq_dense_zero_based": seq_monotonic,
        "variance_annotation_count": len(variance_lines),
    },
    "epistemic_lanes": {
        "value_lane_instruction": value_lane,
        "uncertainty_lane_instruction": uncertainty_lane,
        "store_global_count": len(stores),
    },
    "emitter_log": str(log),
    "failures": failures,
    "boundaries": [
        "witness_is_profile_level_for_explicit_kretikos_patterns",
        "witness_proves_kaxi_assembly_shape_and_dense_sequence_numbers",
        "witness_does_not_claim_arbitrary_sounio_gpu_lowering",
        "witness_does_not_replace_slurm_cuda_runtime_authority",
    ],
}
out.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if failures:
    raise SystemExit(json.dumps(failures))
PY

        echo "kretikos: K-AXI witness emitted - $OUT"
        echo "kretikos: K-AXI witness assembly - $ASM_OUT"
        ;;

    kaxi-source-witness)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos kaxi-source-witness <source.sio> -o <file.json> [--asm-output <file.kaxi>] [--kaxi-witness-output <file.json>]" >&2
            exit 1
        fi
        SRC="$1"
        shift
        OUT=""
        ASM_OUT=""
        KAXI_WITNESS_OUT=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o|--output)
                    OUT="$2"
                    shift 2
                    ;;
                --asm-output)
                    ASM_OUT="$2"
                    shift 2
                    ;;
                --kaxi-witness-output)
                    KAXI_WITNESS_OUT="$2"
                    shift 2
                    ;;
                -*)
                    echo "error: unknown option $1" >&2
                    exit 1
                    ;;
                *)
                    echo "error: unexpected argument $1" >&2
                    exit 1
                    ;;
            esac
        done

        if [[ -z "$OUT" ]]; then
            echo "usage: kretikos kaxi-source-witness <source.sio> -o <file.json> [--asm-output <file.kaxi>] [--kaxi-witness-output <file.json>]" >&2
            exit 1
        fi
        if [[ ! -f "$SRC" ]]; then
            echo "error: source not found: $SRC" >&2
            exit 1
        fi

        case "$OUT" in
            *.json) OUT_STEM="${OUT%.json}" ;;
            *) OUT_STEM="$OUT" ;;
        esac
        if [[ -z "$ASM_OUT" ]]; then
            ASM_OUT="${OUT_STEM}.kaxi"
        fi
        if [[ -z "$KAXI_WITNESS_OUT" ]]; then
            KAXI_WITNESS_OUT="${OUT_STEM}.kaxi-witness.json"
        fi

        mkdir -p "$(dirname "$OUT")" "$(dirname "$ASM_OUT")" "$(dirname "$KAXI_WITNESS_OUT")"
        CHECK_LOG="${OUT}.check.log"
        __kretikos_check_source "$SRC" >"$CHECK_LOG" 2>&1 || {
            cat "$CHECK_LOG" >&2
            echo "error: source check failed before K-AXI source witness: $SRC" >&2
            exit 1
        }

        record="$(__kretikos_source_profile_record "$SRC")"
        IFS='|' read -r PROFILE CUBIN_KIND RUNTIME_RUNG KERNEL_NAME CLASS PTX_PATTERN RUNTIME_BACKED <<<"$record"
        case "$PROFILE" in
            vec_add_f32)
                KAXI_PATTERN="vec_add"
                ;;
            vec_sub_f32)
                KAXI_PATTERN="vec_sub"
                ;;
            vec_mul_f32)
                KAXI_PATTERN="vec_mul"
                ;;
            vec_div_f32)
                KAXI_PATTERN="vec_div"
                ;;
            fma_f32)
                KAXI_PATTERN="fma"
                ;;
            epistemic_elementwise_f32)
                KAXI_PATTERN="epistemic_elementwise_f32"
                ;;
            epistemic_dual_output_f32)
                KAXI_PATTERN="epistemic_dual_output_f32"
                ;;
            *)
                echo "error: K-AXI source witness does not yet support profile '$PROFILE'" >&2
                echo "supported source profiles for K-AXI witness: vec_add_f32, vec_sub_f32, vec_mul_f32, vec_div_f32, fma_f32, epistemic_elementwise_f32, epistemic_dual_output_f32" >&2
                exit 1
                ;;
        esac

        "$KRETIKOS_SELF" kaxi-witness "$KAXI_PATTERN" -o "$KAXI_WITNESS_OUT" --asm-output "$ASM_OUT" >/dev/null

        SOURCE_SHA="$(__kretikos_sha256 "$SRC")" || exit 1
        SOURCE_BYTES="$(__kretikos_file_size "$SRC")" || exit 1
        SOURCE_PATH="$(__kretikos_repo_path "$(cd "$(dirname "$SRC")" && pwd)/$(basename "$SRC")")"
        CHECK_SHA="$(__kretikos_sha256 "$CHECK_LOG")" || exit 1
        CHECK_BYTES="$(__kretikos_file_size "$CHECK_LOG")" || exit 1
        KAXI_WITNESS_SHA="$(__kretikos_sha256 "$KAXI_WITNESS_OUT")" || exit 1

        python3 - "$OUT" "$SOURCE_PATH" "$SOURCE_BYTES" "$SOURCE_SHA" \
            "$CHECK_LOG" "$CHECK_BYTES" "$CHECK_SHA" \
            "$PROFILE" "$CUBIN_KIND" "$RUNTIME_RUNG" "$KERNEL_NAME" "$RUNTIME_BACKED" "$KAXI_PATTERN" \
            "$KAXI_WITNESS_OUT" "$KAXI_WITNESS_SHA" <<'PY'
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

(
    out_path,
    source_path,
    source_bytes,
    source_sha,
    check_log,
    check_bytes,
    check_sha,
    profile,
    cubin_kind,
    runtime_rung,
    kernel_name,
    runtime_backed,
    kaxi_pattern,
    kaxi_witness_path,
    kaxi_witness_sha,
) = sys.argv[1:]

witness_path = Path(kaxi_witness_path)
witness = json.loads(witness_path.read_text(encoding="utf-8"))
failures = []
if witness.get("status") != "pass":
    failures.append({"kind": "kaxi_witness_status_not_pass", "status": witness.get("status")})
if witness.get("failures"):
    failures.append({"kind": "kaxi_witness_failures", "failures": witness.get("failures")})
if not witness.get("assembly", {}).get("seq_dense_zero_based"):
    failures.append({"kind": "kaxi_sequence_not_dense_zero_based"})

payload = {
    "schema": "sounio.kretikos.kaxi-source-witness.v1",
    "generated_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "status": "pass" if not failures else "fail",
    "source": {
        "path": source_path,
        "bytes": int(source_bytes),
        "sha256": source_sha,
        "check": {
            "status": "pass",
            "log_path": check_log,
            "bytes": int(check_bytes),
            "sha256": check_sha,
        },
    },
    "profile": {
        "name": profile,
        "runtime_backed": runtime_backed == "1",
        "cubin_kind": cubin_kind,
        "runtime_rung": runtime_rung,
        "kernel": kernel_name,
    },
    "kaxi": {
        "pattern": kaxi_pattern,
        "semantic_profile": witness.get("semantic_profile"),
        "witness_path": str(witness_path),
        "witness_sha256": kaxi_witness_sha,
        "assembly": witness.get("assembly", {}),
        "epistemic_lanes": witness.get("epistemic_lanes", {}),
    },
    "failures": failures,
    "boundaries": [
        "source_must_typecheck_before_kaxi_profile_selection",
        "source_profile_selection_is_explicit_or_shape_limited",
        "source_witness_links_source_hash_to_kaxi_witness_hash",
        "source_witness_does_not_claim_arbitrary_sounio_gpu_lowering",
        "source_witness_does_not_replace_slurm_cuda_runtime_authority",
    ],
}
Path(out_path).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if failures:
    raise SystemExit(json.dumps(failures))
PY

        echo "kretikos: K-AXI source witness emitted - $OUT"
        echo "kretikos: K-AXI source witness profile - source=$SOURCE_PATH profile=$PROFILE kaxi_pattern=$KAXI_PATTERN"
        ;;

    kaxi-lower-source)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos kaxi-lower-source <source.sio> -o <file.json> [--asm-output <file.kaxi>] [--kaxi-witness-output <file.json>]" >&2
            exit 1
        fi
        SRC="$1"
        shift
        OUT=""
        ASM_OUT=""
        KAXI_WITNESS_OUT=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o|--output)
                    OUT="$2"
                    shift 2
                    ;;
                --asm-output)
                    ASM_OUT="$2"
                    shift 2
                    ;;
                --kaxi-witness-output)
                    KAXI_WITNESS_OUT="$2"
                    shift 2
                    ;;
                -*)
                    echo "error: unknown option $1" >&2
                    exit 1
                    ;;
                *)
                    echo "error: unexpected argument $1" >&2
                    exit 1
                    ;;
            esac
        done

        if [[ -z "$OUT" ]]; then
            echo "usage: kretikos kaxi-lower-source <source.sio> -o <file.json> [--asm-output <file.kaxi>] [--kaxi-witness-output <file.json>]" >&2
            exit 1
        fi
        if [[ ! -f "$SRC" ]]; then
            echo "error: source not found: $SRC" >&2
            exit 1
        fi

        case "$OUT" in
            *.json) OUT_STEM="${OUT%.json}" ;;
            *) OUT_STEM="$OUT" ;;
        esac
        if [[ -z "$ASM_OUT" ]]; then
            ASM_OUT="${OUT_STEM}.kaxi"
        fi
        if [[ -z "$KAXI_WITNESS_OUT" ]]; then
            KAXI_WITNESS_OUT="${OUT_STEM}.kaxi-witness.json"
        fi
        RECOGNITION_OUT="${OUT_STEM}.recognition.json"

        mkdir -p "$(dirname "$OUT")" "$(dirname "$ASM_OUT")" "$(dirname "$KAXI_WITNESS_OUT")" "$(dirname "$RECOGNITION_OUT")"
        CHECK_LOG="${OUT}.check.log"
        __kretikos_check_source "$SRC" >"$CHECK_LOG" 2>&1 || {
            cat "$CHECK_LOG" >&2
            echo "error: source check failed before K-AXI source lowering: $SRC" >&2
            exit 1
        }

        python3 - "$SRC" "$RECOGNITION_OUT" <<'PY' || {
