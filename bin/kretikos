#!/bin/bash
# Kretikos GPU Compiler — bounded GPU compilation wrapper
#
# Kretikos (Κρητικός) = Cretan. Like Ariadne's thread through the Labyrinth,
# this compiler is the named path for Sounio's GPU work: source-level thread
# builtins today, PTX artifact emission when the GPU profile compiler is present,
# and an in-tree Sounio-owned CUBIN emitter surface under self-hosted/gpu/.
#
# Usage:
#   kretikos check <source.sio>          — compile-check a GPU kernel source file
#   kretikos run <source.sio>            — native CPU fallback, serial thread IDs
#   kretikos build <source.sio> -o <out> — PTX via checked GPU artifact if present
#   kretikos emit-cubin                  — list Sounio-owned CUBIN preview surface
#
# GPU builtins recognized in kernel fn bodies:
#   gpu_thread_id_x()  gpu_thread_id_y()  gpu_thread_id_z()
#   gpu_block_id_x()   gpu_block_id_y()   gpu_block_id_z()
#   gpu_block_dim_x()  gpu_block_dim_y()  gpu_block_dim_z()
#   gpu_sync_threads()

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Resolve the compiler binary
SOUC_BIN="${SOUNIO_KRETIKOS_COMPILER:-$SCRIPT_DIR/souc-linux-x86_64}"
if [[ ! -x "$SOUC_BIN" ]]; then
    SOUC_BIN="$SCRIPT_DIR/souc"
fi
if [[ ! -x "$SOUC_BIN" ]]; then
    echo "error: Kretikos compiler not found. Set SOUNIO_KRETIKOS_COMPILER." >&2
    exit 1
fi

export SOUNIO_STDLIB_PATH="${SOUNIO_STDLIB_PATH:-$ROOT_DIR/stdlib}"

CMD="${1:-}"
shift 2>/dev/null || true

case "$CMD" in
    check)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos check <source.sio>" >&2
            exit 1
        fi
        "$SOUC_BIN" "$1" /tmp/kretikos-check.elf >/dev/null 2>&1
        echo "kretikos: check OK — GPU builtin surface accepted"
        echo "kretikos: CPU fallback is serial: thread/block IDs are deterministic stubs"
        ;;
    run)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos run <source.sio>" >&2
            exit 1
        fi
        OUT="/tmp/kretikos-run.elf"
        rm -f "$OUT"
        "$SOUC_BIN" "$1" "$OUT"
        chmod +x "$OUT"
        "$OUT"
        ;;
    build)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos build <source.sio> [options] -o <output.ptx>" >&2
        echo "note: requires artifacts/omega/souc-bin/souc-linux-x86_64-gpu" >&2
            exit 1
        fi
        SRC="$1"
        shift
        # Delegate to checked GPU artifact if available
        GPU_ARTIFACT="$ROOT_DIR/artifacts/omega/souc-bin/souc-linux-x86_64-gpu"
        if [[ -x "$GPU_ARTIFACT" ]]; then
            "$GPU_ARTIFACT" build "$SRC" --backend gpu "$@"
        else
            echo "error: GPU artifact not found at $GPU_ARTIFACT" >&2
            echo "hint: 'kretikos run' executes a serial native CPU fallback, not GPU simulation" >&2
            exit 1
        fi
        ;;
    emit-cubin)
        echo "kretikos: Sounio-owned CUBIN emitter preview"
        echo "Current kernel surfaces in self-hosted/gpu/nvidia_bare.sio:"
        echo "  exit_only              — minimal kernel that returns immediately"
        echo "  store_u32_const        — stores a constant u32 to output"
        echo "  vec_add_f32            — f32 vector addition (SM80)"
        echo "  epistemic_dual_f32     — epistemic dual-lane f32 output"
        echo ""
        echo "Direct CLI emission is not wired yet."
        echo "For now, compile self-hosted/gpu/nvidia_bare.sio with a main()"
        echo "that calls gpu_bare_emit_sm80_<kind>_cubin() and writes bytes."
        ;;
    info)
        echo "Kretikos GPU Compiler"
        echo "====================="
        echo "Compiler: $SOUC_BIN"
        echo "Stdlib:   $SOUNIO_STDLIB_PATH"
        echo ""
        echo "GPU builtin surface:"
        echo "  gpu_thread_id_x()        — x-axis thread index"
        echo "  gpu_block_id_x()         — x-axis block index"
        echo "  gpu_block_dim_x()        — x-axis threads per block"
        echo "  gpu_thread_id_y/z()      — recognized; CPU fallback returns 0"
        echo "  gpu_block_id_y/z()       — recognized; CPU fallback returns 0"
        echo "  gpu_block_dim_y/z()      — recognized; CPU fallback returns 1"
        echo "  gpu_sync_threads()       — recognized; CPU fallback is a no-op"
        echo ""
        echo "PTX backend:     self-hosted/gpu/ptx_advanced.sio"
        echo "CUBIN backend:   self-hosted/gpu/nvidia_bare.sio"
        echo "SPIR-V backend:  self-hosted/gpu/spirv_lower.sio"
        ;;
    *)
        echo "Kretikos GPU Compiler — bounded GPU compilation"
        echo ""
        echo "Usage: kretikos <command> [args]"
        echo ""
        echo "Commands:"
        echo "  check <source.sio>       Compile-check a GPU kernel source file"
        echo "  run <source.sio>         Native CPU fallback, serial thread IDs"
        echo "  build <source.sio> -o <out>  Emit PTX via checked GPU artifact if present"
        echo "  emit-cubin               List Sounio-owned CUBIN preview surface"
        echo "  info                     Show compiler configuration"
        echo ""
        echo "Environment:"
        echo "  SOUNIO_KRETIKOS_COMPILER — path to souc binary"
        echo "  SOUNIO_STDLIB_PATH       — path to stdlib directory"
        exit 1
        ;;
esac
