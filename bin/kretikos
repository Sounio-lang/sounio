                if [[ -z "$KRETIKOS_CC" || ! -x "$(command -v "$KRETIKOS_CC" 2>/dev/null || true)" ]]; then
                    KRETIKOS_CC=""
                    for candidate in cc gcc clang; do
                        if command -v "$candidate" >/dev/null 2>&1; then
                            KRETIKOS_CC="$(command -v "$candidate")"
                            break
                        fi
                    done
                fi
                if [[ -z "$KRETIKOS_CC" ]]; then
                    RUNTIME_STATUS="not_run"
                    RUNTIME_REASON="c_compiler_missing"
                    if [[ "$RUNTIME_MODE" == "required" ]]; then
                        echo "kretikos: required runtime validation failed - C compiler missing" >&2
                        exit 1
                    fi
                elif [[ ! -f "$ROOT_DIR/scripts/gpu/nvidia_bare_driver_loader.c" ]]; then
                    RUNTIME_STATUS="not_run"
