                    RUNTIME_STATUS="fail"
                    RUNTIME_REASON="runtime_status_parse_failed"
                fi
                if [[ "$RUNTIME_STATUS" == "fail" ]]; then
                    echo "kretikos: runtime validation $RUNTIME_STATUS - $RUNTIME_REASON; see $RUNTIME_LOG_OUT" >&2
                fi
                if [[ "$RUNTIME_MODE" == "required" && "$RUNTIME_STATUS" != "pass" ]]; then
                    echo "kretikos: runtime validation $RUNTIME_STATUS - $RUNTIME_REASON; see $RUNTIME_LOG_OUT" >&2
                    exit 1
                fi
            fi
        fi
