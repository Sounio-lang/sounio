        echo "kretikos: K-AXI certificate emitted - $OUT"
        echo "kretikos: K-AXI certificate work dir - $WORK_DIR"
        ;;

    emulate)
        DRIVER_SRC="$ROOT_DIR/self-hosted/gpu/kretikos_emulate.sio"
        OLD_UMASK="$(umask)"
        umask 077
        DRIVER_DIR="$(mktemp -d "${TMPDIR:-/tmp}/kretikos-emulate.XXXXXX")" || {
            echo "error: failed to create temporary emulation directory" >&2
            exit 1
        }
        umask "$OLD_UMASK"
        DRIVER_ELF="$DRIVER_DIR/driver.elf"
        trap 'rm -rf "$DRIVER_DIR"' EXIT INT TERM

        "$SOUC_BIN" "$DRIVER_SRC" "$DRIVER_ELF" >/dev/null 2>&1 || {
            echo "error: failed to compile CPU emulation driver" >&2
            exit 1
        }
        chmod +x "$DRIVER_ELF"

        "$DRIVER_ELF"
        ;;

    emit-cubin)
        DRIVER_SRC="$ROOT_DIR/self-hosted/gpu/kretikos_emit_cubin.sio"
        OLD_UMASK="$(umask)"
        umask 077
        DRIVER_DIR="$(mktemp -d "${TMPDIR:-/tmp}/kretikos-emit-cubin.XXXXXX")" || {
            echo "error: failed to create temporary CUBIN driver directory" >&2
            exit 1
        }
        umask "$OLD_UMASK"
        DRIVER_ELF="$DRIVER_DIR/driver.elf"
        trap 'rm -rf "$DRIVER_DIR"' EXIT INT TERM

        # Parse args: emit-cubin <kind> -o <file> [--validate-toolchain]
        KIND=""
        OUT=""
        VALIDATE_TOOLCHAIN=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o|--output)
                    OUT="$2"
                    shift 2
                    ;;
                --validate-toolchain)
                    VALIDATE_TOOLCHAIN=1
                    shift
                    ;;
                -*)
                    echo "error: unknown option $1" >&2
                    exit 1
                    ;;
                *)
                    if [[ -z "$KIND" ]]; then
                        KIND="$1"
                    else
                        echo "error: unexpected argument $1" >&2
                        exit 1
                    fi
                    shift
                    ;;
            esac
        done

        if [[ -n "$VALIDATE_TOOLCHAIN" ]]; then
            if ! command -v nvcc >/dev/null 2>&1; then
                echo "error: --validate-toolchain requires nvcc, but it was not found" >&2
                echo "hint: run 'kretikos detect-cuda' to check your CUDA installation" >&2
                exit 1
            fi
            echo "kretikos: toolchain validation OK - nvcc found"
        fi

        if [[ -z "$KIND" ]]; then
            echo "usage: kretikos emit-cubin <kind> -o <file.cubin>" >&2
            echo "" >&2
            echo "Supported kinds:" >&2
            echo "  exit_only          - minimal kernel that returns immediately" >&2
            echo "  store_u32_const    - stores a constant u32 to output" >&2
            echo "  vec_add_f32        - f32 vector addition (SM80)" >&2
            echo "  vec_add_f64        - f64 vector addition (SM80)" >&2
            echo "  vec_sub_f64        - f64 vector subtraction (SM80)" >&2
            echo "  vec_mul_f64        - f64 vector multiplication (SM80)" >&2
            echo "  vec_div_f64        - f64 vector division (SM80)" >&2
            echo "  fma_f64            - f64 fused multiply-add (SM80)" >&2
            echo "  vec_sub_f32        - f32 vector subtraction (SM80)" >&2
            echo "  vec_mul_f32        - f32 vector multiplication (SM80)" >&2
            echo "  vec_div_f32        - f32 vector division (SM80)" >&2
            echo "  fma_f32            - f32 affine fused multiply-add (SM80)" >&2
            echo "  epistemic_dual_f32 - epistemic dual-lane f32 output (SM80)" >&2
            exit 1
        fi

        case "$KIND" in
            exit_only|store_u32_const|vec_add_f32|vec_add_f64|vec_sub_f64|vec_mul_f64|vec_div_f64|fma_f64|vec_sub_f32|vec_mul_f32|vec_div_f32|fma_f32|epistemic_dual_f32) ;;
            *)
                echo "error: unsupported CUBIN kind '$KIND'" >&2
                echo "supported CUBIN kinds: exit_only, store_u32_const, vec_add_f32, vec_add_f64, vec_sub_f64, vec_mul_f64, vec_div_f64, fma_f64, vec_sub_f32, vec_mul_f32, vec_div_f32, fma_f32, epistemic_dual_f32" >&2
                exit 1
                ;;
        esac

        DRIVER_KIND="$KIND"
        PATCH_CUBIN_SYMBOL="none"
        if [[ "$KIND" == "vec_div_f32" ]]; then
            DRIVER_KIND="fma_f32"
            PATCH_CUBIN_SYMBOL="fma_to_div"
        fi

        if [[ -z "$OUT" ]]; then
            echo "error: -o <output> is required" >&2
            exit 1
        fi

        case "$KIND" in
            vec_add_f64|vec_sub_f64|vec_mul_f64|vec_div_f64|fma_f64)
            python3 - "$ROOT_DIR/self-hosted/gpu/nvidia_bare.sio" "$OUT" "$KIND" <<'PY'
from pathlib import Path
import re
import sys

src, out_path, kind = sys.argv[1:]
profiles = {
    "vec_add_f64": ("gpu_bare_sm80_vec_add_f64", 49, 3112, b"sounio_bare_vec_add_f64_sm80"),
    "vec_sub_f64": ("gpu_bare_sm80_vec_sub_f64", 49, 3112, b"sounio_bare_vec_sub_f64_sm80"),
    "vec_mul_f64": ("gpu_bare_sm80_vec_mul_f64", 49, 3112, b"sounio_bare_vec_mul_f64_sm80"),
    "vec_div_f64": ("gpu_bare_sm80_vec_div_f64", 81, 5160, b"sounio_bare_vec_div_f64_sm80"),
    "fma_f64": ("gpu_bare_sm80_fma_f64", 49, 3112, b"sounio_bare_vec_fma_f64_sm80"),
}
try:
    prefix, expected_chunks, expected_len, expected_symbol = profiles[kind]
except KeyError:
    raise SystemExit(f"unsupported f64 CUBIN chunk kind: {kind}")
text = Path(src).read_text(encoding="utf-8")
match = re.search(
    rf"fn {prefix}_cubin_hex_chunk\(i: i64\) -> string \{{(.*?)\n\}}\n\nfn ",
    text,
    re.S,
)
if not match:
    raise SystemExit(f"{kind} CUBIN chunk function not found")
chunks = re.findall(r'"([0-9a-fA-F]+)"', match.group(1))
if len(chunks) != expected_chunks:
    raise SystemExit(f"expected {expected_chunks} {kind} CUBIN chunks, found {len(chunks)}")
data = bytes.fromhex("".join(chunks))
if len(data) != expected_len:
    raise SystemExit(f"expected {expected_len} {kind} CUBIN bytes, found {len(data)}")
if data[:4] != b"\x7fELF" or data[4] != 2:
    raise SystemExit(f"{kind} CUBIN is not ELF64")
if int.from_bytes(data[18:20], "little") != 190:
    raise SystemExit(f"{kind} CUBIN e_machine is not NVIDIA CUDA")
if expected_symbol not in data:
    raise SystemExit(f"{kind} CUBIN symbol missing")
Path(out_path).write_bytes(data)
PY
            ;;
            *)
        "$SOUC_BIN" "$DRIVER_SRC" "$DRIVER_ELF" >/dev/null 2>&1 || {
            echo "error: failed to compile CUBIN emitter driver" >&2
            exit 1
        }
        chmod +x "$DRIVER_ELF"

        # Run driver -> decimal bytes on stdout -> python -> binary file
        "$DRIVER_ELF" "$DRIVER_KIND" | python3 -c "import sys
out = bytearray()
for raw in sys.stdin:
    line = raw.strip()
    if not line:
        continue
    try:
        value = int(line)
    except ValueError:
        raise SystemExit(f'non-integer byte emitted: {line!r}')
    if value < 0 or value > 255:
        raise SystemExit(f'byte out of range: {value}')
    out.append(value)
sys.stdout.buffer.write(bytes(out))" > "$OUT"

        if [[ "$PATCH_CUBIN_SYMBOL" == "fma_to_div" ]]; then
            python3 - "$OUT" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
data = path.read_bytes()
replacements = [
    (b".nv.info.sounio_bare_vec_fma_f32_sm80", b".nv.info.sounio_bare_vec_div_f32_sm80"),
    (b".nv.constant0.sounio_bare_vec_fma_f32_sm80", b".nv.constant0.sounio_bare_vec_div_f32_sm80"),
    (b".text.sounio_bare_vec_fma_f32_sm80", b".text.sounio_bare_vec_div_f32_sm80"),
    (b"sounio_bare_vec_fma_f32_sm80", b"sounio_bare_vec_div_f32_sm80"),
]
for old, new in replacements:
    if len(old) != len(new):
        raise SystemExit("internal CUBIN patch length mismatch")
    if old not in data:
        raise SystemExit(f"internal CUBIN patch target missing: {old!r}")
    data = data.replace(old, new)
if b"sounio_bare_vec_fma_f32_sm80" in data:
    raise SystemExit("internal CUBIN patch left stale fma symbol")
path.write_bytes(data)
PY
        fi
            ;;
        esac

        bytes=$(stat -c%s "$OUT" 2>/dev/null || stat -f%z "$OUT" 2>/dev/null || echo "?")
        echo "kretikos: CUBIN template emitted - $OUT ($bytes bytes)"

        # Quick structural validation
        if command -v file >/dev/null 2>&1; then
            magic=$(file -b "$OUT" 2>/dev/null || true)
            if [[ "$magic" == *"NVIDIA CUDA"* ]]; then
                echo "kretikos: structural validation OK - $magic"
            else
                echo "kretikos: warning - file magic does not match NVIDIA CUDA: $magic" >&2
            fi
        fi
        python3 - "$OUT" <<'PY' || {
import struct
import sys

with open(sys.argv[1], "rb") as fh:
    data = fh.read(64)

if len(data) < 20 or data[0:4] != b"\x7fELF" or data[4] != 2:
    raise SystemExit(1)

if struct.unpack_from("<H", data, 18)[0] != 190:
    raise SystemExit(1)
PY
            echo "kretikos: structural validation failed - CUBIN is not ELF64 CUDA (e_machine=190)" >&2
            exit 1
        }
        ;;
    bundle)
        OUT_DIR=""
        PTX_PATTERN="vec_add"
        CUBIN_KIND="epistemic_dual_f32"
        FORCE=0
        TOOLCHAIN_MODE="off"
        RUNTIME_MODE="off"
        RUNTIME_RUNG=""

        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o|--output-dir)
                    OUT_DIR="$2"
                    shift 2
                    ;;
                --ptx-pattern)
                    PTX_PATTERN="$2"
                    shift 2
                    ;;
                --cubin-kind)
                    CUBIN_KIND="$2"
                    shift 2
                    ;;
                -f|--force)
                    FORCE=1
                    shift
                    ;;
                --validate-toolchain)
                    TOOLCHAIN_MODE="auto"
                    shift
                    ;;
                --require-toolchain)
                    TOOLCHAIN_MODE="required"
                    shift
                    ;;
                --toolchain-mode)
                    TOOLCHAIN_MODE="$2"
                    shift 2
                    ;;
                --validate-runtime)
                    RUNTIME_MODE="auto"
                    shift
                    ;;
                --require-runtime)
                    RUNTIME_MODE="required"
                    shift
                    ;;
                --runtime-mode)
                    RUNTIME_MODE="$2"
                    shift 2
                    ;;
                --runtime-rung)
                    RUNTIME_RUNG="$2"
                    shift 2
                    ;;
                -*)
                    echo "error: unknown option $1" >&2
                    exit 1
                    ;;
                *)
                    echo "error: unexpected argument $1" >&2
                    exit 1
                    ;;
            esac
        done

        case "$TOOLCHAIN_MODE" in
            off|auto|required) ;;
            *)
                echo "error: --toolchain-mode must be off, auto, or required" >&2
                exit 1
                ;;
        esac
        case "$RUNTIME_MODE" in
            off|auto|required) ;;
