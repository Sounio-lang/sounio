import re
import sys
from datetime import datetime, timezone
from pathlib import Path

src_path, out_path = sys.argv[1:]
source = Path(src_path)
raw = source.read_text(encoding="utf-8")
code = re.sub(r"//.*", "", raw)
flat = re.sub(r"\s+", " ", code)

common_checks = {
    "profile_directive_absent": re.search(r"//\s*kretikos\s*:\s*profile\s*=", raw, re.IGNORECASE) is None,
    "has_gpu_kernel": re.search(r"\bkernel\s+fn\s+[A-Za-z_][A-Za-z0-9_]*", code) is not None and "with GPU" in raw,
    "has_thread_index": "gpu_thread_id_x()" in code and "gpu_block_id_x()" in code and "gpu_block_dim_x()" in code,
    "has_bounds_guard": re.search(r"\bif\s+i\s*<\s*n\b", code) is not None,
    "has_mut_f32_output": re.search(r"\bout\s*:\s*&!\s*\[\s*f32\s*;\s*32\s*\]", code) is not None,
}

binary_shapes = [
    {
        "recognized_pattern": "indexed_f32_vector_add",
        "kaxi_pattern": "source_vec_add_f32",
        "runtime_rung": "vec_add_f32",
        "operator": r"\+",
        "semantic": "add:f32",
    },
    {
        "recognized_pattern": "indexed_f32_vector_sub",
        "kaxi_pattern": "source_vec_sub_f32",
        "runtime_rung": "vec_sub_f32",
        "operator": r"-",
        "semantic": "sub:f32",
    },
    {
        "recognized_pattern": "indexed_f32_vector_mul",
        "kaxi_pattern": "source_vec_mul_f32",
        "runtime_rung": "vec_mul_f32",
        "operator": r"\*",
        "semantic": "mul:f32",
    },
    {
        "recognized_pattern": "indexed_f32_vector_div",
        "kaxi_pattern": "source_vec_div_f32",
        "runtime_rung": "vec_div_f32",
        "operator": r"/",
        "semantic": "div:f32",
    },
]

matches = []
has_f32_input_a = re.search(r"\ba\s*:\s*&\s*\[\s*f32\s*;\s*32\s*\]", code) is not None
has_f32_input_b = re.search(r"\bb\s*:\s*&\s*\[\s*f32\s*;\s*32\s*\]", code) is not None
has_knowledge_input_a = re.search(r"\ba\s*:\s*Knowledge\s*<\s*f32\s*>", code) is not None
has_knowledge_input_b = re.search(r"\bb\s*:\s*Knowledge\s*<\s*f32\s*>", code) is not None
has_f32_input_ua = re.search(r"\bua\s*:\s*&\s*\[\s*f32\s*;\s*32\s*\]", code) is not None
has_f32_input_ub = re.search(r"\bub\s*:\s*&\s*\[\s*f32\s*;\s*32\s*\]", code) is not None
has_mut_f32_output_u = re.search(r"\bout_u\s*:\s*&!\s*\[\s*f32\s*;\s*32\s*\]", code) is not None
knowledge_value_lane = (
    re.search(r"\blet\s+av\s*=\s*a\s*\.\s*value\b", code) is not None
    and re.search(r"\blet\s+bv\s*=\s*b\s*\.\s*value\b", code) is not None
    and re.search(r"\(\s*\*\s*out\s*\)\s*\[[^\]]+\]\s*=\s*av\s*\+\s*bv\b", code) is not None
)
knowledge_epsilon_lane = (
    re.search(r"\blet\s+au\s*=\s*a\s*\.\s*epsilon\s+as\s+f32\b", code) is not None
    and re.search(r"\blet\s+bu\s*=\s*b\s*\.\s*epsilon\s+as\s+f32\b", code) is not None
    and re.search(
        r"\(\s*\*\s*out_u\s*\)\s*\[[^\]]+\]\s*=\s*"
        r"\(?\s*au\s*\*\s*au\s*\)?\s*\+\s*"
        r"\(?\s*bu\s*\*\s*bu\s*\)?",
        code,
    ) is not None
)
dual_value_lane = re.search(
    r"\(\s*\*\s*out\s*\)\s*\[[^\]]+\]\s*=\s*"
    r"\(\s*\*\s*a\s*\)\s*\[[^\]]+\]\s*\+\s*"
    r"\(\s*\*\s*b\s*\)\s*\[[^\]]+\]",
    code,
) is not None
dual_uncertainty_lane = re.search(
    r"\(\s*\*\s*out_u\s*\)\s*\[[^\]]+\]\s*=\s*"
    r"\(?\s*\(\s*\*\s*ua\s*\)\s*\[[^\]]+\]\s*\*\s*"
    r"\(\s*\*\s*ua\s*\)\s*\[[^\]]+\]\s*\)?\s*\+\s*"
    r"\(?\s*\(\s*\*\s*ub\s*\)\s*\[[^\]]+\]\s*\*\s*"
    r"\(\s*\*\s*ub\s*\)\s*\[[^\]]+\]\s*\)?",
    code,
) is not None
for shape in binary_shapes:
    if has_f32_input_a and has_f32_input_b and re.search(
        r"\(\s*\*\s*out\s*\)\s*\[[^\]]+\]\s*=\s*"
        r"\(\s*\*\s*a\s*\)\s*\[[^\]]+\]\s*" + shape["operator"] + r"\s*"
        r"\(\s*\*\s*b\s*\)\s*\[[^\]]+\]",
        code,
    ):
        matches.append({
            **shape,
            "semantic_ops": [
                "thread_index:i=block_id_x*block_dim_x+thread_id_x",
                "guard:i<n",
                "load_global:a[i]",
                "load_global:b[i]",
                shape["semantic"],
                "store_global:out[i]",
            ],
        })

has_f32_input_c = re.search(r"\bc\s*:\s*&\s*\[\s*f32\s*;\s*32\s*\]", code) is not None
if re.search(
    r"\(\s*\*\s*out\s*\)\s*\[[^\]]+\]\s*=\s*"
    r"\(?\s*\(\s*\*\s*a\s*\)\s*\[[^\]]+\]\s*\*\s*"
    r"\(\s*\*\s*b\s*\)\s*\[[^\]]+\]\s*\)?\s*\+\s*"
    r"\(\s*\*\s*c\s*\)\s*\[[^\]]+\]",
    code,
) and has_f32_input_c:
    matches.append({
        "recognized_pattern": "indexed_f32_affine_mad",
        "kaxi_pattern": "source_fma_f32",
        "runtime_rung": "fma_f32",
        "operator": "mul_plus_add",
        "semantic": "mul_add:f32",
        "semantic_ops": [
            "thread_index:i=block_id_x*block_dim_x+thread_id_x",
            "guard:i<n",
            "load_global:a[i]",
            "load_global:b[i]",
            "load_global:c[i]",
            "mul:f32",
            "add:f32",
            "store_global:out[i]",
        ],
    })

if dual_value_lane and dual_uncertainty_lane and has_f32_input_ua and has_f32_input_ub and has_mut_f32_output_u:
    matches = [{
        "recognized_pattern": "indexed_f32_epistemic_dual_output",
        "kaxi_pattern": "source_epistemic_dual_output_f32",
        "runtime_rung": "epistemic_dual_output_f32",
        "operator": "dual_add_plus_uncertainty_sum_of_squares",
        "semantic": "dual_lane:f32",
        "semantic_ops": [
            "thread_index:i=block_id_x*block_dim_x+thread_id_x",
            "guard:i<n",
            "load_global:a[i]",
            "load_global:b[i]",
            "add:f32:value",
            "store_global:out[i]",
            "load_global:ua[i]",
            "load_global:ub[i]",
            "mul:f32:ua^2",
            "mul:f32:ub^2",
            "add:f32:uncertainty",
            "store_global:out_u[i]",
        ],
    }]

if knowledge_value_lane and knowledge_epsilon_lane and has_knowledge_input_a and has_knowledge_input_b and has_mut_f32_output_u:
    matches = [{
        "recognized_pattern": "indexed_f32_knowledge_dual_output",
        "kaxi_pattern": "source_epistemic_dual_output_f32",
        "runtime_rung": "epistemic_dual_output_f32",
        "operator": "knowledge_value_plus_epsilon_sum_of_squares",
        "semantic": "knowledge_dual_lane:f32",
        "semantic_ops": [
            "thread_index:i=block_id_x*block_dim_x+thread_id_x",
            "guard:i<n",
            "field:a.value",
            "field:b.value",
            "add:f32:value",
            "store_global:out[i]",
            "field:a.epsilon",
            "field:b.epsilon",
            "cast:f64_to_f32:epsilon",
            "mul:f32:epsilon_a^2",
            "mul:f32:epsilon_b^2",
            "add:f32:epsilon",
            "store_global:out_u[i]",
        ],
    }]

checks = {
    **common_checks,
    "has_f32_input_a": has_f32_input_a,
    "has_f32_input_b": has_f32_input_b,
    "has_knowledge_input_a": has_knowledge_input_a,
    "has_knowledge_input_b": has_knowledge_input_b,
    "has_f32_input_c": has_f32_input_c,
    "has_f32_input_ua": has_f32_input_ua,
    "has_f32_input_ub": has_f32_input_ub,
    "has_mut_f32_output_u": has_mut_f32_output_u,
    "has_epistemic_dual_value_lane": dual_value_lane,
    "has_epistemic_dual_uncertainty_lane": dual_uncertainty_lane,
    "has_knowledge_value_lane": knowledge_value_lane,
    "has_knowledge_epsilon_lane": knowledge_epsilon_lane,
    "has_supported_arithmetic_shape": len(matches) == 1,
    "recognized_shape_count": len(matches),
}
failures = [{"kind": name} for name, ok in common_checks.items() if not ok]
if len(matches) == 0:
    failures.append({"kind": "unsupported_source_arithmetic_shape"})
elif len(matches) > 1:
    failures.append({"kind": "ambiguous_source_arithmetic_shape", "count": len(matches)})

recognized = matches[0] if not failures else {}
payload = {
    "schema": "sounio.kretikos.source-lowering-recognition.v1",
    "generated_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "status": "pass" if not failures else "fail",
    "source": str(source),
    "profile_hint": "none" if checks["profile_directive_absent"] else "present",
    "profile_directive_present": not checks["profile_directive_absent"],
    "source_lowered_to_kaxi": not failures,
    "fallback_path": "none",
    "recognized_pattern": recognized.get("recognized_pattern"),
    "kaxi_pattern": recognized.get("kaxi_pattern"),
    "runtime_rung": recognized.get("runtime_rung"),
    "semantic_ops": recognized.get("semantic_ops", []),
    "checks": checks,
    "failures": failures,
    "boundaries": [
        "recognizer_rejects_profile_directives",
        "recognizer_is_shape_limited_to_indexed_f32_arithmetic",
        "recognizer_does_not_parse_arbitrary_sounio_gpu_programs",
    ],
}
Path(out_path).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if failures:
    raise SystemExit(json.dumps(failures))
PY
            cat "$RECOGNITION_OUT" >&2
            echo "error: K-AXI source lowering recognizer failed: $SRC" >&2
            exit 1
        }

        KAXI_PATTERN="$(python3 - "$RECOGNITION_OUT" <<'PY'
import json
import sys
from pathlib import Path

obj = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
print(obj.get("kaxi_pattern", ""))
PY
)"
        RECOGNIZED_PATTERN="$(python3 - "$RECOGNITION_OUT" <<'PY'
import json
import sys
from pathlib import Path

obj = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
print(obj.get("recognized_pattern", ""))
PY
)"
        case "$KAXI_PATTERN" in
            source_vec_add_f32|source_vec_sub_f32|source_vec_mul_f32|source_vec_div_f32|source_fma_f32|source_epistemic_dual_output_f32) ;;
            *)
            echo "error: unsupported recognized K-AXI lowering pattern '$KAXI_PATTERN'" >&2
            exit 1
                ;;
        esac

        "$KRETIKOS_SELF" kaxi-witness "$KAXI_PATTERN" -o "$KAXI_WITNESS_OUT" --asm-output "$ASM_OUT" >/dev/null

        SOURCE_SHA="$(__kretikos_sha256 "$SRC")" || exit 1
        SOURCE_BYTES="$(__kretikos_file_size "$SRC")" || exit 1
        SOURCE_PATH="$(__kretikos_repo_path "$(cd "$(dirname "$SRC")" && pwd)/$(basename "$SRC")")"
        CHECK_SHA="$(__kretikos_sha256 "$CHECK_LOG")" || exit 1
        CHECK_BYTES="$(__kretikos_file_size "$CHECK_LOG")" || exit 1
        RECOGNITION_SHA="$(__kretikos_sha256 "$RECOGNITION_OUT")" || exit 1
        RECOGNITION_BYTES="$(__kretikos_file_size "$RECOGNITION_OUT")" || exit 1
        KAXI_WITNESS_SHA="$(__kretikos_sha256 "$KAXI_WITNESS_OUT")" || exit 1

        python3 - "$OUT" "$SOURCE_PATH" "$SOURCE_BYTES" "$SOURCE_SHA" \
            "$CHECK_LOG" "$CHECK_BYTES" "$CHECK_SHA" \
            "$RECOGNITION_OUT" "$RECOGNITION_BYTES" "$RECOGNITION_SHA" \
            "$KAXI_WITNESS_OUT" "$KAXI_WITNESS_SHA" <<'PY'
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

(
    out_path,
    source_path,
    source_bytes,
    source_sha,
    check_log,
    check_bytes,
    check_sha,
    recognition_path,
    recognition_bytes,
    recognition_sha,
    kaxi_witness_path,
    kaxi_witness_sha,
) = sys.argv[1:]

recognition = json.loads(Path(recognition_path).read_text(encoding="utf-8"))
witness_path = Path(kaxi_witness_path)
witness = json.loads(witness_path.read_text(encoding="utf-8"))
failures = []
if recognition.get("status") != "pass":
    failures.append({"kind": "recognition_status_not_pass", "status": recognition.get("status")})
if recognition.get("profile_hint") != "none":
    failures.append({"kind": "profile_hint_not_none", "profile_hint": recognition.get("profile_hint")})
if recognition.get("fallback_path") != "none":
    failures.append({"kind": "fallback_path_not_none", "fallback_path": recognition.get("fallback_path")})
if not recognition.get("source_lowered_to_kaxi"):
    failures.append({"kind": "source_not_lowered_to_kaxi"})
if witness.get("status") != "pass":
    failures.append({"kind": "kaxi_witness_status_not_pass", "status": witness.get("status")})
if witness.get("pattern") != recognition.get("kaxi_pattern"):
    failures.append({
        "kind": "kaxi_pattern_mismatch",
        "recognition": recognition.get("kaxi_pattern"),
        "witness": witness.get("pattern"),
    })
if not witness.get("assembly", {}).get("seq_dense_zero_based"):
    failures.append({"kind": "kaxi_sequence_not_dense_zero_based"})
if witness.get("epistemic_lanes", {}).get("store_global_count", 0) < 1:
    failures.append({"kind": "lowered_source_requires_store_global"})
if recognition.get("kaxi_pattern") == "source_epistemic_dual_output_f32" and witness.get("epistemic_lanes", {}).get("store_global_count", 0) < 2:
    failures.append({"kind": "lowered_epistemic_dual_source_requires_two_store_global_ops"})

payload = {
    "schema": "sounio.kretikos.kaxi-source-lowering.v1",
    "generated_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "status": "pass" if not failures else "fail",
    "source": {
        "path": source_path,
        "bytes": int(source_bytes),
        "sha256": source_sha,
        "check": {
            "status": "pass",
            "log_path": check_log,
            "bytes": int(check_bytes),
            "sha256": check_sha,
        },
    },
    "lowering": {
        "mode": "source_to_kaxi",
        "source_lowered_to_kaxi": recognition.get("source_lowered_to_kaxi"),
        "profile_hint": recognition.get("profile_hint"),
        "fallback_path": recognition.get("fallback_path"),
        "recognized_pattern": recognition.get("recognized_pattern"),
        "kaxi_pattern": recognition.get("kaxi_pattern"),
        "runtime_rung": recognition.get("runtime_rung"),
        "semantic_ops": recognition.get("semantic_ops", []),
        "recognition": {
            "path": recognition_path,
            "bytes": int(recognition_bytes),
            "sha256": recognition_sha,
            "checks": recognition.get("checks", {}),
        },
    },
    "kaxi": {
        "pattern": witness.get("pattern"),
        "semantic_profile": witness.get("semantic_profile"),
        "witness_path": str(witness_path),
        "witness_sha256": kaxi_witness_sha,
        "assembly": witness.get("assembly", {}),
        "epistemic_lanes": witness.get("epistemic_lanes", {}),
    },
    "failures": failures,
    "boundaries": [
        "source_must_typecheck_before_kaxi_lowering",
        "profile_directives_are_rejected_for_source_lowering",
        "source_lowering_links_source_hash_to_kaxi_witness_hash",
        "source_lowering_is_shape_limited_to_indexed_f32_arithmetic",
        "source_lowering_does_not_claim_general_gpu_backend_completeness",
        "source_lowering_does_not_replace_slurm_cuda_runtime_authority",
    ],
}
Path(out_path).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if failures:
    raise SystemExit(json.dumps(failures))
PY

        echo "kretikos: K-AXI source lowering emitted - $OUT"
        echo "kretikos: K-AXI source lowering pattern - source=$SOURCE_PATH recognized=$RECOGNIZED_PATTERN kaxi_pattern=$KAXI_PATTERN profile_hint=none fallback_path=none"
        ;;

    kaxi-lowering-certificate)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos kaxi-lowering-certificate <source.sio> -o <file.json> [--work-dir <dir>] [--force] [--require-runtime]" >&2
            exit 1
        fi
        SRC="$1"
        shift
        OUT=""
        WORK_DIR=""
        FORCE=0
        RUNTIME_ARG=(--validate-runtime)
        RUNTIME_MODE="auto"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o|--output)
                    OUT="$2"
                    shift 2
                    ;;
                --work-dir)
                    WORK_DIR="$2"
                    shift 2
                    ;;
                --force)
                    FORCE=1
                    shift
                    ;;
                --validate-runtime)
                    RUNTIME_ARG=(--validate-runtime)
                    RUNTIME_MODE="auto"
                    shift
                    ;;
                --require-runtime)
                    RUNTIME_ARG=(--require-runtime)
                    RUNTIME_MODE="required"
                    shift
                    ;;
                -*)
                    echo "error: unknown option $1" >&2
                    exit 1
                    ;;
                *)
                    echo "error: unexpected argument $1" >&2
                    exit 1
                    ;;
            esac
        done

        if [[ -z "$OUT" ]]; then
            echo "usage: kretikos kaxi-lowering-certificate <source.sio> -o <file.json> [--work-dir <dir>] [--force] [--require-runtime]" >&2
            exit 1
        fi
        if [[ ! -f "$SRC" ]]; then
            echo "error: source not found: $SRC" >&2
            exit 1
        fi

        case "$OUT" in
            *.json) OUT_STEM="${OUT%.json}" ;;
            *) OUT_STEM="$OUT" ;;
        esac
        if [[ -z "$WORK_DIR" ]]; then
            WORK_DIR="${OUT_STEM}.lowering-certificate.d"
        fi
        if [[ -e "$OUT" && "$FORCE" -ne 1 ]]; then
            echo "error: lowering certificate output already exists: $OUT (use --force)" >&2
            exit 1
        fi
        if [[ -e "$WORK_DIR" && "$FORCE" -ne 1 ]]; then
            echo "error: lowering certificate work dir already exists: $WORK_DIR (use --force)" >&2
            exit 1
        fi
        if [[ "$FORCE" -eq 1 ]]; then
            rm -rf "$WORK_DIR"
        fi
        mkdir -p "$(dirname "$OUT")" "$WORK_DIR"

        SOURCE_LOWERING="$WORK_DIR/kaxi_source_lowering.json"
        KAXI_WITNESS="$WORK_DIR/kaxi_witness.json"
        KAXI_ASM="$WORK_DIR/kaxi_source_lowered.kaxi"
        RUNTIME_DIR="$WORK_DIR/runtime"
        RUN_SOURCE_LOG="$WORK_DIR/run_source.out"

        "$KRETIKOS_SELF" kaxi-lower-source "$SRC" \
            -o "$SOURCE_LOWERING" \
            --asm-output "$KAXI_ASM" \
            --kaxi-witness-output "$KAXI_WITNESS" >/dev/null

        mkdir -p "$RUNTIME_DIR"
        "$KRETIKOS_SELF" run-source "$SRC" -o "$RUNTIME_DIR" --force "${RUNTIME_ARG[@]}" >"$RUN_SOURCE_LOG" 2>&1 || {
            cat "$RUN_SOURCE_LOG" >&2
            echo "error: K-AXI lowering certificate runtime/profile bundle step failed" >&2
            exit 1
        }

        python3 - "$OUT" "$SRC" "$WORK_DIR" "$SOURCE_LOWERING" "$KAXI_WITNESS" "$KAXI_ASM" \
            "$RUNTIME_DIR/kretikos_source_profile.v1.json" "$RUNTIME_DIR/kretikos_bundle.v1.json" "$RUN_SOURCE_LOG" "$RUNTIME_MODE" <<'PY'
import hashlib
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

(
    out_path,
    source_arg,
    work_dir,
    source_lowering_path,
    kaxi_witness_path,
    kaxi_asm_path,
    runtime_profile_path,
    bundle_path,
    run_source_log_path,
    runtime_mode,
) = sys.argv[1:]

def read_json(path):
    p = Path(path)
    if not p.is_file():
        return None
    return json.loads(p.read_text(encoding="utf-8"))

def file_record(path):
    p = Path(path)
    if not p.is_file():
        return None
    data = p.read_bytes()
    return {
        "path": str(p),
        "bytes": p.stat().st_size,
        "sha256": hashlib.sha256(data).hexdigest(),
    }

source_lowering = read_json(source_lowering_path)
kaxi_witness = read_json(kaxi_witness_path)
runtime_profile = read_json(runtime_profile_path)
bundle = read_json(bundle_path)
runtime_validation = (bundle or {}).get("runtime_validation") or {}
lowering = (source_lowering or {}).get("lowering") or {}
kaxi = (source_lowering or {}).get("kaxi") or {}

failures = []
if source_lowering is None:
    failures.append({"kind": "missing_source_lowering", "path": source_lowering_path})
elif source_lowering.get("status") != "pass":
    failures.append({"kind": "source_lowering_not_pass", "status": source_lowering.get("status")})

if kaxi_witness is None:
    failures.append({"kind": "missing_kaxi_witness", "path": kaxi_witness_path})
elif kaxi_witness.get("status") != "pass":
    failures.append({"kind": "kaxi_witness_not_pass", "status": kaxi_witness.get("status")})

if runtime_profile is None:
    failures.append({"kind": "missing_runtime_source_profile", "path": runtime_profile_path})
if bundle is None:
    failures.append({"kind": "missing_runtime_bundle", "path": bundle_path})

if source_lowering:
    if lowering.get("profile_hint") != "none":
        failures.append({"kind": "profile_hint_not_none", "profile_hint": lowering.get("profile_hint")})
    if lowering.get("fallback_path") != "none":
        failures.append({"kind": "fallback_path_not_none", "fallback_path": lowering.get("fallback_path")})
    if not lowering.get("source_lowered_to_kaxi"):
        failures.append({"kind": "source_not_lowered_to_kaxi"})
    if kaxi.get("pattern") != lowering.get("kaxi_pattern"):
        failures.append({
            "kind": "lowering_kaxi_pattern_mismatch",
            "lowering": lowering.get("kaxi_pattern"),
            "kaxi": kaxi.get("pattern"),
        })

if kaxi_witness and source_lowering:
    if kaxi_witness.get("pattern") != lowering.get("kaxi_pattern"):
        failures.append({
            "kind": "witness_pattern_mismatch",
            "lowering": lowering.get("kaxi_pattern"),
            "witness": kaxi_witness.get("pattern"),
        })
    if not kaxi_witness.get("assembly", {}).get("seq_dense_zero_based"):
        failures.append({"kind": "kaxi_sequence_not_dense_zero_based"})
    if lowering.get("kaxi_pattern") == "source_epistemic_dual_output_f32":
        store_count = kaxi_witness.get("epistemic_lanes", {}).get("store_global_count", 0)
        if store_count < 2:
            failures.append({"kind": "dual_lowering_requires_two_store_global_ops", "store_global_count": store_count})

if source_lowering and runtime_profile:
    source_a = source_lowering.get("source") or {}
    source_b = runtime_profile.get("source") or {}
    if source_a.get("sha256") != source_b.get("sha256"):
        failures.append({
            "kind": "source_hash_mismatch",
            "lowering_source_sha256": source_a.get("sha256"),
            "runtime_source_sha256": source_b.get("sha256"),
        })
    if lowering.get("runtime_rung") != runtime_profile.get("profile"):
        failures.append({
            "kind": "runtime_profile_mismatch",
            "lowering_runtime_rung": lowering.get("runtime_rung"),
            "runtime_profile": runtime_profile.get("profile"),
        })

if source_lowering and bundle:
    if lowering.get("runtime_rung") != runtime_validation.get("rung"):
        failures.append({
            "kind": "runtime_rung_mismatch",
            "lowering_runtime_rung": lowering.get("runtime_rung"),
            "bundle_rung": runtime_validation.get("rung"),
        })
    if runtime_profile and runtime_profile.get("kernel") != runtime_validation.get("kernel"):
        failures.append({
            "kind": "runtime_kernel_mismatch",
            "runtime_profile_kernel": runtime_profile.get("kernel"),
            "bundle_kernel": runtime_validation.get("kernel"),
        })

if runtime_mode == "required" and runtime_validation.get("status") != "pass":
    failures.append({
        "kind": "runtime_required_but_not_pass",
        "status": runtime_validation.get("status"),
        "reason": runtime_validation.get("reason"),
    })

payload = {
    "schema": "sounio.kretikos.kaxi-lowering-certificate.v1",
    "generated_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "status": "pass" if not failures else "fail",
    "source": (source_lowering or {}).get("source"),
    "profile": {
        "name": (runtime_profile or {}).get("profile"),
        "profile_kind": (runtime_profile or {}).get("profile_kind"),
        "runtime_backed": (runtime_profile or {}).get("runtime_backed"),
        "cubin_kind": (runtime_profile or {}).get("cubin_kind"),
        "runtime_rung": (runtime_profile or {}).get("runtime_rung"),
        "kernel": (runtime_profile or {}).get("kernel"),
    },
    "lowering": lowering,
    "kaxi": kaxi,
    "runtime": {
        "mode": runtime_mode,
        "source_profile": runtime_profile,
        "bundle_status": (bundle or {}).get("status"),
        "structural_checks": (bundle or {}).get("structural_checks"),
        "artifacts": (bundle or {}).get("artifacts"),
        "runtime_validation": runtime_validation,
        "toolchain_validation": (bundle or {}).get("toolchain_validation"),
    },
    "artifact_records": {
        "source_lowering": file_record(source_lowering_path),
        "kaxi_witness": file_record(kaxi_witness_path),
        "kaxi_assembly": file_record(kaxi_asm_path),
        "runtime_source_profile": file_record(runtime_profile_path),
        "runtime_bundle": file_record(bundle_path),
        "run_source_log": file_record(run_source_log_path),
    },
    "work_dir": work_dir,
    "source_arg": source_arg,
    "failures": failures,
    "boundaries": [
        "certificate_braids_checked_source_lowering_kaxi_witness_and_runtime_bundle_hashes",
        "source_must_typecheck_before_source_lowering_and_profile_selection",
        "profile_hint_must_be_absent_for_source_lowering_certificate",
        "kaxi_evidence_is_shape_limited_source_lowering_not_general_gpu_lowering",
        "runtime_validation_applies_to_selected_predefined_cubin_rung_only",
        "local_cuda_not_run_is_classified_and_slurm_remains_runtime_authority",
        "certificate_does_not_claim_first_class_knowledge_generic_lowering",
        "certificate_does_not_claim_general_gpu_backend_completeness",
    ],
}
Path(out_path).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if failures:
    raise SystemExit(json.dumps(failures))
PY

        echo "kretikos: K-AXI lowering certificate emitted - $OUT"
        echo "kretikos: K-AXI lowering certificate work dir - $WORK_DIR"
        ;;

    kaxi-certificate)
        if [[ $# -lt 1 ]]; then
            echo "usage: kretikos kaxi-certificate <source.sio> -o <file.json> [--work-dir <dir>] [--force] [--require-runtime]" >&2
            exit 1
        fi
        SRC="$1"
        shift
        OUT=""
        WORK_DIR=""
        FORCE=0
        RUNTIME_ARG=(--validate-runtime)
        RUNTIME_MODE="auto"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o|--output)
                    OUT="$2"
                    shift 2
                    ;;
                --work-dir)
                    WORK_DIR="$2"
                    shift 2
                    ;;
                --force)
                    FORCE=1
                    shift
                    ;;
                --validate-runtime)
                    RUNTIME_ARG=(--validate-runtime)
                    RUNTIME_MODE="auto"
                    shift
                    ;;
                --require-runtime)
                    RUNTIME_ARG=(--require-runtime)
                    RUNTIME_MODE="required"
                    shift
                    ;;
                -*)
                    echo "error: unknown option $1" >&2
                    exit 1
                    ;;
                *)
                    echo "error: unexpected argument $1" >&2
                    exit 1
                    ;;
            esac
        done

        if [[ -z "$OUT" ]]; then
            echo "usage: kretikos kaxi-certificate <source.sio> -o <file.json> [--work-dir <dir>] [--force] [--require-runtime]" >&2
            exit 1
        fi
        if [[ ! -f "$SRC" ]]; then
            echo "error: source not found: $SRC" >&2
            exit 1
        fi

        case "$OUT" in
            *.json) OUT_STEM="${OUT%.json}" ;;
            *) OUT_STEM="$OUT" ;;
        esac
        if [[ -z "$WORK_DIR" ]]; then
            WORK_DIR="${OUT_STEM}.certificate.d"
        fi
        if [[ -e "$OUT" && "$FORCE" -ne 1 ]]; then
            echo "error: certificate output already exists: $OUT (use --force)" >&2
            exit 1
        fi
        if [[ -e "$WORK_DIR" && "$FORCE" -ne 1 ]]; then
            echo "error: certificate work dir already exists: $WORK_DIR (use --force)" >&2
            exit 1
        fi
        if [[ "$FORCE" -eq 1 ]]; then
            rm -rf "$WORK_DIR"
        fi
        mkdir -p "$(dirname "$OUT")" "$WORK_DIR"

        SOURCE_WITNESS="$WORK_DIR/kaxi_source_witness.json"
        KAXI_WITNESS="$WORK_DIR/kaxi_witness.json"
        KAXI_ASM="$WORK_DIR/kaxi_source.kaxi"
        RUNTIME_DIR="$WORK_DIR/runtime"
        RUN_SOURCE_LOG="$WORK_DIR/run_source.out"

        "$KRETIKOS_SELF" kaxi-source-witness "$SRC" \
            -o "$SOURCE_WITNESS" \
            --asm-output "$KAXI_ASM" \
            --kaxi-witness-output "$KAXI_WITNESS" >/dev/null

        mkdir -p "$RUNTIME_DIR"
        "$KRETIKOS_SELF" run-source "$SRC" -o "$RUNTIME_DIR" --force "${RUNTIME_ARG[@]}" >"$RUN_SOURCE_LOG" 2>&1 || {
            cat "$RUN_SOURCE_LOG" >&2
            echo "error: K-AXI certificate runtime/profile bundle step failed" >&2
            exit 1
        }

        python3 - "$OUT" "$SRC" "$WORK_DIR" "$SOURCE_WITNESS" "$KAXI_WITNESS" "$KAXI_ASM" \
            "$RUNTIME_DIR/kretikos_source_profile.v1.json" "$RUNTIME_DIR/kretikos_bundle.v1.json" "$RUN_SOURCE_LOG" "$RUNTIME_MODE" <<'PY'
import hashlib
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

(
    out_path,
    source_arg,
    work_dir,
    source_witness_path,
    kaxi_witness_path,
    kaxi_asm_path,
    runtime_profile_path,
    bundle_path,
    run_source_log_path,
    runtime_mode,
) = sys.argv[1:]

def read_json(path):
    p = Path(path)
    if not p.is_file():
        return None
    return json.loads(p.read_text(encoding="utf-8"))

def file_record(path):
    p = Path(path)
    if not p.is_file():
        return None
    data = p.read_bytes()
    return {
        "path": str(p),
        "bytes": p.stat().st_size,
        "sha256": hashlib.sha256(data).hexdigest(),
    }

source_witness = read_json(source_witness_path)
kaxi_witness = read_json(kaxi_witness_path)
runtime_profile = read_json(runtime_profile_path)
bundle = read_json(bundle_path)
runtime_validation = (bundle or {}).get("runtime_validation") or {}

failures = []
if source_witness is None:
    failures.append({"kind": "missing_source_witness", "path": source_witness_path})
elif source_witness.get("status") != "pass":
    failures.append({"kind": "source_witness_not_pass", "status": source_witness.get("status")})

if kaxi_witness is None:
    failures.append({"kind": "missing_kaxi_witness", "path": kaxi_witness_path})
elif kaxi_witness.get("status") != "pass":
    failures.append({"kind": "kaxi_witness_not_pass", "status": kaxi_witness.get("status")})

if runtime_profile is None:
    failures.append({"kind": "missing_runtime_source_profile", "path": runtime_profile_path})
if bundle is None:
    failures.append({"kind": "missing_runtime_bundle", "path": bundle_path})

if source_witness and runtime_profile:
    source_a = source_witness.get("source") or {}
    source_b = runtime_profile.get("source") or {}
    if source_a.get("sha256") != source_b.get("sha256"):
        failures.append({
            "kind": "source_hash_mismatch",
            "kaxi_source_sha256": source_a.get("sha256"),
            "runtime_source_sha256": source_b.get("sha256"),
        })
    profile_a = (source_witness.get("profile") or {}).get("name")
    profile_b = runtime_profile.get("profile")
    if profile_a != profile_b:
        failures.append({
            "kind": "profile_mismatch",
            "kaxi_profile": profile_a,
            "runtime_profile": profile_b,
        })

if source_witness and bundle:
    profile = source_witness.get("profile") or {}
    if profile.get("runtime_rung") != runtime_validation.get("rung"):
        failures.append({
            "kind": "runtime_rung_mismatch",
            "source_witness_rung": profile.get("runtime_rung"),
            "bundle_rung": runtime_validation.get("rung"),
        })
    if profile.get("kernel") != runtime_validation.get("kernel"):
        failures.append({
            "kind": "runtime_kernel_mismatch",
            "source_witness_kernel": profile.get("kernel"),
            "bundle_kernel": runtime_validation.get("kernel"),
        })

if runtime_mode == "required" and runtime_validation.get("status") != "pass":
    failures.append({
        "kind": "runtime_required_but_not_pass",
        "status": runtime_validation.get("status"),
        "reason": runtime_validation.get("reason"),
    })

payload = {
    "schema": "sounio.kretikos.kaxi-certificate.v1",
    "generated_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "status": "pass" if not failures else "fail",
    "source": (source_witness or {}).get("source"),
    "profile": (source_witness or {}).get("profile"),
    "kaxi": (source_witness or {}).get("kaxi"),
    "runtime": {
        "mode": runtime_mode,
        "source_profile": runtime_profile,
        "bundle_status": (bundle or {}).get("status"),
        "structural_checks": (bundle or {}).get("structural_checks"),
        "artifacts": (bundle or {}).get("artifacts"),
        "runtime_validation": runtime_validation,
        "toolchain_validation": (bundle or {}).get("toolchain_validation"),
    },
    "artifact_records": {
        "source_witness": file_record(source_witness_path),
        "kaxi_witness": file_record(kaxi_witness_path),
        "kaxi_assembly": file_record(kaxi_asm_path),
        "runtime_source_profile": file_record(runtime_profile_path),
        "runtime_bundle": file_record(bundle_path),
        "run_source_log": file_record(run_source_log_path),
    },
    "work_dir": work_dir,
    "source_arg": source_arg,
    "failures": failures,
    "boundaries": [
        "certificate_braids_checked_source_kaxi_witness_and_runtime_bundle_hashes",
        "source_must_typecheck_before_certificate_profile_selection",
        "kaxi_evidence_is_profile_level_for_explicit_kretikos_patterns",
        "runtime_validation_applies_to_selected_predefined_cubin_rung_only",
        "local_cuda_not_run_is_classified_and_slurm_remains_runtime_authority",
        "certificate_does_not_claim_arbitrary_sounio_gpu_lowering",
        "certificate_does_not_claim_general_gpu_backend_completeness",
    ],
}
Path(out_path).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if failures:
    raise SystemExit(json.dumps(failures))
