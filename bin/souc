#!/usr/bin/env bash
# bin/souc — default Sounio compiler entrypoint.
#
# DEFAULT ENGINE: Madaros (the self-hosted *modular* compiler, built from
# self-hosted/compiler/main.sio into artifacts/self-hosted/madaros). This is the
# compiler people invoke for normal use ("MADAROS IS DEFAULT", 2026-06-14).
#
# LEGACY ENGINE: lean_single — the single-file bootstrap codegen that bin/souc
# USED to be, preserved as bin/souc-lean-single-x86_64. It remains the bootstrap
# SEED (make build, build-madaros) and the canonical fixed-point ELF, but is no
# longer the default user-facing compiler.
#
# This is a thin CLI shim: it keeps the historical `souc check|compile|run|
# --version|info` surface (657+ call sites) working while routing to Madaros via
# bin/madaros, which already maps those verbs to the raw modular ELF.
#
# Engine selection (in order):
#   SOUNIO_SOUC_BIN=<elf>          -> exec that ELF directly (raw, lean_single CLI)
#   SOUNIO_SOUC_ENGINE=lean_single -> force the legacy lean_single ELF
#   (default)                      -> Madaros; if its raw ELF is not built, fall
#                                     back to lean_single with a visible notice so
#                                     no caller hard-breaks in an unbuilt checkout.
#
# Environment passthrough:
#   SOUNIO_STDLIB_PATH   forwarded to whichever engine runs
#   MADAROS_RAW_BIN / SOUNIO_MADAROS_BIN  override the Madaros raw ELF
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# The preserved lean_single fixed-point ELF (escape hatch + fallback target).
LEAN_SINGLE="$ROOT_DIR/bin/souc-lean-single-x86_64"
[[ -x "$LEAN_SINGLE" ]] || LEAN_SINGLE="$ROOT_DIR/bin/souc-linux-x86_64"

_is_elf() { [[ -n "${1:-}" && -x "$1" && "$(head -c2 "$1" 2>/dev/null)" != '#!' ]]; }

# An explicit compiler override that cannot be used must ABORT, never be skipped.
#
# WHY. `_is_elf` requires the execute bit. A build that leaves its output
# non-executable therefore produces a path that fails this test, and the
# resolution loop below simply moves on to the next candidate — ending at the
# COMMITTED `bin/madaros-linux-x86_64`, which lags `self-hosted/` source. The
# caller asked to measure their build and silently measured the shipped one.
#
# That is not hypothetical: on 2026-08-28 an agent read `check: OK` through a
# supposedly fresh compiler and `error[E245]` through the same ELF after
# `chmod +x` — opposite verdicts, same file, no message in between. A wrong
# measurement that still exits 0 costs more than a failed one, so an override
# that was SET and is unusable stops here and says which reason applies.
_reject_unusable_override() {  # _reject_unusable_override <var-name> <path>
  local var="$1" path="$2" why
  if   [[ ! -e "$path" ]];              then why="no such file"
  elif [[ -d "$path" ]];                then why="is a directory"
  elif [[ ! -x "$path" ]];              then why="not executable (chmod +x it)"
  elif [[ "$(head -c2 "$path" 2>/dev/null)" == '#!' ]]; then why="is a script, not a raw ELF"
  else why="unusable"; fi
  echo "error[E-SRB-001]: $var is set but cannot be used: $why" >&2
  echo "  $var=$path" >&2
  echo "souc: refusing to fall back to the committed compiler — it lags self-hosted/ source," >&2
  echo "souc: so the measurement you asked for would silently become a different one." >&2
  echo "souc: fix the path, or unset $var to use the default resolution order." >&2
  exit 78
}

# Abort on any override that is set-but-unusable, before any resolution runs.
for _ov in MADAROS_RAW_BIN SOUNIO_MADAROS_BIN SOUNIO_SOUC_BIN; do
  _ov_val="${!_ov:-}"
  [[ -n "$_ov_val" ]] && ! _is_elf "$_ov_val" && _reject_unusable_override "$_ov" "$_ov_val"
done
unset _ov _ov_val

_science_boundary_requested() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --science-boundary|--science-boundary=*|--science-manifest|--science-manifest=*|\
      --claim-contract|--claim-contract=*|--emit-boundary-receipt|--emit-boundary-receipt=*)
        return 0
        ;;
    esac
  done
  return 1
}

_package_release_requested() {
  [[ "${1:-}" == "pkg" && "${2:-}" == "verify" ]] && return 0
  local arg
  for arg in "$@"; do
    case "$arg" in
      --release-bundle|--release-bundle=*) return 0 ;;
    esac
  done
  return 1
}

_reject_science_without_madaros() {
  echo "error[E-SRB-000]: science boundary options require the Madaros launcher" >&2
  echo "souc: remove the legacy engine override or build a current-source Madaros" >&2
  exit 1
}

# Resolve the Madaros raw ELF, mirroring bin/madaros's resolution order.
_resolve_madaros() {
  local cand
  for cand in "${MADAROS_RAW_BIN:-}" "${SOUNIO_MADAROS_BIN:-}" \
              "$ROOT_DIR/artifacts/self-hosted/madaros" "$ROOT_DIR/bin/madaros-linux-x86_64"; do
    if _is_elf "$cand"; then echo "$cand"; return 0; fi
  done
  return 1
}

cmd_init() {
  if [[ $# -ne 1 ]]; then
    echo "souc: init requires <name>" >&2
    exit 2
  fi
  local name="$1"
  if [[ -e "$name" ]]; then
    echo "souc: path already exists: $name" >&2
    exit 1
  fi
  mkdir -p "$name/src"
  cat >"$name/sounio.toml" <<EOF
[package]
name = "$name"
version = "0.1.0"
edition = "2026"

[[bin]]
name = "$name"
path = "src/main.sio"
EOF
  cat >"$name/src/greet.sio" <<'EOF'
pub fn answer() -> i64 {
    42
}
EOF
  cat >"$name/src/main.sio" <<'EOF'
use greet::{answer}

fn main() -> i64 with IO {
    print_int(answer())
    print_char(10)
    0
}
EOF
  echo "Created Sounio project: $name"
}

# souc-flavoured help. The `check|compile|run <file.sio>` tokens are the repo-wide
# capability-probe contract (scripts grep `souc --help` for `compile <file.sio>` /
# `run <file.sio>` to decide between the verb CLI and the raw `SRC OUT` form). We
# only print this when the Madaros engine is actually resolved — Madaros supports
# the verbs, so the probe correctly selects the verb form. In the lean_single
# fallback we delegate --help to the raw ELF (no verb tokens), so probes correctly
# select the raw `SRC OUT` form that lean_single understands.
_print_souc_help() {
  cat <<'USAGE'
souc — the Sounio compiler (default engine: Madaros)

Usage:
  souc --version                      print compiler identity
  souc info                           print compiler status
  souc check <file.sio|project-dir>   parse, resolve and typecheck
  souc compile <file.sio|project-dir> [-o OUT]
                                      compile source to a native ELF
  souc build <file.sio|project-dir> [-o OUT]
                                      compile source to a native ELF
  souc build <file.sio> --backend gpu -o OUT
                                      emit a public GPU artifact (PTX by default)
  souc run <file.sio|project-dir>     run source (compile to a temp ELF and execute)
  souc init <name>                    create a minimal sounio.toml project
  souc format <file.sio>              format Sounio source on stdout
  souc fmt <file.sio>                 alias for format
  souc repl                           start the file-backed Sounio REPL
  souc lsp --stdio                    start the preview language server over stdio
  souc pkg build [project] --science-boundary strict --claim-contract <path>
                                      emit an atomic, verified .sio-release bundle
  souc pkg verify <bundle> [--root <project>]
                                      revalidate a package release bundle
  souc install <package>              shorthand for `souc pkg install`
  souc search <query>                 shorthand for `souc pkg search`
  souc ontology <resolve|search|ancestors|is-subclass|map>
                                      resolve CURIEs against the bundled ontology
                                      slice (GO, HPO, LOINC, CHEBI, SNOMED)

Science boundary:
  --science-boundary off|advisory|strict
                                      select the R0-R2 boundary mode
  --science-manifest <path>           use an explicit science manifest
  --claim-contract <path>             bind an explicit claim contract
  --emit-boundary-receipt <path>      write a deterministic boundary receipt
  --release-bundle <path>             select the strict package release directory

Engine selection:
  SOUNIO_SOUC_ENGINE=lean_single      force the legacy lean_single engine (raw `souc SRC OUT`)
  MADAROS_RAW_BIN=<elf>               override the Madaros raw ELF
USAGE
}

# Tooling commands are repo wrappers around the selected compiler. Keep these in
# front of engine dispatch so the public `bin/souc` surface is consistent for
# Madaros and lean_single users alike.
case "${1:-}" in
  init)
    shift
    cmd_init "$@"
    exit 0
    ;;
  format|fmt)
    if [[ $# -lt 2 ]]; then
      echo "souc: usage: souc ${1:-format} <file.sio>" >&2
      exit 64
    fi
    exec "$ROOT_DIR/tools/fmt/sounio-fmt.sh" "${@:2}"
    ;;
  repl)
    shift
    exec env SOUC_BIN="$ROOT_DIR/bin/souc" "$ROOT_DIR/tools/repl.sh" "$@"
    ;;
  lsp)
    shift
    exec env \
      SOUNIO_LSP_SOUC_BIN="${SOUNIO_LSP_SOUC_BIN:-$ROOT_DIR/bin/souc}" \
      SOUNIO_LSP_STRICT_NO_RUST="${SOUNIO_LSP_STRICT_NO_RUST:-0}" \
      "$ROOT_DIR/tools/lsp/sounio-lsp.sh" "$@"
    ;;
esac

# 1) Explicit ELF override: honor it directly (raw lean_single-style CLI).
if _is_elf "${SOUNIO_SOUC_BIN:-}"; then
  if _science_boundary_requested "$@" || _package_release_requested "$@"; then
    _reject_science_without_madaros
  fi
  exec "$SOUNIO_SOUC_BIN" "$@"
fi

# Historical raw positional compile form: `souc <src.sio> <out> [flags]`.
# Keep routing this through the lean_single bootstrap ELF even though Madaros is
# the default verb-oriented engine; the modular launcher does not implement the
# raw `SRC OUT` ABI.
#
# Fail-closed: a flag-looking second argument is not an output path.
# `souc file.sio -o dest.elf` used to exec lean_single with OUT=`-o`, write a
# file literally named `-o`, and exit 0. That is the silent-success class.
# See docs/audit/SOUC_WRAPPER_BARE_DASH_O_SWALLOW_DISPATCH_2026-08-18.md.
if [[ $# -ge 2 && "${1:-}" == *.sio ]]; then
  if [[ "${2:-}" == -* ]]; then
    echo "souc: refused: bare form 'souc $1 $2 …' would treat '$2' as the output filename and exit 0" >&2
    echo "souc: use: souc compile $1 -o <out>" >&2
    exit 2
  fi
  if _science_boundary_requested "$@"; then
    _reject_science_without_madaros
  fi
  if [[ -x "$LEAN_SINGLE" ]]; then
    exec "$LEAN_SINGLE" "$@"
  fi
  echo "souc: raw positional form '<src.sio> <out>' requires a lean_single ELF at $LEAN_SINGLE" >&2
  exit 127
fi

# 2) Forced legacy engine.
case "${SOUNIO_SOUC_ENGINE:-madaros}" in
  lean_single|lean-single|leansingle)
    if _science_boundary_requested "$@" || _package_release_requested "$@"; then
      _reject_science_without_madaros
    fi
    if [[ ! -x "$LEAN_SINGLE" ]]; then
      echo "souc: SOUNIO_SOUC_ENGINE=lean_single but no lean_single ELF found at $LEAN_SINGLE" >&2
      exit 127
    fi
    # lean_single uses raw `SRC OUT` CLI, not the verb-based `run|check|compile` form.
    # Translate verb invocations so gate scripts using `souc run <file>` work correctly.
    case "${1:-}" in
      run)
        _ls_src="${2:-}"
        _ls_tmp="$(mktemp /tmp/souc-lean-run-XXXXXX)"
        "$LEAN_SINGLE" "$_ls_src" "$_ls_tmp" >/dev/null 2>&1
        chmod +x "$_ls_tmp"
        exec "$_ls_tmp" "${@:3}"
        ;;
      check)
        _ls_tmp2="$(mktemp /tmp/souc-lean-check-XXXXXX)"
        "$LEAN_SINGLE" "${2:-}" "$_ls_tmp2" 2>&1
        _ls_rc=$?
        rm -f "$_ls_tmp2"
        exit $_ls_rc
        ;;
      compile)
        # souc compile <src> -o <out> → lean_single <src> <out>
        _ls_compile_src="${2:-}"
        _ls_compile_out=""
        shift 2
        while [[ $# -gt 0 ]]; do
          if [[ "${1:-}" == "-o" ]]; then _ls_compile_out="${2:-}"; shift 2; else shift; fi
        done
        exec "$LEAN_SINGLE" "$_ls_compile_src" "${_ls_compile_out:-/dev/null}"
        ;;
      *)
        exec "$LEAN_SINGLE" "$@"
        ;;
    esac
    ;;
esac

# 3) Default: Madaros (via bin/madaros, which maps the souc verbs to the raw ELF).
if MADAROS_ELF="$(_resolve_madaros)"; then
  # Advertise the souc verb CLI so capability-probing callers select the verb form
  # (which Madaros supports) instead of the raw `SRC OUT` form (which it does not).
  case "${1:-}" in
    -h|--help|help) _print_souc_help; exit 0 ;;
  esac
  # Provenance on STDERR, never stdout.
  #
  # `souc --version` prints "Madaros v0.80.0" and nothing about WHICH build that
  # is, so a binary months behind its source is indistinguishable from a fresh
  # one in every log, paste and report. Measured 2026-08-23: two agents
  # independently concluded the compiler does not enforce the EpistemicComplete
  # floor -- and that a dissertation contribution was inert -- from an rc=0 that
  # came from the committed ELF, not from the source they were reading. Both had
  # carefully unset the poisoned SOUC_BIN and SOUNIO_STDLIB_PATH first. Clearing
  # the environment disarms one trap; the binary is a second one.
  #
  # The condition was not being omitted out of carelessness. There was nowhere to
  # read it. This puts it where nobody has to remember.
  #
  # stdout stays byte-identical because ~657 call sites parse it; stderr is where
  # the condition goes, so a human or a captured log sees it and a parser does not.
  if [[ "${1:-}" == "--version" ]]; then
    _prov_elf="$MADAROS_ELF"
    _prov_sum="$( { md5sum "$_prov_elf" 2>/dev/null || echo '? -'; } | cut -c1-8 )"
    _prov_src="$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || echo 'no-git')"
    _prov_dirty=""
    if ! git -C "$ROOT_DIR" diff --quiet -- self-hosted 2>/dev/null; then
      _prov_dirty=" self-hosted/ MODIFIED since this tree's HEAD"
    fi
    printf 'provenance: elf=%s md5=%s tree=%s%s\n' \
      "${_prov_elf#$ROOT_DIR/}" "$_prov_sum" "$_prov_src" "$_prov_dirty" >&2
    printf 'provenance: this ELF is the COMMITTED binary; it is not built from the tree above.\n' >&2
    printf 'provenance: for a claim about compiler behaviour, build from source.\n' >&2
  fi
  exec env MADAROS_RAW_BIN="$MADAROS_ELF" "$ROOT_DIR/bin/madaros" "$@"
fi

# 4) Madaros not built — do not hard-break callers; fall back to lean_single.
if [[ -x "$LEAN_SINGLE" ]]; then
  if _science_boundary_requested "$@" || _package_release_requested "$@"; then
    _reject_science_without_madaros
  fi
  echo "souc: Madaros raw ELF not found (run 'make build-madaros') — falling back to the" >&2
  echo "souc: legacy lean_single engine. Set SOUNIO_SOUC_ENGINE=lean_single to silence this." >&2
  exec "$LEAN_SINGLE" "$@"
fi

echo "souc: no compiler engine available — build Madaros ('make build-madaros') or provide" >&2
echo "souc: a lean_single ELF at $LEAN_SINGLE." >&2
exit 127
