#!/usr/bin/env bash
# bin/souc — default Sounio compiler entrypoint.
#
# DEFAULT ENGINE: Madaros (the self-hosted *modular* compiler, built from
# self-hosted/compiler/main.sio into artifacts/self-hosted/madaros). This is the
# compiler people invoke for normal use ("MADAROS IS DEFAULT", 2026-06-14).
#
# LEGACY ENGINE: lean_single — the single-file bootstrap codegen that bin/souc
# USED to be, preserved as bin/souc-lean-single-x86_64. It remains the bootstrap
# SEED (make build, build-madaros) and the canonical fixed-point ELF, but is no
# longer the default user-facing compiler.
#
# This is a thin CLI shim: it keeps the historical `souc check|compile|run|
# --version|info` surface (657+ call sites) working while routing to Madaros via
# bin/madaros, which already maps those verbs to the raw modular ELF.
#
# Engine selection (in order):
#   SOUNIO_SOUC_BIN=<elf>          -> exec that ELF directly (raw, lean_single CLI)
#   SOUNIO_SOUC_ENGINE=lean_single -> force the legacy lean_single ELF
#   (default)                      -> Madaros; if its raw ELF is not built, fall
#                                     back to lean_single with a visible notice so
#                                     no caller hard-breaks in an unbuilt checkout.
#
# Environment passthrough:
#   SOUNIO_STDLIB_PATH   forwarded to whichever engine runs
#   MADAROS_RAW_BIN / SOUNIO_MADAROS_BIN  override the Madaros raw ELF
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# The preserved lean_single fixed-point ELF (escape hatch + fallback target).
LEAN_SINGLE="$ROOT_DIR/bin/souc-lean-single-x86_64"
[[ -x "$LEAN_SINGLE" ]] || LEAN_SINGLE="$ROOT_DIR/bin/souc-linux-x86_64"

_is_elf() { [[ -n "${1:-}" && -x "$1" && "$(head -c2 "$1" 2>/dev/null)" != '#!' ]]; }

# Resolve the Madaros raw ELF, mirroring bin/madaros's resolution order.
_resolve_madaros() {
  local cand
  for cand in "${MADAROS_RAW_BIN:-}" "${SOUNIO_MADAROS_BIN:-}" \
              "$ROOT_DIR/artifacts/self-hosted/madaros" "$ROOT_DIR/bin/madaros-linux-x86_64"; do
    if _is_elf "$cand"; then echo "$cand"; return 0; fi
  done
  return 1
}

# souc-flavoured help. The `check|compile|run <file.sio>` tokens are the repo-wide
# capability-probe contract (scripts grep `souc --help` for `compile <file.sio>` /
# `run <file.sio>` to decide between the verb CLI and the raw `SRC OUT` form). We
# only print this when the Madaros engine is actually resolved — Madaros supports
# the verbs, so the probe correctly selects the verb form. In the lean_single
# fallback we delegate --help to the raw ELF (no verb tokens), so probes correctly
# select the raw `SRC OUT` form that lean_single understands.
_print_souc_help() {
  cat <<'USAGE'
souc — the Sounio compiler (default engine: Madaros)

Usage:
  souc --version                      print compiler identity
  souc info                           print compiler status
  souc check <file.sio>               parse, resolve and typecheck
  souc compile <file.sio> [-o OUT]    compile <file.sio> to a native ELF
  souc run <file.sio>                 run <file.sio> (compile to a temp ELF and execute)

Engine selection:
  SOUNIO_SOUC_ENGINE=lean_single      force the legacy lean_single engine (raw `souc SRC OUT`)
  MADAROS_RAW_BIN=<elf>               override the Madaros raw ELF
USAGE
}

# 1) Explicit ELF override: honor it directly (raw lean_single-style CLI).
if _is_elf "${SOUNIO_SOUC_BIN:-}"; then
  exec "$SOUNIO_SOUC_BIN" "$@"
fi

# 2) Forced legacy engine.
case "${SOUNIO_SOUC_ENGINE:-madaros}" in
  lean_single|lean-single|leansingle)
    if [[ ! -x "$LEAN_SINGLE" ]]; then
      echo "souc: SOUNIO_SOUC_ENGINE=lean_single but no lean_single ELF found at $LEAN_SINGLE" >&2
      exit 127
    fi
    exec "$LEAN_SINGLE" "$@"
    ;;
esac

# 3) Default: Madaros (via bin/madaros, which maps the souc verbs to the raw ELF).
if MADAROS_ELF="$(_resolve_madaros)"; then
  # Advertise the souc verb CLI so capability-probing callers select the verb form
  # (which Madaros supports) instead of the raw `SRC OUT` form (which it does not).
  case "${1:-}" in
    -h|--help|help) _print_souc_help; exit 0 ;;
  esac
  exec env MADAROS_RAW_BIN="$MADAROS_ELF" "$ROOT_DIR/bin/madaros" "$@"
fi

# 4) Madaros not built — do not hard-break callers; fall back to lean_single.
if [[ -x "$LEAN_SINGLE" ]]; then
  echo "souc: Madaros raw ELF not found (run 'make build-madaros') — falling back to the" >&2
  echo "souc: legacy lean_single engine. Set SOUNIO_SOUC_ENGINE=lean_single to silence this." >&2
  exec "$LEAN_SINGLE" "$@"
fi

echo "souc: no compiler engine available — build Madaros ('make build-madaros') or provide" >&2
echo "souc: a lean_single ELF at $LEAN_SINGLE." >&2
exit 127
