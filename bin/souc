#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HOST_OS="${SOUNIO_HOST_OS_OVERRIDE:-$(uname -s)}"
HOST_ARCH="${SOUNIO_HOST_ARCH_OVERRIDE:-$(uname -m)}"
WRAPPER_VERSION="${SOUNIO_SOUC_VERSION:-1.0.0-beta.5}"
MACOS_CODESIGN_HELPER="$ROOT_DIR/scripts/lib/macos_codesign.sh"

if [[ -f "$MACOS_CODESIGN_HELPER" ]]; then
  # shellcheck source=/dev/null
  source "$MACOS_CODESIGN_HELPER"
fi

resolve_host_target() {
  case "$HOST_OS:$HOST_ARCH" in
    Linux:x86_64|Linux:amd64)
      printf '%s\n' "x86_64-linux"
      ;;
    Linux:arm64|Linux:aarch64)
      printf '%s\n' "aarch64-linux"
      ;;
    Darwin:arm64|Darwin:aarch64)
      printf '%s\n' "aarch64-macos"
      ;;
    Darwin:x86_64|Darwin:amd64)
      printf '%s\n' "x86_64-macos"
      ;;
    *)
      return 1
      ;;
  esac
}

resolve_host_binary() {
  case "$HOST_OS:$HOST_ARCH" in
    Linux:x86_64|Linux:amd64)
      printf '%s\n' "$ROOT_DIR/bin/souc-linux-x86_64"
      ;;
    Darwin:arm64|Darwin:aarch64)
      printf '%s\n' "$ROOT_DIR/artifacts/self-hosted/souc-self-hosted-arm64-macos"
      ;;
    Darwin:x86_64|Darwin:amd64)
      printf '%s\n' "$ROOT_DIR/artifacts/self-hosted/souc-self-hosted-x86_64-macos"
      ;;
    *)
      return 1
      ;;
  esac
}

if [[ -n "${SOUNIO_SOUC_BIN:-}" ]]; then
  SELECTED_BIN="$SOUNIO_SOUC_BIN"
else
  if ! SELECTED_BIN="$(resolve_host_binary)"; then
    echo "error: unsupported host platform for this checkout: $HOST_OS/$HOST_ARCH" >&2
    echo "hint: supported checked artifacts are Linux x86_64, macOS arm64, and macOS x86_64" >&2
    exit 2
  fi
fi

HOST_TARGET=""
if _resolved_host_target="$(resolve_host_target 2>/dev/null)"; then
  HOST_TARGET="$_resolved_host_target"
fi

if [[ ! -x "$SELECTED_BIN" ]]; then
  echo "error: selected souc binary is missing or not executable: $SELECTED_BIN" >&2
  exit 2
fi

if declare -F sounio_ad_hoc_codesign >/dev/null 2>&1; then
  sounio_ad_hoc_codesign "$SELECTED_BIN"
fi

if [[ "${SOUNIO_SOUC_PRINT_PATH:-0}" == "1" ]]; then
  printf '%s\n' "$SELECTED_BIN"
  exit 0
fi

print_usage() {
  cat <<EOF
usage:
  bin/souc check <source.sio> [--target <triple>] [--show-ast] [--show-types] [--r15-monitor]
  bin/souc compile <source.sio> -o <output> [--target <triple>] [--show-ast] [--show-types] [--r15-monitor]
  bin/souc build <source.sio> -o <output> [--target <triple>] [--show-ast] [--show-types] [--r15-monitor]
  bin/souc run <source.sio> [--target <triple>] [--show-ast] [--show-types] [--r15-monitor] [-- <program args...>]
  bin/souc info
  bin/souc --version

raw pass-through:
  bin/souc <source.sio> <output> [--target <triple>] [--show-ast] [--show-types] [--r15-monitor]
EOF
}

print_info() {
  cat <<EOF
souc_wrapper_version=$WRAPPER_VERSION
host_os=$HOST_OS
host_arch=$HOST_ARCH
host_target=${HOST_TARGET:-unknown}
selected_bin=$SELECTED_BIN
selected_interface=raw-self-hosted
compat_commands=check,compile,build,run,info,version
raw_interface=<source.sio> <output> [--target <triple>] [--show-ast] [--show-types] [--r15-monitor]
EOF
}

raw_compile_quiet() {
  local src="$1"
  local out="$2"
  shift 2

  local output=""
  local rc=0

  set +e
  output="$("$SELECTED_BIN" "$src" "$out" "$@" 2>&1)"
  rc=$?
  set -e

  if [[ $rc -ne 0 ]]; then
    [[ -n "$output" ]] && printf '%s\n' "$output" >&2
    return "$rc"
  fi

  if [[ "${SOUNIO_SOUC_VERBOSE:-0}" == "1" && -n "$output" ]]; then
    printf '%s\n' "$output" >&2
  fi

  chmod +x "$out" 2>/dev/null || true
  if declare -F sounio_ad_hoc_codesign >/dev/null 2>&1; then
    sounio_ad_hoc_codesign "$out"
  fi
}

parse_compat_args() {
  local mode="$1"
  shift

  COMPAT_SOURCE=""
  COMPAT_OUTPUT=""
  COMPAT_TARGET=""
  COMPAT_COMPILER_ARGS=()
  COMPAT_PROGRAM_ARGS=()
  COMPAT_JSON=0

  local saw_program_sep=0

  while [[ $# -gt 0 ]]; do
    if [[ $saw_program_sep -eq 1 ]]; then
      COMPAT_PROGRAM_ARGS+=("$1")
      shift
      continue
    fi

    case "$1" in
      --)
        saw_program_sep=1
        shift
        ;;
      -o|--out)
        if [[ $# -lt 2 ]]; then
          echo "error: missing output path after $1" >&2
          exit 2
        fi
        COMPAT_OUTPUT="$2"
        shift 2
        ;;
      --target)
        if [[ $# -lt 2 ]]; then
          echo "error: missing target triple after --target" >&2
          exit 2
        fi
        COMPAT_TARGET="$2"
        COMPAT_COMPILER_ARGS+=("$1" "$2")
        shift 2
        ;;
      --show-ast|--show-types|--r15-monitor)
        COMPAT_COMPILER_ARGS+=("$1")
        shift
        ;;
      --json)
        COMPAT_JSON=1
        shift
        ;;
      -h|--help)
        print_usage
        exit 0
        ;;
      repl|test|fmt|lint|analyze|diagnostics|sysroot|clean|watch|serve|bench|gpu-emit|emit)
        echo "error: unsupported command for the checked self-hosted launcher: $1" >&2
        echo "hint: use the richer omega/pinned CLI for that workflow" >&2
        exit 2
        ;;
      -*)
        echo "error: unsupported option for wrapper compatibility mode: $1" >&2
        echo "hint: supported wrapper flags are --target, --show-ast, --show-types, --r15-monitor, and -o/--out" >&2
        exit 2
        ;;
      *)
        if [[ -z "$COMPAT_SOURCE" ]]; then
          COMPAT_SOURCE="$1"
        elif [[ -z "$COMPAT_OUTPUT" && "$mode" != "run" && "$mode" != "check" ]]; then
          COMPAT_OUTPUT="$1"
        else
          echo "error: unexpected positional argument in $mode mode: $1" >&2
          exit 2
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$COMPAT_SOURCE" ]]; then
    echo "error: missing source file for $mode" >&2
    exit 2
  fi
}

compat_check() {
  parse_compat_args "check" "$@"

  local tmp_dir
  local rc=0
  tmp_dir="$(mktemp -d)"

  if [[ "$COMPAT_JSON" == "1" ]]; then
    # Capture compiler stderr+stdout into a buffer, parse the canonical
    # `error: <msg> at line <N>` format into sounio.diagnostic.v1 JSON.
    local log="$tmp_dir/check.log"
    if [[ ${#COMPAT_COMPILER_ARGS[@]} -gt 0 ]]; then
      "$SELECTED_BIN" "$COMPAT_SOURCE" "$tmp_dir/check.out" "${COMPAT_COMPILER_ARGS[@]}" \
        >"$log" 2>&1 || rc=$?
    else
      "$SELECTED_BIN" "$COMPAT_SOURCE" "$tmp_dir/check.out" >"$log" 2>&1 || rc=$?
    fi
    emit_diagnostics_json "$COMPAT_SOURCE" "$log"
    rm -rf "$tmp_dir"
    # Exit 0 when JSON is well-formed even if compile failed — the
    # diagnostics array communicates failure. Mirrors the LSP shape.
    return 0
  fi

  if [[ ${#COMPAT_COMPILER_ARGS[@]} -gt 0 ]]; then
    raw_compile_quiet "$COMPAT_SOURCE" "$tmp_dir/check.out" "${COMPAT_COMPILER_ARGS[@]}" || rc=$?
  else
    raw_compile_quiet "$COMPAT_SOURCE" "$tmp_dir/check.out" || rc=$?
  fi
  rm -rf "$tmp_dir"
  return "$rc"
}

# Emit sounio.diagnostic.v1 JSON for a captured compiler log. No `jq`
# dependency — pure bash + printf.
emit_diagnostics_json() {
  local source="$1"
  local log="$2"

  # file:// URI: percent-encode spaces, leave everything else.
  local abs_path
  abs_path="$(readlink -f -- "$source" 2>/dev/null || echo "$source")"
  local uri="file://${abs_path// /%20}"

  local diags_buf=""
  local first=1
  while IFS= read -r line; do
    [[ "$line" =~ ^error:\ (.+)\ at\ line\ ([0-9]+)$ ]] || continue
    local msg="${BASH_REMATCH[1]}"
    local lineno="${BASH_REMATCH[2]}"
    # LSP uses zero-based line numbers; souc reports one-based.
    local lsp_line=$(( lineno - 1 ))
    [[ $lsp_line -lt 0 ]] && lsp_line=0

    # Escape backslash, double-quote, tab, CR in msg.
    # NB: error lines never contain literal newlines (already
    # split by `read -r`), so no `\n` escape needed.
    local esc
    esc=${msg//\\/\\\\}
    esc=${esc//\"/\\\"}
    esc=${esc//$'\t'/\\t}
    esc=${esc//$'\r'/\\r}

    if [[ $first -eq 1 ]]; then
      first=0
    else
      diags_buf="$diags_buf,"
    fi
    diags_buf+=$(printf '{"severity":1,"code":"E001","source":"sounio:type","message":"%s","range":{"start":{"line":%d,"character":0},"end":{"line":%d,"character":0}}}' \
      "$esc" "$lsp_line" "$lsp_line")
  done < "$log"

  printf '{"schema":"sounio.diagnostic.v1","uri":"%s","version":null,"diagnostics":[%s]}\n' \
    "$uri" "$diags_buf"
}

# souc inspect --pos LINE:COL <source.sio>
#
# Best-effort cursor-resolution against the type-checker's per-function
# output. Emits:
#
#   {
#     "schema": "sounio.inspect.v1",
#     "uri": "file://...",
#     "position": {"line": N, "character": M},
#     "found": true|false,
#     "name": "...",            # identifier under cursor, if any
#     "kind": "function" | "identifier" | "keyword" | ...,
#     "signature": "fn NAME(...) -> T with EFFECTS",  # for functions
#     "decl_line": N,           # zero-based line of the declaration
#     "fn_index": N             # fn#N in --show-types
#   }
#
# Resolution path:
#   1. Walk the source for `fn <name>` declarations and record each
#      one's (line, name, end-line).
#   2. Find the declaration whose [start_line, next_decl_line) range
#      contains the cursor.
#   3. Parse `--show-types` output and pick the matching fn# entry by
#      ordinal index (user-defined fns are emitted first).
#   4. If the cursor is on the declarator name itself, also resolve
#      the identifier-under-cursor in the source to fill `name`.
compat_inspect() {
  local source=""
  local line=-1
  local char=-1
  local resolve_name=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pos)
        [[ $# -lt 2 ]] && { echo "error: --pos needs LINE:COL" >&2; exit 2; }
        local p="$2"
        line="${p%%:*}"
        char="${p##*:}"
        shift 2
        ;;
      --resolve)
        [[ $# -lt 2 ]] && { echo "error: --resolve needs NAME" >&2; exit 2; }
        resolve_name="$2"
        shift 2
        ;;
      -h|--help)
        echo "usage: souc inspect --pos LINE:COL <source.sio>" >&2
        echo "       souc inspect --resolve NAME <source.sio>" >&2
        exit 0
        ;;
      *)
        if [[ -z "$source" ]]; then source="$1"
        else echo "error: unexpected arg: $1" >&2; exit 2
        fi
        shift
        ;;
    esac
  done

  [[ -z "$source" ]] && { echo "error: missing source.sio" >&2; exit 2; }

  if [[ -n "$resolve_name" ]]; then
    inspect_resolve "$resolve_name" "$source"
    return $?
  fi

  if ! [[ "$line" =~ ^[0-9]+$ ]] || ! [[ "$char" =~ ^[0-9]+$ ]]; then
    echo "error: --pos LINE:COL or --resolve NAME required" >&2
    exit 2
  fi

  local abs_path
  abs_path="$(readlink -f -- "$source" 2>/dev/null || echo "$source")"
  local uri="file://${abs_path// /%20}"

  # 1. Walk source for `fn NAME` declarations.
  # Recognizes `fn` or `pub fn` at column 0 (or after leading whitespace),
  # followed by an identifier.
  local -a decl_lines=()
  local -a decl_names=()
  local cur=0
  while IFS= read -r src_line; do
    if [[ "$src_line" =~ ^[[:space:]]*(pub[[:space:]]+)?fn[[:space:]]+([A-Za-z_][A-Za-z0-9_]*) ]]; then
      decl_lines+=("$cur")
      decl_names+=("${BASH_REMATCH[2]}")
    fi
    cur=$((cur + 1))
  done < "$source"

  # 2. Find the decl whose range contains `line`.
  local found_idx=-1
  local i
  for ((i = 0; i < ${#decl_lines[@]}; i++)); do
    local start="${decl_lines[$i]}"
    local end
    if (( i + 1 < ${#decl_lines[@]} )); then
      end="${decl_lines[$((i + 1))]}"
    else
      end=$cur
    fi
    if (( line >= start && line < end )); then
      found_idx=$i
      break
    fi
  done

  if (( found_idx < 0 )); then
    printf '{"schema":"sounio.inspect.v1","uri":"%s","position":{"line":%d,"character":%d},"found":false}\n' \
      "$uri" "$line" "$char"
    return 0
  fi

  local fn_name="${decl_names[$found_idx]}"
  local decl_line="${decl_lines[$found_idx]}"

  # 3. Run --show-types, parse fn#<idx> entry. The lean_single output
  # collapses each "fn#N : arity A -> T with EFFECTS" record into
  # newline-separated short tokens; reassemble.
  local tmp_dir
  tmp_dir="$(mktemp -d)"
  local types_log="$tmp_dir/types.log"
  "$SELECTED_BIN" "$source" "$tmp_dir/out.elf" --show-types >"$types_log" 2>&1 || true

  # Reassemble: each fn record spans the line `fn#N` through the next
  # `fn#M` (or EOF). Within that span we expect tokens like
  #  ": arity A", "-> T with EFFECTS", which are split across multiple
  # lines.
  local fn_signature=""
  local in_record=0
  local accum=""
  while IFS= read -r tline; do
    if [[ "$tline" =~ ^fn\#([0-9]+) ]]; then
      local n="${BASH_REMATCH[1]}"
      if [[ "$in_record" == "1" ]]; then break; fi
      if [[ "$n" == "$found_idx" ]]; then
        in_record=1
        continue
      fi
    elif [[ "$in_record" == "1" ]]; then
      # Strip leading whitespace; concat
      local t="${tline# }"
      if [[ -z "$accum" ]]; then accum="$t"
      else accum="$accum $t"
      fi
    fi
  done < "$types_log"
  fn_signature="$accum"
  rm -rf "$tmp_dir"

  # Build the displayed `signature` string.
  local rendered="fn $fn_name $fn_signature"
  # Escape for JSON
  local esc="${rendered//\\/\\\\}"
  esc="${esc//\"/\\\"}"

  printf '{"schema":"sounio.inspect.v1","uri":"%s","position":{"line":%d,"character":%d},"found":true,"name":"%s","kind":"function","decl_line":%d,"fn_index":%d,"signature":"%s"}\n' \
    "$uri" "$line" "$char" "$fn_name" "$decl_line" "$found_idx" "$esc"
}

# inspect_resolve NAME <source.sio>
#
# Best-effort name resolution across the source's `use` graph. BFS over
# directly-imported files (with depth + visited limits to avoid walking
# the whole stdlib). Emits sounio.inspect.v1 JSON on hit, {found:false}
# on miss. Used by the LSP as the third tier of textDocument/definition
# after in-file scan and peer-open-buffer scan both miss.
inspect_resolve() {
  local name="$1"
  local source="$2"

  if ! [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    printf '{"schema":"sounio.inspect.v1","found":false,"error":"bad NAME"}\n'
    return 0
  fi

  local source_abs
  source_abs="$(readlink -f -- "$source" 2>/dev/null || echo "$source")"
  local source_dir
  source_dir="$(dirname -- "$source_abs")"

  # Walk up from source_dir looking for project markers. Any ancestor
  # with souc.toml / .git / Cargo.toml becomes a search root, so
  # `use libs::helpers` from src/main.sio resolves into libs/helpers.sio
  # in a project rooted multiple levels up.
  local -a project_roots=()
  local up="$source_dir"
  local guard=0
  while [[ "$up" != "/" && $guard -lt 16 ]]; do
    if [[ -e "$up/souc.toml" || -e "$up/.git" || -e "$up/Cargo.toml" ]]; then
      project_roots+=("$up")
    fi
    up="$(dirname -- "$up")"
    guard=$((guard + 1))
  done

  local -a roots=("$source_dir")
  local r
  for r in "${project_roots[@]}"; do roots+=("$r"); done
  roots+=("$ROOT_DIR/stdlib" "$ROOT_DIR/self-hosted" "$ROOT_DIR")

  local -a queue=("$source_abs")
  local -A visited=()
  local files_scanned=0
  local files_limit=200

  while (( ${#queue[@]} > 0 && files_scanned < files_limit )); do
    local current="${queue[0]}"
    queue=("${queue[@]:1}")
    [[ -n "${visited[$current]:-}" ]] && continue
    visited[$current]=1
    files_scanned=$((files_scanned + 1))
    [[ -f "$current" ]] || continue

    local hit
    hit="$(awk -v n="$name" '
      {
        line=$0
        sub(/^[[:space:]]+/, "", line)
        if (match(line, "^(pub[[:space:]]+)?(fn|let|var|struct|enum)[[:space:]]+" n "([^A-Za-z0-9_]|$)")) {
          orig=$0
          re="(^|[^A-Za-z0-9_])" n "([^A-Za-z0-9_]|$)"
          if (match(orig, re)) {
            col = RSTART
            ch = substr(orig, col, 1)
            if (ch !~ /[A-Za-z0-9_]/) { col = col + 1 }
            if (line ~ "^(pub[[:space:]]+)?fn[[:space:]]+") k="function"
            else if (line ~ "^(pub[[:space:]]+)?(let|var)[[:space:]]+") k="variable"
            else if (line ~ "^(pub[[:space:]]+)?struct[[:space:]]+") k="struct"
            else if (line ~ "^(pub[[:space:]]+)?enum[[:space:]]+") k="enum"
            else k="identifier"
            print (NR - 1) "\t" (col - 1) "\t" k
            exit
          }
        }
      }
    ' "$current")"

    if [[ -n "$hit" ]]; then
      local decl_line decl_char kind
      IFS=$'\t' read -r decl_line decl_char kind <<<"$hit"
      local uri="file://${current// /%20}"
      printf '{"schema":"sounio.inspect.v1","found":true,"name":"%s","kind":"%s","file":"%s","uri":"%s","decl_line":%d,"decl_char":%d}\n' \
        "$name" "$kind" "$current" "$uri" "$decl_line" "$decl_char"
      return 0
    fi

    while IFS= read -r imp_path; do
      [[ -z "$imp_path" ]] && continue
      local parts="${imp_path//::/ }"
      local -a segs
      read -ra segs <<<"$parts"
      [[ ${#segs[@]} -eq 0 ]] && continue
      local k
      for ((k = ${#segs[@]}; k >= 1; k--)); do
        local rel=""
        local j
        for ((j = 0; j < k; j++)); do
          if [[ -z "$rel" ]]; then rel="${segs[$j]}"
          else rel="$rel/${segs[$j]}"
          fi
        done
        local cand="${rel}.sio"
        local r2
        for r2 in "${roots[@]}"; do
          local p="$r2/$cand"
          if [[ -f "$p" ]]; then
            p="$(readlink -f -- "$p")"
            if [[ -z "${visited[$p]:-}" ]]; then
              queue+=("$p")
            fi
          fi
        done
      done
    done < <(
      awk '
        /^use[[:space:]]+/ {
          line=$0
          sub(/^use[[:space:]]+/, "", line)
          sub(/[[:space:]]*\/\/.*$/, "", line)
          sub(/;[[:space:]]*$/, "", line)
          if (line ~ /\{.*\}/) {
            prefix=line
            sub(/::\{.*$/, "", prefix)
            inner=line
            sub(/^[^{]*\{/, "", inner)
            sub(/\}.*$/, "", inner)
            n=split(inner, items, ",")
            for (i = 1; i <= n; i++) {
              s=items[i]
              gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
              if (s != "") print prefix "::" s
            }
          } else {
            gsub(/[[:space:]]/, "", line)
            if (line != "") print line
          }
        }
      ' "$current"
    )
  done

  printf '{"schema":"sounio.inspect.v1","found":false,"name":"%s"}\n' "$name"
}

compat_compile() {
  parse_compat_args "compile" "$@"

  if [[ -z "$COMPAT_OUTPUT" ]]; then
    echo "error: compile/build mode requires -o <output> or a positional output path" >&2
    exit 2
  fi

  local rc=0
  if [[ ${#COMPAT_COMPILER_ARGS[@]} -gt 0 ]]; then
    raw_compile_quiet "$COMPAT_SOURCE" "$COMPAT_OUTPUT" "${COMPAT_COMPILER_ARGS[@]}" || rc=$?
  else
    raw_compile_quiet "$COMPAT_SOURCE" "$COMPAT_OUTPUT" || rc=$?
  fi
  return "$rc"
}

compat_run() {
  parse_compat_args "run" "$@"

  if [[ -n "$HOST_TARGET" && -n "$COMPAT_TARGET" && "$COMPAT_TARGET" != "$HOST_TARGET" ]]; then
    echo "error: run mode only executes host-native outputs in the checked self-hosted launcher" >&2
    echo "hint: use compile for cross-target output ($COMPAT_TARGET) and run it on the matching host" >&2
    exit 2
  fi

  local tmp_dir
  local rc=0
  tmp_dir="$(mktemp -d)"

  local out="$tmp_dir/run.out"
  if [[ ${#COMPAT_COMPILER_ARGS[@]} -gt 0 ]]; then
    raw_compile_quiet "$COMPAT_SOURCE" "$out" "${COMPAT_COMPILER_ARGS[@]}" || rc=$?
  else
    raw_compile_quiet "$COMPAT_SOURCE" "$out" || rc=$?
  fi
  if [[ $rc -eq 0 ]]; then
    "$out" "${COMPAT_PROGRAM_ARGS[@]}" || rc=$?
  fi
  rm -rf "$tmp_dir"
  return "$rc"
}

if [[ $# -eq 0 ]]; then
  print_usage >&2
  exit 2
fi

case "$1" in
  --version|version|-v)
    printf 'souc %s\n' "$WRAPPER_VERSION"
    exit 0
    ;;
  info)
    print_info
    exit 0
    ;;
  --help|help|-h)
    print_usage
    exit 0
    ;;
  check)
    shift
    # NB: `exit $?` (not `exit 0`) — typecheck failures must propagate.
    # `set -e` is unreliable here because compat_check returns via
    # `return "$rc"` after a captured-rc compile, and bash's set -e does
    # not always fire on function-return-nonzero in compound contexts.
    # See docs/audit/PL_ADOPTION_AUDIT_2026-05-27.md §2 / G2.
    set +e
    compat_check "$@"
    _rc=$?
    set -e
    exit "$_rc"
    ;;
  compile|build)
    shift
    set +e
    compat_compile "$@"
    _rc=$?
    set -e
    exit "$_rc"
    ;;
  run)
    shift
    set +e
    compat_run "$@"
    _rc=$?
    set -e
    exit "$_rc"
    ;;
  inspect)
    shift
    set +e
    compat_inspect "$@"
    _rc=$?
    set -e
    exit "$_rc"
    ;;
  lsp)
    shift
    # Sounio Language Server (stdio JSON-RPC). The actual binary is built
    # from self-hosted/lsp/server.sio. If not present, build it now.
    LSP_BIN="$ROOT_DIR/bin/sounio-lsp"
    if [[ ! -x "$LSP_BIN" ]] || [[ "$ROOT_DIR/self-hosted/lsp/server.sio" -nt "$LSP_BIN" ]]; then
      "$SELECTED_BIN" "$ROOT_DIR/self-hosted/lsp/server.sio" "$LSP_BIN" >/dev/null 2>&1 || {
        echo "error: failed to build sounio-lsp from self-hosted/lsp/server.sio" >&2
        exit 1
      }
      chmod +x "$LSP_BIN"
    fi
    exec "$LSP_BIN" "$@"
    ;;
  repl|test|fmt|lint|analyze|diagnostics|sysroot|clean|watch|serve|bench|gpu-emit|emit)
    echo "error: unsupported command for the checked self-hosted launcher: $1" >&2
    echo "hint: use the richer omega/pinned CLI for that workflow" >&2
    exit 2
    ;;
esac

if [[ $# -ge 2 && "$1" != -* ]]; then
  raw_compile_quiet "$1" "$2" "${@:3}"
  exit 0
fi

exec "$SELECTED_BIN" "$@"
