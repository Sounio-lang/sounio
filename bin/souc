#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NATIVE_BIN="${SOUC_NATIVE_BIN:-$ROOT_DIR/artifacts/self-hosted/souc-self-hosted-x86_64}"
export SOUNIO_STDLIB_PATH="${ROOT_DIR}/stdlib"

usage() {
  cat <<'EOF'
Usage:
  souc check <file.sio>
  souc run <file.sio> [-- <program args...>]
  souc compile <file.sio> -o <output>
  souc build <file.sio> --backend native -o <output>
  souc build <file.sio> --backend gpu -o <output.ptx>
  souc info
  souc repl

Notes:
  - Native mode compiles to an ELF before execution.
  - GPU mode emits PTX for CUDA, SPIR-V, or Metal (--gpu-target, default ptx).
  - GPU precision: --gpu-precision f32|f64 (default f64).
  - REPL is not yet supported in native mode.
  - `check --show-ast` and `check --show-types` use native compiler summaries.
EOF
}

require_native() {
  if [[ ! -x "$NATIVE_BIN" ]]; then
    echo "error: native compiler not found at $NATIVE_BIN" >&2
    exit 1
  fi
}

unsupported_flag() {
  echo "error: $1 is not yet supported in native mode" >&2
  exit 2
}

abspath_path() {
  local path="$1"
  if [[ "$path" = /* ]]; then
    printf '%s\n' "$path"
  else
    printf '%s/%s\n' "$PWD" "$path"
  fi
}

compile_quiet() {
  local src="$1"
  local out="$2"
  local log="$3"
  shift 3
  local abs_src abs_out
  abs_src="$(abspath_path "$src")"
  abs_out="$(abspath_path "$out")"
  if (
    cd "$ROOT_DIR"
    "$NATIVE_BIN" "$abs_src" "$abs_out" "$@"
  ) >"$log" 2>&1; then
    return 0
  fi
  cat "$log" >&2
  return 1
}

print_native_summary_log() {
  local log="$1"
  awk '
    /^AST summary:/ { section="ast"; print; next }
    /^Type summary:/ { section="types"; print; next }
    /^compile: fns=/ { section=""; next }
    section == "ast" {
      if ($0 ~ /^struct#/ || $0 ~ /^enum#/ || $0 ~ /^global#/ || $0 ~ /^fn#/ || $0 ~ /^[(]/ || $0 ~ /^ -> /) {
        print
      }
      next
    }
    section == "types" {
      if ($0 ~ /^global#/ || $0 ~ /^fn#/ || $0 ~ /^: arity/ || $0 ~ /^ -> /) {
        print
      }
      next
    }
  ' "$log"
}

parse_check_args() {
  local src_ref="$1"
  local show_ast_ref="$2"
  local show_types_ref="$3"
  shift 3

  printf -v "$src_ref" '%s' ""
  printf -v "$show_ast_ref" '%s' "0"
  printf -v "$show_types_ref" '%s' "0"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        cat <<'EOF'
Type-check a Sounio source file without keeping the produced ELF

Usage:
  souc check <file.sio> [--show-ast] [--show-types]
EOF
        exit 0
        ;;
      --show-ast)
        printf -v "$show_ast_ref" '%s' "1"
        shift
        ;;
      --show-types)
        printf -v "$show_types_ref" '%s' "1"
        shift
        ;;
      -*)
        echo "error: unsupported argument for check: $1" >&2
        exit 2
        ;;
      *)
        if [[ -z "${!src_ref}" ]]; then
          printf -v "$src_ref" '%s' "$1"
        else
          echo "error: unexpected extra argument: $1" >&2
          exit 2
        fi
        shift
        ;;
    esac
  done

  if [[ -z "${!src_ref}" ]]; then
    echo "error: missing input .sio file" >&2
    exit 2
  fi
}

parse_build_args() {
  local src_ref="$1"
  local out_ref="$2"
  local backend_ref="$3"
  local gpu_target_ref="$4"
  local gpu_precision_ref="$5"
  shift 5

  printf -v "$src_ref" '%s' ""
  printf -v "$out_ref" '%s' "a.elf"
  printf -v "$backend_ref" '%s' "native"
  printf -v "$gpu_target_ref" '%s' "ptx"
  printf -v "$gpu_precision_ref" '%s' "f64"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      -o)
        if [[ $# -lt 2 ]]; then
          echo "error: missing output after -o" >&2
          exit 2
        fi
        printf -v "$out_ref" '%s' "$2"
        shift 2
        ;;
      --backend)
        if [[ $# -lt 2 ]]; then
          echo "error: missing backend after --backend" >&2
          exit 2
        fi
        printf -v "$backend_ref" '%s' "$2"
        shift 2
        ;;
      --backend=*)
        printf -v "$backend_ref" '%s' "${1#--backend=}"
        shift
        ;;
      --gpu-target)
        if [[ $# -lt 2 ]]; then
          echo "error: missing target after --gpu-target" >&2
          exit 2
        fi
        printf -v "$gpu_target_ref" '%s' "$2"
        shift 2
        ;;
      --gpu-precision)
        if [[ $# -lt 2 ]]; then
          echo "error: missing precision after --gpu-precision" >&2
          exit 2
        fi
        printf -v "$gpu_precision_ref" '%s' "$2"
        shift 2
        ;;
      --show-ast|--show-types)
        unsupported_flag "$1"
        ;;
      -*)
        echo "error: unsupported argument in native mode: $1" >&2
        exit 2
        ;;
      *)
        if [[ -z "${!src_ref}" ]]; then
          printf -v "$src_ref" '%s' "$1"
        else
          echo "error: unexpected extra argument: $1" >&2
          exit 2
        fi
        shift
        ;;
    esac
  done

  if [[ -z "${!src_ref}" ]]; then
    echo "error: missing input .sio file" >&2
    exit 2
  fi
}

cmd="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$cmd" in
  help|-h|--help)
    usage
    ;;
  version|-v|--version)
    echo "souc native-wrapper v1.0.0-rc1"
    ;;
  info)
    require_native
    cat <<EOF
souc native-wrapper v1.0.0-rc1
native compiler: $NATIVE_BIN
[+] Native self-hosted compiler
[+] GPU codegen (PTX, SPIR-V, Metal via --backend gpu)
[-] Cranelift JIT
[-] LLVM backend
[-] REPL
[+] --show-ast
[+] --show-types
EOF
    ;;
  repl)
    echo "not yet supported in native mode" >&2
    exit 1
    ;;
  check)
    require_native
    parse_check_args src show_ast show_types "$@"
    tmp_out="$(mktemp /tmp/souc-check-XXXXXX.elf)"
    tmp_log="$(mktemp /tmp/souc-check-XXXXXX.log)"
    trap 'rm -f "$tmp_out" "$tmp_log"' EXIT
    extra_flags=()
    if [[ "$show_ast" == "1" ]]; then
      extra_flags+=(--show-ast)
    fi
    if [[ "$show_types" == "1" ]]; then
      extra_flags+=(--show-types)
    fi
    if compile_quiet "$src" "$tmp_out" "$tmp_log" "${extra_flags[@]}"; then
      compile_ok=true
    else
      compile_ok=false
    fi
    rm -f "$tmp_out"
    if [[ ${#extra_flags[@]} -gt 0 ]]; then
      print_native_summary_log "$tmp_log"
    fi
    # Check for error messages in compiler output
    if grep -q '^error\[E' "$tmp_log" 2>/dev/null || grep -q '^error:' "$tmp_log" 2>/dev/null; then
      grep -E '^error' "$tmp_log"
      exit 1
    fi
    if [[ "$compile_ok" != "true" ]]; then
      echo "Compilation failed" >&2
      cat "$tmp_log" >&2
      exit 1
    fi
    echo "All checks passed"
    ;;
  run)
    require_native
    src="${1:-}"
    if [[ -z "$src" ]]; then
      usage >&2
      exit 1
    fi
    shift || true
    if [[ "${1:-}" == "--" ]]; then
      shift
    fi
    tmp_out="$(mktemp /tmp/souc-run-XXXXXX.elf)"
    tmp_log="$(mktemp /tmp/souc-run-XXXXXX.log)"
    trap 'rm -f "$tmp_out" "$tmp_log"' EXIT
    compile_quiet "$src" "$tmp_out" "$tmp_log"
    chmod +x "$tmp_out"
    exec "$tmp_out" "$@"
    ;;
  compile)
    require_native
    src="${1:-}"
    if [[ -z "$src" ]]; then
      usage >&2
      exit 1
    fi
    shift || true
    out="a.elf"
    extra_flags=()
    if [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
      usage
      exit 0
    fi
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -o)
          out="${2:-}"
          if [[ -z "$out" ]]; then
            echo "error: missing output after -o" >&2
            exit 2
          fi
          shift 2
          ;;
        --show-ast|--show-types)
          extra_flags+=("$1")
          shift
          ;;
        *)
          if [[ "$out" == "a.elf" ]]; then
            out="$1"
            shift
          else
            echo "error: unexpected extra argument: $1" >&2
            exit 2
          fi
          ;;
      esac
    done
    abs_src="$(abspath_path "$src")"
    abs_out="$(abspath_path "$out")"
    (
      cd "$ROOT_DIR"
      "$NATIVE_BIN" "$abs_src" "$abs_out" "${extra_flags[@]}"
    )
    chmod +x "$out"
    ;;
  build)
    require_native
    parse_build_args src out backend gpu_target gpu_precision "$@"
    case "$backend" in
      native|selfhosted-native|"")
        ;;
      gpu)
        abs_src="$(abspath_path "$src")"
        abs_out="$(abspath_path "$out")"
        (
          cd "$ROOT_DIR"
          "$NATIVE_BIN" "$abs_src" "$abs_out" --backend gpu --gpu-target "$gpu_target" --gpu-precision "$gpu_precision"
        )
        ;;
      llvm|cranelift|jit)
        echo "error: backend '$backend' is not available in native-only mode" >&2
        exit 2
        ;;
      *)
        echo "error: unknown backend '$backend'" >&2
        exit 2
        ;;
    esac
    if [[ "$backend" != "gpu" ]]; then
      abs_src="$(abspath_path "$src")"
      abs_out="$(abspath_path "$out")"
      (
        cd "$ROOT_DIR"
        "$NATIVE_BIN" "$abs_src" "$abs_out"
      )
      chmod +x "$out"
    fi
    ;;
  *)
    echo "error: unknown subcommand: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
