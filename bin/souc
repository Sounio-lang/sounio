#!/usr/bin/env bash
# souc — Sounio compiler CLI wrapper
# Translates subcommand interface to native binary interface.
# Usage: souc <subcommand> <file.sio> [options]
#   run     <file.sio>           — compile, execute, clean up
#   check   <file.sio>           — compile only (type-check)
#   compile <file.sio> -o <out>  — compile to output path
#   <file.sio> <out.elf>         — legacy direct interface (passthrough)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NATIVE="$SCRIPT_DIR/souc-native"

if [[ $# -lt 1 ]]; then
    echo "Usage: souc <run|check|compile> <file.sio> [options]" >&2
    exit 1
fi

CMD="$1"

case "$CMD" in
    run)
        if [[ $# -lt 2 ]]; then echo "Usage: souc run <file.sio>" >&2; exit 1; fi
        SRC="$2"
        shift 2
        TMP_ELF="$(mktemp /tmp/souc_run_XXXXXX)"
        cleanup() { rm -f "$TMP_ELF"; }
        trap cleanup EXIT
        # Collect extra flags (pass through to compiler)
        "$NATIVE" "$SRC" "$TMP_ELF" "$@" >&2
        chmod +x "$TMP_ELF"
        exec "$TMP_ELF"
        ;;
    check)
        if [[ $# -lt 2 ]]; then echo "Usage: souc check <file.sio>" >&2; exit 1; fi
        SRC="$2"
        shift 2
        TMP_ELF="$(mktemp /tmp/souc_check_XXXXXX)"
        cleanup() { rm -f "$TMP_ELF"; }
        trap cleanup EXIT
        "$NATIVE" "$SRC" "$TMP_ELF" "$@"
        ;;
    compile)
        # souc compile <file.sio> -o <output>
        if [[ $# -lt 4 ]]; then echo "Usage: souc compile <file.sio> -o <output>" >&2; exit 1; fi
        SRC="$2"
        OUT="$4"
        shift 4
        "$NATIVE" "$SRC" "$OUT" "$@"
        chmod +x "$OUT"
        ;;
    *)
        # Legacy passthrough: souc <source.sio> <output.elf> [flags]
        exec "$NATIVE" "$@"
        ;;
esac
