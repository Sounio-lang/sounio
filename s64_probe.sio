    msc_slow_free_margin_n14, msc_slow_free_margin_n28,
    msc_slow_free_ncrit, msc_slow_free_nlast, msc_slow_free_span,
    msc_fast_cni_margin_n7, msc_fast_cni_margin_n14, msc_fast_cni_margin_n21,
