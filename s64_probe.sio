    print(" n28="); print_f64(msc_fast_free_margin_n28()); print("\n")
    print("FREE ncrit="); pi(msc_fast_free_ncrit()); print(" nlast="); pi(msc_fast_free_nlast()); print(" span="); pi(msc_fast_free_span()); print("\n")

    print("\n=== INH (ke=0.002236, F=0.282, D=1.5mg) ===\n")
