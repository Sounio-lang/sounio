    msc_ind_cni_margin_n7, msc_ind_cni_margin_n14, msc_ind_cni_margin_n28,
    msc_ind_cni_ncrit, msc_ind_cni_nlast, msc_ind_cni_span,
    msc_ind_free_margin_n7, msc_ind_free_margin_n28,
    msc_ind_free_ncrit, msc_ind_free_nlast, msc_ind_free_span,
    msc_pop_cni_cert_n7, msc_pop_free_cert_n28
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== STD (ke=0.01118, F=0.141, D=5mg) ===\n")
    print("CNI  n7="); print_f64(msc_std_cni_margin_n7());
    print(" n14="); print_f64(msc_std_cni_margin_n14());
    print(" n21="); print_f64(msc_std_cni_margin_n21()); print("\n")
    print("CNI  ncrit="); pi(msc_std_cni_ncrit()); print(" nlast="); pi(msc_std_cni_nlast()); print(" span="); pi(msc_std_cni_span()); print("\n")
    print("FREE n7="); print_f64(msc_std_free_margin_n7());
    print(" n28="); print_f64(msc_std_free_margin_n28()); print("\n")
    print("FREE ncrit="); pi(msc_std_free_ncrit()); print(" nlast="); pi(msc_std_free_nlast()); print(" span="); pi(msc_std_free_span()); print("\n")

    print("\n=== SLOW (ke=0.00838, F=0.188, D=2.5mg) ===\n")
