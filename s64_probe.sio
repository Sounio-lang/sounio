    print(" n14="); print_f64(msc_inh_cni_margin_n14());
    print(" n28="); print_f64(msc_inh_cni_margin_n28()); print("\n")
    print("CNI  ncrit="); pi(msc_inh_cni_ncrit()); print(" nlast="); pi(msc_inh_cni_nlast()); print(" span="); pi(msc_inh_cni_span()); print("\n")
    print("FREE n7="); print_f64(msc_inh_free_margin_n7());
    print(" n28="); print_f64(msc_inh_free_margin_n28()); print("\n")
    print("FREE ncrit="); pi(msc_inh_free_ncrit()); print(" nlast="); pi(msc_inh_free_nlast()); print(" span="); pi(msc_inh_free_span()); print("\n")

    print("\n=== IND (ke=0.05590, F=0.047, D=34mg) ===\n")
