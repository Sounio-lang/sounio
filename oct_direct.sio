struct Octonion {
    a: f64,
    b: f64
}

fn oct_norm_sq(o: Octonion) -> f64 {
    return o.a*o.a + o.b*o.b
}

fn main() {
    print("Test: Direct Struct Construction")

    let o1 = Octonion { a: 3.0, b: 4.0 }

    println("o1.a = ")
    println(o1.a)
    println("o1.b = ")
    println(o1.b)

    let nsq = oct_norm_sq(o1)
    println("norm_sq = ")
    println(nsq)
    println("Expected: 25.0")

    if nsq > 24.9 && nsq < 25.1 {
        print("✓ PASS!")
    }
}
