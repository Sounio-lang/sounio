module main

use pbpk::rapamycin_uc_trajectory::{
    uct_c_n1,  uct_c_n7,  uct_c_n14, uct_c_n28, uct_c_n42, uct_c_n56,
    uct_uc_n1, uct_uc_n7, uct_uc_n14, uct_uc_n28, uct_uc_n42, uct_uc_n56,
    uct_cv_n1, uct_cv_n7, uct_cv_n14, uct_cv_n28,
    uct_uc_ratio_n7_n1, uct_uc_ratio_n14_n7, uct_uc_ratio_n28_n14,
    uct_c_ratio_n7_n1, uct_c_ratio_n14_n7,
    uct_double_n
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== Trough concentration c (mg/L) ===\n")
    print("N=1:  "); print_f64(uct_c_n1());  print("\n")
    print("N=7:  "); print_f64(uct_c_n7());  print("\n")
    print("N=14: "); print_f64(uct_c_n14()); print("\n")
    print("N=28: "); print_f64(uct_c_n28()); print("\n")
    print("N=42: "); print_f64(uct_c_n42()); print("\n")
    print("N=56: "); print_f64(uct_c_n56()); print("\n")
    print("\n")
    print("=== Combined uncertainty u_c (mg/L) ===\n")
    print("N=1:  "); print_f64(uct_uc_n1());  print("\n")
    print("N=7:  "); print_f64(uct_uc_n7());  print("\n")
    print("N=14: "); print_f64(uct_uc_n14()); print("\n")
    print("N=28: "); print_f64(uct_uc_n28()); print("\n")
    print("N=42: "); print_f64(uct_uc_n42()); print("\n")
    print("N=56: "); print_f64(uct_uc_n56()); print("\n")
    print("\n")
    print("=== Relative uncertainty CV = u_c/c ===\n")
    print("N=1:  "); print_f64(uct_cv_n1());  print("\n")
    print("N=7:  "); print_f64(uct_cv_n7());  print("\n")
    print("N=14: "); print_f64(uct_cv_n14()); print("\n")
    print("N=28: "); print_f64(uct_cv_n28()); print("\n")
    print("\n")
    print("=== u_c growth ratios ===\n")
    print("uc(7)/uc(1):   "); print_f64(uct_uc_ratio_n7_n1());   print("\n")
    print("uc(14)/uc(7):  "); print_f64(uct_uc_ratio_n14_n7());  print("\n")
    print("uc(28)/uc(14): "); print_f64(uct_uc_ratio_n28_n14()); print("\n")
    print("\n")
    print("=== Trough growth ratios ===\n")
    print("c(7)/c(1):   "); print_f64(uct_c_ratio_n7_n1());  print("\n")
    print("c(14)/c(7):  "); print_f64(uct_c_ratio_n14_n7()); print("\n")
    print("\n")
    print("=== Scanner ===\n")
    print("double_n (uc >= 2*uc_1): "); pi(uct_double_n()); print("\n")
}
