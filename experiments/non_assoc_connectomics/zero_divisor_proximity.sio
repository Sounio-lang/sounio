//@ run-pass
// Phase 1 — Non-Associative Epistemic Connectomics
// zero_divisor_proximity.sio — STUB for Experiment C (sedenion zero-divisors).
//
// Phase 1 scope (per PROTOCOL.md): stub only, no subjects processed.
// Exercises the API: given a 16D feature vector, returns minimum Euclidean
// distance to a hand-picked subset of primitive zero-divisor support points
// drawn from artifacts/research/sedenion_zero_divisor_geometry.v1.json.
//
// In Phase 3, the full 168 projective support classes will replace the
// inline subset and the feature vector will come from a real ABIDE subject.

// =============================================================================
// Primitive support subset (representative; not all 168 classes).
// Each support vector `s` is a 16-dim unit vector `(e_i ± e_j)/√2` — here we
// store the two active indices and the sign. Component 0 is the scalar part.
// The 6 supports below are the `support_pairs` of component 0 in the JSON
// artifact. In Phase 3 this is replaced by loading the full JSON.
// =============================================================================

fn support_i(idx: i32) -> i32 {
    if idx == 0 { return 1 }
    if idx == 1 { return 2 }
    if idx == 2 { return 4 }
    if idx == 3 { return 5 }
    if idx == 4 { return 6 }
    7  // idx == 5
}

fn support_j(idx: i32) -> i32 {
    if idx == 0 { return 10 }
    if idx == 1 { return 9 }
    if idx == 2 { return 15 }
    if idx == 3 { return 14 }
    if idx == 4 { return 13 }
    12  // idx == 5
}

// Distance from feature point f to support s_k, where s_k has unit components
// at indices (support_i(k), support_j(k)) with magnitude sqrt(0.5) each.
// d² = Σ_c (f[c] - s[c])² = |f|² − 2·<f, s> + 1 (since |s|² = 1).
fn dist_sq_to_support(f: &[f64; 16], k: i32) -> f64 with Mut {
    let i = support_i(k)
    let j = support_j(k)
    let inv_sqrt2 = 0.7071067811865476
    var fnorm_sq: f64 = 0.0
    var c: i32 = 0
    while c < 16 {
        fnorm_sq = fnorm_sq + f[c] * f[c]
        c = c + 1
    }
    let dot = f[i] * inv_sqrt2 + f[j] * inv_sqrt2
    fnorm_sq - 2.0 * dot + 1.0
}

// Iterate k = 0..6 (6 supports in this stub) and return the minimum d²
fn min_dist_sq(f: &[f64; 16]) -> f64 with Mut {
    var best: f64 = dist_sq_to_support(f, 0)
    var k: i32 = 1
    while k < 6 {
        let d = dist_sq_to_support(f, k)
        if d < best { best = d }
        k = k + 1
    }
    best
}

fn main() -> i32 with IO, Mut {
    println("=== zero_divisor_proximity: Phase 1 stub ===")

    // Synthetic feature vector: entries decay like 1/(1+c)
    var feat: [f64; 16] = [0.0; 16]
    var c: i32 = 0
    while c < 16 {
        let fc = 1.0 / (1.0 + (c as f64))
        feat[c] = fc * 0.3  // scaled so features are O(0.1)
        c = c + 1
    }

    let d2 = min_dist_sq(&feat)
    print("feature[0..3] = ")
    print_f64(feat[0]); print(", ")
    print_f64(feat[1]); print(", ")
    print_f64(feat[2]); println("")

    print("min_dist² to 6-support subset = ")
    println(d2)

    // Sanity: d² should be ∈ [0, 4] (since both f and supports live on or near
    // unit sphere). Any value outside this range signals a bug.
    if d2 >= 0.0 {
        if d2 <= 4.0 {
            println("PASS: stub distance in valid range")
            return 0
        }
    }
    println("FAIL: distance out of expected range")
    1
}
