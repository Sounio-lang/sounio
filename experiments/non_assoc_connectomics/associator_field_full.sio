//@ run-pass
// Phase 2 — full-cohort associator field computer.
//
// For each ABIDE-I subject, loads 7 Laplacian eigenvectors × 200 ROIs from
// frames.bin, builds 200 node octonions
//   L_i = (1.0, v1[i], v2[i], ..., v7[i])
// and computes ‖[L_i, L_j, L_k]‖² over all C(200, 3) = 1,313,400 triples.
// Reduces to mean + p95 per subject. Emits one CSV row to stdout.
//
// Synthetic fallback: if frames.bin is absent or too small, generates
// α=0.5 synthetic 200-node labels so the pipeline stays exercisable.
//
// CLI (driven by SLURM_ARRAY_TASK_ID in Part B):
//   souc run associator_field_full.sio -- --subject=N [--label=ASD|TD]
// If --subject not given, processes first 1 ASD + 1 TD (synthetic mode).
//
// Fano-plane convention matches
// tests/run-pass/knowledge_octonion_structure.sio and Phase 1
// sim_ground_truth.sio.

// =============================================================================
// BSS arrays — fixed-size, 200-node + 1,313,400-triple capacity
// =============================================================================
var LAB200: [f64; 1600] = [0.0; 1600]           // 200 nodes × 8 octonion channels
var NORMS: [f64; 1313400] = [0.0; 1313400]      // C(200, 3) associator norm² values

// =============================================================================
// Fano-plane associator norm² — inline octonion products, scalar f64.
// IDENTICAL to sim_ground_truth.sio / associator_field.sio.
// =============================================================================
fn assoc_norm_sq(
    a0: f64, a1: f64, a2: f64, a3: f64, a4: f64, a5: f64, a6: f64, a7: f64,
    b0: f64, b1: f64, b2: f64, b3: f64, b4: f64, b5: f64, b6: f64, b7: f64,
    c0: f64, c1: f64, c2: f64, c3: f64, c4: f64, c5: f64, c6: f64, c7: f64,
) -> f64 {
    let p0 = a0*b0 - a1*b1 - a2*b2 - a3*b3 - a4*b4 - a5*b5 - a6*b6 - a7*b7
    let p1 = a0*b1 + a1*b0 + a2*b3 - a3*b2 + a4*b5 - a5*b4 - a6*b7 + a7*b6
    let p2 = a0*b2 + a2*b0 - a1*b3 + a3*b1 + a4*b6 - a6*b4 + a5*b7 - a7*b5
    let p3 = a0*b3 + a3*b0 + a1*b2 - a2*b1 + a4*b7 - a7*b4 - a5*b6 + a6*b5
    let p4 = a0*b4 + a4*b0 - a1*b5 + a5*b1 - a2*b6 + a6*b2 - a3*b7 + a7*b3
    let p5 = a0*b5 + a5*b0 + a1*b4 - a4*b1 + a3*b6 - a6*b3 - a2*b7 + a7*b2
    let p6 = a0*b6 + a6*b0 + a2*b4 - a4*b2 - a3*b5 + a5*b3 + a1*b7 - a7*b1
    let p7 = a0*b7 + a7*b0 - a1*b6 + a6*b1 + a2*b5 - a5*b2 + a3*b4 - a4*b3

    let l0 = p0*c0 - p1*c1 - p2*c2 - p3*c3 - p4*c4 - p5*c5 - p6*c6 - p7*c7
    let l1 = p0*c1 + p1*c0 + p2*c3 - p3*c2 + p4*c5 - p5*c4 - p6*c7 + p7*c6
    let l2 = p0*c2 + p2*c0 - p1*c3 + p3*c1 + p4*c6 - p6*c4 + p5*c7 - p7*c5
    let l3 = p0*c3 + p3*c0 + p1*c2 - p2*c1 + p4*c7 - p7*c4 - p5*c6 + p6*c5
    let l4 = p0*c4 + p4*c0 - p1*c5 + p5*c1 - p2*c6 + p6*c2 - p3*c7 + p7*c3
    let l5 = p0*c5 + p5*c0 + p1*c4 - p4*c1 + p3*c6 - p6*c3 - p2*c7 + p7*c2
    let l6 = p0*c6 + p6*c0 + p2*c4 - p4*c2 - p3*c5 + p5*c3 + p1*c7 - p7*c1
    let l7 = p0*c7 + p7*c0 - p1*c6 + p6*c1 + p2*c5 - p5*c2 + p3*c4 - p4*c3

    let q0 = b0*c0 - b1*c1 - b2*c2 - b3*c3 - b4*c4 - b5*c5 - b6*c6 - b7*c7
    let q1 = b0*c1 + b1*c0 + b2*c3 - b3*c2 + b4*c5 - b5*c4 - b6*c7 + b7*c6
    let q2 = b0*c2 + b2*c0 - b1*c3 + b3*c1 + b4*c6 - b6*c4 + b5*c7 - b7*c5
    let q3 = b0*c3 + b3*c0 + b1*c2 - b2*c1 + b4*c7 - b7*c4 - b5*c6 + b6*c5
    let q4 = b0*c4 + b4*c0 - b1*c5 + b5*c1 - b2*c6 + b6*c2 - b3*c7 + b7*c3
    let q5 = b0*c5 + b5*c0 + b1*c4 - b4*c1 + b3*c6 - b6*c3 - b2*c7 + b7*c2
    let q6 = b0*c6 + b6*c0 + b2*c4 - b4*c2 - b3*c5 + b5*c3 + b1*c7 - b7*c1
    let q7 = b0*c7 + b7*c0 - b1*c6 + b6*c1 + b2*c5 - b5*c2 + b3*c4 - b4*c3

    let r0 = a0*q0 - a1*q1 - a2*q2 - a3*q3 - a4*q4 - a5*q5 - a6*q6 - a7*q7
    let r1 = a0*q1 + a1*q0 + a2*q3 - a3*q2 + a4*q5 - a5*q4 - a6*q7 + a7*q6
    let r2 = a0*q2 + a2*q0 - a1*q3 + a3*q1 + a4*q6 - a6*q4 + a5*q7 - a7*q5
    let r3 = a0*q3 + a3*q0 + a1*q2 - a2*q1 + a4*q7 - a7*q4 - a5*q6 + a6*q5
    let r4 = a0*q4 + a4*q0 - a1*q5 + a5*q1 - a2*q6 + a6*q2 - a3*q7 + a7*q3
    let r5 = a0*q5 + a5*q0 + a1*q4 - a4*q1 + a3*q6 - a6*q3 - a2*q7 + a7*q2
    let r6 = a0*q6 + a6*q0 + a2*q4 - a4*q2 - a3*q5 + a5*q3 + a1*q7 - a7*q1
    let r7 = a0*q7 + a7*q0 - a1*q6 + a6*q1 + a2*q5 - a5*q2 + a3*q4 - a4*q3

    let d0 = l0 - r0
    let d1 = l1 - r1
    let d2 = l2 - r2
    let d3 = l3 - r3
    let d4 = l4 - r4
    let d5 = l5 - r5
    let d6 = l6 - r6
    let d7 = l7 - r7

    d0*d0 + d1*d1 + d2*d2 + d3*d3 + d4*d4 + d5*d5 + d6*d6 + d7*d7
}

// =============================================================================
// Quickselect — partition-based selection of the k-th smallest element in
// a f64 array, in-place. O(n) expected, with median-of-3 pivot.
//
// Returns arr[k] where k is the target index. Permutes `arr` in the process.
// Operates on the global NORMS array (indices [lo, hi] inclusive; k ∈ [lo,hi]).
// Iterative (tail-call via while-loop update of lo/hi) to avoid recursion.
// =============================================================================
fn qs_median_of_3(lo: i64, hi: i64) -> i64 with Mut {
    let mid = lo + (hi - lo) / 2
    // Sort lo, mid, hi in-place so NORMS[mid] becomes the pivot.
    if NORMS[lo as usize] > NORMS[mid as usize] {
        let t = NORMS[lo as usize]
        NORMS[lo as usize] = NORMS[mid as usize]
        NORMS[mid as usize] = t
    }
    if NORMS[lo as usize] > NORMS[hi as usize] {
        let t = NORMS[lo as usize]
        NORMS[lo as usize] = NORMS[hi as usize]
        NORMS[hi as usize] = t
    }
    if NORMS[mid as usize] > NORMS[hi as usize] {
        let t = NORMS[mid as usize]
        NORMS[mid as usize] = NORMS[hi as usize]
        NORMS[hi as usize] = t
    }
    mid
}

fn quickselect_p95(n_total: i64, k: i64) -> f64 with Mut, Div {
    // NORMS[0..n_total] contains the data. Find and return the k-th smallest.
    var lo: i64 = 0
    var hi: i64 = n_total - 1
    while lo < hi {
        if hi - lo < 8 {
            // Small region: insertion sort then return.
            var i = lo + 1
            while i <= hi {
                var j = i
                while j > lo {
                    if NORMS[(j - 1) as usize] > NORMS[j as usize] {
                        let t = NORMS[(j - 1) as usize]
                        NORMS[(j - 1) as usize] = NORMS[j as usize]
                        NORMS[j as usize] = t
                        j = j - 1
                    } else {
                        j = lo - 1  // break
                    }
                }
                i = i + 1
            }
            return NORMS[k as usize]
        }

        // Median-of-3 pivot → moved to lo+1 for partition.
        let pivot_idx = qs_median_of_3(lo, hi)
        let pivot = NORMS[pivot_idx as usize]
        // Move pivot to end-1, scan [lo, hi-1]
        let t = NORMS[pivot_idx as usize]
        NORMS[pivot_idx as usize] = NORMS[(hi - 1) as usize]
        NORMS[(hi - 1) as usize] = t

        // Lomuto partition around pivot (already at hi-1).
        var i2: i64 = lo
        var j2: i64 = lo
        let pivot_pos = hi - 1
        while j2 < pivot_pos {
            if NORMS[j2 as usize] < pivot {
                let t2 = NORMS[i2 as usize]
                NORMS[i2 as usize] = NORMS[j2 as usize]
                NORMS[j2 as usize] = t2
                i2 = i2 + 1
            }
            j2 = j2 + 1
        }
        // Move pivot from pivot_pos to i2.
        let t3 = NORMS[i2 as usize]
        NORMS[i2 as usize] = NORMS[pivot_pos as usize]
        NORMS[pivot_pos as usize] = t3

        // Recurse into the side containing k.
        if k == i2 {
            return NORMS[k as usize]
        } else if k < i2 {
            hi = i2 - 1
        } else {
            lo = i2 + 1
        }
    }
    NORMS[k as usize]
}

// =============================================================================
// CLI arg helper — very simple --subject=N parser. Defaults to 0 if absent.
// =============================================================================
fn parse_subject_arg() -> i64 with IO, Mut, Div {
    let argc = arg_count()
    var i: i64 = 0
    while i < argc {
        let a = get_arg(i)
        let len = str_len(a)
        // Look for '--subject=' prefix (10 chars).
        if len > 10 {
            if str_char_at(a, 0) == 45 {
                if str_char_at(a, 1) == 45 {
                    if str_char_at(a, 2) == 115 {  // 's'
                        if str_char_at(a, 3) == 117 {  // 'u'
                            // Parse integer after '='.
                            var j: i64 = 10  // past "--subject="
                            var val: i64 = 0
                            while j < len {
                                let c = str_char_at(a, j)
                                if c >= 48 && c <= 57 {
                                    val = val * 10 + (c - 48)
                                }
                                j = j + 1
                            }
                            return val
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    0 - 1  // no arg
}

// =============================================================================
// Compute (mean, p95) for labels stored in LAB200. Uses NORMS scratch array.
// Returns via (out_mean[0], out_p95[0]).
// =============================================================================
fn subject_stats(out: &![f64; 2]) with Mut, Div {
    var tidx: i64 = 0
    var i: i32 = 0
    while i < 200 {
        var j = i + 1
        while j < 200 {
            var k = j + 1
            while k < 200 {
                NORMS[tidx as usize] = assoc_norm_sq(
                    LAB200[(i*8+0) as usize], LAB200[(i*8+1) as usize], LAB200[(i*8+2) as usize], LAB200[(i*8+3) as usize],
                    LAB200[(i*8+4) as usize], LAB200[(i*8+5) as usize], LAB200[(i*8+6) as usize], LAB200[(i*8+7) as usize],
                    LAB200[(j*8+0) as usize], LAB200[(j*8+1) as usize], LAB200[(j*8+2) as usize], LAB200[(j*8+3) as usize],
                    LAB200[(j*8+4) as usize], LAB200[(j*8+5) as usize], LAB200[(j*8+6) as usize], LAB200[(j*8+7) as usize],
                    LAB200[(k*8+0) as usize], LAB200[(k*8+1) as usize], LAB200[(k*8+2) as usize], LAB200[(k*8+3) as usize],
                    LAB200[(k*8+4) as usize], LAB200[(k*8+5) as usize], LAB200[(k*8+6) as usize], LAB200[(k*8+7) as usize],
                )
                tidx = tidx + 1
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    // Mean
    var sum: f64 = 0.0
    var m: i64 = 0
    while m < 1313400 {
        sum = sum + NORMS[m as usize]
        m = m + 1
    }
    out[0] = sum / 1313400.0

    // p95: index ⌊0.95 × 1313400⌋ = 1247729  (0-indexed sorted)
    let p95_idx: i64 = 1247729
    out[1] = quickselect_p95(1313400, p95_idx)
}

// =============================================================================
// Synthetic label generator — α-controlled mix. For synthetic-fallback mode
// only. Deterministic given seed.
// =============================================================================
fn rng_next(state: i64) -> i64 with Div {
    let a: i64 = 16807
    let m: i64 = 2147483647
    let q: i64 = 127773
    let r: i64 = 2836
    let hi = state / q
    let lo = state - hi * q
    let t = a * lo - r * hi
    if t > 0 { t } else { t + m }
}

fn rng_uniform(state: i64) -> f64 with Div {
    let m: i64 = 2147483647
    let s = state as f64
    let mf = m as f64
    (s / mf) * 2.0 - 1.0
}

fn fill_synthetic_200(seed: i64) with Mut, Div {
    var rng = seed
    var node: i32 = 0
    while node < 200 {
        rng = rng_next(rng)
        var bucket = rng
        if bucket < 0 { bucket = 0 - bucket }
        let mod10 = bucket - (bucket / 10) * 10
        let full_oct = mod10 < 5  // α = 0.5
        var k: i32 = 0
        while k < 8 {
            rng = rng_next(rng)
            let v = rng_uniform(rng)
            if k >= 4 && !full_oct {
                LAB200[(node*8 + k) as usize] = 0.0
            } else {
                LAB200[(node*8 + k) as usize] = v
            }
            k = k + 1
        }
        node = node + 1
    }
}

// =============================================================================
// Main — SLURM array driver: processes ONE subject per invocation, indexed
// by --subject=N. Falls back to synthetic 1-subject demo if frames.bin absent.
// =============================================================================
fn main() -> i32 with IO, Mut, Div {
    println("group,subject_id,mean,p95,n_triples")

    let subject_arg = parse_subject_arg()

    let path = "artifacts/research/abide/frames.bin"
    let sz = file_size(path)

    if sz > 16 && subject_arg >= 0 {
        // Real ABIDE mode — single subject
        let raw = read_file(path)
        let n_asd = read_i64(raw, 0)
        let n_td = read_i64(raw, 1)
        let n_total = n_asd + n_td
        if subject_arg < n_total {
            // Load subject frame inline (frames.bin: 7 eig × 200 ROI × f64)
            let frame_size: i64 = 1400
            let header: i64 = 2
            var node: i32 = 0
            while node < 200 {
                LAB200[(node * 8 + 0) as usize] = 1.0
                var e: i32 = 0
                while e < 7 {
                    let off = header + subject_arg * frame_size + (e as i64) * 200 + (node as i64)
                    LAB200[(node * 8 + (e + 1)) as usize] = read_f64(raw, off) * 5.0
                    e = e + 1
                }
                node = node + 1
            }
            var out_buf: [f64; 2] = [0.0; 2]
            subject_stats(&!out_buf)
            if subject_arg < n_asd { print("ASD,") } else { print("TD,") }
            print_f64(out_buf[0]); print(",")
            print_f64(out_buf[1]); print(",1313400,")
            print_int(subject_arg)
        }
        return 0
    }

    // Synthetic fallback — 1 subject at α=0.5. Exercisable without real data.
    fill_synthetic_200(42)
    var out_buf: [f64; 2] = [0.0; 2]
    subject_stats(&!out_buf)
    print("SYN,")
    print_f64(out_buf[0]); print(",")
    print_f64(out_buf[1]); print(",1313400,0")
    0
}
