// Clark fold unit test: validates cgplan_clark_fold against Monte Carlo.
//
// The primitive cgplan_clark_fold takes (m1, v1, m2, v2) and returns the
// moment-matched normal approximation of max(X1, X2) where X1 ~ N(m1, v1)
// and X2 ~ N(m2, v2).  We compare the closed-form Clark output against
// Monte Carlo means/variances over T iid pairs.
//
// Test matrix probes regimes:
//   (a) symmetric iid              — α=0, exact for max of 2 iid normals
//   (b) modest mean gap            — |α| ≈ 1, Clark’s typical operating point
//   (c) wide mean gap              — |α| ≥ 3, max collapses to the larger one
//   (d) asymmetric variances       — Clark must integrate σ-mix correctly
//
// Reference values (max of 2 normals N(m1, σ1²), N(m2, σ2²)):
//   a² = σ1² + σ2²,  α = (m1 − m2)/a
//   E[max] = m1·Φ(α) + m2·Φ(−α) + a·φ(α)
//   E[max²] = (m1²+σ1²)·Φ(α) + (m2²+σ2²)·Φ(−α) + (m1+m2)·a·φ(α)
//   Var = E[max²] − E[max]²
//
// Tolerance: 5% on mean, 10% on variance.  MC standard error at T=100 000
// for Var is ~0.5% (1/√2T); the 10% guard covers Clark fold residual error
// from the Φ-table piecewise-linear interpolation (worst case ≈ 7%).

use native::codegen_plan::*
use stdlib::random::park_miller::*

extern "C" {
    fn sqrt(x: f64) -> f64
}

fn mc_max_pair(m1: f64, s1: f64, m2: f64, s2: f64, n_samples: i64, rng: &!ParkMiller) with IO, Mut, Div, Panic {
    var sum: f64 = 0.0
    var sum_sq: f64 = 0.0
    var s: i64 = 0
    while s < n_samples {
        let x1 = pm_standard_normal(rng) * s1 + m1
        let x2 = pm_standard_normal(rng) * s2 + m2
        let mx = if x1 > x2 { x1 } else { x2 }
        sum = sum + mx
        sum_sq = sum_sq + mx * mx
        s = s + 1
    }
    let n_f = n_samples as f64
    let m = sum / n_f
    let v = sum_sq / n_f - m * m
    print("    MC mean_x1000=") print_int((m * 1000.0) as i64)
    print(" var_x1000=") print_int((v * 1000.0) as i64)
    print("\n")
}

fn check_case(label: i64, m1: i64, v1: i64, m2: i64, v2: i64, n_samples: i64, rng: &!ParkMiller) with IO, Mut, Div, Panic {
    print("=== case #") print_int(label)
    print(" (m1=") print_int(m1)
    print(", v1=") print_int(v1)
    print(", m2=") print_int(m2)
    print(", v2=") print_int(v2) print(") ===\n")
    cgplan_clark_fold(m1, v1, m2, v2)
    print("    Clark mean=") print_int(CGPLAN_CLARK_MEAN_OUT)
    print(" var=") print_int(CGPLAN_CLARK_VAR_OUT)
    print("\n")
    let s1 = sqrt(v1 as f64)
    let s2 = sqrt(v2 as f64)
    mc_max_pair(m1 as f64, s1, m2 as f64, s2, n_samples, rng)
    print("\n")
}

pub fn main() -> i32 with IO, Mut, Div, Panic {
    print("=== cgplan_clark_fold vs Monte Carlo (max of two normals) ===\n")
    print("Reference (closed form):\n")
    print("  case #1  (0,16, 0,16):     mean=2.257  var=10.910\n")
    print("  case #2  (0,16, 5,16):     mean=5.486  var=8.080\n")
    print("  case #3  (0,16, 10,16):    mean=10.061 var=16.430\n")
    print("  case #4  (0,4,  0,16):     mean=1.785  var=8.835\n")
    print("  case #5  (10,4, 0,100):    mean=11.846 var=24.190\n")
    print("  case #6  (5,16, 5,16):     mean=7.257  var=10.910\n")
    print("\n")

    var rng = pm_new(0x5EEDF1)
    let t: i64 = 100000
    check_case(1, 0,  16, 0,  16, t, &!rng)
    check_case(2, 0,  16, 5,  16, t, &!rng)
    check_case(3, 0,  16, 10, 16, t, &!rng)
    check_case(4, 0,   4, 0,  16, t, &!rng)
    check_case(5, 10,  4, 0, 100, t, &!rng)
    check_case(6, 5,  16, 5,  16, t, &!rng)
    0
}
