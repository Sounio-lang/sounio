{
  "argv": [
    "python",
    "-m",
    "sounio_kernel",
    "-f",
    "{connection_file}"
  ],
  "display_name": "Sounio",
  "language": "sounio",
  "codemirror_mode": "sounio",
  "file_extension": ".sio",
  "mimetype": "text/x-sounio",
  "name": "sounio",
  "pygments_lexer": "sounio",
  "logo": "data:image/svg+xml;base64,",
  "metadata": {
    "epistemic_support": true,
    "uncertainty_visualization": true,
    "provenance_tracking": true,
    "scientific_computing": true,
    "version": "0.1.0"
  },
  "env": {
    "SOUNIO_PATH": "${HOME}/.sounio",
    "PYTHONPATH": "${PYTHONPATH}:${HOME}/.local/lib/python3.11/site-packages"
  },
  "interrupt_mode": "message",
  "language_info": {
    "name": "sounio",
    "version": "0.1.0",
    "mimetype": "text/x-sounio",
    "file_extension": ".sio",
    "pygments_lexer": "sounio",
    "codemirror_mode": "sounio",
    "nbconvert_exporter": "sounio"
  },
  "help_links": [
    {
      "text": "Sounio Documentation",
      "url": "https://docs.sounio.dev"
    },
    {
      "text": "Epistemic Programming Guide",
      "url": "https://docs.sounio.dev/guide/epistemic"
    },
    {
      "text": "Drug Discovery Examples",
      "url": "https://github.com/sounio-lang/examples/drug-discovery"
    },
    {
      "text": "GitHub Repository",
      "url": "https://github.com/sounio-lang/sounio"
    }
  ]
}