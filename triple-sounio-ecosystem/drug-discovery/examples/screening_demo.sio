// Screening Demo — Lipinski Rule of Five with epistemic uncertainty
//
// Demonstrates virtual screening of 5 candidate molecules.

fn demo_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn print_f64_3(v: f64) -> i64 with IO, Panic, Div {
    if v < 0.0 {
        print("-")
        let neg_v = 0.0 - v
        let ip = neg_v as i64
        let frac = ((neg_v - (ip as f64)) * 1000.0) as i64
        print_int(ip)
        print(".")
        if frac < 100 { print("0") }
        if frac < 10 { print("0") }
        print_int(frac)
        return 0
    }
    let ip = v as i64
    let frac = ((v - (ip as f64)) * 1000.0) as i64
    print_int(ip)
    print(".")
    if frac < 100 { print("0") }
    if frac < 10 { print("0") }
    print_int(frac)
    return 0
}

struct DK {
    value: f64,
    epsilon: f64,
    prov_id: i64
}

struct Molecule {
    mw: DK,
    logp: DK,
    hbd: i64,
    hba: i64,
    id: i64
}

fn screen_mw(mw: DK) -> f64 with Div, Panic {
    let threshold = 500.0
    let diff = threshold - mw.value
    let unc = (1.0 - mw.epsilon) * mw.value * 0.1
    if unc < 0.001 {
        if mw.value < threshold { return 1.0 }
        return 0.0
    }
    if diff > unc { return 1.0 }
    if diff < (0.0 - unc) { return 0.0 }
    return ((diff + unc) / (2.0 * unc)) * mw.epsilon
}

fn screen_logp(lp: DK) -> f64 with Div, Panic {
    let threshold = 5.0
    let diff = threshold - lp.value
    let unc = (1.0 - lp.epsilon) * demo_abs(lp.value) * 0.2
    if unc < 0.001 {
        if lp.value < threshold { return 1.0 }
        return 0.0
    }
    if diff > unc { return 1.0 }
    if diff < (0.0 - unc) { return 0.0 }
    return ((diff + unc) / (2.0 * unc)) * lp.epsilon
}

fn print_knowledge(v: f64, eps: f64, label: i64) with IO, Panic, Div {
    print("    Knowledge { value: ")
    let _ = print_f64_3(v)
    print(" epsilon: ")
    let _ = print_f64_3(eps)
    print(" prov: \"lipinski_screen\" }")
    println("")
}

fn screen_one(mol: Molecule) -> i64 with IO, Div, Panic, Mut {
    let mw_c = screen_mw(mol.mw)
    let lp_c = screen_logp(mol.logp)

    var hbd_ok = 0
    if mol.hbd <= 5 { hbd_ok = 1 }
    var hba_ok = 0
    if mol.hba <= 10 { hba_ok = 1 }

    let hbd_f = hbd_ok as f64
    let hba_f = hba_ok as f64
    let conf = mw_c * lp_c * hbd_f * hba_f

    print("  Molecule ")
    print_int(mol.id)
    println(":")
    print("    MW  = ")
    let _ = print_f64_3(mol.mw.value)
    print(" (eps=")
    let _ = print_f64_3(mol.mw.epsilon)
    print(") -> conf=")
    let _ = print_f64_3(mw_c)
    println("")
    print("    LogP= ")
    let _ = print_f64_3(mol.logp.value)
    print(" (eps=")
    let _ = print_f64_3(mol.logp.epsilon)
    print(") -> conf=")
    let _ = print_f64_3(lp_c)
    println("")
    print("    HBD = ")
    print_int(mol.hbd)
    print(", HBA = ")
    print_int(mol.hba)
    println("")
    print_knowledge(conf, conf, 0)

    if conf > 0.5 {
        println("    => PASS")
        return 1
    }
    println("    => FAIL")
    return 0
}

fn main() -> i64 with IO, Div, Panic, Mut {
    println("========================================")
    println("  Virtual Screening Demo")
    println("  Lipinski Rule of Five (Epistemic)")
    println("========================================")
    println("")

    // Molecule 1: Aspirin-like (should pass easily)
    let m1 = Molecule {
        mw: DK { value: 180.16, epsilon: 0.99, prov_id: 1 },
        logp: DK { value: 1.19, epsilon: 0.95, prov_id: 1 },
        hbd: 1, hba: 4, id: 1
    }

    // Molecule 2: Borderline MW (498 +/- uncertainty)
    let m2 = Molecule {
        mw: DK { value: 498.0, epsilon: 0.85, prov_id: 2 },
        logp: DK { value: 3.5, epsilon: 0.90, prov_id: 2 },
        hbd: 3, hba: 8, id: 2
    }

    // Molecule 3: Fails LogP (too lipophilic)
    let m3 = Molecule {
        mw: DK { value: 350.0, epsilon: 0.95, prov_id: 3 },
        logp: DK { value: 6.2, epsilon: 0.92, prov_id: 3 },
        hbd: 2, hba: 5, id: 3
    }

    // Molecule 4: Fails HBD
    let m4 = Molecule {
        mw: DK { value: 420.0, epsilon: 0.97, prov_id: 4 },
        logp: DK { value: 2.8, epsilon: 0.94, prov_id: 4 },
        hbd: 7, hba: 6, id: 4
    }

    // Molecule 5: Good drug candidate
    let m5 = Molecule {
        mw: DK { value: 312.0, epsilon: 0.98, prov_id: 5 },
        logp: DK { value: 2.1, epsilon: 0.96, prov_id: 5 },
        hbd: 2, hba: 5, id: 5
    }

    var total_pass = 0
    total_pass = total_pass + screen_one(m1)
    println("")
    total_pass = total_pass + screen_one(m2)
    println("")
    total_pass = total_pass + screen_one(m3)
    println("")
    total_pass = total_pass + screen_one(m4)
    println("")
    total_pass = total_pass + screen_one(m5)

    println("")
    println("========================================")
    print("  Summary: ")
    print_int(total_pass)
    println(" / 5 molecules passed")
    println("========================================")

    return 0
}
