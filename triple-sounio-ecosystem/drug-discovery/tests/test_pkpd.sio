//@ run-pass
// Test: PK/PD model calculations

fn t_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn t_exp(x: f64) -> f64 {
    var result = 1.0
    var term = 1.0
    var i = 1
    while i < 20 {
        term = term * x / (i * 1.0)
        result = result + term
        i = i + 1
    }
    return result
}

fn t_log(x: f64) -> f64 with Div, Panic, Mut {
    if x <= 0.0 { return 0.0 }
    let z = (x - 1.0) / (x + 1.0)
    var result = 0.0
    var term = z
    var i = 1
    while i < 40 {
        result = result + term / (i * 1.0)
        term = term * z * z
        i = i + 2
    }
    return 2.0 * result
}

fn print_f64_3(v: f64) -> i64 with IO, Panic, Div {
    if v < 0.0 {
        print("-")
        let neg_v = 0.0 - v
        let ip = neg_v as i64
        let frac = ((neg_v - (ip as f64)) * 1000.0) as i64
        print_int(ip)
        print(".")
        if frac < 100 { print("0") }
        if frac < 10 { print("0") }
        print_int(frac)
        return 0
    }
    let ip = v as i64
    let frac = ((v - (ip as f64)) * 1000.0) as i64
    print_int(ip)
    print(".")
    if frac < 100 { print("0") }
    if frac < 10 { print("0") }
    print_int(frac)
    return 0
}

fn main() -> i64 with IO, Div, Panic, Mut {
    let f_val = 0.85
    let ka = 1.2
    let cl = 7.5
    let vd = 50.0
    let ke = cl / vd
    let dose = 500.0

    // Test 1: ke = 0.15
    if t_abs(ke - 0.15) > 0.001 {
        println("FAIL: ke")
        return 1
    }
    print("PASS: ke = ")
    let _ = print_f64_3(ke)
    println("")

    // Test 2: half-life ~ 4.62
    let hl = 0.693147 / ke
    if t_abs(hl - 4.621) > 0.1 {
        println("FAIL: half-life")
        return 1
    }
    print("PASS: t1/2 = ")
    let _ = print_f64_3(hl)
    println("")

    // Test 3: tmax in [1, 5]
    let ratio = ka / ke
    let log_r = t_log(ratio)
    let tmax = log_r / (ka - ke)
    if tmax < 1.0 {
        println("FAIL: tmax < 1")
        return 1
    }
    if tmax > 5.0 {
        println("FAIL: tmax > 5")
        return 1
    }
    print("PASS: tmax = ")
    let _ = print_f64_3(tmax)
    println("")

    // Test 4: C(0) = 0 for oral model
    let rd = ka - ke
    let denom = vd * rd
    let coeff = (f_val * dose * ka) / denom
    let c0 = coeff * (t_exp(0.0) - t_exp(0.0))
    if t_abs(c0) > 0.001 {
        println("FAIL: C(0) != 0")
        return 1
    }
    println("PASS: C(0) = 0")

    // Test 5: AUC ~ 56.67
    let auc = f_val * dose / cl
    if t_abs(auc - 56.667) > 1.0 {
        println("FAIL: AUC")
        return 1
    }
    print("PASS: AUC = ")
    let _ = print_f64_3(auc)
    println("")

    // Test 6: Cmax > 0
    let c_tmax = coeff * (t_exp(0.0 - ke * tmax) - t_exp(0.0 - ka * tmax))
    if c_tmax <= 0.0 {
        println("FAIL: Cmax <= 0")
        return 1
    }
    print("PASS: Cmax = ")
    let _ = print_f64_3(c_tmax)
    println("")

    println("All PK/PD tests passed")
    return 0
}
