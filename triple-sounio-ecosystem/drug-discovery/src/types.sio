// Drug Discovery Pipeline — Core Types
//
// Defines molecular, patient, and pharmacokinetic data structures
// with epistemic uncertainty throughout.

fn dd_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// Core epistemic knowledge wrapper
struct DrugKnowledge {
    value: f64,
    epsilon: f64,
    prov_id: i64
}

fn dk_new(val: f64, eps: f64, prov: i64) -> DrugKnowledge {
    DrugKnowledge { value: val, epsilon: eps, prov_id: prov }
}

fn dk_from_exact(val: f64) -> DrugKnowledge {
    DrugKnowledge { value: val, epsilon: 1.0, prov_id: 0 }
}

fn dk_add(a: DrugKnowledge, b: DrugKnowledge) -> DrugKnowledge {
    DrugKnowledge { value: a.value + b.value, epsilon: a.epsilon * b.epsilon, prov_id: 100 }
}

fn dk_sub(a: DrugKnowledge, b: DrugKnowledge) -> DrugKnowledge {
    DrugKnowledge { value: a.value - b.value, epsilon: a.epsilon * b.epsilon, prov_id: 100 }
}

fn dk_mul(a: DrugKnowledge, b: DrugKnowledge) -> DrugKnowledge {
    DrugKnowledge { value: a.value * b.value, epsilon: a.epsilon * b.epsilon, prov_id: 100 }
}

fn dk_div(a: DrugKnowledge, b: DrugKnowledge) -> DrugKnowledge with Div, Panic {
    if dd_abs(b.value) < 1e-15 { return dk_new(0.0, 0.0, 0) }
    DrugKnowledge { value: a.value / b.value, epsilon: a.epsilon * b.epsilon * 0.99, prov_id: 100 }
}

fn dk_scale(a: DrugKnowledge, s: f64) -> DrugKnowledge {
    DrugKnowledge { value: a.value * s, epsilon: a.epsilon, prov_id: a.prov_id }
}

// Molecular descriptor for virtual screening
struct MoleculeDesc {
    mol_weight: DrugKnowledge,
    log_p: DrugKnowledge,
    hbd: i64,
    hba: i64,
    name_id: i64
}

fn molecule_new(mw: f64, mw_eps: f64, lp: f64, lp_eps: f64, hbd: i64, hba: i64, name: i64) -> MoleculeDesc {
    MoleculeDesc {
        mol_weight: dk_new(mw, mw_eps, 10),
        log_p: dk_new(lp, lp_eps, 11),
        hbd: hbd,
        hba: hba,
        name_id: name
    }
}

// PK parameter set
struct PKParams {
    bioavailability: DrugKnowledge,
    absorption_rate: DrugKnowledge,
    elimination_rate: DrugKnowledge,
    volume_dist: DrugKnowledge,
    clearance: DrugKnowledge
}

fn pk_default() -> PKParams with Div, Panic {
    let cl = dk_new(7.5, 0.87, 24)
    let vd = dk_new(50.0, 0.90, 23)
    PKParams {
        bioavailability: dk_new(0.85, 0.92, 20),
        absorption_rate: dk_new(1.2, 0.88, 21),
        elimination_rate: DrugKnowledge { value: cl.value / vd.value, epsilon: cl.epsilon * vd.epsilon * 0.99, prov_id: 22 },
        volume_dist: vd,
        clearance: cl
    }
}

// Patient data
struct PatientData {
    weight_kg: f64,
    age_years: i64,
    dose_mg: DrugKnowledge,
    creatinine_clearance: DrugKnowledge
}

fn patient_new(weight: f64, age: i64, dose: f64, dose_eps: f64) -> PatientData {
    PatientData {
        weight_kg: weight,
        age_years: age,
        dose_mg: dk_new(dose, dose_eps, 30),
        creatinine_clearance: dk_new(100.0, 0.85, 31)
    }
}

// Screening result
struct ScreeningResult {
    passes_mw: i64,
    passes_logp: i64,
    passes_hbd: i64,
    passes_hba: i64,
    confidence: f64,
    overall_pass: i64
}

// Trial result
struct TrialResult {
    n_patients: i64,
    efficacy_rate: DrugKnowledge,
    adverse_rate: DrugKnowledge,
    therapeutic_index: DrugKnowledge,
    recommend_proceed: i64
}

// Pipeline result
struct PipelineResult {
    screening_pass: i64,
    screening_confidence: f64,
    pk_half_life: DrugKnowledge,
    pk_cmax: DrugKnowledge,
    trial_efficacy: DrugKnowledge,
    trial_safety: DrugKnowledge,
    final_decision: i64,
    final_confidence: f64
}
