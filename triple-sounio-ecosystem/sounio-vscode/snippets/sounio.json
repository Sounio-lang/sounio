{
  "Function with effect": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:ReturnType} with ${4:IO} {",
      "\t${0}",
      "}"
    ],
    "description": "Function definition with effect annotation"
  },
  "Main function": {
    "prefix": "main",
    "body": [
      "fn main() with IO {",
      "\t${0}",
      "}"
    ],
    "description": "Main entry point"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:Type},",
      "\t${0}",
      "}"
    ],
    "description": "Struct definition"
  },
  "Linear struct": {
    "prefix": "linear",
    "body": [
      "linear struct ${1:Name} {",
      "\t${2:field}: ${3:Type},",
      "\t${0}",
      "}"
    ],
    "description": "Linear (must-use) struct definition"
  },
  "Impl block": {
    "prefix": "impl",
    "body": [
      "impl ${1:TypeName} {",
      "\tfn ${2:method}(self: &${1:TypeName}${3:, ${4:param}: ${5:Type}}) -> ${6:ReturnType} with ${7:Pure} {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Impl block with method"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:Variant1},",
      "\t${3:Variant2},",
      "\t${0}",
      "}"
    ],
    "description": "Enum definition"
  },
  "Let binding": {
    "prefix": "let",
    "body": "let ${1:name}: ${2:Type} = ${0}",
    "description": "Immutable binding"
  },
  "Var binding": {
    "prefix": "var",
    "body": "var ${1:name}: ${2:Type} = ${0}",
    "description": "Mutable binding"
  },
  "If-else": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${2}",
      "} else {",
      "\t${0}",
      "}"
    ],
    "description": "If-else expression"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:collection} {",
      "\t${0}",
      "}"
    ],
    "description": "For-in loop"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t${0}",
      "}"
    ],
    "description": "While loop"
  },
  "Match expression": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:Pattern1} => ${3:result1},",
      "\t${4:Pattern2} => ${5:result2},",
      "\t_ => ${0}",
      "}"
    ],
    "description": "Match expression"
  },
  "Knowledge measurement": {
    "prefix": "know",
    "body": "let ${1:name}: Knowledge<${2:mg}> = measure(${3:value}, uncertainty: ${4:0.1})",
    "description": "Epistemic measurement with uncertainty (GUM)"
  },
  "Module declaration": {
    "prefix": "module",
    "body": [
      "module ${1:name} {",
      "\t${0}",
      "}"
    ],
    "description": "Module declaration"
  },
  "Import": {
    "prefix": "import",
    "body": "import ${1:module}::${0}",
    "description": "Import statement"
  },
  "Type alias": {
    "prefix": "type",
    "body": "type ${1:Name} = ${0}",
    "description": "Type alias"
  },
  "Refinement type": {
    "prefix": "tyref",
    "body": "type ${1:Name} = { ${2:x}: ${3:f64} | ${4:x > 0} }",
    "description": "Refinement type definition"
  },
  "Effect annotation": {
    "prefix": "with",
    "body": "with ${1:IO, Alloc}",
    "description": "Effect annotation clause"
  },
  "Unit declaration": {
    "prefix": "unit",
    "body": "unit ${1:name};",
    "description": "Unit of measure declaration"
  },
  "Trait definition": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "\tfn ${2:method}(self: &Self) -> ${3:ReturnType} with ${4:Pure}",
      "\t${0}",
      "}"
    ],
    "description": "Trait definition"
  },
  "Effect definition": {
    "prefix": "effect",
    "body": [
      "effect ${1:Name} {",
      "\tfn ${2:operation}(${3:params}) -> ${4:ReturnType}",
      "\t${0}",
      "}"
    ],
    "description": "Algebraic effect definition"
  },
  "Handler block": {
    "prefix": "handler",
    "body": [
      "handler ${1:EffectName} {",
      "\tfn ${2:operation}(${3:params}) -> ${4:ReturnType} {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Effect handler block"
  },
  "Linear struct with drop": {
    "prefix": "linearfull",
    "body": [
      "linear struct ${1:Name} {",
      "\t${2:field}: ${3:Type},",
      "}",
      "",
      "impl ${1:Name} {",
      "\tfn drop(self: ${1:Name}) with ${4:IO} {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Linear struct with explicit drop implementation"
  }
}
