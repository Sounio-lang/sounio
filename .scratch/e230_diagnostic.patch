+// Write a rodata slice (offset..offset+len) to stderr via sys_write.
+// Factored out of nc_core_emit_alloc_failure_diagnostic_into so the 90% drift
+// warning block can also emit multi-segment messages without duplicating the
+// LEA / reloc / mov / syscall sequence. Takes nc by `&!` so the caller keeps
+// ownership of the NativeCompiler and never has to remember to assign.
+fn nc_write_rodata_to_stderr_into(nc: &! NativeCompiler, offset: i64, len: i64) with Mut, Panic, Div {
     let lea_pos = (*nc).code.len
     nc_emit_lea_rax_rip_disp32(nc, 0)
-    nc_add_rodata_reloc(nc, lea_pos + 3, rodata_offset)
+    nc_add_rodata_reloc(nc, lea_pos + 3, offset)
     nc_emit_mov_reg_reg(nc, 6, 0)
