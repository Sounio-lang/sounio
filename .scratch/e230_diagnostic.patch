+// Append a fixed-size byte array to the current rodata cursor.
+// Used by the diagnostic paths to assemble multi-segment literals at
+// compile time instead of hand-unrolling dozens of native_v2_rodata_append_byte_into
+// calls. n is the number of bytes to append (must be <= 64).
+fn nc_append_rodata_bytes(nc: &! NativeCompiler, bytes: [i64; 64], n: i64) with Mut, Panic, Div {
+    var i = 0
+    while i < n {
+        native_v2_rodata_append_byte_into(nc, bytes[i])
+        i = i + 1
+    }
+}
