+fn nc_core_emit_alloc_failure_diagnostic_into(nc: &! NativeCompiler, fail_code: i64) with Mut, Panic, Div {
+    // Emit a short prefix naming which resource exhausted, then the live
+    // counter, then " of ", then the limit, then a trailing marker.
+    let rodata_offset = native_v2_rodata_len_into(nc)
+    if fail_code == 181 {
+        // "madaros: arena full: cursor=" (28 bytes)
+        let p1 = [109,97,100,97,114,111,115,58,32,97,114,101,110,97,32,102,117,108,108,58,32,99,117,114,115,111,114,61]
+        nc_append_rodata_bytes(nc, p1, 28)
+    } else {
+        // "madaros: handles full: count=" (29 bytes)
+        let p1 = [109,97,100,97,114,111,115,58,32,104,97,110,100,108,101,115,32,102,117,108,108,58,32,99,111,117,110,116,61]
+        nc_append_rodata_bytes(nc, p1, 29)
+    }
+    let literal1_len = native_v2_rodata_len_into(nc) - rodata_offset
+    let literal1_off = rodata_offset
+
+    // Set up a fresh rbp frame so emit_inline_itoa_stderr can use a
+    // rbp-relative stack buffer (it expects rbp = rsp on entry).
+    nc_emit_byte(nc, 0x55)                     // push rbp
+    nc_emit_byte(nc, 0x48)
+    nc_emit_byte(nc, 0x89)
+    nc_emit_byte(nc, 0xe5)                     // mov rbp, rsp
+    nc_emit_sub_rsp_imm32(nc, 48)              // 48-byte itoa stack buffer
+
+    nc_write_rodata_to_stderr_into(nc, literal1_off, literal1_len)
+
+    if fail_code == 181 {
+        emit_load_runtime_context_field_rax_into(nc, runtime_context_field_heap_cursor())
+        nc_emit_mov_reg_reg(nc, 7, 0)
+        nc = emit_inline_itoa_stderr(nc)
+    } else {
+        emit_load_runtime_context_field_rax_into(nc, runtime_context_field_handle_count())
+        nc_emit_mov_reg_reg(nc, 7, 0)
+        nc = emit_inline_itoa_stderr(nc)
+    }
+
+    // " of " separator (4 bytes)
+    let p2_off = native_v2_rodata_len_into(nc)
+    let p2 = [32,111,102,32]
+    nc_append_rodata_bytes(nc, p2, 4)
+    nc_write_rodata_to_stderr_into(nc, p2_off, 4)
+
+    if fail_code == 181 {
+        emit_load_runtime_context_field_rax_into(nc, runtime_context_field_heap_limit())
+        nc_emit_mov_reg_reg(nc, 7, 0)
+        nc = emit_inline_itoa_stderr(nc)
+    } else {
+        emit_load_runtime_context_field_rax_into(nc, runtime_context_field_handle_capacity())
+        nc_emit_mov_reg_reg(nc, 7, 0)
+        nc = emit_inline_itoa_stderr(nc)
+    }
+
+    // Trailing marker. For 182, print " (2^22)\n" so the user sees the
+    // power-of-two that bounds the table.
+    if fail_code == 182 {
+        let p3_off = native_v2_rodata_len_into(nc)
+        let p3 = [32,40,50,94,50,50,41,10]
+        nc_append_rodata_bytes(nc, p3, 8)
+        nc_write_rodata_to_stderr_into(nc, p3_off, 8)
+    } else {
+        let p3_off = native_v2_rodata_len_into(nc)
+        let p3 = [10]
+        nc_append_rodata_bytes(nc, p3, 1)
+        nc_write_rodata_to_stderr_into(nc, p3_off, 1)
+    }
+
+    // Tear down the rbp frame.
+    nc_emit_add_rsp_imm32(nc, 48)
+    nc_emit_byte(nc, 0x5d)                     // pop rbp
+
+    nc_emit_exit_code(nc, fail_code)
+}
