//@ run-pass
//!
//! Matcher-free first Sounio authority executable for Operator Seed Kernel v8.

use hardware::pireus::operator_seed_kernel::{
    PireusOskDigest,
    PireusOskVector,
    PIREUS_OSK_LANES,
    PIREUS_OSK_TERMS,
    PIREUS_OSK_PROBES,
    PIREUS_OSK_OK,
    pireus_operator_seed_kernel_request,
    pireus_operator_seed_kernel_parent_paths,
    pireus_operator_seed_kernel_evaluate,
    pireus_osk_basis_witness,
}

fn bit(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_words(words: &[i64; 8]) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(words[word])
        word = word + 1
    }
}

fn print_digest(digest: &PireusOskDigest) with IO, Mut, Panic {
    print_words(&digest.words)
}

fn print_vector(vector: &PireusOskVector) with IO, Mut, Panic {
    var lane: i64 = 0
    while lane < PIREUS_OSK_LANES {
        if lane > 0 { print(":") }
        print_int(vector.lanes[lane])
        lane = lane + 1
    }
}

fn print_negative(name: string, refused: bool) with IO {
    print("PIREUS_OSK_NEGATIVE name=")
    print(name)
    print(" refused=")
    print_int(bit(refused))
    print("\n")
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    print("PIREUS_OSK_BOOT step=main\n")
    let request = pireus_operator_seed_kernel_request()
    print("PIREUS_OSK_BOOT step=request\n")
    let paths = pireus_operator_seed_kernel_parent_paths()
    print("PIREUS_OSK_BOOT step=paths\n")
    let result = pireus_operator_seed_kernel_evaluate(&request, &paths)
    print("PIREUS_OSK_BOOT step=evaluate\n")

    print("SOUNIO_AUTHORITY schema=pireus-operator-seed-kernel.v8")
    print(" role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE\n")

    print("PIREUS_OSK_LINEAGE parent_valid=")
    print_int(bit(result.lineage.parent_valid))
    print(" parent_frozen_match=")
    print_int(bit(result.lineage.parent_frozen_match))
    print(" source_file_match=")
    print_int(bit(result.lineage.parent_source_file_match))
    print(" semantics_receipt_match=")
    print_int(bit(result.lineage.parent_semantics_receipt_match))
    print(" freeze_file_match=")
    print_int(bit(result.lineage.parent_freeze_file_match))
    print(" evidence_file_match=")
    print_int(bit(result.lineage.parent_evidence_file_match))
    print(" process_evidence_bound=")
    print_int(bit(result.lineage.parent_process_evidence_bound))
    print(" process_evidence_externalized=")
    print_int(bit(result.lineage.parent_process_evidence_externalized))
    print(" recursive_parent_evaluation=")
    print_int(bit(result.lineage.parent_recursive_evaluation_used))
    print(" parent_outcome=")
    print_int(result.lineage.parent_outcome_kind)
    print(" parent_bridge=")
    print_int(bit(result.lineage.parent_existing_bridge))
    print(" parent_seed=")
    print_int(bit(result.lineage.parent_operator_seed))
    print(" parent_residual_nonzero=")
    print_int(result.lineage.parent_residual_nonzero)
    print(" word_cell_checks=")
    print_int(result.lineage.seed_word_cell_checks)
    print(" word_cell_failures=")
    print_int(result.lineage.seed_word_cell_failures)
    print(" complete=")
    print_int(bit(result.lineage.complete))
    print("\n")
    print("PIREUS_OSK_PARENT_HASH name=source value=")
    print_words(&result.lineage.parent_source_sha256); print("\n")
    print("PIREUS_OSK_PARENT_HASH name=semantics value=")
    print_words(&result.lineage.parent_semantics_sha256); print("\n")
    print("PIREUS_OSK_PARENT_HASH name=freeze value=")
    print_words(&result.lineage.parent_freeze_sha256); print("\n")

    print("PIREUS_OSK_SEED words=")
    print_words(&result.seed_words)
    print(" nonzero=")
    print_int(result.lineage.parent_residual_nonzero)
    print("\n")
    var cell: i64 = 0
    while cell < 256 {
        print("PIREUS_OSK_SEED_CELL id=")
        print_int(cell)
        print(" left="); print_int(cell / 16)
        print(" right="); print_int(cell - (cell / 16) * 16)
        print(" bit="); print_int(result.seed_cells[cell])
        print("\n")
        cell = cell + 1
    }

    print("PIREUS_OSK_KERNEL kind=")
    print_int(result.operator_ir.operator_kind)
    print(" bits="); print_int(result.operator_ir.bits)
    print(" lanes="); print_int(result.operator_ir.lanes)
    print(" destinations="); print_int(result.operator_ir.destination_count)
    print(" terms_per_destination=")
    print_int(result.operator_ir.terms_per_destination)
    print(" terms="); print_int(result.operator_ir.term_count)
    print(" unique_term_checks=")
    print_int(result.operator_ir.unique_term_checks)
    print(" unique_term_failures=")
    print_int(result.operator_ir.unique_term_failures)
    print(" unique_source_checks=")
    print_int(result.operator_ir.unique_source_checks)
    print(" unique_source_failures=")
    print_int(result.operator_ir.unique_source_failures)
    print(" group_checks=")
    print_int(result.operator_ir.destination_group_checks)
    print(" group_failures=")
    print_int(result.operator_ir.destination_group_failures)
    print(" xor_checks=")
    print_int(result.operator_ir.xor_address_checks)
    print(" xor_failures=")
    print_int(result.operator_ir.xor_address_failures)
    print(" coefficient_checks=")
    print_int(result.operator_ir.coefficient_checks)
    print(" coefficient_failures=")
    print_int(result.operator_ir.coefficient_failures)
    print(" roundtrip_checks=")
    print_int(result.operator_ir.roundtrip_checks)
    print(" roundtrip_failures=")
    print_int(result.operator_ir.roundtrip_failures)
    print(" complete="); print_int(bit(result.operator_ir.complete))
    print("\n")
    var term: i64 = 0
    while term < PIREUS_OSK_TERMS {
        print("PIREUS_OSK_TERM id="); print_int(term)
        print(" destination="); print_int(result.operator_ir.destinations[term])
        print(" left="); print_int(result.operator_ir.left_indices[term])
        print(" right="); print_int(result.operator_ir.right_indices[term])
        print(" coefficient="); print_int(result.operator_ir.coefficients[term])
        print(" source_cell="); print_int(result.operator_ir.source_cells[term])
        print("\n")
        term = term + 1
    }

    print("PIREUS_OSK_BASIS products=")
    print_int(result.basis.products)
    print(" lane_checks="); print_int(result.basis.lane_checks)
    print(" path_checks="); print_int(result.basis.path_checks)
    print(" destination_checks=")
    print_int(result.basis.destination_checks)
    print(" coefficient_checks=")
    print_int(result.basis.coefficient_checks)
    print(" single_support_checks=")
    print_int(result.basis.single_support_checks)
    print(" failures="); print_int(result.basis.failures)
    print(" complete="); print_int(bit(result.basis.complete))
    print("\n")
    var left: i64 = 0
    while left < PIREUS_OSK_LANES {
        var right: i64 = 0
        while right < PIREUS_OSK_LANES {
            let witness = pireus_osk_basis_witness(
                &result.seed_cells, &result.operator_ir, left, right)
            print("PIREUS_OSK_BASIS_PRODUCT left="); print_int(left)
            print(" right="); print_int(right)
            print(" destination="); print_int(witness.destination)
            print(" coefficient="); print_int(witness.coefficient)
            print(" table_value="); print_int(witness.table_value)
            print(" ir_value="); print_int(witness.ir_value)
            print(" table_nonzero=")
            print_int(witness.table_nonzero_lanes)
            print(" ir_nonzero="); print_int(witness.ir_nonzero_lanes)
            print(" lane_checks="); print_int(witness.lane_checks)
            print(" failures="); print_int(witness.failures)
            print(" complete="); print_int(bit(witness.complete))
            print("\n")
            right = right + 1
        }
        left = left + 1
    }

    var probe: i64 = 0
    while probe < PIREUS_OSK_PROBES {
        print("PIREUS_OSK_PROBE id="); print_int(result.probes[probe].id)
        print(" max_abs_a="); print_int(result.probes[probe].max_abs_a)
        print(" max_abs_b="); print_int(result.probes[probe].max_abs_b)
        print(" uniform_bound="); print_int(result.probes[probe].uniform_bound)
        print(" lane_checks="); print_int(result.probes[probe].lane_checks)
        print(" equality_failures=")
        print_int(result.probes[probe].equality_failures)
        print(" bound_checks="); print_int(result.probes[probe].bound_checks)
        print(" bound_failures=")
        print_int(result.probes[probe].bound_failures)
        print(" complete="); print_int(bit(result.probes[probe].complete))
        print("\n")
        print("PIREUS_OSK_PROBE_VECTOR id="); print_int(probe)
        print(" name=a values="); print_vector(&result.probes[probe].a)
        print("\n")
        print("PIREUS_OSK_PROBE_VECTOR id="); print_int(probe)
        print(" name=b values="); print_vector(&result.probes[probe].b)
        print("\n")
        print("PIREUS_OSK_PROBE_OUTPUT id="); print_int(probe)
        print(" path=table values=")
        print_vector(&result.probes[probe].table_output)
        print("\n")
        print("PIREUS_OSK_PROBE_OUTPUT id="); print_int(probe)
        print(" path=ir values=")
        print_vector(&result.probes[probe].ir_output)
        print("\n")
        probe = probe + 1
    }

    print("PIREUS_OSK_CANDIDATE kind=")
    print_int(result.candidate.kind)
    print(" operator_kind="); print_int(result.candidate.operator_kind)
    print(" parent_outcome=")
    print_int(result.candidate.parent_outcome_kind)
    print(" parent_residual_nonzero=")
    print_int(result.candidate.parent_residual_nonzero)
    print(" generated="); print_int(bit(result.candidate.generated))
    print(" future_parent_eligible=")
    print_int(bit(result.candidate.future_parent_eligible))
    print(" seed_words="); print_words(&result.candidate.seed_words)
    print(" kernel_digest=")
    print_digest(&result.candidate.kernel_digest)
    print(" execution_digest=")
    print_digest(&result.candidate.execution_digest)
    print("\n")

    print("PIREUS_OSK_RECEIPT schema=")
    print_int(result.receipt.schema)
    print(" producer_language=")
    print_int(result.receipt.producer_language)
    print(" producer_role="); print_int(result.receipt.producer_role)
    print(" parent_lineage_bound=")
    print_int(bit(result.receipt.parent_lineage_bound))
    print(" parent_frozen_match=")
    print_int(bit(result.receipt.parent_frozen_match))
    print(" parent_process_evidence_bound=")
    print_int(bit(result.receipt.parent_process_evidence_bound))
    print(" parent_process_evidence_externalized=")
    print_int(bit(result.receipt.parent_process_evidence_externalized))
    print(" parent_recursive_evaluation_used=")
    print_int(bit(result.receipt.parent_recursive_evaluation_used))
    print(" seed_admitted=")
    print_int(bit(result.receipt.operator_seed_admitted))
    print(" table_evaluator=")
    print_int(bit(result.receipt.table_evaluator_validated))
    print(" kernel_ir="); print_int(bit(result.receipt.kernel_ir_complete))
    print(" ir_evaluator=")
    print_int(bit(result.receipt.ir_evaluator_validated))
    print(" basis="); print_int(bit(result.receipt.basis_sweep_complete))
    print(" probes="); print_int(bit(result.receipt.dense_probes_complete))
    print(" candidate=")
    print_int(bit(result.receipt.generated_operator_candidate))
    print(" expected_result_used=")
    print_int(bit(result.receipt.expected_result_used))
    print(" target_evidence_used=")
    print_int(bit(result.receipt.target_evidence_used))
    print(" material_evidence_used=")
    print_int(bit(result.receipt.material_evidence_used))
    print(" target_cost_used=")
    print_int(bit(result.receipt.target_cost_used))
    print(" target_performance_used=")
    print_int(bit(result.receipt.target_performance_used))
    print(" semantics_frozen=")
    print_int(bit(result.receipt.semantics_frozen))
    print(" formal_parity_open=")
    print_int(bit(result.receipt.formal_parity_open))
    print(" effect_parity_open=")
    print_int(bit(result.receipt.effect_parity_open))
    print(" material_parity_open=")
    print_int(bit(result.receipt.material_parity_open))
    print(" broad_novelty=")
    print_int(bit(result.receipt.broad_novelty))
    print(" historical_novelty=")
    print_int(bit(result.receipt.historical_novelty))
    print(" priority="); print_int(bit(result.receipt.priority_claim))
    print(" claim_ready="); print_int(bit(result.receipt.claim_ready))
    print("\n")

    print_negative("python_authority", result.negatives.python_authority)
    print_negative("rust_authority", result.negatives.rust_authority)
    print_negative("cpp_authority", result.negatives.cpp_authority)
    print_negative("llm_authority", result.negatives.llm_authority)
    print_negative("lean_authority", result.negatives.lean_authority)
    print_negative("koka_authority", result.negatives.koka_authority)
    print_negative("missing_policy", result.negatives.missing_policy)
    print_negative("wrong_stage", result.negatives.wrong_stage)
    print_negative("missing_parent", result.negatives.missing_parent)
    print_negative("unfrozen_parent", result.negatives.unfrozen_parent)
    print_negative("unbound_parent_source", result.negatives.unbound_parent_source)
    print_negative("unbound_parent_semantics", result.negatives.unbound_parent_semantics)
    print_negative("unbound_parent_freeze", result.negatives.unbound_parent_freeze)
    print_negative("missing_parent_process_evidence", result.negatives.missing_parent_process_evidence)
    print_negative("recursive_parent_evaluation", result.negatives.recursive_parent_evaluation)
    print_negative("prefilled_parent_seed", result.negatives.prefilled_parent_seed)
    print_negative("expected_probe_output", result.negatives.expected_probe_output)
    print_negative("expected_basis_output", result.negatives.expected_basis_output)
    print_negative("expected_digest", result.negatives.expected_digest)
    print_negative("expected_transcript", result.negatives.expected_transcript)
    print_negative("target_evidence", result.negatives.target_evidence)
    print_negative("material_evidence", result.negatives.material_evidence)
    print_negative("target_cost", result.negatives.target_cost)
    print_negative("target_performance", result.negatives.target_performance)
    print_negative("semantic_write", result.negatives.semantic_write)
    print_negative("expected_result_write", result.negatives.expected_result_write)
    print_negative("review_promotion", result.negatives.review_promotion)
    print_negative("broad_novelty", result.negatives.broad_novelty)
    print_negative("historical_novelty", result.negatives.historical_novelty)
    print_negative("priority_claim", result.negatives.priority_claim)
    print_negative("claim_ready", result.negatives.claim_ready)
    print_negative("waiver", result.negatives.waiver)
    print_negative("bridge_as_seed", result.negatives.bridge_as_seed)
    print_negative("zero_seed", result.negatives.zero_seed)
    print_negative("malformed_seed", result.negatives.malformed_seed)
    print("PIREUS_OSK_NEGATIVES total="); print_int(result.negatives.total)
    print(" passed="); print_int(result.negatives.passed)
    print("\n")

    print("PIREUS_OSK_DIGEST name=lineage value=")
    print_digest(&result.lineage_digest); print("\n")
    print("PIREUS_OSK_DIGEST name=seed value=")
    print_digest(&result.seed_digest); print("\n")
    print("PIREUS_OSK_DIGEST name=kernel value=")
    print_digest(&result.kernel_digest); print("\n")
    print("PIREUS_OSK_DIGEST name=probe value=")
    print_digest(&result.probe_digest); print("\n")
    print("PIREUS_OSK_DIGEST name=basis value=")
    print_digest(&result.basis_digest); print("\n")
    print("PIREUS_OSK_DIGEST name=receipt value=")
    print_digest(&result.receipt_digest); print("\n")
    print("PIREUS_OSK_DIGEST name=forge value=")
    print_digest(&result.forge_digest); print("\n")

    print("PIREUS_OSK_RESULT valid="); print_int(bit(result.valid))
    print(" error="); print_int(result.error)
    print(" failure_groups="); print_int(result.failure_groups)
    print(" claim_ready="); print_int(bit(result.receipt.claim_ready))
    print("\n")
    if result.valid && result.error == PIREUS_OSK_OK &&
        result.failure_groups == 0 { 0 } else { 1 }
}
