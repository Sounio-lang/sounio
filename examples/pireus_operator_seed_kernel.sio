//@ run-pass
//@ known-failure: Madaros miscompile (re-measured 2026-10-13): probe id=2 prints lane_checks=16 equality_failures=0 bound_checks=32 bound_failures=0 but complete=0, so the probes, candidate and receipt flags drop and valid=0 error=11 frozen match=0; lean_single prints complete=1 and matches. #2820
//!
//! Frozen Sounio authority executable for Operator Seed Kernel v8.

use hardware::pireus::operator_seed_kernel::{
    PIREUS_OSK_OK,
    pireus_operator_seed_kernel_request,
    pireus_operator_seed_kernel_parent_paths,
    pireus_operator_seed_kernel_execute,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    let request = pireus_operator_seed_kernel_request()
    let paths = pireus_operator_seed_kernel_parent_paths()
    let summary = pireus_operator_seed_kernel_execute(
        &request, &paths, true)
    if summary.valid && summary.error == PIREUS_OSK_OK &&
        summary.failure_groups == 0 && summary.structural_failures == 0 &&
        summary.negative_failures == 0 && summary.frozen_match &&
        summary.frozen_mismatch_code == 0 && !summary.claim_ready {
        0
    } else {
        1
    }
}
