//@ run-pass
//!
//! First Sounio semantic-authority executable for XorConvolution(bits, twist).
//! No count, classification, result bit pattern, or digest in this file
//! predates this execution.

use algebra::xor_convolution::{
    XorDigest, XorPredicateWitness,
    xor_convolution_evaluate,
    xor_convolution_matches_frozen_semantics,
}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_hex_word(word: i64) with IO, Mut {
    var shift: i64 = 28
    while shift >= 0 {
        let nibble = (word >> shift) & 15
        if nibble < 10 { print_char(48 + nibble) }
        else { print_char(87 + nibble) }
        shift = shift - 4
    }
}

fn print_digest(digest: &XorDigest) with IO, Mut {
    var i: i64 = 0
    while i < 8 {
        print_hex_word(digest.words[i])
        i = i + 1
    }
}

fn print_witness(name: string, item: &XorPredicateWitness) with IO, Mut {
    print("XOR_CONV_WITNESS name="); print(name)
    print(" present="); print_int(yes(item.present))
    print(" i="); print_int(item.i)
    print(" j="); print_int(item.j)
    print(" k="); print_int(item.k)
    print(" d="); print_int(item.displacement)
    print(" lhs="); print_int(item.lhs)
    print(" rhs="); print_int(item.rhs)
    print("\n")
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let result = xor_convolution_evaluate(4)
    if !xor_convolution_matches_frozen_semantics(&result) { return 12 }
    let class = &result.classification

    print("XOR_CONV_CONTRACT bits="); print_int(result.contract.bits)
    print(" dimension="); print_int(result.contract.dimension)
    print(" twist="); print_int(result.contract.twist_identity)
    print(" coefficient_domain="); print_int(result.contract.coefficient_domain)
    print(" accumulation_order="); print_int(result.contract.accumulation_order)
    print(" valid="); print_int(yes(result.contract.valid))
    print(" error="); print_int(result.contract.error)
    print("\n")

    print("XOR_CONV_EQUIVALENCE mismatch_count=")
    print_int(result.mismatch_count)
    print(" first_mismatch="); print_int(result.first_mismatch)
    print(" max_abs_difference_bits=")
    print_int(f64_to_bits(result.max_abs_difference))
    print("\n")

    var d: i64 = 0
    while d < result.contract.dimension {
        print("XOR_CONV_RESULT d="); print_int(d)
        print(" direct_bits="); print_int(result.direct_bits[d])
        print(" horizontal_bits="); print_int(result.horizontal_bits[d])
        print(" negative_signs=")
        print_int(class.displacement_negative_counts[d])
        print("\n")
        d = d + 1
    }

    print("XOR_CONV_TWIST plus="); print_int(class.plus_count)
    print(" minus="); print_int(class.minus_count)
    print(" zero="); print_int(class.zero_count)
    print(" other="); print_int(class.other_count)
    print(" zero_free="); print_int(yes(class.zero_free))
    print(" normalized="); print_int(yes(class.normalized))
    print(" displacement_only="); print_int(yes(class.displacement_only))
    print(" rank_one_separable="); print_int(yes(class.rank_one_separable))
    print(" left_square="); print_int(yes(class.left_square))
    print(" group_two_cocycle="); print_int(yes(class.group_two_cocycle))
    print(" associator_defects="); print_int(class.associator_defect_count)
    print("\n")

    print_witness("zero", &class.zero_witness)
    print_witness("normalization", &class.normalization_witness)
    print_witness("displacement", &class.displacement_witness)
    print_witness("separability", &class.separability_witness)
    print_witness("left_square", &class.left_square_witness)
    print_witness("group_two_cocycle", &class.group_two_cocycle_witness)

    print("XOR_CONV_NEGATIVES passed="); print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total)
    print("\n")

    print("XOR_CONV_DIGEST contract="); print_digest(&result.contract_digest)
    print("\nXOR_CONV_DIGEST input="); print_digest(&result.input_digest)
    print("\nXOR_CONV_DIGEST direct="); print_digest(&result.direct_digest)
    print("\nXOR_CONV_DIGEST horizontal=")
    print_digest(&result.horizontal_digest)
    print("\nXOR_CONV_DIGEST twist_table=")
    print_digest(&result.twist_table_digest)
    print("\nXOR_CONV_DIGEST properties=")
    print_digest(&result.property_digest)
    print("\nXOR_CONV_DIGEST witnesses=")
    print_digest(&result.witness_digest)
    print("\n")

    print("XOR_CONV_AUTHORITY language=Sounio role=SEMANTIC_AUTHORITY")
    print(" stage=SOUNIO_EXECUTABLE parity_open=0 claim_ready=0")
    print(" failures="); print_int(result.failures)
    print("\n")
    result.failures as i32
}
