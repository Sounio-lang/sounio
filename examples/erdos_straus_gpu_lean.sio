// Erdos-Straus GPU Oracle + Lean 4 Formal Verification
// This script runs the GPU sieve and generates a Lean 4 formal proof
// script for the first 100 solutions found.

use stdlib::text::format::*
kernel fn es_sieve(threads: i64, offset: i64, count: i64, cap: i64,
                   ox: &![i64], oy: &![i64], oz: &![i64]) with GPU {
    let tid = gpu_thread_id_x()
    if tid < count {
        let n = offset + tid
        var fx: i64 = 0
        var fy: i64 = 0
        var fz: i64 = 0
        if n >= 2 && n < cap {
            let imax: i64 = 9223372036854775807
            var all_overflow: bool = true
            var kx: i64 = 0
            while kx < 256 && fx == 0 {
                let x = n / 4 + 1 + kx
                let p = 4 * x - n
                if p > 0 {
                    let q = n * x
                    var y = q / p
                    if y < x { y = x }
                    var ky: i64 = 0
                    var broke: bool = false
                    while ky < 16384 && fx == 0 && broke == false {
                        if q > 0 && y > imax / q {
                            broke = true
                        } else {
                            all_overflow = false
                            let num = p * y - q
                            if num > 0 {
                                let den = q * y
                                if den % num == 0 {
                                    let z = den / num
                                    if z >= y {
                                        fx = x
                                        fy = y
                                        fz = z
                                    }
                                }
                            }
                            y = y + 1
                            ky = ky + 1
                        }
                    }
                }
                kx = kx + 1
            }
            if fx == 0 && all_overflow == true { fx = -1 }
        }
        ox[tid as usize] = fx
        oy[tid as usize] = fy
        oz[tid as usize] = fz
    }
}

fn main() -> i32 with IO, Mut, Panic, GPU, Alloc, Epistemic {
    var ox: [i64; 100000] = [0; 100000]
    var oy: [i64; 100000] = [0; 100000]
    var oz: [i64; 100000] = [0; 100000]

    let cap: i64 = 100
    let chunk: i64 = 100000

    var off: i64 = 0
    es_sieve(chunk, off, chunk, cap, &!ox, &!oy, &!oz)

    println("import Init.Data.Nat.Basic")
    println("")
    println("-- Auto-generated by Sounio GPU Oracle")
    println("-- Erdős–Straus Conjecture Formal Verification")
    println("-- Proves that 4/n = 1/x + 1/y + 1/z for GPU-found witnesses")
    println("")
    println("def verify_erdos (n x y z : Nat) : Bool :=")
    println("  4 * x * y * z == n * (y * z + x * z + x * y)")
    println("")

    var t: i64 = 0
    var proofs: i64 = 0
    while t < chunk {
        let n = t
        if n >= 2 && n < cap {
            let x = ox[t as usize]
            if x != 0 {
                proofs = proofs + 1
            }
            if x > 0 {
                let y = oy[t as usize]
                let z = oz[t as usize]

                print("theorem erdos_")
                print(format_int(n))
                print(" : verify_erdos ")
                print(format_int(n))
                print(" ")
                print(format_int(x))
                print(" ")
                print(format_int(y))
                print(" ")
                print(format_int(z))
                println(" = true := by rfl")

                proofs = proofs + 1
            }
        }
        t = t + 1
    }

    println("")
    print("-- Generated proofs: ")
    println(format_int(proofs))
    0
}
