// examples/neuroreceptor_pet/pet_2tcm_epistemic.sio
//
// Executable Epistemic PET 2-Tissue Compartment Model (2TCM) — NRM 2026
//
// AUDITED implementation (see commit history).
// Follows the GUM finite-difference Jacobian methodology of
// stdlib/darwin_pbpk/epistemic_pbpk14.sio (JCGM 100:2008 §5.1.3).
//
// Model:
//   dC1/dt = K1*Cp(t) - (k2+k3)*C1 + k4*C2
//   dC2/dt = k3*C1 - k4*C2
//   CT(t)  = C1(t) + C2(t)
//
// Derived:
//   BP_ND = k3/k4
//   V_T   = (K1/k2) * (1 + k3/k4)
//
// Synthetic input:
//   Cp(t) = cp_amp * exp(-cp_decay * t),  t in minutes
//
// Proof-of-concept only. Not a clinical tool.
//
// Author: Demetrios Chiuratto Agourakis
// Reference: JCGM 100:2008 (GUM); Gunn 1998; Innis 2007; Lammertsma 1996

// ============================================================================
// NUMERIC HELPERS (self-contained, mirroring stdlib style)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { return a }
    return b
}

// Babylonian square root. Safe for x >= 0.
fn sqrt_f64(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var g = x
    if g < 1.0 { g = 1.0 }
    var i = 0
    while i < 40 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    return g
}

// exp(x) via aggressive range reduction to |x| <= 0.5 + 20-term Taylor series.
// For |x| <= 0.5, the Taylor series for exp converges to ~1e-15 in ~15 terms.
// Negative inputs are handled as 1 / exp(-x) for numerical stability.
fn exp_f64(x: f64) -> f64 with Mut, Div {
    if x < 0.0 { return 1.0 / exp_f64(0.0 - x) }
    if x > 0.5 {
        let half = exp_f64(x * 0.5)
        return half * half
    }
    // x in [0, 0.5], Taylor series converges quickly
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 20 {
        let di = i as f64
        term = term * x / di
        sum = sum + term
        i = i + 1
    }
    return sum
}

fn ep_finite(x: f64) -> bool {
    if x != x { return false }
    return abs_f64(x) < 1.0e12
}

// ============================================================================
// STRUCTS
// ============================================================================

struct PET2TCMParams {
    k1: f64,
    k2: f64,
    k3: f64,
    k4: f64,
    cp_amp: f64,
    cp_decay: f64,
}

struct PET2TCMState {
    c1: f64,
    c2: f64,
}

struct PETMetrics {
    tac_auc: f64,
    tac_peak: f64,
    t_peak: f64,
    vt: f64,
    bpnd: f64,
    c_final: f64,
    success: bool,
}

struct EpPETPrior {
    mean: [f64; 6],
    variance: [f64; 6],
    confidence: [f64; 6],
    n: i32,
}

struct EpPETResult {
    tac_auc_mean: f64,
    tac_auc_var: f64,
    tac_peak_mean: f64,
    tac_peak_var: f64,
    vt_mean: f64,
    vt_var: f64,
    bpnd_mean: f64,
    bpnd_var: f64,
    confidence: f64,
    sensitivity: [f64; 6],
    d_vt: [f64; 6],
    d_bpnd: [f64; 6],
    success: bool,
}

// ============================================================================
// PLASMA INPUT FUNCTION
// ============================================================================

fn cp_t(t: f64, amp: f64, decay: f64) -> f64 with Mut, Div {
    if t < 0.0 { return 0.0 }
    return amp * exp_f64(0.0 - decay * t)
}

// ============================================================================
// RK4 INTEGRATOR — Classical 4th-order fixed-step
// ============================================================================

fn rk4_step(state: PET2TCMState, t: f64, dt: f64, p: PET2TCMParams) -> PET2TCMState with Mut, Div {
    let cp0 = cp_t(t, p.cp_amp, p.cp_decay)
    let k1_1 = dt * (p.k1 * cp0 - (p.k2 + p.k3) * state.c1 + p.k4 * state.c2)
    let k2_1 = dt * (p.k3 * state.c1 - p.k4 * state.c2)

    let s2_c1 = state.c1 + 0.5 * k1_1
    let s2_c2 = state.c2 + 0.5 * k2_1
    let cp_mid = cp_t(t + 0.5 * dt, p.cp_amp, p.cp_decay)
    let k1_2 = dt * (p.k1 * cp_mid - (p.k2 + p.k3) * s2_c1 + p.k4 * s2_c2)
    let k2_2 = dt * (p.k3 * s2_c1 - p.k4 * s2_c2)

    let s3_c1 = state.c1 + 0.5 * k1_2
    let s3_c2 = state.c2 + 0.5 * k2_2
    let k1_3 = dt * (p.k1 * cp_mid - (p.k2 + p.k3) * s3_c1 + p.k4 * s3_c2)
    let k2_3 = dt * (p.k3 * s3_c1 - p.k4 * s3_c2)

    let s4_c1 = state.c1 + k1_3
    let s4_c2 = state.c2 + k2_3
    let cp_end = cp_t(t + dt, p.cp_amp, p.cp_decay)
    let k1_4 = dt * (p.k1 * cp_end - (p.k2 + p.k3) * s4_c1 + p.k4 * s4_c2)
    let k2_4 = dt * (p.k3 * s4_c1 - p.k4 * s4_c2)

    PET2TCMState {
        c1: state.c1 + (k1_1 + 2.0 * k1_2 + 2.0 * k1_3 + k1_4) / 6.0,
        c2: state.c2 + (k2_1 + 2.0 * k2_2 + 2.0 * k2_3 + k2_4) / 6.0,
    }
}

fn simulate_pet(p: PET2TCMParams, t_end: f64, dt: f64) -> PETMetrics with Mut, Div, Panic {
    var st = PET2TCMState { c1: 0.0, c2: 0.0 }
    var t = 0.0
    var auc = 0.0
    var peak = 0.0
    var t_peak = 0.0
    var prev_ct = 0.0
    var n = 0
    let max_steps = 10000

    while t < t_end && n < max_steps {
        let ct = st.c1 + st.c2

        if ct > peak {
            peak = ct
            t_peak = t
        }

        if n > 0 {
            auc = auc + 0.5 * (ct + prev_ct) * dt
        }

        prev_ct = ct
        st = rk4_step(st, t, dt, p)
        t = t + dt
        n = n + 1
    }

    let final_ct = st.c1 + st.c2
    let bpnd = if p.k4 > 1.0e-9 { p.k3 / p.k4 } else { 0.0 }
    let vt = if p.k2 > 1.0e-9 { (p.k1 / p.k2) * (1.0 + bpnd) } else { 0.0 }

    PETMetrics {
        tac_auc: auc,
        tac_peak: peak,
        t_peak: t_peak,
        vt: vt,
        bpnd: bpnd,
        c_final: final_ct,
        success: t >= t_end * 0.98 && ep_finite(auc) && ep_finite(peak) && n > 100,
    }
}

// ============================================================================
// GUM FINITE-DIFFERENCE PROPAGATION
// ============================================================================
//
// CRITICAL: We build the perturbed parameter struct explicitly for each
// parameter index, rather than copying the whole prior array (which may alias
// in Sounio). This is the same safe pattern used by epistemic_pbpk14.sio.
// ============================================================================

fn gum_finite_h(mean: f64, var_i: f64) -> f64 with Mut, Div {
    let scale_mean = 1.0e-6 * abs_f64(mean)
    let scale_sd = 1.0e-2 * sqrt_f64(max_f64(var_i, 1.0e-10))
    max_f64(scale_mean, scale_sd)
}

fn perturbed_params(ref_p: PET2TCMParams, idx: i32, h: f64) -> PET2TCMParams {
    if idx == 0 {
        return PET2TCMParams {
            k1: ref_p.k1 + h, k2: ref_p.k2, k3: ref_p.k3, k4: ref_p.k4,
            cp_amp: ref_p.cp_amp, cp_decay: ref_p.cp_decay,
        }
    }
    if idx == 1 {
        return PET2TCMParams {
            k1: ref_p.k1, k2: ref_p.k2 + h, k3: ref_p.k3, k4: ref_p.k4,
            cp_amp: ref_p.cp_amp, cp_decay: ref_p.cp_decay,
        }
    }
    if idx == 2 {
        return PET2TCMParams {
            k1: ref_p.k1, k2: ref_p.k2, k3: ref_p.k3 + h, k4: ref_p.k4,
            cp_amp: ref_p.cp_amp, cp_decay: ref_p.cp_decay,
        }
    }
    if idx == 3 {
        return PET2TCMParams {
            k1: ref_p.k1, k2: ref_p.k2, k3: ref_p.k3, k4: ref_p.k4 + h,
            cp_amp: ref_p.cp_amp, cp_decay: ref_p.cp_decay,
        }
    }
    if idx == 4 {
        return PET2TCMParams {
            k1: ref_p.k1, k2: ref_p.k2, k3: ref_p.k3, k4: ref_p.k4,
            cp_amp: ref_p.cp_amp + h, cp_decay: ref_p.cp_decay,
        }
    }
    // idx == 5
    return PET2TCMParams {
        k1: ref_p.k1, k2: ref_p.k2, k3: ref_p.k3, k4: ref_p.k4,
        cp_amp: ref_p.cp_amp, cp_decay: ref_p.cp_decay + h,
    }
}

fn run_gum_pet(prior: EpPETPrior, t_end: f64, dt: f64) -> EpPETResult with Mut, Div, Panic {
    let ref_p = PET2TCMParams {
        k1: prior.mean[0],
        k2: prior.mean[1],
        k3: prior.mean[2],
        k4: prior.mean[3],
        cp_amp: prior.mean[4],
        cp_decay: prior.mean[5],
    }

    let ref_m = simulate_pet(ref_p, t_end, dt)

    if !ref_m.success {
        return EpPETResult {
            tac_auc_mean: 0.0, tac_auc_var: 0.0,
            tac_peak_mean: 0.0, tac_peak_var: 0.0,
            vt_mean: 0.0, vt_var: 0.0,
            bpnd_mean: 0.0, bpnd_var: 0.0,
            confidence: 0.0,
            sensitivity: [0.0; 6],
            d_vt: [0.0; 6],
            d_bpnd: [0.0; 6],
            success: false,
        }
    }

    var d_auc = [0.0; 6]
    var d_peak = [0.0; 6]
    var d_vt = [0.0; 6]
    var d_bpnd = [0.0; 6]
    var i = 0

    while i < 6 {
        let h = gum_finite_h(prior.mean[i], prior.variance[i])
        let pert_p = perturbed_params(ref_p, i, h)
        let pert_m = simulate_pet(pert_p, t_end, dt)

        if pert_m.success && h > 0.0 {
            d_auc[i] = (pert_m.tac_auc - ref_m.tac_auc) / h
            d_peak[i] = (pert_m.tac_peak - ref_m.tac_peak) / h
            d_vt[i] = (pert_m.vt - ref_m.vt) / h
            d_bpnd[i] = (pert_m.bpnd - ref_m.bpnd) / h
        }
        i = i + 1
    }

    // GUM variance (sum of squared sensitivities × prior variance)
    var var_auc = 0.0
    var var_peak = 0.0
    var var_vt = 0.0
    var var_bpnd = 0.0
    var total_vt_contrib = 0.0
    i = 0
    while i < 6 {
        let v = prior.variance[i]
        var_auc = var_auc + d_auc[i] * d_auc[i] * v
        var_peak = var_peak + d_peak[i] * d_peak[i] * v
        var_vt = var_vt + d_vt[i] * d_vt[i] * v
        var_bpnd = var_bpnd + d_bpnd[i] * d_bpnd[i] * v
        total_vt_contrib = total_vt_contrib + d_vt[i] * d_vt[i] * v
        i = i + 1
    }

    // Sensitivity fractions (normalized against total V_T variance)
    var sens = [0.0; 6]
    if total_vt_contrib > 1.0e-12 {
        i = 0
        while i < 6 {
            sens[i] = (d_vt[i] * d_vt[i] * prior.variance[i]) / total_vt_contrib
            i = i + 1
        }
    }

    // Evidence-weighted confidence (weighted by sensitivity fraction)
    var conf = 0.0
    if total_vt_contrib > 1.0e-12 {
        i = 0
        while i < 6 {
            conf = conf + prior.confidence[i] * sens[i]
            i = i + 1
        }
    } else {
        conf = 0.5
    }

    EpPETResult {
        tac_auc_mean: ref_m.tac_auc,
        tac_auc_var: var_auc,
        tac_peak_mean: ref_m.tac_peak,
        tac_peak_var: var_peak,
        vt_mean: ref_m.vt,
        vt_var: var_vt,
        bpnd_mean: ref_m.bpnd,
        bpnd_var: var_bpnd,
        confidence: conf,
        sensitivity: sens,
        d_vt: d_vt,
        d_bpnd: d_bpnd,
        success: true,
    }
}

// ============================================================================
// MAIN — AUDITED ACCEPTANCE TESTS
// ============================================================================

fn main() -> i32 with IO, Mut, Div, Panic {
    println("======================================================================")
    println("  EXECUTABLE EPISTEMIC PET 2TCM — NRM 2026 PROOF-OF-CONCEPT (AUDITED)")
    println("  Method: GUM finite-difference Jacobian (JCGM 100:2008 §5.1.3)")
    println("  Solver: fixed-step classical RK4")
    println("======================================================================")
    println("")

    // Priors from the project specification (unchanged).
    let prior = EpPETPrior {
        mean: [0.15, 0.20, 0.10, 0.05, 1.00, 0.20],
        variance: [0.0004, 0.0009, 0.0004, 0.0001, 0.0025, 0.0004],
        confidence: [0.70, 0.70, 0.60, 0.60, 0.65, 0.65],
        n: 6,
    }

    let t_end = 60.0
    let dt = 0.05

    println("Synthetic epistemic priors:")
    println("  K1       (mean): ")
    println(prior.mean[0])
    println("  k2       (mean): ")
    println(prior.mean[1])
    println("  k3       (mean): ")
    println(prior.mean[2])
    println("  k4       (mean): ")
    println(prior.mean[3])
    println("  cp_amp   (mean): ")
    println(prior.mean[4])
    println("  cp_decay (mean): ")
    println(prior.mean[5])
    println("")

    // ---------------------------------------------------------------------
    // AUDIT 1: Cp(t) decays correctly
    // ---------------------------------------------------------------------
    println("AUDIT 1: Plasma input function Cp(t) = exp(-0.2*t)")
    println("  Cp(0)  (expected ~1.0000):")
    println(cp_t(0.0, prior.mean[4], prior.mean[5]))
    println("  Cp(1)  (expected ~0.8187):")
    println(cp_t(1.0, prior.mean[4], prior.mean[5]))
    println("  Cp(5)  (expected ~0.3679):")
    println(cp_t(5.0, prior.mean[4], prior.mean[5]))
    println("  Cp(10) (expected ~0.1353):")
    println(cp_t(10.0, prior.mean[4], prior.mean[5]))
    println("  Cp(60) (expected ~0.000006):")
    println(cp_t(60.0, prior.mean[4], prior.mean[5]))
    println("")

    // ---------------------------------------------------------------------
    // Run GUM propagation
    // ---------------------------------------------------------------------
    let result = run_gum_pet(prior, t_end, dt)

    if !result.success {
        println("SIMULATION FAILED (reference run did not converge)")
        return 1
    }

    let auc_sd = sqrt_f64(result.tac_auc_var)
    let peak_sd = sqrt_f64(result.tac_peak_var)
    let vt_sd = sqrt_f64(result.vt_var)
    let bpnd_sd = sqrt_f64(result.bpnd_var)

    println("RESULTS (GUM-propagated):")
    println("  TAC AUC (0-60 min) mean (expected ~9.47):")
    println(result.tac_auc_mean)
    println("  TAC AUC SD:")
    println(auc_sd)
    println("  TAC Peak mean (expected ~0.31):")
    println(result.tac_peak_mean)
    println("  TAC Peak SD:")
    println(peak_sd)
    println("  V_T mean (exact 2.25):")
    println(result.vt_mean)
    println("  V_T SD (delta-method ~0.62):")
    println(vt_sd)
    println("  BP_ND mean (exact 2.00):")
    println(result.bpnd_mean)
    println("  BP_ND SD (delta-method ~0.566):")
    println(bpnd_sd)
    println("  Evidence-weighted confidence:")
    println(result.confidence)
    println("")

    println("AUDIT 2: Finite-difference derivatives (vs analytic)")
    println("  d(BP_ND)/d(k3) fd (analytic = 20.0):")
    println(result.d_bpnd[2])
    println("  d(BP_ND)/d(k4) fd (analytic = -40.0):")
    println(result.d_bpnd[3])
    println("  d(V_T)/d(K1)  fd (analytic = 15.0):")
    println(result.d_vt[0])
    println("  d(V_T)/d(k2)  fd (analytic = -11.25):")
    println(result.d_vt[1])
    println("  d(V_T)/d(k3)  fd (analytic = 15.0):")
    println(result.d_vt[2])
    println("  d(V_T)/d(k4)  fd (analytic = -30.0):")
    println(result.d_vt[3])
    println("")

    println("Normalized sensitivity fractions (to V_T):")
    println("  K1:")
    println(result.sensitivity[0])
    println("  k2:")
    println(result.sensitivity[1])
    println("  k3:")
    println(result.sensitivity[2])
    println("  k4:")
    println(result.sensitivity[3])
    println("  cp_amp:")
    println(result.sensitivity[4])
    println("  cp_decay:")
    println(result.sensitivity[5])
    println("")

    // ---------------------------------------------------------------------
    // ACCEPTANCE TESTS
    // ---------------------------------------------------------------------
    println("ACCEPTANCE TESTS:")
    println("")

    var passed = 0
    var failed = 0

    // Test 1: Simulation completed
    if result.success {
        println("  [PASS] 1. Simulation completes (reference + 6 perturbations)")
        passed = passed + 1
    } else {
        println("  [FAIL] 1. Simulation did not converge")
        failed = failed + 1
    }

    // Test 2: TAC AUC in plausible range
    if result.tac_auc_mean > 5.0 && result.tac_auc_mean < 20.0 {
        println("  [PASS] 2. TAC AUC in plausible range (5..20)")
        passed = passed + 1
    } else {
        println("  [FAIL] 2. TAC AUC out of plausible range (5..20)")
        failed = failed + 1
    }

    // Test 3: TAC peak in plausible range
    if result.tac_peak_mean > 0.05 && result.tac_peak_mean < 1.0 {
        println("  [PASS] 3. TAC Peak in plausible range (0.05..1.0)")
        passed = passed + 1
    } else {
        println("  [FAIL] 3. TAC Peak out of plausible range")
        failed = failed + 1
    }

    // Test 4: V_T exact analytic value
    if abs_f64(result.vt_mean - 2.25) < 0.01 {
        println("  [PASS] 4. V_T matches analytic 2.25")
        passed = passed + 1
    } else {
        println("  [FAIL] 4. V_T deviates from analytic")
        failed = failed + 1
    }

    // Test 5: BP_ND exact analytic value
    if abs_f64(result.bpnd_mean - 2.00) < 0.01 {
        println("  [PASS] 5. BP_ND matches analytic 2.00")
        passed = passed + 1
    } else {
        println("  [FAIL] 5. BP_ND deviates from analytic")
        failed = failed + 1
    }

    // Test 6: BP_ND variance close to delta-method prediction (0.32)
    if result.bpnd_var > 0.20 && result.bpnd_var < 0.50 {
        println("  [PASS] 6. BP_ND variance ~0.32 (delta-method check)")
        passed = passed + 1
    } else {
        println("  [FAIL] 6. BP_ND variance outside [0.20, 0.50]")
        failed = failed + 1
    }

    // Test 7: V_T variance non-zero and plausible (SD ~0.6 => var ~0.36)
    if result.vt_var > 0.15 && result.vt_var < 0.80 {
        println("  [PASS] 7. V_T variance plausible (delta-method check)")
        passed = passed + 1
    } else {
        println("  [FAIL] 7. V_T variance out of plausible range")
        failed = failed + 1
    }

    // Test 8: d(BP_ND)/dk3 finite-difference matches analytic (20)
    if abs_f64(result.d_bpnd[2] - 20.0) < 1.0 {
        println("  [PASS] 8. d(BP_ND)/dk3 matches analytic 20")
        passed = passed + 1
    } else {
        println("  [FAIL] 8. d(BP_ND)/dk3 inconsistent with analytic")
        failed = failed + 1
    }

    // Test 9: Halving k4 increases BP_ND
    let p_low_k4 = PET2TCMParams {
        k1: prior.mean[0], k2: prior.mean[1], k3: prior.mean[2],
        k4: prior.mean[3] * 0.5,
        cp_amp: prior.mean[4], cp_decay: prior.mean[5],
    }
    let m_low = simulate_pet(p_low_k4, t_end, dt)
    if m_low.success && m_low.bpnd > result.bpnd_mean {
        println("  [PASS] 9. Halving k4 increases BP_ND (causal)")
        passed = passed + 1
    } else {
        println("  [FAIL] 9. Monotonicity test (k4)")
        failed = failed + 1
    }

    // Test 10: Sensitivity fractions sum to ~1.0
    var sum_s = 0.0
    var j = 0
    while j < 6 {
        sum_s = sum_s + result.sensitivity[j]
        j = j + 1
    }
    println("  Sensitivity fractions sum:")
    println(sum_s)
    if sum_s > 0.95 && sum_s < 1.05 {
        println("  [PASS] 10. Sensitivity fractions sum ~1.0")
        passed = passed + 1
    } else {
        println("  [FAIL] 10. Sensitivity normalization off")
        failed = failed + 1
    }

    println("")
    println("======================================================================")
    println("  TEST SUMMARY")
    println("======================================================================")
    println("  Passed:")
    println(passed)
    println("  Failed:")
    println(failed)
    println("")

    if failed == 0 {
        println("  ALL NUMERICAL AUDITS PASSED")
        println("  GUM finite-difference derivatives match analytic delta-method")
        println("  predictions for BP_ND and V_T. TAC AUC and Peak in expected")
        println("  physical range for the synthetic input function.")
        return 0
    } else {
        println("  AUDIT FAILURES PRESENT — not publication-ready.")
        println("  Review the failed checks above before quoting results.")
        return 1
    }
}
