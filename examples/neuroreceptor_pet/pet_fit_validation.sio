// examples/neuroreceptor_pet/pet_fit_validation.sio
//
// Parameter recovery validation for PET 2TCM via synthetic noisy TAC.
//
// Strategy (standard approach before patient data):
//   1. Generate a "ground truth" TAC using 2TCM with known K1, k2, k3, k4.
//   2. Add Gaussian-like noise (5 % of peak) to each sample.
//   3. Use coordinate-descent optimisation to recover K1, k2, k3, k4 from
//      the noisy TAC.
//   4. Compare recovered parameters to ground truth.
//   5. Report relative error for K1, k2, k3, k4, BP_ND, V_T.
//
// This is the standard validation step required before fitting real patient
// data: show that the fitter correctly recovers parameters when the data
// generating process is known. Lammertsma 1996 and Gunn 1997 both perform
// this step as part of their method validation.
//
// Reference: Lammertsma et al. 1996; Gunn et al. 1997.

fn abs_f64(x: f64) -> f64 { if x < 0.0 { return 0.0 - x } ; return x }

fn max_f64(a: f64, b: f64) -> f64 { if a > b { return a } ; return b }

fn sqrt_f64(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var g = x
    if g < 1.0 { g = 1.0 }
    var i = 0
    while i < 40 { g = 0.5 * (g + x / g); i = i + 1 }
    return g
}

fn exp_f64(x: f64) -> f64 with Mut, Div {
    if x < 0.0 { return 1.0 / exp_f64(0.0 - x) }
    if x > 0.5 {
        let half = exp_f64(x * 0.5)
        return half * half
    }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 20 {
        let di = i as f64
        term = term * x / di
        sum = sum + term
        i = i + 1
    }
    return sum
}

// ============================================================================
// LCG PRNG + approximate Gaussian (sum of 12 uniforms)
// ============================================================================

struct Rng { state: i64 }

fn rng_new(seed: i64) -> Rng { Rng { state: seed } }

fn rng_next(r: Rng) -> Rng {
    let s = r.state * 6364136223846793005 + 1442695040888963407
    Rng { state: s }
}

// Uniform in [0, 1)
fn rng_uniform(r: Rng) -> f64 {
    // Use top 53 bits for f64 precision. Mask to positive.
    let v = r.state
    // Keep 52 bits of precision by shifting down and dividing
    let mask: i64 = 4503599627370495  // 2^52 - 1
    let bits = (v / 2048) - ((v / 2048) / 4503599627370496) * 4503599627370496
    let bits2 = if bits < 0 { bits + 4503599627370496 } else { bits }
    return (bits2 as f64) / 4503599627370496.0
}

// Approximate N(0,1) via Irwin-Hall (sum of 12 uniforms minus 6)
fn rng_gaussian_pair(r: Rng) -> Rng {
    // We use r as seed; consumers call rng_next repeatedly before asking sample
    return r
}

fn gaussian_sample(r0: Rng) -> f64 with Mut {
    var r = r0
    var sum = 0.0
    var k = 0
    while k < 12 {
        r = rng_next(r)
        sum = sum + rng_uniform(r)
        k = k + 1
    }
    return sum - 6.0
}

// Generate an entire Gaussian vector with reproducible seed
fn gaussian_vec(seed: i64, n: i32, out: &![f64; 80]) with Mut {
    var r = rng_new(seed)
    var i = 0
    while i < n {
        var sum = 0.0
        var k = 0
        while k < 12 {
            r = rng_next(r)
            sum = sum + rng_uniform(r)
            k = k + 1
        }
        (*out)[i as usize] = sum - 6.0
        i = i + 1
    }
}

// ============================================================================
// 2TCM simulator with TAC sampling at observation times
// ============================================================================

struct P2TCM {
    k1: f64, k2: f64, k3: f64, k4: f64,
    cp_amp: f64, cp_decay: f64,
}

struct S2TCM { c1: f64, c2: f64 }

fn cp_of(t: f64, amp: f64, decay: f64) -> f64 with Mut, Div {
    if t < 0.0 { return 0.0 }
    return amp * exp_f64(0.0 - decay * t)
}

fn rk4(st: S2TCM, t: f64, dt: f64, p: P2TCM) -> S2TCM with Mut, Div {
    let cp0 = cp_of(t, p.cp_amp, p.cp_decay)
    let a1 = dt * (p.k1 * cp0 - (p.k2 + p.k3) * st.c1 + p.k4 * st.c2)
    let b1 = dt * (p.k3 * st.c1 - p.k4 * st.c2)
    let c1m = st.c1 + 0.5 * a1
    let c2m = st.c2 + 0.5 * b1
    let cpm = cp_of(t + 0.5 * dt, p.cp_amp, p.cp_decay)
    let a2 = dt * (p.k1 * cpm - (p.k2 + p.k3) * c1m + p.k4 * c2m)
    let b2 = dt * (p.k3 * c1m - p.k4 * c2m)
    let c1n = st.c1 + 0.5 * a2
    let c2n = st.c2 + 0.5 * b2
    let a3 = dt * (p.k1 * cpm - (p.k2 + p.k3) * c1n + p.k4 * c2n)
    let b3 = dt * (p.k3 * c1n - p.k4 * c2n)
    let c1o = st.c1 + a3
    let c2o = st.c2 + b3
    let cpe = cp_of(t + dt, p.cp_amp, p.cp_decay)
    let a4 = dt * (p.k1 * cpe - (p.k2 + p.k3) * c1o + p.k4 * c2o)
    let b4 = dt * (p.k3 * c1o - p.k4 * c2o)
    S2TCM {
        c1: st.c1 + (a1 + 2.0 * a2 + 2.0 * a3 + a4) / 6.0,
        c2: st.c2 + (b1 + 2.0 * b2 + 2.0 * b3 + b4) / 6.0,
    }
}

// Simulate TAC at 60 observation times (every 1 min), returning into obs[0..60].
fn simulate_tac(p: P2TCM, obs: &![f64; 80]) with Mut, Div, Panic {
    let t_end = 60.0
    let dt = 0.05
    var st = S2TCM { c1: 0.0, c2: 0.0 }
    var t = 0.0
    var n = 0
    var ck = 1  // index 0 is t=0 which is zero
    (*obs)[0] = 0.0
    let n_obs = 60

    while t < t_end && n < 5000 {
        st = rk4(st, t, dt, p)
        t = t + dt
        n = n + 1
        while ck <= n_obs {
            let target_t = ck as f64
            if t >= target_t - 1.0e-9 {
                (*obs)[ck as usize] = st.c1 + st.c2
                ck = ck + 1
            } else {
                break
            }
        }
    }
}

// ============================================================================
// Objective: sum of squared residuals between predicted TAC and observed TAC
// ============================================================================

fn chi_squared(pred: [f64; 80], obs: [f64; 80], n_obs: i32) -> f64 with Mut {
    var s = 0.0
    var i = 0
    while i < n_obs {
        let d = pred[i as usize] - obs[i as usize]
        s = s + d * d
        i = i + 1
    }
    return s
}

// ============================================================================
// Coordinate-descent optimisation
// ============================================================================

struct FitResult {
    k1: f64, k2: f64, k3: f64, k4: f64,
    chi2: f64,
    iterations: i32,
    converged: bool,
}

fn evaluate_at(k1: f64, k2: f64, k3: f64, k4: f64, obs: [f64; 80], n_obs: i32,
               cp_amp: f64, cp_decay: f64) -> f64 with Mut, Div, Panic {
    let p = P2TCM { k1: k1, k2: k2, k3: k3, k4: k4, cp_amp: cp_amp, cp_decay: cp_decay }
    var pred = [0.0; 80]
    simulate_tac(p, &!pred)
    return chi_squared(pred, obs, n_obs + 1)
}

fn fit_2tcm(k1_0: f64, k2_0: f64, k3_0: f64, k4_0: f64,
            obs: [f64; 80], n_obs: i32,
            cp_amp: f64, cp_decay: f64) -> FitResult with Mut, Div, Panic {
    var k1 = k1_0
    var k2 = k2_0
    var k3 = k3_0
    var k4 = k4_0

    var chi2 = evaluate_at(k1, k2, k3, k4, obs, n_obs, cp_amp, cp_decay)
    var iter = 0
    let max_iter = 40
    var converged = false

    let mults = [0.80, 0.90, 0.95, 0.98, 1.0, 1.02, 1.05, 1.10, 1.20]

    while iter < max_iter {
        let chi2_prev = chi2

        // Line search on K1
        var m = 0
        while m < 9 {
            let trial = k1 * mults[m as usize]
            let c = evaluate_at(trial, k2, k3, k4, obs, n_obs, cp_amp, cp_decay)
            if c < chi2 { chi2 = c; k1 = trial }
            m = m + 1
        }
        // k2
        m = 0
        while m < 9 {
            let trial = k2 * mults[m as usize]
            let c = evaluate_at(k1, trial, k3, k4, obs, n_obs, cp_amp, cp_decay)
            if c < chi2 { chi2 = c; k2 = trial }
            m = m + 1
        }
        // k3
        m = 0
        while m < 9 {
            let trial = k3 * mults[m as usize]
            let c = evaluate_at(k1, k2, trial, k4, obs, n_obs, cp_amp, cp_decay)
            if c < chi2 { chi2 = c; k3 = trial }
            m = m + 1
        }
        // k4
        m = 0
        while m < 9 {
            let trial = k4 * mults[m as usize]
            let c = evaluate_at(k1, k2, k3, trial, obs, n_obs, cp_amp, cp_decay)
            if c < chi2 { chi2 = c; k4 = trial }
            m = m + 1
        }

        iter = iter + 1

        let rel_improve = if chi2_prev > 1.0e-12 { (chi2_prev - chi2) / chi2_prev } else { 0.0 }
        if rel_improve < 1.0e-5 {
            converged = true
            break
        }
    }

    FitResult { k1: k1, k2: k2, k3: k3, k4: k4, chi2: chi2, iterations: iter, converged: converged }
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 with IO, Mut, Div, Panic {
    println("======================================================================")
    println("  PET 2TCM parameter-recovery validation")
    println("  (synthetic noisy TAC + coordinate-descent optimisation)")
    println("======================================================================")
    println("")

    // Ground-truth parameters (raclopride-like)
    let k1_true = 0.15
    let k2_true = 0.20
    let k3_true = 0.10
    let k4_true = 0.05
    let cp_amp = 1.00
    let cp_decay = 0.20

    let vt_true = (k1_true / k2_true) * (1.0 + k3_true / k4_true)
    let bp_true = k3_true / k4_true

    println("Ground-truth parameters:")
    println("  K1 ="); println(k1_true)
    println("  k2 ="); println(k2_true)
    println("  k3 ="); println(k3_true)
    println("  k4 ="); println(k4_true)
    println("  BP_ND ="); println(bp_true)
    println("  V_T ="); println(vt_true)
    println("")

    // Generate noise-free TAC
    let p_true = P2TCM { k1: k1_true, k2: k2_true, k3: k3_true, k4: k4_true,
                         cp_amp: cp_amp, cp_decay: cp_decay }
    var tac_clean = [0.0; 80]
    simulate_tac(p_true, &!tac_clean)

    let n_obs = 60

    // Noise level: 5 % of peak
    var peak = 0.0
    var k = 0
    while k <= n_obs { if tac_clean[k as usize] > peak { peak = tac_clean[k as usize] }; k = k + 1 }
    let noise_sd = 0.05 * peak

    // Deterministic Gaussian noise vector
    var noise = [0.0; 80]
    gaussian_vec(123456789, n_obs + 1, &!noise)

    // Build noisy observation
    var tac_obs = [0.0; 80]
    var i = 0
    while i <= n_obs {
        tac_obs[i as usize] = tac_clean[i as usize] + noise_sd * noise[i as usize]
        i = i + 1
    }

    println("Synthetic observation setup:")
    println("  n observations: 61 (every 1.0 min from 0 to 60)")
    println("  TAC peak (clean):"); println(peak)
    println("  noise SD (5 % of peak):"); println(noise_sd)
    println("")

    // Print a few observations for transparency
    println("Sampled observations (selected):")
    let show_idx = [1, 5, 10, 20, 40, 60]
    i = 0
    while i < 6 {
        let idx = show_idx[i as usize]
        print("  t="); print(idx as f64)
        print("    clean="); print(tac_clean[idx as usize])
        print("    obs=");   print(tac_obs[idx as usize])
        println("")
        i = i + 1
    }
    println("")

    // Starting guess: intentionally offset from truth (realistic scenario)
    let k1_guess = 0.12
    let k2_guess = 0.25
    let k3_guess = 0.07
    let k4_guess = 0.04

    println("Starting guess (intentionally off from truth):")
    println("  K1_0 ="); println(k1_guess)
    println("  k2_0 ="); println(k2_guess)
    println("  k3_0 ="); println(k3_guess)
    println("  k4_0 ="); println(k4_guess)
    println("")

    let fit = fit_2tcm(k1_guess, k2_guess, k3_guess, k4_guess,
                       tac_obs, n_obs, cp_amp, cp_decay)

    let bp_fit = fit.k3 / fit.k4
    let vt_fit = (fit.k1 / fit.k2) * (1.0 + bp_fit)

    println("Fit result:")
    println("  iterations:"); println(fit.iterations)
    println("  converged:"); println(if fit.converged { 1 } else { 0 })
    println("  final chi-squared:"); println(fit.chi2)
    println("")
    println("Recovered parameters vs ground truth:")

    let err_k1 = abs_f64(fit.k1 - k1_true) / k1_true
    let err_k2 = abs_f64(fit.k2 - k2_true) / k2_true
    let err_k3 = abs_f64(fit.k3 - k3_true) / k3_true
    let err_k4 = abs_f64(fit.k4 - k4_true) / k4_true
    let err_bp = abs_f64(bp_fit - bp_true) / bp_true
    let err_vt = abs_f64(vt_fit - vt_true) / vt_true

    println("  K1:    true="); print(k1_true); print("  fit="); print(fit.k1); print("  rel_err="); println(err_k1)
    println("  k2:    true="); print(k2_true); print("  fit="); print(fit.k2); print("  rel_err="); println(err_k2)
    println("  k3:    true="); print(k3_true); print("  fit="); print(fit.k3); print("  rel_err="); println(err_k3)
    println("  k4:    true="); print(k4_true); print("  fit="); print(fit.k4); print("  rel_err="); println(err_k4)
    println("  BP_ND: true="); print(bp_true); print("  fit="); print(bp_fit); print("  rel_err="); println(err_bp)
    println("  V_T:   true="); print(vt_true); print("  fit="); print(vt_fit); print("  rel_err="); println(err_vt)
    println("")

    // Acceptance tests
    var passed = 0
    var failed = 0

    if fit.converged { println("  [PASS] Fit converged"); passed = passed + 1 }
    else { println("  [FAIL] Fit did not converge"); failed = failed + 1 }

    // Individual rate constants are notoriously unstable in PET fitting
    // (Lammertsma 1996). So we accept up to 50 % error on k3, k4 individually
    // but expect tighter recovery on the identifiable combinations BP_ND, V_T.
    if err_k1 < 0.15 { println("  [PASS] K1 recovered within 15 %"); passed = passed + 1 }
    else { println("  [FAIL] K1 outside 15 % tolerance"); failed = failed + 1 }

    if err_k2 < 0.25 { println("  [PASS] k2 recovered within 25 %"); passed = passed + 1 }
    else { println("  [FAIL] k2 outside 25 % tolerance"); failed = failed + 1 }

    if err_bp < 0.20 { println("  [PASS] BP_ND recovered within 20 %"); passed = passed + 1 }
    else { println("  [FAIL] BP_ND outside 20 % tolerance"); failed = failed + 1 }

    if err_vt < 0.15 { println("  [PASS] V_T recovered within 15 %"); passed = passed + 1 }
    else { println("  [FAIL] V_T outside 15 % tolerance"); failed = failed + 1 }

    println("")
    println("======================================================================")
    println("  RECOVERY SUMMARY")
    println("======================================================================")
    println("  Passed:"); println(passed)
    println("  Failed:"); println(failed)
    println("")
    if failed == 0 {
        println("  Parameter recovery successful from 5 %-noise TAC.")
        println("  BP_ND and V_T — the identifiable combinations — recovered within 20 %.")
        println("  Individual k3/k4 are known to be less identifiable; tolerances reflect")
        println("  that documented behavior (Lammertsma 1996; Hume 1992).")
        return 0
    } else {
        println("  Parameter recovery outside acceptance range.")
        return 1
    }
}
