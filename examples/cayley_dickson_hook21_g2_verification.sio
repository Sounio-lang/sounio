//! examples/cayley_dickson_hook21_g2_verification.sio
//!
//! Corrected verification for two defects found in an audit of
//! docs/papers/main/cayley_dickson_hierarchy_paper_2026-08-13.md's
//! reproduction scripts (scripts/research/hook21_bracket.py,
//! scripts/research/g2_lemon_analysis.py / g2_features.py):
//!
//!  Bug A (hook21_bracket.py): `hook_21_bracket()` correctly computes the
//!  [2,1]-hook Young-symmetrizer projection T - Lambda^3 - Sym^3, but the
//!  function that is actually RUN, `verify_hook_21()`, uses an unrelated
//!  ad hoc 4-term formula instead of calling it, and its "[a,a,b]" test
//!  self-cancels to a meaningless expression. The paper's quoted hook
//!  ratios (0.02-0.15 on octonions, 0.5-2.6 on sedenions) do not reproduce
//!  from either function as checked in.
//!
//!  Bug B (g2_features.py build_g2_generators): the 21 candidate D_{i,j}
//!  operators are built from the WRONG formula (raw commutator of
//!  left-multiplication operators, ei.(ej.x) - ej.(ei.x)), which is not
//!  generally a derivation. The canonical formula for a derivation of an
//!  alternative algebra generated by a commutator is
//!      D_{a,b}(x) = [[a,b],x] - 3(a,b,x)
//!  (commutator-of-commutator minus 3x the associator; see e.g. Schafer,
//!  "An Introduction to Nonassociative Algebras", or Baez "The Octonions"
//!  Sec 4.4). No Leibniz-law test exists anywhere in the audited scripts.
//!
//! This file re-derives both pieces from scratch against
//! stdlib/algebra/octonion.sio's and stdlib/algebra/sedenion.sio's
//! already-verified (13/13 test) multiplication tables, self-contained
//! (no cross-module imports, matching the stdlib leaves' own convention —
//! see sedenion.sio's docstring) to sidestep the multi-module native-path
//! fragility documented in docs/compiler/KNOWN_LIMITATIONS.md.
//!
//! Run: SOUNIO_STDLIB_PATH=$(pwd)/stdlib ./bin/souc run \
//!        examples/cayley_dickson_hook21_g2_verification.sio

// =============================================================================
// PRINT HELPERS (avoid `f64 as string`; fixed-decimal printing, per
// docs/guide/SOUNIO_GOTCHAS.md / madaros-codegen skill guidance)
// =============================================================================

fn print_i64(x: i64) with IO, Mut, Div, Panic {
    if x < 0 { print("-"); print_i64(0 - x) }
    else if x < 10 { print_digit(x) }
    else { print_i64(x / 10); print_digit(x - (x / 10) * 10) }
}

fn print_digit(d: i64) with IO {
    if d == 0 { print("0") } else if d == 1 { print("1") }
    else if d == 2 { print("2") } else if d == 3 { print("3") }
    else if d == 4 { print("4") } else if d == 5 { print("5") }
    else if d == 6 { print("6") } else if d == 7 { print("7") }
    else if d == 8 { print("8") } else { print("9") }
}

fn print_f64(x: f64, decimals: i64) with IO, Mut, Div, Panic {
    if x < 0.0 { print("-"); print_f64(0.0 - x, decimals) }
    else {
        let int_part = x as i64
        print_i64(int_part)
        print(".")
        var frac = x - (int_part as f64)
        var d: i64 = 0
        while d < decimals {
            frac = frac * 10.0
            let digit = frac as i64
            print_digit(digit)
            frac = frac - (digit as f64)
            d = d + 1
        }
    }
}

// =============================================================================
// DETERMINISTIC PRNG (SplitMix64 -> f64 in [-1,1]); self-contained, seeded.
// =============================================================================

// Mirrors stdlib/random/rng.sio's splitmix64_next exactly (same constants,
// same "simplified multiplication for interpreter" 32-bit reduction),
// since that implementation is already proven to compile/run in this repo.
var RNG_STATE: [i64; 1] = [0; 1]

fn rng_seed(seed: i64) with Mut { RNG_STATE[0] = seed }

fn rng_next_u64() -> i64 with Mut {
    RNG_STATE[0] = RNG_STATE[0] + 0x9e3779b97f4a7c15 as i64
    var z = RNG_STATE[0]
    z = z ^ (z >> 30)
    z = z * 0xbf58476d as i64
    z = z ^ (z >> 27)
    z = z * 0x94d049bb as i64
    z = z ^ (z >> 31)
    z
}

// Uniform f64 in [-1, 1], built from the low 32 bits (avoids sign-bit noise).
fn rng_next_signed() -> f64 with Mut, Div {
    let u = rng_next_u64() & 0x7fffffff
    let v = (u as f64) / 1073741823.5
    v - 1.0
}

// =============================================================================
// OCTONION PRODUCT (copied from stdlib/algebra/octonion.sio oct_mul_lo/hi —
// XOR-consistent Cayley-Dickson table, cross-checked identical to
// stdlib/algebra/sedenion.sio's internal oct_p/oct_q by inspection)
// =============================================================================

fn oct_mul(a: &[f64; 8], b: &[f64; 8], out: &![f64; 8]) with Mut, Div, NonAssoc {
    var r0 = a[0]*b[0] - a[1]*b[1] - a[2]*b[2] - a[3]*b[3] - a[4]*b[4] - a[5]*b[5] - a[6]*b[6] - a[7]*b[7]
    out[0] = r0
    var r1 = a[0]*b[1] + a[1]*b[0] + a[2]*b[3] - a[3]*b[2] + a[4]*b[5] - a[5]*b[4] - a[6]*b[7] + a[7]*b[6]
    out[1] = r1
    var r2 = a[0]*b[2] + a[2]*b[0] - a[1]*b[3] + a[3]*b[1] + a[4]*b[6] - a[6]*b[4] + a[5]*b[7] - a[7]*b[5]
    out[2] = r2
    var r3 = a[0]*b[3] + a[3]*b[0] + a[1]*b[2] - a[2]*b[1] + a[4]*b[7] - a[7]*b[4] - a[5]*b[6] + a[6]*b[5]
    out[3] = r3
    var r4 = a[0]*b[4] + a[4]*b[0] - a[1]*b[5] + a[5]*b[1] - a[2]*b[6] + a[6]*b[2] - a[3]*b[7] + a[7]*b[3]
    out[4] = r4
    var r5 = a[0]*b[5] + a[5]*b[0] + a[1]*b[4] - a[4]*b[1] - a[2]*b[7] + a[7]*b[2] + a[3]*b[6] - a[6]*b[3]
    out[5] = r5
    var r6 = a[0]*b[6] + a[6]*b[0] + a[1]*b[7] - a[7]*b[1] + a[2]*b[4] - a[4]*b[2] - a[3]*b[5] + a[5]*b[3]
    out[6] = r6
    var r7 = a[0]*b[7] + a[7]*b[0] - a[1]*b[6] + a[6]*b[1] + a[2]*b[5] - a[5]*b[2] + a[3]*b[4] - a[4]*b[3]
    out[7] = r7
}

fn oct_sub(a: &[f64; 8], b: &[f64; 8], out: &![f64; 8]) with Mut {
    var i: i64 = 0
    while i < 8 { out[i] = a[i] - b[i]; i = i + 1 }
}

fn oct_norm(a: &[f64; 8]) -> f64 with Mut, Div, Panic {
    var s = 0.0; var i: i64 = 0
    while i < 8 { s = s + a[i]*a[i]; i = i + 1 }
    var g = if s <= 0.0 { 0.0 } else { s }
    if g <= 0.0 { return 0.0 }
    var i2: i64 = 0
    while i2 < 30 { g = (g + s/g) / 2.0; i2 = i2 + 1 }
    g
}

fn oct_associator(a: &[f64; 8], b: &[f64; 8], c: &[f64; 8], out: &![f64; 8]) with Mut, Div, NonAssoc {
    var ab: [f64; 8] = [0.0; 8]
    oct_mul(a, b, &!ab)
    var ab_c: [f64; 8] = [0.0; 8]
    oct_mul(&ab, c, &!ab_c)
    var bc: [f64; 8] = [0.0; 8]
    oct_mul(b, c, &!bc)
    var a_bc: [f64; 8] = [0.0; 8]
    oct_mul(a, &bc, &!a_bc)
    oct_sub(&ab_c, &a_bc, out)
}

fn oct_basis(idx: i64) -> [f64; 8] with Mut {
    var o: [f64; 8] = [0.0; 8]
    o[idx] = 1.0
    o
}

fn oct_rand() -> [f64; 8] with Mut, Div {
    var o: [f64; 8] = [0.0; 8]
    var i: i64 = 0
    while i < 8 { o[i] = rng_next_signed(); i = i + 1 }
    o
}

// =============================================================================
// SEDENION PRODUCT (copied from stdlib/algebra/sedenion.sio — genuine
// recursive Cayley-Dickson half-split over the SAME octonion table above;
// verified anticommutative / non-alternative / ZD-annihilating, 13/13 PASS)
// =============================================================================

var SED_P: [f64; 8] = [0.0; 8]
var SED_Q: [f64; 8] = [0.0; 8]
var SED_OUT: [f64; 16] = [0.0; 16]

fn sed_conj(src: &[f64; 8], dst: &![f64; 8]) with Mut {
    dst[0] = src[0]
    var i: i64 = 1
    while i < 8 { dst[i] = 0.0 - src[i]; i = i + 1 }
}

fn sed_mul(a: &[f64; 16], b: &[f64; 16], out: &![f64; 16]) with Mut, Div, NonAssoc {
    var a_lo: [f64; 8] = [0.0; 8]
    var a_hi: [f64; 8] = [0.0; 8]
    var b_lo: [f64; 8] = [0.0; 8]
    var b_hi: [f64; 8] = [0.0; 8]
    var conj: [f64; 8] = [0.0; 8]
    var i: i64 = 0
    while i < 8 {
        a_lo[i] = a[i]; a_hi[i] = a[8 + i]
        b_lo[i] = b[i]; b_hi[i] = b[8 + i]
        i = i + 1
    }
    // Lower 8: a_lo*b_lo - conj(b_hi)*a_hi
    oct_mul(&a_lo, &b_lo, &!SED_P)
    sed_conj(&b_hi, &!conj)
    oct_mul(&conj, &a_hi, &!SED_Q)
    i = 0
    while i < 8 { out[i] = SED_P[i] - SED_Q[i]; i = i + 1 }
    // Upper 8: b_hi*a_lo + a_hi*conj(b_lo)
    oct_mul(&b_hi, &a_lo, &!SED_P)
    sed_conj(&b_lo, &!conj)
    oct_mul(&a_hi, &conj, &!SED_Q)
    i = 0
    while i < 8 { out[8 + i] = SED_P[i] + SED_Q[i]; i = i + 1 }
}

fn sed_sub(a: &[f64; 16], b: &[f64; 16], out: &![f64; 16]) with Mut {
    var i: i64 = 0
    while i < 16 { out[i] = a[i] - b[i]; i = i + 1 }
}

fn sed_norm(a: &[f64; 16]) -> f64 with Mut, Div, Panic {
    var s = 0.0; var i: i64 = 0
    while i < 16 { s = s + a[i]*a[i]; i = i + 1 }
    if s <= 0.0 { return 0.0 }
    var g = s; var i2: i64 = 0
    while i2 < 30 { g = (g + s/g) / 2.0; i2 = i2 + 1 }
    g
}

fn sed_associator(a: &[f64; 16], b: &[f64; 16], c: &[f64; 16], out: &![f64; 16]) with Mut, Div, NonAssoc {
    var ab: [f64; 16] = [0.0; 16]
    sed_mul(a, b, &!ab)
    var ab_c: [f64; 16] = [0.0; 16]
    sed_mul(&ab, c, &!ab_c)
    var bc: [f64; 16] = [0.0; 16]
    sed_mul(b, c, &!bc)
    var a_bc: [f64; 16] = [0.0; 16]
    sed_mul(a, &bc, &!a_bc)
    sed_sub(&ab_c, &a_bc, out)
}

fn sed_rand() -> [f64; 16] with Mut, Div {
    var o: [f64; 16] = [0.0; 16]
    var i: i64 = 0
    while i < 16 { o[i] = rng_next_signed(); i = i + 1 }
    o
}

// =============================================================================
// PART A — THE [2,1]-HOOK, DERIVED IN CLOSED FORM
//
// [2,1](T) = T - Lambda^3(T) - Sym^3(T), the standard-Young-symmetrizer
// projection onto the mixed-symmetry irreducible of the associator tensor
// T(a,b,c) = [a,b,c]. Expanding the 6-term alternating and symmetric sums
// and cancelling (transpositions acb/bac/cba appear with opposite sign in
// Lambda^3 and equal sign in Sym^3, so they cancel identically) collapses
// to a 3-term closed form over the cyclic (even) permutations only:
//
//   [2,1](a,b,c) = (1/3) * ( 2*T(a,b,c) - T(b,c,a) - T(c,a,b) )
//
// This file computes it BOTH ways (closed form, and the literal 6-term
// sum) and asserts they agree to machine precision as a self-check before
// trusting the closed form for the reported numbers.
// =============================================================================

fn hook21_oct_closed(a: &[f64; 8], b: &[f64; 8], c: &[f64; 8], out: &![f64; 8]) with Mut, Div, NonAssoc {
    var tabc: [f64; 8] = [0.0; 8]
    var tbca: [f64; 8] = [0.0; 8]
    var tcab: [f64; 8] = [0.0; 8]
    oct_associator(a, b, c, &!tabc)
    oct_associator(b, c, a, &!tbca)
    oct_associator(c, a, b, &!tcab)
    var i: i64 = 0
    while i < 8 {
        out[i] = (2.0 * tabc[i] - tbca[i] - tcab[i]) / 3.0
        i = i + 1
    }
}

fn hook21_oct_full6(a: &[f64; 8], b: &[f64; 8], c: &[f64; 8], out: &![f64; 8]) with Mut, Div, NonAssoc {
    var tabc: [f64; 8] = [0.0; 8]; oct_associator(a, b, c, &!tabc)
    var tacb: [f64; 8] = [0.0; 8]; oct_associator(a, c, b, &!tacb)
    var tbac: [f64; 8] = [0.0; 8]; oct_associator(b, a, c, &!tbac)
    var tbca: [f64; 8] = [0.0; 8]; oct_associator(b, c, a, &!tbca)
    var tcab: [f64; 8] = [0.0; 8]; oct_associator(c, a, b, &!tcab)
    var tcba: [f64; 8] = [0.0; 8]; oct_associator(c, b, a, &!tcba)
    var i: i64 = 0
    while i < 8 {
        let alt = (tabc[i] - tacb[i] - tbac[i] + tbca[i] + tcab[i] - tcba[i]) / 6.0
        let sym = (tabc[i] + tacb[i] + tbac[i] + tbca[i] + tcab[i] + tcba[i]) / 6.0
        out[i] = tabc[i] - alt - sym
        i = i + 1
    }
}

fn hook21_sed_closed(a: &[f64; 16], b: &[f64; 16], c: &[f64; 16], out: &![f64; 16]) with Mut, Div, NonAssoc {
    var tabc: [f64; 16] = [0.0; 16]
    var tbca: [f64; 16] = [0.0; 16]
    var tcab: [f64; 16] = [0.0; 16]
    sed_associator(a, b, c, &!tabc)
    sed_associator(b, c, a, &!tbca)
    sed_associator(c, a, b, &!tcab)
    var i: i64 = 0
    while i < 16 {
        out[i] = (2.0 * tabc[i] - tbca[i] - tcab[i]) / 3.0
        i = i + 1
    }
}

// =============================================================================
// PART B — G2 DERIVATIONS: CORRECT FORMULA VS. THE AUDITED WRONG ONE
//
// Correct: D_{a,b}(x) = [[a,b],x] - 3*(a,b,x)     (a derivation of O)
// Wrong (as audited in g2_features.py build_g2_generators):
//          D_wrong_{a,b}(x) = a*(b*x) - b*(a*x)    (= [L_a,L_b](x); NOT
//          generally a derivation of a non-associative algebra)
// =============================================================================

fn oct_comm(a: &[f64; 8], b: &[f64; 8], out: &![f64; 8]) with Mut, Div, NonAssoc {
    var ab: [f64; 8] = [0.0; 8]
    var ba: [f64; 8] = [0.0; 8]
    oct_mul(a, b, &!ab)
    oct_mul(b, a, &!ba)
    oct_sub(&ab, &ba, out)
}

fn g2_deriv_correct(a: &[f64; 8], b: &[f64; 8], x: &[f64; 8], out: &![f64; 8]) with Mut, Div, NonAssoc {
    var comm_ab: [f64; 8] = [0.0; 8]
    oct_comm(a, b, &!comm_ab)
    var dcomm: [f64; 8] = [0.0; 8]
    oct_comm(&comm_ab, x, &!dcomm)
    var assoc: [f64; 8] = [0.0; 8]
    oct_associator(a, b, x, &!assoc)
    var i: i64 = 0
    while i < 8 { out[i] = dcomm[i] - 3.0 * assoc[i]; i = i + 1 }
}

fn g2_deriv_wrong(a: &[f64; 8], b: &[f64; 8], x: &[f64; 8], out: &![f64; 8]) with Mut, Div, NonAssoc {
    var bx: [f64; 8] = [0.0; 8]
    oct_mul(b, x, &!bx)
    var a_bx: [f64; 8] = [0.0; 8]
    oct_mul(a, &bx, &!a_bx)
    var ax: [f64; 8] = [0.0; 8]
    oct_mul(a, x, &!ax)
    var b_ax: [f64; 8] = [0.0; 8]
    oct_mul(b, &ax, &!b_ax)
    oct_sub(&a_bx, &b_ax, out)
}

// Leibniz residual: D(x*y) - (D(x)*y + x*D(y)), norm.
fn leibniz_residual_norm(
    a: &[f64; 8], b: &[f64; 8], x: &[f64; 8], y: &[f64; 8], use_correct: bool
) -> f64 with Mut, Div, Panic, NonAssoc {
    var xy: [f64; 8] = [0.0; 8]
    oct_mul(x, y, &!xy)
    var dxy: [f64; 8] = [0.0; 8]
    var dx: [f64; 8] = [0.0; 8]
    var dy: [f64; 8] = [0.0; 8]
    if use_correct {
        g2_deriv_correct(a, b, &xy, &!dxy)
        g2_deriv_correct(a, b, x, &!dx)
        g2_deriv_correct(a, b, y, &!dy)
    } else {
        g2_deriv_wrong(a, b, &xy, &!dxy)
        g2_deriv_wrong(a, b, x, &!dx)
        g2_deriv_wrong(a, b, y, &!dy)
    }
    var dx_y: [f64; 8] = [0.0; 8]
    oct_mul(&dx, y, &!dx_y)
    var x_dy: [f64; 8] = [0.0; 8]
    oct_mul(x, &dy, &!x_dy)
    var rhs: [f64; 8] = [0.0; 8]
    var i: i64 = 0
    while i < 8 { rhs[i] = dx_y[i] + x_dy[i]; i = i + 1 }
    var resid: [f64; 8] = [0.0; 8]
    oct_sub(&dxy, &rhs, &!resid)
    oct_norm(&resid)
}

// =============================================================================
// PART C — REBUILD THE AUDITED-BROKEN SEDENION TABLE AND COUNT
// ANTICOMMUTATIVITY VIOLATIONS DIRECTLY (rather than citing the prior
// audit's "42/210" figure secondhand — recomputed here so the number is
// backed by a command this file's own run reproduces).
//
// This is a literal port of scripts/research/cayley_dickson_paper_reproduction.py
// _build_oct_sign / _build_sed_sign: a Fano-TUPLE octonion table (NOT the
// XOR-consistent one used elsewhere in this file / in stdlib), extended to
// 16 dimensions via `c = a XOR b`.
// =============================================================================

var BROKEN_SED_SIGN: [i64; 256] = [0; 256] // 16x16, flat i*16+j
var BROKEN_SED_IDX:  [i64; 256] = [0; 256]

fn xor8(a: i64, b: i64) -> i64 {
    let a0 = a - (a/2)*2; let b0 = b - (b/2)*2
    let a1 = (a/2) - (a/4)*2; let b1 = (b/2) - (b/4)*2
    let a2 = a/4; let b2 = b/4
    let x0 = if a0 == b0 { 0 } else { 1 }
    let x1 = if a1 == b1 { 0 } else { 1 }
    let x2 = if a2 == b2 { 0 } else { 1 }
    x0 + 2*x1 + 4*x2
}

// Fano tuples exactly as in cayley_dickson_paper_reproduction.py's _FANO
// (NOT the same convention as stdlib/algebra/octonion.sio's Fano lines),
// extended to 16 dims via the audited `c = a XOR b` rule.
fn build_broken_sed_table() with Mut {
    var i: i64 = 0
    while i < 256 { BROKEN_SED_SIGN[i as usize] = 1; i = i + 1 }
    i = 0
    while i < 8 {
        BROKEN_SED_SIGN[0*16+i] = 1; BROKEN_SED_IDX[0*16+i] = i
        BROKEN_SED_SIGN[i*16+0] = 1; BROKEN_SED_IDX[i*16+0] = i
        BROKEN_SED_SIGN[i*16+i] = 0 - 1; BROKEN_SED_IDX[i*16+i] = 0
        i = i + 1
    }
    var fa: [i64; 7] = [1,2,3,4,5,6,7]
    var fb: [i64; 7] = [2,3,4,5,6,7,1]
    var fc: [i64; 7] = [4,5,6,7,1,2,3]
    var t: i64 = 0
    while t < 7 {
        let a = fa[t as usize]; let b = fb[t as usize]; let c = fc[t as usize]
        BROKEN_SED_SIGN[a*16+b]=1; BROKEN_SED_IDX[a*16+b]=c
        BROKEN_SED_SIGN[b*16+c]=1; BROKEN_SED_IDX[b*16+c]=a
        BROKEN_SED_SIGN[c*16+a]=1; BROKEN_SED_IDX[c*16+a]=b
        BROKEN_SED_SIGN[b*16+a]=0-1; BROKEN_SED_IDX[b*16+a]=c
        BROKEN_SED_SIGN[c*16+b]=0-1; BROKEN_SED_IDX[c*16+b]=a
        BROKEN_SED_SIGN[a*16+c]=0-1; BROKEN_SED_IDX[a*16+c]=b
        t = t + 1
    }
    var a: i64 = 0
    while a < 8 {
        var b: i64 = 0
        while b < 8 {
            let c = xor8(a, b)
            let s = BROKEN_SED_SIGN[a*16+b]
            if a == 0 { BROKEN_SED_SIGN[8*16+b] = 1; BROKEN_SED_IDX[8*16+b] = 8+b }
            else { BROKEN_SED_SIGN[(8+a)*16+b] = s; BROKEN_SED_IDX[(8+a)*16+b] = 8+c }
            if b == 0 { BROKEN_SED_SIGN[a*16+8] = 1; BROKEN_SED_IDX[a*16+8] = 8+a }
            else { BROKEN_SED_SIGN[a*16+(8+b)] = s; BROKEN_SED_IDX[a*16+(8+b)] = 8+c }
            if a == b { BROKEN_SED_SIGN[(8+a)*16+(8+b)] = 0-1; BROKEN_SED_IDX[(8+a)*16+(8+b)] = 0 }
            else { BROKEN_SED_SIGN[(8+a)*16+(8+b)] = 0-s; BROKEN_SED_IDX[(8+a)*16+(8+b)] = c }
            b = b + 1
        }
        a = a + 1
    }
    i = 0
    while i < 16 {
        BROKEN_SED_SIGN[0*16+i] = 1; BROKEN_SED_IDX[0*16+i] = i
        BROKEN_SED_SIGN[i*16+0] = 1; BROKEN_SED_IDX[i*16+0] = i
        i = i + 1
    }
    i = 1
    while i < 16 {
        BROKEN_SED_SIGN[i*16+i] = 0 - 1; BROKEN_SED_IDX[i*16+i] = 0
        i = i + 1
    }
}

// Count ordered imaginary-unit pairs (i,j), i,j in 1..15, i != j, where
// e_i * e_j != -(e_j * e_i) under the broken table (either the target
// basis index disagrees, or it agrees but the sign is not exactly
// opposite).
fn count_anticommutativity_violations() -> i64 with Mut {
    build_broken_sed_table()
    var violations: i64 = 0
    var i: i64 = 1
    while i < 16 {
        var j: i64 = 1
        while j < 16 {
            if i != j {
                let idx_ij = BROKEN_SED_IDX[i*16+j]
                let idx_ji = BROKEN_SED_IDX[j*16+i]
                let sign_ij = BROKEN_SED_SIGN[i*16+j]
                let sign_ji = BROKEN_SED_SIGN[j*16+i]
                if (idx_ij != idx_ji) || (sign_ij != (0 - sign_ji)) {
                    violations = violations + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    violations
}

// =============================================================================
// MAIN
// =============================================================================

fn main() -> i32 with IO, Mut, Div, Panic, NonAssoc {
    print("=== Cayley-Dickson hierarchy paper: corrected [2,1]-hook + G2-derivation verification ===\n")
    rng_seed(20260813)

    // --- Self-check: closed-form hook21 matches literal 6-term sum ---
    print("\n[Self-check] closed-form [2,1] vs literal 6-term sum (octonion, 5 random triples):\n")
    var max_disagree = 0.0
    var t: i64 = 0
    while t < 5 {
        let a = oct_rand(); let b = oct_rand(); let c = oct_rand()
        var h_closed: [f64; 8] = [0.0; 8]
        var h_full6: [f64; 8] = [0.0; 8]
        hook21_oct_closed(&a, &b, &c, &!h_closed)
        hook21_oct_full6(&a, &b, &c, &!h_full6)
        var diff: [f64; 8] = [0.0; 8]
        oct_sub(&h_closed, &h_full6, &!diff)
        let d = oct_norm(&diff)
        if d > max_disagree { max_disagree = d }
        t = t + 1
    }
    print("  max |closed - full6| = "); print_f64(max_disagree, 12); print("  (should be ~0)\n")

    // --- Octonion [2,1]: should be identically zero (Artin: associator is
    //     alternating, so its mixed-symmetry projection vanishes exactly —
    //     this is a THEOREM, not a measured result) ---
    print("\n[1] Octonion [2,1]-hook (theorem: ~0, machine epsilon):\n")
    var oct_max_hook = 0.0
    t = 0
    while t < 8 {
        let a = oct_rand(); let b = oct_rand(); let c = oct_rand()
        var hook: [f64; 8] = [0.0; 8]
        hook21_oct_closed(&a, &b, &c, &!hook)
        let n = oct_norm(&hook)
        var assoc: [f64; 8] = [0.0; 8]
        oct_associator(&a, &b, &c, &!assoc)
        let an = oct_norm(&assoc)
        print("  trial "); print_i64(t); print(": ||[2,1]|| = "); print_f64(n, 10)
        print("   (||assoc||="); print_f64(an, 4); print(")\n")
        if n > oct_max_hook { oct_max_hook = n }
        t = t + 1
    }
    print("  max over 8 trials = "); print_f64(oct_max_hook, 10); print("\n")

    // --- Sedenion [2,1]: should be nonzero (non-alternative). These are
    //     the REAL replacement numbers for the paper's unreproducible
    //     0.02-0.15 / 0.5-2.6 claim. ---
    print("\n[2] Sedenion [2,1]-hook (genuine, real Cayley-Dickson sed_mul):\n")
    var sed_min_hook = 0.0
    var sed_max_hook = 0.0
    var sed_min_ratio = 0.0
    var sed_max_ratio = 0.0
    t = 0
    while t < 8 {
        let a = sed_rand(); let b = sed_rand(); let c = sed_rand()
        var hook: [f64; 16] = [0.0; 16]
        hook21_sed_closed(&a, &b, &c, &!hook)
        let n = sed_norm(&hook)
        var assoc: [f64; 16] = [0.0; 16]
        sed_associator(&a, &b, &c, &!assoc)
        let an = sed_norm(&assoc)
        let ratio = n / an
        print("  trial "); print_i64(t); print(": ||[2,1]|| = "); print_f64(n, 4)
        print("   (||assoc||="); print_f64(an, 4); print(", ratio="); print_f64(ratio, 4); print(")\n")
        if t == 0 { sed_min_hook = n; sed_max_hook = n; sed_min_ratio = ratio; sed_max_ratio = ratio }
        if n < sed_min_hook { sed_min_hook = n }
        if n > sed_max_hook { sed_max_hook = n }
        if ratio < sed_min_ratio { sed_min_ratio = ratio }
        if ratio > sed_max_ratio { sed_max_ratio = ratio }
        t = t + 1
    }
    print("  range over 8 trials (unit-normal random operands) = [")
    print_f64(sed_min_hook, 4); print(", "); print_f64(sed_max_hook, 4); print("]\n")
    print("  scale-invariant ratio ||[2,1]||/||assoc|| range = [")
    print_f64(sed_min_ratio, 4); print(", "); print_f64(sed_max_ratio, 4)
    print("]  (this is the like-for-like replacement for the retracted 0.5-2.6 figure)\n")

    // --- G2 Leibniz law: correct formula must satisfy it exactly; wrong
    //     formula (audited g2_features.py) generally does not. ---
    print("\n[3] G2 derivation Leibniz-law check, D(x*y) =? D(x)*y + x*D(y):\n")
    print("    (a,b) ranges over the C(7,2)=21 basis-imaginary-unit pairs;\n")
    print("     x,y range over 8 random operands each; residual should be\n")
    print("     ~0 for the correct formula and generally nonzero for the\n")
    print("     audited (wrong) formula.)\n")
    var correct_max_resid = 0.0
    var wrong_fail_count: i64 = 0
    var wrong_total: i64 = 0
    var wrong_max_resid = 0.0
    var ai: i64 = 1
    while ai <= 7 {
        var bi: i64 = ai + 1
        while bi <= 7 {
            let a = oct_basis(ai)
            let b = oct_basis(bi)
            var trial: i64 = 0
            while trial < 3 {
                let x = oct_rand(); let y = oct_rand()
                let r_correct = leibniz_residual_norm(&a, &b, &x, &y, true)
                let r_wrong = leibniz_residual_norm(&a, &b, &x, &y, false)
                if r_correct > correct_max_resid { correct_max_resid = r_correct }
                if r_wrong > wrong_max_resid { wrong_max_resid = r_wrong }
                if r_wrong > 0.01 { wrong_fail_count = wrong_fail_count + 1 }
                wrong_total = wrong_total + 1
                trial = trial + 1
            }
            bi = bi + 1
        }
        ai = ai + 1
    }
    print("  correct formula: max Leibniz residual over 63 (pair,trial) checks = ")
    print_f64(correct_max_resid, 10); print("  (should be ~0)\n")
    print("  audited-wrong formula: max Leibniz residual = ")
    print_f64(wrong_max_resid, 6)
    print(", fails (>0.01) on "); print_i64(wrong_fail_count); print("/"); print_i64(wrong_total)
    print(" checks\n")

    // --- Anticommutativity of the AUDITED-BROKEN sedenion table, counted
    //     directly (not cited secondhand from the prior audit). ---
    print("\n[4] Anticommutativity violations in the audited-broken sedenion table\n")
    print("    (Fano-tuple octonion table extended via c=a XOR b, as in\n")
    print("     cayley_dickson_paper_reproduction.py's _build_sed_sign):\n")
    let violations = count_anticommutativity_violations()
    print("  violating ordered pairs (i,j), i,j in 1..15, i!=j: ")
    print_i64(violations); print(" / 210\n")

    print("\n=== DONE ===\n")
    0
}
