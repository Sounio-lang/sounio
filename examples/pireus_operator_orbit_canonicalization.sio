//@ run-pass
//!
//! Frozen Sounio semantic authority replay for Pireus V13.

use hardware::pireus::operator_orbit_canonicalization::{
    PireusPocDigest,
    pireus_operator_orbit_canonicalization_request,
    pireus_operator_orbit_canonicalization_run,
    pireus_operator_orbit_canonicalization_frozen_mismatch_code,
    pireus_operator_orbit_canonicalization_matches_frozen_semantics,
}

fn bit(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(digest: &PireusPocDigest) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(digest.words[word])
        word = word + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_operator_orbit_canonicalization_request()
    print("SOUNIO_AUTHORITY schema=pireus-operator-orbit-canonicalization.v13")
    print(" role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE")
    print(" matcher_free=0 expected_results=1\n")

    let result = pireus_operator_orbit_canonicalization_run(&request, true)
    let frozen_match =
        pireus_operator_orbit_canonicalization_matches_frozen_semantics(&result)
    let mismatch =
        pireus_operator_orbit_canonicalization_frozen_mismatch_code(&result)
    print("PIREUS_POC_BOUNDARY exact_declared_orbit=")
    print_int(bit(result.exact_declared_orbit_canonicalization_complete))
    print(" bounded_relative_novelty=")
    print_int(bit(result.bounded_relative_linear_swap_gauge_novelty))
    print(" full_space="); print_int(bit(result.full_2_pow_225_space_exhausted))
    print(" nonlinear_permutation=")
    print_int(bit(result.nonlinear_permutation_quotient_complete))
    print(" isotopy="); print_int(bit(result.isotopy_quotient_complete))
    print(" unrestricted_isomorphism=")
    print_int(bit(result.unrestricted_algebra_isomorphism_complete))
    print(" algebraic="); print_int(bit(result.algebraic_novelty))
    print(" algorithmic="); print_int(bit(result.algorithmic_novelty))
    print(" material="); print_int(bit(result.material_novelty))
    print(" performance="); print_int(bit(result.performance_novelty))
    print(" scientific="); print_int(bit(result.scientific_novelty))
    print(" global="); print_int(bit(result.global_novelty))
    print(" historical="); print_int(bit(result.historical_novelty))
    print(" priority="); print_int(bit(result.priority_claim))
    print(" claim_ready="); print_int(bit(result.claim_ready))
    print("\n")
    print("PIREUS_POC_AUTHORITY_RESULT valid="); print_int(bit(result.valid))
    print(" error="); print_int(result.error)
    print(" frozen_match="); print_int(bit(frozen_match))
    print(" frozen_mismatch_code="); print_int(mismatch)
    print(" baseline_digest="); print_digest(&result.baseline_digest)
    print(" run_digest="); print_digest(&result.run_digest)
    print("\n")
    if result.valid && frozen_match { 0 }
    else if mismatch != 0 { mismatch as i32 }
    else { result.error as i32 }
}
