//@ run-pass
// THREE-DOOR EXPERIMENT — Non-Associative Hepatic Transport
//
// Decomposition:
//   Door 1: Enzyme zonation (5:1 CYP3A4 gradient, steady flow)
//   Door 2: Pulsatile hemodynamics (portal + arterial, uniform CL)
//   Door 3: Space-time interaction (the non-associative [D,K] coupling)
//
// Uses flat [f64; 64] arrays (no struct mutation through &!) to work
// around native compiler struct-ref limitation.
//
// Parameter layout: [0]=D_eff [1]=dx [2]=k_release [3]=CL_site [4]=fu
//   [5]=Kp [6]=C_portal [7]=C_ha [8]=f_heart [9]=A_portal [10]=A_ha
//   [11]=phi_ha [12]=C_tissue [13]=v_blood [14]=zonation

// === Math helpers ===

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn sin_approx(x: f64) -> f64 with Mut {
    let pi: f64 = 3.14159265358979
    var a = x
    let two_pi = 2.0 * pi
    while a > pi { a = a - two_pi }
    while a < 0.0 - pi { a = a + two_pi }
    // Bhaskara I only valid for [0, pi]. Use antisymmetry for [-pi, 0].
    var sign: f64 = 1.0
    if a < 0.0 {
        a = 0.0 - a
        sign = 0.0 - 1.0
    }
    let pma = pi - a
    let a16 = 16.0 * a
    let num = a16 * pma
    let psq = pi * pi
    let t1 = 5.0 * psq
    let a4 = 4.0 * a
    let t2 = a4 * pma
    let den = t1 - t2
    if den == 0.0 { return 0.0 }
    sign * num / den
}

// === Pulsatile input ===

fn pulsatile_input(t: f64, p: &[f64; 64]) -> f64 with Mut {
    let pi: f64 = 3.14159265358979
    let two_pi = 2.0 * pi
    let omega = two_pi * p[8]
    let wt = omega * t
    let sin_wt = sin_approx(wt)
    let portal_amp = p[9] * sin_wt
    let portal = p[6] * (1.0 + portal_amp)
    let wt_phi = wt + p[11]
    let sin_wt_phi = sin_approx(wt_phi)
    let art_amp = p[10] * sin_wt_phi
    let artery = p[7] * (1.0 + art_amp)
    let p_term = 0.75 * portal
    let a_term = 0.25 * artery
    p_term + a_term
}

// === RHS: writes derivatives into deriv array ===

fn lattice_rhs(t: f64, vals: &[f64; 64], p: &[f64; 64], deriv: &![f64; 64]) with Mut, Div {
    let d_eff = p[0]
    let dx = p[1]
    let v_blood = p[13]
    let zonation = p[14]
    let vmax = p[15]
    let km = p[16]
    let dx2 = dx * dx
    let diff_c = d_eff / dx2
    let c_in = pulsatile_input(t, p)

    var i: i64 = 0
    while i < 64 {
        let c_i = vals[i]

        // Advection (upwind)
        var advection: f64 = 0.0
        if v_blood > 0.0 {
            var c_up: f64 = c_in
            if i > 0 { c_up = vals[i - 1] }
            let dc = c_i - c_up
            let raw = v_blood * dc
            advection = 0.0 - raw / dx
        }

        // Diffusion
        var diffusion: f64 = 0.0
        if i == 0 {
            var c_r = c_i
            if i + 1 < 64 { c_r = vals[i + 1] }
            let two_ci = 2.0 * c_i
            let lap = c_in - two_ci + c_r
            diffusion = diff_c * lap
        } else if i == 63 {
            let c_l = vals[i - 1]
            diffusion = diff_c * (c_l - c_i)
        } else {
            let c_l = vals[i - 1]
            let c_r = vals[i + 1]
            let two_ci = 2.0 * c_i
            let lap = c_l - two_ci + c_r
            diffusion = diff_c * lap
        }

        // Michaelis-Menten metabolism with enzyme zonation
        // CL(C) = Vmax * cl_factor * C / (Km + C)
        // Linear limit (Km >> C): CL ≈ (Vmax/Km) * C
        var cl_f: f64 = 1.0
        if zonation > 1.01 {
            let frac = (i as f64) / 63.0
            let zp1 = zonation + 1.0
            let zm1 = zonation - 1.0
            let inner = 1.0 + zm1 * frac
            cl_f = 2.0 / zp1 * inner
        }
        let vm_z = vmax * cl_f
        let mm_num = vm_z * c_i
        let mm_den = km + c_i
        let metab = 0.0 - mm_num / mm_den

        deriv[i] = advection + diffusion + metab
        i = i + 1
    }
}

// === Forward Euler step (flat arrays, no struct) ===

fn euler_step(t: f64, vals: &![f64; 64], p: &[f64; 64], dt: f64) with Mut, Div {
    var deriv: [f64; 64] = [0.0; 64]
    lattice_rhs(t, vals, p, &!deriv)
    var i: i64 = 0
    while i < 64 {
        let dv = dt * deriv[i]
        vals[i] = vals[i] + dv
        if vals[i] < 0.0 { vals[i] = 0.0 }
        i = i + 1
    }
}

// === Parameter init ===

fn init_params(p: &![f64; 64]) with Mut, Div {
    p[0] = 1.0 / 1000000000.0     // D_eff = 1e-9
    p[1] = 3.9 / 1000000.0        // dx = 3.9e-6
    p[2] = 0.0                     // k_release = 0
    p[3] = 3.0 / 1000.0           // CL_site = 0.003
    p[4] = 75.0 / 1000.0          // fu = 0.075
    p[5] = 5.0                     // Kp
    p[6] = 10.0                    // C_portal
    p[7] = 8.0                     // C_ha
    p[8] = 1.2                     // f_heart
    p[9] = 0.05                    // A_portal
    p[10] = 0.30                   // A_ha
    p[11] = 0.785                  // phi_ha
    p[12] = 0.0                    // C_tissue
    p[13] = 3.0 / 10000.0         // v_blood = 3e-4
    p[14] = 1.0                    // zonation (uniform)
    // [15]=Vmax, [16]=Km: Michaelis-Menten clearance
    // Linear limit: Vmax/Km = CL_site * fu = 0.000225
    // Default: Km=10 (moderate saturation at C_portal=10)
    let cl_lin = p[3] * p[4]
    p[16] = 10.0                    // Km (ng/mL) — at C_portal, C/Km = 1
    p[15] = cl_lin * p[16]          // Vmax = CL_linear * Km = 0.00225
}

// === Scenario runner ===

fn run_scenario(p: &[f64; 64], dt: f64, warmup: i64, meas: i64) -> f64 with Mut, Div {
    // Init lattice at input concentration
    let p6 = p[6]
    let p7 = p[7]
    let ci = 0.75 * p6 + 0.25 * p7
    var vals: [f64; 64] = [0.0; 64]
    var j: i64 = 0
    while j < 64 { vals[j] = ci; j = j + 1 }

    let fh = p[8]
    let tc = 1.0 / fh

    // Warmup
    var t: f64 = 0.0
    let tw = (warmup as f64) * tc
    while t < tw {
        var sdt = dt
        let rem = tw - t
        if sdt > rem { sdt = rem }
        euler_step(t, &!vals, p, sdt)
        t = t + sdt
    }

    // Measure cycle-averaged outflow
    var osum: f64 = 0.0
    var ns: i64 = 0
    let tm = (meas as f64) * tc
    let te = t + tm
    while t < te {
        var sdt = dt
        let rem = te - t
        if sdt > rem { sdt = rem }
        euler_step(t, &!vals, p, sdt)
        osum = osum + vals[63]
        ns = ns + 1
        t = t + sdt
    }

    osum / (ns as f64)
}

// === Run four scenarios and print three-door decomposition ===

fn run_three_doors(km_val: f64, cl_site_val: f64, dt: f64) with Mut, Div, Panic, IO {
    let warmup: i64 = 20
    let meas: i64 = 5

    // Scenario 1: Uniform + Steady
    var p1: [f64; 64] = [0.0; 64]
    init_params(&!p1)
    p1[3] = cl_site_val
    p1[9] = 0.0
    p1[10] = 0.0
    p1[14] = 1.0
    p1[16] = km_val
    let cl_lin = cl_site_val * p1[4]
    p1[15] = cl_lin * km_val
    let c_uu = run_scenario(&p1, dt, warmup, meas)

    // Scenario 2: Zonated + Steady
    var p2: [f64; 64] = [0.0; 64]
    init_params(&!p2)
    p2[3] = cl_site_val
    p2[9] = 0.0
    p2[10] = 0.0
    p2[14] = 5.0
    p2[16] = km_val
    p2[15] = cl_lin * km_val
    let c_zu = run_scenario(&p2, dt, warmup, meas)

    // Scenario 3: Uniform + Pulsatile
    var p3: [f64; 64] = [0.0; 64]
    init_params(&!p3)
    p3[3] = cl_site_val
    p3[14] = 1.0
    p3[16] = km_val
    p3[15] = cl_lin * km_val
    let c_up = run_scenario(&p3, dt, warmup, meas)

    // Scenario 4: Zonated + Pulsatile
    var p4: [f64; 64] = [0.0; 64]
    init_params(&!p4)
    p4[3] = cl_site_val
    p4[14] = 5.0
    p4[16] = km_val
    p4[15] = cl_lin * km_val
    let c_zp = run_scenario(&p4, dt, warmup, meas)

    // Reference: uniform steady outflow
    let ref_c = c_uu

    // Three doors (% of reference)
    let d1 = c_zu - c_uu
    let d2 = c_up - c_uu
    let d3 = c_zp - c_zu - c_up + c_uu
    let d1p = 100.0 * d1 / ref_c
    let d2p = 100.0 * d2 / ref_c
    let d3p = 100.0 * d3 / ref_c

    println("  Km (ng/mL):")
    println(km_val)
    println("  C/Km ratio:")
    let p6 = p1[6]
    println(p6 / km_val)
    println("  Vmax:")
    println(cl_lin * km_val)
    println("  Uniform+Steady outflow:")
    println(c_uu)
    println("  Door 1 (zonation %):")
    println(d1p)
    println("  Door 2 (pulsatility %):")
    println(d2p)
    println("  Door 3 (interaction %):")
    println(d3p)
    println("")
}

// === Main ===

fn main() -> i32 with Mut, Div, Panic, IO {
    println("=== JENSEN'S INEQUALITY IN THE SINUSOID ===")
    println("Linear vs Michaelis-Menten clearance")
    println("Rapamycin | 64 sites | v=300 um/s | 5:1 CYP3A4")
    println("")

    var base: [f64; 64] = [0.0; 64]
    init_params(&!base)
    let dx = base[1]
    let d_eff = base[0]
    let vb = base[13]
    let dx2 = dx * dx
    let dtd = 0.1 * dx2 / d_eff
    let dta = 0.2 * dx / vb
    let dt = if dtd < dta { dtd } else { dta }

    // --- LOW EXTRACTION (rapamycin-like, CL_site=0.003) ---
    println("=== LOW E (rapamycin, CL_site=0.003, E~0.02%) ===")
    println("")
    println("--- Linear (Km=10000) ---")
    run_three_doors(10000.0, 0.003, dt)
    println("--- Michaelis-Menten (Km=10, C/Km=1) ---")
    run_three_doors(10.0, 0.003, dt)

    // --- HIGH EXTRACTION (lidocaine-like, CL_site=15) ---
    // CL_total = 15 * 0.075 = 1.125, E ~ 48%
    println("=== HIGH E (lidocaine-like, CL_site=15, E~48%) ===")
    println("")
    println("--- Linear (Km=10000) ---")
    run_three_doors(10000.0, 15.0, dt)
    println("--- Michaelis-Menten (Km=10, C/Km=1) ---")
    run_three_doors(10.0, 15.0, dt)

    0
}
