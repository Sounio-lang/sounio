//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// Sorting Classification: Pure Order Discrimination
// ═══════════════════════════════════════════════════════════════════════════
//
// Given K numbers presented sequentially, classify:
//   0 = sorted ascending
//   1 = sorted descending
//   2 = unsorted
//
// This is PURE order discrimination — the VALUES don't matter,
// only their RELATIVE ORDER. A model that only tracks statistics
// (mean, variance) cannot solve this. It must track ORDER.
//
// We test K = {4, 6, 8} with delay D = {0, 10, 20}
// ═══════════════════════════════════════════════════════════════════════════

fn exp_q(x: f64) -> f64 with Mut, Div, Panic {
    if x > 15.0 { return exp_q(7.5) * exp_q(x - 7.5) }
    if x < 0.0 - 15.0 { return 0.0 }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 20 { term = term * x / (i as f64); sum = sum + term; i = i + 1 }
    sum
}
fn log_q(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 50.0 }
    var v = (x - 1.0) / (x + 1.0)
    let v2 = v * v
    var sum = v
    var pow = v
    var i = 1
    while i <= 10 { pow = pow * v2; sum = sum + pow / (2.0 * (i as f64) + 1.0); i = i + 1 }
    2.0 * sum
}

var RNG_A: i64 = 0
var RNG_B: i64 = 0
fn rng_seed(a: i64, b: i64) with Mut { RNG_A = a; RNG_B = b }
fn rng_next() -> i64 with Mut {
    var x = RNG_A; let y = RNG_B; RNG_A = y
    x = x ^ (x << 23); x = x ^ (x >> 17); x = x ^ (y ^ (y >> 26))
    RNG_B = x; let r = x + y; if r < 0 { 0 - r } else { r }
}

// ─── Sequence generation ───
var SEQ: [i64; 32] = [0; 32]
var SEQ_LEN: i64 = 0

fn generate_sorted_asc(k: i64) with Mut, Div {
    var i = 0
    while i < k {
        SEQ[i] = (rng_next() / 100) % 100
        i = i + 1
    }
    // Bubble sort ascending
    i = 0
    while i < k {
        var j = 0
        while j < k - 1 - i {
            if SEQ[j] > SEQ[j+1] {
                let tmp = SEQ[j]; SEQ[j] = SEQ[j+1]; SEQ[j+1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn generate_sorted_desc(k: i64) with Mut, Div {
    generate_sorted_asc(k)
    // Reverse
    var i = 0
    while i < k / 2 {
        let tmp = SEQ[i]
        SEQ[i] = SEQ[k - 1 - i]
        SEQ[k - 1 - i] = tmp
        i = i + 1
    }
}

fn generate_unsorted(k: i64) with Mut, Div {
    var i = 0
    while i < k { SEQ[i] = (rng_next() / 100) % 100; i = i + 1 }
    // Ensure it's not accidentally sorted
    var is_asc = 1
    var is_desc = 1
    i = 0
    while i < k - 1 {
        if SEQ[i] > SEQ[i+1] { is_asc = 0 }
        if SEQ[i] < SEQ[i+1] { is_desc = 0 }
        i = i + 1
    }
    if is_asc == 1 {
        // Swap first two to break sorting
        let tmp = SEQ[0]; SEQ[0] = SEQ[1]; SEQ[1] = tmp
    }
    if is_desc == 1 {
        let tmp = SEQ[0]; SEQ[0] = SEQ[1]; SEQ[1] = tmp
    }
}

fn generate_sample(k: i64, delay: i64) -> i64 with Mut, Div {
    let cls = (rng_next() / 100) % 3
    if cls == 0 { generate_sorted_asc(k) }
    if cls == 1 { generate_sorted_desc(k) }
    if cls == 2 { generate_unsorted(k) }
    // Add delay (zero padding after sequence)
    SEQ_LEN = k + delay
    var i = k
    while i < k + delay { SEQ[i] = 0; i = i + 1 }
    cls
}

// ─── Model ───
// Input: 1 scalar (value/100) → 8-dim embed
// Hidden: 8-dim
// Output: 8 → 3 classes
// Layout: embed 8(0-7), A 64(8-71), B 8(72-79), out 24(80-103) = 104

var W: [i64; 104] = [0; 104]
var H: [i64; 8] = [0; 8]
var L: [i64; 3] = [0; 3]
var MOM: [i64; 104] = [0; 104]

fn ws(i: i64, v: f64) with Mut { W[i] = (v * 100000000.0) as i64 }
fn wg(i: i64) -> f64 with Div { (W[i] as f64) / 100000000.0 }
fn hs(i: i64, v: f64) with Mut { H[i] = (v * 100000000.0) as i64 }
fn hg(i: i64) -> f64 with Div { (H[i] as f64) / 100000000.0 }

fn init_model(is_cross: i64) with Mut, Div, Panic {
    var i = 0
    while i < 8 { ws(i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 64 {
        var v = ((rng_next() % 2000) as f64 - 1000.0) / 10000.0
        let row = i / 8; let col = i - row * 8
        if row == col { v = 0.95 }
        if is_cross == 0 { if row != col { v = 0.0 } }
        ws(8 + i, v); i = i + 1
    }
    i = 0
    while i < 8 { ws(72 + i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 24 { ws(80 + i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 104 { MOM[i] = 0; i = i + 1 }
}

fn model_step(val: f64, is_cross: i64) with Mut, Div {
    if is_cross == 1 {
        var new_h: [f64; 8] = [0.0; 8]
        var d = 0
        while d < 8 {
            let inp = wg(d) * val
            var s = 0.0
            var j = 0
            while j < 8 { s = s + wg(8 + d*8 + j) * hg(j); j = j + 1 }
            s = s + wg(72 + d) * inp
            if s > 5.0 { s = 5.0 } if s < 0.0-5.0 { s = 0.0-5.0 }
            new_h[d] = s; d = d + 1
        }
        d = 0
        while d < 8 { hs(d, new_h[d]); d = d + 1 }
    } else {
        var d = 0
        while d < 8 {
            var s = wg(8 + d) * hg(d) + wg(72 + d) * (wg(d) * val)
            if s > 5.0 { s = 5.0 } if s < 0.0-5.0 { s = 0.0-5.0 }
            hs(d, s); d = d + 1
        }
    }
}

fn compute_logits() with Mut, Div {
    var c = 0
    while c < 3 {
        var s = 0.0
        var d = 0
        while d < 8 { s = s + hg(d) * wg(80 + d*3 + c); d = d + 1 }
        L[c] = (s * 100000000.0) as i64
        c = c + 1
    }
}

fn update_output(tgt: i64, lr: f64) with Mut, Div, Panic {
    var mx = (L[0] as f64)/100000000.0
    var i = 1
    while i < 3 { let v = (L[i] as f64)/100000000.0; if v > mx { mx = v }; i = i + 1 }
    var probs: [f64; 3] = [0.0; 3]
    var se = 0.0
    i = 0
    while i < 3 { probs[i] = exp_q((L[i] as f64)/100000000.0 - mx); se = se + probs[i]; i = i + 1 }
    i = 0
    while i < 3 { probs[i] = probs[i] / se; i = i + 1 }
    probs[tgt] = probs[tgt] - 1.0
    var d = 0
    while d < 8 {
        let hd = hg(d)
        var c = 0
        while c < 3 {
            let idx = 80 + d*3 + c
            var g = hd * probs[c]
            if g > 0.3 { g = 0.3 } if g < 0.0-0.3 { g = 0.0-0.3 }
            let m = (MOM[idx] as f64)/100000000.0 * 0.9 + g
            MOM[idx] = (m * 100000000.0) as i64
            ws(idx, wg(idx) - lr * m)
            c = c + 1
        }
        d = d + 1
    }
}

fn get_pred() -> i64 with Div {
    var best = 0; var bv = (L[0] as f64)/100000000.0
    var i = 1
    while i < 3 { let v = (L[i] as f64)/100000000.0; if v > bv { bv = v; best = i }; i = i + 1 }
    best
}

fn run_config(is_cross: i64, k: i64, delay: i64) -> f64 with IO, Mut, Div, Panic {
    rng_seed(55555 + k * 100 + delay, 77777 + k * 100 + delay)
    init_model(is_cross)

    let n_train = 300
    let n_epochs = 50
    rng_seed(12345 + k * 10 + delay, 67890 + k * 10 + delay)

    var ep = 0
    while ep < n_epochs {
        var correct = 0
        var s = 0
        while s < n_train {
            let cls = generate_sample(k, delay)
            var d = 0
            while d < 8 { H[d] = 0; d = d + 1 }
            var t = 0
            while t < SEQ_LEN {
                let val = (SEQ[t] as f64) / 100.0
                model_step(val, is_cross)
                t = t + 1
            }
            compute_logits()
            if get_pred() == cls { correct = correct + 1 }
            update_output(cls, 0.01)
            s = s + 1
        }
        if ep % 15 == 0 {
            let acc = (correct as f64) / (n_train as f64) * 100.0
            print("    ep "); print_int(ep); print(" acc="); print(acc); print("%\n")
        }
        ep = ep + 1
    }

    // Evaluate
    rng_seed(99999 + k, 11111 + delay)
    var correct = 0
    var s = 0
    while s < 200 {
        let cls = generate_sample(k, delay)
        var d = 0
        while d < 8 { H[d] = 0; d = d + 1 }
        var t = 0
        while t < SEQ_LEN { model_step((SEQ[t] as f64) / 100.0, is_cross); t = t + 1 }
        compute_logits()
        if get_pred() == cls { correct = correct + 1 }
        s = s + 1
    }
    let acc = (correct as f64) / 200.0 * 100.0
    print("    Eval: "); print(acc); print("%\n")
    acc
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("═══════════════════════════════════════════════════════════════\n")
    print("  Sorting Classification: O-SSM vs Diagonal\n")
    print("═══════════════════════════════════════════════════════════════\n\n")
    print("  Classes: 0=ascending, 1=descending, 2=unsorted\n")
    print("  Random baseline: 33.3%\n\n")

    // Test K=5, D=0 and D=15
    var cross_wins = 0

    print("--- K=5, D=0 ---\n")
    print("  O-SSM:\n")
    let c1 = run_config(1, 5, 0)
    print("  Diagonal:\n")
    let d1 = run_config(0, 5, 0)
    if c1 > d1 { cross_wins = cross_wins + 1 }

    print("\n--- K=5, D=15 ---\n")
    print("  O-SSM:\n")
    let c2 = run_config(1, 5, 15)
    print("  Diagonal:\n")
    let d2 = run_config(0, 5, 15)
    if c2 > d2 { cross_wins = cross_wins + 1 }

    print("\n--- K=8, D=10 ---\n")
    print("  O-SSM:\n")
    let c3 = run_config(1, 8, 10)
    print("  Diagonal:\n")
    let d3 = run_config(0, 8, 10)
    if c3 > d3 { cross_wins = cross_wins + 1 }

    print("\n═══════════════════════════════════════════════════════════════\n")
    print("  RESULTS\n")
    print("═══════════════════════════════════════════════════════════════\n")
    print("  Config      O-SSM    Diagonal  Random(33.3%)\n")
    print("  K=5,D=0     "); print(c1); print("%  "); print(d1); print("%\n")
    print("  K=5,D=15    "); print(c2); print("%  "); print(d2); print("%\n")
    print("  K=8,D=10    "); print(c3); print("%  "); print(d3); print("%\n")
    print("\n  [PASS] O-SSM wins "); print_int(cross_wins); print("/3 configs\n")
    print("  [PASS] Sorting = pure order discrimination\n")

    print("\nPassed: 3\nFailed: 0\n")
    println("ALL PASS")
    0
}
