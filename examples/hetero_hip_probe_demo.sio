//@ run-pass
//
// Hetero HIP probe demo: enumerate AMD devices through dlopen/dlsym
// call-through (HIP), printing measured facts for DeviceCaps.
// On a machine without ROCm it prints "hip: unavailable" and passes.
// Module source: stdlib/hetero/hip_probe.sio

use hetero::hip_probe::{hip_probe_open, hip_probe_print_name, hip_probe_total_mem}

fn main() with IO, Mut, Panic, Div, Alloc {
    let probe = hip_probe_open()
    if !probe.available {
        print("hip: unavailable (no ROCm on this machine, probe OK)\n")
        print("HIP PROBE DONE\n")
        exit(0)
    }
    print("hip devices=")
    print_int(probe.device_count as i64)
    print("\n")
    var i: i32 = 0
    while i < probe.device_count {
        print("device ")
        print_int(i as i64)
        print(": ")
        hip_probe_print_name(&probe, i)
        print(" vram_gib=")
        print_int(hip_probe_total_mem(&probe, i) / 1073741824)
        print("\n")
        i = i + 1
    }
    print("HIP PROBE DONE\n")
    exit(0)
}
