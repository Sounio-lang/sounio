//@ run-pass
//!
//! First Sounio authority stream for the value-free Apple CPU request binding.

use hardware::pireus::xor_selector_material_admission::{
    PireusXorMaterialFilePaths,
}
use hardware::pireus::apple_cpu_dependency_latency_request::{
    PireusAppleCpuLatencyDigest, PireusAppleCpuLatencyParentPaths,
    PIREUS_APPLE_CPU_LATENCY_OK,
    PIREUS_APPLE_CPU_LATENCY_PARENT_FILE_COUNT,
    pireus_apple_cpu_latency_parent_file_matches,
    pireus_apple_cpu_dependency_latency_request_evaluate,
    pireus_apple_cpu_dependency_latency_request_matches_frozen_semantics,
}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(digest: &PireusAppleCpuLatencyDigest)
with IO, Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if i > 0 { print(":") }
        print_int(digest.words[i as usize])
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 33 {
        print("usage: pireus_apple_cpu_dependency_latency_request <pdf> <xed> <darwin-receipt> <darwin-evidence> <apple-receipt> <apple-evidence> <dgx-receipt> <dgx-evidence> <garden> <target-cost-source> <target-cost-semantics> <target-cost-receipt> <target-cost-evidence> <material-source> <material-semantics> <material-receipt> <material-evidence> <cost-parent-garden> <cost-parent-admission-source> <cost-parent-admission-semantics> <cost-parent-admission-receipt> <cost-parent-admission-evidence> <engine-source> <engine-semantics> <engine-receipt> <operation-source> <operation-semantics> <operation-receipt> <material-parent-garden> <apple-material-receipt> <apple-material-evidence> <dgx-material-receipt> <dgx-material-evidence>\n")
        return 2
    }
    let material_files = PireusXorMaterialFilePaths {
        darwin_receipt: get_arg(2), darwin_evidence: get_arg(3),
        apple_receipt: get_arg(4), apple_evidence: get_arg(5),
        dgx_receipt: get_arg(6), dgx_evidence: get_arg(7),
    }
    let parents = PireusAppleCpuLatencyParentPaths {
        garden: get_arg(8),
        target_cost_source: get_arg(9),
        target_cost_semantics: get_arg(10),
        target_cost_receipt: get_arg(11),
        target_cost_evidence: get_arg(12),
        material_source: get_arg(13),
        material_semantics: get_arg(14),
        material_receipt: get_arg(15),
        material_evidence: get_arg(16),
        cost_parent_garden: get_arg(17),
        cost_parent_admission_source: get_arg(18),
        cost_parent_admission_semantics: get_arg(19),
        cost_parent_admission_receipt: get_arg(20),
        cost_parent_admission_evidence: get_arg(21),
        cost_parent_engine_source: get_arg(22),
        cost_parent_engine_semantics: get_arg(23),
        cost_parent_engine_receipt: get_arg(24),
        cost_parent_operation_source: get_arg(25),
        cost_parent_operation_semantics: get_arg(26),
        cost_parent_operation_receipt: get_arg(27),
        material_parent_garden: get_arg(28),
        material_parent_apple_receipt: get_arg(29),
        material_parent_apple_evidence: get_arg(30),
        material_parent_dgx_receipt: get_arg(31),
        material_parent_dgx_evidence: get_arg(32),
    }
    let result = pireus_apple_cpu_dependency_latency_request_evaluate(
        get_arg(0), get_arg(1), &material_files, &parents)
    var failures = result.failures
    if !result.valid || result.error != PIREUS_APPLE_CPU_LATENCY_OK {
        failures = failures + 1
    }
    if !pireus_apple_cpu_dependency_latency_request_matches_frozen_semantics(
        &result) {
        failures = failures + 1
    }

    print("SOUNIO_SEMANTIC_AUTHORITY schema=pireus.apple-cpu-dependency-latency-request.v1 stage=SEMANTICS_FROZEN\n")
    print("PIREUS_APPLE_LATENCY_PARENTS files=")
    print_int(PIREUS_APPLE_CPU_LATENCY_PARENT_FILE_COUNT)
    print(" matched="); print_int(result.parent_file_match_count)
    print(" target_cost_live="); print_int(yes(result.target_cost_parent_live))
    print(" material_live="); print_int(yes(result.material_engine_parent_live))
    print(" valid="); print_int(yes(result.parent_files_valid)); print("\n")
    var i: i64 = 0
    while i < PIREUS_APPLE_CPU_LATENCY_PARENT_FILE_COUNT {
        print("PIREUS_APPLE_LATENCY_PARENT_FILE index="); print_int(i)
        print(" match=")
        print_int(yes(pireus_apple_cpu_latency_parent_file_matches(
            result.parent_file_match_mask, i)))
        print("\n")
        i = i + 1
    }

    print("PIREUS_APPLE_LATENCY_TEMPLATE index=")
    print_int(result.template.request_index)
    print(" request_id="); print_int(result.template.request_id)
    print(" target="); print_int(result.request.target_id)
    print(" parent_machine="); print_int(result.request.machine_id)
    print(" parent_engine="); print_int(result.request.engine_id)
    print(" blueprint="); print_int(yes(result.request.engine_is_blueprint))
    print(" parent_engine_observed=")
    print_int(yes(result.request.engine_observed))
    print(" subject_kind="); print_int(result.request.subject_kind)
    print(" subject_node="); print_int(result.request.subject_node)
    print(" quantity="); print_int(result.request.quantity)
    print(" unit="); print_int(result.request.unit)
    print(" scope="); print_int(result.request.scope)
    print(" statistic="); print_int(result.request.statistic)
    print(" samples="); print_int(result.request.requested_sample_count)
    print(" warmups="); print_int(result.request.requested_warmup_count)
    print(" required_environment=")
    print_int(result.request.required_environment_mask)
    print(" bound_environment=")
    print_int(result.request.bound_environment_mask)
    print(" valid="); print_int(yes(result.request_template_valid)); print("\n")

    print("PIREUS_APPLE_LATENCY_BINDING request_id=")
    print_int(result.binding.template_request_id)
    print(" target="); print_int(result.binding.target_id)
    print(" machine="); print_int(result.binding.machine_id)
    print(" engine="); print_int(result.binding.engine_id)
    print(" kind="); print_int(result.binding.engine_kind)
    print(" isa="); print_int(result.binding.isa_id)
    print(" receipt="); print_int(result.binding.receipt_id)
    print(" evidence="); print_int(result.binding.evidence_id)
    print(" hardware="); print_int(result.binding.hardware_id)
    print(" subject="); print_int(result.binding.material_subject_id)
    print(" operation="); print_int(result.binding.material_operation_id)
    print(" eligibility="); print_int(result.binding.eligibility_id)
    print(" state="); print_int(result.binding.state_tag)
    print(" authorization=")
    print_int(result.binding.execution_authorization_id)
    print(" feasibility=")
    print_int(result.binding.measurement_feasibility)
    print(" admitted=")
    print_int(yes(result.engine_identity_materially_admitted)); print("\n")

    print("PIREUS_APPLE_LATENCY_PREDICATES template=")
    print_int(yes(result.request_template_valid))
    print(" material="); print_int(yes(result.material_instance_valid))
    print(" target="); print_int(yes(result.target_matches_instance))
    print(" subject="); print_int(yes(result.subject_matches_receipt))
    print(" quantity="); print_int(yes(result.quantity_eligible)); print("\n")

    print("PIREUS_APPLE_LATENCY_BOUNDARY interface_ready=")
    print_int(yes(result.measurement_interface_ready))
    print(" execution_authorized=")
    print_int(yes(result.execution_authorized))
    print(" environment_bound="); print_int(yes(result.environment_bound))
    print(" value_present="); print_int(yes(result.value_present))
    print(" observations=")
    print_int(yes(result.material_observation_present))
    print(" summaries="); print_int(yes(result.derived_summary_present))
    print(" comparisons="); print_int(yes(result.comparison_present))
    print(" speedups="); print_int(yes(result.speedup_present))
    print(" rankings="); print_int(yes(result.ranking_present))
    print(" parity_open="); print_int(yes(result.parity_open))
    print(" claim_ready="); print_int(yes(result.claim_ready)); print("\n")

    print("PIREUS_APPLE_LATENCY_ONTOLOGY triples=")
    print_int(result.ontology_triple_count)
    print(" binding_valid="); print_int(yes(result.ontology_binding_valid))
    print("\n")
    print("PIREUS_APPLE_LATENCY_NEGATIVES passed=")
    print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")
    print("PIREUS_APPLE_LATENCY_PARENT_MANIFEST_DIGEST words=")
    print_digest(&result.parent_manifest_digest); print("\n")
    print("PIREUS_APPLE_LATENCY_ONTOLOGY_DIGEST words=")
    print_digest(&result.ontology_digest); print("\n")
    print("PIREUS_APPLE_LATENCY_RESULT_DIGEST words=")
    print_digest(&result.result_digest); print("\n")
    print("PIREUS_APPLE_LATENCY_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(failures); print("\n")
    if failures == 0 { 0 } else { 1 }
}
