// Comprehensive test of the grad builtin function
// grad(f, x) computes f'(x) where f: fn(dual) -> dual

// f(x) = x^2, f'(x) = 2x
fn square(x: dual) -> dual {
    dual_mul(x, x)
}

// f(x) = sin(x), f'(x) = cos(x)
fn sine(x: dual) -> dual {
    dual_sin(x)
}

// f(x) = exp(x), f'(x) = exp(x)
fn exponential(x: dual) -> dual {
    dual_exp(x)
}

// f(x) = x^3, f'(x) = 3x^2
fn cube(x: dual) -> dual {
    dual_mul(dual_mul(x, x), x)
}

fn main() {
    println("=== Comprehensive grad() Tests ===")
    println("")

    // Test 1: Square at x=3
    let d1 = grad(square, 3.0)
    println("d/dx(x^2) at x=3:")
    println(d1)
    println("Expected: 6.0")
    println("")

    // Test 2: Square at x=0
    let d2 = grad(square, 0.0)
    println("d/dx(x^2) at x=0:")
    println(d2)
    println("Expected: 0.0")
    println("")

    // Test 3: Sine at x=0
    let d3 = grad(sine, 0.0)
    println("d/dx(sin(x)) at x=0:")
    println(d3)
    println("Expected: 1.0 (cos(0) = 1)")
    println("")

    // Test 4: Exponential at x=0
    let d4 = grad(exponential, 0.0)
    println("d/dx(exp(x)) at x=0:")
    println(d4)
    println("Expected: 1.0 (exp(0) = 1)")
    println("")

    // Test 5: Cube at x=2
    let d5 = grad(cube, 2.0)
    println("d/dx(x^3) at x=2:")
    println(d5)
    println("Expected: 12.0 (3*2^2 = 12)")
}
