//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// O-FSSM: Second-Order Optimization Over Non-Associative Landscapes
// ═══════════════════════════════════════════════════════════════════════════
//
// Hypothesis: Non-associativity lives in the CURVATURE (Hessian), not the
// gradient. SGD is structurally blind to it. L-BFGS sees curvature via
// gradient history → can navigate non-associative landscapes.
//
// Architecture: h' = clamp((A ⊗ h) ⊗ x), A = unit octonion/quaternion
// L-BFGS applied to 8 A-params only (where the curvature lives)
// SGD on embed/B/output (standard layers)
//
// 4-way comparison:
//   0: O-SSM + L-BFGS  (non-assoc + second-order)
//   1: O-SSM + SGD     (non-assoc + first-order, control)
//   2: H-SSM + L-BFGS  (assoc + second-order, control)
//   3: H-SSM + SGD     (assoc + first-order, baseline)

fn exp_q(x: f64) -> f64 with Mut, Div, Panic {
    if x > 15.0 { return exp_q(7.5) * exp_q(x - 7.5) }
    if x < 0.0 - 15.0 { return 0.0 }
    var sum = 1.0; var term = 1.0; var i = 1
    while i <= 20 { term = term * x / (i as f64); sum = sum + term; i = i + 1 }
    sum
}
fn sqrt_q(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var g = x; var i = 0
    while i < 15 { g = 0.5 * (g + x / g); i = i + 1 }
    g
}

var RNG_A: i64 = 0; var RNG_B: i64 = 0
fn rng_seed(a: i64, b: i64) with Mut { RNG_A = a; RNG_B = b }
fn rng_next() -> i64 with Mut {
    var x = RNG_A; let y = RNG_B; RNG_A = y
    x = x ^ (x << 23); x = x ^ (x >> 17); x = x ^ (y ^ (y >> 26))
    RNG_B = x; let r = x + y; if r < 0 { 0 - r } else { r }
}

// ─── Fano plane (same as all prior benchmarks) ───
fn oct_sign(i: i64, j: i64) -> i64 {
    if i==0{return 1} if j==0{return 1} if i==j{return 0-1}
    if i==1{if j==2{return 1}if j==4{return 0-1}if j==3{return 1}if j==5{return 1}if j==6{return 0-1}if j==7{return 0-1}}
    if i==2{if j==1{return 0-1}if j==3{return 1}if j==4{return 1}if j==5{return 0-1}if j==6{return 1}if j==7{return 0-1}}
    if i==3{if j==1{return 0-1}if j==2{return 0-1}if j==4{return 1}if j==5{return 1}if j==6{return 0-1}if j==7{return 1}}
    if i==4{if j==1{return 1}if j==2{return 0-1}if j==3{return 0-1}if j==5{return 1}if j==6{return 1}if j==7{return 0-1}}
    if i==5{if j==1{return 0-1}if j==2{return 1}if j==3{return 0-1}if j==4{return 0-1}if j==6{return 1}if j==7{return 1}}
    if i==6{if j==1{return 1}if j==2{return 0-1}if j==3{return 1}if j==4{return 0-1}if j==5{return 0-1}if j==7{return 1}}
    if i==7{if j==1{return 1}if j==2{return 1}if j==3{return 0-1}if j==4{return 1}if j==5{return 0-1}if j==6{return 0-1}}
    0
}
fn oct_basis(i: i64, j: i64) -> i64 {
    if i==0{return j}if j==0{return i}if i==j{return 0}
    if i==1{if j==2{return 4}if j==4{return 2}if j==3{return 7}if j==5{return 6}if j==6{return 5}if j==7{return 3}}
    if i==2{if j==1{return 4}if j==3{return 5}if j==4{return 1}if j==5{return 3}if j==6{return 7}if j==7{return 6}}
    if i==3{if j==1{return 7}if j==2{return 5}if j==4{return 6}if j==5{return 2}if j==6{return 4}if j==7{return 1}}
    if i==4{if j==1{return 2}if j==2{return 1}if j==3{return 6}if j==5{return 7}if j==6{return 3}if j==7{return 5}}
    if i==5{if j==1{return 6}if j==2{return 3}if j==3{return 2}if j==4{return 7}if j==6{return 1}if j==7{return 4}}
    if i==6{if j==1{return 5}if j==2{return 7}if j==3{return 4}if j==4{return 3}if j==5{return 1}if j==7{return 2}}
    if i==7{if j==1{return 3}if j==2{return 6}if j==3{return 1}if j==4{return 5}if j==5{return 4}if j==6{return 2}}
    0
}
fn oct_signed_mul(s_a: i64, idx_a: i64, idx_b: i64) -> i64 with Mut {
    let rs = oct_sign(idx_a, idx_b); let rb = oct_basis(idx_a, idx_b)
    var fs = rs; if s_a < 0 { fs = 0 - fs }
    if fs >= 0 { rb } else { 8 + rb }
}

var PROBE_TOKENS: [i64; 4] = [0; 4]; var PROBE_LABEL: i64 = 0; var PROBE_IS_ASSOC: i64 = 0
fn generate_assoc_probe() with Mut, Div {
    let a=(rng_next()/100)%8; let b=(rng_next()/100)%8; let c=(rng_next()/100)%8; let mode=(rng_next()/100)%2
    PROBE_TOKENS[0]=a; PROBE_TOKENS[1]=b; PROBE_TOKENS[2]=c; PROBE_TOKENS[3]=mode+8
    let ab_s=oct_sign(a,b); let ab_i=oct_basis(a,b); let left=oct_signed_mul(ab_s,ab_i,c)
    let bc_s=oct_sign(b,c); let bc_i=oct_basis(b,c); let right=oct_signed_mul(bc_s,a,bc_i)
    if mode==0{PROBE_LABEL=left}if mode==1{PROBE_LABEL=right}
    if left==right{PROBE_IS_ASSOC=1}else{PROBE_IS_ASSOC=0}
}

// ═══════════════════════════════════════════════════════════════════════════
// Weights: Embed(80) + A(8) + B(8) + Out(128) = 224
// ═══════════════════════════════════════════════════════════════════════════
var W: [i64; 224] = [0; 224]
var H: [i64; 8] = [0; 8]
var L: [i64; 16] = [0; 16]
var MOM: [i64; 224] = [0; 224]

// BPTT state saving (4 timesteps × 8 dims)
var H_SAVE: [i64; 64] = [0; 64]
var X_SAVE: [i64; 64] = [0; 64]
var N_STEPS: i64 = 0
var DH: [i64; 8] = [0; 8]

fn ws(i: i64, v: f64) with Mut { W[i] = (v * 100000000.0) as i64 }
fn wg(i: i64) -> f64 with Div { (W[i] as f64) / 100000000.0 }
fn hs(i: i64, v: f64) with Mut { H[i] = (v * 100000000.0) as i64 }
fn hg(i: i64) -> f64 with Div { (H[i] as f64) / 100000000.0 }

fn init_embed_b_out() with Mut, Div {
    var i = 0
    while i < 80 { ws(i, ((rng_next()%2000) as f64 - 1000.0)/3000.0); i = i + 1 }
    i = 0
    while i < 8 { ws(88+i, ((rng_next()%2000) as f64 - 1000.0)/3000.0); i = i + 1 }
    i = 0
    while i < 128 { ws(96+i, ((rng_next()%2000) as f64 - 1000.0)/3000.0); i = i + 1 }
    i = 0
    while i < 224 { MOM[i] = 0; i = i + 1 }
}

fn init_A_oct() with Mut, Div, Panic {
    var nsq = 0.0; var d = 0
    while d < 8 {
        let v = ((rng_next()%2000) as f64 - 1000.0)/1000.0
        ws(80+d, v); nsq = nsq + v*v; d = d + 1
    }
    let n = sqrt_q(nsq)
    if n > 0.001 { d = 0; while d < 8 { ws(80+d, wg(80+d)/n); d = d + 1 } }
}

fn init_A_quat() with Mut, Div, Panic {
    // Two unit quaternions
    var nsq = 0.0; var d = 0
    while d < 4 { let v=((rng_next()%2000) as f64-1000.0)/1000.0; ws(80+d,v); nsq=nsq+v*v; d=d+1 }
    var n = sqrt_q(nsq)
    if n > 0.001 { d=0; while d < 4 { ws(80+d, wg(80+d)/n); d=d+1 } }
    nsq = 0.0; d = 0
    while d < 4 { let v=((rng_next()%2000) as f64-1000.0)/1000.0; ws(84+d,v); nsq=nsq+v*v; d=d+1 }
    n = sqrt_q(nsq)
    if n > 0.001 { d=0; while d < 4 { ws(84+d, wg(84+d)/n); d=d+1 } }
}

fn renormalize_A_oct() with Mut, Div, Panic {
    var nsq = 0.0; var d = 0
    while d < 8 { let v = wg(80+d); nsq = nsq + v*v; d = d + 1 }
    let n = sqrt_q(nsq)
    if n > 0.001 { d=0; while d < 8 { ws(80+d, wg(80+d)/n); d=d+1 } }
}

fn renormalize_A_quat() with Mut, Div, Panic {
    var nsq = 0.0; var d = 0
    while d < 4 { let v=wg(80+d); nsq=nsq+v*v; d=d+1 }
    var n = sqrt_q(nsq)
    if n > 0.001 { d=0; while d < 4 { ws(80+d, wg(80+d)/n); d=d+1 } }
    nsq = 0.0; d = 0
    while d < 4 { let v=wg(84+d); nsq=nsq+v*v; d=d+1 }
    n = sqrt_q(nsq)
    if n > 0.001 { d=0; while d < 4 { ws(84+d, wg(84+d)/n); d=d+1 } }
}

// ═══════════════════════════════════════════════════════════════════════════
// oct_mul helper
// ═══════════════════════════════════════════════════════════════════════════
var T1: [f64; 8] = [0.0; 8]

fn do_oct_mul(a0: f64,a1: f64,a2: f64,a3: f64,a4: f64,a5: f64,a6: f64,a7: f64,
              b0: f64,b1: f64,b2: f64,b3: f64,b4: f64,b5: f64,b6: f64,b7: f64) with Mut {
    T1[0]=a0*b0-a1*b1-a2*b2-a3*b3-a4*b4-a5*b5-a6*b6-a7*b7
    T1[1]=a0*b1+a1*b0+a2*b3-a3*b2+a4*b5-a5*b4-a6*b7+a7*b6
    T1[2]=a0*b2+a2*b0-a1*b3+a3*b1+a4*b6-a6*b4+a5*b7-a7*b5
    T1[3]=a0*b3+a3*b0+a1*b2-a2*b1+a4*b7-a7*b4-a5*b6+a6*b5
    T1[4]=a0*b4+a4*b0-a1*b5+a5*b1-a2*b6+a6*b2-a3*b7+a7*b3
    T1[5]=a0*b5+a5*b0+a1*b4-a4*b1-a2*b7+a7*b2+a3*b6-a6*b3
    T1[6]=a0*b6+a6*b0+a1*b7-a7*b1+a2*b4-a4*b2-a3*b5+a5*b3
    T1[7]=a0*b7+a7*b0-a1*b6+a6*b1+a2*b5-a5*b2+a3*b4-a4*b3
}

// ═══════════════════════════════════════════════════════════════════════════
// Forward: Triple product h' = clamp((A ⊗ h) ⊗ x)
// ═══════════════════════════════════════════════════════════════════════════

var ASSOC_NORM: f64 = 0.0  // associator norm for current step

fn oct_triple_step(token: i64) with Mut, Div, Panic {
    let a0=wg(80);let a1=wg(81);let a2=wg(82);let a3=wg(83)
    let a4=wg(84);let a5=wg(85);let a6=wg(86);let a7=wg(87)
    let h0=hg(0);let h1=hg(1);let h2=hg(2);let h3=hg(3)
    let h4=hg(4);let h5=hg(5);let h6=hg(6);let h7=hg(7)
    let x0=wg(token*8);let x1=wg(token*8+1);let x2=wg(token*8+2);let x3=wg(token*8+3)
    let x4=wg(token*8+4);let x5=wg(token*8+5);let x6=wg(token*8+6);let x7=wg(token*8+7)

    // Step 1: temp = A ⊗ h
    do_oct_mul(a0,a1,a2,a3,a4,a5,a6,a7, h0,h1,h2,h3,h4,h5,h6,h7)
    let t0=T1[0];let t1=T1[1];let t2=T1[2];let t3=T1[3]
    let t4=T1[4];let t5=T1[5];let t6=T1[6];let t7=T1[7]

    // Step 2: result_left = temp ⊗ x  (the actual state update)
    do_oct_mul(t0,t1,t2,t3,t4,t5,t6,t7, x0,x1,x2,x3,x4,x5,x6,x7)
    var left: [f64; 8] = [0.0; 8]
    var d = 0
    while d < 8 { left[d] = T1[d]; d = d + 1 }

    // Step 3: compute right association for associator: A ⊗ (h ⊗ x)
    do_oct_mul(h0,h1,h2,h3,h4,h5,h6,h7, x0,x1,x2,x3,x4,x5,x6,x7)
    let hx0=T1[0];let hx1=T1[1];let hx2=T1[2];let hx3=T1[3]
    let hx4=T1[4];let hx5=T1[5];let hx6=T1[6];let hx7=T1[7]
    do_oct_mul(a0,a1,a2,a3,a4,a5,a6,a7, hx0,hx1,hx2,hx3,hx4,hx5,hx6,hx7)

    // Associator norm
    var asq = 0.0
    d = 0
    while d < 8 { let diff = left[d] - T1[d]; asq = asq + diff*diff; d = d + 1 }
    ASSOC_NORM = sqrt_q(asq)

    // Store left-association result as state
    d = 0
    while d < 8 {
        var v = left[d]
        if v > 5.0 { v = 5.0 } if v < 0.0 - 5.0 { v = 0.0 - 5.0 }
        hs(d, v); d = d + 1
    }
}

fn quat_triple_step(token: i64) with Mut, Div {
    // Block 1: (q1 ⊗ h[0:3]) ⊗ x[0:3]  — associative, brackets don't matter
    let qw=wg(80);let qx=wg(81);let qy=wg(82);let qz=wg(83)
    let hw=hg(0);let hx=hg(1);let hy=hg(2);let hz=hg(3)
    let tw=qw*hw-qx*hx-qy*hy-qz*hz; let tx=qw*hx+qx*hw+qy*hz-qz*hy
    let ty=qw*hy-qx*hz+qy*hw+qz*hx; let tz=qw*hz+qx*hy-qy*hx+qz*hw
    let xw=wg(token*8);let xx=wg(token*8+1);let xy=wg(token*8+2);let xz=wg(token*8+3)
    var n0=tw*xw-tx*xx-ty*xy-tz*xz; var n1=tw*xx+tx*xw+ty*xz-tz*xy
    var n2=tw*xy-tx*xz+ty*xw+tz*xx; var n3=tw*xz+tx*xy-ty*xx+tz*xw
    if n0>5.0{n0=5.0}if n0<0.0-5.0{n0=0.0-5.0}
    if n1>5.0{n1=5.0}if n1<0.0-5.0{n1=0.0-5.0}
    if n2>5.0{n2=5.0}if n2<0.0-5.0{n2=0.0-5.0}
    if n3>5.0{n3=5.0}if n3<0.0-5.0{n3=0.0-5.0}
    // Block 2
    let qw2=wg(84);let qx2=wg(85);let qy2=wg(86);let qz2=wg(87)
    let hw2=hg(4);let hx2=hg(5);let hy2=hg(6);let hz2=hg(7)
    let tw2=qw2*hw2-qx2*hx2-qy2*hy2-qz2*hz2; let tx2=qw2*hx2+qx2*hw2+qy2*hz2-qz2*hy2
    let ty2=qw2*hy2-qx2*hz2+qy2*hw2+qz2*hx2; let tz2=qw2*hz2+qx2*hy2-qy2*hx2+qz2*hw2
    let xw2=wg(token*8+4);let xx2=wg(token*8+5);let xy2=wg(token*8+6);let xz2=wg(token*8+7)
    var n4=tw2*xw2-tx2*xx2-ty2*xy2-tz2*xz2; var n5=tw2*xx2+tx2*xw2+ty2*xz2-tz2*xy2
    var n6=tw2*xy2-tx2*xz2+ty2*xw2+tz2*xx2; var n7=tw2*xz2+tx2*xy2-ty2*xx2+tz2*xw2
    if n4>5.0{n4=5.0}if n4<0.0-5.0{n4=0.0-5.0}
    if n5>5.0{n5=5.0}if n5<0.0-5.0{n5=0.0-5.0}
    if n6>5.0{n6=5.0}if n6<0.0-5.0{n6=0.0-5.0}
    if n7>5.0{n7=5.0}if n7<0.0-5.0{n7=0.0-5.0}
    hs(0,n0);hs(1,n1);hs(2,n2);hs(3,n3);hs(4,n4);hs(5,n5);hs(6,n6);hs(7,n7)
    ASSOC_NORM = 0.0  // quaternions are associative
}

fn model_fwd(token: i64, is_oct: i64) with Mut, Div, Panic {
    if is_oct == 1 { oct_triple_step(token) } else { quat_triple_step(token) }
}

fn model_fwd_save(token: i64, is_oct: i64, step: i64) with Mut, Div, Panic {
    var d = 0
    while d < 8 { H_SAVE[step*8+d] = H[d]; d = d + 1 }
    d = 0
    while d < 8 { X_SAVE[step*8+d] = (wg(token*8+d)*100000000.0) as i64; d = d + 1 }
    model_fwd(token, is_oct)
}

// ═══════════════════════════════════════════════════════════════════════════
// Logits + Output Update
// ═══════════════════════════════════════════════════════════════════════════

fn compute_logits() with Mut, Div {
    var c = 0
    while c < 16 {
        var s = 0.0; var d = 0
        while d < 8 { s = s + hg(d)*wg(96+d*16+c); d = d + 1 }
        L[c] = (s*100000000.0) as i64; c = c + 1
    }
}

fn get_pred() -> i64 with Mut, Div {
    var best=0; var bv=(L[0] as f64)/100000000.0; var i=1
    while i < 16 { let v=(L[i] as f64)/100000000.0; if v > bv { bv=v; best=i }; i=i+1 }
    best
}

var PROBS: [f64; 16] = [0.0; 16]

fn compute_probs(tgt: i64) with Mut, Div, Panic {
    var mx=(L[0] as f64)/100000000.0; var i=1
    while i < 16 { let v=(L[i] as f64)/100000000.0; if v > mx { mx=v }; i=i+1 }
    var se=0.0; i=0
    while i < 16 { PROBS[i]=exp_q((L[i] as f64)/100000000.0-mx); se=se+PROBS[i]; i=i+1 }
    i=0; while i < 16 { PROBS[i]=PROBS[i]/se; i=i+1 }
    PROBS[tgt] = PROBS[tgt] - 1.0
}

fn update_output(tgt: i64, lr: f64) with Mut, Div, Panic {
    compute_probs(tgt)
    var d = 0
    while d < 8 {
        let hd = hg(d); var c = 0
        while c < 16 {
            let idx = 96+d*16+c
            var g = hd*PROBS[c]
            if g>0.3{g=0.3}if g<0.0-0.3{g=0.0-0.3}
            let m = (MOM[idx] as f64)/100000000.0*0.9 + g
            MOM[idx] = (m*100000000.0) as i64
            ws(idx, wg(idx) - lr*m)
            c = c + 1
        }
        d = d + 1
    }
}

// Compute dL/dh (output gradient) into DH, also update output weights
fn compute_dh_and_update_out(tgt: i64, lr_out: f64) with Mut, Div, Panic {
    compute_probs(tgt)
    var d = 0
    while d < 8 {
        let hd=hg(d); var dh_d=0.0; var c=0
        while c < 16 {
            let idx=96+d*16+c
            var g=hd*PROBS[c]
            if g>0.5{g=0.5}if g<0.0-0.5{g=0.0-0.5}
            let m=(MOM[idx] as f64)/100000000.0*0.9+g
            MOM[idx]=(m*100000000.0) as i64
            ws(idx, wg(idx)-lr_out*m)
            dh_d = dh_d + wg(96+d*16+c)*PROBS[c]
            c=c+1
        }
        DH[d]=(dh_d*100000000.0) as i64
        d=d+1
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Simple BPTT for A gradient: accumulate dA over 4 timesteps
// For the triple product, dA is complex but we use numerical approximation:
// dA[i] ≈ Σ_t dh_t · ∂h_t/∂A[i] via finite difference
// ═══════════════════════════════════════════════════════════════════════════

var DA: [f64; 8] = [0.0; 8]  // accumulated gradient for 8 A-params

fn compute_dA_numerical(is_oct: i64) with Mut, Div, Panic {
    // Numerical gradient: perturb each A param, measure loss change
    // Uses the LAST sample's forward pass state
    let eps = 0.0001
    var i = 0
    while i < 8 {
        let orig = wg(80+i)
        // Forward perturb
        ws(80+i, orig + eps)
        // Quick re-forward on last sequence
        var d = 0
        while d < 8 { H[d] = 0; d = d + 1 }
        var t = 0
        while t < 4 { model_fwd(PROBE_TOKENS[t], is_oct); t = t + 1 }
        compute_logits()
        var mx_p = (L[0] as f64)/100000000.0; var k = 1
        while k < 16 { let v=(L[k] as f64)/100000000.0; if v > mx_p { mx_p = v }; k=k+1 }
        var se_p = 0.0; k = 0
        while k < 16 { se_p = se_p + exp_q((L[k] as f64)/100000000.0 - mx_p); k=k+1 }
        let prob_tgt_p = exp_q((L[PROBE_LABEL] as f64)/100000000.0 - mx_p) / se_p
        var loss_p = 0.0 - prob_tgt_p
        if loss_p > 0.0 - 0.0001 { loss_p = 0.0 - 0.0001 }

        // Backward perturb
        ws(80+i, orig - eps)
        d = 0; while d < 8 { H[d] = 0; d = d + 1 }
        t = 0; while t < 4 { model_fwd(PROBE_TOKENS[t], is_oct); t = t + 1 }
        compute_logits()
        var mx_m = (L[0] as f64)/100000000.0; k = 1
        while k < 16 { let v=(L[k] as f64)/100000000.0; if v > mx_m { mx_m = v }; k=k+1 }
        var se_m = 0.0; k = 0
        while k < 16 { se_m = se_m + exp_q((L[k] as f64)/100000000.0 - mx_m); k=k+1 }
        let prob_tgt_m = exp_q((L[PROBE_LABEL] as f64)/100000000.0 - mx_m) / se_m
        var loss_m = 0.0 - prob_tgt_m
        if loss_m > 0.0 - 0.0001 { loss_m = 0.0 - 0.0001 }

        DA[i] = (loss_p - loss_m) / (2.0 * eps)
        ws(80+i, orig)  // restore
        i = i + 1
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// L-BFGS on 8 A-params
// ═══════════════════════════════════════════════════════════════════════════
// m=5 history, two-loop recursion, no line search (fixed step)

var LBFGS_S: [f64; 40] = [0.0; 40]    // 5 × 8: parameter differences
var LBFGS_Y: [f64; 40] = [0.0; 40]    // 5 × 8: gradient differences
var LBFGS_RHO: [f64; 5] = [0.0; 5]    // 1/dot(s,y)
var LBFGS_ALPHA: [f64; 5] = [0.0; 5]  // workspace
var LBFGS_N: i64 = 0                   // stored pairs (0..5)
var LBFGS_OLD_A: [f64; 8] = [0.0; 8]  // previous A params
var LBFGS_OLD_G: [f64; 8] = [0.0; 8]  // previous gradient
var LBFGS_DIR: [f64; 8] = [0.0; 8]    // search direction

fn lbfgs_store_current() with Mut, Div {
    var i = 0
    while i < 8 { LBFGS_OLD_A[i] = wg(80+i); LBFGS_OLD_G[i] = DA[i]; i = i + 1 }
}

fn lbfgs_update_history() with Mut, Div {
    // Compute s = A_new - A_old, y = g_new - g_old
    let slot = LBFGS_N % 5
    var sy = 0.0
    var i = 0
    while i < 8 {
        let s = wg(80+i) - LBFGS_OLD_A[i]
        let y = DA[i] - LBFGS_OLD_G[i]
        LBFGS_S[slot*8+i] = s
        LBFGS_Y[slot*8+i] = y
        sy = sy + s*y
        i = i + 1
    }
    if sy > 0.0000001 {
        LBFGS_RHO[slot] = 1.0 / sy
        if LBFGS_N < 5 { LBFGS_N = LBFGS_N + 1 }
    }
}

fn lbfgs_two_loop() with Mut, Div {
    // Initialize direction with negative gradient
    var i = 0
    while i < 8 { LBFGS_DIR[i] = DA[i]; i = i + 1 }

    // First loop (backward)
    var k = LBFGS_N - 1
    while k >= 0 {
        let slot = k % 5
        var dot = 0.0
        i = 0
        while i < 8 { dot = dot + LBFGS_S[slot*8+i]*LBFGS_DIR[i]; i = i + 1 }
        LBFGS_ALPHA[slot] = LBFGS_RHO[slot] * dot
        i = 0
        while i < 8 { LBFGS_DIR[i] = LBFGS_DIR[i] - LBFGS_ALPHA[slot]*LBFGS_Y[slot*8+i]; i = i + 1 }
        k = k - 1
    }

    // Scale by gamma = s'y / y'y (latest pair)
    if LBFGS_N > 0 {
        let latest = (LBFGS_N - 1) % 5
        var yy = 0.0; var sy = 0.0
        i = 0
        while i < 8 {
            yy = yy + LBFGS_Y[latest*8+i]*LBFGS_Y[latest*8+i]
            sy = sy + LBFGS_S[latest*8+i]*LBFGS_Y[latest*8+i]
            i = i + 1
        }
        var gamma = 1.0
        if yy > 0.0000001 { gamma = sy / yy }
        if gamma > 10.0 { gamma = 10.0 }
        if gamma < 0.01 { gamma = 0.01 }
        i = 0
        while i < 8 { LBFGS_DIR[i] = LBFGS_DIR[i] * gamma; i = i + 1 }
    }

    // Second loop (forward)
    k = 0
    while k < LBFGS_N {
        let slot = k % 5
        var dot = 0.0
        i = 0
        while i < 8 { dot = dot + LBFGS_Y[slot*8+i]*LBFGS_DIR[i]; i = i + 1 }
        let beta = LBFGS_RHO[slot] * dot
        i = 0
        while i < 8 { LBFGS_DIR[i] = LBFGS_DIR[i] + (LBFGS_ALPHA[slot]-beta)*LBFGS_S[slot*8+i]; i = i + 1 }
        k = k + 1
    }

    // Negate for descent
    i = 0
    while i < 8 { LBFGS_DIR[i] = 0.0 - LBFGS_DIR[i]; i = i + 1 }
}

fn lbfgs_step(lr: f64) with Mut, Div {
    var i = 0
    while i < 8 {
        ws(80+i, wg(80+i) + lr*LBFGS_DIR[i])
        i = i + 1
    }
}

fn lbfgs_reset() with Mut {
    LBFGS_N = 0
    var i = 0
    while i < 40 { LBFGS_S[i] = 0.0; LBFGS_Y[i] = 0.0; i = i + 1 }
}

// ═══════════════════════════════════════════════════════════════════════════
// Training Loop
// ═══════════════════════════════════════════════════════════════════════════

fn train_model(is_oct: i64, use_lbfgs: i64) with IO, Mut, Div, Panic {
    let n_train = 300

    // Phase 1: Output-only warmup (30 epochs)
    var ep = 0
    while ep < 30 {
        var s = 0
        while s < n_train {
            generate_assoc_probe()
            var d = 0; while d < 8 { H[d] = 0; d = d + 1 }
            var t = 0
            while t < 4 { model_fwd(PROBE_TOKENS[t], is_oct); t = t + 1 }
            compute_logits()
            update_output(PROBE_LABEL, 0.01)
            s = s + 1
        }
        ep = ep + 1
    }

    // Phase 2: Full optimization of A (80 epochs)
    lbfgs_reset()
    ep = 0
    while ep < 80 {
        // Accumulate A gradient over batch of 50 samples
        var bi = 0
        while bi < 8 { DA[bi] = 0.0; bi = bi + 1 }

        var batch_count = 0
        var s = 0
        while s < n_train {
            generate_assoc_probe()
            var d = 0; while d < 8 { H[d] = 0; d = d + 1 }
            var t = 0
            while t < 4 { model_fwd(PROBE_TOKENS[t], is_oct); t = t + 1 }
            compute_logits()

            // Update output layer (always SGD)
            update_output(PROBE_LABEL, 0.005)

            // Accumulate A gradient via numerical diff every 50 samples
            batch_count = batch_count + 1
            if batch_count == 50 {
                compute_dA_numerical(is_oct)

                if use_lbfgs == 1 {
                    // L-BFGS step on A
                    lbfgs_store_current()
                    lbfgs_two_loop()
                    lbfgs_step(0.001)
                    if is_oct == 1 { renormalize_A_oct() } else { renormalize_A_quat() }
                    lbfgs_update_history()
                } else {
                    // SGD step on A
                    bi = 0
                    while bi < 8 {
                        var g = DA[bi]
                        if g > 0.5 { g = 0.5 } if g < 0.0 - 0.5 { g = 0.0 - 0.5 }
                        ws(80+bi, wg(80+bi) - 0.001 * g)
                        bi = bi + 1
                    }
                    if is_oct == 1 { renormalize_A_oct() } else { renormalize_A_quat() }
                }
                batch_count = 0
            }
            s = s + 1
        }
        ep = ep + 1
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Evaluation
// ═══════════════════════════════════════════════════════════════════════════

var EVAL_OV: i64 = 0; var EVAL_AC: i64 = 0; var EVAL_AT: i64 = 0
var EVAL_NC: i64 = 0; var EVAL_NT: i64 = 0; var EVAL_ASSOC_SUM: f64 = 0.0

fn eval_model(is_oct: i64) with IO, Mut, Div, Panic {
    rng_seed(99999, 11111)
    EVAL_OV=0; EVAL_AC=0; EVAL_AT=0; EVAL_NC=0; EVAL_NT=0; EVAL_ASSOC_SUM=0.0
    var s = 0
    while s < 1000 {
        generate_assoc_probe()
        var d = 0; while d < 8 { H[d] = 0; d = d + 1 }
        var t = 0
        while t < 4 { model_fwd(PROBE_TOKENS[t], is_oct); t = t + 1 }
        EVAL_ASSOC_SUM = EVAL_ASSOC_SUM + ASSOC_NORM
        compute_logits()
        let pred = get_pred()
        if pred == PROBE_LABEL { EVAL_OV = EVAL_OV + 1 }
        if PROBE_IS_ASSOC == 1 { EVAL_AT=EVAL_AT+1; if pred==PROBE_LABEL{EVAL_AC=EVAL_AC+1} }
        else { EVAL_NT=EVAL_NT+1; if pred==PROBE_LABEL{EVAL_NC=EVAL_NC+1} }
        s = s + 1
    }
}

fn print_result() with IO, Mut, Div {
    let ov=(EVAL_OV as f64)/1000.0*100.0
    var ap=0.0; if EVAL_AT>0{ap=(EVAL_AC as f64)/(EVAL_AT as f64)*100.0}
    var np=0.0; if EVAL_NT>0{np=(EVAL_NC as f64)/(EVAL_NT as f64)*100.0}
    let mean_assoc = EVAL_ASSOC_SUM / 1000.0
    print(ov); print("%    "); print(ap); print("%   "); print(np); print("%   ")
    print(mean_assoc); print("\n")
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("═══════════════════════════════════════════════════════════════\n")
    print("  O-FSSM: Second-Order Optimization on Non-Assoc Landscapes\n")
    print("═══════════════════════════════════════════════════════════════\n\n")
    print("  Architecture: h' = (A⊗h)⊗x, A = unit octonion/quaternion\n")
    print("  L-BFGS on 8 A-params (curvature-aware), SGD on output\n")
    print("  Phase 1: 30ep output-only warmup\n")
    print("  Phase 2: 80ep full optimization, batch=50 for grad estimate\n")
    print("  300 samples/epoch, 1000 eval samples\n\n")

    // Store results
    var res_ov: [i64; 4] = [0; 4]
    var res_ac: [i64; 4] = [0; 4]; var res_at: [i64; 4] = [0; 4]
    var res_nc: [i64; 4] = [0; 4]; var res_nt: [i64; 4] = [0; 4]
    var res_assoc: [f64; 4] = [0.0; 4]

    // Model 0: O-SSM + L-BFGS
    print("  [0] O-SSM + L-BFGS (non-assoc + 2nd order)...\n")
    rng_seed(55555,77777); init_embed_b_out(); init_A_oct()
    rng_seed(12345,67890); train_model(1, 1); eval_model(1)
    res_ov[0]=EVAL_OV; res_ac[0]=EVAL_AC; res_at[0]=EVAL_AT
    res_nc[0]=EVAL_NC; res_nt[0]=EVAL_NT; res_assoc[0]=EVAL_ASSOC_SUM/1000.0

    // Model 1: O-SSM + SGD
    print("  [1] O-SSM + SGD (non-assoc + 1st order)...\n")
    rng_seed(55555,77777); init_embed_b_out(); init_A_oct()
    rng_seed(12345,67890); train_model(1, 0); eval_model(1)
    res_ov[1]=EVAL_OV; res_ac[1]=EVAL_AC; res_at[1]=EVAL_AT
    res_nc[1]=EVAL_NC; res_nt[1]=EVAL_NT; res_assoc[1]=EVAL_ASSOC_SUM/1000.0

    // Model 2: H-SSM + L-BFGS
    print("  [2] H-SSM + L-BFGS (assoc + 2nd order)...\n")
    rng_seed(55555,77777); init_embed_b_out(); init_A_quat()
    rng_seed(12345,67890); train_model(0, 1); eval_model(0)
    res_ov[2]=EVAL_OV; res_ac[2]=EVAL_AC; res_at[2]=EVAL_AT
    res_nc[2]=EVAL_NC; res_nt[2]=EVAL_NT; res_assoc[2]=EVAL_ASSOC_SUM/1000.0

    // Model 3: H-SSM + SGD
    print("  [3] H-SSM + SGD (assoc + 1st order)...\n")
    rng_seed(55555,77777); init_embed_b_out(); init_A_quat()
    rng_seed(12345,67890); train_model(0, 0); eval_model(0)
    res_ov[3]=EVAL_OV; res_ac[3]=EVAL_AC; res_at[3]=EVAL_AT
    res_nc[3]=EVAL_NC; res_nt[3]=EVAL_NT; res_assoc[3]=EVAL_ASSOC_SUM/1000.0

    // Results
    print("\n═══════════════════════════════════════════════════════════════\n")
    print("  RESULTS: Associativity Probe — 2nd Order vs 1st Order\n")
    print("═══════════════════════════════════════════════════════════════\n\n")
    print("  Model          Optimizer  Overall  Assoc   Non-assoc  MeanAssocNorm\n")
    print("  ─────────────  ─────────  ───────  ──────  ─────────  ─────────────\n")

    print("  O-SSM          L-BFGS     ")
    EVAL_OV=res_ov[0];EVAL_AC=res_ac[0];EVAL_AT=res_at[0];EVAL_NC=res_nc[0];EVAL_NT=res_nt[0];EVAL_ASSOC_SUM=res_assoc[0]*1000.0
    print_result()

    print("  O-SSM          SGD        ")
    EVAL_OV=res_ov[1];EVAL_AC=res_ac[1];EVAL_AT=res_at[1];EVAL_NC=res_nc[1];EVAL_NT=res_nt[1];EVAL_ASSOC_SUM=res_assoc[1]*1000.0
    print_result()

    print("  H-SSM          L-BFGS     ")
    EVAL_OV=res_ov[2];EVAL_AC=res_ac[2];EVAL_AT=res_at[2];EVAL_NC=res_nc[2];EVAL_NT=res_nt[2];EVAL_ASSOC_SUM=res_assoc[2]*1000.0
    print_result()

    print("  H-SSM          SGD        ")
    EVAL_OV=res_ov[3];EVAL_AC=res_ac[3];EVAL_AT=res_at[3];EVAL_NC=res_nc[3];EVAL_NT=res_nt[3];EVAL_ASSOC_SUM=res_assoc[3]*1000.0
    print_result()

    print("  Random         —          6.25%\n")

    // Key comparisons
    var o_lbfgs_na = 0.0; if res_nt[0]>0{o_lbfgs_na=(res_nc[0] as f64)/(res_nt[0] as f64)*100.0}
    var o_sgd_na = 0.0; if res_nt[1]>0{o_sgd_na=(res_nc[1] as f64)/(res_nt[1] as f64)*100.0}
    var h_lbfgs_na = 0.0; if res_nt[2]>0{h_lbfgs_na=(res_nc[2] as f64)/(res_nt[2] as f64)*100.0}
    var h_sgd_na = 0.0; if res_nt[3]>0{h_sgd_na=(res_nc[3] as f64)/(res_nt[3] as f64)*100.0}

    print("\n  ═══ KEY COMPARISONS ═══\n\n")
    print("  Does L-BFGS help O-SSM on non-assoc?\n")
    print("    O-SSM+LBFGS: "); print(o_lbfgs_na); print("% vs O-SSM+SGD: "); print(o_sgd_na); print("%\n")
    let gap1 = o_lbfgs_na - o_sgd_na
    print("    Gap: "); if gap1>=0.0{print("+")}; print(gap1); print("pp\n")

    print("\n  Does non-assoc separate under L-BFGS?\n")
    print("    O-SSM+LBFGS: "); print(o_lbfgs_na); print("% vs H-SSM+LBFGS: "); print(h_lbfgs_na); print("%\n")
    let gap2 = o_lbfgs_na - h_lbfgs_na
    print("    Gap: "); if gap2>=0.0{print("+")}; print(gap2); print("pp\n")

    print("\n  Does L-BFGS help H-SSM equally?\n")
    print("    H-SSM+LBFGS: "); print(h_lbfgs_na); print("% vs H-SSM+SGD: "); print(h_sgd_na); print("%\n")
    let gap3 = h_lbfgs_na - h_sgd_na
    print("    Gap: "); if gap3>=0.0{print("+")}; print(gap3); print("pp\n")

    print("\n  ═══ VERDICT ═══\n")
    if gap1 > 3.0 {
        if gap2 > 3.0 {
            print("  ✓ L-BFGS unlocks non-associativity specifically for O-SSM\n")
            print("  → Second-order optimization IS the missing piece\n")
        } else {
            print("  ~ L-BFGS helps O-SSM but H-SSM equally → generic optimization benefit\n")
        }
    } else {
        print("  ✗ L-BFGS does not unlock non-associativity at this scale\n")
        if gap2 > 3.0 {
            print("  → But O-SSM separates from H-SSM → Cayley structure helps under L-BFGS\n")
        } else {
            print("  → Non-associativity remains invisible to both 1st and 2nd order\n")
        }
    }

    println("ALL PASS")
    0
}
