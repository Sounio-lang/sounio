//@ run-pass
//!
//! First Sounio semantic-authority executable for Operator Genome v3.
//! No v3 sign mask, output vector, digest, or frozen matcher predates this file.

use hardware::pireus::operator_genome::{
    PireusOperatorGenomeDigest,
    PIREUS_GENOME_OK,
    pireus_operator_genome_request,
    pireus_operator_genome_evaluate,
    pireus_operator_genome_matches_frozen_semantics,
    pireus_operator_genome_frozen_mismatch_code,
}

fn bit(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(digest: &PireusOperatorGenomeDigest) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(digest.words[word])
        word = word + 1
    }
}

fn print_hash(words: &[i64; 8]) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(words[word])
        word = word + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_operator_genome_request()
    let result = pireus_operator_genome_evaluate(&request)

    print("SOUNIO_AUTHORITY schema=pireus-operator-genome.v3")
    print(" role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE\n")

    print("PIREUS_GENOME_LINEAGE parent_live_match=")
    print_int(bit(result.lineage.parent_live_match))
    print(" parent_selected_match=")
    print_int(bit(result.lineage.parent_selected_match))
    print(" parent_receipt_scope_match=")
    print_int(bit(result.lineage.parent_receipt_scope_match))
    print(" complete="); print_int(bit(result.lineage.complete)); print("\n")

    print("PIREUS_GENOME_PARENT field=source value=")
    print_hash(&result.lineage.parent_source_sha256)
    print("\nPIREUS_GENOME_PARENT field=semantics value=")
    print_hash(&result.lineage.parent_semantics_sha256)
    print("\nPIREUS_GENOME_PARENT field=transcript value=")
    print_hash(&result.lineage.parent_transcript_sha256)
    print("\nPIREUS_GENOME_PARENT field=selected value=")
    print_hash(&result.lineage.parent_selected_sha256)
    print("\nPIREUS_GENOME_PARENT field=contract value=")
    print_hash(&result.lineage.parent_contract_sha256)
    print("\nPIREUS_GENOME_PARENT field=freeze value=")
    print_hash(&result.lineage.parent_freeze_sha256)
    print("\nPIREUS_GENOME_PARENT field=cd_sigma_source value=")
    print_hash(&result.lineage.cd_sigma_source_sha256)
    print("\n")

    print("PIREUS_GENOME_GENOTYPE bits=")
    print_int(result.genotype.bits)
    print(" dimension="); print_int(result.genotype.dimension)
    print(" class="); print_int(result.genotype.class_id)
    print(" quadratic_code="); print_int(result.genotype.quadratic_code)
    print(" matrix="); print_int(result.genotype.packed_matrix)
    print(" base_range_checks=")
    print_int(result.genotype.base_range_checks)
    print(" base_range_failures=")
    print_int(result.genotype.base_range_failures)
    print(" negatives="); print_int(result.genotype.negative_count)
    print(" negative_recount=")
    print_int(result.genotype.negative_recount)
    print(" negative_recount_failures=")
    print_int(result.genotype.negative_recount_failures)
    print(" complete="); print_int(bit(result.genotype.complete)); print("\n")

    var row: i64 = 0
    while row < 4 {
        print("PIREUS_GENOME_MATRIX_ROW row="); print_int(row)
        print(" value="); print_int(result.genotype.matrix_rows[row])
        print("\n")
        row = row + 1
    }

    var group: i64 = 0
    while group < result.microprogram.group_count {
        print("PIREUS_GENOME_GROUP index="); print_int(group)
        print(" displacement=")
        print_int(result.microprogram.group_displacements[group])
        print(" source_chunk=")
        print_int(result.microprogram.group_source_chunks[group])
        print(" rhs_chunk=")
        print_int(result.microprogram.group_rhs_chunks[group])
        print(" negative_mask=")
        print_int(result.microprogram.group_negative_masks[group])
        print(" first_ordinal=")
        print_int(result.microprogram.group_first_ordinals[group])
        print(" last_ordinal=")
        print_int(result.microprogram.group_last_ordinals[group])
        print(" cross_chunk=")
        print_int(bit(result.microprogram.group_cross_chunk[group]))
        print("\n")
        group = group + 1
    }

    print("PIREUS_GENOME_MICROPROGRAM cells=")
    print_int(result.microprogram.cell_count)
    print(" groups="); print_int(result.microprogram.group_count)
    print(" same_chunk_groups=")
    print_int(result.microprogram.same_chunk_groups)
    print(" cross_chunk_groups=")
    print_int(result.microprogram.cross_chunk_groups)
    print(" permutation_checks=")
    print_int(result.microprogram.partner_permutation_checks)
    print(" permutation_failures=")
    print_int(result.microprogram.partner_permutation_failures)
    print(" coverage_checks=")
    print_int(result.microprogram.coverage_checks)
    print(" coverage_failures=")
    print_int(result.microprogram.coverage_failures)
    print(" complete=")
    print_int(bit(result.microprogram.complete)); print("\n")

    var lane: i64 = 0
    while lane < result.genotype.dimension {
        print("PIREUS_GENOME_FIXTURE lane="); print_int(lane)
        print(" lhs_bits="); print_int(f64_to_bits(result.evaluation.lhs[lane]))
        print(" rhs_bits="); print_int(f64_to_bits(result.evaluation.rhs[lane]))
        print(" direct_bits=")
        print_int(result.evaluation.direct_output_bits[lane])
        print(" microprogram_bits=")
        print_int(result.evaluation.microprogram_output_bits[lane])
        print("\n")
        lane = lane + 1
    }

    print("PIREUS_GENOME_EVALUATION checks=")
    print_int(result.evaluation.output_checks)
    print(" failures="); print_int(result.evaluation.output_failures)
    print(" fixture_bit_exact=")
    print_int(bit(result.evaluation.fixture_bit_exact)); print("\n")

    var target: i64 = 0
    while target < result.targets.target_count {
        print("PIREUS_GENOME_TARGET index="); print_int(target)
        print(" target="); print_int(result.targets.target_ids[target])
        print(" canonical="); print_int(bit(result.targets.canonical[target]))
        print(" observed="); print_int(bit(result.targets.observed[target]))
        print(" obligations=")
        print_int(result.targets.obligation_counts[target])
        print(" discharged=")
        print_int(result.targets.discharged_counts[target])
        print(" material_receipts=")
        print_int(result.targets.material_receipt_counts[target])
        print(" lowerings="); print_int(result.targets.lowering_counts[target])
        print(" costs="); print_int(result.targets.cost_record_counts[target])
        print(" strict_order=")
        print_int(bit(result.targets.strict_order_required[target]))
        print("\n")
        target = target + 1
    }

    print("PIREUS_GENOME_U250 required_cards=")
    print_int(result.targets.u250_required_cards)
    print(" declared_engine_slots=")
    print_int(result.targets.u250_declared_engine_slots)
    print(" unresolved_obligations=")
    print_int(result.targets.unresolved_obligations)
    print("\n")

    print("PIREUS_GENOME_RECEIPT parent_bound=")
    print_int(bit(result.receipt.parent_lineage_bound))
    print(" genotype_derived=")
    print_int(bit(result.receipt.genotype_derived))
    print(" cells_complete=")
    print_int(bit(result.receipt.canonical_cells_complete))
    print(" groups_complete=")
    print_int(bit(result.receipt.comparison_groups_complete))
    print(" fixture_evaluators_agree=")
    print_int(bit(result.receipt.fixture_evaluators_agree))
    print(" envelopes_emitted=")
    print_int(bit(result.receipt.target_envelopes_emitted))
    print(" hardware_semantics_mutation_absent=")
    print_int(bit(result.receipt.hardware_semantics_mutation_absent))
    print(" genome_derivation=")
    print_int(bit(result.receipt.executable_genome_derivation))
    print(" semantics_frozen=")
    print_int(bit(result.receipt.semantics_frozen))
    print(" parity_open=")
    print_int(bit(result.receipt.material_parity_open))
    print(" claim_ready="); print_int(bit(result.receipt.claim_ready))
    print("\n")

    print("PIREUS_GENOME_NEGATIVES passed=")
    print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")

    print("PIREUS_GENOME_DIGEST lineage=")
    print_digest(&result.lineage_digest)
    print(" genotype="); print_digest(&result.genotype_digest)
    print(" microprogram="); print_digest(&result.microprogram_digest)
    print(" groups="); print_digest(&result.group_digest)
    print(" evaluation="); print_digest(&result.evaluation_digest)
    print(" targets="); print_digest(&result.target_digest)
    print(" receipt="); print_digest(&result.receipt_digest)
    print(" genome="); print_digest(&result.genome_digest)
    print("\n")

    print("PIREUS_GENOME_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(result.failures)
    print(" frozen_match=")
    print_int(bit(pireus_operator_genome_matches_frozen_semantics(&result)))
    print(" frozen_mismatch_code=")
    print_int(pireus_operator_genome_frozen_mismatch_code(&result))
    print(" valid="); print_int(bit(result.valid)); print("\n")

    if result.valid && result.error == PIREUS_GENOME_OK &&
        result.failures == 0 &&
        pireus_operator_genome_matches_frozen_semantics(&result) {
        0
    } else { 1 }
}
