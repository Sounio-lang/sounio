// kretikos: profile=vec_div_f32
//
// Real-source Kretikos division witness. The runtime profile validates
// numerator / denominator on the GPU through the owned affine elementwise CUBIN rung.

kernel fn vec_div_f32(n: i64) with GPU, Panic {
    let tid = gpu_thread_id_x()
    let bid = gpu_block_id_x()
    let bdim = gpu_block_dim_x()
    let i = bid * bdim + tid
    if i < n {
        gpu_sync_threads()
    }
}

fn main() -> i32 with IO {
    0
}
