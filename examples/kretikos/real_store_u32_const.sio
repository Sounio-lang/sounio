// kretikos: profile=store_u32_const
//
// Real-source Kretikos store witness. The Sounio source is checked before the
// profile selects the owned CUBIN runtime rung that writes 42 to device memory.

kernel fn store_u32_const(n: i64) with GPU, Panic {
    let tid = gpu_thread_id_x()
    if tid < n {
        gpu_sync_threads()
    }
}

fn main() -> i32 with IO {
    0
}
