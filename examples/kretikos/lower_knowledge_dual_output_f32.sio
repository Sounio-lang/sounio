// K-AXI Knowledge<f32> source-lowering witness.
//
// No kretikos profile directive is allowed in this file. The lowerer must
// recognize first-class Knowledge<f32> inputs, extract .value under the
// Epistemic effect, and propagate .epsilon into the uncertainty output lane.
// This deliberately uses scalar Knowledge inputs. The active checker does not
// yet preserve Knowledge<T> through indexed array element access.

kernel fn lower_knowledge_dual_output_f32(
    a: Knowledge<f32>,
    b: Knowledge<f32>,
    out: &![f32; 32],
    out_u: &![f32; 32],
    n: i64
) with GPU, Panic, Div, Epistemic {
    let tid = gpu_thread_id_x()
    let bid = gpu_block_id_x()
    let bdim = gpu_block_dim_x()
    let i = bid * bdim + tid
    if i < n {
        let av = a.value
        let bv = b.value
        let au = a.epsilon as f32
        let bu = b.epsilon as f32
        (*out)[i] = av + bv
        (*out_u)[i] = (au * au) + (bu * bu)
    }
}

fn main() -> i32 with IO {
    0
}
