// K-AXI source-lowering witness.
//
// No kretikos profile directive is allowed in this file. The lowerer must
// recognize the indexed f32 vector-add shape from checked Sounio source.

kernel fn lower_vec_add_f32(
    a: &[f32; 32],
    b: &[f32; 32],
    out: &![f32; 32],
    n: i64
) with GPU, Panic, Div {
    let tid = gpu_thread_id_x()
    let bid = gpu_block_id_x()
    let bdim = gpu_block_dim_x()
    let i = bid * bdim + tid
    if i < n {
        (*out)[i] = (*a)[i] + (*b)[i]
    }
}

fn main() -> i32 with IO {
    0
}
