// kretikos: profile=vec_mul_f64
//
// Runtime-backed Kretikos source witness for f64 vector multiplication.
// The CUDA Driver API gate checks owned CUBIN execution against a double oracle.

kernel fn vec_mul_f64(n: i64) with GPU, Panic {
    let tid = gpu_thread_id_x()
    let bid = gpu_block_id_x()
    let bdim = gpu_block_dim_x()
    let i = bid * bdim + tid
    if i < n {
        gpu_sync_threads()
    }
}

fn main() -> i32 with IO {
    0
}
