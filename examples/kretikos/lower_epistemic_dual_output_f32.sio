// K-AXI source-lowering witness.
//
// No kretikos profile directive is allowed in this file. The lowerer must
// recognize coupled f32 value and uncertainty lanes from checked source.

kernel fn lower_epistemic_dual_output_f32(
    a: &[f32; 32],
    b: &[f32; 32],
    ua: &[f32; 32],
    ub: &[f32; 32],
    out: &![f32; 32],
    out_u: &![f32; 32],
    n: i64
) with GPU, Panic, Div {
    let tid = gpu_thread_id_x()
    let bid = gpu_block_id_x()
    let bdim = gpu_block_dim_x()
    let i = bid * bdim + tid
    if i < n {
        (*out)[i] = (*a)[i] + (*b)[i]
        (*out_u)[i] = ((*ua)[i] * (*ua)[i]) + ((*ub)[i] * (*ub)[i])
    }
}

fn main() -> i32 with IO {
    0
}
