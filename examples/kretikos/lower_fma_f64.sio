// K-AXI source-lowering witness — f64 affine multiply-add.
//
// No kretikos profile directive is allowed in this file. The lowerer must
// recognize the indexed f64 affine multiply-add shape from checked source.
//
// Typed K-AXI: load_global/mul/add/store_global carry type=f64 metadata so the
// transpiler emits ld.global.f64 / mul.f64 / add.f64 / st.global.f64 PTX.

kernel fn lower_fma_f64(
    a: &[f64; 32],
    b: &[f64; 32],
    c: &[f64; 32],
    out: &![f64; 32],
    n: i64
) with GPU, Panic, Div {
    let tid = gpu_thread_id_x()
    let bid = gpu_block_id_x()
    let bdim = gpu_block_dim_x()
    let i = bid * bdim + tid
    if i < n {
        (*out)[i] = ((*a)[i] * (*b)[i]) + (*c)[i]
    }
}

fn main() -> i32 with IO {
    0
}
