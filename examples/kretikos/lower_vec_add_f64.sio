// K-AXI source-lowering witness — f64 scalar vector add.
//
// No kretikos profile directive is allowed in this file. The lowerer must
// recognize the indexed f64 vector-add shape from checked Sounio source.
//
// Typed K-AXI: load_global/add/store_global carry type=f64 metadata so the
// transpiler emits ld.global.f64 / add.f64 / st.global.f64 PTX instructions.

kernel fn lower_vec_add_f64(
    a: &[f64; 32],
    b: &[f64; 32],
    out: &![f64; 32],
    n: i64
) with GPU, Panic, Div {
    let tid = gpu_thread_id_x()
    let bid = gpu_block_id_x()
    let bdim = gpu_block_dim_x()
    let i = bid * bdim + tid
    if i < n {
        (*out)[i] = (*a)[i] + (*b)[i]
    }
}

fn main() -> i32 with IO {
    0
}
