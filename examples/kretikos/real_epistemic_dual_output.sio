// kretikos: profile=epistemic_dual_output_f32
//
// Real-source Kretikos dual-output witness. The runtime profile validates a
// single kernel launch with separate value and uncertainty output buffers.

kernel fn epistemic_dual_output_f32(n: i64) with GPU, Panic {
    let tid = gpu_thread_id_x()
    let bid = gpu_block_id_x()
    let bdim = gpu_block_dim_x()
    let i = bid * bdim + tid
    if i < n {
        gpu_sync_threads()
    }
}

fn main() -> i32 with IO {
    0
}
