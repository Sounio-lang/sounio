// kretikos: profile=vec_add_f32
//
// Minimal real-source Kretikos lane.
//
// This file is checked by Sounio first. Kretikos then maps the accepted source
// profile to its owned NVIDIA CUBIN runtime rung and validates the CUDA output
// against the loader oracle.

kernel fn vec_add_f32(n: i64) with GPU, Panic {
    let tid = gpu_thread_id_x()
    let bid = gpu_block_id_x()
    let bdim = gpu_block_dim_x()
    let i = bid * bdim + tid
    if i < n {
        gpu_sync_threads()
    }
}

fn main() -> i32 with IO {
    0
}
