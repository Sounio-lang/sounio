// kretikos: profile=vec_sub_f32
//
// Structural-only Kretikos source witness for f32 vector subtraction.
// This reaches the PTX front door but has no owned CUBIN/runtime rung yet.

kernel fn vec_sub_f32(n: i64) with GPU, Panic {
    let tid = gpu_thread_id_x()
    let bid = gpu_block_id_x()
    let bdim = gpu_block_dim_x()
    let i = bid * bdim + tid
    if i < n {
        gpu_sync_threads()
    }
}

fn main() -> i32 with IO {
    0
}
