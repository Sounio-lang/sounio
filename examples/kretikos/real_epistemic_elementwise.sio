// kretikos: profile=epistemic_elementwise_f32
//
// Real-source Kretikos epistemic elementwise witness. The runtime profile
// verifies x + y * (1 + epsilon) with a nonzero epsilon lane on the GPU.

kernel fn epistemic_vec_add_f32(n: i64) with GPU, Panic {
    let tid = gpu_thread_id_x()
    let bid = gpu_block_id_x()
    let bdim = gpu_block_dim_x()
    let i = bid * bdim + tid
    if i < n {
        gpu_sync_threads()
    }
}

fn main() -> i32 with IO {
    0
}
