//@ run-pass
//!
//! First Sounio-executable Pireus witness.
//!
//! The catalog is deliberately synthetic. This program establishes ontology
//! vocabulary, exact matching, and negative-query behavior. It does not assert
//! a real processor instruction or material cost.

use hardware::pireus::model::{
    pireus_v0_store, pireus_query_permutation, pireus_result_contains,
    PIREUS_LITERAL_1, PIREUS_LITERAL_2,
    PIREUS_LITERAL_8, PIREUS_LITERAL_16, PIREUS_LITERAL_64,
    PIREUS_CAP_SYNTHETIC_F64X8_ONE_SOURCE,
    PIREUS_CAP_SYNTHETIC_F64X8_TWO_SOURCE,
}
use ontology::query::{triple_store_count, sparql_result_count}

fn bool_as_i64(value: bool) -> i64 {
    if value { 1 } else { 0 }
}

fn main() -> i32 with IO, Mut, Panic, Epistemic {
    print("SOUNIO_AUTHORITY schema=pireus-material-ontology.v0")
    print(" role=SEMANTIC_AUTHORITY\n")

    var failures: i64 = 0
    var store = pireus_v0_store()
    let triples = triple_store_count(&store)
    if triples != 25 { failures = failures + 1 }

    let one_source = pireus_query_permutation(
        &store,
        PIREUS_LITERAL_64, 64.0,
        PIREUS_LITERAL_8, 8.0,
        PIREUS_LITERAL_1, 1.0,
    )
    let one_source_matches = sparql_result_count(&one_source)
    let expected_present = pireus_result_contains(
        &one_source, PIREUS_CAP_SYNTHETIC_F64X8_ONE_SOURCE)
    let two_source_false_positive = pireus_result_contains(
        &one_source, PIREUS_CAP_SYNTHETIC_F64X8_TWO_SOURCE)
    if one_source_matches != 1 { failures = failures + 1 }
    if !expected_present { failures = failures + 1 }
    if two_source_false_positive { failures = failures + 1 }

    let two_source = pireus_query_permutation(
        &store,
        PIREUS_LITERAL_64, 64.0,
        PIREUS_LITERAL_8, 8.0,
        PIREUS_LITERAL_2, 2.0,
    )
    let two_source_matches = sparql_result_count(&two_source)
    let two_source_control_present = pireus_result_contains(
        &two_source, PIREUS_CAP_SYNTHETIC_F64X8_TWO_SOURCE)
    if two_source_matches != 1 { failures = failures + 1 }
    if !two_source_control_present { failures = failures + 1 }

    let unsupported_lanes = pireus_query_permutation(
        &store,
        PIREUS_LITERAL_64, 64.0,
        PIREUS_LITERAL_16, 16.0,
        PIREUS_LITERAL_1, 1.0,
    )
    let unsupported_lane_matches = sparql_result_count(&unsupported_lanes)
    if unsupported_lane_matches != 0 { failures = failures + 1 }

    print("PIREUS_SUBSTRATE triple_store=1 sparql_like_query=1")
    print(" triples="); print_int(triples); print("\n")
    print("PIREUS_CATALOG capabilities=2 synthetic_capabilities=2")
    print(" real_material_capabilities=0\n")
    print("PIREUS_QUERY element_bits=64 lanes=8 sources=1 matches=")
    print_int(one_source_matches)
    print(" expected_present="); print_int(bool_as_i64(expected_present))
    print(" two_source_false_positive=")
    print_int(bool_as_i64(two_source_false_positive)); print("\n")
    print("PIREUS_CONTROL element_bits=64 lanes=8 sources=2 matches=")
    print_int(two_source_matches)
    print(" expected_present=")
    print_int(bool_as_i64(two_source_control_present)); print("\n")
    print("PIREUS_NEGATIVE element_bits=64 lanes=16 sources=1 matches=")
    print_int(unsupported_lane_matches); print("\n")
    print("PIREUS_V0_SUMMARY failures="); print_int(failures); print("\n")

    if failures == 0 { 0 } else { 1 }
}
