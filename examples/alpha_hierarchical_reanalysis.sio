//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// Exp 3: Subject-stratified mixed-effects re-analysis of α
// ═══════════════════════════════════════════════════════════════════════════
//
// Data: 7 CHB-MIT subjects. Metric: h_sep = ||h_II − h_IC|| (S-SSM, α sweep).
// Generated by scripts/research/alpha_hierarchical_analysis.py.
//
// ── What Door III claimed ─────────────────────────────────────────────────
//   α=0.20 is the interior population optimum (from MSE ratio on chb03).
//
// ── What this analysis finds ─────────────────────────────────────────────
//   Individual optima (α* = argmax_α h_sep per subject):
//     chb01: α*=0.05  chb02: α*=0.05  chb03: α*=0.50
//     chb05: α*=0.30  chb06: α*=0.80  chb08: α*=0.80  chb11: α*=0.80
//
//   Population model:  α*_i ~ Normal(μ, σ²)  (hierarchical random slopes)
//   Posterior (conjugate):  μ̂=0.471  σ̂=0.344  95% CI=[0.153, 0.789]
//   P(μ ∈ [0.18, 0.22]) = 0.0175   (α=0.20 is unlikely as population mean)
//
//   ZERO subjects have α*=0.20 as their individual optimum.
//   SD of individual optima: 0.344 — strongly heterogeneous.
//
// ── Corrections required ──────────────────────────────────────────────────
//   1. "α=0.20 is the population optimum" → RETRACT.
//      The MSE ratio and h_sep disagree on chb03 itself (h_sep peaks at 0.50).
//      The pooled h_sep optimum is 0.80, not 0.20.
//   2. "α should be fixed at 0.20" → REPLACE with: α is patient-specific.
//      Deploy with per-subject α tuning or treat as a nuisance parameter.
//   3. The individual landscape is BIMODAL:
//      - Small-α group (chb01, chb02): flat landscape, α ≤ 0.05 marginally best
//      - Large-α group (chb06, chb08, chb11): monotone increasing, α=0.80 best
//      - Medium-α (chb03, chb05): interior peaks at 0.50 / 0.30
//      This bimodality may reflect seizure type, not model sensitivity.

// ─── Per-subject h_sep data ───────────────────────────────────────────────
// Columns: hsep at α = 0.05, 0.10, 0.15, 0.20, 0.30, 0.50, 0.80
// Row 0=chb01, 1=chb02, 2=chb03, 3=chb05, 4=chb06, 5=chb08, 6=chb11

var HSEP: [f64; 49] = [0.0; 49]   // 7 subjects × 7 alpha values
var ALPHA_OPT: [f64; 7] = [0.0; 7]  // per-subject argmax alpha

fn load_data() with Mut {
    // chb01: α*=0.05
    HSEP[ 0]=0.820472; HSEP[ 1]=0.816917; HSEP[ 2]=0.815108; HSEP[ 3]=0.812488
    HSEP[ 4]=0.807370; HSEP[ 5]=0.802019; HSEP[ 6]=0.805869; ALPHA_OPT[0]=0.05
    // chb02: α*=0.05
    HSEP[ 7]=1.702882; HSEP[ 8]=1.700701; HSEP[ 9]=1.698779; HSEP[10]=1.696424
    HSEP[11]=1.691476; HSEP[12]=1.678100; HSEP[13]=1.651059; ALPHA_OPT[1]=0.05
    // chb03: α*=0.50
    HSEP[14]=1.603014; HSEP[15]=1.604791; HSEP[16]=1.607694; HSEP[17]=1.610464
    HSEP[18]=1.615465; HSEP[19]=1.617297; HSEP[20]=1.589930; ALPHA_OPT[2]=0.50
    // chb05: α*=0.30
    HSEP[21]=1.122578; HSEP[22]=1.124616; HSEP[23]=1.126655; HSEP[24]=1.128780
    HSEP[25]=1.130373; HSEP[26]=1.127416; HSEP[27]=1.116726; ALPHA_OPT[3]=0.30
    // chb06: α*=0.80
    HSEP[28]=1.155042; HSEP[29]=1.160042; HSEP[30]=1.166196; HSEP[31]=1.171474
    HSEP[32]=1.183267; HSEP[33]=1.205307; HSEP[34]=1.230201; ALPHA_OPT[4]=0.80
    // chb08: α*=0.80
    HSEP[35]=1.257010; HSEP[36]=1.259680; HSEP[37]=1.262739; HSEP[38]=1.267185
    HSEP[39]=1.273825; HSEP[40]=1.287768; HSEP[41]=1.307684; ALPHA_OPT[5]=0.80
    // chb11: α*=0.80
    HSEP[42]=1.388290; HSEP[43]=1.389239; HSEP[44]=1.391759; HSEP[45]=1.394272
    HSEP[46]=1.399869; HSEP[47]=1.417103; HSEP[48]=1.456891; ALPHA_OPT[6]=0.80
}

// Alpha grid values
fn alpha_at(j: i64) -> f64 {
    if j==0 { 0.05 } else if j==1 { 0.10 } else if j==2 { 0.15 }
    else if j==3 { 0.20 } else if j==4 { 0.30 } else if j==5 { 0.50 }
    else { 0.80 }
}

// Posterior statistics (from generator output)
fn MU_HAT()       -> f64 { 0.4714 }
fn SIGMA_HAT()    -> f64 { 0.3438 }
fn CI_LO()        -> f64 { 0.1534 }
fn CI_HI()        -> f64 { 0.7894 }
fn P_AT_020()     -> f64 { 0.0175 }   // P(μ ∈ [0.18,0.22])

// ─── Math helpers ─────────────────────────────────────────────────────────

fn abs_f(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn print_i(v: i64) with IO, Mut {
    if v < 0 { print("-"); print_i(0 - v); return }
    if v >= 10 { print_i(v / 10) }
    let d = v % 10
    if d==0{print("0")}if d==1{print("1")}if d==2{print("2")}if d==3{print("3")}
    if d==4{print("4")}if d==5{print("5")}if d==6{print("6")}if d==7{print("7")}
    if d==8{print("8")}if d==9{print("9")}
}

fn print_f3(v: f64) with IO, Mut, Div, Panic {
    if v < 0.0 { print("-"); print_f3(0.0 - v); return }
    let iv: i64 = v as i64
    print_i(iv); print(".")
    let d1: i64 = ((v - (iv as f64)) * 10.0) as i64
    let d2: i64 = ((v - (iv as f64)) * 100.0) as i64 % 10
    let d3: i64 = ((v - (iv as f64)) * 1000.0) as i64 % 10
    print_i(d1); print_i(d2); print_i(d3)
}

// ─── Assertions ───────────────────────────────────────────────────────────

fn main() with IO, Mut, Div, Panic {
    load_data()
    let N_SUBJ: i64 = 7

    print("=== Exp 3: Subject-stratified α re-analysis ===\n\n")

    // ── Print per-subject optimal α ───────────────────────────────────────
    print("Individual optima (α* = argmax h_sep):\n")
    let subj_names: [string; 7] = ["chb01","chb02","chb03","chb05","chb06","chb08","chb11"]
    var i: i64 = 0
    while i < N_SUBJ {
        print("  "); print(subj_names[i as usize])
        print(": α*="); print_f3(ALPHA_OPT[i as usize])
        print("\n")
        i = i + 1
    }

    // ── T1: No subject has α*=0.20 ────────────────────────────────────────
    print("\nT1 No subject has α*=0.20 (the Door III claim):\n")
    var n_at_020: i64 = 0
    i = 0
    while i < N_SUBJ {
        let diff = abs_f(ALPHA_OPT[i as usize] - 0.20)
        if diff < 0.001 { n_at_020 = n_at_020 + 1 }
        i = i + 1
    }
    print("  Subjects with α*=0.20: "); print_i(n_at_020); print("/7\n")
    assert(n_at_020 == 0)   // RETRACTION: α=0.20 is nobody's individual optimum

    // ── T2: Strong heterogeneity σ̂ > 0.25 ────────────────────────────────
    print("T2 Individual optima are heterogeneous (σ̂ > 0.25):\n")
    print("  σ̂ = "); print_f3(SIGMA_HAT()); print("\n")
    assert(SIGMA_HAT() > 0.25)   // heterogeneous — α is patient-specific

    // ── T3: Population mean μ̂ ≠ 0.20 ─────────────────────────────────────
    print("T3 Population mean μ̂ far from 0.20:\n")
    print("  μ̂ = "); print_f3(MU_HAT())
    print("  (claim was 0.20, diff="); print_f3(abs_f(MU_HAT() - 0.20)); print(")\n")
    assert(abs_f(MU_HAT() - 0.20) > 0.20)   // μ̂=0.471, more than 0.20 away

    // ── T4: P(μ ∈ [0.18,0.22]) is very small ─────────────────────────────
    print("T4 P(μ ∈ [0.18,0.22]) very small (Door III's claim region):\n")
    print("  P = "); print_f3(P_AT_020()); print("  (< 0.05)\n")
    assert(P_AT_020() < 0.05)   // Door III's specific claim poorly supported

    // ── T5: Bimodal structure — small-α and large-α clusters ─────────────
    // Count subjects with α* ≤ 0.15 (small group) and α* ≥ 0.50 (large group)
    print("T5 Bimodal distribution — two subgroups:\n")
    var n_small: i64 = 0   // chb01, chb02 (α*=0.05)
    var n_medium: i64 = 0  // chb03, chb05 (α*=0.30, 0.50)
    var n_large: i64 = 0   // chb06, chb08, chb11 (α*=0.80)
    i = 0
    while i < N_SUBJ {
        let a = ALPHA_OPT[i as usize]
        if a <= 0.15 { n_small = n_small + 1 }
        else if a <= 0.40 { n_medium = n_medium + 1 }
        else { n_large = n_large + 1 }
        i = i + 1
    }
    print("  Small-α (≤0.15):   "); print_i(n_small); print(" subjects (flat landscape)\n")
    print("  Medium-α (0.20-0.40): "); print_i(n_medium); print(" subjects\n")
    print("  Large-α (≥0.50):   "); print_i(n_large); print(" subjects (monotone rising)\n")
    // Two dominant clusters: small (2) and large (3), medium (2)
    assert(n_small >= 2)
    assert(n_large >= 3)
    // No single cluster dominates — heterogeneous landscape confirmed
    assert(n_small + n_medium + n_large == 7)

    // ── T6: 95% CI for μ includes 0.20 but barely ─────────────────────────
    print("T6 95% CI for μ: ["); print_f3(CI_LO()); print(", "); print_f3(CI_HI())
    print("]\n")
    print("  Includes 0.20: ")
    let ci_includes_020 = CI_LO() <= 0.20 && 0.20 <= CI_HI()
    if ci_includes_020 { print("yes (barely — tail of distribution)\n") }
    else { print("no\n") }
    // 0.20 is within the wide CI (σ̂=0.34 makes CI very wide)
    // but this does NOT mean 0.20 is a good individual prescription
    assert(ci_includes_020)   // consistent but not individually prescriptive

    // ── T7: Pooled optimum is NOT 0.20 ────────────────────────────────────
    // Pooled h_sep at each α (mean across subjects)
    print("T7 Pooled h_sep: ")
    var pooled: [f64; 7] = [0.0; 7]
    var j: i64 = 0
    while j < 7 {
        var sum: f64 = 0.0
        i = 0
        while i < N_SUBJ {
            sum = sum + HSEP[i * 7 + j]
            i = i + 1
        }
        pooled[j as usize] = sum / 7.0
        print_f3(pooled[j as usize]); print(" ")
        j = j + 1
    }
    print("\n")
    // Find pooled argmax
    var pooled_best_j: i64 = 0
    var pooled_best_v: f64 = pooled[0]
    j = 1
    while j < 7 {
        if pooled[j as usize] > pooled_best_v {
            pooled_best_v = pooled[j as usize]
            pooled_best_j = j
        }
        j = j + 1
    }
    let pooled_best_alpha = alpha_at(pooled_best_j)
    print("  Pooled optimal α: "); print_f3(pooled_best_alpha); print("\n")
    // Pooled optimum is 0.80 (driven by chb06/08/11), not 0.20
    assert(abs_f(pooled_best_alpha - 0.20) > 0.10)

    print("\n=== Corrections ===\n")
    print("1. RETRACT: alpha=0.20 as population optimum\n")
    print("   0/7 subjects have alpha*=0.20; pooled opt=0.80\n")
    print("2. REPLACE: alpha is patient-specific (sigma=0.344)\n")
    print("3. BIMODAL: small-alpha (flat) vs large-alpha (rising) subgroups\n")
    print("   May reflect seizure type — needs clinical stratification\n")
    print("4. Door III metric (MSE ratio) vs h_sep disagree on chb03 itself\n")
    print("   Future work: report both metrics, clarify which drives the claim\n")

    print("\nALL PASS\n")
}
