//@ run-pass
//!
//! Sounio authority projection of the admitted U250 into the Pireus graph.

use hardware::pireus::u250_material_ingestion::{
    pireus_u250_material_ingest_files,
}
use hardware::pireus::u250_execution_engine::{
    pireus_u250_execution_engine_request,
    pireus_u250_execution_engine_project,
    pireus_u250_execution_engine_matches_expected,
    pireus_u250_execution_engine_store,
    pireus_u250_query_observed_engines,
    pireus_u250_query_unresolved_slots,
    pireus_u250_query_memory_profiles,
    pireus_u250_query_blueprint_slots,
    pireus_u250_query_engine_isa,
    pireus_u250_query_engine_operations,
    pireus_u250_query_machine_bridge,
}
use ontology::query::{triple_store_count, sparql_result_count}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 2 {
        print("usage: pireus_u250_execution_engine <raw-probe> <receipt>\n")
        return 2
    }
    let parent = pireus_u250_material_ingest_files(get_arg(0), get_arg(1))
    let request = pireus_u250_execution_engine_request()
    let result = pireus_u250_execution_engine_project(&parent, &request)
    var store = pireus_u250_execution_engine_store(&result)
    let observed = pireus_u250_query_observed_engines(&store)
    let unresolved = pireus_u250_query_unresolved_slots(&store)
    let memory = pireus_u250_query_memory_profiles(&store)
    let slots = pireus_u250_query_blueprint_slots(&store)
    let isa = pireus_u250_query_engine_isa(&store)
    let operations = pireus_u250_query_engine_operations(&store)
    let bridge = pireus_u250_query_machine_bridge(&store)

    let triples = triple_store_count(&store)
    let observed_count = sparql_result_count(&observed)
    let unresolved_count = sparql_result_count(&unresolved)
    let memory_count = sparql_result_count(&memory)
    let slot_count = sparql_result_count(&slots)
    let isa_count = sparql_result_count(&isa)
    let operation_count = sparql_result_count(&operations)
    let bridge_count = sparql_result_count(&bridge)

    print("SOUNIO_SEMANTIC_AUTHORITY schema=pireus.u250-execution-engine.v0 stage=SOUNIO_EXECUTABLE\n")
    print("PIREUS_U250_EXECUTION_ENGINE valid=")
    print_int(yes(result.valid))
    print(" status="); print_int(result.status)
    print(" target="); print_int(result.target_family)
    print(" kind="); print_int(result.engine_kind)
    print(" fabric="); print_int(result.fabric)
    print(" interface="); print_int(result.interface)
    print(" declared="); print_int(result.declared_engine_count)
    print(" observed="); print_int(result.observed_engine_count)
    print(" unresolved="); print_int(result.unresolved_engine_count)
    print(" memory_profiles="); print_int(result.memory_profile_count)
    print(" operations="); print_int(result.operation_capability_count)
    print(" lowering_authorized="); print_int(yes(result.lowering_authorized))
    print(" parent_parity_open=")
    print_int(yes(result.parent_material_parity_open))
    print(" engine_parity_open=")
    print_int(yes(result.execution_engine_parity_open))
    print(" claim_ready="); print_int(yes(result.claim_ready))
    print(" failures="); print_int(result.failures)
    print("\n")
    print("PIREUS_U250_ENGINE_GRAPH triples="); print_int(triples)
    print(" slots="); print_int(slot_count)
    print(" observed="); print_int(observed_count)
    print(" unresolved="); print_int(unresolved_count)
    print(" memory_profiles="); print_int(memory_count)
    print(" isa_edges="); print_int(isa_count)
    print(" operation_edges="); print_int(operation_count)
    print(" machine_bridges="); print_int(bridge_count)
    print("\n")

    if pireus_u250_execution_engine_matches_expected(&result) &&
        triples == 326 && slot_count == 2 && observed_count == 1 &&
        unresolved_count == 1 && memory_count == 1 && isa_count == 0 &&
        operation_count == 0 && bridge_count == 1 {
        0
    } else { 1 }
}
