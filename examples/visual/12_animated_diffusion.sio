/// Visual Example 12: Animated Heat Diffusion - Frame-Based Animation
///
/// Demonstrates: Terminal animation using frame updates
///
/// Visual Output: 2D heat diffusion simulation
/// - RED: Hot (high temperature)
/// - YELLOW: Warm
/// - CYAN: Cool
/// - BLUE: Cold (low temperature)
/// - Updates in place using ANSI cursor control

// ============================================================================
// ANSI CONTROL CODES
// ============================================================================

fn reset() { print("\x1b[0m") }
fn bold() { print("\x1b[1m") }
fn clear_screen() { print("\x1b[2J") }
fn home_cursor() { print("\x1b[H") }
fn hide_cursor() { print("\x1b[?25l") }
fn show_cursor() { print("\x1b[?25h") }

fn red() { print("\x1b[31m") }
fn green() { print("\x1b[32m") }
fn yellow() { print("\x1b[33m") }
fn blue() { print("\x1b[34m") }
fn magenta() { print("\x1b[35m") }
fn cyan() { print("\x1b[36m") }
fn white() { print("\x1b[97m") }

fn bg_red() { print("\x1b[41m") }
fn bg_yellow() { print("\x1b[43m") }
fn bg_cyan() { print("\x1b[46m") }
fn bg_blue() { print("\x1b[44m") }

// ============================================================================
// HEAT DIFFUSION SIMULATION
// ============================================================================

/// Simple 2D heat diffusion using finite differences
/// ∂T/∂t = α·∇²T
/// Discrete: T_new[i,j] = T[i,j] + α·dt·(T[i-1,j] + T[i+1,j] + T[i,j-1] + T[i,j+1] - 4·T[i,j])/dx²

fn get_temp(grid: [f64; 256], i: i32, j: i32, size: i32) -> f64 {
    if i < 0 || i >= size || j < 0 || j >= size {
        return 0.0  // Boundary condition: cold edges
    }
    let idx = i * size + j
    return grid[idx]
}

fn set_temp(grid: [f64; 256], i: i32, j: i32, size: i32, value: f64) -> [f64; 256] {
    var new_grid = grid
    let idx = i * size + j
    new_grid[idx] = value
    return new_grid
}

fn diffusion_step(grid: [f64; 256], size: i32, alpha: f64, dt: f64, dx: f64) -> [f64; 256] {
    var new_grid = grid
    let coeff = alpha * dt / (dx * dx)

    var i = 1
    while i < size - 1 {
        var j = 1
        while j < size - 1 {
            let idx = i * size + j
            let t_center = grid[idx]
            let t_left = get_temp(grid, i - 1, j, size)
            let t_right = get_temp(grid, i + 1, j, size)
            let t_up = get_temp(grid, i, j - 1, size)
            let t_down = get_temp(grid, i, j + 1, size)

            let laplacian = t_left + t_right + t_up + t_down - 4.0 * t_center
            let t_new = t_center + coeff * laplacian

            new_grid[idx] = t_new
            j = j + 1
        }
        i = i + 1
    }

    return new_grid
}

// ============================================================================
// VISUALIZATION
// ============================================================================

fn temp_to_color(temp: f64) {
    if temp < 25.0 {
        bg_blue()
    }
    if temp >= 25.0 && temp < 50.0 {
        bg_cyan()
    }
    if temp >= 50.0 && temp < 75.0 {
        bg_yellow()
    }
    if temp >= 75.0 {
        bg_red()
    }
}

fn render_frame(grid: [f64; 256], size: i32, frame: i32) {
    home_cursor()

    bold()
    cyan()
    println("╔═══════════════════════════════════════════════════════════════════╗")
    print("║   HEAT DIFFUSION ANIMATION - Frame ")
    print(frame)
    println("                            ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    reset()
    println("")

    // Render grid
    var i = 0
    while i < size {
        print("  ")
        var j = 0
        while j < size {
            let idx = i * size + j
            let temp = grid[idx]
            temp_to_color(temp)
            print("  ")
            reset()
            j = j + 1
        }
        println("")
        i = i + 1
    }

    println("")
    print("  ")
    bg_blue()
    print("  ")
    reset()
    blue()
    print(" Cold (&lt;25°C)  ")
    reset()

    bg_cyan()
    print("  ")
    reset()
    cyan()
    print(" Cool (25-50°C)  ")
    reset()

    bg_yellow()
    print("  ")
    reset()
    yellow()
    print(" Warm (50-75°C)  ")
    reset()

    bg_red()
    print("  ")
    reset()
    red()
    println(" Hot (&gt;75°C)")
    reset()
}

// Note: Array initialization workaround - Sounio doesn't support array literals yet
fn init_grid(size: i32) -> [f64; 256] {
    var grid = [0.0; 256]

    // Hot spot in center
    let center = size / 2
    var i = center - 2
    while i <= center + 2 {
        var j = center - 2
        while j <= center + 2 {
            let idx = i * size + j
            grid[idx] = 100.0
            j = j + 1
        }
        i = i + 1
    }

    return grid
}

// ============================================================================
// MAIN: ANIMATED DIFFUSION
// ============================================================================

fn main() -> i32 {
    clear_screen()
    hide_cursor()

    let size = 16
    let alpha = 0.1    // Thermal diffusivity
    let dt = 0.1       // Time step
    let dx = 1.0       // Spatial step

    var grid = init_grid(size)
    var frame = 0

    // Animate for 20 frames
    while frame < 20 {
        render_frame(grid, size, frame)
        grid = diffusion_step(grid, size, alpha, dt, dx)
        frame = frame + 1

        // Delay (platform-dependent - would need sleep function)
        // For now, just show frames in sequence
    }

    show_cursor()
    println("")
    bold()
    magenta()
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║  ✓ Frame-based animation with ANSI cursor control                ║")
    println("║  ✓ Heat diffusion from center hot spot                           ║")
    println("║  ✓ Color gradient shows temperature distribution                 ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    reset()

    return 0
}
