/// Visual Example 8: Climate Model Ensemble - Color Edition
///
/// Demonstrates: Multi-model uncertainty with color-coded projections
///
/// Visual Output: Color bars for each climate model + ensemble mean
/// - Each model gets unique color
/// - Uncertainty bars show within-model variance
/// - Ensemble aggregation visualized with combined color

// ============================================================================
// ANSI COLORS
// ============================================================================

fn reset() { print("\x1b[0m") }
fn bold() { print("\x1b[1m") }
fn dim() { print("\x1b[2m") }

fn red() { print("\x1b[31m") }
fn green() { print("\x1b[32m") }
fn yellow() { print("\x1b[33m") }
fn blue() { print("\x1b[34m") }
fn magenta() { print("\x1b[35m") }
fn cyan() { print("\x1b[36m") }
fn white() { print("\x1b[97m") }

fn bg_red() { print("\x1b[41m") }
fn bg_green() { print("\x1b[42m") }
fn bg_yellow() { print("\x1b[43m") }
fn bg_blue() { print("\x1b[44m") }
fn bg_magenta() { print("\x1b[45m") }
fn bg_cyan() { print("\x1b[46m") }

// ============================================================================
// NUMERIC HELPERS
// ============================================================================

fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 10 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    return y
}

fn erf_approx(x: f64) -> f64 {
    let a1 = 0.254829592
    let a2 = 0.0 - 0.284496736
    let a3 = 1.421413741
    let a4 = 0.0 - 1.453152027
    let a5 = 1.061405429
    let p = 0.3275911
    let sign = if x < 0.0 { 0.0 - 1.0 } else { 1.0 }
    let x_abs = if x < 0.0 { 0.0 - x } else { x }
    let t = 1.0 / (1.0 + p * x_abs)
    let y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * exp_f64(0.0 - x_abs * x_abs)
    return sign * y
}

fn exp_f64(x: f64) -> f64 {
    if x > 10.0 { return 22026.465794806718 * exp_f64(x - 10.0) }
    if x < 0.0 - 10.0 { return 0.00004539992976248485 * exp_f64(x + 10.0) }
    var result = 1.0
    var term = 1.0
    var nf = 1.0
    var n = 1
    while n < 20 {
        term = term * x / nf
        result = result + term
        n = n + 1
        nf = nf + 1.0
    }
    return result
}

// ============================================================================
// EPISTEMIC VALUE
// ============================================================================

struct EpistemicValue {
    value: f64,
    variance: f64,
    conf_alpha: f64,
    conf_beta: f64
}

fn epistemic_new(value: f64, variance: f64) -> EpistemicValue {
    return EpistemicValue {
        value: value,
        variance: variance,
        conf_alpha: 1.0,
        conf_beta: 1.0
    }
}

fn epistemic_std(k: EpistemicValue) -> f64 {
    return sqrt_f64(k.variance)
}

fn epistemic_prob_gt(k: EpistemicValue, thresh: f64) -> f64 {
    if k.variance <= 0.0000001 {
        if k.value > thresh { return 1.0 }
        return 0.0
    }
    let z = (k.value - thresh) / sqrt_f64(k.variance)
    return 0.5 * (1.0 + erf_approx(z / 1.4142135623730951))
}

fn ensemble_mean_5(m1: EpistemicValue, m2: EpistemicValue, m3: EpistemicValue, m4: EpistemicValue, m5: EpistemicValue) -> EpistemicValue {
    let n = 5.0
    let mean_value = (m1.value + m2.value + m3.value + m4.value + m5.value) / n
    let within_var = (m1.variance + m2.variance + m3.variance + m4.variance + m5.variance) / n

    let d1 = m1.value - mean_value
    let d2 = m2.value - mean_value
    let d3 = m3.value - mean_value
    let d4 = m4.value - mean_value
    let d5 = m5.value - mean_value
    let between_var = (d1*d1 + d2*d2 + d3*d3 + d4*d4 + d5*d5) / (n - 1.0)

    let total_var = within_var + between_var
    return epistemic_new(mean_value, total_var)
}

// ============================================================================
// VISUALIZATION HELPERS
// ============================================================================

fn print_temp_bar_colored(temp: f64, std_dev: f64, model_color: i32) {
    // Model color
    if model_color == 1 { red() }
    if model_color == 2 { green() }
    if model_color == 3 { yellow() }
    if model_color == 4 { magenta() }
    if model_color == 5 { cyan() }

    // Main value bar
    let bar_len = (temp * 20.0)
    var i = 0
    while i < bar_len {
        print("█")
        i = i + 1
    }
    reset()

    // Uncertainty extension
    dim()
    if model_color == 1 { red() }
    if model_color == 2 { green() }
    if model_color == 3 { yellow() }
    if model_color == 4 { magenta() }
    if model_color == 5 { cyan() }

    let unc_len = (std_dev * 20.0)
    i = 0
    while i < unc_len {
        print("▒")
        i = i + 1
    }
    reset()
}

// ============================================================================
// MAIN: CLIMATE ENSEMBLE VISUALIZATION
// ============================================================================

fn main() -> i32 {
    bold()
    cyan()
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║  CLIMATE MODEL ENSEMBLE - Multi-Model Uncertainty Quantification ║")
    println("║  CMIP6 Projections for 2050 (RCP8.5 Scenario)                    ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    reset()
    println("")

    // CMIP6 MODEL PROJECTIONS
    bold()
    yellow()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                   INDIVIDUAL MODEL PROJECTIONS                   ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    let model1 = epistemic_new(1.8, 0.04)
    let model2 = epistemic_new(2.1, 0.09)
    let model3 = epistemic_new(1.9, 0.0625)
    let model4 = epistemic_new(2.3, 0.16)
    let model5 = epistemic_new(2.0, 0.01)

    // Model 1
    print("  ")
    red()
    print("Model 1 (GFDL):   ")
    reset()
    print_temp_bar_colored(model1.value, epistemic_std(model1), 1)
    print("  ")
    bold()
    print(model1.value)
    reset()
    print("°C ± ")
    red()
    print(epistemic_std(model1))
    reset()
    println("°C")

    // Model 2
    print("  ")
    green()
    print("Model 2 (HadGEM): ")
    reset()
    print_temp_bar_colored(model2.value, epistemic_std(model2), 2)
    print("  ")
    bold()
    print(model2.value)
    reset()
    print("°C ± ")
    green()
    print(epistemic_std(model2))
    reset()
    println("°C")

    // Model 3
    print("  ")
    yellow()
    print("Model 3 (MIROC):  ")
    reset()
    print_temp_bar_colored(model3.value, epistemic_std(model3), 3)
    print("  ")
    bold()
    print(model3.value)
    reset()
    print("°C ± ")
    yellow()
    print(epistemic_std(model3))
    reset()
    println("°C")

    // Model 4
    print("  ")
    magenta()
    print("Model 4 (IPSL):   ")
    reset()
    print_temp_bar_colored(model4.value, epistemic_std(model4), 4)
    print("  ")
    bold()
    print(model4.value)
    reset()
    print("°C ± ")
    magenta()
    print(epistemic_std(model4))
    reset()
    println("°C")

    // Model 5
    print("  ")
    cyan()
    print("Model 5 (MPI-ESM):")
    reset()
    print_temp_bar_colored(model5.value, epistemic_std(model5), 5)
    print("  ")
    bold()
    print(model5.value)
    reset()
    print("°C ± ")
    cyan()
    print(epistemic_std(model5))
    reset()
    println("°C")

    println("")

    // ENSEMBLE MEAN
    let ensemble = ensemble_mean_5(model1, model2, model3, model4, model5)

    bold()
    white()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                     ENSEMBLE MEAN PROJECTION                     ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    print("  ")
    bold()
    white()
    print("Ensemble:         ")
    reset()

    // Multi-colored ensemble bar
    var i = 0
    let ens_len = (ensemble.value * 20.0)
    while i < ens_len {
        let segment = i % 5
        if segment == 0 { red() }
        if segment == 1 { green() }
        if segment == 2 { yellow() }
        if segment == 3 { magenta() }
        if segment == 4 { cyan() }
        print("█")
        i = i + 1
    }
    reset()

    print("  ")
    bold()
    cyan()
    print(ensemble.value)
    reset()
    print("°C ± ")
    white()
    print(epistemic_std(ensemble))
    reset()
    println("°C")

    println("")

    // PARIS AGREEMENT ASSESSMENT
    bold()
    red()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                   PARIS AGREEMENT ASSESSMENT                     ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    let prob_1_5 = epistemic_prob_gt(ensemble, 1.5)
    let prob_2_0 = epistemic_prob_gt(ensemble, 2.0)

    print("  P(warming > 1.5°C) = ")
    if prob_1_5 > 0.90 {
        bold()
        red()
    }
    if prob_1_5 > 0.66 && prob_1_5 <= 0.90 {
        yellow()
    }
    if prob_1_5 <= 0.66 {
        green()
    }
    print(prob_1_5 * 100.0)
    print("%  ")

    bg_red()
    i = 0
    let bar1_5 = (prob_1_5 * 40.0)
    while i < bar1_5 {
        print(" ")
        i = i + 1
    }
    reset()
    println("")

    if prob_1_5 > 0.90 {
        red()
        println("    ⚠ IPCC: Virtually certain (>99%) to exceed 1.5°C")
    }
    if prob_1_5 > 0.66 && prob_1_5 <= 0.90 {
        yellow()
        println("    ⚠ IPCC: Likely (>66%) to exceed 1.5°C")
    }
    reset()
    println("")

    print("  P(warming > 2.0°C) = ")
    if prob_2_0 > 0.66 {
        bold()
        red()
    }
    if prob_2_0 > 0.33 && prob_2_0 <= 0.66 {
        yellow()
    }
    if prob_2_0 <= 0.33 {
        green()
    }
    print(prob_2_0 * 100.0)
    print("%  ")

    bg_yellow()
    i = 0
    let bar2_0 = (prob_2_0 * 40.0)
    while i < bar2_0 {
        print(" ")
        i = i + 1
    }
    reset()
    println("")

    if prob_2_0 > 0.66 {
        red()
        println("    ⚠ IPCC: Likely (>66%) to exceed 2.0°C")
    }
    if prob_2_0 > 0.33 && prob_2_0 <= 0.66 {
        yellow()
        println("    ⚠ IPCC: About as likely as not to exceed 2.0°C")
    }
    if prob_2_0 <= 0.33 {
        green()
        println("    ✓ IPCC: Unlikely (<33%) to exceed 2.0°C")
    }
    reset()

    println("")

    // FINAL MESSAGE
    bold()
    cyan()
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║  Multi-model ensemble quantifies structural uncertainty          ║")
    println("║  Color-coded projections show model disagreement                 ║")
    println("║  Paris Agreement targets at serious risk under RCP8.5            ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    reset()

    return 0
}
