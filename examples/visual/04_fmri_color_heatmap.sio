/// Visual Example 4: fMRI Brain Activation with TRUE COLOR
///
/// Demonstrates: ANSI 256-color terminal output for scientific visualization
///
/// Visual Output: Full-color brain heatmap with temperature gradient
/// - Dark blue (0.0) → Cyan → Green → Yellow → Red → White (max)
/// - 256-color ANSI palette for smooth gradients
/// - Same octonion processing as Example 2, but with color!
///
/// Terminal requirement: 256-color support (most modern terminals)

// ============================================================================
// ANSI COLOR CODES
// ============================================================================

fn ansi_color_256(code: i32) {
    // ANSI 256-color escape sequence: \x1b[38;5;<code>m
    print("\x1b[38;5;")
    print(code)
    print("m")
}

fn ansi_bg_color_256(code: i32) {
    // Background color: \x1b[48;5;<code>m
    print("\x1b[48;5;")
    print(code)
    print("m")
}

fn ansi_reset() {
    print("\x1b[0m")
}

fn ansi_bold() {
    print("\x1b[1m")
}

// ============================================================================
// COLOR MAPPING FOR ACTIVATION HEATMAP
// ============================================================================

/// Map activation value [0, max] to 256-color code
/// Color scale: Blue → Cyan → Green → Yellow → Red → Magenta
fn activation_to_color(value: f32, max_val: f32) -> i32 {
    let normalized = value / max_val

    if normalized < 0.0 {
        return 16  // Black (no activation)
    }

    if normalized < 0.2 {
        // Dark blue → blue (16-21)
        let frac = normalized / 0.2
        return 16 + (frac * 5.0)
    }

    if normalized < 0.4 {
        // Cyan range (36-51)
        let frac = (normalized - 0.2) / 0.2
        return 36 + (frac * 15.0)
    }

    if normalized < 0.6 {
        // Green range (40-83)
        let frac = (normalized - 0.4) / 0.2
        return 40 + (frac * 43.0)
    }

    if normalized < 0.8 {
        // Yellow/Orange range (184-214)
        let frac = (normalized - 0.6) / 0.2
        return 184 + (frac * 30.0)
    }

    // Red/Magenta range (196-231)
    let frac = (normalized - 0.8) / 0.2
    return 196 + (frac * 35.0)
}

// ============================================================================
// NUMERIC HELPERS
// ============================================================================

fn abs_f32(x: f32) -> f32 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn max_f32(a: f32, b: f32) -> f32 {
    if a > b { return a }
    return b
}

fn exp_f32(x: f32) -> f32 {
    if x > 10.0 { return 22026.465 * exp_f32(x - 10.0) }
    if x < 0.0 - 10.0 { return 0.000045 * exp_f32(x + 10.0) }
    var result = 1.0
    var term = 1.0
    var nf = 1.0
    var n = 1
    while n < 15 {
        term = term * x / nf
        result = result + term
        n = n + 1
        nf = nf + 1.0
    }
    return result
}

// ============================================================================
// OCTONION STRUCT
// ============================================================================

struct Octonion {
    a: f32, b: f32, c: f32, d: f32,
    e: f32, f: f32, g: f32, h: f32
}

fn oct_norm_sq(o: Octonion) -> f32 {
    return o.a*o.a + o.b*o.b + o.c*o.c + o.d*o.d +
           o.e*o.e + o.f*o.f + o.g*o.g + o.h*o.h
}

fn oct_mul(o1: Octonion, o2: Octonion) -> Octonion {
    return Octonion {
        a: o1.a*o2.a - o1.b*o2.b - o1.c*o2.c - o1.d*o2.d - o1.e*o2.e - o1.f*o2.f - o1.g*o2.g - o1.h*o2.h,
        b: o1.a*o2.b + o1.b*o2.a + o1.c*o2.d - o1.d*o2.c + o1.e*o2.f - o1.f*o2.e - o1.g*o2.h + o1.h*o2.g,
        c: o1.a*o2.c - o1.b*o2.d + o1.c*o2.a + o1.d*o2.b + o1.e*o2.g + o1.f*o2.h - o1.g*o2.e - o1.h*o2.f,
        d: o1.a*o2.d + o1.b*o2.c - o1.c*o2.b + o1.d*o2.a + o1.e*o2.h - o1.f*o2.g + o1.g*o2.f - o1.h*o2.e,
        e: o1.a*o2.e - o1.b*o2.f - o1.c*o2.g - o1.d*o2.h + o1.e*o2.a + o1.f*o2.b + o1.g*o2.c + o1.h*o2.d,
        f: o1.a*o2.f + o1.b*o2.e - o1.c*o2.h + o1.d*o2.g - o1.e*o2.b + o1.f*o2.a - o1.g*o2.d + o1.h*o2.c,
        g: o1.a*o2.g + o1.b*o2.h + o1.c*o2.e - o1.d*o2.f - o1.e*o2.c + o1.f*o2.d + o1.g*o2.a - o1.h*o2.b,
        h: o1.a*o2.h - o1.b*o2.g + o1.c*o2.f + o1.d*o2.e - o1.e*o2.d - o1.f*o2.c + o1.g*o2.b + o1.h*o2.a
    }
}

fn oct_relu(o: Octonion) -> Octonion {
    return Octonion {
        a: if o.a > 0.0 { o.a } else { 0.0 },
        b: if o.b > 0.0 { o.b } else { 0.0 },
        c: if o.c > 0.0 { o.c } else { 0.0 },
        d: if o.d > 0.0 { o.d } else { 0.0 },
        e: if o.e > 0.0 { o.e } else { 0.0 },
        f: if o.f > 0.0 { o.f } else { 0.0 },
        g: if o.g > 0.0 { o.g } else { 0.0 },
        h: if o.h > 0.0 { o.h } else { 0.0 }
    }
}

// ============================================================================
// BOLD SIGNAL SIMULATION
// ============================================================================

fn simulate_bold_signal(x: i32, y: i32) -> f32 {
    let fx = x * 1.0
    let fy = y * 1.0

    let visual_cortex = if y > 24 { 1.0 } else { 0.0 }
    let visual_strength = visual_cortex * 2.5

    let motor_cortex = if y < 8 && x > 8 && x < 24 { 1.0 } else { 0.0 }
    let motor_strength = motor_cortex * 1.8

    let frontal = if y < 12 && x < 12 { 1.0 } else { 0.0 }
    let frontal_strength = frontal * 1.2

    let dx = fx - 16.0
    let dy = fy - 16.0
    let dist_sq = dx*dx + dy*dy
    let spatial_decay = exp_f32(0.0 - dist_sq / 200.0)

    let noise = ((x * 7 + y * 13) % 100) * 0.01 - 0.5

    return (visual_strength + motor_strength + frontal_strength) * spatial_decay + noise * 0.3
}

// ============================================================================
// OCTONION ENCODING
// ============================================================================

fn encode_octonion_voxel(x: i32, y: i32) -> Octonion {
    let center = simulate_bold_signal(x, y)
    let up = simulate_bold_signal(x, y - 1)
    let right = simulate_bold_signal(x + 1, y)
    let down = simulate_bold_signal(x, y + 1)
    let left = simulate_bold_signal(x - 1, y)
    let ul = simulate_bold_signal(x - 1, y - 1)
    let ur = simulate_bold_signal(x + 1, y - 1)
    let dl = simulate_bold_signal(x - 1, y + 1)

    return Octonion {
        a: center, b: up, c: right, d: down,
        e: left, f: ul, g: ur, h: dl
    }
}

// ============================================================================
// OCTONION FEATURE DETECTOR
// ============================================================================

fn octonion_feature_detector(input: Octonion) -> Octonion {
    let weight = Octonion {
        a: 0.8, b: 0.6, c: 0.4, d: 0.5,
        e: 0.45, f: 0.35, g: 0.55, h: 0.65
    }

    let activated = oct_mul(input, weight)
    return oct_relu(activated)
}

// ============================================================================
// MAIN: COLORIZED fMRI VISUALIZATION
// ============================================================================

fn main() -> i32 {
    ansi_bold()
    ansi_color_256(51)  // Cyan
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║   fMRI BRAIN ACTIVATION - TRUE COLOR VISUALIZATION               ║")
    println("║   256-Color ANSI Terminal Heatmap with Octonion Processing       ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    ansi_reset()
    println("")

    println("Processing 32×32 brain slice with octonion neural networks...")
    println("Encoding spatial neighborhoods as 8D hypercomplex numbers...")
    println("")

    // COMPUTE ACTIVATIONS AND FIND MAX
    var max_activation = 0.0
    var y = 0
    while y < 32 {
        var x = 0
        while x < 32 {
            let input = encode_octonion_voxel(x, y)
            let output = octonion_feature_detector(input)
            let activation = oct_norm_sq(output)
            max_activation = max_f32(max_activation, activation)
            x = x + 1
        }
        y = y + 1
    }

    // RENDER COLOR HEATMAP
    ansi_bold()
    ansi_color_256(226)  // Yellow
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("           COLOR-CODED BRAIN ACTIVATION MAP (Sagittal)           ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    ansi_reset()
    println("")

    // Color legend
    print("  ")
    ansi_bg_color_256(16)
    print("  ")
    ansi_reset()
    print(" None   ")

    ansi_bg_color_256(21)
    print("  ")
    ansi_reset()
    print(" Low   ")

    ansi_bg_color_256(40)
    print("  ")
    ansi_reset()
    print(" Med   ")

    ansi_bg_color_256(184)
    print("  ")
    ansi_reset()
    print(" High   ")

    ansi_bg_color_256(196)
    print("  ")
    ansi_reset()
    println(" Peak")
    println("")

    // Render heatmap with colors
    y = 0
    while y < 32 {
        print("  ")
        var x = 0
        while x < 32 {
            let input = encode_octonion_voxel(x, y)
            let output = octonion_feature_detector(input)
            let activation = oct_norm_sq(output)

            let color = activation_to_color(activation, max_activation)
            ansi_bg_color_256(color)
            print("  ")
            ansi_reset()

            x = x + 1
        }
        println("")
        y = y + 1
    }

    println("")
    ansi_bold()
    ansi_color_256(46)  // Green
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                    ACTIVATION STATISTICS                        ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    ansi_reset()
    println("")

    print("  Peak activation: ")
    ansi_color_256(196)
    ansi_bold()
    println(max_activation)
    ansi_reset()
    println("")

    println("  Detected regions:")
    ansi_color_256(196)
    println("    ✓ Visual cortex (posterior): HIGH activation")
    ansi_reset()
    ansi_color_256(184)
    println("    ✓ Motor cortex (superior): MEDIUM-HIGH activation")
    ansi_reset()
    ansi_color_256(40)
    println("    ✓ Frontal regions (anterior): MEDIUM activation")
    ansi_reset()
    println("")

    ansi_bold()
    ansi_color_256(51)
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║  Sounio: Scientific visualization with terminal colors!          ║")
    println("║  No GUI needed - pure ANSI escape sequences in stdout            ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    ansi_reset()

    return 0
}
