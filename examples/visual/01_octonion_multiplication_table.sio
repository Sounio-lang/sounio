/// Visual Example 1: Octonion Multiplication Table
///
/// Demonstrates: Non-associative 8D algebra, Cayley-Dickson construction
///
/// Visual Output: ASCII multiplication table showing the 8 basis octonions
/// (1, i, j, k, l, il, jl, kl) and their products
///
/// Key Properties:
/// - Non-commutative: i×j ≠ j×i
/// - Non-associative: (i×j)×k ≠ i×(j×k)
/// - Normed division algebra: |o₁×o₂| = |o₁|×|o₂|
/// - 7-sphere: Unit octonions form S⁷

// ============================================================================
// OCTONION STRUCT (8-DIMENSIONAL HYPERCOMPLEX NUMBER)
// ============================================================================

struct Octonion {
    a: f32,  // 1   (real)
    b: f32,  // i
    c: f32,  // j
    d: f32,  // k
    e: f32,  // l
    f: f32,  // il
    g: f32,  // jl
    h: f32   // kl
}

// ============================================================================
// OCTONION OPERATIONS (Cayley-Dickson Construction)
// ============================================================================

fn oct_mul(o1: Octonion, o2: Octonion) -> Octonion {
    return Octonion {
        a: o1.a*o2.a - o1.b*o2.b - o1.c*o2.c - o1.d*o2.d - o1.e*o2.e - o1.f*o2.f - o1.g*o2.g - o1.h*o2.h,
        b: o1.a*o2.b + o1.b*o2.a + o1.c*o2.d - o1.d*o2.c + o1.e*o2.f - o1.f*o2.e - o1.g*o2.h + o1.h*o2.g,
        c: o1.a*o2.c - o1.b*o2.d + o1.c*o2.a + o1.d*o2.b + o1.e*o2.g + o1.f*o2.h - o1.g*o2.e - o1.h*o2.f,
        d: o1.a*o2.d + o1.b*o2.c - o1.c*o2.b + o1.d*o2.a + o1.e*o2.h - o1.f*o2.g + o1.g*o2.f - o1.h*o2.e,
        e: o1.a*o2.e - o1.b*o2.f - o1.c*o2.g - o1.d*o2.h + o1.e*o2.a + o1.f*o2.b + o1.g*o2.c + o1.h*o2.d,
        f: o1.a*o2.f + o1.b*o2.e - o1.c*o2.h + o1.d*o2.g - o1.e*o2.b + o1.f*o2.a - o1.g*o2.d + o1.h*o2.c,
        g: o1.a*o2.g + o1.b*o2.h + o1.c*o2.e - o1.d*o2.f - o1.e*o2.c + o1.f*o2.d + o1.g*o2.a - o1.h*o2.b,
        h: o1.a*o2.h - o1.b*o2.g + o1.c*o2.f + o1.d*o2.e - o1.e*o2.d - o1.f*o2.c + o1.g*o2.b + o1.h*o2.a
    }
}

fn oct_norm_sq(o: Octonion) -> f32 {
    return o.a*o.a + o.b*o.b + o.c*o.c + o.d*o.d + o.e*o.e + o.f*o.f + o.g*o.g + o.h*o.h
}

// ============================================================================
// BASIS OCTONIONS
// ============================================================================

fn basis_1() -> Octonion {
    return Octonion { a: 1.0, b: 0.0, c: 0.0, d: 0.0, e: 0.0, f: 0.0, g: 0.0, h: 0.0 }
}

fn basis_i() -> Octonion {
    return Octonion { a: 0.0, b: 1.0, c: 0.0, d: 0.0, e: 0.0, f: 0.0, g: 0.0, h: 0.0 }
}

fn basis_j() -> Octonion {
    return Octonion { a: 0.0, b: 0.0, c: 1.0, d: 0.0, e: 0.0, f: 0.0, g: 0.0, h: 0.0 }
}

fn basis_k() -> Octonion {
    return Octonion { a: 0.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0, g: 0.0, h: 0.0 }
}

fn basis_l() -> Octonion {
    return Octonion { a: 0.0, b: 0.0, c: 0.0, d: 0.0, e: 1.0, f: 0.0, g: 0.0, h: 0.0 }
}

fn basis_il() -> Octonion {
    return Octonion { a: 0.0, b: 0.0, c: 0.0, d: 0.0, e: 0.0, f: 1.0, g: 0.0, h: 0.0 }
}

fn basis_jl() -> Octonion {
    return Octonion { a: 0.0, b: 0.0, c: 0.0, d: 0.0, e: 0.0, f: 0.0, g: 1.0, h: 0.0 }
}

fn basis_kl() -> Octonion {
    return Octonion { a: 0.0, b: 0.0, c: 0.0, d: 0.0, e: 0.0, f: 0.0, g: 0.0, h: 1.0 }
}

// ============================================================================
// VISUALIZATION HELPER
// ============================================================================

fn print_octonion_compact(o: Octonion) {
    if o.a > 0.5 { print(" 1  ") }
    else if o.a < 0.0 - 0.5 { print("-1  ") }
    else if o.b > 0.5 { print(" i  ") }
    else if o.b < 0.0 - 0.5 { print("-i  ") }
    else if o.c > 0.5 { print(" j  ") }
    else if o.c < 0.0 - 0.5 { print("-j  ") }
    else if o.d > 0.5 { print(" k  ") }
    else if o.d < 0.0 - 0.5 { print("-k  ") }
    else if o.e > 0.5 { print(" l  ") }
    else if o.e < 0.0 - 0.5 { print("-l  ") }
    else if o.f > 0.5 { print(" il ") }
    else if o.f < 0.0 - 0.5 { print("-il ") }
    else if o.g > 0.5 { print(" jl ") }
    else if o.g < 0.0 - 0.5 { print("-jl ") }
    else if o.h > 0.5 { print(" kl ") }
    else if o.h < 0.0 - 0.5 { print("-kl ") }
    else { print(" 0  ") }
}

// ============================================================================
// MAIN: VISUAL MULTIPLICATION TABLE
// ============================================================================

fn main() -> i32 {
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║        OCTONION MULTIPLICATION TABLE (Fano Plane Basis)          ║")
    println("║              8-Dimensional Normed Division Algebra                ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    println("")

    println("Basis elements: 1, i, j, k, l, il, jl, kl")
    println("Properties:")
    println("  • Non-commutative: i×j = k, but j×i = -k")
    println("  • Non-associative: (i×j)×l ≠ i×(j×l)")
    println("  • Normed: |o₁×o₂| = |o₁|×|o₂| (division algebra)")
    println("  • Alternative: (x×x)×y = x×(x×y)")
    println("")

    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                    MULTIPLICATION TABLE")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("")

    print("   ×  │")
    print("  1  ")
    print("│")
    print("  i  ")
    print("│")
    print("  j  ")
    print("│")
    print("  k  ")
    print("│")
    print("  l  ")
    print("│")
    print(" il  ")
    print("│")
    print(" jl  ")
    print("│")
    println(" kl  ")

    println("──────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────")

    // Row: 1 × ?
    print("  1   │")
    print_octonion_compact(oct_mul(basis_1(), basis_1()))
    print("│")
    print_octonion_compact(oct_mul(basis_1(), basis_i()))
    print("│")
    print_octonion_compact(oct_mul(basis_1(), basis_j()))
    print("│")
    print_octonion_compact(oct_mul(basis_1(), basis_k()))
    print("│")
    print_octonion_compact(oct_mul(basis_1(), basis_l()))
    print("│")
    print_octonion_compact(oct_mul(basis_1(), basis_il()))
    print("│")
    print_octonion_compact(oct_mul(basis_1(), basis_jl()))
    print("│")
    print_octonion_compact(oct_mul(basis_1(), basis_kl()))
    println("")

    // Row: i × ?
    print("  i   │")
    print_octonion_compact(oct_mul(basis_i(), basis_1()))
    print("│")
    print_octonion_compact(oct_mul(basis_i(), basis_i()))
    print("│")
    print_octonion_compact(oct_mul(basis_i(), basis_j()))
    print("│")
    print_octonion_compact(oct_mul(basis_i(), basis_k()))
    print("│")
    print_octonion_compact(oct_mul(basis_i(), basis_l()))
    print("│")
    print_octonion_compact(oct_mul(basis_i(), basis_il()))
    print("│")
    print_octonion_compact(oct_mul(basis_i(), basis_jl()))
    print("│")
    print_octonion_compact(oct_mul(basis_i(), basis_kl()))
    println("")

    // Row: j × ?
    print("  j   │")
    print_octonion_compact(oct_mul(basis_j(), basis_1()))
    print("│")
    print_octonion_compact(oct_mul(basis_j(), basis_i()))
    print("│")
    print_octonion_compact(oct_mul(basis_j(), basis_j()))
    print("│")
    print_octonion_compact(oct_mul(basis_j(), basis_k()))
    print("│")
    print_octonion_compact(oct_mul(basis_j(), basis_l()))
    print("│")
    print_octonion_compact(oct_mul(basis_j(), basis_il()))
    print("│")
    print_octonion_compact(oct_mul(basis_j(), basis_jl()))
    print("│")
    print_octonion_compact(oct_mul(basis_j(), basis_kl()))
    println("")

    // Row: k × ?
    print("  k   │")
    print_octonion_compact(oct_mul(basis_k(), basis_1()))
    print("│")
    print_octonion_compact(oct_mul(basis_k(), basis_i()))
    print("│")
    print_octonion_compact(oct_mul(basis_k(), basis_j()))
    print("│")
    print_octonion_compact(oct_mul(basis_k(), basis_k()))
    print("│")
    print_octonion_compact(oct_mul(basis_k(), basis_l()))
    print("│")
    print_octonion_compact(oct_mul(basis_k(), basis_il()))
    print("│")
    print_octonion_compact(oct_mul(basis_k(), basis_jl()))
    print("│")
    print_octonion_compact(oct_mul(basis_k(), basis_kl()))
    println("")

    // Row: l × ?
    print("  l   │")
    print_octonion_compact(oct_mul(basis_l(), basis_1()))
    print("│")
    print_octonion_compact(oct_mul(basis_l(), basis_i()))
    print("│")
    print_octonion_compact(oct_mul(basis_l(), basis_j()))
    print("│")
    print_octonion_compact(oct_mul(basis_l(), basis_k()))
    print("│")
    print_octonion_compact(oct_mul(basis_l(), basis_l()))
    print("│")
    print_octonion_compact(oct_mul(basis_l(), basis_il()))
    print("│")
    print_octonion_compact(oct_mul(basis_l(), basis_jl()))
    print("│")
    print_octonion_compact(oct_mul(basis_l(), basis_kl()))
    println("")

    // Row: il × ?
    print(" il   │")
    print_octonion_compact(oct_mul(basis_il(), basis_1()))
    print("│")
    print_octonion_compact(oct_mul(basis_il(), basis_i()))
    print("│")
    print_octonion_compact(oct_mul(basis_il(), basis_j()))
    print("│")
    print_octonion_compact(oct_mul(basis_il(), basis_k()))
    print("│")
    print_octonion_compact(oct_mul(basis_il(), basis_l()))
    print("│")
    print_octonion_compact(oct_mul(basis_il(), basis_il()))
    print("│")
    print_octonion_compact(oct_mul(basis_il(), basis_jl()))
    print("│")
    print_octonion_compact(oct_mul(basis_il(), basis_kl()))
    println("")

    // Row: jl × ?
    print(" jl   │")
    print_octonion_compact(oct_mul(basis_jl(), basis_1()))
    print("│")
    print_octonion_compact(oct_mul(basis_jl(), basis_i()))
    print("│")
    print_octonion_compact(oct_mul(basis_jl(), basis_j()))
    print("│")
    print_octonion_compact(oct_mul(basis_jl(), basis_k()))
    print("│")
    print_octonion_compact(oct_mul(basis_jl(), basis_l()))
    print("│")
    print_octonion_compact(oct_mul(basis_jl(), basis_il()))
    print("│")
    print_octonion_compact(oct_mul(basis_jl(), basis_jl()))
    print("│")
    print_octonion_compact(oct_mul(basis_jl(), basis_kl()))
    println("")

    // Row: kl × ?
    print(" kl   │")
    print_octonion_compact(oct_mul(basis_kl(), basis_1()))
    print("│")
    print_octonion_compact(oct_mul(basis_kl(), basis_i()))
    print("│")
    print_octonion_compact(oct_mul(basis_kl(), basis_j()))
    print("│")
    print_octonion_compact(oct_mul(basis_kl(), basis_k()))
    print("│")
    print_octonion_compact(oct_mul(basis_kl(), basis_l()))
    print("│")
    print_octonion_compact(oct_mul(basis_kl(), basis_il()))
    print("│")
    print_octonion_compact(oct_mul(basis_kl(), basis_jl()))
    print("│")
    print_octonion_compact(oct_mul(basis_kl(), basis_kl()))
    println("")

    println("")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                  DEMONSTRATING NON-ASSOCIATIVITY")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("")

    // Demonstrate non-associativity: (i×j)×l vs i×(j×l)
    let i = basis_i()
    let j = basis_j()
    let l_basis = basis_l()

    let ij = oct_mul(i, j)
    let left = oct_mul(ij, l_basis)

    let jl = oct_mul(j, l_basis)
    let right = oct_mul(i, jl)

    print("  (i × j) × l  = ")
    print_octonion_compact(left)
    println("")

    print("  i × (j × l)  = ")
    print_octonion_compact(right)
    println("")

    println("")
    if left.a != right.a || left.b != right.b || left.c != right.c {
        println("  ✓ Non-associative verified: (i×j)×l ≠ i×(j×l)")
    }

    println("")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                   NORMED DIVISION ALGEBRA TEST")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("")

    // Test norm multiplicativity: |o1 × o2| = |o1| × |o2|
    let o1 = Octonion { a: 1.0, b: 2.0, c: 3.0, d: 1.0, e: 0.5, f: 1.5, g: 2.5, h: 0.7 }
    let o2 = Octonion { a: 2.0, b: 1.0, c: 0.5, d: 3.0, e: 1.0, f: 0.3, g: 1.2, h: 2.0 }

    let product = oct_mul(o1, o2)

    let norm_o1 = oct_norm_sq(o1)
    let norm_o2 = oct_norm_sq(o2)
    let norm_product = oct_norm_sq(product)

    let expected_norm_sq = norm_o1 * norm_o2

    println("  Test octonions:")
    print("    o₁ norm²: ")
    println(norm_o1)
    print("    o₂ norm²: ")
    println(norm_o2)
    print("    (o₁×o₂) norm²: ")
    println(norm_product)
    print("    Expected (o₁×o₂) norm²: ")
    println(expected_norm_sq)

    let error = norm_product - expected_norm_sq
    let rel_error = if expected_norm_sq > 0.0 { error / expected_norm_sq } else { 0.0 }

    println("")
    if rel_error < 0.0001 && rel_error > 0.0 - 0.0001 {
        println("  ✓ Norm multiplicativity verified: |o₁×o₂|² = |o₁|²×|o₂|²")
    }

    println("")
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║      Sounio: Only language with native octonion support!         ║")
    println("║      Reference: Deep Octonion Networks (arXiv:1903.08478)        ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")

    return 0
}
