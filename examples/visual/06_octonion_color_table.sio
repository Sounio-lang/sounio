/// Visual Example 6: Octonion Multiplication Table - COLOR EDITION
///
/// Demonstrates: Color-coded hypercomplex algebra visualization
///
/// Visual Output: Full-color 8×8 multiplication table where:
/// - Real (1): WHITE (identity)
/// - Quaternion basis (i,j,k): RED, GREEN, BLUE
/// - Octonion extensions (l,il,jl,kl): YELLOW, MAGENTA, CYAN, custom
/// - Negative values: Dimmed/background colors
///
/// This visualization makes the Fano plane structure immediately visible!

// ============================================================================
// ANSI COLORS
// ============================================================================

fn color_reset() { print("\x1b[0m") }
fn color_bold() { print("\x1b[1m") }
fn color_dim() { print("\x1b[2m") }

fn color_white() { print("\x1b[97m") }
fn color_red() { print("\x1b[91m") }
fn color_green() { print("\x1b[92m") }
fn color_yellow() { print("\x1b[93m") }
fn color_blue() { print("\x1b[94m") }
fn color_magenta() { print("\x1b[95m") }
fn color_cyan() { print("\x1b[96m") }

fn bg_red() { print("\x1b[41m") }
fn bg_green() { print("\x1b[42m") }
fn bg_blue() { print("\x1b[44m") }
fn bg_yellow() { print("\x1b[43m") }
fn bg_magenta() { print("\x1b[45m") }
fn bg_cyan() { print("\x1b[46m") }

// ============================================================================
// BASIS ELEMENT COLORS
// ============================================================================

fn print_colored_basis(basis: i32, is_negative: i32) {
    if is_negative == 1 {
        color_dim()
    } else {
        color_bold()
    }

    if basis == 0 {
        // Real: 1
        color_white()
    }
    if basis == 1 {
        // i (quaternion)
        color_red()
    }
    if basis == 2 {
        // j (quaternion)
        color_green()
    }
    if basis == 3 {
        // k (quaternion)
        color_blue()
    }
    if basis == 4 {
        // l (octonion)
        color_yellow()
    }
    if basis == 5 {
        // il (octonion)
        color_magenta()
    }
    if basis == 6 {
        // jl (octonion)
        color_cyan()
    }
    if basis == 7 {
        // kl (octonion)
        color_white()
    }
}

// ============================================================================
// OCTONION STRUCT
// ============================================================================

struct Octonion {
    a: f32, b: f32, c: f32, d: f32,
    e: f32, f: f32, g: f32, h: f32
}

fn oct_basis(idx: i32) -> Octonion {
    if idx == 0 { return Octonion { a: 1.0, b: 0.0, c: 0.0, d: 0.0, e: 0.0, f: 0.0, g: 0.0, h: 0.0 } }
    if idx == 1 { return Octonion { a: 0.0, b: 1.0, c: 0.0, d: 0.0, e: 0.0, f: 0.0, g: 0.0, h: 0.0 } }
    if idx == 2 { return Octonion { a: 0.0, b: 0.0, c: 1.0, d: 0.0, e: 0.0, f: 0.0, g: 0.0, h: 0.0 } }
    if idx == 3 { return Octonion { a: 0.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0, g: 0.0, h: 0.0 } }
    if idx == 4 { return Octonion { a: 0.0, b: 0.0, c: 0.0, d: 0.0, e: 1.0, f: 0.0, g: 0.0, h: 0.0 } }
    if idx == 5 { return Octonion { a: 0.0, b: 0.0, c: 0.0, d: 0.0, e: 0.0, f: 1.0, g: 0.0, h: 0.0 } }
    if idx == 6 { return Octonion { a: 0.0, b: 0.0, c: 0.0, d: 0.0, e: 0.0, f: 0.0, g: 1.0, h: 0.0 } }
    return Octonion { a: 0.0, b: 0.0, c: 0.0, d: 0.0, e: 0.0, f: 0.0, g: 0.0, h: 1.0 }
}

fn oct_mul(o1: Octonion, o2: Octonion) -> Octonion {
    return Octonion {
        a: o1.a*o2.a - o1.b*o2.b - o1.c*o2.c - o1.d*o2.d - o1.e*o2.e - o1.f*o2.f - o1.g*o2.g - o1.h*o2.h,
        b: o1.a*o2.b + o1.b*o2.a + o1.c*o2.d - o1.d*o2.c + o1.e*o2.f - o1.f*o2.e - o1.g*o2.h + o1.h*o2.g,
        c: o1.a*o2.c - o1.b*o2.d + o1.c*o2.a + o1.d*o2.b + o1.e*o2.g + o1.f*o2.h - o1.g*o2.e - o1.h*o2.f,
        d: o1.a*o2.d + o1.b*o2.c - o1.c*o2.b + o1.d*o2.a + o1.e*o2.h - o1.f*o2.g + o1.g*o2.f - o1.h*o2.e,
        e: o1.a*o2.e - o1.b*o2.f - o1.c*o2.g - o1.d*o2.h + o1.e*o2.a + o1.f*o2.b + o1.g*o2.c + o1.h*o2.d,
        f: o1.a*o2.f + o1.b*o2.e - o1.c*o2.h + o1.d*o2.g - o1.e*o2.b + o1.f*o2.a - o1.g*o2.d + o1.h*o2.c,
        g: o1.a*o2.g + o1.b*o2.h + o1.c*o2.e - o1.d*o2.f - o1.e*o2.c + o1.f*o2.d + o1.g*o2.a - o1.h*o2.b,
        h: o1.a*o2.h - o1.b*o2.g + o1.c*o2.f + o1.d*o2.e - o1.e*o2.d - o1.f*o2.c + o1.g*o2.b + o1.h*o2.a
    }
}

fn abs_f32(x: f32) -> f32 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ============================================================================
// PRINT PRODUCT
// ============================================================================

fn print_product_colored(i: i32, j: i32) {
    let e1 = oct_basis(i)
    let e2 = oct_basis(j)
    let prod = oct_mul(e1, e2)

    var is_negative = 0
    var basis_idx = 0

    if abs_f32(prod.a - 1.0) < 0.01 { basis_idx = 0 }
    if abs_f32(prod.a + 1.0) < 0.01 { basis_idx = 0; is_negative = 1 }

    if abs_f32(prod.b - 1.0) < 0.01 { basis_idx = 1 }
    if abs_f32(prod.b + 1.0) < 0.01 { basis_idx = 1; is_negative = 1 }

    if abs_f32(prod.c - 1.0) < 0.01 { basis_idx = 2 }
    if abs_f32(prod.c + 1.0) < 0.01 { basis_idx = 2; is_negative = 1 }

    if abs_f32(prod.d - 1.0) < 0.01 { basis_idx = 3 }
    if abs_f32(prod.d + 1.0) < 0.01 { basis_idx = 3; is_negative = 1 }

    if abs_f32(prod.e - 1.0) < 0.01 { basis_idx = 4 }
    if abs_f32(prod.e + 1.0) < 0.01 { basis_idx = 4; is_negative = 1 }

    if abs_f32(prod.f - 1.0) < 0.01 { basis_idx = 5 }
    if abs_f32(prod.f + 1.0) < 0.01 { basis_idx = 5; is_negative = 1 }

    if abs_f32(prod.g - 1.0) < 0.01 { basis_idx = 6 }
    if abs_f32(prod.g + 1.0) < 0.01 { basis_idx = 6; is_negative = 1 }

    if abs_f32(prod.h - 1.0) < 0.01 { basis_idx = 7 }
    if abs_f32(prod.h + 1.0) < 0.01 { basis_idx = 7; is_negative = 1 }

    print_colored_basis(basis_idx, is_negative)

    if is_negative == 1 {
        print("-")
    } else {
        print(" ")
    }

    if basis_idx == 0 { print("1 ") }
    if basis_idx == 1 { print("i ") }
    if basis_idx == 2 { print("j ") }
    if basis_idx == 3 { print("k ") }
    if basis_idx == 4 { print("l ") }
    if basis_idx == 5 { print("il") }
    if basis_idx == 6 { print("jl") }
    if basis_idx == 7 { print("kl") }

    color_reset()
}

// ============================================================================
// MAIN: COLORIZED MULTIPLICATION TABLE
// ============================================================================

fn main() -> i32 {
    color_bold()
    color_cyan()
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║   OCTONION MULTIPLICATION TABLE - COLOR VISUALIZATION            ║")
    println("║   8-Dimensional Normed Division Algebra (Fano Plane)             ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    color_reset()
    println("")

    // LEGEND
    color_bold()
    color_yellow()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                         COLOR LEGEND                             ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    color_reset()
    println("")

    print("  ")
    color_bold()
    color_white()
    print("■ 1")
    color_reset()
    print("  = Real (identity)            ")

    print("  ")
    color_bold()
    color_red()
    print("■ i")
    color_reset()
    println("  = First imaginary")

    print("  ")
    color_bold()
    color_green()
    print("■ j")
    color_reset()
    print("  = Second imaginary           ")

    print("  ")
    color_bold()
    color_blue()
    print("■ k")
    color_reset()
    println("  = Third imaginary")

    print("  ")
    color_bold()
    color_yellow()
    print("■ l")
    color_reset()
    print("  = Octonion extension         ")

    print("  ")
    color_bold()
    color_magenta()
    print("■ il")
    color_reset()
    println(" = l×i")

    print("  ")
    color_bold()
    color_cyan()
    print("■ jl")
    color_reset()
    print(" = l×j                        ")

    print("  ")
    color_bold()
    color_white()
    print("■ kl")
    color_reset()
    println(" = l×k")

    println("")
    color_dim()
    println("  (Dimmed = negative values)")
    color_reset()
    println("")

    // TABLE HEADER
    color_bold()
    color_green()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                    MULTIPLICATION TABLE                          ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    color_reset()
    println("")

    print("   ×  │ ")

    print_colored_basis(0, 0)
    print(" 1 ")
    color_reset()
    print("│ ")

    print_colored_basis(1, 0)
    print(" i ")
    color_reset()
    print("│ ")

    print_colored_basis(2, 0)
    print(" j ")
    color_reset()
    print("│ ")

    print_colored_basis(3, 0)
    print(" k ")
    color_reset()
    print("│ ")

    print_colored_basis(4, 0)
    print(" l ")
    color_reset()
    print("│ ")

    print_colored_basis(5, 0)
    print(" il")
    color_reset()
    print("│ ")

    print_colored_basis(6, 0)
    print(" jl")
    color_reset()
    print("│ ")

    print_colored_basis(7, 0)
    print(" kl")
    color_reset()
    println("")

    println("──────┼────┼────┼────┼────┼────┼────┼────┼────")

    // TABLE ROWS
    var row = 0
    while row < 8 {
        print("  ")
        print_colored_basis(row, 0)

        if row == 0 { print("1  ") }
        if row == 1 { print("i  ") }
        if row == 2 { print("j  ") }
        if row == 3 { print("k  ") }
        if row == 4 { print("l  ") }
        if row == 5 { print("il ") }
        if row == 6 { print("jl ") }
        if row == 7 { print("kl ") }

        color_reset()
        print("│")

        var col = 0
        while col < 8 {
            print_product_colored(row, col)
            print("│")
            col = col + 1
        }
        println("")

        row = row + 1
    }

    println("")

    // PROPERTIES
    color_bold()
    color_magenta()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                      KEY PROPERTIES                              ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    color_reset()
    println("")

    print("  ")
    color_red()
    print("Non-commutative:")
    color_reset()
    print(" ")
    color_bold()
    color_red()
    print("i")
    color_reset()
    print("×")
    color_bold()
    color_green()
    print("j")
    color_reset()
    print(" = ")
    color_bold()
    color_blue()
    print("k")
    color_reset()
    print(", but ")
    color_bold()
    color_green()
    print("j")
    color_reset()
    print("×")
    color_bold()
    color_red()
    print("i")
    color_reset()
    print(" = ")
    color_dim()
    color_blue()
    println("-k")
    color_reset()

    print("  ")
    color_yellow()
    print("Non-associative:")
    color_reset()
    print(" (")
    color_bold()
    color_red()
    print("i")
    color_reset()
    print("×")
    color_bold()
    color_green()
    print("j")
    color_reset()
    print(")×")
    color_bold()
    color_yellow()
    print("l")
    color_reset()
    print(" ≠ ")
    color_bold()
    color_red()
    print("i")
    color_reset()
    print("×(")
    color_bold()
    color_green()
    print("j")
    color_reset()
    print("×")
    color_bold()
    color_yellow()
    print("l")
    color_reset()
    println(")")

    print("  ")
    color_green()
    print("Alternative:")
    color_reset()
    print(" (")
    color_bold()
    color_red()
    print("x")
    color_reset()
    print("×")
    color_bold()
    color_red()
    print("x")
    color_reset()
    print(")×")
    color_bold()
    color_green()
    print("y")
    color_reset()
    print(" = ")
    color_bold()
    color_red()
    print("x")
    color_reset()
    print("×(")
    color_bold()
    color_red()
    print("x")
    color_reset()
    print("×")
    color_bold()
    color_green()
    print("y")
    color_reset()
    println(")")

    print("  ")
    color_cyan()
    print("Normed:")
    color_reset()
    println(" |o₁×o₂| = |o₁|×|o₂| (division algebra)")

    println("")

    // FINAL MESSAGE
    color_bold()
    color_cyan()
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║  Sounio: Visualizing 8D algebra with terminal colors!            ║")
    println("║  The Fano plane structure is now visible at a glance!            ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    color_reset()

    return 0
}
