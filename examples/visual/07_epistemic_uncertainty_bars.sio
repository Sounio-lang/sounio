/// Visual Example 7: Epistemic Uncertainty Visualization
///
/// Demonstrates: Color-coded uncertainty quantification with confidence intervals
///
/// Visual Output: Bar charts showing mean ± uncertainty with color gradients
/// - Green: High confidence (low variance)
/// - Yellow: Medium confidence
/// - Red: Low confidence (high variance)

// ============================================================================
// ANSI COLORS
// ============================================================================

fn reset() { print("\x1b[0m") }
fn bold() { print("\x1b[1m") }
fn dim() { print("\x1b[2m") }

fn green() { print("\x1b[32m") }
fn yellow() { print("\x1b[33m") }
fn red() { print("\x1b[31m") }
fn cyan() { print("\x1b[36m") }
fn magenta() { print("\x1b[35m") }
fn white() { print("\x1b[97m") }

fn bg_green() { print("\x1b[42m") }
fn bg_yellow() { print("\x1b[43m") }
fn bg_red() { print("\x1b[41m") }
fn bg_cyan() { print("\x1b[46m") }

// ============================================================================
// NUMERIC HELPERS
// ============================================================================

fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 10 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    return y
}

// ============================================================================
// EPISTEMIC VALUE
// ============================================================================

struct EpistemicValue {
    value: f64,
    variance: f64,
    conf_alpha: f64,
    conf_beta: f64
}

fn epistemic_new(value: f64, variance: f64) -> EpistemicValue {
    return EpistemicValue {
        value: value,
        variance: variance,
        conf_alpha: 1.0,
        conf_beta: 1.0
    }
}

fn epistemic_std(k: EpistemicValue) -> f64 {
    return sqrt_f64(k.variance)
}

fn epistemic_mul(x: EpistemicValue, y: EpistemicValue) -> EpistemicValue {
    let new_variance = y.value * y.value * x.variance + x.value * x.value * y.variance
    return EpistemicValue {
        value: x.value * y.value,
        variance: new_variance,
        conf_alpha: x.conf_alpha + y.conf_alpha - 1.0,
        conf_beta: x.conf_beta + y.conf_beta - 1.0
    }
}

// ============================================================================
// VISUALIZATION HELPERS
// ============================================================================

fn print_confidence_bar(std_dev: f64, max_std: f64) {
    let normalized = std_dev / max_std

    if normalized < 0.3 {
        // High confidence - green
        bg_green()
    }
    if normalized >= 0.3 && normalized < 0.6 {
        // Medium confidence - yellow
        bg_yellow()
    }
    if normalized >= 0.6 {
        // Low confidence - red
        bg_red()
    }

    let bar_length = (std_dev / max_std * 50.0)
    var i = 0
    while i < bar_length {
        print(" ")
        i = i + 1
    }
    reset()
}

fn print_value_bar(value: f64, max_value: f64) {
    bg_cyan()
    let bar_length = (value / max_value * 40.0)
    var i = 0
    while i < bar_length {
        print(" ")
        i = i + 1
    }
    reset()
}

// ============================================================================
// MAIN: UNCERTAINTY VISUALIZATION
// ============================================================================

fn main() -> i32 {
    bold()
    cyan()
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║   EPISTEMIC UNCERTAINTY VISUALIZATION - GUM COMPLIANCE           ║")
    println("║   Color-Coded Confidence Intervals & Variance Propagation        ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    reset()
    println("")

    // SCENARIO: Pharmaceutical dose calculation
    bold()
    yellow()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("          PHARMACEUTICAL DOSE CALCULATION WITH UNCERTAINTY         ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    // MEASUREMENTS
    let weight = epistemic_new(70.0, 4.0)
    let dose_per_kg = epistemic_new(10.0, 0.25)
    let total_dose = epistemic_mul(weight, dose_per_kg)

    println("Measurements:")
    println("")

    // Weight
    print("  Patient weight:  ")
    bold()
    print(weight.value)
    reset()
    print(" kg ± ")
    yellow()
    print(epistemic_std(weight))
    reset()
    println(" kg")

    print("    Uncertainty:   ")
    print_confidence_bar(epistemic_std(weight), 10.0)
    print("  ")
    yellow()
    print(epistemic_std(weight))
    reset()
    println(" kg")
    println("")

    // Dose per kg
    print("  Dose per kg:     ")
    bold()
    print(dose_per_kg.value)
    reset()
    print(" mg/kg ± ")
    green()
    print(epistemic_std(dose_per_kg))
    reset()
    println(" mg/kg")

    print("    Uncertainty:   ")
    print_confidence_bar(epistemic_std(dose_per_kg), 10.0)
    print("  ")
    green()
    print(epistemic_std(dose_per_kg))
    reset()
    println(" mg/kg")
    println("")

    // Total dose (propagated)
    print("  Total dose:      ")
    bold()
    cyan()
    print(total_dose.value)
    reset()
    print(" mg ± ")
    red()
    print(epistemic_std(total_dose))
    reset()
    println(" mg")

    print("    Uncertainty:   ")
    print_confidence_bar(epistemic_std(total_dose), 50.0)
    print("  ")
    red()
    print(epistemic_std(total_dose))
    reset()
    println(" mg (propagated!)")
    println("")

    // UNCERTAINTY LEGEND
    bold()
    magenta()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                    CONFIDENCE LEVELS                             ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    print("  ")
    bg_green()
    print("        ")
    reset()
    green()
    println("  High confidence (σ < 30% of max)")
    reset()

    print("  ")
    bg_yellow()
    print("        ")
    reset()
    yellow()
    println("  Medium confidence (30% ≤ σ < 60%)")
    reset()

    print("  ")
    bg_red()
    print("        ")
    reset()
    red()
    println("  Low confidence (σ ≥ 60%)")
    reset()
    println("")

    // COMPARISON: Multiple scenarios
    bold()
    cyan()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("              SCENARIO COMPARISON (Same Mean, Different σ)        ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    let scenario1 = epistemic_new(100.0, 1.0)
    let scenario2 = epistemic_new(100.0, 25.0)
    let scenario3 = epistemic_new(100.0, 100.0)

    print("  Scenario 1: 100 ± ")
    green()
    print(epistemic_std(scenario1))
    reset()
    print("   ")
    print_confidence_bar(epistemic_std(scenario1), 10.0)
    print("  ")
    green()
    print("HIGH confidence")
    reset()
    println("")

    print("  Scenario 2: 100 ± ")
    yellow()
    print(epistemic_std(scenario2))
    reset()
    print("   ")
    print_confidence_bar(epistemic_std(scenario2), 10.0)
    print("  ")
    yellow()
    print("MEDIUM confidence")
    reset()
    println("")

    print("  Scenario 3: 100 ± ")
    red()
    print(epistemic_std(scenario3))
    reset()
    print("  ")
    print_confidence_bar(epistemic_std(scenario3), 10.0)
    print("  ")
    red()
    print("LOW confidence")
    reset()
    println("")
    println("")

    // VALUE BARS
    bold()
    green()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                 DOSAGE COMPARISON (Multiple Patients)           ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    let patient1 = epistemic_mul(epistemic_new(50.0, 4.0), dose_per_kg)
    let patient2 = epistemic_mul(epistemic_new(70.0, 4.0), dose_per_kg)
    let patient3 = epistemic_mul(epistemic_new(90.0, 4.0), dose_per_kg)

    print("  Patient 1 (50kg): ")
    print_value_bar(patient1.value, 1000.0)
    print(" ")
    bold()
    print(patient1.value)
    reset()
    print(" mg ± ")
    yellow()
    print(epistemic_std(patient1))
    reset()
    println(" mg")

    print("  Patient 2 (70kg): ")
    print_value_bar(patient2.value, 1000.0)
    print(" ")
    bold()
    print(patient2.value)
    reset()
    print(" mg ± ")
    yellow()
    print(epistemic_std(patient2))
    reset()
    println(" mg")

    print("  Patient 3 (90kg): ")
    print_value_bar(patient3.value, 1000.0)
    print(" ")
    bold()
    print(patient3.value)
    reset()
    print(" mg ± ")
    yellow()
    print(epistemic_std(patient3))
    reset()
    println(" mg")

    println("")

    // FINAL MESSAGE
    bold()
    cyan()
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║  ✓ Automatic GUM-compliant uncertainty propagation               ║")
    println("║  ✓ Visual confidence assessment at a glance                      ║")
    println("║  ✓ No external plotting library needed!                          ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    reset()

    return 0
}
