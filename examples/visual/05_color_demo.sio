/// Visual Example 5: ANSI Color Demo - Terminal Colors in Sounio!
///
/// Demonstrates: Real terminal colors using ANSI escape codes
///
/// This example shows that Sounio can produce COLORIZED output using
/// standard ANSI escape sequences - no graphical library needed!
///
/// Colors work in any modern terminal (Linux, macOS, Windows Terminal)

fn main() -> i32 {
    // Basic ANSI colors
    let red = "\x1b[31m"
    let green = "\x1b[32m"
    let yellow = "\x1b[33m"
    let blue = "\x1b[34m"
    let magenta = "\x1b[35m"
    let cyan = "\x1b[36m"
    let white = "\x1b[37m"
    let reset = "\x1b[0m"

    // Bold and backgrounds
    let bold = "\x1b[1m"
    let bg_red = "\x1b[41m"
    let bg_green = "\x1b[42m"
    let bg_yellow = "\x1b[43m"
    let bg_blue = "\x1b[44m"
    let bg_magenta = "\x1b[45m"
    let bg_cyan = "\x1b[46m"

    // TITLE
    print(bold)
    print(cyan)
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║          SOUNIO: TERMINAL COLOR VISUALIZATION                    ║")
    println("║          ASCII Art + ANSI Colors = Beautiful Output!             ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    print(reset)
    println("")

    // FOREGROUND COLORS
    print(bold)
    print(yellow)
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                    FOREGROUND COLORS                             ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print(reset)
    println("")

    print(red)
    println("  █████  Red: Critical/Error messages")
    print(reset)

    print(green)
    println("  █████  Green: Success/Pass indicators")
    print(reset)

    print(yellow)
    println("  █████  Yellow: Warnings/Attention")
    print(reset)

    print(blue)
    println("  █████  Blue: Information/Headers")
    print(reset)

    print(magenta)
    println("  █████  Magenta: Special/Highlighted")
    print(reset)

    print(cyan)
    println("  █████  Cyan: Data/Values")
    print(reset)

    println("")

    // BACKGROUND COLORS (HEATMAP SIMULATION)
    print(bold)
    print(yellow)
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                 HEATMAP SIMULATION                               ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print(reset)
    println("")

    println("  Activation levels (using background colors):")
    println("")

    print("  Low:    ")
    print(bg_blue)
    print("        ")
    print(reset)
    println("")

    print("  Medium: ")
    print(bg_cyan)
    print("        ")
    print(reset)
    println("")

    print("  High:   ")
    print(bg_yellow)
    print("        ")
    print(reset)
    println("")

    print("  Peak:   ")
    print(bg_red)
    print("        ")
    print(reset)
    println("")

    println("")

    // COLORIZED BRAIN MAP (simplified)
    print(bold)
    print(green)
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("            SAMPLE: Colorized Brain Activation Map                ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print(reset)
    println("")

    // Frontal lobe (low activity - blue)
    print("  ")
    print(bg_blue)
    print("                    ")
    print(reset)
    println("")

    print("  ")
    print(bg_blue)
    print("                    ")
    print(reset)
    println("")

    // Motor cortex (medium activity - cyan)
    print("  ")
    print(bg_cyan)
    print("                    ")
    print(reset)
    println("")

    print("  ")
    print(bg_cyan)
    print("                    ")
    print(reset)
    println("")

    // Transition zone
    print("  ")
    print(bg_cyan)
    print("          ")
    print(reset)
    print(bg_yellow)
    print("          ")
    print(reset)
    println("")

    // Visual cortex (high activity - yellow/red)
    print("  ")
    print(bg_yellow)
    print("                    ")
    print(reset)
    println("")

    print("  ")
    print(bg_yellow)
    print("                    ")
    print(reset)
    println("")

    print("  ")
    print(bg_red)
    print("                    ")
    print(reset)
    print("  ")
    print(red)
    println("← Peak activation!")
    print(reset)

    print("  ")
    print(bg_red)
    print("                    ")
    print(reset)
    println("")

    println("")

    // STYLED OUTPUT
    print(bold)
    print(magenta)
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                   SCIENTIFIC APPLICATIONS                        ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print(reset)
    println("")

    print("  ")
    print(green)
    print("✓")
    print(reset)
    println(" Data validation results")

    print("  ")
    print(red)
    print("✗")
    print(reset)
    println(" Failed test cases")

    print("  ")
    print(yellow)
    print("⚠")
    print(reset)
    println(" Uncertainty warnings")

    print("  ")
    print(cyan)
    print("ⓘ")
    print(reset)
    println(" Statistical summaries")

    print("  ")
    print(magenta)
    print("★")
    print(reset)
    println(" Significant findings")

    println("")

    // FINAL MESSAGE
    print(bold)
    print(cyan)
    println("╔═══════════════════════════════════════════════════════════════════╗")
    print("║  ")
    print(green)
    print("SUCCESS:")
    print(cyan)
    println(" Sounio supports full terminal color output!        ║")
    print("║  Perfect for: ")
    print(yellow)
    print("Heatmaps")
    print(reset)
    print(bold)
    print(cyan)
    print(", ")
    print(magenta)
    print("Graphs")
    print(reset)
    print(bold)
    print(cyan)
    print(", ")
    print(red)
    print("Alerts")
    print(reset)
    print(bold)
    print(cyan)
    print(", ")
    print(green)
    print("Dashboards")
    print(cyan)
    println("      ║")
    println("║  No GUI library needed - pure ANSI escape sequences!         ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    print(reset)

    return 0
}
