/// Visual Example 9: PK/PD Concentration-Time Curves - Color Edition
///
/// Demonstrates: Drug pharmacokinetics with color-coded phases
///
/// Visual Output: ASCII time-series curves showing:
/// - Absorption phase (GREEN - increasing concentration)
/// - Distribution phase (YELLOW - equilibration)
/// - Elimination phase (RED - declining concentration)
/// - Therapeutic window (CYAN background bars)

// ============================================================================
// ANSI COLORS
// ============================================================================

fn reset() { print("\x1b[0m") }
fn bold() { print("\x1b[1m") }
fn dim() { print("\x1b[2m") }

fn red() { print("\x1b[31m") }
fn green() { print("\x1b[32m") }
fn yellow() { print("\x1b[33m") }
fn blue() { print("\x1b[34m") }
fn magenta() { print("\x1b[35m") }
fn cyan() { print("\x1b[36m") }
fn white() { print("\x1b[97m") }

fn bg_red() { print("\x1b[41m") }
fn bg_green() { print("\x1b[42m") }
fn bg_yellow() { print("\x1b[43m") }
fn bg_blue() { print("\x1b[44m") }
fn bg_cyan() { print("\x1b[46m") }
fn bg_white() { print("\x1b[47m") }

// ============================================================================
// MATH HELPERS
// ============================================================================

fn exp_f64(x: f64) -> f64 {
    if x > 10.0 { return 22026.465794806718 * exp_f64(x - 10.0) }
    if x < 0.0 - 10.0 { return 0.00004539992976248485 * exp_f64(x + 10.0) }
    var result = 1.0
    var term = 1.0
    var nf = 1.0
    var n = 1
    while n < 20 {
        term = term * x / nf
        result = result + term
        n = n + 1
        nf = nf + 1.0
    }
    return result
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { return a }
    return b
}

// ============================================================================
// PHARMACOKINETIC MODEL
// ============================================================================

/// One-compartment oral absorption model
/// C(t) = (ka*D/Vd) * (exp(-ke*t) - exp(-ka*t)) / (ka - ke)
fn pk_concentration(t: f64, dose: f64, vd: f64, ka: f64, ke: f64) -> f64 {
    let factor = (ka * dose / vd) / (ka - ke)
    let c_elim = exp_f64(0.0 - ke * t)
    let c_absorb = exp_f64(0.0 - ka * t)
    return factor * (c_elim - c_absorb)
}

/// Determine PK phase based on concentration and time
/// Returns: 0 = absorption, 1 = distribution, 2 = elimination
fn determine_phase(c: f64, c_max: f64, t: f64, t_max: f64) -> i32 {
    if t < t_max {
        return 0  // Absorption (rising)
    }
    if t < t_max * 2.0 && c > c_max * 0.7 {
        return 1  // Distribution (plateau)
    }
    return 2  // Elimination (falling)
}

// ============================================================================
// VISUALIZATION
// ============================================================================

fn print_concentration_bar(conc: f64, max_conc: f64, phase: i32, in_window: i32) {
    // Background for therapeutic window
    if in_window == 1 {
        bg_cyan()
        print(" ")
        reset()
    }

    // Phase color
    if phase == 0 { green() }      // Absorption
    if phase == 1 { yellow() }     // Distribution
    if phase == 2 { red() }        // Elimination

    let bar_len = (conc / max_conc * 60.0)
    var i = 0
    while i < bar_len {
        print("█")
        i = i + 1
    }
    reset()
}

fn print_phase_label(phase: i32) {
    if phase == 0 {
        green()
        print(" [ABSORPTION]")
    }
    if phase == 1 {
        yellow()
        print(" [DISTRIBUTION]")
    }
    if phase == 2 {
        red()
        print(" [ELIMINATION]")
    }
    reset()
}

// ============================================================================
// MAIN: PK/PD VISUALIZATION
// ============================================================================

fn main() -> i32 {
    bold()
    magenta()
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║    PHARMACOKINETIC CONCENTRATION-TIME CURVE VISUALIZATION        ║")
    println("║    Midazolam 7.5mg Oral - One-Compartment Model                 ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    reset()
    println("")

    // Midazolam PK parameters
    let dose = 7.5      // mg
    let vd = 77.0       // L (volume of distribution)
    let cl = 27.0       // L/h (clearance)
    let ka = 1.5        // /h (absorption rate constant)
    let ke = cl / vd    // /h (elimination rate constant = 0.35)

    // Therapeutic window
    let c_min = 20.0    // ng/mL (minimum effective)
    let c_max_safe = 80.0  // ng/mL (maximum safe)

    // Time to peak concentration: t_max = ln(ka/ke) / (ka - ke)
    let t_max = 1.6  // hours (approximately for these parameters)

    bold()
    cyan()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                    PHARMACOKINETIC PARAMETERS                    ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    print("  Dose:                  ")
    bold()
    print(dose)
    reset()
    println(" mg")

    print("  Volume of distribution:")
    bold()
    print(vd)
    reset()
    println(" L")

    print("  Clearance:             ")
    bold()
    print(cl)
    reset()
    println(" L/h")

    print("  Absorption rate (ka):  ")
    green()
    bold()
    print(ka)
    reset()
    println(" /h")

    print("  Elimination rate (ke): ")
    red()
    bold()
    print(ke)
    reset()
    println(" /h")

    print("  Half-life (t½):        ")
    yellow()
    bold()
    print(0.693 / ke)
    reset()
    println(" h")

    println("")
    print("  Therapeutic window:    ")
    cyan()
    print(c_min)
    reset()
    print(" - ")
    cyan()
    print(c_max_safe)
    reset()
    println(" ng/mL")

    println("")

    // Find peak concentration
    let c_peak = pk_concentration(t_max, dose, vd, ka, ke)

    bold()
    yellow()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                CONCENTRATION-TIME PROFILE (0-12h)                ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    // Legend
    print("  ")
    green()
    print("██")
    reset()
    print(" Absorption   ")

    yellow()
    print("██")
    reset()
    print(" Distribution   ")

    red()
    print("██")
    reset()
    print(" Elimination   ")

    bg_cyan()
    print(" ")
    reset()
    println(" Therapeutic window")
    println("")

    // Plot concentration curve at 30-minute intervals
    var t = 0.0
    while t <= 12.0 {
        let c = pk_concentration(t, dose, vd, ka, ke)
        let phase = determine_phase(c, c_peak, t, t_max)
        let in_window = if c >= c_min && c <= c_max_safe { 1 } else { 0 }

        // Time label
        print("  ")
        if t < 10.0 { print(" ") }  // Padding
        bold()
        white()
        print(t)
        reset()
        print("h │ ")

        // Concentration bar
        print_concentration_bar(c, c_peak, phase, in_window)

        // Numerical value
        print("  ")
        if phase == 0 { green() }
        if phase == 1 { yellow() }
        if phase == 2 { red() }
        bold()
        print(c)
        reset()
        print(" ng/mL")

        // Phase label
        print_phase_label(phase)

        println("")
        t = t + 0.5
    }

    println("")

    bold()
    blue()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                    CLINICAL INTERPRETATION                      ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    print("  Peak concentration (C_max): ")
    bold()
    yellow()
    print(c_peak)
    reset()
    println(" ng/mL")

    print("  Time to peak (T_max):       ")
    bold()
    yellow()
    print(t_max)
    reset()
    println(" h")

    let c_12h = pk_concentration(12.0, dose, vd, ka, ke)
    print("  Concentration at 12h:       ")
    red()
    print(c_12h)
    reset()
    println(" ng/mL")

    println("")

    green()
    println("  ✓ Rapid absorption phase (0-1.6h)")
    reset()
    yellow()
    println("  ✓ Brief distribution/equilibration (1.6-3h)")
    reset()
    red()
    println("  ✓ Prolonged elimination phase (3-12h)")
    reset()
    cyan()
    println("  ✓ Concentration remains therapeutic for ~4 hours")
    reset()

    println("")

    bold()
    magenta()
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║  Color-coded PK phases make complex dynamics visible             ║")
    println("║  Therapeutic window assessment at a glance                       ║")
    println("║  No plotting library needed - pure terminal output!              ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    reset()

    return 0
}
