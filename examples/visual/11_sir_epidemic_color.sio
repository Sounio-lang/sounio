/// Visual Example 11: SIR Epidemic Model - Color Edition
///
/// Demonstrates: Disease dynamics with color-coded populations
///
/// Visual Output: SIR compartmental model over time
/// - BLUE: Susceptible population (not yet infected)
/// - RED: Infectious population (actively spreading)
/// - GREEN: Recovered population (immune)
/// - Stacked bars showing population composition

// ============================================================================
// ANSI COLORS
// ============================================================================

fn reset() { print("\x1b[0m") }
fn bold() { print("\x1b[1m") }
fn dim() { print("\x1b[2m") }

fn red() { print("\x1b[31m") }
fn green() { print("\x1b[32m") }
fn yellow() { print("\x1b[33m") }
fn blue() { print("\x1b[34m") }
fn magenta() { print("\x1b[35m") }
fn cyan() { print("\x1b[36m") }
fn white() { print("\x1b[97m") }

fn bg_red() { print("\x1b[41m") }
fn bg_green() { print("\x1b[42m") }
fn bg_yellow() { print("\x1b[43m") }
fn bg_blue() { print("\x1b[44m") }
fn bg_cyan() { print("\x1b[46m") }

// ============================================================================
// SIR MODEL
// ============================================================================

struct SIRState {
    s: f64,  // Susceptible
    i: f64,  // Infectious
    r: f64   // Recovered
}

struct SIRParams {
    beta: f64,   // Transmission rate
    gamma: f64   // Recovery rate
}

/// SIR differential equations:
/// dS/dt = -β·S·I/N
/// dI/dt = β·S·I/N - γ·I
/// dR/dt = γ·I
fn sir_derivative(state: SIRState, params: SIRParams, n: f64) -> SIRState {
    let infection_rate = params.beta * state.s * state.i / n
    let recovery_rate = params.gamma * state.i

    return SIRState {
        s: 0.0 - infection_rate,
        i: infection_rate - recovery_rate,
        r: recovery_rate
    }
}

/// Euler method integration step
fn sir_step(state: SIRState, params: SIRParams, n: f64, dt: f64) -> SIRState {
    let deriv = sir_derivative(state, params, n)
    return SIRState {
        s: state.s + deriv.s * dt,
        i: state.i + deriv.i * dt,
        r: state.r + deriv.r * dt
    }
}

/// Calculate R0 (basic reproduction number)
fn calculate_r0(params: SIRParams) -> f64 {
    return params.beta / params.gamma
}

// ============================================================================
// VISUALIZATION
// ============================================================================

fn print_population_bar(s: f64, i: f64, r: f64, total: f64) {
    let bar_width = 60.0

    // Susceptible (blue)
    bg_blue()
    let s_len = (s / total * bar_width)
    var j = 0
    while j < s_len {
        print(" ")
        j = j + 1
    }
    reset()

    // Infectious (red)
    bg_red()
    let i_len = (i / total * bar_width)
    j = 0
    while j < i_len {
        print(" ")
        j = j + 1
    }
    reset()

    // Recovered (green)
    bg_green()
    let r_len = (r / total * bar_width)
    j = 0
    while j < r_len {
        print(" ")
        j = j + 1
    }
    reset()
}

fn print_phase_indicator(i: f64, peak: f64) {
    if i < peak * 0.1 {
        cyan()
        print(" [EARLY GROWTH]")
    }
    if i >= peak * 0.1 && i < peak * 0.7 {
        yellow()
        print(" [ACCELERATION]")
    }
    if i >= peak * 0.7 && i <= peak {
        red()
        bold()
        print(" [PEAK APPROACH]")
    }
    if i < peak && i >= peak * 0.7 {
        yellow()
        print(" [DECELERATION]")
    }
    reset()
}

// ============================================================================
// MAIN: SIR EPIDEMIC VISUALIZATION
// ============================================================================

fn main() -> i32 {
    bold()
    magenta()
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║       SIR EPIDEMIC MODEL - Disease Dynamics Visualization        ║")
    println("║       COVID-19-like Parameters (R₀ = 2.5)                        ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    reset()
    println("")

    // Parameters (COVID-19-like)
    let params = SIRParams {
        beta: 0.5,    // Transmission rate (/day)
        gamma: 0.2    // Recovery rate (/day, ~5 day infectious period)
    }

    let r0 = calculate_r0(params)
    let n = 1000.0    // Total population
    let dt = 0.5      // Time step (days)

    // Initial conditions
    var state = SIRState {
        s: 990.0,     // 99% susceptible
        i: 10.0,      // 1% initially infected
        r: 0.0        // No recovered yet
    }

    bold()
    cyan()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                     EPIDEMIC PARAMETERS                          ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    print("  Population (N):          ")
    bold()
    print(n)
    reset()
    println(" people")

    print("  Transmission rate (β):   ")
    red()
    bold()
    print(params.beta)
    reset()
    println(" /day")

    print("  Recovery rate (γ):       ")
    green()
    bold()
    print(params.gamma)
    reset()
    println(" /day")

    print("  Infectious period:       ")
    yellow()
    bold()
    print(1.0 / params.gamma)
    reset()
    println(" days")

    print("  Basic reproduction (R₀): ")
    if r0 > 2.0 {
        red()
    }
    if r0 > 1.0 && r0 <= 2.0 {
        yellow()
    }
    if r0 <= 1.0 {
        green()
    }
    bold()
    print(r0)
    reset()
    if r0 > 1.0 {
        red()
        print(" (EPIDEMIC)")
    }
    if r0 <= 1.0 {
        green()
        print(" (CONTROLLED)")
    }
    reset()
    println("")

    println("")

    // Find peak by simulating ahead
    var temp_state = state
    var t_sim = 0.0
    var peak_i = state.i
    while t_sim <= 100.0 {
        temp_state = sir_step(temp_state, params, n, dt)
        if temp_state.i > peak_i {
            peak_i = temp_state.i
        }
        t_sim = t_sim + dt
    }

    bold()
    yellow()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                EPIDEMIC TIME COURSE (0-50 days)                 ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    // Legend
    print("  ")
    bg_blue()
    print("  ")
    reset()
    blue()
    print(" Susceptible  ")
    reset()

    bg_red()
    print("  ")
    reset()
    red()
    print(" Infectious  ")
    reset()

    bg_green()
    print("  ")
    reset()
    green()
    println(" Recovered")
    reset()
    println("")

    // Simulate and visualize
    var t = 0.0
    var peak_reached = 0

    while t <= 50.0 {
        // Print time
        print("  Day ")
        if t < 10.0 { print(" ") }
        bold()
        white()
        print(t)
        reset()
        print(" │ ")

        // Population bar
        print_population_bar(state.s, state.i, state.r, n)

        // Numbers
        print("  ")
        blue()
        print("S:")
        print(state.s)
        reset()
        print(" ")
        red()
        print("I:")
        print(state.i)
        reset()
        print(" ")
        green()
        print("R:")
        print(state.r)
        reset()

        // Peak detection
        if state.i >= peak_i * 0.95 && peak_reached == 0 {
            red()
            bold()
            print(" ← PEAK")
            reset()
            peak_reached = 1
        }

        println("")

        // Update state
        state = sir_step(state, params, n, dt)
        t = t + 2.0  // Print every 2 days
    }

    println("")

    // Final statistics
    bold()
    green()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                     EPIDEMIC SUMMARY                             ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    print("  Peak infections:         ")
    red()
    bold()
    print(peak_i)
    reset()
    print(" people (")
    red()
    print(peak_i / n * 100.0)
    reset()
    println("% of population)")

    print("  Final recovered:         ")
    green()
    bold()
    print(state.r)
    reset()
    print(" people (")
    green()
    print(state.r / n * 100.0)
    reset()
    println("% attack rate)")

    print("  Final susceptible:       ")
    blue()
    print(state.s)
    reset()
    println(" people (escaped infection)")

    println("")

    bold()
    white()
    println("  Key insights:")
    reset()
    cyan()
    println("    • R₀ = 2.5 means each infected person infects 2-3 others")
    reset()
    cyan()
    println("    • Peak infections occur when S ≈ N/R₀ (herd immunity threshold)")
    reset()
    cyan()
    println("    • Final size depends on R₀: higher R₀ → more total infections")
    reset()
    cyan()
    println("    • Recovery (green) grows as infectious (red) declines")
    reset()

    println("")

    bold()
    magenta()
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║  ✓ Compartmental model dynamics visualized with stacked bars     ║")
    println("║  ✓ Epidemic phases color-coded (growth → peak → decline)         ║")
    println("║  ✓ Classic SIR model - foundation of epidemiology!               ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    reset()

    return 0
}
