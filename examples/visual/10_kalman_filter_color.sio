/// Visual Example 10: Bayesian Sensor Fusion with Kalman Filter - Color Edition
///
/// Demonstrates: Sequential belief updates with color-coded uncertainty
///
/// Visual Output: Uncertainty reduction visualization
/// - RED: High uncertainty (low precision)
/// - YELLOW: Medium uncertainty
/// - GREEN: Low uncertainty (high precision)
/// - CYAN: Precision bars showing 1/σ²

// ============================================================================
// ANSI COLORS
// ============================================================================

fn reset() { print("\x1b[0m") }
fn bold() { print("\x1b[1m") }
fn dim() { print("\x1b[2m") }

fn red() { print("\x1b[31m") }
fn green() { print("\x1b[32m") }
fn yellow() { print("\x1b[33m") }
fn blue() { print("\x1b[34m") }
fn magenta() { print("\x1b[35m") }
fn cyan() { print("\x1b[36m") }
fn white() { print("\x1b[97m") }

fn bg_red() { print("\x1b[41m") }
fn bg_green() { print("\x1b[42m") }
fn bg_yellow() { print("\x1b[43m") }
fn bg_blue() { print("\x1b[44m") }
fn bg_cyan() { print("\x1b[46m") }

// ============================================================================
// MATH HELPERS
// ============================================================================

fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 10 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    return y
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ============================================================================
// EPISTEMIC VALUE (BELIEF STATE)
// ============================================================================

struct EpistemicValue {
    value: f64,
    variance: f64
}

fn epistemic_new(value: f64, variance: f64) -> EpistemicValue {
    return EpistemicValue {
        value: value,
        variance: variance
    }
}

fn epistemic_std(k: EpistemicValue) -> f64 {
    return sqrt_f64(k.variance)
}

fn epistemic_precision(k: EpistemicValue) -> f64 {
    if k.variance <= 0.0000001 { return 10000.0 }
    return 1.0 / k.variance
}

// ============================================================================
// KALMAN UPDATE (PRECISION-WEIGHTED BAYESIAN FUSION)
// ============================================================================

/// Kalman filter update: combines prior belief with new measurement
///
/// Precision-weighted mean:
///   μ_post = (τ_prior * μ_prior + τ_meas * z) / (τ_prior + τ_meas)
///   where τ = 1/σ² (precision)
///
/// Posterior precision (information addition):
///   τ_post = τ_prior + τ_meas
///   σ²_post = 1 / (1/σ²_prior + 1/σ²_meas)
///
fn kalman_update(prior: EpistemicValue, measurement: EpistemicValue) -> EpistemicValue {
    let tau_prior = epistemic_precision(prior)
    let tau_meas = epistemic_precision(measurement)
    let tau_post = tau_prior + tau_meas

    let mu_post = (tau_prior * prior.value + tau_meas * measurement.value) / tau_post
    let var_post = 1.0 / tau_post

    return epistemic_new(mu_post, var_post)
}

// ============================================================================
// VISUALIZATION HELPERS
// ============================================================================

fn uncertainty_color(std_dev: f64) {
    if std_dev < 2.0 {
        green()
    }
    if std_dev >= 2.0 && std_dev < 5.0 {
        yellow()
    }
    if std_dev >= 5.0 {
        red()
    }
}

fn print_uncertainty_bar(std_dev: f64, max_std: f64) {
    let normalized = std_dev / max_std

    if normalized < 0.2 { bg_green() }
    if normalized >= 0.2 && normalized < 0.5 { bg_yellow() }
    if normalized >= 0.5 { bg_red() }

    let bar_len = (std_dev / max_std * 40.0)
    var i = 0
    while i < bar_len {
        print(" ")
        i = i + 1
    }
    reset()
}

fn print_precision_bar(precision: f64, max_precision: f64) {
    bg_cyan()
    let bar_len = (precision / max_precision * 40.0)
    var i = 0
    while i < bar_len {
        print(" ")
        i = i + 1
    }
    reset()
}

fn print_confidence_level(std_dev: f64) {
    if std_dev < 2.0 {
        green()
        bold()
        print("HIGH")
    }
    if std_dev >= 2.0 && std_dev < 5.0 {
        yellow()
        bold()
        print("MEDIUM")
    }
    if std_dev >= 5.0 {
        red()
        bold()
        print("LOW")
    }
    reset()
}

// ============================================================================
// MAIN: KALMAN FILTER VISUALIZATION
// ============================================================================

fn main() -> i32 {
    bold()
    blue()
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║   KALMAN FILTER: BAYESIAN SENSOR FUSION VISUALIZATION            ║")
    println("║   Sequential Belief Updates with Uncertainty Reduction           ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    reset()
    println("")

    bold()
    magenta()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                    SENSOR FUSION SCENARIO                        ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    println("  Task: Estimate robot position from multiple noisy sensors")
    println("")
    println("  Sensors:")
    println("    1. Prior belief (uniform/uninformative)")
    println("    2. GPS measurement (low precision, σ = 5m)")
    println("    3. IMU measurement (high precision, σ = 0.5m)")
    println("    4. Lidar measurement (very high precision, σ = 0.1m)")
    println("")

    // Initial prior (uninformative)
    let prior = epistemic_new(0.0, 100.0)  // 0m ± 10m (very uncertain)

    // Sensor measurements
    let gps = epistemic_new(5.2, 25.0)     // 5.2m ± 5m
    let imu = epistemic_new(5.1, 0.25)     // 5.1m ± 0.5m
    let lidar = epistemic_new(5.05, 0.01)  // 5.05m ± 0.1m

    let max_std = epistemic_std(prior)
    let final_state = kalman_update(kalman_update(kalman_update(prior, gps), imu), lidar)
    let max_precision = epistemic_precision(final_state)

    bold()
    yellow()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                SEQUENTIAL BELIEF UPDATES                         ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    // Color legend
    print("  Uncertainty: ")
    bg_green()
    print("  ")
    reset()
    green()
    print(" Low (σ < 2m)  ")
    reset()

    bg_yellow()
    print("  ")
    reset()
    yellow()
    print(" Medium (2-5m)  ")
    reset()

    bg_red()
    print("  ")
    reset()
    red()
    println(" High (σ > 5m)")
    reset()

    println("")

    // STEP 0: Prior
    print("  [PRIOR]         μ = ")
    bold()
    print(prior.value)
    reset()
    print(" m, σ = ")
    uncertainty_color(epistemic_std(prior))
    bold()
    print(epistemic_std(prior))
    reset()
    print(" m  ")
    print_uncertainty_bar(epistemic_std(prior), max_std)
    print("  ")
    print_confidence_level(epistemic_std(prior))
    println("")

    print("                  Precision: ")
    cyan()
    print(epistemic_precision(prior))
    reset()
    print("  ")
    print_precision_bar(epistemic_precision(prior), max_precision)
    println("")
    println("")

    // STEP 1: GPS fusion
    let state1 = kalman_update(prior, gps)

    print("  [+ GPS]         μ = ")
    bold()
    print(state1.value)
    reset()
    print(" m, σ = ")
    uncertainty_color(epistemic_std(state1))
    bold()
    print(epistemic_std(state1))
    reset()
    print(" m  ")
    print_uncertainty_bar(epistemic_std(state1), max_std)
    print("  ")
    print_confidence_level(epistemic_std(state1))
    println("")

    print("                  Precision: ")
    cyan()
    print(epistemic_precision(state1))
    reset()
    print("  ")
    print_precision_bar(epistemic_precision(state1), max_precision)
    println("")

    let reduction1 = (epistemic_std(prior) - epistemic_std(state1)) / epistemic_std(prior) * 100.0
    print("                  Uncertainty reduction: ")
    green()
    bold()
    print(reduction1)
    reset()
    println("%")
    println("")

    // STEP 2: IMU fusion
    let state2 = kalman_update(state1, imu)

    print("  [+ IMU]         μ = ")
    bold()
    print(state2.value)
    reset()
    print(" m, σ = ")
    uncertainty_color(epistemic_std(state2))
    bold()
    print(epistemic_std(state2))
    reset()
    print(" m  ")
    print_uncertainty_bar(epistemic_std(state2), max_std)
    print("  ")
    print_confidence_level(epistemic_std(state2))
    println("")

    print("                  Precision: ")
    cyan()
    print(epistemic_precision(state2))
    reset()
    print("  ")
    print_precision_bar(epistemic_precision(state2), max_precision)
    println("")

    let reduction2 = (epistemic_std(state1) - epistemic_std(state2)) / epistemic_std(state1) * 100.0
    print("                  Uncertainty reduction: ")
    green()
    bold()
    print(reduction2)
    reset()
    println("%")
    println("")

    // STEP 3: Lidar fusion
    let state3 = kalman_update(state2, lidar)

    print("  [+ LIDAR]       μ = ")
    bold()
    print(state3.value)
    reset()
    print(" m, σ = ")
    uncertainty_color(epistemic_std(state3))
    bold()
    print(epistemic_std(state3))
    reset()
    print(" m  ")
    print_uncertainty_bar(epistemic_std(state3), max_std)
    print("  ")
    print_confidence_level(epistemic_std(state3))
    println("")

    print("                  Precision: ")
    cyan()
    print(epistemic_precision(state3))
    reset()
    print("  ")
    print_precision_bar(epistemic_precision(state3), max_precision)
    println("")

    let reduction3 = (epistemic_std(state2) - epistemic_std(state3)) / epistemic_std(state2) * 100.0
    print("                  Uncertainty reduction: ")
    green()
    bold()
    print(reduction3)
    reset()
    println("%")
    println("")

    // Summary
    bold()
    green()
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    println("                      FUSION SUMMARY                              ")
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    reset()
    println("")

    print("  Final position estimate:   ")
    bold()
    cyan()
    print(state3.value)
    reset()
    print(" m ± ")
    green()
    bold()
    print(epistemic_std(state3))
    reset()
    println(" m")

    let total_reduction = (epistemic_std(prior) - epistemic_std(state3)) / epistemic_std(prior) * 100.0
    print("  Total uncertainty reduction: ")
    green()
    bold()
    print(total_reduction)
    reset()
    println("%")

    let precision_gain = epistemic_precision(state3) / epistemic_precision(prior)
    print("  Precision gain:              ")
    cyan()
    bold()
    print(precision_gain)
    reset()
    println("×")

    println("")

    bold()
    white()
    println("  Key insights:")
    reset()
    cyan()
    println("    • Precision adds: 1/σ²_final = 1/σ²_prior + 1/σ²_GPS + 1/σ²_IMU + 1/σ²_Lidar")
    reset()
    cyan()
    println("    • High-precision sensors (Lidar, IMU) dominate the final estimate")
    reset()
    cyan()
    println("    • GPS provides coarse initial constraint despite low precision")
    reset()
    cyan()
    println("    • Uncertainty monotonically decreases with each fusion step")
    reset()

    println("")

    bold()
    blue()
    println("╔═══════════════════════════════════════════════════════════════════╗")
    println("║  ✓ Kalman gain (precision weighting) visualized through color    ║")
    println("║  ✓ Information fusion shown as precision bars                    ║")
    println("║  ✓ Bayesian belief propagation made intuitive!                   ║")
    println("╚═══════════════════════════════════════════════════════════════════╝")
    reset()

    return 0
}
