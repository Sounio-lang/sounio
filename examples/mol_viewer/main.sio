// examples/mol_viewer/main.sio — Interactive 3D molecular viewer
//
// Drag the mouse to rotate the molecule.
// Shows rapamycin (sirolimus, C₅₁H₇₉NO₁₃) coarse scaffold with CPK colouring.
// Press ESC or close the window to quit.

use display::window::{Window, window_open, window_set_title, window_present, window_pending,
                       window_next_event, window_close}
use display::canvas::{Canvas, canvas_from_window, canvas_clear, canvas_fill_rect}
use display::event::{EV_CLOSE, EV_KEY_PRESS, EV_MOTION, EV_MOUSE_PRESS, EV_MOUSE_RELEASE,
                     KEY_ESCAPE, MOUSE_LEFT}
use display::font::{font_draw_string}
use render::renderer3d::{Camera3D}
use viz::mol3d::{mol3d_render_ao, mol3d_precompute_ao}
use viz::physchem::{MoleculeViz, molecule_rapamycin_coarse}

fn main() with IO, Alloc, Mut, Div {
    let W: i64 = 640
    let H: i64 = 480

    var title: [i8; 128] = [0; 128]
    title[0] = 83    // S
    title[1] = 111   // o
    title[2] = 117   // u
    title[3] = 110   // n
    title[4] = 105   // i
    title[5] = 111   // o
    title[6] = 32    //
    title[7] = 77    // M
    title[8] = 111   // o
    title[9] = 108   // l
    let title_len: i64 = 10

    var win = window_open(W, H)
    window_set_title(&!win, &title, title_len)

    // Camera at pos_z=+25; renderer looks in -z, so atoms at world_z≈0 give
    // rz = 0 - 25 = -25 → visible, depth=25, scale=400/25=16 px/Å.
    // Rapamycin ring spans ~13 Å → ~208 px (fits 640 wide window).
    let cam = Camera3D { pos_x: 0.0, pos_y: 0.0, pos_z: 25.0, focal: 400.0 }

    let mol = molecule_rapamycin_coarse()

    var ao: [f64; 64] = [0.0; 64]
    mol3d_precompute_ao(&mol, &!ao)

    var angle_y: f64 = 0.0
    var angle_x: f64 = 0.1

    var drag_active = false
    var last_x: i64 = 0
    var last_y: i64 = 0

    // HUD label: "Rapamycin   drag to rotate"
    var hud: [i8; 256] = [0; 256]
    hud[0]  = 82    // R
    hud[1]  = 97    // a
    hud[2]  = 112   // p
    hud[3]  = 97    // a
    hud[4]  = 109   // m
    hud[5]  = 121   // y
    hud[6]  = 99    // c
    hud[7]  = 105   // i
    hud[8]  = 110   // n
    hud[9]  = 32    //
    hud[10] = 32    //
    hud[11] = 32    //
    hud[12] = 100   // d
    hud[13] = 114   // r
    hud[14] = 97    // a
    hud[15] = 103   // g
    hud[16] = 32    //
    hud[17] = 116   // t
    hud[18] = 111   // o
    hud[19] = 32    //
    hud[20] = 114   // r
    hud[21] = 111   // o
    hud[22] = 116   // t
    hud[23] = 97    // a
    hud[24] = 116   // t
    hud[25] = 101   // e
    let hud_len: i64 = 26

    var running = true
    while running {
        while window_pending(&!win) > 0 {
            let ev = window_next_event(&!win)
            if ev.kind == EV_CLOSE { running = false }
            if ev.kind == EV_KEY_PRESS && ev.key == KEY_ESCAPE { running = false }
            if ev.kind == EV_MOUSE_PRESS && ev.key == MOUSE_LEFT {
                drag_active = true
                last_x = ev.x
                last_y = ev.y
            }
            if ev.kind == EV_MOUSE_RELEASE { drag_active = false }
            if ev.kind == EV_MOTION && drag_active {
                let dx = ev.x - last_x
                let dy = ev.y - last_y
                angle_y = angle_y + (dx as f64) * 0.012
                angle_x = angle_x + (dy as f64) * 0.012
                // Wrap Y, clamp X
                if angle_y > 6.28318 { angle_y = angle_y - 6.28318 }
                if angle_y < 0.0 { angle_y = angle_y + 6.28318 }
                if angle_x > 1.5 { angle_x = 1.5 }
                if angle_x < 0.0 - 1.5 { angle_x = 0.0 - 1.5 }
                last_x = ev.x
                last_y = ev.y
            }
        }

        var c = canvas_from_window(&!win)
        canvas_clear(&!c, 10, 12, 20)

        mol3d_render_ao(&mol, &cam, angle_y, angle_x, &ao, &!c)

        // HUD
        font_draw_string(c.pixels, c.width, c.height, &hud, hud_len, 8, 8, 160, 200, 255)

        window_present(&!win)
    }

    window_close(&!win)
}
