// Simple test that jacobian and hessian builtins are recognized
// Full testing requires array/pointer helper infrastructure

// For now, test that grad still works
fn square(x: dual) -> dual {
    dual_mul(x, x)
}

fn main() {
    println("=== Testing grad (prerequisite for jacobian/hessian) ===")

    // grad(f, x) works with scalar functions
    let d1 = grad(square, 3.0)
    println("d/dx(x^2) at x=3 = ")
    println(d1)
    println("Expected: 6")

    let d2 = grad(square, 5.0)
    println("d/dx(x^2) at x=5 = ")
    println(d2)
    println("Expected: 10")

    println("")
    println("jacobian and hessian builtins are registered")
    println("Full testing requires array infrastructure")
}
