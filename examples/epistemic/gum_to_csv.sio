// GUM measurement -> byte-exact CSV row (Data & Science I/O, Trilha A).
//
// This is the vertical's headline: an epistemic quantity (value + combined
// standard uncertainty, ISO-GUM) flowing out as a tabular record a downstream
// tool can read. It reproduces the frozen numbers of the GUM run-proof
// (tests/stdlib/epistemic/test_gum_stdlib.sio): recovery = 98.3 %, combined
// u_c = 0.290402, k95 = 1.960, U95 = 0.569188.
//
// It imports ONLY epistemic::gum. It cannot also `use data::csv` and reuse
// csv_field_f64 in the same binary: a program with two dependency modules fails
// native emission on Madaros v0.80.0 ("multimodule native thin-link compilation
// failed", rc=12) — the same compiler-owned blocker tracked for Trilha B in
// docs/audit/DATA_IO_LANE_COMPILER_BLOCKER_2026-07-13.md. So the fixed-point
// formatting is inlined here (byte-for-byte identical rules to data::csv). When
// the multimodule native path is repaired, this collapses to csv_field_f64 calls.
use epistemic::gum::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let ub = gum_type_b_uniform(0.5)
    let ua = gum_type_a(0.070710, 5)
    let r = gum_combine2(98.3, ua, ub)

    var vals: [f64; 4] = [0.0; 4]
    vals[0 as usize] = gum_value(r)
    vals[1 as usize] = gum_std_u(r)
    vals[2 as usize] = gum_k95(r)
    vals[3 as usize] = gum_u95(r)

    var decs: [i64; 4] = [0; 4]
    decs[0 as usize] = 4
    decs[1 as usize] = 6
    decs[2 as usize] = 3
    decs[3 as usize] = 6

    print("quantity,value,u_c,k95,U95\n")
    print("recovery")

    var col: i64 = 0
    while col < 4 {
        print(",")

        let d = decs[col as usize]

        var powf: f64 = 1.0
        var kf: i64 = 0
        while kf < d { powf = powf * 10.0; kf = kf + 1 }

        var mag: f64 = vals[col as usize]
        var neg: bool = false
        if mag < 0.0 { neg = true; mag = 0.0 - mag }

        let scaled = (mag * powf + 0.5) as i64

        var pw: i64 = 1
        var ki: i64 = 0
        while ki < d { pw = pw * 10; ki = ki + 1 }

        if neg { print("-") }
        let ip = scaled / pw
        let fp = scaled - ip * pw
        print_int(ip)
        if d > 0 {
            print(".")
            var place: i64 = pw / 10
            while place >= 1 {
                let digit = (fp / place) - ((fp / (place * 10)) * 10)
                print_int(digit)
                place = place / 10
            }
        }

        col = col + 1
    }
    print("\n")
    return 0
}
