//@ run-pass
//@ expect-stdout: ALL PASS
// PROV-DM / SLSA provenance derivation closure — the PROV-CONSTRAINTS
// inference rules expressed as EL+ role axioms over the verified dense
// fixpoint of stdlib/ontology/elplus.sio (executable mirror of crStep /
// closeSatF of formal/OntologyELPlusClosureComplete.lean, subBPlusC_iff).
//
// PROV-CONSTRAINTS inferences are literally role axioms:
//   - wasDerivedFrom is transitive  ->  derivedFrom ∘ derivedFrom ⊑ derivedFrom
//     (closure rule roleComp)
//   - the PROV relation hierarchy
//       wasDerivedFrom ⊑ wasInfluencedBy
//       wasGeneratedBy  ⊑ wasInfluencedBy
//       used            ⊑ influencedBy   (entity-side influence)
//     maps onto the role-hierarchy closure (rclos + closure rule roleSub)
//   - influencedBy ∘ influencedBy ⊑ influencedBy lets influence chains of
//     ANY length close (needed so roleComp iterates beyond 2-link paths)
//
// This REPLACES the flat-struct storage of stdlib/epistemic/prov.sio (no
// transitive reasoning there) with a declarative TBox: derivation chains
// are not walked imperatively, they are DERIVED by roleComp/roleSub.
//
//   Concepts (atoms):
//     0 Entity                 1 Measured    (⊑ Entity)
//     2 Literature (⊑ Entity)  3 Computed    (⊑ Entity)
//     4 Undocumented           5 SLSAL3Claim
//     6 UnsignedArtifact (⊑ Computed, ⊑ SLSAL3Claim — the bad claim)
//     7 top
//
//   Roles:  0 derivedFrom  1 generatedBy  2 used  3 influencedBy
//
//   Role axioms:
//     derivedFrom   ⊑ influencedBy          (PROV hierarchy)
//     generatedBy   ⊑ influencedBy          (PROV hierarchy)
//     used          ⊑ influencedBy          (PROV hierarchy)
//     derivedFrom   ∘ derivedFrom   ⊑ derivedFrom    (PROV transitivity)
//     influencedBy  ∘ influencedBy  ⊑ influencedBy   (chain closure)
//
//   Stated provenance graph (edge (r, C, f) reads C ⊑ ∃r.f: "every C is
//   r-related to some f", matching wasDerivedFrom(x, y) = x derived from y):
//     Computed   ⊑ ∃derivedFrom.Measured     (artifact derived from data)
//     Measured   ⊑ ∃derivedFrom.Literature   (data calibrated on literature)
//     Computed   ⊑ ∃used.Literature          (build used a literature value)
//     UnsignedArtifact ⊑ ∃derivedFrom.Undocumented  (provenance gap)
//
// Interned concept universe (ckind: 0 atom, 1 top, 3 existential; no
// conjunctions in this TBox):
//   0..6  atoms                          7  top
//   8     ∃derivedFrom.Measured          11  ∃influencedBy.Measured
//   9     ∃derivedFrom.Literature        12  ∃influencedBy.Literature
//   10    ∃derivedFrom.Undocumented      13  ∃influencedBy.Undocumented
//   14    ∃used.Literature
// Base concepts (role-edge fillers) are the atoms 0..6 + top, nb = 8.
//
// THE QUERY: prov_ultimate_sources(e) = the count of Literature/Measured
// fillers reachable from e through CLOSED influencedBy edges — i.e. the
// ultimate provenance sources of an artifact, answered by scanning the
// role cube with elplus_edge_dense in O(nb) after ONE fixpoint run.
//
// THE INCONSISTENCY CHECK (SLSA-L3 gate): SLSA provenance level 3 demands
// non-forgeable provenance for every build input; an artifact that is
// closed-subsumed by ∃derivedFrom.Undocumented cannot substantiate the
// claim.  Disjointness SLSAL3Claim ⊥ ∃derivedFrom.Undocumented is stated
// in the disj matrix and the violation is DERIVED by elplus_conflict
// (theorem conflictBPlusC_iff: the boolean conflict oracle IS the
// deductive conflict relation).  UnsignedArtifact (which claims SLSA-L3
// AND has the undocumented derivation) triggers the hard error; the clean
// Computed concept passes the gate.
//
// Checked queries (positive):
//   Computed ⊑ ∃derivedFrom.Literature      = true  (PROV transitivity,
//                                                    roleComp 2-link)
//   Computed ⊑ ∃influencedBy.Measured       = true  (roleSub via
//                                                    derivedFrom ⊑ influencedBy)
//   edge (influencedBy, Computed, Literature) = true (used ⊑ influencedBy)
//   prov_ultimate_sources(Computed)          = 2     (Measured, Literature)
//   prov_ultimate_sources(UnsignedArtifact)  = 2     (Undocumented filtered
//                                                     out — it is a gap, not
//                                                     a source)
//   UnsignedArtifact ⊑ ∃influencedBy.Undocumented = true (the gap is derived
//                                                     through the hierarchy)
//   conflict(UnsignedArtifact, UnsignedArtifact)  = true  -> HARD ERROR
// Checked queries (negative):
//   conflict(Computed, Computed)            = false (clean concept passes
//                                                    the SLSA-L3 gate)
//   Computed ⊑ ∃derivedFrom.Undocumented    = false
//   edge (influencedBy, Literature, Measured) = false (sources do not
//                                                    influence their users)
//
// Relations (parallel primitive arrays with splat init; no struct arrays,
// no where clauses — see artifacts/ontology-frontiers/compiler-repros/REPORT.md):
//   s[c*64+d]                    subsumption pairs over the universe
//   redges[(r*64+c)*64+f]        role edges (r, C, f), f base
//   rclos[r*8+s]                 role-hierarchy closure
//   exid[r*64+f]                 interned id of ∃r.(base f), or -1
//   disj[c*64+d]                 stated disjointness (symmetric)

// NOTE: NAMED imports — the qualified form (`use ontology::elplus;
// f(...)`) miscompiles on the current Madaros imported-module
// native lane (see docs/compiler/KNOWN_LIMITATIONS.md).
use ontology::elplus::{elplus_role_closure, elplus_seed, elplus_fixpoint, elplus_subsumes_dense, elplus_edge_dense, elplus_conflict}

/// prov_ultimate_sources(e): count (and print) the ultimate provenance
/// sources of concept e — the Measured (1) and Literature (2) fillers of
/// e's CLOSED influencedBy (role 3) edges.  Undocumented fillers are NOT
/// sources: they are provenance gaps caught by the SLSA-L3 gate below.
///
/// # Complexity
/// O(nb) over the closed role cube.
fn prov_ultimate_sources(redges: &[bool; 32768], e: i64, nb: i64) -> i64 with IO, Div, Panic {
    var n: i64 = 0
    var f: i64 = 0
    while f < nb {
        if elplus_edge_dense(redges, 3, e, f) {
            if f == 1 {
                println("  ultimate source: Measured")
                n = n + 1
            }
            if f == 2 {
                println("  ultimate source: Literature")
                n = n + 1
            }
        }
        f = f + 1
    }
    return n
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var n_fail = 0

    // ── Concept interning table ─────────────────────────────────────────
    var ckind: [i64; 64] = [0; 64]
    var carg1: [i64; 64] = [0; 64]
    var carg2: [i64; 64] = [0; 64]
    var ci: i64 = 0
    while ci < 7 {
        ckind[ci] = 0
        carg1[ci] = ci
        ci = ci + 1
    }
    ckind[7] = 1
    // ∃derivedFrom.{Measured, Literature, Undocumented}
    ckind[8] = 3
    carg1[8] = 0
    carg2[8] = 1
    ckind[9] = 3
    carg1[9] = 0
    carg2[9] = 2
    ckind[10] = 3
    carg1[10] = 0
    carg2[10] = 4
    // ∃influencedBy.{Measured, Literature, Undocumented}
    ckind[11] = 3
    carg1[11] = 3
    carg2[11] = 1
    ckind[12] = 3
    carg1[12] = 3
    carg2[12] = 2
    ckind[13] = 3
    carg1[13] = 3
    carg2[13] = 4
    // ∃used.Literature
    ckind[14] = 3
    carg1[14] = 2
    carg2[14] = 2

    // ── exid[r*64+f] = interned id of ∃r.(base f), or -1 ───────────────
    var exid: [i64; 512] = [0; 512]
    ci = 0
    while ci < 512 {
        exid[ci] = 0 - 1
        ci = ci + 1
    }
    exid[0 * 64 + 1] = 8
    exid[0 * 64 + 2] = 9
    exid[0 * 64 + 4] = 10
    exid[3 * 64 + 1] = 11
    exid[3 * 64 + 2] = 12
    exid[3 * 64 + 4] = 13
    exid[2 * 64 + 2] = 14

    // ── Role hierarchy (PROV): derivedFrom / generatedBy / used all
    //    subsumed by influencedBy ───────────────────────────────────────
    var rclos: [bool; 64] = [false; 64]
    rclos[0 * 8 + 3] = true
    rclos[1 * 8 + 3] = true
    rclos[2 * 8 + 3] = true
    elplus_role_closure(&!rclos, 4)

    // ── Composition chains: df ∘ df ⊑ df (PROV transitivity) and
    //    ib ∘ ib ⊑ ib (influence chains of any length) ──────────────────
    var ch1: [i64; 8] = [0; 8]
    var ch2: [i64; 8] = [0; 8]
    var ch3: [i64; 8] = [0; 8]
    ch1[0] = 0
    ch2[0] = 0
    ch3[0] = 0
    ch1[1] = 3
    ch2[1] = 3
    ch3[1] = 3

    // ── Seed S: reflexivity + top + stated inclusions ──────────────────
    var s: [bool; 4096] = [false; 4096]
    elplus_seed(&!s, 15, 7)
    // entity-type classes
    s[1 * 64 + 0] = true
    s[2 * 64 + 0] = true
    s[3 * 64 + 0] = true
    // the unsigned artifact is a computed artifact that CLAIMS SLSA-L3
    s[6 * 64 + 3] = true
    s[6 * 64 + 5] = true
    // stated provenance graph
    s[3 * 64 + 8] = true
    s[1 * 64 + 9] = true
    s[3 * 64 + 14] = true
    // the provenance gap: derived from something undocumented
    s[6 * 64 + 10] = true

    // ── Stated disjointness for the SLSA-L3 gate: a concept cannot
    //    consistently claim SLSA-L3 provenance and be derived from
    //    something undocumented ─────────────────────────────────────────
    var disj: [bool; 4096] = [false; 4096]
    disj[5 * 64 + 10] = true
    disj[10 * 64 + 5] = true

    // ── ONE dense 8-rule fixpoint (crStep mirror, iterated to stability) ─
    var redges: [bool; 32768] = [false; 32768]
    let rounds = elplus_fixpoint(&!s, &!redges, &ckind, &carg1, &carg2, &exid, &rclos, &ch1, &ch2, &ch3, 2, 15, 8, 4)

    println("closure rounds:")
    println(rounds)

    // ── Query 1 (PROV transitivity): Computed ⊑ ∃derivedFrom.Literature —
    //    derived by roleComp over the 2 stated derivedFrom links ────────
    if elplus_subsumes_dense(&s, 3, 9) {
        println("derivedFrom Literature (transitive) = true")
    } else {
        println("FAIL: Computed <= ex derivedFrom.Literature should be true")
        n_fail = n_fail + 1
    }

    // ── Query 2 (role hierarchy): Computed ⊑ ∃influencedBy.Measured —
    //    roleSub over derivedFrom ⊑ influencedBy ────────────────────────
    if elplus_subsumes_dense(&s, 3, 11) {
        println("influencedBy Measured (role hierarchy) = true")
    } else {
        println("FAIL: Computed <= ex influencedBy.Measured should be true")
        n_fail = n_fail + 1
    }

    // ── Query 3: the used edge surfaces as influencedBy ────────────────
    if elplus_edge_dense(&redges, 3, 3, 2) {
        println("edge (influencedBy, Computed, Literature) via used = true")
    } else {
        println("FAIL: derived edge (influencedBy, Computed, Literature) missing")
        n_fail = n_fail + 1
    }

    // ── Query 4 (THE provenance query): ultimate sources of Computed ───
    println("prov_ultimate_sources(Computed):")
    let n_src = prov_ultimate_sources(&redges, 3, 8)
    println("source count:")
    println(n_src)
    if n_src == 2 {
        println("ultimate sources of Computed = 2")
    } else {
        println("FAIL: Computed should have exactly 2 ultimate sources")
        n_fail = n_fail + 1
    }

    // ── Query 5: ultimate sources of UnsignedArtifact — the Undocumented
    //    filler is reachable but is a GAP, not a source ─────────────────
    let n_src2 = prov_ultimate_sources(&redges, 6, 8)
    if n_src2 == 2 {
        println("ultimate sources of UnsignedArtifact = 2 (gap filtered)")
    } else {
        println("FAIL: UnsignedArtifact should have exactly 2 ultimate sources")
        n_fail = n_fail + 1
    }

    // ── Query 6: the gap is derived through the hierarchy:
    //    UnsignedArtifact ⊑ ∃influencedBy.Undocumented ──────────────────
    if elplus_subsumes_dense(&s, 6, 13) {
        println("influencedBy Undocumented (gap visible) = true")
    } else {
        println("FAIL: UnsignedArtifact <= ex influencedBy.Undocumented should be true")
        n_fail = n_fail + 1
    }

    // ── Query 7 (SLSA-L3 gate): UnsignedArtifact claims SLSA-L3 (5) and
    //    is closed-subsumed by ∃derivedFrom.Undocumented (10) — the
    //    stated disjointness makes this a DERIVED conflict: hard error ──
    if elplus_conflict(&s, &disj, 15, 6, 6) {
        println("HARD ERROR: SLSA-L3 claim on artifact with undocumented derivation")
    } else {
        println("FAIL: SLSA-L3 violation on UnsignedArtifact not detected")
        n_fail = n_fail + 1
    }

    // ── Query 8 (negative): the clean Computed concept passes the gate ──
    if elplus_conflict(&s, &disj, 15, 3, 3) {
        println("FAIL: Computed should NOT conflict with the SLSA-L3 gate")
        n_fail = n_fail + 1
    } else {
        println("SLSA-L3 gate on clean Computed = pass")
    }

    // ── Query 9 (negative): Computed has no undocumented derivation ─────
    if elplus_subsumes_dense(&s, 3, 10) {
        println("FAIL: Computed <= ex derivedFrom.Undocumented should be false")
        n_fail = n_fail + 1
    } else {
        println("derivedFrom Undocumented from Computed = false")
    }

    // ── Query 10 (negative): sources do not influence their users — no
    //     influencedBy edge leaves Literature ────────────────────────────
    if elplus_edge_dense(&redges, 3, 2, 1) {
        println("FAIL: edge (influencedBy, Literature, Measured) should be false")
        n_fail = n_fail + 1
    } else {
        println("edge (influencedBy, Literature, Measured) = false")
    }

    if n_fail == 0 {
        println("ALL PASS")
        return 0
    }
    println("FAILURES:")
    println(n_fail)
    return 1
}
