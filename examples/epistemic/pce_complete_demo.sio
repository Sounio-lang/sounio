//! Complete Polynomial Chaos Expansion (PCE) Demonstration
//!
//! Shows all PCE capabilities:
//! - Univariate PCE for common functions
//! - Bivariate PCE for multi-input systems
//! - Method comparison (PCE vs GUM vs MC)
//! - Sensitivity analysis (Sobol indices)
//! - Linearity detection
//! - Statistical utilities

extern "C" {
    fn printf(fmt: &u8, ...);
}

// Import PCE types and functions
struct PCEInput {
    mean: f64,
    std: f64,
    dist_type: i32,
}

struct PCE {
    order: i32,
    dist_type: i32,
    input_mean: f64,
    input_std: f64,
    c0: f64,
    c1: f64,
    c2: f64,
    c3: f64,
    c4: f64,
    c5: f64,
    c6: f64,
    c7: f64,
    c8: f64,
    c9: f64,
    c10: f64,
    mean: f64,
    variance: f64,
    sobol_total: f64,
}

struct PCEBivariate {
    order1: i32,
    order2: i32,
    input1_mean: f64,
    input1_std: f64,
    input2_mean: f64,
    input2_std: f64,
    dist_type1: i32,
    dist_type2: i32,
    c00: f64,
    c01: f64,
    c02: f64,
    c03: f64,
    c04: f64,
    c10: f64,
    c11: f64,
    c12: f64,
    c13: f64,
    c14: f64,
    c20: f64,
    c21: f64,
    c22: f64,
    c23: f64,
    c24: f64,
    c30: f64,
    c31: f64,
    c32: f64,
    c33: f64,
    c34: f64,
    c40: f64,
    c41: f64,
    c42: f64,
    c43: f64,
    c44: f64,
    mean: f64,
    variance: f64,
}

struct ComparisonResult {
    pce_mean: f64,
    pce_std: f64,
    gum_mean: f64,
    gum_std: f64,
    mc_mean: f64,
    mc_std: f64,
    pce_vs_mc_error: f64,
    gum_vs_mc_error: f64,
}

// Constructors
fn input_normal(mean: f64, std: f64) -> PCEInput;
fn input_uniform(lo: f64, hi: f64) -> PCEInput with Panic;

// Univariate builders
fn build_identity(input: PCEInput, order: i32) -> PCE with Mut, Panic;
fn build_square(input: PCEInput, order: i32) -> PCE with Mut, Panic, Div;
fn build_exp(input: PCEInput, order: i32) -> PCE with Mut, Panic, Div;
fn build_sin(input: PCEInput, order: i32) -> PCE with Mut, Panic, Div;
fn build_cos(input: PCEInput, order: i32) -> PCE with Mut, Panic, Div;

// Bivariate builders
fn build_bivariate_sum(input1: PCEInput, input2: PCEInput, order: i32) -> PCEBivariate with Mut, Panic;
fn build_bivariate_product(input1: PCEInput, input2: PCEInput, order: i32) -> PCEBivariate with Mut, Panic;

// Statistics
fn std(pce: PCE) -> f64 with Panic;
fn coefficient_of_variation(pce: PCE) -> f64 with Div, Panic;
fn percentile_bounds(pce: PCE, coverage: f64) -> (f64, f64) with Panic;
fn is_linear(pce: PCE) -> bool with Div, Panic;

// Bivariate statistics
fn bivariate_std(pce: PCEBivariate) -> f64 with Panic;
fn bivariate_sobol_x(pce: PCEBivariate) -> f64 with Div, Panic;
fn bivariate_sobol_y(pce: PCEBivariate) -> f64 with Div, Panic;
fn bivariate_sobol_interaction(pce: PCEBivariate) -> f64 with Div, Panic;

// Sensitivity
fn sobol_first_order(pce: PCE) -> f64 with Div, Panic;

// Comparison
fn compare_exp(input: PCEInput, pce_order: i32, mc_samples: i32) -> ComparisonResult with Mut, Panic, Div;
fn compare_square(input: PCEInput, pce_order: i32) -> ComparisonResult with Mut, Panic, Div;

// Evaluation
fn evaluate(pce: PCE, x: f64) -> f64 with Mut, Panic, Div;

// Tests
fn run_all_tests() -> i32 with Mut, Panic, Div;

fn print_separator() with IO {
    printf("================================================\n" as &u8)
}

fn main() with IO, Mut, Panic, Div {
    printf("\n" as &u8)
    print_separator()
    printf("  POLYNOMIAL CHAOS EXPANSION - COMPLETE DEMO\n" as &u8)
    print_separator()
    printf("\n" as &u8)

    // =========================================================================
    // Part 1: Univariate PCE
    // =========================================================================
    printf("PART 1: UNIVARIATE PCE\n" as &u8)
    printf("\n" as &u8)

    printf("Example 1.1: Linear function f(x) = x\n" as &u8)
    let input1 = input_normal(5.0, 2.0)
    let pce1 = build_identity(input1, 2)
    printf("  Input: N(5.0, 2.0)\n" as &u8)
    printf("  Result: mean = %f" as &u8, pce1.mean)
    printf(", std = %f\n" as &u8, std(pce1))
    printf("  Linear? %s\n" as &u8, if is_linear(pce1) { "YES" as &u8 } else { "NO" as &u8 })
    printf("\n" as &u8)

    printf("Example 1.2: Quadratic f(x) = x²\n" as &u8)
    let input2 = input_normal(3.0, 1.0)
    let pce2 = build_square(input2, 4)
    printf("  Input: N(3.0, 1.0)\n" as &u8)
    printf("  Result: mean = %f" as &u8, pce2.mean)
    printf(", std = %f\n" as &u8, std(pce2))
    printf("  CV = %f\n" as &u8, coefficient_of_variation(pce2))
    printf("  Linear? %s\n" as &u8, if is_linear(pce2) { "YES" as &u8 } else { "NO" as &u8 })
    let bounds2 = percentile_bounds(pce2, 0.95)
    printf("  95%% CI: [%f" as &u8, bounds2.0)
    printf(", %f]\n" as &u8, bounds2.1)
    printf("\n" as &u8)

    printf("Example 1.3: Exponential f(x) = exp(x)\n" as &u8)
    let input3 = input_normal(1.0, 0.5)
    let pce3 = build_exp(input3, 4)
    printf("  Input: N(1.0, 0.5)\n" as &u8)
    printf("  Result: mean = %f" as &u8, pce3.mean)
    printf(", std = %f\n" as &u8, std(pce3))
    let sobol3 = sobol_first_order(pce3)
    printf("  Sobol S₁ = %f\n" as &u8, sobol3)
    printf("\n" as &u8)

    printf("Example 1.4: Trigonometric f(x) = sin(x)\n" as &u8)
    let input4 = input_normal(0.5, 0.2)
    let pce4 = build_sin(input4, 4)
    printf("  Input: N(0.5, 0.2)\n" as &u8)
    printf("  Result: mean = %f" as &u8, pce4.mean)
    printf(", std = %f\n" as &u8, std(pce4))
    printf("\n" as &u8)

    // =========================================================================
    // Part 2: PCE Evaluation
    // =========================================================================
    printf("PART 2: PCE EVALUATION (Surrogate Model)\n" as &u8)
    printf("\n" as &u8)

    printf("Evaluating exp(x) PCE at specific points:\n" as &u8)
    let eval1 = evaluate(pce3, 0.5)
    printf("  f(0.5) ≈ %f\n" as &u8, eval1)
    let eval2 = evaluate(pce3, 1.0)
    printf("  f(1.0) ≈ %f\n" as &u8, eval2)
    let eval3 = evaluate(pce3, 1.5)
    printf("  f(1.5) ≈ %f\n" as &u8, eval3)
    printf("\n" as &u8)

    // =========================================================================
    // Part 3: Bivariate PCE
    // =========================================================================
    printf("PART 3: BIVARIATE PCE (Multi-Input)\n" as &u8)
    printf("\n" as &u8)

    printf("Example 3.1: Sum f(x,y) = x + y\n" as &u8)
    let input_x = input_normal(3.0, 1.0)
    let input_y = input_normal(5.0, 2.0)
    let pce_sum = build_bivariate_sum(input_x, input_y, 2)
    printf("  Inputs: X ~ N(3.0, 1.0), Y ~ N(5.0, 2.0)\n" as &u8)
    printf("  Result: mean = %f" as &u8, pce_sum.mean)
    printf(", std = %f\n" as &u8, bivariate_std(pce_sum))
    let sx = bivariate_sobol_x(pce_sum)
    let sy = bivariate_sobol_y(pce_sum)
    printf("  Sobol Sₓ = %f" as &u8, sx)
    printf(", Sᵧ = %f\n" as &u8, sy)
    printf("\n" as &u8)

    printf("Example 3.2: Product f(x,y) = x · y\n" as &u8)
    let input_x2 = input_normal(2.0, 0.5)
    let input_y2 = input_normal(3.0, 0.5)
    let pce_prod = build_bivariate_product(input_x2, input_y2, 2)
    printf("  Inputs: X ~ N(2.0, 0.5), Y ~ N(3.0, 0.5)\n" as &u8)
    printf("  Result: mean = %f" as &u8, pce_prod.mean)
    printf(", std = %f\n" as &u8, bivariate_std(pce_prod))
    let sxp = bivariate_sobol_x(pce_prod)
    let syp = bivariate_sobol_y(pce_prod)
    let sxy = bivariate_sobol_interaction(pce_prod)
    printf("  Sobol Sₓ = %f" as &u8, sxp)
    printf(", Sᵧ = %f" as &u8, syp)
    printf(", Sₓᵧ = %f\n" as &u8, sxy)
    printf("\n" as &u8)

    // =========================================================================
    // Part 4: Method Comparison
    // =========================================================================
    printf("PART 4: PCE vs GUM vs MONTE CARLO\n" as &u8)
    printf("\n" as &u8)

    printf("Comparing methods for f(x) = exp(x)\n" as &u8)
    let comp_input = input_normal(1.0, 0.3)
    let comparison = compare_exp(comp_input, 4, 50)
    printf("  Input: N(1.0, 0.3)\n" as &u8)
    printf("\n" as &u8)
    printf("  PCE:  mean = %f" as &u8, comparison.pce_mean)
    printf(", std = %f" as &u8, comparison.pce_std)
    printf(" (error: %f%%)\n" as &u8, comparison.pce_vs_mc_error * 100.0)
    printf("  GUM:  mean = %f" as &u8, comparison.gum_mean)
    printf(", std = %f" as &u8, comparison.gum_std)
    printf(" (error: %f%%)\n" as &u8, comparison.gum_vs_mc_error * 100.0)
    printf("  MC:   mean = %f" as &u8, comparison.mc_mean)
    printf(", std = %f\n" as &u8, comparison.mc_std)
    printf("\n" as &u8)
    printf("  PCE is %fx more accurate than GUM\n" as &u8,
           comparison.gum_vs_mc_error / comparison.pce_vs_mc_error)
    printf("\n" as &u8)

    printf("Comparing methods for f(x) = x²\n" as &u8)
    let comp_input2 = input_normal(3.0, 1.0)
    let comparison2 = compare_square(comp_input2, 4)
    printf("  Input: N(3.0, 1.0)\n" as &u8)
    printf("\n" as &u8)
    printf("  PCE:      mean = %f" as &u8, comparison2.pce_mean)
    printf(" (error: %f%%)\n" as &u8, comparison2.pce_vs_mc_error * 100.0)
    printf("  GUM:      mean = %f" as &u8, comparison2.gum_mean)
    printf(" (error: %f%%)\n" as &u8, comparison2.gum_vs_mc_error * 100.0)
    printf("  Exact:    mean = %f\n" as &u8, comparison2.mc_mean)
    printf("\n" as &u8)

    // =========================================================================
    // Part 5: Test Suite
    // =========================================================================
    print_separator()
    printf("RUNNING COMPREHENSIVE TEST SUITE\n" as &u8)
    print_separator()
    printf("\n" as &u8)

    let tests_passed = run_all_tests()
    printf("Tests passed: %d" as &u8, tests_passed)
    printf(" / 9\n" as &u8)

    if tests_passed == 9 {
        printf("\n✓ ALL TESTS PASSED\n" as &u8)
    } else {
        printf("\n✗ SOME TESTS FAILED\n" as &u8)
    }

    printf("\n" as &u8)
    print_separator()
    printf("DEMO COMPLETE\n" as &u8)
    print_separator()
    printf("\n" as &u8)
}
