//! Simple PCE test to validate the implementation

extern "C" {
    fn printf(fmt: &u8, ...);
}

fn run_tests() -> i32 with Mut, Panic, Div;
fn run_all_tests() -> i32 with Mut, Panic, Div;

fn main() with IO, Mut, Panic, Div {
    printf("=== PCE Test Suite ===\n" as &u8)
    printf("\n" as &u8)

    printf("Running basic tests (5)...\n" as &u8)
    let basic_passed = run_tests()
    printf("Basic tests passed: %d" as &u8, basic_passed)
    printf(" / 5\n" as &u8)
    printf("\n" as &u8)

    printf("Running extended tests (9)...\n" as &u8)
    let all_passed = run_all_tests()
    printf("Extended tests passed: %d" as &u8, all_passed)
    printf(" / 9\n" as &u8)
    printf("\n" as &u8)

    if all_passed == 9 {
        printf("SUCCESS: All tests passed!\n" as &u8)
    } else {
        printf("FAILURE: Some tests failed\n" as &u8)
    }
}
