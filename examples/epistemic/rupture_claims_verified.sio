// ---------------------------------------------------------------- witness-bound
// The first claim in this repository to declare a WITNESS (rung R17).
//
// Its proposition is a CARDINALITY: the number of distinct ZD-fiber adjacency
// spectra is 3*2^(n-5). R15 measured what that costs. A single Cayley-Dickson
// sign flip, sigma(H/2, H+H/2), leaves the count at 3/6/12 and replaces every
// spectrum; R16 showed it preserves the whole classification and relabels each
// block. A verdict token alone therefore cannot tell the real tower from the
// perturbed one -- both satisfy the proposition exactly.
//
// The witness is a sha256 over the spectra themselves, sorted: the labelling,
// not its size. scripts/ci/zd_fiber_spectra_witness_perturbed_gate.sh is the
// perturbed twin, kept as a live demonstration -- it exits 0, emits the SAME
// verdict token, and differs only here.
claim zd_fiber_spectra_count_law_holds {
    hypothesis = "the ZD-fiber adjacency spectra number 3*2^(n-5) for n=5,6,7, and are the ones this claim fingerprints",
    falsifier  = "the count law fails, or the count holds on a different set of spectra",
    evidence   = Evidence::GateGreen,
    harness    = "scripts/ci/zd_fiber_spectra_witness_gate.sh",
    gate       = "scripts/ci/zd_fiber_spectra_witness_gate.sh",
    verdict_token = "SPECTRA_COUNT_IS_3_TIMES_2_POW_N_MINUS_5",
    witness    = "705d0afdf8e830756f5d58eed9e6a11c7681d9e2e3a29ce7054ea67edc385757",
    // The completeness half of this claim -- that the spectrum COUNT equals the
    // number of distinct fiber geometries -- rests on the explicit
    // parity-collapse map Phi, the upper bound of the completeness pincer. R20
    // found that artifact absent from this branch (committed only to
    // lean/cd-seamflip-forall-n) while this very claim's witness matched and
    // could not see it. Binding provenance means the manifest will not build if
    // Phi vanishes again -- the failure class R20 caught, now closed at compile
    // time on the claim it was found on. The first production claim to declare
    // all three: token (proposition), witness (evidence), provenance (the
    // derivation it cites).
    provenance = "scripts/research/cd_tower_collapse_isomorphism.py",
    verdict    = Verdict::Alive,
}

fn main() -> i64 with IO {
    print("RUPTURE_CLAIMS_VERIFIED_OK\n")
    0
}
