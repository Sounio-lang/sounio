//! Demonstrates Polynomial Chaos Expansion (PCE) for uncertainty quantification
//!
//! This example shows how PCE provides superior nonlinear uncertainty propagation
//! compared to GUM (first-order) methods, while being more efficient than Monte Carlo.

// PCE functions for common mathematical operations
fn build_identity(input: PCEInput, order: i32) -> PCE with Mut, Panic;
fn build_square(input: PCEInput, order: i32) -> PCE with Mut, Panic, Div;
fn build_exp(input: PCEInput, order: i32) -> PCE with Mut, Panic, Div;
fn build_sin(input: PCEInput, order: i32) -> PCE with Mut, Panic, Div;
fn build_cos(input: PCEInput, order: i32) -> PCE with Mut, Panic, Div;

// Input constructors
fn input_normal(mean: f64, std: f64) -> PCEInput;
fn input_uniform(lo: f64, hi: f64) -> PCEInput with Panic;

// Statistics extraction
fn std(pce: PCE) -> f64 with Panic;
fn sobol_first_order(pce: PCE) -> f64 with Div, Panic;

// Test suite
fn run_tests() -> i32 with Mut, Panic, Div;

struct PCEInput {
    mean: f64,
    std: f64,
    dist_type: i32,
}

struct PCE {
    order: i32,
    dist_type: i32,
    input_mean: f64,
    input_std: f64,
    c0: f64,
    c1: f64,
    c2: f64,
    c3: f64,
    c4: f64,
    c5: f64,
    c6: f64,
    c7: f64,
    c8: f64,
    c9: f64,
    c10: f64,
    mean: f64,
    variance: f64,
    sobol_total: f64,
}

extern "C" {
    fn printf(fmt: &u8, ...);
}

fn print_result(name: &u8, pce: PCE) with IO {
    printf(name)
    printf(": mean = " as &u8)
    printf("%f" as &u8, pce.mean)
    printf(", std = " as &u8)
    printf("%f" as &u8, std(pce))
    printf("\n" as &u8)
}

fn main() with IO, Mut, Panic, Div {
    printf("=== Polynomial Chaos Expansion Demo ===\n" as &u8)
    printf("\n" as &u8)

    // Example 1: Linear propagation (identity function)
    printf("Example 1: Identity f(x) = x\n" as &u8)
    let input1 = input_normal(5.0, 2.0)
    let pce1 = build_identity(input1, 2)
    print_result("  Result" as &u8, pce1)
    printf("  Expected: mean = 5.0, std = 2.0\n" as &u8)
    printf("\n" as &u8)

    // Example 2: Quadratic nonlinearity
    printf("Example 2: Square f(x) = x^2\n" as &u8)
    let input2 = input_normal(3.0, 1.0)
    let pce2 = build_square(input2, 4)
    print_result("  Result" as &u8, pce2)
    printf("  Expected: mean ≈ 10.0 (μ² + σ² = 9 + 1)\n" as &u8)
    printf("\n" as &u8)

    // Example 3: Exponential (strong nonlinearity)
    printf("Example 3: Exponential f(x) = exp(x)\n" as &u8)
    let input3 = input_normal(1.0, 0.5)
    let pce3 = build_exp(input3, 4)
    print_result("  Result" as &u8, pce3)
    printf("  Expected: mean ≈ 3.08 (exp(μ + σ²/2))\n" as &u8)
    let sobol3 = sobol_first_order(pce3)
    printf("  Sobol index: %f" as &u8, sobol3)
    printf("\n\n" as &u8)

    // Example 4: Trigonometric
    printf("Example 4: Sine f(x) = sin(x)\n" as &u8)
    let input4 = input_normal(0.5, 0.2)
    let pce4 = build_sin(input4, 4)
    print_result("  Result" as &u8, pce4)
    printf("\n" as &u8)

    // Run test suite
    printf("=== Running PCE Test Suite ===\n" as &u8)
    let tests_passed = run_tests()
    printf("Tests passed: %d" as &u8, tests_passed)
    printf(" / 5\n" as &u8)

    printf("\n=== Demo Complete ===\n" as &u8)
}
