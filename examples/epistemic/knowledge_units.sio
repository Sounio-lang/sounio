//@ run-pass
//@ expect-stdout: ALL PASS

//! Epistemic Knowledge Units — D3 Min-Propagation Semantics
//!
//! This file demonstrates epistemic confidence tracking and GUM uncertainty
//! propagation using a plain userspace struct (EK) instead of the built-in
//! Knowledge<T> type annotation, which requires compiler support not yet
//! present in the JIT binary.
//!
//! Core ideas:
//!
//!   CHANNEL A — UNCERTAINTY (GUM)
//!     Every measurement carries a standard uncertainty u.
//!     For arithmetic operations, uncertainty propagates via the
//!     Guide to the Expression of Uncertainty in Measurement (GUM):
//!       mul: u(a*b) = |a*b| * sqrt((u_a/a)^2 + (u_b/b)^2)
//!       add: u(a+b) = sqrt(u_a^2 + u_b^2)
//!
//!   CHANNEL B — CONFIDENCE (D3 min-propagation)
//!     Every value carries a confidence score in [0,1] reflecting
//!     how trustworthy the source is:
//!       measured  → conf = 0.985  (instrument reading, calibrated)
//!       asserted  → conf = 0.965  (model estimate or literature)
//!     Confidence is monotone non-increasing: any operation takes
//!     the *minimum* of the input confidences (D3 semantics).
//!     This ensures trust can never be conjured from computation.
//!
//!   UNIT TAGGING (conceptual)
//!     Because the JIT binary does not yet support unit-suffix syntax
//!     (e.g., 500.0mg), units are carried as string comments and
//!     demonstrated through named wrapper functions and descriptive
//!     println calls.  The arithmetic itself is dimensionally correct.

extern "C" {
    fn sqrt(x: f64) -> f64;
}

fn sqrt_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 }
    return sqrt(x)
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { return a }
    return b
}

// ============================================================================
// EK — Epistemic Knowledge value (userspace substitute for Knowledge<T>)
//
//   val  — the nominal value
//   unc  — GUM standard uncertainty (1-sigma)
//   conf — D3 confidence score in [0.0, 1.0]
// ============================================================================

struct EK { val: f64, unc: f64, conf: f64 }

// Construct a *measured* EK value (instrument / calibrated reading).
// Confidence 0.985 reflects a well-characterised measurement source.
// Unit: caller's responsibility (e.g., "mg", "kg").
fn ek_measured(v: f64, u: f64) -> EK {
    return EK { val: v, unc: u, conf: 0.985 }
}

// Construct an *asserted* EK value (model estimate / literature value).
// Confidence 0.965 reflects a model or secondary source.
fn ek_asserted(v: f64, u: f64) -> EK {
    return EK { val: v, unc: u, conf: 0.965 }
}

// GUM multiplication:
//   val  = a.val * b.val
//   unc  = |val| * sqrt((a.unc/a.val)^2 + (b.unc/b.val)^2)   [relative-error quadrature]
//   conf = min(a.conf, b.conf)                                  [D3 min-propagation]
fn ek_mul(a: EK, b: EK) -> EK {
    let val = a.val * b.val
    let conf = min_f64(a.conf, b.conf)

    var ra = 0.0
    var rb = 0.0
    if abs_f64(a.val) > 1.0e-15 {
        ra = a.unc / abs_f64(a.val)
    }
    if abs_f64(b.val) > 1.0e-15 {
        rb = b.unc / abs_f64(b.val)
    }
    let unc = abs_f64(val) * sqrt_f64(ra * ra + rb * rb)

    return EK { val: val, unc: unc, conf: conf }
}

// GUM addition:
//   val  = a.val + b.val
//   unc  = sqrt(a.unc^2 + b.unc^2)                             [absolute-error quadrature]
//   conf = min(a.conf, b.conf)                                  [D3 min-propagation]
fn ek_add(a: EK, b: EK) -> EK {
    let val = a.val + b.val
    let conf = min_f64(a.conf, b.conf)
    let unc = sqrt_f64(a.unc * a.unc + b.unc * b.unc)
    return EK { val: val, unc: unc, conf: conf }
}

// ============================================================================
// TESTS
// ============================================================================

fn main() -> i32 {
    var all_pass = 1

    // -----------------------------------------------------------------------
    // T1: Creating measured vs asserted values
    //     measured has conf=0.985, asserted has conf=0.965
    //
    //     Units (conceptual):
    //       dose  → mg    (drug mass)
    //       body  → kg    (body weight)
    // -----------------------------------------------------------------------
    println("T1: measured vs asserted construction")

    // dose: 500 mg measured with ±2.5 mg uncertainty
    let dose_m = ek_measured(500.0, 2.5)   // unit: mg
    // dose: 500 mg asserted (e.g., from patient record) with same numbers
    let dose_a = ek_asserted(500.0, 2.5)   // unit: mg

    let t1_val = (abs_f64(dose_m.val - 500.0) < 1.0e-10) &&
                 (abs_f64(dose_a.val - 500.0) < 1.0e-10) &&
                 (abs_f64(dose_m.conf - 0.985) < 1.0e-10) &&
                 (abs_f64(dose_a.conf - 0.965) < 1.0e-10) &&
                 (dose_m.conf > dose_a.conf)

    if t1_val {
        println("  T1 PASS: measured.conf=0.985 > asserted.conf=0.965")
    } else {
        println("  T1 FAIL")
        all_pass = 0
    }

    // -----------------------------------------------------------------------
    // T2: Multiplication propagates GUM uncertainty and D3 confidence
    //
    //     dose_m [mg] * body [kg] -> total_m [mg*kg]  (intermediate quantity)
    //     GUM: u = |500*70| * sqrt((2.5/500)^2 + (0.5/70)^2)
    //     D3:  conf = min(0.985, 0.985) = 0.985
    // -----------------------------------------------------------------------
    println("T2: GUM multiplication propagation")

    // body weight: 70 kg measured with ±0.5 kg
    let body_m = ek_measured(70.0, 0.5)    // unit: kg

    let product_m = ek_mul(dose_m, body_m)

    // Expected val = 500 * 70 = 35000
    // Expected rel_u = sqrt((2.5/500)^2 + (0.5/70)^2)
    //                = sqrt(0.000025 + 0.0000510204...)
    //                ≈ sqrt(0.0000760204) ≈ 0.008719
    // Expected unc = 35000 * 0.008719 ≈ 305.17
    let expected_mul_val = 35000.0
    let ra = 2.5 / 500.0
    let rb = 0.5 / 70.0
    let expected_mul_unc = 35000.0 * sqrt_f64(ra * ra + rb * rb)

    let t2_val = (abs_f64(product_m.val - expected_mul_val) < 0.001) &&
                 (abs_f64(product_m.unc - expected_mul_unc) < 0.1) &&
                 (abs_f64(product_m.conf - 0.985) < 1.0e-10)

    if t2_val {
        println("  T2 PASS: GUM mul and min-conf correct")
    } else {
        println("  T2 FAIL")
        all_pass = 0
    }

    // -----------------------------------------------------------------------
    // T3: Addition propagates GUM uncertainty and D3 confidence
    //
    //     dose_m [mg] + supplement [mg]
    //     GUM: u = sqrt(2.5^2 + 1.0^2) = sqrt(7.25) ≈ 2.693
    //     D3:  conf = min(0.985, 0.985) = 0.985
    // -----------------------------------------------------------------------
    println("T3: GUM addition propagation")

    // supplement: 50 mg measured with ±1.0 mg
    let supp_m = ek_measured(50.0, 1.0)    // unit: mg

    let sum_m = ek_add(dose_m, supp_m)

    let expected_add_val = 550.0
    let expected_add_unc = sqrt_f64(2.5 * 2.5 + 1.0 * 1.0)  // sqrt(7.25)

    let t3_val = (abs_f64(sum_m.val - expected_add_val) < 0.001) &&
                 (abs_f64(sum_m.unc - expected_add_unc) < 0.001) &&
                 (abs_f64(sum_m.conf - 0.985) < 1.0e-10)

    if t3_val {
        println("  T3 PASS: GUM add and min-conf correct")
    } else {
        println("  T3 FAIL")
        all_pass = 0
    }

    // -----------------------------------------------------------------------
    // T4: Chain of operations — confidence stays at min (asserted dominates)
    //
    //     Mix measured and asserted values in a multi-step chain.
    //     Step 1: dose_m [mg] + dose_a [mg]  -> combined [mg]
    //             conf = min(0.985, 0.965) = 0.965  (asserted dominates)
    //     Step 2: combined [mg] * body_m [kg] -> dose_body [mg*kg]
    //             conf = min(0.965, 0.985) = 0.965  (asserted still dominates)
    //
    //     This is the key D3 property: once an asserted value enters the
    //     chain, it caps all downstream confidence values.
    // -----------------------------------------------------------------------
    println("T4: Chain — asserted dominates confidence")

    let combined = ek_add(dose_m, dose_a)       // conf = min(0.985, 0.965) = 0.965
    let dose_body = ek_mul(combined, body_m)    // conf = min(0.965, 0.985) = 0.965

    let t4_val = (abs_f64(combined.conf - 0.965) < 1.0e-10) &&
                 (abs_f64(dose_body.conf - 0.965) < 1.0e-10)

    if t4_val {
        println("  T4 PASS: asserted dominates throughout chain")
    } else {
        println("  T4 FAIL")
        all_pass = 0
    }

    // -----------------------------------------------------------------------
    // T5: Unit-like tagging (conceptual)
    //
    //     The binary does not yet support unit-suffix syntax (500.0mg),
    //     but the semantics are preserved via named constructor functions
    //     and descriptive labels.  The computation below represents:
    //
    //       dose_rate [mg/kg] = dose [mg] / body [kg]
    //
    //     Implemented here as multiplication by a pre-inverted body weight
    //     (since division is just mul with 1/x) to reuse ek_mul.
    //     We verify the value is in the expected physiological range.
    // -----------------------------------------------------------------------
    println("T5: Unit-like conceptual tagging (mg / kg -> dose rate)")

    // Invert body weight: 1/70 kg^-1, uncertainty propagated manually
    //   For y = 1/x: u(y) = u(x)/x^2 = 0.5/4900 ≈ 0.0001020
    let inv_body_val = 1.0 / 70.0
    let inv_body_unc = 0.5 / (70.0 * 70.0)
    let inv_body = ek_measured(inv_body_val, inv_body_unc)   // unit: 1/kg

    // dose_rate = dose_m [mg] * inv_body [1/kg] = [mg/kg]
    let dose_rate = ek_mul(dose_m, inv_body)

    // Expected: 500/70 ≈ 7.143 mg/kg; physiological range 1–20 mg/kg
    let t5_val = (dose_rate.val > 1.0) && (dose_rate.val < 20.0) &&
                 (dose_rate.unc > 0.0) &&
                 (abs_f64(dose_rate.conf - 0.985) < 1.0e-10)

    if t5_val {
        println("  T5 PASS: dose rate in physiological range, units conceptually correct")
    } else {
        println("  T5 FAIL")
        all_pass = 0
    }

    // -----------------------------------------------------------------------
    // T6: Comparison — measured chain vs asserted chain
    //     asserted always ends up with lower confidence
    //
    //     measured chain:  dose_m + supp_m         conf = min(0.985, 0.985) = 0.985
    //     asserted chain:  dose_a + supp_a         conf = min(0.965, 0.965) = 0.965
    //
    //     The measured chain has strictly higher confidence than the
    //     asserted chain for identical arithmetic operations.
    // -----------------------------------------------------------------------
    println("T6: measured chain vs asserted chain confidence comparison")

    let supp_a = ek_asserted(50.0, 1.0)    // same numbers, lower confidence

    let sum_measured_chain  = ek_add(dose_m, supp_m)   // all measured: conf = 0.985
    let sum_asserted_chain  = ek_add(dose_a, supp_a)   // all asserted: conf = 0.965

    let t6_val = (sum_measured_chain.conf > sum_asserted_chain.conf) &&
                 (abs_f64(sum_measured_chain.conf - 0.985) < 1.0e-10) &&
                 (abs_f64(sum_asserted_chain.conf - 0.965) < 1.0e-10) &&
                 // Values are identical; only provenance differs
                 (abs_f64(sum_measured_chain.val - sum_asserted_chain.val) < 0.001)

    if t6_val {
        println("  T6 PASS: measured chain conf=0.985 > asserted chain conf=0.965")
    } else {
        println("  T6 FAIL")
        all_pass = 0
    }

    // -----------------------------------------------------------------------
    // Final verdict
    // -----------------------------------------------------------------------
    if all_pass == 1 {
        println("ALL PASS")
        return 0
    } else {
        println("SOME TESTS FAILED")
        return 1
    }
}
