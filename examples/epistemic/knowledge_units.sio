//@ run-pass
unit mg; unit kg;

fn main() -> i32 with IO {
    let dose: Knowledge<mg> = measured(500.0, uncertainty: 2.5)
    let body: Knowledge<kg> = measured(70.0,  uncertainty: 0.5)
    // dose / body → Knowledge<mg/kg>, conf = min(dose.conf, body.conf)
    let rate = dose / body
    println("dose/body computed with dimensional Knowledge<T>")
    return 0
}
