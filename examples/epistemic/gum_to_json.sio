// GUM measurement -> byte-exact JSON object (Data & Science I/O, Trilha A).
//
// JSON sibling of examples/epistemic/gum_to_csv.sio: the same ISO-GUM quantity
// (recovery 98.3 %, u_c 0.290402, k95 1.960, U95 0.569188) emitted as one JSON
// object. Imports ONLY epistemic::gum and inlines the fixed-point number
// formatting (byte-identical to data::json json_member_f64), because a program
// importing two dependency modules fails native emission on Madaros v0.80.0
// (multimodule thin-link, rc=12 — docs/audit/DATA_IO_TRILHA_B_BUILTIN_BUFPTR_DISPATCH_2026-07-14.md).
// The "recovery" string needs no escaping, so it is emitted directly. Collapses
// to data::json calls once the multimodule native path is repaired.
use epistemic::gum::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let ub = gum_type_b_uniform(0.5)
    let ua = gum_type_a(0.070710, 5)
    let r = gum_combine2(98.3, ua, ub)

    var vals: [f64; 4] = [0.0; 4]
    vals[0 as usize] = gum_value(r)
    vals[1 as usize] = gum_std_u(r)
    vals[2 as usize] = gum_k95(r)
    vals[3 as usize] = gum_u95(r)

    var decs: [i64; 4] = [0; 4]
    decs[0 as usize] = 4
    decs[1 as usize] = 6
    decs[2 as usize] = 3
    decs[3 as usize] = 6

    print("{\"quantity\":\"recovery\"")

    var col: i64 = 0
    while col < 4 {
        print(",\"")
        if col == 0 { print("value") } else if col == 1 { print("u_c") } else if col == 2 { print("k95") } else { print("U95") }
        print("\":")

        let d = decs[col as usize]

        var powf: f64 = 1.0
        var kf: i64 = 0
        while kf < d { powf = powf * 10.0; kf = kf + 1 }

        var mag: f64 = vals[col as usize]
        var neg: bool = false
        if mag < 0.0 { neg = true; mag = 0.0 - mag }

        let scaled = (mag * powf + 0.5) as i64

        var pw: i64 = 1
        var ki: i64 = 0
        while ki < d { pw = pw * 10; ki = ki + 1 }

        if neg { print("-") }
        let ip = scaled / pw
        let fp = scaled - ip * pw
        print_int(ip)
        if d > 0 {
            print(".")
            var place: i64 = pw / 10
            while place >= 1 {
                let digit = (fp / place) - ((fp / (place * 10)) * 10)
                print_int(digit)
                place = place / 10
            }
        }

        col = col + 1
    }

    print("}\n")
    return 0
}
