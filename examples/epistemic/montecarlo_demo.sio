fn main() -> i32 {
    if !test_rng_uniform() { return 1 }
    if !test_rng_normal() { return 2 }
    if !test_mc_addition() { return 3 }
    if !test_mc_multiplication() { return 4 }
    if !test_mc_exp_nonlinear() { return 5 }

    return 0
}
