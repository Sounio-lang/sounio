//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// Exp 1: G₂-invariant subspace projection across the pre-ictal window
// ═══════════════════════════════════════════════════════════════════════════
//
// Data: CHB-MIT chb03 (chb03_01.edf), seizure onset 362s, α=0.20.
// Generated by scripts/research/generate_g2_projection_chb03.py.
//
// Quantities (mean over N_WIN=80 steps per probe window):
//   assoc_norm = mean_t ||(A⊗h_t)⊗x_t − A⊗(h_t⊗x_t)||
//   g2_proj    = mean_t ||h_t[1..7]||   (Im(𝕆) ⊂ Im(𝕊): G₂-invariant subspace)
//   g2_comp    = mean_t ||h_t[8..15]||  (sedenion extension complement)
//   g2_ratio   = g2_proj / (g2_proj + g2_comp)   ∈ [0,1]
//
// Probe windows: FAR(-60s), PRE30(-30s), PRE10(-10s), PRE5(-5s), IC(0s), POST(+5s)
//
// ── Falsifier verdict ──────────────────────────────────────────────────────
//
// The G₂-drift hypothesis (Door F) predicted:
//   (a) g2_proj increases monotonically FAR→IC
//   (b) assoc_norm decreases monotonically FAR→IC
//   Both holding simultaneously would confirm the G₂-drift mechanism.
//
// Empirical result (chb03):
//   assoc_norm: 1.349 → 0.509 → 0.517 → 0.532 → 1.387 → 1.521
//     → Dip-then-spike confirmed (quiet zone −30s to −5s, spike at IC)
//     → NOT monotone decreasing (FAR value is already high)
//   g2_proj:    0.644 → 0.587 → 0.633 → 0.643 → 0.648 → 0.641
//     → g2_ratio ≈ constant (~0.49) — NOT monotone increasing
//     → G₂-drift hypothesis FALSIFIED
//
// Implication: the pre-ictal "quiet zone" is a REAL finding (confirmed in
// Door F and reproduced here) but the mechanism is NOT G₂-drift.
// The leading alternative: a transient norm-contraction / dimensionality
// reduction of the sedenion coupling that reduces non-associativity without
// selectively loading the G₂-invariant subspace.
// This is the Simpson's-paradox analogue at the mechanism level.
//
// The seizure paper must revise its mechanism section accordingly.
// The *detector* result (assoc_norm dip → spike) survives.

// ─── Probe window data (from generate_g2_projection_chb03.py) ────────────

// window index: 0=FAR, 1=PRE30, 2=PRE10, 3=PRE5, 4=IC, 5=POST
var TIME_REL: [i64; 6] = [0; 6]    // seconds relative to onset
var ASSOC:    [f64; 6] = [0.0; 6]
var G2PROJ:   [f64; 6] = [0.0; 6]
var G2COMP:   [f64; 6] = [0.0; 6]
var G2RATIO:  [f64; 6] = [0.0; 6]

fn load_data() with Mut {
    TIME_REL[0] = -60;  ASSOC[0] = 1.349119;  G2PROJ[0] = 0.644458;  G2COMP[0] = 0.674004;  G2RATIO[0] = 0.488795
    TIME_REL[1] = -30;  ASSOC[1] = 0.509297;  G2PROJ[1] = 0.587095;  G2COMP[1] = 0.685353;  G2RATIO[1] = 0.461390
    TIME_REL[2] = -10;  ASSOC[2] = 0.517473;  G2PROJ[2] = 0.632670;  G2COMP[2] = 0.656444;  G2RATIO[2] = 0.490779
    TIME_REL[3] =  -5;  ASSOC[3] = 0.531935;  G2PROJ[3] = 0.643080;  G2COMP[3] = 0.655607;  G2RATIO[3] = 0.495177
    TIME_REL[4] =   0;  ASSOC[4] = 1.386807;  G2PROJ[4] = 0.647522;  G2COMP[4] = 0.684013;  G2RATIO[4] = 0.486297
    TIME_REL[5] =  +5;  ASSOC[5] = 1.521533;  G2PROJ[5] = 0.641340;  G2COMP[5] = 0.691423;  G2RATIO[5] = 0.481211
}

// ─── Math helpers ─────────────────────────────────────────────────────────

fn abs_f(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn print_i(v: i64) with IO, Mut {
    if v < 0 { print("-"); print_i(0 - v); return }
    if v >= 10 { print_i(v / 10) }
    let d = v % 10
    if d==0{print("0")}if d==1{print("1")}if d==2{print("2")}if d==3{print("3")}
    if d==4{print("4")}if d==5{print("5")}if d==6{print("6")}if d==7{print("7")}
    if d==8{print("8")}if d==9{print("9")}
}

fn print_f3(v: f64) with IO, Mut, Div, Panic {
    if v < 0.0 { print("-"); print_f3(0.0 - v); return }
    let iv: i64 = v as i64
    print_i(iv); print(".")
    let d1: i64 = ((v - (iv as f64)) * 10.0) as i64
    let d2: i64 = ((v - (iv as f64)) * 100.0) as i64 % 10
    let d3: i64 = ((v - (iv as f64)) * 1000.0) as i64 % 10
    print_i(d1); print_i(d2); print_i(d3)
}

// ─── Monotonicity tests (FAR→IC = indices 0..4) ───────────────────────────

// Returns true if arr[0..n] is non-increasing.
fn is_nonincreasing(arr: &[f64; 6], n: i64) -> bool with Div, Panic {
    var ok: bool = true
    var i: i64 = 0
    while i < n - 1 {
        if arr[i as usize] < arr[(i+1) as usize] {
            ok = false
        }
        i = i + 1
    }
    ok
}

// Returns true if arr[0..n] is non-decreasing.
fn is_nondecreasing(arr: &[f64; 6], n: i64) -> bool with Div, Panic {
    var ok: bool = true
    var i: i64 = 0
    while i < n - 1 {
        if arr[i as usize] > arr[(i+1) as usize] {
            ok = false
        }
        i = i + 1
    }
    ok
}

// ─── Dip detection: assoc drops >30% below FAR baseline ───────────────────

fn dip_present() -> bool {
    // At least one of PRE30, PRE10, PRE5 is >30% below FAR
    let baseline = ASSOC[0]
    let thr      = baseline * 0.70
    ASSOC[1] < thr || ASSOC[2] < thr || ASSOC[3] < thr
}

fn spike_at_ic() -> bool {
    // IC (onset) associator is above PRE5 value
    ASSOC[4] > ASSOC[3]
}

fn g2_ratio_constant() -> bool {
    // g2_ratio varies <0.04 across FAR→IC (5 windows)
    var mn: f64 = G2RATIO[0]
    var mx: f64 = G2RATIO[0]
    var i: i64 = 1
    while i < 5 {
        let v = G2RATIO[i as usize]
        if v < mn { mn = v }
        if v > mx { mx = v }
        i = i + 1
    }
    (mx - mn) < 0.04
}

// ─── Main ─────────────────────────────────────────────────────────────────

fn main() with IO, Mut, Div, Panic {
    load_data()

    // ── Print data table ──────────────────────────────────────────────────
    print("G2 projection across pre-ictal window — chb03 (α=0.20)\n")
    print("window  time  assoc    g2_proj  g2_comp  g2_ratio\n")
    let labels: [string; 6] = ["FAR  ", "PRE30", "PRE10", "PRE5 ", "IC   ", "POST "]
    var i: i64 = 0
    while i < 6 {
        print(labels[i as usize]); print("  ")
        print_i(TIME_REL[i as usize]); print("s  ")
        print_f3(ASSOC[i as usize]);   print("  ")
        print_f3(G2PROJ[i as usize]);  print("  ")
        print_f3(G2COMP[i as usize]);  print("  ")
        print_f3(G2RATIO[i as usize]); print("\n")
        i = i + 1
    }

    print("\n=== Hypothesis tests ===\n")

    // ── T1: Dip-then-spike in assoc_norm (confirmed finding) ──────────────
    let dip_ok   = dip_present()
    let spike_ok = spike_at_ic()
    print("T1a assoc dip pre-ictally (>30% below FAR): ")
    if dip_ok { print("CONFIRMED\n") } else { print("NOT FOUND\n") }
    print("T1b assoc spike at IC onset: ")
    if spike_ok { print("CONFIRMED\n") } else { print("NOT FOUND\n") }
    assert(dip_ok)    // The detector finding must hold
    assert(spike_ok)

    // ── T2: G₂-drift hypothesis (falsified) ───────────────────────────────
    // Predicted: g2_proj monotone increasing FAR→IC (indices 0..4)
    // Predicted: assoc monotone decreasing FAR→IC (indices 0..4)
    let assoc_mono  = is_nonincreasing(&ASSOC,  5)
    let g2proj_mono = is_nondecreasing(&G2PROJ, 5)
    print("T2a assoc monotone decreasing FAR→IC: ")
    if assoc_mono { print("YES\n") } else { print("NO — FAR value is already high\n") }
    print("T2b g2_proj monotone increasing FAR→IC: ")
    if g2proj_mono { print("YES\n") } else { print("NO — g2_ratio ≈ constant\n") }
    // EXPECTED: both false (the falsification result)
    assert(assoc_mono  == false)   // assoc is NOT monotone; FAR > PRE30 but PRE10 > PRE30
    assert(g2proj_mono == false)   // g2_proj is NOT monotone increasing

    // ── T3: G₂-ratio constant (new mechanistic insight) ───────────────────
    let const_ok = g2_ratio_constant()
    print("T3  g2_ratio ≈ constant across FAR→IC (<0.04 variation): ")
    if const_ok { print("CONFIRMED\n") } else { print("NOT CONSTANT\n") }
    assert(const_ok)   // g2_ratio near-constant confirms energy is NOT selectively loading Im(𝕆)

    // ── T4: Assoc dip value vs PRE30 (quantify quiet zone) ────────────────
    let dip_depth = ASSOC[0] - ASSOC[1]   // FAR - PRE30 drop
    let spike_amp = ASSOC[4] - ASSOC[3]   // IC - PRE5 rise
    print("T4  dip depth (FAR-PRE30): "); print_f3(dip_depth); print("\n")
    print("    spike amplitude (IC-PRE5): "); print_f3(spike_amp); print("\n")
    // Both must be positive: real dip occurred, real spike at onset
    assert(dip_depth > 0.0)
    assert(spike_amp > 0.0)

    print("\n=== Verdict ===\n")
    print("Detector finding (dip-then-spike): CONFIRMED\n")
    print("Door F mechanism (G2-drift): FALSIFIED\n")
    print("Revised mechanism: transient norm-contraction / dim-reduction\n")
    print("Action: revise mechanism section; detector result stands\n")

    print("\nALL PASS\n")
}
