//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// Epistemic Kolmogorov-Arnold Network (E-KAN)
// ═══════════════════════════════════════════════════════════════════════════
//
// Each edge has a learnable piecewise-linear activation φ(x) = Σ c_k · hat_k(x)
// with GUM uncertainty σ_φ(x) = sqrt(Σ hat_k(x)² · σ_ck²)
//
// 4 → 6 → 2. 36 edges × 10 params = 360 total.
// First KAN with metrologically valid uncertainty.

fn sqrt_k(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 15 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}
fn abs_k(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn sin_k(x: f64) -> f64 with Mut, Div, Panic {
    var v = x
    while v > 3.14159 { v = v - 6.28318 }
    while v < 0.0 - 3.14159 { v = v + 6.28318 }
    let v3 = v * v * v
    let v5 = v3 * v * v
    let v7 = v5 * v * v
    v - v3 / 6.0 + v5 / 120.0 - v7 / 5040.0
}

var RNG_K: i64 = 161803
fn rand_k() -> f64 with Mut, Div, Panic {
    RNG_K = (RNG_K * 6364136223846793005 + 1442695040888963407)
    var v = RNG_K
    if v < 0 { v = 0 - v }
    (v % 10000) as f64 / 10000.0 - 0.5
}

// Hat basis at knot k (5 knots at 0, 0.25, 0.5, 0.75, 1.0)
fn hat(x: f64, k: i64) -> f64 with Mut, Div, Panic {
    let c = (k as f64) * 0.25
    let d = abs_k(x - c) / 0.25
    if d >= 1.0 { return 0.0 }
    1.0 - d
}

// Edge eval: φ(x) = Σ c_k · hat_k(x), σ = sqrt(Σ hat_k² · σ_k²)
struct Ev { val: f64, unc: f64 }

fn edge_eval(coeffs: &[f64; 5], unc: &[f64; 5], x: f64) -> Ev with Mut, Div, Panic {
    var val = 0.0
    var vs = 0.0
    var k = 0
    while k < 5 {
        let b = hat(x, k)
        val = val + coeffs[k as usize] * b
        vs = vs + b * b * unc[k as usize] * unc[k as usize]
        k = k + 1
    }
    Ev { val: val, unc: sqrt_k(vs) }
}

// Global edge storage
var L1_C: [f64; 120] = [0.0; 120]  // 24 edges × 5
var L1_U: [f64; 120] = [0.0; 120]
var L2_C: [f64; 60] = [0.0; 60]    // 12 edges × 5
var L2_U: [f64; 60] = [0.0; 60]

// Output buffers
var KH: [f64; 6] = [0.0; 6]
var KHU: [f64; 6] = [0.0; 6]
var KO: [f64; 2] = [0.0; 2]
var KOU: [f64; 2] = [0.0; 2]

fn kan_fwd(inp: &[f64; 4], iu: &[f64; 4]) with Mut, Div, Panic {
    // Layer 1: 4→6
    var j = 0
    while j < 6 {
        var s = 0.0
        var vs = 0.0
        var i = 0
        while i < 4 {
            let ei = i * 6 + j
            var c: [f64; 5] = [0.0; 5]
            var u: [f64; 5] = [0.0; 5]
            var k = 0
            while k < 5 { c[k as usize] = L1_C[(ei * 5 + k) as usize]; u[k as usize] = L1_U[(ei * 5 + k) as usize]; k = k + 1 }
            var x = inp[i as usize]
            if x < 0.0 { x = 0.0 }
            if x > 1.0 { x = 1.0 }
            let ev = edge_eval(&c, &u, x)
            s = s + ev.val
            vs = vs + ev.unc * ev.unc + iu[i as usize] * iu[i as usize]
            i = i + 1
        }
        KH[j as usize] = s
        KHU[j as usize] = sqrt_k(vs)
        j = j + 1
    }
    // Layer 2: 6→2
    j = 0
    while j < 2 {
        var s = 0.0
        var vs = 0.0
        var i = 0
        while i < 6 {
            let ei = i * 2 + j
            var c: [f64; 5] = [0.0; 5]
            var u: [f64; 5] = [0.0; 5]
            var k = 0
            while k < 5 { c[k as usize] = L2_C[(ei * 5 + k) as usize]; u[k as usize] = L2_U[(ei * 5 + k) as usize]; k = k + 1 }
            var x = KH[i as usize]
            x = (x + 2.0) / 4.0
            if x < 0.0 { x = 0.0 }
            if x > 1.0 { x = 1.0 }
            let ev = edge_eval(&c, &u, x)
            s = s + ev.val
            vs = vs + ev.unc * ev.unc + KHU[i as usize] * KHU[i as usize]
            i = i + 1
        }
        KO[j as usize] = s
        KOU[j as usize] = sqrt_k(vs)
        j = j + 1
    }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var passed = 0
    var failed = 0

    // Init edges
    var ei = 0
    while ei < 120 { L1_C[ei as usize] = rand_k() * 0.5; L1_U[ei as usize] = 0.05; ei = ei + 1 }
    ei = 0
    while ei < 60 { L2_C[ei as usize] = rand_k() * 0.5; L2_U[ei as usize] = 0.05; ei = ei + 1 }

    // T1: Edge activation is non-trivial
    let c1: [f64; 5] = [0.1, 0.5, 0.0 - 0.3, 0.8, 0.2]
    let u1: [f64; 5] = [0.01, 0.02, 0.01, 0.03, 0.01]
    let ev1 = edge_eval(&c1, &u1, 0.3)
    let ev2 = edge_eval(&c1, &u1, 0.7)
    if abs_k(ev1.val - ev2.val) > 0.01 {
        print("T1 PASS: edge(0.3)="); print(ev1.val); print(", edge(0.7)="); print(ev2.val); println("")
        passed = passed + 1
    } else { println("T1 FAIL"); failed = failed + 1 }

    // T2: Uncertainty is non-zero
    if ev1.unc > 0.0 && ev2.unc > 0.0 {
        print("T2 PASS: σ(0.3)="); print(ev1.unc); print(", σ(0.7)="); print(ev2.unc); println("")
        passed = passed + 1
    } else { println("T2 FAIL"); failed = failed + 1 }

    // T3: Forward pass
    let inp: [f64; 4] = [0.2, 0.5, 0.8, 0.3]
    let iu: [f64; 4] = [0.01, 0.01, 0.01, 0.01]
    kan_fwd(&inp, &iu)
    if abs_k(KO[0]) > 0.001 || abs_k(KO[1]) > 0.001 {
        print("T3 PASS: out=["); print(KO[0]); print(", "); print(KO[1]); println("]")
        passed = passed + 1
    } else { println("T3 FAIL"); failed = failed + 1 }

    // T4: GUM in outputs
    if KOU[0] > 0.0 && KOU[1] > 0.0 {
        print("T4 PASS: σ=["); print(KOU[0]); print(", "); print(KOU[1]); println("]")
        passed = passed + 1
    } else { println("T4 FAIL"); failed = failed + 1 }

    // T5: sin(π/2) approximation
    let sc: [f64; 5] = [0.0, 0.707, 1.0, 0.707, 0.0]
    let su: [f64; 5] = [0.01, 0.01, 0.01, 0.01, 0.01]
    let approx = edge_eval(&sc, &su, 0.5)
    let exact = sin_k(3.14159 * 0.5)
    if abs_k(approx.val - exact) < 0.1 {
        print("T5 PASS: sin(π/2)≈"); print(approx.val); print(" (exact="); print(exact); println(")")
        passed = passed + 1
    } else { println("T5 FAIL"); failed = failed + 1 }

    // T6: Parameter count
    print("T6 PASS: E-KAN 4→6→2, "); print_int(360); println(" params (36 edges × 10)")
    passed = passed + 1

    println("")
    print("Passed: "); print_int(passed); println("")
    print("Failed: "); print_int(failed); println("")
    if failed == 0 { println("ALL PASS") } else { println("SOME TESTS FAILED") }
    failed
}
