// examples/fpga/dot_product_kernel.sio
//
// Second kernel for the ADR-022 promotion criterion: a differently
// shaped kernel (1D arrays, multiply-accumulate reduction, no nested
// arrays, no histogram output, no branching) that must survive the
// prototype gate WITHOUT new emitter translation rules.
//
// Semantics: sum over i in 0..n of a[i] * b[i], in i64.

fn dot_product(a: [i64; 1024], b: [i64; 1024], n: i64) -> i64 with Mut {
    var acc: i64 = 0
    for i in 0..n {
        acc = acc + a[i as usize] * b[i as usize]
    }
    acc
}

fn main() -> i32 with IO, Mut {
    var a: [i64; 1024] = [0; 1024]
    var b: [i64; 1024] = [0; 1024]
    a[0] = 3
    b[0] = 4
    a[1] = 5
    b[1] = 6
    a[2] = 7
    b[2] = 8
    let r = dot_product(a, b, 3)
    if r == 12 + 30 + 56 {
        print("DOT_PRODUCT_KERNEL_SIO_PASS\n")
        return 0 as i32
    }
    print("DOT_PRODUCT_KERNEL_SIO_FAIL\n")
    return 1 as i32
}
