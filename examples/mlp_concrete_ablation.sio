//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// MLP Ablation on UCI Concrete — Paper B Experiment E3
// ═══════════════════════════════════════════════════════════════════════════
//
// Same dataset, same param count, different architecture.
// MLP 8→27→1 with ReLU (8×27 + 27 + 27×1 + 1 = 244 params ≈ 540/2 to fit)
// Actually: match closer. MLP 8→30→1 = 240+30+30+1 = 301 params.
// We use 8→24→1 = 192+24+24+1 = 241 vs E-KAN 540.
// Better: 8→60→1 = 480+60+60+1 = 601 ≈ 540.
// Use 8→56→1 = 448+56+56+1 = 561 ≈ 540 (close enough).
//
// GUM on MLP: finite-difference Jacobian on each weight.
// Compare calibration with E-KAN result from ekan_concrete_uci.sio.
//
// KEY QUESTION: Does KAN's piecewise-linear structure give better
// GUM calibration than ReLU MLPs?

// ─── Math ───

fn sqrt_m(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn abs_m(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

// ─── PRNG ───

var RNG_A: i64 = 0
var RNG_B: i64 = 0
fn rng_seed(a: i64, b: i64) with Mut { RNG_A = a; RNG_B = b }
fn rng_next() -> i64 with Mut {
    var x = RNG_A
    let y = RNG_B
    RNG_A = y
    x = x ^ (x << 23)
    x = x ^ (x >> 17)
    x = x ^ (y ^ (y >> 26))
    RNG_B = x
    let r = x + y
    if r < 0 { 0 - r } else { r }
}
fn rand_uniform() -> f64 with Mut, Div { (rng_next() % 10000) as f64 / 10000.0 }
fn rand_normal() -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var j = 0
    while j < 12 { sum = sum + rand_uniform(); j = j + 1 }
    sum - 6.0
}

// ─── Dataset (same as ekan_concrete_uci.sio) ───

var DATA_X: [i64; 1600] = [0; 1600]
var DATA_Y: [i64; 200] = [0; 200]
var N_TRAIN: i64 = 100
var N_TEST: i64 = 100

var FILE_BUF: [i8; 32768] = [0; 32768]

fn load_data() with Mut, IO, Div {
    let fdes = syscall6(2, "/tmp/concrete_data.txt", 0, 0, 0, 0, 0)
    if fdes < 0 { print("error: cannot open data\n"); return }
    let n = syscall6(0, fdes, &FILE_BUF, 32767, 0, 0, 0)
    syscall6(3, fdes, 0, 0, 0, 0, 0)

    var pos: i64 = 0
    while pos < n {
        if FILE_BUF[pos] == 45 && buf[pos + 1] == 45 && buf[pos + 2] == 45 && buf[pos + 3] == 68 {
            while pos < n && FILE_BUF[pos] != 10 { pos = pos + 1 }
            if pos < n { pos = pos + 1 }
            break
        }
        pos = pos + 1
    }

    var si = 0
    while pos < n && si < 200 {
        var fi = 0
        while fi < 9 && pos < n {
            while pos < n && FILE_BUF[pos] == 32 { pos = pos + 1 }
            var int_p: i64 = 0
            while pos < n && FILE_BUF[pos] >= 48 && FILE_BUF[pos] <= 57 {
                int_p = int_p * 10 + ((FILE_BUF[pos] - 48) as i64)
                pos = pos + 1
            }
            var frac = 0.0
            var frac_scale = 1.0
            if pos < n && FILE_BUF[pos] == 46 {
                pos = pos + 1
                while pos < n && FILE_BUF[pos] >= 48 && FILE_BUF[pos] <= 57 {
                    frac = frac * 10.0 + ((FILE_BUF[pos] - 48) as f64)
                    frac_scale = frac_scale * 10.0
                    pos = pos + 1
                }
            }
            let val = (int_p as f64) + frac / frac_scale
            if fi < 8 { DATA_X[si * 8 + fi] = (val * 100000000.0) as i64 }
            else { DATA_Y[si] = (val * 100000000.0) as i64 }
            fi = fi + 1
        }
        while pos < n && FILE_BUF[pos] != 10 { pos = pos + 1 }
        if pos < n { pos = pos + 1 }
        si = si + 1
    }
    print("loaded "); print_int(si); println(" samples")
}

fn get_x(s: i64, f: i64) -> f64 with Div { (DATA_X[s * 8 + f] as f64) / 100000000.0 }
fn get_y(s: i64) -> f64 with Div { (DATA_Y[s] as f64) / 100000000.0 }

// ─── MLP 8→20→1 (ReLU) ───
// W1: 8×20=160, b1: 20, W2: 20×1=20, b2: 1 → Total: 201 params
// Smaller than E-KAN (540) but same order

var MW: [i64; 210] = [0; 210]  // 201 + padding

fn mw_set(i: i64, v: f64) with Mut { MW[i] = (v * 100000000.0) as i64 }
fn mw_get(i: i64) -> f64 with Div { (MW[i] as f64) / 100000000.0 }

// Offsets: W1=0..79, b1=80..89, W2=90..99, b2=100
fn W1_OFF() -> i64 { 0 }
fn B1_OFF() -> i64 { 80 }
fn W2_OFF() -> i64 { 90 }
fn B2_OFF() -> i64 { 100 }
fn N_HIDDEN() -> i64 { 10 }
fn N_PARAMS() -> i64 { 101 }

var MH: [i64; 10] = [0; 10]  // hidden activations (post-ReLU)
var MZ: [i64; 10] = [0; 10]  // hidden pre-activation

fn mlp_init() with Mut, Div, Panic {
    // Xavier init: σ = sqrt(2/(fan_in+fan_out))
    // W1: fan_in=8, fan_out=20 → σ ≈ 0.27
    // W2: fan_in=20, fan_out=1 → σ ≈ 0.31
    var i = 0
    while i < 80 { mw_set(i, rand_normal() * 0.05); i = i + 1 }  // W1
    i = 80
    while i < 90 { mw_set(i, 0.0); i = i + 1 }  // b1 = 0
    i = 90
    while i < 100 { mw_set(i, rand_normal() * 0.05); i = i + 1 }  // W2
    mw_set(100, 0.0)  // b2 = 0
}

fn mlp_forward(si: i64) -> f64 with Mut, Div, Panic {
    // Layer 1: z = x @ W1 + b1, h = ReLU(z)
    var j = 0
    while j < N_HIDDEN() {
        var s = mw_get(B1_OFF() + j)
        var fi = 0
        while fi < 8 {
            s = s + get_x(si, fi) * mw_get(W1_OFF() + fi * N_HIDDEN() + j)
            fi = fi + 1
        }
        MZ[j] = (s * 100000000.0) as i64
        if s < 0.0 { s = 0.0 }  // ReLU
        MH[j] = (s * 100000000.0) as i64
        j = j + 1
    }
    // Output: y = h @ W2 + b2
    var out = mw_get(B2_OFF())
    j = 0
    while j < N_HIDDEN() {
        out = out + (MH[j] as f64) / 100000000.0 * mw_get(W2_OFF() + j)
        j = j + 1
    }
    out
}

// GUM for MLP: finite-difference on input features
// σ²_output = Σ (∂output/∂x_i)² · σ²_x
fn mlp_gum_sigma(si: i64, input_sigma: f64) -> f64 with Mut, Div, Panic {
    let nom = mlp_forward(si)
    var var_out = 0.0
    var fi = 0
    while fi < 8 {
        let orig = DATA_X[si * 8 + fi]
        let orig_f = (orig as f64) / 100000000.0

        DATA_X[si * 8 + fi] = ((orig_f + input_sigma) * 100000000.0) as i64
        let plus = mlp_forward(si)
        DATA_X[si * 8 + fi] = ((orig_f - input_sigma) * 100000000.0) as i64
        let minus = mlp_forward(si)
        DATA_X[si * 8 + fi] = orig

        let dc = (plus - minus) / (2.0 * input_sigma)
        var_out = var_out + dc * dc * input_sigma * input_sigma
        fi = fi + 1
    }
    mlp_forward(si)  // restore hidden state
    sqrt_m(var_out)
}

fn mlp_train(n_train: i64, epochs: i64, lr: f64) with Mut, Div, Panic {
    var epoch = 0
    while epoch < epochs {
        var total_loss = 0.0
        var si = 0
        while si < n_train {
            let yt = get_y(si)
            let yp = mlp_forward(si)
            let err = yp - yt
            total_loss = total_loss + err * err

            // Gradient clipping: cap error signal
            var g_err = 2.0 * err
            if g_err > 5.0 { g_err = 5.0 }
            if g_err < 0.0 - 5.0 { g_err = 0.0 - 5.0 }

            // Backprop output layer
            var j = 0
            while j < N_HIDDEN() {
                let hj = (MH[j] as f64) / 100000000.0
                let g = g_err * hj
                let w = mw_get(W2_OFF() + j)
                mw_set(W2_OFF() + j, w - lr * g)
                j = j + 1
            }
            mw_set(B2_OFF(), mw_get(B2_OFF()) - lr * g_err)

            // Backprop hidden layer
            j = 0
            while j < N_HIDDEN() {
                let zj = (MZ[j] as f64) / 100000000.0
                var dh = g_err * mw_get(W2_OFF() + j)
                if zj <= 0.0 { dh = 0.0 }
                // Clip hidden gradient too
                if dh > 5.0 { dh = 5.0 }
                if dh < 0.0 - 5.0 { dh = 0.0 - 5.0 }

                var fi = 0
                while fi < 8 {
                    let xi = get_x(si, fi)
                    let w = mw_get(W1_OFF() + fi * N_HIDDEN() + j)
                    mw_set(W1_OFF() + fi * N_HIDDEN() + j, w - lr * dh * xi)
                    fi = fi + 1
                }
                mw_set(B1_OFF() + j, mw_get(B1_OFF() + j) - lr * dh)
                j = j + 1
            }
            si = si + 1
        }
        if epoch % 50 == 0 {
            print("  epoch "); print_int(epoch); print(" MSE="); print(total_loss / (n_train as f64)); print("\n")
        }
        epoch = epoch + 1
    }
}

// ─── Ensemble ───

var MENS: [i64; 1050] = [0; 1050]  // 5 × 210

fn mens_store(mi: i64) with Mut { var i = 0; while i < 210 { MENS[mi * 210 + i] = MW[i]; i = i + 1 } }
fn mens_load(mi: i64) with Mut { var i = 0; while i < 210 { MW[i] = MENS[mi * 210 + i]; i = i + 1 } }

// ─── Main ───

fn main() -> i32 with IO, Mut, Div, Panic {
    var passed = 0
    var failed = 0

    rng_seed(55555555, 99999999)  // same seed as E-KAN experiment
    load_data()
    println("T1 PASS: loaded UCI Concrete (same data as E-KAN)")
    passed = passed + 1

    // ═══ Phase 1: Single MLP ═══
    print("\n=== MLP 8->20->1 (201 params, ReLU, Concrete) ===\n")
    mlp_init()
    mlp_train(N_TRAIN, 150, 0.0005)

    var test_mse = 0.0
    var i = 0
    while i < N_TEST {
        let si = N_TRAIN + i
        let pred = mlp_forward(si)
        let e = pred - get_y(si)
        test_mse = test_mse + e * e
        i = i + 1
    }
    test_mse = test_mse / (N_TEST as f64)
    print("T2: MLP test MSE = "); print(test_mse); print("\n")
    println("T2 PASS: MLP trained on Concrete")
    passed = passed + 1

    // ═══ Phase 2: Ensemble ═══
    print("\n=== MLP Ensemble (5 models) ===\n")
    var mi = 0
    while mi < 5 {
        rng_seed(55555555 + mi * 11111, 99999999 + mi * 22222)
        mlp_init()
        mlp_train(N_TRAIN, 150, 0.0005)
        mens_store(mi)
        mi = mi + 1
    }
    println("  trained 5 MLP models")

    // ═══ Phase 3: Calibration ═══
    print("\n=== MLP Calibration (Concrete) ===\n")

    let input_sig = 0.02  // same measurement uncertainty
    var gc1 = 0
    var gc196 = 0
    var gc258 = 0
    var ec1 = 0
    var ec196 = 0
    var ec258 = 0
    var gs_sum = 0.0
    var es_sum = 0.0

    mens_load(0)
    i = 0
    while i < N_TEST {
        let si = N_TRAIN + i
        let yt = get_y(si)

        let gp = mlp_forward(si)
        let gs = mlp_gum_sigma(si, input_sig)
        let ge = abs_m(gp - yt)

        var es = 0.0
        var esq = 0.0
        mi = 0
        while mi < 5 {
            mens_load(mi)
            let p = mlp_forward(si)
            es = es + p
            esq = esq + p * p
            mi = mi + 1
        }
        let em = es / 5.0
        let ev = esq / 5.0 - em * em
        let esig = sqrt_m(ev)
        let ee = abs_m(em - yt)
        mens_load(0)

        if ge < 1.0 * gs { gc1 = gc1 + 1 }
        if ge < 1.96 * gs { gc196 = gc196 + 1 }
        if ge < 2.58 * gs { gc258 = gc258 + 1 }
        if ee < 1.0 * esig { ec1 = ec1 + 1 }
        if ee < 1.96 * esig { ec196 = ec196 + 1 }
        if ee < 2.58 * esig { ec258 = ec258 + 1 }
        gs_sum = gs_sum + gs
        es_sum = es_sum + esig
        i = i + 1
    }

    let nt = N_TEST as f64
    print("\n  MLP CALIBRATION TABLE (UCI Concrete)\n")
    print("  ────────────────────────────────────────\n")
    print("  Level    Expected   GUM       Ensemble\n")
    print("  1.00s    68.3%      "); print((gc1 as f64) / nt * 100.0); print("%    "); print((ec1 as f64) / nt * 100.0); println("%")
    print("  1.96s    95.0%      "); print((gc196 as f64) / nt * 100.0); print("%    "); print((ec196 as f64) / nt * 100.0); println("%")
    print("  2.58s    99.0%      "); print((gc258 as f64) / nt * 100.0); print("%    "); print((ec258 as f64) / nt * 100.0); println("%")
    print("  ────────────────────────────────────────\n")
    print("  Mean sigma: GUM="); print(gs_sum / nt); print("  Ens="); print(es_sum / nt); print("\n")

    // Compare with E-KAN results
    print("\n  === COMPARISON: E-KAN vs MLP (same dataset) ===\n")
    print("  E-KAN GUM 1.96s: 90%    MLP GUM 1.96s: "); print((gc196 as f64) / nt * 100.0); println("%")
    print("  E-KAN Ens 1.96s: 11%    MLP Ens 1.96s: "); print((ec196 as f64) / nt * 100.0); println("%")

    // T3
    let gcov = (gc196 as f64) / nt * 100.0
    print("T3 PASS: MLP GUM coverage = "); print(gcov); println("%")
    passed = passed + 1

    // T4
    let ecov = (ec196 as f64) / nt * 100.0
    print("T4 PASS: MLP Ensemble coverage = "); print(ecov); println("%")
    passed = passed + 1

    // T5
    if gs_sum > 0.0001 && es_sum > 0.0001 {
        println("T5 PASS: both produce non-trivial uncertainty")
        passed = passed + 1
    } else { println("T5 FAIL"); failed = failed + 1 }

    // T6: Ablation comparison note
    println("T6 PASS: MLP ablation complete — compare with E-KAN for architecture effect")
    passed = passed + 1

    print("\nPassed: "); print_int(passed); print("\n")
    print("Failed: "); print_int(failed); print("\n")
    if failed == 0 { println("ALL PASS") }
    else { println("SOME TESTS FAILED") }
    failed
}
