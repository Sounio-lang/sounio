//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// MLP Ablation on UCI Concrete — Paper B Experiment E3
// ═══════════════════════════════════════════════════════════════════════════
//
// Same dataset as E-KAN (ekan_concrete_uci.sio), MLP architecture.
// MLP 8→10→1 with ReLU (101 params) vs E-KAN 8→10→1 (540 params).
// KEY: keep main() lean — decompose into small functions.

fn sqrt_m(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}
fn abs_m(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

var RNG_A: i64 = 0
var RNG_B: i64 = 0
fn rng_seed(a: i64, b: i64) with Mut { RNG_A = a; RNG_B = b }
fn rng_next() -> i64 with Mut {
    var x = RNG_A
    let y = RNG_B
    RNG_A = y
    x = x ^ (x << 23)
    x = x ^ (x >> 17)
    x = x ^ (y ^ (y >> 26))
    RNG_B = x
    let r = x + y
    if r < 0 { 0 - r } else { r }
}
fn rand_uniform() -> f64 with Mut, Div { (rng_next() % 10000) as f64 / 10000.0 }
fn rand_normal() -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var j = 0
    while j < 12 { sum = sum + rand_uniform(); j = j + 1 }
    sum - 6.0
}

// ─── Dataset ───
var DX: [i64; 1600] = [0; 1600]
var DYY: [i64; 200] = [0; 200]
var N_LOADED: i64 = 0

fn get_x(s: i64, f: i64) -> f64 with Div { (DX[s * 8 + f] as f64) / 100000000.0 }
fn get_y(s: i64) -> f64 with Div { (DYY[s] as f64) / 100000000.0 }

fn load_concrete() with IO, Mut, Div {
    var buf: [i8; 4096] = [0; 4096]
    let fd = syscall6(2, "/tmp/concrete_data.txt", 0, 0, 0, 0, 0)
    if fd < 0 { return }
    let n = syscall6(0, fd, &buf, 4095, 0, 0, 0)
    syscall6(3, fd, 0, 0, 0, 0, 0)
    var pos: i64 = 0
    while pos < n {
        if buf[pos] == 45 && buf[pos + 1] == 45 && buf[pos + 2] == 45 && buf[pos + 3] == 68 {
            while pos < n && buf[pos] != 10 { pos = pos + 1 }
            if pos < n { pos = pos + 1 }
            break
        }
        pos = pos + 1
    }
    var si = 0
    while pos < n && si < 100 {
        var fi = 0
        while fi < 9 && pos < n {
            while pos < n && buf[pos] == 32 { pos = pos + 1 }
            var ip: i64 = 0
            while pos < n && buf[pos] >= 48 && buf[pos] <= 57 {
                ip = ip * 10 + ((buf[pos] - 48) as i64)
                pos = pos + 1
            }
            var frac = 0.0
            var fs = 1.0
            if pos < n && buf[pos] == 46 {
                pos = pos + 1
                while pos < n && buf[pos] >= 48 && buf[pos] <= 57 {
                    frac = frac * 10.0 + ((buf[pos] - 48) as f64)
                    fs = fs * 10.0
                    pos = pos + 1
                }
            }
            let val = (ip as f64) + frac / fs
            if fi < 8 { DX[si * 8 + fi] = (val * 100000000.0) as i64 }
            else { DYY[si] = (val * 100000000.0) as i64 }
            fi = fi + 1
        }
        while pos < n && buf[pos] != 10 { pos = pos + 1 }
        if pos < n { pos = pos + 1 }
        si = si + 1
    }
    N_LOADED = si
    print("loaded "); print_int(si); println(" samples")
}

// ─── MLP 8→10→1 ───
var MW: [i64; 110] = [0; 110]
var MH: [i64; 10] = [0; 10]
var MZ: [i64; 10] = [0; 10]
var MENS: [i64; 550] = [0; 550]

fn mw_set(i: i64, v: f64) with Mut { MW[i] = (v * 100000000.0) as i64 }
fn mw_get(i: i64) -> f64 with Div { (MW[i] as f64) / 100000000.0 }
fn mens_store(mi: i64) with Mut { var i = 0; while i < 110 { MENS[mi * 110 + i] = MW[i]; i = i + 1 } }
fn mens_load(mi: i64) with Mut { var i = 0; while i < 110 { MW[i] = MENS[mi * 110 + i]; i = i + 1 } }

fn mlp_init() with Mut, Div, Panic {
    var i = 0
    while i < 80 { mw_set(i, rand_normal() * 0.05); i = i + 1 }
    i = 80
    while i < 90 { mw_set(i, 0.0); i = i + 1 }
    i = 90
    while i < 100 { mw_set(i, rand_normal() * 0.05); i = i + 1 }
    mw_set(100, 0.0)
}

fn mlp_forward(si: i64) -> f64 with Mut, Div, Panic {
    var j = 0
    while j < 10 {
        var s = mw_get(80 + j)
        var fi = 0
        while fi < 8 { s = s + get_x(si, fi) * mw_get(fi * 10 + j); fi = fi + 1 }
        MZ[j] = (s * 100000000.0) as i64
        if s < 0.0 { s = 0.0 }
        MH[j] = (s * 100000000.0) as i64
        j = j + 1
    }
    var out = mw_get(100)
    j = 0
    while j < 10 { out = out + (MH[j] as f64) / 100000000.0 * mw_get(90 + j); j = j + 1 }
    out
}

fn mlp_backprop(si: i64, lr: f64) with Mut, Div, Panic {
    let err = mlp_forward(si) - get_y(si)
    var ge = 2.0 * err
    if ge > 1.0 { ge = 1.0 }
    if ge < 0.0 - 1.0 { ge = 0.0 - 1.0 }

    var j = 0
    while j < 10 {
        mw_set(90 + j, mw_get(90 + j) - lr * ge * (MH[j] as f64) / 100000000.0)
        j = j + 1
    }
    mw_set(100, mw_get(100) - lr * ge)

    j = 0
    while j < 10 {
        let zj = (MZ[j] as f64) / 100000000.0
        var dh = ge * mw_get(90 + j)
        if zj <= 0.0 { dh = 0.0 }
        if dh > 1.0 { dh = 1.0 }
        if dh < 0.0 - 1.0 { dh = 0.0 - 1.0 }
        var fi = 0
        while fi < 8 {
            mw_set(fi * 10 + j, mw_get(fi * 10 + j) - lr * dh * get_x(si, fi))
            fi = fi + 1
        }
        mw_set(80 + j, mw_get(80 + j) - lr * dh)
        j = j + 1
    }
}

fn mlp_train(nt: i64, epochs: i64, lr: f64) with Mut, Div, Panic {
    var epoch = 0
    while epoch < epochs {
        var tl = 0.0
        var si = 0
        while si < nt {
            let p = mlp_forward(si)
            let e = p - get_y(si)
            tl = tl + e * e
            mlp_backprop(si, lr)
            si = si + 1
        }
        if epoch % 50 == 0 { print("  epoch "); print_int(epoch); print(" MSE="); print(tl / (nt as f64)); print("\n") }
        epoch = epoch + 1
    }
}

fn mlp_gum_sigma(si: i64, isig: f64) -> f64 with Mut, Div, Panic {
    let nom = mlp_forward(si)
    var vout = 0.0
    var fi = 0
    while fi < 8 {
        let orig = DX[si * 8 + fi]
        let ov = (orig as f64) / 100000000.0
        DX[si * 8 + fi] = ((ov + isig) * 100000000.0) as i64
        let plus = mlp_forward(si)
        DX[si * 8 + fi] = ((ov - isig) * 100000000.0) as i64
        let minus = mlp_forward(si)
        DX[si * 8 + fi] = orig
        let dc = (plus - minus) / (2.0 * isig)
        vout = vout + dc * dc * isig * isig
        fi = fi + 1
    }
    mlp_forward(si)
    sqrt_m(vout)
}

// ─── Calibration ───
var MC1: i64 = 0
var MC196: i64 = 0
var MC258: i64 = 0
var ME1: i64 = 0
var ME196: i64 = 0
var ME258: i64 = 0
var MGS: i64 = 0
var MES: i64 = 0

fn run_mlp_calibration(n_train: i64, n_test: i64) with Mut, Div, Panic {
    let isig = 0.02
    MC1 = 0; MC196 = 0; MC258 = 0
    ME1 = 0; ME196 = 0; ME258 = 0
    var gs_sum = 0.0
    var es_sum = 0.0

    mens_load(0)
    var i = 0
    while i < n_test {
        let si = n_train + i
        let yt = get_y(si)
        let gp = mlp_forward(si)
        let gs = mlp_gum_sigma(si, isig)
        let ge = abs_m(gp - yt)

        var es = 0.0
        var esq = 0.0
        var mi = 0
        while mi < 3 {
            mens_load(mi)
            let p = mlp_forward(si)
            es = es + p
            esq = esq + p * p
            mi = mi + 1
        }
        let em = es / 3.0
        let ev = esq / 3.0 - em * em
        let esig = sqrt_m(ev)
        let ee = abs_m(em - yt)
        mens_load(0)

        if ge < 1.0 * gs { MC1 = MC1 + 1 }
        if ge < 1.96 * gs { MC196 = MC196 + 1 }
        if ge < 2.58 * gs { MC258 = MC258 + 1 }
        if ee < 1.0 * esig { ME1 = ME1 + 1 }
        if ee < 1.96 * esig { ME196 = ME196 + 1 }
        if ee < 2.58 * esig { ME258 = ME258 + 1 }
        gs_sum = gs_sum + gs
        es_sum = es_sum + esig
        i = i + 1
    }
    MGS = (gs_sum * 100000000.0) as i64
    MES = (es_sum * 100000000.0) as i64
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var passed = 0
    var failed = 0

    load_concrete()
    let n_train = N_LOADED / 2
    let n_test = N_LOADED - n_train

    if N_LOADED >= 40 {
        println("T1 PASS: loaded UCI Concrete")
        passed = passed + 1
    } else { println("T1 FAIL"); failed = failed + 1 }

    print("\n=== MLP 8->10->1 (101 params, ReLU) ===\n")
    rng_seed(55555555, 99999999)
    mlp_init()
    mlp_train(n_train, 200, 0.0005)

    var test_mse = 0.0
    var i = 0
    while i < n_test {
        let e = mlp_forward(n_train + i) - get_y(n_train + i)
        test_mse = test_mse + e * e
        i = i + 1
    }
    test_mse = test_mse / (n_test as f64)
    print("T2: MLP test MSE = "); print(test_mse); println("")
    println("T2 PASS: MLP trained")
    passed = passed + 1

    print("\n=== MLP Ensemble (3 models) ===\n")
    var mi = 0
    while mi < 3 {
        rng_seed(55555555 + mi * 11111, 99999999 + mi * 22222)
        mlp_init()
        mlp_train(n_train, 200, 0.0005)
        mens_store(mi)
        mi = mi + 1
    }
    println("  trained 3 MLP models")

    print("\n=== MLP Calibration ===\n")
    run_mlp_calibration(n_train, n_test)

    let nt = n_test as f64
    print("\n  MLP CALIBRATION TABLE (UCI Concrete)\n")
    print("  ────────────────────────────────────────\n")
    print("  Level    Expected   GUM       Ensemble\n")
    print("  1.00s    68.3%      "); print((MC1 as f64) / nt * 100.0); print("%    "); print((ME1 as f64) / nt * 100.0); println("%")
    print("  1.96s    95.0%      "); print((MC196 as f64) / nt * 100.0); print("%    "); print((ME196 as f64) / nt * 100.0); println("%")
    print("  2.58s    99.0%      "); print((MC258 as f64) / nt * 100.0); print("%    "); print((ME258 as f64) / nt * 100.0); println("%")
    print("  ────────────────────────────────────────\n")
    print("  Mean sigma: GUM="); print((MGS as f64) / 100000000.0 / nt)
    print("  Ens="); print((MES as f64) / 100000000.0 / nt); print("\n")

    print("\n  === E-KAN vs MLP on same data ===\n")
    print("  E-KAN GUM 1.96s: 90%    MLP GUM 1.96s: "); print((MC196 as f64) / nt * 100.0); println("%")

    let gcov = (MC196 as f64) / nt * 100.0
    print("T3 PASS: MLP GUM coverage = "); print(gcov); println("%")
    passed = passed + 1

    let ecov = (ME196 as f64) / nt * 100.0
    print("T4 PASS: MLP Ensemble coverage = "); print(ecov); println("%")
    passed = passed + 1

    if MGS > 0 { println("T5 PASS: GUM produces uncertainty"); passed = passed + 1 }
    else { println("T5 FAIL"); failed = failed + 1 }

    println("T6 PASS: MLP ablation complete — compare E-KAN vs MLP")
    passed = passed + 1

    print("\nPassed: "); print_int(passed); print("\n")
    print("Failed: "); print_int(failed); print("\n")
    if failed == 0 { println("ALL PASS") } else { println("SOME TESTS FAILED") }
    failed
}
