// Real Jacobian computation test
// Tests that jacobian() correctly computes partial derivatives
//
// Test function: f(x, y) = (x^2 + y, x*y)
// Jacobian matrix:
//   [df1/dx, df1/dy]   [2x, 1]
//   [df2/dx, df2/dy] = [y,  x]
//
// At point (3.0, 2.0):
//   J = [[6, 1], [2, 3]]
// Flattened row-major: [6, 1, 2, 3]

// Vector function: R^2 -> R^2
// f(x, y) = (x^2 + y, x*y)
// Input: pointer to array of 2 Duals (no length header, raw data)
// Output: pointer to array of 2 Duals (no length header, raw data)
fn vector_func(input_ptr: i64) -> i64 {
    // Read input duals (each dual is 16 bytes: [value, deriv])
    // input_ptr points to: [dual0, dual1] = [[x_val, x_der], [y_val, y_der]]
    let x_ptr = input_ptr
    let y_ptr = input_ptr + 16

    // f1 = x^2 + y
    // d(f1)/dx = 2x, d(f1)/dy = 1
    let x_squared = dual_mul(x_ptr, x_ptr)  // x * x with product rule
    let f1 = dual_add(x_squared, y_ptr)     // x^2 + y

    // f2 = x * y
    // d(f2)/dx = y, d(f2)/dy = x
    let f2 = dual_mul(x_ptr, y_ptr)         // x * y with product rule

    // Create output array of 2 duals (32 bytes total)
    // Layout: [f1.value, f1.deriv, f2.value, f2.deriv]
    let out = [
        dual_value(f1), dual_deriv(f1),
        dual_value(f2), dual_deriv(f2)
    ]

    // Return pointer to the DATA (skip the length header)
    // The array has layout [length, data...] so we skip 8 bytes
    array_ptr(out as i64)
}

fn main() {
    println("=== Real Jacobian Computation Test ===")
    println("")
    println("Function: f(x,y) = (x^2 + y, x*y)")
    println("Point: (3.0, 2.0)")
    println("Expected Jacobian:")
    println("  [[6, 1], [2, 3]]")
    println("")

    // Create input array [3.0, 2.0] with length header
    let x = [3.0, 2.0]
    let x_ptr = x as i64

    // Verify array length is readable
    let n = array_len(x_ptr)
    println("Input dimension n (from array header): ")
    println(n)

    // Compute Jacobian: jacobian(f, x, m) where m=2 (output dimension)
    let m: i64 = 2
    println("Output dimension m: ")
    println(m)
    println("")

    println("Computing jacobian(vector_func, x, 2)...")
    let J_ptr = jacobian(vector_func, x_ptr, m)

    println("Jacobian matrix pointer: ")
    println(J_ptr)
    println("")

    // Read and display the Jacobian matrix (2x2 = 4 elements, row-major)
    // J[i][j] is at offset (i*n + j) * 8 bytes
    println("Jacobian matrix values:")

    // J[0][0] = df1/dx = 2*3 = 6
    let j00 = ptr_load_f64(J_ptr)
    println("  J[0][0] (df1/dx, expected 6): ")
    println(j00)

    // J[0][1] = df1/dy = 1
    let j01 = ptr_load_f64(J_ptr + 8)
    println("  J[0][1] (df1/dy, expected 1): ")
    println(j01)

    // J[1][0] = df2/dx = y = 2
    let j10 = ptr_load_f64(J_ptr + 16)
    println("  J[1][0] (df2/dx, expected 2): ")
    println(j10)

    // J[1][1] = df2/dy = x = 3
    let j11 = ptr_load_f64(J_ptr + 24)
    println("  J[1][1] (df2/dy, expected 3): ")
    println(j11)

    println("")
    println("Test complete!")
}
