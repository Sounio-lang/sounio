//@ run-pass
//@ expect-stdout: SS FULLVD OK

// Multi-dose steady-state using the clinical full-Vd rapamycin model.
// With t½ ≈ 47 h and τ = 24 h, expect ~2× accumulation at SS (accum
// ratio = 1 / (1 − e^(−ln2·τ/t½)) ≈ 1 / (1 − 0.70) ≈ 3.3×).

use darwin_pbpk::absorption::{rapamycin_absorption_params}
use darwin_pbpk::bbb::bbb_rapamycin::{bbb_rapamycin_params}
use darwin_pbpk::drugs::rapamycin::{rapamycin_fullvd_params}
use darwin_pbpk::scenarios::steady_state_runner::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let sys_prm = rapamycin_fullvd_params()
    let bbb_prm = bbb_rapamycin_params()
    let abs_prm = rapamycin_absorption_params()

    let regimen = rapamycin_qd_regimen(14)
    let report = run_oral_multidose(sys_prm, bbb_prm, abs_prm, regimen, 0.02)

    println("--- 14-day oral rapamycin 2 mg q24h (full-Vd model) ---")
    print("doses_run      = "); print_f64(report.n_doses_run as f64); println("")
    if report.reached_ss {
        print("SS reached @ dose #"); print_f64(report.dose_of_ss as f64); println("")
        print("C_max_ss       = "); print_f64(report.c_max_ss);       println(" mg/L")
        print("C_trough_ss    = "); print_f64(report.c_trough_ss);    println(" mg/L")
        print("AUC_tau_ss_u   = "); print_f64(report.auc_tau_ss);     println(" mg·h/L")
    } else {
        println("SS not reached within 14 doses")
    }
    print("t_to_90pct_h   = "); print_f64(report.t_to_90pct_h); println("")

    println("")
    println("--- Accumulation diagnostic ---")
    println("dose,C_max,C_trough,AUC_tau")
    var i: i32 = 0
    while i < report.n_doses_run {
        let idx = i as usize
        print_f64((i + 1) as f64);                  print(",")
        print_f64(report.c_max_per_dose[idx]);      print(",")
        print_f64(report.c_trough_per_dose[idx]);   print(",")
        print_f64(report.auc_tau_per_dose[idx])
        println("")
        i = i + 1
    }

    let d0 = 0 as usize
    let d_last = (report.n_doses_run - 1) as usize
    let accum_cmax = if report.c_max_per_dose[d0] > 0.0 {
        report.c_max_per_dose[d_last] / report.c_max_per_dose[d0]
    } else { 0.0 }
    let accum_auc = if report.auc_tau_per_dose[d0] > 0.0 {
        report.auc_tau_per_dose[d_last] / report.auc_tau_per_dose[d0]
    } else { 0.0 }
    println("")
    print("C_max_last / C_max_first  = "); print_f64(accum_cmax); println("")
    print("AUC_last  / AUC_first     = "); print_f64(accum_auc);  println("")

    println("SS FULLVD OK")
    0
}
