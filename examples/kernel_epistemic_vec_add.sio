// Example: Epistemic GPU kernel for vector addition with uncertainty
//
// Public GPU-profile commands:
//   souc-linux-x86_64-gpu check examples/kernel_epistemic_vec_add.sio
//   souc-linux-x86_64-gpu build examples/kernel_epistemic_vec_add.sio --backend gpu -o /tmp/kernel_epistemic_vec_add.ptx
//
// This example shows that epistemic kernels are accepted by the checked GPU
// profile and can be lowered through the public PTX-emission path.

kernel fn epistemic_vec_add(n: i64, scale: f64) with GPU, Mut, Div {
    var i: i64 = 0
    while i < n {
        let x = scale + 1.0
        i = i + 1
    }
}

kernel fn epistemic_normalize(n: i64, norm: f64) with GPU, Div, Mut, Panic {
    var i: i64 = 0
    while i < n {
        let x = norm / 2.0
        i = i + 1
    }
}

fn main() -> i32 with IO {
    0
}
