// Example: Epistemic GPU kernel for vector addition with uncertainty
//
// Demonstrates Sounio's novel epistemic GPU feature:
// when the --epistemic flag is used, the compiler generates shadow
// registers that propagate uncertainty through every arithmetic operation.
//
// This is unprecedented — no existing language tracks epistemic
// uncertainty through GPU kernel computations at the type level.
//
// Usage:
//   souc check examples/kernel_epistemic_vec_add.sio
//   souc run self-hosted/ -- gpu-emit --epistemic examples/kernel_epistemic_vec_add.sio

kernel fn epistemic_vec_add(n: i64, scale: f64) with GPU, Mut, Div {
    // With --epistemic flag, the add below gets a companion shadow op:
    //   eps_c = sqrt(eps_a^2 + eps_b^2)   [quadrature]
    var i: i64 = 0
    while i < n {
        let x = scale + 1.0
        i = i + 1
    }
}

kernel fn epistemic_normalize(n: i64, norm: f64) with GPU, Div, Mut, Panic {
    // Division propagation: eps_c = eps_a / |b|
    var i: i64 = 0
    while i < n {
        let x = norm / 2.0
        i = i + 1
    }
}

fn main() -> i32 with IO {
    0
}
