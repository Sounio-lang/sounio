// Example: Epistemic GPU kernel for vector addition with uncertainty
//
// Demonstrates Sounio's novel epistemic GPU feature:
// when kernel parameters carry uncertainty (Knowledge<T>),
// the --epistemic flag generates shadow registers that
// propagate uncertainty through every arithmetic operation.
//
// This is unprecedented — no existing language tracks epistemic
// uncertainty through GPU kernel computations at the type level.
//
// Usage:
//   souc check examples/kernel_epistemic_vec_add.sio
//   souc run self-hosted/ -- gpu-emit --epistemic examples/kernel_epistemic_vec_add.sio

kernel fn epistemic_vec_add(n: i64) with GPU {
    // With --epistemic flag, each add/mul/div operation gets
    // companion uncertainty propagation ops:
    //   add: eps_c = sqrt(eps_a^2 + eps_b^2)   [quadrature]
    //   mul: eps_c = |a|*eps_b + |b|*eps_a      [product rule]
    //   div: eps_c = eps_a / |b|                 [quotient rule]
}

kernel fn epistemic_normalize(n: i64) with GPU, Div {
    // Normalization with uncertainty tracking:
    // eps propagates through the division by norm
}

fn main() -> i32 with IO {
    0
}
