//@ run-pass
//!
//! Sounio authority executable for Operator Novelty Feedback v7. Its first
//! committed form was matcher-free; the frozen suffix was admitted only after
//! that form produced the committed first transcript.

use hardware::pireus::operator_novelty_feedback::{
    PireusOnfDigest,
    PIREUS_ONF_CELL_COUNT,
    PIREUS_ONF_TABLE_WORDS,
    PIREUS_ONF_OK,
    pireus_operator_novelty_feedback_request,
    pireus_operator_novelty_cd16_challenge,
    pireus_operator_novelty_feedback_evaluate,
    pireus_operator_novelty_pair_witness,
    pireus_operator_novelty_feedback_frozen_mismatch_code,
}

fn bit(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_words(words: &[i64; 8]) with IO, Mut, Panic {
    var word: i64 = 0
    while word < PIREUS_ONF_TABLE_WORDS {
        if word > 0 { print(":") }
        print_int(words[word])
        word = word + 1
    }
}

fn print_digest(digest: &PireusOnfDigest) with IO, Mut, Panic {
    print_words(&digest.words)
}

fn print_negative(name: string, value: bool) with IO {
    print("PIREUS_ONF_NEGATIVE name=")
    print(name)
    print(" refused=")
    print_int(bit(value))
    print("\n")
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_operator_novelty_feedback_request()
    let challenge = pireus_operator_novelty_cd16_challenge()
    let result = pireus_operator_novelty_feedback_evaluate(
        &request, &challenge)

    print("SOUNIO_AUTHORITY schema=pireus-operator-novelty-feedback.v7")
    print(" role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE\n")

    print("PIREUS_ONF_LINEAGE quotient_live=")
    print_int(bit(result.lineage.quotient_live_match))
    print(" lowering_live=")
    print_int(bit(result.lineage.lowering_live_match))
    print(" challenge_live=")
    print_int(bit(result.lineage.challenge_live_match))
    print(" class_count_match=")
    print_int(bit(result.lineage.class_count_match))
    print(" representative_checks=")
    print_int(result.lineage.representative_checks)
    print(" representative_failures=")
    print_int(result.lineage.representative_failures)
    print(" complete=")
    print_int(bit(result.lineage.complete))
    print("\n")

    print("PIREUS_ONF_LINEAGE_HASH name=quotient_source value=")
    print_words(&result.lineage.quotient_source_sha256); print("\n")
    print("PIREUS_ONF_LINEAGE_HASH name=quotient_semantics value=")
    print_words(&result.lineage.quotient_semantics_sha256); print("\n")
    print("PIREUS_ONF_LINEAGE_HASH name=quotient_freeze value=")
    print_words(&result.lineage.quotient_freeze_sha256); print("\n")
    print("PIREUS_ONF_LINEAGE_HASH name=lowering_source value=")
    print_words(&result.lineage.lowering_source_sha256); print("\n")
    print("PIREUS_ONF_LINEAGE_HASH name=lowering_semantics value=")
    print_words(&result.lineage.lowering_semantics_sha256); print("\n")
    print("PIREUS_ONF_LINEAGE_HASH name=lowering_freeze value=")
    print_words(&result.lineage.lowering_freeze_sha256); print("\n")
    print("PIREUS_ONF_LINEAGE_HASH name=challenge_source value=")
    print_words(&result.lineage.challenge_source_sha256); print("\n")
    print("PIREUS_ONF_LINEAGE_HASH name=challenge_semantics value=")
    print_words(&result.lineage.challenge_semantics_sha256); print("\n")
    print("PIREUS_ONF_LINEAGE_HASH name=challenge_receipt value=")
    print_words(&result.lineage.challenge_receipt_sha256); print("\n")

    print("PIREUS_ONF_CHALLENGE kind=")
    print_int(result.challenge.kind)
    print(" bits="); print_int(result.challenge.bits)
    print(" dimension="); print_int(result.challenge.dimension)
    print(" cells="); print_int(result.challenge.cell_count)
    print(" positive="); print_int(result.challenge.positive_cells)
    print(" negative="); print_int(result.challenge.negative_cells)
    print(" sign_checks="); print_int(result.challenge.sign_checks)
    print(" sign_failures="); print_int(result.challenge.sign_failures)
    print(" address_checks="); print_int(result.challenge.address_checks)
    print(" address_failures="); print_int(result.challenge.address_failures)
    print(" complete="); print_int(bit(result.challenge.complete))
    print(" table_words="); print_words(&result.challenge.table_words)
    print("\n")
    var cell: i64 = 0
    while cell < PIREUS_ONF_CELL_COUNT {
        print("PIREUS_ONF_CHALLENGE_CELL id=")
        print_int(cell)
        print(" left="); print_int(cell / 16)
        print(" right="); print_int(cell - (cell / 16) * 16)
        print(" sign_bit="); print_int(result.challenge.cells[cell])
        print("\n")
        cell = cell + 1
    }

    print("PIREUS_ONF_NORMALIZER gauge_bits=")
    print_int(result.normalizer.gauge_bits)
    print(" gauge_words="); print_int(result.normalizer.gauge_words)
    print(" pivot_checks="); print_int(result.normalizer.pivot_checks)
    print(" pivot_failures="); print_int(result.normalizer.pivot_failures)
    print(" roundtrip_words="); print_int(result.normalizer.roundtrip_words)
    print(" roundtrip_cells=")
    print_int(result.normalizer.roundtrip_cell_checks)
    print(" roundtrip_failures=")
    print_int(result.normalizer.roundtrip_failures)
    print(" uniqueness_failures=")
    print_int(result.normalizer.uniqueness_failures)
    print(" parent_checks=")
    print_int(result.normalizer.parent_pivot_checks)
    print(" parent_failures=")
    print_int(result.normalizer.parent_pivot_failures)
    print(" complete="); print_int(bit(result.normalizer.complete))
    print("\n")

    print("PIREUS_ONF_ACTION_SET matrix_encodings=")
    print_int(result.actions.matrix_encodings_scanned)
    print(" invertible_matrices=")
    print_int(result.actions.invertible_matrices)
    print(" considered="); print_int(result.actions.actions_considered)
    print(" admitted="); print_int(result.actions.admitted_actions)
    print(" no_swap="); print_int(result.actions.admitted_no_swap)
    print(" swap="); print_int(result.actions.admitted_swap)
    print(" identity="); print_int(bit(result.actions.identity_present))
    print(" parent_cells="); print_int(result.actions.parent_cell_checks)
    print(" parent_failures=")
    print_int(result.actions.parent_replay_failures)
    print(" inverse_checks="); print_int(result.actions.inverse_checks)
    print(" inverse_failures="); print_int(result.actions.inverse_failures)
    print(" closure_checks="); print_int(result.actions.closure_checks)
    print(" closure_failures="); print_int(result.actions.closure_failures)
    print(" v5_certificate_checks=")
    print_int(result.actions.v5_certificate_checks)
    print(" v5_certificate_failures=")
    print_int(result.actions.v5_certificate_failures)
    print(" v5_relation_checks=")
    print_int(result.actions.v5_relation_checks)
    print(" v5_relation_failures=")
    print_int(result.actions.v5_relation_failures)
    print(" complete="); print_int(bit(result.actions.complete))
    print("\n")
    var action: i64 = 0
    while action < result.actions.admitted_actions {
        let code = result.actions.action_codes[action]
        print("PIREUS_ONF_ACTION index="); print_int(action)
        print(" code="); print_int(code)
        print(" matrix="); print_int(code / 2)
        print(" swap="); print_int(code - (code / 2) * 2)
        print(" parent_gauge=")
        print_int(result.actions.parent_gauges[action])
        print("\n")
        action = action + 1
    }

    print("PIREUS_ONF_ATLAS classes=")
    print_int(result.atlas.class_count)
    print(" representative_checks=")
    print_int(result.atlas.representative_checks)
    print(" representative_failures=")
    print_int(result.atlas.representative_failures)
    print(" pairs="); print_int(result.atlas.pair_count)
    print(" pair_failures="); print_int(result.atlas.pair_failures)
    print(" nonmembership_checks=")
    print_int(result.atlas.nonmembership_checks)
    print(" nonmembership_failures=")
    print_int(result.atlas.nonmembership_failures)
    print(" zero_hits="); print_int(result.atlas.zero_residual_hits)
    print(" complete="); print_int(bit(result.atlas.complete))
    print("\n")
    var class_id: i64 = 0
    while class_id < result.atlas.class_count {
        print("PIREUS_ONF_CLASS id="); print_int(class_id)
        print(" representative=")
        print_int(result.atlas.representatives[class_id])
        print(" table_words=")
        var words: [i64; 8] = [0; 8]
        var word: i64 = 0
        while word < PIREUS_ONF_TABLE_WORDS {
            words[word] = result.atlas.representative_words[
                class_id * PIREUS_ONF_TABLE_WORDS + word]
            word = word + 1
        }
        print_words(&words)
        print("\n")
        action = 0
        while action < result.actions.admitted_actions {
            let pair = pireus_operator_novelty_pair_witness(
                &result.challenge, &result.actions, &result.atlas,
                class_id, action)
            print("PIREUS_ONF_PAIR class="); print_int(pair.class_id)
            print(" representative=")
            print_int(pair.representative_child)
            print(" action_index="); print_int(pair.action_index)
            print(" action_code="); print_int(pair.action_code)
            print(" matrix="); print_int(pair.matrix_code)
            print(" swap="); print_int(pair.swap)
            print(" parent_gauge="); print_int(pair.parent_gauge)
            print(" challenge_gauge="); print_int(pair.challenge_gauge)
            print(" residual_nonzero=")
            print_int(pair.residual_nonzero_cells)
            print(" residual_words="); print_words(&pair.residual_words)
            print(" replay_checks="); print_int(pair.replay_checks)
            print(" replay_failures="); print_int(pair.replay_failures)
            print(" valid="); print_int(bit(pair.valid))
            print("\n")
            action = action + 1
        }
        class_id = class_id + 1
    }

    print("PIREUS_ONF_OUTCOME kind=")
    print_int(result.atlas.outcome_kind)
    print(" bridge="); print_int(bit(result.atlas.existing_class_bridge))
    print(" seed="); print_int(bit(result.atlas.operator_seed_generated))
    print(" exhaustive_separation=")
    print_int(bit(result.atlas.exhaustive_separation))
    print(" best_class="); print_int(result.atlas.best_class_id)
    print(" best_representative=")
    print_int(result.atlas.best_representative_child)
    print(" best_action_index=")
    print_int(result.atlas.best_action_index)
    print(" best_action_code=")
    print_int(result.atlas.best_action_code)
    print(" best_matrix="); print_int(result.atlas.best_matrix_code)
    print(" best_swap="); print_int(result.atlas.best_swap)
    print(" best_parent_gauge=")
    print_int(result.atlas.best_parent_gauge)
    print(" best_challenge_gauge=")
    print_int(result.atlas.best_challenge_gauge)
    print(" best_residual_nonzero=")
    print_int(result.atlas.best_residual_nonzero_cells)
    print(" best_residual_words=")
    print_words(&result.atlas.best_residual_words)
    print(" replay_checks=")
    print_int(result.atlas.chosen_replay_checks)
    print(" replay_failures=")
    print_int(result.atlas.chosen_replay_failures)
    print("\n")
    cell = 0
    while cell < PIREUS_ONF_CELL_COUNT {
        print("PIREUS_ONF_SEED_CELL id="); print_int(cell)
        print(" bit="); print_int(result.atlas.best_residual_cells[cell])
        print("\n")
        cell = cell + 1
    }

    print("PIREUS_ONF_RECEIPT quotient_bound=")
    print_int(bit(result.receipt.quotient_lineage_bound))
    print(" lowering_bound=")
    print_int(bit(result.receipt.lowering_lineage_bound))
    print(" challenge_bound=")
    print_int(bit(result.receipt.challenge_lineage_bound))
    print(" challenge_complete=")
    print_int(bit(result.receipt.challenge_complete))
    print(" action_complete=")
    print_int(bit(result.receipt.action_universe_complete))
    print(" normalizer_exact=")
    print_int(bit(result.receipt.gauge_normalizer_exact))
    print(" q2_replayed=")
    print_int(bit(result.receipt.frozen_q2_replayed))
    print(" outcome_exclusive=")
    print_int(bit(result.receipt.outcome_exclusive))
    print(" bridge=")
    print_int(bit(result.receipt.existing_class_bridge))
    print(" seed=")
    print_int(bit(result.receipt.operator_seed_generated))
    print(" exhaustive_separation=")
    print_int(bit(result.receipt.exhaustive_separation))
    print(" replay_complete=")
    print_int(bit(result.receipt.cellwise_replay_complete))
    print(" target_evidence_used=")
    print_int(bit(result.receipt.target_evidence_used))
    print(" material_evidence_used=")
    print_int(bit(result.receipt.material_evidence_used))
    print(" semantics_frozen=")
    print_int(bit(result.receipt.semantics_frozen))
    print(" formal_parity_open=")
    print_int(bit(result.receipt.formal_parity_open))
    print(" effect_parity_open=")
    print_int(bit(result.receipt.effect_parity_open))
    print(" material_parity_open=")
    print_int(bit(result.receipt.material_parity_open))
    print(" broad_novelty=")
    print_int(bit(result.receipt.broad_novelty))
    print(" historical_novelty=")
    print_int(bit(result.receipt.historical_novelty))
    print(" priority=")
    print_int(bit(result.receipt.priority_claim))
    print(" claim_ready=")
    print_int(bit(result.receipt.claim_ready))
    print("\n")

    print("PIREUS_ONF_NEGATIVES passed=")
    print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total)
    print("\n")
    print_negative("python_oracle", result.negatives.python_oracle)
    print_negative("rust_oracle", result.negatives.rust_oracle)
    print_negative("cpp_authority", result.negatives.cpp_authority)
    print_negative("llm_authority", result.negatives.llm_authority)
    print_negative("missing_policy", result.negatives.missing_policy)
    print_negative("missing_quotient_parent",
        result.negatives.missing_quotient_parent)
    print_negative("missing_lowering_parent",
        result.negatives.missing_lowering_parent)
    print_negative("missing_challenge_lineage",
        result.negatives.missing_challenge_lineage)
    print_negative("unfrozen_parent", result.negatives.unfrozen_parent)
    print_negative("unbound_parent", result.negatives.unbound_parent)
    print_negative("wrong_universe", result.negatives.wrong_universe)
    print_negative("result_injection", result.negatives.result_injection)
    print_negative("semantic_write_from_parity",
        result.negatives.semantic_write_from_parity)
    print_negative("expected_write_from_parity",
        result.negatives.expected_write_from_parity)
    print_negative("review_promotion", result.negatives.review_promotion)
    print_negative("material_promotion", result.negatives.material_promotion)
    print_negative("cost_promotion", result.negatives.cost_promotion)
    print_negative("performance_promotion",
        result.negatives.performance_promotion)
    print_negative("broad_novelty_promotion",
        result.negatives.broad_novelty_promotion)
    print_negative("parity_prefreeze", result.negatives.parity_prefreeze)
    print_negative("claim_promotion", result.negatives.claim_promotion)
    print_negative("invalid_waiver", result.negatives.invalid_waiver)
    print_negative("short_challenge", result.negatives.short_challenge)
    print_negative("invalid_challenge_cell",
        result.negatives.invalid_challenge_cell)
    print_negative("bridge_seed_exclusive",
        result.negatives.bridge_seed_exclusive)
    print_negative("zero_seed_refused", result.negatives.zero_seed_refused)
    print_negative("nonzero_bridge_refused",
        result.negatives.nonzero_bridge_refused)
    print_negative("replay_corruption_refused",
        result.negatives.replay_corruption_refused)

    print("PIREUS_ONF_DIGEST name=lineage value=")
    print_digest(&result.lineage_digest); print("\n")
    print("PIREUS_ONF_DIGEST name=challenge value=")
    print_digest(&result.challenge_digest); print("\n")
    print("PIREUS_ONF_DIGEST name=normalizer value=")
    print_digest(&result.normalizer_digest); print("\n")
    print("PIREUS_ONF_DIGEST name=actions value=")
    print_digest(&result.action_digest); print("\n")
    print("PIREUS_ONF_DIGEST name=atlas value=")
    print_digest(&result.atlas_digest); print("\n")
    print("PIREUS_ONF_DIGEST name=receipt value=")
    print_digest(&result.receipt_digest); print("\n")
    print("PIREUS_ONF_DIGEST name=forge value=")
    print_digest(&result.forge_digest); print("\n")

    print("PIREUS_ONF_RESULT valid="); print_int(bit(result.valid))
    print(" error="); print_int(result.error)
    print(" failures="); print_int(result.failures)
    print(" claim_ready="); print_int(bit(result.receipt.claim_ready))
    print("\n")

    let frozen_mismatch_code =
        pireus_operator_novelty_feedback_frozen_mismatch_code(&result)
    let frozen_match = frozen_mismatch_code == 0
    print("PIREUS_ONF_FROZEN match="); print_int(bit(frozen_match))
    print(" mismatch_code="); print_int(frozen_mismatch_code)
    print("\n")

    if result.valid && result.error == PIREUS_ONF_OK &&
        result.failures == 0 && result.atlas.complete &&
        result.receipt.outcome_exclusive &&
        !result.receipt.claim_ready && frozen_match {
        0
    } else { 1 }
}
