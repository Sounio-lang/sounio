//@ run-pass
//!
//! First Sounio semantic-authority witness for Apple's pinned MTLGPUFamily
//! DocC JSON. Enum cases are catalog records, not device observations.

use hardware::pireus::apple_metal_import::{
    pireus_apple_metal_import,
    pireus_apple_metal_expected_sha256,
    pireus_apple_negative_duplicate_key,
    pireus_apple_negative_unknown_case,
    pireus_apple_negative_unknown_platform,
    pireus_apple_negative_malformed_json,
    pireus_apple_negative_duplicate_case,
    pireus_apple_negative_capacity,
    pireus_apple_negative_empty_digest,
    pireus_apple_metal_inventory_store,
    pireus_apple_query_by,
    PIREUS_APPLE_OK,
    PIREUS_APPLE_CLASS_GPU_FAMILY_CASE,
    PIREUS_APPLE_HAS_GROUP, PIREUS_APPLE_HAS_LIFECYCLE,
    PIREUS_APPLE_GROUP_IRI_APPLE, PIREUS_APPLE_GROUP_IRI_METAL,
    PIREUS_APPLE_GROUP_IRI_COMMON, PIREUS_APPLE_GROUP_IRI_MAC,
    PIREUS_APPLE_GROUP_IRI_MAC_CATALYST,
    PIREUS_APPLE_LIFECYCLE_DEPRECATED,
    PIREUS_APPLE_CLASS_PLATFORM_RECORD,
    PIREUS_APPLE_DESCRIBES_ENGINE_BLUEPRINT,
    PIREUS_APPLE_HAS_RAW_BETA, PIREUS_APPLE_HAS_RAW_DEPRECATED,
    PIREUS_APPLE_HAS_RAW_UNAVAILABLE, PIREUS_APPLE_HAS_INTRODUCED_AT,
    PIREUS_APPLE_RAW_FALSE,
    PIREUS_APPLE_VERSION_13_0, PIREUS_APPLE_VERSION_13_1,
    PIREUS_APPLE_VERSION_10_15, PIREUS_APPLE_VERSION_1_0,
}
use hardware::pireus::model::{PIREUS_RDF_TYPE}
use hardware::pireus::execution_engine::{PIREUS_BLUEPRINT_APPLE_GPU}
use ontology::query::{triple_store_count, sparql_result_count}

fn apple_bool(value: bool) -> i64 { if value { 1 } else { 0 } }

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 1 {
        print("usage: pireus_apple_metal_family_import <mtlgpufamily.json>\n")
        return 2
    }
    let inv = pireus_apple_metal_import(get_arg(0))
    var failures: i64 = 0
    if inv.error != PIREUS_APPLE_OK || !inv.digest_match ||
        !inv.root_identity { failures = failures + 1 }
    if inv.apple_count + inv.metal_count + inv.common_count +
        inv.mac_count + inv.mac_catalyst_count != inv.count {
        failures = failures + 1
    }
    if inv.active_count + inv.deprecated_count != inv.count {
        failures = failures + 1
    }

    var store = pireus_apple_metal_inventory_store(&inv)
    let triples = triple_store_count(&store)
    let q_cases = pireus_apple_query_by(
        &store, PIREUS_RDF_TYPE, PIREUS_APPLE_CLASS_GPU_FAMILY_CASE)
    let q_apple = pireus_apple_query_by(
        &store, PIREUS_APPLE_HAS_GROUP, PIREUS_APPLE_GROUP_IRI_APPLE)
    let q_metal = pireus_apple_query_by(
        &store, PIREUS_APPLE_HAS_GROUP, PIREUS_APPLE_GROUP_IRI_METAL)
    let q_common = pireus_apple_query_by(
        &store, PIREUS_APPLE_HAS_GROUP, PIREUS_APPLE_GROUP_IRI_COMMON)
    let q_mac = pireus_apple_query_by(
        &store, PIREUS_APPLE_HAS_GROUP, PIREUS_APPLE_GROUP_IRI_MAC)
    let q_catalyst = pireus_apple_query_by(
        &store, PIREUS_APPLE_HAS_GROUP,
        PIREUS_APPLE_GROUP_IRI_MAC_CATALYST)
    let q_deprecated = pireus_apple_query_by(
        &store, PIREUS_APPLE_HAS_LIFECYCLE,
        PIREUS_APPLE_LIFECYCLE_DEPRECATED)
    let q_platforms = pireus_apple_query_by(
        &store, PIREUS_RDF_TYPE, PIREUS_APPLE_CLASS_PLATFORM_RECORD)
    let q_blueprint = pireus_apple_query_by(
        &store, PIREUS_APPLE_DESCRIBES_ENGINE_BLUEPRINT,
        PIREUS_BLUEPRINT_APPLE_GPU)
    let q_beta_false = pireus_apple_query_by(
        &store, PIREUS_APPLE_HAS_RAW_BETA, PIREUS_APPLE_RAW_FALSE)
    let q_platform_deprecated_false = pireus_apple_query_by(
        &store, PIREUS_APPLE_HAS_RAW_DEPRECATED, PIREUS_APPLE_RAW_FALSE)
    let q_unavailable_false = pireus_apple_query_by(
        &store, PIREUS_APPLE_HAS_RAW_UNAVAILABLE, PIREUS_APPLE_RAW_FALSE)
    let q_13_0 = pireus_apple_query_by(
        &store, PIREUS_APPLE_HAS_INTRODUCED_AT, PIREUS_APPLE_VERSION_13_0)
    let q_13_1 = pireus_apple_query_by(
        &store, PIREUS_APPLE_HAS_INTRODUCED_AT, PIREUS_APPLE_VERSION_13_1)
    let q_10_15 = pireus_apple_query_by(
        &store, PIREUS_APPLE_HAS_INTRODUCED_AT, PIREUS_APPLE_VERSION_10_15)
    let q_1_0 = pireus_apple_query_by(
        &store, PIREUS_APPLE_HAS_INTRODUCED_AT, PIREUS_APPLE_VERSION_1_0)
    let cases = sparql_result_count(&q_cases)
    let apple = sparql_result_count(&q_apple)
    let metal = sparql_result_count(&q_metal)
    let common = sparql_result_count(&q_common)
    let mac = sparql_result_count(&q_mac)
    let catalyst = sparql_result_count(&q_catalyst)
    let deprecated = sparql_result_count(&q_deprecated)
    let platforms = sparql_result_count(&q_platforms)
    let blueprint = sparql_result_count(&q_blueprint)
    let beta_false = sparql_result_count(&q_beta_false)
    let platform_deprecated_false =
        sparql_result_count(&q_platform_deprecated_false)
    let unavailable_false = sparql_result_count(&q_unavailable_false)
    let introduced_13_0 = sparql_result_count(&q_13_0)
    let introduced_13_1 = sparql_result_count(&q_13_1)
    let introduced_10_15 = sparql_result_count(&q_10_15)
    let introduced_1_0 = sparql_result_count(&q_1_0)
    if cases != inv.count || apple != inv.apple_count ||
        metal != inv.metal_count || common != inv.common_count ||
        mac != inv.mac_count || catalyst != inv.mac_catalyst_count ||
        deprecated != inv.deprecated_count { failures = failures + 1 }
    if platforms != inv.platform_count || blueprint != 1 ||
        beta_false != inv.platform_count - inv.platform_beta_true_count ||
        platform_deprecated_false !=
            inv.platform_count - inv.platform_deprecated_true_count ||
        unavailable_false !=
            inv.platform_count - inv.platform_unavailable_true_count ||
        introduced_13_0 != inv.introduced_13_0_count ||
        introduced_13_1 != inv.introduced_13_1_count ||
        introduced_10_15 != inv.introduced_10_15_count ||
        introduced_1_0 != inv.introduced_1_0_count {
        failures = failures + 1
    }

    let neg_key = pireus_apple_negative_duplicate_key()
    let neg_shape = pireus_apple_negative_unknown_case()
    let neg_platform = pireus_apple_negative_unknown_platform()
    let neg_json = pireus_apple_negative_malformed_json()
    let neg_case = pireus_apple_negative_duplicate_case()
    let neg_capacity = pireus_apple_negative_capacity()
    let neg_digest = pireus_apple_negative_empty_digest()
    if !neg_key || !neg_shape || !neg_platform || !neg_json || !neg_case ||
        !neg_capacity || !neg_digest { failures = failures + 1 }

    print("SOUNIO_AUTHORITY schema=pireus-apple-metal-family.v0 role=SEMANTIC_AUTHORITY\n")
    print("PIREUS_APPLE_CORPUS source=mtlgpufamily.json bytes=")
    print_int(inv.total_bytes)
    print(" error="); print_int(inv.error)
    print(" sha256="); print(pireus_apple_metal_expected_sha256())
    print(" digest_match="); print_int(apple_bool(inv.digest_match)); print("\n")
    print("PIREUS_APPLE_ROOT identifier=MTLGPUFamily interface=swift valid=")
    print_int(apple_bool(inv.root_identity)); print("\n")
    print("PIREUS_APPLE_JSON objects="); print_int(inv.json_objects)
    print(" arrays="); print_int(inv.json_arrays)
    print(" strings="); print_int(inv.json_strings)
    print(" max_depth="); print_int(inv.max_depth); print("\n")
    print("PIREUS_APPLE_CASES total="); print_int(inv.count)
    print(" apple="); print_int(inv.apple_count)
    print(" metal="); print_int(inv.metal_count)
    print(" common="); print_int(inv.common_count)
    print(" mac="); print_int(inv.mac_count)
    print(" mac_catalyst="); print_int(inv.mac_catalyst_count); print("\n")
    print("PIREUS_APPLE_LIFECYCLE active="); print_int(inv.active_count)
    print(" deprecated="); print_int(inv.deprecated_count)
    print(" topic_groups="); print_int(inv.selected_topic_groups); print("\n")
    print("PIREUS_APPLE_PLATFORMS total="); print_int(inv.platform_count)
    print(" beta_true="); print_int(inv.platform_beta_true_count)
    print(" deprecated_true="); print_int(inv.platform_deprecated_true_count)
    print(" unavailable_true="); print_int(inv.platform_unavailable_true_count)
    print(" introduced_13_0="); print_int(inv.introduced_13_0_count)
    print(" introduced_13_1="); print_int(inv.introduced_13_1_count)
    print(" introduced_10_15="); print_int(inv.introduced_10_15_count)
    print(" introduced_1_0="); print_int(inv.introduced_1_0_count); print("\n")
    print("PIREUS_APPLE_ENGINE apple_gpu_blueprint_links=")
    print_int(blueprint); print(" device_observations=0\n")
    print("PIREUS_APPLE_ONTOLOGY triples="); print_int(triples)
    print(" cases="); print_int(cases)
    print(" platforms="); print_int(platforms)
    print(" deprecated_cases="); print_int(deprecated); print("\n")
    print("PIREUS_APPLE_NEGATIVE duplicate_key="); print_int(apple_bool(neg_key))
    print(" selected_shape="); print_int(apple_bool(neg_shape))
    print(" platform_shape="); print_int(apple_bool(neg_platform))
    print(" malformed_json="); print_int(apple_bool(neg_json))
    print(" duplicate_case="); print_int(apple_bool(neg_case))
    print(" capacity="); print_int(apple_bool(neg_capacity))
    print(" digest="); print_int(apple_bool(neg_digest)); print("\n")
    print("PIREUS_APPLE_BOUNDARY device_observations=0 metal_permutation_features=0 instruction_equivalences=0 material_costs=0 lowering_claims=0\n")
    print("PIREUS_APPLE_SUMMARY failures="); print_int(failures); print("\n")
    if failures == 0 { 0 } else { 1 }
}
