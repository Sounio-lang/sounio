// examples/dissertation_olanzapine_demo.sio
//
// Dissertation narrative: rapamycin ↔ olanzapine mTOR triangle
//
// Three patients all have a Cypher rapamycin drug-eluting stent (DES).
// Two of them are also prescribed olanzapine for psychiatric co-morbidity.
// This is the most clinically common antipsychotic/stent co-prescription.
//
// The mechanistic triangle:
//   Rapamycin  → mTOR INHIBIT  (stent payload: local arterial + low systemic)
//   Olanzapine → mTOR ACTIVATE (psychiatric: H1 blockade → AMPK↓ → mTORC1↑)
//   Tirzepatide → GLP-1/GIP   (metabolic rescue: AMPK↑ → partially restores)
//
// Patient A: rapamycin DES only        → PROTECTED
// Patient B: rapamycin DES + olanz 10  → UNCERTAIN (monitor mTOR biomarker)
// Patient C: rapamycin DES + olanz 20  → UNPROTECTED (dose review)
// Smoker sub-analysis (Patient B who smokes): CL×2 → lower olanzapine → shifts toward PROTECTED
//
// DES local ICF rapamycin concentrations (from biomaterial_release.sio data):
//   Phase 1 (0–30 days post-implant):  ~5–10 nM at stent-adjacent tissue
//   Phase 2 (30–90 days):              ~0.5–2 nM (elution tailing)
//   Phase 3 (>90 days, elution done):  ~0.05–0.15 nM (systemic residual only)
//
// This demo uses Phase 2 ICF concentrations (clinical maintenance scenario).
//
// Run:
//   SOUNIO_STDLIB_PATH=/workspace/sounio/stdlib \
//     ./bin/souc run examples/dissertation_olanzapine_demo.sio

use darwin_pbpk::bbb::bbb_core::{bbb_integrate_constant_plasma, bbb_c_isf_u}
use darwin_pbpk::drugs::olanzapine::{olanzapine_bbb_params, olanzapine_mtor_act_params, olanzapine_pbpk_params, olanzapine_pbpk_params_smoker}
use darwin_pbpk::pd::d2_occupancy::{D2Params, d2_occupancy}
use darwin_pbpk::pd::mtor_collision::{
    mtor_olanz_activate, mtor_net_effect, mtor_net_interval, mtor_collision_gate,
    rapa_hill_params_clinical
}

// Olanzapine D2 params (PET-calibrated, Kapur 2000)
fn olz_d2_params() -> D2Params {
    D2Params { kd_d2: 0.001800, bmax_d2: 0.009373, ant_threshold: 0.60, eps_threshold: 0.80 }
}

fn olz_ss_plasma(dose_mg: f64, cl_l_h: f64) -> f64 with Div, Panic {
    0.60 * dose_mg / (cl_l_h * 24.0)
}

fn olz_d2_occ(c_plasma: f64) -> f64 with Div, Panic, Mut {
    let bbb = olanzapine_bbb_params()
    let st  = bbb_integrate_constant_plasma(c_plasma, 500.0, 0.1, bbb)
    d2_occupancy(bbb_c_isf_u(st, bbb), olz_d2_params())
}

fn print_gate(g: i32) with IO {
    if g == 2 { println("  mTOR Gate: PROTECTED — stent efficacy maintained") }
    if g == 1 { println("  mTOR Gate: UNCERTAIN — monitor mTOR biomarker (p-S6K1)") }
    if g == 0 { println("  mTOR Gate: UNPROTECTED — olanzapine offsets stent; dose review") }
}

fn main() with IO, Mut, Div, Panic {
    println("======================================================================")
    println("  Rapamycin-Stent ↔ Olanzapine mTOR Collision Triangle")
    println("  Dissertation: Psychiatric + Cardiology co-prescription epistemic model")
    println("======================================================================")
    println("")

    let rapa_p = rapa_hill_params_clinical()
    let olz_p  = olanzapine_mtor_act_params()
    let cl_olz: f64 = 25.0    // non-smoker NM reference CL

    // DES Phase 2 rapamycin ICF concentration (coronary tissue, 30-90 days post-implant)
    let c_rapa_icf_mean: f64 = 1.0     // nM, Phase 2 geometric mean estimate
    let c_rapa_icf_cv:   f64 = 0.50   // wide CV: DES elution varies by stent position

    // -----------------------------------------------------------------------
    // PATIENT A: Rapamycin DES only, no antipsychotic
    // -----------------------------------------------------------------------
    println("----------------------------------------------------------------------")
    println("  PATIENT A: Cypher DES only — no antipsychotic")
    println("----------------------------------------------------------------------")
    let net_a = mtor_net_effect(c_rapa_icf_mean, 0.0, rapa_p, olz_p)
    print("  Rapamycin ICF  = "); print_f64(c_rapa_icf_mean); println(" nM")
    print("  Olanzapine     = 0.0 ng/mL")
    println("")
    print("  mTOR inhibition (rapamycin) = ")
    let inhib_a: f64 = c_rapa_icf_mean / (c_rapa_icf_mean + 0.5)
    print_f64(inhib_a); println("")
    print("  mTOR activation (olanzapine)= 0.000")
    println("")
    print("  Net mTOR effect = "); print_f64(net_a); println("")
    let ivl_a = mtor_net_interval(c_rapa_icf_mean, c_rapa_icf_cv, 0.0, 0.1, rapa_p, olz_p)
    let gate_a = mtor_collision_gate(ivl_a.0, ivl_a.1)
    print_gate(gate_a)
    println("")

    // -----------------------------------------------------------------------
    // PATIENT B: Rapamycin DES + olanzapine 10 mg QD (non-smoker)
    // -----------------------------------------------------------------------
    println("----------------------------------------------------------------------")
    println("  PATIENT B: Cypher DES + olanzapine 10 mg QD (non-smoker)")
    println("----------------------------------------------------------------------")
    let c_olz_b = olz_ss_plasma(10.0, cl_olz) * 1000.0   // convert to ng/mL: mg/L × 1000
    print("  Olanzapine SS plasma = "); print_f64(c_olz_b); println(" ng/mL")
    let occ_b = olz_d2_occ(c_olz_b * 0.001)   // back to mg/L for bbb calc
    print("  D2 occupancy         = "); print_f64(occ_b * 100.0); println("%")
    let act_b = mtor_olanz_activate(c_olz_b, olz_p)
    print("  mTOR activation      = "); print_f64(act_b); println("")
    let net_b = mtor_net_effect(c_rapa_icf_mean, c_olz_b, rapa_p, olz_p)
    print("  Net mTOR (point est) = "); print_f64(net_b); println("")
    let ivl_b = mtor_net_interval(c_rapa_icf_mean, c_rapa_icf_cv, c_olz_b, 0.30, rapa_p, olz_p)
    let gate_b = mtor_collision_gate(ivl_b.0, ivl_b.1)
    print("  Net interval: ["); print_f64(ivl_b.0); print(", "); print_f64(ivl_b.1); println("]")
    print_gate(gate_b)
    println("")
    println("  ISO dominant source: EC50_mTOR_activation (~60% of net mTOR variance)")
    println("  Bhatt 2014 (adipocyte in vitro, n=3 replicates) is the epistemic bottleneck.")
    println("  VoI recommendation: in vivo mTOR biomarker (p-S6K1) measurement.")
    println("")

    // -----------------------------------------------------------------------
    // PATIENT B (smoker variant)
    // -----------------------------------------------------------------------
    println("----------------------------------------------------------------------")
    println("  PATIENT B (smoker): same regimen, CYP1A2 induced × 2")
    println("----------------------------------------------------------------------")
    let prm_smoker = olanzapine_pbpk_params_smoker()
    let cl_olz_smoker = prm_smoker.cl_hepatic
    let c_olz_bs = olz_ss_plasma(10.0, cl_olz_smoker) * 1000.0
    print("  Smoker CL = "); print_f64(cl_olz_smoker); println(" L/h (CYP1A2 induced)")
    print("  Olanzapine SS plasma = "); print_f64(c_olz_bs); println(" ng/mL (halved by induction)")
    let act_bs = mtor_olanz_activate(c_olz_bs, olz_p)
    print("  mTOR activation      = "); print_f64(act_bs); println(" (reduced vs non-smoker)")
    let ivl_bs = mtor_net_interval(c_rapa_icf_mean, c_rapa_icf_cv, c_olz_bs, 0.30, rapa_p, olz_p)
    let gate_bs = mtor_collision_gate(ivl_bs.0, ivl_bs.1)
    print("  Net interval: ["); print_f64(ivl_bs.0); print(", "); print_f64(ivl_bs.1); println("]")
    print_gate(gate_bs)
    println("")
    println("  Smoking-induced CL reduction of olanzapine shifts gate toward PROTECTED.")
    println("  The compiler's confidence gate fires on the smoking UNKNOWN, not the drug.")
    println("  (Smoking status is an epistemic variable that the clinician must ascertain.)")
    println("")

    // -----------------------------------------------------------------------
    // PATIENT C: Rapamycin DES + olanzapine 20 mg QD (high-dose maintenance)
    // -----------------------------------------------------------------------
    println("----------------------------------------------------------------------")
    println("  PATIENT C: Cypher DES + olanzapine 20 mg QD (high-dose maintenance)")
    println("----------------------------------------------------------------------")
    let c_olz_c = olz_ss_plasma(20.0, cl_olz) * 1000.0
    print("  Olanzapine SS plasma = "); print_f64(c_olz_c); println(" ng/mL")
    let occ_c = olz_d2_occ(c_olz_c * 0.001)
    print("  D2 occupancy         = "); print_f64(occ_c * 100.0); println("%")
    let act_c = mtor_olanz_activate(c_olz_c, olz_p)
    print("  mTOR activation      = "); print_f64(act_c); println("")
    let net_c = mtor_net_effect(c_rapa_icf_mean, c_olz_c, rapa_p, olz_p)
    print("  Net mTOR (point est) = "); print_f64(net_c); println("")
    let ivl_c = mtor_net_interval(c_rapa_icf_mean, c_rapa_icf_cv, c_olz_c, 0.30, rapa_p, olz_p)
    let gate_c = mtor_collision_gate(ivl_c.0, ivl_c.1)
    print("  Net interval: ["); print_f64(ivl_c.0); print(", "); print_f64(ivl_c.1); println("]")
    print_gate(gate_c)
    println("")

    // -----------------------------------------------------------------------
    // DISSERTATION SUMMARY
    // -----------------------------------------------------------------------
    println("======================================================================")
    println("  Dissertation Claim: First Epistemic Model of the")
    println("  Rapamycin ↔ Olanzapine mTOR Collision")
    println("======================================================================")
    println("")
    println("  The mechanistic triangle ties three of the six dissertation drugs:")
    println("  Rapamycin (DES) × Olanzapine (antipsychotic) × Tirzepatide (metabolic)")
    println("")
    println("  GLP-1R agonism (tirzepatide) partially restores AMPK activation,")
    println("  reducing E_activate and shifting UNCERTAIN patients toward PROTECTED.")
    println("  This is the dissertation's clinical management corollary.")
    println("")
    println("  Key epistemic limitation: EC50_mTOR_activation (Bhatt 2014, adipocyte")
    println("  in vitro, CV=50%) dominates the net mTOR variance (~60% contribution).")
    println("  An in vivo mTOR biomarker measurement (p-S6K1 in peripheral blood)")
    println("  would reduce this to <20% — the principal VoI recommendation.")
    println("")
    println("  MTOR COLLISION DEMO OK")
}
