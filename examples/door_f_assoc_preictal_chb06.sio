fn load_II(t: i64) -> Sedenion {
    Sedenion {
        e0: II_CH0[t],
        e1: II_CH1[t],
        e2: II_CH2[t],
        e3: II_CH3[t],
        e4: II_CH4[t],
        e5: II_CH5[t],
