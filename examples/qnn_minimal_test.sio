//! Minimal QNN validation example
//!
//! Tests basic QNN functionality with a tiny 2-layer network

use std::qnn

fn main() {
    // === Model Architecture ===
    // Input: 4 quaternions -> Hidden: 8 quaternions -> Output: 2 quaternions

    let input_dim: i32 = 4
    let hidden_dim: i32 = 8
    let output_dim: i32 = 2
    let batch_size: i32 = 1

    // === Layer 1: Linear 4 -> 8 ===
    let layer1 = qnn::quat_linear_new(input_dim, hidden_dim)
    let w1 = qnn::quat_xavier_init(input_dim, hidden_dim, seed: 42)
    let b1 = qnn::quat_xavier_init(1, hidden_dim, seed: 43)

    // === Layer 2: Linear 8 -> 2 ===
    let layer2 = qnn::quat_linear_new(hidden_dim, output_dim)
    let w2 = qnn::quat_xavier_init(hidden_dim, output_dim, seed: 44)
    let b2 = qnn::quat_xavier_init(1, output_dim, seed: 45)

    // === Create sample input (4 quaternions) ===
    var input: [Quat]
    let i: i32 = 0
    while i < input_dim {
        input[i] = quat(1.0, 0.5, 0.3, 0.2)
        i = i + 1
    }

    // === Forward pass ===

    // Layer 1 forward
    let hidden1 = qnn::quat_linear_forward(&layer1, &w1, &input, &b1)

    // ReLU activation
    var hidden1_activated: [Quat]
    qnn::quat_relu_batch(&hidden1, &!hidden1_activated)

    // Layer 2 forward
    let output = qnn::quat_linear_forward(&layer2, &w2, &hidden1_activated, &b2)

    // === Create target (2 quaternions) ===
    var target: [Quat]
    let j: i32 = 0
    while j < output_dim {
        target[j] = quat(0.8, 0.4, 0.2, 0.1)
        j = j + 1
    }

    // === Compute loss ===
    let loss_mse = qnn::quat_mse_loss(&output, &target)
    let loss_mae = qnn::quat_mae_loss(&output, &target)

    // === Test quaternion operations ===
    let q1 = quat(1.0, 0.0, 0.0, 0.0)
    let q2 = quat(0.0, 1.0, 0.0, 0.0)

    // Hamilton product
    let q_product = qnn::hamilton_product(q1, q2)

    // Quaternion norm
    let q_norm = qnn::quat_norm(q_product)

    // Quaternion conjugate
    let q_conj = qnn::quat_conjugate(q_product)

    // === Test optimizer ===
    let optimizer = qnn::quat_adam_new(learning_rate: 0.001)

    // Simulate gradients
    var gradients: [Quat]
    let k: i32 = 0
    while k < input_dim * hidden_dim {
        gradients[k] = quat(0.01, 0.01, 0.01, 0.01)
        k = k + 1
    }

    // Initialize Adam state
    var first_moment: [Quat]
    var second_moment: [Quat]
    let m: i32 = 0
    while m < input_dim * hidden_dim {
        first_moment[m] = quat(0.0, 0.0, 0.0, 0.0)
        second_moment[m] = quat(0.0, 0.0, 0.0, 0.0)
        m = m + 1
    }

    // Adam optimization step
    qnn::quat_adam_step(
        &!w1,
        &gradients,
        &!optimizer,
        &!first_moment,
        &!second_moment
    )

    // === Learning rate schedule ===
    let initial_lr: f32 = 0.001
    let current_step: i32 = 50
    let total_steps: i32 = 1000
    let min_lr: f32 = 0.0001

    let scheduled_lr = qnn::quat_learning_rate_schedule(
        initial_lr,
        current_step,
        total_steps,
        min_lr
    )
}
