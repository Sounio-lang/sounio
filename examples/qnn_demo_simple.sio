//! Simple QNN (Quaternionic Neural Network) Demonstration
//! Shows basic usage of quaternion intrinsics for neural networks

fn main() {
    println("=== QNN Demo: Quaternionic Neural Networks ===\n")

    demo_weight_initialization()
    demo_activations()
    demo_simple_inference()

    println("\n✅ QNN Demo Complete!")
}

// Demonstration 1: Weight Initialization
fn demo_weight_initialization() {
    println("1. Weight Initialization")
    println("   ---------------------")

    // Xavier initialization - good for deep networks
    let xavier_weights = quat_init_xavier(16, 32, 42)
    println("   ✅ Xavier init: 16x32 quaternion matrix created")

    // He initialization - good for ReLU networks
    let he_weights = quat_init_he(16, 32, 43)
    println("   ✅ He init: 16x32 quaternion matrix created")

    // Unit quaternion initialization
    let unit_weights = quat_init_unit(8, 16, 44)
    println("   ✅ Unit init: 8x16 quaternion matrix created\n")
}

// Demonstration 2: Activation Functions
fn demo_activations() {
    println("2. Activation Functions")
    println("   -------------------")

    // Initialize test weights
    let weights = quat_init_xavier(4, 8, 100)

    // Component-wise ReLU activation
    let relu_output = quat_relu(weights)
    println("   ✅ quat_relu: Applied component-wise ReLU")

    // Component-wise sigmoid activation
    let sigmoid_output = quat_sigmoid(relu_output)
    println("   ✅ quat_sigmoid: Applied component-wise sigmoid")

    // Component-wise tanh activation
    let tanh_output = quat_tanh(weights)
    println("   ✅ quat_tanh: Applied component-wise tanh")

    // Leaky ReLU with alpha=0.01
    let leaky_output = quat_leaky_relu(weights, 0.01)
    println("   ✅ quat_leaky_relu: Applied with alpha=0.01\n")
}

// Demonstration 3: Simple Inference
fn demo_simple_inference() {
    println("3. Simple Inference Pipeline")
    println("   -------------------------")

    // Network architecture: 16 -> 32 -> 16 -> 8
    let input_dim = 16
    let hidden1_dim = 32
    let hidden2_dim = 16
    let output_dim = 8

    // Initialize weights for each layer
    let w1 = quat_init_xavier(input_dim, hidden1_dim, 201)
    let w2 = quat_init_he(hidden1_dim, hidden2_dim, 202)
    let w3 = quat_init_xavier(hidden2_dim, output_dim, 203)

    println("   ✅ Layer 1: 16 -> 32 (Xavier init)")
    println("   ✅ Layer 2: 32 -> 16 (He init)")
    println("   ✅ Layer 3: 16 -> 8 (Xavier init)")

    // Simulated forward pass (using activations only for demo)
    let hidden1 = quat_relu(w1)
    let hidden2 = quat_relu(w2)
    let output = quat_sigmoid(w3)

    println("   ✅ Forward pass: ReLU -> ReLU -> Sigmoid")
    println("   ✅ Output: 8 quaternion values")
}
