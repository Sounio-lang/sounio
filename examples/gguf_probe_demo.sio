// Probe GGUF reader: missing path must return ok=false without crash.
use llm::gguf::{gguf_find, gguf_open}

fn main() with Alloc, Mut, Panic {
    let f = gguf_open("/nonexistent/tiny-mixtral.gguf")
    if f.ok {
        print("unexpected ok=true for missing file")
        return
    }
    let t = gguf_find(&f, "blk.0.ffn_gate_exps.weight")
    if t.found {
        print("unexpected found on bad file")
        return
    }
    print("gguf_probe: ok=false as expected")
}
