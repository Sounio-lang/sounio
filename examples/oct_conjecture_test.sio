//@ run-pass
// oct_conjecture_test.sio — Testing three conjectures from first data
//
// CONJECTURE 1 (Alternativity Channel Fraction):
//   For basis-labeled K_n with label(u,v) = e_{(u+v)%7+1},
//   the fraction of zero associators is exactly 5/16 for all n >= 4.
//
// CONJECTURE 3 (Basis Max Bound):
//   For unit octonion basis elements, max ||[e_i, e_j, e_k]|| = 2 exactly.
//   Moreover, ||[e_i, e_j, e_k]|| is either 0 or 2 (no intermediate values).
//
// CONJECTURE 2 (Energy Dilution):
//   Mean associator energy density decreases with average degree.

// ============================================================================
// MATH + OCTONION (inlined)
// ============================================================================

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn sqrt_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var r = x
    var i = 0
    while i < 20 { r = 0.5 * (r + x / r); i = i + 1 }
    r
}

struct Oct { e: [f64; 8] }
fn oct_zero() -> Oct { Oct { e: [0.0; 8] } }
fn oct_unit(idx: i64) -> Oct with Mut, Panic {
    var o = Oct { e: [0.0; 8] }
    if idx >= 0 && idx < 8 { o.e[idx as usize] = 1.0 }
    o
}
fn oct_sub(a: Oct, b: Oct) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    var i: i64 = 0
    while i < 8 { r.e[i as usize] = a.e[i as usize] - b.e[i as usize]; i = i + 1 }
    r
}
fn oct_scale(o: Oct, s: f64) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    var i: i64 = 0
    while i < 8 { r.e[i as usize] = o.e[i as usize] * s; i = i + 1 }
    r
}
fn oct_conjugate(o: Oct) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    r.e[0] = o.e[0]
    var i: i64 = 1
    while i < 8 { r.e[i as usize] = 0.0 - o.e[i as usize]; i = i + 1 }
    r
}
fn oct_norm_sq(o: Oct) -> f64 with Mut, Panic, Div {
    var s: f64 = 0.0
    var i: i64 = 0
    while i < 8 { s = s + o.e[i as usize] * o.e[i as usize]; i = i + 1 }
    s
}
fn oct_norm(o: Oct) -> f64 with Mut, Panic, Div { sqrt_f64(oct_norm_sq(o)) }

fn oct_fano_index(i: i64, j: i64) -> i64 with Mut, Panic, Div {
    if i == j { return 0 }
    var t: [i64; 21] = [0; 21]
    t[0]=1;t[1]=2;t[2]=4; t[3]=2;t[4]=3;t[5]=5; t[6]=3;t[7]=4;t[8]=6
    t[9]=4;t[10]=5;t[11]=7; t[12]=5;t[13]=6;t[14]=1; t[15]=6;t[16]=7;t[17]=2
    t[18]=7;t[19]=1;t[20]=3
    var k: i64 = 0
    while k < 7 {
        let a=t[(k*3) as usize]; let b=t[(k*3+1) as usize]; let c=t[(k*3+2) as usize]
        if (i==a&&j==b)||(i==b&&j==c)||(i==c&&j==a) {
            if i==a&&j==b {return c}; if i==b&&j==c {return a}; return b
        }
        if (i==b&&j==a)||(i==c&&j==b)||(i==a&&j==c) {
            if i==b&&j==a {return c}; if i==c&&j==b {return a}; return b
        }
        k=k+1
    }
    0
}
fn oct_fano_sign(i: i64, j: i64) -> f64 with Mut, Panic, Div {
    if i==j {return -1.0}; if i==0||j==0 {return 1.0}
    var t: [i64; 21] = [0; 21]
    t[0]=1;t[1]=2;t[2]=4; t[3]=2;t[4]=3;t[5]=5; t[6]=3;t[7]=4;t[8]=6
    t[9]=4;t[10]=5;t[11]=7; t[12]=5;t[13]=6;t[14]=1; t[15]=6;t[16]=7;t[17]=2
    t[18]=7;t[19]=1;t[20]=3
    var k: i64 = 0
    while k < 7 {
        let a=t[(k*3) as usize]; let b=t[(k*3+1) as usize]; let c=t[(k*3+2) as usize]
        if (i==a&&j==b)||(i==b&&j==c)||(i==c&&j==a) {return 1.0}
        if (i==b&&j==a)||(i==c&&j==b)||(i==a&&j==c) {return -1.0}
        k=k+1
    }
    0.0
}
fn oct_mul(a: Oct, b: Oct) -> Oct with Mut, Panic, Div {
    var result = oct_zero()
    var i: i64 = 0
    while i < 8 {
        var j: i64 = 0
        while j < 8 {
            let coeff = a.e[i as usize] * b.e[j as usize]
            if i==0&&j==0 { result.e[0] = result.e[0] + coeff }
            else if i==0 { result.e[j as usize] = result.e[j as usize] + coeff }
            else if j==0 { result.e[i as usize] = result.e[i as usize] + coeff }
            else if i==j { result.e[0] = result.e[0] - coeff }
            else {
                let k = oct_fano_index(i, j)
                let sign = oct_fano_sign(i, j)
                result.e[k as usize] = result.e[k as usize] + sign * coeff
            }
            j=j+1
        }
        i=i+1
    }
    result
}
fn oct_associator(a: Oct, b: Oct, c: Oct) -> Oct with Mut, Panic, Div {
    let ab = oct_mul(a, b)
    let bc = oct_mul(b, c)
    oct_sub(oct_mul(ab, c), oct_mul(a, bc))
}

// ============================================================================
// CONJECTURE 3: EXHAUSTIVE BASIS ASSOCIATOR TABLE
// ============================================================================
// Compute ||[e_i, e_j, e_k]|| for ALL i,j,k in 1..7 (7^3 = 343 triples)
// This is a FINITE computation — we can classify every case.

fn test_conjecture_3() -> bool with IO, Mut, Panic, Div {
    println("=== CONJECTURE 3: Basis Associator Max Bound ===")
    println("")
    println("Computing ||[e_i, e_j, e_k]|| for all i,j,k in 1..7")
    println("")

    var total: i32 = 0
    var zeros: i32 = 0
    var twos: i32 = 0
    var other: i32 = 0
    var max_norm: f64 = 0.0

    // Histogram of distinct norms found
    var distinct_norms: [f64; 16] = [0.0; 16]
    var distinct_count: i32 = 0

    var i: i64 = 1
    while i <= 7 {
        var j: i64 = 1
        while j <= 7 {
            var k: i64 = 1
            while k <= 7 {
                let ei = oct_unit(i)
                let ej = oct_unit(j)
                let ek = oct_unit(k)
                let assoc = oct_associator(ei, ej, ek)
                let n = oct_norm(assoc)

                total = total + 1
                if n < 1e-9 { zeros = zeros + 1 }
                else if abs_f64(n - 2.0) < 1e-9 { twos = twos + 1 }
                else { other = other + 1 }
                if n > max_norm { max_norm = n }

                // Track distinct norm values
                var found = false
                var d: i32 = 0
                while d < distinct_count {
                    if abs_f64(distinct_norms[d as usize] - n) < 1e-9 { found = true }
                    d = d + 1
                }
                if !found && distinct_count < 16 {
                    distinct_norms[distinct_count as usize] = n
                    distinct_count = distinct_count + 1
                }

                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    print("  Total triples (7^3): "); println(total)
    print("  ||[e_i,e_j,e_k]|| = 0: "); println(zeros)
    print("  ||[e_i,e_j,e_k]|| = 2: "); println(twos)
    print("  Other values: "); println(other)
    print("  Max norm: ")
    let int_part = max_norm as i64
    let frac = ((max_norm - (int_part as f64)) * 10000.0 + 0.5) as i64
    print(int_part); print("."); println(frac)

    print("  Distinct norm values found: "); println(distinct_count)
    var d: i32 = 0
    while d < distinct_count {
        print("    norm = ")
        let v = distinct_norms[d as usize]
        let ip = v as i64
        let fp = ((v - (ip as f64)) * 10000.0 + 0.5) as i64
        print(ip); print("."); println(fp)
        d = d + 1
    }

    println("")

    // Conjecture 3 holds if: other == 0 and max_norm == 2.0
    let holds = other == 0 && abs_f64(max_norm - 2.0) < 1e-9
    if holds {
        println("  CONJECTURE 3: CONFIRMED")
        println("  For unit basis elements, ||[e_i,e_j,e_k]|| is EXACTLY 0 or 2.")
        println("  No intermediate values exist. This is a BINARY property.")
    } else {
        println("  CONJECTURE 3: REFUTED (intermediate values found)")
    }
    println("")

    // Analyze the zero structure
    print("  Zero fraction: "); println(zeros)
    print("  / "); println(total)
    // zeros/343 — what fraction?
    // If zeros = 133, that's 133/343 = 19/49
    // If zeros = 7*19 = 133, interesting
    println("")

    holds
}

// ============================================================================
// CONJECTURE 1: ALTERNATIVITY CHANNELS IN BASIS-LABELED K_n
// ============================================================================
// For basis-labeled K_n (label(u,v) = e_{(u+v)%7+1}), count zero associators.
// Test for n = 4, 5, 6, 7, 8, 9, 10 and check if fraction = 5/16.

struct OctGraph {
    n: i32
    adj: [i32; 256]
    lab0: [f64; 256]
    lab1: [f64; 256]
    lab2: [f64; 256]
    lab3: [f64; 256]
    lab4: [f64; 256]
    lab5: [f64; 256]
    lab6: [f64; 256]
    lab7: [f64; 256]
}

fn og_new(n: i32) -> OctGraph {
    OctGraph {
        n: n, adj: [0; 256],
        lab0: [0.0; 256], lab1: [0.0; 256], lab2: [0.0; 256], lab3: [0.0; 256],
        lab4: [0.0; 256], lab5: [0.0; 256], lab6: [0.0; 256], lab7: [0.0; 256],
    }
}
fn og_idx(u: i32, v: i32) -> i32 { u * 16 + v }
fn og_get_label(g: OctGraph, u: i32, v: i32) -> Oct with Mut, Panic {
    let idx = og_idx(u, v) as usize
    var o = Oct { e: [0.0; 8] }
    o.e[0]=g.lab0[idx]; o.e[1]=g.lab1[idx]; o.e[2]=g.lab2[idx]; o.e[3]=g.lab3[idx]
    o.e[4]=g.lab4[idx]; o.e[5]=g.lab5[idx]; o.e[6]=g.lab6[idx]; o.e[7]=g.lab7[idx]
    o
}
fn og_set_edge(g: OctGraph, u: i32, v: i32, label: Oct) -> OctGraph with Mut, Panic, Div {
    var r = g
    let idx = og_idx(u, v) as usize
    r.adj[idx] = 1
    r.lab0[idx]=label.e[0]; r.lab1[idx]=label.e[1]; r.lab2[idx]=label.e[2]; r.lab3[idx]=label.e[3]
    r.lab4[idx]=label.e[4]; r.lab5[idx]=label.e[5]; r.lab6[idx]=label.e[6]; r.lab7[idx]=label.e[7]
    r
}
fn og_add_undir(g: OctGraph, u: i32, v: i32, label: Oct) -> OctGraph with Mut, Panic, Div {
    var r = og_set_edge(g, u, v, label)
    r = og_set_edge(r, v, u, oct_conjugate(label))
    r
}

fn make_basis_complete(n: i32) -> OctGraph with Mut, Panic, Div {
    var g = og_new(n)
    var u: i32 = 0
    while u < n {
        var v: i32 = u + 1
        while v < n {
            let basis_idx = ((u + v) % 7 + 1) as i64
            g = og_add_undir(g, u, v, oct_unit(basis_idx))
            v = v + 1
        }
        u = u + 1
    }
    g
}

fn count_assoc_zeros(g: OctGraph) -> i32 with Mut, Panic, Div {
    var zeros: i32 = 0
    var total: i32 = 0
    var u: i32 = 0
    while u < g.n {
        var v: i32 = 0
        while v < g.n {
            if g.adj[og_idx(u, v) as usize] == 1 && u != v {
                var w: i32 = 0
                while w < g.n {
                    if g.adj[og_idx(v, w) as usize] == 1 && v != w && w != u {
                        var x: i32 = 0
                        while x < g.n {
                            if g.adj[og_idx(w, x) as usize] == 1 && w != x && x != v {
                                total = total + 1
                                let a = og_get_label(g, u, v)
                                let b = og_get_label(g, v, w)
                                let c = og_get_label(g, w, x)
                                let assoc = oct_associator(a, b, c)
                                if oct_norm(assoc) < 1e-9 { zeros = zeros + 1 }
                            }
                            x = x + 1
                        }
                    }
                    w = w + 1
                }
            }
            v = v + 1
        }
        u = u + 1
    }
    zeros
}

fn count_assoc_total(g: OctGraph) -> i32 with Mut, Panic, Div {
    var total: i32 = 0
    var u: i32 = 0
    while u < g.n {
        var v: i32 = 0
        while v < g.n {
            if g.adj[og_idx(u, v) as usize] == 1 && u != v {
                var w: i32 = 0
                while w < g.n {
                    if g.adj[og_idx(v, w) as usize] == 1 && v != w && w != u {
                        var x: i32 = 0
                        while x < g.n {
                            if g.adj[og_idx(w, x) as usize] == 1 && w != x && x != v {
                                total = total + 1
                            }
                            x = x + 1
                        }
                    }
                    w = w + 1
                }
            }
            v = v + 1
        }
        u = u + 1
    }
    total
}

fn print_frac(num: i32, den: i32) with IO, Mut, Panic, Div {
    if den == 0 { print("N/A"); return }
    let f = (num as f64) / (den as f64)
    let ip = f as i64
    let fp = ((f - (ip as f64)) * 100000.0 + 0.5) as i64
    print(ip); print(".")
    if fp < 10 { print("0000") }
    else if fp < 100 { print("000") }
    else if fp < 1000 { print("00") }
    else if fp < 10000 { print("0") }
    print(fp)
}

fn test_conjecture_1() -> bool with IO, Mut, Panic, Div {
    println("=== CONJECTURE 1: Alternativity Channel Fraction ===")
    println("")
    println("For basis-labeled K_n, is zero_fraction = 5/16 = 0.3125?")
    println("")

    // 5/16 = 0.3125
    let target = 0.3125
    var all_match = true

    var n: i32 = 4
    while n <= 10 {
        let g = make_basis_complete(n)
        let zeros = count_assoc_zeros(g)
        let total = count_assoc_total(g)

        print("  K_"); print(n); print(":  zeros="); print(zeros)
        print("  total="); print(total); print("  fraction=")
        print_frac(zeros, total)

        if total > 0 {
            let frac = (zeros as f64) / (total as f64)
            if abs_f64(frac - target) < 0.001 {
                println("  = 5/16  OK")
            } else {
                print("  != 5/16  (diff=")
                let diff = abs_f64(frac - target)
                let dp = (diff * 100000.0 + 0.5) as i64
                print(dp)
                println("e-5)")
                all_match = false
            }
        } else {
            println("  (no triples)")
        }

        n = n + 1
    }

    println("")
    if all_match {
        println("  CONJECTURE 1: CONFIRMED for n=4..10")
        println("  The fraction 5/16 appears to be universal!")
    } else {
        println("  CONJECTURE 1: VARIES (not constant 5/16)")
        println("  But the pattern may still be exact for each n.")
    }
    println("")
    all_match
}

// ============================================================================
// CONJECTURE 2: ENERGY DILUTION WITH CONNECTIVITY
// ============================================================================

fn lcg_next(s: i64) -> i64 { s * 6364136223846793005 + 1442695040888963407 }
fn lcg_f64(s: i64) -> f64 with Div, Panic {
    let v = if s < 0 { 0 - s } else { s }
    (v as f64) / 9223372036854775807.0
}
fn random_unit_oct(seed: i64) -> Oct with Mut, Panic, Div {
    var o = Oct { e: [0.0; 8] }
    var s = seed
    var i: i64 = 0
    while i < 8 { s = lcg_next(s); o.e[i as usize] = 2.0 * lcg_f64(s) - 1.0; i = i + 1 }
    let n = oct_norm(o)
    if n < 1e-12 { return oct_unit(1) }
    oct_scale(o, 1.0 / n)
}

fn compute_energy_density(g: OctGraph) -> f64 with Mut, Panic, Div {
    var total: i32 = 0
    var energy: f64 = 0.0
    var u: i32 = 0
    while u < g.n {
        var v: i32 = 0
        while v < g.n {
            if g.adj[og_idx(u, v) as usize] == 1 && u != v {
                var w: i32 = 0
                while w < g.n {
                    if g.adj[og_idx(v, w) as usize] == 1 && v != w && w != u {
                        var x: i32 = 0
                        while x < g.n {
                            if g.adj[og_idx(w, x) as usize] == 1 && w != x && x != v {
                                total = total + 1
                                let a = og_get_label(g, u, v)
                                let b = og_get_label(g, v, w)
                                let c = og_get_label(g, w, x)
                                let assoc = oct_associator(a, b, c)
                                let n = oct_norm_sq(assoc)
                                energy = energy + n
                            }
                            x = x + 1
                        }
                    }
                    w = w + 1
                }
            }
            v = v + 1
        }
        u = u + 1
    }
    if total > 0 { energy / (total as f64) } else { 0.0 }
}

fn compute_avg_degree(g: OctGraph) -> f64 with Mut, Panic, Div {
    var total_deg: i32 = 0
    var u: i32 = 0
    while u < g.n {
        var v: i32 = 0
        while v < g.n {
            if g.adj[og_idx(u, v) as usize] == 1 { total_deg = total_deg + 1 }
            v = v + 1
        }
        u = u + 1
    }
    (total_deg as f64) / (g.n as f64)
}

// Make Erdos-Renyi G(n,p) with random octonion labels
fn make_er(n: i32, p_thresh: i32, seed: i64) -> OctGraph with Mut, Panic, Div {
    // p_thresh: out of 100 (so p_thresh=30 means p=0.30)
    var g = og_new(n)
    var s = seed
    var u: i32 = 0
    while u < n {
        var v: i32 = u + 1
        while v < n {
            s = lcg_next(s)
            let rv = lcg_f64(s)
            let threshold = (p_thresh as f64) / 100.0
            if rv < threshold {
                s = lcg_next(s)
                g = og_add_undir(g, u, v, random_unit_oct(s))
            }
            v = v + 1
        }
        u = u + 1
    }
    g
}

fn test_conjecture_2() -> bool with IO, Mut, Panic, Div {
    println("=== CONJECTURE 2: Energy Dilution with Connectivity ===")
    println("")
    println("Does energy density decrease with average degree?")
    println("Testing ER G(10, p) for p = 0.3, 0.5, 0.7, 0.9")
    println("")

    let seed: i64 = 12345

    // ER with different densities
    let g30 = make_er(10, 30, seed)
    let g50 = make_er(10, 50, seed)
    let g70 = make_er(10, 70, seed)
    let g90 = make_er(10, 90, seed)

    let ed30 = compute_energy_density(g30)
    let ed50 = compute_energy_density(g50)
    let ed70 = compute_energy_density(g70)
    let ed90 = compute_energy_density(g90)

    let ad30 = compute_avg_degree(g30)
    let ad50 = compute_avg_degree(g50)
    let ad70 = compute_avg_degree(g70)
    let ad90 = compute_avg_degree(g90)

    print("  p=0.3: avg_deg=")
    let ip30 = ad30 as i64
    let fp30 = ((ad30 - (ip30 as f64)) * 100.0 + 0.5) as i64
    print(ip30); print("."); print(fp30)
    print("  energy_density=")
    let ipe30 = ed30 as i64
    let fpe30 = ((ed30 - (ipe30 as f64)) * 10000.0 + 0.5) as i64
    print(ipe30); print("."); println(fpe30)

    print("  p=0.5: avg_deg=")
    let ip50 = ad50 as i64
    let fp50 = ((ad50 - (ip50 as f64)) * 100.0 + 0.5) as i64
    print(ip50); print("."); print(fp50)
    print("  energy_density=")
    let ipe50 = ed50 as i64
    let fpe50 = ((ed50 - (ipe50 as f64)) * 10000.0 + 0.5) as i64
    print(ipe50); print("."); println(fpe50)

    print("  p=0.7: avg_deg=")
    let ip70 = ad70 as i64
    let fp70 = ((ad70 - (ip70 as f64)) * 100.0 + 0.5) as i64
    print(ip70); print("."); print(fp70)
    print("  energy_density=")
    let ipe70 = ed70 as i64
    let fpe70 = ((ed70 - (ipe70 as f64)) * 10000.0 + 0.5) as i64
    print(ipe70); print("."); println(fpe70)

    print("  p=0.9: avg_deg=")
    let ip90 = ad90 as i64
    let fp90 = ((ad90 - (ip90 as f64)) * 100.0 + 0.5) as i64
    print(ip90); print("."); print(fp90)
    print("  energy_density=")
    let ipe90 = ed90 as i64
    let fpe90 = ((ed90 - (ipe90 as f64)) * 10000.0 + 0.5) as i64
    print(ipe90); print("."); println(fpe90)

    println("")

    // Check monotonicity: ed should decrease as p increases
    let monotone = ed30 >= ed50 && ed50 >= ed70 && ed70 >= ed90
    if monotone {
        println("  CONJECTURE 2: SUPPORTED (monotone decrease)")
    } else {
        println("  CONJECTURE 2: NOT MONOTONE")
        println("  Energy density does not strictly decrease with connectivity.")
        println("  The relationship may be more nuanced.")
    }
    println("")
    monotone
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("================================================================")
    println("  CONJECTURE TESTING: Octonion-Labeled Graph Theory")
    println("================================================================")
    println("")

    let c3 = test_conjecture_3()
    let c1 = test_conjecture_1()
    let c2 = test_conjecture_2()

    println("================================================================")
    println("  SUMMARY")
    println("================================================================")
    print("  Conjecture 1 (5/16 alternativity):  ")
    if c1 { println("CONFIRMED") } else { println("OPEN") }
    print("  Conjecture 2 (energy dilution):      ")
    if c2 { println("SUPPORTED") } else { println("OPEN") }
    print("  Conjecture 3 (binary {0,2} norm):    ")
    if c3 { println("CONFIRMED") } else { println("OPEN") }
    println("================================================================")

    0
}
