// Knowledge — GUM-compliant epistemic computing (JCGM 100:2008)
// Native x86-64 ELF via lean driver. No JIT. Fixed-point ×10³.

struct Knowledge {
    value: i64,       // ×10³
    variance: i64,    // σ² in (×10³)²
    confidence: i64,  // ×10³ (950 = 95%)
}

var RES: Knowledge = Knowledge { value: 0, variance: 0, confidence: 0 }

// GUM §5.1.2: u²(a+b) = u²(a) + u²(b)
fn gum_add(a: Knowledge, b: Knowledge) {
    let sv = a.value + b.value
    let su = a.variance + b.variance
    let sc = if a.confidence < b.confidence { a.confidence } else { b.confidence }
    RES = Knowledge { value: sv, variance: su, confidence: sc }
}

fn isqrt(x: i64) -> i64 {
    if x <= 0 { return 0 }
    var y = x
    var i: i64 = 0
    while i < 40 { y = (y + x / y) / 2; i = i + 1 }
    y
}

fn main() -> i64 with IO, Mut {
    print("=== GUM Epistemic Computing — Native x86-64 ===\n")

    // Plasma concentrations (×10³ ng/mL)
    let c1 = Knowledge { value: 3200, variance: 250000, confidence: 950 }
    let c2 = Knowledge { value: 1800, variance: 90000, confidence: 950 }

    gum_add(c1, c2)
    let total = RES

    print("C1   = "); print_int(c1.value); print(" ± "); print_int(isqrt(c1.variance)); print("\n")
    print("C2   = "); print_int(c2.value); print(" ± "); print_int(isqrt(c2.variance)); print("\n")
    print("C1+C2= "); print_int(total.value); print(" ± "); print_int(isqrt(total.variance)); print("\n")

    let check = c1.variance + c2.variance - total.variance
    print("GUM check: "); print_int(check); print(" (must=0)\n")

    return 0
}
