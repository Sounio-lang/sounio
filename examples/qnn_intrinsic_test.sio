//! Minimal test for QNN intrinsics (no stdlib imports)

fn main() {
    // Test basic Quat constructor
    let q1 = quat(1.0, 0.0, 0.0, 0.0)
    let q2 = quat(0.0, 1.0, 0.0, 0.0)

    // Test weight initialization intrinsics
    let weights = quat_init_xavier(4, 8, 42)
    let bias = quat_init_he(1, 8, 43)
    let unit_weights = quat_init_unit(4, 8, 44)

    // Test quaternion activations
    let activated_relu = quat_relu(weights)
    let activated_sigmoid = quat_sigmoid(weights)
    let activated_tanh = quat_tanh(weights)
}
