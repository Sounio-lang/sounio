// Conjecture 6.8 (Guterman-Zhilina, arXiv:2608.26903) -- rational sweep beyond
// the basis. Research runner (exploratory: no expect-stdout gate; prints honest
// counts). See docs/research/conj68_attack_log_2026-08-31.md.
//
// Question probed: does the "witness = small +-1 integer combination in the
// hexagon frames" phenomenon (proved on the full basis sweep, D3EXACT=43/43)
// persist for generic small-integer zero divisors off the basis?
//
// Construction (all decidable i64):
//   * x0 = (e1, e2) canonical (WLOG: Aut(O) acts transitively on ZDs, so pairs
//     (x0, random x') cover general pairs up to automorphism).
//   * Random integer ZD x' = (k*a, a*t): a pure with <=2 nonzero entries in
//     {-1,0,1}; t pure, t _|_ a, integer, with n(t) = k^2 a perfect square
//     (rejection-sampled). Then n(k a) = n(a t), components orthogonal & pure.
//     SIZE LIMIT (stated, not silent): entries kept small so every product in
//     the pipeline stays far inside i64; this samples a genuine off-basis
//     neighbourhood, not the full variety.
//   * O(x') frame by the closed form: partners (N*c_j, c_j * z), z = A*B,
//     N = n(A), c_j an integer basis of {1, A, B, z}-perp inside Im(O)
//     (fraction-free 3x7 elimination, gcd-reduced). The formula is VERIFIED by
//     exact bilateral annihilation for every generator; variants with swapped
//     sign are tried; a pair is skipped (and counted) if none verifies.
//   * d=1: exact commutator. d=2: rank of stacked 10x16 frame matrix mod two
//     large primes -- rank 10 mod p PROVES exact rank 10 (rank only drops mod
//     p), so "not d2" is certified; rank < 10 under both primes is reported as
//     d2 (error probability ~ (10/p)^2, honest).
//   * d=3 witness: integer combos, support <= 3, coefficients +-1, both sides.
//
// Output: SWEEP <N>  D1 <> D2 <> W1 <> W2 <> W3 <> UNRES <> SKIP <>
//   W_s = witnesses needing support s. UNRES > 0 = pairs where no small
//   integer witness exists (the interesting datum, NOT a failure gate).

fn cd_sigma_c(a: i64, b: i64, bits: i64) -> i64 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_c(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_c(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_c(a_lo, 0, bits - 1) }
        return 0 - cd_sigma_c(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma_c(0, a_lo, bits - 1) }
    cd_sigma_c(b_lo, a_lo, bits - 1)
}

fn sed_sigma(a: i64, b: i64) -> i64 with Mut, Panic, Div { cd_sigma_c(a, b, 4) }

fn smul_i(x: &[i64; 16], y: &[i64; 16], out: &![i64; 16]) with Mut, Panic, Div {
    var k = 0
    while k < 16 { out[k as usize] = 0; k = k + 1 }
    var i = 0
    while i < 16 {
        if x[i as usize] != 0 {
            var j = 0
            while j < 16 {
                if y[j as usize] != 0 {
                    let t = i ^ j
                    out[t as usize] = out[t as usize] + sed_sigma(i, j) * x[i as usize] * y[j as usize]
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

fn omul_i(x: &[i64; 8], y: &[i64; 8], out: &![i64; 8]) with Mut, Panic, Div {
    var k = 0
    while k < 8 { out[k as usize] = 0; k = k + 1 }
    var i = 0
    while i < 8 {
        if x[i as usize] != 0 {
            var j = 0
            while j < 8 {
                if y[j as usize] != 0 {
                    let t = i ^ j
                    out[t as usize] = out[t as usize] + sed_sigma(i, j) * x[i as usize] * y[j as usize]
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

fn is_zero16(v: &[i64; 16]) -> bool with Mut {
    var k = 0
    while k < 16 {
        if v[k as usize] != 0 { return false }
        k = k + 1
    }
    true
}

fn comm_is_zero(x: &[i64; 16], y: &[i64; 16]) -> bool with Mut, Panic, Div {
    var xy = [0; 16]
    var yx = [0; 16]
    smul_i(x, y, &!xy)
    smul_i(y, x, &!yx)
    var k = 0
    while k < 16 {
        if xy[k as usize] != yx[k as usize] { return false }
        k = k + 1
    }
    true
}

fn annihilates_both(x: &[i64; 16], y: &[i64; 16]) -> bool with Mut, Panic, Div {
    var p = [0; 16]
    smul_i(x, y, &!p)
    if !is_zero16(&p) { return false }
    smul_i(y, x, &!p)
    is_zero16(&p)
}

fn gcd_i(a0: i64, b0: i64) -> i64 with Mut, Div, Panic {
    var a = if a0 < 0 { 0 - a0 } else { a0 }
    var b = if b0 < 0 { 0 - b0 } else { b0 }
    while b != 0 {
        let t = a % b
        a = b
        b = t
    }
    a
}

fn isqrt_exact(n: i64) -> i64 with Mut, Div, Panic {
    // returns k if n == k*k else -1
    if n < 0 { return 0 - 1 }
    var k = 0
    while k * k < n { k = k + 1 }
    if k * k == n { k } else { 0 - 1 }
}

fn lehmer_next(state: i64) -> i64 with Mut, Div, Panic {
    (state * 48271) % 2147483647
}

// rank of an r x 16 i64 matrix modulo prime p (r <= 10); entries reduced mod p.
fn rank_mod_p(rows_in: &[i64; 160], nrows: i64, p: i64) -> i64 with Mut, Panic, Div {
    var m = [0; 160]
    var i = 0
    while i < nrows * 16 {
        var v = rows_in[i as usize] % p
        if v < 0 { v = v + p }
        m[i as usize] = v
        i = i + 1
    }
    var rank = 0
    var col = 0
    while col < 16 && rank < nrows {
        var pr = 0 - 1
        var r = rank
        while r < nrows {
            if m[(r * 16 + col) as usize] != 0 { pr = r; r = nrows } else { r = r + 1 }
        }
        if pr >= 0 {
            if pr != rank {
                var c = 0
                while c < 16 {
                    let t = m[(rank * 16 + c) as usize]
                    m[(rank * 16 + c) as usize] = m[(pr * 16 + c) as usize]
                    m[(pr * 16 + c) as usize] = t
                    c = c + 1
                }
            }
            // modular inverse of pivot via Fermat (p prime): piv^(p-2) mod p
            let piv = m[(rank * 16 + col) as usize]
            var inv = 1
            var base = piv
            var e = p - 2
            while e > 0 {
                if (e % 2) == 1 { inv = (inv * base) % p }
                base = (base * base) % p
                e = e / 2
            }
            var r2 = rank + 1
            while r2 < nrows {
                let f = (m[(r2 * 16 + col) as usize] * inv) % p
                if f != 0 {
                    var c2 = 0
                    while c2 < 16 {
                        var nv = (m[(r2 * 16 + c2) as usize] - (f * m[(rank * 16 + c2) as usize]) % p) % p
                        if nv < 0 { nv = nv + p }
                        m[(r2 * 16 + c2) as usize] = nv
                        c2 = c2 + 1
                    }
                }
                r2 = r2 + 1
            }
            rank = rank + 1
        }
        col = col + 1
    }
    rank
}

// rank of the full bilinear map T: U (x) V -> Im S as a 16 x 25 matrix mod p
// (columns = [u_i, w_j] over the 5x5 frame pairs). Structural probe: if
// rank(T) is uniformly small, ker T is large and rank-one existence becomes a
// linear-section-of-Segre question -- candidate proof route for Conj 6.8.
fn rank_t_mod_p(t: &[i64; 400], p: i64) -> i64 with Mut, Panic, Div {
    var m = [0; 400]
    var i = 0
    while i < 400 {
        var v = t[i as usize] % p
        if v < 0 { v = v + p }
        m[i as usize] = v
        i = i + 1
    }
    var rank = 0
    var col = 0
    while col < 25 && rank < 16 {
        var pr = 0 - 1
        var r = rank
        while r < 16 {
            if m[(r * 25 + col) as usize] != 0 { pr = r; r = 16 } else { r = r + 1 }
        }
        if pr >= 0 {
            if pr != rank {
                var c = 0
                while c < 25 {
                    let tmp = m[(rank * 25 + c) as usize]
                    m[(rank * 25 + c) as usize] = m[(pr * 25 + c) as usize]
                    m[(pr * 25 + c) as usize] = tmp
                    c = c + 1
                }
            }
            let piv = m[(rank * 25 + col) as usize]
            var inv = 1
            var base = piv
            var e = p - 2
            while e > 0 {
                if (e % 2) == 1 { inv = (inv * base) % p }
                base = (base * base) % p
                e = e / 2
            }
            var r2 = rank + 1
            while r2 < 16 {
                let f = (m[(r2 * 25 + col) as usize] * inv) % p
                if f != 0 {
                    var c2 = 0
                    while c2 < 25 {
                        var nv = (m[(r2 * 25 + c2) as usize] - (f * m[(rank * 25 + c2) as usize]) % p) % p
                        if nv < 0 { nv = nv + p }
                        m[(r2 * 25 + c2) as usize] = nv
                        c2 = c2 + 1
                    }
                }
                r2 = r2 + 1
            }
            rank = rank + 1
        }
        col = col + 1
    }
    rank
}

// integer kernel basis of the 3 constraint rows (A, B, z as octonions embedded
// in coords 1..7; coord 0 excluded => pure) via fraction-free elimination on a
// 3x7 system; out: 4 gcd-reduced integer vectors (8-dim, coord 0 = 0).
// Returns number of kernel vectors produced (expected 4).
fn perp_basis(arow: &[i64; 8], brow: &[i64; 8], zrow: &[i64; 8], out: &![i64; 32]) -> i64 with Mut, Panic, Div {
    // m: 3 rows x 7 cols (coords 1..7)
    var m = [0; 21]
    var c = 0
    while c < 7 {
        m[c as usize] = arow[(c + 1) as usize]
        m[(7 + c) as usize] = brow[(c + 1) as usize]
        m[(14 + c) as usize] = zrow[(c + 1) as usize]
        c = c + 1
    }
    var piv_col = [0; 3]
    var rank = 0
    var prev = 1
    var col = 0
    while col < 7 && rank < 3 {
        var pr = 0 - 1
        var r = rank
        while r < 3 {
            if m[(r * 7 + col) as usize] != 0 { pr = r; r = 3 } else { r = r + 1 }
        }
        if pr >= 0 {
            if pr != rank {
                var c1 = 0
                while c1 < 7 {
                    let t = m[(rank * 7 + c1) as usize]
                    m[(rank * 7 + c1) as usize] = m[(pr * 7 + c1) as usize]
                    m[(pr * 7 + c1) as usize] = t
                    c1 = c1 + 1
                }
            }
            let piv = m[(rank * 7 + col) as usize]
            var r2 = 0
            while r2 < 3 {
                if r2 != rank {
                    let f = m[(r2 * 7 + col) as usize]
                    if f != 0 {
                        var c2 = 0
                        while c2 < 7 {
                            m[(r2 * 7 + c2) as usize] = piv * m[(r2 * 7 + c2) as usize] - f * m[(rank * 7 + c2) as usize]
                            c2 = c2 + 1
                        }
                        // gcd-reduce the row to control growth
                        var g = 0
                        var c3 = 0
                        while c3 < 7 {
                            g = gcd_i(g, m[(r2 * 7 + c3) as usize])
                            c3 = c3 + 1
                        }
                        var gd = 1
                        if g > 1 { gd = g }
                        if gd > 1 {
                            c3 = 0
                            while c3 < 7 { m[(r2 * 7 + c3) as usize] = m[(r2 * 7 + c3) as usize] / gd; c3 = c3 + 1 }
                        }
                    }
                }
                r2 = r2 + 1
            }
            piv_col[rank as usize] = col
            prev = piv
            rank = rank + 1
        }
        col = col + 1
    }
    // free columns -> kernel vectors: v[free] = prod-of-pivots pattern
    var nout = 0
    var fc = 0
    while fc < 7 {
        var isp = 0
        var q = 0
        while q < rank {
            if piv_col[q as usize] == fc { isp = 1 }
            q = q + 1
        }
        if isp == 0 && nout < 4 {
            var v = [0; 8]
            // denominator-free: v[fc] = prod of pivots; v[piv_col_q] solves row q
            var prodp = 1
            q = 0
            while q < rank { prodp = prodp * m[(q * 7 + piv_col[q as usize]) as usize]; q = q + 1 }
            v[(fc + 1) as usize] = prodp
            q = 0
            while q < rank {
                let pc = piv_col[q as usize]
                var piv = 1
                if m[(q * 7 + pc) as usize] != 0 { piv = m[(q * 7 + pc) as usize] }
                // row q: piv * v[pc] + m[q][fc] * v[fc] = 0 (rows mutually
                // eliminated) so: v[pc] = -m[q][fc] * prodp / piv
                v[(pc + 1) as usize] = (0 - m[(q * 7 + fc) as usize]) * (prodp / piv)
                q = q + 1
            }
            var g2 = 0
            var c4 = 0
            while c4 < 8 { g2 = gcd_i(g2, v[c4 as usize]); c4 = c4 + 1 }
            var g2d = 1
            if g2 > 1 { g2d = g2 }
            if g2d > 1 {
                c4 = 0
                while c4 < 8 { v[c4 as usize] = v[c4 as usize] / g2d; c4 = c4 + 1 }
            }
            c4 = 0
            while c4 < 8 { out[(nout * 8 + c4) as usize] = v[c4 as usize]; c4 = c4 + 1 }
            nout = nout + 1
        }
        fc = fc + 1
    }
    nout
}

// rank of the O(x0) x O(x') sector: columns (i,j), i,j in 1..4 -> 16x16 mod p
fn rank_t44_mod_p(t: &[i64; 400], p: i64) -> i64 with Mut, Panic, Div {
    var m = [0; 256]
    var r0 = 0
    while r0 < 16 {
        var i = 1
        while i < 5 {
            var j = 1
            while j < 5 {
                var v = t[(r0 * 25 + i * 5 + j) as usize] % p
                if v < 0 { v = v + p }
                m[(r0 * 16 + (i - 1) * 4 + (j - 1)) as usize] = v
                j = j + 1
            }
            i = i + 1
        }
        r0 = r0 + 1
    }
    var rank = 0
    var col = 0
    while col < 16 && rank < 16 {
        var pr = 0 - 1
        var r = rank
        while r < 16 {
            if m[(r * 16 + col) as usize] != 0 { pr = r; r = 16 } else { r = r + 1 }
        }
        if pr >= 0 {
            if pr != rank {
                var c = 0
                while c < 16 {
                    let tmp = m[(rank * 16 + c) as usize]
                    m[(rank * 16 + c) as usize] = m[(pr * 16 + c) as usize]
                    m[(pr * 16 + c) as usize] = tmp
                    c = c + 1
                }
            }
            let piv = m[(rank * 16 + col) as usize]
            var inv = 1
            var base = piv
            var e = p - 2
            while e > 0 {
                if (e % 2) == 1 { inv = (inv * base) % p }
                base = (base * base) % p
                e = e / 2
            }
            var r2 = rank + 1
            while r2 < 16 {
                let f = (m[(r2 * 16 + col) as usize] * inv) % p
                if f != 0 {
                    var c2 = 0
                    while c2 < 16 {
                        var nv = (m[(r2 * 16 + c2) as usize] - (f * m[(rank * 16 + c2) as usize]) % p) % p
                        if nv < 0 { nv = nv + p }
                        m[(r2 * 16 + c2) as usize] = nv
                        c2 = c2 + 1
                    }
                }
                r2 = r2 + 1
            }
            rank = rank + 1
        }
        col = col + 1
    }
    rank
}

// ------------- f64 witness hunt (ported from the run-pass probe): alternating
// inverse-power on G = A^T A + Gauss-Newton polish; lock0 confines to the
// O x O sector. Used ONLY to triage UNRES pairs: residual ~0 => continuous
// witness exists; a robust floor => CANDIDATE d=4 pair (counterexample lead).

fn fabs_(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn fsqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = if x > 1.0 { x } else { 1.0 }
    var it = 0
    while it < 40 {
        y = 0.5 * (y + x / y)
        it = it + 1
    }
    y
}

fn solve5(a_in: &[f64; 25], b_in: &[f64; 5], y: &![f64; 5]) with Mut, Panic, Div {
    var a = [0.0; 25]
    var b = [0.0; 5]
    var i = 0
    while i < 25 { a[i as usize] = a_in[i as usize]; i = i + 1 }
    i = 0
    while i < 5 { b[i as usize] = b_in[i as usize]; i = i + 1 }
    var col = 0
    while col < 5 {
        var pr = col
        var best = fabs_(a[(col * 5 + col) as usize])
        var r = col + 1
        while r < 5 {
            let v = fabs_(a[(r * 5 + col) as usize])
            if v > best { best = v; pr = r }
            r = r + 1
        }
        if pr != col {
            var c = 0
            while c < 5 {
                let t = a[(col * 5 + c) as usize]
                a[(col * 5 + c) as usize] = a[(pr * 5 + c) as usize]
                a[(pr * 5 + c) as usize] = t
                c = c + 1
            }
            let tb = b[col as usize]
            b[col as usize] = b[pr as usize]
            b[pr as usize] = tb
        }
        var piv = a[(col * 5 + col) as usize]
        if fabs_(piv) < 1e-300 { piv = 1e-300 }
        r = col + 1
        while r < 5 {
            let f = a[(r * 5 + col) as usize] / piv
            var c = col
            while c < 5 {
                a[(r * 5 + c) as usize] = a[(r * 5 + c) as usize] - f * a[(col * 5 + c) as usize]
                c = c + 1
            }
            b[r as usize] = b[r as usize] - f * b[col as usize]
            r = r + 1
        }
        col = col + 1
    }
    var rr = 4
    while rr >= 0 {
        var s = b[rr as usize]
        var c = rr + 1
        while c < 5 {
            s = s - a[(rr * 5 + c) as usize] * y[c as usize]
            c = c + 1
        }
        var piv = a[(rr * 5 + rr) as usize]
        if fabs_(piv) < 1e-300 { piv = 1e-300 }
        y[rr as usize] = s / piv
        rr = rr - 1
    }
}

fn solve10(a_in: &[f64; 100], b_in: &[f64; 10], y: &![f64; 10]) with Mut, Panic, Div {
    var a = [0.0; 100]
    var b = [0.0; 10]
    var i = 0
    while i < 100 { a[i as usize] = a_in[i as usize]; i = i + 1 }
    i = 0
    while i < 10 { b[i as usize] = b_in[i as usize]; i = i + 1 }
    var col = 0
    while col < 10 {
        var pr = col
        var best = fabs_(a[(col * 10 + col) as usize])
        var r = col + 1
        while r < 10 {
            let v = fabs_(a[(r * 10 + col) as usize])
            if v > best { best = v; pr = r }
            r = r + 1
        }
        if pr != col {
            var c = 0
            while c < 10 {
                let t = a[(col * 10 + c) as usize]
                a[(col * 10 + c) as usize] = a[(pr * 10 + c) as usize]
                a[(pr * 10 + c) as usize] = t
                c = c + 1
            }
            let tb = b[col as usize]
            b[col as usize] = b[pr as usize]
            b[pr as usize] = tb
        }
        var piv = a[(col * 10 + col) as usize]
        if fabs_(piv) < 1e-300 { piv = 1e-300 }
        r = col + 1
        while r < 10 {
            let f = a[(r * 10 + col) as usize] / piv
            var c = col
            while c < 10 {
                a[(r * 10 + c) as usize] = a[(r * 10 + c) as usize] - f * a[(col * 10 + c) as usize]
                c = c + 1
            }
            b[r as usize] = b[r as usize] - f * b[col as usize]
            r = r + 1
        }
        col = col + 1
    }
    var rr = 9
    while rr >= 0 {
        var s = b[rr as usize]
        var c = rr + 1
        while c < 10 {
            s = s - a[(rr * 10 + c) as usize] * y[c as usize]
            c = c + 1
        }
        var piv = a[(rr * 10 + rr) as usize]
        if fabs_(piv) < 1e-300 { piv = 1e-300 }
        y[rr as usize] = s / piv
        rr = rr - 1
    }
}

fn residual_of(c: &[f64; 400], k: &[f64; 5], m: &[f64; 5]) -> f64 with Mut, Div, Panic {
    var s = 0.0
    var cc = 0
    while cc < 16 {
        var acc = 0.0
        var i = 0
        while i < 5 {
            var j = 0
            while j < 5 {
                acc = acc + k[i as usize] * m[j as usize] * c[(cc * 25 + i * 5 + j) as usize]
                j = j + 1
            }
            i = i + 1
        }
        s = s + acc * acc
        cc = cc + 1
    }
    fsqrt(s)
}

fn hunt_once(c: &[f64; 400], seed: i64, alt_iters: i64, gn_iters: i64, lock0: i64) -> f64 with Mut, Div, Panic {
    var st = seed
    var k = [0.0; 5]
    var m = [0.0; 5]
    var i = 0
    while i < 5 {
        st = lehmer_next(st)
        m[i as usize] = (st as f64) / 2147483647.0 - 0.5
        i = i + 1
    }
    var nm = 0.0
    i = 0
    while i < 5 { nm = nm + m[i as usize] * m[i as usize]; i = i + 1 }
    nm = fsqrt(nm)
    if nm < 1e-12 { m[0] = 1.0; nm = 1.0 }
    i = 0
    while i < 5 { m[i as usize] = m[i as usize] / nm; i = i + 1 }
    if lock0 == 1 { m[0] = 0.0 }
    i = 0
    while i < 5 { k[i as usize] = 0.0; i = i + 1 }
    if lock0 == 1 { k[1] = 1.0 } else { k[0] = 1.0 }
    var it = 0
    while it < alt_iters {
        var g = [0.0; 25]
        var i2 = 0
        while i2 < 5 {
            var j2 = 0
            while j2 < 5 {
                var s = 0.0
                var cc = 0
                while cc < 16 {
                    var ai = 0.0
                    var aj = 0.0
                    var jj = 0
                    while jj < 5 {
                        ai = ai + m[jj as usize] * c[(cc * 25 + i2 * 5 + jj) as usize]
                        aj = aj + m[jj as usize] * c[(cc * 25 + j2 * 5 + jj) as usize]
                        jj = jj + 1
                    }
                    s = s + ai * aj
                    cc = cc + 1
                }
                g[(i2 * 5 + j2) as usize] = s
                j2 = j2 + 1
            }
            i2 = i2 + 1
        }
        i2 = 0
        while i2 < 5 { g[(i2 * 5 + i2) as usize] = g[(i2 * 5 + i2) as usize] + 1e-14; i2 = i2 + 1 }
        if lock0 == 1 {
            var q0 = 0
            while q0 < 5 { g[q0 as usize] = 0.0; g[(q0 * 5) as usize] = 0.0; q0 = q0 + 1 }
            g[0] = 1.0
        }
        var y = [0.0; 5]
        solve5(&g, &k, &!y)
        var ny = 0.0
        i2 = 0
        while i2 < 5 { ny = ny + y[i2 as usize] * y[i2 as usize]; i2 = i2 + 1 }
        ny = fsqrt(ny)
        if ny > 1e-300 {
            i2 = 0
            while i2 < 5 { k[i2 as usize] = y[i2 as usize] / ny; i2 = i2 + 1 }
        }
        var h = [0.0; 25]
        i2 = 0
        while i2 < 5 {
            var j2 = 0
            while j2 < 5 {
                var s = 0.0
                var cc = 0
                while cc < 16 {
                    var bi = 0.0
                    var bj = 0.0
                    var ii = 0
                    while ii < 5 {
                        bi = bi + k[ii as usize] * c[(cc * 25 + ii * 5 + i2) as usize]
                        bj = bj + k[ii as usize] * c[(cc * 25 + ii * 5 + j2) as usize]
                        ii = ii + 1
                    }
                    s = s + bi * bj
                    cc = cc + 1
                }
                h[(i2 * 5 + j2) as usize] = s
                j2 = j2 + 1
            }
            i2 = i2 + 1
        }
        i2 = 0
        while i2 < 5 { h[(i2 * 5 + i2) as usize] = h[(i2 * 5 + i2) as usize] + 1e-14; i2 = i2 + 1 }
        if lock0 == 1 {
            var q1 = 0
            while q1 < 5 { h[q1 as usize] = 0.0; h[(q1 * 5) as usize] = 0.0; q1 = q1 + 1 }
            h[0] = 1.0
        }
        var y2 = [0.0; 5]
        solve5(&h, &m, &!y2)
        var ny2 = 0.0
        i2 = 0
        while i2 < 5 { ny2 = ny2 + y2[i2 as usize] * y2[i2 as usize]; i2 = i2 + 1 }
        ny2 = fsqrt(ny2)
        if ny2 > 1e-300 {
            i2 = 0
            while i2 < 5 { m[i2 as usize] = y2[i2 as usize] / ny2; i2 = i2 + 1 }
        }
        it = it + 1
    }
    var gn = 0
    while gn < gn_iters {
        var jt_j = [0.0; 100]
        var jt_f = [0.0; 10]
        var z = 0
        while z < 100 { jt_j[z as usize] = 0.0; z = z + 1 }
        z = 0
        while z < 10 { jt_f[z as usize] = 0.0; z = z + 1 }
        var cc = 0
        while cc < 16 {
            var arow = [0.0; 10]
            var i3 = 0
            while i3 < 5 {
                var ai = 0.0
                var jj = 0
                while jj < 5 {
                    ai = ai + m[jj as usize] * c[(cc * 25 + i3 * 5 + jj) as usize]
                    jj = jj + 1
                }
                arow[i3 as usize] = ai
                i3 = i3 + 1
            }
            var j3 = 0
            while j3 < 5 {
                var bj = 0.0
                var ii = 0
                while ii < 5 {
                    bj = bj + k[ii as usize] * c[(cc * 25 + ii * 5 + j3) as usize]
                    ii = ii + 1
                }
                arow[(5 + j3) as usize] = bj
                j3 = j3 + 1
            }
            var fval = 0.0
            var i4 = 0
            while i4 < 5 { fval = fval + arow[i4 as usize] * k[i4 as usize]; i4 = i4 + 1 }
            var p = 0
            while p < 10 {
                var q = 0
                while q < 10 {
                    jt_j[(p * 10 + q) as usize] = jt_j[(p * 10 + q) as usize] + arow[p as usize] * arow[q as usize]
                    q = q + 1
                }
                jt_f[p as usize] = jt_f[p as usize] + arow[p as usize] * fval
                p = p + 1
            }
            cc = cc + 1
        }
        var p2 = 0
        while p2 < 10 {
            jt_j[(p2 * 10 + p2) as usize] = jt_j[(p2 * 10 + p2) as usize] + 1e-16
            jt_f[p2 as usize] = 0.0 - jt_f[p2 as usize]
            p2 = p2 + 1
        }
        if lock0 == 1 {
            var q2 = 0
            while q2 < 10 {
                jt_j[q2 as usize] = 0.0
                jt_j[(q2 * 10) as usize] = 0.0
                jt_j[(50 + q2) as usize] = 0.0
                jt_j[(q2 * 10 + 5) as usize] = 0.0
                q2 = q2 + 1
            }
            jt_j[0] = 1.0
            jt_j[55] = 1.0
            jt_f[0] = 0.0
            jt_f[5] = 0.0
        }
        var delta = [0.0; 10]
        solve10(&jt_j, &jt_f, &!delta)
        var i5 = 0
        while i5 < 5 {
            k[i5 as usize] = k[i5 as usize] + delta[i5 as usize]
            m[i5 as usize] = m[i5 as usize] + delta[(5 + i5) as usize]
            i5 = i5 + 1
        }
        var nk = 0.0
        var nm2 = 0.0
        i5 = 0
        while i5 < 5 {
            nk = nk + k[i5 as usize] * k[i5 as usize]
            nm2 = nm2 + m[i5 as usize] * m[i5 as usize]
            i5 = i5 + 1
        }
        nk = fsqrt(nk)
        nm2 = fsqrt(nm2)
        if nk < 1e-9 || nm2 < 1e-9 { return 1e9 }
        i5 = 0
        while i5 < 5 {
            k[i5 as usize] = k[i5 as usize] / nk
            m[i5 as usize] = m[i5 as usize] / nm2
            i5 = i5 + 1
        }
        gn = gn + 1
    }
    residual_of(c, &k, &m)
}

// combo over rows with support <= 3, coefficients +-1; pat interpretation:
// 0..4 single; 5..24 pairs (i<j, rel sign); 25..64 triples (i<j<k, 4 sign pats)
fn combo_vec(rows: &[i64; 160], pat: i64, out: &![i64; 16]) with Mut, Panic, Div {
    var c = 0
    while c < 16 { out[c as usize] = 0; c = c + 1 }
    if pat < 5 {
        var c1 = 0
        while c1 < 16 { out[c1 as usize] = rows[(pat * 16 + c1) as usize]; c1 = c1 + 1 }
        return
    }
    if pat < 25 {
        let p = pat - 5
        let pair = p / 2
        let sgn = if (p % 2) == 0 { 1 } else { 0 - 1 }
        var i = 0
        var j = 1
        var cnt = 0
        var found = 0
        while i < 5 && found == 0 {
            j = i + 1
            while j < 5 && found == 0 {
                if cnt == pair { found = 1 } else { cnt = cnt + 1; j = j + 1 }
            }
            if found == 0 { i = i + 1 }
        }
        var c2 = 0
        while c2 < 16 {
            out[c2 as usize] = rows[(i * 16 + c2) as usize] + sgn * rows[(j * 16 + c2) as usize]
            c2 = c2 + 1
        }
        return
    }
    let p3 = pat - 25
    let trip = p3 / 4
    let spat = p3 % 4
    let s1 = if (spat & 1) == 0 { 1 } else { 0 - 1 }
    let s2 = if (spat & 2) == 0 { 1 } else { 0 - 1 }
    var i3 = 0
    var j3 = 1
    var k3 = 2
    var cnt3 = 0
    var fnd = 0
    while i3 < 5 && fnd == 0 {
        j3 = i3 + 1
        while j3 < 5 && fnd == 0 {
            k3 = j3 + 1
            while k3 < 5 && fnd == 0 {
                if cnt3 == trip { fnd = 1 } else { cnt3 = cnt3 + 1; k3 = k3 + 1 }
            }
            if fnd == 0 { j3 = j3 + 1 }
        }
        if fnd == 0 { i3 = i3 + 1 }
    }
    var c5 = 0
    while c5 < 16 {
        out[c5 as usize] = rows[(i3 * 16 + c5) as usize]
            + s1 * rows[(j3 * 16 + c5) as usize]
            + s2 * rows[(k3 * 16 + c5) as usize]
        c5 = c5 + 1
    }
}

// returns 0 = none, else min support (1, 2, or 3) over both sides' max
fn exact_combo_witness3(urow: &[i64; 160], vrow: &[i64; 160]) -> i64 with Mut, Panic, Div {
    var level = 1
    while level <= 3 {
        let lim = if level == 1 { 5 } else { if level == 2 { 25 } else { 65 } }
        var pa = 0
        while pa < lim {
            var u = [0; 16]
            combo_vec(urow, pa, &!u)
            if !is_zero16(&u) {
                var pb = 0
                while pb < lim {
                    var w = [0; 16]
                    combo_vec(vrow, pb, &!w)
                    if !is_zero16(&w) {
                        if comm_is_zero(&u, &w) { return level }
                    }
                    pb = pb + 1
                }
            }
            pa = pa + 1
        }
        level = level + 1
    }
    0
}

fn main() with IO, Mut, Panic, Div {
    // ---- x0 = (e1,e2) and its 4 known basis partners (verified below)
    var x0 = [0; 16]
    x0[1] = 1
    x0[10] = 1
    var urow = [0; 160]
    var c0 = 0
    while c0 < 16 { urow[c0 as usize] = x0[c0 as usize]; c0 = c0 + 1 }
    // partners: (e4,-e7),(e5,+e6),(e6,-e5),(e7,+e4)
    var plo = [4, 5, 6, 7]
    var phi = [7, 6, 5, 4]
    var psg = [0 - 1, 1, 0 - 1, 1]
    var g = 0
    var u_ok = 1
    while g < 4 {
        var pv = [0; 16]
        pv[plo[g as usize] as usize] = 1
        pv[(8 + phi[g as usize]) as usize] = psg[g as usize]
        if !annihilates_both(&x0, &pv) { u_ok = 0 }
        var c1 = 0
        while c1 < 16 { urow[((g + 1) * 16 + c1) as usize] = pv[c1 as usize]; c1 = c1 + 1 }
        g = g + 1
    }
    print("U_FRAME ")
    if u_ok == 1 { println("OK") } else { println("FAIL") }

    // ---- sweep
    let n_pairs = 60
    var d1 = 0
    var d2 = 0
    var w1 = 0
    var w2 = 0
    var w3 = 0
    var unres = 0
    var skip = 0
    var formula_fail = 0
    var made = 0
    var seed = 987654321
    var attempts = 0
    var hist_all = [0; 17]
    var hist_unres = [0; 17]
    var hist44 = [0; 17]
    var wfloat = 0
    var cand_d4 = 0

    while made < n_pairs && attempts < 40000 {
        attempts = attempts + 1
        // sample a: pure, <=2 nonzero entries in {-1,1}
        var a8 = [0; 8]
        seed = lehmer_next(seed)
        let i1 = 1 + (seed % 7)
        seed = lehmer_next(seed)
        let i2 = 1 + (seed % 7)
        seed = lehmer_next(seed)
        a8[i1 as usize] = if (seed % 2) == 0 { 1 } else { 0 - 1 }
        seed = lehmer_next(seed)
        if i2 != i1 && (seed % 3) != 0 {
            seed = lehmer_next(seed)
            a8[i2 as usize] = if (seed % 2) == 0 { 1 } else { 0 - 1 }
        }
        // sample raw t0: pure, entries in {-1,0,1}
        var t0 = [0; 8]
        var q = 1
        while q < 8 {
            seed = lehmer_next(seed)
            let r3 = seed % 3
            t0[q as usize] = if r3 == 0 { 0 } else { if r3 == 1 { 1 } else { 0 - 1 } }
            q = q + 1
        }
        // project t0 perp to a: tp = n(a) t0 - <t0,a> a
        var na = 0
        var dta = 0
        q = 0
        while q < 8 {
            na = na + a8[q as usize] * a8[q as usize]
            dta = dta + t0[q as usize] * a8[q as usize]
            q = q + 1
        }
        if na == 0 { } else {
            var tp = [0; 8]
            var nz = 0
            q = 0
            while q < 8 {
                tp[q as usize] = na * t0[q as usize] - dta * a8[q as usize]
                if tp[q as usize] != 0 { nz = 1 }
                q = q + 1
            }
            if nz == 1 {
                var gg = 0
                q = 0
                while q < 8 { gg = gcd_i(gg, tp[q as usize]); q = q + 1 }
                if gg > 1 {
                    q = 0
                    while q < 8 { tp[q as usize] = tp[q as usize] / gg; q = q + 1 }
                }
                var ntp = 0
                q = 0
                while q < 8 { ntp = ntp + tp[q as usize] * tp[q as usize]; q = q + 1 }
                let kk = isqrt_exact(ntp)
                if kk > 0 {
                    // x' = (kk * a, a * tp)
                    var b8 = [0; 8]
                    omul_i(&a8, &tp, &!b8)
                    var xp = [0; 16]
                    q = 0
                    while q < 8 {
                        xp[q as usize] = kk * a8[q as usize]
                        xp[(8 + q) as usize] = b8[q as usize]
                        q = q + 1
                    }
                    // skip if same line as x0 (only when xp is scalar multiple)
                    // frame: z = A * B (octonion), c-basis of {1,A,B,z}-perp
                    var arow8 = [0; 8]
                    q = 0
                    while q < 8 { arow8[q as usize] = xp[q as usize]; q = q + 1 }
                    var brow8 = [0; 8]
                    q = 0
                    while q < 8 { brow8[q as usize] = xp[(8 + q) as usize]; q = q + 1 }
                    var z8 = [0; 8]
                    omul_i(&arow8, &brow8, &!z8)
                    var cb = [0; 32]
                    let nc = perp_basis(&arow8, &brow8, &z8, &!cb)
                    if nc != 4 {
                        skip = skip + 1
                    } else {
                        // V frame: x' + partners (N c_j, c_j z), N = n(A)
                        var nA = 0
                        q = 0
                        while q < 8 { nA = nA + arow8[q as usize] * arow8[q as usize]; q = q + 1 }
                        var vrow = [0; 160]
                        q = 0
                        while q < 16 { vrow[q as usize] = xp[q as usize]; q = q + 1 }
                        var all_ok = 1
                        var gj = 0
                        while gj < 4 {
                            var cj = [0; 8]
                            var c6 = 0
                            while c6 < 8 { cj[c6 as usize] = cb[(gj * 8 + c6) as usize]; c6 = c6 + 1 }
                            var dj = [0; 8]
                            omul_i(&cj, &z8, &!dj)
                            var cand = [0; 16]
                            c6 = 0
                            while c6 < 8 {
                                cand[c6 as usize] = nA * cj[c6 as usize]
                                cand[(8 + c6) as usize] = dj[c6 as usize]
                                c6 = c6 + 1
                            }
                            var okg = annihilates_both(&xp, &cand)
                            if !okg {
                                // variant: negate second half
                                c6 = 0
                                while c6 < 8 { cand[(8 + c6) as usize] = 0 - dj[c6 as usize]; c6 = c6 + 1 }
                                okg = annihilates_both(&xp, &cand)
                            }
                            if okg {
                                // gcd-reduce the generator
                                var g3 = 0
                                c6 = 0
                                while c6 < 16 { g3 = gcd_i(g3, cand[c6 as usize]); c6 = c6 + 1 }
                                if g3 > 1 {
                                    c6 = 0
                                    while c6 < 16 { cand[c6 as usize] = cand[c6 as usize] / g3; c6 = c6 + 1 }
                                }
                                c6 = 0
                                while c6 < 16 {
                                    vrow[((gj + 1) * 16 + c6) as usize] = cand[c6 as usize]
                                    c6 = c6 + 1
                                }
                            } else {
                                all_ok = 0
                            }
                            gj = gj + 1
                        }
                        if all_ok == 0 {
                            formula_fail = formula_fail + 1
                            skip = skip + 1
                        } else {
                            made = made + 1
                            if comm_is_zero(&x0, &xp) {
                                d1 = d1 + 1
                            } else {
                                var stack = [0; 160]
                                var s0 = 0
                                while s0 < 80 { stack[s0 as usize] = urow[s0 as usize]; s0 = s0 + 1 }
                                s0 = 0
                                while s0 < 80 { stack[(80 + s0) as usize] = vrow[s0 as usize]; s0 = s0 + 1 }
                                let r1 = rank_mod_p(&stack, 10, 2147483647)
                                var isd2 = 0
                                if r1 < 10 {
                                    let r2 = rank_mod_p(&stack, 10, 2147483629)
                                    if r2 < 10 { isd2 = 1 }
                                }
                                if isd2 == 1 {
                                    d2 = d2 + 1
                                } else {
                                    // rank(T) structural probe over the full 5x5 frame
                                    var tten = [0; 400]
                                    var it2 = 0
                                    while it2 < 5 {
                                        var uu2 = [0; 16]
                                        var cz = 0
                                        while cz < 16 { uu2[cz as usize] = urow[(it2 * 16 + cz) as usize]; cz = cz + 1 }
                                        var jt2 = 0
                                        while jt2 < 5 {
                                            var ww2 = [0; 16]
                                            cz = 0
                                            while cz < 16 { ww2[cz as usize] = vrow[(jt2 * 16 + cz) as usize]; cz = cz + 1 }
                                            var pa2 = [0; 16]
                                            var pb2 = [0; 16]
                                            smul_i(&uu2, &ww2, &!pa2)
                                            smul_i(&ww2, &uu2, &!pb2)
                                            cz = 0
                                            while cz < 16 {
                                                tten[(cz * 25 + it2 * 5 + jt2) as usize] = pa2[cz as usize] - pb2[cz as usize]
                                                cz = cz + 1
                                            }
                                            jt2 = jt2 + 1
                                        }
                                        it2 = it2 + 1
                                    }
                                    let rkt = rank_t_mod_p(&tten, 2147483647)
                                    hist_all[rkt as usize] = hist_all[rkt as usize] + 1
                                    let rkt44 = rank_t44_mod_p(&tten, 2147483647)
                                    hist44[rkt44 as usize] = hist44[rkt44 as usize] + 1
                                    let lvl = exact_combo_witness3(&urow, &vrow)
                                    if lvl == 1 { w1 = w1 + 1 }
                                    else if lvl == 2 { w2 = w2 + 1 }
                                    else if lvl == 3 { w3 = w3 + 1 }
                                    else {
                                        unres = unres + 1
                                        hist_unres[rkt as usize] = hist_unres[rkt as usize] + 1
                                        // f64 triage: continuous witness or d=4 candidate?
                                        var cten = [0.0; 400]
                                        var maxa = 0.0
                                        var ci = 0
                                        while ci < 400 {
                                            let av = fabs_(tten[ci as usize] as f64)
                                            if av > maxa { maxa = av }
                                            ci = ci + 1
                                        }
                                        if maxa < 1e-300 { maxa = 1.0 }
                                        ci = 0
                                        while ci < 400 { cten[ci as usize] = (tten[ci as usize] as f64) / maxa; ci = ci + 1 }
                                        var bestr = 1e9
                                        var rs = 0
                                        var sd2 = 55555 + made * 7919
                                        while rs < 40 && bestr > 1e-12 {
                                            sd2 = lehmer_next(sd2 + rs)
                                            let rr2 = hunt_once(&cten, sd2, 60, 50, 0)
                                            if rr2 < bestr { bestr = rr2 }
                                            rs = rs + 1
                                        }
                                        while rs < 160 && bestr > 1e-9 {
                                            sd2 = lehmer_next(sd2 + rs)
                                            let rr2 = hunt_once(&cten, sd2, 120, 80, 1)
                                            if rr2 < bestr { bestr = rr2 }
                                            rs = rs + 1
                                        }
                                        while rs < 300 && bestr > 1e-9 {
                                            sd2 = lehmer_next(sd2 + rs)
                                            let rr2 = hunt_once(&cten, sd2, 150, 80, 0)
                                            if rr2 < bestr { bestr = rr2 }
                                            rs = rs + 1
                                        }
                                        if bestr < 1e-9 {
                                            wfloat = wfloat + 1
                                        } else {
                                            cand_d4 = cand_d4 + 1
                                            print("CAND_D4 pair#")
                                            print_int(made)
                                            print(" res ")
                                            println(bestr)
                                            print("  A=[")
                                            var pz = 0
                                            while pz < 8 { print_int(xp[pz as usize]); print(" "); pz = pz + 1 }
                                            print("] B=[")
                                            pz = 0
                                            while pz < 8 { print_int(xp[(8 + pz) as usize]); print(" "); pz = pz + 1 }
                                            print("]\n")
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    print("SWEEP ")
    print_int(made)
    print("  D1 ")
    print_int(d1)
    print(" D2 ")
    print_int(d2)
    print(" W1 ")
    print_int(w1)
    print(" W2 ")
    print_int(w2)
    print(" W3 ")
    print_int(w3)
    print(" UNRES ")
    print_int(unres)
    print(" SKIP ")
    print_int(skip)
    print(" FORMULA_FAIL ")
    print_int(formula_fail)
    print("\n")
    print("WFLOAT ")
    print_int(wfloat)
    print(" CAND_D4 ")
    print_int(cand_d4)
    print("\n")
    var hr = 0
    while hr < 17 {
        if hist_all[hr as usize] > 0 {
            print("RANKT ")
            print_int(hr)
            print(" ALL ")
            print_int(hist_all[hr as usize])
            print(" UNRES ")
            print_int(hist_unres[hr as usize])
            print("\n")
        }
        hr = hr + 1
    }
    hr = 0
    while hr < 17 {
        if hist44[hr as usize] > 0 {
            print("RANKT44 ")
            print_int(hr)
            print(" N ")
            print_int(hist44[hr as usize])
            print("\n")
        }
        hr = hr + 1
    }
    if made == n_pairs && u_ok == 1 {
        println("CONJ68_RATIONAL_SWEEP DONE")
    } else {
        println("CONJ68_RATIONAL_SWEEP INCOMPLETE")
    }
}
