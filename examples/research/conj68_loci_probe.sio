// Conjecture 6.8 — DEGENERACY LOCUS probe (route alpha lapidacao, R12).
//
// The rank-7 bundle E7 = W11 ∩ span{Pu, Pw, P[u,w,w], P[w,u,u]}⊥ is honest
// exactly where the 9-row stack
//     { e0, x, x~, x', x~',  u, w, [u,w,w], [w,u,u] }
// has rank 9 (then the four constraint projections into W11 are independent).
// Hypothesis to test: over real configurations, the rank drops ONLY on
//     Z1 = {[u] = [x]},   Z2 = {[w] = [x']}
// (plus possibly lower strata inside them).  Measurement:
//   * canonical x = (e1,e2), random integer ZD x' (rank-9 generic filter off:
//     all pairs), u/w random integer combos of the verified 5-frames;
//   * rank of the 9x16 stack mod two primes (rank 9 mod p PROVES exact 9);
//   * targeted degenerate points: u = x (expect drop), w = x', both;
//   * histogram of ranks + drop diagnostics (is u || x or w || x' when < 9?).

fn cd_sigma_c(a: i64, b: i64, bits: i64) -> i64 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_c(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_c(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_c(a_lo, 0, bits - 1) }
        return 0 - cd_sigma_c(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma_c(0, a_lo, bits - 1) }
    cd_sigma_c(b_lo, a_lo, bits - 1)
}

fn sed_sigma(a: i64, b: i64) -> i64 with Mut, Panic, Div { cd_sigma_c(a, b, 4) }

fn smul_i(x: &[i64; 16], y: &[i64; 16], out: &![i64; 16]) with Mut, Panic, Div {
    var k = 0
    while k < 16 { out[k as usize] = 0; k = k + 1 }
    var i = 0
    while i < 16 {
        if x[i as usize] != 0 {
            var j = 0
            while j < 16 {
                if y[j as usize] != 0 {
                    let t = i ^ j
                    out[t as usize] = out[t as usize] + sed_sigma(i, j) * x[i as usize] * y[j as usize]
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

fn omul_i(x: &[i64; 8], y: &[i64; 8], out: &![i64; 8]) with Mut, Panic, Div {
    var k = 0
    while k < 8 { out[k as usize] = 0; k = k + 1 }
    var i = 0
    while i < 8 {
        if x[i as usize] != 0 {
            var j = 0
            while j < 8 {
                if y[j as usize] != 0 {
                    let t = i ^ j
                    out[t as usize] = out[t as usize] + sed_sigma(i, j) * x[i as usize] * y[j as usize]
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

fn is_zero16(v: &[i64; 16]) -> bool with Mut {
    var k = 0
    while k < 16 {
        if v[k as usize] != 0 { return false }
        k = k + 1
    }
    true
}

fn annihilates_both(x: &[i64; 16], y: &[i64; 16]) -> bool with Mut, Panic, Div {
    var p = [0; 16]
    smul_i(x, y, &!p)
    if !is_zero16(&p) { return false }
    smul_i(y, x, &!p)
    is_zero16(&p)
}

fn gcd_i(a0: i64, b0: i64) -> i64 with Mut, Div, Panic {
    var a = if a0 < 0 { 0 - a0 } else { a0 }
    var b = if b0 < 0 { 0 - b0 } else { b0 }
    while b != 0 {
        let t = a % b
        a = b
        b = t
    }
    a
}

fn isqrt_exact(n: i64) -> i64 with Mut, Div, Panic {
    if n < 0 { return 0 - 1 }
    var k = 0
    while k * k < n { k = k + 1 }
    if k * k == n { k } else { 0 - 1 }
}

fn lehmer_next(state: i64) -> i64 with Mut, Div, Panic {
    (state * 48271) % 2147483647
}

fn perp_basis3(r1: &[i64; 8], r2: &[i64; 8], r3: &[i64; 8], out: &![i64; 32]) -> i64 with Mut, Panic, Div {
    var m = [0; 21]
    var c = 0
    while c < 7 {
        m[c as usize] = r1[(c + 1) as usize]
        m[(7 + c) as usize] = r2[(c + 1) as usize]
        m[(14 + c) as usize] = r3[(c + 1) as usize]
        c = c + 1
    }
    var piv_col = [0; 3]
    var rank = 0
    var col = 0
    while col < 7 && rank < 3 {
        var pr = 0 - 1
        var r = rank
        while r < 3 {
            if m[(r * 7 + col) as usize] != 0 { pr = r; r = 3 } else { r = r + 1 }
        }
        if pr >= 0 {
            if pr != rank {
                var c1 = 0
                while c1 < 7 {
                    let t = m[(rank * 7 + c1) as usize]
                    m[(rank * 7 + c1) as usize] = m[(pr * 7 + c1) as usize]
                    m[(pr * 7 + c1) as usize] = t
                    c1 = c1 + 1
                }
            }
            let piv = m[(rank * 7 + col) as usize]
            var r2i = 0
            while r2i < 3 {
                if r2i != rank {
                    let f = m[(r2i * 7 + col) as usize]
                    if f != 0 {
                        var c2 = 0
                        while c2 < 7 {
                            m[(r2i * 7 + c2) as usize] = piv * m[(r2i * 7 + c2) as usize] - f * m[(rank * 7 + c2) as usize]
                            c2 = c2 + 1
                        }
                        var g = 0
                        var c3 = 0
                        while c3 < 7 { g = gcd_i(g, m[(r2i * 7 + c3) as usize]); c3 = c3 + 1 }
                        var gd = 1
                        if g > 1 { gd = g }
                        if gd > 1 {
                            c3 = 0
                            while c3 < 7 { m[(r2i * 7 + c3) as usize] = m[(r2i * 7 + c3) as usize] / gd; c3 = c3 + 1 }
                        }
                    }
                }
                r2i = r2i + 1
            }
            piv_col[rank as usize] = col
            rank = rank + 1
        }
        col = col + 1
    }
    var nout = 0
    var fc = 0
    while fc < 7 {
        var isp = 0
        var q = 0
        while q < rank {
            if piv_col[q as usize] == fc { isp = 1 }
            q = q + 1
        }
        if isp == 0 && nout < 4 {
            var v = [0; 8]
            var prodp = 1
            q = 0
            while q < rank { prodp = prodp * m[(q * 7 + piv_col[q as usize]) as usize]; q = q + 1 }
            v[(fc + 1) as usize] = prodp
            q = 0
            while q < rank {
                let pc = piv_col[q as usize]
                var piv = 1
                if m[(q * 7 + pc) as usize] != 0 { piv = m[(q * 7 + pc) as usize] }
                v[(pc + 1) as usize] = (0 - m[(q * 7 + fc) as usize]) * (prodp / piv)
                q = q + 1
            }
            var g2 = 0
            var c4 = 0
            while c4 < 8 { g2 = gcd_i(g2, v[c4 as usize]); c4 = c4 + 1 }
            var g2d = 1
            if g2 > 1 { g2d = g2 }
            if g2d > 1 {
                c4 = 0
                while c4 < 8 { v[c4 as usize] = v[c4 as usize] / g2d; c4 = c4 + 1 }
            }
            c4 = 0
            while c4 < 8 { out[(nout * 8 + c4) as usize] = v[c4 as usize]; c4 = c4 + 1 }
            nout = nout + 1
        }
        fc = fc + 1
    }
    nout
}

fn build_o_frame(xp: &[i64; 16], grows: &![i64; 64]) -> i64 with Mut, Panic, Div {
    var arow8 = [0; 8]
    var brow8 = [0; 8]
    var q = 0
    while q < 8 {
        arow8[q as usize] = xp[q as usize]
        brow8[q as usize] = xp[(8 + q) as usize]
        q = q + 1
    }
    var z8 = [0; 8]
    omul_i(&arow8, &brow8, &!z8)
    var cb = [0; 32]
    let nc = perp_basis3(&arow8, &brow8, &z8, &!cb)
    if nc != 4 { return 0 }
    var nA = 0
    q = 0
    while q < 8 { nA = nA + arow8[q as usize] * arow8[q as usize]; q = q + 1 }
    var gj = 0
    while gj < 4 {
        var cj = [0; 8]
        var c6 = 0
        while c6 < 8 { cj[c6 as usize] = cb[(gj * 8 + c6) as usize]; c6 = c6 + 1 }
        var dj = [0; 8]
        omul_i(&cj, &z8, &!dj)
        var cand = [0; 16]
        c6 = 0
        while c6 < 8 {
            cand[c6 as usize] = nA * cj[c6 as usize]
            cand[(8 + c6) as usize] = dj[c6 as usize]
            c6 = c6 + 1
        }
        var okg = annihilates_both(xp, &cand)
        if !okg {
            c6 = 0
            while c6 < 8 { cand[(8 + c6) as usize] = 0 - dj[c6 as usize]; c6 = c6 + 1 }
            okg = annihilates_both(xp, &cand)
        }
        if !okg { return 0 }
        var g3 = 0
        c6 = 0
        while c6 < 16 { g3 = gcd_i(g3, cand[c6 as usize]); c6 = c6 + 1 }
        var g3d = 1
        if g3 > 1 { g3d = g3 }
        if g3d > 1 {
            c6 = 0
            while c6 < 16 { cand[c6 as usize] = cand[c6 as usize] / g3d; c6 = c6 + 1 }
        }
        c6 = 0
        while c6 < 16 { grows[(gj * 16 + c6) as usize] = cand[c6 as usize]; c6 = c6 + 1 }
        gj = gj + 1
    }
    1
}

fn sample_zd(seed_in: i64, xp: &![i64; 16], seed_out: &![i64; 1]) -> i64 with Mut, Panic, Div {
    var seed = seed_in
    var a8 = [0; 8]
    seed = lehmer_next(seed)
    let i1 = 1 + (seed % 7)
    seed = lehmer_next(seed)
    let i2 = 1 + (seed % 7)
    seed = lehmer_next(seed)
    a8[i1 as usize] = if (seed % 2) == 0 { 1 } else { 0 - 1 }
    seed = lehmer_next(seed)
    if i2 != i1 && (seed % 3) != 0 {
        seed = lehmer_next(seed)
        a8[i2 as usize] = if (seed % 2) == 0 { 1 } else { 0 - 1 }
    }
    var t0 = [0; 8]
    var q = 1
    while q < 8 {
        seed = lehmer_next(seed)
        let r3 = seed % 3
        t0[q as usize] = if r3 == 0 { 0 } else { if r3 == 1 { 1 } else { 0 - 1 } }
        q = q + 1
    }
    seed_out[0] = seed
    var na = 0
    var dta = 0
    q = 0
    while q < 8 {
        na = na + a8[q as usize] * a8[q as usize]
        dta = dta + t0[q as usize] * a8[q as usize]
        q = q + 1
    }
    if na == 0 { return 0 }
    var tp = [0; 8]
    var nz = 0
    q = 0
    while q < 8 {
        tp[q as usize] = na * t0[q as usize] - dta * a8[q as usize]
        if tp[q as usize] != 0 { nz = 1 }
        q = q + 1
    }
    if nz == 0 { return 0 }
    var gg = 0
    q = 0
    while q < 8 { gg = gcd_i(gg, tp[q as usize]); q = q + 1 }
    var ggd = 1
    if gg > 1 { ggd = gg }
    if ggd > 1 {
        q = 0
        while q < 8 { tp[q as usize] = tp[q as usize] / ggd; q = q + 1 }
    }
    var ntp = 0
    q = 0
    while q < 8 { ntp = ntp + tp[q as usize] * tp[q as usize]; q = q + 1 }
    let kk = isqrt_exact(ntp)
    if kk <= 0 { return 0 }
    var b8 = [0; 8]
    omul_i(&a8, &tp, &!b8)
    q = 0
    while q < 8 {
        xp[q as usize] = kk * a8[q as usize]
        xp[(8 + q) as usize] = b8[q as usize]
        q = q + 1
    }
    1
}

fn modp(v: i64, p: i64) -> i64 with Mut, Div, Panic {
    var r = v % p
    if r < 0 { r = r + p }
    r
}

fn inv_mod(a: i64, p: i64) -> i64 with Mut, Div, Panic {
    var inv = 1
    var base = modp(a, p)
    var e = p - 2
    while e > 0 {
        if (e % 2) == 1 { inv = (inv * base) % p }
        base = (base * base) % p
        e = e / 2
    }
    inv
}

// rank of r x 16 mod p, r <= 9 (flat 144)
fn rank9_mod_p(rows_in: &[i64; 144], nrows: i64, p: i64) -> i64 with Mut, Panic, Div {
    var m = [0; 144]
    var i = 0
    while i < nrows * 16 { m[i as usize] = modp(rows_in[i as usize], p); i = i + 1 }
    var rank = 0
    var col = 0
    while col < 16 && rank < nrows {
        var pr = 0 - 1
        var r = rank
        while r < nrows {
            if m[(r * 16 + col) as usize] != 0 { pr = r; r = nrows } else { r = r + 1 }
        }
        if pr >= 0 {
            if pr != rank {
                var c = 0
                while c < 16 {
                    let t = m[(rank * 16 + c) as usize]
                    m[(rank * 16 + c) as usize] = m[(pr * 16 + c) as usize]
                    m[(pr * 16 + c) as usize] = t
                    c = c + 1
                }
            }
            let iv = inv_mod(m[(rank * 16 + col) as usize], p)
            var r2 = rank + 1
            while r2 < nrows {
                let f = (m[(r2 * 16 + col) as usize] * iv) % p
                if f != 0 {
                    var c2 = 0
                    while c2 < 16 {
                        m[(r2 * 16 + c2) as usize] = modp(m[(r2 * 16 + c2) as usize] - (f * m[(rank * 16 + c2) as usize]) % p, p)
                        c2 = c2 + 1
                    }
                }
                r2 = r2 + 1
            }
            rank = rank + 1
        }
        col = col + 1
    }
    rank
}

fn main() with IO, Mut, Panic, Div {
    var x1 = [0; 16]
    x1[1] = 1
    x1[10] = 1
    var g1 = [0; 64]
    if build_o_frame(&x1, &!g1) == 0 { println("X1 FAIL"); return }
    // x~ = (e2, -e1) = e2 - e9 ; e0
    var xt1 = [0; 16]
    xt1[2] = 1
    xt1[9] = 0 - 1

    var seed = 24681357
    var npairs = 0
    var trial = 0
    var hist = [0; 10]
    var drop_par = 0      // drops where u ~ x or w ~ x'
    var drop_other = 0
    var targeted_ok = 1
    while trial < 4000 && npairs < 40 {
        trial = trial + 1
        var x2 = [0; 16]
        var so = [0; 1]
        let ok2 = sample_zd(seed, &!x2, &!so)
        seed = so[0]
        if ok2 == 1 {
            var g2 = [0; 64]
            if build_o_frame(&x2, &!g2) == 1 {
                npairs = npairs + 1
                // x~' = (B', -A')
                var xt2 = [0; 16]
                var q = 0
                while q < 8 {
                    xt2[q as usize] = x2[(8 + q) as usize]
                    xt2[(8 + q) as usize] = 0 - x2[q as usize]
                    q = q + 1
                }
                // sample many (u,w) for this pair, including targeted u=x / w=x'
                var samp = 0
                while samp < 60 {
                    var u16 = [0; 16]
                    var w16 = [0; 16]
                    var upar = 0
                    var wpar = 0
                    if samp == 0 {
                        // u = x targeted
                        var q2 = 0
                        while q2 < 16 { u16[q2 as usize] = x1[q2 as usize]; q2 = q2 + 1 }
                        upar = 1
                    } else {
                        // random combo of x1 + gens
                        var cu0 = 0
                        seed = lehmer_next(seed)
                        cu0 = (seed % 5) - 2
                        var q2 = 0
                        while q2 < 16 { u16[q2 as usize] = cu0 * x1[q2 as usize]; q2 = q2 + 1 }
                        var gi = 0
                        var any = 0
                        while gi < 4 {
                            seed = lehmer_next(seed)
                            let cg = (seed % 5) - 2
                            if cg != 0 { any = 1 }
                            q2 = 0
                            while q2 < 16 { u16[q2 as usize] = u16[q2 as usize] + cg * g1[(gi * 16 + q2) as usize]; q2 = q2 + 1 }
                            gi = gi + 1
                        }
                        if any == 0 { upar = 1 }
                    }
                    if samp == 1 {
                        var q3 = 0
                        while q3 < 16 { w16[q3 as usize] = x2[q3 as usize]; q3 = q3 + 1 }
                        wpar = 1
                    } else {
                        var cw0 = 0
                        seed = lehmer_next(seed)
                        cw0 = (seed % 5) - 2
                        var q3 = 0
                        while q3 < 16 { w16[q3 as usize] = cw0 * x2[q3 as usize]; q3 = q3 + 1 }
                        var gj = 0
                        var anyw = 0
                        while gj < 4 {
                            seed = lehmer_next(seed)
                            let cg2 = (seed % 5) - 2
                            if cg2 != 0 { anyw = 1 }
                            q3 = 0
                            while q3 < 16 { w16[q3 as usize] = w16[q3 as usize] + cg2 * g2[(gj * 16 + q3) as usize]; q3 = q3 + 1 }
                            gj = gj + 1
                        }
                        if anyw == 0 { wpar = 1 }
                    }
                    if !is_zero16(&u16) && !is_zero16(&w16) {
                        // A1 = [u,w,w], A2 = [w,u,u]
                        var uw = [0; 16]
                        smul_i(&u16, &w16, &!uw)
                        var uww = [0; 16]
                        smul_i(&uw, &w16, &!uww)
                        var ww = [0; 16]
                        smul_i(&w16, &w16, &!ww)
                        var uww2 = [0; 16]
                        smul_i(&u16, &ww, &!uww2)
                        var wu = [0; 16]
                        smul_i(&w16, &u16, &!wu)
                        var wuu = [0; 16]
                        smul_i(&wu, &u16, &!wuu)
                        var uu = [0; 16]
                        smul_i(&u16, &u16, &!uu)
                        var wuu2 = [0; 16]
                        smul_i(&w16, &uu, &!wuu2)
                        var stack = [0; 144]
                        var q4 = 0
                        while q4 < 16 {
                            stack[q4 as usize] = if q4 == 0 { 1 } else { 0 }          // e0
                            stack[(16 + q4) as usize] = x1[q4 as usize]
                            stack[(32 + q4) as usize] = xt1[q4 as usize]
                            stack[(48 + q4) as usize] = x2[q4 as usize]
                            stack[(64 + q4) as usize] = xt2[q4 as usize]
                            stack[(80 + q4) as usize] = u16[q4 as usize]
                            stack[(96 + q4) as usize] = w16[q4 as usize]
                            stack[(112 + q4) as usize] = uww[q4 as usize] - uww2[q4 as usize]
                            stack[(128 + q4) as usize] = wuu[q4 as usize] - wuu2[q4 as usize]
                            q4 = q4 + 1
                        }
                        var rk = rank9_mod_p(&stack, 9, 2147483647)
                        if rk < 9 {
                            let rk2 = rank9_mod_p(&stack, 9, 2147483629)
                            if rk2 > rk { rk = rk2 }
                        }
                        hist[rk as usize] = hist[rk as usize] + 1
                        if rk < 9 {
                            if upar == 1 || wpar == 1 {
                                drop_par = drop_par + 1
                                if samp <= 1 && rk == 8 { } else { }
                            } else {
                                drop_other = drop_other + 1
                                print("DROP_OTHER pair#")
                                print_int(npairs)
                                print(" samp ")
                                print_int(samp)
                                print(" rank ")
                                print_int(rk)
                                print("\n")
                            }
                        }
                        if samp <= 1 && rk == 9 { targeted_ok = 0 }
                    }
                    samp = samp + 1
                }
            }
        }
    }
    print("PAIRS ")
    print_int(npairs)
    print("\n")
    var hh = 0
    while hh < 10 {
        if hist[hh as usize] > 0 {
            print("RANK9_HIST ")
            print_int(hh)
            print(" N ")
            print_int(hist[hh as usize])
            print("\n")
        }
        hh = hh + 1
    }
    print("DROPS: at_parallel ")
    print_int(drop_par)
    print("  other ")
    print_int(drop_other)
    print("\n")
    print("TARGETED_DEGENERATE ")
    if targeted_ok == 1 { println("CONFIRMED") } else { println("UNEXPECTED_FULLRANK") }
    println("CONJ68_LOCI_PROBE DONE")
}
