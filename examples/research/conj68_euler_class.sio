// Conjecture 6.8 — THE EULER CLASS COMPUTATION (route alpha, attack log R8+).
//
// Pointwise relations of the commutator section, each with a one-line proof:
//   (P1) T(u,w) ⊥ u        (phi alternating: antisymmetric + cyclic)
//   (P2) T(u,w) ⊥ w        (same)
//   (P3) T(u,w) ⊥ u∘w      (wu = conj(uw) for pure u,w ⟹ n(uw) = n(wu))
// plus the 4 proven LINEAR relations (x, x~, x', x~') and e0: the section
// s(u,w) = T(u,w) lives in a rank-8 real bundle E over RP4 x RP4 (dim 8):
//   E ≅ R^11 ⊖ gamma1 ⊖ gamma2 ⊖ gamma1·gamma2   (K-theory class),
// and s is bilinear, i.e. a section of E ⊗ (gamma1 gamma2).
// A nowhere-zero section would force the twisted top Stiefel-Whitney class
//   e = sum_i w_i(E) c^{8-i},  c = w1(gamma1 gamma2) = alpha + beta,
// to vanish on the fundamental class alpha^4 beta^4 of
//   H*(RP4 x RP4; Z/2) = Z/2[alpha,beta]/(alpha^5, beta^5).
// So:  coefficient of alpha^4 beta^4 in e  != 0
//      ⟹ EVERY configuration's section has a zero
//      ⟹ d(x,x') <= 3 for all pairs  (modulo degeneracy-loci care)
//      ⟹ Conjecture 6.8.
// This program computes that coefficient exactly in Z/2.
//
// w(E) = [(1+alpha)(1+beta)(1+alpha+beta)]^{-1} in the truncated ring.
// Polynomials are 5x5 Z/2 coefficient grids p[i][j] = coeff of alpha^i beta^j.

fn pmul(p: &[i64; 25], q: &[i64; 25], out: &![i64; 25]) with Mut, Panic, Div {
    var k = 0
    while k < 25 { out[k as usize] = 0; k = k + 1 }
    var i = 0
    while i < 5 {
        var j = 0
        while j < 5 {
            if p[(i * 5 + j) as usize] == 1 {
                var a = 0
                while a < 5 {
                    var b = 0
                    while b < 5 {
                        if q[(a * 5 + b) as usize] == 1 {
                            let di = i + a
                            let dj = j + b
                            if di < 5 && dj < 5 {
                                out[(di * 5 + dj) as usize] = 1 - out[(di * 5 + dj) as usize]
                            }
                        }
                        b = b + 1
                    }
                    a = a + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn padd(p: &[i64; 25], q: &[i64; 25], out: &![i64; 25]) with Mut {
    var k = 0
    while k < 25 {
        out[k as usize] = (p[k as usize] + q[k as usize]) % 2
        k = k + 1
    }
}

fn main() with IO, Mut, Panic, Div {
    // D = (1+alpha)(1+beta)(1+alpha+beta)
    var one = [0; 25]
    one[0] = 1
    var f1 = [0; 25]        // 1 + alpha
    f1[0] = 1
    f1[5] = 1
    var f2 = [0; 25]        // 1 + beta
    f2[0] = 1
    f2[1] = 1
    var f3 = [0; 25]        // 1 + alpha + beta
    f3[0] = 1
    f3[5] = 1
    f3[1] = 1
    var t12 = [0; 25]
    pmul(&f1, &f2, &!t12)
    var d = [0; 25]
    pmul(&t12, &f3, &!d)
    // invert D = 1 + N: Dinv = 1 + N + N^2 + ... (N nilpotent in truncation)
    var nmat = [0; 25]
    padd(&d, &one, &!nmat)     // N = D - 1
    var dinv = [0; 25]
    dinv[0] = 1
    var npow = [0; 25]
    var k0 = 0
    while k0 < 25 { npow[k0 as usize] = nmat[k0 as usize]; k0 = k0 + 1 }
    var it = 0
    while it < 10 {
        var tmp = [0; 25]
        padd(&dinv, &npow, &!tmp)
        k0 = 0
        while k0 < 25 { dinv[k0 as usize] = tmp[k0 as usize]; k0 = k0 + 1 }
        var np2 = [0; 25]
        pmul(&npow, &nmat, &!np2)
        k0 = 0
        while k0 < 25 { npow[k0 as usize] = np2[k0 as usize]; k0 = k0 + 1 }
        it = it + 1
    }
    // sanity: D * Dinv == 1
    var chk = [0; 25]
    pmul(&d, &dinv, &!chk)
    var ok = 1
    k0 = 0
    while k0 < 25 {
        let want = if k0 == 0 { 1 } else { 0 }
        if chk[k0 as usize] != want { ok = 0 }
        k0 = k0 + 1
    }
    print("INVERSE_CHECK ")
    if ok == 1 { println("OK") } else { println("FAIL") }

    // w(E) = Dinv; w_i(E) = total-degree-i part.
    // c = alpha + beta; e = sum_{i=0}^{8} w_i(E) * c^{8-i}
    var cpol = [0; 25]
    cpol[5] = 1
    cpol[1] = 1
    // cpow[t] = c^t, t = 0..8
    var e = [0; 25]
    var i2 = 0
    while i2 <= 8 {
        // w_i part
        var wi = [0; 25]
        var a = 0
        while a < 5 {
            var b = 0
            while b < 5 {
                if a + b == i2 { wi[(a * 5 + b) as usize] = dinv[(a * 5 + b) as usize] }
                b = b + 1
            }
            a = a + 1
        }
        // c^(8-i)
        var cp = [0; 25]
        cp[0] = 1
        var t = 0
        while t < 8 - i2 {
            var cp2 = [0; 25]
            pmul(&cp, &cpol, &!cp2)
            var k1 = 0
            while k1 < 25 { cp[k1 as usize] = cp2[k1 as usize]; k1 = k1 + 1 }
            t = t + 1
        }
        var term = [0; 25]
        pmul(&wi, &cp, &!term)
        var e2 = [0; 25]
        padd(&e, &term, &!e2)
        var k2 = 0
        while k2 < 25 { e[k2 as usize] = e2[k2 as usize]; k2 = k2 + 1 }
        i2 = i2 + 1
    }
    // report w_i(E) coefficients (total degree i parts of Dinv) for the record
    var i3 = 0
    while i3 <= 8 {
        print("W")
        print_int(i3)
        print(":")
        var a3 = 0
        while a3 < 5 {
            var b3 = 0
            while b3 < 5 {
                if a3 + b3 == i3 && dinv[(a3 * 5 + b3) as usize] == 1 {
                    print(" a")
                    print_int(a3)
                    print("b")
                    print_int(b3)
                }
                b3 = b3 + 1
            }
            a3 = a3 + 1
        }
        print("\n")
        i3 = i3 + 1
    }
    print("EULER_COEFF_a4b4 ")
    print_int(e[(4 * 5 + 4) as usize])
    print("\n")
    // NOTE (Rodada 10): the computation above assumed the VACUOUS P3 relation
    // (u∘w always real for pure u,w) — its bundle premise is invalid.
    // CORRECTED (Rodada 11): the genuine pointwise relations are
    //   T ⊥ u (γ1), T ⊥ w (γ2), T ⊥ [u,w,w] (γ1), T ⊥ [w,u,u] (γ2)
    // (associator relations PROVED: ⟨[u,w],[u,w,w]⟩ = ⟨v²,w⟩-reduction = 0;
    // non-vacuity: rank{u,w,A1,A2} = 4 in 2000/2000 exact samples).
    // Bundle: E7 ≅ R^11 ⊖ 2γ1 ⊖ 2γ2, rank 7 < dim 8; PRIMARY obstruction of
    // E7 ⊗ γ1γ2 lives in H^7: w7 = Σ_i w_i(E7)(α+β)^{7−i}.
    var d2a = [0; 25]
    pmul(&f1, &f1, &!d2a)          // (1+α)²
    var d2b = [0; 25]
    pmul(&f2, &f2, &!d2b)          // (1+β)²
    var d2 = [0; 25]
    pmul(&d2a, &d2b, &!d2)
    var n2 = [0; 25]
    padd(&d2, &one, &!n2)
    var d2inv = [0; 25]
    d2inv[0] = 1
    var np2 = [0; 25]
    var k5 = 0
    while k5 < 25 { np2[k5 as usize] = n2[k5 as usize]; k5 = k5 + 1 }
    var it2 = 0
    while it2 < 10 {
        var tmp2 = [0; 25]
        padd(&d2inv, &np2, &!tmp2)
        k5 = 0
        while k5 < 25 { d2inv[k5 as usize] = tmp2[k5 as usize]; k5 = k5 + 1 }
        var np3 = [0; 25]
        pmul(&np2, &n2, &!np3)
        k5 = 0
        while k5 < 25 { np2[k5 as usize] = np3[k5 as usize]; k5 = k5 + 1 }
        it2 = it2 + 1
    }
    var chk2 = [0; 25]
    pmul(&d2, &d2inv, &!chk2)
    var ok2 = 1
    k5 = 0
    while k5 < 25 {
        let want2 = if k5 == 0 { 1 } else { 0 }
        if chk2[k5 as usize] != want2 { ok2 = 0 }
        k5 = k5 + 1
    }
    print("INVERSE7_CHECK ")
    if ok2 == 1 { println("OK") } else { println("FAIL") }
    var e7 = [0; 25]
    var i7 = 0
    while i7 <= 7 {
        var wi7 = [0; 25]
        var a7 = 0
        while a7 < 5 {
            var b7 = 0
            while b7 < 5 {
                if a7 + b7 == i7 { wi7[(a7 * 5 + b7) as usize] = d2inv[(a7 * 5 + b7) as usize] }
                b7 = b7 + 1
            }
            a7 = a7 + 1
        }
        var cp7 = [0; 25]
        cp7[0] = 1
        var t7 = 0
        while t7 < 7 - i7 {
            var cp8 = [0; 25]
            pmul(&cp7, &cpol, &!cp8)
            var k6 = 0
            while k6 < 25 { cp7[k6 as usize] = cp8[k6 as usize]; k6 = k6 + 1 }
            t7 = t7 + 1
        }
        var term7 = [0; 25]
        pmul(&wi7, &cp7, &!term7)
        var e7b = [0; 25]
        padd(&e7, &term7, &!e7b)
        var k7 = 0
        while k7 < 25 { e7[k7 as usize] = e7b[k7 as usize]; k7 = k7 + 1 }
        i7 = i7 + 1
    }
    print("W7_COEFF_a4b3 ")
    print_int(e7[(4 * 5 + 3) as usize])
    print("  W7_COEFF_a3b4 ")
    print_int(e7[(3 * 5 + 4) as usize])
    print("\n")
    if e7[(4 * 5 + 3) as usize] == 1 || e7[(3 * 5 + 4) as usize] == 1 {
        println("CONJ68_EULER7 PRIMARY_OBSTRUCTION_NONZERO")
    } else {
        println("CONJ68_EULER7 PRIMARY_OBSTRUCTION_ZERO")
    }
}
