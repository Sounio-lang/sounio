// Conjecture 6.8 — exact verification of the THREE POINTWISE RELATIONS that
// cut the commutator section to a rank-8 bundle (route alpha, Euler class):
//   (P1) <[u,w], u> = 0        (P2) <[u,w], w> = 0
//   (P3) <[u,w], uw + wu> = 0  (pure u, w)
// over random integer PURE sedenions (no ZD structure needed — the relations
// are universal bilinear/quadratic identities), plus the generic rank-3 check
// of the three perp lines inside W11 at random commutant points (the bundle
// has honest rank 8 off the degeneracy loci).

fn cd_sigma_c(a: i64, b: i64, bits: i64) -> i64 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_c(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_c(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_c(a_lo, 0, bits - 1) }
        return 0 - cd_sigma_c(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma_c(0, a_lo, bits - 1) }
    cd_sigma_c(b_lo, a_lo, bits - 1)
}

fn sed_sigma(a: i64, b: i64) -> i64 with Mut, Panic, Div { cd_sigma_c(a, b, 4) }

fn smul_i(x: &[i64; 16], y: &[i64; 16], out: &![i64; 16]) with Mut, Panic, Div {
    var k = 0
    while k < 16 { out[k as usize] = 0; k = k + 1 }
    var i = 0
    while i < 16 {
        if x[i as usize] != 0 {
            var j = 0
            while j < 16 {
                if y[j as usize] != 0 {
                    let t = i ^ j
                    out[t as usize] = out[t as usize] + sed_sigma(i, j) * x[i as usize] * y[j as usize]
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

fn dot16(x: &[i64; 16], y: &[i64; 16]) -> i64 with Mut {
    var s = 0
    var k = 0
    while k < 16 { s = s + x[k as usize] * y[k as usize]; k = k + 1 }
    s
}

fn lehmer_next(state: i64) -> i64 with Mut, Div, Panic {
    (state * 48271) % 2147483647
}

fn main() with IO, Mut, Panic, Div {
    var seed = 13579
    var viol1 = 0
    var viol2 = 0
    var viol3 = 0
    var vac_viol = 0
    var c1_viol = 0
    var c2_viol = 0
    var c3_viol = 0
    var c4_viol = 0
    var c5_viol = 0
    var c6_viol = 0
    var rank_hist = [0; 5]
    let n_trials = 2000
    var t = 0
    while t < n_trials {
        // random pure u, w with entries in {-3..3}
        var u = [0; 16]
        var w = [0; 16]
        var q = 1
        while q < 16 {
            seed = lehmer_next(seed)
            u[q as usize] = (seed % 7) - 3
            seed = lehmer_next(seed)
            w[q as usize] = (seed % 7) - 3
            q = q + 1
        }
        var uw = [0; 16]
        var wu = [0; 16]
        smul_i(&u, &w, &!uw)
        smul_i(&w, &u, &!wu)
        var comm = [0; 16]
        var jord = [0; 16]
        q = 0
        while q < 16 {
            comm[q as usize] = uw[q as usize] - wu[q as usize]
            jord[q as usize] = uw[q as usize] + wu[q as usize]
            q = q + 1
        }
        if dot16(&comm, &u) != 0 { viol1 = viol1 + 1 }
        if dot16(&comm, &w) != 0 { viol2 = viol2 + 1 }
        if dot16(&comm, &jord) != 0 { viol3 = viol3 + 1 }
        // RODADA 10: P3 is VACUOUS (u∘w = 2Re(uw)e0 always real for pure u,w
        // — verified below); hunt for a GENUINE third relation among cubic
        // candidates V with <[u,w], V> = 0 identically:
        //   C1 = [u,w,w] = (uw)w − u(ww)     C2 = (uw)w
        //   C3 = w(wu)                        C4 = [w,u,u] = (wu)u − w(uu)
        //   C5 = Malcev-ish [[u,w],w]         C6 = [[u,w],u]
        var jp = 0
        var jpure = 0
        var q2 = 1
        while q2 < 16 { if jord[q2 as usize] != 0 { jpure = 1 }; q2 = q2 + 1 }
        if jpure == 1 { vac_viol = vac_viol + 1 }
        // C1
        var uww = [0; 16]
        smul_i(&uw, &w, &!uww)
        var ww = [0; 16]
        smul_i(&w, &w, &!ww)
        var uww2 = [0; 16]
        smul_i(&u, &ww, &!uww2)
        var c1v = [0; 16]
        q2 = 0
        while q2 < 16 { c1v[q2 as usize] = uww[q2 as usize] - uww2[q2 as usize]; q2 = q2 + 1 }
        if dot16(&comm, &c1v) != 0 { c1_viol = c1_viol + 1 }
        if dot16(&comm, &uww) != 0 { c2_viol = c2_viol + 1 }
        var wwu = [0; 16]
        smul_i(&w, &wu, &!wwu)
        if dot16(&comm, &wwu) != 0 { c3_viol = c3_viol + 1 }
        var wuu = [0; 16]
        smul_i(&wu, &u, &!wuu)
        var uu = [0; 16]
        smul_i(&u, &u, &!uu)
        var wuu2 = [0; 16]
        smul_i(&w, &uu, &!wuu2)
        var c4v = [0; 16]
        q2 = 0
        while q2 < 16 { c4v[q2 as usize] = wuu[q2 as usize] - wuu2[q2 as usize]; q2 = q2 + 1 }
        if dot16(&comm, &c4v) != 0 { c4_viol = c4_viol + 1 }
        var cw = [0; 16]
        var wc = [0; 16]
        smul_i(&comm, &w, &!cw)
        smul_i(&w, &comm, &!wc)
        var c5v = [0; 16]
        q2 = 0
        while q2 < 16 { c5v[q2 as usize] = cw[q2 as usize] - wc[q2 as usize]; q2 = q2 + 1 }
        if dot16(&comm, &c5v) != 0 { c5_viol = c5_viol + 1 }
        var cu = [0; 16]
        var uc = [0; 16]
        smul_i(&comm, &u, &!cu)
        smul_i(&u, &comm, &!uc)
        var c6v = [0; 16]
        q2 = 0
        while q2 < 16 { c6v[q2 as usize] = cu[q2 as usize] - uc[q2 as usize]; q2 = q2 + 1 }
        if dot16(&comm, &c6v) != 0 { c6_viol = c6_viol + 1 }
        jp = jp + 0
        // NON-VACUITY CHECK (the Rodada-10 lesson): rank of {u, w, C1v, C4v}
        // — the associator relations are genuine THIRD/FOURTH constraints iff
        // this rank is 4 generically. Exact integer Bareiss (4 pivots, small).
        var rmat = [0; 64]
        q2 = 0
        while q2 < 16 {
            rmat[q2 as usize] = u[q2 as usize]
            rmat[(16 + q2) as usize] = w[q2 as usize]
            rmat[(32 + q2) as usize] = c1v[q2 as usize]
            rmat[(48 + q2) as usize] = c4v[q2 as usize]
            q2 = q2 + 1
        }
        var rk = 0
        var prev = 1
        var col = 0
        while col < 16 && rk < 4 {
            var pr = 0 - 1
            var r = rk
            while r < 4 {
                if rmat[(r * 16 + col) as usize] != 0 { pr = r; r = 4 } else { r = r + 1 }
            }
            if pr >= 0 {
                if pr != rk {
                    var c9 = 0
                    while c9 < 16 {
                        let tt = rmat[(rk * 16 + c9) as usize]
                        rmat[(rk * 16 + c9) as usize] = rmat[(pr * 16 + c9) as usize]
                        rmat[(pr * 16 + c9) as usize] = tt
                        c9 = c9 + 1
                    }
                }
                let piv = rmat[(rk * 16 + col) as usize]
                var r2 = rk + 1
                while r2 < 4 {
                    let f = rmat[(r2 * 16 + col) as usize]
                    var c9 = 0
                    while c9 < 16 {
                        let num = piv * rmat[(r2 * 16 + c9) as usize] - f * rmat[(rk * 16 + c9) as usize]
                        rmat[(r2 * 16 + c9) as usize] = num / prev
                        c9 = c9 + 1
                    }
                    r2 = r2 + 1
                }
                prev = piv
                rk = rk + 1
            }
            col = col + 1
        }
        rank_hist[rk as usize] = rank_hist[rk as usize] + 1
        t = t + 1
    }
    print("P1_VIOL ")
    print_int(viol1)
    print("  P2_VIOL ")
    print_int(viol2)
    print("  P3_VIOL ")
    print_int(viol3)
    print("  JORD_PURE_NONZERO ")
    print_int(vac_viol)
    print("  (n=")
    print_int(n_trials)
    print(")\n")
    print("CUBIC_HUNT viol: C1 ")
    print_int(c1_viol)
    print(" C2 ")
    print_int(c2_viol)
    print(" C3 ")
    print_int(c3_viol)
    print(" C4 ")
    print_int(c4_viol)
    print(" C5 ")
    print_int(c5_viol)
    print(" C6 ")
    print_int(c6_viol)
    print("\n")
    var hh = 0
    while hh < 5 {
        if rank_hist[hh as usize] > 0 {
            print("RANK_UWA1A2 ")
            print_int(hh)
            print(" N ")
            print_int(rank_hist[hh as usize])
            print("\n")
        }
        hh = hh + 1
    }
    if viol1 == 0 && viol2 == 0 && viol3 == 0 {
        println("CONJ68_POINTWISE_RELATIONS OK")
    } else {
        println("CONJ68_POINTWISE_RELATIONS FAIL")
    }
}
