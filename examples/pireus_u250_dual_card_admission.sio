//@ run-pass
//!
//! First Sounio authority result for the dual AMD Alveo U250 fleet.

use hardware::pireus::u250_dual_card_admission::{
    pireus_u250_initial_admission,
    pireus_u250_initial_matches_expected,
}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn main() -> i32 with IO, Mut {
    let result = pireus_u250_initial_admission()
    print("SOUNIO_SEMANTIC_AUTHORITY schema=pireus.u250-dual-card-admission.v0 stage=SOUNIO_EXECUTABLE\n")
    print("PIREUS_U250_ADMISSION valid="); print_int(yes(result.valid))
    print(" status="); print_int(result.status)
    print(" target="); print_int(result.target_family)
    print(" engine_kind="); print_int(result.engine_kind)
    print(" fabric="); print_int(result.fabric)
    print(" interface="); print_int(result.interface)
    print(" machine="); print_int(result.machine)
    print(" authority_language=")
    print_int(result.semantic_authority_language)
    print(" declared="); print_int(result.declared_card_count)
    print(" slots="); print_int(result.material_slot_count)
    print(" discovered="); print_int(result.discovered_card_count)
    print(" admitted="); print_int(result.admitted_card_count)
    print(" rejected="); print_int(result.rejected_card_count)
    print(" missing="); print_int(result.missing_card_count)
    print(" inventory_complete="); print_int(yes(result.inventory_complete))
    print(" material_parity_ready=")
    print_int(yes(result.material_parity_ready))
    print(" cost_present="); print_int(yes(result.cost_present))
    print(" speedup_present="); print_int(yes(result.speedup_present))
    print(" kernel_correctness_present=")
    print_int(yes(result.kernel_correctness_present))
    print(" parity_open="); print_int(yes(result.parity_open))
    print(" claim_ready="); print_int(yes(result.claim_ready))
    print(" failures="); print_int(result.failures)
    print("\n")

    if pireus_u250_initial_matches_expected(&result) { 0 } else { 1 }
}
