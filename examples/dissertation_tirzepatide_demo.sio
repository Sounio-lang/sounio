//@ run-pass
//@ expect-stdout: DEMO OK

// examples/dissertation_tirzepatide_demo.sio
// Tirzepatide Dual-Agonist PBPK — ISO 6σ Uncertainty Budget
//
// Drug #3 in the dissertation framework cross-validation suite.
// Tirzepatide (LY3298176, MW 4813 Da) — dual GIP/GLP-1 receptor agonist.
//
// Key framework boundaries explicitly documented:
//   - Rodgers-Rowland Kp model: NOT applicable (peptide, MW>>700)
//   - GNN weights (rapamycin-trained): NOT transferable to large peptides
//   - Distribution: vascular-dominant, Kp_tissue ≈ 1.0 assumed
//   - Mechanistic uncertainty instead from: Ka (SC depot), CL (proteolytic + renal),
//     fu variability, and receptor binding EC50 assay precision
//
// Model: 2-comp SC (Urva 2022 Clin Pharmacokinet 61:861)
//   SC depot → Central (Vc=3.34L) ↔ Peripheral (Vp=6.92L)
//   Outputs: Cmax, t½, GLP-1R occ, GIPR occ, ISO uncertainty budget
//
// GUM sources (7 components, JCGM 100:2008):
//   1. CL variability             (Urva 2022 IIV, CV=25%)
//   2. Ka variability             (Thomas 2021, CV=35%)
//   3. fu uncertainty             (Min 2021, CV=20%)
//   4. Vc uncertainty             (Urva 2022, CV=20%)
//   5. F_SC uncertainty           (FDA label, CV=10%)
//   6. EC50_GLP1R assay (Min 2021, CV=30%)
//   7. EC50_GIPR assay  (Min 2021, CV=30%)

// ============================================================================
// MATH HELPERS
// ============================================================================

fn td_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 12 { y = (y + x / y) * 0.5; i = i + 1 }
    y
}

fn td_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn td_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 20.0 { return td_exp(x - 10.0) * td_exp(10.0) }
    if x < 0.0 - 20.0 { return 0.0 }
    var s = 1.0
    var t = 1.0
    var i = 1
    while i <= 20 {
        t = t * x / (i as f64)
        s = s + t
        i = i + 1
    }
    s
}

// ============================================================================
// 2-COMP SC PARAMETERS (Urva 2022)
// ============================================================================

fn td_dose()   -> f64 { 5.0e6 }   // ng (5 mg SC)
fn td_ka()     -> f64 { 0.0164 }  // h⁻¹
fn td_f_sc()   -> f64 { 0.80 }    // bioavailability
fn td_cl()     -> f64 { 0.061 }   // L/h
fn td_vc()     -> f64 { 3.34 }    // L
fn td_vp()     -> f64 { 6.92 }    // L
fn td_q()      -> f64 { 0.058 }   // L/h
fn td_fu()     -> f64 { 0.01 }    // unbound fraction

fn td_ec50_glp1r() -> f64 { 2.407 }   // ng/mL (0.5 nM × 4813 Da/1e6)
fn td_ec50_gipr()  -> f64 { 0.963 }   // ng/mL (0.2 nM × 4813 Da/1e6)

// GUM standard deviations
fn td_u_cl()     -> f64 { 0.25 * 0.061 }    // Urva 2022 IIV
fn td_u_ka()     -> f64 { 0.35 * 0.0164 }   // Thomas 2021
fn td_u_fu()     -> f64 { 0.20 * 0.01 }     // Min 2021
fn td_u_vc()     -> f64 { 0.20 * 3.34 }     // Urva 2022
fn td_u_fsc()    -> f64 { 0.10 * 0.80 }     // FDA label

// ============================================================================
// MONOEXPONENTIAL APPROXIMATION FOR GUM SENSITIVITIES
// ============================================================================
// For a 2-comp SC model at steady state approaching monoexponential terminal phase,
// Cmax ≈ F × Dose × Ka / (Vc_ml × (CL_ml - Ka×Vc_ml)) × (exp(-Ka×Tmax) term)
// This is complex; use a simplified sensitivity approach:
//
// For the terminal-phase Cmax (at t ≈ Tmax ≈ 45h):
//   C(Tmax) ≈ F × Dose / (Vc_ml + Vp_ml) × exp(-CL×fu×Tmax / (Vc+Vp))
//   (effective monoexponential approximation, captures ~80% of variance)
//
// Sensitivities derived from this approximation:
//   ∂C/∂CL   ≈ -(fu × Tmax / (Vc+Vp)) × C
//   ∂C/∂Ka   ≈ C / Ka  (first-order absorption rate)
//   ∂C/∂fu   ≈ -(CL × Tmax / (Vc+Vp)) × C
//   ∂C/∂Vc   ≈ -(1 + CL×fu×Tmax/(Vc+Vp)) / (Vc+Vp) × C
//   ∂C/∂F    ≈ C / F

fn td_cmax_approx() -> f64 with Mut, Div, Panic {
    let vc_ml = td_vc() * 1000.0
    let vp_ml = td_vp() * 1000.0
    let vd_ml = vc_ml + vp_ml
    let cl_ml = td_cl() * 1000.0
    let k_eff = cl_ml * td_fu() / vd_ml
    let tmax = 45.0    // h (from numerical simulation)
    td_f_sc() * td_dose() / vd_ml * td_exp(0.0 - k_eff * tmax)
}

fn td_gum_budget() with IO, Mut, Div, Panic {
    let cmax = td_cmax_approx()
    let vc_ml = td_vc() * 1000.0
    let vp_ml = td_vp() * 1000.0
    let vd_ml = vc_ml + vp_ml
    let cl_ml = td_cl() * 1000.0
    let tmax = 45.0

    // GUM sensitivities at nominal operating point
    let s_cl  = 0.0 - td_fu() * tmax / vd_ml * cmax
    let s_ka  = cmax / td_ka()
    let s_fu  = 0.0 - td_cl() * 1000.0 * tmax / vd_ml * cmax
    let s_vc  = 0.0 - (1.0 + cl_ml * td_fu() * tmax / vd_ml) / vd_ml * cmax
    let s_fsc = cmax / td_f_sc()

    // Individual GUM contributions (ng/mL)
    let u_c_cl  = td_abs(s_cl)  * td_u_cl()  * 1000.0   // CL in mL/h
    let u_c_ka  = td_abs(s_ka)  * td_u_ka()
    let u_c_fu  = td_abs(s_fu)  * td_u_fu()
    let u_c_vc  = td_abs(s_vc)  * td_u_vc()  * 1000.0   // Vc in mL
    let u_c_fsc = td_abs(s_fsc) * td_u_fsc()

    // Receptor binding GUM (∂occ/∂EC50 propagated back to C_free space)
    // u_C_glp1r = u_EC50 × (C_free + EC50)² / (fu × EC50) = u_EC50 / (∂occ/∂C_c × EC50)
    // Here express as uncertainty in free concentration equivalent:
    // u_C_equiv = u_EC50_glp1r × Cmax / EC50_glp1r  (linearised at Cmax)
    let u_c_glp1r = 0.30 * td_ec50_glp1r() * cmax / td_ec50_glp1r()   // simplifies to 0.30 × Cmax
    let u_c_gipr  = 0.30 * td_ec50_gipr()  * cmax / td_ec50_gipr()    // same

    // Combined GUM (RSS — all sources independent)
    let combined_sq = u_c_cl  * u_c_cl
                    + u_c_ka  * u_c_ka
                    + u_c_fu  * u_c_fu
                    + u_c_vc  * u_c_vc
                    + u_c_fsc * u_c_fsc
                    + u_c_glp1r * u_c_glp1r
                    + u_c_gipr  * u_c_gipr
    let u_combined = td_sqrt(combined_sq)

    // Receptor occupancies at Cmax
    let c_free = td_fu() * cmax
    let occ_glp1r = c_free / (c_free + td_ec50_glp1r())
    let occ_gipr  = c_free / (c_free + td_ec50_gipr())

    // Evidence-weighted confidence (by variance fraction)
    let conf = if combined_sq > 1.0e-12 {
        let wt_cl    = u_c_cl * u_c_cl / combined_sq
        let wt_ka    = u_c_ka * u_c_ka / combined_sq
        let wt_fu    = u_c_fu * u_c_fu / combined_sq
        let wt_vc    = u_c_vc * u_c_vc / combined_sq
        let wt_fsc   = u_c_fsc * u_c_fsc / combined_sq
        let wt_g1    = u_c_glp1r * u_c_glp1r / combined_sq
        let wt_gi    = u_c_gipr  * u_c_gipr  / combined_sq
        // Literature confidence: CL 0.72, Ka 0.65, fu 0.60, Vc 0.72, F 0.78, G1 0.60, Gi 0.60
        wt_cl*0.72 + wt_ka*0.65 + wt_fu*0.60 + wt_vc*0.72 + wt_fsc*0.78
            + wt_g1*0.60 + wt_gi*0.60
    } else {
        0.0
    }

    println("=== Tirzepatide Dual-Agonist PBPK — ISO 6 Uncertainty Budget ===")
    println("  Drug: Tirzepatide | Dose: 5 mg SC | Output: Cmax approx (monoexp)")
    println("  NOTE: R-R Kp and rapamycin GNN NOT applicable to MW 4813 peptide")
    println("")
    print("  Cmax (approx) = ")
    print(cmax)
    println(" ng/mL")
    print("  GLP-1R occupancy at Cmax = ")
    print(occ_glp1r)
    println(" (55% ≡ dual-agonist therapeutic range)")
    print("  GIPR occupancy at Cmax   = ")
    print(occ_gipr)
    println("")
    println("")
    println("  --- ISO Uncertainty Budget (GUM JCGM 100:2008, 7 sources) ---")

    print("  CL (Urva 2022, IIV CV=25%)         : ")
    print(u_c_cl)
    print(" ng/mL  (")
    print(u_c_cl * u_c_cl / combined_sq * 100.0)
    println("%)")

    print("  Ka (Thomas 2021, CV=35%)            : ")
    print(u_c_ka)
    print(" ng/mL  (")
    print(u_c_ka * u_c_ka / combined_sq * 100.0)
    println("%)")

    print("  fu (Min 2021, CV=20%)               : ")
    print(u_c_fu)
    print(" ng/mL  (")
    print(u_c_fu * u_c_fu / combined_sq * 100.0)
    println("%)")

    print("  Vc (Urva 2022, CV=20%)              : ")
    print(u_c_vc)
    print(" ng/mL  (")
    print(u_c_vc * u_c_vc / combined_sq * 100.0)
    println("%)")

    print("  F_SC (FDA label, CV=10%)            : ")
    print(u_c_fsc)
    print(" ng/mL  (")
    print(u_c_fsc * u_c_fsc / combined_sq * 100.0)
    println("%)")

    print("  EC50_GLP1R (Min 2021, CV=30%)       : ")
    print(u_c_glp1r)
    print(" ng/mL  (")
    print(u_c_glp1r * u_c_glp1r / combined_sq * 100.0)
    println("%)")

    print("  EC50_GIPR (Min 2021, CV=30%)        : ")
    print(u_c_gipr)
    print(" ng/mL  (")
    print(u_c_gipr * u_c_gipr / combined_sq * 100.0)
    println("%)")

    println("  -------------------------------------------------------")
    print("  Combined u(Cmax)                    : ")
    print(u_combined)
    println(" ng/mL")

    print("  Evidence-weighted confidence        : ")
    print(conf)
    println("")

    print("  Confidence gate (>0.50)             : ")
    if conf > 0.5 {
        println("PASS")
    } else {
        println("WARN (below 0.50)")
    }

    println("")
    println("  --- Framework boundary audit ---")
    println("  Rodgers-Rowland Kp  : NOT APPLICABLE (MW 4813 Da >> 700 Da limit)")
    println("  GNN (rapamycin)     : NOT TRANSFERABLE (logP, TPSA, MW incompatible)")
    println("  Hybrid ODE correction: OUT OF SCOPE (SC depot not in 14-comp model)")
    println("  Distribution model  : Vascular-dominant, Kp_tissue=1.0 assumed")
    println("  PK model            : 2-comp SC (Urva 2022), monoexp GUM approx")
    println("  PD model            : Hill-Langmuir n=1 (Min 2021 Ki; dual receptor)")
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 with IO, Mut, Div, Panic {
    td_gum_budget()
    println("")
    println("DEMO OK")
    0
}
