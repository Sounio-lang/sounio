//@ run-pass
//@ expect-stdout: SCENARIO GATE OK

// Scenario-level VoI-weighted confidence gate demo.
// Runs the existing 7-D BBB HDMR + VoI pipeline, then collapses the
// per-parameter VoI into three scenario verdicts (IV-bolus, Cypher-DES,
// oral-SS) at threshold 0.60.

use darwin_pbpk::bbb::bbb_hdmr::*
use darwin_pbpk::bbb::bbb_priors::{bbb_rapamycin_priors}
use darwin_pbpk::bbb::bbb_rapamycin::{bbb_rapamycin_params}
use darwin_pbpk::bbb::bbb_voi::*
use darwin_pbpk::bbb::scenario_gate::*
use darwin_pbpk::drugs::rapamycin::{rapamycin_mean_params}

fn make_cp() -> [f64; 32] with Div, Panic, Mut {
    var cp: [f64; 32] = [0.0; 32]
    var i: i32 = 0
    while i < 16 {
        let idx = i as usize
        cp[idx] = (i as f64) * 3.0      // 0, 3, 6, …, 45 h
        i = i + 1
    }
    cp
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let sys_prm = rapamycin_mean_params()
    let bbb_prm = bbb_rapamycin_params()
    let priors  = bbb_rapamycin_priors()

    let checkpoints = make_cp()

    let hdmr = bbb_hdmr_build_kpuu_auc(sys_prm, bbb_prm, priors, 5.0, checkpoints, 16, 0.02)
    let voi  = bbb_voi_from_hdmr(hdmr, priors)

    println("--- Parameter-level VoI ranking ---")
    bbb_voi_print(voi)

    println("")
    println("--- Scenario-level gate (threshold = 0.60) ---")
    let v_iv  = gate_scenario(ScenarioKind::IVBolus,         voi, 0.60)
    let v_des = gate_scenario(ScenarioKind::CypherStent,     voi, 0.60)
    let v_ss  = gate_scenario(ScenarioKind::OralSteadyState, voi, 0.60)
    scenario_gate_print(v_iv);  println("")
    scenario_gate_print(v_des); println("")
    scenario_gate_print(v_ss);  println("")

    println("SCENARIO GATE OK")
    0
}
