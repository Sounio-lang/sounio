// examples/interop_serve.sio — Standalone Sounio IPC server example.
//
// Run: souc run examples/interop_serve.sio -- --serve
//
// This starts an IPC server on stdin/stdout using the SNIO binary protocol.
// Connect from F# with:
//   use sounio = new SounioProcess("souc", "examples/interop_serve.sio")
//   let result = sounio.CallScalar("dot_product", args)

// The interop server is built into the compiler main.sio --serve flag.
// This file documents the protocol and serves as a reference for
// writing custom Sounio programs that expose functions via IPC.
//
// Protocol (SNIO binary, little-endian):
//   Magic:    4 bytes = "SNIO" (0x53 0x4E 0x49 0x4F)
//   MsgType:  1 byte  (1=CALL_FUNC, 2=RESULT, 3=ERROR, 4=SHUTDOWN)
//   BodyLen:  4 bytes LE
//   Payload:  BodyLen bytes
//
// CALL_FUNC payload:
//   name_len:  2 bytes LE
//   name:      name_len bytes (UTF-8)
//   arg_count: 8 bytes LE
//   args:      arg_count * 8 bytes LE (i64 raw bit patterns)
//
// RESULT payload:
//   count:  8 bytes LE
//   values: count * 8 bytes LE
//
// Built-in functions: ping, dot_product, vec_add, vec_scale, sum

fn main() with IO {
    println("interop_serve: use 'souc --serve' to start the IPC server")
    println("interop_serve: or compile main.sio with --serve flag")
}
