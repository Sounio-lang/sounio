//@ run-pass
//! First Sounio executable for the Pireus XOR selector plan.
//!
//! This stream creates the expected selector rows and digests. It names no
//! instruction match and records no hardware observation or cost.

use hardware::pireus::xor_material_matching::{
    PireusXorMaterialDigest,
    pireus_xor_material_evaluate,
}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_hex_word(word: i64) with IO, Mut {
    var shift: i64 = 28
    while shift >= 0 {
        let nibble = (word >> shift) & 15
        if nibble < 10 { print_char(48 + nibble) }
        else { print_char(87 + nibble) }
        shift = shift - 4
    }
}

fn print_digest(digest: &PireusXorMaterialDigest) with IO, Mut {
    var i: i64 = 0
    while i < 8 {
        print_hex_word(digest.words[i])
        i = i + 1
    }
}

fn print_hash(hash: &[i64; 8]) with IO, Mut {
    var i: i64 = 0
    while i < 8 {
        print_hex_word(hash[i])
        i = i + 1
    }
}

fn print_negative(name: string, passed: bool) with IO, Mut {
    print("PIREUS_XOR_MATERIAL_NEGATIVE name="); print(name)
    print(" passed="); print_int(yes(passed)); print("\n")
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 1 {
        print("usage: pireus_xor_material_matching <avx512-foundation-isa.xed.txt>\n")
        return 2
    }
    let result = pireus_xor_material_evaluate(get_arg(0))
    print("PIREUS_XOR_MATERIAL shape_bits="); print_int(result.bits)
    print(" dimension="); print_int(result.dimension)
    print(" element_bits="); print_int(result.element_bits)
    print(" chunk_lanes="); print_int(result.chunk_lanes)
    print(" chunk_count="); print_int(result.chunk_count)
    print(" valid="); print_int(yes(result.valid))
    print(" error="); print_int(result.error); print("\n")

    print("PIREUS_XOR_MATERIAL_PARENT live_match=")
    print_int(yes(result.operation_parent_live_match))
    print(" binding_valid=")
    print_int(yes(result.operation_parent_binding_valid))
    print(" result_digest_match=")
    print_int(yes(result.operation_result_digest_match))
    print(" result_digest="); print_hash(&result.operation_result_digest)
    print(" semantics="); print_hash(&result.operation_semantics_sha256)
    print(" receipt="); print_hash(&result.operation_receipt_sha256)
    print("\n")

    var i: i64 = 0
    while i < result.selector.count {
        print("PIREUS_XOR_SELECTOR index="); print_int(i)
        print(" d="); print_int(result.selector.displacements[i])
        print(" output_chunk="); print_int(result.selector.output_chunks[i])
        print(" output_lane="); print_int(result.selector.output_lanes[i])
        print(" i="); print_int(result.selector.global_indices[i])
        print(" j="); print_int(result.selector.partner_indices[i])
        print(" source_chunk="); print_int(result.selector.source_chunks[i])
        print(" source_lane="); print_int(result.selector.source_lanes[i])
        print(" reconstructed=")
        print_int(yes(result.selector.reconstructed[i]))
        print("\n")
        i = i + 1
    }

    print("PIREUS_XOR_SELECTOR_SUMMARY cells=")
    print_int(result.selector.count)
    print(" reconstructed="); print_int(result.reconstructed_cells)
    print(" groups="); print_int(result.one_source_groups)
    print(" one_source_per_group=")
    print_int(yes(result.layout_one_source_per_group)); print("\n")

    let xed = &result.xed
    print("PIREUS_XOR_XED frozen_content=")
    print_hash(&xed.frozen_content_sha256)
    print(" current_envelope="); print_hash(&xed.current_envelope_sha256)
    print(" current_receipt="); print_hash(&xed.current_receipt_sha256)
    print(" total_forms="); print_int(xed.total_forms)
    print(" vpermpd="); print_int(xed.vpermpd_forms)
    print(" vpermi2pd="); print_int(xed.vpermi2pd_forms)
    print(" vpermt2pd="); print_int(xed.vpermt2pd_forms)
    print(" frozen_receipt_reference_present=")
    print_int(yes(xed.frozen_receipt_reference_present))
    print(" vendor_corpus_digest_match=")
    print_int(yes(xed.vendor_corpus_digest_match))
    print(" counts_from_digest_matched_vendor_bytes=")
    print_int(yes(xed.counts_from_digest_matched_vendor_bytes))
    print(" counts_match_receipt_record=")
    print_int(yes(xed.counts_match_receipt_record))
    print(" candidate_family_present=")
    print_int(yes(xed.candidate_family_present))
    print(" behavior_derived_from_presence=")
    print_int(yes(xed.selector_behavior_derived_from_form_presence))
    print(" selector_semantics_receipt=")
    print_int(yes(xed.selector_semantics_receipt_present))
    print(" instruction_match_authorized=")
    print_int(yes(xed.instruction_match_authorized))
    print(" imm8_sufficiency_authorized=")
    print_int(yes(xed.immediate_sufficiency_authorized))
    print(" two_source_necessity_authorized=")
    print_int(yes(xed.two_source_necessity_authorized))
    print("\n")

    i = 0
    while i < result.targets.count {
        print("PIREUS_XOR_MATERIAL_TARGET index="); print_int(i)
        print(" target="); print_int(result.targets.target_ids[i])
        print(" canonical="); print_int(yes(result.targets.canonical[i]))
        print(" observed="); print_int(yes(result.targets.observed[i]))
        print(" plan="); print_int(result.targets.candidate_plans[i])
        print(" unresolved="); print_int(yes(result.targets.unresolved[i]))
        print(" material_receipt=")
        print_int(yes(result.targets.material_receipts[i]))
        print("\n")
        i = i + 1
    }

    let neg = &result.negatives
    print_negative("missing_operation_parent_hash",
        neg.missing_operation_parent_hash)
    print_negative("mismatched_operation_parent_hash",
        neg.mismatched_operation_parent_hash)
    print_negative("missing_operation_receipt",
        neg.missing_operation_receipt)
    print_negative("mismatched_operation_receipt",
        neg.mismatched_operation_receipt)
    print_negative("wrong_logical_bit_width", neg.wrong_logical_bit_width)
    print_negative("wrong_dimension", neg.wrong_dimension)
    print_negative("wrong_element_width", neg.wrong_element_width)
    print_negative("wrong_chunk_width", neg.wrong_chunk_width)
    print_negative("displacement_out_of_range",
        neg.displacement_out_of_range)
    print_negative("output_chunk_out_of_range",
        neg.output_chunk_out_of_range)
    print_negative("output_lane_out_of_range", neg.output_lane_out_of_range)
    print_negative("corrupted_source_chunk", neg.corrupted_source_chunk)
    print_negative("corrupted_source_lane", neg.corrupted_source_lane)
    print_negative("layout_to_two_source_necessity",
        neg.layout_to_two_source_necessity)
    print_negative("imm8_without_vendor_semantics",
        neg.imm8_without_vendor_semantics)
    print_negative("form_presence_to_behavior",
        neg.form_presence_to_behavior)
    print_negative("capability_to_emitted_use",
        neg.capability_to_emitted_use)
    print_negative("target_observation_without_receipt",
        neg.target_observation_without_receipt)
    print_negative("cost_without_material_receipt",
        neg.cost_without_material_receipt)
    print_negative("parity_or_claim_before_transition",
        neg.parity_or_claim_before_transition)
    print_negative("prohibited_oracle_language",
        neg.prohibited_oracle_language)
    print("PIREUS_XOR_MATERIAL_NEGATIVES passed="); print_int(neg.passed)
    print(" total="); print_int(neg.total); print("\n")

    print("PIREUS_XOR_MATERIAL_CLOSED observations=")
    print_int(result.material_observation_count)
    print(" instruction_matches="); print_int(result.instruction_match_count)
    print(" lowerings="); print_int(result.lowering_count)
    print(" cost_records="); print_int(result.cost_record_count)
    print(" loom_guardian_external_required=")
    print_int(yes(result.loom_guardian_external_required))
    print("\n")

    print("PIREUS_XOR_MATERIAL_DIGEST selector=")
    print_digest(&result.selector_digest)
    print("\nPIREUS_XOR_MATERIAL_DIGEST evidence=")
    print_digest(&result.evidence_digest)
    print("\nPIREUS_XOR_MATERIAL_DIGEST target=")
    print_digest(&result.target_digest)
    print("\nPIREUS_XOR_MATERIAL_DIGEST witness=")
    print_digest(&result.witness_digest)
    print("\n")

    print("PIREUS_XOR_MATERIAL_AUTHORITY language=Sounio")
    print(" role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE")
    print(" parity_open="); print_int(yes(result.parity_open))
    print(" claim_ready="); print_int(yes(result.claim_ready))
    print(" failures="); print_int(result.failures); print("\n")
    result.failures as i32
}
