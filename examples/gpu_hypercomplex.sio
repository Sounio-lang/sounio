// Hypercomplex arithmetic demo used as GPU benchmark scaffold.
// This file intentionally provides a CPU-runnable baseline.

struct Quaternion {
    w: f64,
    x: f64,
    y: f64,
    z: f64
}

fn qmul(a: Quaternion, b: Quaternion) -> Quaternion {
    return Quaternion {
        w: a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z,
        x: a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
        y: a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
        z: a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w
    }
}

fn qnorm2(q: Quaternion) -> f64 {
    return q.w * q.w + q.x * q.x + q.y * q.y + q.z * q.z
}

fn main() with IO {
    let a = Quaternion { w: 1.0, x: 2.0, y: 0.5, z: -1.0 }
    let b = Quaternion { w: 0.8, x: -0.2, y: 1.5, z: 0.3 }

    let c = qmul(a, b)

    println("example: gpu_hypercomplex")
    println("result.w")
    println(c.w)
    println("result.x")
    println(c.x)
    println("result.y")
    println(c.y)
    println("result.z")
    println(c.z)
    println("norm^2")
    println(qnorm2(c))
}
