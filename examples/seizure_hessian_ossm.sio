// Epilepsy O-SSM Hessian: Non-Associative Curvature in Seizure EEG
//
// CHB-MIT Scalp EEG: 8 bipolar channels (fronto-temporal), 8-timestep windows
//   label 0 = baseline  (no seizure in the recording)
//   label 1 = interictal (same recording as seizure, but outside seizure)
//   label 2 = ictal      (during seizure)
//
// Hypothesis: seizure propagation is inherently path-dependent —
// signal cascades A→B→C where order matters, producing (A⊗B)⊗C ≠ A⊗(B⊗C).
// The O-SSM Hessian off-diagonal captures this non-associative curvature.
// Ictal windows should have the highest off-diagonal norm, then interictal,
// then baseline. This gradient reflects the degree of path-dependent
// cortical recruitment.
//
// Training: binary classification (ictal vs non-ictal)
// Diagnosis: per-window 8×8 Hessian of loss w.r.t. A parameter

var FEATURES: [f64; 262144] = [0.0; 262144]
var LABELS: [i64; 4096] = [0; 4096]
var SITE_KEYS: [i64; 4096] = [0; 4096]
var UNIQUE_SITES: [i64; 64] = [0; 64]
var UNIQUE_SITE_COUNT: i64 = 0
var SUBJECT_COUNT: i64 = 0

var RNG_A: i64 = 0
var RNG_B: i64 = 0

// Seed offset added for P1.3 seed-robustness sweep.
// Rewritten per run by scripts/research/hessian_seed_sweep/run_sweep.py
// to a distinct value in each seeded copy. Default 0 reproduces the
// original deterministic per-patient seeding.
var SEED_OFFSET: i64 = 0

var W: [i64; 16] = [0; 16]
var MOM: [i64; 16] = [0; 16]
var H: [i64; 8] = [0; 8]
var A: [f64; 8] = [0.0; 8]
var SAVED_A: [f64; 8] = [0.0; 8]
var ASSOC_ACC: i64 = 0
var LOGIT: f64 = 0.0
var TMP_OCT: [f64; 8] = [0.0; 8]

var HESS: [i64; 64] = [0; 64]

// Per-class accumulators
var ICTAL_OD_SUM: i64 = 0
var ICTAL_DG_SUM: i64 = 0
var ICTAL_COUNT: i64 = 0
var INTER_OD_SUM: i64 = 0
var INTER_DG_SUM: i64 = 0
var INTER_COUNT: i64 = 0
var BASE_OD_SUM: i64 = 0
var BASE_DG_SUM: i64 = 0
var BASE_COUNT: i64 = 0

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn exp_q(x: f64) -> f64 with Mut, Div, Panic {
    if x > 15.0 { return exp_q(7.5) * exp_q(x - 7.5) }
    if x < 0.0 - 15.0 { return 0.0 }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 20 { term = term * x / (i as f64); sum = sum + term; i = i + 1 }
    sum
}

fn sqrt_q(x: f64) -> f64 with Mut, Div, Panic {
    if x != x { return 0.0 }
    if x <= 0.0 { return 0.0 }
    var g = x
    var i = 0
    while i < 16 { g = 0.5 * (g + x / g); i = i + 1 }
    if g != g { return 0.0 }
    g
}

fn sigmoid_q(x: f64) -> f64 with Mut, Div, Panic {
    if x >= 0.0 { 1.0 / (1.0 + exp_q(0.0 - x)) }
    else { let ex = exp_q(x); ex / (1.0 + ex) }
}

fn rng_seed(a: i64, b: i64) with Mut { RNG_A = a; RNG_B = b }
fn rng_next() -> i64 with Mut {
    var x = RNG_A
    let y = RNG_B
    RNG_A = y
    x = x ^ (x << 23); x = x ^ (x >> 17); x = x ^ (y ^ (y >> 26))
    RNG_B = x
    let r = x + y
    if r < 0 { 0 - r } else { r }
}
fn randf() -> f64 with Mut, Div { ((rng_next() % 20000) as f64 - 10000.0) / 10000.0 }

fn print_int(v: i64) with IO, Mut {
    if v < 0 { print("-"); print_int(0 - v); return }
    if v >= 10 { print_int(v / 10) }
    let d = v % 10
    if d==0{print("0")}if d==1{print("1")}if d==2{print("2")}if d==3{print("3")}
    if d==4{print("4")}if d==5{print("5")}if d==6{print("6")}if d==7{print("7")}
    if d==8{print("8")}if d==9{print("9")}
}

// ─── Manifest loading ───

fn load_manifest(path: string) -> i64 with IO, Mut, Div, Panic {
    SUBJECT_COUNT = 0
    UNIQUE_SITE_COUNT = 0
    let n = file_size(path)
    if n <= 0 { return 0 }
    let raw = read_file(path)
    let bytes = raw.as_bytes()
    if n < 24 { return -1 }

    var header_start: i64 = 0
    var seeking = true
    while seeking && header_start < n {
        while header_start < n && (bytes[header_start as usize] == 10 || bytes[header_start as usize] == 13) {
            header_start = header_start + 1
        }
        if header_start >= n { seeking = false }
        else if bytes[header_start as usize] == 35 {
            while header_start < n && bytes[header_start as usize] != 10 { header_start = header_start + 1 }
            if header_start < n { header_start = header_start + 1 }
        } else { seeking = false }
    }

    if header_start + 24 >= n ||
       bytes[header_start as usize] != 115 || bytes[(header_start+1) as usize] != 117 ||
       bytes[(header_start+2) as usize] != 98 || bytes[(header_start+3) as usize] != 106 {
        return -1
    }

    var pos: i64 = header_start
    while pos < n && bytes[pos as usize] != 10 { pos = pos + 1 }
    if pos < n { pos = pos + 1 }

    while pos < n && SUBJECT_COUNT < 4096 {
        if bytes[pos as usize] == 10 { pos = pos + 1 }
        else if bytes[pos as usize] == 35 {
            while pos < n && bytes[pos as usize] != 10 { pos = pos + 1 }
            if pos < n { pos = pos + 1 }
        } else {
        var line_end = pos
        while line_end < n && bytes[line_end as usize] != 10 { line_end = line_end + 1 }
        var field_idx: i64 = 0
        var field_start = pos
        var label: i64 = -1
        var site_hash: i64 = 5381
        var feature_idx: i64 = 0
        var i = pos
        while i <= line_end {
            let is_end = i == line_end
            let is_tab = if is_end { false } else { bytes[i as usize] == 9 }
            if is_end || is_tab {
                if field_idx == 1 {
                    if i > field_start {
                        let b = bytes[field_start as usize]
                        if b == 48 { label = 0 }
                        else if b == 49 { label = 1 }
                        else if b == 50 { label = 2 }
                    }
                } else if field_idx == 2 {
                    var si = field_start
                    while si < i { site_hash = site_hash * 33 + (bytes[si as usize] as i64); si = si + 1 }
                } else if field_idx >= 3 && feature_idx < 64 {
                    var val: f64 = 0.0
                    var neg = false
                    var seen_dot = false
                    var frac_scale = 1.0
                    var si = field_start
                    if si < i && bytes[si as usize] == 45 { neg = true; si = si + 1 }
                    while si < i {
                        let b = bytes[si as usize]
                        if b == 46 { seen_dot = true }
                        else if b >= 48 && b <= 57 {
                            if !seen_dot { val = val * 10.0 + ((b - 48) as f64) }
                            else { frac_scale = frac_scale * 0.1; val = val + frac_scale * ((b - 48) as f64) }
                        }
                        si = si + 1
                    }
                    if neg { val = 0.0 - val }
                    FEATURES[(SUBJECT_COUNT * 64 + feature_idx) as usize] = val
                    feature_idx = feature_idx + 1
                }
                field_idx = field_idx + 1
                field_start = i + 1
            }
            i = i + 1
        }
        if label >= 0 && feature_idx >= 8 {
            LABELS[SUBJECT_COUNT as usize] = label
            SITE_KEYS[SUBJECT_COUNT as usize] = site_hash
            SUBJECT_COUNT = SUBJECT_COUNT + 1
        }
        pos = line_end + 1
        }
    }
    SUBJECT_COUNT
}

fn discover_sites() -> i64 with Mut {
    UNIQUE_SITE_COUNT = 0
    var subj: i64 = 0
    while subj < SUBJECT_COUNT {
        let key = SITE_KEYS[subj as usize]
        var exists: i64 = 0
        var i: i64 = 0
        while i < UNIQUE_SITE_COUNT { if UNIQUE_SITES[i as usize] == key { exists = 1; break }; i = i + 1 }
        if exists == 0 && UNIQUE_SITE_COUNT < 64 {
            UNIQUE_SITES[UNIQUE_SITE_COUNT as usize] = key
            UNIQUE_SITE_COUNT = UNIQUE_SITE_COUNT + 1
        }
        subj = subj + 1
    }
    UNIQUE_SITE_COUNT
}

// ─── Model ───

fn ws(i: i64, v: f64) with Mut { W[i as usize] = (v * 100000000.0) as i64 }
fn wg(i: i64) -> f64 with Div { (W[i as usize] as f64) / 100000000.0 }
fn hs(i: i64, v: f64) with Mut { H[i as usize] = (v * 100000000.0) as i64 }
fn hg(i: i64) -> f64 with Div { (H[i as usize] as f64) / 100000000.0 }
fn assoc_s(v: f64) with Mut { ASSOC_ACC = (v * 100000000.0) as i64 }
fn assoc_g() -> f64 with Div { (ASSOC_ACC as f64) / 100000000.0 }

fn init_model() with Mut, Div, Panic {
    var i: i64 = 0
    while i < 10 { ws(i, randf() / 6.0); MOM[i as usize] = 0; i = i + 1 }
    var nsq = 0.0
    i = 0
    while i < 8 { A[i as usize] = randf(); nsq = nsq + A[i as usize] * A[i as usize]; i = i + 1 }
    let n = sqrt_q(nsq)
    i = 0
    while i < 8 {
        if n > 0.000000001 { A[i as usize] = A[i as usize] / n }
        else if i == 0 { A[i as usize] = 1.0 } else { A[i as usize] = 0.0 }
        i = i + 1
    }
}

fn reset_state() with Mut {
    var i: i64 = 0
    while i < 8 { H[i as usize] = 0; i = i + 1 }
    hs(0, 1.0)
    ASSOC_ACC = 0
    LOGIT = 0.0
}

fn do_oct_mul(
    a0: f64, a1: f64, a2: f64, a3: f64, a4: f64, a5: f64, a6: f64, a7: f64,
    b0: f64, b1: f64, b2: f64, b3: f64, b4: f64, b5: f64, b6: f64, b7: f64
) with Mut {
    TMP_OCT[0] = a0*b0 - a1*b1 - a2*b2 - a3*b3 - a4*b4 - a5*b5 - a6*b6 - a7*b7
    TMP_OCT[1] = a0*b1 + a1*b0 + a2*b3 - a3*b2 + a4*b5 - a5*b4 - a6*b7 + a7*b6
    TMP_OCT[2] = a0*b2 + a2*b0 - a1*b3 + a3*b1 + a4*b6 - a6*b4 + a5*b7 - a7*b5
    TMP_OCT[3] = a0*b3 + a3*b0 + a1*b2 - a2*b1 + a4*b7 - a7*b4 - a5*b6 + a6*b5
    TMP_OCT[4] = a0*b4 + a4*b0 - a1*b5 + a5*b1 - a2*b6 + a6*b2 - a3*b7 + a7*b3
    TMP_OCT[5] = a0*b5 + a5*b0 + a1*b4 - a4*b1 - a2*b7 + a7*b2 + a3*b6 - a6*b3
    TMP_OCT[6] = a0*b6 + a6*b0 + a1*b7 - a7*b1 + a2*b4 - a4*b2 - a3*b5 + a5*b3
    TMP_OCT[7] = a0*b7 + a7*b0 - a1*b6 + a6*b1 + a2*b5 - a5*b2 + a3*b4 - a4*b3
}

fn oct_step(x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) with Mut, Div, Panic {
    do_oct_mul(A[0],A[1],A[2],A[3],A[4],A[5],A[6],A[7], hg(0),hg(1),hg(2),hg(3),hg(4),hg(5),hg(6),hg(7))
    let t0=TMP_OCT[0]; let t1=TMP_OCT[1]; let t2=TMP_OCT[2]; let t3=TMP_OCT[3]
    let t4=TMP_OCT[4]; let t5=TMP_OCT[5]; let t6=TMP_OCT[6]; let t7=TMP_OCT[7]
    do_oct_mul(t0,t1,t2,t3,t4,t5,t6,t7, x0,x1,x2,x3,x4,x5,x6,x7)
    var left: [f64; 8] = [0.0; 8]
    var d: i64 = 0
    while d < 8 { left[d as usize] = TMP_OCT[d as usize]; d = d + 1 }
    do_oct_mul(hg(0),hg(1),hg(2),hg(3),hg(4),hg(5),hg(6),hg(7), x0,x1,x2,x3,x4,x5,x6,x7)
    let hx0=TMP_OCT[0]; let hx1=TMP_OCT[1]; let hx2=TMP_OCT[2]; let hx3=TMP_OCT[3]
    let hx4=TMP_OCT[4]; let hx5=TMP_OCT[5]; let hx6=TMP_OCT[6]; let hx7=TMP_OCT[7]
    do_oct_mul(A[0],A[1],A[2],A[3],A[4],A[5],A[6],A[7], hx0,hx1,hx2,hx3,hx4,hx5,hx6,hx7)
    var asq = 0.0
    d = 0
    while d < 8 { let diff = left[d as usize] - TMP_OCT[d as usize]; asq = asq + diff*diff; d = d + 1 }
    var assoc_step = sqrt_q(asq)
    if assoc_step != assoc_step { assoc_step = 0.0 }
    if assoc_step > 1000.0 { assoc_step = 1000.0 }
    assoc_s(assoc_g() + assoc_step)
    d = 0
    while d < 8 {
        var v = left[d as usize] + 0.2 * TMP_OCT[d as usize]
        if v != v { v = 0.0 }
        if v > 5.0 { v = 5.0 } if v < 0.0 - 5.0 { v = 0.0 - 5.0 }
        hs(d, v)
        d = d + 1
    }
}

fn forward_subject(subj: i64) with Mut, Div, Panic {
    reset_state()
    let base = subj * 64
    var step: i64 = 0
    while step < 8 {
        let off = base + step * 8
        oct_step(
            FEATURES[off as usize], FEATURES[(off+1) as usize],
            FEATURES[(off+2) as usize], FEATURES[(off+3) as usize],
            FEATURES[(off+4) as usize], FEATURES[(off+5) as usize],
            FEATURES[(off+6) as usize], FEATURES[(off+7) as usize]
        )
        step = step + 1
    }
    var af = assoc_g() / 8.0
    if af != af { af = 0.0 }
    assoc_s(af)
    var s = wg(9)
    var d: i64 = 0
    while d < 8 {
        var proj = hg(d) * wg(d)
        if proj != proj { proj = 0.0 }
        s = s + proj
        d = d + 1
    }
    var ap = af * wg(8)
    if ap != ap { ap = 0.0 }
    LOGIT = s + ap
}

fn update_binary(target: i64, lr: f64) with Mut, Div, Panic {
    let prob = sigmoid_q(LOGIT)
    var grad = prob - (target as f64)
    if grad > 0.5 { grad = 0.5 } if grad < 0.0 - 0.5 { grad = 0.0 - 0.5 }
    var d: i64 = 0
    while d < 8 {
        let g = hg(d) * grad
        let m = (MOM[d as usize] as f64) / 100000000.0 * 0.9 + g
        MOM[d as usize] = (m * 100000000.0) as i64
        ws(d, wg(d) - lr * m)
        d = d + 1
    }
    let ag = assoc_g() * grad
    let am = (MOM[8] as f64) / 100000000.0 * 0.9 + ag
    MOM[8] = (am * 100000000.0) as i64
    ws(8, wg(8) - lr * am)
    let bm = (MOM[9] as f64) / 100000000.0 * 0.9 + grad
    MOM[9] = (bm * 100000000.0) as i64
    ws(9, wg(9) - lr * bm)
}

// ─── Hessian per window ───

fn compute_loss_subj(subj: i64) -> f64 with Mut, Div, Panic {
    forward_subject(subj)
    let prob = sigmoid_q(LOGIT)
    // Binary target: ictal (label 2) → 1, else → 0
    var target = 0.0
    if LABELS[subj as usize] == 2 { target = 1.0 }
    0.0 - (target * prob + (1.0 - target) * (1.0 - prob))
}

fn compute_subject_hessian(subj: i64) with Mut, Div, Panic {
    let eps = 0.001
    let eps2 = eps * eps
    let f0 = compute_loss_subj(subj)
    var i: i64 = 0
    while i < 8 {
        let orig_i = A[i as usize]
        A[i as usize] = orig_i + eps
        let fip = compute_loss_subj(subj)
        A[i as usize] = orig_i - eps
        let fim = compute_loss_subj(subj)
        A[i as usize] = orig_i
        HESS[i * 8 + i] = ((fip - 2.0 * f0 + fim) / eps2 * 1000000.0) as i64
        var j = i + 1
        while j < 8 {
            let orig_j = A[j as usize]
            A[i as usize] = orig_i + eps
            A[j as usize] = orig_j + eps
            let fpp = compute_loss_subj(subj)
            A[j as usize] = orig_j - eps
            let fpm = compute_loss_subj(subj)
            A[i as usize] = orig_i - eps
            let fmm = compute_loss_subj(subj)
            A[j as usize] = orig_j + eps
            let fmp = compute_loss_subj(subj)
            A[i as usize] = orig_i
            A[j as usize] = orig_j
            let hij = ((fpp - fpm - fmp + fmm) / (4.0 * eps2) * 1000000.0) as i64
            HESS[i * 8 + j] = hij
            HESS[j * 8 + i] = hij
            j = j + 1
        }
        i = i + 1
    }
}

fn subject_offdiag_norm() -> i64 with Mut, Div, Panic {
    var s: i64 = 0
    var i: i64 = 0
    while i < 8 {
        var j: i64 = 0
        while j < 8 {
            if i != j { let v = HESS[i*8+j]; if v < 0 { s = s + (0-v) } else { s = s + v } }
            j = j + 1
        }
        i = i + 1
    }
    s
}

fn subject_diag_norm() -> i64 with Mut, Div, Panic {
    var s: i64 = 0
    var i: i64 = 0
    while i < 8 {
        let v = HESS[i*8+i]
        if v < 0 { s = s + (0-v) } else { s = s + v }
        i = i + 1
    }
    s
}

// ─── Main ───

fn main() -> i32 with IO, Mut, Div, Panic {
    var loaded = load_manifest("seizure_hessian_manifest.tsv")
    if loaded <= 0 {
        loaded = load_manifest("/workspace/sounio/seizure_hessian_manifest.tsv")
    }
    if loaded <= 0 { println("No seizure manifest found"); return 1 }
    discover_sites()

    var ictal_n: i64 = 0
    var inter_n: i64 = 0
    var base_n: i64 = 0
    var subj: i64 = 0
    while subj < SUBJECT_COUNT {
        let lab = LABELS[subj as usize]
        if lab == 2 { ictal_n = ictal_n + 1 }
        else if lab == 1 { inter_n = inter_n + 1 }
        else { base_n = base_n + 1 }
        subj = subj + 1
    }

    println("===============================================================")
    println("  EPILEPSY O-SSM: Hessian Non-Associativity in Seizure EEG")
    println("  CHB-MIT Scalp EEG | Ictal vs Interictal vs Baseline")
    println("===============================================================")
    print("  Windows: "); print_int(SUBJECT_COUNT)
    print(" (ictal="); print_int(ictal_n)
    print(" interictal="); print_int(inter_n)
    print(" baseline="); print_int(base_n); print(")\n")
    print("  Patients: "); print_int(UNIQUE_SITE_COUNT); print("\n")
    println("  Training: ictal(1) vs non-ictal(0)")
    println("  Method: leave-one-patient-out, 8x8 Hessian per test window")
    print("  seed_offset="); print_int(SEED_OFFSET); print("\n")
    println("")

    ICTAL_OD_SUM = 0; ICTAL_DG_SUM = 0; ICTAL_COUNT = 0
    INTER_OD_SUM = 0; INTER_DG_SUM = 0; INTER_COUNT = 0
    BASE_OD_SUM = 0; BASE_DG_SUM = 0; BASE_COUNT = 0

    var fold: i64 = 0
    while fold < UNIQUE_SITE_COUNT {
        let holdout_key = UNIQUE_SITES[fold as usize]
        print("  Fold "); print_int(fold); print("/"); print_int(UNIQUE_SITE_COUNT); print(" ...")

        // Train on non-holdout: binary ictal vs non-ictal
        rng_seed(55555 + holdout_key + SEED_OFFSET, 77777 + holdout_key * 17 + SEED_OFFSET * 31)
        init_model()
        var ep: i64 = 0
        while ep < 80 {
            var seen: i64 = 0
            while seen < 300 {
                subj = (rng_next() / 100) % SUBJECT_COUNT
                if SITE_KEYS[subj as usize] != holdout_key {
                    forward_subject(subj)
                    // Binary target: ictal=1, else=0
                    var bin_target: i64 = 0
                    if LABELS[subj as usize] == 2 { bin_target = 1 }
                    update_binary(bin_target, 0.02)
                }
                seen = seen + 1
            }
            ep = ep + 1
        }

        // Evaluate training accuracy on this fold
        var correct: i64 = 0
        var total: i64 = 0
        subj = 0
        while subj < SUBJECT_COUNT {
            if SITE_KEYS[subj as usize] != holdout_key {
                forward_subject(subj)
                let pred = if LOGIT > 0.0 { 1 } else { 0 }
                var bin_target: i64 = 0
                if LABELS[subj as usize] == 2 { bin_target = 1 }
                if pred == bin_target { correct = correct + 1 }
                total = total + 1
            }
            subj = subj + 1
        }
        print(" train_acc="); print_int(correct * 100 / total); print("%")

        // Test accuracy on holdout
        var test_correct: i64 = 0
        var test_total: i64 = 0
        subj = 0
        while subj < SUBJECT_COUNT {
            if SITE_KEYS[subj as usize] == holdout_key {
                forward_subject(subj)
                let pred = if LOGIT > 0.0 { 1 } else { 0 }
                var bin_target: i64 = 0
                if LABELS[subj as usize] == 2 { bin_target = 1 }
                if pred == bin_target { test_correct = test_correct + 1 }
                test_total = test_total + 1
            }
            subj = subj + 1
        }
        print(" test_acc="); print_int(test_correct * 100 / test_total); print("%")

        // Save trained A
        var ai: i64 = 0
        while ai < 8 { SAVED_A[ai as usize] = A[ai as usize]; ai = ai + 1 }

        // Hessian on holdout windows
        var h_count: i64 = 0
        subj = 0
        while subj < SUBJECT_COUNT {
            if SITE_KEYS[subj as usize] == holdout_key {
                ai = 0
                while ai < 8 { A[ai as usize] = SAVED_A[ai as usize]; ai = ai + 1 }
                compute_subject_hessian(subj)
                let od = subject_offdiag_norm()
                let dg = subject_diag_norm()
                let lab = LABELS[subj as usize]
                if lab == 2 {
                    ICTAL_OD_SUM = ICTAL_OD_SUM + od
                    ICTAL_DG_SUM = ICTAL_DG_SUM + dg
                    ICTAL_COUNT = ICTAL_COUNT + 1
                } else if lab == 1 {
                    INTER_OD_SUM = INTER_OD_SUM + od
                    INTER_DG_SUM = INTER_DG_SUM + dg
                    INTER_COUNT = INTER_COUNT + 1
                } else {
                    BASE_OD_SUM = BASE_OD_SUM + od
                    BASE_DG_SUM = BASE_DG_SUM + dg
                    BASE_COUNT = BASE_COUNT + 1
                }
                h_count = h_count + 1
            }
            subj = subj + 1
        }
        print(" hessians="); print_int(h_count); print("\n")
        fold = fold + 1
    }

    // ─── Results ───
    println("")
    println("===============================================================")
    println("  RESULTS: Seizure EEG Hessian Non-Associativity")
    println("===============================================================")
    print("  Ictal windows tested:      "); print_int(ICTAL_COUNT); print("\n")
    print("  Interictal windows tested:  "); print_int(INTER_COUNT); print("\n")
    print("  Baseline windows tested:    "); print_int(BASE_COUNT); print("\n")

    if ICTAL_COUNT > 0 && INTER_COUNT > 0 && BASE_COUNT > 0 {
        let ictal_od = (ICTAL_OD_SUM as f64) / (ICTAL_COUNT as f64)
        let inter_od = (INTER_OD_SUM as f64) / (INTER_COUNT as f64)
        let base_od = (BASE_OD_SUM as f64) / (BASE_COUNT as f64)
        let ictal_dg = (ICTAL_DG_SUM as f64) / (ICTAL_COUNT as f64)
        let inter_dg = (INTER_DG_SUM as f64) / (INTER_COUNT as f64)
        let base_dg = (BASE_DG_SUM as f64) / (BASE_COUNT as f64)

        println("")
        println("  Mean ||H_offdiag|| (x1e6, non-associative curvature):")
        print("    Ictal:      "); print_int((ictal_od + 0.5) as i64); print("\n")
        print("    Interictal: "); print_int((inter_od + 0.5) as i64); print("\n")
        print("    Baseline:   "); print_int((base_od + 0.5) as i64); print("\n")

        println("")
        println("  Ratios (higher = more path-dependent propagation):")
        if base_od > 0.0 {
            let r_ict_base = ictal_od / base_od
            let r_int_base = inter_od / base_od
            print("    Ictal / Baseline:      "); print_int((r_ict_base * 1000.0 + 0.5) as i64)
            print(" (x1000, expect >>1000)\n")
            print("    Interictal / Baseline: "); print_int((r_int_base * 1000.0 + 0.5) as i64)
            print(" (x1000)\n")
        }
        if inter_od > 0.0 {
            let r_ict_int = ictal_od / inter_od
            print("    Ictal / Interictal:    "); print_int((r_ict_int * 1000.0 + 0.5) as i64)
            print(" (x1000, expect >1000)\n")
        }

        println("")
        println("  Off-diag / Diag ratio (non-associativity fraction):")
        var ictal_frac = 0.0
        if ictal_dg > 0.0 { ictal_frac = ictal_od / ictal_dg }
        var inter_frac = 0.0
        if inter_dg > 0.0 { inter_frac = inter_od / inter_dg }
        var base_frac = 0.0
        if base_dg > 0.0 { base_frac = base_od / base_dg }
        print("    Ictal:      "); print_int((ictal_frac * 1000.0 + 0.5) as i64); print("/1000\n")
        print("    Interictal: "); print_int((inter_frac * 1000.0 + 0.5) as i64); print("/1000\n")
        print("    Baseline:   "); print_int((base_frac * 1000.0 + 0.5) as i64); print("/1000\n")

        println("")
        if ictal_od > inter_od && inter_od > base_od {
            println("  *** HYPOTHESIS CONFIRMED: Ictal > Interictal > Baseline ***")
            println("  Seizure propagation produces the highest non-associative")
            println("  curvature, consistent with path-dependent cortical cascades.")
        } else if ictal_od > base_od {
            println("  Partial support: Ictal > Baseline, but gradient not monotonic")
        } else {
            println("  Hypothesis not supported by this data")
        }
    }

    println("")
    println("DONE")
    0
}
