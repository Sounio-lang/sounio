//@ run-pass
//!
//! Sounio authority declaration of a U250 kernel-artifact blueprint.

use hardware::pireus::u250_material_ingestion::{
    pireus_u250_material_ingest_files,
}
use hardware::pireus::u250_execution_engine::{
    pireus_u250_execution_engine_request,
    pireus_u250_execution_engine_project,
}
use hardware::pireus::u250_fpga_kernel_artifact::{
    pireus_u250_fpga_kernel_artifact_request,
    pireus_u250_fpga_kernel_artifact_project,
    pireus_u250_fpga_kernel_artifact_matches_expected,
    pireus_u250_fpga_kernel_artifact_store,
    pireus_u250_query_kernel_artifacts,
    pireus_u250_query_kernel_arguments,
    pireus_u250_query_artifact_bits,
    pireus_u250_query_artifact_isa,
    pireus_u250_query_artifact_operations,
}
use ontology::query::{triple_store_count, sparql_result_count}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 2 {
        print("usage: pireus_u250_fpga_kernel_artifact <raw-probe> <receipt>\n")
        return 2
    }
    let material = pireus_u250_material_ingest_files(get_arg(0), get_arg(1))
    let engine_request = pireus_u250_execution_engine_request()
    let engine = pireus_u250_execution_engine_project(
        &material, &engine_request)
    let request = pireus_u250_fpga_kernel_artifact_request()
    let result = pireus_u250_fpga_kernel_artifact_project(&engine, &request)
    var store = pireus_u250_fpga_kernel_artifact_store(&engine, &result)
    let artifacts = pireus_u250_query_kernel_artifacts(&store)
    let arguments = pireus_u250_query_kernel_arguments(&store)
    let bits = pireus_u250_query_artifact_bits(&store)
    let isa = pireus_u250_query_artifact_isa(&store)
    let operations = pireus_u250_query_artifact_operations(&store)

    let triples = triple_store_count(&store)
    let artifact_count = sparql_result_count(&artifacts)
    let argument_count = sparql_result_count(&arguments)
    let bits_count = sparql_result_count(&bits)
    let isa_count = sparql_result_count(&isa)
    let operation_count = sparql_result_count(&operations)

    print("SOUNIO_SEMANTIC_AUTHORITY schema=pireus.u250-fpga-kernel-artifact.v0 stage=SOUNIO_EXECUTABLE\n")
    print("PIREUS_U250_FPGA_KERNEL_ARTIFACT valid=")
    print_int(yes(result.valid))
    print(" status="); print_int(result.status)
    print(" engine="); print_int(result.engine)
    print(" kernel="); print_int(result.kernel_symbol)
    print(" format="); print_int(result.artifact_format)
    print(" platform="); print_int(result.platform)
    print(" frequency_mhz="); print_int(result.target_frequency_mhz)
    print(" abi_arguments="); print_int(result.abi_argument_count)
    print(" input_buffers="); print_int(result.input_buffer_count)
    print(" scalar_inputs="); print_int(result.scalar_input_count)
    print(" output_buffers="); print_int(result.output_buffer_count)
    print(" m_axi="); print_int(result.m_axi_argument_count)
    print(" s_axilite="); print_int(result.s_axilite_argument_count)
    print(" bitstream_present="); print_int(yes(result.bitstream_present))
    print(" abi_parity_open="); print_int(yes(result.abi_parity_open))
    print(" execution_observed=")
    print_int(yes(result.kernel_execution_observed))
    print(" correctness_present=")
    print_int(yes(result.kernel_correctness_present))
    print(" lowering_authorized=")
    print_int(yes(result.lowering_authorized))
    print(" artifact_parity_open=")
    print_int(yes(result.artifact_parity_open))
    print(" claim_ready="); print_int(yes(result.claim_ready))
    print(" failures="); print_int(result.failures)
    print("\n")
    print("PIREUS_U250_KERNEL_ARTIFACT_GRAPH triples="); print_int(triples)
    print(" artifacts="); print_int(artifact_count)
    print(" arguments="); print_int(argument_count)
    print(" bits_edges="); print_int(bits_count)
    print(" isa_edges="); print_int(isa_count)
    print(" operation_edges="); print_int(operation_count)
    print("\n")

    if pireus_u250_fpga_kernel_artifact_matches_expected(&result) &&
        triples == 420 && artifact_count == 1 && argument_count == 8 &&
        bits_count == 0 && isa_count == 0 && operation_count == 0 {
        0
    } else { 1 }
}
