//@ run-pass
//!
//! Sounio semantic-authority extraction of Intel VPERMPD selector semantics.

use hardware::pireus::intel_vpermpd_semantics::{
    pireus_intel_vpermpd_evaluate,
    pireus_intel_pdf_expected_sha256,
    pireus_intel_material_semantics_sha256,
    pireus_intel_material_receipt_sha256,
    PIREUS_INTEL_PDF_OK,
}

fn bool_as_i64(value: bool) -> i64 { if value { 1 } else { 0 } }

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 2 {
        print("usage: pireus_intel_vpermpd_semantics <326018-092-sdm-vol-2c.pdf> <avx512-foundation-isa.xed.txt>\n")
        return 2
    }

    let pdf_path = get_arg(0)
    let xed_path = get_arg(1)
    let result = pireus_intel_vpermpd_evaluate(pdf_path, xed_path)
    let probe = result.pdf
    var failures = result.failures
    if !result.valid || result.error != PIREUS_INTEL_PDF_OK {
        failures = failures + 1
    }
    if !result.parent_valid ||
        !result.selector_semantics_receipt_present {
        failures = failures + 1
    }
    if result.vector_bits != 512 || result.element_bits != 64 ||
        result.index_element_bits != 64 || result.selector_bits != 3 ||
        result.selector_mask != 7 || result.source_lanes != 8 {
        failures = failures + 1
    }
    if result.semantic_formula_cells != 8 ||
        result.xor_selector_cells != 256 ||
        result.xor_selector_matches != 256 ||
        result.xor_selector_failures != 0 ||
        result.abstract_form_applications != 32 ||
        !result.vector_control_complete {
        failures = failures + 1
    }
    if result.imm8_patterns_tested != 8 ||
        result.imm8_patterns_supported != 4 ||
        result.imm8_patterns_refused != 4 || result.imm8_complete {
        failures = failures + 1
    }
    if !result.one_source_form_sufficient ||
        result.two_source_form_required ||
        !result.instruction_match_authorized {
        failures = failures + 1
    }
    if result.material_observation_count != 0 ||
        result.lowering_count != 0 || result.cost_record_count != 0 ||
        result.parity_open || result.claim_ready {
        failures = failures + 1
    }
    if result.negative_witnesses_passed != 18 ||
        result.negative_witnesses_total != 18 {
        failures = failures + 1
    }

    print("SOUNIO_AUTHORITY schema=pireus-intel-vpermpd-selector-semantics.v1 role=SEMANTIC_AUTHORITY\n")
    print("PIREUS_INTEL_PARENT material_semantics_sha256=")
    print(pireus_intel_material_semantics_sha256())
    print(" material_receipt_sha256=")
    print(pireus_intel_material_receipt_sha256())
    print(" live_match="); print_int(bool_as_i64(result.parent_valid)); print("\n")
    print("PIREUS_INTEL_PDF manual_version=092 volume=2C bytes=")
    print_int(probe.total_bytes); print(" sha256=")
    print(pireus_intel_pdf_expected_sha256())
    print(" digest_match="); print_int(bool_as_i64(probe.digest_match))
    print(" header_pdf_1_6="); print_int(bool_as_i64(probe.header_match)); print("\n")
    print("PIREUS_INTEL_ENVELOPE eof_offset="); print_int(probe.eof_offset)
    print(" startxref_offset="); print_int(probe.startxref_offset)
    print(" classic="); print_int(bool_as_i64(probe.startxref_classic))
    print(" indirect_object=")
    print_int(bool_as_i64(probe.startxref_indirect_object)); print("\n")
    print("PIREUS_INTEL_STREAMS markers="); print_int(probe.stream_markers)
    print(" flate="); print_int(probe.flate_streams)
    print(" decoded="); print_int(probe.decoded_flate_streams)
    print(" oversized_output="); print_int(probe.oversized_flate_outputs)
    print(" oversized_offset=")
    print_int(probe.oversized_output_stream_offset)
    print(" oversized_objstm=")
    print_int(bool_as_i64(probe.oversized_output_object_stream))
    print(" oversized_xref=")
    print_int(bool_as_i64(probe.oversized_output_xref))
    print(" oversized_image=")
    print_int(bool_as_i64(probe.oversized_output_image))
    print(" oversized_font=")
    print_int(bool_as_i64(probe.oversized_output_font))
    print(" oversized_content_candidate=")
    print_int(bool_as_i64(probe.oversized_output_content_candidate))
    print(" failures="); print_int(probe.flate_decode_failures); print("\n")
    print("PIREUS_INTEL_LINEAGE description_page=5-522 description_stream=")
    print_int(probe.first_vpermpd_stream_offset)
    print(" operation_page=5-524 operation_stream=")
    print_int(probe.first_operation_stream_offset); print("\n")
    print("PIREUS_INTEL_ANCHORS description_page=")
    print_int(probe.description_page_matches)
    print(" vector_form="); print_int(probe.vector_form_matches)
    print(" description_rule=")
    print_int(probe.description_selector_rule_matches)
    print(" operation_page="); print_int(probe.operation_page_matches)
    print(" operation_form="); print_int(probe.operation_vector_form_matches)
    print(" operation_cells="); print_int(probe.operation_selector_cells)
    print(" semantics_receipt=")
    print_int(bool_as_i64(result.selector_semantics_receipt_present)); print("\n")
    print("PIREUS_INTEL_SELECTOR form=EVEX_512_VECTOR_CONTROL vector_bits=")
    print_int(result.vector_bits)
    print(" element_bits="); print_int(result.element_bits)
    print(" index_element_bits="); print_int(result.index_element_bits)
    print(" selector_bits="); print_int(result.selector_bits)
    print(" selector_mask="); print_int(result.selector_mask)
    print(" source_lanes="); print_int(result.source_lanes); print("\n")
    print("PIREUS_INTEL_XOR_MATCH cells="); print_int(result.xor_selector_cells)
    print(" matched="); print_int(result.xor_selector_matches)
    print(" failures="); print_int(result.xor_selector_failures)
    print(" abstract_form_applications=")
    print_int(result.abstract_form_applications)
    print(" vector_complete=")
    print_int(bool_as_i64(result.vector_control_complete)); print("\n")
    print("PIREUS_INTEL_IMM8 patterns="); print_int(result.imm8_patterns_tested)
    print(" supported="); print_int(result.imm8_patterns_supported)
    print(" refused="); print_int(result.imm8_patterns_refused)
    print(" complete="); print_int(bool_as_i64(result.imm8_complete)); print("\n")
    print("PIREUS_INTEL_MATERIAL one_source_form_sufficient=")
    print_int(bool_as_i64(result.one_source_form_sufficient))
    print(" two_source_form_required=")
    print_int(bool_as_i64(result.two_source_form_required))
    print(" instruction_match_authorized=")
    print_int(bool_as_i64(result.instruction_match_authorized)); print("\n")
    print("PIREUS_INTEL_NEGATIVES passed=")
    print_int(result.negative_witnesses_passed)
    print(" total="); print_int(result.negative_witnesses_total); print("\n")
    print("PIREUS_INTEL_BOUNDARY material_observations=")
    print_int(result.material_observation_count)
    print(" lowerings="); print_int(result.lowering_count)
    print(" costs="); print_int(result.cost_record_count)
    print(" parity_open="); print_int(bool_as_i64(result.parity_open))
    print(" claim_ready="); print_int(bool_as_i64(result.claim_ready)); print("\n")
    print("PIREUS_INTEL_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(failures); print("\n")

    if failures == 0 { 0 } else { 1 }
}
