//@ run-pass
// Monte Carlo smoke test using a simple PRNG and integer fixed-point output.
// This is not a statistical-quality claim about the generator.

fn lcg_next(seed: i64) -> i64 with Mut, Panic, Div {
    let a: i64 = 1103515245
    let c: i64 = 12345
    let m: i64 = 2147483648
    ((a * seed + c) % m)
}

fn abs_i64(x: i64) -> i64 {
    if x < 0 { 0 - x } else { x }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let n: i64 = 10000
    var inside: i64 = 0
    var seed: i64 = 42
    var i: i64 = 0
    while i < n {
        seed = lcg_next(seed)
        let x = abs_i64(seed % 10000)
        seed = lcg_next(seed)
        let y = abs_i64(seed % 10000)
        if x * x + y * y <= 10000 * 10000 {
            inside = inside + 1
        }
        i = i + 1
    }
    // Thousandths of pi: an estimate near 3.142 is represented as 3142.
    let pi_times_1000 = (4 * inside * 1000) / n
    assert(pi_times_1000 > 2900)
    assert(pi_times_1000 < 3300)
    println("Monte Carlo pi: PASS")
    0
}
