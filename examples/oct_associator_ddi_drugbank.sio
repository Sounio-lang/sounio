fn row_asym(i: i64) -> f64 {
    if i ==  0 { return 0.2000 }
    if i ==  1 { return 0.0392 }
    if i ==  2 { return 0.0660 }
    if i ==  3 { return 0.0088 }
    if i ==  4 { return 0.0816 }
    if i ==  5 { return 0.5741 }
    if i ==  6 { return 0.4638 }
    if i ==  7 { return 0.3672 }
    if i ==  8 { return 0.3193 }
    if i ==  9 { return 0.2173 }
    if i == 10 { return 0.1709 }
    if i == 11 { return 0.2294 }
    if i == 12 { return 0.1468 }
    if i == 13 { return 0.1853 }
    if i == 14 { return 0.0932 }
    if i == 15 { return 0.2857 }
    if i == 16 { return 0.1933 }
    if i == 17 { return 0.0235 }
    if i == 18 { return 0.0000 }
    if i == 19 { return 0.2184 }
    if i == 20 { return 0.3113 }
    if i == 21 { return 0.2319 }
    if i == 22 { return 0.2325 }
    if i == 23 { return 0.2286 }
    if i == 24 { return 0.0039 }
    if i == 25 { return 0.0195 }
    if i == 26 { return 0.2377 }
    if i == 27 { return 0.0182 }
    if i == 28 { return 0.0302 }
    if i == 29 { return 0.1653 }
    if i == 30 { return 0.0457 }
    if i == 31 { return 0.1814 }
    if i == 32 { return 0.0913 }
    if i == 33 { return 0.0383 }
    0.1006
}

fn n_rows() -> i64 { 35 }

fn main() -> i32 with IO, Mut, Div, Panic {
    println("═══════════════════════════════════════════════════════")
    println("  DDI expanded: DrugBank FAERS (85042 total cases)")
    println("  35 CYP triples, all with temporal data")
    println("  Zero free parameters in predictor.")
    println("═══════════════════════════════════════════════════════")
    println("")

    var n: i64 = n_rows()
    var row_an:   [f64; 35] = [0.0; 35]
    var row_alg0: [i64; 35] = [0; 35]

    var i: i64 = 0
    while i < n {
        let an: f64 = assoc_norm(row_a(i), row_b(i), row_c(i))
        row_an[i] = an
        if an < 0.001 { row_alg0[i] = 1 } else { row_alg0[i] = 0 }
        i = i + 1
    }

    // Collect asymmetry by group (all 35 valid)
    var asym_alg0:  [f64; 35] = [0.0; 35]
    var asym_algnz: [f64; 35] = [0.0; 35]
    var n_alg0:  i64 = 0
    var n_algnz: i64 = 0

    i = 0
    while i < n {
        let asym_val: f64 = row_asym(i)
        if row_alg0[i] == 1 {
            asym_alg0[n_alg0] = asym_val
            n_alg0 = n_alg0 + 1
        } else {
            asym_algnz[n_algnz] = asym_val
            n_algnz = n_algnz + 1
        }
        i = i + 1
    }

    var sum_a0: f64 = 0.0
    var ssq_a0: f64 = 0.0
    var k: i64 = 0
    while k < n_alg0 {
        sum_a0 = sum_a0 + asym_alg0[k]
        ssq_a0 = ssq_a0 + asym_alg0[k] * asym_alg0[k]
        k = k + 1
    }
    var sum_anz: f64 = 0.0
    var ssq_anz: f64 = 0.0
    var m: i64 = 0
    while m < n_algnz {
        sum_anz = sum_anz + asym_algnz[m]
        ssq_anz = ssq_anz + asym_algnz[m] * asym_algnz[m]
        m = m + 1
    }

    let mean_a0:  f64 = sum_a0  / (n_alg0  as f64)
    let mean_anz: f64 = sum_anz / (n_algnz as f64)
    var var_a0: f64 = ssq_a0 / (n_alg0 as f64) - mean_a0 * mean_a0
    var var_anz: f64 = ssq_anz / (n_algnz as f64) - mean_anz * mean_anz
    if var_a0 < 0.0 { var_a0 = 0.0 }
    if var_anz < 0.0 { var_anz = 0.0 }

    let sd_a0: f64 = sqrt_s(var_a0)
    let sd_anz: f64 = sqrt_s(var_anz)
    var pooled: f64 = 0.0
    if n_alg0 + n_algnz > 2 {
        let num: f64 = (n_alg0 as f64) * var_a0 + (n_algnz as f64) * var_anz
        let den: f64 = (n_alg0 as f64) + (n_algnz as f64)
        pooled = sqrt_s(num / den)
    }
    var cohens_d: f64 = 0.0
    if pooled > 0.0001 { cohens_d = (mean_anz - mean_a0) / pooled }

    println("=== H1: |asymmetry| by Fano group (all 35 rows) ===")
    print("  Fano=1 (n="); print_int(n_alg0)
    print(")  mean|asym|="); print(mean_a0)
    print("  sd="); print(sd_a0); println("")
    print("  Fano=0 (n="); print_int(n_algnz)
    print(")  mean|asym|="); print(mean_anz)
    print("  sd="); print(sd_anz); println("")
    print("  Cohen's d = "); print(cohens_d); println("")
    println("")

    // H2: total cases by group
    var cases_f: i64 = 0
    var cases_nf: i64 = 0
    var tr_f: i64 = 0
    var tr_nf: i64 = 0
    i = 0
    while i < n {
        let cc: i64 = row_cases(i)
        if row_alg0[i] == 1 { cases_f = cases_f + cc; tr_f = tr_f + 1 }
        else                { cases_nf = cases_nf + cc; tr_nf = tr_nf + 1 }
        i = i + 1
    }

    println("=== H2: total adverse events by Fano group ===")
    print("  Fano=1 ("); print_int(tr_f)
    print(" triples)  cases="); print_int(cases_f)
    print("  mean="); print((cases_f as f64) / (tr_f as f64)); println("")
    print("  Fano=0 ("); print_int(tr_nf)
    print(" triples)  cases="); print_int(cases_nf)
    print("  mean="); print((cases_nf as f64) / (tr_nf as f64)); println("")
    println("")

    // Permutation test: 1000 shuffles of the Fano label
    println("=== Permutation test (1000 shuffles) ===")
    let observed_diff: f64 = abs_s(mean_anz - mean_a0)
    print("  Observed |mean_nf - mean_f| = "); print(observed_diff); println("")

    var all_asym: [f64; 35] = [0.0; 35]
    i = 0
    while i < n {
        all_asym[i] = row_asym(i)
        i = i + 1
    }

    var rng: RngState = rng_new(42)
    var count_ge: i64 = 0
    var perm: i64 = 0
    while perm < 1000 {
        // Fisher-Yates shuffle of all_asym
        var shuf: [f64; 35] = [0.0; 35]
        var si: i64 = 0
        while si < 35 {
            shuf[si] = all_asym[si]
            si = si + 1
        }
        var j: i64 = 34
        while j > 0 {
            let r: (i64, RngState) = rng_next(rng)
            rng = r.1
            var ri: i64 = r.0 % (j + 1)
            if ri < 0 { ri = 0 - ri }
            let tmp: f64 = shuf[j]
            shuf[j] = shuf[ri]
            shuf[ri] = tmp
            if j == 1 { break }
            j = j - 1
        }

        // First n_alg0 elements are "Fano", rest are "non-Fano"
        var perm_sum_f: f64 = 0.0
        var perm_sum_nf: f64 = 0.0
        var pi: i64 = 0
        while pi < n_alg0 {
            perm_sum_f = perm_sum_f + shuf[pi]
            pi = pi + 1
        }
        pi = n_alg0
        while pi < 35 {
            perm_sum_nf = perm_sum_nf + shuf[pi]
            pi = pi + 1
        }
        let perm_mean_f: f64 = perm_sum_f / (n_alg0 as f64)
        let perm_mean_nf: f64 = perm_sum_nf / (n_algnz as f64)
        let perm_diff: f64 = abs_s(perm_mean_nf - perm_mean_f)
        if perm_diff >= observed_diff { count_ge = count_ge + 1 }
        perm = perm + 1
    }

    let p_value: f64 = (count_ge as f64) / 1000.0
    print("  count >= observed: "); print_int(count_ge); print("/1000"); println("")
    print("  p-value = "); print(p_value); println("")
    if p_value < 0.05 {
        println("  ** SIGNIFICANT at alpha=0.05 **")
    } else {
        if p_value < 0.10 {
            println("  Marginal (0.05 < p < 0.10)")
        } else {
            println("  Not significant (p >= 0.10)")
        }
    }
    println("")

    // ── Assertions ──
    var passed: i32 = 0
    var failed: i32 = 0

    // T1: all 35 associator norms are binary (0 or 2)
    var binary_ok: bool = true
    var kk: i64 = 0
    while kk < n {
        let an: f64 = row_an[kk]
        let near0: bool = an < 0.001
        let near2: bool = if an > 1.9 { an < 2.1 } else { false }
        if near0 == false {
            if near2 == false { binary_ok = false }
        }
        kk = kk + 1
    }
    if binary_ok {
        println("T1 PASS: all 35 norms are binary (0 or 2)")
        passed = passed + 1
    } else {
        println("T1 FAIL: non-binary associator norm found")
        failed = failed + 1
    }

    // T2: both groups have adequate sample sizes
    if n_alg0 >= 5 {
        if n_algnz >= 20 {
            print("T2 PASS: sufficient sample ("); print_int(n_alg0)
            print(" Fano, "); print_int(n_algnz); println(" non-Fano)")
            passed = passed + 1
        } else {
            println("T2 FAIL: too few non-Fano rows")
            failed = failed + 1
        }
    } else {
        println("T2 FAIL: too few Fano rows")
        failed = failed + 1
    }

    // T3: REPORT direction
    print("T3 REPORT: delta = "); print(mean_anz - mean_a0)
    print("  d="); print(cohens_d); println("")
    if cohens_d > 0.0 {
        println("           non-Fano MORE asymmetric (matches algebra)")
    } else {
        println("           non-Fano LESS asymmetric (unexpected)")
    }
    passed = passed + 1

    // T4: REPORT cases direction
    let dcases: f64 = (cases_nf as f64) / (tr_nf as f64) - (cases_f as f64) / (tr_f as f64)
    print("T4 REPORT: mean cases delta = "); print(dcases); println("")
    passed = passed + 1

    // T5: both groups exist
    var count_zero: i64 = 0
    var count_nonzero: i64 = 0
    var tt: i64 = 0
    while tt < n {
        if row_alg0[tt] == 1 { count_zero = count_zero + 1 }
        else { count_nonzero = count_nonzero + 1 }
        tt = tt + 1
    }
    if count_zero >= 1 {
        if count_nonzero >= 1 {
            print("T5 PASS: "); print_int(count_zero); print(" assoc, ")
            print_int(count_nonzero); println(" non-assoc triples")
            passed = passed + 1
        } else {
            println("T5 FAIL: no non-associative triples")
            failed = failed + 1
        }
    } else {
        println("T5 FAIL: no associative triples")
        failed = failed + 1
    }

    println("")
    print("Passed: "); print_int(passed); println("")
    print("Failed: "); print_int(failed); println("")
    if failed == 0 { println("ALL PASS") } else { println("SOME TESTS FAILED") }
    failed
}
