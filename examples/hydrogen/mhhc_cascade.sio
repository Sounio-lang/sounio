// examples/hydrogen/mhhc_cascade.sio
//
// The seven-stage metal-hydride compressor of Gkanas et al. 2020, run as a
// COUPLED cascade on the paper's own measured thermodynamics, with no
// fitted efficiency anywhere.
//
// THE QUESTION THIS ASKS. The existing Sounio demo (demos/hydrogen/
// mh7_reliability.sio) reproduces the paper's headline ratios by fitting
// three quantities to them -- a lumped eta, a swing exponent, and a supply
// pressure back-solved from the target. Fed the paper's MEASURED Table 3,
// that same ratio-chain model returns 6640x instead of 18.7x, which says
// the model form is wrong rather than its parameters. This file asks what
// the coupled model gives instead, and reports the answer whatever it is.
//
// WHAT IS MEASURED AND WHAT IS CHOSEN, before any number is printed:
//
//   MEASURED, from the paper (data/gkanas2020_seven_stage.md):
//     per-stage dH and dS, absorption and desorption, all seven stages
//     alloy masses 31 kg (S1) and 29.5 kg (S2-S7)
//     SS 316L shell 136 kg per stage
//     0.425 kg H2 per cycle, from which the capacity is derived
//     bed geometry L = 12 m, R = 21.4 mm
//     supply 20 bar; the reference results 374 bar / 18.7x / 6625 s at 80 C
//
//   SOURCED ELSEWHERE, because the paper cites its kinetics to a reference
//   without giving values:
//     C_a = 59.187 1/s, E_a = 21179.6 J/mol
//     C_d = 9.57 1/s,   E_d = 16420 J/mol
//   These are the LaNi5 constants of Jemni & Ben Nasrallah (Int. J.
//   Hydrogen Energy 1995), the standard set in this literature. They are
//   NOT the AB2 constants of the paper's stages 2-7, and that substitution
//   is the single largest declared approximation in this file.
//
//   CHOSEN, and varied below rather than tuned:
//     the bed-to-fluid conductance UA, from the bed area 2*pi*R*L = 1.61 m2
//     and a water-side coefficient in the usual range
//     the interconnector volume V_ic, which the paper does not state
//
// Nothing here is adjusted to make an output match. Where the model misses,
// the miss is printed.

use hydride::mhhc::*

fn print_fix3(x: f64) with IO, Mut, Div, Panic {
    let neg = x < 0.0
    var v = if neg { 0.0 - x } else { x }
    let scaled = v * 1000.0
    var n = scaled as i64
    let frac = scaled - (n as f64)
    if frac >= 0.5 { n = n + 1 }
    let whole = n / 1000
    let milli = n - whole * 1000
    if neg { print("-") }
    print(whole) print(".")
    if milli < 100 { print("0") }
    if milli < 10 { print("0") }
    print(milli)
}

fn bed_for(stage: i64, ua: f64) -> HydrideBed with Mut, Div, Panic {
    gkanas_bed(stage, 419.0, 500.0, ua)
}

// One coupling: bed `hot` desorbing at t_hot into bed `cold` absorbing at
// t_cold, through v_ic. Returns, through `rep`, what run_coupling reports.
fn couple(stage_hot: i64, stage_cold: i64, x_hot0: f64, x_cold0: f64,
          n_ic0: f64, t_hot: f64, t_cold: f64, ua: f64, v_ic: f64,
          kin: HydrideKinetics, shape: PlateauShape,
          out: &![f64; 8], rep: &![f64; 8]) with Mut, Div, Panic {
    var s0: [f64; 8] = [0.0; 8]
    s0[0] = x_hot0
    s0[1] = x_cold0
    s0[2] = n_ic0
    s0[3] = t_hot
    s0[4] = t_cold
    run_coupling(&s0, bed_for(stage_hot, ua), bed_for(stage_cold, ua), kin, shape,
                 v_ic, 300.0, t_hot, t_cold, 0.02, 600000 as i64, 1.0e-10, out, rep)
}

fn main() -> i32 with Mut, Div, Panic, IO {
    let kin = HydrideKinetics { c_abs: 59.187, e_abs: 21179.6, c_des: 9.57, e_des: 16420.0 }
    let shape = flat_plateau()
    let t_cold = 283.15    // 10 C, the paper's hydrogenation temperature
    let t_hot = 353.15     // 80 C, the paper's Case 1
    let ua = 2420.0        // W/K, from 2*pi*R*L = 1.61 m2 at h = 1500 W/m2K
    let v_ic = 0.005       // m3, NOT given by the paper

    println("SEVEN-STAGE MH COMPRESSOR, COUPLED MODEL, MEASURED THERMODYNAMICS")
    println("Gkanas et al. 2020, Renewable Energy 147:164-178. Case 1, 10 -> 80 C.")
    println("")
    println("Reference results from the paper: 374 bar, ratio 18.7, cycle 6625 s.")
    println("No fitted efficiency is used anywhere below.")
    println("")

    println("-- per-stage plateau pressures from the measured Table 3 --")
    var s: i64 = 0
    while s < 7 {
        let pa = p_eq_flat(gkanas_dh_abs(s), gkanas_ds_abs(s), t_cold)
        let pd = p_eq_flat(gkanas_dh_des(s), gkanas_ds_des(s), t_hot)
        print("  S") print(s + 1)
        print("  P_abs(10C)= ") print_fix3(pa)
        print(" bar   P_des(80C)= ") print_fix3(pd)
        println(" bar")
        s = s + 1
    }
    println("")

    println("-- the six couplings, integrated --")
    var out: [f64; 8] = [0.0; 8]
    var rep: [f64; 8] = [0.0; 8]
    var total_time = 0.0
    var total_drift = 0.0
    var unconverged: i64 = 0
    var x_prev = 1.0        // stage 1 arrives fully loaded from the 20 bar supply
    var k: i64 = 0
    while k < 6 {
        couple(k, k + 1, x_prev, 0.0, 0.05, t_hot, t_cold, ua, v_ic, kin, shape, &! out, &! rep)
        print("  S") print(k + 1) print(" -> S") print(k + 2)
        print("   P= ") print_fix3(rep[1]) print(" bar")
        print("   moved= ") print_fix3(rep[2]) print(" mol")
        print("   t= ") print_fix3(rep[0]) print(" s")
        print("   drift= ") print_fix3(rep[3] * 1000000.0) print(" ppm")
        if rep[4] > 0.5 { println("   [converged]") } else { unconverged = unconverged + 1; println("   [NOT CONVERGED]") }
        total_time = total_time + rep[0]
        if rep[3] > total_drift { total_drift = rep[3] }
        x_prev = out[1]
        k = k + 1
    }
    println("")

    // Stage 7 delivers by desorbing at t_hot; its plateau at the loading it
    // reached is the pressure it can hold against the delivery line.
    // READ THIS BEFORE READING THE NUMBER BELOW.
    //
    // `shape` here is flat_plateau(), which is sigma = 0 and hyst = 0, and with
    // sigma = 0 the slope term of p_eq_pct vanishes identically. So this
    // call does NOT depend on x_prev. The delivery pressure printed below is
    // the stage-7 desorption plateau from van 't Hoff on the measured dH and
    // dS -- the same 561.549 bar already printed in the plateau table at the
    // top of this run, before any integration happened.
    //
    // Which means: the six couplings above, the loading carried from stage to
    // stage, and the 15973 s of integrated time contribute NOTHING to the
    // headline ratio. Sweeping the six unmeasured inputs over 64 corners moves
    // S7's final loading across [0.000, 0.902] and moves this number by zero
    // digits (examples/hydrogen/mhhc_corner_pbox.sio). The "1.5x
    // overprediction against the paper" is therefore not a property of the
    // coupled model at all; it is stage 7's free van 't Hoff plateau against
    // the paper's delivered pressure, and the ratio-chain model this file was
    // written to improve on would give the same last factor.
    //
    // The paper's own eq. 11 has the slope term, and the data note records
    // that it does not give sigma_s, sigma_0 or Y. Pinning sigma at 0 was a
    // choice made here, not a value taken from anywhere, and it is the choice
    // that made the cascade decorative for this number. The corner p-box
    // carries sigma as an interval instead; hysteresis stays at zero there for
    // a physical reason -- the gap between dh_abs and dh_des already IS the
    // hysteresis, so the paper's Y term on top would count it twice.
    //
    // What the integration DOES determine, and what this file can still claim:
    // the loading actually reached at each stage, the time, and the inventory
    // drift. Those respond to everything. The delivery pressure does not.
    let p_deliver = p_eq_pct(gkanas_dh_des(6), gkanas_ds_des(6), t_hot, x_prev, shape, false)
    print("  S7 loading after the cascade : ") print_fix3(x_prev) println("")
    print("  S7 delivery plateau at 80 C  : ") print_fix3(p_deliver) println(" bar")
    print("  ratio against the 20 bar feed: ") print_fix3(p_deliver / 20.0) println("")
    print("  summed coupling time         : ") print_fix3(total_time) println(" s")
    print("  worst inventory drift        : ") print_fix3(total_drift * 1000000.0) println(" ppm")
    println("")

    println("-- against the paper --")
    print("  delivery  model ") print_fix3(p_deliver) print(" bar   vs paper 374 bar")
    println("")
    print("  ratio     model ") print_fix3(p_deliver / 20.0) print("      vs paper 18.7")
    println("")
    print("  couplings model ") print_fix3(total_time) print(" s     vs paper 6625 s (full cycle,")
    println(" which also includes heating and cooling this model does not time)")
    println("")

    // -- the structural check the paper does not perform on itself --
    //
    // S7's desorption plateau at the dehydrogenation temperature is the
    // highest pressure the last stage can hold. Whatever the system
    // actually delivers into a receiving vessel must sit BELOW it. That
    // makes the plateau a bound, computable from Table 3 alone, on every
    // delivered pressure in Table 4 -- and it holds in all six cases,
    // which is a consistency check between the paper's own two tables.
    println("-- Table 3 bounds Table 4, in all six reported cases --")
    var cases_ok: i64 = 0
    var ci: i64 = 0
    while ci < 6 {
        var t_case = 353.15
        var p_paper = 374.0
        if ci == 1 { t_case = 363.15; p_paper = 483.2 }
        if ci == 2 { t_case = 373.15; p_paper = 606.4 }
        if ci == 3 { t_case = 378.15; p_paper = 682.0 }
        if ci == 4 { t_case = 383.15; p_paper = 742.0 }
        if ci == 5 { t_case = 393.15; p_paper = 830.0 }
        let p_plateau = p_eq_flat(gkanas_dh_des(6), gkanas_ds_des(6), t_case)
        print("  case ") print(ci + 1)
        print("  T_des= ") print_fix3(t_case - 273.15) print(" C")
        print("   S7 plateau= ") print_fix3(p_plateau) print(" bar")
        print("   paper delivered= ") print_fix3(p_paper) print(" bar")
        print("   bound/delivered= ") print_fix3(p_plateau / p_paper)
        if p_plateau > p_paper { cases_ok = cases_ok + 1; println("   [bound holds]") }
        else { println("   [BOUND VIOLATED]") }
        ci = ci + 1
    }
    print("  bound holds in ") print(cases_ok) println(" of 6 cases")
    println("")
    if cases_ok < 6 {
        println("  REFUSING TO INTERPRET: the measured thermodynamics do not bound")
        println("  the reported deliveries, which would mean one of the two tables")
        println("  is inconsistent with the other.")
        return 1
    }

    if unconverged > 0 {
        print("  REFUSING TO INTERPRET: ") print(unconverged) println(" coupling(s) did not converge.")
        return 1
    }
    if total_drift > 1.0e-9 {
        println("  REFUSING TO INTERPRET: hydrogen inventory drifted.")
        return 1
    }
    println("MHHC_CASCADE_OK")
    0
}
