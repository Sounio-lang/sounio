//@ run-pass
//@ description: WP25 data-driven HVP LO is absent; hybrid lattice path still sums
//
// Table 5: estimates not provided. Sounio does not invent 6931/7132/7045
// as a data-driven LO. The slot is Wp25DdHvpLoAbsent, not Epistemic.
// The hybrid remains a citation sum.
//
// Run:
//   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib
//   ./bin/souc run examples/particle_physics/a_mu_wp25_dd_hvp_lo_absent.sio

use particle_physics::ew_precision::{
    a_mu_wp25_datadriven_hvp_lo_provided, a_mu_hvp_lo_datadriven_wp25,
    a_mu_hvp_wp25_assembled, a_mu_hvp_wp25, a_mu_hvp_lo_wp20,
    a_mu_hvp_lo_lattice_wp25, Wp25DdHvpLoAbsent,
}
use epistemic::knowledge::{ep_val, ep_std}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn hold_absent(x: Wp25DdHvpLoAbsent) -> bool {
    x.provided
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let provided = a_mu_wp25_datadriven_hvp_lo_provided()
    let slot = a_mu_hvp_lo_datadriven_wp25()
    let asm = a_mu_hvp_wp25_assembled()
    let pub25 = a_mu_hvp_wp25()
    let lo20 = a_mu_hvp_lo_wp20()
    let lo_lat = a_mu_hvp_lo_lattice_wp25()

    print("WP25_DD_HVP_LO_PROVIDED ")
    if provided { print("1\n") } else { print("0\n") }
    print("HVP_ASSEMBLED ")
    print_f64(ep_val(&asm))
    print("\nHVP_PUBLISHED ")
    print_f64(ep_val(&pub25))
    print("\nHVP_LO_WP20 ")
    print_f64(ep_val(&lo20))
    print("\nHVP_LO_LATTICE_WP25 ")
    print_f64(ep_val(&lo_lat))
    print("\n")

    var ok: i64 = 1
    if provided { ok = 0 }
    if abs_f(ep_val(&asm) - 7044.8) > 0.2 { ok = 0 }
    if abs_f(ep_val(&pub25) - 7045.0) > 0.2 { ok = 0 }
    if ep_std(&asm) <= 0.0 { ok = 0 }
    if ep_val(&lo_lat) <= ep_val(&lo20) { ok = 0 }

    print("VERDICT_ABSENT ")
    if provided { print("0\n") } else { print("1\n") }
    print("VERDICT_HYBRID_INTACT ")
    if abs_f(ep_val(&asm) - 7044.8) <= 0.2 { print("1\n") } else { print("0\n") }

    // Slot is passed through, not observed. Using it as Epistemic is a
    // different file (compile-fail).
    if hold_absent(slot) { ok = 0 }

    if ok == 1 { 0 } else { 1 }
}
