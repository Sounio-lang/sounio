// examples/particle_physics/exp123_z_metrology_nonunitary_ew.sio
//
// Vertical executável: Experiências 1+2+3 (construção, não paper)
//
//   EXP1 — Metrologia Z: Γ(Z→ee) GUM + budget de fontes + confidence gate
//   EXP2 — NonUnitary no pico: deficit(s) + σ_peak + curva deficit vs √s + JSON
//   EXP3 — Tensão EW: M_W tree / Δρ / G_F-Δr, pull ladder, S/T/U, Δρ
//
// Effects: NonUnitary is compiler-enforced on the peak cross-section path.
// Run:
//   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib
//   export SOUNIO_SOUC_ENGINE=lean_single
//   ./bin/souc run examples/particle_physics/exp123_z_metrology_nonunitary_ew.sio
// Gate:
//   bash scripts/ci/particle_exp123_gate.sh

use particle_physics::sm_params::{mass_z, mass_w, mass_h, mass_top, alpha_s_mz, sin2_theta_w}
use particle_physics::epistemic_chain::{
    z_width_ee_ep, z_width_ee_budget, chain_gate_z_width,
    eemm_qed_xsec_pb_gated, chain_gate_qed_xsec,
}
use particle_physics::nonunitary::{
    nu_z_propagator, nu_deficit, nu_deficit_pct, nu_approx, nu_exact,
    eemm_z_amplitude_nu, eemm_z_peak_xsec_nu, nu_z_unitarity_threshold,
    NU_Z,
}
use particle_physics::ew_precision::{
    m_w_prediction_ep, m_w_consistency_pull,
    m_w_prediction_ep_radiative, m_w_consistency_pull_radiative,
    m_w_prediction_ep_gf, m_w_consistency_pull_gf,
    m_w_tension_tree, m_w_tension_rho, m_w_tension_gf,
    tension_improves, tension_abs_pull,
    TENSION_CONSTRUCTION_TREE, TENSION_CONSTRUCTION_ONSHELL_RHO, TENSION_CONSTRUCTION_GF_SIRLIN,
    TENSION_OBS_MW,
    oblique_s_measured_ep, oblique_t_measured_ep, oblique_u_measured_ep,
    delta_rho_ep, g_minus_2_qed_schwinger_ep,
    oblique_s, oblique_t, oblique_u, delta_rho,
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// Name must not be `near` — Madaros multi-module typecheck confuses it with an
// imported symbol under particle_physics (E008 bool/i64).
fn within(a: f64, b: f64, tol: f64) -> bool {
    abs_f(a - b) < tol
}

fn print_pass(tag: i64) with IO {
    print("PASS ")
    print_int(tag)
    print("\n")
}

fn print_fail(tag: i64) with IO {
    print("FAIL ")
    print_int(tag)
    print("\n")
}

// pass_if returns 1 if pass, 0 if fail (avoid exclusive-ref counter bugs across engines).
// Name must not be `chk` — Madaros multi-module typecheck mis-types a local `chk`
// when particle_physics modules are imported (E008 i64/()/bool confusion).
fn pass_if(cond: bool, tag: i64) -> i64 with IO {
    if cond {
        print_pass(tag)
        1
    } else {
        print_fail(tag)
        0
    }
}

// ============================================================================
// EXP1 — Z metrology (GUM + budget + gate)
// ============================================================================

fn run_exp1() -> i64 with IO, Mut, Div, Panic {
    var n: i64 = 0
    print("=== EXP1 Z metrology ===\n")

    let gz = z_width_ee_ep()
    let gval = gz.val()
    let gstd = gz.std()
    let gconf = gz.confidence()

    print("EXP1_GEE_VAL ")
    print_f64(gval)
    print("\n")
    print("EXP1_GEE_STD ")
    print_f64(gstd)
    print("\n")
    print("EXP1_GEE_CONF ")
    print_int(gconf)
    print("\n")

    // Physically: Γ(Z→ee) ≈ 84 MeV = 0.084 GeV
    n = n + pass_if(gval > 0.05 && gval < 0.12, 101)
    n = n + pass_if(gstd > 0.0, 102)
    // Confidence from multi-source PDG chain is ~846 on current stack
    n = n + pass_if(gconf >= 800, 103)

    // Budget: [0]=Var from M_Z, [1]=Var from sin²θ_W, [2]=total Var, [3]=Γ central
    let budget = z_width_ee_budget()
    print("EXP1_BUDGET_VAR_MZ ")
    print_f64(budget[0])
    print("\n")
    print("EXP1_BUDGET_VAR_S2W ")
    print_f64(budget[1])
    print("\n")
    print("EXP1_BUDGET_VAR_TOTAL ")
    print_f64(budget[2])
    print("\n")
    print("EXP1_BUDGET_GEE ")
    print_f64(budget[3])
    print("\n")

    n = n + pass_if(budget[0] > 0.0, 104)
    n = n + pass_if(budget[1] > 0.0, 105)
    n = n + pass_if(budget[2] > 0.0, 106)
    n = n + pass_if(within(budget[3], gval, gval * 1.0e-6), 107)
    // Both source variances positive; total from GUM chain is independent recomputation
    n = n + pass_if(budget[0] + budget[1] > 0.0, 108)
    n = n + pass_if(budget[2] > 0.0, 109)

    // Dominance: which PDG input owns the budget?
    let dom_mz = budget[0] >= budget[1]
    if dom_mz {
        print("EXP1_DOMINANT_SOURCE M_Z\n")
    } else {
        print("EXP1_DOMINANT_SOURCE SIN2_THETA_W\n")
    }
    n = n + pass_if(true, 110)

    // Confidence gate: match observed confidence floor (~846)
    let gate_ok = chain_gate_z_width(800)
    print("EXP1_GATE_800 ")
    print_int(gate_ok)
    print("\n")
    n = n + pass_if(gate_ok == 1, 111)

    // Absurd gate should fail
    let gate_absurd = chain_gate_z_width(9999)
    print("EXP1_GATE_9999 ")
    print_int(gate_absurd)
    print("\n")
    n = n + pass_if(gate_absurd == 0, 112)

    // Bonus: QED continuum gate still works (sanity of epistemic stack)
    let qed_gate = chain_gate_qed_xsec(10.0, 800)
    print("EXP1_QED_GATE_10GEV ")
    print_int(qed_gate)
    print("\n")
    n = n + pass_if(qed_gate == 1, 113)

    print("EXP1_DONE\n")
    n
}

// ============================================================================
// EXP2 — NonUnitary at the Z pole (deficit vs s + peak xsec)
// ============================================================================

fn run_exp2() -> i64 with IO, NonUnitary, Mut, Div, Panic {
    var n: i64 = 0
    print("=== EXP2 NonUnitary Z pole ===\n")

    let mz = mass_z().val()
    let gamma_z = 2.4952
    let gamma_ee = 0.08399
    let gamma_mumu = 0.08399
    let s_pole = mz * mz

    // Deficit scan: pole / far / above
    let prop_pole = nu_z_propagator(s_pole, gamma_z)
    let prop_far = nu_z_propagator(1.0, gamma_z)
    let prop_hi = nu_z_propagator(100000.0, gamma_z)
    let d_pole = nu_deficit(prop_pole)
    let d_far = nu_deficit(prop_far)
    let d_hi = nu_deficit(prop_hi)

    print("EXP2_DEFICIT_POLE ")
    print_f64(d_pole)
    print("\n")
    print("EXP2_DEFICIT_FAR ")
    print_f64(d_far)
    print("\n")
    print("EXP2_DEFICIT_HIGH ")
    print_f64(d_hi)
    print("\n")
    print("EXP2_DEFICIT_PCT_POLE ")
    print_f64(nu_deficit_pct(prop_pole))
    print("\n")

    n = n + pass_if(within(d_pole, 1.0, 0.001), 201)
    n = n + pass_if(d_far < 0.01, 202)
    n = n + pass_if(d_hi < 0.01, 203)
    n = n + pass_if(prop_pole.amp_sq.variance() > 0.0, 204)
    n = n + pass_if(prop_pole.amp_sq.confidence() == 950, 205)
    n = n + pass_if(prop_pole.particle == NU_Z(), 206)

    // Amplitude_nu at pole: positive, deficit ≈ 1
    let amp = eemm_z_amplitude_nu(s_pole, gamma_z)
    print("EXP2_AMP_SQ ")
    print_f64(amp.amp_sq.val())
    print("\n")
    n = n + pass_if(amp.amp_sq.val() > 0.0, 207)
    n = n + pass_if(within(nu_deficit(amp), 1.0, 0.001), 208)

    // Peak xsec: NonUnitary is in the signature — this call forces the effect
    let peak = eemm_z_peak_xsec_nu(gamma_ee, gamma_mumu, gamma_z)
    print("EXP2_PEAK_XSEC ")
    print_f64(peak.val())
    print("\n")
    print("EXP2_PEAK_VAR ")
    print_f64(peak.variance())
    print("\n")
    n = n + pass_if(peak.val() > 1.0e-7 && peak.val() < 1.0e-4, 209)
    n = n + pass_if(peak.variance() > 0.0, 210)

    // nu_approx vs nu_exact: same number, different effect semantics
    let ap = nu_approx(prop_pole).val()
    let ex = nu_exact(prop_pole).val()
    print("EXP2_NU_APPROX ")
    print_f64(ap)
    print("\n")
    print("EXP2_NU_EXACT ")
    print_f64(ex)
    print("\n")
    n = n + pass_if(within(ap, ex, abs_f(ex) * 1.0e-12 + 1.0e-30), 211)

    // Unitary threshold: √s where deficit drops below 1%
    let thr = nu_z_unitarity_threshold(gamma_z, 0.01)
    print("EXP2_UNITARITY_THRESH_SQRT_S ")
    print_f64(thr)
    print("\n")
    n = n + pass_if(thr > mz, 212)

    // Mid-scan: deficit between pole and far should be intermediate
    let s_mid = s_pole * 1.01
    let d_mid = nu_deficit(nu_z_propagator(s_mid, gamma_z))
    print("EXP2_DEFICIT_MID ")
    print_f64(d_mid)
    print("\n")
    n = n + pass_if(d_mid < d_pole && d_mid > d_far, 213)

    // Deficit vs √s curve receipt (construction object, not a plot-only claim)
    // Points: below pole → pole → slightly above → threshold neighbourhood → far
    let s_lo = (mz - 2.0) * (mz - 2.0)
    let s_hi = (mz + 5.0) * (mz + 5.0)
    let s_thr = thr * thr
    let d_lo = nu_deficit(nu_z_propagator(s_lo, gamma_z))
    let d_hi5 = nu_deficit(nu_z_propagator(s_hi, gamma_z))
    let d_thr = nu_deficit(nu_z_propagator(s_thr, gamma_z))
    print("EXP2_SCAN_SQRT_S_LO ")
    print_f64(mz - 2.0)
    print("\n")
    print("EXP2_SCAN_DEFICIT_LO ")
    print_f64(d_lo)
    print("\n")
    print("EXP2_SCAN_SQRT_S_POLE ")
    print_f64(mz)
    print("\n")
    print("EXP2_SCAN_DEFICIT_POLE ")
    print_f64(d_pole)
    print("\n")
    print("EXP2_SCAN_SQRT_S_MID ")
    print_f64(mz * 1.005)
    print("\n")
    print("EXP2_SCAN_DEFICIT_MID ")
    print_f64(d_mid)
    print("\n")
    print("EXP2_SCAN_SQRT_S_HI5 ")
    print_f64(mz + 5.0)
    print("\n")
    print("EXP2_SCAN_DEFICIT_HI5 ")
    print_f64(d_hi5)
    print("\n")
    print("EXP2_SCAN_SQRT_S_THR ")
    print_f64(thr)
    print("\n")
    print("EXP2_SCAN_DEFICIT_THR ")
    print_f64(d_thr)
    print("\n")
    // Peak is unique maximum among sampled off-pole points
    n = n + pass_if(d_lo < d_pole && d_hi5 < d_pole, 214)
    // Moving further off-pole reduces deficit (hi5 beyond mid, thr near 1%)
    n = n + pass_if(d_hi5 < d_mid, 215)
    n = n + pass_if(d_thr < 0.02 && d_thr > 0.0, 216)
    // Monotone wings: |√s − M_Z| larger → deficit smaller on high side of thr vs hi5
    n = n + pass_if(d_thr < d_hi5 || thr > mz + 5.0, 217)

    // Machine-readable deficit curve (JSON line; gate also materialises a file)
    print("EXP2_DEFICIT_JSON {")
    print("\"schema\":\"particle.exp123.deficit_curve.v1\",")
    print("\"particle\":\"Z\",")
    print("\"gamma_z\":")
    print_f64(gamma_z)
    print(",\"unitarity_threshold_sqrt_s\":")
    print_f64(thr)
    print(",\"points\":[")
    print("{\"label\":\"lo\",\"sqrt_s\":")
    print_f64(mz - 2.0)
    print(",\"deficit\":")
    print_f64(d_lo)
    print("},")
    print("{\"label\":\"pole\",\"sqrt_s\":")
    print_f64(mz)
    print(",\"deficit\":")
    print_f64(d_pole)
    print("},")
    print("{\"label\":\"mid\",\"sqrt_s\":")
    print_f64(mz * 1.005)
    print(",\"deficit\":")
    print_f64(d_mid)
    print("},")
    print("{\"label\":\"hi5\",\"sqrt_s\":")
    print_f64(mz + 5.0)
    print(",\"deficit\":")
    print_f64(d_hi5)
    print("},")
    print("{\"label\":\"thr1pct\",\"sqrt_s\":")
    print_f64(thr)
    print(",\"deficit\":")
    print_f64(d_thr)
    print("}]}\n")
    n = n + pass_if(true, 218)

    print("EXP2_DONE\n")
    n
}

// ============================================================================
// EXP3 — EW tension (M_W pull, S/T/U, Δρ)
// ============================================================================

fn run_exp3() -> i64 with IO, Mut, Div, Panic {
    var n: i64 = 0
    print("=== EXP3 EW tension ===\n")

    // Typed tension objects (N2) — not print-only keys
    let t_tree = m_w_tension_tree()
    let t_rho = m_w_tension_rho()
    let t_gf = m_w_tension_gf()

    print("EXP3_MW_PRED_TREE ")
    print_f64(t_tree.pred_val)
    print("\n")
    print("EXP3_MW_PRED_RAD ")
    print_f64(t_rho.pred_val)
    print("\n")
    print("EXP3_MW_PRED_GF ")
    print_f64(t_gf.pred_val)
    print("\n")
    print("EXP3_MW_MEAS ")
    print_f64(t_gf.meas_val)
    print("\n")
    print("EXP3_MW_PULL_TREE ")
    print_f64(t_tree.pull)
    print("\n")
    print("EXP3_MW_PULL_RAD ")
    print_f64(t_rho.pull)
    print("\n")
    print("EXP3_MW_PULL_GF ")
    print_f64(t_gf.pull)
    print("\n")
    print("EXP3_MW_PULL ")
    print_f64(t_gf.pull)
    print("\n")
    print("EXP3_TENSION_CONSTRUCTION_TREE ")
    print_int(t_tree.construction)
    print("\n")
    print("EXP3_TENSION_CONSTRUCTION_RHO ")
    print_int(t_rho.construction)
    print("\n")
    print("EXP3_TENSION_CONSTRUCTION_GF ")
    print_int(t_gf.construction)
    print("\n")
    print("EXP3_TENSION_OBS ")
    print_int(t_gf.observable)
    print("\n")

    // Machine-readable tension ladder (schema parity with deficit JSON)
    print("EXP3_TENSION_JSON {")
    print("\"schema\":\"particle.exp123.tension_ladder.v1\",")
    print("\"observable\":\"M_W\",")
    print("\"steps\":[")
    print("{\"construction\":\"tree\",\"tag\":")
    print_int(TENSION_CONSTRUCTION_TREE())
    print(",\"pred\":")
    print_f64(t_tree.pred_val)
    print(",\"pull\":")
    print_f64(t_tree.pull)
    print("},")
    print("{\"construction\":\"onshell_rho\",\"tag\":")
    print_int(TENSION_CONSTRUCTION_ONSHELL_RHO())
    print(",\"pred\":")
    print_f64(t_rho.pred_val)
    print(",\"pull\":")
    print_f64(t_rho.pull)
    print("},")
    print("{\"construction\":\"gf_sirlin\",\"tag\":")
    print_int(TENSION_CONSTRUCTION_GF_SIRLIN())
    print(",\"pred\":")
    print_f64(t_gf.pred_val)
    print(",\"pull\":")
    print_f64(t_gf.pull)
    print("}]}\n")

    // Physical range for M_W (tree + Δρ + G_F)
    n = n + pass_if(t_tree.pred_val > 75.0 && t_tree.pred_val < 85.0, 301)
    n = n + pass_if(t_gf.meas_val > 75.0 && t_gf.meas_val < 85.0, 302)
    n = n + pass_if(t_tree.pred_var > 0.0, 303)
    n = n + pass_if(tension_abs_pull(t_tree) < 100.0, 304)
    n = n + pass_if(t_rho.pred_val > 75.0 && t_rho.pred_val < 85.0, 305)
    n = n + pass_if(t_rho.pred_var > 0.0, 306)
    n = n + pass_if(tension_abs_pull(t_rho) < 100.0, 307)
    // Leading Δρ must lift M_W toward the PDG direct measurement
    n = n + pass_if(t_rho.pred_val > t_tree.pred_val, 308)
    // Typed ladder honesty: each step improves |pull|
    n = n + pass_if(tension_improves(t_tree, t_rho), 309)
    n = n + pass_if(t_gf.pred_val > 75.0 && t_gf.pred_val < 85.0, 310)
    n = n + pass_if(t_gf.pred_var > 0.0, 311)
    n = n + pass_if(tension_abs_pull(t_gf) < 100.0, 312)
    n = n + pass_if(tension_improves(t_tree, t_gf), 313)
    n = n + pass_if(tension_improves(t_rho, t_gf), 314)
    n = n + pass_if(tension_abs_pull(t_gf) < 3.0, 315)
    // Construction tags and observable identity on typed objects
    n = n + pass_if(t_tree.construction == TENSION_CONSTRUCTION_TREE(), 316)
    n = n + pass_if(t_rho.construction == TENSION_CONSTRUCTION_ONSHELL_RHO(), 317)
    n = n + pass_if(t_gf.construction == TENSION_CONSTRUCTION_GF_SIRLIN(), 318)
    n = n + pass_if(t_gf.observable == TENSION_OBS_MW(), 319)
    if t_gf.consistent == 1 {
        print("EXP3_TENSION_FLAG CONSISTENT\n")
        print("EXP3_TENSION_NOTE G_F_Sirlin_Delta_r_pull_within_2sigma\n")
    } else {
        print("EXP3_TENSION_FLAG RESIDUAL_PULL_AFTER_GF_DR\n")
        print("EXP3_TENSION_NOTE G_F_Sirlin_Delta_r_closes_most_tension_higher_orders_open\n")
    }
    n = n + pass_if(true, 320)

    // Oblique parameters (PDG global fit, epistemic)
    let s_ep = oblique_s_measured_ep()
    let t_ep = oblique_t_measured_ep()
    let u_ep = oblique_u_measured_ep()
    print("EXP3_S_MEAS ")
    print_f64(s_ep.val())
    print("\n")
    print("EXP3_S_STD ")
    print_f64(s_ep.std())
    print("\n")
    print("EXP3_T_MEAS ")
    print_f64(t_ep.val())
    print("\n")
    print("EXP3_T_STD ")
    print_f64(t_ep.std())
    print("\n")
    print("EXP3_U_MEAS ")
    print_f64(u_ep.val())
    print("\n")
    print("EXP3_U_STD ")
    print_f64(u_ep.std())
    print("\n")

    // PDG-scale: S ~ 0.05 ± 0.11, T ~ 0.09 ± 0.14
    n = n + pass_if(abs_f(s_ep.val()) < 1.0, 321)
    n = n + pass_if(s_ep.std() > 0.0, 322)
    n = n + pass_if(abs_f(t_ep.val()) < 1.0, 323)
    n = n + pass_if(t_ep.std() > 0.0, 324)
    n = n + pass_if(u_ep.std() > 0.0, 325)

    // SM theory Δρ from top (epistemic)
    let dr = delta_rho_ep()
    print("EXP3_DELTA_RHO ")
    print_f64(dr.val())
    print("\n")
    print("EXP3_DELTA_RHO_STD ")
    print_f64(dr.std())
    print("\n")
    n = n + pass_if(dr.val() > 0.0 && dr.val() < 0.02, 326)
    n = n + pass_if(dr.variance() > 0.0, 327)

    // Theory S,T,U at PDG central masses (consistency of formulas)
    let mt = mass_top().val()
    let mh = mass_h().val()
    let asz = alpha_s_mz().val()
    let s_th = oblique_s(mh, mt, asz)
    let t_th = oblique_t(mh, mt)
    let u_th = oblique_u(mh, mt, asz)
    print("EXP3_S_TH ")
    print_f64(s_th)
    print("\n")
    print("EXP3_T_TH ")
    print_f64(t_th)
    print("\n")
    print("EXP3_U_TH ")
    print_f64(u_th)
    print("\n")
    n = n + pass_if(abs_f(s_th) < 1.0, 328)
    n = n + pass_if(abs_f(t_th) < 1.0, 329)

    // g-2 Schwinger term with GUM
    let amu = g_minus_2_qed_schwinger_ep()
    print("EXP3_AMU_QED ")
    print_f64(amu.val())
    print("\n")
    // α/(2π) ≈ 0.0011614
    n = n + pass_if(within(amu.val(), 0.0011614, 1.0e-6), 330)
    n = n + pass_if(amu.variance() > 0.0, 331)

    print("EXP3_DONE\n")
    n
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 with IO, NonUnitary, Mut, Div, Panic {
    print("PARTICLE_EXP123_BEGIN\n")

    let n1 = run_exp1()
    let n2 = run_exp2()
    let n3 = run_exp3()
    let npass = n1 + n2 + n3
    // Expected checks: exp1=13, exp2=18, exp3=31 → 62
    let expected: i64 = 62
    let nfail = expected - npass

    print("PARTICLE_EXP123_PASS ")
    print_int(npass)
    print("\n")
    print("PARTICLE_EXP123_FAIL ")
    print_int(nfail)
    print("\n")
    print("PARTICLE_EXP123_N1 ")
    print_int(n1)
    print("\n")
    print("PARTICLE_EXP123_N2 ")
    print_int(n2)
    print("\n")
    print("PARTICLE_EXP123_N3 ")
    print_int(n3)
    print("\n")

    if npass == expected {
        print("PARTICLE_EXP123_OK\n")
        0
    } else {
        print("PARTICLE_EXP123_FAILED\n")
        1
    }
}
