// examples/particle_physics/exp19_h_yukawa_amp_to_xsec.sio
//
// EXP19 — H amp→σ via stdlib Yukawa-bb amplitude
//
// Twin of EXP18's W restore (and EXP14's Z): continuum σ from
//
//   σ(s) = |M|²(s) · s / (12π)
//
// with |M|² from `nonunitary_amp::h_bb_yukawa_amplitude_nu`
// (num = y_b⁴, y_b = √2 m_b / v via mass_bottom GUM), not inlined scalars.
//
// NWA peak toy unchanged from EXP16 (local Br·Γ_H bb).
// Honesty band for continuum/peak: (0.3, 2); measured ~0.65.
// Off-pole uses ξ = 2 (Γ_H/M_H ~ 3e-5; 1% s-shift is vacuous).
//
// Spin note (math-review 2026-08-06): physical scalar J=0 would use 4π;
// this leaf keeps the shared vector 12π of EXP14–18 so the EXP16 twin
// ratio is preserved. Absolute H xsec is not claimed.
//
// Gate: scripts/research/particle_exp19_h_yukawa_amp_gate.sh

use particle_physics::sm_params::{mass_h}
use particle_physics::nonunitary_amp::{h_bb_yukawa_amplitude_nu}
use epistemic::knowledge::{ep_val, ep_variance}

fn pass_if(cond: bool, tag: i64) -> i64 with IO {
    if cond {
        print("PASS ")
        print_int(tag)
        print("\n")
        1
    } else {
        print("FAIL ")
        print_int(tag)
        print("\n")
        0
    }
}

fn main() -> i32 with IO, NonUnitary, Mut, Div, Panic {
    print("PARTICLE_EXP19_BEGIN\n")
    print("EXP19_CLAIM h_yukawa_amp_to_xsec_via_h_bb_yukawa_amplitude_nu\n")
    var n: i64 = 0

    let mh = mass_h().val()
    let s_pole = mh * mh
    let gh = 0.00407
    let pi = 3.14159265358979323846

    let br_bb = 0.5824
    let gamma_bb = br_bb * gh

    let nu = h_bb_yukawa_amplitude_nu(s_pole, gh)
    let amp = ep_val(&nu.amp_sq)
    let amp_var = ep_variance(&nu.amp_sq)
    // Shared Z/W/H leaf prefactor (vector 12π). Scalar J=0 would use 4π;
    // kept for EXP16 twin ratio — absolute H xsec not claimed.
    let sigma = amp * s_pole / (12.0 * pi)

    let peak = 12.0 * pi * gamma_bb * gamma_bb / (s_pole * gh * gh)
    let ratio = sigma / peak

    // ξ = (s − M²) / (M Γ) = 2
    let s_off = s_pole + 2.0 * mh * gh
    let nu_off = h_bb_yukawa_amplitude_nu(s_off, gh)
    let amp_off = ep_val(&nu_off.amp_sq)
    let sigma_off = amp_off * s_off / (12.0 * pi)

    print("EXP19_AMP ")
    print_f64(amp)
    print("\n")
    print("EXP19_AMP_VAR ")
    print_f64(amp_var)
    print("\n")
    print("EXP19_SIGMA ")
    print_f64(sigma)
    print("\n")
    print("EXP19_PEAK ")
    print_f64(peak)
    print("\n")
    print("EXP19_RATIO ")
    print_f64(ratio)
    print("\n")
    print("EXP19_SIGMA_OFF ")
    print_f64(sigma_off)
    print("\n")

    let p1 = amp > 1.0e-9 && amp < 1.0e-3
    n = n + pass_if(p1, 2701)

    let p2 = sigma > 1.0e-6 && sigma < 1.0e-2
    n = n + pass_if(p2, 2702)

    let p3 = peak > 1.0e-6 && peak < 1.0e-2 && ratio > 0.3 && ratio < 2.0
    n = n + pass_if(p3, 2703)

    let p4 = sigma_off > 0.0 && sigma_off < sigma
    n = n + pass_if(p4, 2704)

    let p5 = amp_var > 0.0
    n = n + pass_if(p5, 2705)

    let expected: i64 = 5
    print("EXP19_LEDGER_JSON {")
    print("\"schema\":\"particle.exp19.h_yukawa_amp_to_xsec.v1\",")
    print("\"claim\":\"h_yukawa_amp_to_xsec_via_h_bb_yukawa_amplitude_nu\",")
    print("\"amp\":")
    print_f64(amp)
    print(",\"amp_var\":")
    print_f64(amp_var)
    print(",\"sigma\":")
    print_f64(sigma)
    print(",\"peak\":")
    print_f64(peak)
    print(",\"ratio_sigma_over_peak\":")
    print_f64(ratio)
    print(",\"sigma_off\":")
    print_f64(sigma_off)
    print(",\"num_yukawa\":\"y_b^4\",")
    print("\"source\":\"h_bb_yukawa_amplitude_nu\",")
    print("\"off_pole\":\"xi=2\",")
    print("\"formula\":\"sigma = amp_sq * s / (12 * pi)\",")
    print("\"spin_prefactor\":\"shared_vector_12pi_exp16_twin\",")
    print("\"nonclaim\":\"nwa_peak_not_equal_to_continuum_bw; not_full_hbb_matrix_element; not_ggh; scalar_would_use_4pi\"")
    print("}\n")

    print("PARTICLE_EXP19_PASS ")
    print_int(n)
    print("\n")
    if n == expected {
        print("PARTICLE_EXP19_OK\n")
        0
    } else {
        print("PARTICLE_EXP19_FAILED\n")
        1
    }
}
