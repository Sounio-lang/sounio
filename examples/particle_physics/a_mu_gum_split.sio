//@ run-pass
//@ description: muon a_μ GUM split — Fermilab 2025 vs TI WP20 vs TI WP25
//
// Citation witness. Sounio does not compute hadronic VP. It refuses to
// store "the" SM prediction as one f64. Pulls are GUM: Var(X−Y)=Var(X)+Var(Y).
//
// Run:
//   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib
//   ./bin/souc run examples/particle_physics/a_mu_gum_split.sio

use particle_physics::ew_precision::{
    a_mu_exp_fermilab_2025, a_mu_sm_wp20, a_mu_sm_wp25,
    a_mu_pull, a_mu_k95, g_minus_2_qed_schwinger_ep, g_minus_2_muon_leading,
    a_mu_qed_wp20, a_mu_ew_wp20, a_mu_hvp_wp20, a_mu_hlbl_wp20,
    a_mu_qed_wp25, a_mu_ew_wp25, a_mu_hvp_wp25, a_mu_hlbl_wp25,
    a_mu_sm_sum_wp20, a_mu_sm_sum_wp25,
    a_mu_hvp_lo_wp20, a_mu_hvp_lo_lattice_wp25,
    a_mu_hvp_nlo_epem_wp25, a_mu_hvp_nnlo_epem_wp25,
    a_mu_hvp_wp25_assembled,
}
use particle_physics::sm_params::{alpha_em, mass_muon, mass_top, mass_h}
use epistemic::knowledge::{ep_val, ep_std, ep_sub}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let exp = a_mu_exp_fermilab_2025()
    let wp20 = a_mu_sm_wp20()
    let wp25 = a_mu_sm_wp25()
    let k95 = a_mu_k95()

    let pull_exp_wp20 = a_mu_pull(exp, wp20)
    let pull_exp_wp25 = a_mu_pull(exp, wp25)
    let pull_wp25_wp20 = a_mu_pull(wp25, wp20)

    let disagrees_wp20 = abs_f(pull_exp_wp20) > k95
    let agrees_wp25 = abs_f(pull_exp_wp25) < k95
    let split_survives = abs_f(pull_wp25_wp20) > k95

    print("A_MU_UNIT 1e-11\n")
    print("A_MU_EXP_VAL ")
    print_f64(ep_val(&exp))
    print("\nA_MU_EXP_STD ")
    print_f64(ep_std(&exp))
    print("\nA_MU_WP20_VAL ")
    print_f64(ep_val(&wp20))
    print("\nA_MU_WP20_STD ")
    print_f64(ep_std(&wp20))
    print("\nA_MU_WP25_VAL ")
    print_f64(ep_val(&wp25))
    print("\nA_MU_WP25_STD ")
    print_f64(ep_std(&wp25))
    print("\nA_MU_PULL_EXP_WP20 ")
    print_f64(pull_exp_wp20)
    print("\nA_MU_PULL_EXP_WP25 ")
    print_f64(pull_exp_wp25)
    print("\nA_MU_PULL_WP25_WP20 ")
    print_f64(pull_wp25_wp20)
    print("\nA_MU_K95 ")
    print_f64(k95)
    print("\n")

    print("VERDICT_EXP_DISAGREES_WP20 ")
    if disagrees_wp20 { print("1\n") } else { print("0\n") }
    print("VERDICT_EXP_AGREES_WP25 ")
    if agrees_wp25 { print("1\n") } else { print("0\n") }
    print("VERDICT_SPLIT_SURVIVES ")
    if split_survives { print("1\n") } else { print("0\n") }

    // Derived control: Schwinger from α, not a citation. Must stay ~α/2π.
    let schw = g_minus_2_qed_schwinger_ep()
    print("A_MU_SCHWINGER ")
    print_f64(ep_val(&schw))
    print("\n")

    // Negative control: the collapsed f64 still exists and is finite.
    let collapsed = g_minus_2_muon_leading(
        alpha_em().val(),
        mass_muon().val(),
        mass_top().val(),
        mass_h().val(),
    )
    print("A_MU_COLLAPSED_F64 ")
    print_f64(collapsed)
    print("\n")

    // Sector budget. The SM is a sum. The fork is not one term.
    let qed20 = a_mu_qed_wp20()
    let ew20 = a_mu_ew_wp20()
    let hvp20 = a_mu_hvp_wp20()
    let hlbl20 = a_mu_hlbl_wp20()
    let qed25 = a_mu_qed_wp25()
    let ew25 = a_mu_ew_wp25()
    let hvp25 = a_mu_hvp_wp25()
    let hlbl25 = a_mu_hlbl_wp25()
    let sum20 = a_mu_sm_sum_wp20()
    let sum25 = a_mu_sm_sum_wp25()
    let d_qed = ep_sub(&qed25, &qed20)
    let d_ew = ep_sub(&ew25, &ew20)
    let d_hvp = ep_sub(&hvp25, &hvp20)
    let d_hlbl = ep_sub(&hlbl25, &hlbl20)
    let d_sum = ep_sub(&sum25, &sum20)
    let d_pub = ep_sub(&wp25, &wp20)

    print("SECTOR_QED_WP20 ")
    print_f64(ep_val(&qed20))
    print("\nSECTOR_EW_WP20 ")
    print_f64(ep_val(&ew20))
    print("\nSECTOR_HVP_WP20 ")
    print_f64(ep_val(&hvp20))
    print("\nSECTOR_HLBL_WP20 ")
    print_f64(ep_val(&hlbl20))
    print("\nSECTOR_SUM_WP20 ")
    print_f64(ep_val(&sum20))
    print("\nSECTOR_QED_WP25 ")
    print_f64(ep_val(&qed25))
    print("\nSECTOR_EW_WP25 ")
    print_f64(ep_val(&ew25))
    print("\nSECTOR_HVP_WP25 ")
    print_f64(ep_val(&hvp25))
    print("\nSECTOR_HLBL_WP25 ")
    print_f64(ep_val(&hlbl25))
    print("\nSECTOR_SUM_WP25 ")
    print_f64(ep_val(&sum25))
    print("\nSHIFT_QED ")
    print_f64(ep_val(&d_qed))
    print("\nSHIFT_EW ")
    print_f64(ep_val(&d_ew))
    print("\nSHIFT_HVP ")
    print_f64(ep_val(&d_hvp))
    print("\nSHIFT_HLBL ")
    print_f64(ep_val(&d_hlbl))
    print("\nSHIFT_SUM ")
    print_f64(ep_val(&d_sum))
    print("\nSHIFT_PUB ")
    print_f64(ep_val(&d_pub))
    print("\n")

    let lo_lat = a_mu_hvp_lo_lattice_wp25()
    let nlo_ee = a_mu_hvp_nlo_epem_wp25()
    let nnlo_ee = a_mu_hvp_nnlo_epem_wp25()
    let hvp_asm = a_mu_hvp_wp25_assembled()
    let lo_wp20 = a_mu_hvp_lo_wp20()
    let pull_lo = a_mu_pull(lo_lat, lo_wp20)
    print("HVP_LO_LATTICE ")
    print_f64(ep_val(&lo_lat))
    print("\nHVP_NLO_EPEM ")
    print_f64(ep_val(&nlo_ee))
    print("\nHVP_NNLO_EPEM ")
    print_f64(ep_val(&nnlo_ee))
    print("\nHVP_ASSEMBLED ")
    print_f64(ep_val(&hvp_asm))
    print("\nHVP_PUBLISHED ")
    print_f64(ep_val(&hvp25))
    print("\nHVP_LO_WP20 ")
    print_f64(ep_val(&lo_wp20))
    print("\nPULL_HVP_LO_LATTICE_VS_WP20 ")
    print_f64(pull_lo)
    print("\nVERDICT_HVP_HYBRID ")
    if abs_f(ep_val(&hvp_asm) - ep_val(&hvp25)) < 2.0 { print("1\n") } else { print("0\n") }
    print("VERDICT_HVP_LO_SPLIT ")
    if abs_f(pull_lo) > k95 { print("1\n") } else { print("0\n") }

    print("A_MU_GUM_SPLIT_DONE\n")

    var rc: i64 = 0
    if !disagrees_wp20 { rc = 1 }
    if !agrees_wp25 { rc = 1 }
    if !split_survives { rc = 1 }
    if ep_val(&schw) < 0.00116 { rc = 1 }
    if ep_val(&schw) > 0.00117 { rc = 1 }
    if abs_f(ep_val(&sum25) - ep_val(&wp25)) > 2.0 { rc = 1 }
    if abs_f(ep_val(&sum20) - ep_val(&wp20)) > 2.0 { rc = 1 }
    if abs_f(ep_val(&d_sum) - ep_val(&d_pub)) > 2.0 { rc = 1 }
    if abs_f(ep_val(&d_hvp)) <= abs_f(ep_val(&d_hlbl)) { rc = 1 }
    if abs_f(ep_val(&d_hlbl)) <= abs_f(ep_val(&d_ew)) { rc = 1 }
    if abs_f(ep_val(&hvp_asm) - ep_val(&hvp25)) >= 2.0 { rc = 1 }
    if abs_f(pull_lo) <= k95 { rc = 1 }
    rc
}
