// examples/particle_physics/exp17_zwh_amp_xsec_ledger.sio
//
// EXP17 — Z / W / H amp→σ joint ledger
//
// Single vertical that jointly asserts the EXP14–16 continuum honesty leaves:
//   P1 — Z: σ = |M|² s/(12π) via eemm_z_amplitude_nu, ratio continuum/NWA ∈ (10, 20)
//   P2 — W: CC num=(g²/2)², ratio ∈ (2, 6)
//   P3 — H: Yukawa num=y_b⁴, ratio ∈ (0.3, 2), off-pole at ξ=2
//   P4 — species ordering: ratio_Z > ratio_W > ratio_H
//   P5 — all three: Var(|M|²) > 0 and σ_off < σ_pole
//
// Z continuum amp uses nonunitary_amp::eemm_z_amplitude_nu (Madaros-safe after
// E175 trilogy). W/H stay on local CC/Yukawa nums + thin propagators.
// Z peak remains the local NWA formula (same numbers as eemm_z_peak_xsec_nu).
//
// Gate: scripts/research/particle_exp17_zwh_ledger_gate.sh

use particle_physics::sm_params::{mass_z, mass_w, mass_h}
use particle_physics::nonunitary::{nu_w_propagator, nu_higgs_propagator}
use particle_physics::nonunitary_amp::{eemm_z_amplitude_nu}
use epistemic::knowledge::{ep_val, ep_variance}

fn pass_if(cond: bool, tag: i64) -> i64 with IO {
    if cond {
        print("PASS ")
        print_int(tag)
        print("\n")
        1
    } else {
        print("FAIL ")
        print_int(tag)
        print("\n")
        0
    }
}

fn main() -> i32 with IO, NonUnitary, Mut, Div, Panic {
    print("PARTICLE_EXP17_BEGIN\n")
    print("EXP17_CLAIM zwh_amp_to_xsec_joint_ledger\n")
    var n: i64 = 0
    var bits: i64 = 0

    let pi = 3.14159265358979323846
    let g = 0.629773
    let g4 = g * g * g * g

    // ── Z (EXP14) — vertex amplitude path ──
    let mz = mass_z().val()
    let sz = mz * mz
    let gz = 2.4952
    let nu_z = eemm_z_amplitude_nu(sz, gz)
    let amp_z = ep_val(&nu_z.amp_sq)
    let var_z = ep_variance(&nu_z.amp_sq)
    let sig_z = amp_z * sz / (12.0 * pi)
    let gee = 0.08399
    let peak_z = 12.0 * pi * gee * gee / (sz * gz * gz)
    let ratio_z = sig_z / peak_z
    let nu_z_off = eemm_z_amplitude_nu(sz * 1.01, gz)
    let sig_z_off = ep_val(&nu_z_off.amp_sq) * (sz * 1.01) / (12.0 * pi)

    // ── W (EXP15) ──
    let mw = mass_w().val()
    let sw = mw * mw
    let gw = 2.085
    let num_w = g4 / 4.0
    let prop_w = nu_w_propagator(sw, gw)
    let amp_w = ep_val(&prop_w.amp_sq) * num_w
    let var_w = ep_variance(&prop_w.amp_sq) * num_w * num_w
    let sig_w = amp_w * sw / (12.0 * pi)
    let br_ln = 0.1086
    let gln = br_ln * gw
    let peak_w = 12.0 * pi * gln * gln / (sw * gw * gw)
    let ratio_w = sig_w / peak_w
    let prop_w_off = nu_w_propagator(sw * 1.01, gw)
    let sig_w_off = ep_val(&prop_w_off.amp_sq) * num_w * (sw * 1.01) / (12.0 * pi)

    // ── H (EXP16) ──
    let mh = mass_h().val()
    let sh = mh * mh
    let gh = 0.00407
    let mb = 4.18
    let v = 246.22
    let yb = 1.4142135623730951 * mb / v
    let num_h = yb * yb * yb * yb
    let prop_h = nu_higgs_propagator(sh, gh)
    let amp_h = ep_val(&prop_h.amp_sq) * num_h
    let var_h = ep_variance(&prop_h.amp_sq) * num_h * num_h
    let sig_h = amp_h * sh / (12.0 * pi)
    let br_bb = 0.5824
    let gbb = br_bb * gh
    let peak_h = 12.0 * pi * gbb * gbb / (sh * gh * gh)
    let ratio_h = sig_h / peak_h
    let sh_off = sh + 2.0 * mh * gh
    let prop_h_off = nu_higgs_propagator(sh_off, gh)
    let sig_h_off = ep_val(&prop_h_off.amp_sq) * num_h * sh_off / (12.0 * pi)

    print("EXP17_RATIO_Z ")
    print_f64(ratio_z)
    print("\n")
    print("EXP17_RATIO_W ")
    print_f64(ratio_w)
    print("\n")
    print("EXP17_RATIO_H ")
    print_f64(ratio_h)
    print("\n")

    let p1 = sig_z > 1.0e-6 && peak_z > 1.0e-7 && ratio_z > 10.0 && ratio_z < 20.0 && var_z > 0.0
    n = n + pass_if(p1, 2501)
    if p1 { bits = bits + 1 }

    let p2 = sig_w > 1.0e-6 && peak_w > 1.0e-6 && ratio_w > 2.0 && ratio_w < 6.0 && var_w > 0.0
    n = n + pass_if(p2, 2502)
    if p2 { bits = bits + 2 }

    let p3 = sig_h > 1.0e-6 && peak_h > 1.0e-6 && ratio_h > 0.3 && ratio_h < 2.0 && var_h > 0.0
    n = n + pass_if(p3, 2503)
    if p3 { bits = bits + 4 }

    let p4 = ratio_z > ratio_w && ratio_w > ratio_h
    n = n + pass_if(p4, 2504)
    if p4 { bits = bits + 8 }

    let p5 = sig_z_off > 0.0 && sig_z_off < sig_z
        && sig_w_off > 0.0 && sig_w_off < sig_w
        && sig_h_off > 0.0 && sig_h_off < sig_h
    n = n + pass_if(p5, 2505)
    if p5 { bits = bits + 16 }

    let expected: i64 = 5
    print("EXP17_LEDGER_JSON {")
    print("\"schema\":\"particle.exp17.zwh_amp_xsec_ledger.v1\",")
    print("\"claim\":\"zwh_amp_to_xsec_joint_ledger\",")
    print("\"bits\":")
    print_int(bits)
    print(",\"ratio_z\":")
    print_f64(ratio_z)
    print(",\"ratio_w\":")
    print_f64(ratio_w)
    print(",\"ratio_h\":")
    print_f64(ratio_h)
    print(",\"sigma_z\":")
    print_f64(sig_z)
    print(",\"sigma_w\":")
    print_f64(sig_w)
    print(",\"sigma_h\":")
    print_f64(sig_h)
    print(",\"z_source\":\"eemm_z_amplitude_nu\",")
    print("\"nonclaim\":\"species_ratios_are_construction_gaps_not_pdg_fits\"")
    print("}\n")

    print("PARTICLE_EXP17_PASS ")
    print_int(n)
    print("\n")
    if n == expected && bits == 31 {
        print("PARTICLE_EXP17_OK\n")
        0
    } else {
        print("PARTICLE_EXP17_FAILED\n")
        1
    }
}
