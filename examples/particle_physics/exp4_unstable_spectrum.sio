    n = n + pass_if(within(d_pole, 1.0, 0.01), tag_base + 1)
    n = n + pass_if(d_far < 0.05, tag_base + 2)
    n = n + pass_if(d_pole > d_mid && d_pole > d_hi && d_pole > d_far, tag_base + 3)
    n = n + pass_if(d_mid > d_hi && d_hi > d_thr, tag_base + 4)
    n = n + pass_if(thr > mass, tag_base + 5)
    n = n + pass_if(d_thr < 0.02 && d_thr > 0.0, tag_base + 6)
    n = n + pass_if(prop_pole.particle == NU_W(), tag_base + 7)
    n = n + pass_if(amp_var > 0.0, tag_base + 8)

    print("EXP4_SPECIES_JSON {")
    print("\"schema\":\"sounio.broken_structure.v1\",")
    print("\"domain\":\"qft_unstable\",")
    print("\"species\":\"W\",")
    print("\"coordinate\":\"sqrt_s\",")
    print("\"effect_or_type\":\"NonUnitary\",")
    print("\"points\":[")
    print("{\"label\":\"pole\",\"coord\":")
    print_f64(mass)
    print(",\"proximity\":")
    print_f64(d_pole)
    print("},")
    print("{\"label\":\"mid\",\"coord\":")
    print_f64(mass * 1.005)
    print(",\"proximity\":")
    print_f64(d_mid)
    print("},")
    print("{\"label\":\"hi5\",\"coord\":")
    print_f64(mass + 5.0)
    print(",\"proximity\":")
    print_f64(d_hi)
    print("},")
    print("{\"label\":\"thr1pct\",\"coord\":")
    print_f64(thr)
    print(",\"proximity\":")
    print_f64(d_thr)
    print("}]}\n")
    n
}

fn exp4_peak_and_cross(mz: f64, mw: f64, gamma_z: f64, gamma_w: f64) -> i64 with IO, NonUnitary, Mut, Div, Panic {
    var n: i64 = 0
    let _force = eemm_z_peak_xsec_nu(0.08399, 0.08399, gamma_z)
    let peak = exp4_peak_xsec_local(0.08399, 0.08399, gamma_z)
    let peak_val = ep_val(&peak)
    let peak_var = ep_variance(&peak)
    print("EXP4_Z_PEAK_XSEC ")
    print_f64(peak_val)
    print("\n")
    n = n + pass_if(peak_val > 1.0e-7 && peak_val < 1.0e-4, 601)
    n = n + pass_if(peak_var > 0.0, 602)

    let thr_z = nu_z_unitarity_threshold(gamma_z, 0.01)
    let thr_w = nu_w_unitarity_threshold(gamma_w, 0.01)
    print("EXP4_THRESH_Z ")
    print_f64(thr_z)
    print("\n")
    print("EXP4_THRESH_W ")
    print_f64(thr_w)
    print("\n")
    n = n + pass_if(thr_z > mz && thr_w > mw, 603)
    n = n + pass_if(within(nu_unitarity_threshold(mz, gamma_z, 0.01), thr_z, 1.0e-9), 604)
    n = n + pass_if(within(nu_unitarity_threshold(mw, gamma_w, 0.01), thr_w, 1.0e-9), 605)
    n
}

fn main() -> i32 with IO, NonUnitary, Mut, Div, Panic {
    print("PARTICLE_EXP4_BEGIN\n")

    let mz = mass_z().val()
    let mw = mass_w().val()
    let gamma_z = 2.4952
    let gamma_w = 2.085

    let n_z = scan_species_z(mz, gamma_z, 400)
    let n_w = scan_species_w(mw, gamma_w, 500)
    let n_fx = exp4_peak_and_cross(mz, mw, gamma_z, gamma_w)

    let npass = n_z + n_w + n_fx
    let expected: i64 = 21
    let nfail = expected - npass

    print("PARTICLE_EXP4_PASS ")
    print_int(npass)
    print("\n")
    print("PARTICLE_EXP4_FAIL ")
    print_int(nfail)
    print("\n")
    print("PARTICLE_EXP4_NZ ")
    print_int(n_z)
    print("\n")
    print("PARTICLE_EXP4_NW ")
    print_int(n_w)
    print("\n")

    if npass == expected {
        print("PARTICLE_EXP4_OK\n")
        0
    } else {
        print("PARTICLE_EXP4_FAILED\n")
        1
    }
}
