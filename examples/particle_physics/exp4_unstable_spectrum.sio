// examples/particle_physics/exp4_unstable_spectrum.sio
//
// EXP4 — Unstable spectrum: NonUnitary is not a Z one-off (N1)
//
// Axioms for deficit d(s) of any unstable species (Z, W):
//   A1  d(s_pole) ≈ 1
//   A2  d(s) → 0 far off pole
//   A3  peak is unique among sampled off-pole points
//   A4  high wing monotone: mid > hi > thr
//   A5  unitarity threshold √s > M
//   A6  particle id tags correct (NU_Z / NU_W)
//
// Also forces `with NonUnitary` via Z peak xsec (compiler-enforced).
// Madaros: split helpers + free-fn Epistemic + local peak (full-IR peak residual).
//
// Run:
//   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib
//   export SOUNIO_SOUC_ENGINE=lean_single
//   ./bin/souc run examples/particle_physics/exp4_unstable_spectrum.sio
// Gate:
//   bash scripts/ci/particle_unstable_effect_gate.sh

use particle_physics::sm_params::{mass_z, mass_w}
use epistemic::knowledge::{Epistemic, ep_val, ep_variance, ep_new, ep_certain}
use particle_physics::nonunitary::{
    nu_z_propagator, nu_w_propagator,
    nu_deficit, nu_deficit_pct,
    eemm_z_peak_xsec_nu,
    nu_unitarity_threshold, nu_z_unitarity_threshold, nu_w_unitarity_threshold,
    NU_Z, NU_W,
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn within(a: f64, b: f64, tol: f64) -> bool {
    abs_f(a - b) < tol
}

fn print_pass(tag: i64) with IO {
    print("PASS ")
    print_int(tag)
    print("\n")
}

fn print_fail(tag: i64) with IO {
    print("FAIL ")
    print_int(tag)
    print("\n")
}

fn pass_if(cond: bool, tag: i64) -> i64 with IO {
    if cond {
        print_pass(tag)
        1
    } else {
        print_fail(tag)
        0
    }
}

// Madaros full-IR residual: imported eemm_z_peak_xsec_nu may return 0.
// Local body mirrors stdlib; still call stdlib for NonUnitary effect.
fn exp4_peak_xsec_local(gamma_ee: f64, gamma_mumu: f64, gamma_z: f64) -> Epistemic with NonUnitary, Mut, Div, Panic {
    let mz = mass_z()
    let mz_val = ep_val(&mz)
    let mz2 = mz_val * mz_val
    if gamma_z == 0.0 || mz2 == 0.0 {
        return ep_certain(0.0)
    }
    let pi = 3.141592653589793
    let sigma_val = 12.0 * pi * gamma_ee * gamma_mumu / (mz2 * gamma_z * gamma_z)
    let d_sigma_d_mz = 0.0 - 2.0 * sigma_val / mz_val
    let sigma_var = d_sigma_d_mz * d_sigma_d_mz * ep_variance(&mz)
    ep_new(sigma_val, sigma_var, 950)
}

// Shared axiom suite for one unstable species (split from main for Madaros lower).
// Returns pass count (expected 8 per species).
fn scan_species_z(mass: f64, gamma: f64, tag_base: i64) -> i64 with IO, Mut, Div, Panic {
    var n: i64 = 0
    let s_pole = mass * mass
    let s_far = 1.0
    let s_hi = (mass + 5.0) * (mass + 5.0)
    let s_mid = s_pole * 1.01

    let prop_pole = nu_z_propagator(s_pole, gamma)
    let prop_far = nu_z_propagator(s_far, gamma)
    let prop_hi = nu_z_propagator(s_hi, gamma)
    let prop_mid = nu_z_propagator(s_mid, gamma)
    let d_pole = nu_deficit(prop_pole)
    let d_far = nu_deficit(prop_far)
    let d_hi = nu_deficit(prop_hi)
    let d_mid = nu_deficit(prop_mid)
    let thr = nu_unitarity_threshold(mass, gamma, 0.01)
    let prop_thr = nu_z_propagator(thr * thr, gamma)
    let d_thr = nu_deficit(prop_thr)
    let amp_var = ep_variance(&prop_pole.amp_sq)

    print("EXP4_SPECIES Z\n")
    print("EXP4_MASS ")
    print_f64(mass)
    print("\n")
    print("EXP4_DEFICIT_POLE ")
    print_f64(d_pole)
    print("\n")
    print("EXP4_DEFICIT_FAR ")
    print_f64(d_far)
    print("\n")
    print("EXP4_DEFICIT_MID ")
    print_f64(d_mid)
    print("\n")
    print("EXP4_DEFICIT_HI5 ")
    print_f64(d_hi)
    print("\n")
    print("EXP4_DEFICIT_THR ")
    print_f64(d_thr)
    print("\n")
    print("EXP4_UNITARITY_THRESH_SQRT_S ")
    print_f64(thr)
    print("\n")

    n = n + pass_if(within(d_pole, 1.0, 0.01), tag_base + 1)
    n = n + pass_if(d_far < 0.05, tag_base + 2)
    n = n + pass_if(d_pole > d_mid && d_pole > d_hi && d_pole > d_far, tag_base + 3)
    n = n + pass_if(d_mid > d_hi && d_hi > d_thr, tag_base + 4)
    n = n + pass_if(thr > mass, tag_base + 5)
    n = n + pass_if(d_thr < 0.02 && d_thr > 0.0, tag_base + 6)
    n = n + pass_if(prop_pole.particle == NU_Z(), tag_base + 7)
    n = n + pass_if(amp_var > 0.0, tag_base + 8)

    print("EXP4_SPECIES_JSON {")
    print("\"schema\":\"sounio.broken_structure.v1\",")
    print("\"domain\":\"qft_unstable\",")
    print("\"species\":\"Z\",")
    print("\"coordinate\":\"sqrt_s\",")
    print("\"effect_or_type\":\"NonUnitary\",")
    print("\"points\":[")
    print("{\"label\":\"pole\",\"coord\":")
    print_f64(mass)
    print(",\"proximity\":")
    print_f64(d_pole)
    print("},")
    print("{\"label\":\"mid\",\"coord\":")
    print_f64(mass * 1.005)
    print(",\"proximity\":")
    print_f64(d_mid)
    print("},")
    print("{\"label\":\"hi5\",\"coord\":")
    print_f64(mass + 5.0)
    print(",\"proximity\":")
    print_f64(d_hi)
    print("},")
    print("{\"label\":\"thr1pct\",\"coord\":")
    print_f64(thr)
    print(",\"proximity\":")
    print_f64(d_thr)
    print("}]}\n")
    n
}

fn scan_species_w(mass: f64, gamma: f64, tag_base: i64) -> i64 with IO, Mut, Div, Panic {
    var n: i64 = 0
    let s_pole = mass * mass
    let s_far = 1.0
    let s_hi = (mass + 5.0) * (mass + 5.0)
    let s_mid = s_pole * 1.01

    let prop_pole = nu_w_propagator(s_pole, gamma)
    let prop_far = nu_w_propagator(s_far, gamma)
    let prop_hi = nu_w_propagator(s_hi, gamma)
    let prop_mid = nu_w_propagator(s_mid, gamma)
    let d_pole = nu_deficit(prop_pole)
    let d_far = nu_deficit(prop_far)
