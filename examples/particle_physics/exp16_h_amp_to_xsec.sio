// examples/particle_physics/exp16_h_amp_to_xsec.sio
//
// EXP16 — Higgs observable from amplitude (amp → σ honesty)
//
// H twin of EXP14/15 on the same thin import graph:
//
//   σ(s) = |M|²(s) · s / (12π)
//
// with |M|² = num · |D_H|², |D_H|² = nu_higgs_propagator, and
// num = y_b⁴, y_b = √2 m_b / v  (two Yukawa bb vertices, construction toy).
//
// NWA peak for the bb resonant toy:
//   σ_peak = 12π · Γ_bb · Γ_bb / (M_H² · Γ_H²),   Γ_bb = Br(H→bb)·Γ_H
//
// Measured continuum/peak ratio ~0.65 — continuum BELOW NWA here (narrow
// Higgs + Yukawa scale); honesty band (0.3, 2), equality not claimed.
//
// Off-pole uses ξ = 2 (Higgs Γ/M ~ 3e-5; a 1% s-shift is vacuous).
//
// Gate: scripts/research/particle_exp16_h_amp_xsec_gate.sh

use particle_physics::sm_params::{mass_h}
use particle_physics::nonunitary::{nu_higgs_propagator}
use epistemic::knowledge::{ep_val, ep_variance}

fn pass_if(cond: bool, tag: i64) -> i64 with IO {
    if cond {
        print("PASS ")
        print_int(tag)
        print("\n")
        1
    } else {
        print("FAIL ")
        print_int(tag)
        print("\n")
        0
    }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("PARTICLE_EXP16_BEGIN\n")
    print("EXP16_CLAIM h_observable_from_amplitude_sigma_eq_amp_sq_times_s_over_12pi\n")
    var n: i64 = 0

    let mh = mass_h().val()
    let s_pole = mh * mh
    let gh = 0.00407
    let pi = 3.14159265358979323846

    // PDG-central scalars (sm_params / PDG 2024 scale).
    let mb = 4.18
    let v = 246.22
    let sqrt2 = 1.4142135623730951
    let yb = sqrt2 * mb / v
    let num = yb * yb * yb * yb

    let br_bb = 0.5824
    let gamma_bb = br_bb * gh

    let prop = nu_higgs_propagator(s_pole, gh)
    let prop_a = ep_val(&prop.amp_sq)
    let prop_v = ep_variance(&prop.amp_sq)
    let amp = prop_a * num
    let amp_var = prop_v * num * num
    let sigma = amp * s_pole / (12.0 * pi)

    let peak = 12.0 * pi * gamma_bb * gamma_bb / (s_pole * gh * gh)
    let ratio = sigma / peak

    // ξ = (s − M²) / (M Γ) = 2
    let s_off = s_pole + 2.0 * mh * gh
    let prop_off = nu_higgs_propagator(s_off, gh)
    let amp_off = ep_val(&prop_off.amp_sq) * num
    let sigma_off = amp_off * s_off / (12.0 * pi)

    print("EXP16_AMP ")
    print_f64(amp)
    print("\n")
    print("EXP16_AMP_VAR ")
    print_f64(amp_var)
    print("\n")
    print("EXP16_SIGMA ")
    print_f64(sigma)
    print("\n")
    print("EXP16_PEAK ")
    print_f64(peak)
    print("\n")
    print("EXP16_RATIO ")
    print_f64(ratio)
    print("\n")
    print("EXP16_SIGMA_OFF ")
    print_f64(sigma_off)
    print("\n")

    let p1 = amp > 1.0e-9 && amp < 1.0e-3
    n = n + pass_if(p1, 2401)

    let p2 = sigma > 1.0e-6 && sigma < 1.0e-2
    n = n + pass_if(p2, 2402)

    // Continuum can sit below NWA for this Yukawa toy — band straddles 1.
    let p3 = peak > 1.0e-6 && peak < 1.0e-2 && ratio > 0.3 && ratio < 2.0
    n = n + pass_if(p3, 2403)

    let p4 = sigma_off > 0.0 && sigma_off < sigma
    n = n + pass_if(p4, 2404)

    let p5 = amp_var > 0.0
    n = n + pass_if(p5, 2405)

    let expected: i64 = 5
    print("EXP16_LEDGER_JSON {")
    print("\"schema\":\"particle.exp16.h_amp_to_xsec.v1\",")
    print("\"claim\":\"h_observable_from_amplitude_sigma_eq_amp_sq_times_s_over_12pi\",")
    print("\"amp\":")
    print_f64(amp)
    print(",\"amp_var\":")
    print_f64(amp_var)
    print(",\"sigma\":")
    print_f64(sigma)
    print(",\"peak\":")
    print_f64(peak)
    print(",\"ratio_sigma_over_peak\":")
    print_f64(ratio)
    print(",\"sigma_off\":")
    print_f64(sigma_off)
    print(",\"num_yukawa\":\"y_b^4\",")
    print("\"off_pole\":\"xi=2\",")
    print("\"formula\":\"sigma = amp_sq * s / (12 * pi)\",")
    print("\"nonclaim\":\"nwa_peak_not_equal_to_continuum_bw; not_full_hbb_matrix_element; not_ggh\"")
    print("}\n")

    print("PARTICLE_EXP16_PASS ")
    print_int(n)
    print("\n")
    if n == expected {
        print("PARTICLE_EXP16_OK\n")
        0
    } else {
        print("PARTICLE_EXP16_FAILED\n")
        1
    }
}
