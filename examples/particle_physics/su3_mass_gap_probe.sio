//@ run-pass
// examples/particle_physics/su3_mass_gap_probe.sio
//
// OPEN PROBLEM ATTACK — SU(3) Yang–Mills mass-gap / confinement (lattice)
// ========================================================================
// Pure SU(3) Wilson gauge theory on L=4⁴ with Cabibbo–Marinari Metropolis
// (three SU(2) subgroup hits per link), Creutz χ(2,2) → σ a², and glueball
// mass-gap PROXY m a ≈ 3.5 √(σ a²).
//
// CLAIM: lattice confinement scale for SU(3) with Epistemic SEM.
// NOT CLAIMED: continuum Clay mass gap; full QCD with quarks; precision glueballs.
//
// Typical SU(3) β = 6/g² ~ 5.5–6.0 in the scaling window.
//
// Run:
//   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib
//   export SOUNIO_SOUC_ENGINE=lean_single
//   ./bin/souc run examples/particle_physics/su3_mass_gap_probe.sio

use particle_physics::lattice_su3::{
    su3_lat_l, su3_nsites, su3_nlinks, su3_flat_len,
    su3_seed, su3_lattice_cold, su3_thermalize, su3_mean_plaquette,
    su3_wilson_loop_rect, su3_creutz_ratio,
    su3_measure_ensemble, su3_plaquette_ep, su3_string_tension_ep,
    su3_mass_gap_proxy_ep,
}
use epistemic::knowledge::{ep_val, ep_std, ep_confidence}

fn fp6(v: f64) -> string with Mut, Div, Panic {
    var x = v
    var neg = false
    if x < 0.0 { neg = true; x = 0.0 - x }
    let n = (x * 1000000.0 + 0.5) as i64
    var whole = n / 1000000
    let frac = n % 1000000
    var buf: [i8; 64] = [0; 64]
    var pos: i64 = 0
    if neg { buf[0] = 45 as i8; pos = 1 }
    var wrev: [i8; 16] = [0; 16]
    var wlen: i64 = 0
    if whole == 0 { wrev[0] = 48 as i8; wlen = 1 }
    while whole > 0 && wlen < 15 {
        wrev[wlen as usize] = (48 + whole % 10) as i8
        wlen = wlen + 1
        whole = whole / 10
    }
    var i = wlen - 1
    while i >= 0 {
        buf[pos as usize] = wrev[i as usize]
        pos = pos + 1
        if i == 0 { break }
        i = i - 1
    }
    buf[pos as usize] = 46 as i8
    pos = pos + 1
    var div: i64 = 100000
    while div >= 1 {
        buf[pos as usize] = (48 + (frac / div) % 10) as i8
        pos = pos + 1
        div = div / 10
    }
    str_from_bytes(buf, pos)
}

fn i64s(v: i64) -> string with Mut, Div, Panic {
    if v == 0 { return "0" }
    var n = v
    var neg = false
    if n < 0 { neg = true; n = 0 - n }
    var rev: [i8; 24] = [0; 24]
    var len: i64 = 0
    while n > 0 && len < 23 {
        rev[len as usize] = (48 + n % 10) as i8
        len = len + 1
        n = n / 10
    }
    var buf: [i8; 32] = [0; 32]
    var pos: i64 = 0
    if neg { buf[0] = 45 as i8; pos = 1 }
    var i = len - 1
    while i >= 0 {
        buf[pos as usize] = rev[i as usize]
        pos = pos + 1
        if i == 0 { break }
        i = i - 1
    }
    str_from_bytes(buf, pos)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("================================================================")
    println(" SU(3) LATTICE YANG–MILLS — MASS-GAP / CONFINEMENT PROBE")
    println(" Sounio particle_physics::lattice_su3")
    println("================================================================")
    println("CLAIM: SU(3) lattice σ a² + glueball mass-gap proxy")
    println("NOT CLAIMED: continuum Clay theorem / full QCD")
    println("")

    println("L=" ++ i64s(su3_lat_l())
        ++ " sites=" ++ i64s(su3_nsites())
        ++ " links=" ++ i64s(su3_nlinks())
        ++ " flat=" ++ i64s(su3_flat_len()))

    // β = 6/g² ; 5.7 is a common pure-SU(3) scaling-region value on small volumes
    let beta: f64 = 5.7
    let eps: f64 = 0.25
    let n_therm: i64 = 25
    let n_meas: i64 = 16
    let n_sep: i64 = 2
    let seed: i64 = 20260813

    println("β=" ++ fp6(beta) ++ "  ε=" ++ fp6(eps)
        ++ "  therm=" ++ i64s(n_therm)
        ++ "  meas=" ++ i64s(n_meas)
        ++ "  sep=" ++ i64s(n_sep)
        ++ "  seed=" ++ i64s(seed))
    println("update: Cabibbo–Marinari SU(2) subgroups ×3 per link")
    println("")

    var lat: [f64; 93312] = [0.0; 93312]
    su3_seed(seed)
    su3_lattice_cold(&!lat)

    println("--- thermalize (cold start) ---")
    let p_th = su3_thermalize(&!lat, beta, eps, n_therm)
    println("⟨P⟩=ReTr/3 after therm = " ++ fp6(p_th)
        ++ "  (expect ~0.5–0.65 at β≈5.7)")

    let w11 = su3_wilson_loop_rect(&lat, 1, 1)
    let w12 = su3_wilson_loop_rect(&lat, 1, 2)
    let w22 = su3_wilson_loop_rect(&lat, 2, 2)
    let (chi0, ok0) = su3_creutz_ratio(&lat, 2)
    println("W(1,1)=" ++ fp6(w11) ++ " W(1,2)=" ++ fp6(w12)
        ++ " W(2,2)=" ++ fp6(w22))
    println("χ(2,2) single = " ++ fp6(chi0) ++ " valid=" ++ i64s(ok0))

    println("--- measure ensemble ---")
    var plaq_s: [f64; 256] = [0.0; 256]
    var chi_s: [f64; 256] = [0.0; 256]
    var chi_v: [i64; 256] = [0; 256]
    let n_ok = su3_measure_ensemble(
        &!lat, beta, eps, n_meas, n_sep, &!plaq_s, &!chi_s, &!chi_v
    )

    let pep = su3_plaquette_ep(&plaq_s, n_meas)
    let sep = su3_string_tension_ep(&chi_s, &chi_v, n_meas)
    let mep = su3_mass_gap_proxy_ep(&sep)

    println("")
    println("================================================================")
    println(" RESULTS (Epistemic)")
    println("================================================================")
    println("⟨P⟩            = " ++ fp6(ep_val(&pep)) ++ " ± " ++ fp6(ep_std(&pep))
        ++ "  conf=" ++ i64s(ep_confidence(&pep)))
    println("σ a² ≈ χ(2,2)  = " ++ fp6(ep_val(&sep)) ++ " ± " ++ fp6(ep_std(&sep))
        ++ "  conf=" ++ i64s(ep_confidence(&sep))
        ++ "  valid=" ++ i64s(n_ok) ++ "/" ++ i64s(n_meas))
    println("m_gap a proxy  = " ++ fp6(ep_val(&mep)) ++ " ± " ++ fp6(ep_std(&mep))
        ++ "  conf=" ++ i64s(ep_confidence(&mep))
        ++ "  (r≈3.5 fixed; model error not in SEM)")

    println("")
    println("================================================================")
    println(" GATES")
    println("================================================================")
    let p_ok = ep_val(&pep) > 0.35 && ep_val(&pep) < 0.95
    let confining = ep_val(&sep) > 0.0 && n_ok >= 2
    let gap = ep_val(&mep) > 0.0 && confining
    // W(1,1) should match mean plaquette order
    let w_ok = w11 > 0.3 && w11 < 0.95

    if p_ok { println("GATE plaquette_physical: PASS") }
    else { println("GATE plaquette_physical: FAIL_HONEST") }
    if w_ok { println("GATE wilson_w11_sane: PASS") }
    else { println("GATE wilson_w11_sane: FAIL_HONEST") }
    if confining { println("GATE creutz_confinement: PASS") }
    else { println("GATE creutz_confinement: FAIL_HONEST  (need more stats/β)") }
    if gap { println("GATE mass_gap_proxy_positive: PASS") }
    else { println("GATE mass_gap_proxy_positive: FAIL_HONEST") }

    println("")
    println("NOTE: SU(2) tower already has APE+L6+multi-β; this is the SU(3) gate.")
    println("OPEN NEXT: SU(3) heatbath · APE on SU(3) · β-scan · dynamical quarks")
    println("================================================================")
    0
}
