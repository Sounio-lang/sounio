// examples/particle_physics/exp10_approx_physics.sio
// Madaros-runnable free-fn LO/NWA physics (approx_effects_gum).
// Full exp10 algebra keeps original approx_effects for lean_single.

use particle_physics::sm_params::{mass_z}
use particle_physics::approx_effects_gum::{
    alpha_s_lo_ep_gum, z_partial_width_nwa_ep_gum, h_bb_width_nwa_ep_gum, ggh_lo_xsec_ep_gum,
}
use epistemic::knowledge::{ep_val, ep_variance}

fn pass_if(cond: bool, tag: i64) -> i64 with IO {
    if cond {
        print("PASS ")
        print_int(tag)
        print("\n")
        1
    } else {
        print("FAIL ")
        print_int(tag)
        print("\n")
        0
    }
}

fn main() -> i32 with IO, NarrowWidthApproximation, Perturbative, Mut, Div, Panic {
    print("PARTICLE_EXP10_PHYSICS_BEGIN\n")
    var n: i64 = 0
    let mz = ep_val(&mass_z())

    let as_lo = alpha_s_lo_ep_gum(mz)
    print("EXP10P_ALPHA_S_LO ")
    print_f64(ep_val(&as_lo))
    print("\n")
    n = n + pass_if(ep_val(&as_lo) > 0.10 && ep_val(&as_lo) < 0.14, 1)
    n = n + pass_if(ep_variance(&as_lo) > 0.0, 2)

    let g_nu = 0.5 * 0.5 + 0.5 * 0.5
    let w_nu = z_partial_width_nwa_ep_gum(g_nu, 1.0)
    print("EXP10P_Z_WIDTH_NWA ")
    print_f64(ep_val(&w_nu))
    print("\n")
    n = n + pass_if(ep_val(&w_nu) > 0.10 && ep_val(&w_nu) < 0.25, 3)
    n = n + pass_if(ep_variance(&w_nu) > 0.0, 4)

    let w_bb = h_bb_width_nwa_ep_gum()
    print("EXP10P_HBB ")
    print_f64(ep_val(&w_bb))
    print("\n")
    n = n + pass_if(ep_val(&w_bb) > 0.001 && ep_val(&w_bb) < 0.01, 5)
    n = n + pass_if(ep_variance(&w_bb) > 0.0, 6)

    let sig = ggh_lo_xsec_ep_gum(125.2, 13000.0)
    print("EXP10P_GGH_LO ")
    print_f64(ep_val(&sig))
    print("\n")
    n = n + pass_if(ep_val(&sig) > 0.0, 7)
    n = n + pass_if(ep_variance(&sig) > 0.0, 8)

    print("PARTICLE_EXP10_PHYSICS_PASS ")
    print_int(n)
    print("\n")
    if n == 8 {
        print("PARTICLE_EXP10_PHYSICS_OK\n")
        0
    } else {
        print("PARTICLE_EXP10_PHYSICS_FAILED\n")
        1
    }
}
