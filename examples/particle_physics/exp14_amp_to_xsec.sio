// examples/particle_physics/exp14_amp_to_xsec.sio
//
// EXP14 — Observable from amplitude (amp → σ honesty)
//
// Closes the next residual after EXP13: |M|² is not the claim; the physical
// observable is the continuum cross-section
//
//   σ(s) = |M|²(s) · s / (12π)
//
// Uses Madaros-safe `eemm_z_amplitude_nu` (vertex path) after the E175 close
// (private extern "C" sqrt stubs removed; see particle_e175_amp_import_2026-08-05).
// Peak comparison still uses nonunitary::eemm_z_peak_xsec_nu (NWA widths).
//
// Pillars:
//   P1 — |M|² at pole in physical range (order ~1e-7 GeV⁻⁴)
//   P2 — σ_from_amp at pole in physical range (order ~1e-4 GeV⁻²)
//   P3 — NWA peak-widths formula is a DIFFERENT construction: ratio
//        σ_from_amp / σ_peak ∈ [10, 20] (measured ~13.95; not claimed equal)
//   P4 — off-pole (s = 1.01 M_Z²) σ drops vs pole (BW shape)
//   P5 — GUM variance on |M|² stays positive through the chain
//
// Gate: scripts/research/particle_exp14_amp_xsec_gate.sh

use particle_physics::sm_params::{mass_z}
use particle_physics::nonunitary::{eemm_z_peak_xsec_nu}
use particle_physics::nonunitary_amp::{eemm_z_amplitude_nu}
use epistemic::knowledge::{ep_val, ep_variance}

fn pass_if(cond: bool, tag: i64) -> i64 with IO {
    if cond {
        print("PASS ")
        print_int(tag)
        print("\n")
        1
    } else {
        print("FAIL ")
        print_int(tag)
        print("\n")
        0
    }
}

fn main() -> i32 with IO, NonUnitary, Mut, Div, Panic {
    print("PARTICLE_EXP14_BEGIN\n")
    print("EXP14_CLAIM observable_from_amplitude_sigma_eq_amp_sq_times_s_over_12pi\n")
    var n: i64 = 0

    let mz = mass_z().val()
    let s_pole = mz * mz
    let gz = 2.4952
    let pi = 3.14159265358979323846

    let nu = eemm_z_amplitude_nu(s_pole, gz)
    let amp = ep_val(&nu.amp_sq)
    let amp_var = ep_variance(&nu.amp_sq)
    // σ = |M|² · s / (12π)
    let sigma = amp * s_pole / (12.0 * pi)

    let peak_ep = eemm_z_peak_xsec_nu(0.08399, 0.08399, gz)
    let peak = ep_val(&peak_ep)
    let ratio = sigma / peak

    let s_off = s_pole * 1.01
    let nu_off = eemm_z_amplitude_nu(s_off, gz)
    let amp_off = ep_val(&nu_off.amp_sq)
    let sigma_off = amp_off * s_off / (12.0 * pi)

    // print_f64 may render ~3e-7 as 0.000000; gates use raw f64 compares.
    print("EXP14_AMP ")
    print_f64(amp)
    print("\n")
    print("EXP14_AMP_VAR ")
    print_f64(amp_var)
    print("\n")
    print("EXP14_SIGMA ")
    print_f64(sigma)
    print("\n")
    print("EXP14_PEAK ")
    print_f64(peak)
    print("\n")
    print("EXP14_RATIO ")
    print_f64(ratio)
    print("\n")
    print("EXP14_SIGMA_OFF ")
    print_f64(sigma_off)
    print("\n")

    let p1 = amp > 1.0e-9 && amp < 1.0e-4
    n = n + pass_if(p1, 2201)

    let p2 = sigma > 1.0e-6 && sigma < 1.0e-3
    n = n + pass_if(p2, 2202)

    let p3 = peak > 1.0e-7 && peak < 1.0e-4 && ratio > 10.0 && ratio < 20.0
    n = n + pass_if(p3, 2203)

    let p4 = sigma_off > 0.0 && sigma_off < sigma
    n = n + pass_if(p4, 2204)

    let p5 = amp_var > 0.0
    n = n + pass_if(p5, 2205)

    let expected: i64 = 5
    print("EXP14_LEDGER_JSON {")
    print("\"schema\":\"particle.exp14.amp_to_xsec.v1\",")
    print("\"claim\":\"observable_from_amplitude_sigma_eq_amp_sq_times_s_over_12pi\",")
    print("\"amp\":")
    print_f64(amp)
    print(",\"amp_var\":")
    print_f64(amp_var)
    print(",\"sigma\":")
    print_f64(sigma)
    print(",\"peak\":")
    print_f64(peak)
    print(",\"ratio_sigma_over_peak\":")
    print_f64(ratio)
    print(",\"sigma_off\":")
    print_f64(sigma_off)
    print(",\"formula\":\"sigma = amp_sq * s / (12 * pi)\",")
    print("\"source\":\"eemm_z_amplitude_nu\",")
    print("\"nonclaim\":\"peak_widths_nwa_not_equal_to_continuum_bw\"")
    print("}\n")

    print("PARTICLE_EXP14_PASS ")
    print_int(n)
    print("\n")
    if n == expected {
        print("PARTICLE_EXP14_OK\n")
        0
    } else {
        print("PARTICLE_EXP14_FAILED\n")
        1
    }
}
