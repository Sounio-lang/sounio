//@ run-pass
// examples/particle_physics/su2_continuum_heatbath.sio
//
// OPEN PROBLEM ATTACK — SU(2) multi-β continuum sketch with CREUTZ HEATBATH
// ========================================================================
// Production-grade pipeline (exact heatbath, no Metropolis reject) at each β:
//   cold → heatbath therm → APE 0++ m_eff + Creutz σ → m_eff/√σ
//
// Prior Metropolis multi-β: ⟨r⟩≈4.38±1.12 (2–3 ok points).
// Production L=6 HB single-β: r≈3.81 (in lit window).
// This run: multi-β with HB+APE to test β-constancy of the dimensionless gap.
//
// CLAIM: heatbath multi-β trend of pure-SU(2) spectral gap scale.
// NOT CLAIMED: controlled a→0 continuum fit; Clay theorem; infinite volume.
//
// L=4 for multi-point budget (L=6 single-β production in mass_gap_heatbath_production).
//
// Run:
//   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib
//   export SOUNIO_SOUC_ENGINE=lean_single
//   ./bin/souc run examples/particle_physics/su2_continuum_heatbath.sio

use particle_physics::lattice_gauge::{
    lat_l, lg_set_L, lg_seed, lattice_cold, heatbath_thermalize,
    measure_glueball_thin_and_ape_hb, measure_ensemble_hb,
    plaquette_ep, string_tension_ep,
    glueball_meff_log, glueball_meff_ep_from_samples,
}
use epistemic::knowledge::{Epistemic, ep_val, ep_std, ep_confidence}

fn fp6(v: f64) -> string with Mut, Div, Panic {
    var x = v
    var neg = false
    if x < 0.0 { neg = true; x = 0.0 - x }
    let n = (x * 1000000.0 + 0.5) as i64
    var whole = n / 1000000
    let frac = n % 1000000
    var buf: [i8; 64] = [0; 64]
    var pos: i64 = 0
    if neg { buf[0] = 45 as i8; pos = 1 }
    var wrev: [i8; 16] = [0; 16]
    var wlen: i64 = 0
    if whole == 0 { wrev[0] = 48 as i8; wlen = 1 }
    while whole > 0 && wlen < 15 {
        wrev[wlen as usize] = (48 + whole % 10) as i8
        wlen = wlen + 1
        whole = whole / 10
    }
    var i = wlen - 1
    while i >= 0 {
        buf[pos as usize] = wrev[i as usize]
        pos = pos + 1
        if i == 0 { break }
        i = i - 1
    }
    buf[pos as usize] = 46 as i8
    pos = pos + 1
    var div: i64 = 100000
    while div >= 1 {
        buf[pos as usize] = (48 + (frac / div) % 10) as i8
        pos = pos + 1
        div = div / 10
    }
    str_from_bytes(buf, pos)
}

fn i64s(v: i64) -> string with Mut, Div, Panic {
    if v == 0 { return "0" }
    var n = v
    var neg = false
    if n < 0 { neg = true; n = 0 - n }
    var rev: [i8; 24] = [0; 24]
    var len: i64 = 0
    while n > 0 && len < 23 {
        rev[len as usize] = (48 + n % 10) as i8
        len = len + 1
        n = n / 10
    }
    var buf: [i8; 32] = [0; 32]
    var pos: i64 = 0
    if neg { buf[0] = 45 as i8; pos = 1 }
    var i = len - 1
    while i >= 0 {
        buf[pos as usize] = rev[i as usize]
        pos = pos + 1
        if i == 0 { break }
        i = i - 1
    }
    str_from_bytes(buf, pos)
}

fn sqrt_q(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var g = x
    var k: i64 = 0
    while k < 40 { g = 0.5 * (g + x / g); k = k + 1 }
    g
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn nsmear_for_beta(beta: f64) -> i64 {
    if beta >= 2.45 { return 2 }
    if beta >= 2.35 { return 2 }
    3
}

/// One β with Creutz heatbath: therm → APE m_eff → Creutz σ.
/// Returns (plaq, sig, ssem, meff, msem, r, ok) ok:1=APE 2=thin 0=fail.
fn run_beta_hb(
    lat: &![f64; 65536],
    sm: &![f64; 65536],
    tmp: &![f64; 65536],
    beta: f64,
    n_therm: i64,
    n_meas: i64,
    n_sep: i64,
    alpha: f64,
    seed: i64
) -> (f64, f64, f64, f64, f64, f64, i64) with Mut, Div, Panic {
    let n_smear = nsmear_for_beta(beta)
    lg_seed(seed)
    lattice_cold(lat)
    let _pt = heatbath_thermalize(lat, beta, n_therm)

    var c_thin: [f64; 8] = [0.0; 8]
    var c_ape: [f64; 8] = [0.0; 8]
    var mt_s: [f64; 256] = [0.0; 256]
    var mt_v: [i64; 256] = [0; 256]
    var ma_s: [f64; 256] = [0.0; 256]
    var ma_v: [i64; 256] = [0; 256]

    let (_nt, _na, _ot, _oa) = measure_glueball_thin_and_ape_hb(
        lat, sm, tmp, beta, n_meas, n_sep, alpha, n_smear,
        &!c_thin, &!c_ape, &!mt_s, &!mt_v, &!ma_s, &!ma_v
    )

    let (m_ape, ok_ape) = glueball_meff_log(c_ape[0], c_ape[1])
    let (m_thin, ok_thin) = glueball_meff_log(c_thin[0], c_thin[1])
    let cfg_a = glueball_meff_ep_from_samples(&ma_s, &ma_v, n_meas)
    let cfg_t = glueball_meff_ep_from_samples(&mt_s, &mt_v, n_meas)

    var meff: f64 = 0.0
    var meff_sem: f64 = 0.0
    var used: i64 = 0
    if ok_ape == 1 && m_ape > 0.0 {
        meff = m_ape
        meff_sem = 0.15 * m_ape
        if ep_val(&cfg_a) > 0.0 && ep_std(&cfg_a) > 0.0 {
            meff_sem = ep_std(&cfg_a)
        }
        used = 1
    } else if ok_thin == 1 && m_thin > 0.0 {
        meff = m_thin
        meff_sem = 0.2 * m_thin
        if ep_val(&cfg_t) > 0.0 && ep_std(&cfg_t) > 0.0 {
            meff_sem = ep_std(&cfg_t)
        }
        used = 2
    }

    var plaq_s: [f64; 256] = [0.0; 256]
    var chi_s: [f64; 256] = [0.0; 256]
    var chi_v: [i64; 256] = [0; 256]
    let n_ctx: i64 = 12
    let _nc = measure_ensemble_hb(lat, beta, n_ctx, n_sep, &!plaq_s, &!chi_s, &!chi_v)
    let pep = plaquette_ep(&plaq_s, n_ctx)
    let sep = string_tension_ep(&chi_s, &chi_v, n_ctx)
    let plaq = ep_val(&pep)
    let sig = ep_val(&sep)
    let ssem = ep_std(&sep)
    let srt = sqrt_q(sig)

    var r: f64 = 0.0
    var ok: i64 = 0
    if used > 0 && srt > 1.0e-12 && meff > 0.0 {
        r = meff / srt
        ok = used
    }
    (plaq, sig, ssem, meff, meff_sem, r, ok)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("================================================================")
    println(" SU(2) MULTI-β CONTINUUM — CREUTZ HEATBATH + APE")
    println("================================================================")
    println("CLAIM: HB multi-β trend of pure-SU(2) m_eff/√σ (spectral)")
    println("NOT CLAIMED: continuum Clay theorem / infinite volume")
    println("anchor: L=6 HB production r≈3.81 (mass_gap_heatbath_production)")
    println("")

    let _ = lg_set_L(4)
    println("L=" ++ i64s(lat_l()) ++ "  β ∈ {2.2, 2.3, 2.4, 2.5}  update=Creutz heatbath")

    var betas: [f64; 4] = [2.2, 2.3, 2.4, 2.5]
    let n_beta: i64 = 4
    let n_therm: i64 = 40
    let n_meas: i64 = 36
    let n_sep: i64 = 3
    let alpha: f64 = 0.4
    let seed0: i64 = 20260813

    println("therm=" ++ i64s(n_therm) ++ " meas=" ++ i64s(n_meas)
        ++ " sep=" ++ i64s(n_sep) ++ " APE α=" ++ fp6(alpha))
    println("ok: 1=APE  2=thin  0=fail")
    println("")

    var lat: [f64; 65536] = [0.0; 65536]
    var sm: [f64; 65536] = [0.0; 65536]
    var tmp: [f64; 65536] = [0.0; 65536]

    var plaqs: [f64; 4] = [0.0; 4]
    var sigs: [f64; 4] = [0.0; 4]
    var meffs: [f64; 4] = [0.0; 4]
    var ratios: [f64; 4] = [0.0; 4]
    var oks: [i64; 4] = [0; 4]

    var b: i64 = 0
    while b < n_beta {
        let beta = betas[b as usize]
        let seed = seed0 + 17000 * (b + 1)
        println("--- β=" ++ fp6(beta) ++ " seed=" ++ i64s(seed)
            ++ " n_smear=" ++ i64s(nsmear_for_beta(beta)) ++ " ---")
        let (plaq, sig, ssem, meff, msem, r, ok) = run_beta_hb(
            &!lat, &!sm, &!tmp, beta, n_therm, n_meas, n_sep, alpha, seed
        )
        plaqs[b as usize] = plaq
        sigs[b as usize] = sig
        meffs[b as usize] = meff
        ratios[b as usize] = r
        oks[b as usize] = ok
        println("  ⟨P⟩=" ++ fp6(plaq)
            ++ " σa²=" ++ fp6(sig) ++ "±" ++ fp6(ssem)
            ++ " m_eff=" ++ fp6(meff) ++ "±" ++ fp6(msem)
            ++ " m/√σ=" ++ fp6(r)
            ++ " ok=" ++ i64s(ok))
        b = b + 1
    }

    println("")
    println("================================================================")
    println(" TABLE: β | ⟨P⟩ | σ a² | m_eff | m/√σ | ok")
    println("================================================================")
    b = 0
    while b < n_beta {
        println("  " ++ fp6(betas[b as usize])
            ++ " | " ++ fp6(plaqs[b as usize])
            ++ " | " ++ fp6(sigs[b as usize])
            ++ " | " ++ fp6(meffs[b as usize])
            ++ " | " ++ fp6(ratios[b as usize])
            ++ " | " ++ i64s(oks[b as usize]))
        b = b + 1
    }

    var n_ok: i64 = 0
    var n_phys: i64 = 0
    var n_lit: i64 = 0
    var sum_r: f64 = 0.0
    var sum_r2: f64 = 0.0
    b = 0
    while b < n_beta {
        if oks[b as usize] > 0 {
            n_ok = n_ok + 1
            let r = ratios[b as usize]
            sum_r = sum_r + r
            sum_r2 = sum_r2 + r * r
            if r > 1.5 && r < 8.0 { n_phys = n_phys + 1 }
            if r > 2.5 && r < 5.5 { n_lit = n_lit + 1 }
        }
        b = b + 1
    }

    var r_mean: f64 = 0.0
    var r_std: f64 = 0.0
    if n_ok > 0 { r_mean = sum_r / (n_ok as f64) }
    if n_ok > 1 {
        let vr = sum_r2 / (n_ok as f64) - r_mean * r_mean
        if vr > 0.0 { r_std = sqrt_q(vr) }
    }

    var n_plaq_up: i64 = 0
    b = 0
    while b < n_beta - 1 {
        if plaqs[(b + 1) as usize] > plaqs[b as usize] { n_plaq_up = n_plaq_up + 1 }
        b = b + 1
    }

    var n_sqrt_down: i64 = 0
    var n_pairs: i64 = 0
    b = 0
    while b < n_beta - 1 {
        if oks[b as usize] > 0 && oks[(b + 1) as usize] > 0 {
            n_pairs = n_pairs + 1
            if sqrt_q(sigs[(b + 1) as usize]) < sqrt_q(sigs[b as usize]) {
                n_sqrt_down = n_sqrt_down + 1
            }
        }
        b = b + 1
    }

    var max_rel: f64 = 0.0
    if r_mean > 1.0e-12 {
        b = 0
        while b < n_beta {
            if oks[b as usize] > 0 {
                let rel = abs_f(ratios[b as usize] - r_mean) / r_mean
                if rel > max_rel { max_rel = rel }
            }
            b = b + 1
        }
    }

    // Compare to prior Metropolis multi-β and L=6 production anchor
    let metro_mean: f64 = 4.383420
    let l6_anchor: f64 = 3.807182

    let r_ep = Epistemic {
        val: r_mean,
        variance: r_std * r_std,
        confidence: 500
    }

    println("")
    println("continuum-sketch summary (HEATBATH):")
    println("  ok points          = " ++ i64s(n_ok) ++ "/" ++ i64s(n_beta))
    println("  phys window (1.5–8)= " ++ i64s(n_phys))
    println("  lit window (2.5–5.5)= " ++ i64s(n_lit))
    println("  ⟨m/√σ⟩_β HB        = " ++ fp6(r_mean) ++ " ± " ++ fp6(r_std)
        ++ "  conf=" ++ i64s(ep_confidence(&r_ep)))
    println("  prior Metropolis ⟨r⟩= " ++ fp6(metro_mean) ++ "  (worse scatter era)")
    println("  L=6 HB production  = " ++ fp6(l6_anchor) ++ "  (single-β anchor)")
    println("  ⟨P⟩ rises w/ β     = " ++ i64s(n_plaq_up) ++ "/" ++ i64s(n_beta - 1))
    println("  √σ falls w/ β      = " ++ i64s(n_sqrt_down) ++ "/" ++ i64s(n_pairs))
    println("  max |r−⟨r⟩|/⟨r⟩   = " ++ fp6(max_rel))

    // crude linear slope dr/dβ over ok endpoints
    var slope: f64 = 0.0
    var slope_ok: i64 = 0
    if n_ok >= 2 {
        // first and last ok
        var i0: i64 = 0 - 1
        var i1: i64 = 0 - 1
        b = 0
        while b < n_beta {
            if oks[b as usize] > 0 {
                if i0 < 0 { i0 = b }
                i1 = b
            }
            b = b + 1
        }
        if i0 >= 0 && i1 > i0 {
            let db = betas[i1 as usize] - betas[i0 as usize]
            if abs_f(db) > 1.0e-12 {
                slope = (ratios[i1 as usize] - ratios[i0 as usize]) / db
                slope_ok = 1
            }
        }
    }
    println("  crude Δr/Δβ (ends) = " ++ fp6(slope)
        ++ "  (→0 is continuum-sketch friendly)")

    println("")
    println("================================================================")
    println(" GATES")
    println("================================================================")
    let g_multi = n_ok >= 3
    let g_phys = n_phys >= 3
    let g_lit = n_lit >= 2
    let g_plaq = n_plaq_up >= 2
    let g_scale = n_pairs == 0 || n_sqrt_down >= 1
    var g_const = false
    if n_ok >= 2 && r_mean > 0.0 {
        if r_std / r_mean < 0.55 { g_const = true }
    }
    let g_mean_lit = r_mean > 2.5 && r_mean < 5.5
    // improve vs Metropolis: mean closer to L6 anchor or lower scatter
    var g_better = false
    if n_ok >= 2 {
        let d_hb = abs_f(r_mean - l6_anchor)
        let d_m = abs_f(metro_mean - l6_anchor)
        if d_hb < d_m { g_better = true }
        if r_std < 1.0 { g_better = true }
    }
    let g_flat = slope_ok == 1 && abs_f(slope) < 8.0

    if g_multi { println("GATE multi_beta_ok_points: PASS") }
    else { println("GATE multi_beta_ok_points: FAIL_HONEST") }
    if g_phys { println("GATE ratios_in_phys_window: PASS") }
    else { println("GATE ratios_in_phys_window: FAIL_HONEST") }
    if g_lit { println("GATE ratios_in_lit_window: PASS") }
    else { println("GATE ratios_in_lit_window: FAIL_HONEST") }
    if g_plaq { println("GATE plaquette_rises_with_beta: PASS") }
    else { println("GATE plaquette_rises_with_beta: FAIL_HONEST") }
    if g_scale { println("GATE sqrt_sigma_trend: PASS") }
    else { println("GATE sqrt_sigma_trend: FAIL_HONEST") }
    if g_const { println("GATE ratio_beta_scatter_bounded: PASS") }
    else { println("GATE ratio_beta_scatter_bounded: FAIL_HONEST") }
    if g_mean_lit { println("GATE mean_ratio_in_literature: PASS  ★") }
    else { println("GATE mean_ratio_in_literature: FAIL_HONEST") }
    if g_better { println("GATE improves_on_metropolis_sketch: PASS") }
    else { println("GATE improves_on_metropolis_sketch: FAIL_HONEST") }
    if g_flat { println("GATE crude_slope_bounded: PASS") }
    else { println("GATE crude_slope_bounded: FAIL_HONEST") }

    println("")
    println("INTERPRETATION: HB multi-β constancy + L=6 anchor ≈ continuum *sketch*.")
    println("Still not a→0 extrapolation with controlled systematics / Clay.")
    println("OPEN NEXT: L=6 multi-β HB · SU(3) L↑ HB · continuum fit in a√σ")
    println("================================================================")
    0
}
