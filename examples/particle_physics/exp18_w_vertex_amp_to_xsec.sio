// examples/particle_physics/exp18_w_vertex_amp_to_xsec.sio
//
// EXP18 — W amp→σ via stdlib charged-current amplitude
//
// Twin of EXP14's Z restore: continuum σ from
//
//   σ(s) = |M|²(s) · s / (12π)
//
// with |M|² from `nonunitary_amp::cc_w_leptonic_amplitude_nu`
// (num = (g²/2)² via coupling_g GUM), not an inlined PDG scalar.
//
// NWA peak toy unchanged from EXP15 (local leptonic Br·Γ_W).
// Honesty band for continuum/peak: (2, 6); measured ~3.49.
//
// Gate: scripts/research/particle_exp18_w_vertex_amp_gate.sh

use particle_physics::sm_params::{mass_w}
use particle_physics::nonunitary_amp::{cc_w_leptonic_amplitude_nu}
use epistemic::knowledge::{ep_val, ep_variance}

fn pass_if(cond: bool, tag: i64) -> i64 with IO {
    if cond {
        print("PASS ")
        print_int(tag)
        print("\n")
        1
    } else {
        print("FAIL ")
        print_int(tag)
        print("\n")
        0
    }
}

fn main() -> i32 with IO, NonUnitary, Mut, Div, Panic {
    print("PARTICLE_EXP18_BEGIN\n")
    print("EXP18_CLAIM w_vertex_amp_to_xsec_via_cc_w_leptonic_amplitude_nu\n")
    var n: i64 = 0

    let mw = mass_w().val()
    let s_pole = mw * mw
    let gw = 2.085
    let pi = 3.14159265358979323846

    let br_ln = 0.1086
    let gamma_ln = br_ln * gw

    let nu = cc_w_leptonic_amplitude_nu(s_pole, gw)
    let amp = ep_val(&nu.amp_sq)
    let amp_var = ep_variance(&nu.amp_sq)
    let sigma = amp * s_pole / (12.0 * pi)

    let peak = 12.0 * pi * gamma_ln * gamma_ln / (s_pole * gw * gw)
    let ratio = sigma / peak

    let s_off = s_pole * 1.01
    let nu_off = cc_w_leptonic_amplitude_nu(s_off, gw)
    let amp_off = ep_val(&nu_off.amp_sq)
    let sigma_off = amp_off * s_off / (12.0 * pi)

    print("EXP18_AMP ")
    print_f64(amp)
    print("\n")
    print("EXP18_AMP_VAR ")
    print_f64(amp_var)
    print("\n")
    print("EXP18_SIGMA ")
    print_f64(sigma)
    print("\n")
    print("EXP18_PEAK ")
    print_f64(peak)
    print("\n")
    print("EXP18_RATIO ")
    print_f64(ratio)
    print("\n")
    print("EXP18_SIGMA_OFF ")
    print_f64(sigma_off)
    print("\n")

    let p1 = amp > 1.0e-9 && amp < 1.0e-3
    n = n + pass_if(p1, 2601)

    let p2 = sigma > 1.0e-6 && sigma < 1.0e-2
    n = n + pass_if(p2, 2602)

    let p3 = peak > 1.0e-6 && peak < 1.0e-3 && ratio > 2.0 && ratio < 6.0
    n = n + pass_if(p3, 2603)

    let p4 = sigma_off > 0.0 && sigma_off < sigma
    n = n + pass_if(p4, 2604)

    let p5 = amp_var > 0.0
    n = n + pass_if(p5, 2605)

    let expected: i64 = 5
    print("EXP18_LEDGER_JSON {")
    print("\"schema\":\"particle.exp18.w_vertex_amp_to_xsec.v1\",")
    print("\"claim\":\"w_vertex_amp_to_xsec_via_cc_w_leptonic_amplitude_nu\",")
    print("\"amp\":")
    print_f64(amp)
    print(",\"amp_var\":")
    print_f64(amp_var)
    print(",\"sigma\":")
    print_f64(sigma)
    print(",\"peak\":")
    print_f64(peak)
    print(",\"ratio_sigma_over_peak\":")
    print_f64(ratio)
    print(",\"sigma_off\":")
    print_f64(sigma_off)
    print(",\"num_cc\":\"(g^2/2)^2\",")
    print("\"source\":\"cc_w_leptonic_amplitude_nu\",")
    print("\"formula\":\"sigma = amp_sq * s / (12 * pi)\",")
    print("\"nonclaim\":\"nwa_peak_not_equal_to_continuum_bw; not_full_enu_matrix_element\"")
    print("}\n")

    print("PARTICLE_EXP18_PASS ")
    print_int(n)
    print("\n")
    if n == expected {
        print("PARTICLE_EXP18_OK\n")
        0
    } else {
        print("PARTICLE_EXP18_FAILED\n")
        1
    }
}
