// examples/particle_physics/exp123_madaros_core.sio
//
// Madaros-runnable core of the EXP123 reactor (N4).
//
// Full exp123_z_metrology_nonunitary_ew.sio still SEGVs Madaros at
// lower_array: dep_begin once the main IR grows (local blocker doc).
// This core proves default-engine native run of:
//   EXP1-style Z width, EXP2-style NonUnitary deficit+peak, EXP3-style tension.
//
// Run:
//   SOUNIO_SOUC_ENGINE=madaros ./bin/souc run examples/particle_physics/exp123_madaros_core.sio

use particle_physics::sm_params::{mass_z}
use particle_physics::epistemic_chain_z::{
    z_width_ee_ep, z_width_ee_budget, chain_gate_z_width,
}
use particle_physics::nonunitary::{
    nu_z_propagator, nu_deficit, eemm_z_peak_xsec_nu, NU_Z,
}
use particle_physics::ew_precision::{
    m_w_consistency_pull, m_w_consistency_pull_radiative, m_w_consistency_pull_gf,
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn within(a: f64, b: f64, tol: f64) -> bool {
    abs_f(a - b) < tol
}

fn pass_if(cond: bool, tag: i64) -> i64 with IO {
    if cond {
        print("PASS ")
        print_int(tag)
        print("\n")
        1
    } else {
        print("FAIL ")
        print_int(tag)
        print("\n")
        0
    }
}

fn main() -> i32 with IO, NonUnitary, Mut, Div, Panic {
    print("PARTICLE_MADAROS_CORE_BEGIN\n")
    var n: i64 = 0

    // EXP1 core
    let gz = z_width_ee_ep()
    let budget = z_width_ee_budget()
    print("CORE_GEE ")
    print_f64(gz.val())
    print("\n")
    n = n + pass_if(gz.val() > 0.05 && gz.val() < 0.12, 1)
    n = n + pass_if(gz.std() > 0.0, 2)
    n = n + pass_if(gz.confidence() >= 800, 3)
    n = n + pass_if(budget[0] > 0.0 && budget[1] > 0.0, 4)
    n = n + pass_if(chain_gate_z_width(800) == 1, 5)

    // EXP2 core
    let mz = mass_z().val()
    let prop = nu_z_propagator(mz * mz, 2.4952)
    let d = nu_deficit(prop)
    let peak = eemm_z_peak_xsec_nu(0.08399, 0.08399, 2.4952)
    print("CORE_DEFICIT_POLE ")
    print_f64(d)
    print("\n")
    print("CORE_PEAK ")
    print_f64(peak.val())
    print("\n")
    n = n + pass_if(within(d, 1.0, 0.001), 6)
    n = n + pass_if(prop.particle == NU_Z(), 7)
    n = n + pass_if(peak.val() > 1.0e-7 && peak.val() < 1.0e-4, 8)

    // EXP3 core — pull ladder via f64 consistency pulls (Madaros-safe)
    let pull0 = m_w_consistency_pull()
    let pull1 = m_w_consistency_pull_radiative()
    let pull2 = m_w_consistency_pull_gf()
    print("CORE_PULL_TREE ")
    print_f64(pull0)
    print("\n")
    print("CORE_PULL_RAD ")
    print_f64(pull1)
    print("\n")
    print("CORE_PULL_GF ")
    print_f64(pull2)
    print("\n")
    let a0 = if pull0 < 0.0 { 0.0 - pull0 } else { pull0 }
    let a1 = if pull1 < 0.0 { 0.0 - pull1 } else { pull1 }
    let a2 = if pull2 < 0.0 { 0.0 - pull2 } else { pull2 }
    n = n + pass_if(a1 < a0, 9)
    n = n + pass_if(a2 < a1, 10)
    n = n + pass_if(a2 < 3.0, 11)

    let expected: i64 = 11
    print("PARTICLE_MADAROS_CORE_PASS ")
    print_int(n)
    print("\n")
    if n == expected {
        print("PARTICLE_MADAROS_CORE_OK\n")
        0
    } else {
        print("PARTICLE_MADAROS_CORE_FAILED\n")
        1
    }
}
