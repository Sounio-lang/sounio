// examples/particle_physics/exp15_w_amp_to_xsec.sio
//
// EXP15 — W observable from amplitude (amp → σ honesty)
//
// W twin of EXP14 on the same thin import graph:
//
//   σ(s) = |M|²(s) · s / (12π)
//
// with |M|² = num · |D_W|², |D_W|² = nu_w_propagator, and
// num = (g²/2)² = g⁴/4  (two V−A charged-current vertices).
//
// NWA peak for the leptonic s-channel toy νe e → νμ μ:
//   σ_peak = 12π · Γ_eν · Γ_μν / (M_W² · Γ_W²),   Γ_ℓν = Br(W→ℓν)·Γ_W
//
// Measured continuum/peak ratio ~3.5 — construction gap, not equality.
//
// Gate: scripts/research/particle_exp15_w_amp_xsec_gate.sh

use particle_physics::sm_params::{mass_w}
use particle_physics::nonunitary::{nu_w_propagator}
use epistemic::knowledge::{ep_val, ep_variance}

fn pass_if(cond: bool, tag: i64) -> i64 with IO {
    if cond {
        print("PASS ")
        print_int(tag)
        print("\n")
        1
    } else {
        print("FAIL ")
        print_int(tag)
        print("\n")
        0
    }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("PARTICLE_EXP15_BEGIN\n")
    print("EXP15_CLAIM w_observable_from_amplitude_sigma_eq_amp_sq_times_s_over_12pi\n")
    var n: i64 = 0

    let mw = mass_w().val()
    let s_pole = mw * mw
    let gw = 2.085
    let pi = 3.14159265358979323846

    // PDG-central scalars (= sm_params centrals). Same lean_single import
    // discipline as EXP14 (no coupling_g / ep_scale selective-import).
    let g = 0.629773
    let g2 = g * g
    let num = (g2 * g2) / 4.0

    // PDG-scale leptonic branching for the NWA peak toy (Br ≈ 10.86%).
    let br_ln = 0.1086
    let gamma_ln = br_ln * gw

    let prop = nu_w_propagator(s_pole, gw)
    let prop_a = ep_val(&prop.amp_sq)
    let prop_v = ep_variance(&prop.amp_sq)
    let amp = prop_a * num
    let amp_var = prop_v * num * num
    let sigma = amp * s_pole / (12.0 * pi)

    // Local NWA peak (no imported eemm_w_peak — not in stdlib).
    let peak = 12.0 * pi * gamma_ln * gamma_ln / (s_pole * gw * gw)
    let ratio = sigma / peak

    let s_off = s_pole * 1.01
    let prop_off = nu_w_propagator(s_off, gw)
    let amp_off = ep_val(&prop_off.amp_sq) * num
    let sigma_off = amp_off * s_off / (12.0 * pi)

    print("EXP15_AMP ")
    print_f64(amp)
    print("\n")
    print("EXP15_AMP_VAR ")
    print_f64(amp_var)
    print("\n")
    print("EXP15_SIGMA ")
    print_f64(sigma)
    print("\n")
    print("EXP15_PEAK ")
    print_f64(peak)
    print("\n")
    print("EXP15_RATIO ")
    print_f64(ratio)
    print("\n")
    print("EXP15_SIGMA_OFF ")
    print_f64(sigma_off)
    print("\n")

    // P1 — |M|² pole range
    let p1 = amp > 1.0e-9 && amp < 1.0e-3
    n = n + pass_if(p1, 2301)

    // P2 — continuum σ from amp
    let p2 = sigma > 1.0e-6 && sigma < 1.0e-2
    n = n + pass_if(p2, 2302)

    // P3 — NWA peak distinct; measured ratio ~3.5 ∈ (2, 6)
    let p3 = peak > 1.0e-6 && peak < 1.0e-3 && ratio > 2.0 && ratio < 6.0
    n = n + pass_if(p3, 2303)

    // P4 — BW shape
    let p4 = sigma_off > 0.0 && sigma_off < sigma
    n = n + pass_if(p4, 2304)

    // P5 — GUM alive (M_W in propagator)
    let p5 = amp_var > 0.0
    n = n + pass_if(p5, 2305)

    let expected: i64 = 5
    print("EXP15_LEDGER_JSON {")
    print("\"schema\":\"particle.exp15.w_amp_to_xsec.v1\",")
    print("\"claim\":\"w_observable_from_amplitude_sigma_eq_amp_sq_times_s_over_12pi\",")
    print("\"amp\":")
    print_f64(amp)
    print(",\"amp_var\":")
    print_f64(amp_var)
    print(",\"sigma\":")
    print_f64(sigma)
    print(",\"peak\":")
    print_f64(peak)
    print(",\"ratio_sigma_over_peak\":")
    print_f64(ratio)
    print(",\"sigma_off\":")
    print_f64(sigma_off)
    print(",\"num_cc\":\"(g^2/2)^2\",")
    print("\"formula\":\"sigma = amp_sq * s / (12 * pi)\",")
    print("\"nonclaim\":\"nwa_peak_not_equal_to_continuum_bw; not_full_enu_matrix_element\"")
    print("}\n")

    print("PARTICLE_EXP15_PASS ")
    print_int(n)
    print("\n")
    if n == expected {
        print("PARTICLE_EXP15_OK\n")
        0
    } else {
        print("PARTICLE_EXP15_FAILED\n")
        1
    }
}
