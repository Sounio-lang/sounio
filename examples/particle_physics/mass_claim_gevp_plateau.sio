//@ run-pass
// examples/particle_physics/mass_claim_gevp_plateau.sio
//
// EARN PLATEAU — multi-τ GEVP (only path back to mass-gap claim)
// ==============================================================
// Single-operator C(τ) had only m_eff(0). Try variational 3-smear GEVP:
//   (A) fixed t0=0: m(τ) = −ln λ(τ)/(τ−t0) for τ=1,2[,3]
//   (B) local:      m(τ) from GEVP C(τ+1) vs C(τ), τ=0,1[,2]
//   (C) 2×2 GEVP fixed t0 (often more stable)
// Then glueball_mass_claim — status 2 only earns MASS_GAP m/√σ.
//
// Success = PLATEAU_MASS. Anything else = still KILLED (no drift).
//
// CLAIM: attempt multi-τ GEVP plateau; hard gate unchanged.
// NOT CLAIMED: continuum; Clay; that attempt implies success.
//
// Run:
//   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib
//   export SOUNIO_SOUC_ENGINE=lean_single
//   ./bin/souc run examples/particle_physics/mass_claim_gevp_plateau.sio

use particle_physics::lattice_gauge::{
    lat_l, lat_nsites, lg_set_L, lg_seed, lattice_cold,
    heatbath_thermalize, measure_ensemble_hb,
    measure_variational_3smear_hb,
    gevp3_meff_scan, gevp2_meff_scan, gevp3_meff_local_scan,
    glueball_mass_claim, mass_gap_ratio_or_kill, glueball_n_valid_meff,
    glueball_meff_scan, string_tension_ep,
}
use epistemic::knowledge::{ep_val, ep_std}

fn fp6(v: f64) -> string with Mut, Div, Panic {
    var x = v
    var neg = false
    if x < 0.0 { neg = true; x = 0.0 - x }
    let n = (x * 1000000.0 + 0.5) as i64
    var whole = n / 1000000
    let frac = n % 1000000
    var buf: [i8; 64] = [0; 64]
    var pos: i64 = 0
    if neg { buf[0] = 45 as i8; pos = 1 }
    var wrev: [i8; 16] = [0; 16]
    var wlen: i64 = 0
    if whole == 0 { wrev[0] = 48 as i8; wlen = 1 }
    while whole > 0 && wlen < 15 {
        wrev[wlen as usize] = (48 + whole % 10) as i8
        wlen = wlen + 1
        whole = whole / 10
    }
    var i = wlen - 1
    while i >= 0 {
        buf[pos as usize] = wrev[i as usize]
        pos = pos + 1
        if i == 0 { break }
        i = i - 1
    }
    buf[pos as usize] = 46 as i8
    pos = pos + 1
    var div: i64 = 100000
    while div >= 1 {
        buf[pos as usize] = (48 + (frac / div) % 10) as i8
        pos = pos + 1
        div = div / 10
    }
    str_from_bytes(buf, pos)
}

fn i64s(v: i64) -> string with Mut, Div, Panic {
    if v == 0 { return "0" }
    var n = v
    var neg = false
    if n < 0 { neg = true; n = 0 - n }
    var rev: [i8; 24] = [0; 24]
    var len: i64 = 0
    while n > 0 && len < 23 {
        rev[len as usize] = (48 + n % 10) as i8
        len = len + 1
        n = n / 10
    }
    var buf: [i8; 32] = [0; 32]
    var pos: i64 = 0
    if neg { buf[0] = 45 as i8; pos = 1 }
    var i = len - 1
    while i >= 0 {
        buf[pos as usize] = rev[i as usize]
        pos = pos + 1
        if i == 0 { break }
        i = i - 1
    }
    str_from_bytes(buf, pos)
}

fn sqrt_q(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var g = x
    var k: i64 = 0
    while k < 40 { g = 0.5 * (g + x / g); k = k + 1 }
    g
}

fn status_name(s: i64) -> string {
    if s == 2 { return "PLATEAU_MASS" }
    if s == 1 { return "CONTACT_UV_ONLY" }
    "MASS_GAP_CLAIM_KILLED"
}

fn print_meff(tag: string, meff: &[f64; 8], vok: &[i64; 8], n: i64) with IO, Mut, Div, Panic {
    println("  " ++ tag ++ ":")
    var t: i64 = 0
    while t < n {
        println("    idx=" ++ i64s(t) ++ "  m=" ++ fp6(meff[t as usize])
            ++ "  ok=" ++ i64s(vok[t as usize]))
        t = t + 1
    }
}

/// Returns (status, m_gap, r_gap, m_contact, r_contact)
fn claim_from_meff(
    tag: string,
    meff: &[f64; 8],
    vok: &[i64; 8],
    n_tau: i64,
    tol: f64,
    srt: f64
) -> (i64, f64, f64, f64, f64) with IO, Mut, Div, Panic {
    print_meff(tag, meff, vok, n_tau)
    let (st, m_gap) = glueball_mass_claim(meff, vok, n_tau, tol)
    let (r_gap, okg) = mass_gap_ratio_or_kill(st, m_gap, srt)
    var m_ct: f64 = 0.0
    if vok[0] == 1 && meff[0] > 0.0 { m_ct = meff[0] }
    var r_ct: f64 = 0.0
    if m_ct > 0.0 && srt > 1.0e-12 { r_ct = m_ct / srt }
    let nv = glueball_n_valid_meff(vok, meff, n_tau)
    println("  → " ++ status_name(st)
        ++ "  n_valid=" ++ i64s(nv)
        ++ "  m_gap=" ++ fp6(m_gap))
    if okg == 1 {
        println("  MASS_GAP m/sqrt(sig) = " ++ fp6(r_gap))
    } else {
        println("  MASS_GAP m/sqrt(sig) = KILLED")
    }
    (st, m_gap, r_gap, m_ct, r_ct)
}

fn run_volume(
    lat: &![f64; 65536],
    sm0: &![f64; 65536],
    sm1: &![f64; 65536],
    sm2: &![f64; 65536],
    tmp: &![f64; 65536],
    L_set: i64,
    beta: f64,
    n_therm: i64,
    n_meas: i64,
    n_sep: i64,
    seed: i64,
    tol: f64
) -> (i64, f64, f64) with IO, Mut, Div, Panic {
    let okL = lg_set_L(L_set)
    if okL == 0 {
        println("FAIL lg_set_L(" ++ i64s(L_set) ++ ")")
        return (0, 0.0, 0.0)
    }
    let L = lat_l()
    var n_sink: i64 = L / 2
    if n_sink > 3 { n_sink = 3 }
    if n_sink < 2 { n_sink = 2 }
    println("L=" ++ i64s(L) ++ " sites=" ++ i64s(lat_nsites())
        ++ " β=" ++ fp6(beta) ++ " n_sink=" ++ i64s(n_sink)
        ++ " meas=" ++ i64s(n_meas))
    lg_seed(seed)
    lattice_cold(lat)
    let pth = heatbath_thermalize(lat, beta, n_therm)
    println("⟨P⟩=" ++ fp6(pth))

    var c00: [f64; 8] = [0.0; 8]
    var c01: [f64; 8] = [0.0; 8]
    var c02: [f64; 8] = [0.0; 8]
    var c11: [f64; 8] = [0.0; 8]
    var c12: [f64; 8] = [0.0; 8]
    var c22: [f64; 8] = [0.0; 8]
    let (_m0, _m1, _m2) = measure_variational_3smear_hb(
        lat, sm0, sm1, sm2, tmp,
        beta, n_meas, n_sep, 0.4, 1, 2, 4,
        &!c00, &!c01, &!c02, &!c11, &!c12, &!c22
    )
    println("C00(τ): " ++ fp6(c00[0]) ++ " " ++ fp6(c00[1]) ++ " " ++ fp6(c00[2])
        ++ " " ++ fp6(c00[3]))
    println("C11(τ): " ++ fp6(c11[0]) ++ " " ++ fp6(c11[1]) ++ " " ++ fp6(c11[2]))
    println("C22(τ): " ++ fp6(c22[0]) ++ " " ++ fp6(c22[1]) ++ " " ++ fp6(c22[2]))

    var pl: [f64; 256] = [0.0; 256]
    var ch: [f64; 256] = [0.0; 256]
    var cv: [i64; 256] = [0; 256]
    let n_ctx: i64 = 16
    let _nc = measure_ensemble_hb(lat, beta, n_ctx, n_sep, &!pl, &!ch, &!cv)
    let sep = string_tension_ep(&ch, &cv, n_ctx)
    let srt = sqrt_q(ep_val(&sep))
    println("√σ=" ++ fp6(srt) ++ "  (scale only)")

    // (0) single-op reference — expected CONTACT_UV
    var me_d: [f64; 8] = [0.0; 8]
    var vo_d: [i64; 8] = [0; 8]
    glueball_meff_scan(&c00, n_sink, &!me_d, &!vo_d)
    println("--- (0) single-op C00 m_eff (control) ---")
    let (st0, _g0, _rg0, _ct0, _rct0) = claim_from_meff(
        "diag_C00", &me_d, &vo_d, n_sink, tol, srt
    )

    // (A) 3×3 GEVP fixed t0=0
    var me_a: [f64; 8] = [0.0; 8]
    var vo_a: [i64; 8] = [0; 8]
    let nok_a = gevp3_meff_scan(
        &c00, &c01, &c02, &c11, &c12, &c22, 0, n_sink, &!me_a, &!vo_a
    )
    println("--- (A) GEVP3 fixed t0=0  n_ok=" ++ i64s(nok_a) ++ " ---")
    // claim uses indices as consecutive; for fixed-t0, valid at 1,2,3 —
    // glueball_mass_claim pairs (0,1),(1,2),... so need valid consecutive.
    // Remap: pack valid sinks into dense meff[0], meff[1], ... for claim.
    var md: [f64; 8] = [0.0; 8]
    var vd: [i64; 8] = [0; 8]
    var nd: i64 = 0
    var t: i64 = 0
    while t < 8 {
        if vo_a[t as usize] == 1 {
            md[nd as usize] = me_a[t as usize]
            vd[nd as usize] = 1
            nd = nd + 1
        }
        t = t + 1
    }
    let (st_a, mg_a, rg_a, _c, _rc) = claim_from_meff(
        "GEVP3_t0=0_dense", &md, &vd, nd, tol, srt
    )

    // (B) 3×3 local consecutive GEVP
    var me_b: [f64; 8] = [0.0; 8]
    var vo_b: [i64; 8] = [0; 8]
    let nok_b = gevp3_meff_local_scan(
        &c00, &c01, &c02, &c11, &c12, &c22, n_sink, &!me_b, &!vo_b
    )
    println("--- (B) GEVP3 local consecutive  n_ok=" ++ i64s(nok_b) ++ " ---")
    let (st_b, mg_b, rg_b, _cb, _rcb) = claim_from_meff(
        "GEVP3_local", &me_b, &vo_b, n_sink, tol, srt
    )

    // (C) 2×2 GEVP fixed t0=0
    var me_c: [f64; 8] = [0.0; 8]
    var vo_c: [i64; 8] = [0; 8]
    let nok_c = gevp2_meff_scan(&c00, &c01, &c11, 0, n_sink, &!me_c, &!vo_c)
    println("--- (C) GEVP2 fixed t0=0  n_ok=" ++ i64s(nok_c) ++ " ---")
    var md2: [f64; 8] = [0.0; 8]
    var vd2: [i64; 8] = [0; 8]
    var nd2: i64 = 0
    t = 0
    while t < 8 {
        if vo_c[t as usize] == 1 {
            md2[nd2 as usize] = me_c[t as usize]
            vd2[nd2 as usize] = 1
            nd2 = nd2 + 1
        }
        t = t + 1
    }
    let (st_c, mg_c, rg_c, _cc, _rcc) = claim_from_meff(
        "GEVP2_t0=0_dense", &md2, &vd2, nd2, tol, srt
    )

    // (D) 3×3 fixed t0=1 if L allows n_sink>=3
    var st_d: i64 = 0
    var mg_d: f64 = 0.0
    var rg_d: f64 = 0.0
    if n_sink >= 3 {
        var me_d2: [f64; 8] = [0.0; 8]
        var vo_d2: [i64; 8] = [0; 8]
        let nok_d = gevp3_meff_scan(
            &c00, &c01, &c02, &c11, &c12, &c22, 1, n_sink, &!me_d2, &!vo_d2
        )
        println("--- (D) GEVP3 fixed t0=1  n_ok=" ++ i64s(nok_d) ++ " ---")
        var md3: [f64; 8] = [0.0; 8]
        var vd3: [i64; 8] = [0; 8]
        var nd3: i64 = 0
        t = 0
        while t < 8 {
            if vo_d2[t as usize] == 1 {
                md3[nd3 as usize] = me_d2[t as usize]
                vd3[nd3 as usize] = 1
                nd3 = nd3 + 1
            }
            t = t + 1
        }
        let (s, mg, rg, _x, _y) = claim_from_meff(
            "GEVP3_t0=1_dense", &md3, &vd3, nd3, tol, srt
        )
        st_d = s
        mg_d = mg
        rg_d = rg
    }

    // Best status among A,B,C,D — only 2 earns gap
    var best_st: i64 = st0
    var best_rg: f64 = 0.0
    var best_mg: f64 = 0.0
    if st_a == 2 { best_st = 2; best_rg = rg_a; best_mg = mg_a }
    if st_b == 2 { best_st = 2; best_rg = rg_b; best_mg = mg_b }
    if st_c == 2 { best_st = 2; best_rg = rg_c; best_mg = mg_c }
    if st_d == 2 { best_st = 2; best_rg = rg_d; best_mg = mg_d }
    // track if any got 2
    var any2: i64 = 0
    if st_a == 2 || st_b == 2 || st_c == 2 || st_d == 2 { any2 = 1 }
    if any2 == 0 {
        // best non-gap status for reporting
        if st_a > best_st { best_st = st_a }
        if st_b > best_st { best_st = st_b }
        if st_c > best_st { best_st = st_c }
        if st_d > best_st { best_st = st_d }
    }

    println("VOLUME_SUMMARY L=" ++ i64s(L)
        ++ " best_claim=" ++ status_name(best_st)
        ++ " m_gap=" ++ fp6(best_mg)
        ++ " m/√σ_gap=" ++ fp6(best_rg))
    let _reset = lg_set_L(4)
    (best_st, best_mg, best_rg)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("================================================================")
    println(" EARN PLATEAU — multi-τ GEVP mass-gap attempt")
    println("================================================================")
    println("RULE unchanged: only PLATEAU_MASS ⇒ legal MASS_GAP m/√σ")
    println("NOT CLAIMED: success; continuum; Clay")
    println("")

    let tol: f64 = 0.20
    let seed0: i64 = 20260813
    println("plateau tol=" ++ fp6(tol))
    println("")

    var lat: [f64; 65536] = [0.0; 65536]
    var sm0: [f64; 65536] = [0.0; 65536]
    var sm1: [f64; 65536] = [0.0; 65536]
    var sm2: [f64; 65536] = [0.0; 65536]
    var tmp: [f64; 65536] = [0.0; 65536]

    println("======== SU(2) L=6 β=2.3 ========")
    let (st6, mg6, rg6) = run_volume(
        &!lat, &!sm0, &!sm1, &!sm2, &!tmp,
        6, 2.3, 40, 40, 2, seed0, tol
    )

    println("")
    println("======== SU(2) L=8 β=2.3 ========")
    let (st8, mg8, rg8) = run_volume(
        &!lat, &!sm0, &!sm1, &!sm2, &!tmp,
        8, 2.3, 44, 36, 2, seed0 + 80, tol
    )

    println("")
    println("================================================================")
    println(" HARD GATES")
    println("================================================================")
    println("L=6 claim: " ++ status_name(st6)
        ++ "  m_gap=" ++ fp6(mg6) ++ "  m/√σ=" ++ fp6(rg6))
    println("L=8 claim: " ++ status_name(st8)
        ++ "  m_gap=" ++ fp6(mg8) ++ "  m/√σ=" ++ fp6(rg8))

    let earned6 = st6 == 2
    let earned8 = st8 == 2
    let any_earned = earned6 || earned8

    if earned6 { println("GATE L6_gevp_plateau: PASS  ★") }
    else { println("GATE L6_gevp_plateau: FAIL_HONEST  (gap still killed)") }
    if earned8 { println("GATE L8_gevp_plateau: PASS  ★") }
    else { println("GATE L8_gevp_plateau: FAIL_HONEST  (gap still killed)") }
    if any_earned {
        println("GATE mass_gap_claim_restored: PASS")
    } else {
        println("GATE mass_gap_claim_restored: FAIL_HONEST")
        println("  multi-τ GEVP did not earn plateau — claim remains KILLED")
    }

    println("")
    println("VERDICT:")
    if any_earned {
        println("  Plateau earned via multi-τ GEVP — report only status=2 channels.")
        if earned6 {
            println("  L6 MASS_GAP m/√σ = " ++ fp6(rg6))
        }
        if earned8 {
            println("  L8 MASS_GAP m/√σ = " ++ fp6(rg8))
        }
    } else {
        println("  ATATEAU NOT EARNED. Mass-gap claim remains KILLED.")
        println("  Variational GEVP did not produce τ-stable m on L∈{6,8}.")
        println("  Next real step would be larger T or far more stats — not multi-β averages.")
    }
    println("================================================================")
    0
}
