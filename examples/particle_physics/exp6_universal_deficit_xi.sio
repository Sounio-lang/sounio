// examples/particle_physics/exp6_universal_deficit_xi.sio
//
// EXP6 — Universal reduced-variable NonUnitary deficit (construction novelty)
//
// Physics: pure Breit-Wigner unitarity deficit depends only on
//   ξ = (s − M²) / (M · Γ)
// via
//   d(ξ) = 1 / (1 + ξ²)
//
// Novelty (executable, not paper):
//   1. Z and W at matched ξ collapse onto the same analytic curve
//   2. Live nu_deficit(prop) matches d(ξ) within numerical tol
//   3. Species JSON receipt + cross-species residual JSON
//   4. Higgs + top optional third/fourth species on the same ξ grid
//
// Run:
//   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib
//   ./bin/souc run examples/particle_physics/exp6_universal_deficit_xi.sio
// Gate:
//   bash scripts/ci/particle_exp6_universal_xi_gate.sh

use particle_physics::sm_params::{mass_z, mass_w, mass_h, mass_top}
use epistemic::knowledge::{ep_variance}
use particle_physics::nonunitary::{
    nu_z_propagator, nu_w_propagator, nu_higgs_propagator, nu_top_propagator,
    nu_deficit, nu_reduced_xi, nu_deficit_analytic_xi, nu_s_from_xi,
    NU_Z, NU_W, NU_HIGGS, NU_TOP,
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn within(a: f64, b: f64, tol: f64) -> bool {
    abs_f(a - b) < tol
}

fn print_pass(tag: i64) with IO {
    print("PASS ")
    print_int(tag)
    print("\n")
}

fn print_fail(tag: i64) with IO {
    print("FAIL ")
    print_int(tag)
    print("\n")
}

fn pass_if(cond: bool, tag: i64) -> i64 with IO {
    if cond {
        print_pass(tag)
        1
    } else {
        print_fail(tag)
        0
    }
}

// Evaluate one species on the universal ξ grid.
// xi_grid fixed: -3, -1, 0, 1, 3  (5 points)
// Returns pass count (expected 8: 5 analytic matches + pole + particle + amp var).
fn scan_xi_species(
    name_code: i64,
    mass: f64,
    gamma: f64,
    particle_id: i64,
    tag_base: i64
) -> i64 with IO, Mut, Div, Panic {
    var n: i64 = 0
    // name_code: 0=Z 1=W 2=H 3=T
    let xi0 = 0.0 - 3.0
    let xi1 = 0.0 - 1.0
    let xi2 = 0.0
    let xi3 = 1.0
    let xi4 = 3.0

    let s0 = nu_s_from_xi(xi0, mass, gamma)
    let s1 = nu_s_from_xi(xi1, mass, gamma)
    let s2 = nu_s_from_xi(xi2, mass, gamma)
    let s3 = nu_s_from_xi(xi3, mass, gamma)
    let s4 = nu_s_from_xi(xi4, mass, gamma)

    // Build props per species
    var d0 = 0.0
    var d1 = 0.0
    var d2 = 0.0
    var d3 = 0.0
    var d4 = 0.0
    var pid: i64 = 0
    var amp_var = 0.0

    if name_code == 0 {
        let p0 = nu_z_propagator(s0, gamma)
        let p1 = nu_z_propagator(s1, gamma)
        let p2 = nu_z_propagator(s2, gamma)
        let p3 = nu_z_propagator(s3, gamma)
        let p4 = nu_z_propagator(s4, gamma)
        d0 = nu_deficit(p0)
        d1 = nu_deficit(p1)
        d2 = nu_deficit(p2)
        d3 = nu_deficit(p3)
        d4 = nu_deficit(p4)
        pid = p2.particle
        amp_var = ep_variance(&p2.amp_sq)
        print("EXP6_SPECIES Z\n")
    } else {
        if name_code == 1 {
            let p0 = nu_w_propagator(s0, gamma)
            let p1 = nu_w_propagator(s1, gamma)
            let p2 = nu_w_propagator(s2, gamma)
            let p3 = nu_w_propagator(s3, gamma)
            let p4 = nu_w_propagator(s4, gamma)
            d0 = nu_deficit(p0)
            d1 = nu_deficit(p1)
            d2 = nu_deficit(p2)
            d3 = nu_deficit(p3)
            d4 = nu_deficit(p4)
            pid = p2.particle
            amp_var = ep_variance(&p2.amp_sq)
            print("EXP6_SPECIES W\n")
        } else {
            if name_code == 2 {
                let p0 = nu_higgs_propagator(s0, gamma)
                let p1 = nu_higgs_propagator(s1, gamma)
                let p2 = nu_higgs_propagator(s2, gamma)
                let p3 = nu_higgs_propagator(s3, gamma)
                let p4 = nu_higgs_propagator(s4, gamma)
                d0 = nu_deficit(p0)
                d1 = nu_deficit(p1)
                d2 = nu_deficit(p2)
                d3 = nu_deficit(p3)
                d4 = nu_deficit(p4)
                pid = p2.particle
                amp_var = ep_variance(&p2.amp_sq)
                print("EXP6_SPECIES H\n")
            } else {
                let p0 = nu_top_propagator(s0, gamma)
                let p1 = nu_top_propagator(s1, gamma)
                let p2 = nu_top_propagator(s2, gamma)
                let p3 = nu_top_propagator(s3, gamma)
                let p4 = nu_top_propagator(s4, gamma)
                d0 = nu_deficit(p0)
                d1 = nu_deficit(p1)
                d2 = nu_deficit(p2)
                d3 = nu_deficit(p3)
                d4 = nu_deficit(p4)
                pid = p2.particle
                amp_var = ep_variance(&p2.amp_sq)
                print("EXP6_SPECIES T\n")
            }
        }
    }

    let a0 = nu_deficit_analytic_xi(xi0)
    let a1 = nu_deficit_analytic_xi(xi1)
    let a2 = nu_deficit_analytic_xi(xi2)
    let a3 = nu_deficit_analytic_xi(xi3)
    let a4 = nu_deficit_analytic_xi(xi4)

    // Recovered ξ from s must match inputs (definition invertibility)
    let r0 = nu_reduced_xi(s0, mass, gamma)
    let r2 = nu_reduced_xi(s2, mass, gamma)

    print("EXP6_XI_GRID -3 -1 0 1 3\n")
    print("EXP6_DEFICIT_XI0 ")
    print_f64(d0)
    print("\n")
    print("EXP6_DEFICIT_XI2 ")
    print_f64(d2)
    print("\n")
    print("EXP6_ANALYTIC_XI2 ")
    print_f64(a2)
    print("\n")

    // Match analytic at each grid point (BW exact for pure denom form)
    let tol = 1.0e-9
    n = n + pass_if(within(d0, a0, tol), tag_base + 1)
    n = n + pass_if(within(d1, a1, tol), tag_base + 2)
    n = n + pass_if(within(d2, a2, tol), tag_base + 3)
    n = n + pass_if(within(d3, a3, tol), tag_base + 4)
    n = n + pass_if(within(d4, a4, tol), tag_base + 5)
    // Pole is max
    n = n + pass_if(within(d2, 1.0, 1.0e-9) && d2 >= d0 && d2 >= d4, tag_base + 6)
    n = n + pass_if(pid == particle_id, tag_base + 7)
    n = n + pass_if(amp_var > 0.0, tag_base + 8)
    n = n + pass_if(within(r0, xi0, 1.0e-12) && within(r2, xi2, 1.0e-12), tag_base + 9)

    print("EXP6_SPECIES_JSON {")
    print("\"schema\":\"particle.exp6.universal_xi.v1\",")
    print("\"species_code\":")
    print_int(name_code)
    print(",\"mass\":")
    print_f64(mass)
    print(",\"gamma\":")
    print_f64(gamma)
    print(",\"points\":[")
    print("{\"xi\":-3.0,\"deficit\":")
    print_f64(d0)
    print(",\"analytic\":")
    print_f64(a0)
    print("},")
    print("{\"xi\":-1.0,\"deficit\":")
    print_f64(d1)
    print(",\"analytic\":")
    print_f64(a1)
    print("},")
    print("{\"xi\":0.0,\"deficit\":")
    print_f64(d2)
    print(",\"analytic\":")
    print_f64(a2)
    print("},")
    print("{\"xi\":1.0,\"deficit\":")
    print_f64(d3)
    print(",\"analytic\":")
    print_f64(a3)
    print("},")
    print("{\"xi\":3.0,\"deficit\":")
    print_f64(d4)
    print(",\"analytic\":")
    print_f64(a4)
    print("}]}\n")
    n
}

// Cross-species collapse: Z vs W at same ξ (reuse analytic as shared target).
fn cross_species_collapse(mz: f64, gz: f64, mw: f64, gw: f64) -> i64 with IO, Mut, Div, Panic {
    var n: i64 = 0
    let xi_a = 0.0 - 1.0
    let xi_b = 2.0
    let sz_a = nu_s_from_xi(xi_a, mz, gz)
    let sw_a = nu_s_from_xi(xi_a, mw, gw)
    let sz_b = nu_s_from_xi(xi_b, mz, gz)
    let sw_b = nu_s_from_xi(xi_b, mw, gw)
    let dz_a = nu_deficit(nu_z_propagator(sz_a, gz))
    let dw_a = nu_deficit(nu_w_propagator(sw_a, gw))
    let dz_b = nu_deficit(nu_z_propagator(sz_b, gz))
    let dw_b = nu_deficit(nu_w_propagator(sw_b, gw))
    let an_a = nu_deficit_analytic_xi(xi_a)
    let an_b = nu_deficit_analytic_xi(xi_b)

    print("EXP6_CROSS_DZ_A ")
    print_f64(dz_a)
    print("\n")
    print("EXP6_CROSS_DW_A ")
    print_f64(dw_a)
    print("\n")
    print("EXP6_CROSS_DZ_B ")
    print_f64(dz_b)
    print("\n")
    print("EXP6_CROSS_DW_B ")
    print_f64(dw_b)
    print("\n")

    // Z≈W at matched ξ (species collapse)
    n = n + pass_if(within(dz_a, dw_a, 1.0e-9), 901)
    n = n + pass_if(within(dz_b, dw_b, 1.0e-9), 902)
    // both match analytic
    n = n + pass_if(within(dz_a, an_a, 1.0e-9) && within(dw_a, an_a, 1.0e-9), 903)
    n = n + pass_if(within(dz_b, an_b, 1.0e-9) && within(dw_b, an_b, 1.0e-9), 904)

    // Residual map |d_Z - d_W| at matched ξ must be ~0
    let res_a = abs_f(dz_a - dw_a)
    let res_b = abs_f(dz_b - dw_b)
    print("EXP6_CROSS_JSON {")
    print("\"schema\":\"particle.exp6.cross_species_xi.v1\",")
    print("\"claim\":\"NonUnitary_deficit_universal_under_reduced_xi\",")
    print("\"points\":[")
    print("{\"xi\":-1.0,\"d_z\":")
    print_f64(dz_a)
    print(",\"d_w\":")
    print_f64(dw_a)
    print(",\"residual\":")
    print_f64(res_a)
    print("},")
    print("{\"xi\":2.0,\"d_z\":")
    print_f64(dz_b)
    print(",\"d_w\":")
    print_f64(dw_b)
    print(",\"residual\":")
    print_f64(res_b)
    print("}]}\n")
    n = n + pass_if(res_a < 1.0e-9 && res_b < 1.0e-9, 905)
    n
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("PARTICLE_EXP6_BEGIN\n")
    print("EXP6_CLAIM NonUnitary_deficit_is_universal_under_reduced_xi\n")

    let mz = mass_z().val()
    let mw = mass_w().val()
    let mh = mass_h().val()
    let mt = mass_top().val()
    let gamma_z = 2.4952
    let gamma_w = 2.085
    // PDG-scale widths (construction; not precision claims)
    let gamma_h = 0.00407
    let gamma_t = 1.42

    // 9 checks per species × 4 species = 36
    let n_z = scan_xi_species(0, mz, gamma_z, NU_Z(), 600)
    let n_w = scan_xi_species(1, mw, gamma_w, NU_W(), 700)
    let n_h = scan_xi_species(2, mh, gamma_h, NU_HIGGS(), 800)
    let n_t = scan_xi_species(3, mt, gamma_t, NU_TOP(), 850)
    let n_x = cross_species_collapse(mz, gamma_z, mw, gamma_w)

    let npass = n_z + n_w + n_h + n_t + n_x
    // 9*4 + 5 = 41
    let expected: i64 = 41
    let nfail = expected - npass

    print("PARTICLE_EXP6_PASS ")
    print_int(npass)
    print("\n")
    print("PARTICLE_EXP6_FAIL ")
    print_int(nfail)
    print("\n")
    print("PARTICLE_EXP6_NZ ")
    print_int(n_z)
    print("\n")
    print("PARTICLE_EXP6_NW ")
    print_int(n_w)
    print("\n")
    print("PARTICLE_EXP6_NH ")
    print_int(n_h)
    print("\n")
    print("PARTICLE_EXP6_NT ")
    print_int(n_t)
    print("\n")
    print("PARTICLE_EXP6_NX ")
    print_int(n_x)
    print("\n")

    if npass == expected {
        print("PARTICLE_EXP6_OK\n")
        print("PARTICLE_EXP6_UNIVERSAL_XI_OK\n")
        0
    } else {
        print("PARTICLE_EXP6_FAILED\n")
        1
    }
}
