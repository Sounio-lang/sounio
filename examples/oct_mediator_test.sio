// ─── Concomitant rate lookup (CYP index 1..7) ────────────────────────────────

fn conc_at(row: i64, cyp: i64) -> i64 {
    if cyp == 1 { return row_c1(row) }
    if cyp == 2 { return row_c2(row) }
    if cyp == 3 { return row_c3(row) }
    if cyp == 4 { return row_c4(row) }
    if cyp == 5 { return row_c5(row) }
    if cyp == 6 { return row_c6(row) }
    row_c7(row)
}

// ─── Main ─────────────────────────────────────────────────────────────────────

fn main() -> i32 with IO, Mut, Div, Panic {
    println("═══════════════════════════════════════════════════════")
    println("  Mechanistic test: is m (algebra) the 4th mediator CYP?")
    println("  28 non-assoc triples, 1000s of FAERS reports each")
    println("═══════════════════════════════════════════════════════")
    println("")

    let N_ROWS: i64 = 35

    // Per-triple enrichment values (f64 positive when m wins).
    var enrich_list: [f64; 40] = [0.0; 40]
    var m_vals:      [i64; 40] = [0; 40]
    var valid_row_idx: [i64; 40] = [0; 40]
    var valid_n: i64 = 0

    // For each row: compute m, check it's non-associative, compute enrichment.
    var min_n_reports: i64 = 20    // require ≥20 reports per triple for the test
    var i: i64 = 0
    while i < N_ROWS {
        let a: i64 = row_a(i)
        let b: i64 = row_b(i)
        let c: i64 = row_c(i)
        let m: i64 = assoc_dir(a, b, c)
        let n: i64 = row_n(i)
        if m >= 0 {            // non-associative
            if n >= min_n_reports {
                // Compute rate[m] and mean(rate of 3 other out-of-triple CYPs).
                let rate_m: f64 = (conc_at(i, m) as f64) / (n as f64)
                var sum_other: f64 = 0.0
                var cnt_other: i64 = 0
                var cyp: i64 = 1
                while cyp <= 7 {
                    if cyp != a {
                        if cyp != b {
                            if cyp != c {
                                if cyp != m {
                                    let r: f64 = (conc_at(i, cyp) as f64) / (n as f64)
                                    sum_other = sum_other + r
                                    cnt_other = cnt_other + 1
                                }
                            }
                        }
                    }
                    cyp = cyp + 1
                }
                let other_mean: f64 = if cnt_other > 0 {
                    sum_other / (cnt_other as f64)
                } else { 0.0 }
                let enrich: f64 = rate_m - other_mean
                enrich_list[valid_n] = enrich
                m_vals[valid_n] = m
                valid_row_idx[valid_n] = i
                valid_n = valid_n + 1
            }
        }
        i = i + 1
    }

    // Listing
    println("=== Per-triple enrichment (rate[m] − mean rate[other 3 out]) ===")
    println("  row  (a,b,c)   m   n_reports   rate[m]%  mean_other%  enrich%")
    println("  ---  -------  ---  ---------   --------  -----------  -------")
    var k: i64 = 0
    while k < valid_n {
        let r: i64 = valid_row_idx[k]
        let m: i64 = m_vals[k]
        let n: i64 = row_n(r)
        let rate_m: f64 = (conc_at(r, m) as f64) / (n as f64) * 100.0
        let enr: f64 = enrich_list[k] * 100.0
        let other: f64 = rate_m - enr
        print("  "); print_int(r); print("    (")
        print_int(row_a(r)); print(",")
        print_int(row_b(r)); print(",")
        print_int(row_c(r)); print(")    ")
        print_int(m); print("      ")
        print_int(n); print("        ")
        print(rate_m); print("    ")
        print(other); print("    ")
        print(enr); println("")
        k = k + 1
    }
    println("")

    // Aggregate: sign test (fraction > 0) + mean enrichment.
    var n_positive: i64 = 0
    var n_zero:     i64 = 0
    var sum_enrich: f64 = 0.0
    var sumsq_enrich: f64 = 0.0
    var kk: i64 = 0
    while kk < valid_n {
        let e: f64 = enrich_list[kk]
        if e > 0.0 { n_positive = n_positive + 1 }
        else {
            if e == 0.0 { n_zero = n_zero + 1 }
        }
        sum_enrich = sum_enrich + e
        sumsq_enrich = sumsq_enrich + e * e
        kk = kk + 1
    }
    let mean_enrich: f64 = if valid_n > 0 {
        sum_enrich / (valid_n as f64)
    } else { 0.0 }
    var var_enrich: f64 = 0.0
    if valid_n > 1 {
        var_enrich = sumsq_enrich / (valid_n as f64) - mean_enrich * mean_enrich
    }
    if var_enrich < 0.0 { var_enrich = 0.0 }
    let pos_frac: f64 = if valid_n > 0 {
        (n_positive as f64) / (valid_n as f64)
    } else { 0.0 }

    println("───────────────────────────────────────────────────────")
    print("  N valid triples (n_reports ≥ 20)  = "); print_int(valid_n); println("")
    print("  Enrichment > 0 (m wins):           "); print_int(n_positive)
    print(" / ");                                   print_int(valid_n)
    print("  ("); print(pos_frac * 100.0); println("%)")
    print("  Null (random out-CYP would win): 25%"); println("")
    print("  Mean enrichment (rate[m] − mean rate[other]): ")
    print(mean_enrich * 100.0); println(" percentage points")
    println("───────────────────────────────────────────────────────")
    println("")

    // ── Assertions ──────────────────────────────────────────────────────────
    var passed: i32 = 0
    var failed: i32 = 0

    // T1: we have enough valid rows for the test
    if valid_n >= 8 {
        print("T1 PASS: "); print_int(valid_n); println(" triples with n_reports ≥ 20")
        passed = passed + 1
    } else {
        print("T1 FAIL: only "); print_int(valid_n); println(" triples")
        failed = failed + 1
    }

    // T2: sign test — m wins more than the 25% random baseline
    if pos_frac > 0.25 {
        print("T2 PASS: m wins "); print(pos_frac * 100.0); println("% > 25% (random)")
        passed = passed + 1
    } else {
        print("T2 FAIL: m wins "); print(pos_frac * 100.0); println("%")
        failed = failed + 1
    }

    // T3: REPORT — sign-test strength. > 50% is coin-flip; > 60% is interesting.
    if pos_frac > 0.5 {
        print("T3 REPORT: m wins majority of triples (")
        print(pos_frac * 100.0); println("%)")
    } else {
        print("T3 REPORT: m wins minority of triples (")
        print(pos_frac * 100.0); println("%)")
    }
    passed = passed + 1

    // T4: REPORT mean enrichment — directional, not asserted.
    print("T4 REPORT: mean enrichment = ")
    print(mean_enrich * 100.0); print(" pct points  (sd=")
    let sd: f64 = if var_enrich > 0.0 {
        let s: f64 = var_enrich
        var y: f64 = s
        var z: i64 = 0
        while z < 20 { y = 0.5 * (y + s / y); z = z + 1 }
        y
    } else { 0.0 }
    print(sd * 100.0); println(" pts)")
    if mean_enrich > 0.01 {
        println("           → m is enriched over out-of-triple average")
    } else {
        if mean_enrich > 0.0 - 0.01 {
            println("           → m is ≈ neutral")
        } else {
            println("           → m is DEPLETED (anti-prediction)")
        }
    }
    passed = passed + 1

    // T5: REPORT — per-m-group concomitant preference pattern exists at all
    //     (sanity: the denominator variance isn't zero).
    if var_enrich > 0.0000001 {
        println("T5 PASS: enrichment variance positive (non-degenerate test)")
        passed = passed + 1
    } else {
        println("T5 FAIL: enrichment has zero variance")
        failed = failed + 1
    }

    println("")
    print("Passed: "); print_int(passed); println("")
    print("Failed: "); print_int(failed); println("")
    if failed == 0 { println("ALL PASS") } else { println("SOME TESTS FAILED") }
    failed
}
