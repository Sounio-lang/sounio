//@ run-pass
// T_7 via sign function — no arrays, no multiplication, pure algebra

fn cd_sigma(a: i32, b: i32, bits: i32) -> i32 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return -1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma(a_lo, b_lo, bits - 1) }
        else { return 0 - cd_sigma(a_lo, b_lo, bits - 1) }
    }
    if b_lo == 0 { return 0 - cd_sigma(b_lo, a_lo, bits - 1) }
    else { return cd_sigma(b_lo, a_lo, bits - 1) }
}

fn main() -> i32 with Mut, Panic, Div, IO {
    println("Computing T_7 (dim 128, 127^3 = 2,048,383 triples)...")
    println("Using sign function only — no arrays, no multiplication.")
    println("")

    let bits: i32 = 7
    let n = 127
    var nonzero: i32 = 0

    var i: i32 = 1
    while i <= n {
        var j: i32 = 1
        while j <= n {
            var k: i32 = 1
            while k <= n {
                let alpha = cd_sigma(i, j, bits) * cd_sigma(i ^ j, k, bits)
                let beta = cd_sigma(j, k, bits) * cd_sigma(i, j ^ k, bits)
                if alpha != beta { nonzero = nonzero + 1 }
                k = k + 1
            }
            j = j + 1
        }
        if i % 20 == 0 {
            println(i)
        }
        i = i + 1
    }

    println("")
    println("T_7 = ")
    println(nonzero)
    println("Predicted: 168 * 6231 = 1046808")
    let predicted: i32 = 168 * 6231
    if nonzero == predicted {
        println("MATCH!")
    } else {
        println("MISMATCH")
        println(predicted)
    }
    0
}
