pub struct BasinWeights {
    pub weights: [f64; 7],
    pub top_line: i64,
    pub top_weight: f64,
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn line_i(line: i64) -> i64 {
    if line == 0 { return 1 }
    if line == 1 { return 1 }
    if line == 2 { return 1 }
    if line == 3 { return 2 }
    if line == 4 { return 2 }
    if line == 5 { return 3 }
    3
}

fn line_j(line: i64) -> i64 {
    if line == 0 { return 2 }
    if line == 1 { return 4 }
    if line == 2 { return 7 }
    if line == 3 { return 4 }
    if line == 4 { return 5 }
    if line == 5 { return 4 }
    6
}

fn line_k(line: i64) -> i64 {
    if line == 0 { return 3 }
    if line == 1 { return 5 }
    if line == 2 { return 6 }
    if line == 3 { return 6 }
    if line == 4 { return 7 }
    if line == 5 { return 7 }
    5
}

pub fn print_basin_name(line: i64) with IO {
    if line == 0 {
        print("line_123")
    } else if line == 1 {
        print("line_145")
    } else if line == 2 {
        print("line_176")
    } else if line == 3 {
        print("line_246")
    } else if line == 4 {
        print("line_257")
    } else if line == 5 {
        print("line_347")
    } else {
        print("line_365")
    }
}

pub fn route_utterance(x: &[f64; 8]) -> BasinWeights with Mut, Div, Panic {
    var raw: [f64; 7] = [0.0; 7]
    let scalar_mass = abs_f64(x[0]) * 0.12

    var total = 0.0
    var top_line: i64 = 0
    var top_weight = 0.0
    var line: i64 = 0
    while line < 7 {
        let i = line_i(line)
        let j = line_j(line)
        let k = line_k(line)
        let w = scalar_mass +
            abs_f64(x[i as usize]) +
            abs_f64(x[j as usize]) +
            abs_f64(x[k as usize])
        raw[line as usize] = w
        total = total + w
        if w > top_weight {
            top_weight = w
            top_line = line
        }
        line = line + 1
    }

    if total <= 1.0e-9 {
        total = 7.0
        line = 0
        while line < 7 {
            raw[line as usize] = 1.0
            line = line + 1
        }
        top_line = 0
        top_weight = 1.0
    }

    var normed: [f64; 7] = [0.0; 7]
    line = 0
    while line < 7 {
        normed[line as usize] = raw[line as usize] / total
        line = line + 1
    }

    BasinWeights {
        weights: normed,
        top_line: top_line,
        top_weight: top_weight / total,
    }
}

pub fn route_utterance_out(
    x: &[f64; 8],
    out_weights: &![f64; 7],
    out_top_line: &![i64; 1],
    out_top_weight: &![f64; 1]
) with Mut, Div, Panic {
    let scalar_mass = abs_f64(x[0]) * 0.12
    var total = 0.0
    var top_line: i64 = 0
    var top_weight = 0.0
    var line: i64 = 0
    while line < 7 {
        let i = line_i(line)
        let j = line_j(line)
        let k = line_k(line)
        let w = scalar_mass +
            abs_f64(x[i as usize]) +
            abs_f64(x[j as usize]) +
            abs_f64(x[k as usize])
        out_weights[line as usize] = w
        total = total + w
        if w > top_weight {
            top_weight = w
            top_line = line
        }
        line = line + 1
    }

    if total <= 1.0e-9 {
        total = 7.0
        line = 0
        while line < 7 {
            out_weights[line as usize] = 1.0 / 7.0
            line = line + 1
        }
        out_top_line[0] = 0
        out_top_weight[0] = 1.0 / 7.0
        return
    }

    line = 0
    while line < 7 {
        out_weights[line as usize] = out_weights[line as usize] / total
        line = line + 1
    }
    out_top_line[0] = top_line
    out_top_weight[0] = top_weight / total
}

pub fn route_apply(x: &[f64; 8], routed: &BasinWeights) -> [f64; 8] with Mut {
    var out: [f64; 8] = [0.0; 8]
    var i: i64 = 0
    while i < 8 {
        out[i as usize] = x[i as usize] * 0.82
        i = i + 1
    }
    out[0] = x[0]

    var line: i64 = 0
    while line < 7 {
        let w = routed.weights[line as usize]
        let i0 = line_i(line)
        let j0 = line_j(line)
        let k0 = line_k(line)
        out[i0 as usize] = out[i0 as usize] + x[i0 as usize] * (0.12 + 0.18 * w)
        out[j0 as usize] = out[j0 as usize] + x[j0 as usize] * (0.12 + 0.18 * w)
        out[k0 as usize] = out[k0 as usize] + x[k0 as usize] * (0.12 + 0.18 * w)
        line = line + 1
    }

    let ti = line_i(routed.top_line)
    let tj = line_j(routed.top_line)
    let tk = line_k(routed.top_line)
    out[ti as usize] = out[ti as usize] + x[ti as usize] * routed.top_weight * 0.45
    out[tj as usize] = out[tj as usize] + x[tj as usize] * routed.top_weight * 0.45
    out[tk as usize] = out[tk as usize] + x[tk as usize] * routed.top_weight * 0.45
    out
}

pub fn route_apply_weighted(
    x: &[f64; 8],
    weights: &[f64; 7],
    top_line: i64,
    top_weight: f64,
    out: &![f64; 8]
) with Mut {
    var i: i64 = 0
    while i < 8 {
        out[i as usize] = x[i as usize] * 0.82
        i = i + 1
    }
    out[0] = x[0]

    var line: i64 = 0
    while line < 7 {
        let w = weights[line as usize]
        let i0 = line_i(line)
        let j0 = line_j(line)
        let k0 = line_k(line)
        out[i0 as usize] = out[i0 as usize] + x[i0 as usize] * (0.12 + 0.18 * w)
        out[j0 as usize] = out[j0 as usize] + x[j0 as usize] * (0.12 + 0.18 * w)
        out[k0 as usize] = out[k0 as usize] + x[k0 as usize] * (0.12 + 0.18 * w)
        line = line + 1
    }

    let ti = line_i(top_line)
    let tj = line_j(top_line)
    let tk = line_k(top_line)
    out[ti as usize] = out[ti as usize] + x[ti as usize] * top_weight * 0.45
    out[tj as usize] = out[tj as usize] + x[tj as usize] * top_weight * 0.45
    out[tk as usize] = out[tk as usize] + x[tk as usize] * top_weight * 0.45
}
