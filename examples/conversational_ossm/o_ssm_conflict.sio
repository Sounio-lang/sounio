use algebra::sedenion::{
    sed_from_pair, sed_mul, sed_norm_sq,
    sed_canonical_zd_z, sed_canonical_zd_w
}

pub struct ConflictTelemetry {
    pub zero_divisor_proximity: f64,
    pub contradiction: f64,
    pub freeze_pressure: f64,
}

fn clamp01(x: f64) -> f64 {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    x
}

pub fn conflict_branch_input(x: &[f64; 8], contradiction: f64) -> [f64; 8] with Mut {
    var out: [f64; 8] = [0.0; 8]
    out[0] = x[0] * 0.80
    out[1] = (0.0 - x[1]) * contradiction
    out[2] = x[2]
    out[3] = (0.0 - x[3]) * 0.50 * contradiction
    out[4] = x[4]
    out[5] = x[5] * (1.0 - 0.15 * contradiction)
    out[6] = x[6] * (1.0 - 0.60 * contradiction)
    out[7] = x[7] + 0.20 * contradiction
    out
}

pub fn conflict_branch_input_out(x: &[f64; 8], contradiction: f64, out: &![f64; 8]) with Mut {
    out[0] = x[0] * 0.80
    out[1] = (0.0 - x[1]) * contradiction
    out[2] = x[2]
    out[3] = (0.0 - x[3]) * 0.50 * contradiction
    out[4] = x[4]
    out[5] = x[5] * (1.0 - 0.15 * contradiction)
    out[6] = x[6] * (1.0 - 0.60 * contradiction)
    out[7] = x[7] + 0.20 * contradiction
}

pub fn conflict_head(h0: &[f64; 8], x: &[f64; 8], contradiction: f64) -> ConflictTelemetry with Mut, Div, Panic {
    let shadow = conflict_branch_input(x, contradiction)

    var s: [f64; 16] = [0.0; 16]
    sed_from_pair(h0, &shadow, &!s)

    var z: [f64; 16] = [0.0; 16]
    var w: [f64; 16] = [0.0; 16]
    var pz: [f64; 16] = [0.0; 16]
    var pw: [f64; 16] = [0.0; 16]
    sed_canonical_zd_z(&!z)
    sed_canonical_zd_w(&!w)
    sed_mul(&s, &z, &!pz)
    sed_mul(&s, &w, &!pw)

    let eps = 1.0e-12
    let dist = (sed_norm_sq(&pz) + sed_norm_sq(&pw)) / (sed_norm_sq(&s) + eps)
    let proximity = 1.0 / (1.0 + dist)
    let freeze = clamp01(0.56 * proximity + 0.44 * contradiction)

    ConflictTelemetry {
        zero_divisor_proximity: proximity,
        contradiction: contradiction,
        freeze_pressure: freeze,
    }
}

pub fn conflict_head_out(
    h0: &[f64; 8],
    x: &[f64; 8],
    contradiction: f64,
    out_zd: &![f64; 1],
    out_freeze: &![f64; 1]
) with Mut, Div, Panic {
    var shadow: [f64; 8] = [0.0; 8]
    conflict_branch_input_out(x, contradiction, &!shadow)

    var s: [f64; 16] = [0.0; 16]
    sed_from_pair(h0, &shadow, &!s)

    var z: [f64; 16] = [0.0; 16]
    var w: [f64; 16] = [0.0; 16]
    var pz: [f64; 16] = [0.0; 16]
    var pw: [f64; 16] = [0.0; 16]
    sed_canonical_zd_z(&!z)
    sed_canonical_zd_w(&!w)
    sed_mul(&s, &z, &!pz)
    sed_mul(&s, &w, &!pw)

    let eps = 1.0e-12
    let dist = (sed_norm_sq(&pz) + sed_norm_sq(&pw)) / (sed_norm_sq(&s) + eps)
    let proximity = 1.0 / (1.0 + dist)
    out_zd[0] = proximity
    out_freeze[0] = clamp01(0.56 * proximity + 0.44 * contradiction)
}
