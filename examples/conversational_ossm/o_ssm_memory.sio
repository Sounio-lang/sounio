use o_ssm_core::{OSSMState}

pub struct BranchMemory {
    pub primary: OSSMState,
    pub alternate: OSSMState,
    pub has_alternate: bool,
    pub split_turn: i64,
    pub split_count: i64,
}

pub fn memory_new(root: OSSMState) -> BranchMemory {
    BranchMemory {
        primary: root,
        alternate: root,
        has_alternate: false,
        split_turn: 0,
        split_count: 0,
    }
}

pub fn memory_commit(mem: BranchMemory, next: OSSMState) -> BranchMemory with Mut {
    var out = mem
    out.primary = next
    out
}

pub fn memory_split(mem: BranchMemory, primary: OSSMState, alternate: OSSMState, turn: i64) -> BranchMemory with Mut {
    var out = mem
    out.primary = primary
    out.alternate = alternate
    out.has_alternate = true
    out.split_turn = turn
    out.split_count = out.split_count + 1
    out
}

pub fn memory_keep_best(mem: BranchMemory) -> BranchMemory with Mut {
    if !mem.has_alternate { return mem }
    var out = mem
    if out.alternate.confidence > out.primary.confidence {
        let swap = out.primary
        out.primary = out.alternate
        out.alternate = swap
    }
    out
}

pub fn branch_gap(mem: &BranchMemory) -> f64 {
    if !mem.has_alternate { return 0.0 }
    if mem.primary.confidence > mem.alternate.confidence {
        mem.primary.confidence - mem.alternate.confidence
    } else {
        mem.alternate.confidence - mem.primary.confidence
    }
}
