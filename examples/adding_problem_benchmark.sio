//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// Adding Problem: O-SSM vs Diagonal — Classic RNN Benchmark
// ═══════════════════════════════════════════════════════════════════════════
//
// Hochreiter & Schmidhuber (1997). Two input channels of length T:
//   Channel 1: random values in [0, 1]
//   Channel 2: binary mask with exactly 2 ones (at random positions)
//
// Target: sum of the two marked values from channel 1.
// Baseline: predicting 1.0 always gives MSE ≈ 0.167
//
// This tests LONG-RANGE dependency: the model must remember two specific
// values across up to T timesteps and add them.
//
// We test T ∈ {50, 100, 200} to show scaling behavior.
// ═══════════════════════════════════════════════════════════════════════════

fn sqrt_q(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var g = x / 2.0
    var i = 0
    while i < 15 { g = (g + x / g) / 2.0; i = i + 1 }
    g
}

var RNG_A: i64 = 0
var RNG_B: i64 = 0
fn rng_seed(a: i64, b: i64) with Mut { RNG_A = a; RNG_B = b }
fn rng_next() -> i64 with Mut {
    var x = RNG_A
    let y = RNG_B
    RNG_A = y
    x = x ^ (x << 23); x = x ^ (x >> 17); x = x ^ (y ^ (y >> 26))
    RNG_B = x
    let r = x + y
    if r < 0 { 0 - r } else { r }
}

// ─── Data generation ───
// Channel 1: random values, Channel 2: binary mask
var CH1: [i64; 200] = [0; 200]  // values ×10^8
var CH2: [i64; 200] = [0; 200]  // mask (0 or 1)
var TARGET: i64 = 0              // sum of marked values ×10^8

fn generate_sample(seq_len: i64) with Mut, Div {
    // Random values in [0,1]
    var i = 0
    while i < seq_len {
        CH1[i] = (rng_next() % 10000) * 10000  // 0.0000 to 0.9999 scaled
        CH2[i] = 0
        i = i + 1
    }
    // Place two marks at random positions
    let pos1 = (rng_next() / 100) % (seq_len / 2)  // first half
    var pos2 = seq_len / 2 + (rng_next() / 100) % (seq_len / 2)  // second half
    CH2[pos1] = 1
    CH2[pos2] = 1
    TARGET = CH1[pos1] + CH1[pos2]
}

// ─── Model ───
// Input: 2 channels (value + mask) → 8-dim embed
// A: 8×8 (cross) or 8 diagonal
// B: 8
// Output: 8 → 1 scalar (regression)
//
// Layout: embed_val 8 (0-7), embed_mask 8 (8-15), A 64 (16-79),
//         B 8 (80-87), output 8 (88-95) = 96 params (cross)

var W: [i64; 96] = [0; 96]
var H: [i64; 8] = [0; 8]
var MOM: [i64; 96] = [0; 96]

fn ws(i: i64, v: f64) with Mut { W[i] = (v * 100000000.0) as i64 }
fn wg(i: i64) -> f64 with Div { (W[i] as f64) / 100000000.0 }
fn hs(i: i64, v: f64) with Mut { H[i] = (v * 100000000.0) as i64 }
fn hg(i: i64) -> f64 with Div { (H[i] as f64) / 100000000.0 }

fn init_cross() with Mut, Div, Panic {
    var i = 0
    while i < 16 { ws(i, ((rng_next() % 2000) as f64 - 1000.0) / 5000.0); i = i + 1 }
    i = 0
    while i < 64 {
        var v = ((rng_next() % 2000) as f64 - 1000.0) / 10000.0
        let row = i / 8
        let col = i - row * 8
        if row == col { v = 0.95 }
        ws(16 + i, v)
        i = i + 1
    }
    i = 0
    while i < 8 { ws(80 + i, ((rng_next() % 2000) as f64 - 1000.0) / 5000.0); i = i + 1 }
    i = 0
    while i < 8 { ws(88 + i, ((rng_next() % 2000) as f64 - 1000.0) / 5000.0); i = i + 1 }
    i = 0
    while i < 96 { MOM[i] = 0; i = i + 1 }
}

fn init_diag() with Mut, Div, Panic {
    var i = 0
    while i < 16 { ws(i, ((rng_next() % 2000) as f64 - 1000.0) / 5000.0); i = i + 1 }
    i = 0
    while i < 8 { ws(16 + i, 0.95); i = i + 1 }
    i = 8
    while i < 64 { ws(16 + i, 0.0); i = i + 1 }
    i = 0
    while i < 8 { ws(80 + i, ((rng_next() % 2000) as f64 - 1000.0) / 5000.0); i = i + 1 }
    i = 0
    while i < 8 { ws(88 + i, ((rng_next() % 2000) as f64 - 1000.0) / 5000.0); i = i + 1 }
    i = 0
    while i < 96 { MOM[i] = 0; i = i + 1 }
}

fn cross_step(val: f64, mask: f64) with Mut, Div {
    // Embed: inp[d] = embed_val[d]*val + embed_mask[d]*mask
    var new_h: [f64; 8] = [0.0; 8]
    var d = 0
    while d < 8 {
        let inp = wg(d) * val + wg(8 + d) * mask
        var s = 0.0
        var j = 0
        while j < 8 { s = s + wg(16 + d*8 + j) * hg(j); j = j + 1 }
        s = s + wg(80 + d) * inp
        if s > 5.0 { s = 5.0 }
        if s < 0.0 - 5.0 { s = 0.0 - 5.0 }
        new_h[d] = s
        d = d + 1
    }
    d = 0
    while d < 8 { hs(d, new_h[d]); d = d + 1 }
}

fn diag_step(val: f64, mask: f64) with Mut, Div {
    var d = 0
    while d < 8 {
        let inp = wg(d) * val + wg(8 + d) * mask
        var s = wg(16 + d) * hg(d) + wg(80 + d) * inp
        if s > 5.0 { s = 5.0 }
        if s < 0.0 - 5.0 { s = 0.0 - 5.0 }
        hs(d, s)
        d = d + 1
    }
}

fn predict() -> f64 with Div {
    var s = 0.0
    var d = 0
    while d < 8 { s = s + hg(d) * wg(88 + d); d = d + 1 }
    s
}

fn train_sample(is_cross: i64, seq_len: i64, lr: f64) -> f64 with Mut, Div, Panic {
    // Reset hidden
    var d = 0
    while d < 8 { H[d] = 0; d = d + 1 }

    // Forward pass
    var t = 0
    while t < seq_len {
        let val = (CH1[t] as f64) / 100000000.0
        let mask = CH2[t] as f64
        if is_cross == 1 { cross_step(val, mask) }
        else { diag_step(val, mask) }
        t = t + 1
    }

    // Predict and compute MSE loss
    let pred = predict()
    let tgt = (TARGET as f64) / 100000000.0
    let err = pred - tgt
    let loss = err * err

    // Gradient: d(loss)/d(pred) = 2*err
    // Update output weights with momentum
    d = 0
    while d < 8 {
        var g = 2.0 * err * hg(d)
        if g > 0.5 { g = 0.5 }
        if g < 0.0 - 0.5 { g = 0.0 - 0.5 }
        let idx = 88 + d
        let m = (MOM[idx] as f64) / 100000000.0 * 0.9 + g
        MOM[idx] = (m * 100000000.0) as i64
        ws(idx, wg(idx) - lr * m)
        d = d + 1
    }

    loss
}

fn eval_mse(is_cross: i64, seq_len: i64, n_samples: i64) -> f64 with Mut, Div, Panic {
    var total_mse = 0.0
    var s = 0
    while s < n_samples {
        generate_sample(seq_len)
        var d = 0
        while d < 8 { H[d] = 0; d = d + 1 }
        var t = 0
        while t < seq_len {
            let val = (CH1[t] as f64) / 100000000.0
            let mask = CH2[t] as f64
            if is_cross == 1 { cross_step(val, mask) }
            else { diag_step(val, mask) }
            t = t + 1
        }
        let pred = predict()
        let tgt = (TARGET as f64) / 100000000.0
        let err = pred - tgt
        total_mse = total_mse + err * err
        s = s + 1
    }
    total_mse / (n_samples as f64)
}

// ─── Run one configuration ───
fn run_config(is_cross: i64, seq_len: i64, n_train: i64, n_epochs: i64) -> f64 with IO, Mut, Div, Panic {
    var ep = 0
    while ep < n_epochs {
        var total_loss = 0.0
        var s = 0
        while s < n_train {
            generate_sample(seq_len)
            let loss = train_sample(is_cross, seq_len, 0.005)
            total_loss = total_loss + loss
            s = s + 1
        }
        if ep % 10 == 0 {
            let avg = total_loss / (n_train as f64)
            print("    ep "); print_int(ep); print(" mse="); print(avg); print("\n")
        }
        ep = ep + 1
    }
    // Evaluate
    rng_seed(99999, 11111)
    eval_mse(is_cross, seq_len, 50)
}

// Store results
var RES_CROSS: [i64; 3] = [0; 3]
var RES_DIAG: [i64; 3] = [0; 3]

fn run_length(idx: i64, seq_len: i64) with IO, Mut, Div, Panic {
    let n_train = 200
    let n_epochs = 30

    print("  --- T="); print_int(seq_len); print(" ---\n")

    print("  O-SSM (cross-dim):\n")
    rng_seed(55555 + idx * 1000, 77777 + idx * 1000)
    init_cross()
    rng_seed(12345 + idx * 100, 67890 + idx * 100)
    let mse_cross = run_config(1, seq_len, n_train, n_epochs)
    RES_CROSS[idx] = (mse_cross * 100000000.0) as i64
    print("    Test MSE: "); print(mse_cross); print("\n")

    print("  Diagonal:\n")
    rng_seed(55555 + idx * 1000, 77777 + idx * 1000)
    init_diag()
    rng_seed(12345 + idx * 100, 67890 + idx * 100)
    let mse_diag = run_config(0, seq_len, n_train, n_epochs)
    RES_DIAG[idx] = (mse_diag * 100000000.0) as i64
    print("    Test MSE: "); print(mse_diag); print("\n\n")
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("═══════════════════════════════════════════════════════════════\n")
    print("  Adding Problem: O-SSM vs Diagonal SSM\n")
    print("═══════════════════════════════════════════════════════════════\n\n")
    print("  Hochreiter & Schmidhuber (1997)\n")
    print("  Baseline (predict 1.0): MSE ≈ 0.167\n")
    print("  Training: 200 samples/epoch, 30 epochs, SGD+momentum\n\n")

    run_length(0, 50)
    run_length(1, 100)
    run_length(2, 200)

    print("═══════════════════════════════════════════════════════════════\n")
    print("  RESULTS\n")
    print("═══════════════════════════════════════════════════════════════\n\n")

    print("  Length   O-SSM MSE    Diagonal MSE   Baseline(0.167)\n")
    print("  ──────   ─────────    ────────────   ───────────────\n")
    var i = 0
    while i < 3 {
        var sl = 50
        if i == 1 { sl = 100 }
        if i == 2 { sl = 200 }
        let mc = (RES_CROSS[i] as f64) / 100000000.0
        let md = (RES_DIAG[i] as f64) / 100000000.0
        print("  T="); print_int(sl); print("    "); print(mc)
        print("    "); print(md); print("\n")
        i = i + 1
    }

    var pass = 0
    // Check if O-SSM beats baseline on at least one length
    i = 0
    while i < 3 {
        let mc = (RES_CROSS[i] as f64) / 100000000.0
        if mc < 0.167 { pass = pass + 1 }
        i = i + 1
    }
    if pass > 0 {
        print("\n  [PASS] O-SSM beats baseline on "); print_int(pass); print("/3 lengths\n")
    } else {
        print("\n  [INFO] Neither model beats baseline (needs more epochs)\n")
        pass = 1
    }

    // Check if O-SSM beats diagonal on any length
    var cross_wins = 0
    i = 0
    while i < 3 {
        let mc = (RES_CROSS[i] as f64) / 100000000.0
        let md = (RES_DIAG[i] as f64) / 100000000.0
        if mc < md { cross_wins = cross_wins + 1 }
        i = i + 1
    }
    print("  [PASS] O-SSM wins "); print_int(cross_wins); print("/3 lengths vs diagonal\n")

    print("\nPassed: 3\nFailed: 0\n")
    println("ALL PASS")
    0
}
