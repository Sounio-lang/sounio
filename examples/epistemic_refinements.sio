//@ run-pass
// Epistemic refinement types with SMT-verified bounds
//
// This example demonstrates:
// 1. Type aliases with epistemic refinements
// 2. Functions requiring proven reliability
// 3. Compile-time verification of confidence bounds
// 4. Type errors on refinement violations

// Type alias: only high-confidence measurements
// The where clause is checked by the SMT solver at compile time
type Reliable<T> = Knowledge<T> where confidence >= 0.95

// Function that requires proven reliability
// Type system proves confidence >= 0.95 before calling
fn extract_safe<T>(k: Reliable<T>) -> T {
    // Safe to extract because type system guarantees confidence >= 0.95
    return k.extract()
}

// Function that shows confidence propagation
fn combine_reliable<T>(
    a: Reliable<T>,
    b: Reliable<T>
) -> Knowledge<T> where result.confidence >= 0.90 {
    // Product of confidences: 0.95 * 0.95 = 0.9025 >= 0.90
    // SMT solver verifies this at compile time
    return a.combine(b)
}

fn main() -> i32 with IO {
    // High confidence measurement - satisfies Reliable<f64>
    let high_conf: Reliable<f64> = measure(10.0, uncertainty: 0.2, confidence: 0.97)

    // Type checks: Z3 proves 0.97 >= 0.95
    let value = extract_safe(high_conf)

    // Low confidence measurement - does NOT satisfy Reliable<f64>
    let low_conf: Knowledge<f64> = measure(20.0, uncertainty: 5.0, confidence: 0.70)

    // COMPILE ERROR: Cannot prove 0.70 >= 0.95
    // Uncomment to see type error:
    // let bad = extract_safe(low_conf)

    // Combining two reliable measurements
    let a: Reliable<f64> = measure(5.0, uncertainty: 0.1, confidence: 0.96)
    let b: Reliable<f64> = measure(8.0, uncertainty: 0.15, confidence: 0.98)

    // Type checks: 0.96 * 0.98 = 0.9408 >= 0.90
    let combined = combine_reliable(a, b)

    return 0
}
