//@ run-pass
//!
//! Matcher-free first Sounio authority executable for Operator Morphogenesis
//! V12. All generated values are printed as results, never matched here.

use hardware::pireus::operator_morphogenesis::{
    PireusPomDigest,
    PIREUS_POM_OK,
    PIREUS_POM_EPOCHS,
    PIREUS_POM_SIGN_CELLS,
    PIREUS_POM_INTERIOR_CELLS,
    pireus_operator_morphogenesis_request,
    pireus_operator_morphogenesis_evaluate,
    pireus_operator_morphogenesis_frozen_mismatch_code,
    pireus_operator_morphogenesis_matches_frozen_semantics,
}

fn bit(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(digest: &PireusPomDigest) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(digest.words[word])
        word = word + 1
    }
}

fn print_hash(words: &[i64; 8]) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(words[word])
        word = word + 1
    }
}

fn print_flat_digest(words: &[i64; 128], epoch: i64)
with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(words[epoch * 8 + word])
        word = word + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_operator_morphogenesis_request()
    let result = pireus_operator_morphogenesis_evaluate(&request)
    let population = &result.population

    print("SOUNIO_AUTHORITY schema=pireus-operator-morphogenesis.v12")
    print(" role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE")
    print(" matcher_free=1\n")

    print("PIREUS_POM_LINEAGE cubic_live_valid=")
    print_int(bit(result.lineage.cubic_live_valid))
    print(" cubic_frozen_match=")
    print_int(bit(result.lineage.cubic_frozen_match))
    print(" complete="); print_int(bit(result.lineage.complete)); print("\n")
    print("PIREUS_POM_PARENT field=garden value=")
    print_hash(&result.lineage.garden_sha256)
    print("\nPIREUS_POM_PARENT field=contract value=")
    print_hash(&result.lineage.contract_sha256)
    print("\nPIREUS_POM_PARENT field=cubic_source value=")
    print_hash(&result.lineage.cubic_source_sha256)
    print("\nPIREUS_POM_PARENT field=cubic_semantics value=")
    print_hash(&result.lineage.cubic_semantics_sha256)
    print("\nPIREUS_POM_PARENT field=cubic_freeze value=")
    print_hash(&result.lineage.cubic_freeze_sha256)
    print("\nPIREUS_POM_PARENT field=cubic_parity value=")
    print_hash(&result.lineage.cubic_parity_sha256)
    print("\nPIREUS_POM_PARENT field=frontier_semantics value=")
    print_hash(&result.lineage.frontier_semantics_sha256)
    print("\nPIREUS_POM_PARENT field=frontier_material value=")
    print_hash(&result.lineage.frontier_material_sha256)
    print("\n")

    print("PIREUS_POM_ARCHIVE initial=")
    print_int(population.initial_archive_count)
    print(" final="); print_int(population.final_archive_count)
    print(" generated="); print_int(population.generated_epochs)
    print(" fixed="); print_int(population.orbit_fixed)
    print(" pairs="); print_int(population.orbit_pairs)
    print(" closure_checks=")
    print_int(population.archive_closure_checks)
    print(" closure_failures=")
    print_int(population.archive_closure_failures)
    print(" dedup_checks="); print_int(population.archive_dedup_checks)
    print(" capacity_failures=")
    print_int(population.archive_capacity_failures)
    print(" capacity_refusals="); print_int(population.capacity_refusals)
    print("\n")

    print("PIREUS_POM_PROOF cd_sign_checks=")
    print_int(population.cd_sign_checks)
    print(" cd_sign_failures="); print_int(population.cd_sign_failures)
    print(" cd_axis_checks="); print_int(population.cd_axis_checks)
    print(" cd_axis_failures="); print_int(population.cd_axis_failures)
    print(" phase_checks="); print_int(population.phase_checks)
    print(" phase_failures="); print_int(population.phase_failures)
    print(" anf_coefficients=")
    print_int(population.anf_coefficient_checks)
    print(" anf_reconstruction_checks=")
    print_int(population.anf_reconstruction_checks)
    print(" anf_reconstruction_failures=")
    print_int(population.anf_reconstruction_failures)
    print(" certificates="); print_int(population.certificate_count)
    print(" certificate_checks=")
    print_int(population.certificate_checks)
    print(" certificate_failures=")
    print_int(population.certificate_failures)
    print(" direct_comparisons=")
    print_int(population.direct_comparison_checks)
    print(" direct_collision_failures=")
    print_int(population.direct_collision_failures)
    print(" unit_checks="); print_int(population.unit_checks)
    print(" unit_failures="); print_int(population.unit_failures)
    print(" microprogram_checks=")
    print_int(population.microprogram_checks)
    print(" microprogram_failures=")
    print_int(population.microprogram_failures)
    print("\n")

    var epoch: i64 = 0
    while epoch < population.generated_epochs {
        print("PIREUS_POM_EPOCH epoch="); print_int(epoch)
        print(" archive_before="); print_int(population.archive_before[epoch])
        print(" archive_after="); print_int(population.archive_after[epoch])
        print(" orbit_kind="); print_int(population.orbit_kinds[epoch])
        print(" negatives="); print_int(population.negative_sign_counts[epoch])
        print(" square_negatives=")
        print_int(population.square_negative_counts[epoch])
        print(" commutator_defects=")
        print_int(population.commutator_defects[epoch])
        print(" associator_defects=")
        print_int(population.associator_defects[epoch])
        print(" parent_archive_digest=")
        print_flat_digest(&population.parent_archive_digest_words, epoch)
        print(" epoch_digest=")
        print_flat_digest(&population.epoch_digest_words, epoch)
        print("\n")

        var interior: i64 = 0
        while interior < PIREUS_POM_INTERIOR_CELLS {
            print("PIREUS_POM_GENOME epoch="); print_int(epoch)
            print(" cell="); print_int(interior)
            print(" phase=")
            print_int(population.generated_phase_bits[
                epoch * PIREUS_POM_INTERIOR_CELLS + interior])
            print(" anf=")
            print_int(population.generated_anf_bits[
                epoch * PIREUS_POM_INTERIOR_CELLS + interior])
            print("\n")
            interior = interior + 1
        }

        var cell: i64 = 0
        while cell < PIREUS_POM_SIGN_CELLS {
            let flat = epoch * PIREUS_POM_SIGN_CELLS + cell
            print("PIREUS_POM_MICROPROGRAM epoch="); print_int(epoch)
            print(" entry="); print_int(cell)
            print(" left="); print_int(population.microprogram_left_inputs[flat])
            print(" right="); print_int(population.microprogram_right_inputs[flat])
            print(" destination=")
            print_int(population.microprogram_destinations[flat])
            print(" ordinal="); print_int(population.microprogram_ordinals[flat])
            print(" sign_bit=")
            print_int(population.microprogram_sign_bits[flat])
            print("\n")
            cell = cell + 1
        }

        var lane: i64 = 0
        while lane < 16 {
            print("PIREUS_POM_PROBE epoch="); print_int(epoch)
            print(" lane="); print_int(lane)
            print(" value=")
            print_int(population.probe_outputs[epoch * 16 + lane])
            print("\n")
            lane = lane + 1
        }
        epoch = epoch + 1
    }

    var certificate: i64 = 0
    while certificate < population.certificate_count {
        print("PIREUS_POM_CERTIFICATE id="); print_int(certificate)
        print(" kind="); print_int(population.certificate_kinds[certificate])
        print(" epoch="); print_int(population.certificate_epochs[certificate])
        print(" archive_index=")
        print_int(population.certificate_archive_indices[certificate])
        print(" partner_index=")
        print_int(population.certificate_partner_indices[certificate])
        print(" cell="); print_int(population.certificate_cells[certificate])
        print(" generated_bit=")
        print_int(population.certificate_generated_bits[certificate])
        print(" archived_bit=")
        print_int(population.certificate_archived_bits[certificate])
        print("\n")
        certificate = certificate + 1
    }

    print("PIREUS_POM_NEGATIVES passed=")
    print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")
    print("PIREUS_POM_DIGEST final_archive=")
    print_digest(&population.final_archive_digest)
    print(" run="); print_digest(&population.run_digest); print("\n")
    print("PIREUS_POM_BOUNDARY proof_carrying_complete=")
    print_int(bit(result.proof_carrying_generation_complete))
    print(" constructive_bounded_relative_novelty=")
    print_int(bit(result.constructive_bounded_relative_novelty))
    print(" candidate_selected="); print_int(bit(result.candidate_selected))
    print(" full_space_exhausted="); print_int(bit(result.full_space_exhausted))
    print(" gl_gauge="); print_int(bit(result.full_gl_gauge_inequivalence))
    print(" algebraic="); print_int(bit(result.algebraic_novelty))
    print(" algorithmic="); print_int(bit(result.algorithmic_novelty))
    print(" material="); print_int(bit(result.material_novelty))
    print(" performance="); print_int(bit(result.performance_novelty))
    print(" scientific="); print_int(bit(result.scientific_novelty))
    print(" historical="); print_int(bit(result.historical_novelty))
    print(" global="); print_int(bit(result.global_novelty))
    print(" priority="); print_int(bit(result.priority_claim))
    print(" claim_ready="); print_int(bit(result.claim_ready)); print("\n")
    print("PIREUS_POM_SUMMARY error="); print_int(result.error)
    print(" structural_failures="); print_int(result.structural_failures)
    print(" frozen_mismatch_code=")
    print_int(pireus_operator_morphogenesis_frozen_mismatch_code(&result))
    print(" frozen_match=")
    print_int(bit(pireus_operator_morphogenesis_matches_frozen_semantics(
        &result)))
    print(" valid="); print_int(bit(result.valid)); print("\n")

    if result.valid && result.error == PIREUS_POM_OK &&
        result.structural_failures == 0 &&
        result.proof_carrying_generation_complete &&
        result.constructive_bounded_relative_novelty &&
        pireus_operator_morphogenesis_matches_frozen_semantics(&result) &&
        !result.candidate_selected && !result.claim_ready { 0 } else { 1 }
}
