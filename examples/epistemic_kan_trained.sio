//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// Epistemic Kolmogorov-Arnold Network — Trained (E-KAN-T)
// ═══════════════════════════════════════════════════════════════════════════
//
// Enhancements over base E-KAN:
//   • End-to-end gradient descent training on sin(πx)
//   • Manual backprop through piecewise-linear hat basis
//   • Convergence + generalization tests
//   • OOD error detection (extrapolation penalty)
//   • GPU-ready kernel stubs for batch forward/backward
//
// First KAN that actually learns inside Sounio.

fn sqrt_t(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 15 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}
fn abs_t(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn sin_t(x: f64) -> f64 with Mut, Div {
    var v = x
    while v > 3.14159 { v = v - 6.28318 }
    while v < 0.0 - 3.14159 { v = v + 6.28318 }
    let v3 = v * v * v
    let v5 = v3 * v * v
    let v7 = v5 * v * v
    v - v3 / 6.0 + v5 / 120.0 - v7 / 5040.0
}

var RNG_T: i64 = 314159
fn rand_t() -> f64 with Mut, Div, Panic {
    RNG_T = (RNG_T * 6364136223846793005 + 1442695040888963407)
    var v = RNG_T
    if v < 0 { v = 0 - v }
    (v % 10000) as f64 / 10000.0 - 0.5
}

// Hat basis at knot k (5 knots at 0, 0.25, 0.5, 0.75, 1.0)
fn hat_t(x: f64, k: i64) -> f64 with Mut, Div, Panic {
    let c = (k as f64) * 0.25
    let d = abs_t(x - c) / 0.25
    if d >= 1.0 { return 0.0 }
    1.0 - d
}

// Derivative of hat basis (piecewise constant)
fn hat_deriv_t(x: f64, k: i64) -> f64 with Mut {
    let c = (k as f64) * 0.25
    let d = x - c
    if abs_t(d) >= 0.25 { return 0.0 }
    if d < 0.0 { 4.0 } else { 0.0 - 4.0 }
}

// ─── Edge eval with uncertainty ───
struct EvT { val: f64, unc: f64 }

fn edge_eval_t(coeffs: &[f64; 5], unc: &[f64; 5], x: f64) -> EvT with Mut, Div, Panic {
    var val = 0.0
    var vs = 0.0
    var k = 0
    while k < 5 {
        let b = hat_t(x, k)
        val = val + coeffs[k as usize] * b
        vs = vs + b * b * unc[k as usize] * unc[k as usize]
        k = k + 1
    }
    EvT { val: val, unc: sqrt_t(vs) }
}

// ─── Globals ───
var L1_C: [f64; 40] = [0.0; 40]   // 8 edges × 5 coeffs
var L1_U: [f64; 40] = [0.0; 40]   // uncertainties (fixed)
var L1_G: [f64; 40] = [0.0; 40]   // gradients
var L2_C: [f64; 40] = [0.0; 40]   // 8 edges × 5 coeffs
var L2_U: [f64; 40] = [0.0; 40]   // uncertainties (fixed)
var L2_G: [f64; 40] = [0.0; 40]   // gradients
var HT: [f64; 8] = [0.0; 8]       // hidden activations

// Training data: sin(πx) on [0,1]
var TRAIN_X: [f64; 6] = [0.0, 0.15, 0.3, 0.5, 0.7, 0.85]
var TRAIN_Y: [f64; 6] = [0.0, 0.454, 0.809, 1.0, 0.809, 0.454]

// Test data (unseen)
var TEST_X: [f64; 4] = [0.075, 0.225, 0.6, 0.95]
var TEST_Y: [f64; 4] = [0.233, 0.649, 0.951, 0.156]

// ─── Forward pass (stores hidden in HT) ───
fn forward_t(x: f64) -> f64 with Mut, Div, Panic {
    // Layer 1: 1 input -> 8 hidden
    var j = 0
    while j < 8 {
        var s = 0.0
        var k = 0
        while k < 5 {
            s = s + L1_C[(j * 5 + k) as usize] * hat_t(x, k)
            k = k + 1
        }
        HT[j as usize] = s
        j = j + 1
    }

    // Layer 2: 8 hidden -> 1 output
    var y = 0.0
    j = 0
    while j < 8 {
        var h_clamped = HT[j as usize]
        if h_clamped < 0.0 { h_clamped = 0.0 }
        if h_clamped > 1.0 { h_clamped = 1.0 }
        var s = 0.0
        var k = 0
        while k < 5 {
            s = s + L2_C[(j * 5 + k) as usize] * hat_t(h_clamped, k)
            k = k + 1
        }
        y = y + s
        j = j + 1
    }
    y
}

// ─── Backward pass + update ───
fn backward_t(x: f64, target: f64, lr: f64) with Mut, Div, Panic {
    let y = forward_t(x)
    let dL_dy = 2.0 * (y - target)

    // Zero gradients
    var i = 0
    while i < 40 { L1_G[i as usize] = 0.0; L2_G[i as usize] = 0.0; i = i + 1 }

    // Layer 2 + Layer 1 backprop
    var j = 0
    while j < 8 {
        var h_clamped = HT[j as usize]
        var dh_raw = 1.0
        if h_clamped < 0.0 { h_clamped = 0.0; dh_raw = 0.0 }
        if h_clamped > 1.0 { h_clamped = 1.0; dh_raw = 0.0 }

        // L2 gradient
        var k = 0
        while k < 5 {
            let h_val = hat_t(h_clamped, k)
            L2_G[(j * 5 + k) as usize] = dL_dy * h_val
            k = k + 1
        }

        // Gradient w.r.t. hidden j
        var dL_dhj = 0.0
        k = 0
        while k < 5 {
            dL_dhj = dL_dhj + L2_C[(j * 5 + k) as usize] * hat_deriv_t(h_clamped, k)
            k = k + 1
        }
        dL_dhj = dL_dhj * dL_dy * dh_raw

        // L1 gradient
        k = 0
        while k < 5 {
            L1_G[(j * 5 + k) as usize] = dL_dhj * hat_t(x, k)
            k = k + 1
        }

        j = j + 1
    }

    // Update weights
    i = 0
    while i < 40 {
        L1_C[i as usize] = L1_C[i as usize] - lr * L1_G[i as usize]
        L2_C[i as usize] = L2_C[i as usize] - lr * L2_G[i as usize]
        i = i + 1
    }
}

// ─── Loss functions ───
fn mse_train() -> f64 with Mut, Div, Panic {
    var s = 0.0
    var i = 0
    while i < 6 {
        let y = forward_t(TRAIN_X[i as usize])
        let e = y - TRAIN_Y[i as usize]
        s = s + e * e
        i = i + 1
    }
    s / 6.0
}

fn mse_test() -> f64 with Mut, Div, Panic {
    var s = 0.0
    var i = 0
    while i < 4 {
        let y = forward_t(TEST_X[i as usize])
        let e = y - TEST_Y[i as usize]
        s = s + e * e
        i = i + 1
    }
    s / 4.0
}

// Forward with uncertainty (inference only)
fn forward_unc_t(x: f64, xu: f64) -> EvT with Mut, Div, Panic {
    // Layer 1
    var j = 0
    while j < 8 {
        var c: [f64; 5] = [0.0; 5]
        var u: [f64; 5] = [0.0; 5]
        var k = 0
        while k < 5 {
            c[k as usize] = L1_C[(j * 5 + k) as usize]
            u[k as usize] = L1_U[(j * 5 + k) as usize]
            k = k + 1
        }
        let ev = edge_eval_t(&c, &u, x)
        HT[j as usize] = ev.val
        j = j + 1
    }

    // Layer 2
    var y = 0.0
    var yu_sq = 0.0
    j = 0
    while j < 8 {
        var h_clamped = HT[j as usize]
        if h_clamped < 0.0 { h_clamped = 0.0 }
        if h_clamped > 1.0 { h_clamped = 1.0 }
        var c: [f64; 5] = [0.0; 5]
        var u: [f64; 5] = [0.0; 5]
        var k = 0
        while k < 5 {
            c[k as usize] = L2_C[(j * 5 + k) as usize]
            u[k as usize] = L2_U[(j * 5 + k) as usize]
            k = k + 1
        }
        let ev = edge_eval_t(&c, &u, h_clamped)
        y = y + ev.val
        yu_sq = yu_sq + ev.unc * ev.unc + xu * xu
        j = j + 1
    }
    EvT { val: y, unc: sqrt_t(yu_sq) }
}

// ─── GPU-ready kernel stubs ───
kernel kan_fwd_batch(n: i64) with GPU, Div, Panic {
    var i: i64 = 0
    while i < n {
        // Each thread: load input x, compute forward_t(x), write output
        i = i + 1
    }
}

kernel kan_bwd_batch(n: i64) with GPU, Div, Panic {
    var i: i64 = 0
    while i < n {
        // Each thread: load (x, target), compute backward_t(x, target, lr)
        i = i + 1
    }
}

// ─── Tests ───
fn main() -> i32 with IO, Mut, Div, Panic {
    var passed = 0
    var failed = 0

    // Init coefficients (small random) and fixed uncertainties
    var i = 0
    while i < 40 {
        L1_C[i as usize] = rand_t() * 0.1
        L1_U[i as usize] = 0.05
        L2_C[i as usize] = rand_t() * 0.1
        L2_U[i as usize] = 0.05
        i = i + 1
    }

    // T1: Edge activation is non-trivial
    let c1: [f64; 5] = [0.1, 0.5, 0.0 - 0.3, 0.8, 0.2]
    let u1: [f64; 5] = [0.01, 0.02, 0.01, 0.03, 0.01]
    let ev1 = edge_eval_t(&c1, &u1, 0.3)
    let ev2 = edge_eval_t(&c1, &u1, 0.7)
    if abs_t(ev1.val - ev2.val) > 0.01 {
        print("T1 PASS: edge(0.3)="); print(ev1.val); print(", edge(0.7)="); print(ev2.val); println("")
        passed = passed + 1
    } else { println("T1 FAIL"); failed = failed + 1 }

    // T2: Uncertainty is non-zero
    if ev1.unc > 0.0 && ev2.unc > 0.0 {
        print("T2 PASS: σ(0.3)="); print(ev1.unc); print(", σ(0.7)="); print(ev2.unc); println("")
        passed = passed + 1
    } else { println("T2 FAIL"); failed = failed + 1 }

    // T3: Forward pass produces output before training
    let y_before = forward_t(0.5)
    if abs_t(y_before) > 0.001 {
        print("T3 PASS: pre-train y(0.5)="); print(y_before); println("")
        passed = passed + 1
    } else { println("T3 FAIL"); failed = failed + 1 }

    // Measure loss before training
    let loss_before = mse_train()

    // Train 20 epochs
    var epoch = 0
    while epoch < 20 {
        var s = 0
        while s < 6 {
            backward_t(TRAIN_X[s as usize], TRAIN_Y[s as usize], 0.05)
            s = s + 1
        }
        epoch = epoch + 1
    }

    // Measure loss after training
    let loss_after = mse_train()

    // T4: Loss decreased
    if loss_after < loss_before {
        print("T4 PASS: loss "); print(loss_before); print(" -> "); print(loss_after); println("")
        passed = passed + 1
    } else { println("T4 FAIL"); failed = failed + 1 }

    // T5: Test MSE below threshold
    let test_mse = mse_test()
    if test_mse < 0.15 {
        print("T5 PASS: test MSE="); print(test_mse); println(" (< 0.15)")
        passed = passed + 1
    } else { println("T5 FAIL"); failed = failed + 1 }

    // T6: Training point approximation
    var train_err = 0.0
    i = 0
    while i < 6 {
        let y = forward_t(TRAIN_X[i as usize])
        let e = abs_t(y - TRAIN_Y[i as usize])
        if e > train_err { train_err = e }
        i = i + 1
    }
    if train_err < 0.2 {
        print("T6 PASS: max train error="); print(train_err); println(" (< 0.2)")
        passed = passed + 1
    } else { println("T6 FAIL"); failed = failed + 1 }

    // T7: Uncertainty propagation after training
    let ev_inf = forward_unc_t(0.5, 0.01)
    if ev_inf.unc > 0.0 {
        print("T7 PASS: σ_after_train("); print(ev_inf.val); print(")="); print(ev_inf.unc); println("")
        passed = passed + 1
    } else { println("T7 FAIL"); failed = failed + 1 }

    // T8: OOD error is higher than ID error
    // OOD inputs: -0.2 and 1.2 (outside training domain [0,1])
    // True targets: sin(-0.2π) ≈ -0.588, sin(1.2π) ≈ -0.588
    let ood1 = forward_t(0.0 - 0.2)
    let ood2 = forward_t(1.2)
    let ood_tgt1 = sin_t(0.0 - 0.628318)
    let ood_tgt2 = sin_t(3.769911)
    let ood_err = abs_t(ood1 - ood_tgt1) + abs_t(ood2 - ood_tgt2)
    let id_err = test_mse * 4.0
    if ood_err > id_err {
        print("T8 PASS: OOD error="); print(ood_err); print(" > 4×test MSE="); print(id_err); println("")
        passed = passed + 1
    } else { println("T8 FAIL"); failed = failed + 1 }

    // T9: Parameter count
    println("T9 PASS: E-KAN-T 1→8→1, 80 params (16 edges × 5)")
    passed = passed + 1

    println("")
    print("Passed: "); print_int(passed); println("")
    print("Failed: "); print_int(failed); println("")
    if failed == 0 { println("ALL PASS") } else { println("SOME TESTS FAILED") }
    failed as i32
}
