// scientific_hello.sio — Sprint 235: print_f64 gate
//
// Demonstrates f64 output from native ELF.
// Compiles via lean emitter to bare-metal x86-64.
//
// Expected output:
//   sqrt(2) = 1.414214
//   concentration = 11.904762

fn main() -> i64 with IO, Mut, Panic, Div {
    let x = sqrt(2.0)
    print("sqrt(2) = ")
    print_f64(x)
    print("\n")

    let dose = 500.0
    let volume = 42.0
    let conc = dose / volume
    print("concentration = ")
    print_f64(conc)
    print(" mg/L\n")

    0
}
