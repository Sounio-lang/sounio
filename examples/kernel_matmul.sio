// Example: GPU kernel for matrix multiplication
//
// Demonstrates multiple kernel functions in a single file that the checked GPU
// profile can lower to PTX.
//
// Public GPU-profile commands:
//   souc-linux-x86_64-gpu check examples/kernel_matmul.sio
//   souc-linux-x86_64-gpu build examples/kernel_matmul.sio --backend gpu -o /tmp/kernel_matmul.ptx

kernel fn matmul(m: i64, n: i64, k: i64) with GPU {
}

kernel fn matmul_transpose(m: i64, n: i64) with GPU {
}

fn main() -> i32 with IO {
    0
}
