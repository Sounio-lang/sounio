//@ run-pass
//!
//! First Sounio authority stream for receipt-bound Pireus engine admission.

use hardware::pireus::material_engine_admission::{
    PireusMaterialEngineDigest, PireusMaterialEngineParentPaths,
    PIREUS_MATERIAL_ENGINE_OK, PIREUS_MATERIAL_ENGINE_PARENT_FILE_COUNT,
    PIREUS_LOCATOR_APPLE_TAILNET, PIREUS_MACHINE_APPLE_MAC17_7,
    PIREUS_ENGINE_CPU_APPLE_M5_MAX, PIREUS_ENGINE_KIND_CPU,
    PIREUS_RECEIPT_APPLE_A64_TBL,
    PIREUS_EVIDENCE_APPLE_A64_TBL, PIREUS_HARDWARE_APPLE_MAC17_7,
    PIREUS_LOCATOR_DGX_24, PIREUS_MACHINE_DGX_SPARK_3C59,
    PIREUS_ENGINE_GPU_DGX_GB10,
    PIREUS_RECEIPT_DGX_PTX_SHFL, PIREUS_EVIDENCE_DGX_PTX_SHFL,
    PIREUS_HARDWARE_DGX_SPARK_3C59,
    PIREUS_LOCATOR_DGX_48, PIREUS_IDENTITY_REQUEST_DGX_48,
    pireus_material_engine_parent_file_matches,
    pireus_material_engine_admission_evaluate,
    pireus_material_engine_admission_matches_frozen_semantics,
}
use hardware::pireus::target_profile::{
    PIREUS_TARGET_APPLE_SILICON, PIREUS_TARGET_DGX_SPARK,
}
use hardware::pireus::execution_engine::{
    PIREUS_ENGINE_KIND_CPU, PIREUS_ENGINE_KIND_GPU,
    PIREUS_ENGINE_ISA_AARCH64, PIREUS_ENGINE_ISA_NVIDIA_SM121,
    PIREUS_INTERFACE_CUDA,
}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(digest: &PireusMaterialEngineDigest) with IO, Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if i > 0 { print(":") }
        print_int(digest.words[i as usize])
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 12 {
        print("usage: pireus_material_engine_admission <garden> <engine-source> <engine-semantics> <engine-receipt> <cost-source> <cost-semantics> <cost-receipt> <cost-evidence> <apple-receipt> <apple-evidence> <dgx-receipt> <dgx-evidence>\n")
        return 2
    }
    let parents = PireusMaterialEngineParentPaths {
        garden: get_arg(0), engine_source: get_arg(1),
        engine_semantics: get_arg(2), engine_receipt: get_arg(3),
        cost_source: get_arg(4), cost_semantics: get_arg(5),
        cost_receipt: get_arg(6), cost_evidence: get_arg(7),
        apple_receipt: get_arg(8), apple_evidence: get_arg(9),
        dgx_receipt: get_arg(10), dgx_evidence: get_arg(11),
    }
    let result = pireus_material_engine_admission_evaluate(&parents)
    var failures = result.failures
    if !result.valid || result.error != PIREUS_MATERIAL_ENGINE_OK {
        failures = failures + 1
    }
    if !pireus_material_engine_admission_matches_frozen_semantics(&result) {
        failures = failures + 1
    }

    print("SOUNIO_SEMANTIC_AUTHORITY schema=pireus-material-engine-admission.v0 material_receipt_producer_role=MATERIAL_PARITY\n")
    print("PIREUS_MATERIAL_PARENTS files=")
    print_int(PIREUS_MATERIAL_ENGINE_PARENT_FILE_COUNT)
    print(" matched="); print_int(result.parent_file_match_count)
    print(" engine_snapshot_matches=")
    print_int(yes(result.execution_engine_parent_snapshot_matches))
    print(" cost_hash_bound=")
    print_int(yes(result.target_cost_parent_hash_bound))
    print(" valid="); print_int(yes(result.parent_files_valid)); print("\n")
    var i: i64 = 0
    while i < PIREUS_MATERIAL_ENGINE_PARENT_FILE_COUNT {
        print("PIREUS_MATERIAL_PARENT_FILE index="); print_int(i)
        print(" match=")
        print_int(yes(pireus_material_engine_parent_file_matches(
            result.parent_file_match_mask, i)))
        print("\n")
        i = i + 1
    }
    print("PIREUS_MATERIAL_BASE cluster_machines=")
    print_int(result.base_cluster_machine_count)
    print(" cpu_engines="); print_int(result.base_cpu_engine_count)
    print(" gpu_engines="); print_int(result.base_gpu_engine_count)
    print(" darwin_engines="); print_int(result.base_darwin_engine_count)
    print(" apple_engines="); print_int(result.base_apple_engine_count)
    print(" dgx_engines="); print_int(result.base_dgx_engine_count); print("\n")

    print("PIREUS_MATERIAL_ADMISSION target=")
    print_int(PIREUS_TARGET_APPLE_SILICON)
    print(" locator="); print_int(PIREUS_LOCATOR_APPLE_TAILNET)
    print(" machine="); print_int(PIREUS_MACHINE_APPLE_MAC17_7)
    print(" engine="); print_int(PIREUS_ENGINE_CPU_APPLE_M5_MAX)
    print(" kind="); print_int(PIREUS_ENGINE_KIND_CPU)
    print(" isa="); print_int(PIREUS_ENGINE_ISA_AARCH64)
    print(" interface=0 receipt="); print_int(PIREUS_RECEIPT_APPLE_A64_TBL)
    print(" evidence="); print_int(PIREUS_EVIDENCE_APPLE_A64_TBL)
    print(" hardware="); print_int(PIREUS_HARDWARE_APPLE_MAC17_7)
    print(" admitted="); print_int(yes(result.apple_admitted)); print("\n")

    print("PIREUS_MATERIAL_ADMISSION target=")
    print_int(PIREUS_TARGET_DGX_SPARK)
    print(" locator="); print_int(PIREUS_LOCATOR_DGX_24)
    print(" machine="); print_int(PIREUS_MACHINE_DGX_SPARK_3C59)
    print(" engine="); print_int(PIREUS_ENGINE_GPU_DGX_GB10)
    print(" kind="); print_int(PIREUS_ENGINE_KIND_GPU)
    print(" isa="); print_int(PIREUS_ENGINE_ISA_NVIDIA_SM121)
    print(" interface="); print_int(PIREUS_INTERFACE_CUDA)
    print(" receipt="); print_int(PIREUS_RECEIPT_DGX_PTX_SHFL)
    print(" evidence="); print_int(PIREUS_EVIDENCE_DGX_PTX_SHFL)
    print(" hardware="); print_int(PIREUS_HARDWARE_DGX_SPARK_3C59)
    print(" admitted="); print_int(yes(result.dgx_24_admitted)); print("\n")

    print("PIREUS_MATERIAL_IDENTITY_REQUEST target=")
    print_int(PIREUS_TARGET_DGX_SPARK)
    print(" locator="); print_int(PIREUS_LOCATOR_DGX_48)
    print(" request="); print_int(PIREUS_IDENTITY_REQUEST_DGX_48)
    print(" machine=0 engine=0 unresolved=")
    print_int(yes(result.dgx_48_unresolved)); print("\n")

    print("PIREUS_MATERIAL_OVERLAY cluster_machines=")
    print_int(result.overlay_cluster_machine_count)
    print(" cpu_engines="); print_int(result.overlay_cpu_engine_count)
    print(" gpu_engines="); print_int(result.overlay_gpu_engine_count)
    print(" apple_engines="); print_int(result.overlay_apple_engine_count)
    print(" dgx_engines="); print_int(result.overlay_dgx_engine_count)
    print(" admitted_machines="); print_int(result.admitted_machine_count)
    print(" admitted_engines="); print_int(result.admitted_engine_count)
    print(" receipts="); print_int(result.material_receipt_count)
    print(" unresolved_identity_requests=")
    print_int(result.unresolved_identity_request_count)
    print(" identity_requests="); print_int(result.identity_request_count)
    print(" dgx_48_resolutions="); print_int(result.dgx_48_resolution_count)
    print(" apple_gpu="); print_int(result.apple_gpu_engine_count)
    print(" dgx_cpu="); print_int(result.dgx_cpu_engine_count); print("\n")

    print("PIREUS_MATERIAL_COST_REQUEST_ELIGIBILITY engines=")
    print_int(result.cost_request_eligible_engine_count)
    print(" rows="); print_int(result.cost_request_eligibility_count)
    print(" values="); print_int(result.material_cost_value_count)
    print(" whole_operation=")
    print_int(result.whole_operation_coverage_count); print("\n")
    print("PIREUS_MATERIAL_NEGATIVES passed=")
    print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")
    print("PIREUS_MATERIAL_BOUNDARY comparisons=")
    print_int(result.comparison_count)
    print(" speedups="); print_int(result.speedup_count)
    print(" rankings="); print_int(result.ranking_count)
    print(" cross_target_comparable=")
    print_int(yes(result.cross_target_comparable))
    print(" parity_open="); print_int(yes(result.parity_open))
    print(" claim_ready="); print_int(yes(result.claim_ready)); print("\n")
    print("PIREUS_MATERIAL_ONTOLOGY triples=")
    print_int(result.ontology_triple_count)
    print(" identity_binding_valid=")
    print_int(yes(result.ontology_identity_binding_valid)); print("\n")
    print("PIREUS_MATERIAL_ONTOLOGY_DIGEST words=")
    print_digest(&result.ontology_digest); print("\n")
    print("PIREUS_MATERIAL_DIGEST words=")
    print_digest(&result.result_digest); print("\n")
    print("PIREUS_MATERIAL_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(failures); print("\n")
    if failures == 0 { 0 } else { 1 }
}
