//! Test Knowledge type syntax

struct Knowledge<T> {
    value: T,
    uncertainty: f64,
    confidence: f64,
    provenance: String,
}

impl<T> Knowledge<T> {
    fn new(value: T, uncertainty: f64, confidence: f64, source: &str) -> Self {
        Knowledge {
            value,
            uncertainty,
            confidence,
            provenance: source.to_string(),
        }
    }
}

fn main() {
    let measurement = Knowledge::new(42.0, 2.1, 0.94, "experimental")
}
