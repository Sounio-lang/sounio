//@ run-pass
// Conjecture 3 — Computational Proof
//
// For each of the 343 ordered triples of octonion basis elements,
// compute BOTH parenthesizations of the triple product:
//
//   Forward:  (e_i · e_j) · e_k = α · e_{i⊕j⊕k}
//   Backward: e_i · (e_j · e_k) = β · e_{i⊕j⊕k}
//
// In TSVF terms:
//   Forward  = (⟨φ| · A) · |ψ⟩  — past meets observable first
//   Backward = ⟨φ| · (A · |ψ⟩)  — future meets observable first
//
// The associator bit b(i,j,k) = 0 if α=β, 1 if α≠β.
// Conjecture 3: exactly 168 triples have b=1 (the arrow of time).

fn cd_sigma(a: i32, b: i32) -> i32 with Mut, Panic, Div {
    // Cayley-Dickson sign function for octonions (bits=3, hardcoded)
    if a == 0 || b == 0 { return 1 }
    let bits: i32 = 3
    let half: i32 = 4
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & 3
    let b_lo = b & 3

    // Recurse to bits=2 (quaternions)
    if a_hi == 0 && b_hi == 0 { return quat_sigma(a_lo, b_lo) }
    if a_hi == 0 && b_hi == 1 { return quat_sigma(b_lo, a_lo) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return quat_sigma(a_lo, b_lo) }
        else { return 0 - quat_sigma(a_lo, b_lo) }
    }
    // both hi
    if b_lo == 0 { return 0 - quat_sigma(b_lo, a_lo) }
    else { return quat_sigma(b_lo, a_lo) }
}

fn quat_sigma(a: i32, b: i32) -> i32 with Mut, Panic, Div {
    // Sign function for quaternions (bits=2)
    if a == 0 || b == 0 { return 1 }
    let half: i32 = 2
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & 1
    let b_lo = b & 1

    // Recurse to bits=1 (complex)
    if a_hi == 0 && b_hi == 0 { return complex_sigma(a_lo, b_lo) }
    if a_hi == 0 && b_hi == 1 { return complex_sigma(b_lo, a_lo) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return complex_sigma(a_lo, b_lo) }
        else { return 0 - complex_sigma(a_lo, b_lo) }
    }
    if b_lo == 0 { return 0 - complex_sigma(b_lo, a_lo) }
    else { return complex_sigma(b_lo, a_lo) }
}

fn complex_sigma(a: i32, b: i32) -> i32 {
    // Sign function for complex numbers (bits=1)
    if a == 0 || b == 0 { return 1 }
    return 0 - 1
}

fn main() -> i32 with Mut, Panic, Div, IO {
    println("=== CONJECTURE 3: THE ARROW OF TIME IN OCTONIONIC QM ===")
    println("")
    println("For each triple (i,j,k) of imaginary octonion units:")
    println("  Forward:  alpha = sigma(i,j) * sigma(i^j, k)")
    println("  Backward: beta  = sigma(j,k) * sigma(i, j^k)")
    println("  Arrow:    b = 0 (time-symmetric) or 1 (arrow exists)")
    println("")

    var associative: i32 = 0
    var nonassociative: i32 = 0

    // Count and classify all 343 triples
    var i: i32 = 1
    while i <= 7 {
        var j: i32 = 1
        while j <= 7 {
            var k: i32 = 1
            while k <= 7 {
                let alpha = cd_sigma(i, j) * cd_sigma(i ^ j, k)
                let beta = cd_sigma(j, k) * cd_sigma(i, j ^ k)

                if alpha == beta {
                    associative = associative + 1
                } else {
                    nonassociative = nonassociative + 1
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    println("=== RESULTS ===")
    println("")
    println("Time-symmetric triples (b=0, Fano-line):")
    println(associative)
    println("")
    println("Arrow-of-time triples (b=1, off-Fano):")
    println(nonassociative)
    println("")

    // Verify
    assert(associative == 175)
    assert(nonassociative == 168)

    println("VERIFIED: 175 time-symmetric + 168 arrow-of-time = 343")
    println("")
    println("The Fano plane partitions octonionic measurements into:")
    println("  175 where past->future = future->past (no arrow)")
    println("  168 where past->future /= future->past (arrow exists)")
    println("")
    println("The arrow of time is not dynamical. It is algebraic.")
    println("It arises from the non-associativity of the octonions.")
    println("168 = |PSL(2,7)| = the symmetry group of the Fano plane.")
    println("")

    // Theorem D verification: e_0 is always time-symmetric
    var e0_nonassoc: i32 = 0
    var idx: i32 = 0
    while idx <= 7 {
        var jj: i32 = 0
        while jj <= 7 {
            let a2 = cd_sigma(0, idx) * cd_sigma(0 ^ idx, jj)
            let b2 = cd_sigma(idx, jj) * cd_sigma(0, idx ^ jj)
            if a2 != b2 { e0_nonassoc = e0_nonassoc + 1 }
            jj = jj + 1
        }
        idx = idx + 1
    }

    println("=== THEOREM D: THE OBSERVER ===")
    println("")
    println("Triples involving e_0 that are non-associative:")
    println(e0_nonassoc)
    assert(e0_nonassoc == 0)
    println("VERIFIED: e_0 never encounters the arrow of time.")
    println("The observer is time-symmetric. The observed is not.")

    0
}
