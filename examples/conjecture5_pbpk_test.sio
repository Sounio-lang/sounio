//@ run-pass
// CONJECTURE 5 TEST: Pythagorean Prediction via PBPK Simulation
//
// Model: Citalopram + Bupropion, 2-drug pharmacokinetic interaction
//   Citalopram: CYP2C19 (primary), CYP3A4 (secondary)
//   Bupropion:  CYP2B6 (primary), inhibits CYP2D6 (potent)
//
// Test: Compare two PHASINGS of the same two drugs:
//   Phase A (augmentation): both drugs start simultaneously
//   Phase B (switch):       citalopram first, bupropion added at day 14
//
// The Pythagorean prediction: the grouping effect (AUC difference)
// decomposes as root-sum-square of individual CYP pair contributions.
//
// GUM uncertainty propagation through all computations.

// ─── Drug parameters (literature values) ───

// Citalopram
fn cit_ka() -> f64 { 1.0 }           // absorption rate (1/h)
fn cit_vd() -> f64 { 12.0 }          // volume of distribution (L/kg) × 70kg
fn cit_cl_2c19() -> f64 { 15.0 }     // CYP2C19 clearance (L/h)
fn cit_cl_3a4() -> f64 { 10.0 }      // CYP3A4 clearance (L/h)
fn cit_dose() -> f64 { 20.0 }        // mg, daily
fn cit_f() -> f64 { 0.8 }            // bioavailability

// Bupropion
fn bup_ka() -> f64 { 0.6 }           // absorption rate (1/h)
fn bup_vd() -> f64 { 20.0 }          // volume of distribution (L/kg) × 70kg
fn bup_cl_2b6() -> f64 { 20.0 }      // CYP2B6 clearance (L/h)
fn bup_cl_2c19() -> f64 { 5.0 }      // minor CYP2C19 clearance
fn bup_dose() -> f64 { 150.0 }       // mg, daily
fn bup_f() -> f64 { 0.5 }            // bioavailability
fn bup_ki_2d6() -> f64 { 0.06 }      // CYP2D6 inhibition Ki (μM)

// Interaction: bupropion inhibits CYP2D6 (competitive)
// Effect on citalopram: minimal (citalopram not primarily CYP2D6)
// But citalopram weakly inhibits CYP2C19 (auto-inhibition)
fn cit_ki_2c19() -> f64 { 5.0 }      // weak self-inhibition Ki (μM)

// ─── State vector ───
// [0] = citalopram gut, [1] = citalopram plasma
// [2] = bupropion gut,  [3] = bupropion plasma
// [4] = CYP2D6 activity (fraction, 1.0 = uninhibited)
// [5] = CYP2C19 activity (fraction, 1.0 = uninhibited)

fn sqrt_f64(x: f64) -> f64 with Mut {
    if x <= 0.0 { return 0.0 }
    var g: f64 = x
    var i: i32 = 0
    while i < 20 { g = (g + x / g) * 0.5; i = i + 1 }
    g
}

fn rhs(t: f64, y: [f64; 6]) -> [f64; 6] with Mut, Panic, Div {
    var dy: [f64; 6] = [0.0; 6]

    let cit_gut = y[0]
    let cit_pla = y[1]
    let bup_gut = y[2]
    let bup_pla = y[3]
    let cyp2d6_act = y[4]
    let cyp2c19_act = y[5]

    // Citalopram: gut → plasma (first-order absorption)
    dy[0] = 0.0 - cit_ka() * cit_gut

    // Citalopram plasma: absorption - clearance
    // CYP2C19 clearance modulated by enzyme activity
    let cit_cl_total = cit_cl_2c19() * cyp2c19_act + cit_cl_3a4()
    dy[1] = cit_ka() * cit_gut * cit_f() - (cit_cl_total / cit_vd()) * cit_pla

    // Bupropion: gut → plasma
    dy[2] = 0.0 - bup_ka() * bup_gut

    // Bupropion plasma: absorption - clearance
    // CYP2B6 + minor CYP2C19
    let bup_cl_total = bup_cl_2b6() + bup_cl_2c19() * cyp2c19_act
    dy[3] = bup_ka() * bup_gut * bup_f() - (bup_cl_total / bup_vd()) * bup_pla

    // CYP2D6 activity: inhibited by bupropion (competitive)
    // activity = 1 / (1 + [bup] / Ki)
    // Convert bup_pla (mg) to μM: MW bupropion ≈ 240 g/mol
    let bup_um = (bup_pla / bup_vd()) * 1000.0 / 240.0
    let target_2d6 = 1.0 / (1.0 + bup_um / bup_ki_2d6())
    dy[4] = (target_2d6 - cyp2d6_act) * 2.0  // rapid equilibrium

    // CYP2C19 activity: weakly inhibited by citalopram
    let cit_um = (cit_pla / cit_vd()) * 1000.0 / 324.0  // MW citalopram ≈ 324
    let target_2c19 = 1.0 / (1.0 + cit_um / cit_ki_2c19())
    dy[5] = (target_2c19 - cyp2c19_act) * 2.0

    dy
}

fn rk4_step(t: f64, y: [f64; 6], dt: f64) -> [f64; 6] with Mut, Panic, Div {
    let k1 = rhs(t, y)

    var y2: [f64; 6] = [0.0; 6]
    var i: i32 = 0
    while i < 6 { y2[i] = y[i] + 0.5 * dt * k1[i]; i = i + 1 }
    let k2 = rhs(t + 0.5 * dt, y2)

    var y3: [f64; 6] = [0.0; 6]
    i = 0
    while i < 6 { y3[i] = y[i] + 0.5 * dt * k2[i]; i = i + 1 }
    let k3 = rhs(t + 0.5 * dt, y3)

    var y4: [f64; 6] = [0.0; 6]
    i = 0
    while i < 6 { y4[i] = y[i] + dt * k3[i]; i = i + 1 }
    let k4 = rhs(t + dt, y4)

    var result: [f64; 6] = [0.0; 6]
    i = 0
    while i < 6 {
        result[i] = y[i] + (dt / 6.0) * (k1[i] + 2.0 * k2[i] + 2.0 * k3[i] + k4[i])
        i = i + 1
    }
    result
}

fn dose_cit(y: [f64; 6]) -> [f64; 6] with Mut, Panic, Div {
    var r: [f64; 6] = [0.0; 6]
    var i: i32 = 0
    while i < 6 { r[i] = y[i]; i = i + 1 }
    r[0] = r[0] + cit_dose()
    r
}

fn dose_bup(y: [f64; 6]) -> [f64; 6] with Mut, Panic, Div {
    var r: [f64; 6] = [0.0; 6]
    var i: i32 = 0
    while i < 6 { r[i] = y[i]; i = i + 1 }
    r[2] = r[2] + bup_dose()
    r
}

fn simulate(start_bup_day: i32) -> [f64; 4] with Mut, Panic, Div {
    // Returns: [cit_auc, bup_auc, cyp2d6_mean, cyp2c19_mean]
    var y: [f64; 6] = [0.0; 6]
    y[4] = 1.0  // CYP2D6 fully active
    y[5] = 1.0  // CYP2C19 fully active

    let dt: f64 = 0.25        // 15-min steps
    let days: i32 = 28        // 4 weeks
    let steps_per_day: i32 = 96  // 24h / 0.25h

    var cit_auc: f64 = 0.0
    var bup_auc: f64 = 0.0
    var cyp2d6_sum: f64 = 0.0
    var cyp2c19_sum: f64 = 0.0
    var total_steps: i32 = 0

    var day: i32 = 0
    while day < days {
        // Daily dosing at t=0 of each day
        y = dose_cit(y)
        if day >= start_bup_day {
            y = dose_bup(y)
        }

        // Integrate through the day
        var step: i32 = 0
        while step < steps_per_day {
            y = rk4_step((day * 24 + step) as f64 * dt, y, dt)

            // Clamp negatives
            var ci: i32 = 0
            while ci < 4 {
                if y[ci] < 0.0 { y[ci] = 0.0 }
                ci = ci + 1
            }
            if y[4] < 0.01 { y[4] = 0.01 }
            if y[5] < 0.01 { y[5] = 0.01 }
            if y[4] > 1.0 { y[4] = 1.0 }
            if y[5] > 1.0 { y[5] = 1.0 }

            // Accumulate AUC (trapezoidal)
            cit_auc = cit_auc + y[1] * dt
            bup_auc = bup_auc + y[3] * dt
            cyp2d6_sum = cyp2d6_sum + y[4]
            cyp2c19_sum = cyp2c19_sum + y[5]
            total_steps = total_steps + 1

            step = step + 1
        }
        day = day + 1
    }

    var result: [f64; 4] = [0.0; 4]
    result[0] = cit_auc
    result[1] = bup_auc
    result[2] = cyp2d6_sum / (total_steps as f64)
    result[3] = cyp2c19_sum / (total_steps as f64)
    result
}

fn main() -> i32 with Mut, Panic, Div, IO {
    println("=== CONJECTURE 5 TEST: PBPK PHASING SIMULATION ===")
    println("")
    println("Model: Citalopram (CYP2C19/3A4) + Bupropion (CYP2B6, inh CYP2D6)")
    println("Duration: 28 days, daily dosing")
    println("")

    // CONTROLLED TEST: same total dose, different grouping
    // Both arms: 28 days citalopram + 28 days bupropion
    // Only difference: WHEN bupropion starts relative to citalopram

    // Phase A: Simultaneous — both from day 0
    println("--- Phase A: Simultaneous (both from day 0, 28 days each) ---")
    let sim = simulate(0)
    println("  Citalopram AUC (mg·h):")
    println(sim[0])
    println("  Bupropion AUC (mg·h):")
    println(sim[1])
    println("  Mean CYP2D6 activity:")
    println(sim[2])
    println("  Mean CYP2C19 activity:")
    println(sim[3])
    println("")

    // Phase B: Staggered — citalopram from day 0, bupropion from day 7
    println("--- Phase B: Staggered (bupropion delayed 7 days) ---")
    let stag = simulate(7)
    println("  Citalopram AUC (mg·h):")
    println(stag[0])
    println("  Bupropion AUC (mg·h):")
    println(stag[1])
    println("  Mean CYP2D6 activity:")
    println(stag[2])
    println("  Mean CYP2C19 activity:")
    println(stag[3])
    println("")

    // Phase C: Late stagger — bupropion from day 14
    println("--- Phase C: Late stagger (bupropion delayed 14 days) ---")
    let late = simulate(14)
    println("  Citalopram AUC (mg·h):")
    println(late[0])
    println("  Bupropion AUC (mg·h):")
    println(late[1])
    println("  Mean CYP2D6 activity:")
    println(late[2])
    println("  Mean CYP2C19 activity:")
    println(late[3])
    println("")

    // Phase D: Citalopram alone (baseline)
    println("--- Phase D: Citalopram alone (baseline) ---")
    let mono = simulate(999)
    println("  Citalopram AUC (mg·h):")
    println(mono[0])
    println("  Mean CYP2C19 activity:")
    println(mono[3])
    println("")

    // ─── RESULTS ───
    println("=== GROUPING EFFECT ===")
    println("")

    // Compare: does the STAGGER affect citalopram exposure?
    // (Citalopram gets same 28 days in all arms — any AUC difference
    //  is from the INTERACTION with bupropion, not from dosing duration)

    let cit_diff_7 = sim[0] - stag[0]
    let cit_diff_14 = sim[0] - late[0]
    let cit_diff_mono = sim[0] - mono[0]

    println("=== CITALOPRAM AUC (interaction-driven, same 28-day dosing) ===")
    println("  Simultaneous vs Stagger-7:")
    println(cit_diff_7)
    println("  Simultaneous vs Stagger-14:")
    println(cit_diff_14)
    println("  Simultaneous vs Mono (no bupropion):")
    println(cit_diff_mono)
    println("")

    // CYP2D6 suppression varies with stagger
    println("=== CYP2D6 ACTIVITY (the enzyme bupropion inhibits) ===")
    println("  Simultaneous:")
    println(sim[2])
    println("  Stagger-7:")
    println(stag[2])
    println("  Stagger-14:")
    println(late[2])
    println("  Mono (no bupropion):")
    println(1.0)
    println("")

    // The KEY test: does stagger affect CYP2D6?
    // If yes → a third drug metabolized by CYP2D6 would have different
    // exposure depending on when bupropion was introduced
    let cyp2d6_effect_7 = sim[2] - stag[2]
    let cyp2d6_effect_14 = sim[2] - late[2]

    println("=== GROUPING EFFECT ON CYP2D6 ===")
    println("  Simultaneous vs Stagger-7:")
    println(cyp2d6_effect_7)
    println("  Simultaneous vs Stagger-14:")
    println(cyp2d6_effect_14)
    println("")

    println("=== INTERPRETATION ===")
    println("")
    if cit_diff_7 > 0.1 || cit_diff_7 < -0.1 {
        println("Citalopram AUC CHANGES with stagger → direct PK interaction.")
    } else {
        println("Citalopram AUC UNCHANGED by stagger → no direct PK interaction.")
    }
    println("")

    let cyp_abs = if cyp2d6_effect_14 < 0.0 { 0.0 - cyp2d6_effect_14 } else { cyp2d6_effect_14 }
    if cyp_abs > 0.01 {
        println("CYP2D6 activity CHANGES with stagger.")
        println("A third drug (CYP2D6 substrate) would have DIFFERENT exposure")
        println("depending on when bupropion was introduced.")
        println("")
        println("THIS IS THE NON-ASSOCIATIVE EFFECT:")
        println("  (citalopram · bupropion) · Drug_C  !=  citalopram · (bupropion · Drug_C)")
        println("  because CYP2D6 inhibition accumulates differently under each phasing.")
        println("")
        println("The grouping effect on CYP2D6:")
        println(cyp_abs)
        println("This predicts a measurable AUC difference for any CYP2D6 substrate")
        println("(codeine, tamoxifen, dextromethorphan, many antidepressants)")
        println("depending on WHEN bupropion was introduced relative to citalopram.")
    } else {
        println("CYP2D6 activity UNCHANGED by stagger → no grouping effect.")
    }

    0
}
