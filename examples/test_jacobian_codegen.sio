// Test that jacobian and hessian codegen works
// This verifies the builtins compile and are recognized

// Simple 1D test function for Hessian: f(x) = x^2
// Hessian should be [[2]] (constant)
fn simple_scalar(input_ptr: i64) -> i64 {
    // Just return input_ptr as placeholder - real impl would compute
    input_ptr
}

// Simple test function for Jacobian: f(x) = x
// Jacobian should be identity matrix
fn simple_vec(input_ptr: i64) -> i64 {
    // Just return input_ptr as placeholder
    input_ptr
}

fn main() {
    println("=== Jacobian/Hessian Codegen Test ===")

    // Create a dummy input - just using 0 as placeholder ptr
    let dummy_ptr: i64 = 0
    let n: i64 = 2
    let m: i64 = 2

    // Test that jacobian call compiles
    println("Calling jacobian(f, x, 2, 2)...")
    let J = jacobian(simple_vec, dummy_ptr, n, m)
    println("jacobian returned: ")
    println(J)

    // Test that hessian call compiles
    println("Calling hessian(f, x, 2)...")
    let H = hessian(simple_scalar, dummy_ptr, n)
    println("hessian returned: ")
    println(H)

    println("")
    println("Codegen test passed - builtins are callable")
}
