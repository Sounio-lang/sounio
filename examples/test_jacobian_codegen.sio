// Test that jacobian and hessian codegen works
// This verifies the builtins compile and are recognized
// The new API reads array length automatically from the array header

// Simple 1D test function for Hessian: f(x) = x^2
// Hessian should be [[2]] (constant)
fn simple_scalar(input_ptr: i64) -> i64 {
    // Just return input_ptr as placeholder - real impl would compute
    input_ptr
}

// Simple test function for Jacobian: f(x) = x
// Jacobian should be identity matrix
fn simple_vec(input_ptr: i64) -> i64 {
    // Just return input_ptr as placeholder
    input_ptr
}

fn main() {
    println("=== Jacobian/Hessian Codegen Test ===")
    println("Testing new API with automatic array length detection")

    // Create an actual array - length will be read from header
    let x = [1.0, 2.0, 3.0]
    let x_ptr = x as i64
    let m: i64 = 2

    // Test that jacobian call compiles with new API: jacobian(f, x, m)
    // n is read automatically from x array header
    println("Calling jacobian(f, x, m) where m=2...")
    let J = jacobian(simple_vec, x_ptr, m)
    println("jacobian returned: ")
    println(J)

    // Test that hessian call compiles with new API: hessian(f, x)
    // n is read automatically from x array header
    println("Calling hessian(f, x)...")
    let H = hessian(simple_scalar, x_ptr)
    println("hessian returned: ")
    println(H)

    println("")
    println("Codegen test passed - builtins are callable with new API")
}
