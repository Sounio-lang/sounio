//! Bit Set Demonstration
//!
//! Shows efficient bit operations for tracking sets of integers.
//! Use case: tracking visited nodes during graph traversal.

extern "C" {
    fn printf(fmt: *const u8, ...) -> i32;
    fn malloc(size: usize) -> *mut u8;
    fn free(ptr: *mut u8);
}

// BitSet structure and helper functions
struct BitSet {
    bits: *mut u64,
    len: usize,
    num_words: usize
}

fn bitset_new(len: usize) -> BitSet with Alloc {
    let num_words = (len + 63) / 64
    let size_bytes = num_words * 8
    let ptr = malloc(size_bytes) as *mut u64

    var i: usize = 0
    while i < num_words {
        ptr[i] = 0
        i = i + 1
    }

    let result = BitSet {
        bits: ptr,
        len: len,
        num_words: num_words,
    }
    return result
}

fn bitset_set(bs: &!BitSet, index: usize) with Panic {
    if index >= bs.len {
        panic("BitSet index out of bounds")
    }
    let word = index / 64
    let bit = index % 64
    bs.bits[word] = bs.bits[word] | (1u64 << bit)
}

fn bitset_clear(bs: &!BitSet, index: usize) with Panic {
    if index >= bs.len {
        panic("BitSet index out of bounds")
    }
    let word = index / 64
    let bit = index % 64
    bs.bits[word] = bs.bits[word] & !(1u64 << bit)
}

fn bitset_get(bs: &BitSet, index: usize) -> bool with Panic {
    if index >= bs.len {
        panic("BitSet index out of bounds")
    }
    let word = index / 64
    let bit = index % 64
    return (bs.bits[word] & (1u64 << bit)) != 0
}

fn popcount64(x: u64) -> usize {
    var n = x
    n = n - ((n >> 1) & 0x5555555555555555)
    n = (n & 0x3333333333333333) + ((n >> 2) & 0x3333333333333333)
    n = (n + (n >> 4)) & 0x0F0F0F0F0F0F0F0F
    n = (n * 0x0101010101010101) >> 56
    return n as usize
}

fn bitset_count_ones(bs: &BitSet) -> usize {
    var count: usize = 0
    var i: usize = 0
    while i < bs.num_words {
        count = count + popcount64(bs.bits[i])
        i = i + 1
    }
    return count
}

fn bitset_union_with(bs: &!BitSet, other: &BitSet) with Panic {
    if bs.len != other.len {
        panic("BitSet union requires same length")
    }
    var i: usize = 0
    while i < bs.num_words {
        bs.bits[i] = bs.bits[i] | other.bits[i]
        i = i + 1
    }
}

fn bitset_intersect_with(bs: &!BitSet, other: &BitSet) with Panic {
    if bs.len != other.len {
        panic("BitSet intersection requires same length")
    }
    var i: usize = 0
    while i < bs.num_words {
        bs.bits[i] = bs.bits[i] & other.bits[i]
        i = i + 1
    }
}

fn bitset_drop(bs: &!BitSet) with Alloc {
    if bs.bits != null_mut() {
        free(bs.bits as *mut u8)
        bs.bits = null_mut()
    }
}

fn main() -> i32 with Alloc, Panic {
    printf("Bit Set Demonstration\n".as_ptr())
    printf("=====================\n\n".as_ptr())

    // Create a bitset for tracking visited graph nodes (0-99)
    printf("Creating BitSet for 100 nodes\n".as_ptr())
    var visited = bitset_new(100)

    // Simulate graph traversal: mark nodes as visited
    printf("\nSimulating graph traversal...\n".as_ptr())
    printf("Visiting nodes: 0, 5, 12, 17, 23, 42, 67, 89\n".as_ptr())

    bitset_set(&!visited, 0)
    bitset_set(&!visited, 5)
    bitset_set(&!visited, 12)
    bitset_set(&!visited, 17)
    bitset_set(&!visited, 23)
    bitset_set(&!visited, 42)
    bitset_set(&!visited, 67)
    bitset_set(&!visited, 89)

    printf("\nTotal visited nodes: %zu\n".as_ptr(), bitset_count_ones(&visited))

    // Check if specific nodes were visited
    printf("\nChecking node status:\n".as_ptr())
    let check_nodes = [0, 1, 42, 50, 89, 99]
    var i: usize = 0
    while i < 6 {
        let node = check_nodes[i]
        let status = if bitset_get(&visited, node) { "visited" } else { "not visited" }
        printf("  Node %zu: %s\n".as_ptr(), node, status.as_ptr())
        i = i + 1
    }

    // Demonstrate set operations
    printf("\nDemonstrating set operations:\n".as_ptr())

    var set_a = bitset_new(64)
    var set_b = bitset_new(64)

    // Set A: {0, 2, 4, 6, 8}
    bitset_set(&!set_a, 0)
    bitset_set(&!set_a, 2)
    bitset_set(&!set_a, 4)
    bitset_set(&!set_a, 6)
    bitset_set(&!set_a, 8)

    // Set B: {2, 3, 6, 7, 8}
    bitset_set(&!set_b, 2)
    bitset_set(&!set_b, 3)
    bitset_set(&!set_b, 6)
    bitset_set(&!set_b, 7)
    bitset_set(&!set_b, 8)

    printf("  Set A elements: {0, 2, 4, 6, 8}\n".as_ptr())
    printf("  Set B elements: {2, 3, 6, 7, 8}\n".as_ptr())

    // Union
    var set_union = bitset_new(64)
    bitset_union_with(&!set_union, &set_a)
    bitset_union_with(&!set_union, &set_b)
    printf("  A ∪ B: %zu elements\n".as_ptr(), bitset_count_ones(&set_union))

    // Intersection
    var set_intersection = bitset_new(64)
    bitset_union_with(&!set_intersection, &set_a)
    bitset_intersect_with(&!set_intersection, &set_b)
    printf("  A ∩ B: %zu elements\n".as_ptr(), bitset_count_ones(&set_intersection))

    // Clean up
    bitset_drop(&!visited)
    bitset_drop(&!set_a)
    bitset_drop(&!set_b)
    bitset_drop(&!set_union)
    bitset_drop(&!set_intersection)

    printf("\nBitSet operations completed successfully!\n".as_ptr())
    return 0
}
