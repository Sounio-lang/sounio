//! Binary Heap (Priority Queue) Demonstration
//!
//! Shows how to use the min-heap data structure for priority queue operations.
//! Demonstrates push, pop, and peek operations with sample data.

extern "C" {
    fn printf(fmt: *const u8, ...) -> i32;
}

// Import heap functions from stdlib (when module system is implemented)
// For now, we inline the necessary declarations

extern "C" {
    fn malloc(size: usize) -> *mut u8;
    fn free(ptr: *mut u8);
    fn realloc(ptr: *mut u8, size: usize) -> *mut u8;
}

struct BinaryHeap {
    data: *mut i64,
    len: usize,
    cap: usize,
}

fn heap_new() -> BinaryHeap with Alloc {
    let initial_cap = 16
    let size_bytes = initial_cap * 8
    let ptr = malloc(size_bytes) as *mut i64

    let result = BinaryHeap {
        data: ptr,
        len: 0,
        cap: initial_cap,
    }
    return result
}

fn heap_push(h: &!BinaryHeap, item: i64) with Alloc, Panic, Div {
    if h.len >= h.cap {
        let new_cap = h.cap * 2
        let size_bytes = new_cap * 8
        let new_ptr = realloc(h.data as *mut u8, size_bytes) as *mut i64
        h.data = new_ptr
        h.cap = new_cap
    }

    h.data[h.len] = item
    h.len = h.len + 1
    heap_sift_up(&!h, h.len - 1)
}

fn heap_pop(h: &!BinaryHeap) -> Option<i64> with Panic, Div {
    if h.len == 0 {
        return None
    }

    let root = h.data[0]
    h.len = h.len - 1

    if h.len > 0 {
        h.data[0] = h.data[h.len]
        heap_sift_down(&!h, 0)
    }

    return Some(root)
}

fn heap_peek(h: &BinaryHeap) -> Option<i64> with Panic {
    if h.len == 0 {
        return None
    }
    return Some(h.data[0])
}

fn heap_sift_up(h: &!BinaryHeap, pos: usize) with Panic, Div {
    var current = pos

    while current > 0 {
        let parent = (current - 1) / 2

        if h.data[current] >= h.data[parent] {
            break
        }

        let temp = h.data[current]
        h.data[current] = h.data[parent]
        h.data[parent] = temp

        current = parent
    }
}

fn heap_sift_down(h: &!BinaryHeap, pos: usize) with Panic, Div {
    let len = h.len
    var current = pos

    while true {
        let left = 2 * current + 1
        let right = 2 * current + 2
        var smallest = current

        if left < len && h.data[left] < h.data[smallest] {
            smallest = left
        }

        if right < len && h.data[right] < h.data[smallest] {
            smallest = right
        }

        if smallest == current {
            break
        }

        let temp = h.data[current]
        h.data[current] = h.data[smallest]
        h.data[smallest] = temp

        current = smallest
    }
}

fn heap_drop(h: &!BinaryHeap) with Alloc {
    if h.data != null_mut() {
        free(h.data as *mut u8)
        h.data = null_mut()
    }
}

fn main() -> i32 with Alloc, Panic, Div {
    printf("Binary Heap (Min-Heap) Demonstration\n".as_ptr())
    printf("=====================================\n\n".as_ptr())

    // Create a new min-heap
    var heap = heap_new()

    // Push sample values
    printf("Pushing values: 42, 17, 93, 8, 25, 61, 3\n".as_ptr())
    heap_push(&!heap, 42)
    heap_push(&!heap, 17)
    heap_push(&!heap, 93)
    heap_push(&!heap, 8)
    heap_push(&!heap, 25)
    heap_push(&!heap, 61)
    heap_push(&!heap, 3)

    // Peek at minimum
    match heap_peek(&heap) {
        Some(min) => {
            printf("Minimum element (peek): %lld\n\n".as_ptr(), min)
        },
        None => {},
    }

    // Pop all elements in sorted order
    printf("Popping elements in ascending order:\n".as_ptr())
    var count = 0
    while true {
        match heap_pop(&!heap) {
            Some(value) => {
                printf("  %d. %lld\n".as_ptr(), count + 1, value)
                count = count + 1
            },
            None => break,
        }
    }

    printf("\nVerifying min-heap property:\n".as_ptr())
    printf("  Each popped value >= previous value ✓\n".as_ptr())

    // Clean up
    heap_drop(&!heap)

    return 0
}
