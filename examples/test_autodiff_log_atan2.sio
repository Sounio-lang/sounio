// Test autodiff with log2, log10, atan2
// log2(x): d/dx = 1/(x * ln(2))
// log10(x): d/dx = 1/(x * ln(10))
// atan2(y, x): d/dy = x/(x² + y²), d/dx = -y/(x² + y²)

// --- Autodiff preamble ---
fn exp_f64(x: f64) -> f64 {
    if x > 20.0 { return exp_f64(x / 2.0) * exp_f64(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / exp_f64(0.0 - x) }
    var sum = 1.0; var term = 1.0
    term = term * x / 1.0; sum = sum + term; term = term * x / 2.0; sum = sum + term
    term = term * x / 3.0; sum = sum + term; term = term * x / 4.0; sum = sum + term
    term = term * x / 5.0; sum = sum + term; term = term * x / 6.0; sum = sum + term
    term = term * x / 7.0; sum = sum + term; term = term * x / 8.0; sum = sum + term
    term = term * x / 9.0; sum = sum + term; term = term * x / 10.0; sum = sum + term
    return sum
}
fn ln_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 - 1000000.0 }
    var val = x; var k = 0.0; let e = 2.718281828459045
    while val > e { val = val / e; k = k + 1.0 }
    while val < 1.0 / e { val = val * e; k = k - 1.0 }
    let u = (val - 1.0) / (val + 1.0); let u2 = u * u
    var sum = u; var term = u
    term = term * u2; sum = sum + term / 3.0; term = term * u2; sum = sum + term / 5.0
    term = term * u2; sum = sum + term / 7.0; term = term * u2; sum = sum + term / 9.0
    term = term * u2; sum = sum + term / 11.0
    return 2.0 * sum + k
}
fn atan_f64(x: f64) -> f64 {
    let pi = 3.141592653589793
    if x < 0.0 { return 0.0 - atan_f64(0.0 - x) }
    if x > 2.0 { return pi / 2.0 - atan_f64(1.0 / x) }
    if x > 0.5 {
        let y = (x - 1.0) / (x + 1.0)
        let y2 = y * y; var sum = y; var term = y
        term = term * (0.0 - y2); sum = sum + term / 3.0
        term = term * (0.0 - y2); sum = sum + term / 5.0
        term = term * (0.0 - y2); sum = sum + term / 7.0
        term = term * (0.0 - y2); sum = sum + term / 9.0
        term = term * (0.0 - y2); sum = sum + term / 11.0
        term = term * (0.0 - y2); sum = sum + term / 13.0
        return pi / 4.0 + sum
    }
    let x2 = x * x; var sum = x; var term = x
    term = term * (0.0 - x2); sum = sum + term / 3.0
    term = term * (0.0 - x2); sum = sum + term / 5.0
    term = term * (0.0 - x2); sum = sum + term / 7.0
    term = term * (0.0 - x2); sum = sum + term / 9.0
    term = term * (0.0 - x2); sum = sum + term / 11.0
    term = term * (0.0 - x2); sum = sum + term / 13.0
    term = term * (0.0 - x2); sum = sum + term / 15.0
    return sum
}
fn atan2_f64(y: f64, x: f64) -> f64 {
    let pi = 3.141592653589793
    if x > 0.0 { return atan_f64(y / x) }
    if x < 0.0 && y >= 0.0 { return atan_f64(y / x) + pi }
    if x < 0.0 && y < 0.0 { return atan_f64(y / x) - pi }
    if x == 0.0 && y > 0.0 { return pi / 2.0 }
    if x == 0.0 && y < 0.0 { return 0.0 - pi / 2.0 }
    return 0.0
}
struct Dual { val: f64, dot: f64 }
fn dual(val: f64, dot: f64) -> Dual { return Dual { val: val, dot: dot } }
fn dual_value(d: Dual) -> f64 { return d.val }
fn dual_deriv(d: Dual) -> f64 { return d.dot }
fn dual_log2(a: Dual) -> Dual {
    let ln2 = 0.6931471805599453
    return Dual { val: ln_f64(a.val) / ln2, dot: a.dot / (a.val * ln2) }
}
fn dual_log10(a: Dual) -> Dual {
    let ln10 = 2.302585092994046
    return Dual { val: ln_f64(a.val) / ln10, dot: a.dot / (a.val * ln10) }
}
fn dual_atan2(y: Dual, x: Dual) -> Dual {
    let r2 = x.val * x.val + y.val * y.val
    let dot = (x.val * y.dot - y.val * x.dot) / r2
    return Dual { val: atan2_f64(y.val, x.val), dot: dot }
}
// --- End preamble ---

fn main() {
    println("=== Autodiff: log2(x) at x=8 ===")

    let x: f64 = 8.0
    let x_dual = dual(x, 1.0)

    let result = dual_log2(x_dual)

    let value = dual_value(result)
    let derivative = dual_deriv(result)

    // log2(8) = 3
    // d/dx log2(x) at x=8 = 1/(8 * ln(2)) ~ 0.1803

    println("f(x) = log2(x) at x=8:")
    println("  Value f(8) = ")
    println(value)
    println("  Derivative f'(8) = ")
    println(derivative)

    println("Expected: value = 3, derivative ~ 0.1803")

    println("")
    println("=== Autodiff: log10(x) at x=100 ===")

    let y: f64 = 100.0
    let y_dual = dual(y, 1.0)

    let result2 = dual_log10(y_dual)

    let value2 = dual_value(result2)
    let derivative2 = dual_deriv(result2)

    // log10(100) = 2
    // d/dx log10(x) at x=100 = 1/(100 * ln(10)) ~ 0.00434

    println("g(x) = log10(x) at x=100:")
    println("  Value g(100) = ")
    println(value2)
    println("  Derivative g'(100) = ")
    println(derivative2)

    println("Expected: value = 2, derivative ~ 0.00434")

    println("")
    println("=== Autodiff: atan2(y, x) at y=1, x=1 ===")

    // For atan2, we track derivative w.r.t. y (with x constant)
    let a: f64 = 1.0
    let b: f64 = 1.0
    let a_dual = dual(a, 1.0)  // dy/dt = 1
    let b_dual = dual(b, 0.0)  // dx/dt = 0

    let result3 = dual_atan2(a_dual, b_dual)

    let value3 = dual_value(result3)
    let derivative3 = dual_deriv(result3)

    // atan2(1, 1) = pi/4 ~ 0.7854
    // With dy=1, dx=0: d/dt = x/(x² + y²) = 1/(1+1) = 0.5

    println("h(t) = atan2(y(t), x) where y(t)=t, x=1, at t=1:")
    println("  Value h(1) = ")
    println(value3)
    println("  Derivative h'(1) = ")
    println(derivative3)

    println("Expected: value ~ 0.7854, derivative = 0.5")

    println("")
    println("=== Autodiff: atan2(y, x) at y=1, x=1, varying x ===")

    // Track derivative w.r.t. x (with y constant)
    let c: f64 = 1.0
    let d: f64 = 1.0
    let c_dual = dual(c, 0.0)  // dy/dt = 0
    let d_dual = dual(d, 1.0)  // dx/dt = 1

    let result4 = dual_atan2(c_dual, d_dual)

    let value4 = dual_value(result4)
    let derivative4 = dual_deriv(result4)

    // With dy=0, dx=1: d/dt = -y/(x² + y²) = -1/(1+1) = -0.5

    println("i(t) = atan2(y, x(t)) where y=1, x(t)=t, at t=1:")
    println("  Value i(1) = ")
    println(value4)
    println("  Derivative i'(1) = ")
    println(derivative4)

    println("Expected: value ~ 0.7854, derivative = -0.5")
}
