//@ run-pass
//! examples/g2_octonion_derivations.sio
//!
//! G₂ / V₂(ℝ⁷) structure of Cayley–Dickson zero divisors — the finite,
//! computable skeleton, verified from the verified `cd_sigma` table.
//!
//! The established theorem (Moreno 1998 Cor. 2.14; Reggiani 2024) is that the
//! normalised sedenion zero divisors form the manifold ZD(𝕊) ≅ V₂(ℝ⁷) =
//! G₂/SU(2), the total space of the bundle  S³ → G₂ → V₂(ℝ⁷).  A homeomorphism
//! of continuous manifolds is NOT something finite computation can verify.
//! What this program verifies are the finite invariants / necessary conditions
//! of that structure, computed from first principles:
//!
//!   COMPUTED here (exact, integer matrices over cd_sigma ∈ {-1,0,1}):
//!     (1) dim Der(𝕆) = 14 = dim G₂        [g₂ = Der(𝕆), Cartan]
//!     (2) Der(𝕆) ⊂ so(7)  (every derivation kills 1 and is skew on Im 𝕆)
//!     (3) 𝕆 is a division algebra: ker L_x = 0  (no zero divisors)
//!     (4) the sedenion zero divisor e₃+e₁₀ has ker L = 4  (the S³ fiber)
//!     (5) g₂ ↪ Der(𝕊):  every D ∈ Der(𝕆) lifts to diag(D,D) ∈ Der(𝕊)
//!         — i.e. the octonions' G₂ = Aut(𝕆) acts on the sedenions, hence on
//!           ZD(𝕊).  (This is the anchor: it ties dim 14 to the ZD structure.)
//!
//!   CITED + arithmetic (NOT verified here):
//!     dim V₂(ℝ⁷) = 11,  ZD(𝕊) ≅ V₂(ℝ⁷)  (Reggiani 2024), and the bundle
//!     dimension identity  dim G₂ = dim V₂(ℝ⁷) + dim S³ = 11 + 3 = 14.
//!
//! NOT claimed: the manifold homeomorphism/isometry; that L_A is a quantum
//! channel; any physics role for sedenions (established physics is octonion-
//! only).  The annihilator ker L_A is the S³ FIBER's underlying space — it is
//! NOT the quaternion subalgebra H_a (a separate summand in Moreno's
//! decomposition A_n = H_a ⊕ Ker T̃_a ⊕ Ker L_a ⊕ ⊕V_λ).

use algebra::cayley_dickson::{cd_sigma}

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

// Gauss rank (partial pivoting) on the first `nrows` × `ncols` of a flat
// row-major buffer.  Entries are small integers, so float elimination
// computes the exact rank (cross-checked against an exact ℤ-rank in Lean).
fn rank_buf(m: &![f64; 294912], nrows: i64, ncols: i64, tol: f64) -> i64 with Mut, Div, Panic {
    var rank: i64 = 0
    var row: i64 = 0
    var col: i64 = 0
    while col < ncols && row < nrows {
        var pivot_row: i64 = 0 - 1
        var best: f64 = tol
        var r: i64 = row
        while r < nrows {
            let av = abs_f64((*m)[(ncols * r + col) as usize])
            if av > best { best = av; pivot_row = r }
            r = r + 1
        }
        if pivot_row < 0 {
            col = col + 1
        } else {
            if pivot_row != row {
                var j: i64 = 0
                while j < ncols {
                    let a = (*m)[(ncols * row + j) as usize]
                    let b = (*m)[(ncols * pivot_row + j) as usize]
                    (*m)[(ncols * row + j) as usize] = b
                    (*m)[(ncols * pivot_row + j) as usize] = a
                    j = j + 1
                }
            }
            let piv = (*m)[(ncols * row + col) as usize]
            var rr: i64 = row + 1
            while rr < nrows {
                let factor = (*m)[(ncols * rr + col) as usize] / piv
                var j: i64 = col
                while j < ncols {
                    let nv = (*m)[(ncols * rr + j) as usize]
                              - factor * (*m)[(ncols * row + j) as usize]
                    (*m)[(ncols * rr + j) as usize] = nv
                    j = j + 1
                }
                rr = rr + 1
            }
            rank = rank + 1
            row = row + 1
            col = col + 1
        }
    }
    rank
}

// Add value v into row `r`, column `c` of the 64-wide buffer (accumulates).
fn acc(m: &![f64; 294912], r: i64, c: i64, v: f64) with Mut, Panic {
    let idx = (64 * r + c) as usize
    (*m)[idx] = (*m)[idx] + v
}

// Accumulate at an explicit flat index (for matrices whose stride is not 64).
fn acc_idx(m: &![f64; 294912], idx: i64, v: f64) with Mut, Panic {
    (*m)[idx as usize] = (*m)[idx as usize] + v
}

// Map a sedenion-matrix slot Dtilde[p][q] (p,q in 0..15) to a column of the
// 64 unknowns D[a][b] (col 8a+b) under Dtilde = diag(D,D); -1 if cross-block.
fn diag_col(p: i64, q: i64) -> i64 {
    if p < 8 && q < 8 { 8 * p + q }
    else { if p >= 8 && q >= 8 { 8 * (p - 8) + (q - 8) } else { 0 - 1 } }
}

// ---- left-multiplication kernel dim for A = e_a + e_b at level `bits` ----
fn leftmul_ker(a: i64, b: i64, bits: i64, n: i64) -> i64 with Mut, Div, Panic {
    var M: [f64; 294912] = [0.0; 294912]
    var k: i64 = 0
    while k < n {
        // column k = L_A(e_k): rows (a^k) += sigma(a,k), (b^k) += sigma(b,k).
        // Write with stride n (rank_buf reads ncols=n), NOT the 64-stride acc.
        acc_idx(&!M, (a ^^^ k) * n + k, cd_sigma(a as i32, k as i32, bits as i32) as f64)
        acc_idx(&!M, (b ^^^ k) * n + k, cd_sigma(b as i32, k as i32, bits as i32) as f64)
        k = k + 1
    }
    n - rank_buf(&!M, n, n, 1.0e-9)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("================================================================")
    println("  G₂ / V₂(ℝ⁷) skeleton of Cayley–Dickson zero divisors")
    println("================================================================")
    println("")

    // (1) dim Der(𝕆): octonion Leibniz system over 64 unknowns D[a][b].
    //     row (i,j,m):  σ(i,j)·D[m, i^j] − σ(m^j,j)·D[m^j, i] − σ(i,i^m)·D[i^m, j] = 0
    var Mo: [f64; 294912] = [0.0; 294912]
    var ro: i64 = 0
    var i: i64 = 0
    while i < 8 {
        var j: i64 = 0
        while j < 8 {
            var m: i64 = 0
            while m < 8 {
                acc(&!Mo, ro, 8 * m + (i ^^^ j), cd_sigma(i as i32, j as i32, 3) as f64)
                acc(&!Mo, ro, 8 * (m ^^^ j) + i, 0.0 - (cd_sigma((m ^^^ j) as i32, j as i32, 3) as f64))
                acc(&!Mo, ro, 8 * (i ^^^ m) + j, 0.0 - (cd_sigma(i as i32, (i ^^^ m) as i32, 3) as f64))
                ro = ro + 1
                m = m + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    let dim_der_O = 64 - rank_buf(&!Mo, ro, 64, 1.0e-9)
    print("  (1) dim Der(𝕆) = "); print(dim_der_O); println("   (expect 14 = dim G₂)")
    if dim_der_O != 14 { println("  FAIL"); return 1 }

    // (2) Der(𝕆) ⊂ so(7): rebuild octonion rows + skew/identity rows, nullity must stay 14.
    var Ms: [f64; 294912] = [0.0; 294912]
    var rs: i64 = 0
    i = 0
    while i < 8 {
        var j: i64 = 0
        while j < 8 {
            var m: i64 = 0
            while m < 8 {
                acc(&!Ms, rs, 8 * m + (i ^^^ j), cd_sigma(i as i32, j as i32, 3) as f64)
                acc(&!Ms, rs, 8 * (m ^^^ j) + i, 0.0 - (cd_sigma((m ^^^ j) as i32, j as i32, 3) as f64))
                acc(&!Ms, rs, 8 * (i ^^^ m) + j, 0.0 - (cd_sigma(i as i32, (i ^^^ m) as i32, 3) as f64))
                rs = rs + 1
                m = m + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    // D(1)=0 : D[a,0]=0
    var a: i64 = 0
    while a < 8 { acc(&!Ms, rs, 8 * a + 0, 1.0); rs = rs + 1; a = a + 1 }
    // skew on Im : D[a,b] + D[b,a] = 0 for 1<=a<b<=7
    a = 1
    while a < 8 {
        var b: i64 = a + 1
        while b < 8 {
            acc(&!Ms, rs, 8 * a + b, 1.0)
            acc(&!Ms, rs, 8 * b + a, 1.0)
            rs = rs + 1
            b = b + 1
        }
        a = a + 1
    }
    let dim_so7 = 64 - rank_buf(&!Ms, rs, 64, 1.0e-9)
    print("  (2) dim (Der(𝕆) ∩ skew∩{D1=0}) = "); print(dim_so7)
    println("   (expect 14 ⇒ Der(𝕆) ⊂ so(7), so the 14-dim algebra is g₂)")
    if dim_so7 != 14 { println("  FAIL"); return 1 }

    // (3) 𝕆 is a division algebra: no zero divisors.
    let ko = leftmul_ker(1, 2, 3, 8)
    print("  (3) ker L_(e₁+e₂) in 𝕆 = "); print(ko); println("   (expect 0 — division algebra)")
    if ko != 0 { println("  FAIL"); return 1 }

    // (4) sedenion zero divisor e₃+e₁₀: the S³ fiber (4-dim annihilator).
    let ks = leftmul_ker(3, 10, 4, 16)
    print("  (4) ker L_(e₃+e₁₀) in 𝕊 = "); print(ks); println("   (expect 4 = dim S³ + 1, the SU(2) fiber)")
    if ks != 4 { println("  FAIL"); return 1 }

    // (5) ANCHOR — g₂ ↪ Der(𝕊): octonion Leibniz rows ++ pulled-back sedenion
    //     Leibniz rows under D ↦ diag(D,D).  If nullity stays 14, every
    //     octonion derivation lifts to a sedenion derivation.
    var Ml: [f64; 294912] = [0.0; 294912]
    var rl: i64 = 0
    i = 0
    while i < 8 {
        var j: i64 = 0
        while j < 8 {
            var m: i64 = 0
            while m < 8 {
                acc(&!Ml, rl, 8 * m + (i ^^^ j), cd_sigma(i as i32, j as i32, 3) as f64)
                acc(&!Ml, rl, 8 * (m ^^^ j) + i, 0.0 - (cd_sigma((m ^^^ j) as i32, j as i32, 3) as f64))
                acc(&!Ml, rl, 8 * (i ^^^ m) + j, 0.0 - (cd_sigma(i as i32, (i ^^^ m) as i32, 3) as f64))
                rl = rl + 1
                m = m + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    // pulled-back sedenion rows (i,j,m in 0..15), slots mapped through diag(D,D)
    i = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            var m: i64 = 0
            while m < 16 {
                let c1 = diag_col(m, i ^^^ j)
                if c1 >= 0 { acc(&!Ml, rl, c1, cd_sigma(i as i32, j as i32, 4) as f64) }
                let c2 = diag_col(m ^^^ j, i)
                if c2 >= 0 { acc(&!Ml, rl, c2, 0.0 - (cd_sigma((m ^^^ j) as i32, j as i32, 4) as f64)) }
                let c3 = diag_col(i ^^^ m, j)
                if c3 >= 0 { acc(&!Ml, rl, c3, 0.0 - (cd_sigma(i as i32, (i ^^^ m) as i32, 4) as f64)) }
                rl = rl + 1
                m = m + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    let dim_lift = 64 - rank_buf(&!Ml, rl, 64, 1.0e-9)
    print("  (5) dim {D ∈ Der(𝕆) : diag(D,D) ∈ Der(𝕊)} = "); print(dim_lift)
    println("   (expect 14 = dim Der(𝕆) ⇒ g₂ ↪ Der(𝕊): Aut(𝕆)=G₂ acts on ZD(𝕊))")
    if dim_lift != 14 { println("  FAIL"); return 1 }

    println("")
    println("================================================================")
    println("  Verified (computed from cd_sigma):")
    println("    dim G₂ = dim Der(𝕆) = 14,  Der(𝕆) ⊂ so(7)")
    println("    𝕆 division algebra (ker L = 0); 𝕊 ZD fiber ker L = 4 (S³)")
    println("    g₂ ↪ Der(𝕊): the octonion G₂ = Aut(𝕆) acts on the sedenion ZDs")
    println("  Cited + arithmetic (NOT verified here):")
    println("    ZD(𝕊) ≅ V₂(ℝ⁷) = G₂/SU(2)  (Moreno 1998; Reggiani 2024)")
    println("    bundle dims:  dim G₂ = dim V₂(ℝ⁷) + dim S³ = 11 + 3 = 14")
    println("  NOT claimed: the manifold homeomorphism; any physics role.")
    println("================================================================")
    0
}
