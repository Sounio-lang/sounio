//@ run-pass
//!
//! First Sounio semantic-authority witness for the pinned NVIDIA PTX `prmt`
//! section. Structural counts and expected results are produced from the full
//! hashed HTML stream; no parity language or disposable script supplies them.

use hardware::pireus::ptx_import::{
    pireus_ptx_import_chunks,
    pireus_ptx_expected_sha256,
    pireus_ptx_negative_duplicate_section,
    pireus_ptx_negative_unknown_shape,
    pireus_ptx_negative_malformed_html,
    pireus_ptx_negative_capacity,
    pireus_ptx_negative_empty_digest,
    pireus_ptx_inventory_store,
    pireus_ptx_query_objects_by,
    PIREUS_PTX_OK,
    PIREUS_PTX_HAS_CORPUS,
    PIREUS_PTX_CORPUS_CUDA_13_2_PTX_9_2,
    PIREUS_PTX_CLASS_RAW_MODE,
}
use hardware::pireus::model::{PIREUS_RDF_TYPE}
use ontology::query::{triple_store_count, sparql_result_count}

fn ptx_bool_i64(value: bool) -> i64 { if value { 1 } else { 0 } }

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 1 {
        print("usage: pireus_ptx_prmt_import <chunk-prefix>\n")
        return 2
    }
    let prefix = get_arg(0)
    let inv = pireus_ptx_import_chunks(prefix)
    var failures: i64 = 0
    if inv.error != PIREUS_PTX_OK { failures = failures + 1 }
    if !inv.digest_match { failures = failures + 1 }
    if inv.selected_sections != 1 { failures = failures + 1 }
    if inv.mode_f4e + inv.mode_b4e + inv.mode_rc8 + inv.mode_ecl +
        inv.mode_ecr + inv.mode_rc16 != 6 {
        failures = failures + 1
    }
    if inv.syntax_lines <= 0 || inv.semantics_lines <= 0 ||
        inv.example_lines <= 0 {
        failures = failures + 1
    }

    var store = pireus_ptx_inventory_store(&inv)
    let triples = triple_store_count(&store)
    let q_forms = pireus_ptx_query_objects_by(
        &store, PIREUS_PTX_HAS_CORPUS,
        PIREUS_PTX_CORPUS_CUDA_13_2_PTX_9_2)
    let q_modes = pireus_ptx_query_objects_by(
        &store, PIREUS_RDF_TYPE, PIREUS_PTX_CLASS_RAW_MODE)
    let form_count = sparql_result_count(&q_forms)
    let mode_count = sparql_result_count(&q_modes)
    if form_count != 1 || mode_count != 6 { failures = failures + 1 }

    let negative_duplicate = pireus_ptx_negative_duplicate_section()
    let negative_shape = pireus_ptx_negative_unknown_shape()
    let negative_html = pireus_ptx_negative_malformed_html()
    let negative_capacity = pireus_ptx_negative_capacity()
    let negative_digest = pireus_ptx_negative_empty_digest()
    if !negative_duplicate || !negative_shape || !negative_html ||
        !negative_capacity || !negative_digest {
        failures = failures + 1
    }

    print("SOUNIO_AUTHORITY schema=pireus-ptx-prmt.v0 role=SEMANTIC_AUTHORITY\n")
    print("PIREUS_PTX_CORPUS release=CUDA-13.2.0 ptx_isa=9.2 bytes=")
    print_int(inv.total_bytes)
    print(" chunks="); print_int(inv.chunk_count)
    print(" error="); print_int(inv.error)
    print(" sha256="); print(pireus_ptx_expected_sha256())
    print(" digest_match="); print_int(ptx_bool_i64(inv.digest_match)); print("\n")
    print("PIREUS_PTX_SECTION id=data-movement-and-conversion-instructions-prmt selected=")
    print_int(inv.selected_sections)
    print(" headings="); print_int(inv.headings)
    print(" paragraphs="); print_int(inv.paragraphs)
    print(" rubrics="); print_int(inv.rubrics); print("\n")
    print("PIREUS_PTX_BLOCKS pre="); print_int(inv.pre_blocks)
    print(" syntax_lines="); print_int(inv.syntax_lines)
    print(" semantics_lines="); print_int(inv.semantics_lines)
    print(" example_lines="); print_int(inv.example_lines); print("\n")
    print("PIREUS_PTX_TABLES tables="); print_int(inv.tables)
    print(" rows="); print_int(inv.table_rows)
    print(" code_tokens="); print_int(inv.code_tokens); print("\n")
    print("PIREUS_PTX_MODES f4e="); print_int(inv.mode_f4e)
    print(" b4e="); print_int(inv.mode_b4e)
    print(" rc8="); print_int(inv.mode_rc8)
    print(" ecl="); print_int(inv.mode_ecl)
    print(" ecr="); print_int(inv.mode_ecr)
    print(" rc16="); print_int(inv.mode_rc16); print("\n")
    print("PIREUS_PTX_NOTES introduced_ptx_2_0=")
    print_int(inv.introduced_ptx_2_0)
    print(" target_sm_20_or_higher=")
    print_int(inv.target_sm_20_or_higher); print("\n")
    print("PIREUS_PTX_ONTOLOGY triples="); print_int(triples)
    print(" forms="); print_int(form_count)
    print(" raw_modes="); print_int(mode_count); print("\n")
    print("PIREUS_PTX_NEGATIVE duplicate_section=")
    print_int(ptx_bool_i64(negative_duplicate))
    print(" selected_shape="); print_int(ptx_bool_i64(negative_shape))
    print(" malformed_html="); print_int(ptx_bool_i64(negative_html))
    print(" capacity="); print_int(ptx_bool_i64(negative_capacity))
    print(" digest="); print_int(ptx_bool_i64(negative_digest)); print("\n")
    print("PIREUS_PTX_BOUNDARY sass_links=0 material_capabilities=0 lowering_claims=0 semantic_role_assignments=0\n")
    print("PIREUS_PTX_SUMMARY failures="); print_int(failures); print("\n")

    if failures == 0 { 0 } else { 1 }
}
