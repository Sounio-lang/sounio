fn pk_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn pk_sqrt(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var g = x * 0.5
    if x < 1.0 { g = 1.0 }
    var i: i64 = 0
    while i < 60 { g = 0.5 * (g + x / g)
        i = i + 1 }
    g
}
fn pk_exp_pos(x: f64) -> f64 with Mut, Panic, Div {
    var sum = 1.0
    var term = 1.0
    var d = 1.0
    var n: i64 = 0
    while n < 25 { d = d + 1.0
        term = term * x / d
        sum = sum + term
        n = n + 1 }
    sum
}
fn pk_conc(t: f64, ka: f64, ke: f64, dose: f64, vd: f64) -> f64 with Mut, Panic, Div {
    let diff = ka - ke
    if pk_abs(diff) < 0.0001 { return 0.0 }
    let factor = dose * ka / (vd * diff)
    let ek = 1.0 / pk_exp_pos(ke * t)
    let ea = 1.0 / pk_exp_pos(ka * t)
    factor * (ek - ea)
}
fn pk_fit(dose: f64, vd: f64) -> i64 with Mut, Panic, Div {
    var ka = 0.6
    var ke = 0.25
    var iter: i64 = 0
    while iter < 30 {
        if pk_abs(ka - ke) < 0.001 { ke = ke + 0.01 }
        let h = 0.0001
        let c1 = pk_conc(1.0, ka, ke, dose, vd)
        let c2 = pk_conc(4.0, ka, ke, dose, vd)
        let c3 = pk_conc(12.0, ka, ke, dose, vd)
        let j1a = (pk_conc(1.0, ka + h, ke, dose, vd) - c1) / h
        let j1e = (pk_conc(1.0, ka, ke + h, dose, vd) - c1) / h
        let j2a = (pk_conc(4.0, ka + h, ke, dose, vd) - c2) / h
        let j2e = (pk_conc(4.0, ka, ke + h, dose, vd) - c2) / h
        let r1 = c1 - 3.360
        let r2 = c2 - 4.971
        let aa = j1a * j1a + j2a * j2a
        let ab = j1a * j1e + j2a * j2e
        let bb = j1e * j1e + j2e * j2e
        let ga = j1a * r1 + j2a * r2
        let gb = j1e * r1 + j2e * r2
        let det = aa * bb - ab * ab
        if pk_abs(det) < 0.0000000001 { break }
        let dka = 0.0 - (bb * ga - ab * gb) / det
        let dke = 0.0 - (aa * gb - ab * ga) / det
        ka = ka + dka * 0.3
        ke = ke + dke * 0.3
        if ka < 0.01 { ka = 0.01 }
        if ke < 0.01 { ke = 0.01 }
        iter = iter + 1
    }
    var result: i64 = 0
    if pk_abs(ka - 0.5) / 0.5 < 0.2 { result = result + 32 }
    if pk_abs(ke - 0.2) / 0.2 < 0.2 { result = result + 16 }
    if ka > 0.3 { result = result + 8 }
    if ke > 0.1 { result = result + 4 }
    if ka < 0.8 { result = result + 2 }
    result = result + 1
    result
}
fn main() -> i64 with Mut, Panic, Div { pk_fit(100.0, 10.0) }
