// Native Epistemic PK: Full 6-Observation Gauss-Newton
// Pure Sounio. No libc. No imports. Static ELF.
// Split into helper functions for lean emitter compatibility.

fn pk_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn pk_sqrt(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var g = x * 0.5
    if x < 1.0 { g = 1.0 }
    var i: i64 = 0
    while i < 60 { g = 0.5 * (g + x / g)
        i = i + 1 }
    g
}

fn pk_exp_pos(x: f64) -> f64 with Mut, Panic, Div {
    var sum = 1.0
    var term = 1.0
    var d = 0.0
    var n: i64 = 0
    while n < 25 { d = d + 1.0
        term = term * x / d
        sum = sum + term
        n = n + 1 }
    sum
}

fn pk_conc(t: f64, ka: f64, ke: f64, dose: f64, vd: f64) -> f64 with Mut, Panic, Div {
    let diff = ka - ke
    if pk_abs(diff) < 0.0001 { return 0.0 }
    let factor = dose * ka / (vd * diff)
    let ek = 1.0 / pk_exp_pos(ke * t)
    let ea = 1.0 / pk_exp_pos(ka * t)
    factor * (ek - ea)
}

fn jac_ka(t: f64, ka: f64, ke: f64, d: f64, v: f64) -> f64 with Mut, Panic, Div {
    let h = 0.0001
    (pk_conc(t, ka + h, ke, d, v) - pk_conc(t, ka, ke, d, v)) / h
}

fn jac_ke(t: f64, ka: f64, ke: f64, d: f64, v: f64) -> f64 with Mut, Panic, Div {
    let h = 0.0001
    (pk_conc(t, ka, ke + h, d, v) - pk_conc(t, ka, ke, d, v)) / h
}

fn fisher_aa(ka: f64, ke: f64, d: f64, v: f64) -> f64 with Mut, Panic, Div {
    let j0 = jac_ka(0.5, ka, ke, d, v)
    let j1 = jac_ka(1.0, ka, ke, d, v)
    let j2 = jac_ka(2.0, ka, ke, d, v)
    let j3 = jac_ka(4.0, ka, ke, d, v)
    let j4 = jac_ka(8.0, ka, ke, d, v)
    let j5 = jac_ka(12.0, ka, ke, d, v)
    j0 * j0 + j1 * j1 + j2 * j2 + j3 * j3 + j4 * j4 + j5 * j5
}

fn fisher_ab(ka: f64, ke: f64, d: f64, v: f64) -> f64 with Mut, Panic, Div {
    let a0 = jac_ka(0.5, ka, ke, d, v)
    let b0 = jac_ke(0.5, ka, ke, d, v)
    let a1 = jac_ka(1.0, ka, ke, d, v)
    let b1 = jac_ke(1.0, ka, ke, d, v)
    let a2 = jac_ka(2.0, ka, ke, d, v)
    let b2 = jac_ke(2.0, ka, ke, d, v)
    let a3 = jac_ka(4.0, ka, ke, d, v)
    let b3 = jac_ke(4.0, ka, ke, d, v)
    let a4 = jac_ka(8.0, ka, ke, d, v)
    let b4 = jac_ke(8.0, ka, ke, d, v)
    let a5 = jac_ka(12.0, ka, ke, d, v)
    let b5 = jac_ke(12.0, ka, ke, d, v)
    a0 * b0 + a1 * b1 + a2 * b2 + a3 * b3 + a4 * b4 + a5 * b5
}

fn fisher_bb(ka: f64, ke: f64, d: f64, v: f64) -> f64 with Mut, Panic, Div {
    let j0 = jac_ke(0.5, ka, ke, d, v)
    let j1 = jac_ke(1.0, ka, ke, d, v)
    let j2 = jac_ke(2.0, ka, ke, d, v)
    let j3 = jac_ke(4.0, ka, ke, d, v)
    let j4 = jac_ke(8.0, ka, ke, d, v)
    let j5 = jac_ke(12.0, ka, ke, d, v)
    j0 * j0 + j1 * j1 + j2 * j2 + j3 * j3 + j4 * j4 + j5 * j5
}

fn grad_ka(ka: f64, ke: f64, d: f64, v: f64) -> f64 with Mut, Panic, Div {
    jac_ka(0.5, ka, ke, d, v) * (pk_conc(0.5, ka, ke, d, v) - 2.206)
    + jac_ka(1.0, ka, ke, d, v) * (pk_conc(1.0, ka, ke, d, v) - 3.360)
    + jac_ka(2.0, ka, ke, d, v) * (pk_conc(2.0, ka, ke, d, v) - 5.293)
    + jac_ka(4.0, ka, ke, d, v) * (pk_conc(4.0, ka, ke, d, v) - 4.971)
    + jac_ka(8.0, ka, ke, d, v) * (pk_conc(8.0, ka, ke, d, v) - 3.213)
    + jac_ka(12.0, ka, ke, d, v) * (pk_conc(12.0, ka, ke, d, v) - 1.392)
}

fn grad_ke(ka: f64, ke: f64, d: f64, v: f64) -> f64 with Mut, Panic, Div {
    jac_ke(0.5, ka, ke, d, v) * (pk_conc(0.5, ka, ke, d, v) - 2.206)
    + jac_ke(1.0, ka, ke, d, v) * (pk_conc(1.0, ka, ke, d, v) - 3.360)
    + jac_ke(2.0, ka, ke, d, v) * (pk_conc(2.0, ka, ke, d, v) - 5.293)
    + jac_ke(4.0, ka, ke, d, v) * (pk_conc(4.0, ka, ke, d, v) - 4.971)
    + jac_ke(8.0, ka, ke, d, v) * (pk_conc(8.0, ka, ke, d, v) - 3.213)
    + jac_ke(12.0, ka, ke, d, v) * (pk_conc(12.0, ka, ke, d, v) - 1.392)
}

fn pk_fit(dose: f64, vd: f64) -> i64 with Mut, Panic, Div {
    var ka = 0.6
    var ke = 0.25
    var converged: i64 = 0
    var iter: i64 = 0
    while iter < 40 {
        if pk_abs(ka - ke) < 0.001 { ke = ke + 0.01 }
        let a11 = fisher_aa(ka, ke, dose, vd)
        let a12 = fisher_ab(ka, ke, dose, vd)
        let a22 = fisher_bb(ka, ke, dose, vd)
        let g1 = grad_ka(ka, ke, dose, vd)
        let g2 = grad_ke(ka, ke, dose, vd)
        let det = a11 * a22 - a12 * a12
        if pk_abs(det) < 0.0000000001 { break }
        var dka = 0.0 - (a22 * g1 - a12 * g2) / det
        var dke = 0.0 - (a11 * g2 - a12 * g1) / det
        let delta = pk_sqrt(dka * dka + dke * dke)
        if delta > 0.3 { dka = dka * 0.3 / delta
            dke = dke * 0.3 / delta }
        ka = ka + dka
        ke = ke + dke
        if ka < 0.01 { ka = 0.01 }
        if ke < 0.01 { ke = 0.01 }
        if delta < 0.000001 { converged = 1
            break }
        iter = iter + 1
    }
    var result: i64 = 0
    if pk_abs(ka - 0.5) / 0.5 < 0.15 { result = result + 32 }
    if pk_abs(ke - 0.2) / 0.2 < 0.15 { result = result + 16 }
    if ka > 0.3 { result = result + 8 }
    if ke > 0.1 { result = result + 4 }
    if ka < 0.8 { result = result + 2 }
    result = result + converged
    result
}

fn main() -> i64 with Mut, Panic, Div { pk_fit(100.0, 10.0) }
