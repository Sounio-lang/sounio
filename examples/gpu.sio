// Public GPU-profile example for the checked artifact.
//
// Verified commands:
//   souc-linux-x86_64-gpu check examples/gpu.sio
//   souc-linux-x86_64-gpu build examples/gpu.sio --backend gpu -o /tmp/sounio-gpu.ptx
//
// The current checked GPU artifact accepts:
// - `kernel fn`
// - `with GPU`
// - `perform GPU.launch(...)`
// - `perform GPU.sync()`
//
// The `gpu.*` intrinsic namespace shown in older docs is not yet part of the
// checked public surface, so this example sticks to the verified launch path.

kernel fn vector_add(n: i64) with GPU {
}

kernel fn scale_vector(factor: f64, n: i64) with GPU, Div {
}

fn main() with GPU, IO {
    let n: i64 = 1024
    let grid = (16, 1, 1)
    let block = (64, 1, 1)

    perform GPU.launch(vector_add, grid, block)(n)
    perform GPU.launch(scale_vector, grid, block)(2.0, n)
    perform GPU.sync()
}
