    if i ==  6 { return 3 }
    if i ==  7 { return 3 }
    if i ==  8 { return 3 }
    if i ==  9 { return 4 }
    if i == 10 { return 4 }
    if i == 11 { return 4 }
    if i == 12 { return 5 }
    if i == 13 { return 5 }
    if i == 14 { return 6 }
    if i == 15 { return 3 }
    if i == 16 { return 3 }
    if i == 17 { return 3 }
    if i == 18 { return 3 }
    if i == 19 { return 4 }
    if i == 20 { return 4 }
    if i == 21 { return 4 }
    if i == 22 { return 5 }
    if i == 23 { return 5 }
    if i == 24 { return 6 }
    if i == 25 { return 4 }
    if i == 26 { return 4 }
    if i == 27 { return 4 }
    if i == 28 { return 5 }
    if i == 29 { return 5 }
    if i == 30 { return 6 }
    if i == 31 { return 5 }
    if i == 32 { return 5 }
    if i == 33 { return 6 }
    if i == 34 { return 6 }
