    if i ==  0 { return 3 }
    if i ==  1 { return 4 }
    if i ==  2 { return 5 }
    if i ==  3 { return 6 }
    if i ==  4 { return 7 }
    if i ==  5 { return 4 }
    if i ==  6 { return 5 }
    if i ==  7 { return 6 }
    if i ==  8 { return 7 }
    if i ==  9 { return 5 }
    if i == 10 { return 6 }
    if i == 11 { return 7 }
    if i == 12 { return 6 }
    if i == 13 { return 7 }
    if i == 14 { return 7 }
    if i == 15 { return 4 }
    if i == 16 { return 5 }
    if i == 17 { return 6 }
    if i == 18 { return 7 }
    if i == 19 { return 5 }
    if i == 20 { return 6 }
    if i == 21 { return 7 }
    if i == 22 { return 6 }
    if i == 23 { return 7 }
