    if i ==  0 { return 0 }
    if i ==  1 { return 1 }
    if i ==  2 { return 1 }
    if i ==  3 { return 0 }
    if i ==  4 { return 0 }
    if i ==  5 { return 0 }
    if i ==  6 { return 0 }
    if i ==  7 { return 0 }
    if i ==  8 { return 0 }
