// Test typed literal suffixes

fn main() -> i32 {
    // Integer typed literals
    let a = 42i32
    let b = 0u8
    let c = 255u8
    let d = 1_000i64
    let e = 100_000_000i128

    // Unsigned types
    let f = 65535u16
    let g = 4_294_967_295u32

    // Float typed literals
    let h = 1.0f32
    let i = 3.14159f64
    let j = 2.5_f32

    // Integer with float suffix
    let k = 0f32
    let l = 100f64

    // Verify type inference still works for untyped literals
    let m: i32 = 5
    let n: f64 = 2.5

    // Mixed in expressions
    let result = a + (m * 2)

    result
}
