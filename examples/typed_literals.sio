// Typed constants via type annotations (literal suffixes like 42i32 are not supported by Madaros)

fn main() -> i32 {
    // Integer typed literals
    let a: i32 = 42
    let b: u8 = 0
    let c: u8 = 255
    let d: i64 = 1_000
    let e: i128 = 100_000_000

    // Unsigned types
    let f: u16 = 65535
    let g: u32 = 4_294_967_295

    // Float typed literals
    let h: f32 = 1.0
    let i: f64 = 3.14159
    let j: f32 = 2.5

    // Whole-number values typed as floats
    let k: f32 = 0.0
    let l: f64 = 100.0

    // Verify type inference still works for untyped literals
    let m: i32 = 5
    let n: f64 = 2.5

    // Mixed in expressions
    let result = a + (m * 2)

    result
}
