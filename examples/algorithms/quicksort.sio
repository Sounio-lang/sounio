//@ run-pass
//! Quicksort: in-place sort of 10,000 integers
//!
//! Demonstrates: real algorithms, mutable struct refs, LCG pseudo-random data,
//! verification pass, O(n log n) on 10K elements.
//!
//! Run: $SOUC run examples/algorithms/quicksort.sio

struct SortBuf {
    data: [i64; 10000],
}

fn swap(arr: &! SortBuf, i: i64, j: i64) with Mut {
    let tmp = arr.data[i]
    arr.data[i] = arr.data[j]
    arr.data[j] = tmp
}

// Lomuto partition — median-of-three pivot for better performance
fn median3(arr: &! SortBuf, lo: i64, hi: i64) -> i64 with Mut {
    let mid = lo + (hi - lo) / 2
    // Sort lo, mid, hi and use mid as pivot
    if arr.data[lo] > arr.data[mid] { swap(arr, lo, mid) }
    if arr.data[lo] > arr.data[hi]  { swap(arr, lo, hi)  }
    if arr.data[mid] > arr.data[hi] { swap(arr, mid, hi) }
    mid
}

fn partition(arr: &! SortBuf, lo: i64, hi: i64) -> i64 with Mut {
    let pivot_idx = median3(arr, lo, hi)
    let pivot = arr.data[pivot_idx]
    // Move pivot to end
    swap(arr, pivot_idx, hi)
    var i = lo - 1
    var j = lo
    while j < hi {
        if arr.data[j] <= pivot {
            i = i + 1
            swap(arr, i, j)
        }
        j = j + 1
    }
    swap(arr, i + 1, hi)
    i + 1
}

fn qsort(arr: &! SortBuf, lo: i64, hi: i64) with Mut {
    if lo < hi {
        let p = partition(arr, lo, hi)
        qsort(arr, lo, p - 1)
        qsort(arr, p + 1, hi)
    }
}

fn abs64(x: i64) -> i64 {
    if x < 0 { 0 - x } else { x }
}

fn main() -> i32 with IO, Mut {
    var buf = SortBuf { data: [0; 10000] }
    let n: i64 = 10000

    // Fill with LCG pseudo-random values (Knuth multiplicative)
    var seed: i64 = 6364136223846793005
    var i: i64 = 0
    while i < n {
        seed = seed * 6364136223846793005 + 1442695040888963407
        buf.data[i] = seed
        i = i + 1
    }

    let first_before = buf.data[0]

    qsort(&! buf, 0, n - 1)

    // Verify sorted
    var sorted = true
    i = 1
    while i < n {
        if buf.data[i] < buf.data[i - 1] { sorted = false }
        i = i + 1
    }

    if sorted {
        print("Quicksort (10,000 integers): PASS\n")
        print("  min = ")
        println(buf.data[0])
        print("  max = ")
        println(buf.data[n - 1])
        print("  unsorted[0] was: ")
        println(first_before)
        0
    } else {
        print("FAIL: sort verification failed\n")
        1
    }
}
