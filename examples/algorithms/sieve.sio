//@ run-pass
//! Sieve of Eratosthenes: find all primes up to 100,000
//!
//! Demonstrates: O(n log log n) algorithm, large arrays, nested loops,
//! counting and searching.
//!
//! Run: $SOUC run examples/algorithms/sieve.sio

struct SieveBuf {
    is_prime: [i32; 100001],
}

fn main() -> i32 with IO, Mut {
    var s = SieveBuf { is_prime: [1; 100001] }
    let limit: i64 = 100000

    // 0 and 1 are not prime
    s.is_prime[0] = 0
    s.is_prime[1] = 0

    // Sieve: mark composites
    var i: i64 = 2
    while i * i <= limit {
        if s.is_prime[i] == 1 {
            var j = i * i
            while j <= limit {
                s.is_prime[j] = 0
                j = j + i
            }
        }
        i = i + 1
    }

    // Count primes and find largest
    var count: i64 = 0
    var largest: i64 = 0
    i = 2
    while i <= limit {
        if s.is_prime[i] == 1 {
            count = count + 1
            largest = i
        }
        i = i + 1
    }

    // Print first 10 primes
    print("First 10 primes: ")
    var printed: i64 = 0
    i = 2
    while i <= limit && printed < 10 {
        if s.is_prime[i] == 1 {
            if printed > 0 { print(", ") }
            print_int(i)
            printed = printed + 1
        }
        i = i + 1
    }
    print("\n")

    print("Primes up to 100,000: ")
    println(count)
    print("Largest prime: ")
    println(largest)

    // Verify known count (9592 primes up to 100000)
    if count == 9592 {
        print("Count verified: PASS\n")
        0
    } else {
        print("Count mismatch: FAIL\n")
        1
    }
}
