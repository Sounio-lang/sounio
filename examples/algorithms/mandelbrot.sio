//@ run-pass
//! Mandelbrot Set: ASCII render at 80×40 resolution
//!
//! Demonstrates: f64 arithmetic, nested loops, complex iteration,
//! character output — zero external dependencies.
//!
//! Outputs a text-art rendering of the Mandelbrot set.
//!
//! Run: $SOUC run examples/algorithms/mandelbrot.sio

const WIDTH: i64 = 78
const HEIGHT: i64 = 36
const MAX_ITER: i64 = 64

// Compute Mandelbrot escape count for point (cx, cy)
fn mandelbrot(cx: f64, cy: f64) -> i64 {
    var zx: f64 = 0.0
    var zy: f64 = 0.0
    var iter: i64 = 0
    while iter < MAX_ITER {
        let zx2 = zx * zx
        let zy2 = zy * zy
        if zx2 + zy2 > 4.0 {
            return iter
        }
        let new_zx = zx2 - zy2 + cx
        zy = 2.0 * zx * zy + cy
        zx = new_zx
        iter = iter + 1
    }
    MAX_ITER
}

// Map escape count to ASCII character
fn iter_to_char(n: i64) -> i64 {
    if n == MAX_ITER { return 64 }   // '@' = 64
    if n > 48 { return 35 }          // '#' = 35
    if n > 32 { return 43 }          // '+' = 43
    if n > 16 { return 46 }          // '.' = 46
    if n > 8  { return 58 }          // ':' = 58
    32                                // ' ' = 32
}

fn print_char(c: i64) with IO {
    if c == 64 { print("@") }
    else if c == 35 { print("#") }
    else if c == 43 { print("+") }
    else if c == 46 { print(".") }
    else if c == 58 { print(":") }
    else { print(" ") }
}

fn main() -> i32 with IO {
    print("Mandelbrot Set (")
    print_int(WIDTH)
    print("x")
    print_int(HEIGHT)
    print(", max_iter=")
    print_int(MAX_ITER)
    print(")\n")
    print("Region: x in [-2.5, 1.0], y in [-1.2, 1.2]\n\n")

    let x_min: f64 = -2.5
    let x_max: f64 =  1.0
    let y_min: f64 = -1.2
    let y_max: f64 =  1.2

    var row: i64 = 0
    while row < HEIGHT {
        let cy = y_max - (y_max - y_min) * (row as f64) / (HEIGHT as f64)
        var col: i64 = 0
        while col < WIDTH {
            let cx = x_min + (x_max - x_min) * (col as f64) / (WIDTH as f64)
            let n = mandelbrot(cx, cy)
            print_char(iter_to_char(n))
            col = col + 1
        }
        print("\n")
        row = row + 1
    }

    // Count pixels in the set (escape == MAX_ITER)
    var in_set: i64 = 0
    row = 0
    while row < HEIGHT {
        let cy = y_max - (y_max - y_min) * (row as f64) / (HEIGHT as f64)
        var col: i64 = 0
        while col < WIDTH {
            let cx = x_min + (x_max - x_min) * (col as f64) / (WIDTH as f64)
            if mandelbrot(cx, cy) == MAX_ITER { in_set = in_set + 1 }
            col = col + 1
        }
        row = row + 1
    }

    print("\nPixels in Mandelbrot set: ")
    println(in_set)
    print("Total pixels: ")
    println(WIDTH * HEIGHT)

    0
}
