// COMPLEX DEMO: Quicksort + Sieve + GCD + Fibonacci + Collatz
// Tests: recursion, 8 functions, 2 global arrays, all operators

var DATA: [i64; 10000]
var PRIMES: [i64; 1300]

fn swap(i: i64, j: i64) with Mut, Panic {
    var tmp = DATA[i]
    DATA[i] = DATA[j]
    DATA[j] = tmp
}

fn partition(lo: i64, hi: i64) -> i64 with Mut, Panic {
    var pivot = DATA[hi]
    var i = lo - 1
    var j = lo
    while j < hi {
        if DATA[j] <= pivot {
            i = i + 1
            swap(i, j)
        }
        j = j + 1
    }
    swap(i + 1, hi)
    return i + 1
}

fn qsort(lo: i64, hi: i64) with Mut, Panic {
    if lo < hi {
        var p = partition(lo, hi)
        qsort(lo, p - 1)
        qsort(p + 1, hi)
    }
}

fn gcd(a: i64, b: i64) -> i64 with Div {
    if b == 0 { return a }
    return gcd(b, a % b)
}

fn fib(n: i64) -> i64 {
    if n <= 1 { return n }
    return fib(n - 1) + fib(n - 2)
}

fn collatz_steps(n: i64) -> i64 with Mut, Panic, Div {
    var steps = 0
    var x = n
    while x != 1 {
        if (x % 2) == 0 {
            x = x / 2
        } else {
            x = x * 3 + 1
        }
        steps = steps + 1
    }
    return steps
}

fn sieve_primes(limit: i64) -> i64 with Mut, Panic {
    // Use DATA as sieve (0=composite, 1=prime) up to limit
    var i = 2
    while i <= limit {
        DATA[i] = 1
        i = i + 1
    }
    i = 2
    while (i * i) <= limit {
        if DATA[i] == 1 {
            var j = i * i
            while j <= limit {
                DATA[j] = 0
                j = j + i
            }
        }
        i = i + 1
    }
    // Collect primes into PRIMES array
    var count = 0
    i = 2
    while i <= limit {
        if DATA[i] == 1 {
            PRIMES[count] = i
            count = count + 1
        }
        i = i + 1
    }
    return count
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var pass = 0
    var total = 0

    // TEST 1: Fibonacci
    print("=== TEST 1: Fibonacci ===\n")
    var f20 = fib(20)
    print("fib(20) = ")
    print_int(f20)
    print("\n")
    total = total + 1
    if f20 == 6765 { pass = pass + 1; print("PASS\n") } else { print("FAIL\n") }

    // TEST 2: GCD
    print("\n=== TEST 2: GCD ===\n")
    var g1 = gcd(48, 18)
    var g2 = gcd(1071, 462)
    print("gcd(48,18) = ")
    print_int(g1)
    print("\ngcd(1071,462) = ")
    print_int(g2)
    print("\n")
    total = total + 1
    if g1 == 6 { pass = pass + 1; print("PASS\n") } else { print("FAIL\n") }
    total = total + 1
    if g2 == 21 { pass = pass + 1; print("PASS\n") } else { print("FAIL\n") }

    // TEST 3: Collatz
    print("\n=== TEST 3: Collatz ===\n")
    var c27 = collatz_steps(27)
    var c1000 = collatz_steps(1000)
    print("collatz(27) = ")
    print_int(c27)
    print(" steps\ncollatz(1000) = ")
    print_int(c1000)
    print(" steps\n")
    total = total + 1
    if c27 == 111 { pass = pass + 1; print("PASS\n") } else { print("FAIL\n") }
    total = total + 1
    if c1000 == 111 { pass = pass + 1; print("PASS\n") } else { print("FAIL\n") }

    // TEST 4: Sieve of Eratosthenes (primes up to 10000)
    print("\n=== TEST 4: Sieve (primes to 10000) ===\n")
    var nprimes = sieve_primes(9999)
    print("Primes found: ")
    print_int(nprimes)
    print("\nFirst 5: ")
    print_int(PRIMES[0])
    print(", ")
    print_int(PRIMES[1])
    print(", ")
    print_int(PRIMES[2])
    print(", ")
    print_int(PRIMES[3])
    print(", ")
    print_int(PRIMES[4])
    print("\nLast: ")
    print_int(PRIMES[nprimes - 1])
    print("\n")
    total = total + 1
    if nprimes == 1229 { pass = pass + 1; print("PASS\n") } else { print("FAIL\n") }

    // TEST 5: Quicksort 10000
    print("\n=== TEST 5: Quicksort 10,000 ===\n")
    var seed = 42
    var i = 0
    while i < 10000 {
        seed = ((seed * 1103515245) + 12345)
        DATA[i] = seed
        i = i + 1
    }
    qsort(0, 9999)
    var sorted = 1
    i = 1
    while i < 10000 {
        if DATA[i] < DATA[i - 1] { sorted = 0 }
        i = i + 1
    }
    total = total + 1
    if sorted == 1 {
        print("Quicksort 10,000: PASS\n")
        pass = pass + 1
    } else {
        print("Quicksort 10,000: FAIL\n")
    }

    // SUMMARY
    print("\n=============================\n")
    print_int(pass)
    print(" / ")
    print_int(total)
    print(" tests passed\n")
    if pass == total { print("ALL PASS\n") } else { print("SOME FAILED\n") }
    return 0
}
