// Test autodiff: compute derivative of x^2
// f(x) = x^2, f'(x) = 2x
// At x = 3: f(3) = 9, f'(3) = 6

fn main() {
    println("=== Autodiff: derivative of x^2 at x=3 ===")

    let x: f64 = 3.0

    // Create dual number: x with derivative 1 (seed for df/dx)
    let x_dual = dual(x, 1.0)

    // Compute x^2 = x * x using product rule
    // (x, 1) * (x, 1) = (x*x, 1*x + x*1) = (x^2, 2x)
    let x_squared = dual_mul(x_dual, x_dual)

    // Get the result
    let value = dual_value(x_squared)
    let derivative = dual_deriv(x_squared)

    println("f(x) = x^2 at x=3:")
    println("  Value f(3) = ")
    println(value)
    println("  Derivative f'(3) = ")
    println(derivative)

    println("Expected: value=9, derivative=6")
}
