    POST_TGT[70] = -3.18323065
    POST_TGT[71] = -3.37181891
    POST_TGT[72] = -3.80042861
    POST_TGT[73] = -4.31476025
    POST_TGT[74] = -4.43477096
    POST_TGT[75] = -4.55478168
