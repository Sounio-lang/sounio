// Test autodiff with sqrt and pow
// f(x) = sqrt(x) => f'(x) = 1/(2*sqrt(x))
// At x = 4: f(4) = 2, f'(4) = 1/4 = 0.25

// g(x) = x^3 => g'(x) = 3*x^2
// At x = 2: g(2) = 8, g'(2) = 12

// --- Autodiff preamble ---
fn exp_f64(x: f64) -> f64 {
    if x > 20.0 { return exp_f64(x / 2.0) * exp_f64(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / exp_f64(0.0 - x) }
    var sum = 1.0; var term = 1.0
    term = term * x / 1.0; sum = sum + term; term = term * x / 2.0; sum = sum + term
    term = term * x / 3.0; sum = sum + term; term = term * x / 4.0; sum = sum + term
    term = term * x / 5.0; sum = sum + term; term = term * x / 6.0; sum = sum + term
    term = term * x / 7.0; sum = sum + term; term = term * x / 8.0; sum = sum + term
    term = term * x / 9.0; sum = sum + term; term = term * x / 10.0; sum = sum + term
    return sum
}
fn ln_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 - 1000000.0 }
    var val = x; var k = 0.0; let e = 2.718281828459045
    while val > e { val = val / e; k = k + 1.0 }
    while val < 1.0 / e { val = val * e; k = k - 1.0 }
    let u = (val - 1.0) / (val + 1.0); let u2 = u * u
    var sum = u; var term = u
    term = term * u2; sum = sum + term / 3.0; term = term * u2; sum = sum + term / 5.0
    term = term * u2; sum = sum + term / 7.0; term = term * u2; sum = sum + term / 9.0
    return 2.0 * sum + k
}
fn pow_f64(x: f64, n: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    return exp_f64(n * ln_f64(x))
}
fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y); y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y); y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y); y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y); y = 0.5 * (y + x / y)
    return y
}
struct Dual { val: f64, dot: f64 }
fn dual(val: f64, dot: f64) -> Dual { return Dual { val: val, dot: dot } }
fn dual_value(d: Dual) -> f64 { return d.val }
fn dual_deriv(d: Dual) -> f64 { return d.dot }
fn dual_mul(a: Dual, b: Dual) -> Dual {
    return Dual { val: a.val * b.val, dot: a.dot * b.val + a.val * b.dot }
}
fn dual_sqrt(a: Dual) -> Dual {
    let v = sqrt_f64(a.val)
    return Dual { val: v, dot: a.dot / (2.0 * v) }
}
fn dual_pow(a: Dual, n: f64) -> Dual {
    let v = pow_f64(a.val, n)
    return Dual { val: v, dot: a.dot * n * pow_f64(a.val, n - 1.0) }
}
// --- End preamble ---

fn main() {
    println("=== Autodiff: sqrt(x) at x=4 ===")

    let x: f64 = 4.0
    let x_dual = dual(x, 1.0)

    let result = dual_sqrt(x_dual)

    let value = dual_value(result)
    let derivative = dual_deriv(result)

    println("f(x) = sqrt(x) at x=4:")
    println("  Value f(4) = ")
    println(value)
    println("  Derivative f'(4) = ")
    println(derivative)

    println("Expected: value=2, derivative=0.25")

    println("")
    println("=== Autodiff: x^3 at x=2 ===")

    let y: f64 = 2.0
    let y_dual = dual(y, 1.0)

    let result2 = dual_pow(y_dual, 3.0)

    let value2 = dual_value(result2)
    let derivative2 = dual_deriv(result2)

    println("g(x) = x^3 at x=2:")
    println("  Value g(2) = ")
    println(value2)
    println("  Derivative g'(2) = ")
    println(derivative2)

    println("Expected: value=8, derivative=12")

    println("")
    println("=== Autodiff: sqrt(x^2) = |x| at x=3 ===")

    let z: f64 = 3.0
    let z_dual = dual(z, 1.0)

    // z^2
    let z2 = dual_mul(z_dual, z_dual)

    // sqrt(z^2)
    let result3 = dual_sqrt(z2)

    let value3 = dual_value(result3)
    let derivative3 = dual_deriv(result3)

    println("h(x) = sqrt(x^2) at x=3:")
    println("  Value h(3) = ")
    println(value3)
    println("  Derivative h'(3) = ")
    println(derivative3)

    println("Expected: value=3, derivative=1 (for x>0)")
}
