// Epistemic BMI example with compiler-native uncertainty propagation.
//
// Uses Knowledge<f64> — the compiler emits inline GUM codegen for
// arithmetic and enforces E170 on .value access.

fn bmi(weight_kg: Knowledge<f64>, height_m: Knowledge<f64>) -> Knowledge<f64> {
    // BMI = weight / height²
    // Native Knowledge arithmetic propagates uncertainty automatically:
    //   h² variance via mul codegen (JCGM §5.1.3)
    //   w/h² variance via div codegen
    weight_kg / (height_m * height_m)
}

fn main() with IO, Epistemic {
    let weight = measure(72.0, uncertainty: 0.6)
    let height = measure(1.78, uncertainty: 0.01)

    let result = bmi(weight, height)

    println("example: epistemic_bmi")
    println("BMI value")
    print_f64(result.value)
    print("\n")
    println("BMI uncertainty (GUM propagated)")
    print_f64(result.uncertainty)
    print("\n")
}
