// Sprint 230: Functional Calculus - Native ELF Demo
//
// Higher-order numerical algorithms compiled to a ~8KB static binary.
// Uses i64 for native demo (lean emitter f64 indirect-call WIP).
// Full f64 calculus works in JIT: test_calculus_e2e.sio
//
// Compile:
//   $SOUC run self-hosted/compiler/render_native_compile_driver_lean.sio \
//     -- examples/native_calculus.sio /tmp/calculus.elf
// Run:
//   /tmp/calculus.elf; echo $?  # -> 50

fn double(x: i64) -> i64 { x * 2 }
fn triple(x: i64) -> i64 { x * 3 }
fn negate(x: i64) -> i64 { 0 - x }
fn square(x: i64) -> i64 { x * x }
fn add(a: i64, b: i64) -> i64 { a + b }
fn sub10sq(x: i64) -> i64 { (x - 10) * (x - 10) }

fn apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }

fn ideriv(f: fn(i64) -> i64, x: i64) -> i64 { f(x + 1) - f(x) }

fn ibisect(f: fn(i64) -> i64, lo: i64, hi: i64) -> i64 with Mut, Panic, Div {
    var a = lo
    var b = hi
    var i: i64 = 0
    while i < 100 && a < b {
        let mid = (a + b) / 2
        let fmid = f(mid)
        if fmid == 0 { return mid }
        let flo = f(a)
        var same_sign: i64 = 0
        if flo > 0 && fmid > 0 { same_sign = 1 }
        if flo < 0 && fmid < 0 { same_sign = 1 }
        if same_sign == 1 { a = mid + 1 }
        else { b = mid }
        i = i + 1
    }
    a
}

fn fold_range(n: i64, init: i64, f: fn(i64, i64) -> i64) -> i64 with Mut, Panic, Div {
    var acc = init
    var i: i64 = 0
    while i < n { acc = f(acc, i)
        i = i + 1 }
    acc
}

fn apply_n(f: fn(i64) -> i64, x: i64, n: i64) -> i64 with Mut, Panic, Div {
    var result = x
    var i: i64 = 0
    while i < n { result = f(result)
        i = i + 1 }
    result
}

fn iminimize(f: fn(i64) -> i64, a: i64, b: i64) -> i64 with Mut, Panic, Div {
    var best_x = a
    var best_f = f(a)
    var x = a + 1
    while x <= b {
        let fx = f(x)
        if fx < best_f { best_f = fx
            best_x = x }
        x = x + 1
    }
    best_x
}

fn select_op(which: i64) -> fn(i64) -> i64 with Mut, Panic, Div {
    if which == 0 { double }
    else if which == 1 { triple }
    else { negate }
}

fn main() -> i64 with Mut, Panic, Div {
    let d = ideriv(square, 3)
    let sum = fold_range(5, 0, add)
    let pow = apply_n(double, 1, 3)
    let min_x = iminimize(sub10sq, 5, 15)
    let dyn_op = select_op(1)
    let dyn_r = dyn_op(2)
    let f = square
    let sq_r = f(3)
    d + sum + pow + min_x + sq_r + dyn_r
}
