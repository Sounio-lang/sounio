// Test autodiff with tan, atan, abs
// tan(x): d/dx tan(x) = sec^2(x) = 1/cos^2(x)
// atan(x): d/dx atan(x) = 1/(1+x^2)
// abs(x): d/dx |x| = sign(x) = x/|x| for x != 0

// --- Autodiff preamble ---
fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}
fn signum_f64(x: f64) -> f64 {
    if x > 0.0 { return 1.0 }
    if x < 0.0 { return 0.0 - 1.0 }
    return 0.0
}
fn sin_f64(x: f64) -> f64 {
    let pi = 3.141592653589793
    var y = x
    while y > pi { y = y - 2.0 * pi }
    while y < 0.0 - pi { y = y + 2.0 * pi }
    let x2 = y * y; var sum = y; var term = y
    term = term * (0.0 - x2) / (2.0 * 3.0); sum = sum + term
    term = term * (0.0 - x2) / (4.0 * 5.0); sum = sum + term
    term = term * (0.0 - x2) / (6.0 * 7.0); sum = sum + term
    term = term * (0.0 - x2) / (8.0 * 9.0); sum = sum + term
    return sum
}
fn cos_f64(x: f64) -> f64 {
    let pi = 3.141592653589793
    var y = x
    while y > pi { y = y - 2.0 * pi }
    while y < 0.0 - pi { y = y + 2.0 * pi }
    let x2 = y * y; var sum = 1.0; var term = 1.0
    term = term * (0.0 - x2) / (1.0 * 2.0); sum = sum + term
    term = term * (0.0 - x2) / (3.0 * 4.0); sum = sum + term
    term = term * (0.0 - x2) / (5.0 * 6.0); sum = sum + term
    term = term * (0.0 - x2) / (7.0 * 8.0); sum = sum + term
    return sum
}
fn atan_f64(x: f64) -> f64 {
    // atan(x) = pi/4 + atan((x-1)/(x+1))  — range reduction around 1
    let pi = 3.141592653589793
    if x < 0.0 { return 0.0 - atan_f64(0.0 - x) }
    // reduce to (0, 0.5) for fast series convergence
    if x > 2.0 { return pi / 2.0 - atan_f64(1.0 / x) }
    if x > 0.5 {
        // atan(x) = pi/4 + atan((x-1)/(x+1))
        let y = (x - 1.0) / (x + 1.0)
        let y2 = y * y; var sum = y; var term = y
        term = term * (0.0 - y2); sum = sum + term / 3.0
        term = term * (0.0 - y2); sum = sum + term / 5.0
        term = term * (0.0 - y2); sum = sum + term / 7.0
        term = term * (0.0 - y2); sum = sum + term / 9.0
        term = term * (0.0 - y2); sum = sum + term / 11.0
        term = term * (0.0 - y2); sum = sum + term / 13.0
        term = term * (0.0 - y2); sum = sum + term / 15.0
        term = term * (0.0 - y2); sum = sum + term / 17.0
        term = term * (0.0 - y2); sum = sum + term / 19.0
        return pi / 4.0 + sum
    }
    let x2 = x * x; var sum = x; var term = x
    term = term * (0.0 - x2); sum = sum + term / 3.0
    term = term * (0.0 - x2); sum = sum + term / 5.0
    term = term * (0.0 - x2); sum = sum + term / 7.0
    term = term * (0.0 - x2); sum = sum + term / 9.0
    term = term * (0.0 - x2); sum = sum + term / 11.0
    term = term * (0.0 - x2); sum = sum + term / 13.0
    term = term * (0.0 - x2); sum = sum + term / 15.0
    term = term * (0.0 - x2); sum = sum + term / 17.0
    term = term * (0.0 - x2); sum = sum + term / 19.0
    return sum
}
struct Dual { val: f64, dot: f64 }
fn dual(val: f64, dot: f64) -> Dual { return Dual { val: val, dot: dot } }
fn dual_value(d: Dual) -> f64 { return d.val }
fn dual_deriv(d: Dual) -> f64 { return d.dot }
fn dual_tan(a: Dual) -> Dual {
    let c = cos_f64(a.val)
    return Dual { val: sin_f64(a.val) / c, dot: a.dot / (c * c) }
}
fn dual_atan(a: Dual) -> Dual {
    return Dual { val: atan_f64(a.val), dot: a.dot / (1.0 + a.val * a.val) }
}
fn dual_abs(a: Dual) -> Dual {
    return Dual { val: abs_f64(a.val), dot: a.dot * signum_f64(a.val) }
}
// --- End preamble ---

fn main() {
    println("=== Autodiff: tan(x) at x=0 ===")

    let x: f64 = 0.0
    let x_dual = dual(x, 1.0)

    let result = dual_tan(x_dual)

    let value = dual_value(result)
    let derivative = dual_deriv(result)

    println("f(x) = tan(x) at x=0:")
    println("  Value f(0) = ")
    println(value)
    println("  Derivative f'(0) = ")
    println(derivative)

    println("Expected: value=0, derivative=1 (sec^2(0) = 1)")

    println("")
    println("=== Autodiff: atan(x) at x=1 ===")

    let y: f64 = 1.0
    let y_dual = dual(y, 1.0)

    let result2 = dual_atan(y_dual)

    let value2 = dual_value(result2)
    let derivative2 = dual_deriv(result2)

    // atan(1) = pi/4 ~ 0.7854
    // d/dx atan(x) at x=1 = 1/(1+1) = 0.5

    println("g(x) = atan(x) at x=1:")
    println("  Value g(1) = ")
    println(value2)
    println("  Derivative g'(1) = ")
    println(derivative2)

    println("Expected: value ~ 0.7854, derivative = 0.5")

    println("")
    println("=== Autodiff: |x| at x=3 ===")

    let z: f64 = 3.0
    let z_dual = dual(z, 1.0)

    let result3 = dual_abs(z_dual)

    let value3 = dual_value(result3)
    let derivative3 = dual_deriv(result3)

    println("h(x) = |x| at x=3:")
    println("  Value h(3) = ")
    println(value3)
    println("  Derivative h'(3) = ")
    println(derivative3)

    println("Expected: value=3, derivative=1 (positive x)")

    println("")
    println("=== Autodiff: |x| at x=-2 ===")

    let w: f64 = -2.0
    let w_dual = dual(w, 1.0)

    let result4 = dual_abs(w_dual)

    let value4 = dual_value(result4)
    let derivative4 = dual_deriv(result4)

    println("h(x) = |x| at x=-2:")
    println("  Value h(-2) = ")
    println(value4)
    println("  Derivative h'(-2) = ")
    println(derivative4)

    println("Expected: value=2, derivative=-1 (negative x)")
}
