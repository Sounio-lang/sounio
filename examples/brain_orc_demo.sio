//@ run-pass
// brain_orc_demo.sio — Brain ORC + Associator Field Pipeline
//
// End-to-end demonstration of the Paper 4 connectome analysis pipeline:
//   1. Generate synthetic ASD and TD connectomes
//   2. Compute Ollivier-Ricci Curvature (LLY) on each
//   3. Classify geometric phases
//   4. Extract subgraphs and compute octonion associator fields
//   5. Compare ASD vs TD across curvature and algebraic measures
//
// This is the computational backbone for:
//   "Brain ORC + Associator Field: Non-Associative Geometry of
//    Functional Connectomes in ASD"
//   Target: Network Neuroscience
//
// References:
//   - Ollivier 2009, "Ricci curvature of Markov chains"
//   - Lin, Lu, Yau 2011, "Ricci curvature of graphs"
//   - Di Martino et al. 2014, "The ABIDE Initiative"
//   - Baez 2002, "The Octonions"

// ============================================================================
// MATH HELPERS
// ============================================================================

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn sqrt_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var r = x
    var i = 0
    while i < 20 { r = 0.5 * (r + x / r); i = i + 1 }
    r
}

// ============================================================================
// ADJACENCY MATRIX — 50x50 for demo (full pipeline uses 200x200)
// ============================================================================

struct DemoMatrix {
    data: [f64; 2500]     // 50*50 flattened
    n: i64
}

fn dm_new(n: i64) -> DemoMatrix {
    DemoMatrix { data: [0.0; 2500], n: n }
}

fn dm_get(m: DemoMatrix, i: i64, j: i64) -> f64 with Panic {
    m.data[(i * m.n + j) as usize]
}

fn dm_set_sym(m: DemoMatrix, i: i64, j: i64, val: f64) -> DemoMatrix with Mut, Panic {
    var out = m
    out.data[(i * m.n + j) as usize] = val
    out.data[(j * m.n + i) as usize] = val
    out
}

// ============================================================================
// LCG RNG
// ============================================================================

fn lcg_next(s: i64) -> i64 { s * 6364136223846793005 + 1442695040888963407 }

fn lcg_f64(s: i64) -> f64 with Div, Panic {
    let v = if s < 0 { 0 - s } else { s }
    (v as f64) / 9223372036854775807.0
}

// ============================================================================
// CONNECTOME GENERATORS
// ============================================================================

fn generate_connectome(
    n: i64, n_modules: i64, p_within: f64, p_between: f64, seed: i64
) -> DemoMatrix with Mut, Panic, Div {
    var m = dm_new(n)
    var s = seed

    var i: i64 = 0
    while i < n {
        var j: i64 = i + 1
        while j < n {
            s = lcg_next(s)
            let r = lcg_f64(s)
            let mod_i = i * n_modules / n
            let mod_j = j * n_modules / n
            let same_mod = mod_i == mod_j
            let p = if same_mod { p_within } else { p_between }

            if r < p {
                s = lcg_next(s)
                let w = 0.2 + 0.6 * lcg_f64(s)
                m = dm_set_sym(m, i, j, w)
            }
            j = j + 1
        }
        i = i + 1
    }
    m
}

fn generate_td(n: i64, seed: i64) -> DemoMatrix with Mut, Panic, Div {
    generate_connectome(n, 5, 0.70, 0.15, seed)
}

fn generate_asd(n: i64, seed: i64) -> DemoMatrix with Mut, Panic, Div {
    generate_connectome(n, 5, 0.55, 0.25, seed)
}

// ============================================================================
// BINARY GRAPH — for ORC computation
// ============================================================================

struct BinGraph {
    adj: [i32; 2500]       // 50*50
    n: i64
}

fn bg_new(n: i64) -> BinGraph { BinGraph { adj: [0; 2500], n: n } }

fn bg_from_matrix(m: DemoMatrix, threshold: f64) -> BinGraph with Mut, Panic, Div {
    var g = bg_new(m.n)
    var i: i64 = 0
    while i < m.n {
        var j: i64 = i + 1
        while j < m.n {
            if dm_get(m, i, j) > threshold {
                g.adj[(i * m.n + j) as usize] = 1
                g.adj[(j * m.n + i) as usize] = 1
            }
            j = j + 1
        }
        i = i + 1
    }
    g
}

fn bg_degree(g: BinGraph, v: i64) -> i64 with Mut, Panic, Div {
    var d: i64 = 0
    var j: i64 = 0
    while j < g.n {
        if g.adj[(v * g.n + j) as usize] == 1 { d = d + 1 }
        j = j + 1
    }
    d
}

fn bg_common_neighbors(g: BinGraph, u: i64, v: i64) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var w: i64 = 0
    while w < g.n {
        if w != u && w != v {
            if g.adj[(u * g.n + w) as usize] == 1 && g.adj[(v * g.n + w) as usize] == 1 {
                count = count + 1
            }
        }
        w = w + 1
    }
    count
}

fn bg_edge_count(g: BinGraph) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < g.n {
        var j: i64 = i + 1
        while j < g.n {
            if g.adj[(i * g.n + j) as usize] == 1 { count = count + 1 }
            j = j + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// LIN-LU-YAU RICCI CURVATURE
// ============================================================================

fn orc_lly(g: BinGraph, u: i64, v: i64) -> f64 with Mut, Panic, Div {
    let d_u = bg_degree(g, u)
    let d_v = bg_degree(g, v)
    if d_u == 0 || d_v == 0 { return 0.0 }

    let t = bg_common_neighbors(g, u, v)
    let inv_du = 1.0 / (d_u as f64)
    let inv_dv = 1.0 / (d_v as f64)
    (t as f64) * (inv_du + inv_dv) + inv_du + inv_dv - 1.0
}

// Curvature statistics for all edges
struct OrcStats {
    n_edges: i64
    mean_k: f64
    min_k: f64
    max_k: f64
    std_k: f64
    n_pos: i64
    n_zero: i64
    n_neg: i64
}

fn compute_orc_stats(g: BinGraph) -> OrcStats with Mut, Panic, Div {
    var n_edges: i64 = 0
    var sum_k: f64 = 0.0
    var sum_k2: f64 = 0.0
    var min_k: f64 = 1000.0
    var max_k: f64 = 0.0 - 1000.0
    var n_pos: i64 = 0
    var n_zero: i64 = 0
    var n_neg: i64 = 0
    let eps = 0.01

    var u: i64 = 0
    while u < g.n {
        var v: i64 = u + 1
        while v < g.n {
            if g.adj[(u * g.n + v) as usize] == 1 {
                let k = orc_lly(g, u, v)
                n_edges = n_edges + 1
                sum_k = sum_k + k
                sum_k2 = sum_k2 + k * k
                if k < min_k { min_k = k }
                if k > max_k { max_k = k }
                if k > eps { n_pos = n_pos + 1 }
                else if k < (0.0 - eps) { n_neg = n_neg + 1 }
                else { n_zero = n_zero + 1 }
            }
            v = v + 1
        }
        u = u + 1
    }

    let mean = if n_edges > 0 { sum_k / (n_edges as f64) } else { 0.0 }
    let var_k = if n_edges > 0 {
        sum_k2 / (n_edges as f64) - mean * mean
    } else { 0.0 }

    OrcStats {
        n_edges: n_edges,
        mean_k: mean,
        min_k: if n_edges > 0 { min_k } else { 0.0 },
        max_k: if n_edges > 0 { max_k } else { 0.0 },
        std_k: sqrt_f64(abs_f64(var_k)),
        n_pos: n_pos, n_zero: n_zero, n_neg: n_neg,
    }
}

fn phase_name(stats: OrcStats) -> i64 with Div, Panic {
    if stats.n_edges == 0 { return 3 }
    let ne = stats.n_edges as f64
    let frac_pos = (stats.n_pos as f64) / ne
    let frac_neg = (stats.n_neg as f64) / ne
    if frac_pos > 0.5 { return 0 }
    if frac_neg > 0.5 { return 2 }
    if abs_f64(stats.mean_k) < 0.05 && stats.std_k < 0.1 { return 1 }
    3
}

// ============================================================================
// OCTONION (inlined for demo)
// ============================================================================

struct Oct { e: [f64; 8] }

fn oct_zero() -> Oct { Oct { e: [0.0; 8] } }

fn oct_unit(idx: i64) -> Oct with Mut, Panic {
    var o = Oct { e: [0.0; 8] }
    if idx >= 0 && idx < 8 { o.e[idx as usize] = 1.0 }
    o
}

fn oct_scale(o: Oct, s: f64) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    var i: i64 = 0
    while i < 8 { r.e[i as usize] = o.e[i as usize] * s; i = i + 1 }
    r
}

fn oct_sub(a: Oct, b: Oct) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    var i: i64 = 0
    while i < 8 { r.e[i as usize] = a.e[i as usize] - b.e[i as usize]; i = i + 1 }
    r
}

fn oct_conjugate(o: Oct) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    r.e[0] = o.e[0]
    var i: i64 = 1
    while i < 8 { r.e[i as usize] = 0.0 - o.e[i as usize]; i = i + 1 }
    r
}

fn oct_norm_sq(o: Oct) -> f64 with Mut, Panic, Div {
    var s: f64 = 0.0
    var i: i64 = 0
    while i < 8 { s = s + o.e[i as usize] * o.e[i as usize]; i = i + 1 }
    s
}

fn oct_norm(o: Oct) -> f64 with Mut, Panic, Div { sqrt_f64(oct_norm_sq(o)) }

fn oct_fano_index(i: i64, j: i64) -> i64 with Mut, Panic, Div {
    if i == j { return 0 }
    var t: [i64; 21] = [0; 21]
    t[0]=1;t[1]=2;t[2]=4; t[3]=2;t[4]=3;t[5]=5; t[6]=3;t[7]=4;t[8]=6
    t[9]=4;t[10]=5;t[11]=7; t[12]=5;t[13]=6;t[14]=1; t[15]=6;t[16]=7;t[17]=2
    t[18]=7;t[19]=1;t[20]=3
    var k: i64 = 0
    while k < 7 {
        let a=t[(k*3) as usize]; let b=t[(k*3+1) as usize]; let c=t[(k*3+2) as usize]
        if (i==a&&j==b)||(i==b&&j==c)||(i==c&&j==a) {
            if i==a&&j==b {return c}; if i==b&&j==c {return a}; return b
        }
        if (i==b&&j==a)||(i==c&&j==b)||(i==a&&j==c) {
            if i==b&&j==a {return c}; if i==c&&j==b {return a}; return b
        }
        k=k+1
    }
    0
}

fn oct_fano_sign(i: i64, j: i64) -> f64 with Mut, Panic, Div {
    if i==j {return -1.0}; if i==0||j==0 {return 1.0}
    var t: [i64; 21] = [0; 21]
    t[0]=1;t[1]=2;t[2]=4; t[3]=2;t[4]=3;t[5]=5; t[6]=3;t[7]=4;t[8]=6
    t[9]=4;t[10]=5;t[11]=7; t[12]=5;t[13]=6;t[14]=1; t[15]=6;t[16]=7;t[17]=2
    t[18]=7;t[19]=1;t[20]=3
    var k: i64 = 0
    while k < 7 {
        let a=t[(k*3) as usize]; let b=t[(k*3+1) as usize]; let c=t[(k*3+2) as usize]
        if (i==a&&j==b)||(i==b&&j==c)||(i==c&&j==a) {return 1.0}
        if (i==b&&j==a)||(i==c&&j==b)||(i==a&&j==c) {return -1.0}
        k=k+1
    }
    0.0
}

fn oct_mul(a: Oct, b: Oct) -> Oct with Mut, Panic, Div {
    var result = oct_zero()
    var i: i64 = 0
    while i < 8 {
        var j: i64 = 0
        while j < 8 {
            let coeff = a.e[i as usize] * b.e[j as usize]
            if i==0&&j==0 { result.e[0] = result.e[0] + coeff }
            else if i==0 { result.e[j as usize] = result.e[j as usize] + coeff }
            else if j==0 { result.e[i as usize] = result.e[i as usize] + coeff }
            else if i==j { result.e[0] = result.e[0] - coeff }
            else {
                let k = oct_fano_index(i, j)
                let sign = oct_fano_sign(i, j)
                result.e[k as usize] = result.e[k as usize] + sign * coeff
            }
            j=j+1
        }
        i=i+1
    }
    result
}

fn oct_associator(a: Oct, b: Oct, c: Oct) -> Oct with Mut, Panic, Div {
    let ab = oct_mul(a, b)
    let bc = oct_mul(b, c)
    oct_sub(oct_mul(ab, c), oct_mul(a, bc))
}

// ============================================================================
// OCTGRAPH (16-node subgraph for demo)
// ============================================================================

struct OctGraph {
    n: i32
    adj: [i32; 256]
    lab0: [f64; 256]
    lab1: [f64; 256]
    lab2: [f64; 256]
    lab3: [f64; 256]
    lab4: [f64; 256]
    lab5: [f64; 256]
    lab6: [f64; 256]
    lab7: [f64; 256]
}

fn og_new(n: i32) -> OctGraph {
    OctGraph {
        n: n, adj: [0; 256],
        lab0: [0.0; 256], lab1: [0.0; 256], lab2: [0.0; 256], lab3: [0.0; 256],
        lab4: [0.0; 256], lab5: [0.0; 256], lab6: [0.0; 256], lab7: [0.0; 256],
    }
}

fn og_idx(u: i32, v: i32) -> i32 { u * 16 + v }

fn og_set_edge(g: OctGraph, u: i32, v: i32, label: Oct) -> OctGraph with Mut, Panic, Div {
    var r = g
    let idx = og_idx(u, v) as usize
    r.adj[idx] = 1
    r.lab0[idx]=label.e[0]; r.lab1[idx]=label.e[1]; r.lab2[idx]=label.e[2]; r.lab3[idx]=label.e[3]
    r.lab4[idx]=label.e[4]; r.lab5[idx]=label.e[5]; r.lab6[idx]=label.e[6]; r.lab7[idx]=label.e[7]
    r
}

fn og_add_undir(g: OctGraph, u: i32, v: i32, label: Oct) -> OctGraph with Mut, Panic, Div {
    var r = og_set_edge(g, u, v, label)
    r = og_set_edge(r, v, u, oct_conjugate(label))
    r
}

fn og_get_label(g: OctGraph, u: i32, v: i32) -> Oct with Mut, Panic {
    let idx = og_idx(u, v) as usize
    var o = Oct { e: [0.0; 8] }
    o.e[0]=g.lab0[idx]; o.e[1]=g.lab1[idx]; o.e[2]=g.lab2[idx]; o.e[3]=g.lab3[idx]
    o.e[4]=g.lab4[idx]; o.e[5]=g.lab5[idx]; o.e[6]=g.lab6[idx]; o.e[7]=g.lab7[idx]
    o
}

// Build OctGraph from first n_nodes of DemoMatrix (n_nodes <= 16)
fn matrix_to_octgraph(m: DemoMatrix, n_nodes: i32, threshold: f64) -> OctGraph with Mut, Panic, Div {
    var g = og_new(n_nodes)
    var i: i32 = 0
    while i < n_nodes {
        var j: i32 = i + 1
        while j < n_nodes {
            let w = dm_get(m, i as i64, j as i64)
            if w > threshold {
                // Cyclic basis labeling: weight * e_{(i+j) mod 7 + 1}
                let basis = (((i + j) as i64) % 7) + 1
                let label = oct_scale(oct_unit(basis), w)
                g = og_add_undir(g, i, j, label)
            }
            j = j + 1
        }
        i = i + 1
    }
    g
}

// ============================================================================
// ASSOCIATOR FIELD STATISTICS
// ============================================================================

struct AssocStats {
    count: i32
    mean_norm: f64
    max_norm: f64
    energy: f64
    zero_count: i32
}

fn compute_assoc_stats(g: OctGraph) -> AssocStats with Mut, Panic, Div {
    var count: i32 = 0
    var sum_norm: f64 = 0.0
    var max_n: f64 = 0.0
    var sum_sq: f64 = 0.0
    var zeros: i32 = 0

    var u: i32 = 0
    while u < g.n {
        var v: i32 = 0
        while v < g.n {
            if g.adj[og_idx(u, v) as usize] == 1 && u != v {
                var w: i32 = 0
                while w < g.n {
                    if g.adj[og_idx(v, w) as usize] == 1 && v != w && w != u {
                        var x: i32 = 0
                        while x < g.n {
                            if g.adj[og_idx(w, x) as usize] == 1 && w != x && x != v {
                                let a = og_get_label(g, u, v)
                                let b = og_get_label(g, v, w)
                                let c = og_get_label(g, w, x)
                                let assoc = oct_associator(a, b, c)
                                let n = oct_norm(assoc)
                                count = count + 1
                                sum_norm = sum_norm + n
                                sum_sq = sum_sq + n * n
                                if n > max_n { max_n = n }
                                if n < 1e-9 { zeros = zeros + 1 }
                            }
                            x = x + 1
                        }
                    }
                    w = w + 1
                }
            }
            v = v + 1
        }
        u = u + 1
    }

    let mean = if count > 0 { sum_norm / (count as f64) } else { 0.0 }
    AssocStats {
        count: count, mean_norm: mean, max_norm: max_n,
        energy: sum_sq, zero_count: zeros,
    }
}

// ============================================================================
// PRINT HELPERS
// ============================================================================

fn print_f64(x: f64) with IO, Mut, Panic, Div {
    if x < 0.0 { print("-"); print_f64(0.0 - x); return }
    let integer_part = x as i64
    let frac = x - (integer_part as f64)
    let frac_scaled = (frac * 10000.0 + 0.5) as i64
    print(integer_part)
    print(".")
    if frac_scaled < 10 { print("000") }
    else if frac_scaled < 100 { print("00") }
    else if frac_scaled < 1000 { print("0") }
    print(frac_scaled)
}

fn print_phase(p: i64) with IO {
    if p == 0 { print("SPHERICAL") }
    else if p == 1 { print("FLAT") }
    else if p == 2 { print("HYPERBOLIC") }
    else { print("MIXED") }
}

fn print_orc_stats(name: i64, s: OrcStats) with IO, Mut, Panic, Div {
    if name == 0 { print("  TD  connectome: ") }
    else { print("  ASD connectome: ") }
    print("edges="); print(s.n_edges)
    print(" mean_k="); print_f64(s.mean_k)
    print(" std_k="); print_f64(s.std_k)
    print(" [+"); print(s.n_pos)
    print(" 0:"); print(s.n_zero)
    print(" -"); print(s.n_neg)
    print("]")
    println("")
}

fn print_assoc_stats(name: i64, s: AssocStats) with IO, Mut, Panic, Div {
    if name == 0 { print("  TD  subgraph: ") }
    else { print("  ASD subgraph: ") }
    print("triples="); print(s.count)
    print(" mean="); print_f64(s.mean_norm)
    print(" max="); print_f64(s.max_norm)
    print(" energy="); print_f64(s.energy)
    print(" zeros="); print(s.zero_count)
    println("")
}

// ============================================================================
// MAIN — THE EXPERIMENT
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("================================================================")
    println("  BRAIN ORC + ASSOCIATOR FIELD — Paper 4 Pipeline")
    println("  Connectome Geometry via Ollivier-Ricci Curvature")
    println("  and Octonion Associator Fields")
    println("================================================================")
    println("")

    let n: i64 = 30       // 30 nodes for demo (manageable computation)
    let threshold = 0.3    // edge weight threshold

    // -----------------------------------------------------------------
    // Phase 1: Generate synthetic connectomes
    // -----------------------------------------------------------------
    println("--- Phase 1: Synthetic Connectome Generation ---")
    println("")

    let td_matrix = generate_td(n, 42)
    let asd_matrix = generate_asd(n, 42)

    // Count edges
    var td_edges: i64 = 0
    var asd_edges: i64 = 0
    var i: i64 = 0
    while i < n {
        var j: i64 = i + 1
        while j < n {
            if dm_get(td_matrix, i, j) > threshold { td_edges = td_edges + 1 }
            if dm_get(asd_matrix, i, j) > threshold { asd_edges = asd_edges + 1 }
            j = j + 1
        }
        i = i + 1
    }

    print("  TD  connectome: n="); print(n); print(" edges="); print(td_edges)
    print(" density="); print_f64((td_edges as f64) / (((n * (n - 1)) / 2) as f64))
    println("")
    print("  ASD connectome: n="); print(n); print(" edges="); print(asd_edges)
    print(" density="); print_f64((asd_edges as f64) / (((n * (n - 1)) / 2) as f64))
    println("")
    println("")

    // -----------------------------------------------------------------
    // Phase 2: Ollivier-Ricci Curvature
    // -----------------------------------------------------------------
    println("--- Phase 2: Ollivier-Ricci Curvature (Lin-Lu-Yau) ---")
    println("")

    let bg_td = bg_from_matrix(td_matrix, threshold)
    let bg_asd = bg_from_matrix(asd_matrix, threshold)

    let orc_td = compute_orc_stats(bg_td)
    let orc_asd = compute_orc_stats(bg_asd)

    print_orc_stats(0, orc_td)
    print_orc_stats(1, orc_asd)
    println("")

    // Phase classification
    let phase_td = phase_name(orc_td)
    let phase_asd = phase_name(orc_asd)
    print("  TD  geometric phase: "); print_phase(phase_td); println("")
    print("  ASD geometric phase: "); print_phase(phase_asd); println("")

    // Curvature difference
    println("")
    print("  Mean curvature difference (TD - ASD): ")
    print_f64(orc_td.mean_k - orc_asd.mean_k)
    println("")

    let td_frac_neg = if orc_td.n_edges > 0 {
        (orc_td.n_neg as f64) / (orc_td.n_edges as f64)
    } else { 0.0 }
    let asd_frac_neg = if orc_asd.n_edges > 0 {
        (orc_asd.n_neg as f64) / (orc_asd.n_edges as f64)
    } else { 0.0 }
    print("  Negative curvature fraction — TD: ")
    print_f64(td_frac_neg)
    print("  ASD: ")
    print_f64(asd_frac_neg)
    println("")
    println("")

    // -----------------------------------------------------------------
    // Phase 3: Octonion Associator Field (on subgraph)
    // -----------------------------------------------------------------
    println("--- Phase 3: Octonion Associator Field (10-node subgraph) ---")
    println("")

    let sub_n: i32 = 10    // 10-node subgraph for tractable associator computation
    let og_td = matrix_to_octgraph(td_matrix, sub_n, threshold)
    let og_asd = matrix_to_octgraph(asd_matrix, sub_n, threshold)

    let af_td = compute_assoc_stats(og_td)
    let af_asd = compute_assoc_stats(og_asd)

    print_assoc_stats(0, af_td)
    print_assoc_stats(1, af_asd)
    println("")

    // Comparison
    print("  Associator mean diff (TD - ASD): ")
    print_f64(af_td.mean_norm - af_asd.mean_norm)
    println("")
    print("  Associator energy diff (TD - ASD): ")
    print_f64(af_td.energy - af_asd.energy)
    println("")

    let zf_td = if af_td.count > 0 { (af_td.zero_count as f64) / (af_td.count as f64) } else { 0.0 }
    let zf_asd = if af_asd.count > 0 { (af_asd.zero_count as f64) / (af_asd.count as f64) } else { 0.0 }
    print("  Zero-associator fraction — TD: ")
    print_f64(zf_td)
    print("  ASD: ")
    print_f64(zf_asd)
    println("")
    println("")

    // -----------------------------------------------------------------
    // Phase 4: Node-level curvature (top-5 highest/lowest)
    // -----------------------------------------------------------------
    println("--- Phase 4: Node-Level Curvature Profile ---")
    println("")

    // Compute mean curvature per node for TD
    var td_node_k: [f64; 50] = [0.0; 50]
    var td_node_cnt: [i64; 50] = [0; 50]
    var u: i64 = 0
    while u < n {
        var v: i64 = u + 1
        while v < n {
            if bg_td.adj[(u * n + v) as usize] == 1 {
                let k = orc_lly(bg_td, u, v)
                td_node_k[u as usize] = td_node_k[u as usize] + k
                td_node_cnt[u as usize] = td_node_cnt[u as usize] + 1
                td_node_k[v as usize] = td_node_k[v as usize] + k
                td_node_cnt[v as usize] = td_node_cnt[v as usize] + 1
            }
            v = v + 1
        }
        u = u + 1
    }

    // Print nodes with highest mean curvature
    print("  TD top-5 highest mean curvature nodes: ")
    var printed: i64 = 0
    while printed < 5 {
        var best_node: i64 = 0
        var best_k: f64 = 0.0 - 10000.0
        var ni: i64 = 0
        while ni < n {
            if td_node_cnt[ni as usize] > 0 {
                let avg = td_node_k[ni as usize] / (td_node_cnt[ni as usize] as f64)
                if avg > best_k {
                    best_k = avg
                    best_node = ni
                }
            }
            ni = ni + 1
        }
        print("n"); print(best_node); print("(")
        print_f64(best_k)
        print(") ")
        // Mark as visited by zeroing count
        td_node_cnt[best_node as usize] = 0
        printed = printed + 1
    }
    println("")
    println("")

    // -----------------------------------------------------------------
    // Phase 5: Summary
    // -----------------------------------------------------------------
    println("================================================================")
    println("  SUMMARY — Paper 4 Hypotheses")
    println("================================================================")
    println("")
    println("  H1: ASD connectomes show more negative Ricci curvature")
    println("      (hyperbolic geometry → tree-like, disrupted communities)")
    print("      Result: ASD neg frac = "); print_f64(asd_frac_neg)
    print(" vs TD = "); print_f64(td_frac_neg); println("")
    println("")
    println("  H2: ASD connectomes produce different associator field patterns")
    println("      (non-associative algebra detects structural differences)")
    print("      Result: energy diff = "); print_f64(af_td.energy - af_asd.energy); println("")
    println("")
    println("  H3: Phase classification separates ASD from TD")
    print("      Result: TD="); print_phase(phase_td)
    print(" ASD="); print_phase(phase_asd); println("")
    println("")
    println("  Next: Apply to real ABIDE-I CC200 matrices")
    println("================================================================")

    0
}
