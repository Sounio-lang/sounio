// Test autodiff with exp and log
// f(x) = exp(log(x)) = x  (identity)
// f'(x) = 1
// At x = 2: f(2) = 2, f'(2) = 1

fn main() {
    println("=== Autodiff: exp(log(x)) at x=2 ===")

    let x: f64 = 2.0
    let x_dual = dual(x, 1.0)

    // log(x)
    let log_x = dual_log(x_dual)

    // exp(log(x)) = x
    let result = dual_exp(log_x)

    let value = dual_value(result)
    let derivative = dual_deriv(result)

    println("f(x) = exp(log(x)) at x=2:")
    println("  Value f(2) = ")
    println(value)
    println("  Derivative f'(2) = ")
    println(derivative)

    println("Expected: value=2, derivative=1")

    println("")
    println("=== Autodiff: exp(x^2) at x=1 ===")

    let y: f64 = 1.0
    let y_dual = dual(y, 1.0)

    // y^2
    let y2 = dual_mul(y_dual, y_dual)

    // exp(y^2)
    let exp_result = dual_exp(y2)

    let value2 = dual_value(exp_result)
    let derivative2 = dual_deriv(exp_result)

    // f(x) = exp(x^2), f'(x) = 2x * exp(x^2)
    // At x=1: f(1) = e ≈ 2.718, f'(1) = 2 * e ≈ 5.436

    println("f(x) = exp(x^2) at x=1:")
    println("  Value f(1) = ")
    println(value2)
    println("  Derivative f'(1) = ")
    println(derivative2)

    println("Expected: value ≈ 2.718, derivative ≈ 5.436")
}
