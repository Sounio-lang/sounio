// examples/pbpk_viz/rapamycin_cyp3a5.sio — rapamycin exposure by CYP3A5 genotype.
//   souc run examples/pbpk_viz/rapamycin_cyp3a5.sio -> rapamycin_cyp3a5.png
use image::pure::types::{Image, image_new}
use image::plot::{Area, area_new, plot_background, plot_grid, plot_hband, plot_line_w, plot_axes, plot_text_sc, plot_legend_item}
use image::pure::png::{png_write}
use pbpk::rapamycin_params::{rap_ka}
use pbpk::rapamycin_cyp3a5::{cyp_ke_slow, cyp_f_slow, cyp_ke_standard, cyp_f_standard, cyp_ke_fast, cyp_f_fast}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
fn pk_oral(dose_ug: f64, ka: f64, vdf: f64, ke: f64, t: f64) -> f64 with Mut, Div, Panic {
    var dd = ka - ke; if dd < 0.0 { dd = 0.0 - dd }
    if dd < 0.000000001 { return 0.0 }
    (dose_ug * ka) / (vdf * (ka - ke)) * (exp(0.0 - ke * t) - exp(0.0 - ka * t))
}
fn main() with IO, Mut, Div, Panic {
    let ka_e = rap_ka(); let ka = ka_e.val()
    let dose = 6000.0; let vd_std = 840.0; let f_std = 0.141
    let ke_s = cyp_ke_slow();     let vdf_s = vd_std * f_std / cyp_f_slow()
    let ke_m = cyp_ke_standard(); let vdf_m = vd_std * f_std / cyp_f_standard()
    let ke_f = cyp_ke_fast();     let vdf_f = vd_std * f_std / cyp_f_fast()
    let n = 320; let tmax = 72.0
    var ts: [f64; 512] = [0.0; 512]
    var cs: [f64; 512] = [0.0; 512]
    var cm: [f64; 512] = [0.0; 512]
    var cf: [f64; 512] = [0.0; 512]
    var ymax = 0.0
    var i = 0
    while i < n {
        let t = tmax * ((i as f64) / ((n - 1) as f64)); ts[i as usize] = t
        let a = pk_oral(dose, ka, vdf_s, ke_s, t); cs[i as usize] = a
        cm[i as usize] = pk_oral(dose, ka, vdf_m, ke_m, t)
        cf[i as usize] = pk_oral(dose, ka, vdf_f, ke_f, t)
        if a > ymax { ymax = a }
        i = i + 1
    }
    ymax = ymax * 1.08
    let w = 1200; let h = 760
    var img = image_new(w as i32, h as i32)
    plot_background(&!img, w as i64, h as i64, 0xFFFFFF)
    let a = area_new(150, 110, 1150, 660, 0.0, tmax, 0.0, ymax)
    plot_grid(&!img, &a, 6, 6, 0xECECEC)
    plot_hband(&!img, &a, trough_floor_mg_l() * 1000.0, trough_ceil_mg_l() * 1000.0, 0xEAF4EC)
    plot_line_w(&!img, &a, &ts, &cs, n, 0xC0392B, 2.4)   // slow *3/*3
    plot_line_w(&!img, &a, &ts, &cm, n, 0x2E8B57, 2.4)   // standard *1/*3
    plot_line_w(&!img, &a, &ts, &cf, n, 0x1F5FA8, 2.4)   // fast *1/*1
    plot_axes(&!img, &a, 6, 6, 0x555555, 3)
    let _t1 = plot_text_sc(&!img, "Rapamycin exposure by CYP3A5 genotype", 150, 40, 0x111111, 4)
    let _t2 = plot_text_sc(&!img, "time (h)", 560, 706, 0x333333, 3)
    let _t3 = plot_text_sc(&!img, "C (ng/mL)", 150, 78, 0x333333, 3)
    plot_legend_item(&!img, 820, 150, 0xC0392B, "slow 3/3")
    plot_legend_item(&!img, 820, 185, 0x2E8B57, "std 1/3")
    plot_legend_item(&!img, 820, 220, 0x1F5FA8, "fast 1/1")
    let ok = png_write("rapamycin_cyp3a5.png", &img)
    print("wrote="); print(ok); print("\n")
}
