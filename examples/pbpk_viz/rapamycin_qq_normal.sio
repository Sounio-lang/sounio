// examples/pbpk_viz/rapamycin_qq_normal.sio
// Normal Q-Q plot of a batch of rapamycin trough concentrations. Drug troughs are
// typically right-skewed (log-normal), so the upper points bow away from the
// ideal-normal line and the PPCC sits below 1 — the classic signal that a
// log-transform is needed before a t-test/ANOVA.
//   souc run examples/pbpk_viz/rapamycin_qq_normal.sio -> rapamycin_qq_normal.png
use image::pure::types::{Image, image_new}
use image::plot::{Area, area_new, plot_background, plot_grid, plot_point, plot_line_w, plot_axes, plot_text_sc, draw_number}
use image::pure::png::{png_write}
use stats::qq_normal::{qq_normal, QQResult}

fn main() with IO, Mut, Div, Panic {
    // 18 measured trough concentrations (ng/mL), right-skewed.
    var data: [f64; 256] = [0.0; 256]
    data[0]=3.1;  data[1]=3.8;  data[2]=4.2;  data[3]=4.5;  data[4]=4.9;  data[5]=5.3
    data[6]=5.8;  data[7]=6.1;  data[8]=6.7;  data[9]=7.4;  data[10]=8.2; data[11]=9.1
    data[12]=10.5; data[13]=12.3; data[14]=14.8; data[15]=18.2; data[16]=24.1; data[17]=31.5
    let n = 18

    var theo: [f64; 256] = [0.0; 256]
    var samp: [f64; 256] = [0.0; 256]
    let r = qq_normal(&data, n as i32, &!theo, &!samp)

    let w = 1200; let h = 760
    var img = image_new(w as i32, h as i32)
    plot_background(&!img, w as i64, h as i64, 0xFFFFFF)
    let a = area_new(160, 110, 1150, 660, 0.0 - 2.5, 2.5, 0.0, 35.0)
    plot_grid(&!img, &a, 10, 7, 0xEEEEEE)

    // Ideal-normal reference line y = mean + sd·z across the plotted z range.
    var lx: [f64; 512] = [0.0; 512]
    var ly: [f64; 512] = [0.0; 512]
    lx[0] = 0.0 - 2.5; ly[0] = r.mean + r.sd * (0.0 - 2.5)
    lx[1] = 2.5;       ly[1] = r.mean + r.sd * 2.5
    plot_line_w(&!img, &a, &lx, &ly, 2, 0xB03A2E, 2.0)

    plot_axes(&!img, &a, 10, 7, 0x555555, 3)

    // Q-Q points: x = theoretical normal quantile, y = ordered trough.
    var i = 0
    while i < n {
        plot_point(&!img, &a, theo[i as usize], samp[i as usize], 0x2E5E8C, 5)
        i = i + 1
    }

    let _t1 = plot_text_sc(&!img, "Trough concentrations: normal Q-Q plot", 160, 40, 0x111111, 4)
    let _t2 = plot_text_sc(&!img, "theoretical normal quantile", 470, 706, 0x333333, 3)
    let _t3 = plot_text_sc(&!img, "ordered trough (ng/mL)", 160, 78, 0x333333, 3)
    // On-plot PPCC readout (upper-left of the panel).
    let _lx = plot_text_sc(&!img, "PPCC", 230, 150, 0x666666, 3)
    let _nx = draw_number(&!img, r.ppcc, 3, 360, 150, 0xB03A2E, 3)

    let ok = png_write("rapamycin_qq_normal.png", &img)
    print("ppcc="); print(r.ppcc); print(" slope="); print(r.slope)
    print(" mean="); print(r.mean); print(" sd="); print(r.sd)
    print(" wrote="); print(ok); print("\n")
}
