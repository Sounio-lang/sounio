// examples/pbpk_viz/rapamycin_curve.sio
// Native publication figure: rapamycin (sirolimus) oral concentration-time curve
// with a 95% GUM uncertainty band, consuming the literature-referenced Epistemic
// parameters in stdlib/pbpk and rendered with image::plot — no Python, no FFI.
//   souc run examples/pbpk_viz/rapamycin_curve.sio   -> rapamycin_curve.png

use image::pure::types::{Image, image_new}
use image::plot::{Area, area_new, plot_background, plot_band, plot_line, plot_axes, plot_text}
use image::pure::png::{png_write}
use epistemic::knowledge::{Epistemic}
use pbpk::rapamycin_params::{rap_ka, rap_vd, rap_ke}

// One-compartment oral (first-order absorption), apparent Vd/F, dose in ug -> C in ng/mL.
fn pk_oral(dose_ug: f64, ka: f64, vdf: f64, ke: f64, t: f64) -> f64 with Mut, Div, Panic {
    var d = ka - ke; if d < 0.0 { d = 0.0 - d }
    if d < 0.000000001 { return 0.0 }
    (dose_ug * ka) / (vdf * (ka - ke)) * (exp(0.0 - ke * t) - exp(0.0 - ka * t))
}

fn main() with IO, Mut, Div, Panic {
    let ka_e = rap_ka(); let ka = ka_e.val(); let ka_sd = ka_e.std()
    let vd_e = rap_vd(); let vd = vd_e.val(); let vd_sd = vd_e.std()
    let ke_e = rap_ke(); let ke = ke_e.val(); let ke_sd = ke_e.std()
    let dose = 6000.0  // 6 mg oral loading, in ug

    let n = 200
    var ts:  [f64; 512] = [0.0; 512]
    var cc:  [f64; 512] = [0.0; 512]
    var lo:  [f64; 512] = [0.0; 512]
    var hi:  [f64; 512] = [0.0; 512]
    let tmax = 72.0
    var ymax = 0.0
    var i = 0
    while i < n {
        let t = tmax * ((i as f64) / ((n - 1) as f64))
        let c = pk_oral(dose, ka, vd, ke, t)
        // first-order GUM: symmetric secant per parameter, combined in quadrature
        let g_ka = (pk_oral(dose, ka + ka_sd, vd, ke, t) - pk_oral(dose, ka - ka_sd, vd, ke, t)) / 2.0
        let g_vd = (pk_oral(dose, ka, vd + vd_sd, ke, t) - pk_oral(dose, ka, vd - vd_sd, ke, t)) / 2.0
        let g_ke = (pk_oral(dose, ka, vd, ke + ke_sd, t) - pk_oral(dose, ka, vd, ke - ke_sd, t)) / 2.0
        let sig = sqrt(g_ka * g_ka + g_vd * g_vd + g_ke * g_ke)
        var l = c - 1.96 * sig; if l < 0.0 { l = 0.0 }
        let h = c + 1.96 * sig
        ts[i as usize] = t; cc[i as usize] = c; lo[i as usize] = l; hi[i as usize] = h
        if h > ymax { ymax = h }
        i = i + 1
    }
    ymax = ymax * 1.05

    let w = 512; let h = 360
    var img = image_new(w as i32, h as i32)
    plot_background(&!img, w as i64, h as i64, 0x0E1420)
    let a = area_new(56, 46, 496, 306, 0.0, tmax, 0.0, ymax)
    plot_band(&!img, &a, &ts, &lo, &hi, n, 0x274063)   // 95% GUM band
    plot_line(&!img, &a, &ts, &cc, n, 0xFFC24D)        // mean curve
    plot_axes(&!img, &a, 6, 5, 0x7F8CA6)
    let _t1 = plot_text(&!img, "Rapamycin 6 mg oral PK", 92, 8, 0xE8EEF7)
    let _t2 = plot_text(&!img, "time  h", 224, 330, 0xB8C2D4)
    let _t3 = plot_text(&!img, "C  ng/mL", 56, 28, 0xB8C2D4)
    let ok = png_write("rapamycin_curve.png", &img)
    print("ka="); print(ka); print(" ke="); print(ke); print(" Vd/F="); print(vd)
    print(" | Cmax~"); print(ymax / 1.05); print(" ng/mL | wrote="); print(ok); print("\n")
}
