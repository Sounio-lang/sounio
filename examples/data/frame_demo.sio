// Demo for stdlib/data/frame.sio
//
// This file demonstrates usage of the data::frame module: fixed-capacity
// columns ([T; 64] buffer + length), add_column statuses, and epistemic
// aggregation.
// Module source: stdlib/data/frame.sio

use data::frame::*

// ============================================================================

fn main() -> i32 with IO, Mut, Div, Panic {
    print("Testing DataFrame module...\n")

    var ages: [i64; 64] = [0; 64]
    ages[0] = 25
    ages[1] = 30
    ages[2] = 35
    ages[3] = 40
    var names: [FrameStr; 64] = [frame_str(""); 64]
    names[0] = frame_str("Alice")
    names[1] = frame_str("Bob")
    names[2] = frame_str("Carol")
    names[3] = frame_str("Dave")
    var weights: [f64; 64] = [0.0; 64]
    weights[0] = 65.0
    weights[1] = 78.5
    weights[2] = 55.0
    weights[3] = 82.0

    var df = dataframe_new()
    let age_col = column_int("age", &ages, 4)
    let name_col = column_string("name", &names, 4)
    let weight_col = column_float("weight", &weights, 4)
    if dataframe_add_column(&!df, &age_col) != FRAME_OK { return 1 }
    if dataframe_add_column(&!df, &name_col) != FRAME_OK { return 1 }
    if dataframe_add_column(&!df, &weight_col) != FRAME_OK { return 1 }

    let shape = dataframe_shape(&df)
    if shape.0 != 4 { return 1 }
    if shape.1 != 3 { return 2 }
    print("Shape test: PASS\n")

    // Column access
    let got_age = dataframe_get_column(&df, "age")
    if got_age.int_data[0] != 25 { return 3 }
    print("Column access: PASS\n")

    // Row access
    let row = dataframe_get_row(&df, 1)
    if row_get_string(&row, "name") != "Bob" { return 4 }
    print("Row access: PASS\n")

    // Aggregations
    let sum_weight = dataframe_col_sum(&df, "weight")
    if sum_weight < 280.0 || sum_weight > 281.0 { return 5 }
    let mean_weight = dataframe_col_mean(&df, "weight")
    if mean_weight < 70.0 || mean_weight > 70.2 { return 6 }
    print("Aggregations: PASS\n")

    // Head/tail
    let head_df = dataframe_head(&df, 2)
    if dataframe_nrows(&head_df) != 2 { return 7 }
    let tail_df = dataframe_tail(&df, 2)
    if dataframe_nrows(&tail_df) != 2 { return 8 }
    print("Head/Tail: PASS\n")

    // Filter
    var mask: [bool; 64] = [false; 64]
    mask[0] = true
    mask[2] = true
    let filtered = dataframe_filter(&df, &mask, 4)
    if dataframe_nrows(&filtered) != 2 { return 9 }
    print("Filter: PASS\n")

    // Epistemic column
    var ep_vals: [f64; 64] = [0.0; 64]
    var ep_uncerts: [f64; 64] = [0.0; 64]
    var ep_confs: [f64; 64] = [0.0; 64]
    ep_vals[0] = 100.0
    ep_vals[1] = 102.0
    ep_vals[2] = 98.0
    ep_uncerts[0] = 2.0
    ep_uncerts[1] = 2.0
    ep_uncerts[2] = 2.0
    ep_confs[0] = 0.95
    ep_confs[1] = 0.90
    ep_confs[2] = 0.92

    var df2 = dataframe_new()
    let ep_col = column_epistemic("measurement", &ep_vals, &ep_uncerts, &ep_confs, 3)
    if dataframe_add_column(&!df2, &ep_col) != FRAME_OK { return 10 }
    let ep_mean = dataframe_col_mean_epistemic(&df2, "measurement")
    if ep_mean.value < 99.0 || ep_mean.value > 101.0 { return 10 }
    if ep_mean.uncertainty < 1.0 || ep_mean.uncertainty > 1.5 { return 11 }
    if ep_mean.confidence > 0.91 { return 12 }  // Should be min (0.90)
    print("Epistemic column: PASS\n")

    // Drop column
    let df3 = dataframe_drop_column(&df, "weight")
    if dataframe_ncols(&df3) != 2 { return 13 }
    print("Drop column: PASS\n")

    print("All DataFrame tests PASSED\n")
    0
}
