//@ run-pass
// Wall time is taken outside the process. LOAD_BEGIN/END bracket llama_load.
// Usage: llama_load_bench [model-dir]

use llm::llama::{kv_new, llama_argmax, llama_forward, llama_load}
use tensor2::cpu_kernel::{ck_alloc, ck_set}

fn main() with IO, Mut, Panic, Div, Alloc {
    var dir = "/workspace/llm-models/SmolLM2-135M"
    if arg_count() > 0 { dir = get_arg(0) }
    print("LOAD_BEGIN\n")
    let m = llama_load(dir)
    print("LOAD_END loaded=")
    print_int(if m.loaded { 1 } else { 0 })
    print(" layers=")
    print_int(m.cfg.layers as i64)
    print("\n")
    if !m.loaded { exit(1) }
    var ids = ck_alloc(8)
    ck_set(&!ids, 0, 0.0)
    ck_set(&!ids, 1, 504.0)
    ck_set(&!ids, 2, 3575.0)
    ck_set(&!ids, 3, 282.0)
    ck_set(&!ids, 4, 4649.0)
    ck_set(&!ids, 5, 314.0)
    var kv = kv_new(&m, 32)
    let logits = llama_forward(&m, &!kv, &ids, 6)
    let a = llama_argmax(&logits)
    print("argmax=")
    print_int(a)
    print("\n")
    if a != 7042 { print("LOAD FAIL argmax\n"); exit(1) }
    print("LOAD PASS\n")
}
