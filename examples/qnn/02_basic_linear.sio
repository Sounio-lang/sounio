//! 02_basic_linear.sio
//!
//! Demonstrates a single quaternion linear layer.
//! Shows weight initialization, forward pass, and activation.
//!
//! Run with: cargo run --features jit -- run examples/qnn/02_basic_linear.sio

// Quaternion multiplication: Hamilton product
fn quat_mul(q1: [f32; 4], q2: [f32; 4]) -> [f32; 4] {
    let w = q1[0] * q2[0] - q1[1] * q2[1] - q1[2] * q2[2] - q1[3] * q2[3]
    let x = q1[0] * q2[1] + q1[1] * q2[0] + q1[2] * q2[3] - q1[3] * q2[2]
    let y = q1[0] * q2[2] - q1[1] * q2[3] + q1[2] * q2[0] + q1[3] * q2[1]
    let z = q1[0] * q2[3] + q1[1] * q2[2] - q1[2] * q2[1] + q1[3] * q2[0]
    return [w, x, y, z]
}

// Component-wise ReLU activation
fn quat_relu(q: [f32; 4]) -> [f32; 4] {
    return [
        if q[0] < 0.0 { 0.0 } else { q[0] },
        if q[1] < 0.0 { 0.0 } else { q[1] },
        if q[2] < 0.0 { 0.0 } else { q[2] },
        if q[3] < 0.0 { 0.0 } else { q[3] },
    ]
}

// Quaternion addition
fn quat_add(q1: [f32; 4], q2: [f32; 4]) -> [f32; 4] {
    return [q1[0] + q2[0], q1[1] + q2[1], q1[2] + q2[2], q1[3] + q2[3]]
}

fn main() {
    println("=== QNN Basic Linear Layer ===\n")

    // Step 1: Define the layer dimensions
    println("1. Layer Definition")
    println("   ----------------")
    let input_features = 4
    let output_features = 2

    println("   Created linear layer: 4 → 2 quaternions")
    println("   This means: 4 quaternion inputs, 2 quaternion outputs")

    // Step 2: Initialize weights and bias
    println("\n2. Weight Initialization")
    println("   ---------------------")

    // Simple Xavier-like initialization: small random values
    // In practice, these would be initialized with proper Xavier scaling
    var weights: [f32; 32] = []  // 4 input quats × 2 output quats = 8 quats = 32 floats
    var bias: [f32; 8] = []      // 2 output quats = 8 floats

    // Initialize with example values
    var idx: i32 = 0
    while idx < 32 {
        weights[idx] = 0.1
        idx = idx + 1
    }
    var bidx: i32 = 0
    while bidx < 8 {
        bias[bidx] = 0.01
        bidx = bidx + 1
    }

    println("   Xavier init: scale = sqrt(2 / (fan_in + fan_out))")
    println("   Bias initialized (2 × 4 component values)")

    // Step 3: Create input data
    println("\n3. Input Data")
    println("   ----------")

    // Create 4 input quaternions
    var input: [f32; 16] = []  // 4 quats × 4 components
    var iidx: i32 = 0
    while iidx < 16 {
        input[iidx] = 0.5
        iidx = iidx + 1
    }
    println("   Created input: 4 quaternions")

    // Step 4: Forward pass
    println("\n4. Forward Pass")
    println("   -----------")

    // Linear transformation: y = W ⊗ x + b
    var output: [f32; 8] = []  // 2 output quaternions

    // For each output quaternion
    var o: i32 = 0
    while o < output_features {
        var sum: [f32; 4] = [0.0, 0.0, 0.0, 0.0]

        // For each input quaternion, accumulate Hamilton products
        var i: i32 = 0
        while i < input_features {
            let in_quat: [f32; 4] = [
                input[4 * i],
                input[4 * i + 1],
                input[4 * i + 2],
                input[4 * i + 3],
            ]

            let w_quat: [f32; 4] = [
                weights[4 * (o * input_features + i)],
                weights[4 * (o * input_features + i) + 1],
                weights[4 * (o * input_features + i) + 2],
                weights[4 * (o * input_features + i) + 3],
            ]

            let prod = quat_mul(w_quat, in_quat)
            sum[0] = sum[0] + prod[0]
            sum[1] = sum[1] + prod[1]
            sum[2] = sum[2] + prod[2]
            sum[3] = sum[3] + prod[3]

            i = i + 1
        }

        // Add bias
        let b_quat: [f32; 4] = [bias[4 * o], bias[4 * o + 1], bias[4 * o + 2], bias[4 * o + 3]]
        sum = quat_add(sum, b_quat)

        // Store output
        output[4 * o] = sum[0]
        output[4 * o + 1] = sum[1]
        output[4 * o + 2] = sum[2]
        output[4 * o + 3] = sum[3]

        o = o + 1
    }

    println("   Computed: output = W ⊗ input + bias")
    println("   Output shape: 2 quaternions")

    // Step 5: Apply activation
    println("\n5. Activation Function")
    println("   -------------------")

    var activated: [f32; 8] = []
    var aidx: i32 = 0
    while aidx < output_features {
        let out_quat: [f32; 4] = [output[4 * aidx], output[4 * aidx + 1], output[4 * aidx + 2], output[4 * aidx + 3]]
        let act_quat = quat_relu(out_quat)
        activated[4 * aidx] = act_quat[0]
        activated[4 * aidx + 1] = act_quat[1]
        activated[4 * aidx + 2] = act_quat[2]
        activated[4 * aidx + 3] = act_quat[3]
        aidx = aidx + 1
    }

    println("   Applied ReLU (component-wise)")

    // Step 6: Summary
    println("\n6. Summary")
    println("   -------")
    println("   Layer: 4 → 2 quaternions")
    println("   Weight parameters: 4 × 2 = 8 quaternions = 32 float values")
    println("   Bias parameters: 2 quaternions = 8 float values")
    println("   Total: 40 float values")
    println("")
    println("   Equivalent real-valued network:")
    println("   16 inputs → 8 outputs = 128 + 8 = 136 parameters")
    println("   QNN is 3.4× more parameter-efficient!")

    println("\n=== Done! ===")
    println("Next: See qnn_mnist.sio for a complete training example")
}
