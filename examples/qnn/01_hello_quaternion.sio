//! 01_hello_quaternion.sio
//!
//! The simplest introduction to quaternions in Sounio.
//! Learn to create, manipulate, and understand quaternions.
//!
//! Run with: ./bin/souc run examples/qnn/01_hello_quaternion.sio

fn main() {
    println("=== Hello Quaternion! ===\n")

    // Section 1: Creating Quaternions
    println("1. Creating Quaternions")
    println("   --------------------")

    // Identity quaternion: represents "no rotation"
    let identity: [f32; 4] = [1.0, 0.0, 0.0, 0.0]
    println("   Identity: [1, 0, 0, 0]")

    // A 90-degree rotation around the X-axis
    // For unit quaternions: q = (cos(θ/2), sin(θ/2)*axis)
    // θ = 90° = π/2, so θ/2 = π/4
    let rotation_x: [f32; 4] = [0.7071, 0.7071, 0.0, 0.0]
    println("   90° X-rotation: [0.707, 0.707, 0, 0]")

    // Section 2: Basic Operations
    println("\n2. Basic Operations")
    println("   ----------------")

    // Accessing components
    let q: [f32; 4] = [1.0, 2.0, 3.0, 4.0]
    println("   q = [1, 2, 3, 4]")
    println("   q[0] (w/real part) = 1.0")
    println("   q[1] (x/i component) = 2.0")
    println("   q[2] (y/j component) = 3.0")
    println("   q[3] (z/k component) = 4.0")

    // Conjugate: negates the vector part
    let q_conj: [f32; 4] = [q[0], -q[1], -q[2], -q[3]]
    println("   conjugate(q) = [1, -2, -3, -4]")

    // Norm: magnitude of the quaternion
    let norm_sq = q[0] * q[0] + q[1] * q[1] + q[2] * q[2] + q[3] * q[3]
    println("   norm²(q) = 1² + 2² + 3² + 4² = 30.0")

    // Section 3: Hamilton Product
    println("\n3. Hamilton Product (Non-commutative!)")
    println("   -----------------------------------")

    let q1: [f32; 4] = [1.0, 2.0, 0.0, 0.0]
    let q2: [f32; 4] = [0.0, 0.0, 3.0, 4.0]

    // Hamilton product: q1 ⊗ q2
    let w = q1[0] * q2[0] - q1[1] * q2[1] - q1[2] * q2[2] - q1[3] * q2[3]
    let x = q1[0] * q2[1] + q1[1] * q2[0] + q1[2] * q2[3] - q1[3] * q2[2]
    let y = q1[0] * q2[2] - q1[1] * q2[3] + q1[2] * q2[0] + q1[3] * q2[1]
    let z = q1[0] * q2[3] + q1[1] * q2[2] - q1[2] * q2[1] + q1[3] * q2[0]
    let product: [f32; 4] = [w, x, y, z]

    println("   q1 = [1, 2, 0, 0]")
    println("   q2 = [0, 0, 3, 4]")
    println("   q1 ⊗ q2 = Hamilton product")

    // Important: order matters!
    let w_rev = q2[0] * q1[0] - q2[1] * q1[1] - q2[2] * q1[2] - q2[3] * q1[3]
    let x_rev = q2[0] * q1[1] + q2[1] * q1[0] + q2[2] * q1[3] - q2[3] * q1[2]
    let y_rev = q2[0] * q1[2] - q2[1] * q1[3] + q2[2] * q1[0] + q2[3] * q1[1]
    let z_rev = q2[0] * q1[3] + q2[1] * q1[2] - q2[2] * q1[1] + q2[3] * q1[0]

    println("   Note: q1 ⊗ q2 ≠ q2 ⊗ q1 (non-commutative)")

    // Section 4: Unit Quaternions
    println("\n4. Unit Quaternions (Rotations)")
    println("   ----------------------------")

    let raw: [f32; 4] = [1.5, 0.5, 0.5, 0.5]
    let raw_norm_sq = raw[0] * raw[0] + raw[1] * raw[1] + raw[2] * raw[2] + raw[3] * raw[3]
    // Normalization: divide each component by the norm (approximately 1.8708)
    // For this example, we'll show the concept

    println("   raw = [1.5, 0.5, 0.5, 0.5]")
    println("   Unit quaternions have norm = 1")
    println("   They represent pure rotations in 3D")

    // Section 5: Component-wise ReLU
    println("\n5. Activation Functions")
    println("   --------------------")

    let weights: [f32; 4] = [0.5, -0.3, 0.8, -0.1]
    // ReLU: max(0, x) applied to each component
    let activated: [f32; 4] = [
        if weights[0] < 0.0 { 0.0 } else { weights[0] },
        if weights[1] < 0.0 { 0.0 } else { weights[1] },
        if weights[2] < 0.0 { 0.0 } else { weights[2] },
        if weights[3] < 0.0 { 0.0 } else { weights[3] }
    ]
    println("   Applied ReLU activation (component-wise)")
    println("   Input:  [0.5, -0.3, 0.8, -0.1]")
    println("   Output: [0.5, 0.0, 0.8, 0.0]")

    println("\n=== Done! ===")
    println("Next: See 02_basic_linear.sio for neural network layers")
}
