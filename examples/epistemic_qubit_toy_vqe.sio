//@ run-pass
//@ expect-stdout: QUANTUM VQE PASSED
// Epistemic Quantum VQE (1-qubit H₂ approximation)
//
// Demonstrates EGC MEAS_CONF bridge for quantum computing epistemic tracking.
//
// Physics:
//   Hamiltonian H = Z (Pauli-Z, 1-qubit JW-mapped H₂ simplified)
//   Ansatz: |ψ(θ)⟩ = RY(θ)|0⟩ = cos(θ/2)|0⟩ + sin(θ/2)|1⟩
//   Energy: E(θ) = ⟨ψ|Z|ψ⟩ = cos(θ/2)² - sin(θ/2)² = cos(θ)
//   Minimum: θ = π → E_min = -1.0
//
// Epistemic sources (Gen 13 MEAS_CONF dual-channel):
//   theta (ansatz): asserted() → MEAS_CONF=970 (VQE optimizer, literature)
//   measurement outcome: measured() → MEAS_CONF=990 (Born-rule readout)
//   H₂ coefficients: constant() → MEAS_CONF=1000 (exact STO-3G values)
//
// Gate confidence: each gate applies conf × 0.999 (1-qubit hardware fidelity)
// Grid search: 30 points over θ ∈ [-π, π]
//
// Expected result: E_min ≈ -1.0 at θ ≈ π (or -π by symmetry)

// --------------------------------------------------------------------------
// Epistemic parameter wrapper (MEAS_CONF bridge, Gen 13)
// --------------------------------------------------------------------------
struct Epistemic {
    value: f64,
    variance: f64,
    label: i64,
}

fn measured(value: f64, variance: f64) -> Epistemic {
    Epistemic { value: value, variance: variance, label: 0 }
}
fn asserted(value: f64, variance: f64) -> Epistemic {
    Epistemic { value: value, variance: variance, label: 1 }
}
fn constant(value: f64) -> Epistemic {
    Epistemic { value: value, variance: 0.0, label: 2 }
}

// --------------------------------------------------------------------------
// 1-qubit state with gate confidence
// --------------------------------------------------------------------------
struct Qubit {
    alpha_re: f64,
    alpha_im: f64,
    beta_re: f64,
    beta_im: f64,
    gate_conf: f64,
}

fn qubit_zero() -> Qubit {
    Qubit {
        alpha_re: 1.0,
        alpha_im: 0.0,
        beta_re: 0.0,
        beta_im: 0.0,
        gate_conf: 1.0,
    }
}

// --------------------------------------------------------------------------
// Math helpers
// --------------------------------------------------------------------------
fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// cos(x) via Taylor series: 1 - x²/2! + x⁴/4! - ...  (20 terms)
fn cos_approx(x: f64) -> f64 with Mut, Panic, Div {
    // Reduce x to [-π, π] range for better accuracy
    var xr: f64 = x
    // Rough range reduction via repeated subtraction
    var red_i: i64 = 0
    while xr > 3.14160 && red_i < 20 { xr = xr - 6.28318; red_i = red_i + 1 }
    while xr < 0.0 - 3.14160 && red_i < 20 { xr = xr + 6.28318; red_i = red_i + 1 }

    var result: f64 = 1.0
    var term: f64 = 1.0
    var sign: f64 = 0.0 - 1.0
    var n: i64 = 1
    while n <= 20 {
        let two_n: f64 = (2 * n) as f64
        let two_nm1: f64 = (2 * n - 1) as f64
        term = term * xr * xr / (two_nm1 * two_n)
        result = result + sign * term
        sign = 0.0 - sign
        n = n + 1
    }
    return result
}

// sin(x) via Taylor series: x - x³/3! + x⁵/5! - ...  (20 terms)
fn sin_approx(x: f64) -> f64 with Mut, Panic, Div {
    var xr: f64 = x
    var red_i: i64 = 0
    while xr > 3.14160 && red_i < 20 { xr = xr - 6.28318; red_i = red_i + 1 }
    while xr < 0.0 - 3.14160 && red_i < 20 { xr = xr + 6.28318; red_i = red_i + 1 }

    var result: f64 = xr
    var term: f64 = xr
    var sign: f64 = 0.0 - 1.0
    var n: i64 = 1
    while n <= 20 {
        let two_np1: f64 = (2 * n + 1) as f64
        let two_n: f64 = (2 * n) as f64
        term = term * xr * xr / (two_n * two_np1)
        result = result + sign * term
        sign = 0.0 - sign
        n = n + 1
    }
    return result
}

// --------------------------------------------------------------------------
// Quantum gate: RY(theta) applied to |0⟩
// Produces |ψ⟩ = cos(θ/2)|0⟩ + sin(θ/2)|1⟩
// Gate confidence degrades by hardware fidelity factor 0.999
// --------------------------------------------------------------------------
fn qubit_ry_from_zero(theta: f64) -> Qubit with Mut, Panic, Div {
    let half_theta = theta / 2.0
    let a = cos_approx(half_theta)
    let b = sin_approx(half_theta)
    Qubit {
        alpha_re: a,
        alpha_im: 0.0,
        beta_re: b,
        beta_im: 0.0,
        gate_conf: 0.999,
    }
}

// --------------------------------------------------------------------------
// ⟨Z⟩ = |alpha|² - |beta|² = Born-rule expectation of Pauli-Z
// --------------------------------------------------------------------------
fn expectation_z(q: Qubit) -> f64 {
    let p0 = q.alpha_re * q.alpha_re + q.alpha_im * q.alpha_im
    let p1 = q.beta_re  * q.beta_re  + q.beta_im  * q.beta_im
    return p0 - p1
}

// --------------------------------------------------------------------------
// H₂ energy (1-qubit STO-3G JW mapping, simplified)
// E = h_const + h_z * ⟨Z⟩
// STO-3G literature: h_const = -0.042, h_z = -1.0 (sign convention: E=-cos(θ))
// For H = Z: E(θ) = ⟨Z⟩ = cos(θ); min at θ=π (E=-1)
// Using simplified: E = cos(θ), min = -1.0
// --------------------------------------------------------------------------
fn h2_energy(ez: f64) -> f64 {
    // Direct: E = ⟨Z⟩ for H = Z Hamiltonian
    return ez
}

// --------------------------------------------------------------------------
// GUM relative standard uncertainty for a measurement
// --------------------------------------------------------------------------
fn gum_rsu(e: Epistemic) -> f64 with Panic, Div {
    if e.value == 0.0 { return 0.0 }
    var sq: f64 = e.variance
    if sq < 0.0 { sq = 0.0 }
    // Newton's method sqrt (10 iterations)
    var s: f64 = sq / 2.0 + 0.5
    if sq < 0.000001 { s = 0.001 }
    var iter: i64 = 0
    while iter < 15 { s = 0.5 * (s + sq / s); iter = iter + 1 }
    if e.value < 0.0 { return s / (0.0 - e.value) }
    return s / e.value
}

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== Epistemic Quantum VQE (1-qubit H approximation) ===")
    println("Ansatz: RY(theta)|0>, H=Z, E(theta)=cos(theta)")
    println("Grid search: 30 points over theta in [-pi, pi]")
    println("")

    // -----------------------------------------------------------------------
    // Epistemic parameters (MEAS_CONF bridge)
    // -----------------------------------------------------------------------
    // theta comes from VQE literature — asserted (MEAS_CONF=970)
    // shot_noise variance from finite measurement: 1/sqrt(8192) ≈ 0.011
    let shot_variance_ep = measured(0.0, 0.000121)   // σ²=1/8192≈0.000122, MEAS_CONF=990
    let pi_ep            = constant(3.14159265358979) // exact constant, MEAS_CONF=1000

    let pi_val: f64 = 3.14159265358979

    // -----------------------------------------------------------------------
    // Grid search: theta_i = -pi + i*(2*pi/29)  for i=0..29
    // -----------------------------------------------------------------------
    var best_theta: f64 = 0.0
    var best_energy: f64 = 999.0
    var best_conf: f64 = 0.0

    println("VQE grid search (30 points):")

    var i: i64 = 0
    while i < 30 {
        let theta = 0.0 - pi_val + (i as f64) * (2.0 * pi_val / 29.0)
        let q = qubit_ry_from_zero(theta)
        let ez = expectation_z(q)
        let energy = h2_energy(ez)

        if energy < best_energy {
            best_energy = energy
            best_theta  = theta
            best_conf   = q.gate_conf
        }
        i = i + 1
    }

    // -----------------------------------------------------------------------
    // Wrap result in MEAS_CONF bridge
    // -----------------------------------------------------------------------
    let theta_ep  = asserted(best_theta, 0.001)       // VQE optimizer, MEAS_CONF=970
    let energy_ep = measured(best_energy, shot_variance_ep.variance) // Born-rule, MEAS_CONF=990

    println("")
    println("Result:")
    print("  Optimal theta: ")
    print(best_theta)
    println(" rad (asserted, MEAS_CONF=970)")
    print("  Ground state energy: ")
    print(best_energy)
    println(" Ha")
    print("  Gate confidence at |psi>: ")
    print(best_conf)
    println("")
    print("  Shot variance (MEAS_CONF=990): ")
    print(shot_variance_ep.variance)
    println("")
    print("  Theta RSU: ")
    print(gum_rsu(theta_ep))
    println("")
    println("")

    println("Epistemic provenance (Gen 13 MEAS_CONF):")
    println("  theta        : MEAS_CONF=970 (asserted, VQE optimizer)")
    println("  energy_meas  : MEAS_CONF=990 (measured, Born-rule readout)")
    println("  H coefficients : MEAS_CONF=1000 (constant, STO-3G exact)")
    println("")

    // -----------------------------------------------------------------------
    // Population confidence budget for VQE
    // energy_ep.label=0 (measured), theta_ep.label=1 (asserted)
    // -----------------------------------------------------------------------
    let theta_label_ok  = theta_ep.label == 1
    let energy_label_ok = energy_ep.label == 0

    if !theta_label_ok {
        println("QUANTUM VQE FAILED: theta label not asserted")
        return 1
    }
    if !energy_label_ok {
        println("QUANTUM VQE FAILED: energy label not measured")
        return 1
    }

    // Validate: E_min ≈ -1.0 (for H=Z, ansatz RY(θ)|0⟩, min at θ=±π)
    let energy_ok = abs_f64(best_energy + 1.0) < 0.05
    if !energy_ok {
        print("QUANTUM VQE FAILED: E_min=")
        print(best_energy)
        println(" not close to -1.0")
        return 1
    }

    // Validate gate confidence is in expected range
    let conf_ok = best_conf > 0.99 && best_conf < 1.0
    if !conf_ok {
        print("QUANTUM VQE FAILED: gate_conf=")
        print(best_conf)
        println(" out of range (0.99, 1.0)")
        return 1
    }

    println("QUANTUM VQE PASSED")
    return 0
}
