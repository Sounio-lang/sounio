//@ run-pass
// sedenion_168_verify.sio — Is 336 = 2 × 168 a coincidence?
//
// Octonions: 168 nonzero associators among 343 basis triples
// Sedenions: 336 zero-divisor pairs among basis pair-products
// Sedenions: 336 nonzero associators among 392 cross-half triples
//
// 168 = |PSL(2,7)| = |Aut(Fano)|
// 336 = 2 × 168
//
// Is there a bijection between sedenion zero-divisor pairs and
// nonzero sedenion associators?

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn sqrt_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var r = x
    var i = 0
    while i < 20 { r = 0.5 * (r + x / r); i = i + 1 }
    r
}

struct Oct { e: [f64; 8] }
fn oct_zero() -> Oct { Oct { e: [0.0; 8] } }
fn oct_sub(a: Oct, b: Oct) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    var i: i64 = 0
    while i < 8 { r.e[i as usize] = a.e[i as usize] - b.e[i as usize]; i = i + 1 }
    r
}
fn oct_add(a: Oct, b: Oct) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    var i: i64 = 0
    while i < 8 { r.e[i as usize] = a.e[i as usize] + b.e[i as usize]; i = i + 1 }
    r
}
fn oct_conjugate(o: Oct) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    r.e[0] = o.e[0]
    var i: i64 = 1
    while i < 8 { r.e[i as usize] = 0.0 - o.e[i as usize]; i = i + 1 }
    r
}
fn oct_fano_index(i: i64, j: i64) -> i64 with Mut, Panic, Div {
    if i == j { return 0 }
    var t: [i64; 21] = [0; 21]
    t[0]=1;t[1]=2;t[2]=4; t[3]=2;t[4]=3;t[5]=5; t[6]=3;t[7]=4;t[8]=6
    t[9]=4;t[10]=5;t[11]=7; t[12]=5;t[13]=6;t[14]=1; t[15]=6;t[16]=7;t[17]=2
    t[18]=7;t[19]=1;t[20]=3
    var k: i64 = 0
    while k < 7 {
        let a=t[(k*3) as usize]; let b=t[(k*3+1) as usize]; let c=t[(k*3+2) as usize]
        if (i==a&&j==b)||(i==b&&j==c)||(i==c&&j==a) {
            if i==a&&j==b {return c}; if i==b&&j==c {return a}; return b
        }
        if (i==b&&j==a)||(i==c&&j==b)||(i==a&&j==c) {
            if i==b&&j==a {return c}; if i==c&&j==b {return a}; return b
        }
        k=k+1
    }
    0
}
fn oct_fano_sign(i: i64, j: i64) -> f64 with Mut, Panic, Div {
    if i==j {return -1.0}; if i==0||j==0 {return 1.0}
    var t: [i64; 21] = [0; 21]
    t[0]=1;t[1]=2;t[2]=4; t[3]=2;t[4]=3;t[5]=5; t[6]=3;t[7]=4;t[8]=6
    t[9]=4;t[10]=5;t[11]=7; t[12]=5;t[13]=6;t[14]=1; t[15]=6;t[16]=7;t[17]=2
    t[18]=7;t[19]=1;t[20]=3
    var k: i64 = 0
    while k < 7 {
        let a=t[(k*3) as usize]; let b=t[(k*3+1) as usize]; let c=t[(k*3+2) as usize]
        if (i==a&&j==b)||(i==b&&j==c)||(i==c&&j==a) {return 1.0}
        if (i==b&&j==a)||(i==c&&j==b)||(i==a&&j==c) {return -1.0}
        k=k+1
    }
    0.0
}
fn oct_mul(a: Oct, b: Oct) -> Oct with Mut, Panic, Div {
    var result = oct_zero()
    var i: i64 = 0
    while i < 8 {
        var j: i64 = 0
        while j < 8 {
            let coeff = a.e[i as usize] * b.e[j as usize]
            if i==0&&j==0 { result.e[0] = result.e[0] + coeff }
            else if i==0 { result.e[j as usize] = result.e[j as usize] + coeff }
            else if j==0 { result.e[i as usize] = result.e[i as usize] + coeff }
            else if i==j { result.e[0] = result.e[0] - coeff }
            else {
                let k = oct_fano_index(i, j)
                let sign = oct_fano_sign(i, j)
                result.e[k as usize] = result.e[k as usize] + sign * coeff
            }
            j=j+1
        }
        i=i+1
    }
    result
}

struct Sed { e: [f64; 16] }
fn sed_zero() -> Sed { Sed { e: [0.0; 16] } }
fn sed_unit(idx: i64) -> Sed with Mut, Panic {
    var s = Sed { e: [0.0; 16] }
    if idx >= 0 && idx < 16 { s.e[idx as usize] = 1.0 }
    s
}
fn sed_norm_sq(s: Sed) -> f64 with Mut, Panic, Div {
    var sum: f64 = 0.0
    var i: i64 = 0
    while i < 16 { sum = sum + s.e[i as usize] * s.e[i as usize]; i = i + 1 }
    sum
}
fn sed_norm(s: Sed) -> f64 with Mut, Panic, Div { sqrt_f64(sed_norm_sq(s)) }
fn sed_sub(a: Sed, b: Sed) -> Sed with Mut, Panic, Div {
    var r = sed_zero()
    var i: i64 = 0
    while i < 16 { r.e[i as usize] = a.e[i as usize] - b.e[i as usize]; i = i + 1 }
    r
}
fn sed_to_oct_pair(s: Sed) -> (Oct, Oct) with Mut, Panic, Div {
    var a = oct_zero(); var b = oct_zero()
    var i: i64 = 0
    while i < 8 {
        a.e[i as usize] = s.e[i as usize]
        b.e[i as usize] = s.e[(i + 8) as usize]
        i = i + 1
    }
    (a, b)
}
fn sed_from_oct_pair(a: Oct, b: Oct) -> Sed with Mut, Panic, Div {
    var s = sed_zero()
    var i: i64 = 0
    while i < 8 {
        s.e[i as usize] = a.e[i as usize]
        s.e[(i + 8) as usize] = b.e[i as usize]
        i = i + 1
    }
    s
}
fn sed_mul(p: Sed, q: Sed) -> Sed with Mut, Panic, Div {
    let pp = sed_to_oct_pair(p)
    let qp = sed_to_oct_pair(q)
    let a = pp.0; let b = pp.1; let c = qp.0; let d = qp.1
    let d_conj = oct_conjugate(d)
    let c_conj = oct_conjugate(c)
    let real_part = oct_sub(oct_mul(a, c), oct_mul(d_conj, b))
    let imag_part = oct_add(oct_mul(d, a), oct_mul(b, c_conj))
    sed_from_oct_pair(real_part, imag_part)
}
fn sed_associator(a: Sed, b: Sed, c: Sed) -> Sed with Mut, Panic, Div {
    let ab = sed_mul(a, b)
    let bc = sed_mul(b, c)
    sed_sub(sed_mul(ab, c), sed_mul(a, bc))
}

fn main() -> i32 with IO, Mut, Panic, Div {
    println("================================================================")
    println("  THE 168 INVESTIGATION")
    println("================================================================")
    println("")

    // 1. Count octonion nonzero associators (all i,j,k in 1..7)
    println("--- Octonion basis associators (i,j,k in 1..7) ---")
    var oct_total: i32 = 0
    var oct_nonzero: i32 = 0
    var i: i64 = 1
    while i <= 7 {
        var j: i64 = 1
        while j <= 7 {
            var k: i64 = 1
            while k <= 7 {
                // Compute oct associator using sedenion infrastructure
                // (embed octonion basis in sedenion)
                let a = sed_unit(i)
                let b = sed_unit(j)
                let c = sed_unit(k)
                let assoc = sed_associator(a, b, c)
                let n = sed_norm(assoc)
                oct_total = oct_total + 1
                if n > 1e-9 { oct_nonzero = oct_nonzero + 1 }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    print("  Total: "); print(oct_total); print("  Nonzero: "); println(oct_nonzero)
    println("")

    // 2. Count sedenion cross-half nonzero associators (i in 1..7, j in 8..15, k in 1..7)
    println("--- Sedenion cross-half associators (i<8, j>=8, k<8) ---")
    var sed_total: i32 = 0
    var sed_nonzero: i32 = 0
    i = 1
    while i <= 7 {
        var j: i64 = 8
        while j <= 15 {
            var k: i64 = 1
            while k <= 7 {
                let a = sed_unit(i)
                let b = sed_unit(j)
                let c = sed_unit(k)
                let assoc = sed_associator(a, b, c)
                let n = sed_norm(assoc)
                sed_total = sed_total + 1
                if n > 1e-9 { sed_nonzero = sed_nonzero + 1 }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    print("  Total: "); print(sed_total); print("  Nonzero: "); println(sed_nonzero)
    println("")

    // 3. Count ALL sedenion nonzero associators (i,j,k in 1..15)
    println("--- Sedenion ALL basis associators (i,j,k in 1..15) ---")
    var all_total: i32 = 0
    var all_nonzero: i32 = 0
    var all_zero: i32 = 0
    i = 1
    while i <= 15 {
        var j: i64 = 1
        while j <= 15 {
            var k: i64 = 1
            while k <= 15 {
                let a = sed_unit(i)
                let b = sed_unit(j)
                let c = sed_unit(k)
                let assoc = sed_associator(a, b, c)
                let n = sed_norm(assoc)
                all_total = all_total + 1
                if n > 1e-9 { all_nonzero = all_nonzero + 1 }
                else { all_zero = all_zero + 1 }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    print("  Total: "); print(all_total)
    print("  Nonzero: "); print(all_nonzero)
    print("  Zero: "); println(all_zero)
    println("")

    // 4. The key numbers
    println("--- THE NUMBERS ---")
    println("")
    print("  Octonion nonzero associators:       "); println(oct_nonzero)
    print("  Sedenion cross-half nonzero assoc:   "); println(sed_nonzero)
    print("  Sedenion ALL nonzero associators:    "); println(all_nonzero)
    print("  Sedenion zero-divisor pairs (from hunt): 336")
    println("")
    println("")
    print("  168 * 2 = 336?  "); println(168 * 2)
    print("  |PSL(2,7)| = 168")
    println("")
    println("")

    // Ratios
    print("  Oct zero fraction: "); print(343 - oct_nonzero); print("/343 = ")
    // manually: if oct_nonzero = 168, then zeros = 175
    println("")
    print("  Sed(all) zero fraction: "); print(all_zero); print("/"); println(all_total)
    println("")

    println("================================================================")

    0
}
