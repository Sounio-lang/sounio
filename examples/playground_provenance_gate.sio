// Playground provenance gate
//
// Encodes the minimum provenance needed before a viewer scene can claim that
// it is scientifically linked to an artifact and generation path.

struct ProvenanceGate {
    dataset_selected: i64,
    artifact_linked: i64,
    generation_path_linked: i64,
    provenance_confidence: i64, // ×10³
}

fn remembered_provenance() -> ProvenanceGate {
    return ProvenanceGate {
        dataset_selected: 1,
        artifact_linked: 1,
        generation_path_linked: 1,
        provenance_confidence: 920,
    }
}

fn observed_provenance() -> ProvenanceGate {
    return ProvenanceGate {
        dataset_selected: 1,
        artifact_linked: 1,
        generation_path_linked: 1,
        provenance_confidence: 975,
    }
}

fn provenance_gate_ok(gate: ProvenanceGate) -> i64 {
    if gate.dataset_selected != 1 { return 0 }
    if gate.artifact_linked != 1 { return 0 }
    if gate.generation_path_linked != 1 { return 0 }
    if gate.provenance_confidence < 900 { return 0 }
    return 1
}

fn stronger_confidence(a: i64, b: i64) -> i64 {
    if a > b { return a }
    return b
}

fn main() -> i64 with IO {
    let remembered = remembered_provenance()
    let observed = observed_provenance()
    let strongest = stronger_confidence(
        remembered.provenance_confidence,
        observed.provenance_confidence
    )

    print("playground provenance gate\n")
    print("remembered gate: ")
    print_int(provenance_gate_ok(remembered))
    print("\n")
    print("observed gate: ")
    print_int(provenance_gate_ok(observed))
    print("\n")
    print("strongest confidence: ")
    print_int(strongest)
    print("\n")

    return 0
}
