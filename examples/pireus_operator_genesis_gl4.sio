//@ run-pass
//!
//! First Sounio-produced GL(4,2) and sign-gauge Operator Genesis transcript.

use hardware::pireus::operator_genesis_gl4::{
    GL4GenesisDigest,
    PIREUS_GL4_OK,
    pireus_operator_genesis_gl4_request,
    pireus_operator_genesis_gl4_evaluate,
    pireus_operator_genesis_gl4_frozen_mismatch_code,
    pireus_operator_genesis_gl4_matches_frozen_semantics,
}

fn bool_i64(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(digest: &GL4GenesisDigest) with IO, Mut, Panic {
    var index: i64 = 0
    while index < 8 {
        if index > 0 { print(":") }
        print_int(digest.words[index])
        index = index + 1
    }
}

fn print_digest_words(words: &[i64; 128], start: i64)
with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(words[start + word])
        word = word + 1
    }
}

fn print_corpus_digest_words(words: &[i64; 24], start: i64)
with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(words[start + word])
        word = word + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_operator_genesis_gl4_request()
    let result = pireus_operator_genesis_gl4_evaluate(&request)
    print("SOUNIO_AUTHORITY schema=pireus-operator-genesis-gl4.v1 role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE\n")

    print("PIREUS_GL4_GROUP encodings_scanned=")
    print_int(result.group.encodings_scanned)
    print(" matrices="); print_int(result.group.matrix_count)
    print(" bfs_count="); print_int(result.group.bfs_count)
    print(" set_mismatches="); print_int(result.group.set_mismatches)
    print(" bfs_noninvertible="); print_int(result.group.bfs_noninvertible)
    print(" bfs_overflow="); print_int(bool_i64(result.group.bfs_overflow))
    print(" identity_present=")
    print_int(bool_i64(result.group.identity_present))
    print(" sorted_unique="); print_int(bool_i64(result.group.sorted_unique))
    print(" operand_orders="); print_int(result.group.operand_orders)
    print(" linear_swap_actions=")
    print_int(result.group.linear_swap_actions)
    print(" complete="); print_int(bool_i64(result.group.complete)); print("\n")

    print("PIREUS_GL4_GAUGE functions=")
    print_int(result.gauge.gauge_functions)
    print(" kernel="); print_int(result.gauge.kernel_count)
    print(" distinct_actions="); print_int(result.gauge.distinct_actions)
    print(" tree_edges="); print_int(result.gauge.tree_edges)
    print(" quotient_exact="); print_int(bool_i64(result.gauge.quotient_exact))
    print(" declared_action_universe=82575360\n")

    var ordinal: i64 = 0
    while ordinal < result.search.candidates_evaluated {
        print("PIREUS_GL4_CANDIDATE ordinal="); print_int(ordinal)
        print(" mask="); print_int(result.search.candidate_masks[ordinal])
        print(" quotient_distance=")
        print_int(result.search.candidate_distances[ordinal])
        print(" canonical_matrix=")
        print_int(result.search.candidate_matrices[ordinal])
        print(" canonical_swap=")
        print_int(bool_i64(result.search.candidate_swaps[ordinal]))
        print(" nearest_corpus=")
        print_int(result.search.candidate_nearest_corpus[ordinal])
        print(" equivalent=")
        print_int(bool_i64(result.search.candidate_equivalent[ordinal]))
        print(" declared_equivalence_class=")
        print_int(result.search.candidate_equivalence_classes[ordinal])
        print(" canonical_digest=")
        print_digest_words(
            &result.search.candidate_canonical_digest_words, ordinal * 8)
        print("\n")
        ordinal = ordinal + 1
    }

    print("PIREUS_GL4_DECLARED_EQUIVALENCE_CLASSES count=")
    print_int(result.search.candidate_equivalence_class_count); print("\n")
    var corpus_id: i64 = 1
    while corpus_id <= 3 {
        print("PIREUS_GL4_CORPUS_CANONICAL corpus="); print_int(corpus_id)
        print(" digest=")
        print_corpus_digest_words(
            &result.search.corpus_canonical_digest_words, (corpus_id - 1) * 8)
        print("\n")
        corpus_id = corpus_id + 1
    }

    let selected = &result.search.selected
    print("PIREUS_GL4_SELECTED ordinal=")
    print_int(selected.generation_ordinal)
    print(" mask="); print_int(selected.phase_mask)
    print(" canonical_quotient_distance=")
    print_int(selected.canonical_quotient_distance)
    print(" canonical_matrix="); print_int(selected.canonical_matrix)
    print(" canonical_swap="); print_int(bool_i64(selected.canonical_swap))
    print(" nearest_corpus="); print_int(selected.nearest_corpus_id)
    print(" equivalent=")
    print_int(bool_i64(selected.equivalent_to_corpus))
    print(" declared_gl4_gauge_inequivalence=")
    print_int(bool_i64(selected.declared_gl4_gauge_inequivalence))
    print("\n")

    print("PIREUS_GL4_CANONICAL actions_considered=")
    print_int(result.selected_key.actions_considered)
    print(" diagonal_finalists=")
    print_int(result.selected_key.diagonal_finalists)
    print(" commutator_finalists=")
    print_int(result.selected_key.commutator_finalists)
    print(" normalized_actions=")
    print_int(result.selected_key.normalized_actions)
    print(" valid="); print_int(bool_i64(result.selected_key.valid)); print("\n")

    print("PIREUS_GL4_INVARIANCE gauge_checks=")
    print_int(result.gauge_invariance_checks)
    print(" gauge_failures="); print_int(result.gauge_invariance_failures)
    print(" generator_checks="); print_int(result.generator_invariance_checks)
    print(" generator_failures=")
    print_int(result.generator_invariance_failures); print("\n")

    print("PIREUS_GL4_WITNESS present=")
    print_int(bool_i64(result.witness.present))
    print(" corpus="); print_int(result.witness.corpus_id)
    print(" i="); print_int(result.witness.i)
    print(" j="); print_int(result.witness.j)
    print(" candidate_sign="); print_int(result.witness.candidate_sign)
    print(" corpus_sign="); print_int(result.witness.corpus_sign)
    print(" canonical_quotient_distance=")
    print_int(result.witness.canonical_quotient_distance); print("\n")

    print("PIREUS_GL4_FINGERPRINT positive=")
    print_int(result.fingerprint.positive_count)
    print(" negative="); print_int(result.fingerprint.negative_count)
    print(" commutator_defects=")
    print_int(result.fingerprint.commutator_defects)
    print(" associator_defects=")
    print_int(result.fingerprint.associator_defects); print("\n")
    var displacement: i64 = 0
    while displacement < 16 {
        print("PIREUS_GL4_DISPLACEMENT d="); print_int(displacement)
        print(" negatives=")
        print_int(result.fingerprint.displacement_negative_counts[displacement])
        print("\n")
        displacement = displacement + 1
    }

    var row: i64 = 0
    while row < 16 {
        print("PIREUS_GL4_CANONICAL_ROW row="); print_int(row); print(" bits=")
        var column: i64 = 0
        while column < 16 {
            print_int(result.selected_key.table[row * 16 + column])
            column = column + 1
        }
        print("\n")
        row = row + 1
    }

    print("PIREUS_GL4_RECEIPT relative_semantic_novelty=")
    print_int(bool_i64(result.receipt.relative_semantic_novelty))
    print(" declared_corpus_only=")
    print_int(bool_i64(result.receipt.declared_corpus_only))
    print(" declared_grammar_exhaustive=")
    print_int(bool_i64(result.receipt.declared_grammar_exhaustive))
    print(" all_sign_tables_exhausted=")
    print_int(bool_i64(result.receipt.all_sign_tables_exhausted))
    print(" base_twist_assumed=")
    print_int(bool_i64(result.receipt.base_twist_assumed))
    print(" declared_gl4_gauge_inequivalence=")
    print_int(bool_i64(result.receipt.declared_gl4_gauge_inequivalence))
    print(" relative_monomial_gauge_novelty=")
    print_int(bool_i64(result.receipt.relative_monomial_gauge_novelty))
    print(" relative_algebraic_novelty=")
    print_int(bool_i64(result.receipt.relative_algebraic_novelty))
    print(" algebra_isomorphism_complete=")
    print_int(bool_i64(result.receipt.algebra_isomorphism_complete))
    print(" quotient_distance_not_orbit_hamming=")
    print_int(bool_i64(result.receipt.quotient_distance_not_orbit_hamming))
    print(" global_novelty=")
    print_int(bool_i64(result.receipt.global_novelty))
    print(" scientific_novelty=")
    print_int(bool_i64(result.receipt.scientific_novelty))
    print(" source_hash_bound=")
    print_int(bool_i64(result.receipt.source_hash_bound))
    print(" semantics_hash_bound=")
    print_int(bool_i64(result.receipt.semantics_hash_bound))
    print(" parity_open="); print_int(bool_i64(result.receipt.parity_open))
    print(" claim_ready="); print_int(bool_i64(result.receipt.claim_ready))
    print("\n")

    print("PIREUS_GL4_DIGEST grammar="); print_digest(&result.grammar_digest)
    print(" matrix="); print_digest(&result.matrix_digest)
    print(" gauge="); print_digest(&result.gauge_digest)
    print(" corpus="); print_digest(&result.corpus_digest)
    print(" search="); print_digest(&result.search_digest)
    print(" candidate="); print_digest(&result.candidate_digest)
    print(" canonical="); print_digest(&result.canonical_digest)
    print(" witness="); print_digest(&result.witness_digest)
    print(" receipt="); print_digest(&result.receipt_digest); print("\n")

    print("PIREUS_GL4_NEGATIVES passed="); print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")
    print("PIREUS_GL4_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(result.failures)
    print(" frozen_match=")
    print_int(bool_i64(
        pireus_operator_genesis_gl4_matches_frozen_semantics(&result)))
    print(" frozen_mismatch_code=")
    print_int(pireus_operator_genesis_gl4_frozen_mismatch_code(&result))
    print(" valid="); print_int(bool_i64(result.valid)); print("\n")
    if result.valid && result.error == PIREUS_GL4_OK &&
        result.failures == 0 { 0 } else { 1 }
}
