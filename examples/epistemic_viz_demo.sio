// examples/epistemic_viz_demo.sio
// Demo completo das 5 moves + image viewer em Sounio real (Option B)
// Compile com: ./bin/souc run examples/epistemic_viz_demo.sio

use graphics::epistemic::{
    new_epistemic_curve, add_glyph, build_epistemic_figure, EpistemicGlyphSpec,
    provenance_kind_measured, provenance_kind_model,
    provenance_kind_literature, provenance_kind_simulation,
    confidence_decay_config_default,
    draw_epistemic_figure_to_surface
}
use graphics::surface::{surface_new}
use graphics::view

fn main() -> i64 with IO, Mut, Panic, Div {
    println("=== Epistemic Visualization Demo (Sounio native - Option B) ===")
    println("Construindo figura com decay curve + 4 provenance glyphs de formas diferentes...")

    // Dados de exemplo (curva decaindo com confiança caindo)
    var xs: [f64; 256] = [0.0; 256]
    var ys: [f64; 256] = [0.0; 256]
    var conf: [f64; 256] = [0.0; 256]
    let n: i64 = 16

    var i: i64 = 0
    while i < n {
        xs[i] = (i as f64) * 0.6
        ys[i] = 50.0 - (i as f64) * 1.5 + (i as f64) * (i as f64) * 0.04
        conf[i] = if i < 7 { 0.95 - (i as f64) * 0.03 } else { 0.72 - (i as f64) * 0.08 }
        if conf[i] < 0.08 { conf[i] = 0.08 }
        i = i + 1
    }

    // Move 5: Builder
    var fig = new_epistemic_curve(xs, ys, conf, n)

    // Adiciona glyphs com placement (moves 1 + 3)
    fig = add_glyph(fig, EpistemicGlyphSpec {
        data_index: 3,
        kind: provenance_kind_measured(),
        offset_x: 2, offset_y: -3
    })
    fig = add_glyph(fig, EpistemicGlyphSpec {
        data_index: 8,
        kind: provenance_kind_model(),
        offset_x: 1, offset_y: 2
    })
    fig = add_glyph(fig, EpistemicGlyphSpec {
        data_index: 12,
        kind: provenance_kind_literature(),   // diamond
        offset_x: -2, offset_y: 3
    })
    fig = add_glyph(fig, EpistemicGlyphSpec {
        data_index: 14,
        kind: provenance_kind_simulation(),   // triangle
        offset_x: 3, offset_y: 1
    })

    // Move 4: Usa Surface (pode ser TiledSurface também)
    let s = surface_new(256, 180)
    let drawn = draw_epistemic_figure_to_surface(&fig, s, confidence_decay_config_default())

    // O image viewer real em Sounio!
    println("\n=== Visualização no terminal (graphics::view) ===")
    view::show(&drawn)

    // High-quality epistemic viewers (colored half-block + Unicode glyphs)
    println("\n=== Epistemic viewer (colored bands + provenance glyphs) ===")
    view::show_epistemic(&fig)

    // SOTA++ braille high-density mode (4× vertical resolution via braille cells)
    println("\n=== Epistemic viewer (braille high-res line) ===")
    view::show_epistemic_braille(&fig)

    // Move 5 + Lens: Build the figure properly then view it with the full instrument
    let fig = build_epistemic_figure(fig.xs, fig.ys, fig.conf, fig.n, fig.glyphs, fig.glyph_count)

    // The true Sounio-native instrument
    // This single call executes Moves 1-2-3-4-5 in parallel and adds the unique
    // Sounio epistemic lens on top (glyph decay + rings + provenance threads +
    // intelligent placement + Tiled-ready + automatic legend + signature panel).
    println("\n=== EPISTEMIC LENS — All 5 moves in parallel + Sounio signature ===")
    view::show_epistemic_lens(&fig)

    println("\n=== Versão SVG para publicação (moves 2 + 5) ===")
    // (a versão completa to_svg emitiria os glyphs + legend automaticamente)
    println("SVG seria gerado aqui com a legenda automática e glyphs de formas diferentes.")
    println("Você pode copiar a lógica do svg_draw_provenance_legend + svg_draw_provenance_glyph para uma versão completa.")

    println("\nTudo em Sounio puro. Sem matplotlib. Sem FFI por enquanto.")
    0
}
