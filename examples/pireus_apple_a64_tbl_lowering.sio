//@ run-pass
//!
//! First Sounio authority stream for the Apple A64 TBL XOR candidate.

use hardware::pireus::apple_a64_tbl_lowering::{
    PIREUS_APPLE_A64_OK,
    pireus_apple_a64_tbl_evaluate,
}

fn bool_i64(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(words: &[i64; 8]) with IO, Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if i > 0 { print(":") }
        print_int(words[i])
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 10 {
        print("usage: pireus_apple_a64_tbl_lowering <garden> <lowering-source> <lowering-semantics> <lowering-receipt> <aarchmrs-source> <aarchmrs-semantics> <aarchmrs-receipt> <tbl-xml> <tbx-xml> <notice-xml>\n")
        return 2
    }
    let result = pireus_apple_a64_tbl_evaluate(
        get_arg(0), get_arg(1), get_arg(2), get_arg(3), get_arg(4),
        get_arg(5), get_arg(6), get_arg(7), get_arg(8), get_arg(9))
    var failures = result.failures
    if !result.valid || result.error != PIREUS_APPLE_A64_OK {
        failures = failures + 1
    }

    print("SOUNIO_AUTHORITY schema=pireus-apple-a64-tbl-xor-lowering.v1 role=SEMANTIC_AUTHORITY\n")
    print("PIREUS_APPLE_PARENTS garden=")
    print_int(bool_i64(result.parents.garden_match))
    print(" lowering_source=")
    print_int(bool_i64(result.parents.lowering_source_match))
    print(" lowering_semantics=")
    print_int(bool_i64(result.parents.lowering_semantics_match))
    print(" lowering_receipt=")
    print_int(bool_i64(result.parents.lowering_receipt_match))
    print(" aarchmrs_source=")
    print_int(bool_i64(result.parents.aarchmrs_source_match))
    print(" aarchmrs_semantics=")
    print_int(bool_i64(result.parents.aarchmrs_semantics_match))
    print(" aarchmrs_receipt=")
    print_int(bool_i64(result.parents.aarchmrs_receipt_match))
    print(" aarchmrs_corpus=")
    print_int(bool_i64(result.parents.aarchmrs_corpus_binding_match))
    print(" tbl_xml="); print_int(bool_i64(result.parents.tbl_xml_match))
    print(" tbx_xml="); print_int(bool_i64(result.parents.tbx_xml_match))
    print(" notice_xml="); print_int(bool_i64(result.parents.notice_xml_match))
    print(" valid="); print_int(bool_i64(result.parents.valid)); print("\n")

    print("PIREUS_APPLE_A64_XML root=")
    print_int(result.semantics.root_sections)
    print(" advsimd_docvars="); print_int(result.semantics.advsimd_docvars)
    print(" a64_docvars="); print_int(result.semantics.a64_docvars)
    print(" tbl_docvars="); print_int(result.semantics.tbl_docvars)
    print(" encodings="); print_int(result.semantics.encoding_count)
    print(" declared_encodings="); print_int(result.semantics.declared_encodings)
    print(" q_width="); print_int(result.semantics.q_field_width)
    print(" len_width="); print_int(result.semantics.len_field_width)
    print(" decode_blocks="); print_int(result.semantics.decode_blocks)
    print(" execute_blocks="); print_int(result.semantics.execute_blocks)
    print(" complete="); print_int(bool_i64(result.semantics.complete)); print("\n")

    print("PIREUS_APPLE_A64_ASL datasize=")
    print_int(bool_i64(result.semantics.datasize_rule))
    print(" elements="); print_int(bool_i64(result.semantics.elements_rule))
    print(" registers="); print_int(bool_i64(result.semantics.registers_rule))
    print(" is_tbl="); print_int(bool_i64(result.semantics.tbl_discriminator_rule))
    print(" table_storage="); print_int(bool_i64(result.semantics.table_storage_rule))
    print(" table_register="); print_int(bool_i64(result.semantics.table_register_rule))
    print(" zero_default="); print_int(bool_i64(result.semantics.zero_default_rule))
    print(" byte_index="); print_int(bool_i64(result.semantics.byte_index_rule))
    print(" table_bound="); print_int(bool_i64(result.semantics.table_bound_rule))
    print(" byte_lookup="); print_int(bool_i64(result.semantics.byte_lookup_rule))
    print(" destination="); print_int(bool_i64(result.semantics.destination_write_rule))
    print("\n")

    print("PIREUS_APPLE_A64_GEOMETRY table_registers=")
    print_int(result.candidate.table_registers)
    print(" table_bits="); print_int(result.candidate.table_bits)
    print(" table_bytes="); print_int(result.candidate.table_bytes)
    print(" output_bits="); print_int(result.candidate.output_bits)
    print(" output_bytes="); print_int(result.candidate.output_bytes)
    print(" f64_per_table="); print_int(result.candidate.f64_per_table)
    print(" f64_per_output="); print_int(result.candidate.f64_per_output)
    print(" vectors_per_displacement=")
    print_int(result.candidate.output_vectors_per_displacement)
    print(" abstract_tbl_applications=")
    print_int(result.candidate.abstract_tbl_applications)
    print("\n")

    print("PIREUS_APPLE_A64_COVERAGE displacements=")
    print_int(result.candidate.displacement_count)
    print(" logical_cells="); print_int(result.candidate.logical_cells)
    print(" matched_cells="); print_int(result.candidate.matched_cells)
    print(" mismatched_cells="); print_int(result.candidate.mismatched_cells)
    print(" in_domain_sources=")
    print_int(result.candidate.in_domain_source_cells)
    print(" out_of_domain_sources=")
    print_int(result.candidate.out_of_domain_source_cells)
    print(" bijective_displacements=")
    print_int(result.candidate.bijective_displacements)
    print(" dimension_matches_bits=")
    print_int(bool_i64(result.candidate.dimension_matches_bits))
    print(" byte_controls="); print_int(result.candidate.byte_control_cells)
    print(" matched_byte_controls=")
    print_int(result.candidate.matched_byte_controls)
    print(" payload_bits="); print_int(result.candidate.symbolic_payload_bits)
    print(" matched_payload_bits=")
    print_int(result.candidate.matched_payload_bits)
    print(" max_control="); print_int(result.candidate.max_control)
    print(" out_of_range="); print_int(result.candidate.out_of_range_controls)
    print(" same_group=")
    print_int(bool_i64(result.candidate.same_source_group_per_output))
    print(" index_coverage=")
    print_int(bool_i64(result.candidate.logical_index_coverage))
    print(" payload_addresses_preserved=")
    print_int(bool_i64(
        result.candidate.symbolic_payload_address_preservation))
    print(" xor_permute_candidate=")
    print_int(bool_i64(result.candidate.xor_permute_candidate))
    print(" unresolved_other_nodes=")
    print_int(result.candidate.unresolved_other_nodes)
    print(" exact_tree_refused=")
    print_int(bool_i64(result.candidate.exact_tree_reduction_refused))
    print("\n")

    print("PIREUS_APPLE_A64_DIGEST candidate=")
    print_digest(&result.candidate.digest.words); print("\n")
    print("PIREUS_APPLE_A64_NEGATIVES passed=")
    print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")
    print("PIREUS_APPLE_BOUNDARY canonical=")
    print_int(bool_i64(result.apple_silicon_canonical))
    print(" observed="); print_int(bool_i64(result.apple_silicon_observed))
    print(" material_receipts="); print_int(result.apple_material_receipt_count)
    print(" compiler_emissions="); print_int(result.compiler_emission_count)
    print(" costs="); print_int(result.cost_record_count)
    print(" parity_open="); print_int(bool_i64(result.parity_open))
    print(" claim_ready="); print_int(bool_i64(result.claim_ready)); print("\n")
    print("PIREUS_APPLE_A64_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(failures); print("\n")

    if failures == 0 { 0 } else { 1 }
}
