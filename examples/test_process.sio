// Test program for stdlib/os/process.sio
// Demonstrates all process information functions

extern "C" {
    fn getpid() -> i32;
    fn getppid() -> i32;
    fn exit(status: i32) -> !;
    fn abort() -> !;
}

// Process ID functions
fn process_id() -> u32 with IO {
    getpid() as u32
}

fn process_parent_id() -> u32 with IO {
    getppid() as u32
}

// Process exit functions (typed but not called in tests)
fn process_exit(code: i32) -> ! with IO {
    exit(code)
}

fn process_abort() -> ! with IO {
    abort()
}

// Process arguments (simplified)
fn process_args() -> [string; 0] with IO {
    []
}

// Main test function
fn main() -> i32 with IO {
    println("=== Process Information Tests ===");

    let pid = process_id();
    println("Current PID: ");
    println(pid);

    let ppid = process_parent_id();
    println("Parent PID: ");
    println(ppid);

    let args = process_args();
    println("Arguments: (empty array)");

    println("Exit/abort functions available (not tested to avoid termination)");
    println("All tests passed!");

    return 0
}
