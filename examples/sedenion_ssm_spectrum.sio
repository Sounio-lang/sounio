//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// Door G — Spectral analysis of R_A : ℝ¹⁶ → ℝ¹⁶, R_A(h) = A · h
// ═══════════════════════════════════════════════════════════════════════════
//
// We've shown α=0.2 is optimal (Door C), G₂-specific (Door E), and
// orbit-universal (Door F). Door G asks the mechanistic question:
// what changes about the linear operator R_A as α moves through 0.2?
//
// R_A is the 16×16 real matrix sending h → A·h via Cayley-Dickson mul.
// Its column j is A·e_j, computable as 16 sed_muls.
//
// Spectral probes (as functions of α):
//   1. ‖R_A‖_F²  =  Σ_j |A·e_j|²        (Frobenius norm; total energy)
//   2. ‖R_A‖_op  ≈  top eigenvalue of R_A^T R_A via power iteration
//                   uses left-adjoint identity: R_A^T = mul-by-conj(A) on left
//   3. min_j |A·e_j|  (lower bound on smallest singular value)
//   4. ‖R_A^T R_A − I‖_F  (isometry defect; how non-orthogonal R_A is)
//      Built from off-diagonal Gram entries G[i,j] = ⟨A·e_i, A·e_j⟩.
//
// For composition algebras (quaternion, octonion), R_A is orthogonal when
// |A|=1 → isometry defect ≡ 0. Sedenions are non-composition; defect ≠ 0
// in general. As α moves toward the ZD locus, the defect should change in
// some structured way.
//
// We sweep α at fine resolution {0.0, 0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5, 0.7, 1.0}
// and report all four probes per α.

use math::sedenion::*;

// ─── Helpers ──────────────────────────────────────────────────────────────────

fn sqrt_s(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y: f64 = x
    var i: i64 = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn abs_s(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

// ─── Probe storage (indexed by α-step, max 16 α values) ──────────────────────

var ALPHAS:    [f64; 16] = [0.0; 16]
var FROB_NSQ:  [f64; 16] = [0.0; 16]
var OP_NORM:   [f64; 16] = [0.0; 16]
var MIN_BASIS: [f64; 16] = [0.0; 16]
var ISO_DEF:   [f64; 16] = [0.0; 16]

fn alpha_at(i: i64) -> f64 {
    if i ==  0 { return 0.0 }
    if i ==  1 { return 0.05 }
    if i ==  2 { return 0.1 }
    if i ==  3 { return 0.15 }
    if i ==  4 { return 0.2 }
    if i ==  5 { return 0.25 }
    if i ==  6 { return 0.3 }
    if i ==  7 { return 0.4 }
    if i ==  8 { return 0.5 }
    if i ==  9 { return 0.7 }
    1.0
}
fn n_alpha() -> i64 { 11 }

// ─── Frobenius norm² and min basis norm ───────────────────────────────────────

fn frob_min_basis(a: Sedenion) -> f64 with Mut, Div, Panic {
    // Returns Frobenius norm². Side effect: writes min_basis to global.
    var sum_sq: f64 = 0.0
    var min_n:  f64 = 99.0
    var j: i64 = 0
    while j < 16 {
        let ej:  Sedenion = sed_basis(j, 1.0)
        let aej: Sedenion = sed_mul(a, ej)
        let n_sq: f64 = sed_norm_sq(aej)
        let n:    f64 = sqrt_s(n_sq)
        sum_sq = sum_sq + n_sq
        if n < min_n { min_n = n }
        j = j + 1
    }
    LAST_MIN_BASIS = min_n
    sum_sq
}

var LAST_MIN_BASIS: f64 = 0.0

// ─── Operator norm via power iteration on R_A^T R_A ──────────────────────────
// R_A v = sed_mul(A, v).  R_A^T u = sed_mul(conj(A), u)  (left adjoint).

fn op_norm_power(a: Sedenion, n_iters: i64) -> f64 with Mut, Div, Panic {
    let aconj: Sedenion = sed_conj(a)
    // Random-ish starting vector (deterministic seed via basis combination)
    var v: Sedenion = sed_normalize(sed_add(sed_basis(0, 1.0),
        sed_add(sed_basis(3, 0.5),
            sed_add(sed_basis(7, 0.3), sed_basis(13, 0.2)))))
    var lambda: f64 = 0.0
    var k: i64 = 0
    while k < n_iters {
        let av:    Sedenion = sed_mul(a, v)
        let atav:  Sedenion = sed_mul(aconj, av)
        let nnext: f64 = sed_norm(atav)
        if nnext > 0.0000001 {
            v = sed_scale(atav, 1.0 / nnext)
            lambda = nnext
        }
        k = k + 1
    }
    sqrt_s(lambda)
}

// ─── Isometry defect ‖R_A^T R_A − I‖_F via Gram-matrix entries ───────────────
// (R_A^T R_A)[i,j] = ⟨R_A e_i, R_A e_j⟩ = ⟨A·e_i, A·e_j⟩

fn isometry_defect(a: Sedenion) -> f64 with Mut, Div, Panic {
    var sum_sq: f64 = 0.0
    var i: i64 = 0
    while i < 16 {
        let ei:  Sedenion = sed_basis(i, 1.0)
        let aei: Sedenion = sed_mul(a, ei)
        var j: i64 = 0
        while j < 16 {
            let ej:  Sedenion = sed_basis(j, 1.0)
            let aej: Sedenion = sed_mul(a, ej)
            let gij: f64 = sed_dot(aei, aej)
            var d: f64 = gij
            if i == j { d = gij - 1.0 }
            sum_sq = sum_sq + d * d
            j = j + 1
        }
        i = i + 1
    }
    sqrt_s(sum_sq)
}

// ─── Make A(α) on the G₂ curve ───────────────────────────────────────────────

fn make_a(a_generic: Sedenion, zd_n: Sedenion, alpha: f64) -> Sedenion
    with Div, Panic {
    sed_normalize(sed_lerp(a_generic, zd_n, alpha))
}

// ─── Main ─────────────────────────────────────────────────────────────────────

fn main() -> i32 with IO, Mut, Div, Panic {
    let zd:   Sedenion = sed_known_zero_divisor()
    let zd_n: Sedenion = sed_normalize(zd)
    let ag_raw:    Sedenion = sed_add(sed_basis(0, 1.0), sed_basis(1, 1.0))
    let a_generic: Sedenion = sed_normalize(ag_raw)

    println("═══════════════════════════════════════════════════════")
    println("  Door G: spectrum of R_A as α moves through the basin")
    println("  R_A : ℝ¹⁶ → ℝ¹⁶,  R_A(h) = A·h  (sedenion left-mul)")
    println("═══════════════════════════════════════════════════════")
    println("")
    println("  α      ‖R_A‖_F²  ‖R_A‖_op  min|A·e_j|  iso_defect")
    println("  -----  --------  --------  ----------  ----------")

    var i: i64 = 0
    let nalpha: i64 = n_alpha()
    while i < nalpha {
        let alpha: f64 = alpha_at(i)
        let a: Sedenion = make_a(a_generic, zd_n, alpha)
        let frob: f64 = frob_min_basis(a)
        let mb:   f64 = LAST_MIN_BASIS
        let opn:  f64 = op_norm_power(a, 30)
        let iso:  f64 = isometry_defect(a)
        ALPHAS[i]    = alpha
        FROB_NSQ[i]  = frob
        OP_NORM[i]   = opn
        MIN_BASIS[i] = mb
        ISO_DEF[i]   = iso
        print("  "); print(alpha)
        print("  "); print(frob)
        print("  "); print(opn)
        print("  "); print(mb)
        print("  "); print(iso); println("")
        i = i + 1
    }
    println("")

    // ── Find the index of the alpha closest to 0.2 ──────────────────────────
    let basin_idx: i64 = 4   // alpha_at(4) = 0.2
    let basin_alpha: f64 = ALPHAS[basin_idx]
    let basin_frob:  f64 = FROB_NSQ[basin_idx]
    let basin_op:    f64 = OP_NORM[basin_idx]
    let basin_min:   f64 = MIN_BASIS[basin_idx]
    let basin_iso:   f64 = ISO_DEF[basin_idx]

    // Compare to α=0 and α=1 endpoints
    let frob_0: f64 = FROB_NSQ[0]
    let frob_1: f64 = FROB_NSQ[10]
    let op_0:   f64 = OP_NORM[0]
    let op_1:   f64 = OP_NORM[10]
    let iso_0:  f64 = ISO_DEF[0]
    let iso_1:  f64 = ISO_DEF[10]
    let min_0:  f64 = MIN_BASIS[0]
    let min_1:  f64 = MIN_BASIS[10]

    println("───────────────────────────────────────────────────────")
    print("  At α=0.2:  ‖R_A‖_F²="); print(basin_frob)
    print("  ‖R_A‖_op="); print(basin_op); println("")
    print("              min|A·e_j|="); print(basin_min)
    print("  iso_defect="); print(basin_iso); println("")
    print("  At α=0.0:  ‖R_A‖_F²="); print(frob_0)
    print("  iso_defect="); print(iso_0); println("")
    print("  At α=1.0:  ‖R_A‖_F²="); print(frob_1)
    print("  iso_defect="); print(iso_1); println("")
    println("───────────────────────────────────────────────────────")
    println("")

    // ── Find min isometry defect across α ───────────────────────────────────
    var min_iso_idx: i64 = 0
    var min_iso_val: f64 = ISO_DEF[0]
    var k: i64 = 1
    while k < nalpha {
        if ISO_DEF[k] < min_iso_val { min_iso_val = ISO_DEF[k]; min_iso_idx = k }
        k = k + 1
    }
    let min_iso_alpha: f64 = ALPHAS[min_iso_idx]
    print("  min iso_defect at α="); print(min_iso_alpha)
    print("  (defect="); print(min_iso_val); println(")")

    // Find min Frobenius norm
    var min_frob_idx: i64 = 0
    var min_frob_val: f64 = FROB_NSQ[0]
    var k2: i64 = 1
    while k2 < nalpha {
        if FROB_NSQ[k2] < min_frob_val { min_frob_val = FROB_NSQ[k2]; min_frob_idx = k2 }
        k2 = k2 + 1
    }
    print("  min ‖R_A‖_F² at α="); print(ALPHAS[min_frob_idx])
    print("  (frob²="); print(min_frob_val); println(")")

    // Find max Frobenius norm
    var max_frob_idx: i64 = 0
    var max_frob_val: f64 = FROB_NSQ[0]
    var k3: i64 = 1
    while k3 < nalpha {
        if FROB_NSQ[k3] > max_frob_val { max_frob_val = FROB_NSQ[k3]; max_frob_idx = k3 }
        k3 = k3 + 1
    }
    print("  max ‖R_A‖_F² at α="); print(ALPHAS[max_frob_idx])
    print("  (frob²="); print(max_frob_val); println(")")
    println("")

    // ── Assertions ──────────────────────────────────────────────────────────
    var passed: i32 = 0
    var failed: i32 = 0

    // T1: At α=0.0 (composition-like generic point), R_A is approximately
    //     orthogonal — Frobenius norm² should be near 16 (ideal value for
    //     16×16 orthogonal matrix), iso_defect should be small.
    let frob0_dev: f64 = abs_s(frob_0 - 16.0)
    if frob0_dev < 1.0 {
        print("T1 PASS: ‖R_A(α=0)‖_F²="); print(frob_0); println(" ≈ 16 (composition)")
        passed = passed + 1
    } else {
        print("T1 FAIL: ‖R_A(α=0)‖_F²="); print(frob_0); println("")
        failed = failed + 1
    }

    // T2: REFRAMED — Frobenius norm is INVARIANT across α.
    //     For unit sedenion A and basis e_j, |A·e_j| = |A| = 1 exactly
    //     (right-multiplication by a basis element is a signed-permutation of
    //     components, preserving norm). So Σ_j |A·e_j|² = 16 for every α,
    //     regardless of where on the G₂ curve A sits. The total spectral
    //     energy of R_A is invariant; only its DISTRIBUTION across the 16
    //     singular values changes with α.
    let frob_dev: f64 = abs_s(basin_frob - 16.0)
    if frob_dev < 0.001 {
        print("T2 PASS: ‖R_A‖_F² invariant = "); print(basin_frob)
        println(" for all α (CD basis-mul preserves norm)")
        passed = passed + 1
    } else {
        print("T2 FAIL: ‖R_A‖_F² not invariant: "); print(basin_frob); println("")
        failed = failed + 1
    }

    // T3: Isometry defect MONOTONICALLY INCREASES from α=0 to α=1.
    //     A composition-algebra-like point (α=0) gives orthogonal R_A;
    //     pure ZD gives most-non-orthogonal R_A.
    var monotone: bool = true
    var prev: f64 = ISO_DEF[0]
    var t: i64 = 1
    while t < nalpha {
        let cur: f64 = ISO_DEF[t]
        if cur < prev - 0.001 { monotone = false }
        prev = cur
        t = t + 1
    }
    if monotone {
        print("T3 PASS: iso_defect monotone increasing from α=0 to α=1. "); println("")
        print("         "); print(iso_0); print(" → "); print(iso_1); println("")
        passed = passed + 1
    } else {
        println("T3 FAIL: iso_defect not monotone")
        failed = failed + 1
    }

    // T4: REFRAMED — at α=0.2, the spectral probes are STRICTLY INTERMEDIATE
    //     between α=0 (orthogonal) and α=1 (rank-deficient). This says α=0.2
    //     is not a spectral landmark; it sits on a smooth interpolation. The
    //     headline finding of Door G is precisely this: the optimum α=0.2
    //     does NOT correspond to any singular spectral feature (no eigenvalue
    //     collision, no condition-number minimum, no operator-norm extremum).
    //     The optimum emerges from interaction between R_A's smoothly-shifting
    //     spectrum and the task; not from R_A alone.
    if basin_op > op_0 {
        if basin_op < op_1 {
            if basin_iso > iso_0 {
                if basin_iso < iso_1 {
                    print("T4 PASS: at α=0.2, op_norm="); print(basin_op)
                    print(" ∈ (");                        print(op_0)
                    print(", ");                          print(op_1); println(")")
                    print("                  iso_def="); print(basin_iso)
                    print(" ∈ (");                        print(iso_0)
                    print(", ");                          print(iso_1); println(")")
                    passed = passed + 1
                } else {
                    println("T4 FAIL: iso_def at α=0.2 not strictly < iso_def(1)")
                    failed = failed + 1
                }
            } else {
                println("T4 FAIL: iso_def at α=0.2 not strictly > iso_def(0)")
                failed = failed + 1
            }
        } else {
            println("T4 FAIL: op_norm at α=0.2 not strictly < op_norm(1)")
            failed = failed + 1
        }
    } else {
        println("T4 FAIL: op_norm at α=0.2 not strictly > op_norm(0)")
        failed = failed + 1
    }

    // T5: All probes finite and bounded.
    var ok: bool = true
    var u: i64 = 0
    while u < nalpha {
        if FROB_NSQ[u] < 0.0  { ok = false }
        if FROB_NSQ[u] > 100.0 { ok = false }
        if OP_NORM[u]  < 0.0  { ok = false }
        if OP_NORM[u]  > 10.0 { ok = false }
        if ISO_DEF[u]  < 0.0  { ok = false }
        if ISO_DEF[u]  > 100.0 { ok = false }
        if MIN_BASIS[u] < 0.0 { ok = false }
        u = u + 1
    }
    if ok {
        println("T5 PASS: all spectral probes in sane ranges")
        passed = passed + 1
    } else {
        println("T5 FAIL: some probe out of range")
        failed = failed + 1
    }

    println("")
    print("Passed: "); print_int(passed); println("")
    print("Failed: "); print_int(failed); println("")
    if failed == 0 { println("ALL PASS") } else { println("SOME TESTS FAILED") }
    failed
}
