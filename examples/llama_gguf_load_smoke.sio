// Smoke: llama_load_gguf on fixture GGUF (Task 6).
use llm::llama::{llama_load_gguf}

fn main() with Alloc, Mut, Panic, Div, IO {
    let path = "/workspace/llm-models/tiny-mixtral-moe.gguf"
    let m = llama_load_gguf(path)
    if !m.loaded {
        print("gguf_load_smoke: loaded=0 FAIL")
        return
    }
    var packs = 0
    var li: i32 = 0
    while li < m.cfg.layers {
        if m.moe_gate_bytes[li as usize] > 0 { packs = packs + 1 }
        if m.moe_up_bytes[li as usize] > 0 { packs = packs + 1 }
        if m.moe_down_bytes[li as usize] > 0 { packs = packs + 1 }
        li = li + 1
    }
    print(str_concat("gguf_load_smoke: loaded=1 n_experts=", ll_num(m.cfg.n_experts)))
    print(str_concat("gguf_load_smoke: moe_pack_tensors=", ll_num(packs as i64)))
    if m.cfg.n_experts != 8 || packs < 6 {
        print("gguf_load_smoke: FAIL packs or experts")
        return
    }
    print("gguf_load_smoke: OK")
}

fn ll_digit(d: i64) -> string {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    "9"
}

fn ll_num(n: i64) -> string with Alloc {
    if n < 10 { return ll_digit(n) }
    str_concat(ll_num(n / 10), ll_digit(n % 10))
}
