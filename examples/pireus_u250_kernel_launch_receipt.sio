//@ run-pass
//!
//! Sounio admission of one material U250 kernel launch observation.

use hardware::pireus::u250_material_ingestion::{
    pireus_u250_material_ingest_files,
}
use hardware::pireus::u250_execution_engine::{
    pireus_u250_execution_engine_request,
    pireus_u250_execution_engine_project,
}
use hardware::pireus::u250_fpga_kernel_artifact::{
    pireus_u250_fpga_kernel_artifact_request,
    pireus_u250_fpga_kernel_artifact_project,
}
use hardware::pireus::u250_xclbin_material_receipt::{
    pireus_u250_xclbin_material_ingest_file,
}
use hardware::pireus::u250_kernel_launch_receipt::{
    pireus_u250_kernel_launch_request,
    pireus_u250_kernel_launch_project,
    pireus_u250_kernel_launch_ingest_file,
    pireus_u250_kernel_launch_waiting_matches_expected,
    pireus_u250_kernel_launch_parity_matches_expected,
    pireus_u250_kernel_launch_store,
    pireus_u250_query_kernel_launch_receipts,
    pireus_u250_query_kernel_launch_lifecycle,
    pireus_u250_query_kernel_launch_outputs,
}
use ontology::query::{triple_store_count, sparql_result_count}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 3 && arg_count() != 4 {
        print("usage: pireus_u250_kernel_launch_receipt <raw-card-probe> <card-receipt> <xclbin-probe> [launch-probe]\n")
        return 2
    }
    let admission = pireus_u250_material_ingest_files(get_arg(0), get_arg(1))
    let engine_request = pireus_u250_execution_engine_request()
    let engine = pireus_u250_execution_engine_project(
        &admission, &engine_request)
    let artifact_request = pireus_u250_fpga_kernel_artifact_request()
    let artifact = pireus_u250_fpga_kernel_artifact_project(
        &engine, &artifact_request)
    let material = pireus_u250_xclbin_material_ingest_file(
        &artifact, get_arg(2))
    let result = if arg_count() == 4 {
        pireus_u250_kernel_launch_ingest_file(&material, get_arg(3))
    } else {
        let request = pireus_u250_kernel_launch_request()
        pireus_u250_kernel_launch_project(&material, &request)
    }
    var store = pireus_u250_kernel_launch_store(
        &engine, &artifact, &material, &result)
    let receipts = pireus_u250_query_kernel_launch_receipts(&store)
    let lifecycle = pireus_u250_query_kernel_launch_lifecycle(&store)
    let outputs = pireus_u250_query_kernel_launch_outputs(&store)

    print("SOUNIO_SEMANTIC_AUTHORITY schema=pireus.u250-kernel-launch-receipt.v0 stage=")
    if result.execution_parity_open { print("PARITY_OPEN\n") }
    else { print("SOUNIO_EXECUTABLE\n") }
    print("PIREUS_U250_KERNEL_LAUNCH valid=")
    print_int(yes(result.valid))
    print(" status="); print_int(result.status)
    print(" artifact_parity_open=")
    print_int(yes(result.artifact_parity_open))
    print(" launch_observed="); print_int(yes(result.launch_observed))
    print(" identity="); print_int(yes(result.identity_matches))
    print(" invocation="); print_int(yes(result.invocation_matches))
    print(" lifecycle="); print_int(yes(result.lifecycle_matches))
    print(" output_shape="); print_int(yes(result.output_shape_matches))
    print(" output_values_recorded=")
    print_int(yes(result.output_values_recorded))
    print(" n_samples="); print_int(result.n_samples)
    print(" n_points="); print_int(result.n_points)
    print(" q_delta="); print_int(result.q_delta)
    print(" lifecycle_observations=")
    print_int(result.lifecycle_observation_count)
    print(" buffers="); print_int(result.buffers_allocated)
    print(" output_syncs="); print_int(result.outputs_synced)
    print(" execution_parity_open=")
    print_int(yes(result.execution_parity_open))
    print(" execution_observed=")
    print_int(yes(result.kernel_execution_observed))
    print(" correctness_present=")
    print_int(yes(result.kernel_correctness_present))
    print(" operation_capabilities=")
    print_int(result.operation_capability_count)
    print(" lowering_authorized=")
    print_int(yes(result.lowering_authorized))
    print(" isa_claim="); print_int(yes(result.isa_claim_present))
    print(" performance_present=")
    print_int(yes(result.performance_present))
    print(" claim_ready="); print_int(yes(result.claim_ready))
    print(" failures="); print_int(result.failures)
    print("\n")
    print("PIREUS_U250_KERNEL_LAUNCH_GRAPH triples=")
    print_int(triple_store_count(&store))
    print(" receipt_edges="); print_int(sparql_result_count(&receipts))
    print(" lifecycle_edges="); print_int(sparql_result_count(&lifecycle))
    print(" output_edges="); print_int(sparql_result_count(&outputs))
    print("\n")

    if arg_count() == 4 {
        if pireus_u250_kernel_launch_parity_matches_expected(&result) &&
            triple_store_count(&store) == 457 &&
            sparql_result_count(&receipts) == 1 &&
            sparql_result_count(&lifecycle) == 1 &&
            sparql_result_count(&outputs) == 1 { 0 } else { 1 }
    } else {
        if pireus_u250_kernel_launch_waiting_matches_expected(&result) &&
            triple_store_count(&store) == 442 &&
            sparql_result_count(&receipts) == 0 &&
            sparql_result_count(&lifecycle) == 0 &&
            sparql_result_count(&outputs) == 0 { 0 } else { 1 }
    }
}
