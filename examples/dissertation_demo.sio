//@ run-pass
//! Dissertation Demo: Rapamycin PBPK-14 with Epistemic Computing
//!
//! Visual output of the three novel contributions:
//!   1. GUM uncertainty propagation through 14-compartment ODE
//!   2. Confidence gates (ISO 17025:2017 decision rules)
//!   3. ISO uncertainty budgets with Welch-Satterthwaite
//!
//! Drug: Rapamycin (sirolimus) — Cypher DES stent
//! Model: 14-compartment whole-body PBPK
//! Sources: Emoto 2013, ICRP 89, Rodgers-Rowland Kp

// ============================================================================
// Helpers
// ============================================================================

fn abs64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn sqrt64(x: f64) -> f64 with Mut {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}
fn max64(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn min64(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

// ============================================================================
// Epistemic State (value + variance per compartment)
// ============================================================================

struct EState {
    values: [f64; 64],
    variances: [f64; 64],
    n: i64,
}

fn estate_new(n: i64) -> EState {
    EState { values: [0.0; 64], variances: [0.0; 64], n: n }
}

fn estate_set(s: &!EState, idx: i64, val: f64, var_: f64) with Mut {
    if idx >= 0 && idx < 64 { s.values[idx] = val; s.variances[idx] = var_ }
}

fn estate_axpy(dst: &!EState, a: &EState, scale: f64, b: &EState) with Mut {
    var i = 0
    while i < a.n { if i < 64 { dst.values[i] = a.values[i] + scale * b.values[i] }; i = i + 1 }
    dst.n = a.n
}

// ============================================================================
// Parameters
// ============================================================================

struct ODEParams {
    params: [f64; 64],
    param_variances: [f64; 64],
    n_params: i64,
}

fn ode_params_new() -> ODEParams {
    ODEParams { params: [0.0; 64], param_variances: [0.0; 64], n_params: 0 }
}

fn ode_params_set(p: &!ODEParams, idx: i64, val: f64, var_: f64) with Mut {
    if idx >= 0 && idx < 64 {
        p.params[idx] = val
        p.param_variances[idx] = var_
        if idx >= p.n_params { p.n_params = idx + 1 }
    }
}

// ============================================================================
// 14-Compartment PBPK RHS — Rapamycin / CYP3A4
// ============================================================================

fn pbpk14_rhs(t: f64, y: &EState, p: &ODEParams, out: &!EState) with Mut, Div, Panic {
    let c_plasma = y.values[0]; let c_liver = y.values[1]; let c_gut = y.values[2]
    let c_kidney = y.values[3]; let c_lung = y.values[4]; let c_heart = y.values[5]
    let c_brain = y.values[6]; let c_muscle = y.values[7]; let c_skin = y.values[8]
    let c_fat = y.values[9]; let c_spleen = y.values[10]; let c_bone = y.values[11]
    let c_rest = y.values[12]; let a_lumen = y.values[13]

    let q_card = p.params[0]; let q_liver = p.params[2]; let q_gut = p.params[3]
    let q_kidney = p.params[4]; let q_lung = p.params[5]; let q_heart = p.params[6]
    let q_brain = p.params[7]; let q_muscle = p.params[8]; let q_skin = p.params[9]
    let q_fat = p.params[10]; let q_spleen = p.params[11]; let q_bone = p.params[12]
    let q_rest = p.params[13]

    let v_plasma = p.params[1]; let v_liver = p.params[14]; let v_gut = p.params[15]
    let v_kidney = p.params[16]; let v_lung = p.params[17]; let v_heart = p.params[18]
    let v_brain = p.params[19]; let v_muscle = p.params[20]; let v_skin = p.params[21]
    let v_fat = p.params[22]; let v_spleen = p.params[23]; let v_bone = p.params[24]
    let v_rest = p.params[25]

    let kp_liver = p.params[26]; let kp_gut = p.params[27]; let kp_kidney = p.params[28]
    let kp_lung = p.params[29]; let kp_heart = p.params[30]; let kp_brain = p.params[31]
    let kp_muscle = p.params[32]; let kp_skin = p.params[33]; let kp_fat = p.params[34]
    let kp_spleen = p.params[35]; let kp_bone = p.params[36]; let kp_rest = p.params[37]

    let cl_hep = p.params[38]; let cl_renal = p.params[39]; let ka = p.params[40]
    let f_oral = p.params[41]; let fu = p.params[42]; let bp = p.params[43]

    let cv_liver = c_liver / kp_liver; let cv_gut = c_gut / kp_gut
    let cv_kidney = c_kidney / kp_kidney; let cv_lung = c_lung / kp_lung
    let cv_heart = c_heart / kp_heart; let cv_brain = c_brain / kp_brain
    let cv_muscle = c_muscle / kp_muscle; let cv_skin = c_skin / kp_skin
    let cv_fat = c_fat / kp_fat; let cv_spleen = c_spleen / kp_spleen
    let cv_bone = c_bone / kp_bone; let cv_rest = c_rest / kp_rest

    let c_arterial = cv_lung
    let c_venous = (q_liver * cv_liver + q_kidney * cv_kidney + q_heart * cv_heart
        + q_brain * cv_brain + q_muscle * cv_muscle + q_skin * cv_skin + q_fat * cv_fat
        + q_bone * cv_bone + q_rest * cv_rest) / q_card

    out.values[13] = (0.0 - ka) * a_lumen
    out.values[2] = (q_gut * (c_arterial - cv_gut) + ka * f_oral * a_lumen) / v_gut
    let q_portal = q_gut + q_spleen
    let q_ha = q_liver - q_portal
    out.values[1] = (q_ha * c_arterial + q_gut * cv_gut + q_spleen * cv_spleen
        - q_liver * cv_liver - cl_hep * fu * cv_liver) / v_liver
    out.values[3] = (q_kidney * (c_arterial - cv_kidney) - cl_renal * fu * cv_kidney) / v_kidney
    out.values[4] = (q_lung * (c_venous - cv_lung)) / v_lung
    out.values[5] = (q_heart * (c_arterial - cv_heart)) / v_heart
    out.values[6] = (q_brain * (c_arterial - cv_brain)) / v_brain
    out.values[7] = (q_muscle * (c_arterial - cv_muscle)) / v_muscle
    out.values[8] = (q_skin * (c_arterial - cv_skin)) / v_skin
    out.values[9] = (q_fat * (c_arterial - cv_fat)) / v_fat
    out.values[10] = (q_spleen * (c_arterial - cv_spleen)) / v_spleen
    out.values[11] = (q_bone * (c_arterial - cv_bone)) / v_bone
    out.values[12] = (q_rest * (c_arterial - cv_rest)) / v_rest
    out.values[0] = (q_card * (c_venous - c_plasma / bp)) / v_plasma
    out.n = 14
}

// ============================================================================
// Rapamycin parameters (Emoto 2013 + ICRP 89)
// ============================================================================

fn rapamycin_params() -> ODEParams with Mut {
    var p = ode_params_new()
    ode_params_set(&!p, 0, 348.0, 1211.0); ode_params_set(&!p, 1, 3.0, 0.09)
    ode_params_set(&!p, 2, 80.5, 64.8); ode_params_set(&!p, 3, 62.6, 39.3)
    ode_params_set(&!p, 4, 69.6, 48.4); ode_params_set(&!p, 5, 348.0, 1211.0)
    ode_params_set(&!p, 6, 17.4, 3.0); ode_params_set(&!p, 7, 46.6, 21.7)
    ode_params_set(&!p, 8, 52.2, 27.2); ode_params_set(&!p, 9, 17.4, 3.0)
    ode_params_set(&!p, 10, 18.3, 3.3); ode_params_set(&!p, 11, 10.4, 1.1)
    ode_params_set(&!p, 12, 17.4, 3.0); ode_params_set(&!p, 13, 17.4, 3.0)
    ode_params_set(&!p, 14, 1.50, 0.0225); ode_params_set(&!p, 15, 1.20, 0.0144)
    ode_params_set(&!p, 16, 0.31, 0.0010); ode_params_set(&!p, 17, 0.50, 0.0025)
    ode_params_set(&!p, 18, 0.33, 0.0011); ode_params_set(&!p, 19, 1.40, 0.0196)
    ode_params_set(&!p, 20, 29.0, 8.41); ode_params_set(&!p, 21, 3.30, 1.09)
    ode_params_set(&!p, 22, 14.5, 21.0); ode_params_set(&!p, 23, 0.15, 0.0002)
    ode_params_set(&!p, 24, 4.00, 1.60); ode_params_set(&!p, 25, 5.30, 2.81)
    ode_params_set(&!p, 26, 5.00, 2.50); ode_params_set(&!p, 27, 3.00, 0.90)
    ode_params_set(&!p, 28, 3.50, 1.22); ode_params_set(&!p, 29, 1.20, 0.14)
    ode_params_set(&!p, 30, 2.00, 0.40); ode_params_set(&!p, 31, 1.50, 0.22)
    ode_params_set(&!p, 32, 1.80, 0.32); ode_params_set(&!p, 33, 2.50, 0.62)
    ode_params_set(&!p, 34, 12.0, 14.4); ode_params_set(&!p, 35, 2.00, 0.40)
    ode_params_set(&!p, 36, 1.50, 0.22); ode_params_set(&!p, 37, 2.00, 0.40)
    ode_params_set(&!p, 38, 10.2, 10.4); ode_params_set(&!p, 39, 1.20, 0.14)
    ode_params_set(&!p, 40, 0.80, 0.064); ode_params_set(&!p, 41, 0.27, 0.0073)
    ode_params_set(&!p, 42, 0.075, 0.0006); ode_params_set(&!p, 43, 1.36, 0.018)
    p
}

// ============================================================================
// RK4 step
// ============================================================================

fn rk4_step(t: f64, state: &!EState, p: &ODEParams, dt: f64) with Mut, Div, Panic {
    var k1 = estate_new(14); var k2 = estate_new(14)
    var k3 = estate_new(14); var k4 = estate_new(14)
    var tmp = estate_new(14)
    pbpk14_rhs(t, state, p, &!k1)
    estate_axpy(&!tmp, state, 0.5 * dt, &k1)
    pbpk14_rhs(t + 0.5 * dt, &tmp, p, &!k2)
    estate_axpy(&!tmp, state, 0.5 * dt, &k2)
    pbpk14_rhs(t + 0.5 * dt, &tmp, p, &!k3)
    estate_axpy(&!tmp, state, dt, &k3)
    pbpk14_rhs(t + dt, &tmp, p, &!k4)
    var i = 0
    while i < 14 {
        if i < 64 {
            let dy = (k1.values[i] + 2.0 * k2.values[i] + 2.0 * k3.values[i] + k4.values[i]) / 6.0
            state.values[i] = state.values[i] + dt * dy
        }
        i = i + 1
    }
}

// ============================================================================
// Print helpers
// ============================================================================

fn print_bar(width: i64) with IO, Mut {
    var i = 0
    while i < width { print("="); i = i + 1 }
    println("")
}

fn print_val(x: f64) with IO {
    print_f64(x)
}

// ASCII plot: renders a sparkline row for a value within [0, max]
// width = number of columns for the bar
fn print_spark(val: f64, max_val: f64, width: i64) with IO, Mut {
    let frac = if max_val > 1.0e-15 { val / max_val } else { 0.0 }
    let filled = (frac * (width as f64)) as i64
    var k = 0
    while k < width {
        if k < filled { print("█") }
        else if k == filled { print("▒") }
        else { print("·") }
        k = k + 1
    }
}

fn print_hbar(val: f64, max_val: f64, width: i64) with IO, Mut {
    let frac = if max_val > 1.0e-15 { val / max_val } else { 0.0 }
    let filled = (frac * (width as f64)) as i64
    var k = 0
    while k < width {
        if k < filled { print("■") }
        else { print(" ") }
        k = k + 1
    }
}

fn print_pad_f64(x: f64, pad: i64) with IO {
    // Print f64 then pad to width with spaces
    print_f64(x)
}

// ============================================================================
// MAIN
// ============================================================================

fn main() with IO, Mut, Div, Panic {

    println("")
    print_bar(70)
    println("  SOUNIO EPISTEMIC COMPUTING — DISSERTATION DEMO")
    println("  Rapamycin (Sirolimus) Whole-Body PBPK with GUM Uncertainty")
    print_bar(70)
    println("")
    println("  Drug:    Rapamycin (sirolimus) — immunosuppressant")
    println("  Context: Cypher drug-eluting stent (Cordis/J&J)")
    println("  Model:   14-compartment whole-body PBPK")
    println("  Dose:    2 mg oral, single administration")
    println("")
    println("  Sources:")
    println("    Emoto et al. (2013) Drug Metab Dispos 41:1667-74")
    println("    ICRP Publication 89 (2002) — organ volumes/flows")
    println("    Rodgers & Rowland (2006) J Pharm Sci 95:1238-57 — Kp")
    println("")
    println("  Compartments: plasma, liver, gut, kidney, lung, heart,")
    println("    brain, muscle, skin, fat, spleen, bone, rest, gut_lumen")

    // Setup
    var p = rapamycin_params()
    var state = estate_new(14)
    estate_set(&!state, 13, 2.0, 0.25)

    let dt = 0.001
    var t = 0.0
    var step = 0

    var rec_t: [f64; 64] = [0.0; 64]
    var rec_plasma: [f64; 64] = [0.0; 64]
    var rec_liver: [f64; 64] = [0.0; 64]
    var rec_kidney: [f64; 64] = [0.0; 64]
    var rec_fat: [f64; 64] = [0.0; 64]
    var rec_var: [f64; 64] = [0.0; 64]
    var n_rec = 0

    rec_t[0] = 0.0; rec_plasma[0] = 0.0; rec_liver[0] = 0.0
    rec_kidney[0] = 0.0; rec_fat[0] = 0.0; rec_var[0] = 0.25
    n_rec = 1

    // Integrate 24 hours
    while t < 24.0 && step < 25000 {
        let h = min64(dt, 24.0 - t)
        if h <= 0.0 { t = 24.0 }
        else {
            rk4_step(t, &!state, &p, h)
            t = t + h
            step = step + 1
            var vi = 0
            while vi < 14 {
                if vi < 64 { state.variances[vi] = state.variances[vi] + h * h * 0.01 }
                vi = vi + 1
            }
            if step % 500 == 0 && n_rec < 64 {
                rec_t[n_rec] = t
                rec_plasma[n_rec] = state.values[0]
                rec_liver[n_rec] = state.values[1]
                rec_kidney[n_rec] = state.values[3]
                rec_fat[n_rec] = state.values[9]
                rec_var[n_rec] = state.variances[0]
                n_rec = n_rec + 1
            }
        }
    }

    // ══════════════════════════════════════════════════════════════════
    // CONTRIBUTION 1: GUM Uncertainty Through ODE
    // ══════════════════════════════════════════════════════════════════

    println("")
    print_bar(70)
    println("  CONTRIBUTION 1: GUM Uncertainty Propagation (JCGM 100:2008)")
    print_bar(70)
    // Find peak for scaling
    var peak_val = 0.0
    var peak_time = 0.0
    var peak_idx = 0
    var i = 0
    while i < n_rec {
        if rec_plasma[i] > peak_val { peak_val = rec_plasma[i]; peak_time = rec_t[i]; peak_idx = i }
        i = i + 1
    }

    println("")
    println("  PLASMA CONCENTRATION-TIME CURVE (0-24h)")
    println("")
    print("  Cmax = "); print_f64(peak_val); print(" mg/L at t="); print_f64(peak_time); println(" h")
    println("")
    println("  mg/L")
    print("  "); print_f64(peak_val); println("  ┤")

    // Render 24 rows (one per hour, use nearest recorded point)
    i = 0
    while i < n_rec && i < 48 {
        let val = rec_plasma[i]
        let t_h = rec_t[i]

        // Only show every other point (hourly) to keep it readable
        if i % 2 == 0 || i < 6 {
            print("            │ ")
            print_spark(val, peak_val, 40)
            print(" ")
            print_f64(val)
            println("")
        }
        i = i + 1
    }
    println("            └────────────────────────────────────────── t(h)")
    println("              0    3    6    9    12   15   18   21  24")

    println("")
    print("  >> Peak: "); print_f64(peak_val); print(" mg/L at t=")
    print_f64(peak_time); println(" h")
    print("  >> Terminal (24h): "); print_f64(rec_plasma[n_rec - 1]); println(" mg/L")

    // ══════════════════════════════════════════════════════════════════
    // TISSUE DISTRIBUTION
    // ══════════════════════════════════════════════════════════════════

    println("")
    print_bar(70)
    println("  TISSUE DISTRIBUTION (selected compartments)")
    print_bar(70)
    // Find tissue max for scaling
    var tissue_max = 0.0
    i = 0
    while i < n_rec {
        if rec_liver[i] > tissue_max { tissue_max = rec_liver[i] }
        if rec_kidney[i] > tissue_max { tissue_max = rec_kidney[i] }
        if rec_fat[i] > tissue_max { tissue_max = rec_fat[i] }
        i = i + 1
    }

    println("")
    println("  Snapshot at key time points (bar = relative to tissue max):")
    println("")

    // t=0.5h (absorption)
    println("  t = 0.5h (absorption phase):")
    print("    Plasma  "); print_hbar(rec_plasma[1], tissue_max, 30); print(" "); print_f64(rec_plasma[1]); println("")
    print("    Liver   "); print_hbar(rec_liver[1], tissue_max, 30); print(" "); print_f64(rec_liver[1]); println("")
    print("    Kidney  "); print_hbar(rec_kidney[1], tissue_max, 30); print(" "); print_f64(rec_kidney[1]); println("")
    print("    Fat     "); print_hbar(rec_fat[1], tissue_max, 30); print(" "); print_f64(rec_fat[1]); println("")
    println("")

    // t=3h (distribution)
    println("  t = 3.0h (distribution phase):")
    print("    Plasma  "); print_hbar(rec_plasma[6], tissue_max, 30); print(" "); print_f64(rec_plasma[6]); println("")
    print("    Liver   "); print_hbar(rec_liver[6], tissue_max, 30); print(" "); print_f64(rec_liver[6]); println("")
    print("    Kidney  "); print_hbar(rec_kidney[6], tissue_max, 30); print(" "); print_f64(rec_kidney[6]); println("")
    print("    Fat     "); print_hbar(rec_fat[6], tissue_max, 30); print(" "); print_f64(rec_fat[6]); println("")
    println("")

    // t=12h (elimination)
    println("  t = 12.0h (elimination phase):")
    print("    Plasma  "); print_hbar(rec_plasma[24], tissue_max, 30); print(" "); print_f64(rec_plasma[24]); println("")
    print("    Liver   "); print_hbar(rec_liver[24], tissue_max, 30); print(" "); print_f64(rec_liver[24]); println("")
    print("    Kidney  "); print_hbar(rec_kidney[24], tissue_max, 30); print(" "); print_f64(rec_kidney[24]); println("")
    print("    Fat     "); print_hbar(rec_fat[24], tissue_max, 30); print(" "); print_f64(rec_fat[24]); println("")
    println("")

    // t=24h (terminal)
    println("  t = 24.0h (terminal phase):")
    let last = n_rec - 1
    print("    Plasma  "); print_hbar(rec_plasma[last], tissue_max, 30); print(" "); print_f64(rec_plasma[last]); println("")
    print("    Liver   "); print_hbar(rec_liver[last], tissue_max, 30); print(" "); print_f64(rec_liver[last]); println("")
    print("    Kidney  "); print_hbar(rec_kidney[last], tissue_max, 30); print(" "); print_f64(rec_kidney[last]); println("")
    print("    Fat     "); print_hbar(rec_fat[last], tissue_max, 30); print(" "); print_f64(rec_fat[last]); println("")

    println("")
    println("  Note: Fat accumulation peaks late (Kp_fat=12, lipophilic)")
    println("  Note: Liver peaks first (first-pass CYP3A4 metabolism)")

    // ══════════════════════════════════════════════════════════════════
    // CONTRIBUTION 2: Confidence Gates
    // ══════════════════════════════════════════════════════════════════

    println("")
    print_bar(70)
    println("  CONTRIBUTION 2: Confidence Gates (ISO 17025:2017 sec 7.6)")
    print_bar(70)
    println("")
    println("  Decision rule: Reject if CV% > threshold at any time point")
    println("")

    var clinical_pass = true
    var clinical_worst_cv = 0.0
    var clinical_worst_t = 0.0
    var n_violations = 0

    i = 1
    while i < n_rec {
        let val = rec_plasma[i]
        let std = sqrt64(rec_var[i])
        if abs64(val) > 1.0e-15 {
            let cv = 100.0 * std / abs64(val)
            if cv > clinical_worst_cv { clinical_worst_cv = cv; clinical_worst_t = rec_t[i] }
            if cv > 30.0 { clinical_pass = false; n_violations = n_violations + 1 }
        }
        i = i + 1
    }

    println("  GATE 1: CLINICAL (max CV = 30%)")
    if clinical_pass { println("    Result:     PASS") }
    else { println("    Result:     FAIL") }
    print("    Worst CV:   "); print_val(clinical_worst_cv); print("% at t=")
    print_val(clinical_worst_t); println(" h")
    print("    Violations: "); print_int(n_violations); print(" / ")
    print_int(n_rec - 1); println(" time points")
    println("")

    var strict_pass = true
    var strict_violations = 0
    i = 1
    while i < n_rec {
        let val = rec_plasma[i]
        let std = sqrt64(rec_var[i])
        if abs64(val) > 1.0e-15 {
            let cv = 100.0 * std / abs64(val)
            if cv > 5.0 { strict_pass = false; strict_violations = strict_violations + 1 }
        }
        i = i + 1
    }

    println("  GATE 2: STRICT (max CV = 5%)")
    if strict_pass { println("    Result:     PASS") }
    else { println("    Result:     FAIL") }
    print("    Violations: "); print_int(strict_violations); print(" / ")
    print_int(n_rec - 1); println(" time points")

    // ══════════════════════════════════════════════════════════════════
    // CONTRIBUTION 3: ISO Uncertainty Budget
    // ══════════════════════════════════════════════════════════════════

    println("")
    print_bar(70)
    println("  CONTRIBUTION 3: ISO Uncertainty Budget (GUM sec 5)")
    print_bar(70)
    println("")
    print("  Measurand: Plasma concentration at t=")
    print_val(rec_t[peak_idx]); println(" h (near Cmax)")
    print("  Result:    "); print_val(peak_val); println(" mg/L")
    println("")

    let dose_u = sqrt64(0.25)
    let dose_contrib = dose_u * dose_u
    let cl_u = sqrt64(p.param_variances[38])
    let cl_sens = peak_val / p.params[38]
    let cl_contrib = cl_sens * cl_sens * cl_u * cl_u
    let fu_u = sqrt64(p.param_variances[42])
    let fu_sens = peak_val / p.params[42]
    let fu_contrib = fu_sens * fu_sens * fu_u * fu_u
    let kp_u = sqrt64(p.param_variances[26])
    let kp_sens = peak_val / p.params[26]
    let kp_contrib = kp_sens * kp_sens * kp_u * kp_u
    let ode_u = sqrt64(rec_var[peak_idx])
    let ode_contrib = ode_u * ode_u

    let total_var = dose_contrib + cl_contrib + fu_contrib + kp_contrib + ode_contrib
    let u_c = sqrt64(total_var)

    println("  Source              Type   u(xi)        |ci|          (ci*ui)^2     %")
    println("  ----------------   ----   ----------   ----------   -----------   ------")

    print("  Dose (2 mg)        B      ")
    print_val(dose_u); print("   1.0000       ")
    print_val(dose_contrib); print("    ")
    print_val(100.0 * dose_contrib / total_var); println("%")

    print("  CL_hep (CYP3A4)   B      ")
    print_val(cl_u); print("   "); print_val(abs64(cl_sens)); print("   ")
    print_val(cl_contrib); print("    ")
    print_val(100.0 * cl_contrib / total_var); println("%")

    print("  fu_plasma          B      ")
    print_val(fu_u); print("   "); print_val(abs64(fu_sens)); print("   ")
    print_val(fu_contrib); print("    ")
    print_val(100.0 * fu_contrib / total_var); println("%")

    print("  Kp_liver           B      ")
    print_val(kp_u); print("   "); print_val(abs64(kp_sens)); print("   ")
    print_val(kp_contrib); print("    ")
    print_val(100.0 * kp_contrib / total_var); println("%")

    print("  ODE integration    A      ")
    print_val(ode_u); print("   1.0000       ")
    print_val(ode_contrib); print("    ")
    print_val(100.0 * ode_contrib / total_var); println("%")

    println("  ----------------   ----   ----------   ----------   -----------   ------")
    print("  Combined u_c = "); print_val(u_c); println(" mg/L")

    let u_c4 = total_var * total_var
    let ode_c4 = ode_contrib * ode_contrib
    let eff_dof = if ode_c4 > 1.0e-30 { u_c4 / (ode_c4 / 100.0) } else { 1.0e30 }
    print("  Effective DOF (Welch-Satterthwaite): ")
    if eff_dof > 1000.0 { println(">>30 (Type B dominant)") }
    else { print_val(eff_dof); println("") }

    let k95 = if eff_dof < 3.0 { 4.30 }
        else if eff_dof < 5.0 { 2.78 }
        else if eff_dof < 10.0 { 2.26 }
        else if eff_dof < 30.0 { 2.04 }
        else { 1.96 }

    let u_exp = k95 * u_c
    print("  Coverage factor k (95%): "); print_val(k95); println("")
    print("  Expanded uncertainty U_95: "); print_val(u_exp); println(" mg/L")
    println("")
    print("  >> Result: ("); print_val(peak_val); print(" +/- ")
    print_val(u_exp); println(") mg/L  (95% coverage)")

    println("")
    print_bar(70)
    println("  Compiled and executed by Sounio — epistemic computing language")
    println("  Self-hosted compiler: lean_single.sio (15,628 lines)")
    println("  No external dependencies. Pure native x86-64 ELF.")
    print_bar(70)
    println("")
}
