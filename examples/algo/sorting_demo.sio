//! Sorting Algorithms Demonstration
//!
//! Compares quicksort, mergesort, and heapsort on the same dataset.
//! Shows algorithm correctness and sorting verification.

extern "C" {
    fn printf(fmt: *const u8, ...) -> i32;
    fn malloc(size: usize) -> *mut u8;
    fn free(ptr: *mut u8);
}

// Quicksort implementation
fn quicksort_i64(arr: &![i64], len: usize) with Panic, Div {
    if len <= 1 {
        return
    }
    quicksort_range(&!arr, 0, len - 1)
}

fn quicksort_range(arr: &![i64], low: usize, high: usize) with Panic, Div {
    if low < high {
        let pivot_idx = partition(&!arr, low, high)

        if pivot_idx > 0 {
            quicksort_range(&!arr, low, pivot_idx - 1)
        }

        if pivot_idx < high {
            quicksort_range(&!arr, pivot_idx + 1, high)
        }
    }
}

fn partition(arr: &![i64], low: usize, high: usize) -> usize with Panic, Div {
    let mid = low + (high - low) / 2
    let pivot = arr[mid]

    var i = low
    var j = high

    while true {
        while arr[i] < pivot {
            i = i + 1
        }

        while arr[j] > pivot {
            j = j - 1
        }

        if i >= j {
            return j
        }

        let temp = arr[i]
        arr[i] = arr[j]
        arr[j] = temp

        i = i + 1
        j = j - 1
    }

    return j
}

// Mergesort implementation
fn mergesort_i64(arr: &![i64], len: usize) with Alloc, Panic, Div {
    if len <= 1 {
        return
    }

    let size_bytes = len * 8
    let temp = malloc(size_bytes) as *mut i64

    mergesort_recursive(&!arr, temp, 0, len - 1)

    free(temp as *mut u8)
}

fn mergesort_recursive(arr: &![i64], temp: *mut i64, left: usize, right: usize) with Panic, Div {
    if left >= right {
        return
    }

    let mid = left + (right - left) / 2

    mergesort_recursive(&!arr, temp, left, mid)
    mergesort_recursive(&!arr, temp, mid + 1, right)
    merge(&!arr, temp, left, mid, right)
}

fn merge(arr: &![i64], temp: *mut i64, left: usize, mid: usize, right: usize) with Panic, Div {
    var i = left
    while i <= right {
        temp[i] = arr[i]
        i = i + 1
    }

    var i1 = left
    var i2 = mid + 1
    var curr = left

    while i1 <= mid && i2 <= right {
        if temp[i1] <= temp[i2] {
            arr[curr] = temp[i1]
            i1 = i1 + 1
        } else {
            arr[curr] = temp[i2]
            i2 = i2 + 1
        }
        curr = curr + 1
    }

    while i1 <= mid {
        arr[curr] = temp[i1]
        i1 = i1 + 1
        curr = curr + 1
    }
}

// Heapsort implementation
fn heapsort_i64(arr: &![i64], len: usize) with Panic, Div {
    if len <= 1 {
        return
    }

    var i = len / 2
    while i > 0 {
        i = i - 1
        heapify(&!arr, len, i)
    }

    var end = len - 1
    while end > 0 {
        let temp = arr[0]
        arr[0] = arr[end]
        arr[end] = temp

        heapify(&!arr, end, 0)

        end = end - 1
    }
}

fn heapify(arr: &![i64], heap_size: usize, root: usize) with Panic {
    var largest = root
    let left = 2 * root + 1
    let right = 2 * root + 2

    if left < heap_size && arr[left] > arr[largest] {
        largest = left
    }

    if right < heap_size && arr[right] > arr[largest] {
        largest = right
    }

    if largest != root {
        let temp = arr[root]
        arr[root] = arr[largest]
        arr[largest] = temp

        heapify(&!arr, heap_size, largest)
    }
}

// Check if array is sorted
fn is_sorted(arr: &[i64], len: usize) -> bool with Panic, Div {
    if len <= 1 {
        return true
    }

    var i = 0
    while i < len - 1 {
        if arr[i] > arr[i + 1] {
            return false
        }
        i = i + 1
    }

    return true
}

// Print array helper
fn print_array(arr: &[i64], len: usize) with Panic {
    printf("  [".as_ptr())
    var i: usize = 0
    while i < len {
        if i > 0 {
            printf(", ".as_ptr())
        }
        printf("%lld".as_ptr(), arr[i])
        i = i + 1
    }
    printf("]\n".as_ptr())
}

// Copy array helper
fn copy_array(dest: &![i64], src: &[i64], len: usize) with Panic {
    var i: usize = 0
    while i < len {
        dest[i] = src[i]
        i = i + 1
    }
}

fn main() -> i32 with Alloc, Panic, Div {
    printf("Sorting Algorithms Comparison\n".as_ptr())
    printf("=============================\n\n".as_ptr())

    // Sample dataset
    let original = [64, 34, 25, 12, 22, 11, 90, 88, 45, 50, 23, 36]
    let len: usize = 12

    printf("Original array:\n".as_ptr())
    print_array(&original, len)
    printf("\n".as_ptr())

    // Test Quicksort
    printf("1. Quicksort (in-place, unstable)\n".as_ptr())
    var arr_quick = [64, 34, 25, 12, 22, 11, 90, 88, 45, 50, 23, 36]
    quicksort_i64(&!arr_quick, len)
    printf("   Sorted: ".as_ptr())
    print_array(&arr_quick, len)
    printf("   Verified: %s\n\n".as_ptr(),
           if is_sorted(&arr_quick, len) { "✓ Correct" } else { "✗ Failed" }.as_ptr())

    // Test Mergesort
    printf("2. Mergesort (stable, O(n) space)\n".as_ptr())
    var arr_merge = [64, 34, 25, 12, 22, 11, 90, 88, 45, 50, 23, 36]
    mergesort_i64(&!arr_merge, len)
    printf("   Sorted: ".as_ptr())
    print_array(&arr_merge, len)
    printf("   Verified: %s\n\n".as_ptr(),
           if is_sorted(&arr_merge, len) { "✓ Correct" } else { "✗ Failed" }.as_ptr())

    // Test Heapsort
    printf("3. Heapsort (in-place, unstable)\n".as_ptr())
    var arr_heap = [64, 34, 25, 12, 22, 11, 90, 88, 45, 50, 23, 36]
    heapsort_i64(&!arr_heap, len)
    printf("   Sorted: ".as_ptr())
    print_array(&arr_heap, len)
    printf("   Verified: %s\n\n".as_ptr(),
           if is_sorted(&arr_heap, len) { "✓ Correct" } else { "✗ Failed" }.as_ptr())

    // Verify all algorithms produce same result
    printf("Comparing results:\n".as_ptr())
    var all_match = true
    var i: usize = 0
    while i < len {
        if arr_quick[i] != arr_merge[i] || arr_merge[i] != arr_heap[i] {
            all_match = false
            break
        }
        i = i + 1
    }

    printf("  All algorithms agree: %s\n".as_ptr(),
           if all_match { "✓ Yes" } else { "✗ No" }.as_ptr())

    printf("\nSorting demo completed successfully!\n".as_ptr())
    return 0
}
