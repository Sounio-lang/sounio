//! Graph Algorithms Demonstration
//!
//! Demonstrates Dijkstra's shortest path, DFS, and BFS algorithms
//! on a sample weighted directed graph.

extern "C" {
    fn printf(fmt: *const u8, ...) -> i32;
    fn malloc(size: usize) -> *mut u8;
    fn free(ptr: *mut u8);
}

struct Edge {
    to: usize,
    weight: f64,
}

const INFINITY: f64 = 1.0e308

// Dijkstra's algorithm for shortest paths
fn dijkstra(adj: &[*const Edge], edge_counts: &[usize], n: usize, source: usize) -> *mut f64 with Alloc, Panic {
    // Allocate distance and visited arrays
    let dist = malloc(n * 8) as *mut f64
    let visited = malloc(n) as *mut bool

    // Initialize distances
    var i: usize = 0
    while i < n {
        dist[i] = INFINITY
        visited[i] = false
        i = i + 1
    }

    dist[source] = 0.0

    var remaining = n

    while remaining > 0 {
        // Find unvisited node with minimum distance
        var min_dist = INFINITY
        var min_node: i64 = -1

        i = 0
        while i < n {
            if !visited[i] && dist[i] < min_dist {
                min_dist = dist[i]
                min_node = i as i64
            }
            i = i + 1
        }

        if min_node == -1 {
            break
        }

        let u = min_node as usize
        visited[u] = true
        remaining = remaining - 1

        // Relax edges from u
        let edges = adj[u]
        let count = edge_counts[u]
        var j: usize = 0
        while j < count {
            let edge = &edges[j]
            let v = edge.to
            let new_dist = dist[u] + edge.weight

            if new_dist < dist[v] {
                dist[v] = new_dist
            }
            j = j + 1
        }
    }

    free(visited as *mut u8)
    return dist
}

// Breadth-first search
fn bfs(adj: &[*const Edge], edge_counts: &[usize], n: usize, source: usize) -> *mut i64 with Alloc, Panic {
    let distances = malloc(n * 8) as *mut i64

    var i: usize = 0
    while i < n {
        distances[i] = -1
        i = i + 1
    }

    // Simple queue using array
    let queue = malloc(n * 8) as *mut usize
    var head: usize = 0
    var tail: usize = 0

    distances[source] = 0
    queue[tail] = source
    tail = tail + 1

    while head < tail {
        let u = queue[head]
        head = head + 1

        let edges = adj[u]
        let count = edge_counts[u]
        var j: usize = 0
        while j < count {
            let v = edges[j].to
            if distances[v] == -1 {
                distances[v] = distances[u] + 1
                queue[tail] = v
                tail = tail + 1
            }
            j = j + 1
        }
    }

    free(queue as *mut u8)
    return distances
}

// Depth-first search
fn dfs_visit(adj: &[*const Edge], edge_counts: &[usize], u: usize, visited: &!*mut bool) with Panic {
    visited[u] = true

    let edges = adj[u]
    let count = edge_counts[u]
    var i: usize = 0
    while i < count {
        let v = edges[i].to
        if !visited[v] {
            dfs_visit(adj, edge_counts, v, visited)
        }
        i = i + 1
    }
}

fn dfs(adj: &[*const Edge], edge_counts: &[usize], n: usize, source: usize) -> *mut bool with Alloc, Panic {
    let visited = malloc(n) as *mut bool

    var i: usize = 0
    while i < n {
        visited[i] = false
        i = i + 1
    }

    dfs_visit(adj, edge_counts, source, &!visited)

    return visited
}

fn main() -> i32 with Alloc, Panic {
    printf("Graph Algorithms Demonstration\n".as_ptr())
    printf("===============================\n\n".as_ptr())

    // Build sample graph: 6 nodes (0-5)
    // Graph structure:
    //   0 -> 1 (2.0), 0 -> 2 (4.0)
    //   1 -> 2 (1.0), 1 -> 3 (7.0)
    //   2 -> 4 (3.0)
    //   3 -> 5 (1.0)
    //   4 -> 3 (2.0), 4 -> 5 (5.0)

    let n: usize = 6

    // Allocate edge arrays for each node
    let edges0 = malloc(2 * 16) as *mut Edge
    edges0[0] = Edge { to: 1, weight: 2.0 }
    edges0[1] = Edge { to: 2, weight: 4.0 }

    let edges1 = malloc(2 * 16) as *mut Edge
    edges1[0] = Edge { to: 2, weight: 1.0 }
    edges1[1] = Edge { to: 3, weight: 7.0 }

    let edges2 = malloc(1 * 16) as *mut Edge
    edges2[0] = Edge { to: 4, weight: 3.0 }

    let edges3 = malloc(1 * 16) as *mut Edge
    edges3[0] = Edge { to: 5, weight: 1.0 }

    let edges4 = malloc(2 * 16) as *mut Edge
    edges4[0] = Edge { to: 3, weight: 2.0 }
    edges4[1] = Edge { to: 5, weight: 5.0 }

    let edges5 = malloc(0) as *mut Edge

    // Build adjacency list
    let adj = [edges0 as *const Edge, edges1 as *const Edge, edges2 as *const Edge,
               edges3 as *const Edge, edges4 as *const Edge, edges5 as *const Edge]
    let edge_counts: [usize; 6] = [2, 2, 1, 1, 2, 0]

    printf("Graph structure (6 nodes, weighted edges):\n".as_ptr())
    printf("  0 -> 1 (2.0), 2 (4.0)\n".as_ptr())
    printf("  1 -> 2 (1.0), 3 (7.0)\n".as_ptr())
    printf("  2 -> 4 (3.0)\n".as_ptr())
    printf("  3 -> 5 (1.0)\n".as_ptr())
    printf("  4 -> 3 (2.0), 5 (5.0)\n\n".as_ptr())

    // Run Dijkstra from node 0
    printf("1. Dijkstra's Shortest Paths (from node 0):\n".as_ptr())
    let dist = dijkstra(&adj, &edge_counts, n, 0)

    var i: usize = 0
    while i < n {
        if dist[i] < INFINITY {
            printf("   Distance to node %zu: %.1f\n".as_ptr(), i, dist[i])
        } else {
            printf("   Distance to node %zu: ∞ (unreachable)\n".as_ptr(), i)
        }
        i = i + 1
    }
    printf("\n".as_ptr())

    // Run BFS from node 0
    printf("2. Breadth-First Search (from node 0):\n".as_ptr())
    let bfs_dist = bfs(&adj, &edge_counts, n, 0)

    i = 0
    while i < n {
        if bfs_dist[i] >= 0 {
            printf("   BFS distance to node %zu: %lld hops\n".as_ptr(), i, bfs_dist[i])
        } else {
            printf("   Node %zu: unreachable\n".as_ptr(), i)
        }
        i = i + 1
    }
    printf("\n".as_ptr())

    // Run DFS from node 0
    printf("3. Depth-First Search (from node 0):\n".as_ptr())
    let visited = dfs(&adj, &edge_counts, n, 0)

    printf("   Visited nodes: ".as_ptr())
    i = 0
    var first = true
    while i < n {
        if visited[i] {
            if !first {
                printf(", ".as_ptr())
            }
            printf("%zu".as_ptr(), i)
            first = false
        }
        i = i + 1
    }
    printf("\n\n".as_ptr())

    // Verify shortest path to node 5
    printf("Shortest path from 0 to 5:\n".as_ptr())
    printf("  Dijkstra distance: %.1f\n".as_ptr(), dist[5])
    printf("  Path: 0 -> 1 -> 2 -> 4 -> 3 -> 5\n".as_ptr())
    printf("  (2.0 + 1.0 + 3.0 + 2.0 + 1.0 = 9.0)\n".as_ptr())

    // Clean up
    free(dist as *mut u8)
    free(bfs_dist as *mut u8)
    free(visited as *mut u8)
    free(edges0 as *mut u8)
    free(edges1 as *mut u8)
    free(edges2 as *mut u8)
    free(edges3 as *mut u8)
    free(edges4 as *mut u8)

    printf("\nGraph algorithms completed successfully!\n".as_ptr())
    return 0
}
