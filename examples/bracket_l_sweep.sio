//@ run-pass
//@ expect-stdout: ALL PASS

// Bracket L-Sweep: L={6,8,10,12,16,20} - convergence vs sequence length

fn exp_q(x: f64) -> f64 with Mut, Div, Panic {
    if x > 15.0 { return exp_q(7.5) * exp_q(x - 7.5) }
    if x < 0.0 - 15.0 { return 0.0 }
    var sum = 1.0; var term = 1.0; var i = 1
    while i <= 20 { term = term * x / (i as f64); sum = sum + term; i = i + 1 }
    sum
}

var RNG_A: i64 = 0; var RNG_B: i64 = 0
fn rng_seed(a: i64, b: i64) with Mut { RNG_A = a; RNG_B = b }
fn rng_next() -> i64 with Mut {
    var x = RNG_A; let y = RNG_B; RNG_A = y
    x = x ^ (x << 23); x = x ^ (x >> 17); x = x ^ (y ^ (y >> 26))
    RNG_B = x; let r = x + y; if r < 0 { 0 - r } else { r }
}

var SEQ: [i64; 20] = [0; 20]; var SEQ_LEN: i64 = 0
var STK: [i64; 10] = [0; 10]; var STK_TOP: i64 = 0

fn check_balanced(slen: i64) -> i64 with Mut {
    STK_TOP = 0; var i = 0
    while i < slen {
        let tok = SEQ[i]
        if tok == 1 { STK[STK_TOP] = 1; STK_TOP = STK_TOP + 1 }
        if tok == 3 { STK[STK_TOP] = 3; STK_TOP = STK_TOP + 1 }
        if tok == 2 { if STK_TOP == 0 { return 0 }; STK_TOP = STK_TOP - 1; if STK[STK_TOP] != 1 { return 0 } }
        if tok == 4 { if STK_TOP == 0 { return 0 }; STK_TOP = STK_TOP - 1; if STK[STK_TOP] != 3 { return 0 } }
        if STK_TOP > 9 { return 0 }
        i = i + 1
    }
    if STK_TOP == 0 { 1 } else { 0 }
}

fn generate_balanced(slen: i64) with Mut, Div {
    STK_TOP = 0; var pos = 0
    while pos < slen {
        let remaining = slen - pos
        let can_open = STK_TOP < remaining / 2
        let can_close = STK_TOP > 0
        var choice = 0
        if can_open { if can_close { choice = (rng_next() / 100) % 2 } }
        if can_open { if can_close == false { choice = 0 } }
        if can_open == false { if can_close { choice = 1 } }
        if choice == 0 {
            let btype = (rng_next() / 100) % 2
            if btype == 0 { SEQ[pos] = 1; STK[STK_TOP] = 1 }
            if btype == 1 { SEQ[pos] = 3; STK[STK_TOP] = 3 }
            STK_TOP = STK_TOP + 1
        }
        if choice == 1 {
            STK_TOP = STK_TOP - 1
            let top = STK[STK_TOP]
            if top == 1 { SEQ[pos] = 2 }
            if top == 3 { SEQ[pos] = 4 }
        }
        pos = pos + 1
    }
}

fn generate_unbalanced(slen: i64) with Mut, Div {
    var attempts = 0; var done = 0
    while done == 0 {
        var i = 0
        while i < slen { SEQ[i] = (rng_next() / 100) % 4 + 1; i = i + 1 }
        if check_balanced(slen) == 0 { done = 1 }
        attempts = attempts + 1
        if attempts > 30 { SEQ[0] = 2; SEQ[1] = 4; done = 1 }
    }
}

fn generate_sample_br(slen: i64) -> i64 with Mut, Div {
    let cls = (rng_next() / 100) % 2
    if cls == 1 { generate_balanced(slen) }
    if cls == 0 { generate_unbalanced(slen) }
    SEQ_LEN = slen; cls
}

var W: [i64; 128] = [0; 128]; var H: [i64; 8] = [0; 8]; var L: [i64; 2] = [0; 2]; var MOM: [i64; 128] = [0; 128]

fn ws(i: i64, v: f64) with Mut { W[i] = (v * 100000000.0) as i64 }
fn wg(i: i64) -> f64 with Div { (W[i] as f64) / 100000000.0 }
fn hs(i: i64, v: f64) with Mut { H[i] = (v * 100000000.0) as i64 }
fn hg(i: i64) -> f64 with Div { (H[i] as f64) / 100000000.0 }

fn init_model(is_cross: i64) with Mut, Div, Panic {
    var i = 0
    while i < 40 { ws(i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 64 {
        var v = ((rng_next() % 2000) as f64 - 1000.0) / 10000.0
        let row = i / 8; let col = i - row * 8
        if row == col { v = 0.95 }
        if is_cross == 0 { if row != col { v = 0.0 } }
        ws(40 + i, v); i = i + 1
    }
    i = 0
    while i < 8 { ws(104 + i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 16 { ws(112 + i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 128 { MOM[i] = 0; i = i + 1 }
}

fn model_step(token: i64, is_cross: i64) with Mut, Div {
    if is_cross == 1 {
        var new_h: [f64; 8] = [0.0; 8]; var d = 0
        while d < 8 {
            let inp = wg(token * 8 + d)
            var s = 0.0; var j = 0
            while j < 8 { s = s + wg(40 + d*8 + j) * hg(j); j = j + 1 }
            s = s + wg(104 + d) * inp
            if s > 5.0 { s = 5.0 } if s < 0.0 - 5.0 { s = 0.0 - 5.0 }
            new_h[d] = s; d = d + 1
        }
        d = 0
        while d < 8 { hs(d, new_h[d]); d = d + 1 }
    } else {
        var d = 0
        while d < 8 {
            var s = wg(40 + d) * hg(d) + wg(104 + d) * wg(token * 8 + d)
            if s > 5.0 { s = 5.0 } if s < 0.0 - 5.0 { s = 0.0 - 5.0 }
            hs(d, s); d = d + 1
        }
    }
}

fn compute_logits() with Mut, Div {
    var c = 0
    while c < 2 {
        var s = 0.0; var d = 0
        while d < 8 { s = s + hg(d) * wg(112 + d*2 + c); d = d + 1 }
        L[c] = (s * 100000000.0) as i64; c = c + 1
    }
}

fn get_pred() -> i64 with Mut, Div {
    let v0 = (L[0] as f64) / 100000000.0
    let v1 = (L[1] as f64) / 100000000.0
    if v1 > v0 { 1 } else { 0 }
}

fn update_output(tgt: i64, lr: f64) with Mut, Div, Panic {
    var mx = (L[0] as f64) / 100000000.0
    let v1 = (L[1] as f64) / 100000000.0
    if v1 > mx { mx = v1 }
    var probs: [f64; 2] = [0.0; 2]; var se = 0.0; var i = 0
    while i < 2 { probs[i] = exp_q((L[i] as f64) / 100000000.0 - mx); se = se + probs[i]; i = i + 1 }
    i = 0
    while i < 2 { probs[i] = probs[i] / se; i = i + 1 }
    probs[tgt] = probs[tgt] - 1.0
    var d = 0
    while d < 8 {
        let hd = hg(d)
        var c = 0
        while c < 2 {
            let idx = 112 + d*2 + c
            var g = hd * probs[c]
            if g > 0.3 { g = 0.3 } if g < 0.0 - 0.3 { g = 0.0 - 0.3 }
            let m = (MOM[idx] as f64) / 100000000.0 * 0.9 + g
            MOM[idx] = (m * 100000000.0) as i64
            ws(idx, wg(idx) - lr * m)
            c = c + 1
        }
        d = d + 1
    }
}

fn run_bracket(is_cross: i64, slen: i64) -> f64 with IO, Mut, Div, Panic {
    let n_train = 250; let n_epochs = 35
    var ep = 0
    while ep < n_epochs {
        var s = 0
        while s < n_train {
            let cls = generate_sample_br(slen)
            var d = 0
            while d < 8 { H[d] = 0; d = d + 1 }
            var t = 0
            while t < SEQ_LEN { model_step(SEQ[t], is_cross); t = t + 1 }
            compute_logits()
            if get_pred() == cls { }
            update_output(cls, 0.01)
            s = s + 1
        }
        ep = ep + 1
    }
    rng_seed(99999, 11111)
    var correct = 0; var s = 0
    while s < 100 {
        let cls = generate_sample_br(slen)
        var d = 0
        while d < 8 { H[d] = 0; d = d + 1 }
        var t = 0
        while t < SEQ_LEN { model_step(SEQ[t], is_cross); t = t + 1 }
        compute_logits()
        if get_pred() == cls { correct = correct + 1 }
        s = s + 1
    }
    (correct as f64) / 100.0 * 100.0
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("Bracket L-Sweep: L={6,8,10,12,16,20}\n\n")

    var l_vals: [i64; 6] = [6, 8, 10, 12, 16, 20]
    var idx = 0
    while idx < 6 {
        let l = l_vals[idx]
        print("L="); print_int(l); print(": ")

        rng_seed(55555 + l, 77777); init_model(1)
        rng_seed(12345, 67890)
        let acc_cross = run_bracket(1, l)
        print("O-SSM="); print(acc_cross); print("% ")

        rng_seed(55555 + l, 77777); init_model(0)
        rng_seed(12345, 67890)
        let acc_diag = run_bracket(0, l)
        print("Diag="); print(acc_diag); print("%\n")

        idx = idx + 1
    }

    println("\nALL PASS")
    0
}
