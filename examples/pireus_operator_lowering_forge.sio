//@ run-pass
//!
//! First matcher-free Sounio authority executable for Operator-Lowering Forge
//! v6. Every value printed here is produced by Sounio at execution time.

use hardware::pireus::operator_lowering_forge::{
    PireusOlfDigest,
    PIREUS_OLF_OK,
    PIREUS_OLF_NODE_COUNT,
    PIREUS_OLF_PACK_COUNT,
    PIREUS_OLF_ROUTE_COUNT,
    PIREUS_OLF_SERIALIZATION_COUNT,
    PIREUS_OLF_TARGET_COUNT,
    pireus_operator_lowering_request,
    pireus_operator_lowering_evaluate,
    pireus_operator_lowering_frozen_mismatch_code,
}

fn bit(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(digest: &PireusOlfDigest) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(digest.words[word])
        word = word + 1
    }
}

fn print_hash(words: &[i64; 8]) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(words[word])
        word = word + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_operator_lowering_request()
    let result = pireus_operator_lowering_evaluate(&request)

    print("SOUNIO_AUTHORITY schema=pireus-operator-lowering-forge.v6")
    print(" role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE\n")

    print("PIREUS_OLF_LINEAGE parent_live_match=")
    print_int(bit(result.lineage.parent_live_match))
    print(" parent_valid="); print_int(bit(result.lineage.parent_valid))
    print(" parent_semantics_frozen=")
    print_int(bit(result.lineage.parent_semantics_frozen))
    print(" parent_operator_classes=")
    print_int(result.lineage.parent_operator_classes)
    print(" parent_selected_child=")
    print_int(result.lineage.parent_selected_child)
    print(" parent_ranking=")
    print_int(bit(result.lineage.parent_ranking_present))
    print(" complete="); print_int(bit(result.lineage.complete))
    print(" parent_forge=")
    print_hash(&result.lineage.parent_forge_digest)
    print("\n")

    print("PIREUS_OLF_GRAMMAR node_checks=")
    print_int(result.grammar.node_checks)
    print(" node_failures="); print_int(result.grammar.node_failures)
    print(" pack_checks="); print_int(result.grammar.pack_checks)
    print(" pack_failures="); print_int(result.grammar.pack_failures)
    print(" route_checks="); print_int(result.grammar.route_checks)
    print(" route_failures="); print_int(result.grammar.route_failures)
    print(" serialization_checks=")
    print_int(result.grammar.serialization_checks)
    print(" serialization_failures=")
    print_int(result.grammar.serialization_failures)
    print(" shape_checks="); print_int(result.grammar.shape_checks)
    print(" shape_failures="); print_int(result.grammar.shape_failures)
    print(" complete="); print_int(bit(result.grammar.complete)); print("\n")

    var index: i64 = 0
    while index < PIREUS_OLF_NODE_COUNT {
        print("PIREUS_OLF_GRAMMAR_NODE index="); print_int(index)
        print(" kind="); print_int(result.grammar.node_kinds[index])
        print("\n")
        index = index + 1
    }
    index = 0
    while index < PIREUS_OLF_PACK_COUNT {
        print("PIREUS_OLF_GRAMMAR_PACK index="); print_int(index)
        print(" width="); print_int(result.grammar.pack_widths[index])
        print("\n")
        index = index + 1
    }
    index = 0
    while index < PIREUS_OLF_ROUTE_COUNT {
        print("PIREUS_OLF_GRAMMAR_ROUTE index="); print_int(index)
        print(" kind="); print_int(result.grammar.route_kinds[index])
        print("\n")
        index = index + 1
    }
    index = 0
    while index < PIREUS_OLF_SERIALIZATION_COUNT {
        print("PIREUS_OLF_GRAMMAR_SERIALIZATION index=")
        print_int(index)
        print(" kind=")
        print_int(result.grammar.serialization_kinds[index])
        print("\n")
        index = index + 1
    }

    print("PIREUS_OLF_TARGETS required_endpoints=")
    print_int(result.targets.required_endpoints)
    print(" observed_endpoints=")
    print_int(result.targets.observed_endpoint_total)
    print(" unresolved_endpoints=")
    print_int(result.targets.unresolved_endpoints)
    print(" checks="); print_int(result.targets.target_checks)
    print(" failures="); print_int(result.targets.target_failures)
    print(" complete="); print_int(bit(result.targets.complete)); print("\n")
    index = 0
    while index < PIREUS_OLF_TARGET_COUNT {
        print("PIREUS_OLF_TARGET index="); print_int(index)
        print(" id="); print_int(result.targets.target_ids[index])
        print(" endpoints=")
        print_int(result.targets.endpoint_requirements[index])
        print(" observed=")
        print_int(result.targets.observed_endpoints[index])
        print(" material_receipts=")
        print_int(result.targets.material_receipts[index])
        print(" primitive_candidate=")
        print_int(result.targets.primitive_candidates[index])
        print(" candidate_only=")
        print_int(bit(result.targets.candidate_only[index]))
        print("\n")
        index = index + 1
    }

    print("PIREUS_OLF_SEMANTICS operator_classes=")
    print_int(result.semantics.operator_classes)
    print(" representative_checks=")
    print_int(result.semantics.representative_checks)
    print(" representative_failures=")
    print_int(result.semantics.representative_failures)
    print(" parent_relation_checks=")
    print_int(result.semantics.parent_relation_checks)
    print(" parent_relation_failures=")
    print_int(result.semantics.parent_relation_failures)
    print(" partner_checks="); print_int(result.semantics.partner_checks)
    print(" partner_failures=")
    print_int(result.semantics.partner_failures)
    print(" sign_checks="); print_int(result.semantics.sign_checks)
    print(" sign_failures="); print_int(result.semantics.sign_failures)
    print(" roundtrip_word_checks=")
    print_int(result.semantics.roundtrip_word_checks)
    print(" roundtrip_word_failures=")
    print_int(result.semantics.roundtrip_word_failures)
    print(" order_checks="); print_int(result.semantics.order_checks)
    print(" order_failures="); print_int(result.semantics.order_failures)
    print(" destination_checks=")
    print_int(result.semantics.destination_checks)
    print(" destination_failures=")
    print_int(result.semantics.destination_failures)
    print(" definitional_reconstruction=")
    print_int(bit(result.semantics.definitional_reconstruction))
    print(" complete="); print_int(bit(result.semantics.complete)); print("\n")
    index = 0
    while index < result.semantics.operator_classes {
        print("PIREUS_OLF_OPERATOR_CLASS id="); print_int(index)
        print(" representative=")
        print_int(result.semantics.representatives[index])
        print("\n")
        index = index + 1
    }

    print("PIREUS_OLF_ATLAS candidates=")
    print_int(result.atlas.candidate_count)
    print(" attempts="); print_int(result.atlas.generation_attempts)
    print(" overflows="); print_int(result.atlas.capacity_overflows)
    print(" operator_classes=")
    print_int(result.semantics.operator_classes)
    print(" program_classes=")
    print_int(result.atlas.program_class_count)
    print(" machine_classes=")
    print_int(result.atlas.machine_class_count)
    print(" complete="); print_int(bit(result.atlas.complete)); print("\n")

    index = 0
    while index < result.atlas.candidate_count {
        print("PIREUS_OLF_CELL id="); print_int(index)
        print(" operator_class=")
        print_int(result.atlas.operator_class_ids[index])
        print(" operator_representative=")
        print_int(result.atlas.operator_representatives[index])
        print(" target="); print_int(result.atlas.target_ids[index])
        print(" pack="); print_int(result.atlas.pack_widths[index])
        print(" route="); print_int(result.atlas.route_kinds[index])
        print(" serialization=")
        print_int(result.atlas.serialization_kinds[index])
        print(" order="); print_int(result.atlas.order_kinds[index])
        print(" primitive=")
        print_int(result.atlas.primitive_kinds[index])
        print(" program_class=")
        print_int(result.atlas.program_class_ids[index])
        print(" program_representative=")
        print_int(result.atlas.program_representatives[index])
        print(" machine_class=")
        print_int(result.atlas.machine_class_ids[index])
        print(" residual_mask=")
        print_int(result.atlas.residual_masks[index])
        print(" seed_kind=")
        print_int(result.atlas.seed_kinds[index])
        print(" discharged_mask=")
        print_int(result.atlas.discharged_obligation_masks[index])
        print(" unresolved_mask=")
        print_int(result.atlas.unresolved_obligation_masks[index])
        print("\n")
        index = index + 1
    }

    print("PIREUS_OLF_QUOTIENT program_checks=")
    print_int(result.atlas.program_equivalence_checks)
    print(" program_failures=")
    print_int(result.atlas.program_equivalence_failures)
    print(" separation_checks=")
    print_int(result.atlas.program_separation_checks)
    print(" separation_failures=")
    print_int(result.atlas.program_separation_failures)
    print(" machine_checks=")
    print_int(result.atlas.machine_equivalence_checks)
    print(" machine_failures=")
    print_int(result.atlas.machine_equivalence_failures)
    print(" serialization_checks=")
    print_int(result.atlas.serialization_collapse_checks)
    print(" serialization_failures=")
    print_int(result.atlas.serialization_collapse_failures)
    print(" order_checks=")
    print_int(result.atlas.order_separation_checks)
    print(" order_failures=")
    print_int(result.atlas.order_separation_failures)
    print("\n")

    print("PIREUS_OLF_RESIDUALS count=")
    print_int(result.atlas.residual_count)
    print(" lowering_seeds=")
    print_int(result.atlas.lowering_seed_count)
    print(" primitive_seeds=")
    print_int(result.atlas.primitive_seed_count)
    print(" fabric_seeds=")
    print_int(result.atlas.fabric_seed_count)
    print(" operator_seeds=")
    print_int(result.atlas.operator_seed_count)
    print(" discharged_obligations=")
    print_int(result.atlas.discharged_obligations)
    print(" unresolved_obligations=")
    print_int(result.atlas.unresolved_obligations)
    print(" refuted_obligations=")
    print_int(result.atlas.refuted_obligations)
    print(" admitted_lowerings=")
    print_int(result.atlas.admitted_lowerings)
    print(" selected="); print_int(result.atlas.selected_candidate)
    print(" ranking="); print_int(bit(result.atlas.ranking_present))
    print("\n")

    print("PIREUS_OLF_RECEIPT parent=")
    print_int(bit(result.receipt.parent_lineage_bound))
    print(" grammar=")
    print_int(bit(result.receipt.graph_grammar_complete))
    print(" semantics=")
    print_int(bit(result.receipt.semantic_decomposition_complete))
    print(" semantics_definitional=")
    print_int(bit(result.receipt.semantic_decomposition_definitional))
    print(" targets=")
    print_int(bit(result.receipt.target_envelopes_complete))
    print(" operator_q=")
    print_int(bit(result.receipt.operator_quotient_inherited))
    print(" program_q=")
    print_int(bit(result.receipt.declared_program_quotient_complete))
    print(" machine_envelope_q=")
    print_int(bit(result.receipt.declared_machine_envelope_quotient_complete))
    print(" material_machine_q=")
    print_int(bit(result.receipt.material_machine_quotient_complete))
    print(" residuals=")
    print_int(bit(result.receipt.typed_residuals_complete))
    print(" seed_taxonomy=")
    print_int(bit(result.receipt.typed_seed_taxonomy_complete))
    print(" operator_seed_generated=")
    print_int(bit(result.receipt.operator_seed_generated))
    print(" semantics_frozen=")
    print_int(bit(result.receipt.semantics_frozen))
    print(" parity_open=")
    print_int(bit(result.receipt.material_parity_open))
    print(" claim_ready="); print_int(bit(result.receipt.claim_ready))
    print("\n")

    print("PIREUS_OLF_NEGATIVES passed=")
    print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")

    print("PIREUS_OLF_DIGEST lineage=")
    print_digest(&result.lineage_digest)
    print(" grammar="); print_digest(&result.grammar_digest)
    print(" targets="); print_digest(&result.target_digest)
    print(" semantics="); print_digest(&result.semantic_digest)
    print(" atlas="); print_digest(&result.atlas_digest)
    print(" receipt="); print_digest(&result.receipt_digest)
    print(" forge="); print_digest(&result.forge_digest)
    print("\n")

    print("PIREUS_OLF_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(result.failures)
    print(" valid="); print_int(bit(result.valid)); print("\n")

    let frozen_mismatch_code =
        pireus_operator_lowering_frozen_mismatch_code(&result)
    let frozen_match = frozen_mismatch_code == 0
    print(" frozen_match="); print_int(bit(frozen_match)); print("\n")
    print(" frozen_mismatch_code=")
    print_int(frozen_mismatch_code)
    print("\n")

    if result.valid && result.error == PIREUS_OLF_OK &&
        result.failures == 0 && result.atlas.candidate_count > 0 &&
        result.atlas.program_class_count > 0 &&
        result.atlas.residual_count == result.atlas.candidate_count &&
        result.atlas.admitted_lowerings == 0 &&
        result.atlas.selected_candidate == -1 &&
        !result.receipt.semantics_frozen &&
        !result.receipt.claim_ready && frozen_match { 0 } else { 1 }
}
