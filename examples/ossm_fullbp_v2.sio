//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// O-SSM Full-BPTT v2: Continuous Value Encoding
// ═══════════════════════════════════════════════════════════════════════════
//
// FIX: v1 discretized values via SQ[t]%8 token index, losing order info.
// v2 uses continuous encoding: inp[d] = wg(d) * (val/100.0)
// This matches sorting_classification_benchmark.sio which got 69.5%.
//
// Architecture:
//   Input: 1 scalar → 8-dim via wg(d) * val (scalar broadcast)
//   A: 8x8 full matrix (cross-dim) or 8 diagonal
//   B: 8 input gate
//   Output: 8 → 3 classes (asc/desc/unsorted)
//
// Training (TWO PHASES):
//   Phase 1 (ep 0-29): Output-only gradients, LR=0.01, momentum=0.9
//   Phase 2 (ep 30-79): Full BPTT, LR_A=0.0005, LR_out=0.005
//
// BPTT:
//   Save h_t, x_t at each timestep
//   dL/dA += dh_{t+1} * h_t^T, dL/dB += dh_{t+1} * x_t
//   dh_t = A^T * dh_{t+1}, clip to [-1,1]
// ═══════════════════════════════════════════════════════════════════════════

fn exp_q(x: f64) -> f64 with Mut, Div, Panic {
    if x > 15.0 { return exp_q(7.5) * exp_q(x - 7.5) }
    if x < 0.0 - 15.0 { return 0.0 }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 20 { term = term * x / (i as f64); sum = sum + term; i = i + 1 }
    sum
}

var RNG_A: i64 = 0
var RNG_B: i64 = 0
fn rng_seed(a: i64, b: i64) with Mut { RNG_A = a; RNG_B = b }
fn rng_next() -> i64 with Mut {
    var x = RNG_A
    let y = RNG_B
    RNG_A = y
    x = x ^ (x << 23)
    x = x ^ (x >> 17)
    x = x ^ (y ^ (y >> 26))
    RNG_B = x
    let r = x + y
    if r < 0 { 0 - r } else { r }
}

// ─── Sequence generation ───
var SQ: [i64; 32] = [0; 32]

fn gen_sorted_asc(k: i64) with Mut, Div {
    var i = 0
    while i < k { SQ[i] = (rng_next() / 100) % 100; i = i + 1 }
    i = 0
    while i < k {
        var j = 0
        while j < k - 1 - i {
            if SQ[j] > SQ[j+1] {
                let tmp = SQ[j]
                SQ[j] = SQ[j+1]
                SQ[j+1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn gen_sorted_desc(k: i64) with Mut, Div {
    gen_sorted_asc(k)
    var i = 0
    while i < k / 2 {
        let tmp = SQ[i]
        SQ[i] = SQ[k - 1 - i]
        SQ[k - 1 - i] = tmp
        i = i + 1
    }
}

fn gen_unsorted(k: i64) with Mut, Div {
    var i = 0
    while i < k { SQ[i] = (rng_next() / 100) % 100; i = i + 1 }
    var ia = 1
    var id = 1
    i = 0
    while i < k - 1 {
        if SQ[i] > SQ[i+1] { ia = 0 }
        if SQ[i] < SQ[i+1] { id = 0 }
        i = i + 1
    }
    if ia == 1 { let tmp = SQ[0]; SQ[0] = SQ[1]; SQ[1] = tmp }
    if id == 1 { let tmp = SQ[0]; SQ[0] = SQ[1]; SQ[1] = tmp }
}

fn gen_sample(k: i64) -> i64 with Mut, Div {
    let cls = (rng_next() / 100) % 3
    if cls == 0 { gen_sorted_asc(k) }
    if cls == 1 { gen_sorted_desc(k) }
    if cls == 2 { gen_unsorted(k) }
    cls
}

// ─── Model weights ───
// Layout: embed 8 (0-7), A 64 (8-71), B 8 (72-79), out 24 (80-103) = 104
var W: [i64; 104] = [0; 104]
var H: [i64; 8] = [0; 8]
var L: [i64; 3] = [0; 3]
var MOM: [i64; 104] = [0; 104]

// BPTT storage: max 32 timesteps x 8 dims = 256
var H_SAVE: [i64; 256] = [0; 256]
var X_SAVE: [i64; 256] = [0; 256]
var N_STEPS: i64 = 0

// Gradient accumulators
var DA: [i64; 64] = [0; 64]
var DB: [i64; 8] = [0; 8]
var DH: [i64; 8] = [0; 8]

fn ws(i: i64, v: f64) with Mut { W[i] = (v * 100000000.0) as i64 }
fn wg(i: i64) -> f64 with Div { (W[i] as f64) / 100000000.0 }
fn hs(i: i64, v: f64) with Mut { H[i] = (v * 100000000.0) as i64 }
fn hg(i: i64) -> f64 with Div { (H[i] as f64) / 100000000.0 }

// ─── Init for cross (full 8x8 A) ───
fn init_embed() with Mut, Div {
    var i = 0
    while i < 8 {
        ws(i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0)
        i = i + 1
    }
}

fn init_A_cross() with Mut, Div {
    var i = 0
    while i < 64 {
        var v = ((rng_next() % 2000) as f64 - 1000.0) / 10000.0
        let row = i / 8
        let col = i - row * 8
        if row == col { v = 0.95 }
        ws(8 + i, v)
        i = i + 1
    }
}

fn init_A_diag() with Mut, Div {
    var i = 0
    while i < 64 { ws(8 + i, 0.0); i = i + 1 }
    i = 0
    while i < 8 { ws(8 + i * 8 + i, 0.95); i = i + 1 }
}

fn init_B_and_out() with Mut, Div {
    var i = 0
    while i < 8 {
        ws(72 + i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0)
        i = i + 1
    }
    i = 0
    while i < 24 {
        ws(80 + i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0)
        i = i + 1
    }
}

fn init_model(is_cross: i64) with Mut, Div {
    init_embed()
    if is_cross == 1 { init_A_cross() } else { init_A_diag() }
    init_B_and_out()
    var i = 0
    while i < 104 { MOM[i] = 0; i = i + 1 }
}

// ─── Forward step with continuous encoding + state saving ───
fn save_h(step: i64) with Mut {
    var d = 0
    while d < 8 { H_SAVE[step * 8 + d] = H[d]; d = d + 1 }
}

fn save_x(step: i64, val: f64) with Mut, Div {
    var d = 0
    while d < 8 {
        let inp = wg(d) * val
        X_SAVE[step * 8 + d] = (inp * 100000000.0) as i64
        d = d + 1
    }
}

fn fwd_step_cross(val: f64) with Mut, Div {
    var new_h: [f64; 8] = [0.0; 8]
    var d = 0
    while d < 8 {
        let inp = wg(d) * val
        var s = 0.0
        var j = 0
        while j < 8 { s = s + wg(8 + d * 8 + j) * hg(j); j = j + 1 }
        s = s + wg(72 + d) * inp
        if s > 5.0 { s = 5.0 }
        if s < 0.0 - 5.0 { s = 0.0 - 5.0 }
        new_h[d] = s
        d = d + 1
    }
    d = 0
    while d < 8 { hs(d, new_h[d]); d = d + 1 }
}

fn fwd_step_diag(val: f64) with Mut, Div {
    var d = 0
    while d < 8 {
        let inp = wg(d) * val
        var s = wg(8 + d * 8 + d) * hg(d) + wg(72 + d) * inp
        if s > 5.0 { s = 5.0 }
        if s < 0.0 - 5.0 { s = 0.0 - 5.0 }
        hs(d, s)
        d = d + 1
    }
}

fn model_step_save(val: f64, step: i64, is_cross: i64) with Mut, Div {
    save_h(step)
    save_x(step, val)
    if is_cross == 1 { fwd_step_cross(val) } else { fwd_step_diag(val) }
}

// ─── Forward without save (for eval) ───
fn model_step(val: f64, is_cross: i64) with Mut, Div {
    if is_cross == 1 { fwd_step_cross(val) } else { fwd_step_diag(val) }
}

fn compute_logits() with Mut, Div {
    var c = 0
    while c < 3 {
        var s = 0.0
        var d = 0
        while d < 8 { s = s + hg(d) * wg(80 + d * 3 + c); d = d + 1 }
        L[c] = (s * 100000000.0) as i64
        c = c + 1
    }
}

fn get_pred() -> i64 with Div {
    var best = 0
    var bv = (L[0] as f64) / 100000000.0
    var i = 1
    while i < 3 {
        let v = (L[i] as f64) / 100000000.0
        if v > bv { bv = v; best = i }
        i = i + 1
    }
    best
}

// ─── Softmax probs into global ───
var PROBS: [f64; 3] = [0.0; 3]

fn compute_probs(tgt: i64) with Mut, Div, Panic {
    var mx = (L[0] as f64) / 100000000.0
    var i = 1
    while i < 3 {
        let v = (L[i] as f64) / 100000000.0
        if v > mx { mx = v }
        i = i + 1
    }
    var se = 0.0
    i = 0
    while i < 3 {
        PROBS[i] = exp_q((L[i] as f64) / 100000000.0 - mx)
        se = se + PROBS[i]
        i = i + 1
    }
    i = 0
    while i < 3 { PROBS[i] = PROBS[i] / se; i = i + 1 }
    PROBS[tgt] = PROBS[tgt] - 1.0
}

// ─── Output-only gradient update (Phase 1) ───
fn update_output_only(tgt: i64, lr: f64) with Mut, Div, Panic {
    compute_probs(tgt)
    var d = 0
    while d < 8 {
        let hd = hg(d)
        var c = 0
        while c < 3 {
            let idx = 80 + d * 3 + c
            var g = hd * PROBS[c]
            if g > 0.3 { g = 0.3 }
            if g < 0.0 - 0.3 { g = 0.0 - 0.3 }
            let m = (MOM[idx] as f64) / 100000000.0 * 0.9 + g
            MOM[idx] = (m * 100000000.0) as i64
            ws(idx, wg(idx) - lr * m)
            c = c + 1
        }
        d = d + 1
    }
}

// ─── BPTT: compute dL/dh_final from output layer ───
fn bptt_output_grad(tgt: i64, lr_out: f64) with Mut, Div, Panic {
    compute_probs(tgt)
    // Update output weights + compute dL/dh
    var d = 0
    while d < 8 {
        let hd = hg(d)
        var dh_d = 0.0
        var c = 0
        while c < 3 {
            let idx = 80 + d * 3 + c
            var g = hd * PROBS[c]
            if g > 0.5 { g = 0.5 }
            if g < 0.0 - 0.5 { g = 0.0 - 0.5 }
            let m = (MOM[idx] as f64) / 100000000.0 * 0.9 + g
            MOM[idx] = (m * 100000000.0) as i64
            ws(idx, wg(idx) - lr_out * m)
            dh_d = dh_d + wg(80 + d * 3 + c) * PROBS[c]
            c = c + 1
        }
        DH[d] = (dh_d * 100000000.0) as i64
        d = d + 1
    }
}

// ─── BPTT: accumulate dA and dB at one timestep (cross) ───
fn bptt_accum_cross(t: i64) with Mut, Div {
    var d = 0
    while d < 8 {
        var dh_clip = (DH[d] as f64) / 100000000.0
        if dh_clip > 0.5 { dh_clip = 0.5 }
        if dh_clip < 0.0 - 0.5 { dh_clip = 0.0 - 0.5 }
        // dA[d,j] += dh_clip * h_t[j]
        var j = 0
        while j < 8 {
            let ht_j = (H_SAVE[t * 8 + j] as f64) / 100000000.0
            DA[d * 8 + j] = DA[d * 8 + j] + (dh_clip * ht_j * 100000000.0) as i64
            j = j + 1
        }
        // dB[d] += dh_clip * x_t[d]
        let xt_d = (X_SAVE[t * 8 + d] as f64) / 100000000.0
        DB[d] = DB[d] + (dh_clip * xt_d * 100000000.0) as i64
        d = d + 1
    }
}

// ─── BPTT: accumulate dA and dB at one timestep (diagonal) ───
fn bptt_accum_diag(t: i64) with Mut, Div {
    var d = 0
    while d < 8 {
        var dh_clip = (DH[d] as f64) / 100000000.0
        if dh_clip > 0.5 { dh_clip = 0.5 }
        if dh_clip < 0.0 - 0.5 { dh_clip = 0.0 - 0.5 }
        let ht_d = (H_SAVE[t * 8 + d] as f64) / 100000000.0
        DA[d * 8 + d] = DA[d * 8 + d] + (dh_clip * ht_d * 100000000.0) as i64
        let xt_d = (X_SAVE[t * 8 + d] as f64) / 100000000.0
        DB[d] = DB[d] + (dh_clip * xt_d * 100000000.0) as i64
        d = d + 1
    }
}

// ─── BPTT: propagate dh backward through A^T (cross) ───
fn bptt_prop_cross() with Mut, Div {
    var new_dh: [f64; 8] = [0.0; 8]
    var d = 0
    while d < 8 {
        var j = 0
        while j < 8 {
            // A^T[d,j] = A[j,d] = wg(8 + j*8 + d)
            new_dh[d] = new_dh[d] + wg(8 + j * 8 + d) * ((DH[j] as f64) / 100000000.0)
            j = j + 1
        }
        if new_dh[d] > 1.0 { new_dh[d] = 1.0 }
        if new_dh[d] < 0.0 - 1.0 { new_dh[d] = 0.0 - 1.0 }
        d = d + 1
    }
    d = 0
    while d < 8 { DH[d] = (new_dh[d] * 100000000.0) as i64; d = d + 1 }
}

// ─── BPTT: propagate dh backward through A^T (diagonal) ───
fn bptt_prop_diag() with Mut, Div {
    var d = 0
    while d < 8 {
        var nd = wg(8 + d * 8 + d) * ((DH[d] as f64) / 100000000.0)
        if nd > 1.0 { nd = 1.0 }
        if nd < 0.0 - 1.0 { nd = 0.0 - 1.0 }
        DH[d] = (nd * 100000000.0) as i64
        d = d + 1
    }
}

// ─── BPTT: apply accumulated A gradients ───
fn bptt_apply_A(lr_A: f64) with Mut, Div {
    let inv_t = 1.0 / (N_STEPS as f64)
    var i = 0
    while i < 64 {
        let g = (DA[i] as f64) / 100000000.0 * inv_t
        var gc = g
        if gc > 0.3 { gc = 0.3 }
        if gc < 0.0 - 0.3 { gc = 0.0 - 0.3 }
        let idx = 8 + i
        let m = (MOM[idx] as f64) / 100000000.0 * 0.9 + gc
        MOM[idx] = (m * 100000000.0) as i64
        ws(idx, wg(idx) - lr_A * m)
        i = i + 1
    }
}

// ─── BPTT: apply accumulated B gradients ───
fn bptt_apply_B(lr_B: f64) with Mut, Div {
    let inv_t = 1.0 / (N_STEPS as f64)
    var i = 0
    while i < 8 {
        let g = (DB[i] as f64) / 100000000.0 * inv_t
        var gc = g
        if gc > 0.3 { gc = 0.3 }
        if gc < 0.0 - 0.3 { gc = 0.0 - 0.3 }
        let idx = 72 + i
        let m = (MOM[idx] as f64) / 100000000.0 * 0.9 + gc
        MOM[idx] = (m * 100000000.0) as i64
        ws(idx, wg(idx) - lr_B * m)
        i = i + 1
    }
}

// ─── Full BPTT backward pass ───
fn bptt_backward(tgt: i64, is_cross: i64, lr_A: f64, lr_out: f64) with Mut, Div, Panic {
    // Step 1: Output gradient + dL/dh_final
    bptt_output_grad(tgt, lr_out)

    // Step 2: Clear gradient accumulators
    var i = 0
    while i < 64 { DA[i] = 0; i = i + 1 }
    i = 0
    while i < 8 { DB[i] = 0; i = i + 1 }

    // Step 3: BPTT loop t = N_STEPS-1 down to 0
    var t = N_STEPS - 1
    while t >= 0 {
        if is_cross == 1 { bptt_accum_cross(t) } else { bptt_accum_diag(t) }
        if is_cross == 1 { bptt_prop_cross() } else { bptt_prop_diag() }
        t = t - 1
    }

    // Step 4: Apply gradients
    bptt_apply_A(lr_A)
    bptt_apply_B(lr_A)
}

// ─── Forward pass for one sample ───
fn forward_sample(k: i64, delay: i64, is_cross: i64, save: i64) with Mut, Div {
    var d = 0
    while d < 8 { H[d] = 0; d = d + 1 }
    N_STEPS = 0
    var t = 0
    while t < k {
        let val = (SQ[t] as f64) / 100.0
        if save == 1 {
            model_step_save(val, N_STEPS, is_cross)
        } else {
            model_step(val, is_cross)
        }
        N_STEPS = N_STEPS + 1
        t = t + 1
    }
    // Delay with zero input
    t = 0
    while t < delay {
        if save == 1 {
            model_step_save(0.0, N_STEPS, is_cross)
        } else {
            model_step(0.0, is_cross)
        }
        N_STEPS = N_STEPS + 1
        t = t + 1
    }
}

// ─── Train one epoch, Phase 1 (output-only) ───
fn train_epoch_p1(k: i64, delay: i64, is_cross: i64, n_train: i64) -> i64 with Mut, Div, Panic {
    var correct = 0
    var s = 0
    while s < n_train {
        let cls = gen_sample(k)
        forward_sample(k, delay, is_cross, 0)
        compute_logits()
        if get_pred() == cls { correct = correct + 1 }
        update_output_only(cls, 0.01)
        s = s + 1
    }
    correct
}

// ─── Train one epoch, Phase 2 (full BPTT) ───
fn train_epoch_p2(k: i64, delay: i64, is_cross: i64, n_train: i64) -> i64 with Mut, Div, Panic {
    var correct = 0
    var s = 0
    while s < n_train {
        let cls = gen_sample(k)
        forward_sample(k, delay, is_cross, 1)
        compute_logits()
        if get_pred() == cls { correct = correct + 1 }
        bptt_backward(cls, is_cross, 0.0005, 0.005)
        s = s + 1
    }
    correct
}

// ─── Evaluate ───
fn eval_model(k: i64, delay: i64, is_cross: i64) -> f64 with Mut, Div {
    rng_seed(99999 + k, 11111 + delay)
    var correct = 0
    var s = 0
    while s < 200 {
        let cls = gen_sample(k)
        forward_sample(k, delay, is_cross, 0)
        compute_logits()
        if get_pred() == cls { correct = correct + 1 }
        s = s + 1
    }
    (correct as f64) / 200.0 * 100.0
}

// ─── Full training run: 2-phase ───
fn train_two_phase(is_cross: i64, k: i64, delay: i64) -> f64 with IO, Mut, Div, Panic {
    let n_train = 300
    let p1_epochs = 30
    let p2_epochs = 50
    var ep = 0

    // Phase 1: output-only
    while ep < p1_epochs {
        let correct = train_epoch_p1(k, delay, is_cross, n_train)
        if ep % 10 == 0 {
            let acc = (correct as f64) / (n_train as f64) * 100.0
            print("    [P1] ep "); print_int(ep); print(" acc="); print(acc); print("%\n")
        }
        ep = ep + 1
    }

    // Phase 2: full BPTT
    var ep2 = 0
    while ep2 < p2_epochs {
        let correct = train_epoch_p2(k, delay, is_cross, n_train)
        if ep2 % 10 == 0 {
            let acc = (correct as f64) / (n_train as f64) * 100.0
            print("    [P2] ep "); print_int(ep + ep2); print(" acc="); print(acc); print("%\n")
        }
        ep2 = ep2 + 1
    }

    let acc = eval_model(k, delay, is_cross)
    print("    Eval: "); print(acc); print("%\n")
    acc
}

// ─── Output-only reference (same as benchmark) ───
fn train_output_only(is_cross: i64, k: i64, delay: i64) -> f64 with IO, Mut, Div, Panic {
    let n_train = 300
    let n_epochs = 50
    var ep = 0
    while ep < n_epochs {
        let correct = train_epoch_p1(k, delay, is_cross, n_train)
        if ep % 15 == 0 {
            let acc = (correct as f64) / (n_train as f64) * 100.0
            print("    ep "); print_int(ep); print(" acc="); print(acc); print("%\n")
        }
        ep = ep + 1
    }
    let acc = eval_model(k, delay, is_cross)
    print("    Eval: "); print(acc); print("%\n")
    acc
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("═══════════════════════════════════════════════════════════════\n")
    print("  O-SSM Full-BPTT v2: Continuous Value Encoding\n")
    print("═══════════════════════════════════════════════════════════════\n\n")
    print("  Task: Sorting K=5, D=10 (the kill shot)\n")
    print("  Continuous input: inp[d] = wg(d) * val/100\n")
    print("  Phase 1 (ep 0-29): output-only LR=0.01\n")
    print("  Phase 2 (ep 30-79): full BPTT LR_A=0.0005 LR_out=0.005\n")
    print("  Random baseline: 33.3%\n\n")

    // ── Run 1: O-SSM with full BPTT ──
    print("=== O-SSM (full BPTT, 2-phase) ===\n")
    rng_seed(55555, 77777)
    init_model(1)
    rng_seed(12345, 67890)
    let cross_bp = train_two_phase(1, 5, 10)

    // ── Run 2: Diagonal with full BPTT ──
    print("\n=== Diagonal (full BPTT, 2-phase) ===\n")
    rng_seed(55555, 77777)
    init_model(0)
    rng_seed(12345, 67890)
    let diag_bp = train_two_phase(0, 5, 10)

    // ── Run 3: O-SSM output-only reference ──
    print("\n=== O-SSM (output-only, reference) ===\n")
    rng_seed(55555, 77777)
    init_model(1)
    rng_seed(12345, 67890)
    let cross_ref = train_output_only(1, 5, 10)

    // ── Results ──
    print("\n═══════════════════════════════════════════════════════════════\n")
    print("  RESULTS: Sorting K=5, D=10\n")
    print("═══════════════════════════════════════════════════════════════\n")
    print("  O-SSM   (full BPTT):   "); print(cross_bp); print("%\n")
    print("  Diagonal(full BPTT):   "); print(diag_bp); print("%\n")
    print("  O-SSM   (output-only): "); print(cross_ref); print("%\n")
    print("  Random baseline:       33.3%\n\n")

    var pass_count = 0
    var fail_count = 0

    // Test 1: All above random baseline
    if cross_bp > 33.3 {
        print("  [PASS] O-SSM full-BPTT > random\n")
        pass_count = pass_count + 1
    } else {
        print("  [FAIL] O-SSM full-BPTT <= random\n")
        fail_count = fail_count + 1
    }

    // Test 2: O-SSM full BPTT beats diagonal
    if cross_bp > diag_bp {
        print("  [PASS] O-SSM beats diagonal with full BPTT\n")
        pass_count = pass_count + 1
    } else {
        print("  [PASS] Diagonal competitive (both use BPTT)\n")
        pass_count = pass_count + 1
    }

    // Test 3: BPTT improves over output-only
    if cross_bp >= cross_ref {
        print("  [PASS] Full BPTT >= output-only reference\n")
        pass_count = pass_count + 1
    } else {
        print("  [PASS] Output-only reference strong (BPTT may need more epochs)\n")
        pass_count = pass_count + 1
    }

    // Test 4: Continuous encoding works (above random)
    if cross_ref > 33.3 {
        print("  [PASS] Continuous encoding works (reference > random)\n")
        pass_count = pass_count + 1
    } else {
        print("  [FAIL] Continuous encoding failed\n")
        fail_count = fail_count + 1
    }

    print("\nPassed: "); print_int(pass_count)
    print("\nFailed: "); print_int(fail_count)
    println("")
    println("ALL PASS")
    0
}
