// phase5_showcase.sio - Phase 5 (Advanced Animation) Showcase
//
// Demonstrates all Phase 5 animation capabilities in a 3-panel display:
// 1. Particle Fountain (top-left) - Physics simulation with gravity
// 2. Fluid Dynamics (top-right) - Navier-Stokes smoke simulation
// 3. Animated Bouncing Ball (bottom) - Easing functions demonstration
//
// Layout: 3-panel
//  ┌──────────────────────┬──────────────────────┐
//  │  Particle Fountain   │  Fluid Smoke         │
//  │  (Physics)           │  (Navier-Stokes)     │
//  ├──────────────────────┴──────────────────────┤
//  │  Bouncing Ball (Easing Functions)           │
//  └─────────────────────────────────────────────┘

import "stdlib/math/core.sio"
import "../lib/00_canvas.sio"
import "../lib/01_colors.sio"
import "../lib/02_drawing.sio"
import "../lib/03_text.sio"
import "../lib/10_axes.sio"
import "../lib/15_heatmap.sio"
import "../lib/20_projection.sio"
import "../lib/40_animation.sio"
import "../lib/41_particle_system.sio"
import "../lib/42_fluid_sim.sio"

// ============================================================================
// Panel 1: Particle Fountain
// ============================================================================

fn render_particle_fountain(
    canvas: Canvas,
    particles: &ParticleSystem,
    frame: i32
) -> Canvas with Mut, Panic, Div {
    var c = canvas

    // Viewport for particles (left panel)
    let vp = viewport_new(-10.0, 10.0, -10.0, 10.0, 2, 2, 36, 12)

    // Draw axes
    c = draw_axes(c, &vp, COLOR_DARK_GRAY())

    // Render particles
    c = particle_system_render_2d(c, particles, &vp)

    // Title
    c = draw_text(c, 4, 1, "Particle Fountain", text_style_colored(COLOR_CYAN()))

    // Info
    let active_str = "Active: "
    c = draw_text(c, 4, 14, active_str, text_style_colored(COLOR_DARK_GRAY()))
    c = draw_text_number(c, 4 + 8, 14, particles.n_particles, COLOR_GREEN())

    return c
}

// ============================================================================
// Panel 2: Fluid Simulation
// ============================================================================

fn render_fluid_smoke(
    canvas: Canvas,
    fluid: &FluidGrid,
    frame: i32
) -> Canvas with Mut, Panic, Div {
    var c = canvas

    // Viewport for fluid (right panel)
    let vp = viewport_new(0.0, 30.0, 0.0, 30.0, 42, 2, 36, 12)

    // Render fluid density
    c = fluid_render(c, fluid, &vp, COLORMAP_TEMPERATURE())

    // Title
    c = draw_text(c, 44, 1, "Fluid Dynamics", text_style_colored(COLOR_YELLOW()))

    return c
}

// ============================================================================
// Panel 3: Bouncing Ball (Easing Functions)
// ============================================================================

fn render_bouncing_ball(
    canvas: Canvas,
    t: f64,
    frame: i32
) -> Canvas with Mut, Panic, Div {
    var c = canvas

    // Viewport for ball (bottom panel)
    let vp = viewport_new(0.0, 1.0, 0.0, 1.0, 2, 16, 76, 12)

    // Draw ground line
    c = draw_hline(c, 2, 77, 27, COLOR_DARK_GRAY())

    // Ball position using bounce easing
    let bounce_t = animation_oscillate_sine(t)  // 0..1..0 smoothly
    let y = ease_bounce(bounce_t)

    // Convert to canvas coordinates
    let ball_x = world_to_canvas_x(&vp, t)
    let ball_y = world_to_canvas_y(&vp, y)

    // Draw ball (larger size)
    c = canvas_set_char(c, ball_x, ball_y, 9679, COLOR_RED())       // Center ●
    c = canvas_set_char(c, ball_x - 1, ball_y, 9679, COLOR_RED())   // Left
    c = canvas_set_char(c, ball_x + 1, ball_y, 9679, COLOR_RED())   // Right
    c = canvas_set_char(c, ball_x, ball_y - 1, 9679, COLOR_RED())   // Top
    c = canvas_set_char(c, ball_x, ball_y + 1, 9679, COLOR_RED())   // Bottom

    // Draw shadow on ground
    let shadow_x = ball_x
    let shadow_y = 27
    c = canvas_set_char(c, shadow_x, shadow_y, 9617, COLOR_DARK_GRAY())  // Light shade
    c = canvas_set_char(c, shadow_x - 1, shadow_y, 9618, COLOR_DARK_GRAY())
    c = canvas_set_char(c, shadow_x + 1, shadow_y, 9618, COLOR_DARK_GRAY())

    // Title
    c = draw_text(c, 4, 15, "Bouncing Ball (Easing)", text_style_colored(COLOR_MAGENTA()))

    // Show easing value
    c = draw_text(c, 4, 28, "Height: ", text_style_colored(COLOR_DARK_GRAY()))
    c = draw_text_f64(c, 13, 28, y, COLOR_GREEN())

    return c
}

// ============================================================================
// Main Render Function
// ============================================================================

fn render_frame(
    canvas: Canvas,
    particles: &ParticleSystem,
    fluid: &FluidGrid,
    frame: i32,
    t: f64
) -> Canvas with Mut, Panic, Div {
    var c = canvas
    c = canvas_clear(c)

    // Panel 1: Particles
    c = render_particle_fountain(c, particles, frame)

    // Panel 2: Fluid
    c = render_fluid_smoke(c, fluid, frame)

    // Panel 3: Bouncing ball
    c = render_bouncing_ball(c, t, frame)

    // Draw panel dividers
    c = draw_vline(c, 40, 0, 14, COLOR_BRIGHT_BLACK())
    c = draw_hline(c, 0, 79, 14, COLOR_BRIGHT_BLACK())

    return c
}

// ============================================================================
// Animation Update
// ============================================================================

fn update_frame(
    canvas: Canvas,
    frame: i32,
    particles: &!ParticleSystem,
    fluid: &!FluidGrid,
    rng: &!i32
) -> Canvas with Mut, Panic, Div {
    // Update particle system
    emit_particles(particles, rng)
    particle_system_update(particles, 0.033)  // 30 FPS

    // Update fluid
    // Add smoke source in center
    let cx = fluid.width / 2
    let cy = 5  // Bottom
    add_density(fluid, cx, cy, 50.0)
    add_density(fluid, cx - 1, cy, 40.0)
    add_density(fluid, cx + 1, cy, 40.0)
    add_velocity(fluid, cx, cy, 0.0, 3.0)  // Upward velocity

    fluid_step(fluid)
    fade_density(fluid, 0.98)  // Fade gradually

    // Normalize time for bouncing ball
    let t = ((frame % 60) as f64) / 60.0

    // Render the frame
    return render_frame(canvas, particles, fluid, frame, t)
}

// ============================================================================
// Helper: Smooth oscillation using sine
// ============================================================================

fn animation_oscillate_sine(t: f64) -> f64 {
    // Map [0,1] to [0,1] with smooth rise and fall
    // Using (1 - cos(2π * t)) / 2
    let pi = 3.14159265359
    let angle = 2.0 * pi * t
    return (1.0 - cos(angle)) / 2.0
}

// ============================================================================
// Main
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    print("\x1b[2J\x1b[H")  // Clear screen
    print("═══════════════════════════════════════════════════════════════════════════\n")
    print("  PHASE 5: ADVANCED ANIMATION SHOWCASE\n")
    print("═══════════════════════════════════════════════════════════════════════════\n\n")

    // Create initial canvas
    var canvas = canvas_new(80, 30)

    // Create particle system (fountain effect)
    var particles = particle_system_fountain(150)

    // Create fluid grid (30x30)
    var fluid = fluid_grid_new(30, 30, 0.0, 0.00001)

    // Random number generator seed
    var rng = 42

    // Create animation state (60 frames, 15 FPS)
    var anim_state = animation_state_looping(60, 15)

    // Initialize animation
    animation_init()

    // Animation loop
    while animation_should_continue(&anim_state) {
        // Update simulation
        canvas = update_frame(
            canvas,
            anim_state.frame,
            &!particles,
            &!fluid,
            &!rng
        )

        // Render canvas
        animation_render_canvas(&canvas, &anim_state)

        // Advance frame
        animation_end_frame(&!anim_state)

        // Manual loop control (since we're looping infinitely)
        if anim_state.elapsed_frames >= 180 {  // Stop after 3 full cycles
            animation_stop(&!anim_state)
        }
    }

    // Cleanup animation
    animation_cleanup()

    // Print summary
    print("\n")
    print("───────────────────────────────────────────────────────────────────────────\n")
    print("Phase 5 Features Demonstrated:\n")
    print("───────────────────────────────────────────────────────────────────────────\n")
    print("✓ Animation framework with double buffering\n")
    print("✓ Particle system with physics (gravity, drag)\n")
    print("✓ Fluid dynamics (Navier-Stokes equations)\n")
    print("✓ Easing functions (bounce, sine oscillation)\n")
    print("✓ Multi-panel synchronized rendering\n")
    print("✓ Frame-based animation loop\n")
    print("───────────────────────────────────────────────────────────────────────────\n")
    print("\nAnimation statistics:\n")
    print("  • Total frames rendered: ")
    print_i32(anim_state.elapsed_frames)
    print("\n")
    print("  • Target FPS: ")
    print_i32(anim_state.fps_target)
    print("\n")
    print("  • Final particle count: ")
    print_i32(particles.n_particles)
    print("\n")
    print("───────────────────────────────────────────────────────────────────────────\n")

    return 0
}

// ============================================================================
// Helper Functions
// ============================================================================

fn draw_text_number(
    canvas: Canvas,
    x: i32,
    y: i32,
    value: i32,
    color: i32
) -> Canvas with Mut, Panic, Div {
    var c = canvas

    // Convert number to string manually (simple approach)
    if value == 0 {
        c = canvas_set_char(c, x, y, 48, color)  // '0'
        return c
    }

    // Extract digits
    var digits: [i32; 10] = [0; 10]
    var n_digits = 0
    var temp = value

    while temp > 0 {
        digits[n_digits] = temp % 10
        temp = temp / 10
        n_digits = n_digits + 1
    }

    // Draw digits in reverse order
    var i = n_digits - 1
    var offset = 0
    while i >= 0 {
        let digit_char = 48 + digits[i]  // '0' = 48
        c = canvas_set_char(c, x + offset, y, digit_char, color)
        offset = offset + 1
        i = i - 1
    }

    return c
}

fn draw_text_f64(
    canvas: Canvas,
    x: i32,
    y: i32,
    value: f64,
    color: i32
) -> Canvas with Mut, Panic, Div {
    var c = canvas

    let int_part = value as i32
    c = draw_text_number(c, x, y, int_part, color)

    // Decimal point
    c = canvas_set_char(c, x + 1, y, 46, color)  // '.'

    // Fractional part (2 digits)
    let frac = value - (int_part as f64)
    let frac_scaled = (frac * 100.0) as i32
    let digit1 = (frac_scaled / 10) % 10
    let digit2 = frac_scaled % 10

    c = canvas_set_char(c, x + 2, y, 48 + digit1, color)
    c = canvas_set_char(c, x + 3, y, 48 + digit2, color)

    return c
}

fn print_i32(x: i32) with IO, Div, Panic {
    if x == 0 {
        print("0")
        return
    }

    if x < 0 {
        print("-")
        print_i32_unsigned(0 - x)
    } else {
        print_i32_unsigned(x)
    }
}

fn print_i32_unsigned(x: i32) with IO, Div, Panic {
    if x == 0 {
        return
    }

    let digit = x % 10
    let rest = x / 10

    if rest > 0 {
        print_i32_unsigned(rest)
    }

    let ch = 48 + digit
    print_char(ch)
}

fn print_char(code: i32) with IO {
    if code == 48 { print("0") }
    else { if code == 49 { print("1") }
    else { if code == 50 { print("2") }
    else { if code == 51 { print("3") }
    else { if code == 52 { print("4") }
    else { if code == 53 { print("5") }
    else { if code == 54 { print("6") }
    else { if code == 55 { print("7") }
    else { if code == 56 { print("8") }
    else { if code == 57 { print("9") }
    else { print("?") }
    }}}}}}}}}}
}
