// phase7_showcase.sio - Network/Graph Visualization Demonstration
//
// Showcases all Phase 7 graphics library capabilities:
// 1. Graph data structures and operations
// 2. Force-directed layout (Fruchterman-Reingold)
// 3. Tree layouts (binary, radial)
// 4. Graph rendering with colors and animation
//
// Run: ./bin/souc run examples/graphics/demos/phase7_showcase.sio

// ============================================================================
// Data Structures (simplified inline versions)
// ============================================================================

struct Node {
    id: i32,
    x: f64,
    y: f64,
    label: i32,
    color: i32,
    fixed: i32
}

struct Edge {
    from_id: i32,
    to_id: i32,
    weight: f64,
    directed: i32
}

struct Force {
    fx: f64,
    fy: f64
}

// ============================================================================
// Demo 1: Social Network Graph
// ============================================================================

fn demo_social_network() with IO, Mut, Div, Panic {
    print("\x1b[2J\x1b[H")
    print("\x1b[1;36m=== Demo 1: Social Network Graph ===\x1b[0m\n\n")

    // Create nodes (6 people)
    var nodes: [Node; 20] = [Node {
        id: 0, x: 0.0, y: 0.0, label: 65, color: 37, fixed: 0
    }; 20]

    var edges: [Edge; 50] = [Edge {
        from_id: 0, to_id: 0, weight: 1.0, directed: 0
    }; 50]

    // Initialize positions and labels
    let n_nodes = 6
    var i = 0
    while i < n_nodes {
        nodes[i].id = i
        nodes[i].label = 65 + i
        nodes[i].x = ((i % 3) as f64) * 10.0 - 10.0
        nodes[i].y = ((i / 3) as f64) * 8.0 - 4.0
        i = i + 1
    }

    // Create friendships
    let n_edges = 8
    edges[0] = Edge { from_id: 0, to_id: 1, weight: 1.0, directed: 0 }  // A-B
    edges[1] = Edge { from_id: 0, to_id: 2, weight: 1.0, directed: 0 }  // A-C
    edges[2] = Edge { from_id: 1, to_id: 2, weight: 1.0, directed: 0 }  // B-C
    edges[3] = Edge { from_id: 1, to_id: 3, weight: 1.0, directed: 0 }  // B-D
    edges[4] = Edge { from_id: 2, to_id: 4, weight: 1.0, directed: 0 }  // C-E
    edges[5] = Edge { from_id: 3, to_id: 4, weight: 1.0, directed: 0 }  // D-E
    edges[6] = Edge { from_id: 3, to_id: 5, weight: 1.0, directed: 0 }  // D-F
    edges[7] = Edge { from_id: 4, to_id: 5, weight: 1.0, directed: 0 }  // E-F

    print("Social network with ")
    print_i32(n_nodes)
    print(" people and ")
    print_i32(n_edges)
    print(" friendships\n\n")

    // Apply force-directed layout
    print("Applying Fruchterman-Reingold layout...\n\n")

    var forces: [Force; 20] = [Force { fx: 0.0, fy: 0.0 }; 20]
    let k = 8.0  // Optimal distance
    var temperature = 10.0

    var iter = 0
    while iter < 50 {
        // Reset forces
        var f = 0
        while f < n_nodes {
            forces[f].fx = 0.0
            forces[f].fy = 0.0
            f = f + 1
        }

        // Repulsive forces
        i = 0
        while i < n_nodes {
            var j = 0
            while j < n_nodes {
                if i != j {
                    let dx = nodes[i].x - nodes[j].x
                    let dy = nodes[i].y - nodes[j].y
                    let dist = sqrt_approx(dx * dx + dy * dy) + 0.1
                    let force = (k * k) / dist
                    forces[i].fx = forces[i].fx + (dx / dist) * force
                    forces[i].fy = forces[i].fy + (dy / dist) * force
                }
                j = j + 1
            }
            i = i + 1
        }

        // Attractive forces
        var e = 0
        while e < n_edges {
            let from = edges[e].from_id
            let to = edges[e].to_id
            let dx = nodes[to].x - nodes[from].x
            let dy = nodes[to].y - nodes[from].y
            let dist = sqrt_approx(dx * dx + dy * dy) + 0.1
            let force = (dist * dist) / k

            forces[from].fx = forces[from].fx + (dx / dist) * force
            forces[from].fy = forces[from].fy + (dy / dist) * force
            forces[to].fx = forces[to].fx - (dx / dist) * force
            forces[to].fy = forces[to].fy - (dy / dist) * force

            e = e + 1
        }

        // Apply forces with temperature limiting
        i = 0
        while i < n_nodes {
            let mag = sqrt_approx(forces[i].fx * forces[i].fx + forces[i].fy * forces[i].fy)
            if mag > temperature {
                forces[i].fx = forces[i].fx * temperature / mag
                forces[i].fy = forces[i].fy * temperature / mag
            }
            nodes[i].x = nodes[i].x + forces[i].fx
            nodes[i].y = nodes[i].y + forces[i].fy
            i = i + 1
        }

        temperature = temperature * 0.95
        iter = iter + 1
    }

    // Display result
    print("Layout complete. Final positions:\n")
    i = 0
    while i < n_nodes {
        print("  ")
        print_node_label(nodes[i].label)
        print(": (")
        print_f64(nodes[i].x)
        print(", ")
        print_f64(nodes[i].y)
        print(")\n")
        i = i + 1
    }

    // Render ASCII visualization
    print("\n")
    render_graph_ascii(&nodes, n_nodes, &edges, n_edges, 50, 15)

    print("\nPress Enter for next demo...")
    wait_for_input()
}

// ============================================================================
// Demo 2: Binary Tree Layout
// ============================================================================

fn demo_binary_tree() with IO, Mut, Div, Panic {
    print("\x1b[2J\x1b[H")
    print("\x1b[1;36m=== Demo 2: Binary Tree Layout ===\x1b[0m\n\n")

    var nodes: [Node; 20] = [Node {
        id: 0, x: 0.0, y: 0.0, label: 65, color: 37, fixed: 0
    }; 20]

    var edges: [Edge; 50] = [Edge {
        from_id: 0, to_id: 0, weight: 1.0, directed: 0
    }; 50]

    // Create binary tree: 15 nodes (depth 4)
    let n_nodes = 15

    // Initialize labels
    var i = 0
    while i < n_nodes {
        nodes[i].id = i
        nodes[i].label = 65 + i
        i = i + 1
    }

    // Create edges (parent to children)
    let n_edges = 14
    i = 0
    while i < 7 {  // Internal nodes
        let left = 2 * i + 1
        let right = 2 * i + 2
        edges[2 * i] = Edge { from_id: i, to_id: left, weight: 1.0, directed: 1 }
        edges[2 * i + 1] = Edge { from_id: i, to_id: right, weight: 1.0, directed: 1 }
        i = i + 1
    }

    print("Binary tree with ")
    print_i32(n_nodes)
    print(" nodes (depth 4)\n\n")

    // Apply hierarchical layout
    print("Applying hierarchical layout...\n\n")

    let level_height = 3.0
    let node_sep = 2.5

    // Position nodes by level
    // Level 0: 1 node at center
    nodes[0].x = 0.0
    nodes[0].y = 0.0

    // Level 1: 2 nodes
    nodes[1].x = -8.0
    nodes[1].y = level_height
    nodes[2].x = 8.0
    nodes[2].y = level_height

    // Level 2: 4 nodes
    nodes[3].x = -12.0
    nodes[3].y = 2.0 * level_height
    nodes[4].x = -4.0
    nodes[4].y = 2.0 * level_height
    nodes[5].x = 4.0
    nodes[5].y = 2.0 * level_height
    nodes[6].x = 12.0
    nodes[6].y = 2.0 * level_height

    // Level 3: 8 nodes
    var leaf_start = 7
    var leaf_x = -14.0
    i = 0
    while i < 8 {
        nodes[leaf_start + i].x = leaf_x
        nodes[leaf_start + i].y = 3.0 * level_height
        leaf_x = leaf_x + 4.0
        i = i + 1
    }

    // Display structure
    print("Tree structure:\n")
    print("  Level 0 (root): A\n")
    print("  Level 1:        B, C\n")
    print("  Level 2:        D, E, F, G\n")
    print("  Level 3 (leaves): H, I, J, K, L, M, N, O\n\n")

    // Render
    render_tree_ascii(&nodes, n_nodes, &edges, n_edges, 50, 12)

    print("\nPress Enter for next demo...")
    wait_for_input()
}

// ============================================================================
// Demo 3: Radial Tree Layout
// ============================================================================

fn demo_radial_tree() with IO, Mut, Div, Panic {
    print("\x1b[2J\x1b[H")
    print("\x1b[1;36m=== Demo 3: Radial Tree Layout ===\x1b[0m\n\n")

    var nodes: [Node; 20] = [Node {
        id: 0, x: 0.0, y: 0.0, label: 65, color: 37, fixed: 0
    }; 20]

    var edges: [Edge; 50] = [Edge {
        from_id: 0, to_id: 0, weight: 1.0, directed: 0
    }; 50]

    // Create tree with root and 6 children, each with 2 grandchildren
    let n_nodes = 13  // 1 root + 4 children + 8 grandchildren

    // Initialize
    var i = 0
    while i < n_nodes {
        nodes[i].id = i
        nodes[i].label = 65 + i
        i = i + 1
    }

    // Edges: root to children, children to grandchildren
    let n_edges = 12
    // Root to children (0 -> 1,2,3,4)
    edges[0] = Edge { from_id: 0, to_id: 1, weight: 1.0, directed: 0 }
    edges[1] = Edge { from_id: 0, to_id: 2, weight: 1.0, directed: 0 }
    edges[2] = Edge { from_id: 0, to_id: 3, weight: 1.0, directed: 0 }
    edges[3] = Edge { from_id: 0, to_id: 4, weight: 1.0, directed: 0 }

    // Children to grandchildren
    edges[4] = Edge { from_id: 1, to_id: 5, weight: 1.0, directed: 0 }
    edges[5] = Edge { from_id: 1, to_id: 6, weight: 1.0, directed: 0 }
    edges[6] = Edge { from_id: 2, to_id: 7, weight: 1.0, directed: 0 }
    edges[7] = Edge { from_id: 2, to_id: 8, weight: 1.0, directed: 0 }
    edges[8] = Edge { from_id: 3, to_id: 9, weight: 1.0, directed: 0 }
    edges[9] = Edge { from_id: 3, to_id: 10, weight: 1.0, directed: 0 }
    edges[10] = Edge { from_id: 4, to_id: 11, weight: 1.0, directed: 0 }
    edges[11] = Edge { from_id: 4, to_id: 12, weight: 1.0, directed: 0 }

    print("Radial tree with ")
    print_i32(n_nodes)
    print(" nodes (3 levels)\n\n")

    // Apply radial layout
    print("Applying radial layout...\n\n")

    // Root at center
    nodes[0].x = 0.0
    nodes[0].y = 0.0

    // Level 1: 4 children in circle
    let r1 = 5.0
    i = 0
    while i < 4 {
        let angle = (i as f64) * 1.5708  // 90 degrees apart
        nodes[1 + i].x = cos_approx(angle) * r1
        nodes[1 + i].y = sin_approx(angle) * r1
        i = i + 1
    }

    // Level 2: 2 grandchildren per child
    let r2 = 10.0
    i = 0
    while i < 4 {
        let base_angle = (i as f64) * 1.5708
        let spread = 0.5

        let gc1 = 5 + i * 2
        let gc2 = 5 + i * 2 + 1

        nodes[gc1].x = cos_approx(base_angle - spread) * r2
        nodes[gc1].y = sin_approx(base_angle - spread) * r2
        nodes[gc2].x = cos_approx(base_angle + spread) * r2
        nodes[gc2].y = sin_approx(base_angle + spread) * r2

        i = i + 1
    }

    // Render
    render_radial_ascii(&nodes, n_nodes, &edges, n_edges, 50, 20)

    print("\nPress Enter for next demo...")
    wait_for_input()
}

// ============================================================================
// Demo 4: Graph Traversal Animation
// ============================================================================

fn demo_graph_traversal() with IO, Mut, Div, Panic {
    print("\x1b[2J\x1b[H")
    print("\x1b[1;36m=== Demo 4: BFS Graph Traversal ===\x1b[0m\n\n")

    // Simple graph for BFS demo
    var nodes: [Node; 10] = [Node {
        id: 0, x: 0.0, y: 0.0, label: 65, color: 37, fixed: 0
    }; 10]

    let n_nodes = 7

    // Arrange in a pattern
    nodes[0].x = 0.0; nodes[0].y = 0.0; nodes[0].label = 65  // A (start)
    nodes[1].x = -6.0; nodes[1].y = 4.0; nodes[1].label = 66  // B
    nodes[2].x = 6.0; nodes[2].y = 4.0; nodes[2].label = 67  // C
    nodes[3].x = -9.0; nodes[3].y = 8.0; nodes[3].label = 68  // D
    nodes[4].x = -3.0; nodes[4].y = 8.0; nodes[4].label = 69  // E
    nodes[5].x = 3.0; nodes[5].y = 8.0; nodes[5].label = 70  // F
    nodes[6].x = 9.0; nodes[6].y = 8.0; nodes[6].label = 71  // G

    // Edges
    var edges: [Edge; 20] = [Edge {
        from_id: 0, to_id: 0, weight: 1.0, directed: 0
    }; 20]

    let n_edges = 8
    edges[0] = Edge { from_id: 0, to_id: 1, weight: 1.0, directed: 0 }  // A-B
    edges[1] = Edge { from_id: 0, to_id: 2, weight: 1.0, directed: 0 }  // A-C
    edges[2] = Edge { from_id: 1, to_id: 3, weight: 1.0, directed: 0 }  // B-D
    edges[3] = Edge { from_id: 1, to_id: 4, weight: 1.0, directed: 0 }  // B-E
    edges[4] = Edge { from_id: 2, to_id: 5, weight: 1.0, directed: 0 }  // C-F
    edges[5] = Edge { from_id: 2, to_id: 6, weight: 1.0, directed: 0 }  // C-G
    edges[6] = Edge { from_id: 4, to_id: 5, weight: 1.0, directed: 0 }  // E-F (cross edge)
    edges[7] = Edge { from_id: 3, to_id: 4, weight: 1.0, directed: 0 }  // D-E

    print("BFS traversal starting from node A\n\n")

    // Build adjacency for BFS
    var adj: [i32; 50] = [0; 50]
    var adj_offset: [i32; 10] = [0; 10]

    // Count degrees
    var degrees: [i32; 10] = [0; 10]
    var e = 0
    while e < n_edges {
        degrees[edges[e].from_id] = degrees[edges[e].from_id] + 1
        degrees[edges[e].to_id] = degrees[edges[e].to_id] + 1
        e = e + 1
    }

    // Build offsets
    adj_offset[0] = 0
    var n = 0
    while n < n_nodes {
        adj_offset[n + 1] = adj_offset[n] + degrees[n]
        degrees[n] = 0  // Reset for filling
        n = n + 1
    }

    // Fill adjacency
    e = 0
    while e < n_edges {
        let from = edges[e].from_id
        let to = edges[e].to_id

        adj[adj_offset[from] + degrees[from]] = to
        degrees[from] = degrees[from] + 1

        adj[adj_offset[to] + degrees[to]] = from
        degrees[to] = degrees[to] + 1

        e = e + 1
    }

    // BFS traversal
    var visited: [i32; 10] = [0; 10]
    var queue: [i32; 20] = [0; 20]
    var q_front = 0
    var q_back = 0

    // Start from A
    queue[q_back] = 0
    q_back = q_back + 1

    print("Traversal order: ")

    var step = 0
    while q_front < q_back {
        let current = queue[q_front]
        q_front = q_front + 1

        if visited[current] == 0 {
            visited[current] = 1

            // Print current node
            if step > 0 { print(" -> ") }
            print_node_label(nodes[current].label)
            step = step + 1

            // Enqueue neighbors
            var i = adj_offset[current]
            while i < adj_offset[current + 1] {
                let neighbor = adj[i]
                if visited[neighbor] == 0 {
                    queue[q_back] = neighbor
                    q_back = q_back + 1
                }
                i = i + 1
            }
        }
    }

    print("\n\nLevel-order exploration:\n")
    print("  Level 0: A (start)\n")
    print("  Level 1: B, C (neighbors of A)\n")
    print("  Level 2: D, E, F, G (neighbors of B and C)\n\n")

    // Show graph structure
    render_bfs_ascii(&nodes, n_nodes, &edges, n_edges, 40, 12)

    print("\nPress Enter to finish...")
    wait_for_input()
}

// ============================================================================
// ASCII Rendering Functions
// ============================================================================

fn render_graph_ascii(
    nodes: &[Node], n_nodes: i32,
    edges: &[Edge], n_edges: i32,
    width: i32, height: i32
) with IO, Mut, Div, Panic {
    // Find bounds
    var min_x = nodes[0].x
    var max_x = nodes[0].x
    var min_y = nodes[0].y
    var max_y = nodes[0].y

    var i = 1
    while i < n_nodes {
        if nodes[i].x < min_x { min_x = nodes[i].x }
        if nodes[i].x > max_x { max_x = nodes[i].x }
        if nodes[i].y < min_y { min_y = nodes[i].y }
        if nodes[i].y > max_y { max_y = nodes[i].y }
        i = i + 1
    }

    // Add margin
    min_x = min_x - 2.0
    max_x = max_x + 2.0
    min_y = min_y - 1.0
    max_y = max_y + 1.0

    // Create buffer
    var buffer: [i32; 1000] = [32; 1000]  // Space

    // Draw edges
    var e = 0
    while e < n_edges {
        let from = edges[e].from_id
        let to = edges[e].to_id

        let x0 = scale_x(nodes[from].x, min_x, max_x, width)
        let y0 = scale_y(nodes[from].y, min_y, max_y, height)
        let x1 = scale_x(nodes[to].x, min_x, max_x, width)
        let y1 = scale_y(nodes[to].y, min_y, max_y, height)

        draw_line_buffer(&!buffer, width, height, x0, y0, x1, y1, 45)  // '-'
        e = e + 1
    }

    // Draw nodes
    i = 0
    while i < n_nodes {
        let x = scale_x(nodes[i].x, min_x, max_x, width)
        let y = scale_y(nodes[i].y, min_y, max_y, height)
        let idx = y * width + x
        if idx >= 0 {
            if idx < 1000 {
                buffer[idx] = nodes[i].label
            }
        }
        i = i + 1
    }

    // Print buffer
    var y = 0
    while y < height {
        var x = 0
        while x < width {
            let idx = y * width + x
            let ch = buffer[idx]
            if ch >= 65 {
                if ch <= 90 {
                    print("\x1b[1;36m")  // Cyan bold for nodes
                }
            }
            print_char_simple(ch)
            print("\x1b[0m")
            x = x + 1
        }
        print("\n")
        y = y + 1
    }
}

fn render_tree_ascii(
    nodes: &[Node], n_nodes: i32,
    edges: &[Edge], n_edges: i32,
    width: i32, height: i32
) with IO, Mut, Div, Panic {
    var buffer: [i32; 1000] = [32; 1000]

    let min_x = -16.0
    let max_x = 16.0
    let min_y = -1.0
    let max_y = 10.0

    // Draw edges as vertical lines where possible
    var e = 0
    while e < n_edges {
        let from = edges[e].from_id
        let to = edges[e].to_id

        let x0 = scale_x(nodes[from].x, min_x, max_x, width)
        let y0 = scale_y(nodes[from].y, min_y, max_y, height)
        let x1 = scale_x(nodes[to].x, min_x, max_x, width)
        let y1 = scale_y(nodes[to].y, min_y, max_y, height)

        draw_line_buffer(&!buffer, width, height, x0, y0, x1, y1, 124)  // '|'
        e = e + 1
    }

    // Draw nodes
    var i = 0
    while i < n_nodes {
        let x = scale_x(nodes[i].x, min_x, max_x, width)
        let y = scale_y(nodes[i].y, min_y, max_y, height)
        let idx = y * width + x
        if idx >= 0 {
            if idx < 1000 {
                buffer[idx] = nodes[i].label
            }
        }
        i = i + 1
    }

    // Print
    var y = 0
    while y < height {
        var x = 0
        while x < width {
            let idx = y * width + x
            let ch = buffer[idx]
            if ch >= 65 {
                if ch <= 90 {
                    print("\x1b[1;32m")  // Green for tree nodes
                }
            } else { if ch == 124 {
                print("\x1b[33m")  // Yellow for edges
            }}
            print_char_simple(ch)
            print("\x1b[0m")
            x = x + 1
        }
        print("\n")
        y = y + 1
    }
}

fn render_radial_ascii(
    nodes: &[Node], n_nodes: i32,
    edges: &[Edge], n_edges: i32,
    width: i32, height: i32
) with IO, Mut, Div, Panic {
    var buffer: [i32; 1200] = [32; 1200]

    let min_x = -12.0
    let max_x = 12.0
    let min_y = -12.0
    let max_y = 12.0

    // Draw edges
    var e = 0
    while e < n_edges {
        let from = edges[e].from_id
        let to = edges[e].to_id

        let x0 = scale_x(nodes[from].x, min_x, max_x, width)
        let y0 = scale_y(nodes[from].y, min_y, max_y, height)
        let x1 = scale_x(nodes[to].x, min_x, max_x, width)
        let y1 = scale_y(nodes[to].y, min_y, max_y, height)

        draw_line_buffer(&!buffer, width, height, x0, y0, x1, y1, 42)  // '*'
        e = e + 1
    }

    // Draw nodes
    var i = 0
    while i < n_nodes {
        let x = scale_x(nodes[i].x, min_x, max_x, width)
        let y = scale_y(nodes[i].y, min_y, max_y, height)
        let idx = y * width + x
        if idx >= 0 {
            if idx < 1200 {
                buffer[idx] = nodes[i].label
            }
        }
        i = i + 1
    }

    // Print
    var y = 0
    while y < height {
        var x = 0
        while x < width {
            let idx = y * width + x
            let ch = buffer[idx]
            if ch >= 65 {
                if ch <= 90 {
                    print("\x1b[1;35m")  // Magenta for radial nodes
                }
            }
            print_char_simple(ch)
            print("\x1b[0m")
            x = x + 1
        }
        print("\n")
        y = y + 1
    }
}

fn render_bfs_ascii(
    nodes: &[Node], n_nodes: i32,
    edges: &[Edge], n_edges: i32,
    width: i32, height: i32
) with IO, Mut, Div, Panic {
    var buffer: [i32; 600] = [32; 600]

    let min_x = -12.0
    let max_x = 12.0
    let min_y = -2.0
    let max_y = 10.0

    // Draw edges
    var e = 0
    while e < n_edges {
        let from = edges[e].from_id
        let to = edges[e].to_id

        let x0 = scale_x(nodes[from].x, min_x, max_x, width)
        let y0 = scale_y(nodes[from].y, min_y, max_y, height)
        let x1 = scale_x(nodes[to].x, min_x, max_x, width)
        let y1 = scale_y(nodes[to].y, min_y, max_y, height)

        draw_line_buffer(&!buffer, width, height, x0, y0, x1, y1, 46)  // '.'
        e = e + 1
    }

    // Draw nodes
    var i = 0
    while i < n_nodes {
        let x = scale_x(nodes[i].x, min_x, max_x, width)
        let y = scale_y(nodes[i].y, min_y, max_y, height)
        let idx = y * width + x
        if idx >= 0 {
            if idx < 600 {
                buffer[idx] = nodes[i].label
            }
        }
        i = i + 1
    }

    // Print
    var y = 0
    while y < height {
        var x = 0
        while x < width {
            let idx = y * width + x
            let ch = buffer[idx]
            if ch >= 65 {
                if ch <= 90 {
                    print("\x1b[1;33m")  // Yellow for BFS nodes
                }
            }
            print_char_simple(ch)
            print("\x1b[0m")
            x = x + 1
        }
        print("\n")
        y = y + 1
    }
}

// ============================================================================
// Drawing Helpers
// ============================================================================

fn scale_x(x: f64, min: f64, max: f64, width: i32) -> i32 with Div, Panic {
    let range = max - min
    if range <= 0.0 { return 0 }
    let t = (x - min) / range
    return (t * ((width - 1) as f64)) as i32
}

fn scale_y(y: f64, min: f64, max: f64, height: i32) -> i32 with Div, Panic {
    let range = max - min
    if range <= 0.0 { return 0 }
    let t = (y - min) / range
    return ((1.0 - t) * ((height - 1) as f64)) as i32  // Flip Y
}

fn draw_line_buffer(
    buffer: &![i32],
    width: i32, height: i32,
    x0: i32, y0: i32,
    x1: i32, y1: i32,
    ch: i32
) with Mut {
    var dx = x1 - x0
    var dy = y1 - y0
    var abs_dx = dx
    var abs_dy = dy
    if dx < 0 { abs_dx = 0 - dx }
    if dy < 0 { abs_dy = 0 - dy }

    var sx = 1
    var sy = 1
    if dx < 0 { sx = -1 }
    if dy < 0 { sy = -1 }

    var err = abs_dx - abs_dy
    var x = x0
    var y = y0

    var steps = 0
    let max_steps = abs_dx + abs_dy + 1

    while steps < max_steps {
        if x >= 0 {
            if x < width {
                if y >= 0 {
                    if y < height {
                        let idx = y * width + x
                        if idx < 1200 {
                            if buffer[idx] == 32 {  // Only draw on empty
                                buffer[idx] = ch
                            }
                        }
                    }
                }
            }
        }

        if x == x1 {
            if y == y1 {
                return
            }
        }

        let e2 = 2 * err
        if e2 > 0 - abs_dy {
            err = err - abs_dy
            x = x + sx
        }
        if e2 < abs_dx {
            err = err + abs_dx
            y = y + sy
        }

        steps = steps + 1
    }
}

// ============================================================================
// Math and Print Helpers
// ============================================================================

fn sqrt_approx(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var guess = x * 0.5
    var i = 0
    while i < 10 {
        guess = (guess + x / guess) * 0.5
        i = i + 1
    }
    return guess
}

fn sin_approx(x: f64) -> f64 {
    var xx = x
    while xx > 3.14159 { xx = xx - 6.28318 }
    while xx < -3.14159 { xx = xx + 6.28318 }
    let x2 = xx * xx
    let x3 = x2 * xx
    let x5 = x3 * x2
    return xx - x3 * 0.16667 + x5 * 0.00833
}

fn cos_approx(x: f64) -> f64 {
    return sin_approx(x + 1.5708)
}

fn print_i32(x: i32) with IO, Div, Panic {
    if x == 0 { print("0"); return }
    if x < 0 { print("-"); print_i32_unsigned(0 - x) }
    else { print_i32_unsigned(x) }
}

fn print_i32_unsigned(x: i32) with IO, Div, Panic {
    if x == 0 { return }
    let digit = x % 10
    let rest = x / 10
    if rest > 0 { print_i32_unsigned(rest) }
    print_digit(digit)
}

fn print_digit(d: i32) with IO {
    if d == 0 { print("0") }
    else { if d == 1 { print("1") }
    else { if d == 2 { print("2") }
    else { if d == 3 { print("3") }
    else { if d == 4 { print("4") }
    else { if d == 5 { print("5") }
    else { if d == 6 { print("6") }
    else { if d == 7 { print("7") }
    else { if d == 8 { print("8") }
    else { if d == 9 { print("9") }
    }}}}}}}}}}
}

fn print_f64(x: f64) with IO, Div, Panic {
    if x < 0.0 { print("-"); print_f64_pos(0.0 - x) }
    else { print_f64_pos(x) }
}

fn print_f64_pos(x: f64) with IO, Div, Panic {
    let int_part = x as i32
    print_i32(int_part)
    print(".")
    let frac = x - (int_part as f64)
    var frac_scaled = (frac * 100.0) as i32
    if frac_scaled < 0 { frac_scaled = 0 }
    if frac_scaled < 10 { print("0") }
    print_i32_unsigned(frac_scaled)
}

fn print_node_label(code: i32) with IO {
    if code == 65 { print("A") }
    else { if code == 66 { print("B") }
    else { if code == 67 { print("C") }
    else { if code == 68 { print("D") }
    else { if code == 69 { print("E") }
    else { if code == 70 { print("F") }
    else { if code == 71 { print("G") }
    else { if code == 72 { print("H") }
    else { if code == 73 { print("I") }
    else { if code == 74 { print("J") }
    else { if code == 75 { print("K") }
    else { if code == 76 { print("L") }
    else { if code == 77 { print("M") }
    else { if code == 78 { print("N") }
    else { if code == 79 { print("O") }
    else { print("?") }
    }}}}}}}}}}}}}}}
}

fn print_char_simple(ch: i32) with IO {
    if ch == 32 { print(" ") }
    else { if ch == 42 { print("*") }
    else { if ch == 45 { print("-") }
    else { if ch == 46 { print(".") }
    else { if ch == 124 { print("|") }
    else { if ch >= 65 {
        if ch <= 90 {
            print_node_label(ch)
        } else {
            print(" ")
        }
    } else {
        print(" ")
    }}}}}}
}

fn wait_for_input() with IO {
    // Busy wait simulation (no actual input in Sounio yet)
    var i = 0
    while i < 50000000 {
        i = i + 1
    }
}

