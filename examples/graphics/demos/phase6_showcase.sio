// ============================================================================
// Main
// ============================================================================

fn main() -> i32 with IO, Mut, Div, Panic {
    // Show each demo
    demo_phase_diagram()
    sleep_frames(100)

    demo_bifurcation()
    sleep_frames(100)

    demo_poincare()
    sleep_frames(100)

    demo_streamlines()
    sleep_frames(100)

    demo_summary()

    return 0
}
