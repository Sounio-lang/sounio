// Phase 6 Showcase - Scientific Charts Demonstration
//
// Demonstrates the four scientific visualization modules:
// 1. Phase Diagram - Thermodynamic phase regions
// 2. Bifurcation Diagram - Route to chaos in logistic map
// 3. Poincaré Section - Lorenz attractor structure
// 4. Streamlines - Dipole vector field flow
//
// Each visualization is shown for a few seconds before transitioning.

// ============================================================================
// Common Helpers
// ============================================================================

fn print_i32(x: i32) with IO, Div, Panic {
    if x == 0 { print("0"); return }
    if x < 0 { print("-"); print_i32_unsigned(0 - x) }
    else { print_i32_unsigned(x) }
}

fn print_i32_unsigned(x: i32) with IO, Div, Panic {
    if x == 0 { return }
    let rest = x / 10
    if rest > 0 { print_i32_unsigned(rest) }
    let digit = x % 10
    print_digit(digit)
}

fn print_digit(d: i32) with IO {
    if d == 0 { print("0") }
    else { if d == 1 { print("1") }
    else { if d == 2 { print("2") }
    else { if d == 3 { print("3") }
    else { if d == 4 { print("4") }
    else { if d == 5 { print("5") }
    else { if d == 6 { print("6") }
    else { if d == 7 { print("7") }
    else { if d == 8 { print("8") }
    else { if d == 9 { print("9") }
    }}}}}}}}}}
}

fn print_f64(x: f64) with IO, Div, Panic {
    if x < 0.0 { print("-"); let x = 0.0 - x }
    let int_part = x as i32
    print_i32(int_part)
    print(".")
    let frac = x - (int_part as f64)
    let scaled = (frac * 100.0) as i32
    if scaled < 10 { print("0") }
    print_i32_unsigned(scaled)
}

fn sleep_frames(n: i32) with IO {
    // Busy-wait loop as placeholder for timing
    // Terminal I/O provides natural delay
    var i = 0
    while i < n * 10000 {
        i = i + 1
    }
}

// ============================================================================
// Demo 1: Simplified Phase Diagram
// ============================================================================

fn demo_phase_diagram() with IO, Mut, Div, Panic {
    print("\x1b[2J\x1b[H")
    print("\x1b[1;36m╔══════════════════════════════════════════════════════════╗\x1b[0m\n")
    print("\x1b[1;36m║          PHASE 6: SCIENTIFIC CHARTS                      ║\x1b[0m\n")
    print("\x1b[1;36m║     Demo 1/4: Phase Diagram (Water H2O)                  ║\x1b[0m\n")
    print("\x1b[1;36m╚══════════════════════════════════════════════════════════╝\x1b[0m\n\n")

    // Simplified phase diagram display
    print("  P (kPa)\n")
    print("   ^\n")
    print("   |\n")

    // Render simplified phase regions
    // High pressure region (solid/liquid)
    var y = 20
    while y >= 0 {
        print("   |")

        var x = 0
        while x < 50 {
            // Temperature roughly maps to x (200K to 700K)
            let t = 200.0 + (x as f64) * 10.0
            // Pressure roughly maps to y (0 to 25000 kPa)
            let p = (y as f64) * 1200.0

            // Phase classification
            var phase = 0

            // Below triple point pressure
            if p < 610.0 {
                if t < 273.0 {
                    phase = 1  // Solid
                } else {
                    phase = 3  // Gas
                }
            } else {
                // Above critical point
                if t > 650.0 {
                    if p > 22000.0 {
                        phase = 4  // Supercritical
                    } else {
                        phase = 3  // Gas
                    }
                } else {
                    // Normal phases
                    if t < 273.0 {
                        phase = 1  // Solid
                    } else {
                        // Liquid or gas based on vapor pressure curve
                        let vp = 0.611 * exp_simple((t - 273.0) * 0.05)
                        if p > vp {
                            phase = 2  // Liquid
                        } else {
                            phase = 3  // Gas
                        }
                    }
                }
            }

            // Render
            if phase == 1 {
                print("\x1b[34m#\x1b[0m")  // Blue solid
            } else { if phase == 2 {
                print("\x1b[36m~\x1b[0m")  // Cyan liquid
            } else { if phase == 3 {
                print("\x1b[33m.\x1b[0m")  // Yellow gas
            } else {
                print("\x1b[35m*\x1b[0m")  // Magenta supercritical
            }}}

            x = x + 1
        }
        print("\n")
        y = y - 1
    }

    print("   +---------------------------------------------------> T (K)\n")
    print("     200                    450                     700\n\n")

    print("   \x1b[34m#\x1b[0m Solid (Ice)  \x1b[36m~\x1b[0m Liquid  \x1b[33m.\x1b[0m Gas (Vapor)  \x1b[35m*\x1b[0m Supercritical\n")
    print("   \x1b[1;31mT\x1b[0m = Triple Point (273K, 0.6kPa)\n")
    print("   \x1b[1;31mC\x1b[0m = Critical Point (647K, 22MPa)\n")
}

fn exp_simple(x: f64) -> f64 {
    if x > 10.0 { return 22000.0 }
    if x < -10.0 { return 0.00001 }
    let x2 = x * x
    let x3 = x2 * x
    return 1.0 + x + x2 * 0.5 + x3 * 0.167
}

// ============================================================================
// Demo 2: Bifurcation Diagram
// ============================================================================

fn demo_bifurcation() with IO, Mut, Div, Panic {
    print("\x1b[2J\x1b[H")
    print("\x1b[1;36m╔══════════════════════════════════════════════════════════╗\x1b[0m\n")
    print("\x1b[1;36m║          PHASE 6: SCIENTIFIC CHARTS                      ║\x1b[0m\n")
    print("\x1b[1;36m║     Demo 2/4: Bifurcation Diagram (Logistic Map)         ║\x1b[0m\n")
    print("\x1b[1;36m╚══════════════════════════════════════════════════════════╝\x1b[0m\n\n")

    // Grid for density
    var density = [0; 2400]  // 60 x 40

    // Compute bifurcation for logistic map
    var px = 0
    while px < 60 {
        // r ranges from 2.5 to 4.0
        let r = 2.5 + (px as f64) * 0.025

        // Start from x = 0.5
        var x = 0.5

        // Transient
        var t = 0
        while t < 200 {
            x = r * x * (1.0 - x)
            t = t + 1
        }

        // Sample attractor
        var s = 0
        while s < 100 {
            x = r * x * (1.0 - x)

            // Map to grid (x in [0,1], y axis)
            let gy = (x * 39.0) as i32
            if gy >= 0 {
                if gy < 40 {
                    let idx = gy * 60 + px
                    if idx < 2400 {
                        density[idx] = density[idx] + 1
                    }
                }
            }
            s = s + 1
        }

        px = px + 1
    }

    // Render
    print("   x\n")
    print("   ^\n")

    var y = 39
    while y >= 0 {
        print("   |")

        var x = 0
        while x < 60 {
            let idx = y * 60 + x
            var d = 0
            if idx < 2400 {
                d = density[idx]
            }

            if d == 0 {
                print(" ")
            } else { if d < 3 {
                print("\x1b[34m.\x1b[0m")
            } else { if d < 10 {
                print("\x1b[36m:\x1b[0m")
            } else { if d < 30 {
                print("\x1b[32m+\x1b[0m")
            } else {
                print("\x1b[33m*\x1b[0m")
            }}}}

            x = x + 1
        }
        print("\n")
        y = y - 1
    }

    print("   +-------------------------------------------------------------> r\n")
    print("     2.5                        3.2                           4.0\n\n")

    print("   Logistic map: x_{n+1} = r * x_n * (1 - x_n)\n")
    print("   Shows period-doubling cascade: 1 -> 2 -> 4 -> 8 -> ... -> chaos\n")
}

// ============================================================================
// Demo 3: Poincaré Section
// ============================================================================

struct State3D {
    x: f64,
    y: f64,
    z: f64
}

fn demo_poincare() with IO, Mut, Div, Panic {
    print("\x1b[2J\x1b[H")
    print("\x1b[1;36m╔══════════════════════════════════════════════════════════╗\x1b[0m\n")
    print("\x1b[1;36m║          PHASE 6: SCIENTIFIC CHARTS                      ║\x1b[0m\n")
    print("\x1b[1;36m║     Demo 3/4: Poincare Section (Lorenz Attractor)        ║\x1b[0m\n")
    print("\x1b[1;36m╚══════════════════════════════════════════════════════════╝\x1b[0m\n\n")

    // Density grid for section at z=27
    var density = [0; 1800]  // 60 x 30
    let section_z = 27.0

    // Integrate Lorenz system
    var state = State3D { x: 1.0, y: 1.0, z: 1.0 }
    var prev_z = state.z
    let dt = 0.005
    let sigma = 10.0
    let rho = 28.0
    let beta = 2.667

    // Skip transient
    var t = 0
    while t < 10000 {
        prev_z = state.z
        // RK4 step (simplified to Euler for brevity)
        let dx = sigma * (state.y - state.x)
        let dy = state.x * (rho - state.z) - state.y
        let dz = state.x * state.y - beta * state.z
        state.x = state.x + dx * dt
        state.y = state.y + dy * dt
        state.z = state.z + dz * dt
        t = t + 1
    }

    // Collect crossings
    t = 0
    while t < 200000 {
        prev_z = state.z
        let dx = sigma * (state.y - state.x)
        let dy = state.x * (rho - state.z) - state.y
        let dz = state.x * state.y - beta * state.z
        state.x = state.x + dx * dt
        state.y = state.y + dy * dt
        state.z = state.z + dz * dt

        // Check upward crossing
        if prev_z < section_z {
            if state.z >= section_z {
                // Map (x, y) to grid
                // x in [-25, 25], y in [-30, 30]
                let gx = ((state.x + 25.0) * 1.2) as i32
                let gy = ((state.y + 30.0) * 0.5) as i32
                if gx >= 0 {
                    if gx < 60 {
                        if gy >= 0 {
                            if gy < 30 {
                                let idx = gy * 60 + gx
                                if idx < 1800 {
                                    density[idx] = density[idx] + 1
                                }
                            }
                        }
                    }
                }
            }
        }

        t = t + 1
    }

    // Render
    print("   y\n")
    print("   ^\n")

    var y = 29
    while y >= 0 {
        print("   |")

        var x = 0
        while x < 60 {
            let idx = y * 60 + x
            var d = 0
            if idx < 1800 {
                d = density[idx]
            }

            if d == 0 {
                print(" ")
            } else { if d < 2 {
                print("\x1b[34m.\x1b[0m")
            } else { if d < 5 {
                print("\x1b[36m+\x1b[0m")
            } else { if d < 15 {
                print("\x1b[32m*\x1b[0m")
            } else {
                print("\x1b[33m#\x1b[0m")
            }}}}

            x = x + 1
        }
        print("\n")
        y = y - 1
    }

    print("   +-------------------------------------------------------------> x\n")
    print("    -25                          0                             25\n\n")

    print("   Lorenz attractor at z = 27 plane\n")
    print("   Reveals fractal structure of strange attractor\n")
}

// ============================================================================
// Demo 4: Streamlines
// ============================================================================

fn demo_streamlines() with IO, Mut, Div, Panic {
    print("\x1b[2J\x1b[H")
    print("\x1b[1;36m╔══════════════════════════════════════════════════════════╗\x1b[0m\n")
    print("\x1b[1;36m║          PHASE 6: SCIENTIFIC CHARTS                      ║\x1b[0m\n")
    print("\x1b[1;36m║     Demo 4/4: Streamlines (Dipole Field)                 ║\x1b[0m\n")
    print("\x1b[1;36m╚══════════════════════════════════════════════════════════╝\x1b[0m\n\n")

    // Display buffer
    var display = [32; 1800]  // 60 x 30

    // Integrate streamlines from seed points
    var seed = 0
    while seed < 20 {
        // Seed positions (grid around y-axis)
        var sx = 0.0
        var sy = -2.5 + (seed as f64) * 0.26

        // Integrate forward
        var step = 0
        while step < 200 {
            // Check bounds
            if sx < -3.0 { step = 200 }
            else { if sx > 3.0 { step = 200 }
            else { if sy < -3.0 { step = 200 }
            else { if sy > 3.0 { step = 200 }
            else {
                // Plot point
                let gx = ((sx + 3.0) * 10.0) as i32
                let gy = ((sy + 3.0) * 5.0) as i32
                if gx >= 0 {
                    if gx < 60 {
                        if gy >= 0 {
                            if gy < 30 {
                                let idx = gy * 60 + gx

                                // Get dipole field direction
                                let r1x = sx + 1.0
                                let r1y = sy
                                let r1sq = r1x * r1x + r1y * r1y + 0.1
                                let r2x = sx - 1.0
                                let r2y = sy
                                let r2sq = r2x * r2x + r2y * r2y + 0.1

                                let vx = r1x / r1sq - r2x / r2sq
                                let vy = r1y / r1sq - r2y / r2sq

                                // Direction character
                                var ch = 45  // '-'
                                let abs_vx = vx
                                let abs_vy = vy
                                if abs_vx < 0.0 { let abs_vx = 0.0 - abs_vx }
                                if abs_vy < 0.0 { let abs_vy = 0.0 - abs_vy }

                                if abs_vy > abs_vx * 2.0 {
                                    ch = 124  // '|'
                                } else { if abs_vx > abs_vy * 2.0 {
                                    ch = 45  // '-'
                                } else {
                                    if vx * vy > 0.0 {
                                        ch = 92  // '\'
                                    } else {
                                        ch = 47  // '/'
                                    }
                                }}

                                if idx < 1800 {
                                    display[idx] = ch
                                }
                            }
                        }
                    }
                }

                // Euler step
                let r1x = sx + 1.0
                let r1y = sy
                let r1sq = r1x * r1x + r1y * r1y + 0.1
                let r2x = sx - 1.0
                let r2y = sy
                let r2sq = r2x * r2x + r2y * r2y + 0.1

                let vx = r1x / r1sq - r2x / r2sq
                let vy = r1y / r1sq - r2y / r2sq

                let vlen = sqrt_simple(vx * vx + vy * vy)
                if vlen > 0.01 {
                    sx = sx + vx * 0.03 / vlen
                    sy = sy + vy * 0.03 / vlen
                } else {
                    step = 200
                }
            }}}}

            step = step + 1
        }

        seed = seed + 1
    }

    // Mark source and sink
    let src_x = ((0.0 - 1.0 + 3.0) * 10.0) as i32
    let src_y = ((0.0 + 3.0) * 5.0) as i32
    let sink_x = ((1.0 + 3.0) * 10.0) as i32
    let sink_y = ((0.0 + 3.0) * 5.0) as i32

    if src_x >= 0 {
        if src_x < 60 {
            if src_y >= 0 {
                if src_y < 30 {
                    display[src_y * 60 + src_x] = 43  // '+'
                }
            }
        }
    }
    if sink_x >= 0 {
        if sink_x < 60 {
            if sink_y >= 0 {
                if sink_y < 30 {
                    display[sink_y * 60 + sink_x] = 45  // '-' for sink
                }
            }
        }
    }

    // Render
    print("   y\n")
    print("   ^\n")

    var y = 29
    while y >= 0 {
        print("   |")

        var x = 0
        while x < 60 {
            let idx = y * 60 + x
            var ch = 32
            if idx < 1800 {
                ch = display[idx]
            }

            // Color streamlines cyan, special points red
            if ch == 43 {
                print("\x1b[1;31m+\x1b[0m")  // Source
            } else { if ch == 45 {
                if x == sink_x {
                    if y == sink_y {
                        print("\x1b[1;31m-\x1b[0m")  // Sink
                    } else {
                        print("\x1b[36m-\x1b[0m")
                    }
                } else {
                    print("\x1b[36m-\x1b[0m")
                }
            } else { if ch == 32 {
                print(" ")
            } else {
                print("\x1b[36m")
                print_char_code(ch)
                print("\x1b[0m")
            }}}

            x = x + 1
        }
        print("\n")
        y = y - 1
    }

    print("   +-------------------------------------------------------------> x\n")
    print("    -3                           0                              3\n\n")

    print("   Electric dipole field: \x1b[1;31m+\x1b[0m source at (-1,0), \x1b[1;31m-\x1b[0m sink at (1,0)\n")
    print("   Field lines flow from positive to negative charge\n")
}

fn sqrt_simple(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var g = x * 0.5
    if g < 1.0 { g = 1.0 }
    var i = 0
    while i < 8 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    return g
}

fn print_char_code(code: i32) with IO {
    if code == 32 { print(" ") }
    else { if code == 45 { print("-") }
    else { if code == 47 { print("/") }
    else { if code == 92 { print("\\") }
    else { if code == 124 { print("|") }
    else { print(".") }
    }}}}
}

