// Phase 1 Showcase - Comprehensive demo of Sounio terminal graphics
//
// Demonstrates:
// - Canvas abstraction with double buffering
// - Color management with semantic mappings
// - Drawing primitives (lines, circles, rectangles)
// - Text rendering with alignment and styling
//
// Creates a visually rich terminal graphic showcasing all Phase 1 capabilities.

// ============================================================================
// Duplicate types from library modules
// ============================================================================

struct Cell {
    ch: i32,
    fg_color: i32,
    bg_color: i32,
    bold: i32,
    dim: i32
}

struct Canvas {
    width: i32,
    height: i32,
    cells: [Cell; 2400]
}

struct TextStyle {
    fg_color: i32,
    bg_color: i32,
    bold: i32,
    dim: i32
}

// ============================================================================
// Canvas functions
// ============================================================================

fn cell_blank() -> Cell {
    return Cell {
        ch: 32,
        fg_color: 7,
        bg_color: 0,
        bold: 0,
        dim: 0
    }
}

fn canvas_new(width: i32, height: i32) -> Canvas with Mut, Panic, Div {
    var canvas = Canvas {
        width: width,
        height: height,
        cells: [cell_blank(); 2400]
    }

    var i = 0
    while i < width * height {
        canvas.cells[i] = cell_blank()
        i = i + 1
    }

    return canvas
}

fn canvas_set_pixel(canvas: Canvas, x: i32, y: i32, ch: i32, color: i32) -> Canvas with Mut, Panic {
    if x < 0 { return canvas }
    if y < 0 { return canvas }
    if x >= canvas.width { return canvas }
    if y >= canvas.height { return canvas }

    var new_canvas = canvas
    let index = y * canvas.width + x
    new_canvas.cells[index] = Cell {
        ch: ch,
        fg_color: color,
        bg_color: 0,
        bold: 0,
        dim: 0
    }
    return new_canvas
}

fn canvas_set_styled(canvas: Canvas, x: i32, y: i32, ch: i32, style: TextStyle) -> Canvas with Mut, Panic {
    if x < 0 { return canvas }
    if y < 0 { return canvas }
    if x >= canvas.width { return canvas }
    if y >= canvas.height { return canvas }

    var new_canvas = canvas
    let index = y * canvas.width + x
    new_canvas.cells[index] = Cell {
        ch: ch,
        fg_color: style.fg_color,
        bg_color: style.bg_color,
        bold: style.bold,
        dim: style.dim
    }
    return new_canvas
}

// ============================================================================
// Drawing primitives
// ============================================================================

fn draw_hline(canvas: Canvas, x0: i32, x1: i32, y: i32, color: i32) -> Canvas with Mut, Panic, Div {
    var result = canvas
    let start_x = if x0 < x1 { x0 } else { x1 }
    let end_x = if x0 < x1 { x1 } else { x0 }

    var x = start_x
    while x <= end_x {
        result = canvas_set_pixel(result, x, y, 9608, color)
        x = x + 1
    }

    return result
}

fn draw_vline(canvas: Canvas, x: i32, y0: i32, y1: i32, color: i32) -> Canvas with Mut, Panic, Div {
    var result = canvas
    let start_y = if y0 < y1 { y0 } else { y1 }
    let end_y = if y0 < y1 { y1 } else { y0 }

    var y = start_y
    while y <= end_y {
        result = canvas_set_pixel(result, x, y, 9608, color)
        y = y + 1
    }

    return result
}

fn draw_rect(canvas: Canvas, x: i32, y: i32, width: i32, height: i32, color: i32) -> Canvas with Mut, Panic, Div {
    var result = canvas

    result = draw_hline(result, x, x + width - 1, y, color)
    result = draw_hline(result, x, x + width - 1, y + height - 1, color)
    result = draw_vline(result, x, y, y + height - 1, color)
    result = draw_vline(result, x + width - 1, y, y + height - 1, color)

    return result
}

fn fill_rect(canvas: Canvas, x: i32, y: i32, width: i32, height: i32, color: i32) -> Canvas with Mut, Panic, Div {
    var result = canvas

    var row = 0
    while row < height {
        result = draw_hline(result, x, x + width - 1, y + row, color)
        row = row + 1
    }

    return result
}

// ============================================================================
// Text rendering
// ============================================================================

fn text_style_new(fg: i32, bg: i32, bold: i32, dim: i32) -> TextStyle {
    return TextStyle {
        fg_color: fg,
        bg_color: bg,
        bold: bold,
        dim: dim
    }
}

fn string_length(chars: &[i32], max_len: i32) -> i32 with Mut, Panic, Div {
    var len = 0
    while len < max_len {
        if chars[len] == -1 {
            return len
        }
        len = len + 1
    }
    return len
}

fn draw_text_left(
    canvas: Canvas,
    x: i32,
    y: i32,
    text: &[i32],
    max_len: i32,
    style: TextStyle
) -> Canvas with Mut, Panic, Div {
    var result = canvas
    var i = 0
    var cur_x = x

    while i < max_len {
        let ch = text[i]
        if ch == -1 {
            return result
        }

        result = canvas_set_styled(result, cur_x, y, ch, style)
        cur_x = cur_x + 1
        i = i + 1
    }

    return result
}

fn draw_text_center(
    canvas: Canvas,
    x: i32,
    y: i32,
    text: &[i32],
    max_len: i32,
    style: TextStyle
) -> Canvas with Mut, Panic, Div {
    let text_len = string_length(text, max_len)
    let start_x = x - (text_len / 2)

    return draw_text_left(canvas, start_x, y, text, max_len, style)
}

// ============================================================================
// Color functions
// ============================================================================

fn COLOR_RED() -> i32 { return 1 }
fn COLOR_GREEN() -> i32 { return 2 }
fn COLOR_YELLOW() -> i32 { return 3 }
fn COLOR_BLUE() -> i32 { return 4 }
fn COLOR_MAGENTA() -> i32 { return 5 }
fn COLOR_CYAN() -> i32 { return 6 }
fn COLOR_WHITE() -> i32 { return 7 }

fn uncertainty_to_color(normalized: f64) -> i32 {
    if normalized < 0.3 {
        return COLOR_GREEN()
    }
    if normalized < 0.6 {
        return COLOR_YELLOW()
    }
    return COLOR_RED()
}

// ============================================================================
// Render canvas to terminal (simplified)
// ============================================================================

fn print_color_code(code: i32) with IO {
    print("\x1b[3")
    if code == 0 { print("0") }
    if code == 1 { print("1") }
    if code == 2 { print("2") }
    if code == 3 { print("3") }
    if code == 4 { print("4") }
    if code == 5 { print("5") }
    if code == 6 { print("6") }
    if code == 7 { print("7") }
    print("m")
}

fn print_char(ch: i32) with IO {
    if ch == 32 { print(" ") }
    if ch == 35 { print("#") }
    if ch == 42 { print("*") }
    if ch == 45 { print("-") }
    if ch == 61 { print("=") }
    if ch == 66 { print("B") }
    if ch == 67 { print("C") }
    if ch == 68 { print("D") }
    if ch == 71 { print("G") }
    if ch == 72 { print("H") }
    if ch == 73 { print("I") }
    if ch == 76 { print("L") }
    if ch == 79 { print("O") }
    if ch == 80 { print("P") }
    if ch == 83 { print("S") }
    if ch == 84 { print("T") }
    if ch == 97 { print("a") }
    if ch == 99 { print("c") }
    if ch == 101 { print("e") }
    if ch == 103 { print("g") }
    if ch == 104 { print("h") }
    if ch == 105 { print("i") }
    if ch == 108 { print("l") }
    if ch == 110 { print("n") }
    if ch == 111 { print("o") }
    if ch == 112 { print("p") }
    if ch == 114 { print("r") }
    if ch == 115 { print("s") }
    if ch == 119 { print("w") }
    if ch == 9608 { print("█") }
}

fn canvas_render(canvas: &Canvas) with IO, Mut, Div, Panic {
    print("\x1b[H")  // Home cursor

    var y = 0
    while y < canvas.height {
        var x = 0
        var current_color = -1

        while x < canvas.width {
            let index = y * canvas.width + x
            let cell = canvas.cells[index]

            if cell.fg_color != current_color {
                print_color_code(cell.fg_color)
                current_color = cell.fg_color
            }

            print_char(cell.ch)
            x = x + 1
        }

        print("\x1b[0m\n")  // Reset color at end of line
        y = y + 1
    }
}

// ============================================================================
// Main Demo
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    // Create 70×25 canvas
    var canvas = canvas_new(70, 25)

    // ========================================================================
    // Title section
    // ========================================================================

    var title = [83, 79, 85, 78, 73, 79, 32, 71, 82, 65, 80, 72, 73, 67, 83, -1]  // "SOUNIO GRAPHICS"
    let title_style = text_style_new(COLOR_CYAN(), 0, 1, 0)  // Cyan + bold
    canvas = draw_text_center(canvas, 35, 1, &title, 20, title_style)

    var subtitle = [80, 104, 97, 115, 101, 32, 49, 32, 83, 104, 111, 119, 99, 97, 115, 101, -1]  // "Phase 1 Showcase"
    let subtitle_style = text_style_new(COLOR_YELLOW(), 0, 0, 0)  // Yellow
    canvas = draw_text_center(canvas, 35, 2, &subtitle, 20, subtitle_style)

    // Horizontal divider
    canvas = draw_hline(canvas, 5, 65, 3, COLOR_WHITE())

    // ========================================================================
    // Color palette demonstration
    // ========================================================================

    var palette_label = [67, 111, 108, 111, 114, 115, -1]  // "Colors"
    let label_style = text_style_new(COLOR_GREEN(), 0, 1, 0)  // Green + bold
    canvas = draw_text_left(canvas, 5, 5, &palette_label, 10, label_style)

    // Color swatches
    canvas = fill_rect(canvas, 5, 7, 4, 2, COLOR_RED())
    canvas = fill_rect(canvas, 10, 7, 4, 2, COLOR_GREEN())
    canvas = fill_rect(canvas, 15, 7, 4, 2, COLOR_BLUE())
    canvas = fill_rect(canvas, 20, 7, 4, 2, COLOR_YELLOW())
    canvas = fill_rect(canvas, 25, 7, 4, 2, COLOR_MAGENTA())
    canvas = fill_rect(canvas, 30, 7, 4, 2, COLOR_CYAN())

    // ========================================================================
    // Geometric shapes demonstration
    // ========================================================================

    var shapes_label = [83, 104, 97, 112, 101, 115, -1]  // "Shapes"
    canvas = draw_text_left(canvas, 5, 11, &shapes_label, 10, label_style)

    // Rectangles
    canvas = draw_rect(canvas, 5, 13, 10, 5, COLOR_BLUE())
    canvas = fill_rect(canvas, 18, 13, 10, 5, COLOR_MAGENTA())

    // ========================================================================
    // Uncertainty visualization (semantic color mapping)
    // ========================================================================

    var uncertainty_label = [85, 110, 99, 101, 114, 116, 97, 105, 110, 116, 121, -1]  // "Uncertainty"
    canvas = draw_text_left(canvas, 40, 5, &uncertainty_label, 15, label_style)

    // Low uncertainty (0.2) → Green
    let low_unc_color = uncertainty_to_color(0.2)
    canvas = fill_rect(canvas, 40, 7, 8, 2, low_unc_color)
    var low_label = [76, 111, 119, -1]  // "Low"
    let low_text_style = text_style_new(COLOR_WHITE(), 0, 0, 0)
    canvas = draw_text_left(canvas, 49, 7, &low_label, 5, low_text_style)

    // Medium uncertainty (0.5) → Yellow
    let med_unc_color = uncertainty_to_color(0.5)
    canvas = fill_rect(canvas, 40, 10, 8, 2, med_unc_color)
    var med_label = [77, 101, 100, -1]  // "Med"
    canvas = draw_text_left(canvas, 49, 10, &med_label, 5, low_text_style)

    // High uncertainty (0.8) → Red
    let high_unc_color = uncertainty_to_color(0.8)
    canvas = fill_rect(canvas, 40, 13, 8, 2, high_unc_color)
    var high_label = [72, 105, 103, 104, -1]  // "High"
    canvas = draw_text_left(canvas, 49, 13, &high_label, 6, low_text_style)

    // ========================================================================
    // Footer
    // ========================================================================

    canvas = draw_hline(canvas, 5, 65, 20, COLOR_WHITE())

    var footer = [84, 101, 114, 109, 105, 110, 97, 108, 45, 110, 97, 116, 105, 118, 101, 32, 103, 114, 97, 112, 104, 105, 99, 115, 33, -1]  // "Terminal-native graphics!"
    let footer_style = text_style_new(COLOR_CYAN(), 0, 0, 1)  // Cyan + dim
    canvas = draw_text_center(canvas, 35, 22, &footer, 30, footer_style)

    // ========================================================================
    // Render to terminal
    // ========================================================================

    canvas_render(&canvas)

    return 0
}
