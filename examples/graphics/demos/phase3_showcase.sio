// phase3_showcase.sio - Comprehensive Phase 3 (3D Graphics) Demo
//
// Showcases all Phase 3 3D visualization capabilities:
// - Isometric and perspective projection
// - Wireframe meshes (cube, pyramid, tetrahedron, octahedron)
// - 3D scatter plots with depth sorting
// - Point cloud visualization
// - Rotation and transformation
//
// Layout: 2×2 grid
//  ┌─────────────────┬─────────────────┐
//  │  Rotating Cube  │  3D Scatter     │
//  │  (Wireframe)    │  (Helix)        │
//  ├─────────────────┼─────────────────┤
//  │  Pyramid        │  Point Cloud    │
//  │  (Wireframe)    │  (Sphere)       │
//  └─────────────────┴─────────────────┘

import "stdlib/math/core.sio"
import "../lib/00_canvas.sio"
import "../lib/01_colors.sio"
import "../lib/02_drawing.sio"
import "../lib/03_text.sio"
import "../lib/10_axes.sio"
import "../lib/20_projection.sio"
import "../lib/21_wireframe.sio"
import "../lib/23_scatter3d.sio"

fn main() -> i32 with IO, Mut, Panic, Div {
    print("\x1b[2J\x1b[H")  // Clear screen
    print("═══════════════════════════════════════════════════════════════════════\n")
    print("  PHASE 3: 3D VISUALIZATION SHOWCASE\n")
    print("═══════════════════════════════════════════════════════════════════════\n\n")

    // Create canvas (80×30)
    var canvas = canvas_new(80, 30)
    canvas = canvas_clear(canvas)

    // ==================================================================
    // Panel 1: Rotating Cube Wireframe (Top Left)
    // ==================================================================

    let vp1 = viewport_new(-5.0, 5.0, -5.0, 5.0, 2, 1, 36, 13)

    // Create cube
    let cube = mesh_cube(3.0)

    // Rotate 45° around Y, 30° around Z
    let cube_rotation = vec3d_new(0.0, deg_to_rad(45.0), deg_to_rad(30.0))

    // Draw axes
    canvas = draw_axes_3d(canvas, &vp1, 4.0, 1.0)

    // Draw wireframe
    canvas = draw_wireframe_auto(canvas, &vp1, &cube, cube_rotation, COLOR_CYAN())

    // Title
    canvas = draw_text(canvas, 5, 0, "Rotating Cube", text_style_colored(COLOR_WHITE()))

    // ==================================================================
    // Panel 2: 3D Scatter Plot - Helix (Top Right)
    // ==================================================================

    let vp2 = viewport_new(-5.0, 5.0, -5.0, 5.0, 42, 1, 36, 13)

    // Generate helix points
    var helix_points = generate_helix_points(40, 2.0, 0.25)

    // Colorize by Z
    colorize_by_z(&!helix_points, 40, -4.0, 4.0)

    // Draw with rotation
    let helix_rotation = vec3d_new(deg_to_rad(15.0), deg_to_rad(30.0), 0.0)
    canvas = scatter_plot_3d_rotated(canvas, &vp2, &helix_points, 40, helix_rotation, 1.5)

    // Title
    canvas = draw_text(canvas, 45, 0, "3D Helix (40 pts)", text_style_colored(COLOR_WHITE()))

    // ==================================================================
    // Panel 3: Pyramid Wireframe (Bottom Left)
    // ==================================================================

    let vp3 = viewport_new(-5.0, 5.0, -5.0, 5.0, 2, 15, 36, 13)

    // Create pyramid
    let pyramid = mesh_pyramid(3.0, 4.0)

    // Rotate 20° around X, 45° around Y
    let pyramid_rotation = vec3d_new(deg_to_rad(20.0), deg_to_rad(45.0), 0.0)

    // Draw wireframe
    canvas = draw_wireframe_auto(canvas, &vp3, &pyramid, pyramid_rotation, COLOR_YELLOW())

    // Title
    canvas = draw_text(canvas, 5, 14, "Pyramid", text_style_colored(COLOR_WHITE()))

    // ==================================================================
    // Panel 4: Point Cloud - Sphere Surface (Bottom Right)
    // ==================================================================

    let vp4 = viewport_new(-5.0, 5.0, -5.0, 5.0, 42, 15, 36, 13)

    // Generate sphere points
    var sphere_points = generate_sphere_points(60, 2.5, 12345)

    // Colorize by distance from origin
    colorize_by_distance(&!sphere_points, 60)

    // Draw with rotation
    let sphere_rotation = vec3d_new(deg_to_rad(25.0), deg_to_rad(40.0), deg_to_rad(10.0))
    canvas = scatter_plot_3d_rotated(canvas, &vp4, &sphere_points, 60, sphere_rotation, 1.5)

    // Title
    canvas = draw_text(canvas, 45, 14, "Sphere (60 pts)", text_style_colored(COLOR_WHITE()))

    // ==================================================================
    // Draw Panel Dividers
    // ==================================================================

    // Vertical divider
    canvas = draw_vline(canvas, 40, 0, 29, COLOR_BRIGHT_BLACK())

    // Horizontal divider
    canvas = draw_hline(canvas, 0, 79, 14, COLOR_BRIGHT_BLACK())

    // ==================================================================
    // Render Canvas
    // ==================================================================

    canvas_render(&canvas)

    // ==================================================================
    // Print Summary
    // ==================================================================

    print("\n")
    print("───────────────────────────────────────────────────────────────────────\n")
    print("Phase 3 Features Demonstrated:\n")
    print("───────────────────────────────────────────────────────────────────────\n")
    print("✓ Isometric projection (all panels)\n")
    print("✓ 3D rotation (all objects rotated)\n")
    print("✓ Wireframe rendering (cube, pyramid)\n")
    print("✓ 3D scatter plots (helix, sphere)\n")
    print("✓ Depth-aware coloring (Z-coordinate and distance)\n")
    print("✓ Point cloud generation (procedural sphere)\n")
    print("✓ 3D coordinate axes (panel 1)\n")
    print("───────────────────────────────────────────────────────────────────────\n")
    print("\nObjects rendered:\n")
    print("  • Cube: 8 vertices, 12 edges\n")
    print("  • Pyramid: 5 vertices, 8 edges\n")
    print("  • Helix: 40 points\n")
    print("  • Sphere: 60 points (surface-sampled)\n")
    print("\nProjection: Isometric (30° angles)\n")
    print("Rotations: Euler angles (X-Y-Z order)\n")
    print("───────────────────────────────────────────────────────────────────────\n")

    return 0
}
