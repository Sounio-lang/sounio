// 20_projection.sio - 3D to 2D projection and transformations
//
// Provides isometric and perspective projection, 3D rotations,
// and coordinate transformations for 3D graphics rendering.

import "stdlib/math/core.sio"

// ============================================================================
// 3D Point Structure
// ============================================================================

struct Vec3D {
    x: f64,
    y: f64,
    z: f64
}

fn vec3d_new(x: f64, y: f64, z: f64) -> Vec3D {
    return Vec3D { x: x, y: y, z: z }
}

fn vec3d_zero() -> Vec3D {
    return Vec3D { x: 0.0, y: 0.0, z: 0.0 }
}

fn vec3d_add(a: &Vec3D, b: &Vec3D) -> Vec3D {
    return Vec3D {
        x: a.x + b.x,
        y: a.y + b.y,
        z: a.z + b.z
    }
}

fn vec3d_sub(a: &Vec3D, b: &Vec3D) -> Vec3D {
    return Vec3D {
        x: a.x - b.x,
        y: a.y - b.y,
        z: a.z - b.z
    }
}

fn vec3d_scale(v: &Vec3D, s: f64) -> Vec3D {
    return Vec3D {
        x: v.x * s,
        y: v.y * s,
        z: v.z * s
    }
}

fn vec3d_dot(a: &Vec3D, b: &Vec3D) -> f64 {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

fn vec3d_cross(a: &Vec3D, b: &Vec3D) -> Vec3D {
    return Vec3D {
        x: a.y * b.z - a.z * b.y,
        y: a.z * b.x - a.x * b.z,
        z: a.x * b.y - a.y * b.x
    }
}

fn vec3d_magnitude(v: &Vec3D) -> f64 with Panic {
    return sqrt(v.x * v.x + v.y * v.y + v.z * v.z)
}

fn vec3d_normalize(v: &Vec3D) -> Vec3D with Div, Panic {
    let mag = vec3d_magnitude(v)
    if mag < 0.0001 {
        return vec3d_zero()
    }
    return vec3d_scale(v, 1.0 / mag)
}

// ============================================================================
// 2D Point (for projected results)
// ============================================================================

struct Vec2D {
    x: f64,
    y: f64
}

fn vec2d_new(x: f64, y: f64) -> Vec2D {
    return Vec2D { x: x, y: y }
}

// ============================================================================
// Isometric Projection
// ============================================================================

// Isometric projection: projects 3D point to 2D using standard isometric angles
// This creates a pseudo-3D view where:
// - X axis goes right-down at 30°
// - Y axis goes left-down at 30°
// - Z axis goes straight up
//
// The projection formula:
// screen_x = (x - y) * cos(30°)
// screen_y = (x + y) * sin(30°) - z
//
// Using cos(30°) ≈ 0.866 and sin(30°) = 0.5

fn isometric_project(p: &Vec3D) -> Vec2D {
    let cos30 = 0.866025403784  // sqrt(3)/2
    let sin30 = 0.5

    let screen_x = (p.x - p.y) * cos30
    let screen_y = (p.x + p.y) * sin30 - p.z

    return vec2d_new(screen_x, screen_y)
}

// Isometric projection with scale factor
fn isometric_project_scaled(p: &Vec3D, scale: f64) -> Vec2D {
    let cos30 = 0.866025403784
    let sin30 = 0.5

    let screen_x = (p.x - p.y) * cos30 * scale
    let screen_y = ((p.x + p.y) * sin30 - p.z) * scale

    return vec2d_new(screen_x, screen_y)
}

// ============================================================================
// Perspective Projection
// ============================================================================

// Perspective projection: simulates realistic depth perception
// Points closer to camera appear larger, distant points appear smaller
//
// Formula:
// scale_factor = focal_length / (focal_length + z)
// screen_x = x * scale_factor
// screen_y = y * scale_factor
//
// Assumes camera is at origin looking down +Z axis

fn perspective_project(p: &Vec3D, focal_length: f64) -> Vec2D with Div {
    let z_adjusted = focal_length + p.z

    // Avoid division by zero
    if z_adjusted < 0.1 {
        return vec2d_new(p.x * 10.0, p.y * 10.0)
    }

    let scale_factor = focal_length / z_adjusted
    return vec2d_new(p.x * scale_factor, p.y * scale_factor)
}

// Perspective projection with clipping
// Points behind the camera (z < -focal_length) are clipped
fn perspective_project_clipped(p: &Vec3D, focal_length: f64) -> Vec2D with Div, Panic {
    let z_adjusted = focal_length + p.z

    // Clip points behind camera
    if z_adjusted <= 0.0 {
        return vec2d_new(0.0, 0.0)
    }

    let scale_factor = focal_length / z_adjusted
    return vec2d_new(p.x * scale_factor, p.y * scale_factor)
}

// ============================================================================
// 3D Rotations
// ============================================================================

// Rotation around X axis (pitch)
// Y and Z coordinates rotate, X stays the same
fn rotate_x(p: &Vec3D, angle_rad: f64) -> Vec3D with Panic {
    let c = cos(angle_rad)
    let s = sin(angle_rad)

    return Vec3D {
        x: p.x,
        y: p.y * c - p.z * s,
        z: p.y * s + p.z * c
    }
}

// Rotation around Y axis (yaw)
// X and Z coordinates rotate, Y stays the same
fn rotate_y(p: &Vec3D, angle_rad: f64) -> Vec3D with Panic {
    let c = cos(angle_rad)
    let s = sin(angle_rad)

    return Vec3D {
        x: p.x * c + p.z * s,
        y: p.y,
        z: -p.x * s + p.z * c
    }
}

// Rotation around Z axis (roll)
// X and Y coordinates rotate, Z stays the same
fn rotate_z(p: &Vec3D, angle_rad: f64) -> Vec3D with Panic {
    let c = cos(angle_rad)
    let s = sin(angle_rad)

    return Vec3D {
        x: p.x * c - p.y * s,
        y: p.x * s + p.y * c,
        z: p.z
    }
}

// Combined rotation: apply rotations in order X -> Y -> Z (Euler angles)
fn rotate_xyz(p: &Vec3D, rx: f64, ry: f64, rz: f64) -> Vec3D with Panic {
    var result = rotate_x(p, rx)
    result = rotate_y(&result, ry)
    result = rotate_z(&result, rz)
    return result
}

// Combined rotation with explicit order specification
// order: 0=XYZ, 1=XZY, 2=YXZ, 3=YZX, 4=ZXY, 5=ZYX
fn rotate_euler(p: &Vec3D, rx: f64, ry: f64, rz: f64, order: i32) -> Vec3D with Panic {
    if order == 0 {
        // XYZ
        var result = rotate_x(p, rx)
        result = rotate_y(&result, ry)
        result = rotate_z(&result, rz)
        return result
    } else { if order == 1 {
        // XZY
        var result = rotate_x(p, rx)
        result = rotate_z(&result, rz)
        result = rotate_y(&result, ry)
        return result
    } else { if order == 2 {
        // YXZ
        var result = rotate_y(p, ry)
        result = rotate_x(&result, rx)
        result = rotate_z(&result, rz)
        return result
    } else { if order == 3 {
        // YZX
        var result = rotate_y(p, ry)
        result = rotate_z(&result, rz)
        result = rotate_x(&result, rx)
        return result
    } else { if order == 4 {
        // ZXY
        var result = rotate_z(p, rz)
        result = rotate_x(&result, rx)
        result = rotate_y(&result, ry)
        return result
    } else {
        // ZYX (default)
        var result = rotate_z(p, rz)
        result = rotate_y(&result, ry)
        result = rotate_x(&result, rx)
        return result
    }}}}}
}

// ============================================================================
// Camera Transformations
// ============================================================================

// Transform point from world space to camera space
// camera_pos: position of camera in world
// camera_target: point camera is looking at
// camera_up: up vector (usually (0, 0, 1))
fn world_to_camera(
    p: &Vec3D,
    camera_pos: &Vec3D,
    camera_target: &Vec3D,
    camera_up: &Vec3D
) -> Vec3D with Div, Panic {
    // Compute camera basis vectors
    let forward = vec3d_normalize(&vec3d_sub(camera_target, camera_pos))
    let right = vec3d_normalize(&vec3d_cross(&forward, camera_up))
    let up = vec3d_cross(&right, &forward)

    // Translate point to camera space
    let translated = vec3d_sub(p, camera_pos)

    // Project onto camera basis
    return Vec3D {
        x: vec3d_dot(&translated, &right),
        y: vec3d_dot(&translated, &up),
        z: vec3d_dot(&translated, &forward)
    }
}

// ============================================================================
// Lighting and Shading
// ============================================================================

// Compute Lambertian (diffuse) shading intensity
// normal: surface normal (should be normalized)
// light_dir: direction to light source (should be normalized)
// Returns value in [0, 1] where 0 is dark, 1 is fully lit
fn lambertian_shading(normal: &Vec3D, light_dir: &Vec3D) -> f64 {
    let intensity = vec3d_dot(normal, light_dir)

    // Clamp to [0, 1]
    if intensity < 0.0 {
        return 0.0
    }
    if intensity > 1.0 {
        return 1.0
    }
    return intensity
}

// Compute surface normal for a triangle
// p1, p2, p3: triangle vertices in counter-clockwise order
// Returns normalized normal vector
fn triangle_normal(p1: &Vec3D, p2: &Vec3D, p3: &Vec3D) -> Vec3D with Div, Panic {
    let edge1 = vec3d_sub(p2, p1)
    let edge2 = vec3d_sub(p3, p1)
    let normal = vec3d_cross(&edge1, &edge2)
    return vec3d_normalize(&normal)
}

// ============================================================================
// Utility Functions
// ============================================================================

// Convert degrees to radians
fn deg_to_rad(deg: f64) -> f64 {
    return deg * 0.0174532925199  // deg * PI / 180
}

// Convert radians to degrees
fn rad_to_deg(rad: f64) -> f64 {
    return rad * 57.2957795131  // rad * 180 / PI
}

// Interpolate between two 3D points
fn vec3d_lerp(a: &Vec3D, b: &Vec3D, t: f64) -> Vec3D {
    return Vec3D {
        x: a.x + (b.x - a.x) * t,
        y: a.y + (b.y - a.y) * t,
        z: a.z + (b.z - a.z) * t
    }
}

// Distance between two 3D points
fn vec3d_distance(a: &Vec3D, b: &Vec3D) -> f64 with Panic {
    let dx = b.x - a.x
    let dy = b.y - a.y
    let dz = b.z - a.z
    return sqrt(dx * dx + dy * dy + dz * dz)
}

// ============================================================================
// Example/Test Function
// ============================================================================

fn main() -> i32 with IO, Panic, Div {
    print("=== 3D Projection Module Test ===\n\n")

    // Test point
    let p = vec3d_new(5.0, 3.0, 2.0)
    print("Original point: (")
    print_f64(p.x)
    print(", ")
    print_f64(p.y)
    print(", ")
    print_f64(p.z)
    print(")\n\n")

    // Isometric projection
    let iso = isometric_project(&p)
    print("Isometric projection: (")
    print_f64(iso.x)
    print(", ")
    print_f64(iso.y)
    print(")\n")

    // Perspective projection
    let persp = perspective_project(&p, 10.0)
    print("Perspective projection (focal=10): (")
    print_f64(persp.x)
    print(", ")
    print_f64(persp.y)
    print(")\n\n")

    // Rotation around Z axis (90 degrees)
    let angle = deg_to_rad(90.0)
    let rotated = rotate_z(&p, angle)
    print("After 90° rotation around Z: (")
    print_f64(rotated.x)
    print(", ")
    print_f64(rotated.y)
    print(", ")
    print_f64(rotated.z)
    print(")\n\n")

    // Test vector operations
    let v1 = vec3d_new(1.0, 0.0, 0.0)
    let v2 = vec3d_new(0.0, 1.0, 0.0)
    let cross = vec3d_cross(&v1, &v2)
    print("Cross product of (1,0,0) × (0,1,0): (")
    print_f64(cross.x)
    print(", ")
    print_f64(cross.y)
    print(", ")
    print_f64(cross.z)
    print(")\n")

    // Test lighting
    let normal = vec3d_new(0.0, 0.0, 1.0)
    let light = vec3d_new(0.0, 0.0, 1.0)
    let intensity = lambertian_shading(&normal, &light)
    print("Lambertian shading (normal facing light): ")
    print_f64(intensity)
    print("\n")

    return 0
}

// Helper function for printing f64
fn print_f64(x: f64) with IO {
    // Simple conversion - just print the value
    // Note: Sounio doesn't have built-in f64 -> string conversion yet
    // This is a placeholder that will print the raw value
    if x < 0.0 {
        print("-")
        print_f64_unsigned(0.0 - x)
    } else {
        print_f64_unsigned(x)
    }
}

fn print_f64_unsigned(x: f64) with IO, Div, Panic {
    // Convert to integer part
    let int_part = x as i32
    print_i32(int_part)

    // Print decimal point
    print(".")

    // Get fractional part
    let frac = x - (int_part as f64)
    let scaled = (frac * 1000.0) as i32

    // Print 3 decimal places
    if scaled < 100 {
        print("0")
    }
    if scaled < 10 {
        print("0")
    }
    print_i32(scaled)
}

fn print_i32(x: i32) with IO, Div, Panic {
    if x == 0 {
        print("0")
        return
    }

    if x < 0 {
        print("-")
        print_i32_unsigned(0 - x)
    } else {
        print_i32_unsigned(x)
    }
}

fn print_i32_unsigned(x: i32) with IO, Div, Panic {
    if x == 0 {
        return
    }

    let digit = x % 10
    let rest = x / 10

    if rest > 0 {
        print_i32_unsigned(rest)
    }

    // Print digit as character
    let ch = 48 + digit  // '0' is ASCII 48
    print_char(ch)
}

fn print_char(code: i32) with IO {
    // Use the character code directly
    // This is a workaround until we have proper char support
    if code == 48 { print("0") }
    else { if code == 49 { print("1") }
    else { if code == 50 { print("2") }
    else { if code == 51 { print("3") }
    else { if code == 52 { print("4") }
    else { if code == 53 { print("5") }
    else { if code == 54 { print("6") }
    else { if code == 55 { print("7") }
    else { if code == 56 { print("8") }
    else { if code == 57 { print("9") }
    else { print("?") }
    }}}}}}}}}}
}
