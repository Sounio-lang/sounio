// Scatter Plots - 2D point plotting with markers and colors
//
// Provides scatter plot functionality with customizable markers, colors,
// and support for plotting data points in world coordinates using viewports.

// ============================================================================
// Duplicate necessary types
// ============================================================================

struct Cell {
    ch: i32,
    fg_color: i32,
    bg_color: i32,
    bold: i32,
    dim: i32
}

struct Canvas {
    width: i32,
    height: i32,
    cells: [Cell; 2400]
}

struct Viewport {
    x_min: f64,
    x_max: f64,
    y_min: f64,
    y_max: f64,
    canvas_x: i32,
    canvas_y: i32,
    canvas_width: i32,
    canvas_height: i32
}

// ============================================================================
// Scatter Plot Data Structures
// ============================================================================

// Single scatter point with marker and color
struct ScatterPoint {
    x: f64,
    y: f64,
    marker: i32,    // Character code for marker (9679='○', 9608='█', etc.)
    color: i32      // ANSI color code (0-15)
}

// Create a scatter point
fn scatter_point_new(x: f64, y: f64, marker: i32, color: i32) -> ScatterPoint {
    return ScatterPoint {
        x: x,
        y: y,
        marker: marker,
        color: color
    }
}

// ============================================================================
// Coordinate Transformation (from 10_axes.sio)
// ============================================================================

fn world_to_canvas_x(vp: &Viewport, x: f64) -> i32 with Mut, Panic, Div {
    let x_range = vp.x_max - vp.x_min
    let normalized = (x - vp.x_min) / x_range
    let pixel_offset = normalized * (vp.canvas_width as f64)
    return vp.canvas_x + (pixel_offset as i32)
}

fn world_to_canvas_y(vp: &Viewport, y: f64) -> i32 with Mut, Panic, Div {
    let y_range = vp.y_max - vp.y_min
    let normalized = (y - vp.y_min) / y_range
    let pixel_offset = normalized * (vp.canvas_height as f64)

    // Flip Y axis (canvas Y increases downward, world Y increases upward)
    return vp.canvas_y + vp.canvas_height - (pixel_offset as i32)
}

// ============================================================================
// Canvas Operations
// ============================================================================

fn canvas_set_pixel(canvas: Canvas, x: i32, y: i32, ch: i32, color: i32) -> Canvas with Mut, Panic {
    if x < 0 { return canvas }
    if y < 0 { return canvas }
    if x >= canvas.width { return canvas }
    if y >= canvas.height { return canvas }

    var new_canvas = canvas
    let index = y * canvas.width + x
    new_canvas.cells[index] = Cell {
        ch: ch,
        fg_color: color,
        bg_color: 0,
        bold: 0,
        dim: 0
    }
    return new_canvas
}

// ============================================================================
// Scatter Plot Rendering
// ============================================================================

// Plot a single scatter point
fn plot_point(
    canvas: Canvas,
    vp: &Viewport,
    point: &ScatterPoint
) -> Canvas with Mut, Panic, Div {
    // Transform world coordinates to canvas pixels
    let px = world_to_canvas_x(vp, point.x)
    let py = world_to_canvas_y(vp, point.y)

    // Draw the marker
    return canvas_set_pixel(canvas, px, py, point.marker, point.color)
}

// Plot an array of scatter points
fn scatter_plot(
    canvas: Canvas,
    vp: &Viewport,
    points: &[ScatterPoint],
    n_points: i32
) -> Canvas with Mut, Panic, Div {
    var result = canvas

    var i = 0
    while i < n_points {
        result = plot_point(result, vp, &points[i])
        i = i + 1
    }

    return result
}

// Plot scatter with uniform marker and color
fn scatter_plot_uniform(
    canvas: Canvas,
    vp: &Viewport,
    x_data: &[f64],
    y_data: &[f64],
    n_points: i32,
    marker: i32,
    color: i32
) -> Canvas with Mut, Panic, Div {
    var result = canvas

    var i = 0
    while i < n_points {
        let px = world_to_canvas_x(vp, x_data[i])
        let py = world_to_canvas_y(vp, y_data[i])
        result = canvas_set_pixel(result, px, py, marker, color)
        i = i + 1
    }

    return result
}

// ============================================================================
// Common Markers
// ============================================================================

fn MARKER_DOT() -> i32 { return 9679 }      // ○
fn MARKER_FILLED() -> i32 { return 9608 }   // █
fn MARKER_CIRCLE() -> i32 { return 9675 }   // ◯
fn MARKER_SQUARE() -> i32 { return 9632 }   // ■
fn MARKER_DIAMOND() -> i32 { return 9670 }  // ◆
fn MARKER_STAR() -> i32 { return 9733 }     // ★
fn MARKER_PLUS() -> i32 { return 43 }       // +
fn MARKER_CROSS() -> i32 { return 120 }     // x

// ============================================================================
// Axes Drawing (from 10_axes.sio)
// ============================================================================

fn draw_hline(canvas: Canvas, x0: i32, x1: i32, y: i32, color: i32) -> Canvas with Mut, Panic, Div {
    var result = canvas
    let start_x = if x0 < x1 { x0 } else { x1 }
    let end_x = if x0 < x1 { x1 } else { x0 }

    var x = start_x
    while x <= end_x {
        result = canvas_set_pixel(result, x, y, 9608, color)
        x = x + 1
    }

    return result
}

fn draw_vline(canvas: Canvas, x: i32, y0: i32, y1: i32, color: i32) -> Canvas with Mut, Panic, Div {
    var result = canvas
    let start_y = if y0 < y1 { y0 } else { y1 }
    let end_y = if y0 < y1 { y1 } else { y0 }

    var y = start_y
    while y <= end_y {
        result = canvas_set_pixel(result, x, y, 9608, color)
        y = y + 1
    }

    return result
}

fn draw_axes(canvas: Canvas, vp: &Viewport, color: i32) -> Canvas with Mut, Panic, Div {
    var result = canvas

    // Find pixel coordinates for origin (0, 0)
    let origin_x = world_to_canvas_x(vp, 0.0)
    let origin_y = world_to_canvas_y(vp, 0.0)

    // Draw Y axis (vertical line at x=0)
    if origin_x >= vp.canvas_x && origin_x < vp.canvas_x + vp.canvas_width {
        result = draw_vline(result, origin_x, vp.canvas_y, vp.canvas_y + vp.canvas_height - 1, color)
    }

    // Draw X axis (horizontal line at y=0)
    if origin_y >= vp.canvas_y && origin_y < vp.canvas_y + vp.canvas_height {
        result = draw_hline(result, vp.canvas_x, vp.canvas_x + vp.canvas_width - 1, origin_y, color)
    }

    return result
}

fn draw_grid(canvas: Canvas, vp: &Viewport, n_x_lines: i32, n_y_lines: i32, color: i32) -> Canvas with Mut, Panic, Div {
    var result = canvas

    // Vertical grid lines
    var i = 0
    while i <= n_x_lines {
        let fraction = (i as f64) / (n_x_lines as f64)
        let world_x = vp.x_min + fraction * (vp.x_max - vp.x_min)
        let pixel_x = world_to_canvas_x(vp, world_x)

        result = draw_vline(result, pixel_x, vp.canvas_y, vp.canvas_y + vp.canvas_height - 1, color)
        i = i + 1
    }

    // Horizontal grid lines
    i = 0
    while i <= n_y_lines {
        let fraction = (i as f64) / (n_y_lines as f64)
        let world_y = vp.y_min + fraction * (vp.y_max - vp.y_min)
        let pixel_y = world_to_canvas_y(vp, world_y)

        result = draw_hline(result, vp.canvas_x, vp.canvas_x + vp.canvas_width - 1, pixel_y, color)
        i = i + 1
    }

    return result
}

// ============================================================================
// Viewport Creation
// ============================================================================

fn viewport_new(
    x_min: f64,
    x_max: f64,
    y_min: f64,
    y_max: f64,
    canvas_x: i32,
    canvas_y: i32,
    canvas_width: i32,
    canvas_height: i32
) -> Viewport {
    return Viewport {
        x_min: x_min,
        x_max: x_max,
        y_min: y_min,
        y_max: y_max,
        canvas_x: canvas_x,
        canvas_y: canvas_y,
        canvas_width: canvas_width,
        canvas_height: canvas_height
    }
}

// ============================================================================
// Test/Demo
// ============================================================================

fn cell_blank() -> Cell {
    return Cell {
        ch: 32,
        fg_color: 7,
        bg_color: 0,
        bold: 0,
        dim: 0
    }
}

fn canvas_new(width: i32, height: i32) -> Canvas with Mut, Panic, Div {
    var canvas = Canvas {
        width: width,
        height: height,
        cells: [cell_blank(); 2400]
    }

    var i = 0
    while i < width * height {
        canvas.cells[i] = cell_blank()
        i = i + 1
    }

    return canvas
}

fn COLOR_WHITE() -> i32 { return 7 }
fn COLOR_BRIGHT_BLACK() -> i32 { return 8 }
fn COLOR_RED() -> i32 { return 1 }
fn COLOR_GREEN() -> i32 { return 2 }
fn COLOR_BLUE() -> i32 { return 4 }
fn COLOR_YELLOW() -> i32 { return 3 }
fn COLOR_CYAN() -> i32 { return 6 }

fn main() -> i32 with IO, Mut, Panic, Div {
    print("=== Sounio Scatter Plot Demo ===\n\n")

    // Create canvas
    var canvas = canvas_new(70, 30)

    // Create viewport: [-10, 10] x [-10, 10]
    let vp = viewport_new(
        -10.0, 10.0,
        -10.0, 10.0,
        5, 2,
        60, 26
    )

    // Draw grid and axes
    print("Drawing grid and axes...\n")
    canvas = draw_grid(canvas, &vp, 4, 4, COLOR_BRIGHT_BLACK())
    canvas = draw_axes(canvas, &vp, COLOR_WHITE())

    // Test 1: Scatter plot with uniform marker
    print("Plotting uniform scatter (sine wave)...\n")
    var x_data = [-8.0, -6.0, -4.0, -2.0, 0.0, 2.0, 4.0, 6.0, 8.0, -1.0]
    var y_data = [-7.0, -3.0, 2.0, 7.0, 8.0, 7.0, 2.0, -3.0, -7.0, 5.0]

    canvas = scatter_plot_uniform(
        canvas,
        &vp,
        &x_data,
        &y_data,
        10,
        MARKER_DOT(),
        COLOR_CYAN()
    )

    // Test 2: Individual points with different markers and colors
    print("Plotting individual points with custom markers...\n")

    var points = [
        scatter_point_new(5.0, 5.0, MARKER_STAR(), COLOR_YELLOW()),
        scatter_point_new(-5.0, 5.0, MARKER_DIAMOND(), COLOR_RED()),
        scatter_point_new(-5.0, -5.0, MARKER_SQUARE(), COLOR_GREEN()),
        scatter_point_new(5.0, -5.0, MARKER_FILLED(), COLOR_BLUE()),
        scatter_point_new(0.0, 0.0, MARKER_PLUS(), COLOR_WHITE()),
        scatter_point_new(3.0, 7.0, MARKER_CROSS(), COLOR_CYAN()),
        scatter_point_new(0.0, 0.0, MARKER_DOT(), COLOR_RED()),
        scatter_point_new(0.0, 0.0, MARKER_DOT(), COLOR_RED()),
        scatter_point_new(0.0, 0.0, MARKER_DOT(), COLOR_RED()),
        scatter_point_new(0.0, 0.0, MARKER_DOT(), COLOR_RED())
    ]

    canvas = scatter_plot(canvas, &vp, &points, 6)

    print("\n=== Scatter plot rendering complete! ===\n")
    print("Plotted 10 sine wave points + 6 custom markers\n")
    print("(Canvas created but not rendered)\n")

    return 0
}
