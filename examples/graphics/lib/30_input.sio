// Example/Test Function
// ============================================================================

fn main() -> i32 with IO, Mut {
    print("=== Terminal Input Module Test ===\n\n")

    // Create input state
    var state = input_state_new()

    print("Mouse tracking control:\n")
    print("  • enable_mouse_tracking() - Enable ANSI mouse events\n")
    print("  • disable_mouse_tracking() - Disable mouse tracking\n")
    print("  • enable_raw_mode() - Raw terminal mode\n")
    print("  • disable_raw_mode() - Normal terminal mode\n\n")

    print("Event structures:\n")
    print("  • MouseEvent: type, button, x, y, modifiers\n")
    print("  • KeyEvent: key_code, modifiers, is_char\n\n")

    print("Event polling (simplified interface):\n")
    print("  • poll_mouse_event() - Returns MouseEvent or none\n")
    print("  • poll_key_event() - Returns KeyEvent or none\n\n")

    print("Simulated events for testing:\n")
    let click = simulate_mouse_click(10, 5, BUTTON_LEFT())
    print("  • Click at (10, 5): x=")
    print_i32(click.x)
    print(", y=")
    print_i32(click.y)
    print("\n")

    let scroll = simulate_scroll(20, 10, 1)
    print("  • Scroll up at (20, 10): type=")
    print_i32(scroll.event_type)
    print("\n\n")

    print("NOTE: Full mouse/keyboard input requires raw terminal mode\n")
    print("      and escape sequence parsing (future enhancement).\n")

    return 0
}

// Helper function for printing integers
fn print_i32(x: i32) with IO, Div, Panic {
    if x == 0 {
        print("0")
        return
    }

    if x < 0 {
        print("-")
        print_i32_unsigned(0 - x)
    } else {
        print_i32_unsigned(x)
    }
}

fn print_i32_unsigned(x: i32) with IO, Div, Panic {
    if x == 0 {
        return
    }

    let digit = x % 10
    let rest = x / 10

    if rest > 0 {
        print_i32_unsigned(rest)
    }

    // Print digit
    let ch = 48 + digit  // '0' is ASCII 48
    print_char(ch)
}

fn print_char(code: i32) with IO {
    if code == 48 { print("0") }
    else { if code == 49 { print("1") }
    else { if code == 50 { print("2") }
    else { if code == 51 { print("3") }
    else { if code == 52 { print("4") }
    else { if code == 53 { print("5") }
    else { if code == 54 { print("6") }
    else { if code == 55 { print("7") }
    else { if code == 56 { print("8") }
    else { if code == 57 { print("9") }
    else { print("?") }
    }}}}}}}}}}
}
