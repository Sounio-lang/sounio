// 30_input.sio - Terminal input handling (mouse and keyboard)
//
// Provides terminal input event handling for interactive graphics.
// Uses ANSI escape sequences for mouse tracking and keyboard events.
//
// IMPORTANT: This module requires raw terminal mode for full functionality.
// The current implementation provides a simplified interface that works
// within Sounio's current I/O capabilities.

import "stdlib/math/core.sio"

// ============================================================================
// Event Types
// ============================================================================

// Mouse event types
fn MOUSE_PRESS() -> i32 { return 0 }
fn MOUSE_RELEASE() -> i32 { return 1 }
fn MOUSE_MOVE() -> i32 { return 2 }
fn MOUSE_DRAG() -> i32 { return 3 }
fn MOUSE_SCROLL_UP() -> i32 { return 4 }
fn MOUSE_SCROLL_DOWN() -> i32 { return 5 }

// Mouse buttons
fn BUTTON_LEFT() -> i32 { return 0 }
fn BUTTON_RIGHT() -> i32 { return 1 }
fn BUTTON_MIDDLE() -> i32 { return 2 }

// Keyboard modifiers
fn MOD_NONE() -> i32 { return 0 }
fn MOD_SHIFT() -> i32 { return 1 }
fn MOD_CTRL() -> i32 { return 2 }
fn MOD_ALT() -> i32 { return 4 }
fn MOD_META() -> i32 { return 8 }

// Special keys
fn KEY_ESCAPE() -> i32 { return 27 }
fn KEY_ENTER() -> i32 { return 13 }
fn KEY_TAB() -> i32 { return 9 }
fn KEY_BACKSPACE() -> i32 { return 8 }
fn KEY_SPACE() -> i32 { return 32 }
fn KEY_UP() -> i32 { return 1000 }
fn KEY_DOWN() -> i32 { return 1001 }
fn KEY_LEFT() -> i32 { return 1002 }
fn KEY_RIGHT() -> i32 { return 1003 }

// ============================================================================
// Event Structures
// ============================================================================

struct MouseEvent {
    event_type: i32,  // MOUSE_PRESS, MOUSE_RELEASE, etc.
    button: i32,      // BUTTON_LEFT, BUTTON_RIGHT, BUTTON_MIDDLE
    x: i32,           // Column (0-based)
    y: i32,           // Row (0-based)
    modifiers: i32    // MOD_SHIFT | MOD_CTRL | etc.
}

fn mouse_event_new(event_type: i32, button: i32, x: i32, y: i32, modifiers: i32) -> MouseEvent {
    return MouseEvent {
        event_type: event_type,
        button: button,
        x: x,
        y: y,
        modifiers: modifiers
    }
}

fn mouse_event_none() -> MouseEvent {
    return mouse_event_new(0, 0, 0, 0, 0)
}

struct KeyEvent {
    key_code: i32,    // ASCII code or KEY_* constant
    modifiers: i32,   // MOD_SHIFT | MOD_CTRL | etc.
    is_char: i32      // 1 if printable character, 0 if special key
}

fn key_event_new(key_code: i32, modifiers: i32, is_char: i32) -> KeyEvent {
    return KeyEvent {
        key_code: key_code,
        modifiers: modifiers,
        is_char: is_char
    }
}

fn key_event_none() -> KeyEvent {
    return key_event_new(0, 0, 0)
}

// ============================================================================
// Mouse Tracking Control
// ============================================================================

// Enable mouse tracking in terminal
// Sends ANSI escape sequences to enable mouse reporting
fn enable_mouse_tracking() with IO {
    // Enable mouse button press/release tracking (X10 mode)
    print("\x1b[?1000h")

    // Enable mouse motion tracking
    print("\x1b[?1002h")

    // Enable SGR extended mouse mode (better coordinate reporting)
    print("\x1b[?1006h")

    // Enable alternate scroll mode
    print("\x1b[?1015h")
}

// Disable mouse tracking
fn disable_mouse_tracking() with IO {
    print("\x1b[?1000l")
    print("\x1b[?1002l")
    print("\x1b[?1006l")
    print("\x1b[?1015l")
}

// Enable raw mode (no line buffering, no echo)
// NOTE: This is a simplified version using ANSI codes
// Full implementation would require FFI to termios
fn enable_raw_mode() with IO {
    // Disable line buffering and echo
    print("\x1b[?25l")  // Hide cursor
    print("\x1b[?7l")   // Disable line wrapping
}

// Disable raw mode
fn disable_raw_mode() with IO {
    print("\x1b[?25h")  // Show cursor
    print("\x1b[?7h")   // Enable line wrapping
}

// ============================================================================
// Input State Management
// ============================================================================

struct InputState {
    mouse_enabled: i32,
    raw_mode: i32,
    last_mouse_x: i32,
    last_mouse_y: i32,
    last_button: i32,
    button_pressed: i32  // 1 if button currently pressed, 0 otherwise
}

fn input_state_new() -> InputState {
    return InputState {
        mouse_enabled: 0,
        raw_mode: 0,
        last_mouse_x: 0,
        last_mouse_y: 0,
        last_button: 0,
        button_pressed: 0
    }
}

fn input_init(state: &!InputState) with IO, Mut {
    enable_mouse_tracking()
    enable_raw_mode()
    state.mouse_enabled = 1
    state.raw_mode = 1
}

fn input_cleanup(state: &!InputState) with IO, Mut {
    if state.mouse_enabled == 1 {
        disable_mouse_tracking()
        state.mouse_enabled = 0
    }
    if state.raw_mode == 1 {
        disable_raw_mode()
        state.raw_mode = 0
    }
}

