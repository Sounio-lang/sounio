// Color Management - ANSI 16-color palette with semantic mappings
//
// Provides standard ANSI color constants and helper functions for
// semantic color selection (uncertainty levels, temperature gradients, etc.)

// ============================================================================
// Standard ANSI 16-color palette (color codes 0-15)
// ============================================================================

// Normal colors (0-7)
fn COLOR_BLACK() -> i32 { return 0 }
fn COLOR_RED() -> i32 { return 1 }
fn COLOR_GREEN() -> i32 { return 2 }
fn COLOR_YELLOW() -> i32 { return 3 }
fn COLOR_BLUE() -> i32 { return 4 }
fn COLOR_MAGENTA() -> i32 { return 5 }
fn COLOR_CYAN() -> i32 { return 6 }
fn COLOR_WHITE() -> i32 { return 7 }

// Bright colors (8-15)
fn COLOR_BRIGHT_BLACK() -> i32 { return 8 }   // Gray
fn COLOR_BRIGHT_RED() -> i32 { return 9 }
fn COLOR_BRIGHT_GREEN() -> i32 { return 10 }
fn COLOR_BRIGHT_YELLOW() -> i32 { return 11 }
fn COLOR_BRIGHT_BLUE() -> i32 { return 12 }
fn COLOR_BRIGHT_MAGENTA() -> i32 { return 13 }
fn COLOR_BRIGHT_CYAN() -> i32 { return 14 }
fn COLOR_BRIGHT_WHITE() -> i32 { return 15 }

// ============================================================================
// Semantic color mappings for scientific visualization
// ============================================================================

// Map uncertainty level (0.0-1.0) to traffic light colors
// 0.0-0.3: Green (high confidence)
// 0.3-0.6: Yellow (medium confidence)
// 0.6-1.0: Red (low confidence)
fn uncertainty_to_color(normalized: f64) -> i32 {
    if normalized < 0.3 {
        return COLOR_GREEN()
    }
    if normalized < 0.6 {
        return COLOR_YELLOW()
    }
    return COLOR_RED()
}

// Map temperature value to heat map colors
// Uses blue → cyan → green → yellow → red gradient
fn temperature_to_color(temp: f64, min_temp: f64, max_temp: f64) -> i32 with Mut, Panic, Div {
    // Normalize to 0.0-1.0 range
    var normalized = (temp - min_temp) / (max_temp - min_temp)

    // Clamp to 0-1
    if normalized < 0.0 { normalized = 0.0 }
    if normalized > 1.0 { normalized = 1.0 }

    // Map to 5-step gradient
    if normalized < 0.2 {
        return COLOR_BLUE()       // Coldest
    }
    if normalized < 0.4 {
        return COLOR_CYAN()       // Cold
    }
    if normalized < 0.6 {
        return COLOR_GREEN()      // Medium
    }
    if normalized < 0.8 {
        return COLOR_YELLOW()     // Hot
    }
    return COLOR_RED()            // Hottest
}

// Map value to grayscale (black → white)
fn value_to_grayscale(value: f64, min_val: f64, max_val: f64) -> i32 with Mut, Panic, Div {
    // Normalize to 0.0-1.0
    var normalized = (value - min_val) / (max_val - min_val)

    // Clamp
    if normalized < 0.0 { normalized = 0.0 }
    if normalized > 1.0 { normalized = 1.0 }

    // Map to 4-step grayscale (black → gray → white → bright white)
    if normalized < 0.25 {
        return COLOR_BLACK()
    }
    if normalized < 0.5 {
        return COLOR_BRIGHT_BLACK()  // Gray
    }
    if normalized < 0.75 {
        return COLOR_WHITE()
    }
    return COLOR_BRIGHT_WHITE()
}

// Categorical colors for distinct data series (up to 8 series)
fn category_color(index: i32) -> i32 with Panic {
    let color_idx = index % 8  // Wrap around for >8 categories

    if color_idx == 0 { return COLOR_RED() }
    if color_idx == 1 { return COLOR_GREEN() }
    if color_idx == 2 { return COLOR_BLUE() }
    if color_idx == 3 { return COLOR_YELLOW() }
    if color_idx == 4 { return COLOR_MAGENTA() }
    if color_idx == 5 { return COLOR_CYAN() }
    if color_idx == 6 { return COLOR_WHITE() }
    return COLOR_BRIGHT_WHITE()
}

// Phase-coded colors for time series (absorption → distribution → elimination)
fn phase_color(phase_idx: i32) -> i32 {
    if phase_idx == 0 { return COLOR_GREEN() }   // Early phase
    if phase_idx == 1 { return COLOR_YELLOW() }  // Middle phase
    if phase_idx == 2 { return COLOR_RED() }     // Late phase
    return COLOR_WHITE()  // Unknown phase
}

// Status colors for pass/fail/warning indicators
fn status_pass_color() -> i32 { return COLOR_GREEN() }
fn status_fail_color() -> i32 { return COLOR_RED() }
fn status_warning_color() -> i32 { return COLOR_YELLOW() }
fn status_info_color() -> i32 { return COLOR_BLUE() }

// Scientific domain color schemes
fn octonion_basis_color(basis_idx: i32) -> i32 {
    // Color map for octonion basis elements (0-7)
    if basis_idx == 0 { return COLOR_WHITE() }    // Real part
    if basis_idx == 1 { return COLOR_RED() }      // i
    if basis_idx == 2 { return COLOR_GREEN() }    // j
    if basis_idx == 3 { return COLOR_BLUE() }     // k
    if basis_idx == 4 { return COLOR_YELLOW() }   // l
    if basis_idx == 5 { return COLOR_MAGENTA() }  // il
    if basis_idx == 6 { return COLOR_CYAN() }     // jl
    return COLOR_BRIGHT_WHITE()                   // kl
}

// Epidemic model compartments
fn sir_susceptible_color() -> i32 { return COLOR_BLUE() }
fn sir_infectious_color() -> i32 { return COLOR_RED() }
fn sir_recovered_color() -> i32 { return COLOR_GREEN() }

// ============================================================================
// Intensity/brightness modulation
// ============================================================================

// Get bright version of a normal color (0-7 → 8-15)
fn color_brighten(color: i32) -> i32 {
    if color >= 0 && color < 8 {
        return color + 8
    }
    return color  // Already bright or out of range
}

// Get normal version of a bright color (8-15 → 0-7)
fn color_dim(color: i32) -> i32 {
    if color >= 8 && color < 16 {
        return color - 8
    }
    return color  // Already normal or out of range
}

// ============================================================================
// Color blending/mixing (discrete approximation)
// ============================================================================

// Mix two colors (simple nearest-neighbor approximation)
// Returns the color closer to the midpoint
fn color_mix(color1: i32, color2: i32) -> i32 with Panic, Div {
    // Simple heuristic: if both are bright or both normal, average
    // Otherwise return the brighter one

    let both_bright = (color1 >= 8 && color2 >= 8)
    let both_normal = (color1 < 8 && color2 < 8)

    if both_bright || both_normal {
        // Average and clamp to valid range
        let avg = (color1 + color2) / 2
        if avg < 0 { return 0 }
        if avg > 15 { return 15 }
        return avg
    }

    // Return the brighter one
    if color1 >= 8 { return color1 }
    return color2
}

// ============================================================================
// Color name lookup (for display/debugging)
// ============================================================================

// Get human-readable color name
fn color_name(color: i32) -> i32 {
    // Returns a code representing the name (could be extended to return strings)
    // For now, just return the color code itself
    // TODO: When string manipulation is available, return actual names
    return color
}

// ============================================================================
// Test/demo function
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    print("=== Sounio Color Management Demo ===\n\n")

    print("Standard ANSI colors (0-15):\n")
    print("  BLACK=")
    let black = COLOR_BLACK()
    if black == 0 { print("0 ") }

    print("RED=")
    let red = COLOR_RED()
    if red == 1 { print("1 ") }

    print("GREEN=")
    let green = COLOR_GREEN()
    if green == 2 { print("2 ") }

    print("BLUE=")
    let blue = COLOR_BLUE()
    if blue == 4 { print("4\n") }

    print("\nSemantic mappings:\n")

    print("  Uncertainty 0.2 → color ")
    let unc_low = uncertainty_to_color(0.2)
    if unc_low == 2 { print("2 (GREEN)\n") }

    print("  Uncertainty 0.5 → color ")
    let unc_med = uncertainty_to_color(0.5)
    if unc_med == 3 { print("3 (YELLOW)\n") }

    print("  Uncertainty 0.8 → color ")
    let unc_high = uncertainty_to_color(0.8)
    if unc_high == 1 { print("1 (RED)\n") }

    print("\nTemperature gradient (0-100):\n")
    print("  Temp 10 → color ")
    let temp_cold = temperature_to_color(10.0, 0.0, 100.0)
    if temp_cold == 4 { print("4 (BLUE)\n") }

    print("  Temp 50 → color ")
    let temp_mid = temperature_to_color(50.0, 0.0, 100.0)
    if temp_mid == 2 { print("2 (GREEN)\n") }

    print("  Temp 90 → color ")
    let temp_hot = temperature_to_color(90.0, 0.0, 100.0)
    if temp_hot == 1 { print("1 (RED)\n") }

    print("\nCategorical colors:\n")
    print("  Category 0 → color ")
    let cat0 = category_color(0)
    if cat0 == 1 { print("1 (RED)\n") }

    print("  Category 1 → color ")
    let cat1 = category_color(1)
    if cat1 == 2 { print("2 (GREEN)\n") }

    print("  Category 2 → color ")
    let cat2 = category_color(2)
    if cat2 == 4 { print("4 (BLUE)\n") }

    print("\nColor modulation:\n")
    print("  Brighten RED(1) → ")
    let bright_red = color_brighten(1)
    if bright_red == 9 { print("9 (BRIGHT_RED)\n") }

    print("  Dim BRIGHT_GREEN(10) → ")
    let dim_green = color_dim(10)
    if dim_green == 2 { print("2 (GREEN)\n") }

    print("\nOctonion basis colors:\n")
    print("  Basis 0 (real) → ")
    let oct0 = octonion_basis_color(0)
    if oct0 == 7 { print("7 (WHITE)\n") }

    print("  Basis 1 (i) → ")
    let oct1 = octonion_basis_color(1)
    if oct1 == 1 { print("1 (RED)\n") }

    print("\n=== All tests passed! ===\n")

    return 0
}
