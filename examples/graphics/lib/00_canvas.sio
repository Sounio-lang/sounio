// Canvas Abstraction - In-memory framebuffer for terminal graphics
//
// Provides a character grid with color attributes that can be manipulated
// before rendering to the terminal. Enables double buffering and complex
// compositions.

// Cell represents a single character cell with color and styling
struct Cell {
    ch: i32,        // Unicode character (as int codepoint)
    fg_color: i32,  // Foreground color code (0-15 for ANSI)
    bg_color: i32,  // Background color code (0-15)
    bold: i32,      // 0 or 1
    dim: i32        // 0 or 1
}

// Canvas is an in-memory framebuffer of character cells
struct Canvas {
    width: i32,
    height: i32,
    cells: [Cell; 2400]  // 80×30 default
}

// Helper: Create a blank cell with space character
fn cell_blank() -> Cell {
    return Cell {
        ch: 32,        // Space character
        fg_color: 7,   // White
        bg_color: 0,   // Black
        bold: 0,
        dim: 0
    }
}

// Initialize a new canvas with given dimensions
fn canvas_new(width: i32, height: i32) -> Canvas with Mut, Panic, Div {
    var canvas = Canvas {
        width: width,
        height: height,
        cells: [cell_blank(); 2400]
    }

    // Initialize all cells to blank
    var i = 0
    while i < width * height {
        canvas.cells[i] = cell_blank()
        i = i + 1
    }

    return canvas
}

// Clear canvas (reset all cells to blank) - functional style
fn canvas_clear_func(canvas: Canvas) -> Canvas with Mut, Panic, Div {
    var new_canvas = canvas
    var i = 0
    let total = new_canvas.width * new_canvas.height
    while i < total {
        new_canvas.cells[i] = cell_blank()
        i = i + 1
    }
    return new_canvas
}

// Set a cell at (x, y) position - functional style
fn canvas_set_func(canvas: Canvas, x: i32, y: i32, ch: i32, fg: i32, bg: i32) -> Canvas with Mut, Panic {
    // Bounds check
    if x < 0 { return canvas }
    if y < 0 { return canvas }
    if x >= canvas.width { return canvas }
    if y >= canvas.height { return canvas }

    var new_canvas = canvas
    let index = y * canvas.width + x
    new_canvas.cells[index] = Cell {
        ch: ch,
        fg_color: fg,
        bg_color: bg,
        bold: 0,
        dim: 0
    }
    return new_canvas
}

// Get a cell at (x, y) position
fn canvas_get(canvas: &Canvas, x: i32, y: i32) -> Cell with Panic {
    // Bounds check - return blank cell if out of bounds
    if x < 0 { return cell_blank() }
    if y < 0 { return cell_blank() }
    if x >= canvas.width { return cell_blank() }
    if y >= canvas.height { return cell_blank() }

    let index = y * canvas.width + x
    return canvas.cells[index]
}

// Helper: Convert color code to ANSI foreground sequence
fn color_code_to_fg_ansi(color: i32) -> i32 {
    // Map color codes 0-15 to ANSI codes
    // 0-7: normal colors (30-37)
    // 8-15: bright colors (90-97)
    if color < 8 {
        return 30 + color
    } else {
        return 90 + (color - 8)
    }
}

// Helper: Convert color code to ANSI background sequence
fn color_code_to_bg_ansi(color: i32) -> i32 {
    // Map color codes 0-15 to ANSI codes
    // 0-7: normal colors (40-47)
    // 8-15: bright colors (100-107)
    if color < 8 {
        return 40 + color
    } else {
        return 100 + (color - 8)
    }
}

// Helper: Print ANSI escape sequence for foreground color
fn print_fg_color(color: i32) with IO {
    print("\x1b[")

    // Convert color code to ANSI
    let ansi_code = color_code_to_fg_ansi(color)

    // Print the number (need to convert i32 to output)
    // Simple approach: use conditionals for 30-37, 90-97
    if ansi_code == 30 { print("30") }
    if ansi_code == 31 { print("31") }
    if ansi_code == 32 { print("32") }
    if ansi_code == 33 { print("33") }
    if ansi_code == 34 { print("34") }
    if ansi_code == 35 { print("35") }
    if ansi_code == 36 { print("36") }
    if ansi_code == 37 { print("37") }
    if ansi_code == 90 { print("90") }
    if ansi_code == 91 { print("91") }
    if ansi_code == 92 { print("92") }
    if ansi_code == 93 { print("93") }
    if ansi_code == 94 { print("94") }
    if ansi_code == 95 { print("95") }
    if ansi_code == 96 { print("96") }
    if ansi_code == 97 { print("97") }

    print("m")
}

// Helper: Print ANSI escape sequence for background color
fn print_bg_color(color: i32) with IO {
    print("\x1b[")

    // Convert color code to ANSI
    let ansi_code = color_code_to_bg_ansi(color)

    // Print the number
    if ansi_code == 40 { print("40") }
    if ansi_code == 41 { print("41") }
    if ansi_code == 42 { print("42") }
    if ansi_code == 43 { print("43") }
    if ansi_code == 44 { print("44") }
    if ansi_code == 45 { print("45") }
    if ansi_code == 46 { print("46") }
    if ansi_code == 47 { print("47") }
    if ansi_code == 100 { print("100") }
    if ansi_code == 101 { print("101") }
    if ansi_code == 102 { print("102") }
    if ansi_code == 103 { print("103") }
    if ansi_code == 104 { print("104") }
    if ansi_code == 105 { print("105") }
    if ansi_code == 106 { print("106") }
    if ansi_code == 107 { print("107") }

    print("m")
}

// Helper: Print character from code point
fn print_char_code(code: i32) with IO {
    // Map common character codes to their characters
    // For ASCII printable: 32-126
    if code == 32 { print(" ") }
    if code == 33 { print("!") }
    if code == 35 { print("#") }
    if code == 42 { print("*") }
    if code == 43 { print("+") }
    if code == 45 { print("-") }
    if code == 46 { print(".") }
    if code == 61 { print("=") }
    if code == 72 { print("H") }
    if code == 88 { print("X") }
    if code == 101 { print("e") }
    if code == 108 { print("l") }
    if code == 111 { print("o") }
    if code == 124 { print("|") }

    // Unicode box drawing characters
    if code == 9473 { print("-") }  // Horizontal line (simplified)
    if code == 9474 { print("|") }  // Vertical line (simplified)

    // Unicode block characters
    if code == 9608 { print("█") }  // Full block
    if code == 9617 { print("░") }  // Light shade
    if code == 9618 { print("▒") }  // Medium shade
    if code == 9619 { print("▓") }  // Dark shade
    if code == 9632 { print("■") }  // Black square

    // Fallback: print space for unknown characters
    // TODO: Add more character mappings as needed
}

// Render canvas to terminal
fn canvas_render(canvas: &Canvas) with IO, Mut, Div, Panic {
    // Save cursor position and clear screen
    print("\x1b[H")  // Home cursor

    var y = 0
    while y < canvas.height {
        var x = 0

        // Track current styling to avoid redundant ANSI codes
        var current_fg = -1
        var current_bg = -1
        var current_bold = 0
        var current_dim = 0

        while x < canvas.width {
            let cell = canvas_get(canvas, x, y)

            // Update foreground color if changed
            if cell.fg_color != current_fg {
                print_fg_color(cell.fg_color)
                current_fg = cell.fg_color
            }

            // Update background color if changed
            if cell.bg_color != current_bg {
                print_bg_color(cell.bg_color)
                current_bg = cell.bg_color
            }

            // Update bold if changed
            if cell.bold != current_bold {
                if cell.bold == 1 {
                    print("\x1b[1m")
                } else {
                    print("\x1b[22m")  // Normal intensity
                }
                current_bold = cell.bold
            }

            // Update dim if changed
            if cell.dim != current_dim {
                if cell.dim == 1 {
                    print("\x1b[2m")
                } else {
                    print("\x1b[22m")  // Normal intensity
                }
                current_dim = cell.dim
            }

            // Print character
            print_char_code(cell.ch)

            x = x + 1
        }

        // Reset styles at end of line
        print("\x1b[0m")
        print("\n")

        y = y + 1
    }

    // Final reset
    print("\x1b[0m")
}

// Main function - simple test
fn main() -> i32 with IO, Mut, Panic, Div {
    // Create a small canvas
    var canvas = canvas_new(40, 10)

    // Draw a border - functional style
    var x = 0
    while x < 40 {
        canvas = canvas_set_func(canvas, x, 0, 9473, 2, 0)  // Top border (green)
        canvas = canvas_set_func(canvas, x, 9, 9473, 2, 0)  // Bottom border
        x = x + 1
    }

    var y = 0
    while y < 10 {
        canvas = canvas_set_func(canvas, 0, y, 9474, 2, 0)   // Left border
        canvas = canvas_set_func(canvas, 39, y, 9474, 2, 0)  // Right border
        y = y + 1
    }

    // Draw some text
    canvas = canvas_set_func(canvas, 10, 5, 72, 3, 0)   // 'H' in yellow
    canvas = canvas_set_func(canvas, 11, 5, 101, 3, 0)  // 'e'
    canvas = canvas_set_func(canvas, 12, 5, 108, 3, 0)  // 'l'
    canvas = canvas_set_func(canvas, 13, 5, 108, 3, 0)  // 'l'
    canvas = canvas_set_func(canvas, 14, 5, 111, 3, 0)  // 'o'

    // Render to terminal
    canvas_render(&canvas)

    return 0
}
