// Simplified canvas test to debug borrow checker

struct Cell {
    ch: i32,
    fg_color: i32
}

struct Canvas {
    width: i32,
    cells: [Cell; 10]
}

fn cell_blank() -> Cell {
    return Cell {
        ch: 32,
        fg_color: 7
    }
}

fn canvas_new() -> Canvas {
    return Canvas {
        width: 10,
        cells: [cell_blank(); 10]
    }
}

fn canvas_set(canvas: &!Canvas, index: i32, ch: i32) with Mut, Panic {
    canvas.cells[index] = Cell {
        ch: ch,
        fg_color: 7
    }
}

fn main() -> i32 with Mut, Panic {
    var canvas = canvas_new()

    {
        canvas_set(&!canvas, 0, 65)  // 'A'
    }
    {
        canvas_set(&!canvas, 1, 66)  // 'B'
    }
    {
        canvas_set(&!canvas, 2, 67)  // 'C'
    }

    return 0
}
