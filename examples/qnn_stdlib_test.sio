//! Test QNN with stdlib imports

use std::qnn

fn main() {
    let input_dim: i32 = 4
    let hidden_dim: i32 = 8
    let output_dim: i32 = 2

    // Create layers using stdlib functions
    let layer1 = qnn::quat_linear_new(input_dim, hidden_dim)
    let w1 = qnn::quat_xavier_init(input_dim, hidden_dim, 42)
    let b1 = qnn::quat_xavier_init(1, hidden_dim, 43)

    let layer2 = qnn::quat_linear_new(hidden_dim, output_dim)
    let w2 = qnn::quat_xavier_init(hidden_dim, output_dim, 44)
    let b2 = qnn::quat_xavier_init(1, output_dim, 45)

    // Sample input (batch of 1 with 4 quaternion features)
    var input_data: [Quat]
    let i: i32 = 0
    while i < 4 {
        input_data[i] = quat(0.1, 0.2, 0.3, 0.4)
        i = i + 1
    }

    // Forward pass layer 1
    let hidden = qnn::quat_linear_forward(&layer1, &w1, &input_data, &b1)

    // ReLU activation
    var activated: [Quat]
    qnn::quat_relu_batch(&hidden, &!activated)

    // Forward pass layer 2
    let output = qnn::quat_linear_forward(&layer2, &w2, &activated, &b2)

    // Target (dummy)
    var target: [Quat]
    let j: i32 = 0
    while j < output_dim {
        target[j] = quat(1.0, 0.0, 0.0, 0.0)
        j = j + 1
    }

    // Loss
    let loss = qnn::quat_mse_loss(&output, &target)
}
