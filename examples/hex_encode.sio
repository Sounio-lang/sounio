//@ run-pass
// Hex encoding: bytes to hex string representation

fn nibble_to_hex(n: u8) -> u8 {
    let nibble = n & (15 as u8)
    if nibble < (10 as u8) {
        (48 as u8) + nibble
    } else {
        (87 as u8) + nibble
    }
}

fn hex_encode(input: &[u8; 256], in_len: i32, out: &![u8; 512]) -> i32 with Mut, Div, Panic {
    if in_len < 0 || in_len > 256 { return 0 - 1 }
    var i: i32 = 0
    while i < in_len {
        let byte = input[i as usize]
        out[(i * 2) as usize] = nibble_to_hex(byte >> (4 as u8))
        out[(i * 2 + 1) as usize] = nibble_to_hex(byte)
        i = i + 1
    }
    in_len * 2
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var input: [u8; 256] = [0; 256]
    var output: [u8; 512] = [0; 512]
    input[0] = (222 as u8)
    input[1] = (173 as u8)
    input[2] = (190 as u8)
    input[3] = (239 as u8)

    let n = hex_encode(&input, 4, &! output)
    assert(n == 8)
    assert(output[0] == (100 as u8))
    assert(output[1] == (101 as u8))
    println("Hex encode: PASS")
    0
}
