//@ run-pass
//!
//! Sounio-authority witness for Pireus v0.1 target and material profiles.

use hardware::pireus::model::{
    pireus_result_contains,
    PIREUS_LITERAL_1, PIREUS_LITERAL_2,
}
use hardware::pireus::target_profile::{
    pireus_v01_store,
    pireus_query_canonical_targets,
    pireus_query_observed_machines,
    pireus_query_observed_feature,
    pireus_query_permutation_form,
    PIREUS_TARGET_DARWIN_XEON,
    PIREUS_TARGET_APPLE_SILICON,
    PIREUS_TARGET_DGX_SPARK,
    PIREUS_ARCH_X86_64, PIREUS_ARCH_AARCH64, PIREUS_ARCH_CUDA_SM,
    PIREUS_FEATURE_AVX512F, PIREUS_FEATURE_AVX512_VNNI,
    PIREUS_FEATURE_AVX512_VBMI2, PIREUS_FEATURE_AMX_TILE,
    PIREUS_LITERAL_0,
    PIREUS_ACCESS_WRITE, PIREUS_ACCESS_READ_WRITE,
    PIREUS_CAP_F64X8_DATA1_SELECTOR1_WRITE,
    PIREUS_CAP_F64X8_DATA2_SELECTOR1_READ_WRITE,
}
use ontology::query::{triple_store_count, sparql_result_count}

fn bool_as_i64(value: bool) -> i64 {
    if value { 1 } else { 0 }
}

fn main() -> i32 with IO, Mut, Panic, Epistemic {
    print("SOUNIO_AUTHORITY schema=pireus-target-profile.v0.1")
    print(" role=SEMANTIC_AUTHORITY\n")

    var failures: i64 = 0
    var store = pireus_v01_store()
    let triples = triple_store_count(&store)
    if triples != 164 { failures = failures + 1 }

    let canonical = pireus_query_canonical_targets(&store)
    let canonical_count = sparql_result_count(&canonical)
    let darwin_declared = pireus_result_contains(
        &canonical, PIREUS_TARGET_DARWIN_XEON)
    let apple_declared = pireus_result_contains(
        &canonical, PIREUS_TARGET_APPLE_SILICON)
    let dgx_declared = pireus_result_contains(
        &canonical, PIREUS_TARGET_DGX_SPARK)
    if canonical_count != 3 { failures = failures + 1 }
    if !darwin_declared { failures = failures + 1 }
    if !apple_declared { failures = failures + 1 }
    if !dgx_declared { failures = failures + 1 }

    let darwin_observed = pireus_query_observed_machines(
        &store, PIREUS_TARGET_DARWIN_XEON, PIREUS_ARCH_X86_64)
    let apple_observed = pireus_query_observed_machines(
        &store, PIREUS_TARGET_APPLE_SILICON, PIREUS_ARCH_AARCH64)
    let dgx_observed = pireus_query_observed_machines(
        &store, PIREUS_TARGET_DGX_SPARK, PIREUS_ARCH_CUDA_SM)
    let darwin_observed_count = sparql_result_count(&darwin_observed)
    let apple_observed_count = sparql_result_count(&apple_observed)
    let dgx_observed_count = sparql_result_count(&dgx_observed)
    if darwin_observed_count != 5 { failures = failures + 1 }
    if apple_observed_count != 0 { failures = failures + 1 }
    if dgx_observed_count != 0 { failures = failures + 1 }

    let avx512f = pireus_query_observed_feature(
        &store, PIREUS_FEATURE_AVX512F)
    let vnni = pireus_query_observed_feature(
        &store, PIREUS_FEATURE_AVX512_VNNI)
    let vbmi2 = pireus_query_observed_feature(
        &store, PIREUS_FEATURE_AVX512_VBMI2)
    let amx = pireus_query_observed_feature(
        &store, PIREUS_FEATURE_AMX_TILE)
    let avx512f_count = sparql_result_count(&avx512f)
    let vnni_count = sparql_result_count(&vnni)
    let vbmi2_count = sparql_result_count(&vbmi2)
    let amx_count = sparql_result_count(&amx)
    if avx512f_count != 5 { failures = failures + 1 }
    if vnni_count != 4 { failures = failures + 1 }
    if vbmi2_count != 3 { failures = failures + 1 }
    if amx_count != 3 { failures = failures + 1 }

    let data1_selector1 = pireus_query_permutation_form(
        &store,
        PIREUS_LITERAL_1, 1.0,
        PIREUS_LITERAL_1, 1.0,
        PIREUS_LITERAL_0, 0.0,
        PIREUS_ACCESS_WRITE)
    let data1_count = sparql_result_count(&data1_selector1)
    let data1_present = pireus_result_contains(
        &data1_selector1, PIREUS_CAP_F64X8_DATA1_SELECTOR1_WRITE)
    let data2_false_positive = pireus_result_contains(
        &data1_selector1,
        PIREUS_CAP_F64X8_DATA2_SELECTOR1_READ_WRITE)
    if data1_count != 1 { failures = failures + 1 }
    if !data1_present { failures = failures + 1 }
    if data2_false_positive { failures = failures + 1 }

    let data2_selector1 = pireus_query_permutation_form(
        &store,
        PIREUS_LITERAL_2, 2.0,
        PIREUS_LITERAL_1, 1.0,
        PIREUS_LITERAL_0, 0.0,
        PIREUS_ACCESS_READ_WRITE)
    let data2_count = sparql_result_count(&data2_selector1)
    let data2_present = pireus_result_contains(
        &data2_selector1,
        PIREUS_CAP_F64X8_DATA2_SELECTOR1_READ_WRITE)
    if data2_count != 1 { failures = failures + 1 }
    if !data2_present { failures = failures + 1 }

    let missing_selector = pireus_query_permutation_form(
        &store,
        PIREUS_LITERAL_1, 1.0,
        PIREUS_LITERAL_0, 0.0,
        PIREUS_LITERAL_0, 0.0,
        PIREUS_ACCESS_WRITE)
    let missing_selector_count = sparql_result_count(&missing_selector)
    if missing_selector_count != 0 { failures = failures + 1 }

    print("PIREUS_V01_STORE triples="); print_int(triples); print("\n")
    print("PIREUS_TARGETS canonical="); print_int(canonical_count)
    print(" darwin_declared="); print_int(bool_as_i64(darwin_declared))
    print(" apple_declared="); print_int(bool_as_i64(apple_declared))
    print(" dgx_declared="); print_int(bool_as_i64(dgx_declared)); print("\n")
    print("PIREUS_OBSERVED darwin_xeon="); print_int(darwin_observed_count)
    print(" apple_silicon="); print_int(apple_observed_count)
    print(" dgx_spark="); print_int(dgx_observed_count); print("\n")
    print("PIREUS_FEATURE_COUNTS avx512f="); print_int(avx512f_count)
    print(" avx512_vnni="); print_int(vnni_count)
    print(" avx512_vbmi2="); print_int(vbmi2_count)
    print(" amx_tile="); print_int(amx_count); print("\n")
    print("PIREUS_OPERANDS data=1 selector=1 mask=0 dest=write matches=")
    print_int(data1_count)
    print(" expected_present="); print_int(bool_as_i64(data1_present))
    print(" data2_false_positive=")
    print_int(bool_as_i64(data2_false_positive)); print("\n")
    print("PIREUS_OPERAND_CONTROL data=2 selector=1 mask=0")
    print(" dest=read_write matches="); print_int(data2_count)
    print(" expected_present="); print_int(bool_as_i64(data2_present)); print("\n")
    print("PIREUS_OPERAND_NEGATIVE data=1 selector=0 mask=0")
    print(" dest=write matches="); print_int(missing_selector_count); print("\n")
    print("PIREUS_V01_SUMMARY failures="); print_int(failures); print("\n")

    if failures == 0 { 0 } else { 1 }
}
