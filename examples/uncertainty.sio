//@ run-pass
// GUM uncertainty propagation through arithmetic
// The aspirational Knowledge<T> version is preserved beside this file as
// uncertainty_aspirational.sio.disabled until its API is executable.

struct Measurement { value: f64, uncertainty: f64 }

fn add_meas(a: Measurement, b: Measurement) -> Measurement with Mut, Panic, Div {
    let v = a.value + b.value
    let u = meas_sqrt(a.uncertainty * a.uncertainty + b.uncertainty * b.uncertainty)
    Measurement { value: v, uncertainty: u }
}

fn mul_meas(a: Measurement, b: Measurement) -> Measurement with Mut, Panic, Div {
    let v = a.value * b.value
    let rel_a = a.uncertainty / a.value
    let rel_b = b.uncertainty / b.value
    let u = v * meas_sqrt(rel_a * rel_a + rel_b * rel_b)
    if u < 0.0 {
        Measurement { value: v, uncertainty: 0.0 - u }
    } else {
        Measurement { value: v, uncertainty: u }
    }
}

fn meas_sqrt(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var g = x
    if x > 1.0 { g = x * 0.5 }
    var i: i64 = 0
    while i < 50 { g = 0.5 * (g + x / g); i = i + 1 }
    g
}

fn meas_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let mass = Measurement { value: 75.0, uncertainty: 0.5 }
    let height = Measurement { value: 1.80, uncertainty: 0.01 }

    let h_sq = mul_meas(height, height)
    let bmi_val = mass.value / h_sq.value

    assert(meas_abs(bmi_val - 23.148) < 0.01)
    println("Uncertainty propagation: PASS")
    0
}
