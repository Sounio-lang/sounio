        if n > 0.0000001 { h = sed_scale(act, 1.0 / n) } else { h = act }
        let y: f64 = sed_dot(h, get_c())
        let err: f64 = y - FAR_TGT[t]
        total = total + err * err
        t = t + 1
    }
    total / 80.0
}

