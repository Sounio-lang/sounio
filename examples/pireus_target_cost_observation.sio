//@ run-pass
//!
//! First Sounio authority stream for typed, value-free Pireus cost requests.

use hardware::pireus::xor_selector_material_admission::{
    PireusXorMaterialFilePaths,
}
use hardware::pireus::target_cost_observation::{
    PireusCostDigest, PireusCostParentPaths, PireusCostRequest,
    PIREUS_COST_OK, PIREUS_COST_PARENT_FILE_COUNT,
    pireus_cost_parent_file_matches, pireus_cost_request_valid,
    pireus_cost_ledger_request,
    pireus_target_cost_observation_evaluate,
    pireus_target_cost_observation_matches_frozen_semantics,
}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(digest: &PireusCostDigest) with IO, Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if i > 0 { print(":") }
        print_int(digest.words[i as usize])
        i = i + 1
    }
}

fn print_request(request: &PireusCostRequest) with IO, Mut, Panic {
    print("PIREUS_COST_REQUEST id="); print_int(request.request_id)
    print(" target="); print_int(request.target_id)
    print(" machine="); print_int(request.machine_id)
    print(" engine="); print_int(request.engine_id)
    print(" blueprint="); print_int(yes(request.engine_is_blueprint))
    print(" observed="); print_int(yes(request.engine_observed))
    print(" subject="); print_int(request.subject_kind)
    print(" node="); print_int(request.subject_node)
    print(" quantity="); print_int(request.quantity)
    print(" unit="); print_int(request.unit)
    print(" scope="); print_int(request.scope)
    print(" statistic="); print_int(request.statistic)
    print(" samples="); print_int(request.requested_sample_count)
    print(" warmups="); print_int(request.requested_warmup_count)
    print(" required_environment=")
    print_int(request.required_environment_mask)
    print(" bound_environment="); print_int(request.bound_environment_mask)
    print(" value_present="); print_int(yes(request.value_present))
    print(" covered="); print_int(yes(request.subject_covered))
    print(" admitted="); print_int(yes(request.admitted))
    print(" valid="); print_int(yes(pireus_cost_request_valid(request)))
    print("\n")
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 19 {
        print("usage: pireus_target_cost_observation <pdf> <xed> <darwin-receipt> <darwin-evidence> <apple-receipt> <apple-evidence> <dgx-receipt> <dgx-evidence> <garden> <admission-source> <admission-semantics> <admission-receipt> <admission-evidence> <engine-source> <engine-semantics> <engine-receipt> <operation-source> <operation-semantics> <operation-receipt>\n")
        return 2
    }
    let material = PireusXorMaterialFilePaths {
        darwin_receipt: get_arg(2), darwin_evidence: get_arg(3),
        apple_receipt: get_arg(4), apple_evidence: get_arg(5),
        dgx_receipt: get_arg(6), dgx_evidence: get_arg(7),
    }
    let parents = PireusCostParentPaths {
        garden: get_arg(8), admission_source: get_arg(9),
        admission_semantics: get_arg(10), admission_receipt: get_arg(11),
        admission_evidence: get_arg(12), engine_source: get_arg(13),
        engine_semantics: get_arg(14), engine_receipt: get_arg(15),
        operation_source: get_arg(16), operation_semantics: get_arg(17),
        operation_receipt: get_arg(18),
    }
    let result = pireus_target_cost_observation_evaluate(
        get_arg(0), get_arg(1), &material, &parents)
    var failures = result.failures
    if !result.valid || result.error != PIREUS_COST_OK {
        failures = failures + 1
    }
    if !pireus_target_cost_observation_matches_frozen_semantics(&result) {
        failures = failures + 1
    }

    print("SOUNIO_AUTHORITY schema=pireus-target-cost-observation.v0 role=SEMANTIC_AUTHORITY\n")
    print("PIREUS_COST_PARENTS files=")
    print_int(PIREUS_COST_PARENT_FILE_COUNT)
    print(" matched="); print_int(result.parent_file_match_count)
    print(" admission_live="); print_int(yes(result.admission_parent_live))
    print(" operation_live="); print_int(yes(result.operation_parent_live))
    print(" engine_live="); print_int(yes(result.engine_parent_live))
    print(" valid="); print_int(yes(result.parent_files_valid)); print("\n")
    var i: i64 = 0
    while i < PIREUS_COST_PARENT_FILE_COUNT {
        print("PIREUS_COST_PARENT_FILE index="); print_int(i)
        print(" match=")
        print_int(yes(pireus_cost_parent_file_matches(
            result.parent_file_match_mask, i)))
        print("\n")
        i = i + 1
    }
    print("PIREUS_COST_ENGINES observed_cpu=")
    print_int(result.observed_cpu_count)
    print(" observed_gpu="); print_int(result.observed_gpu_count)
    print(" darwin_observed="); print_int(result.darwin_observed_engine_count)
    print(" apple_observed="); print_int(result.apple_observed_engine_count)
    print(" dgx_observed="); print_int(result.dgx_observed_engine_count)
    print(" darwin_blueprints="); print_int(result.darwin_blueprint_count)
    print(" apple_blueprints="); print_int(result.apple_blueprint_count)
    print(" dgx_blueprints="); print_int(result.dgx_blueprint_count)
    print("\n")
    i = 0
    while i < result.ledger.request_count {
        let request = pireus_cost_ledger_request(&result.ledger, i)
        print_request(&request)
        i = i + 1
    }
    print("PIREUS_COST_LEDGER requests="); print_int(result.ledger.request_count)
    print(" selector="); print_int(result.ledger.selector_request_count)
    print(" whole_operation=")
    print_int(result.ledger.whole_operation_request_count)
    print(" static_site_facts="); print_int(result.static_site_fact_count)
    print(" secondary_site_facts="); print_int(result.secondary_site_fact_count)
    print("\n")
    print("PIREUS_COST_ONTOLOGY triples="); print_int(result.ontology_triple_count)
    print(" requests="); print_int(result.ontology_request_count)
    print(" observations="); print_int(result.ontology_observation_count)
    print(" summaries="); print_int(result.ontology_summary_count)
    print(" comparisons="); print_int(result.ontology_comparison_count)
    print("\n")
    print("PIREUS_COST_NEGATIVES passed="); print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")
    print("PIREUS_COST_BOUNDARY material_observations=")
    print_int(result.material_observation_count)
    print(" derived_summaries="); print_int(result.derived_summary_count)
    print(" comparison_receipts="); print_int(result.comparison_receipt_count)
    print(" speedups="); print_int(result.speedup_count)
    print(" rankings="); print_int(result.ranking_count)
    print(" cross_target_comparable=")
    print_int(yes(result.cross_target_comparable))
    print(" parity_open="); print_int(yes(result.parity_open))
    print(" claim_ready="); print_int(yes(result.claim_ready)); print("\n")
    print("PIREUS_COST_DIGEST words="); print_digest(&result.result_digest)
    print("\n")
    print("PIREUS_COST_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(failures); print("\n")
    if failures == 0 { 0 } else { 1 }
}
