//! Quaternionic Neural Network (QNN) Example
//!
//! This example demonstrates native QNN support in Sounio.
//! QNNs use quaternion-valued neurons for 4x parameter efficiency
//! and better representation of 3D rotations.
//!
//! References:
//! - "Quaternion Convolutional Neural Networks" (arXiv:1804.10592)
//! - "Deep Quaternion Networks" (arXiv:1705.07944)
//! - "Quaternion Recurrent Neural Networks" (arXiv:1903.08478)

use std::pkg

//@ requires: pkg("tensor")

// QNN architecture for 3D rotation classification
// Each quaternion weight encodes 4 real parameters in one type

fn quat_linear_layer_demo() {
    // Create quaternionic linear layer
    // Input: 16 quaternion features -> Output: 32 quaternion features
    // This is 4x more efficient than real-valued: 16*32*4 = 2048 real params
    // vs 16*32 = 512 for real-valued
    let input_size: i32 = 16
    let output_size: i32 = 32

    let layer = quat_linear_create(input_size, output_size)

    // Initialize weights with quaternion-aware scheme
    // Xavier initialization adapted for quaternion weights
    let weights = quat_init_xavier(input_size, output_size, seed: 42)
    let bias = quat_init_xavier(1, output_size, seed: 43)

    // Sample quaternion input (batch of 8)
    let batch_size: i32 = 8
    let input: [Quat; batch_size] = [
        quat(1.0, 0.5, 0.2, 0.1),
        quat(0.8, 0.3, 0.4, 0.2),
        quat(0.6, 0.7, 0.1, 0.3),
        quat(0.4, 0.2, 0.8, 0.1),
        quat(0.2, 0.9, 0.3, 0.4),
        quat(0.9, 0.1, 0.5, 0.2),
        quat(0.3, 0.6, 0.2, 0.7),
        quat(0.5, 0.4, 0.9, 0.1),
    ]

    // Forward pass: y = W ⊗ x + b (Hamilton product)
    let output = quat_linear_fwd(layer, weights, input, bias)

    // Apply quaternion activation (ReLU per component)
    let activated = quat_relu(output)

    print("Quaternionic Linear Layer Demo")
    print("Input shape: [8, 16] quats (512 real values)")
    print("Output shape: [8, 32] quats (1024 real values)")
    print("Hamilton product: W ⊗ x for quaternion multiplication")
}

fn quat_conv2d_demo() {
    // Quaternionic 2D Convolution for 3D vision tasks
    // Input: 3-channel RGB image, but treated as quaternion channels
    // Each filter is quaternion-valued

    let in_channels: i32 = 3
    let out_channels: i32 = 16
    let kernel_h: i32 = 3
    let kernel_w: i32 = 3
    let height: i32 = 32
    let width: i32 = 32
    let batch: i32 = 4

    let conv_layer = quat_conv2d_create(in_channels, out_channels, kernel_h, kernel_w)

    // Initialize convolution kernels with He initialization (quaternion-aware)
    let kernels = quat_init_he(in_channels * out_channels, kernel_h * kernel_w, seed: 123)

    // Create sample quaternion-valued input
    // Image represented as quaternion for richer feature encoding
    let input: [Quat; batch * in_channels * height * width]

    // Initialize input with sample quaternion values
    // In real application: convert RGB to quaternion representation
    let i: i32 = 0
    while i < batch * in_channels * height * width {
        input[i] = quat(
            random_f32() * 0.1,
            random_f32() * 0.1,
            random_f32() * 0.1,
            random_f32() * 0.1,
        )
        i = i + 1
    }

    // Forward pass with Hamilton product convolution
    let output = quat_conv2d_fwd(conv_layer, kernels, input, batch, height, width)

    // Quaternionic pooling (applied per component)
    let pooled = quat_avg_pool2d(output, 2, 2, 2, 2)

    print("Quaternionic 2D Convolution Demo")
    print("Input: [4, 3, 32, 32] quats")
    print("Output: [4, 16, 16, 16] quats after convolution + pooling")
}

fn quat_rnn_demo() {
    // Quaternionic RNN for 3D rotation sequence modeling
    // Useful for: robotics, aerospace, 3D animation

    let input_size: i32 = 8
    let hidden_size: i32 = 16
    let seq_length: i32 = 10

    // Create quaternionic gates (for LSTM/GRU)
    let gate = quat_gate_create(input_size, hidden_size)

    // Initialize hidden state
    var hidden_state = quat_rnn_state_init(hidden_size)

    // Quaternion input sequence (e.g., 3D orientation changes over time)
    let input_seq: [[Quat; input_size]; seq_length]

    // Generate sample orientation sequence
    let t: i32 = 0
    while t < seq_length {
        let angle: f32 = (t as f32) * 0.1
        let i: i32 = 0
        while i < input_size {
            // Represent rotation as quaternion
            input_seq[t][i] = quat(
                (angle * (i as f32)).cos() * 0.5,
                (angle * (i as f32)).sin() * 0.5,
                0.0,
                0.0,
            )
            i = i + 1
        }
        t = t + 1
    }

    // Process sequence through quaternionic LSTM cell
    let t: i32 = 0
    while t < seq_length {
        let (new_state, output) = quat_lstm_cell(gate, input_seq[t], hidden_state)
        hidden_state = new_state
        t = t + 1
    }

    print("Quaternionic RNN Demo")
    print(f"Sequence length: {seq_length}")
    print(f"Hidden size: {hidden_size} quats")
    print("Quaternion gates capture 3D rotation dynamics naturally")
}

fn quat_attention_demo() {
    // Quaternionic multi-head attention for 3D feature learning
    // Each attention head operates in quaternion space

    let num_heads: i32 = 4
    let head_dim: i32 = 8  // quaternions per head
    let seq_len: i32 = 16

    // Query, Key, Value as quaternion matrices
    let query: [[Quat; head_dim * num_heads]; seq_len]
    let key: [[Quat; head_dim * num_heads]; seq_len]
    let value: [[Quat; head_dim * num_heads]; seq_len]

    // Initialize with quaternion embeddings
    let h: i32 = 0
    while h < num_heads {
        let i: i32 = 0
        while i < seq_len {
            let j: i32 = 0
            while j < head_dim {
                let idx = h * head_dim + j
                query[i][idx] = quat_embed_init(seed: i * 100 + j)
                key[i][idx] = quat_embed_init(seed: i * 100 + j + 1000)
                value[i][idx] = quat_embed_init(seed: i * 100 + j + 2000)
                j = j + 1
            }
            i = i + 1
        }
        h = h + 1
    }

    // Quaternion attention: scale using quaternion dot products
    let (output, attention_weights) = quat_attention(query, key, value)

    print("Quaternionic Attention Demo")
    print(f"Heads: {num_heads}, Head dim: {head_dim} quats")
    print("Quaternion attention captures 4-way feature interactions")
}

fn qnn_full_example() {
    // Complete QNN for 3D rotation classification
    //
    // Architecture:
    // 1. QuatConv2D: Extract quaternion features from 3D data
    // 2. QuatBN: Batch normalization (per-component)
    // 3. QuatReLU: Activation
    // 4. QuatAvgPool2D: Spatial pooling
    // 5. QuatLinear: Classification head
    // 6. QuatSoftmax: Output probabilities

    print("=" * 60)
    print("QUATERNIONIC NEURAL NETWORK - FULL EXAMPLE")
    print("=" * 60)
    print("")
    print("Benefits of Quaternionic Neural Networks:")
    print("  - 4x parameter efficiency (quaternion = 4 floats)")
    print("  - Natural 3D rotation representation")
    print("  - Better gradient flow for rotation tasks")
    print("  - Reduced parameter count with improved accuracy")
    print("")

    // Layer 1: Input 3D tensor as quaternions
    let conv1 = quat_conv2d_create(in_ch: 3, out_ch: 32, kH: 3, kW: 3)
    let bn1 = quat_bn_create(num_features: 32)
    let weights1 = quat_init_he(32 * 3, 3 * 3, seed: 1)

    // Layer 2
    let conv2 = quat_conv2d_create(in_ch: 32, out_ch: 64, kH: 3, kW: 3)
    let bn2 = quat_bn_create(num_features: 64)
    let weights2 = quat_init_he(64 * 32, 3 * 3, seed: 2)

    // Classification head
    let fc1 = quat_linear_create(input: 64 * 8 * 8, output: 128)
    let fc2 = quat_linear_create(input: 128, output: 4)  // 4 classes

    print("QNN Architecture:")
    print("  Input: [batch, 3, 32, 32] quats")
    print("  Conv1 + BN + ReLU: [batch, 32, 30, 30]")
    print("  Conv2 + BN + ReLU + Pool: [batch, 64, 8, 8]")
    print("  Flatten + FC1 + FC2: [batch, 4] classes")
    print("")
    print("Total parameters: ~25K quats = ~100K real values")
    print("(vs ~400K for equivalent real-valued CNN)")
    print("")
    print("QNNs provide 4x parameter efficiency!")
}

// Main entry point
fn main() {
    quat_linear_layer_demo()
    print("")
    quat_conv2d_demo()
    print("")
    quat_rnn_demo()
    print("")
    quat_attention_demo()
    print("")
    qnn_full_example()
}
