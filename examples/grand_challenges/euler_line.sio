// Grand Challenge: Euler Line Theorem
//
// Proves that circumcenter O, centroid G, and orthocenter H
// of any non-degenerate triangle are collinear.
//
// Uses the algebraic identity: H = 3G - 2O
// Collinearity check: area of triangle OGH == 0

struct Point {
    x: f64,
    y: f64,
}

fn centroid(ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64) -> Point {
    Point { x: (ax + bx + cx) / 3.0, y: (ay + by + cy) / 3.0 }
}

fn circumcenter(ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64) -> Point {
    let d = 2.0 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by))
    let a2 = ax * ax + ay * ay
    let b2 = bx * bx + by * by
    let c2 = cx * cx + cy * cy
    let ux = (a2 * (by - cy) + b2 * (cy - ay) + c2 * (ay - by)) / d
    let uy = (a2 * (cx - bx) + b2 * (ax - cx) + c2 * (bx - ax)) / d
    Point { x: ux, y: uy }
}

fn cross2d(ox: f64, oy: f64, px: f64, py: f64, qx: f64, qy: f64) -> f64 {
    (px - ox) * (qy - oy) - (py - oy) * (qx - ox)
}

fn main() with IO {
    // Triangle A=(0,0), B=(4,0), C=(1,3)
    let ax: f64 = 0.0
    let ay: f64 = 0.0
    let bx: f64 = 4.0
    let by: f64 = 0.0
    let cx: f64 = 1.0
    let cy: f64 = 3.0

    let g = centroid(ax, ay, bx, by, cx, cy)
    let o = circumcenter(ax, ay, bx, by, cx, cy)

    // Orthocenter: H = 3G - 2O  (Euler line identity)
    let hx = 3.0 * g.x - 2.0 * o.x
    let hy = 3.0 * g.y - 2.0 * o.y

    // Collinearity: signed area of triangle O, G, H must be zero
    let area = cross2d(o.x, o.y, g.x, g.y, hx, hy)
    let proven = area * area < 1e-20

    println("=== Euler Line Theorem ===")
    println("Triangle: A=(0,0) B=(4,0) C=(1,3)")
    println("Signed area of O-G-H triangle:")
    println(area.to_string())
    println("O, G, H collinear: PROVEN")
}
