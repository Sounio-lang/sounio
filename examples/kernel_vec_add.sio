// Example: GPU kernel for vector addition
//
// Public compiler commands (Linux):
//   ./bin/souc check examples/kernel_vec_add.sio
//   ./bin/souc build examples/kernel_vec_add.sio --backend gpu -o /tmp/kernel_vec_add.ptx
//
// One block only: gpu_thread_id_x is not a global multi-block index.
// The host must supply device buffers with at least n f64 elements and launch
// at least n threads. main does not launch the kernel; numerical validation:
//   python3 tests/gpu/public_kernel_vec_add.py /tmp/kernel_vec_add.ptx
// Run that command only inside an authorized NVIDIA GPU allocation.

kernel fn vec_add(n: i64, a: &[f64], b: &[f64], c: &![f64]) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        c[tid as usize] = a[tid as usize] + b[tid as usize]
    }
}

fn main() -> i32 with IO {
    0
}
