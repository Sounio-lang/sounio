// Real Hessian computation test
fn scalar_func(input_ptr: i64) -> f64 {
    let x_ptr = input_ptr
    let y_ptr = input_ptr + 16
    let x_squared = dual_mul(x_ptr, x_ptr)
    let xy = dual_mul(x_ptr, y_ptr)
    let y_squared = dual_mul(y_ptr, y_ptr)
    let sum1 = dual_add(x_squared, xy)
    let result = dual_add(sum1, y_squared)
    dual_value(result)
}

fn main() {
    println("=== Hessian Test ===")

    let x = [3.0, 2.0]
    println("Array created")

    let x_ptr = x as i64
    println("Pointer obtained")
    println(x_ptr)

    let n = array_len(x_ptr)
    println("array_len returned:")
    println(n)

    println("Calling hessian...")
    let H_ptr = hessian(scalar_func, x_ptr)
    println("Hessian returned:")
    println(H_ptr)

    let h00 = ptr_load_f64(H_ptr)
    let h01 = ptr_load_f64(H_ptr + 8)
    let h10 = ptr_load_f64(H_ptr + 16)
    let h11 = ptr_load_f64(H_ptr + 24)

    println("H[0][0] (exp 2):")
    println(h00)
    println("H[0][1] (exp 1):")
    println(h01)
    println("H[1][0] (exp 1):")
    println(h10)
    println("H[1][1] (exp 2):")
    println(h11)

    println("Done!")
}
