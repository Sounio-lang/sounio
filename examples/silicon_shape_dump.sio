// Emit experimental images as signed i64 words for the independent GPU gate.
use hetero::silicon::image::{si_gemv_sm89}

fn main() with IO, Alloc, Mut, Div, Panic {
    let ns: [i64; 17] = [1, 1, 2, 2, 31, 31, 32, 33, 63, 64, 65, 128, 129, 576, 1023, 1024, 1024]
    let ks: [i64; 17] = [1, 2, 1, 7, 5, 64, 65, 128, 17, 256, 576, 7, 1024, 576, 511, 2048, 4096]
    var j: i64 = 0
    while j < 17 {
        let n = ns[j]
        let k = ks[j]
        let image = si_gemv_sm89(n, k)
        if !image.ok || image.nbytes != 2904 { exit(1) }
        print("SHAPE ")
        print_int(n)
        print(" ")
        print_int(k)
        print("\n")
        var i: i64 = 0
        while i < 363 {
            print_int(read_i64(image.ptr as *mut i64, i))
            print("\n")
            i = i + 1
        }
        j = j + 1
    }
}
