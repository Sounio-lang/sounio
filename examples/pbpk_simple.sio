// Simplified PBPK-style one-compartment demo with compiler-native epistemic types.
//
// Uses Knowledge<f64> with inline GUM uncertainty propagation.
// The compiler enforces E170: .value access requires `with Epistemic`.

fn concentration(dose_mg: Knowledge<f64>, volume_l: Knowledge<f64>) -> Knowledge<f64> {
    // Native Knowledge division emits inline GUM codegen:
    // value = dose / volume
    // variance = (1/vol²) * var_dose + (dose²/vol⁴) * var_vol
    dose_mg / volume_l
}

fn main() with IO, Epistemic {
    let dose = measure(500.0, uncertainty: 5.0)
    let volume = measure(42.0, uncertainty: 0.8)

    let c0 = concentration(dose, volume)

    println("example: pbpk_simple")
    println("C0 (mg/L)")
    print_f64(c0.value)
    print("\n")
    println("C0 uncertainty")
    print_f64(c0.uncertainty)
    print("\n")
}
