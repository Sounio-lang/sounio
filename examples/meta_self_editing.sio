// examples/meta_self_editing.sio
//
// Butterfly Thesis — Fase 7 easter egg: Sounio performs surgery on
// Sounio.
//
// Because the Sounio compiler is self-hosted, the SAME `Editable<T>`
// wrapper that allows surgical edits on an LLM's knowledge also
// allows surgical edits on the COMPILER's own inference rules.
//
// Concrete demonstration:
//   1. We model a fragment of the Sounio type checker as a wrapped
//      array of inference rules, each tagged with a (chunk, ZD-class)
//      address drawn from the 168-element sedenion basis.
//   2. We invoke `surgical_remove_rule` which returns a NEW rule
//      table with the targeted rule deactivated.  (We avoid the
//      &![T; N] mutation pattern, which is a documented Sounio
//      limitation; instead we take struct-by-value semantics.)
//   3. We verify that (a) the targeted rule is gone, and (b) all
//      other rules are byte-exactly preserved — the locality
//      guarantee inherited from Paper B's
//      `editing_locality_kernel_bound` theorem.
//
// Formal backing: the removal is correct because the (chunk, class)
// address maps injectively to one basis vector of the 168-graph;
// removing its annihilator subspace preserves the complement,
// exactly as in `capability_removal_preserves_complement`.

struct InferenceRule {
    id: i64,
    chunk: i32,
    class: i32,
    active: bool,
}

// Array wrapper (struct-by-value is how we sidestep the &! array
// mutation limitation — documented in docs/compiler/KNOWN_LIMITATIONS.md).
struct RuleTable {
    r0: InferenceRule,
    r1: InferenceRule,
    r2: InferenceRule,
    r3: InferenceRule,
    r4: InferenceRule,
    r5: InferenceRule,
    r6: InferenceRule,
    r7: InferenceRule,
}

fn make_rule(id: i64, chunk: i32, class: i32) -> InferenceRule with Mut {
    InferenceRule { id: id, chunk: chunk, class: class, active: true }
}

fn initial_table() -> RuleTable with Mut {
    RuleTable {
        r0: make_rule(1, 0, 12),   // implicit i32->i64 coercion (target)
        r1: make_rule(2, 0, 34),
        r2: make_rule(3, 1,  7),
        r3: make_rule(4, 2, 55),
        r4: make_rule(5, 3, 99),
        r5: make_rule(6, 4,  2),
        r6: make_rule(7, 5, 88),
        r7: make_rule(8, 6, 140),
    }
}

// Deactivate a rule by address, returning a new table.  Preserves
// every other rule byte-for-byte.
fn deactivate(rule: InferenceRule, t_chunk: i32, t_class: i32) -> InferenceRule with Mut {
    if rule.chunk == t_chunk && rule.class == t_class {
        InferenceRule { id: rule.id, chunk: rule.chunk, class: rule.class, active: false }
    } else {
        rule
    }
}

fn surgical_remove_rule(t: RuleTable, t_chunk: i32, t_class: i32) -> RuleTable with Mut, ZD {
    RuleTable {
        r0: deactivate(t.r0, t_chunk, t_class),
        r1: deactivate(t.r1, t_chunk, t_class),
        r2: deactivate(t.r2, t_chunk, t_class),
        r3: deactivate(t.r3, t_chunk, t_class),
        r4: deactivate(t.r4, t_chunk, t_class),
        r5: deactivate(t.r5, t_chunk, t_class),
        r6: deactivate(t.r6, t_chunk, t_class),
        r7: deactivate(t.r7, t_chunk, t_class),
    }
}

fn count_active(t: RuleTable) -> i64 with Mut {
    var c: i64 = 0
    if t.r0.active { c = c + 1 }
    if t.r1.active { c = c + 1 }
    if t.r2.active { c = c + 1 }
    if t.r3.active { c = c + 1 }
    if t.r4.active { c = c + 1 }
    if t.r5.active { c = c + 1 }
    if t.r6.active { c = c + 1 }
    if t.r7.active { c = c + 1 }
    c
}

fn target_inactive(t: RuleTable, t_chunk: i32, t_class: i32) -> bool with Mut {
    if t.r0.chunk == t_chunk && t.r0.class == t_class { return !t.r0.active }
    if t.r1.chunk == t_chunk && t.r1.class == t_class { return !t.r1.active }
    if t.r2.chunk == t_chunk && t.r2.class == t_class { return !t.r2.active }
    if t.r3.chunk == t_chunk && t.r3.class == t_class { return !t.r3.active }
    if t.r4.chunk == t_chunk && t.r4.class == t_class { return !t.r4.active }
    if t.r5.chunk == t_chunk && t.r5.class == t_class { return !t.r5.active }
    if t.r6.chunk == t_chunk && t.r6.class == t_class { return !t.r6.active }
    if t.r7.chunk == t_chunk && t.r7.class == t_class { return !t.r7.active }
    false
}

fn rule_byte_eq(a: InferenceRule, b: InferenceRule) -> bool with Mut {
    a.id == b.id && a.chunk == b.chunk && a.class == b.class && a.active == b.active
}

fn others_preserved(pre: RuleTable, post: RuleTable, t_chunk: i32, t_class: i32) -> bool with Mut {
    if !(pre.r0.chunk == t_chunk && pre.r0.class == t_class) {
        if !rule_byte_eq(pre.r0, post.r0) { return false }
    }
    if !(pre.r1.chunk == t_chunk && pre.r1.class == t_class) {
        if !rule_byte_eq(pre.r1, post.r1) { return false }
    }
    if !(pre.r2.chunk == t_chunk && pre.r2.class == t_class) {
        if !rule_byte_eq(pre.r2, post.r2) { return false }
    }
    if !(pre.r3.chunk == t_chunk && pre.r3.class == t_class) {
        if !rule_byte_eq(pre.r3, post.r3) { return false }
    }
    if !(pre.r4.chunk == t_chunk && pre.r4.class == t_class) {
        if !rule_byte_eq(pre.r4, post.r4) { return false }
    }
    if !(pre.r5.chunk == t_chunk && pre.r5.class == t_class) {
        if !rule_byte_eq(pre.r5, post.r5) { return false }
    }
    if !(pre.r6.chunk == t_chunk && pre.r6.class == t_class) {
        if !rule_byte_eq(pre.r6, post.r6) { return false }
    }
    if !(pre.r7.chunk == t_chunk && pre.r7.class == t_class) {
        if !rule_byte_eq(pre.r7, post.r7) { return false }
    }
    true
}

fn main() with IO, Mut, Panic, Div {
    println("=== meta: Sounio surgery on Sounio ===")
    println("")
    let pre = initial_table()
    let before = count_active(pre)

    print("  rules active before removal: "); print_int(before); println("")

    let t_chunk = 0
    let t_class = 12
    let post = surgical_remove_rule(pre, t_chunk, t_class)

    let after = count_active(post)
    let targ_ok = target_inactive(post, t_chunk, t_class)
    let others_ok = others_preserved(pre, post, t_chunk, t_class)

    print("  rules active after  removal: "); print_int(after); println("")
    print("  target rule removed:         "); if targ_ok { print("yes") } else { print("no") } println("")
    print("  other rules preserved:       "); if others_ok { print("yes") } else { print("no") } println("")
    println("")
    println("  Lean backing: capability_removal_preserves_complement")
    println("                (Sounio.SurgicalInterventions, 79-of-84 complement preserved)")
    println("")

    if targ_ok && others_ok && after == before - 1 {
        println("  verdict: surgical rule removal succeeded;")
        println("           compiler is the same except at the target address.")
        println("")
        println("META SELF-EDITING PASS")
    } else {
        println("  verdict: unexpected - investigate")
    }
}
