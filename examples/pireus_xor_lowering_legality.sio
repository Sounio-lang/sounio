//@ run-pass
//!
//! First Sounio authority stream for complete XOR lowering legality.

use hardware::pireus::xor_lowering_legality::{
    PIREUS_XOR_LOWERING_OK,
    pireus_xor_lowering_evaluate,
}

fn bool_as_i64(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(words: &[i64; 8]) with IO, Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if i > 0 { print(":") }
        print_int(words[i])
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 2 {
        print("usage: pireus_xor_lowering_legality <intel-sdm-vol-2c.pdf> <avx512-foundation-isa.xed.txt>\n")
        return 2
    }
    let result = pireus_xor_lowering_evaluate(get_arg(0), get_arg(1))
    var failures = result.failures
    if !result.valid || result.error != PIREUS_XOR_LOWERING_OK {
        failures = failures + 1
    }

    print("SOUNIO_AUTHORITY schema=pireus-xor-lowering-legality.v1 role=SEMANTIC_AUTHORITY\n")
    print("PIREUS_XOR_LOWERING_PARENTS operation_live=")
    print_int(bool_as_i64(result.parents.operation_live_match))
    print(" material_live=")
    print_int(bool_as_i64(result.parents.material_live_match))
    print(" intel_live=")
    print_int(bool_as_i64(result.parents.intel_live_match))
    print(" valid="); print_int(bool_as_i64(result.parents.valid)); print("\n")

    var node: i64 = 0
    while node < result.plan.count {
        print("PIREUS_XOR_LOWERING_NODE index="); print_int(node)
        print(" kind="); print_int(result.plan.node_kinds[node])
        print(" capability="); print_int(result.plan.capabilities[node])
        print(" semantic_form="); print_int(result.plan.semantic_forms[node])
        print(" material_form="); print_int(result.plan.material_forms[node])
        print(" groups="); print_int(result.plan.group_counts[node])
        print(" exact_order=")
        print_int(bool_as_i64(result.plan.exact_order_preserved[node]))
        print(" reassociation_required=")
        print_int(bool_as_i64(result.plan.reassociation_required[node]))
        print(" barrier=")
        print_int(bool_as_i64(result.plan.barriers_present[node]))
        print(" barrier_crossed=")
        print_int(bool_as_i64(result.plan.barriers_crossed[node]))
        print(" semantic_authorized=")
        print_int(bool_as_i64(result.plan.semantic_authorized[node]))
        print(" material_authorized=")
        print_int(bool_as_i64(result.plan.material_authorized[node]))
        print(" refusal="); print_int(result.plan.refusal_reasons[node])
        print("\n")
        node = node + 1
    }

    print("PIREUS_XOR_LOWERING_PLAN semantic_authorized=")
    print_int(result.plan.semantic_authorized_count)
    print(" material_candidates=")
    print_int(result.plan.material_candidate_count)
    print(" material_authorized=")
    print_int(result.plan.material_authorized_count)
    print(" unresolved_material=")
    print_int(result.plan.unresolved_material_count)
    print(" reassociation_required=")
    print_int(result.plan.reassociation_required_count)
    print(" exact_tree_refused=")
    print_int(bool_as_i64(result.plan.exact_tree_reduction_refused))
    print("\n")

    var group: i64 = 0
    while group < result.signs.count {
        print("PIREUS_XOR_SIGN_GROUP index="); print_int(group)
        print(" displacement="); print_int(result.signs.displacements[group])
        print(" chunk="); print_int(result.signs.chunks[group])
        print(" negative_lane_mask=")
        print_int(result.signs.negative_lane_masks[group]); print("\n")
        group = group + 1
    }
    print("PIREUS_XOR_SIGNS groups="); print_int(result.signs.count)
    print(" negative_cells="); print_int(result.signs.negative_cells)
    print(" positive_cells="); print_int(result.signs.positive_cells)
    print(" other_cells="); print_int(result.signs.other_cells)
    print(" complete_cells="); print_int(result.signs.complete_cells)
    print(" valid="); print_int(bool_as_i64(result.signs.valid)); print("\n")

    print("PIREUS_XOR_EXECUTION matching_lanes=")
    print_int(result.execution.matching_lanes)
    print(" mismatching_lanes=")
    print_int(result.execution.mismatching_lanes)
    print(" first_mismatch="); print_int(result.execution.first_mismatch)
    print(" partner_table_valid=")
    print_int(bool_as_i64(result.execution.partner_table_valid))
    print(" ascending_i=")
    print_int(bool_as_i64(result.execution.ascending_i))
    print(" reassociated=")
    print_int(bool_as_i64(result.execution.reassociated))
    print(" bit_exact_to_frozen_parent=")
    print_int(bool_as_i64(result.execution.bit_exact_to_frozen_parent))
    print("\n")

    var target: i64 = 0
    while target < result.targets.count {
        print("PIREUS_XOR_TARGET id="); print_int(result.targets.target_ids[target])
        print(" canonical=")
        print_int(bool_as_i64(result.targets.canonical[target]))
        print(" observed=")
        print_int(bool_as_i64(result.targets.observed[target]))
        print(" material_receipt=")
        print_int(bool_as_i64(result.targets.material_receipts[target]))
        print(" selector_candidate=")
        print_int(bool_as_i64(result.targets.selector_candidates[target]))
        print("\n")
        target = target + 1
    }

    print("PIREUS_XOR_DIGEST plan="); print_digest(&result.plan_digest.words)
    print(" signs="); print_digest(&result.sign_digest.words)
    print(" execution="); print_digest(&result.execution_digest.words)
    print(" targets="); print_digest(&result.target_digest.words)
    print(" witnesses="); print_digest(&result.witness_digest.words)
    print("\n")
    print("PIREUS_XOR_NEGATIVES passed="); print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")
    print("PIREUS_XOR_BOUNDARY material_observations=")
    print_int(result.material_observation_count)
    print(" compiler_emissions="); print_int(result.compiler_emission_count)
    print(" costs="); print_int(result.cost_record_count)
    print(" numerical_refinements=")
    print_int(result.numerical_refinement_receipt_count)
    print(" parity_open="); print_int(bool_as_i64(result.parity_open))
    print(" claim_ready="); print_int(bool_as_i64(result.claim_ready)); print("\n")
    print("PIREUS_XOR_LOWERING_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(failures); print("\n")

    if failures == 0 { 0 } else { 1 }
}
