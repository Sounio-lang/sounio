// Checked sequentially consistent native i64 atomics. Build the platform ABI first.
use ffi::platform::{platform_open,platform_status,platform_close}
use sync::atomic::{atomic_new,atomic_status,atomic_load,atomic_store,atomic_add,atomic_sub,atomic_cas,atomic_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
    let p=platform_open()
    assert(platform_status(&p)==0)
    let a=atomic_new(&p,0)
    assert(atomic_status(&a)==0)
    assert(atomic_load(&p,&a).value==0)
    assert(atomic_store(&p,&a,42)==0)
    assert(atomic_add(&p,&a,10).value==42)
    assert(atomic_load(&p,&a).value==52)
    assert(atomic_sub(&p,&a,2).value==52)
    assert(atomic_cas(&p,&a,50,100).value==1)
    assert(atomic_cas(&p,&a,50,200).value==0)
    assert(atomic_load(&p,&a).value==100)
    // Signed fetch_sub must not negate the minimum i64 in Sounio.
    assert(atomic_store(&p,&a,0)==0)
    assert(atomic_sub(&p,&a,(-9223372036854775807-1)).value==0)
    assert(atomic_load(&p,&a).value==(-9223372036854775807-1))
    assert(atomic_close(&p,a)==0)
    platform_close(p)
    println("ATOMIC_NATIVE_OK")
    return 0
}
