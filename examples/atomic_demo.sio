//! Demonstration of atomic operations for lock-free concurrency
//!
//! This example shows how to use AtomicI64, AtomicU64, and AtomicBool
//! for thread-safe operations without locks.

use sync::atomic::*

fn main() with IO, Panic {
    println("=== Atomic Operations Demo ===")
    println("")

    // Test 1: Basic counter
    println("Test 1: Basic atomic counter")
    let counter_result = test_atomic_counter()
    println("Final counter value: ")
    println(counter_result)
    println("")

    // Test 2: Compare-and-exchange
    println("Test 2: Compare-and-exchange")
    let cas_result = test_atomic_cas()
    if cas_result {
        println("CAS test passed!")
    } else {
        println("CAS test FAILED!")
    }
    println("")

    // Test 3: Atomic boolean
    println("Test 3: Atomic boolean operations")
    let bool_result = test_atomic_bool()
    if bool_result {
        println("Boolean test passed!")
    } else {
        println("Boolean test FAILED!")
    }
    println("")

    // Test 4: Relaxed ordering
    println("Test 4: Lock-free counter with relaxed ordering")
    let relaxed_result = test_relaxed_counter()
    println("Final value: ")
    println(relaxed_result)
    println("")

    // Test 5: Decrement operations
    println("Test 5: Atomic decrement")
    let dec_result = test_atomic_decrement()
    println("Final value after decrements: ")
    println(dec_result)
    println("")

    // Test 6: Memory orderings
    println("Test 6: Memory ordering semantics")
    let ordering_result = test_memory_orderings()
    if ordering_result {
        println("Memory ordering test passed!")
    } else {
        println("Memory ordering test FAILED!")
    }
    println("")

    // Example: Large counter
    println("Example: Lock-free counter with 1000 iterations")
    let large_result = example_lock_free_counter(1000)
    println("Final counter value: ")
    println(large_result)
    println("")

    println("=== All tests completed ===")
}
