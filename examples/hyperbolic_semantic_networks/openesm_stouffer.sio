//@ run-pass
//! Stouffer Z combination of the three preregistered one-sided permutation p-values (H1: Forman
//! curvature negatively predicts depression | density). Single family-level statistic across the three
//! openESM cohorts — honest about the null cohort (it pulls Z down), beats Bonferroni.
//!   Z = Σ Φ⁻¹(1 − p_i) / √k ,  combined one-sided p = 1 − Φ(Z).
//! Inputs are the exact one-sided permutation p's from openesm_curv.sio (B=1000).

fn st_sqrt(x: f64) -> f64 with Mut, Div, Panic { if x<=0.0 {return 0.0} var y=x; var i:i64=0; while i<40 {y=0.5*(y+x/y); i=i+1}; y }
fn st_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x<=0.0 {return -1.0e9}
    let ln2=0.6931471805599453; var v=x; var k:i64=0
    while v>2.0 {v=v/2.0; k=k+1}
    while v<1.0 {v=v*2.0; k=k-1}
    let y=(v-1.0)/(v+1.0); let yy=y*y; var r=0.0; var p=y; var i:i64=1
    while i<=29 {r=r+p/(i as f64); p=p*yy; i=i+2}
    2.0*r+(k as f64)*ln2
}
// Acklam inverse normal CDF (probit), good to ~1e-9 on (0,1).
fn probit(p: f64) -> f64 with Mut, Div, Panic {
    let a1=-3.969683028665376e+01; let a2=2.209460984245205e+02; let a3=-2.759285104469687e+02
    let a4=1.383577518672690e+02; let a5=-3.066479806614716e+01; let a6=2.506628277459239e+00
    let b1=-5.447609879822406e+01; let b2=1.615858368580409e+02; let b3=-1.556989798598866e+02
    let b4=6.680131188771972e+01;  let b5=-1.328068155288572e+01
    let c1=-7.784894002430293e-03; let c2=-3.223964580411365e-01; let c3=-2.400758277161838e+00
    let c4=-2.549732539343734e+00; let c5=4.374664141464968e+00;  let c6=2.938163982698783e+00
    let d1=7.784695709041462e-03;  let d2=3.224671290700398e-01;  let d3=2.445134137142996e+00
    let d4=3.754408661907416e+00
    let plow=0.02425; let phigh=1.0-plow
    if p<plow {
        let q=st_sqrt(-2.0*st_ln(p))
        return (((((c1*q+c2)*q+c3)*q+c4)*q+c5)*q+c6) / ((((d1*q+d2)*q+d3)*q+d4)*q+1.0)
    }
    if p>phigh {
        let q=st_sqrt(-2.0*st_ln(1.0-p))
        return 0.0 - (((((c1*q+c2)*q+c3)*q+c4)*q+c5)*q+c6) / ((((d1*q+d2)*q+d3)*q+d4)*q+1.0)
    }
    let q=p-0.5; let r=q*q
    (((((a1*r+a2)*r+a3)*r+a4)*r+a5)*r+a6)*q / (((((b1*r+b2)*r+b3)*r+b4)*r+b5)*r+1.0)
}
// erf (Abramowitz-Stegun 7.1.26) and normal CDF Phi.
fn st_erf(x: f64) -> f64 with Mut, Div, Panic {
    let s = if x<0.0 {-1.0} else {1.0}; let z=if x<0.0 {0.0-x} else {x}
    let t=1.0/(1.0+0.3275911*z)
    let y=1.0-(((((1.061405429*t-1.453152027)*t)+1.421413741)*t-0.284496736)*t+0.254829592)*t*st_expn(z*z)
    s*y
}
fn st_expn(x: f64) -> f64 with Mut, Div, Panic {  // exp(-x), x>=0
    if x>700.0 {return 0.0}
    let ln2=0.6931471805599453; let k=(x/ln2) as i64; let r=x-(k as f64)*ln2
    var res=1.0; var term=1.0; var i:i64=1
    while i<=15 {term=term*(0.0-r)/(i as f64); res=res+term; i=i+1}
    var j:i64=0; while j<k {res=res/2.0; j=j+1}
    res
}
fn phi(z: f64) -> f64 with Mut, Div, Panic { 0.5*(1.0+st_erf(z/1.4142135623730951)) }
fn print_kv(k: string, v: f64) with IO { print(k); print("="); print(v); println("") }

fn main() -> i64 with IO, Mut, Div, Panic {
    // exact one-sided permutation p's (Forman negative | density), B=1000, from openesm_curv.sio
    let p_fisher    = 0.093906
    let p_kuczynski = 0.015984
    let p_geschwind = 0.483516
    let z1=probit(1.0-p_fisher); let z2=probit(1.0-p_kuczynski); let z3=probit(1.0-p_geschwind)
    print_kv("z_fisher", z1); print_kv("z_kuczynski", z2); print_kv("z_geschwind", z3)
    let Z=(z1+z2+z3)/st_sqrt(3.0)
    let pcomb=1.0-phi(Z)
    println("=== Stouffer combination (3 cohorts, one-sided H1: Forman<0) ===")
    print_kv("Stouffer_Z", Z)
    print_kv("combined_one_sided_p", pcomb)
    print_kv("bonferroni_min_p_x3", p_kuczynski*3.0)
    println("OPENESM_STOUFFER_DONE")
    0
}
