// autodiff_neural.sio — Self-contained 2-layer neural net with manual backprop
//
// Architecture: 2→4→1
//   Forward:   x (2D) → W1·x + b1 → sigmoid → h (4D) → W2·h + b2 → y_pred (scalar)
//   Loss:      MSE = (y_pred - y_target)²
//   Backward:  manual gradient computation for all weights
//   Training:  10 gradient descent steps
//   Verdict:   PASS if final_loss < initial_loss
//
// No imports — all helpers inlined.

// ============================================================================
// MATH HELPERS
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn exp_f64(x: f64) -> f64 {
    if x > 20.0 { return exp_f64(x / 2.0) * exp_f64(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / exp_f64(0.0 - x) }
    var sum = 1.0
    var term = 1.0
    term = term * x / 1.0;  sum = sum + term
    term = term * x / 2.0;  sum = sum + term
    term = term * x / 3.0;  sum = sum + term
    term = term * x / 4.0;  sum = sum + term
    term = term * x / 5.0;  sum = sum + term
    term = term * x / 6.0;  sum = sum + term
    term = term * x / 7.0;  sum = sum + term
    term = term * x / 8.0;  sum = sum + term
    term = term * x / 9.0;  sum = sum + term
    term = term * x / 10.0; sum = sum + term
    term = term * x / 11.0; sum = sum + term
    term = term * x / 12.0; sum = sum + term
    return sum
}

fn sigmoid(x: f64) -> f64 {
    return 1.0 / (1.0 + exp_f64(0.0 - x))
}

fn sigmoid_deriv(y: f64) -> f64 {
    return y * (1.0 - y)
}

// ============================================================================
// NETWORK WEIGHTS  (2→4→1)
//
// W1: 4×2 = 8 weights (row-major: W1[i*2+j] = weight from input j to hidden i)
// b1: 4 biases
// W2: 1×4 = 4 weights (W2[j] = weight from hidden j to output)
// b2: 1 bias
// ============================================================================

// Training data: single sample (x0=1.0, x1=0.5) → target 0.8
fn x0() -> f64 { 1.0 }
fn x1() -> f64 { 0.5 }
fn y_target() -> f64 { 0.8 }
fn lr() -> f64 { 0.1 }

fn main() -> i32 with IO, Mut, Panic {
    // Initialize weights (small fixed values, no RNG needed for determinism)
    var W1: [f64; 8] = [0.0; 8]
    var b1: [f64; 4] = [0.0; 4]
    var W2: [f64; 4] = [0.0; 4]
    var b2: f64 = 0.0

    // W1 initial values (2→4)
    W1[0] = 0.5;  W1[1] = 0.3   // hidden 0
    W1[2] = 0.2;  W1[3] = 0.6   // hidden 1
    W1[4] = 0.8;  W1[5] = 0.1   // hidden 2
    W1[6] = 0.4;  W1[7] = 0.7   // hidden 3

    // b1 initial values
    b1[0] = 0.1; b1[1] = 0.2; b1[2] = 0.05; b1[3] = 0.15

    // W2 initial values (4→1)
    W2[0] = 0.6; W2[1] = 0.3; W2[2] = 0.5; W2[3] = 0.4

    // b2
    b2 = 0.0

    // Intermediate storage
    var z1: [f64; 4] = [0.0; 4]
    var h: [f64; 4]  = [0.0; 4]

    // Forward pass once to compute initial loss
    // z1[i] = W1[i*2]*x0 + W1[i*2+1]*x1 + b1[i]
    var hi: i64 = 0
    while hi < 4 {
        z1[hi as usize] = W1[(hi * 2) as usize] * x0() + W1[(hi * 2 + 1) as usize] * x1() + b1[hi as usize]
        h[hi as usize] = sigmoid(z1[hi as usize])
        hi = hi + 1
    }
    // y_pred = W2·h + b2
    var y_pred_init = b2
    var wi: i64 = 0
    while wi < 4 {
        y_pred_init = y_pred_init + W2[wi as usize] * h[wi as usize]
        wi = wi + 1
    }
    let loss_init = (y_pred_init - y_target()) * (y_pred_init - y_target())

    // =========================================================================
    // TRAINING LOOP — 10 gradient descent steps
    // =========================================================================
    var step: i64 = 0
    while step < 10 {
        // --- Forward pass ---
        // z1, h
        var i: i64 = 0
        while i < 4 {
            z1[i as usize] = W1[(i * 2) as usize] * x0() + W1[(i * 2 + 1) as usize] * x1() + b1[i as usize]
            h[i as usize] = sigmoid(z1[i as usize])
            i = i + 1
        }
        // y_pred
        var y_pred = b2
        var j: i64 = 0
        while j < 4 {
            y_pred = y_pred + W2[j as usize] * h[j as usize]
            j = j + 1
        }

        // --- Backward pass ---
        // dL/dy_pred = 2*(y_pred - y_target)
        let d_out = 2.0 * (y_pred - y_target())

        // dL/dW2[j] = d_out * h[j]
        // dL/db2    = d_out
        // dL/dh[j]  = d_out * W2[j]
        var dh: [f64; 4] = [0.0; 4]
        var j2: i64 = 0
        while j2 < 4 {
            let dW2_j = d_out * h[j2 as usize]
            W2[j2 as usize] = W2[j2 as usize] - lr() * dW2_j
            dh[j2 as usize] = d_out * W2[j2 as usize]  // use updated W2 (close enough for 10 steps)
            j2 = j2 + 1
        }
        b2 = b2 - lr() * d_out

        // dL/dz1[i] = dh[i] * sigmoid'(h[i]) = dh[i] * h[i]*(1-h[i])
        var i2: i64 = 0
        while i2 < 4 {
            let dz1_i = dh[i2 as usize] * sigmoid_deriv(h[i2 as usize])
            // dL/dW1[i*2]   = dz1_i * x0
            // dL/dW1[i*2+1] = dz1_i * x1
            // dL/db1[i]     = dz1_i
            W1[(i2 * 2) as usize]       = W1[(i2 * 2) as usize]       - lr() * dz1_i * x0()
            W1[(i2 * 2 + 1) as usize]   = W1[(i2 * 2 + 1) as usize]   - lr() * dz1_i * x1()
            b1[i2 as usize]             = b1[i2 as usize]             - lr() * dz1_i
            i2 = i2 + 1
        }

        step = step + 1
    }

    // --- Final forward pass to compute final loss ---
    var i3: i64 = 0
    while i3 < 4 {
        z1[i3 as usize] = W1[(i3 * 2) as usize] * x0() + W1[(i3 * 2 + 1) as usize] * x1() + b1[i3 as usize]
        h[i3 as usize] = sigmoid(z1[i3 as usize])
        i3 = i3 + 1
    }
    var y_pred_final = b2
    var j3: i64 = 0
    while j3 < 4 {
        y_pred_final = y_pred_final + W2[j3 as usize] * h[j3 as usize]
        j3 = j3 + 1
    }
    let loss_final = (y_pred_final - y_target()) * (y_pred_final - y_target())

    // PASS if loss decreased
    if loss_final < loss_init {
        print("autodiff_neural: PASS\n")
        return 0
    }
    print("autodiff_neural: FAIL\n")
    return 1 as i32
}
