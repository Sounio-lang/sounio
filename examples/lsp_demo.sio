// LSP Demo for Sounio Language Server Protocol
// 
// Este arquivo demonstra as funcionalidades LSP implementadas:
// - Syntax highlighting para tipos epistêmicos
// - Auto-completion para Knowledge<T>
// - Hover information para funções
// - Go-to-definition
// - Find references

import stdlib.math.*

// Função principal demonstrando LSP features
fn main() -> i32 {
    // LSP: Completion, Hover, Go-to-definition
    
    // Knowledge<T> type com uncertainty-aware programming
    let measurement = Knowledge::new(42.0, 0.5, 0.95, "measurement_source")
    
    // LSP: Epistemic type highlighting e completion
    let result = process_measurement(measurement)
    
    // LSP: Find references, Rename support
    print_epistemic_value(result)
    
    0
}

// LSP: Symbol extraction, Document symbols
fn process_measurement(input: Knowledge<f64>) -> Knowledge<f64> {
    // LSP: Hover information para tipos epistêmicos
    let processed = input * Knowledge::new(2.0, 0.1, 0.99, "calibration_factor")
    
    // LSP: Completion para operações epistêmicas
    if processed.confidence > 0.9 {
        processed * Knowledge::new(1.05, 0.02, 0.95, "confidence_boost")
    } else {
        processed
    }
}

// LSP: Semantic tokens, Type information
fn print_epistemic_value(value: Knowledge<f64>) -> () {
    println("Value: {} ± {} (conf: {:.2}%)", 
           value.value, 
           value.uncertainty,
           value.confidence * 100.0)
}

// LSP: Workspace symbols, Cross-file references
fn advanced_epistemic_computation() -> Knowledge<f64> {
    // LSP: Error highlighting para operações inválidas
    
    let measurements = [
        Knowledge::new(1.0, 0.1, 0.95, "sensor_a"),
        Knowledge::new(2.0, 0.15, 0.92, "sensor_b"),
        Knowledge::new(3.0, 0.2, 0.88, "sensor_c")
    ]
    
    // LSP: Completion para tipos epistêmicos
    var total = Knowledge::new(0.0, 0.0, 1.0, "accumulator")
    
    for measurement in measurements {
        // LSP: Code actions para otimizações epistêmicas
        total = total + measurement
    }
    
    total / Knowledge::new(3.0, 0.0, 1.0, "normalization")
}