// examples/stats/epistemic_suite_demo.sio
// End-to-end demonstration of the epistemic-statistics suite. Runs a small
// method-comparison / two-group analysis and prints a report exercising every
// corner of the package: Student-t mean CI, chi-square variance CI, F
// variance-ratio CI, Wilcoxon signed-rank, and Bland-Altman. Each tool is
// imported directly from its module (the suite is documented in
// stdlib/stats/EPISTEMIC_SUITE.md).
//   souc run examples/stats/epistemic_suite_demo.sio
use stats::student_t::{t_mean_ci, TCI}
use stats::chi_square::{chi2_variance_ci, VarCI}
use stats::fisher_f::{f_var_ratio_ci, VarRatioCI}
use stats::wilcoxon::{wilcoxon_signed_rank, WilcoxonResult}
use stats::bland_altman::{bland_altman, BAResult}

fn mean_of(x: &[f64; 256], n: i32) -> f64 with Mut, Div, Panic {
    var s = 0.0
    var i = 0
    while i < n { s = s + x[i as usize]; i = i + 1 }
    return s / (n as f64)
}

fn sd_of(x: &[f64; 256], n: i32) -> f64 with Mut, Div, Panic {
    let m = mean_of(x, n)
    var ss = 0.0
    var i = 0
    while i < n {
        let d = x[i as usize] - m
        ss = ss + d * d
        i = i + 1
    }
    // Newton sqrt of the sample variance (n-1 basis)
    let v = ss / ((n - 1) as f64)
    if v <= 0.0 { return 0.0 }
    var y = v
    var k = 0
    while k < 24 { y = 0.5 * (y + v / y); k = k + 1 }
    return y
}

fn main() with IO, Mut, Div, Panic {
    // Paired measurements of the same 10 samples by two assay methods (ng/mL).
    var a: [f64; 256] = [0.0; 256]
    var b: [f64; 256] = [0.0; 256]
    a[0]=8.1; a[1]=9.4; a[2]=7.6; a[3]=10.2; a[4]=8.8
    a[5]=9.9; a[6]=7.1; a[7]=11.3; a[8]=8.5; a[9]=9.0
    b[0]=8.3; b[1]=9.1; b[2]=7.9; b[3]=9.8;  b[4]=9.1
    b[5]=9.5; b[6]=7.4; b[7]=10.7; b[8]=8.9; b[9]=8.7
    let n = 10

    print("=== Epistemic statistics suite — demo report ===\n\n")

    // 1. Student-t confidence interval for method A's mean.
    let ma = mean_of(&a, n)
    let sa = sd_of(&a, n)
    let ci_a: TCI = t_mean_ci(ma, sa, n as i64, 0.95)
    print("[t] method A mean 95% CI: ")
    print(ci_a.mean); print(" ["); print(ci_a.lo); print(", "); print(ci_a.hi)
    print("]  (t*="); print(ci_a.mult); print(", df="); print(ci_a.df); print(")\n")

    // 2. Chi-square confidence interval for method A's variance.
    let var_a = sa * sa
    let vci: VarCI = chi2_variance_ci(var_a, n as i64, 0.95)
    print("[chi2] method A variance 95% CI: ")
    print(vci.s2); print(" ["); print(vci.lo); print(", "); print(vci.hi); print("]\n")

    // 3. F confidence interval for the ratio of the two methods' variances.
    let mb = mean_of(&b, n)
    let sb = sd_of(&b, n)
    let fci: VarRatioCI = f_var_ratio_ci(sa * sa, n as i64, sb * sb, n as i64, 0.95)
    print("[F] variance ratio A/B 95% CI: ")
    print(fci.ratio); print(" ["); print(fci.lo); print(", "); print(fci.hi); print("]\n")

    // 4. Wilcoxon signed-rank on the paired differences.
    let wr: WilcoxonResult = wilcoxon_signed_rank(&a, &b, n)
    print("[wilcoxon] signed-rank: W+="); print(wr.w_plus)
    print(" W-="); print(wr.w_minus); print(" z="); print(wr.z)
    print(" p="); print(wr.p_value); print("\n")

    // 5. Bland-Altman agreement between the two methods.
    let ba: BAResult = bland_altman(&a, &b, n, 0.95)
    print("[bland-altman] bias="); print(ba.bias)
    print(" LoA=["); print(ba.loa_lo); print(", "); print(ba.loa_hi); print("]")
    print(" outside="); print(ba.n_outside); print("/"); print(ba.n); print("\n")

    print("\nAll five tools of the epistemic-statistics suite ran on one dataset.\n")
}
