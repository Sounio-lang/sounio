//! Effect Size Calculations Demo
//!
//! Demonstrates statistical effect size measures for comparing distributions.
//! Shows both parametric (Cohen's d) and non-parametric (Cliff's delta) approaches.
//!
//! Example use case: Comparing network metrics across different graph models
//! to determine if differences are statistically meaningful.

fn main() with IO, Alloc {
    log_info("=== Statistical Effect Size Demo ===\n")

    // Simulate two datasets: network clustering coefficients from different models
    var group1 = vec_new()
    var group2 = vec_new()

    // Control group: smaller clustering coefficients
    vec_push(&!group1, 0.15)
    vec_push(&!group1, 0.18)
    vec_push(&!group1, 0.12)
    vec_push(&!group1, 0.20)
    vec_push(&!group1, 0.16)
    vec_push(&!group1, 0.14)
    vec_push(&!group1, 0.19)
    vec_push(&!group1, 0.17)

    // Treatment group: larger clustering coefficients
    vec_push(&!group2, 0.32)
    vec_push(&!group2, 0.35)
    vec_push(&!group2, 0.28)
    vec_push(&!group2, 0.38)
    vec_push(&!group2, 0.33)
    vec_push(&!group2, 0.36)
    vec_push(&!group2, 0.30)
    vec_push(&!group2, 0.34)

    // Calculate descriptive statistics for each group
    log_info("Group 1 (Control):")
    let g1_stats = summarize(&group1)
    log_info(&summary_format(&g1_stats))

    log_info("\nGroup 2 (Treatment):")
    let g2_stats = summarize(&group2)
    log_info(&summary_format(&g2_stats))

    // Calculate Cliff's delta (non-parametric effect size)
    let cliffs_d = cliffs_delta(&group1, &group2)
    let cliffs_interp = cliffs_delta_interpretation(cliffs_d)
    log_info(&string_from("\nCliff's Delta (non-parametric):"))
    log_info(&format_number(cliffs_d, "  Value: "))
    log_info(&string_from("  Interpretation: "))
    log_info(cliffs_interp)
    log_info(&string_from("\n"))

    // Calculate Cohen's d (parametric effect size)
    let cohens_d_val = cohens_d(&group1, &group2)
    let cohens_interp = cohens_d_interpretation(cohens_d_val)
    log_info(&string_from("Cohen's d (parametric):"))
    log_info(&format_number(cohens_d_val, "  Value: "))
    log_info(&string_from("  Interpretation: "))
    log_info(cohens_interp)
    log_info(&string_from("\n"))

    // Calculate confidence intervals for means
    let (g1_lo, g1_hi) = ci_95(&group1)
    let (g2_lo, g2_hi) = ci_95(&group2)

    log_info("95% Confidence Intervals:")
    log_info(&string_from("  Group 1: ["))
    log_info(&format_float(g1_lo))
    log_info(&string_from(", "))
    log_info(&format_float(g1_hi))
    log_info(&string_from("]\n"))

    log_info(&string_from("  Group 2: ["))
    log_info(&format_float(g2_lo))
    log_info(&string_from(", "))
    log_info(&format_float(g2_hi))
    log_info(&string_from("]\n"))

    // Calculate Pearson correlation for synthetic multivariate data
    var x_vals = vec_new()
    var y_vals = vec_new()

    var i = 0
    while i < 8 {
        vec_push(&!x_vals, group1[i])
        vec_push(&!y_vals, group2[i])
        i = i + 1
    }

    let pearson_r = pearson_correlation(&x_vals, &y_vals)
    log_info(&string_from("Pearson Correlation (between groups):"))
    log_info(&format_number(pearson_r, "  r = "))
    log_info(&string_from("\n"))

    log_info("=== End of Demo ===\n")
}

// Helper functions for formatting and logging

fn format_number(val: f64, prefix: &str) -> String with Alloc {
    var result = string_from(prefix)
    string_push_str(&!result, &format_float(val))
    result
}

fn format_float(val: f64) -> String with Alloc {
    // Simple float formatting
    var s = string_new()
    let int_part = (val as i64) as f64
    let frac_part = (val - int_part) * 1000.0

    // Integer part
    var i = int_part as i64
    if i < 0 {
        string_push(&!s, '-')
        i = -i
    }
    var int_str = string_new()
    if i == 0 {
        string_push(&!int_str, '0')
    } else {
        while i > 0 {
            let digit = ((i % 10) as u8 + ('0' as u8)) as char
            string_push(&!int_str, digit)
            i = i / 10
        }
        string_reverse(&!int_str)
    }
    string_push_str(&!s, &int_str)
    string_push(&!s, '.')

    // Fractional part (3 decimals)
    var frac_int = frac_part as i64
    var j = 0
    while j < 3 {
        let digit = ((frac_int / (100i64.pow((2 - j) as u32)) % 10) as u8 + ('0' as u8)) as char
        string_push(&!s, digit)
        j = j + 1
    }

    s
}

fn log_info(msg: &str) with IO {
    // Simple logging
    let bytes = msg.as_bytes()
    write(1, bytes.as_ptr(), bytes.len())
}

extern "C" {
    fn write(fd: i32, buf: *const u8, count: usize) -> i64
}
