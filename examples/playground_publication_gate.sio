// Playground publication gate
//
// Makes the scientific publication threshold explicit so the viewer, provenance
// lane, and review/publication lane can share the same rule.

struct PublicationGate {
    viewer_ready: i64,
    provenance_ready: i64,
    review_checkpoint: i64,
    publication_confidence: i64, // ×10³
}

fn remembered_publication_gate() -> PublicationGate {
    return PublicationGate {
        viewer_ready: 1,
        provenance_ready: 1,
        review_checkpoint: 1,
        publication_confidence: 915,
    }
}

fn observed_publication_gate() -> PublicationGate {
    return PublicationGate {
        viewer_ready: 1,
        provenance_ready: 1,
        review_checkpoint: 1,
        publication_confidence: 985,
    }
}

fn publication_gate_ok(gate: PublicationGate) -> i64 {
    if gate.viewer_ready != 1 { return 0 }
    if gate.provenance_ready != 1 { return 0 }
    if gate.review_checkpoint != 1 { return 0 }
    if gate.publication_confidence < 900 { return 0 }
    return 1
}

fn best_confidence(a: i64, b: i64) -> i64 {
    if a > b { return a }
    return b
}

fn main() -> i64 with IO {
    let remembered = remembered_publication_gate()
    let observed = observed_publication_gate()
    let confidence = best_confidence(
        remembered.publication_confidence,
        observed.publication_confidence
    )

    print("playground publication gate\n")
    print("remembered gate: ")
    print_int(publication_gate_ok(remembered))
    print("\n")
    print("observed gate: ")
    print_int(publication_gate_ok(observed))
    print("\n")
    print("best confidence: ")
    print_int(confidence)
    print("\n")

    return 0
}
