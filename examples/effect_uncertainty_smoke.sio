// CEI WS-A smoke: handle<Epistemic>{ Epistemic.add(2,3) } dispatched to the clause.
// No result annotation needed (P2: ExprHandle results carry scalar-kind).
fn main() -> i32 with IO {
    let r = handle<Epistemic> {
        Epistemic.add(2, 3)
    } with {
        let add = |a: i64, b: i64| { a + b }
    }
    print("SMOKE ")
    println(r)
    0
}
