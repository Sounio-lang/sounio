// Epilepsy O-SSM Hessian: Deep Analysis of Non-Associative Curvature
//
// CHB-MIT Scalp EEG, 5 patients, 5 classes:
//   0 = baseline     (no seizure in the recording)
//   1 = interictal   (same recording as seizure, far from seizure)
//   2 = ictal        (during seizure)
//   3 = pre_ictal    (30s before seizure onset)
//   4 = post_ictal   (30s after seizure end)
//
// Three analyses:
//   A. Full 5-class Hessian comparison (leave-one-patient-out)
//   B. Fano-line decomposition: which non-associative triplets dominate
//   C. H-SSM (quaternion, 4D) vs O-SSM (octonion, 8D) comparison
//
// The 7 Fano lines of the octonions map to 7 non-associative "channels":
//   L0: (e1,e2,e4)  L1: (e2,e3,e5)  L2: (e3,e4,e6)
//   L3: (e4,e5,e7)  L4: (e5,e6,e1)  L5: (e6,e7,e2)  L6: (e7,e1,e3)
// Each line contributes to specific off-diagonal Hessian entries.

var FEATURES: [f64; 262144] = [0.0; 262144]
var LABELS: [i64; 4096] = [0; 4096]
var SITE_KEYS: [i64; 4096] = [0; 4096]
var UNIQUE_SITES: [i64; 64] = [0; 64]
var UNIQUE_SITE_COUNT: i64 = 0
var SUBJECT_COUNT: i64 = 0

var RNG_A: i64 = 0
var RNG_B: i64 = 0

var W: [i64; 16] = [0; 16]
var MOM: [i64; 16] = [0; 16]
var H: [i64; 8] = [0; 8]
var A: [f64; 8] = [0.0; 8]
var SAVED_A: [f64; 8] = [0.0; 8]
var ASSOC_ACC: i64 = 0
var LOGIT: f64 = 0.0
var TMP_OCT: [f64; 8] = [0.0; 8]

var HESS: [i64; 64] = [0; 64]

// 5 classes × 2 metrics (offdiag, diag) = 10 accumulators + 5 counts
var CLS_OD: [i64; 5] = [0; 5]
var CLS_DG: [i64; 5] = [0; 5]
var CLS_CT: [i64; 5] = [0; 5]

// Fano line accumulators per class (7 lines × 5 classes = 35)
var FANO_ICTAL: [i64; 7] = [0; 7]
var FANO_BASE: [i64; 7] = [0; 7]
var FANO_INTER: [i64; 7] = [0; 7]

// H-SSM (quaternion) accumulators
var HSSM_OD: [i64; 5] = [0; 5]
var HSSM_DG: [i64; 5] = [0; 5]

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn exp_q(x: f64) -> f64 with Mut, Div, Panic {
    if x > 15.0 { return exp_q(7.5) * exp_q(x - 7.5) }
    if x < 0.0 - 15.0 { return 0.0 }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 20 { term = term * x / (i as f64); sum = sum + term; i = i + 1 }
    sum
}

fn sqrt_q(x: f64) -> f64 with Mut, Div, Panic {
    if x != x { return 0.0 }
    if x <= 0.0 { return 0.0 }
    var g = x
    var i = 0
    while i < 16 { g = 0.5 * (g + x / g); i = i + 1 }
    if g != g { return 0.0 }
    g
}

fn sigmoid_q(x: f64) -> f64 with Mut, Div, Panic {
    if x >= 0.0 { 1.0 / (1.0 + exp_q(0.0 - x)) }
    else { let ex = exp_q(x); ex / (1.0 + ex) }
}

fn rng_seed(a: i64, b: i64) with Mut { RNG_A = a; RNG_B = b }
fn rng_next() -> i64 with Mut {
    var x = RNG_A
    let y = RNG_B
    RNG_A = y
    x = x ^ (x << 23); x = x ^ (x >> 17); x = x ^ (y ^ (y >> 26))
    RNG_B = x
    let r = x + y
    if r < 0 { 0 - r } else { r }
}
fn randf() -> f64 with Mut, Div { ((rng_next() % 20000) as f64 - 10000.0) / 10000.0 }

fn print_int(v: i64) with IO, Mut {
    if v < 0 { print("-"); print_int(0 - v); return }
    if v >= 10 { print_int(v / 10) }
    let d = v % 10
    if d==0{print("0")}if d==1{print("1")}if d==2{print("2")}if d==3{print("3")}
    if d==4{print("4")}if d==5{print("5")}if d==6{print("6")}if d==7{print("7")}
    if d==8{print("8")}if d==9{print("9")}
}

// ─── Manifest loading ───

fn load_manifest(path: string) -> i64 with IO, Mut, Div, Panic {
    SUBJECT_COUNT = 0
    UNIQUE_SITE_COUNT = 0
    let n = file_size(path)
    if n <= 0 { return 0 }
    let raw = read_file(path)
    let bytes = raw.as_bytes()
    if n < 24 { return -1 }

    var header_start: i64 = 0
    var seeking = true
    while seeking && header_start < n {
        while header_start < n && (bytes[header_start as usize] == 10 || bytes[header_start as usize] == 13) {
            header_start = header_start + 1
        }
        if header_start >= n { seeking = false }
        else if bytes[header_start as usize] == 35 {
            while header_start < n && bytes[header_start as usize] != 10 { header_start = header_start + 1 }
            if header_start < n { header_start = header_start + 1 }
        } else { seeking = false }
    }

    if header_start + 24 >= n ||
       bytes[header_start as usize] != 115 || bytes[(header_start+1) as usize] != 117 ||
       bytes[(header_start+2) as usize] != 98 || bytes[(header_start+3) as usize] != 106 {
        return -1
    }

    var pos: i64 = header_start
    while pos < n && bytes[pos as usize] != 10 { pos = pos + 1 }
    if pos < n { pos = pos + 1 }

    while pos < n && SUBJECT_COUNT < 4096 {
        if bytes[pos as usize] == 10 { pos = pos + 1 }
        else if bytes[pos as usize] == 35 {
            while pos < n && bytes[pos as usize] != 10 { pos = pos + 1 }
            if pos < n { pos = pos + 1 }
        } else {
        var line_end = pos
        while line_end < n && bytes[line_end as usize] != 10 { line_end = line_end + 1 }
        var field_idx: i64 = 0
        var field_start = pos
        var label: i64 = -1
        var site_hash: i64 = 5381
        var feature_idx: i64 = 0
        var i = pos
        while i <= line_end {
            let is_end = i == line_end
            let is_tab = if is_end { false } else { bytes[i as usize] == 9 }
            if is_end || is_tab {
                if field_idx == 1 {
                    if i > field_start {
                        let b = bytes[field_start as usize]
                        if b == 48 { label = 0 }
                        else if b == 49 { label = 1 }
                        else if b == 50 { label = 2 }
                        else if b == 51 { label = 3 }
                        else if b == 52 { label = 4 }
                    }
                } else if field_idx == 2 {
                    var si = field_start
                    while si < i { site_hash = site_hash * 33 + (bytes[si as usize] as i64); si = si + 1 }
                } else if field_idx >= 3 && feature_idx < 64 {
                    var val: f64 = 0.0
                    var neg = false
                    var seen_dot = false
                    var frac_scale = 1.0
                    var si = field_start
                    if si < i && bytes[si as usize] == 45 { neg = true; si = si + 1 }
                    while si < i {
                        let b = bytes[si as usize]
                        if b == 46 { seen_dot = true }
                        else if b >= 48 && b <= 57 {
                            if !seen_dot { val = val * 10.0 + ((b - 48) as f64) }
                            else { frac_scale = frac_scale * 0.1; val = val + frac_scale * ((b - 48) as f64) }
                        }
                        si = si + 1
                    }
                    if neg { val = 0.0 - val }
                    FEATURES[(SUBJECT_COUNT * 64 + feature_idx) as usize] = val
                    feature_idx = feature_idx + 1
                }
                field_idx = field_idx + 1
                field_start = i + 1
            }
            i = i + 1
        }
        if label >= 0 && feature_idx >= 8 {
            LABELS[SUBJECT_COUNT as usize] = label
            SITE_KEYS[SUBJECT_COUNT as usize] = site_hash
            SUBJECT_COUNT = SUBJECT_COUNT + 1
        }
        pos = line_end + 1
        }
    }
    SUBJECT_COUNT
}

fn discover_sites() -> i64 with Mut {
    UNIQUE_SITE_COUNT = 0
    var subj: i64 = 0
    while subj < SUBJECT_COUNT {
        let key = SITE_KEYS[subj as usize]
        var exists: i64 = 0
        var i: i64 = 0
        while i < UNIQUE_SITE_COUNT { if UNIQUE_SITES[i as usize] == key { exists = 1; break }; i = i + 1 }
        if exists == 0 && UNIQUE_SITE_COUNT < 64 {
            UNIQUE_SITES[UNIQUE_SITE_COUNT as usize] = key
            UNIQUE_SITE_COUNT = UNIQUE_SITE_COUNT + 1
        }
        subj = subj + 1
    }
    UNIQUE_SITE_COUNT
}

// ─── Model ───

fn ws(i: i64, v: f64) with Mut { W[i as usize] = (v * 100000000.0) as i64 }
fn wg(i: i64) -> f64 with Div { (W[i as usize] as f64) / 100000000.0 }
fn hs(i: i64, v: f64) with Mut { H[i as usize] = (v * 100000000.0) as i64 }
fn hg(i: i64) -> f64 with Div { (H[i as usize] as f64) / 100000000.0 }
fn assoc_s(v: f64) with Mut { ASSOC_ACC = (v * 100000000.0) as i64 }
fn assoc_g() -> f64 with Div { (ASSOC_ACC as f64) / 100000000.0 }

fn init_model() with Mut, Div, Panic {
    var i: i64 = 0
    while i < 10 { ws(i, randf() / 6.0); MOM[i as usize] = 0; i = i + 1 }
    var nsq = 0.0
    i = 0
    while i < 8 { A[i as usize] = randf(); nsq = nsq + A[i as usize] * A[i as usize]; i = i + 1 }
    let n = sqrt_q(nsq)
    i = 0
    while i < 8 {
        if n > 0.000000001 { A[i as usize] = A[i as usize] / n }
        else if i == 0 { A[i as usize] = 1.0 } else { A[i as usize] = 0.0 }
        i = i + 1
    }
}

fn reset_state() with Mut {
    var i: i64 = 0
    while i < 8 { H[i as usize] = 0; i = i + 1 }
    hs(0, 1.0)
    ASSOC_ACC = 0
    LOGIT = 0.0
}

fn do_oct_mul(
    a0: f64, a1: f64, a2: f64, a3: f64, a4: f64, a5: f64, a6: f64, a7: f64,
    b0: f64, b1: f64, b2: f64, b3: f64, b4: f64, b5: f64, b6: f64, b7: f64
) with Mut {
    TMP_OCT[0] = a0*b0 - a1*b1 - a2*b2 - a3*b3 - a4*b4 - a5*b5 - a6*b6 - a7*b7
    TMP_OCT[1] = a0*b1 + a1*b0 + a2*b3 - a3*b2 + a4*b5 - a5*b4 - a6*b7 + a7*b6
    TMP_OCT[2] = a0*b2 + a2*b0 - a1*b3 + a3*b1 + a4*b6 - a6*b4 + a5*b7 - a7*b5
    TMP_OCT[3] = a0*b3 + a3*b0 + a1*b2 - a2*b1 + a4*b7 - a7*b4 - a5*b6 + a6*b5
    TMP_OCT[4] = a0*b4 + a4*b0 - a1*b5 + a5*b1 - a2*b6 + a6*b2 - a3*b7 + a7*b3
    TMP_OCT[5] = a0*b5 + a5*b0 + a1*b4 - a4*b1 - a2*b7 + a7*b2 + a3*b6 - a6*b3
    TMP_OCT[6] = a0*b6 + a6*b0 + a1*b7 - a7*b1 + a2*b4 - a4*b2 - a3*b5 + a5*b3
    TMP_OCT[7] = a0*b7 + a7*b0 - a1*b6 + a6*b1 + a2*b5 - a5*b2 + a3*b4 - a4*b3
}

fn oct_step(x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) with Mut, Div, Panic {
    do_oct_mul(A[0],A[1],A[2],A[3],A[4],A[5],A[6],A[7], hg(0),hg(1),hg(2),hg(3),hg(4),hg(5),hg(6),hg(7))
    let t0=TMP_OCT[0]; let t1=TMP_OCT[1]; let t2=TMP_OCT[2]; let t3=TMP_OCT[3]
    let t4=TMP_OCT[4]; let t5=TMP_OCT[5]; let t6=TMP_OCT[6]; let t7=TMP_OCT[7]
    do_oct_mul(t0,t1,t2,t3,t4,t5,t6,t7, x0,x1,x2,x3,x4,x5,x6,x7)
    var left: [f64; 8] = [0.0; 8]
    var d: i64 = 0
    while d < 8 { left[d as usize] = TMP_OCT[d as usize]; d = d + 1 }
    do_oct_mul(hg(0),hg(1),hg(2),hg(3),hg(4),hg(5),hg(6),hg(7), x0,x1,x2,x3,x4,x5,x6,x7)
    let hx0=TMP_OCT[0]; let hx1=TMP_OCT[1]; let hx2=TMP_OCT[2]; let hx3=TMP_OCT[3]
    let hx4=TMP_OCT[4]; let hx5=TMP_OCT[5]; let hx6=TMP_OCT[6]; let hx7=TMP_OCT[7]
    do_oct_mul(A[0],A[1],A[2],A[3],A[4],A[5],A[6],A[7], hx0,hx1,hx2,hx3,hx4,hx5,hx6,hx7)
    var asq = 0.0
    d = 0
    while d < 8 { let diff = left[d as usize] - TMP_OCT[d as usize]; asq = asq + diff*diff; d = d + 1 }
    var assoc_step = sqrt_q(asq)
    if assoc_step != assoc_step { assoc_step = 0.0 }
    if assoc_step > 1000.0 { assoc_step = 1000.0 }
    assoc_s(assoc_g() + assoc_step)
    d = 0
    while d < 8 {
        var v = left[d as usize] + 0.2 * TMP_OCT[d as usize]
        if v != v { v = 0.0 }
        if v > 5.0 { v = 5.0 } if v < 0.0 - 5.0 { v = 0.0 - 5.0 }
        hs(d, v)
        d = d + 1
    }
}

fn forward_subject(subj: i64) with Mut, Div, Panic {
    reset_state()
    let base = subj * 64
    var step: i64 = 0
    while step < 8 {
        let off = base + step * 8
        oct_step(
            FEATURES[off as usize], FEATURES[(off+1) as usize],
            FEATURES[(off+2) as usize], FEATURES[(off+3) as usize],
            FEATURES[(off+4) as usize], FEATURES[(off+5) as usize],
            FEATURES[(off+6) as usize], FEATURES[(off+7) as usize]
        )
        step = step + 1
    }
    var af = assoc_g() / 8.0
    if af != af { af = 0.0 }
    assoc_s(af)
    var s = wg(9)
    var d: i64 = 0
    while d < 8 {
        var proj = hg(d) * wg(d)
        if proj != proj { proj = 0.0 }
        s = s + proj
        d = d + 1
    }
    var ap = af * wg(8)
    if ap != ap { ap = 0.0 }
    LOGIT = s + ap
}

fn update_binary(target: i64, lr: f64) with Mut, Div, Panic {
    let prob = sigmoid_q(LOGIT)
    var grad = prob - (target as f64)
    if grad > 0.5 { grad = 0.5 } if grad < 0.0 - 0.5 { grad = 0.0 - 0.5 }
    var d: i64 = 0
    while d < 8 {
        let g = hg(d) * grad
        let m = (MOM[d as usize] as f64) / 100000000.0 * 0.9 + g
        MOM[d as usize] = (m * 100000000.0) as i64
        ws(d, wg(d) - lr * m)
        d = d + 1
    }
    let ag = assoc_g() * grad
    let am = (MOM[8] as f64) / 100000000.0 * 0.9 + ag
    MOM[8] = (am * 100000000.0) as i64
    ws(8, wg(8) - lr * am)
    let bm = (MOM[9] as f64) / 100000000.0 * 0.9 + grad
    MOM[9] = (bm * 100000000.0) as i64
    ws(9, wg(9) - lr * bm)
}

// ─── Hessian ───

fn compute_loss_subj(subj: i64) -> f64 with Mut, Div, Panic {
    forward_subject(subj)
    let prob = sigmoid_q(LOGIT)
    var target = 0.0
    if LABELS[subj as usize] == 2 { target = 1.0 }
    0.0 - (target * prob + (1.0 - target) * (1.0 - prob))
}

fn compute_subject_hessian(subj: i64) with Mut, Div, Panic {
    let eps = 0.001
    let eps2 = eps * eps
    let f0 = compute_loss_subj(subj)
    var i: i64 = 0
    while i < 8 {
        let orig_i = A[i as usize]
        A[i as usize] = orig_i + eps
        let fip = compute_loss_subj(subj)
        A[i as usize] = orig_i - eps
        let fim = compute_loss_subj(subj)
        A[i as usize] = orig_i
        HESS[i * 8 + i] = ((fip - 2.0 * f0 + fim) / eps2 * 1000000.0) as i64
        var j = i + 1
        while j < 8 {
            let orig_j = A[j as usize]
            A[i as usize] = orig_i + eps
            A[j as usize] = orig_j + eps
            let fpp = compute_loss_subj(subj)
            A[j as usize] = orig_j - eps
            let fpm = compute_loss_subj(subj)
            A[i as usize] = orig_i - eps
            let fmm = compute_loss_subj(subj)
            A[j as usize] = orig_j + eps
            let fmp = compute_loss_subj(subj)
            A[i as usize] = orig_i
            A[j as usize] = orig_j
            let hij = ((fpp - fpm - fmp + fmm) / (4.0 * eps2) * 1000000.0) as i64
            HESS[i * 8 + j] = hij
            HESS[j * 8 + i] = hij
            j = j + 1
        }
        i = i + 1
    }
}

fn offdiag_norm() -> i64 with Mut, Div, Panic {
    var s: i64 = 0
    var i: i64 = 0
    while i < 8 {
        var j: i64 = 0
        while j < 8 {
            if i != j { let v = HESS[i*8+j]; if v < 0 { s = s + (0-v) } else { s = s + v } }
            j = j + 1
        }
        i = i + 1
    }
    s
}

fn diag_norm() -> i64 with Mut, Div, Panic {
    var s: i64 = 0
    var i: i64 = 0
    while i < 8 {
        let v = HESS[i*8+i]
        if v < 0 { s = s + (0-v) } else { s = s + v }
        i = i + 1
    }
    s
}

// Fano line energy: sum |H[a][b]| + |H[b][c]| + |H[a][c]| for tripliet (a,b,c)
fn fano_line_energy(a: i64, b: i64, c: i64) -> i64 with Mut, Div, Panic {
    var s: i64 = 0
    let v1 = HESS[a*8+b]; if v1 < 0 { s = s + (0-v1) } else { s = s + v1 }
    let v2 = HESS[b*8+a]; if v2 < 0 { s = s + (0-v2) } else { s = s + v2 }
    let v3 = HESS[a*8+c]; if v3 < 0 { s = s + (0-v3) } else { s = s + v3 }
    let v4 = HESS[c*8+a]; if v4 < 0 { s = s + (0-v4) } else { s = s + v4 }
    let v5 = HESS[b*8+c]; if v5 < 0 { s = s + (0-v5) } else { s = s + v5 }
    let v6 = HESS[c*8+b]; if v6 < 0 { s = s + (0-v6) } else { s = s + v6 }
    s
}

// H-SSM: off-diagonal restricted to quaternion subspace (indices 0-3)
fn hssm_offdiag_norm() -> i64 with Mut, Div, Panic {
    var s: i64 = 0
    var i: i64 = 0
    while i < 4 {
        var j: i64 = 0
        while j < 4 {
            if i != j { let v = HESS[i*8+j]; if v < 0 { s = s + (0-v) } else { s = s + v } }
            j = j + 1
        }
        i = i + 1
    }
    s
}

fn hssm_diag_norm() -> i64 with Mut, Div, Panic {
    var s: i64 = 0
    var i: i64 = 0
    while i < 4 {
        let v = HESS[i*8+i]
        if v < 0 { s = s + (0-v) } else { s = s + v }
        i = i + 1
    }
    s
}

// ─── Main ───

fn main() -> i32 with IO, Mut, Div, Panic {
    var loaded = load_manifest("seizure_hessian_manifest.tsv")
    if loaded <= 0 {
        loaded = load_manifest("/workspace/sounio/seizure_hessian_manifest.tsv")
    }
    if loaded <= 0 { println("No seizure manifest found"); return 1 }
    discover_sites()

    var cnt: [i64; 5] = [0; 5]
    var subj: i64 = 0
    while subj < SUBJECT_COUNT {
        let lab = LABELS[subj as usize]
        if lab >= 0 && lab < 5 { cnt[lab as usize] = cnt[lab as usize] + 1 }
        subj = subj + 1
    }

    println("================================================================")
    println("  EPILEPSY O-SSM: Deep Hessian Non-Associativity Analysis")
    println("  CHB-MIT Scalp EEG | 5 Patients | 5 Classes")
    println("================================================================")
    print("  Windows: "); print_int(SUBJECT_COUNT); print("\n")
    print("    baseline:   "); print_int(cnt[0]); print("\n")
    print("    interictal: "); print_int(cnt[1]); print("\n")
    print("    ictal:      "); print_int(cnt[2]); print("\n")
    print("    pre_ictal:  "); print_int(cnt[3]); print("\n")
    print("    post_ictal: "); print_int(cnt[4]); print("\n")
    print("  Patients: "); print_int(UNIQUE_SITE_COUNT); print("\n")
    println("")

    // Reset accumulators
    var ci: i64 = 0
    while ci < 5 { CLS_OD[ci as usize] = 0; CLS_DG[ci as usize] = 0; CLS_CT[ci as usize] = 0; HSSM_OD[ci as usize] = 0; HSSM_DG[ci as usize] = 0; ci = ci + 1 }
    ci = 0
    while ci < 7 { FANO_ICTAL[ci as usize] = 0; FANO_BASE[ci as usize] = 0; FANO_INTER[ci as usize] = 0; ci = ci + 1 }

    var fold: i64 = 0
    while fold < UNIQUE_SITE_COUNT {
        let holdout_key = UNIQUE_SITES[fold as usize]
        print("  Fold "); print_int(fold + 1); print("/"); print_int(UNIQUE_SITE_COUNT)

        rng_seed(55555 + holdout_key, 77777 + holdout_key * 17)
        init_model()
        var ep: i64 = 0
        while ep < 80 {
            var seen: i64 = 0
            while seen < 300 {
                subj = (rng_next() / 100) % SUBJECT_COUNT
                if SITE_KEYS[subj as usize] != holdout_key {
                    forward_subject(subj)
                    var bin_target: i64 = 0
                    if LABELS[subj as usize] == 2 { bin_target = 1 }
                    update_binary(bin_target, 0.02)
                }
                seen = seen + 1
            }
            ep = ep + 1
        }

        // Test accuracy
        var test_correct: i64 = 0
        var test_total: i64 = 0
        subj = 0
        while subj < SUBJECT_COUNT {
            if SITE_KEYS[subj as usize] == holdout_key {
                forward_subject(subj)
                let pred = if LOGIT > 0.0 { 1 } else { 0 }
                var bin_target: i64 = 0
                if LABELS[subj as usize] == 2 { bin_target = 1 }
                if pred == bin_target { test_correct = test_correct + 1 }
                test_total = test_total + 1
            }
            subj = subj + 1
        }
        print(" acc="); print_int(test_correct * 100 / test_total); print("%")

        var ai: i64 = 0
        while ai < 8 { SAVED_A[ai as usize] = A[ai as usize]; ai = ai + 1 }

        // Hessian on holdout windows
        var h_count: i64 = 0
        subj = 0
        while subj < SUBJECT_COUNT {
            if SITE_KEYS[subj as usize] == holdout_key {
                ai = 0
                while ai < 8 { A[ai as usize] = SAVED_A[ai as usize]; ai = ai + 1 }
                compute_subject_hessian(subj)
                let od = offdiag_norm()
                let dg = diag_norm()
                let hod = hssm_offdiag_norm()
                let hdg = hssm_diag_norm()
                let lab = LABELS[subj as usize]
                if lab >= 0 && lab < 5 {
                    CLS_OD[lab as usize] = CLS_OD[lab as usize] + od
                    CLS_DG[lab as usize] = CLS_DG[lab as usize] + dg
                    CLS_CT[lab as usize] = CLS_CT[lab as usize] + 1
                    HSSM_OD[lab as usize] = HSSM_OD[lab as usize] + hod
                    HSSM_DG[lab as usize] = HSSM_DG[lab as usize] + hdg
                }

                // Fano lines: (e1,e2,e4), (e2,e3,e5), (e3,e4,e6), (e4,e5,e7), (e5,e6,e1), (e6,e7,e2), (e7,e1,e3)
                if lab == 2 {
                    FANO_ICTAL[0] = FANO_ICTAL[0] + fano_line_energy(1, 2, 4)
                    FANO_ICTAL[1] = FANO_ICTAL[1] + fano_line_energy(2, 3, 5)
                    FANO_ICTAL[2] = FANO_ICTAL[2] + fano_line_energy(3, 4, 6)
                    FANO_ICTAL[3] = FANO_ICTAL[3] + fano_line_energy(4, 5, 7)
                    FANO_ICTAL[4] = FANO_ICTAL[4] + fano_line_energy(5, 6, 1)
                    FANO_ICTAL[5] = FANO_ICTAL[5] + fano_line_energy(6, 7, 2)
                    FANO_ICTAL[6] = FANO_ICTAL[6] + fano_line_energy(7, 1, 3)
                } else if lab == 0 {
                    FANO_BASE[0] = FANO_BASE[0] + fano_line_energy(1, 2, 4)
                    FANO_BASE[1] = FANO_BASE[1] + fano_line_energy(2, 3, 5)
                    FANO_BASE[2] = FANO_BASE[2] + fano_line_energy(3, 4, 6)
                    FANO_BASE[3] = FANO_BASE[3] + fano_line_energy(4, 5, 7)
                    FANO_BASE[4] = FANO_BASE[4] + fano_line_energy(5, 6, 1)
                    FANO_BASE[5] = FANO_BASE[5] + fano_line_energy(6, 7, 2)
                    FANO_BASE[6] = FANO_BASE[6] + fano_line_energy(7, 1, 3)
                } else if lab == 1 {
                    FANO_INTER[0] = FANO_INTER[0] + fano_line_energy(1, 2, 4)
                    FANO_INTER[1] = FANO_INTER[1] + fano_line_energy(2, 3, 5)
                    FANO_INTER[2] = FANO_INTER[2] + fano_line_energy(3, 4, 6)
                    FANO_INTER[3] = FANO_INTER[3] + fano_line_energy(4, 5, 7)
                    FANO_INTER[4] = FANO_INTER[4] + fano_line_energy(5, 6, 1)
                    FANO_INTER[5] = FANO_INTER[5] + fano_line_energy(6, 7, 2)
                    FANO_INTER[6] = FANO_INTER[6] + fano_line_energy(7, 1, 3)
                }

                h_count = h_count + 1
            }
            subj = subj + 1
        }
        print(" n="); print_int(h_count); print("\n")
        fold = fold + 1
    }

    // ═══ RESULTS A: Full 5-class comparison ═══
    println("")
    println("================================================================")
    println("  A. Hessian Off-Diagonal by Clinical Phase")
    println("================================================================")
    println("  Expected gradient: Ictal > Pre > Post > Interictal > Baseline")
    println("")

    var class_names: [i64; 5] = [0; 5]

    ci = 0
    while ci < 5 {
        let c = CLS_CT[ci as usize]
        if ci == 0 { print("  baseline:   ") }
        else if ci == 1 { print("  interictal: ") }
        else if ci == 2 { print("  ictal:      ") }
        else if ci == 3 { print("  pre_ictal:  ") }
        else { print("  post_ictal: ") }
        if c > 0 {
            let mean_od = CLS_OD[ci as usize] / c
            let mean_dg = CLS_DG[ci as usize] / c
            print("||H_od||="); print_int(mean_od)
            print("  ||H_dg||="); print_int(mean_dg)
            print("  n="); print_int(c)
        } else {
            print("(no data)")
        }
        print("\n")
        ci = ci + 1
    }

    // Ratios vs baseline
    let base_c = CLS_CT[0]
    if base_c > 0 {
        let base_od = CLS_OD[0] / base_c
        println("")
        println("  Ratios vs Baseline (x1000):")
        ci = 0
        while ci < 5 {
            let c = CLS_CT[ci as usize]
            if c > 0 && base_od > 0 {
                let mean_od = CLS_OD[ci as usize] / c
                let ratio = mean_od * 1000 / base_od
                if ci == 0 { print("    baseline:   ") }
                else if ci == 1 { print("    interictal: ") }
                else if ci == 2 { print("    ictal:      ") }
                else if ci == 3 { print("    pre_ictal:  ") }
                else { print("    post_ictal: ") }
                print_int(ratio); print("\n")
            }
            ci = ci + 1
        }
    }

    // ═══ RESULTS B: Fano-line decomposition ═══
    println("")
    println("================================================================")
    println("  B. Fano-Line Decomposition (7 Non-Associative Channels)")
    println("================================================================")
    println("  Which non-associative triplets carry the seizure signal?")
    println("")

    let ict_c = CLS_CT[2]
    let bas_c = CLS_CT[0]
    let int_c = CLS_CT[1]

    if ict_c > 0 && bas_c > 0 {
        println("  Line  Tripliet    Ictal/win   Base/win   Ratio")
        println("  ----  ---------   ---------   --------   -----")
        var fl: i64 = 0
        while fl < 7 {
            print("  L"); print_int(fl); print("    ")
            if fl == 0 { print("(e1,e2,e4)  ") }
            else if fl == 1 { print("(e2,e3,e5)  ") }
            else if fl == 2 { print("(e3,e4,e6)  ") }
            else if fl == 3 { print("(e4,e5,e7)  ") }
            else if fl == 4 { print("(e5,e6,e1)  ") }
            else if fl == 5 { print("(e6,e7,e2)  ") }
            else { print("(e7,e1,e3)  ") }
            let ict_mean = FANO_ICTAL[fl as usize] / ict_c
            let bas_mean = FANO_BASE[fl as usize] / bas_c
            print_int(ict_mean); print("    ")
            print_int(bas_mean); print("    ")
            if bas_mean > 0 {
                print_int(ict_mean * 100 / bas_mean); print("%")
            } else {
                print("inf")
            }
            print("\n")
            fl = fl + 1
        }
    }

    // ═══ RESULTS C: O-SSM vs H-SSM ═══
    println("")
    println("================================================================")
    println("  C. O-SSM (Octonion, 8D) vs H-SSM (Quaternion, 4D subspace)")
    println("================================================================")
    println("  If non-associativity matters, O-SSM off-diag should dominate.")
    println("")

    ci = 0
    while ci < 5 {
        let c = CLS_CT[ci as usize]
        if c > 0 {
            let o_od = CLS_OD[ci as usize] / c
            let h_od = HSSM_OD[ci as usize] / c
            let extra = o_od - h_od

            if ci == 0 { print("  baseline:   ") }
            else if ci == 1 { print("  interictal: ") }
            else if ci == 2 { print("  ictal:      ") }
            else if ci == 3 { print("  pre_ictal:  ") }
            else { print("  post_ictal: ") }

            print("O-SSM="); print_int(o_od)
            print("  H-SSM="); print_int(h_od)
            print("  extra_from_octonionic="); print_int(extra)
            if h_od > 0 {
                print(" (+"); print_int(extra * 100 / h_od); print("%)")
            }
            print("\n")
        }
        ci = ci + 1
    }

    println("")
    // Verdict
    let ict_od = if CLS_CT[2] > 0 { CLS_OD[2] / CLS_CT[2] } else { 0 }
    let bas_od = if CLS_CT[0] > 0 { CLS_OD[0] / CLS_CT[0] } else { 1 }
    let int_od = if CLS_CT[1] > 0 { CLS_OD[1] / CLS_CT[1] } else { 0 }
    let pre_od = if CLS_CT[3] > 0 { CLS_OD[3] / CLS_CT[3] } else { 0 }

    if ict_od > int_od && ict_od > bas_od {
        println("  CONFIRMED: Seizure produces highest non-associative curvature")
        if pre_od > int_od {
            println("  BONUS: Pre-ictal > Interictal (pre-seizure buildup detected)")
        }
    } else {
        println("  Result inconclusive at this sample size")
    }

    println("")
    println("DONE")
    0
}
