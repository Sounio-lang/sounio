//@ run-pass
//!
//! Frozen Sounio authority executable for Cubic Operator Forge v4.

use hardware::pireus::cubic_operator_forge::{
    PireusCubicForgeDigest,
    PIREUS_CUBIC_FORGE_OK,
    pireus_cubic_forge_request,
    pireus_cubic_operator_forge_evaluate,
    pireus_cubic_operator_forge_matches_frozen_semantics,
    pireus_cubic_operator_forge_frozen_mismatch_code,
}

fn bit(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(digest: &PireusCubicForgeDigest) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(digest.words[word])
        word = word + 1
    }
}

fn print_hash(words: &[i64; 8]) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(words[word])
        word = word + 1
    }
}

fn print_flat_digest(words: &[i64; 384], mutation: i64)
with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(words[mutation * 8 + word])
        word = word + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_cubic_forge_request()
    let result = pireus_cubic_operator_forge_evaluate(&request)

    print("SOUNIO_AUTHORITY schema=pireus-cubic-operator-forge.v4")
    print(" role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE\n")

    print("PIREUS_CUBIC_LINEAGE parent_live_match=")
    print_int(bit(result.lineage.parent_live_match))
    print(" parent_digest_match=")
    print_int(bit(result.lineage.parent_digest_match))
    print(" parent_scope_match=")
    print_int(bit(result.lineage.parent_scope_match))
    print(" complete="); print_int(bit(result.lineage.complete)); print("\n")
    print("PIREUS_CUBIC_PARENT field=source value=")
    print_hash(&result.lineage.parent_source_sha256)
    print("\nPIREUS_CUBIC_PARENT field=semantics value=")
    print_hash(&result.lineage.parent_semantics_sha256)
    print("\nPIREUS_CUBIC_PARENT field=freeze value=")
    print_hash(&result.lineage.parent_freeze_sha256)
    print("\nPIREUS_CUBIC_PARENT field=transcript value=")
    print_hash(&result.lineage.parent_transcript_sha256)
    print("\nPIREUS_CUBIC_PARENT field=parity_open value=")
    print_hash(&result.lineage.parent_parity_receipt_sha256)
    print("\n")

    print("PIREUS_CUBIC_GRAMMAR mutations=")
    print_int(result.population.mutation_count)
    print(" descriptor_checks=")
    print_int(result.population.descriptor_checks)
    print(" descriptor_failures=")
    print_int(result.population.descriptor_failures)
    print(" support_checks=")
    print_int(result.population.support_checks)
    print(" support_failures=")
    print_int(result.population.support_failures)
    print(" witness_checks=")
    print_int(result.population.witness_checks)
    print(" witness_failures=")
    print_int(result.population.witness_failures)
    print(" bilinear_witness_checks=")
    print_int(result.population.bilinear_witness_checks)
    print(" bilinear_witness_failures=")
    print_int(result.population.bilinear_witness_failures)
    print(" pairwise_checks=")
    print_int(result.population.pairwise_checks)
    print(" pairwise_failures=")
    print_int(result.population.pairwise_failures)
    print("\n")

    var mutation: i64 = 0
    while mutation < result.population.mutation_count {
        print("PIREUS_CUBIC_CHILD id="); print_int(mutation)
        print(" kind="); print_int(result.population.kinds[mutation])
        print(" r="); print_int(result.population.r_coordinates[mutation])
        print(" s="); print_int(result.population.s_coordinates[mutation])
        print(" t="); print_int(result.population.t_coordinates[mutation])
        print(" support="); print_int(result.population.support_counts[mutation])
        print(" witness_i="); print_int(result.population.witness_i[mutation])
        print(" witness_j="); print_int(result.population.witness_j[mutation])
        print(" witness_k="); print_int(result.population.witness_k[mutation])
        print(" witness_value=")
        print_int(result.population.witness_values[mutation])
        print(" negatives=")
        print_int(result.population.negative_counts[mutation])
        print(" square_negatives=")
        print_int(result.population.square_negative_counts[mutation])
        print(" commutator_defects=")
        print_int(result.population.commutator_defects[mutation])
        print(" associator_defects=")
        print_int(result.population.associator_defects[mutation])
        print(" groups="); print_int(result.population.group_counts[mutation])
        print(" unresolved=")
        print_int(result.population.unresolved_obligations[mutation])
        print(" child_digest=")
        print_flat_digest(&result.population.child_digest_words, mutation)
        print(" lineage_digest=")
        print_flat_digest(
            &result.population.child_lineage_digest_words, mutation)
        print("\n")
        mutation = mutation + 1
    }

    print("PIREUS_CUBIC_POPULATION sign_checks=")
    print_int(result.population.sign_range_checks)
    print(" sign_failures=")
    print_int(result.population.sign_range_failures)
    print(" parent_delta_checks=")
    print_int(result.population.parent_delta_checks)
    print(" parent_delta_failures=")
    print_int(result.population.parent_delta_failures)
    print(" semantic_cell_checks=")
    print_int(result.population.semantic_cell_checks)
    print(" semantic_cell_failures=")
    print_int(result.population.semantic_cell_failures)
    print(" fixture_checks=")
    print_int(result.population.fixture_checks)
    print(" fixture_failures=")
    print_int(result.population.fixture_failures)
    print(" groups="); print_int(result.population.group_total)
    print(" unresolved=")
    print_int(result.population.unresolved_obligation_total)
    print(" selected_child=")
    print_int(result.population.selected_child)
    print(" ranking_present=")
    print_int(bit(result.population.ranking_present))
    print(" complete="); print_int(bit(result.population.complete)); print("\n")

    print("PIREUS_CUBIC_MATERIAL observations=")
    print_int(result.population.target_observations)
    print(" discharges=")
    print_int(result.population.target_discharges)
    print(" receipts="); print_int(result.population.material_receipts)
    print(" lowerings="); print_int(result.population.target_lowerings)
    print(" costs="); print_int(result.population.target_cost_records)
    print(" performance=")
    print_int(result.population.target_performance_records)
    print("\n")

    print("PIREUS_CUBIC_RECEIPT parent_bound=")
    print_int(bit(result.receipt.parent_lineage_bound))
    print(" population_complete=")
    print_int(bit(result.receipt.mixed_cubic_population_complete))
    print(" witnesses_complete=")
    print_int(bit(result.receipt.noncocycle_witness_complete))
    print(" bilinear_grammar_novelty=")
    print_int(bit(result.receipt.relative_bilinear_grammar_novelty))
    print(" child_genomes=")
    print_int(bit(result.receipt.executable_child_genomes))
    print(" no_selection=")
    print_int(bit(result.receipt.no_child_selected))
    print(" target_envelopes_unresolved=")
    print_int(bit(result.receipt.target_envelopes_unresolved))
    print(" coordinate_scope=")
    print_int(bit(result.receipt.declared_coordinate_scope))
    print(" child_diagnostics=")
    print_int(bit(result.receipt.structural_counts_are_child_diagnostics))
    print(" fixture_smoke_only=")
    print_int(bit(result.receipt.fixture_is_smoke_only))
    print(" semantics_frozen=")
    print_int(bit(result.receipt.semantics_frozen))
    print(" parity_open=")
    print_int(bit(result.receipt.material_parity_open))
    print(" claim_ready="); print_int(bit(result.receipt.claim_ready))
    print("\n")

    print("PIREUS_CUBIC_NEGATIVES passed=")
    print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")

    print("PIREUS_CUBIC_DIGEST lineage=")
    print_digest(&result.lineage_digest)
    print(" grammar="); print_digest(&result.grammar_digest)
    print(" population="); print_digest(&result.population_digest)
    print(" receipt="); print_digest(&result.receipt_digest)
    print(" forge="); print_digest(&result.forge_digest)
    print("\n")

    print("PIREUS_CUBIC_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(result.failures)
    print(" frozen_match=")
    print_int(bit(
        pireus_cubic_operator_forge_matches_frozen_semantics(&result)))
    print(" frozen_mismatch_code=")
    print_int(pireus_cubic_operator_forge_frozen_mismatch_code(&result))
    print(" valid="); print_int(bit(result.valid)); print("\n")

    if result.valid && result.error == PIREUS_CUBIC_FORGE_OK &&
        result.failures == 0 &&
        pireus_cubic_operator_forge_matches_frozen_semantics(&result) {
        0
    } else { 1 }
}
