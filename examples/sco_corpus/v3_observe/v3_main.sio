// SCO corpus V3 — driver (multi-module native)
// Violation class: erased observation barrier (SCO Step I §4 V3)
//
// Exact sentinel block:
//   1
//   7001
//
// Line 1: barrier tag from leaf (ω entitlement must survive import).
// Line 2: observation discharge under Observe — without this effect row,
//         the discharge function is not legal (E035). Optimisations that
//         erase the barrier report while keeping a plausible payload class
//         are the SCO adversary (see corpus doc).

use v3_leaf

fn sco_discharge_observe(payload_u: i64) -> i64 with Observe {
    // Observation step: maps raw payload units to report class.
    if payload_u > 0 {
        7001
    } else {
        7000
    }
}

fn main() -> i32 with IO, Observe {
    print_int(sco_barrier_tag())
    print("\n")
    print_int(sco_discharge_observe(sco_raw_payload_u()))
    print("\n")
    return 0
}
