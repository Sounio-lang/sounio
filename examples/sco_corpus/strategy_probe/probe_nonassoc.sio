// SCO strategy probe — ordinary return type + NonAssoc effect.
// Under enforce, lower must assign PRECISION_PRESERVING (2).
// Under SOUNIO_SCO_ABLATION=1, elevation is skipped → STANDARD (0).
// Observed via SOUNIO_SCO_STRATEGY_TRACE=1 → lines SCO_STRATEGY=N

fn sco_probe_leaf(x: f64) -> f64 with NonAssoc, Div {
    x * 1.0
}

fn main() -> i32 with IO, NonAssoc, Div {
    let y = sco_probe_leaf(2.0)
    if y > 0.0 {
        print_int(1)
        print("\n")
    } else {
        print_int(0)
        print("\n")
    }
    return 0
}
