// SCO corpus V1 — leaf module
// Scientific entitlement: finite-dof Type-A-dominant budget → Student-t k95.
// Exports k95*1000 as i64 so the main sink cannot float-print flake.
//
// Sentinel class (see docs/research/sco_corpus_2026-08-01.md):
//   2776 = coverage preserved
//   1960 = silent collapse (adversary win)

use epistemic::gum::{gum_combine2, gum_type_a, gum_type_b_uniform, gum_k95}

pub fn sco_k95i() -> i64 with Div, Mut, Panic {
    let r = gum_combine2(98.3, gum_type_a(0.30, 5), gum_type_b_uniform(0.001))
    (gum_k95(r) * 1000.0) as i64
}
