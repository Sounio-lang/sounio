// SCO corpus V2 — leaf module
// Scientific entitlement: non-associative product variance classes must remain
// distinct (Fano vs non-Fano) after multi-module native emission.
// Micro-unit integers: var * 1e6.

use epistemic::product_nonassoc::{product_nonassoc_augment, pn_oct_basis}

pub fn sco_fano_var_u() -> i64 with Div, Mut, Panic, NonAssoc {
    let kappa = 1.0
    let base_var = 0.25
    let a = pn_oct_basis(1)
    let b = pn_oct_basis(2)
    let c = pn_oct_basis(3)
    let vf = product_nonassoc_augment(base_var, &a, &b, &c, kappa)
    (vf * 1000000.0) as i64
}

pub fn sco_nonfano_var_u() -> i64 with Div, Mut, Panic, NonAssoc {
    let kappa = 1.0
    let base_var = 0.25
    let a = pn_oct_basis(1)
    let b = pn_oct_basis(2)
    let c = pn_oct_basis(4)
    let vn = product_nonassoc_augment(base_var, &a, &b, &c, kappa)
    (vn * 1000000.0) as i64
}
