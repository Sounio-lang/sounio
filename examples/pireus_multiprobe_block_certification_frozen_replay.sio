//@ run-pass
//!
//! Frozen Sounio semantic-authority replay for the V14 plan.

use hardware::pireus::multiprobe_block_certification::{
    pireus_multiprobe_block_certification_request,
    pireus_multiprobe_block_certification_paths,
    pireus_multiprobe_block_certification_evaluate,
}
use hardware::pireus::multiprobe_block_certification_frozen::{
    pireus_mbc_frozen_mismatch_code,
    pireus_mbc_matches_frozen_v14,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    let request = pireus_multiprobe_block_certification_request()
    let paths = pireus_multiprobe_block_certification_paths()
    let result = pireus_multiprobe_block_certification_evaluate(
        &request, &paths, false)
    let mismatch = pireus_mbc_frozen_mismatch_code(&result)
    if mismatch != 0 || !pireus_mbc_matches_frozen_v14(&result) {
        return if mismatch != 0 { mismatch as i32 } else { 90 }
    }
    print("SOUNIO_AUTHORITY schema=pireus-multiprobe-block-certification.v14")
    print(" role=SEMANTIC_AUTHORITY stage=SEMANTICS_FROZEN")
    print(" matcher_free=0 observed_plan_matchers=6")
    print(" expected_block_results=0\n")
    print("PIREUS_MBC_FROZEN_REPLAY match=1 mismatch=0")
    print(" completed_blocks=0 reuse_hits=0 certified=0 claim_ready=0\n")
    0
}
