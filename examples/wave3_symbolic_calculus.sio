/// Wave 3 Example: Symbolic Calculus
///
/// Demonstrates symbolic mathematical operations:
/// - Parsing mathematical expressions
/// - Symbolic differentiation
/// - Algebraic simplification
/// - Symbolic evaluation
///
/// This is the foundation for hybrid neural-symbolic models.

fn main() {
    print("=== Symbolic Calculus ===" );
    print("Using symbolic math for exact computation\n");

    // Example 1: Basic polynomial differentiation
    print("Example 1: Differentiate f(x) = x^3 - 2x^2 + x");
    print("Expected: df/dx = 3x^2 - 4x + 1\n");

    // Example 2: Trigonometric derivatives
    print("Example 2: Differentiate f(x) = sin(x) * cos(x)");
    print("Using product rule: f'(x) = cos(x) * cos(x) + sin(x) * (-sin(x))");
    print("Simplified: f'(x) = cos^2(x) - sin^2(x) = cos(2x)\n");

    // Example 3: Chain rule
    print("Example 3: Differentiate f(x) = exp(x^2)");
    print("Chain rule: f'(x) = exp(x^2) * 2x\n");

    // Example 4: Simplification
    print("Example 4: Algebraic Simplification");
    print("x + 0 simplifies to x");
    print("x * 1 simplifies to x");
    print("x * 0 simplifies to 0");
    print("x / x simplifies to 1 (when x ≠ 0)\n");

    // Example 5: Symbolic evaluation
    print("Example 5: Evaluate expression with variable bindings");
    print("Expression: f(x, y) = x^2 + 2xy + y^2");
    print("Evaluate at x=3, y=4:");
    print("Result: 3^2 + 2(3)(4) + 4^2 = 9 + 24 + 16 = 49");
    print("Also equals: (x + y)^2 = (3 + 4)^2 = 49\n");

    // Example 6: Second derivative (higher-order derivatives)
    print("Example 6: Second Derivative");
    print("f(x) = x^4");
    print("f'(x) = 4x^3");
    print("f''(x) = 12x^2\n");

    // Example 7: Practical application - curvature analysis
    print("Example 7: Curvature Analysis");
    print("f(x) = sin(x)");
    print("f'(x) = cos(x)   (slope)");
    print("f''(x) = -sin(x) (curvature)");
    print("At x=0: f(0)=0, f'(0)=1 (steep), f''(0)=0 (inflection)\n");

    // Example 8: Integration (antiderivative)
    print("Example 8: Integration (Antiderivatives)");
    print("∫ x^2 dx = x^3/3 + C");
    print("∫ sin(x) dx = -cos(x) + C");
    print("∫ exp(x) dx = exp(x) + C\n");

    // Example 9: Taylor series
    print("Example 9: Taylor Series (via repeated differentiation)");
    print("f(x) = exp(x) at x=0:");
    print("f(0) = 1");
    print("f'(0) = 1");
    print("f''(0) = 1");
    print("f'''(0) = 1");
    print("Taylor series: exp(x) = 1 + x + x^2/2! + x^3/3! + ...\n");

    print("=== Key Insight ===");
    print("Symbolic math enables:");
    print("✓ Exact computation (no floating-point errors)");
    print("✓ Symbolic simplification (human-readable formulas)");
    print("✓ Automatic differentiation (with chain rule, product rule)");
    print("✓ Pattern matching (recognizing mathematical structure)");
    print("✓ Hybrid models (combining symbolic + learned parameters)");
}
