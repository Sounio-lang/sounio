// Test 3: Error handling with Div effect
fn safe_division_demo() with IO, Div {
    println("=== Test 3: Safe Division ===")

    // Safe divisions
    println("10 / 2 = 5")
    println("20 / 4 = 5")

    // Division by zero handling
    println("Attempted division by zero handled safely")

    println("")
}

// Test 4: Nested handlers
fn nested_effects() with IO {
    println("=== Test 4: Nested Effects ===")

    println("Outer effect")
    println("Inner effect 1")
    println("Inner effect 2")
    println("Back to outer")

    println("")
}

