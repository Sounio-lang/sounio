//@ run-pass
// sedenion_zero_div_hunt.sio — Systematic zero-divisor search
//
// Moreno (1998) proved sedenions have zero divisors of the form
//   (e_i + e_j)(e_k - e_l) = 0
// where the indices follow the octonion Fano plane structure.
//
// The exact pairs depend on the Cayley-Dickson convention.
// We systematically search ALL pairs (e_i ± e_j)(e_k ± e_l) = 0.

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn sqrt_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var r = x
    var i = 0
    while i < 20 { r = 0.5 * (r + x / r); i = i + 1 }
    r
}

struct Oct { e: [f64; 8] }
fn oct_zero() -> Oct { Oct { e: [0.0; 8] } }
fn oct_sub(a: Oct, b: Oct) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    var i: i64 = 0
    while i < 8 { r.e[i as usize] = a.e[i as usize] - b.e[i as usize]; i = i + 1 }
    r
}
fn oct_add(a: Oct, b: Oct) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    var i: i64 = 0
    while i < 8 { r.e[i as usize] = a.e[i as usize] + b.e[i as usize]; i = i + 1 }
    r
}
fn oct_conjugate(o: Oct) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    r.e[0] = o.e[0]
    var i: i64 = 1
    while i < 8 { r.e[i as usize] = 0.0 - o.e[i as usize]; i = i + 1 }
    r
}
fn oct_fano_index(i: i64, j: i64) -> i64 with Mut, Panic, Div {
    if i == j { return 0 }
    var t: [i64; 21] = [0; 21]
    t[0]=1;t[1]=2;t[2]=4; t[3]=2;t[4]=3;t[5]=5; t[6]=3;t[7]=4;t[8]=6
    t[9]=4;t[10]=5;t[11]=7; t[12]=5;t[13]=6;t[14]=1; t[15]=6;t[16]=7;t[17]=2
    t[18]=7;t[19]=1;t[20]=3
    var k: i64 = 0
    while k < 7 {
        let a=t[(k*3) as usize]; let b=t[(k*3+1) as usize]; let c=t[(k*3+2) as usize]
        if (i==a&&j==b)||(i==b&&j==c)||(i==c&&j==a) {
            if i==a&&j==b {return c}; if i==b&&j==c {return a}; return b
        }
        if (i==b&&j==a)||(i==c&&j==b)||(i==a&&j==c) {
            if i==b&&j==a {return c}; if i==c&&j==b {return a}; return b
        }
        k=k+1
    }
    0
}
fn oct_fano_sign(i: i64, j: i64) -> f64 with Mut, Panic, Div {
    if i==j {return -1.0}; if i==0||j==0 {return 1.0}
    var t: [i64; 21] = [0; 21]
    t[0]=1;t[1]=2;t[2]=4; t[3]=2;t[4]=3;t[5]=5; t[6]=3;t[7]=4;t[8]=6
    t[9]=4;t[10]=5;t[11]=7; t[12]=5;t[13]=6;t[14]=1; t[15]=6;t[16]=7;t[17]=2
    t[18]=7;t[19]=1;t[20]=3
    var k: i64 = 0
    while k < 7 {
        let a=t[(k*3) as usize]; let b=t[(k*3+1) as usize]; let c=t[(k*3+2) as usize]
        if (i==a&&j==b)||(i==b&&j==c)||(i==c&&j==a) {return 1.0}
        if (i==b&&j==a)||(i==c&&j==b)||(i==a&&j==c) {return -1.0}
        k=k+1
    }
    0.0
}
fn oct_mul(a: Oct, b: Oct) -> Oct with Mut, Panic, Div {
    var result = oct_zero()
    var i: i64 = 0
    while i < 8 {
        var j: i64 = 0
        while j < 8 {
            let coeff = a.e[i as usize] * b.e[j as usize]
            if i==0&&j==0 { result.e[0] = result.e[0] + coeff }
            else if i==0 { result.e[j as usize] = result.e[j as usize] + coeff }
            else if j==0 { result.e[i as usize] = result.e[i as usize] + coeff }
            else if i==j { result.e[0] = result.e[0] - coeff }
            else {
                let k = oct_fano_index(i, j)
                let sign = oct_fano_sign(i, j)
                result.e[k as usize] = result.e[k as usize] + sign * coeff
            }
            j=j+1
        }
        i=i+1
    }
    result
}

struct Sed { e: [f64; 16] }
fn sed_zero() -> Sed { Sed { e: [0.0; 16] } }
fn sed_norm_sq(s: Sed) -> f64 with Mut, Panic, Div {
    var sum: f64 = 0.0
    var i: i64 = 0
    while i < 16 { sum = sum + s.e[i as usize] * s.e[i as usize]; i = i + 1 }
    sum
}
fn sed_norm(s: Sed) -> f64 with Mut, Panic, Div { sqrt_f64(sed_norm_sq(s)) }

fn sed_to_oct_pair(s: Sed) -> (Oct, Oct) with Mut, Panic, Div {
    var a = oct_zero(); var b = oct_zero()
    var i: i64 = 0
    while i < 8 {
        a.e[i as usize] = s.e[i as usize]
        b.e[i as usize] = s.e[(i + 8) as usize]
        i = i + 1
    }
    (a, b)
}
fn sed_from_oct_pair(a: Oct, b: Oct) -> Sed with Mut, Panic, Div {
    var s = sed_zero()
    var i: i64 = 0
    while i < 8 {
        s.e[i as usize] = a.e[i as usize]
        s.e[(i + 8) as usize] = b.e[i as usize]
        i = i + 1
    }
    s
}
fn sed_mul(p: Sed, q: Sed) -> Sed with Mut, Panic, Div {
    let pp = sed_to_oct_pair(p)
    let qp = sed_to_oct_pair(q)
    let a = pp.0; let b = pp.1; let c = qp.0; let d = qp.1
    let d_conj = oct_conjugate(d)
    let c_conj = oct_conjugate(c)
    let real_part = oct_sub(oct_mul(a, c), oct_mul(d_conj, b))
    let imag_part = oct_add(oct_mul(d, a), oct_mul(b, c_conj))
    sed_from_oct_pair(real_part, imag_part)
}

fn print_f4(x: f64) with IO, Mut, Panic, Div {
    if x < 0.0 { print("-"); print_f4(0.0 - x); return }
    let ip = x as i64
    let fp = ((x - (ip as f64)) * 10000.0 + 0.5) as i64
    print(ip); print(".")
    if fp < 10 { print("000") }
    else if fp < 100 { print("00") }
    else if fp < 1000 { print("0") }
    print(fp)
}

fn main() -> i32 with IO, Mut, Panic, Div {
    println("================================================================")
    println("  SEDENION ZERO-DIVISOR HUNT")
    println("  Searching ALL (e_i + s1*e_j)(e_k + s2*e_l) pairs")
    println("  where i<j, k<l, s1,s2 in {+1,-1}")
    println("================================================================")
    println("")

    var found: i32 = 0

    // Search: z = e_i + s1*e_j, w = e_k + s2*e_l
    // where i < j, k < l, s1 in {+1,-1}, s2 in {+1,-1}
    // and at least one of (i,j) crosses the octonion/sedenion boundary
    var i: i64 = 0
    while i < 16 {
        var j: i64 = i + 1
        while j < 16 {
            var k: i64 = 0
            while k < 16 {
                var l: i64 = k + 1
                while l < 16 {
                    // Try all 4 sign combinations
                    var s1: i32 = 0
                    while s1 < 2 {
                        var s2: i32 = 0
                        while s2 < 2 {
                            let sign1 = if s1 == 0 { 1.0 } else { -1.0 }
                            let sign2 = if s2 == 0 { 1.0 } else { -1.0 }

                            var z = sed_zero()
                            z.e[i as usize] = 1.0
                            z.e[j as usize] = sign1

                            var w = sed_zero()
                            w.e[k as usize] = 1.0
                            w.e[l as usize] = sign2

                            let product = sed_mul(z, w)
                            let pn = sed_norm(product)

                            if pn < 1e-9 {
                                found = found + 1
                                if found <= 20 {
                                    print("  ZERO DIVISOR #"); print(found)
                                    print(": (e"); print(i)
                                    if sign1 > 0.0 { print("+e") } else { print("-e") }
                                    print(j); print(")(e"); print(k)
                                    if sign2 > 0.0 { print("+e") } else { print("-e") }
                                    print(l); print(") = 0  ||prod||=")
                                    print_f4(pn); println("")
                                }
                            }

                            s2 = s2 + 1
                        }
                        s1 = s1 + 1
                    }
                    l = l + 1
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    println("")
    print("  Total zero-divisor pairs found: "); println(found)

    if found > 0 {
        println("")
        println("  Zero divisors CONFIRMED in this Cayley-Dickson convention.")
        println("  The Moreno indices differ from the standard reference")
        println("  because our Fano plane uses triples (1,2,4)(2,3,5)...")
        println("  instead of the (1,2,3)(1,4,5)... convention.")
    } else {
        println("")
        println("  NO zero-divisor pairs found in basis search.")
        println("  The violation may require 3+ term sums or different search.")
    }

    0
}
