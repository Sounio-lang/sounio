// examples/physics/em_demo.sio
// Real E2E demo of EM with epistemic + units

use physics::em;
use epistemic::knowledge::Epistemic;

fn main() -> i32 with IO, Mut, Div, Panic {
    // Electron charge ~1.6e-19, field of point charge at 1nm
    let q = Epistemic::measured(1.6e-19, 0.0);
    let (e, ue) = em::point_charge_e_field(q.val(), q.std(), 1e-9, 0.0);
    println("E at 1nm from e: {} +/- {}", e, ue);

    // Poynting for wave E=100 V/m , B~E/c but use numbers
    let (s, us) = em::poynting(100.0, 1.0, 3.33e-7, 1e-9);
    println("S for E=100V/m: {} +/- {}", s, us);

    println("EM demo (computations done)");
    return 0
}