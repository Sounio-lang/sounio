// examples/physics/thermo_demo.sio
// Real E2E thermo with epistemic

use physics::thermo::{ideal_gas_p, carnot_efficiency};
use epistemic::knowledge::Epistemic;

fn main() -> i32 with IO, Mut, Div, Panic {
    let n = Epistemic::measured(1.0, 0.001);
    let t = Epistemic::measured(300.0, 0.1);
    let v = Epistemic::measured(0.024, 0.0001);
    let (p, up) = ideal_gas_p(n.val(), n.std(), t.val(), t.std(), v.val(), v.std());
    println("P for 1mol 300K 24L: {} +/- {}", p, up);

    let (eta, ueta) = carnot_efficiency(600.0, 1.0, 300.0, 1.0);
    println("Carnot eta: {} +/- {}", eta, ueta);

    println("Thermo demo (computations done)");
    return 0
}