//@ run-pass
//@ description: sedenion Artin probe fails; octonion embedding still vanishes
//
// Alternativity: [a,a,v] = (aa)v − a(av). Octonions satisfy it (Artin).
// Sedenions do not. Same two left-multiplication protocols as
// sedenion_action / octonion_action. Witness a=e1+e10, v=e4
// (Madaros nsq=4). Control: Artin pair embedded from O.
//
// Not consciousness. Not g-2. No new product.
//
// Run:
//   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib
//   ./bin/souc run examples/physics/sedenion_artin.sio

use algebra::octonion::{oct_basis}
use algebra::sedenion_action::{
    sed_embed_oct, sed_lmul_artin_nsq, sed_artin_witness_a, sed_artin_witness_v,
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var a: [f64; 16] = [0.0; 16]
    var v: [f64; 16] = [0.0; 16]
    sed_artin_witness_a(&!a)
    sed_artin_witness_v(&!v)
    let nsq_sed = sed_lmul_artin_nsq(&a, &v)

    var art_a = oct_basis(1)
    var art_v = oct_basis(2)
    art_a[4] = 1.0
    art_v[5] = 1.0
    var art_ae: [f64; 16] = [0.0; 16]
    var art_ve: [f64; 16] = [0.0; 16]
    sed_embed_oct(&art_a, &!art_ae)
    sed_embed_oct(&art_v, &!art_ve)
    let nsq_oct = sed_lmul_artin_nsq(&art_ae, &art_ve)

    print("ARTIN_SED_NSQ ")
    print_f64(nsq_sed)
    print("\nARTIN_OCT_EMBED_NSQ ")
    print_f64(nsq_oct)
    print("\n")

    var ok: i64 = 1
    if abs_f(nsq_sed - 4.0) > 1.0e-9 { ok = 0 }
    if nsq_oct > 1.0e-9 { ok = 0 }

    print("VERDICT_SED_ARTIN_FAILS ")
    if nsq_sed > 1.0e-9 { print("1\n") } else { print("0\n") }
    print("VERDICT_OCT_EMBED_ARTIN_HOLDS ")
    if nsq_oct <= 1.0e-9 { print("1\n") } else { print("0\n") }

    if abs_f(nsq_oct) < 0.0 { ok = 0 }
    if ok == 1 { 0 } else { 1 }
}
