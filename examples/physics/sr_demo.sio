// examples/physics/sr_demo.sio
// Real E2E SR with epistemic + compton

use physics::sr::{relativistic_energy, compton_shift};
use epistemic::knowledge::Epistemic;

fn main() -> i32 with IO, Mut, Div, Panic {
    let m = Epistemic::measured(1.0, 0.0);
    let c = 299792458.0;
    let (e, ue) = relativistic_energy(m.val(), m.std(), 0.6 * c, 0.0);
    println("E at 0.6c for 1kg: {} +/- {}", e, ue);

    let (d, ud) = compton_shift(3.1416, 0.0); // 180 deg
    println("Compton shift 180deg: {} +/- {}", d, ud);

    println("SR demo (computations done)");
    return 0
}