//@ run-pass
//!
//! First Sounio witness for geometry beneath the pinned Apple Metal tables.
//! This stage emits geometry only; it does not assert hardware capabilities.

use document::pdf_text::{
    SounioPdfOperatorCensus,
    sounio_pdf_text_operator_census,
    sounio_pdf_text_projection_empty,
    sounio_pdf_line_projection_empty,
    sounio_pdf_text_project,
    sounio_pdf_text_project_lines,
    sounio_pdf_text_projection_digest,
}
use document::pdf_table::{
    SOUNIO_PDF_TABLE_OK,
    sounio_pdf_table_geometry_empty,
    sounio_pdf_table_project_geometry,
    sounio_pdf_table_cell_projection_empty,
    sounio_pdf_table_project_cells,
    sounio_pdf_table_cell_digest,
}

fn print_inline_int(value: i64) with IO, Mut, Panic, Div {
    if value == 0 { print_char(48); return }
    var remaining = value
    if remaining < 0 { print_char(45); remaining = 0 - remaining }
    var digits: [i64; 20] = [0; 20]
    var count: i64 = 0
    while remaining > 0 {
        digits[count as usize] = remaining % 10
        count = count + 1
        remaining = remaining / 10
    }
    while count > 0 {
        count = count - 1
        print_char(48 + digits[count as usize])
    }
}

fn print_hex_byte(value: i64) with IO, Mut, Panic {
    let high = (value >> 4) & 15
    let low = value & 15
    if high < 10 { print_char(48 + high) } else { print_char(55 + high) }
    if low < 10 { print_char(48 + low) } else { print_char(55 + low) }
}

fn print_operator_name(
    census: &SounioPdfOperatorCensus,
    operator: i64,
) with IO, Mut, Panic {
    var at: i64 = 0
    while at < census.operator_length[operator as usize] {
        print_char(census.operator_bytes[(operator * 16 + at) as usize])
        at = at + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    if arg_count() != 1 {
        print("usage: pireus_apple_metal_table_cells <Metal-Feature-Set-Tables.pdf>\n")
        return 2
    }

    var projection = sounio_pdf_text_projection_empty()
    let project_error = sounio_pdf_text_project(get_arg(0), &!projection)
    var lines = sounio_pdf_line_projection_empty()
    let line_error = sounio_pdf_text_project_lines(&projection, &!lines)
    let digest = sounio_pdf_text_projection_digest(&projection, &lines)
    let expected_digest: [i64; 32] = [
        0xae, 0xbd, 0xea, 0x50, 0x34, 0xdc, 0x20, 0x20,
        0x1e, 0xdf, 0x55, 0x5b, 0xbb, 0x25, 0x7e, 0x29,
        0x71, 0xeb, 0x86, 0x12, 0x7b, 0xe6, 0x02, 0xe6,
        0x30, 0xbe, 0x11, 0x35, 0x56, 0x4f, 0x93, 0xf8
    ]
    var digest_match = digest.error == 0
    var byte: i64 = 0
    while byte < 32 {
        if digest.bytes[byte as usize] != expected_digest[byte as usize] {
            digest_match = false
        }
        byte = byte + 1
    }
    print("PIREUS_PARENT error="); print_inline_int(project_error)
    print(" line_error="); print_inline_int(line_error)
    print(" sha256=")
    byte = 0
    while byte < 32 {
        print_hex_byte(digest.bytes[byte as usize])
        byte = byte + 1
    }
    print(" expected="); if digest_match { print("1") } else { print("0") }
    print("\n")
    if project_error != 0 || line_error != 0 || !digest_match { return 3 }

    let operators = sounio_pdf_text_operator_census(get_arg(0))
    print("PIREUS_OPERATORS error="); print_inline_int(operators.error)
    print(" distinct="); print_inline_int(operators.distinct_operators)
    print("\n")
    var operator: i64 = 0
    while operator < operators.distinct_operators {
        print("PIREUS_OPERATOR name=")
        print_operator_name(&operators, operator)
        print(" count="); print_inline_int(operators.operator_count[operator as usize])
        print("\n")
        operator = operator + 1
    }

    var geometry = sounio_pdf_table_geometry_empty()
    let geometry_error = sounio_pdf_table_project_geometry(
        get_arg(0), &!geometry)
    print("PIREUS_GEOMETRY error="); print_inline_int(geometry_error)
    print(" base_error="); print_inline_int(geometry.base_error)
    print(" pages="); print_inline_int(geometry.pages)
    print(" bytes="); print_inline_int(geometry.decoded_bytes)
    print(" operators="); print_inline_int(geometry.operators)
    print(" q="); print_inline_int(geometry.graphics_saves)
    print(" Q="); print_inline_int(geometry.graphics_restores)
    print(" cm="); print_inline_int(geometry.matrix_concats)
    print(" re="); print_inline_int(geometry.rectangles)
    print(" m="); print_inline_int(geometry.move_tos)
    print(" l="); print_inline_int(geometry.line_tos)
    print(" h="); print_inline_int(geometry.close_paths)
    print(" curves="); print_inline_int(geometry.curve_tos)
    print(" paints="); print_inline_int(geometry.paint_paths)
    print(" clips="); print_inline_int(geometry.clip_paths)
    print(" stroke_segments="); print_inline_int(geometry.stroke_segments)
    print(" fill_segments="); print_inline_int(geometry.fill_segments)
    print(" fill_stroke_segments=")
    print_inline_int(geometry.fill_stroke_segments)
    print(" discarded_segments=")
    print_inline_int(geometry.discarded_segments)
    print(" fill_paths="); print_inline_int(geometry.fill_paths)
    print(" filled_rectangles="); print_inline_int(geometry.filled_rectangles)
    print(" nonrectangular_fills=")
    print_inline_int(geometry.nonrectangular_fills)
    print(" segments="); print_inline_int(geometry.segments)
    print(" horizontal="); print_inline_int(geometry.horizontal_segments)
    print(" vertical="); print_inline_int(geometry.vertical_segments)
    print(" oblique="); print_inline_int(geometry.oblique_segments)
    print(" quantized="); print_inline_int(geometry.quantized_numbers)
    print(" depth="); print_inline_int(geometry.max_graphics_depth)
    print(" scan_page="); print_inline_int(geometry.scan_page)
    print(" scan_offset="); print_inline_int(geometry.scan_offset)
    print(" scan_stack="); print_inline_int(geometry.scan_stack)
    print(" scan_operator=")
    var scan_byte: i64 = 0
    while scan_byte < geometry.scan_operator_length && scan_byte < 16 {
        print_char(geometry.scan_operator_bytes[scan_byte as usize])
        scan_byte = scan_byte + 1
    }
    print("\n")
    var page: i64 = 0
    while page < geometry.pages {
        print("PIREUS_PAGE page="); print_inline_int(page)
        print(" segments=")
        print_inline_int(geometry.page_segment_count[page as usize])
        print(" stroke_h=")
        print_inline_int(geometry.page_stroke_horizontal[page as usize])
        print(" stroke_v=")
        print_inline_int(geometry.page_stroke_vertical[page as usize])
        print(" fill_h=")
        print_inline_int(geometry.page_fill_horizontal[page as usize])
        print(" fill_v=")
        print_inline_int(geometry.page_fill_vertical[page as usize])
        print(" discarded=")
        print_inline_int(geometry.page_discarded_segments[page as usize])
        print(" filled_rectangles=")
        print_inline_int(geometry.page_filled_rectangles[page as usize])
        print("\n")
        page = page + 1
    }
    var cells = sounio_pdf_table_cell_projection_empty()
    let cell_error = sounio_pdf_table_project_cells(
        &geometry, &projection, &!cells)
    print("PIREUS_CELLS error="); print_inline_int(cell_error)
    print(" pages="); print_inline_int(cells.pages)
    print(" source_rectangles="); print_inline_int(cells.source_rectangles)
    print(" duplicate_rectangles="); print_inline_int(cells.duplicate_rectangles)
    print(" cells="); print_inline_int(cells.cells)
    print(" nonempty="); print_inline_int(cells.nonempty_cells)
    print(" empty="); print_inline_int(cells.empty_cells)
    print(" text_objects="); print_inline_int(cells.text_objects)
    print(" empty_text_objects="); print_inline_int(cells.empty_text_objects)
    print(" assigned="); print_inline_int(cells.assigned_objects)
    print(" unassigned="); print_inline_int(cells.unassigned_objects)
    print(" nested="); print_inline_int(cells.nested_resolutions)
    print(" exact_ties="); print_inline_int(cells.exact_tie_objects)
    print(" containment_matches=")
    print_inline_int(cells.containment_matches)
    print("\n")
    let cell_digest = sounio_pdf_table_cell_digest(
        &digest, &projection, &cells)
    let expected_cell_digest: [i64; 32] = [
        0x66, 0x79, 0x90, 0x6d, 0xee, 0xe2, 0x91, 0xb2,
        0x59, 0x0e, 0xf3, 0x9a, 0x86, 0x45, 0xe4, 0x2a,
        0x1f, 0xe6, 0x50, 0xee, 0x4b, 0x6b, 0xae, 0xfd,
        0x17, 0x28, 0xee, 0x61, 0xee, 0xd6, 0x59, 0xbe
    ]
    var cell_digest_match = cell_digest.error == 0
    byte = 0
    while byte < 32 {
        if cell_digest.bytes[byte as usize] !=
            expected_cell_digest[byte as usize] {
            cell_digest_match = false
        }
        byte = byte + 1
    }
    print("PIREUS_CELL_DIGEST error=")
    print_inline_int(cell_digest.error)
    print(" bytes="); print_inline_int(cell_digest.serialized_bytes)
    print(" sha256=")
    byte = 0
    while byte < 32 {
        print_hex_byte(cell_digest.bytes[byte as usize])
        byte = byte + 1
    }
    print(" expected=")
    if cell_digest_match { print("1") } else { print("0") }
    print("\n")
    if operators.error != 0 || geometry_error != SOUNIO_PDF_TABLE_OK {
        return 4
    }
    if cell_error != SOUNIO_PDF_TABLE_OK { return 5 }
    if cell_digest.error != SOUNIO_PDF_TABLE_OK || !cell_digest_match {
        return 6
    }
    0
}
