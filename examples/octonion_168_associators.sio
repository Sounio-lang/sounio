//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// The 168 Theorem: Octonion Basis Associators and PSL(2,7)
// ═══════════════════════════════════════════════════════════════════════════
//
// For octonion basis elements {e1,...,e7}, the associator is:
//   [ei, ej, ek] = (ei·ej)·ek − ei·(ej·ek)
//
// Claim: Exactly 168 of the 7³ = 343 triples (i,j,k) have nonzero
// associator. This equals |PSL(2,7)|, the order of the simple group
// acting on the Fano plane.
//
// We verify this computationally using the standard Fano plane
// multiplication table for octonions.
// ═══════════════════════════════════════════════════════════════════════════

// Multiplication table: MULT[i*8+j] = product index, SIGN[i*8+j] = ±1
// Convention: e0 = 1 (real unit), e1..e7 = imaginary units
// Fano triples (cyclic → positive): (1,2,4),(2,3,5),(3,4,6),(4,5,7),(5,6,1),(6,7,2),(7,1,3)

var MULT: [i64; 64] = [0; 64]
var SIGN: [i64; 64] = [0; 64]

fn init_table() with Mut {
    // e0 * ei = ei, ei * e0 = ei (identity)
    var i = 0
    while i < 8 {
        MULT[0 * 8 + i] = i
        SIGN[0 * 8 + i] = 1
        MULT[i * 8 + 0] = i
        SIGN[i * 8 + 0] = 1
        i = i + 1
    }

    // ei * ei = -e0 for i=1..7
    i = 1
    while i < 8 {
        MULT[i * 8 + i] = 0
        SIGN[i * 8 + i] = 0 - 1
        i = i + 1
    }

    // Fano triples: (a,b,c) means ea*eb = +ec, eb*ea = -ec
    // (1,2,4), (2,3,5), (3,4,6), (4,5,7), (5,6,1), (6,7,2), (7,1,3)
    var FA: [i64; 7] = [1, 2, 3, 4, 5, 6, 7]
    var FB: [i64; 7] = [2, 3, 4, 5, 6, 7, 1]
    var FC: [i64; 7] = [4, 5, 6, 7, 1, 2, 3]

    var t = 0
    while t < 7 {
        let a = FA[t]
        let b = FB[t]
        let c = FC[t]

        // ea * eb = +ec
        MULT[a * 8 + b] = c
        SIGN[a * 8 + b] = 1

        // eb * ea = -ec (anticommutative)
        MULT[b * 8 + a] = c
        SIGN[b * 8 + a] = 0 - 1

        // eb * ec = +ea (cyclic)
        MULT[b * 8 + c] = a
        SIGN[b * 8 + c] = 1

        // ec * eb = -ea
        MULT[c * 8 + b] = a
        SIGN[c * 8 + b] = 0 - 1

        // ec * ea = +eb (cyclic)
        MULT[c * 8 + a] = b
        SIGN[c * 8 + a] = 1

        // ea * ec = -eb
        MULT[a * 8 + c] = b
        SIGN[a * 8 + c] = 0 - 1

        t = t + 1
    }
}

// Multiply two basis elements: returns (index, sign)
// Result stored in global to avoid struct returns
var RES_IDX: i64 = 0
var RES_SGN: i64 = 0

fn basis_mul(i_idx: i64, i_sgn: i64, j_idx: i64, j_sgn: i64) with Mut {
    // (s1 * ei) * (s2 * ej) = (s1*s2) * (ei * ej)
    RES_IDX = MULT[i_idx * 8 + j_idx]
    RES_SGN = i_sgn * j_sgn * SIGN[i_idx * 8 + j_idx]
}

fn count_associators() -> i64 with Mut, IO {
    var count = 0
    var zero_count = 0
    var i = 1
    while i < 8 {
        var j = 1
        while j < 8 {
            var k = 1
            while k < 8 {
                // Left: (ei * ej) * ek
                basis_mul(i, 1, j, 1)
                let l_tmp_idx = RES_IDX
                let l_tmp_sgn = RES_SGN
                basis_mul(l_tmp_idx, l_tmp_sgn, k, 1)
                let left_idx = RES_IDX
                let left_sgn = RES_SGN

                // Right: ei * (ej * ek)
                basis_mul(j, 1, k, 1)
                let r_tmp_idx = RES_IDX
                let r_tmp_sgn = RES_SGN
                basis_mul(i, 1, r_tmp_idx, r_tmp_sgn)
                let right_idx = RES_IDX
                let right_sgn = RES_SGN

                // Associator nonzero iff left ≠ right
                if left_idx != right_idx {
                    count = count + 1
                } else {
                    if left_sgn != right_sgn {
                        count = count + 1
                    } else {
                        zero_count = zero_count + 1
                    }
                }

                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    print("  Total triples: "); print_int(7 * 7 * 7); print("\n")
    print("  Nonzero associators: "); print_int(count); print("\n")
    print("  Zero associators: "); print_int(zero_count); print("\n")
    count
}

// ─── Verify Fano plane properties ───
fn verify_fano() -> i64 with Mut, IO {
    var pass = 0
    var fail = 0

    // 1. Anticommutativity: ei*ej = -ej*ei for i≠j, i,j≥1
    var anti_ok = 1
    var i = 1
    while i < 8 {
        var j = i + 1
        while j < 8 {
            basis_mul(i, 1, j, 1)
            let fwd_idx = RES_IDX
            let fwd_sgn = RES_SGN
            basis_mul(j, 1, i, 1)
            let rev_idx = RES_IDX
            let rev_sgn = RES_SGN
            if fwd_idx != rev_idx { anti_ok = 0 }
            if fwd_sgn != (0 - rev_sgn) { anti_ok = 0 }
            j = j + 1
        }
        i = i + 1
    }
    if anti_ok == 1 {
        print("  [PASS] Anticommutativity: ei*ej = -ej*ei\n")
        pass = pass + 1
    } else {
        print("  [FAIL] Anticommutativity\n")
        fail = fail + 1
    }

    // 2. Each ei² = -1
    var sq_ok = 1
    i = 1
    while i < 8 {
        basis_mul(i, 1, i, 1)
        if RES_IDX != 0 { sq_ok = 0 }
        if RES_SGN != (0 - 1) { sq_ok = 0 }
        i = i + 1
    }
    if sq_ok == 1 {
        print("  [PASS] ei² = -1 for all i=1..7\n")
        pass = pass + 1
    } else {
        print("  [FAIL] ei²\n")
        fail = fail + 1
    }

    // 3. Moufang identity (one form): (a·(b·a))·c = a·(b·(a·c))
    // Check for specific basis elements
    var moufang_ok = 1
    i = 1
    while i < 4 {
        var j = i + 1
        while j < 5 {
            var k = j + 1
            while k < 6 {
                // Left: (ei·(ej·ei))·ek
                basis_mul(j, 1, i, 1)
                let t1_idx = RES_IDX
                let t1_sgn = RES_SGN
                basis_mul(i, 1, t1_idx, t1_sgn)
                let t2_idx = RES_IDX
                let t2_sgn = RES_SGN
                basis_mul(t2_idx, t2_sgn, k, 1)
                let ml_idx = RES_IDX
                let ml_sgn = RES_SGN

                // Right: ei·(ej·(ei·ek))
                basis_mul(i, 1, k, 1)
                let t3_idx = RES_IDX
                let t3_sgn = RES_SGN
                basis_mul(j, 1, t3_idx, t3_sgn)
                let t4_idx = RES_IDX
                let t4_sgn = RES_SGN
                basis_mul(i, 1, t4_idx, t4_sgn)
                let mr_idx = RES_IDX
                let mr_sgn = RES_SGN

                if ml_idx != mr_idx { moufang_ok = 0 }
                if ml_sgn != mr_sgn { moufang_ok = 0 }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    if moufang_ok == 1 {
        print("  [PASS] Moufang identity: (a(ba))c = a(b(ac))\n")
        pass = pass + 1
    } else {
        print("  [FAIL] Moufang identity\n")
        fail = fail + 1
    }

    // 4. Alternativity: (a·a)·b = a·(a·b) and (a·b)·b = a·(b·b)
    var alt_ok = 1
    i = 1
    while i < 8 {
        j = 1
        while j < 8 {
            // Left alt: (ei·ei)·ej = ei·(ei·ej)
            basis_mul(i, 1, i, 1)
            let la_tmp_idx = RES_IDX
            let la_tmp_sgn = RES_SGN
            basis_mul(la_tmp_idx, la_tmp_sgn, j, 1)
            let la_l_idx = RES_IDX
            let la_l_sgn = RES_SGN
            basis_mul(i, 1, j, 1)
            let la_t2_idx = RES_IDX
            let la_t2_sgn = RES_SGN
            basis_mul(i, 1, la_t2_idx, la_t2_sgn)
            let la_r_idx = RES_IDX
            let la_r_sgn = RES_SGN
            if la_l_idx != la_r_idx { alt_ok = 0 }
            if la_l_sgn != la_r_sgn { alt_ok = 0 }

            // Right alt: (ei·ej)·ej = ei·(ej·ej)
            basis_mul(i, 1, j, 1)
            let ra_tmp_idx = RES_IDX
            let ra_tmp_sgn = RES_SGN
            basis_mul(ra_tmp_idx, ra_tmp_sgn, j, 1)
            let ra_l_idx = RES_IDX
            let ra_l_sgn = RES_SGN
            basis_mul(j, 1, j, 1)
            let ra_t2_idx = RES_IDX
            let ra_t2_sgn = RES_SGN
            basis_mul(i, 1, ra_t2_idx, ra_t2_sgn)
            let ra_r_idx = RES_IDX
            let ra_r_sgn = RES_SGN
            if ra_l_idx != ra_r_idx { alt_ok = 0 }
            if ra_l_sgn != ra_r_sgn { alt_ok = 0 }
            j = j + 1
        }
        i = i + 1
    }
    if alt_ok == 1 {
        print("  [PASS] Alternativity: (aa)b = a(ab), (ab)b = a(bb)\n")
        pass = pass + 1
    } else {
        print("  [FAIL] Alternativity\n")
        fail = fail + 1
    }

    pass
}

// ─── Binary {0,2} norm property ───
fn verify_binary_norms() -> i64 with Mut, IO {
    // For nonzero associators [ei,ej,ek], the result is always ±2·em
    // (norm = 2). Zero associators have norm 0. So: {0, 2} only.
    var pass = 0
    var all_binary = 1
    var i = 1
    while i < 8 {
        var j = 1
        while j < 8 {
            var k = 1
            while k < 8 {
                // Left: (ei * ej) * ek
                basis_mul(i, 1, j, 1)
                let l_tmp_idx = RES_IDX
                let l_tmp_sgn = RES_SGN
                basis_mul(l_tmp_idx, l_tmp_sgn, k, 1)
                let left_idx = RES_IDX
                let left_sgn = RES_SGN

                // Right: ei * (ej * ek)
                basis_mul(j, 1, k, 1)
                let r_tmp_idx = RES_IDX
                let r_tmp_sgn = RES_SGN
                basis_mul(i, 1, r_tmp_idx, r_tmp_sgn)
                let right_idx = RES_IDX
                let right_sgn = RES_SGN

                // Associator = left - right
                // If same index, coeff = left_sgn - right_sgn ∈ {-2, 0, 2}
                // If different index, we have two terms (always ±1 each)
                if left_idx == right_idx {
                    let diff = left_sgn - right_sgn
                    if diff != 0 {
                        if diff != 2 {
                            if diff != (0 - 2) {
                                all_binary = 0
                            }
                        }
                    }
                } else {
                    // Two different basis elements, each with coeff ±1
                    // Norm² = 1 + 1 = 2, but this shouldn't happen for basis
                    // Actually for basis associators with same idx, diff is always 0 or ±2
                    // Different idx means the products land on different basis elements
                    // This CAN happen — norm² = 2 in that case
                    // Just verify coefficients are ±1
                    if left_sgn != 1 {
                        if left_sgn != (0 - 1) { all_binary = 0 }
                    }
                    if right_sgn != 1 {
                        if right_sgn != (0 - 1) { all_binary = 0 }
                    }
                }

                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    if all_binary == 1 {
        print("  [PASS] Binary norm property: all associators have norm in {0, 2}\n")
        pass = pass + 1
    } else {
        print("  [FAIL] Binary norm property\n")
    }
    pass
}

// ─── Symmetry: associator is fully antisymmetric ───
fn verify_antisymmetry() -> i64 with Mut, IO {
    var ok = 1
    var checked = 0
    var i = 1
    while i < 6 {
        var j = i + 1
        while j < 7 {
            var k = j + 1
            while k < 8 {
                // Compute [ei,ej,ek]
                basis_mul(i, 1, j, 1)
                let ab_idx = RES_IDX
                let ab_sgn = RES_SGN
                basis_mul(ab_idx, ab_sgn, k, 1)
                let l_idx = RES_IDX
                let l_sgn = RES_SGN
                basis_mul(j, 1, k, 1)
                let bc_idx = RES_IDX
                let bc_sgn = RES_SGN
                basis_mul(i, 1, bc_idx, bc_sgn)
                let r_idx = RES_IDX
                let r_sgn = RES_SGN

                // Compute [ej,ei,ek] — swap first two → should negate
                basis_mul(j, 1, i, 1)
                let ab2_idx = RES_IDX
                let ab2_sgn = RES_SGN
                basis_mul(ab2_idx, ab2_sgn, k, 1)
                let l2_idx = RES_IDX
                let l2_sgn = RES_SGN
                basis_mul(i, 1, k, 1)
                let ik_idx = RES_IDX
                let ik_sgn = RES_SGN
                basis_mul(j, 1, ik_idx, ik_sgn)
                let r2_idx = RES_IDX
                let r2_sgn = RES_SGN

                // [ei,ej,ek] = (l_sgn - r_sgn) * e_{l_idx}  (when l_idx==r_idx)
                // [ej,ei,ek] = (l2_sgn - r2_sgn) * e_{l2_idx}
                // Should be negation
                if l_idx == r_idx {
                    let d1 = l_sgn - r_sgn
                    if l2_idx == r2_idx {
                        let d2 = l2_sgn - r2_sgn
                        if d1 + d2 != 0 { ok = 0 }
                    }
                }
                checked = checked + 1

                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    if ok == 1 {
        print("  [PASS] Antisymmetry: [ei,ej,ek] = -[ej,ei,ek] ("); print_int(checked); print(" triples)\n")
    } else {
        print("  [FAIL] Antisymmetry\n")
    }
    ok
}

fn main() -> i32 with IO, Mut {
    print("═══════════════════════════════════════════════════════════════\n")
    print("  The 168 Theorem: Octonion Basis Associators\n")
    print("═══════════════════════════════════════════════════════════════\n\n")

    init_table()

    print("--- Fano Plane Verification ---\n")
    let fano_pass = verify_fano()

    print("\n--- 168 Associator Count ---\n")
    let count = count_associators()

    print("\n--- Binary Norm Property ---\n")
    let bin_pass = verify_binary_norms()

    print("\n--- Antisymmetry ---\n")
    let anti_pass = verify_antisymmetry()

    print("\n═══════════════════════════════════════════════════════════════\n")
    print("  RESULTS\n")
    print("═══════════════════════════════════════════════════════════════\n")

    var total_pass = fano_pass + bin_pass + anti_pass
    var total_fail = (4 - fano_pass) + (1 - bin_pass) + (1 - anti_pass)
    if count == 168 {
        print("  [PASS] 168 nonzero associators = |PSL(2,7)|\n")
        total_pass = total_pass + 1
    } else {
        print("  [FAIL] Expected 168, got "); print_int(count); print("\n")
        total_fail = total_fail + 1
    }

    print("\nPassed: "); print_int(total_pass); print("\nFailed: "); print_int(total_fail); print("\n")
    if total_fail == 0 { println("ALL PASS") }
    else { println("SOME FAILED") }
    0
}
