// ─── A-matrix construction (same as all S-SSM experiments) ───────────────────

fn make_a(alpha: f64) -> Sedenion with Div, Panic {
    let zd: Sedenion = sed_known_zero_divisor()
    let zd_n: Sedenion = sed_normalize(zd)
    let ag_raw: Sedenion = sed_add(sed_basis(0, 1.0), sed_basis(1, 1.0))
    let a_generic: Sedenion = sed_normalize(ag_raw)
    sed_normalize(sed_lerp(a_generic, zd_n, alpha))
}

// ─── S-SSM state storage (shared by both SSM variants) ───────────────────────

var H0:  [f64; 64] = [0.0; 64]
var H1:  [f64; 64] = [0.0; 64]
var H2:  [f64; 64] = [0.0; 64]
var H3:  [f64; 64] = [0.0; 64]
var H4:  [f64; 64] = [0.0; 64]
var H5:  [f64; 64] = [0.0; 64]
var H6:  [f64; 64] = [0.0; 64]
var H7:  [f64; 64] = [0.0; 64]
var H8:  [f64; 64] = [0.0; 64]
var H9:  [f64; 64] = [0.0; 64]
var H10: [f64; 64] = [0.0; 64]
var H11: [f64; 64] = [0.0; 64]
var H12: [f64; 64] = [0.0; 64]
var H13: [f64; 64] = [0.0; 64]
var H14: [f64; 64] = [0.0; 64]
var H15: [f64; 64] = [0.0; 64]

var LH0:  f64 = 0.0
var LH1:  f64 = 0.0
var LH2:  f64 = 0.0
var LH3:  f64 = 0.0
var LH4:  f64 = 0.0
var LH5:  f64 = 0.0
var LH6:  f64 = 0.0
var LH7:  f64 = 0.0
var LH8:  f64 = 0.0
var LH9:  f64 = 0.0
var LH10: f64 = 0.0
var LH11: f64 = 0.0
var LH12: f64 = 0.0
var LH13: f64 = 0.0
var LH14: f64 = 0.0
var LH15: f64 = 0.0

fn save_h(t: i64, h: Sedenion) with Mut {
    H0[t] = h.e0;   H1[t] = h.e1;   H2[t] = h.e2;   H3[t] = h.e3
    H4[t] = h.e4;   H5[t] = h.e5;   H6[t] = h.e6;   H7[t] = h.e7
    H8[t] = h.e8;   H9[t] = h.e9;   H10[t] = h.e10; H11[t] = h.e11
    H12[t] = h.e12; H13[t] = h.e13; H14[t] = h.e14; H15[t] = h.e15
}

fn save_last_h(h: Sedenion) with Mut {
    LH0 = h.e0;  LH1 = h.e1;  LH2 = h.e2;  LH3 = h.e3
    LH4 = h.e4;  LH5 = h.e5;  LH6 = h.e6;  LH7 = h.e7
    LH8 = h.e8;  LH9 = h.e9;  LH10 = h.e10; LH11 = h.e11
    LH12 = h.e12; LH13 = h.e13; LH14 = h.e14; LH15 = h.e15
}

fn load_last_h() -> Sedenion {
    Sedenion {
        e0: LH0, e1: LH1, e2: LH2, e3: LH3, e4: LH4, e5: LH5, e6: LH6, e7: LH7,
        e8: LH8, e9: LH9, e10: LH10, e11: LH11, e12: LH12, e13: LH13, e14: LH14, e15: LH15
    }
}

// ─── C readout (shared, trained by gradient on TARGET) ────────────────────────

var WC: [i64; 16] = [0; 16]
var GC: [f64; 16] = [0.0; 16]

fn cg(i: i64) -> f64 with Div { (WC[i] as f64) / 100000000.0 }
fn cs(i: i64, v: f64) with Mut { WC[i] = (v * 100000000.0) as i64 }

fn get_c() -> Sedenion with Div {
    Sedenion {
        e0: cg(0), e1: cg(1), e2: cg(2), e3: cg(3),
        e4: cg(4), e5: cg(5), e6: cg(6), e7: cg(7),
        e8: cg(8), e9: cg(9), e10: cg(10), e11: cg(11),
        e12: cg(12), e13: cg(13), e14: cg(14), e15: cg(15)
    }
}

fn init_c() with Mut { var i: i64 = 0; while i < 16 { WC[i] = 0; i = i + 1 } }

fn ssm_update_c(lr: f64) with Mut, Div, Panic {
    let c: Sedenion = get_c()
    var i: i64 = 0
    while i < 16 { GC[i] = 0.0; i = i + 1 }
    var t: i64 = 0
    while t < 64 {
        let ht: Sedenion = Sedenion {
            e0:H0[t], e1:H1[t], e2:H2[t], e3:H3[t],
            e4:H4[t], e5:H5[t], e6:H6[t], e7:H7[t],
            e8:H8[t], e9:H9[t], e10:H10[t], e11:H11[t],
            e12:H12[t], e13:H13[t], e14:H14[t], e15:H15[t]
        }
        let y: f64 = sed_dot(ht, c)
        let err: f64 = y - TARGET[t]
        GC[0]  = GC[0]  + err * H0[t];  GC[1]  = GC[1]  + err * H1[t]
        GC[2]  = GC[2]  + err * H2[t];  GC[3]  = GC[3]  + err * H3[t]
        GC[4]  = GC[4]  + err * H4[t];  GC[5]  = GC[5]  + err * H5[t]
        GC[6]  = GC[6]  + err * H6[t];  GC[7]  = GC[7]  + err * H7[t]
        GC[8]  = GC[8]  + err * H8[t];  GC[9]  = GC[9]  + err * H9[t]
        GC[10] = GC[10] + err * H10[t]; GC[11] = GC[11] + err * H11[t]
        GC[12] = GC[12] + err * H12[t]; GC[13] = GC[13] + err * H13[t]
        GC[14] = GC[14] + err * H14[t]; GC[15] = GC[15] + err * H15[t]
        t = t + 1
    }
    let scale: f64 = lr * 2.0 / 64.0
    i = 0
    while i < 16 { cs(i, cg(i) - scale * GC[i]); i = i + 1 }
}

fn ssm_train_mse() -> f64 with Mut, Div, Panic {
    let c: Sedenion = get_c()
    var local_sum: f64 = 0.0
    var t: i64 = 0
    while t < 64 {
        let ht: Sedenion = Sedenion {
            e0:H0[t], e1:H1[t], e2:H2[t], e3:H3[t],
            e4:H4[t], e5:H5[t], e6:H6[t], e7:H7[t],
            e8:H8[t], e9:H9[t], e10:H10[t], e11:H11[t],
            e12:H12[t], e13:H13[t], e14:H14[t], e15:H15[t]
        }
        let y: f64 = sed_dot(ht, c)
        let err: f64 = y - TARGET[t]
        local_sum = local_sum + err * err
        t = t + 1
    }
    local_sum / 64.0
}

// ─── S-SSM-16ch: sedenion spatial input (the novel architecture) ─────────────

fn ssm16_forward_train(a: Sedenion) with Mut, Div, Panic {
    var h: Sedenion = sed_one()
    var t: i64 = 0
    while t < 64 {
        let xt: Sedenion = Sedenion {
            e0:  CH0[t],  e1:  CH1[t],  e2:  CH2[t],  e3:  CH3[t],
            e4:  CH4[t],  e5:  CH5[t],  e6:  CH6[t],  e7:  CH7[t],
            e8:  CH8[t],  e9:  CH9[t],  e10: CH10[t], e11: CH11[t],
            e12: CH12[t], e13: CH13[t], e14: CH14[t], e15: CH15[t]
        }
        let ah: Sedenion = sed_mul(a, h)
        let raw: Sedenion = sed_add(ah, xt)
        let act: Sedenion = sed_tanh(raw)
        let n: f64 = sed_norm(act)
        var hn: Sedenion = act
        if n > 0.0000001 { hn = sed_scale(act, 1.0 / n) }
        h = hn
        save_h(t, h)
        t = t + 1
    }
    save_last_h(h)
}

fn ssm16_test_mse(a: Sedenion) -> f64 with Mut, Div, Panic {
    let c: Sedenion = get_c()
    var h: Sedenion = load_last_h()
    var local_sum: f64 = 0.0
    var t: i64 = 64
    while t < 80 {
        let xt: Sedenion = Sedenion {
            e0:  CH0[t],  e1:  CH1[t],  e2:  CH2[t],  e3:  CH3[t],
            e4:  CH4[t],  e5:  CH5[t],  e6:  CH6[t],  e7:  CH7[t],
            e8:  CH8[t],  e9:  CH9[t],  e10: CH10[t], e11: CH11[t],
            e12: CH12[t], e13: CH13[t], e14: CH14[t], e15: CH15[t]
        }
        let ah: Sedenion = sed_mul(a, h)
        let raw: Sedenion = sed_add(ah, xt)
        let act: Sedenion = sed_tanh(raw)
        let n: f64 = sed_norm(act)
        var hn: Sedenion = act
        if n > 0.0000001 { hn = sed_scale(act, 1.0 / n) }
        h = hn
        let y: f64 = sed_dot(h, c)
        let err: f64 = y - TARGET[t]
        local_sum = local_sum + err * err
        t = t + 1
    }
    local_sum / 16.0
}

// ─── S-SSM-scalar: only CH0 as input (ablation — no spatial context) ─────────

fn ssm_scalar_forward_train(a: Sedenion, b: Sedenion) with Mut, Div, Panic {
    var h: Sedenion = sed_one()
    var t: i64 = 0
    while t < 64 {
        let x: f64 = CH0[t]
        let ah: Sedenion = sed_mul(a, h)
        let bx: Sedenion = sed_scale(b, x)
        let raw: Sedenion = sed_add(ah, bx)
        let act: Sedenion = sed_tanh(raw)
        let n: f64 = sed_norm(act)
        var hn: Sedenion = act
        if n > 0.0000001 { hn = sed_scale(act, 1.0 / n) }
        h = hn
        save_h(t, h)
        t = t + 1
    }
    save_last_h(h)
}

fn ssm_scalar_test_mse(a: Sedenion, b: Sedenion) -> f64 with Mut, Div, Panic {
    let c: Sedenion = get_c()
    var h: Sedenion = load_last_h()
    var local_sum: f64 = 0.0
    var t: i64 = 64
    while t < 80 {
        let x: f64 = CH0[t]
        let ah: Sedenion = sed_mul(a, h)
        let bx: Sedenion = sed_scale(b, x)
        let raw: Sedenion = sed_add(ah, bx)
        let act: Sedenion = sed_tanh(raw)
        let n: f64 = sed_norm(act)
        var hn: Sedenion = act
        if n > 0.0000001 { hn = sed_scale(act, 1.0 / n) }
        h = hn
        let y: f64 = sed_dot(h, c)
        let err: f64 = y - TARGET[t]
        local_sum = local_sum + err * err
        t = t + 1
    }
    local_sum / 16.0
}

// ─── Real diagonal baseline: 16 AR(1)s, one per channel ──────────────────────

var WA_R: [f64; 16] = [0.0; 16]
var WB_R: [f64; 16] = [0.0; 16]
var WC_R: [i64; 16] = [0; 16]
var H_REAL: [f64; 1024] = [0.0; 1024]
var LAST_HR: [f64; 16] = [0.0; 16]

fn cg_r(i: i64) -> f64 with Div { (WC_R[i] as f64) / 100000000.0 }
fn cs_r(i: i64, v: f64) with Mut { WC_R[i] = (v * 100000000.0) as i64 }

fn init_real() with Mut {
    var i: i64 = 0
    while i < 16 {
        WA_R[i] = 0.85
        WB_R[i] = 0.1
        WC_R[i] = 0
        i = i + 1
    }
}

fn real_forward_train() with Mut, Div, Panic {
    var h: [f64; 16] = [0.0; 16]
    var t: i64 = 0
    while t < 64 {
        var k: i64 = 0
        while k < 16 {
            let ch_val: f64 = if k == 0 { CH0[t] }
                else if k == 1 { CH1[t] }
                else if k == 2 { CH2[t] }
                else if k == 3 { CH3[t] }
                else if k == 4 { CH4[t] }
                else if k == 5 { CH5[t] }
                else if k == 6 { CH6[t] }
                else if k == 7 { CH7[t] }
                else if k == 8 { CH8[t] }
                else if k == 9 { CH9[t] }
                else if k == 10 { CH10[t] }
                else if k == 11 { CH11[t] }
                else if k == 12 { CH12[t] }
                else if k == 13 { CH13[t] }
                else if k == 14 { CH14[t] }
                else { CH15[t] }
            let hk: f64 = WA_R[k] * h[k] + WB_R[k] * ch_val
            h[k] = hk
            H_REAL[(t * 16 + k) as usize] = hk
            k = k + 1
        }
        t = t + 1
    }
    var k: i64 = 0
    while k < 16 { LAST_HR[k] = h[k]; k = k + 1 }
}

fn real_update_c(lr: f64) with Mut, Div, Panic {
    var gc: [f64; 16] = [0.0; 16]
    var t: i64 = 0
    while t < 64 {
        var local_y: f64 = 0.0
        var k: i64 = 0
        while k < 16 { local_y = local_y + cg_r(k) * H_REAL[(t * 16 + k) as usize]; k = k + 1 }
        let err: f64 = local_y - TARGET[t]
        k = 0
        while k < 16 { gc[k] = gc[k] + err * H_REAL[(t * 16 + k) as usize]; k = k + 1 }
        t = t + 1
    }
    let scale: f64 = lr * 2.0 / 64.0
    var k: i64 = 0
    while k < 16 { cs_r(k, cg_r(k) - scale * gc[k]); k = k + 1 }
}

fn real_train_mse() -> f64 with Mut, Div, Panic {
    var local_sum: f64 = 0.0
    var t: i64 = 0
    while t < 64 {
        var local_y: f64 = 0.0
        var k: i64 = 0
        while k < 16 { local_y = local_y + cg_r(k) * H_REAL[(t * 16 + k) as usize]; k = k + 1 }
        let err: f64 = local_y - TARGET[t]
        local_sum = local_sum + err * err
        t = t + 1
    }
    local_sum / 64.0
}

fn real_test_mse() -> f64 with Mut, Div, Panic {
    var h: [f64; 16] = [0.0; 16]
    var k: i64 = 0
    while k < 16 { h[k] = LAST_HR[k]; k = k + 1 }
    var local_sum: f64 = 0.0
    var t: i64 = 64
    while t < 80 {
        k = 0
        while k < 16 {
            let ch_val: f64 = if k == 0 { CH0[t] }
                else if k == 1 { CH1[t] }
                else if k == 2 { CH2[t] }
                else if k == 3 { CH3[t] }
                else if k == 4 { CH4[t] }
                else if k == 5 { CH5[t] }
                else if k == 6 { CH6[t] }
                else if k == 7 { CH7[t] }
                else if k == 8 { CH8[t] }
                else if k == 9 { CH9[t] }
                else if k == 10 { CH10[t] }
                else if k == 11 { CH11[t] }
                else if k == 12 { CH12[t] }
                else if k == 13 { CH13[t] }
                else if k == 14 { CH14[t] }
                else { CH15[t] }
            h[k] = WA_R[k] * h[k] + WB_R[k] * ch_val
            k = k + 1
        }
        var local_y: f64 = 0.0
        k = 0
        while k < 16 { local_y = local_y + cg_r(k) * h[k]; k = k + 1 }
        let err: f64 = local_y - TARGET[t]
        local_sum = local_sum + err * err
        t = t + 1
    }
    local_sum / 16.0
}

// ─── Target variance (zero-predictor MSE on train) ───────────────────────────

fn target_variance() -> f64 with Mut, Div, Panic {
    var local_sum: f64 = 0.0
    var t: i64 = 0
    while t < 64 { local_sum = local_sum + TARGET[t] * TARGET[t]; t = t + 1 }
    local_sum / 64.0
}

// ─── Main ────────────────────────────────────────────────────────────────────

fn main() -> i32 with IO, Mut, Div, Panic {
    init_eeg_16ch()

    let a02: Sedenion = make_a(0.2)
    let b: Sedenion = sed_one()

    println("═══════════════════════════════════════════════════════")
    println("  Exp 13: S-SSM 16-channel sedenion spatial embedding")
    println("  TARGET = CH0[t+1] (Fc5)  train=64  test=16 @ 160 Hz")
    println("  Cross-channel corr mean=0.763  max=0.897 (Fcz)")
    println("═══════════════════════════════════════════════════════")
    println("")

    let var_target: f64 = target_variance()
    print("  Target variance (zero-pred MSE) = "); print(var_target); println("")
    println("")

    // ── S-SSM-16ch ────────────────────────────────────────────────────────────
    init_c()
    var ep: i64 = 0
    while ep < 100 { ssm16_forward_train(a02); ssm_update_c(1.0); ep = ep + 1 }
    ssm16_forward_train(a02)
    let s16_train: f64 = ssm_train_mse()
    let s16_test:  f64 = ssm16_test_mse(a02)
    print("  S-SSM-16ch  α=0.2  train="); print(s16_train)
    print("  test="); print(s16_test); println("")

    // ── S-SSM-scalar ─────────────────────────────────────────────────────────
    init_c()
    ep = 0
    while ep < 100 { ssm_scalar_forward_train(a02, b); ssm_update_c(1.0); ep = ep + 1 }
    ssm_scalar_forward_train(a02, b)
    let s1_train: f64 = ssm_train_mse()
    let s1_test:  f64 = ssm_scalar_test_mse(a02, b)
    print("  S-SSM-scalar α=0.2  train="); print(s1_train)
    print("  test="); print(s1_test); println("")

    // ── Real-16ch ────────────────────────────────────────────────────────────
    init_real()
    ep = 0
    while ep < 100 { real_forward_train(); real_update_c(1.0); ep = ep + 1 }
    real_forward_train()
    let r16_train: f64 = real_train_mse()
    let r16_test:  f64 = real_test_mse()
    print("  Real-16ch (diag AR)  train="); print(r16_train)
    print("  test="); print(r16_test); println("")
    println("")

    let spatial_gain_test: f64 = s1_test - s16_test
    let s16_gap:  f64 = s16_test  - s16_train
    let r16_gap:  f64 = r16_test  - r16_train
    print("  Spatial gain on test (scalar - 16ch) = "); print(spatial_gain_test); println("")
    print("  S-SSM-16ch  gap (test - train) = "); print(s16_gap); println("")
    print("  Real-16ch   gap (test - train) = "); print(r16_gap); println("")
    println("")

    var passed: i32 = 0
    var failed: i32 = 0

    // T1: target has non-trivial variance
    if var_target > 0.02 {
        print("T1 PASS: target variance="); print(var_target); println("")
        passed = passed + 1
    } else {
        print("T1 FAIL: target variance="); print(var_target); println("")
        failed = failed + 1
    }

    // T2: S-SSM-16ch beats zero predictor on train
    if s16_train < var_target {
        print("T2 PASS: S-SSM-16ch train="); print(s16_train); println("")
        passed = passed + 1
    } else {
        print("T2 FAIL: S-SSM-16ch train="); print(s16_train); println("")
        failed = failed + 1
    }

    // T3: Real-16ch beats zero predictor on train
    if r16_train < var_target {
        print("T3 PASS: Real-16ch train="); print(r16_train); println("")
        passed = passed + 1
    } else {
        print("T3 FAIL: Real-16ch train="); print(r16_train); println("")
        failed = failed + 1
    }

    // T4: S-SSM-16ch generalizes better than Real-16ch (G2 regularization)
    if s16_gap < r16_gap {
        print("T4 PASS: 16ch gap "); print(s16_gap)
        print(" < real gap "); print(r16_gap)
        println(" (G2 regularizes multi-channel input)")
        passed = passed + 1
    } else {
        print("T4 FAIL: 16ch gap "); print(s16_gap)
        print(" >= real gap "); print(r16_gap); println("")
        failed = failed + 1
    }

    // T5: All MSEs finite (in [0, 5))
    var ok: bool = true
    if s16_train < 0.0 { ok = false }  if s16_train > 5.0 { ok = false }
    if s16_test  < 0.0 { ok = false }  if s16_test  > 5.0 { ok = false }
    if s1_train  < 0.0 { ok = false }  if s1_train  > 5.0 { ok = false }
    if s1_test   < 0.0 { ok = false }  if s1_test   > 5.0 { ok = false }
    if r16_train < 0.0 { ok = false }  if r16_train > 5.0 { ok = false }
    if r16_test  < 0.0 { ok = false }  if r16_test  > 5.0 { ok = false }
    if ok {
        println("T5 PASS: all MSE in [0, 5)")
        passed = passed + 1
    } else {
        println("T5 FAIL: some MSE out of range")
        failed = failed + 1
    }

    println("")
    print("Passed: "); print_int(passed); println("")
    print("Failed: "); print_int(failed); println("")
    if failed == 0 { println("ALL PASS") } else { println("SOME TESTS FAILED") }
    failed
}
