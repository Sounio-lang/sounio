//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// Exp 13: S-SSM 16-channel spatial embedding
// ═══════════════════════════════════════════════════════════════════════════
//
// Each sedenion component carries one EEG electrode (fronto-central strip).
// Prediction task: CH0[t+1] (Fc5) from all 16 channels at time t.
//
// Three-way comparison:
//   S-SSM-16ch (α=0.2): sedenion state + sedenion spatial input (all 16 ch)
//   S-SSM-scalar       : sedenion state + scalar input CH0[t] only
//   Real-16ch          : 16 parallel AR(1)s, one per channel, shared readout
//
// Data: EEGMMIDB S001R01, fronto-central strip, window [2000..2080] @ 160 Hz.
// Train=64, test=16 samples.  Cross-channel corr mean=0.763, max=0.897 (Fcz).
//
// Key question: does G₂-gated sedenion mixing of spatial channels improve
// prediction of CH0 beyond having CH0 alone?

use math::sedenion::*;

// ─── Math helpers ────────────────────────────────────────────────────────────

fn sqrt_s(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y: f64 = x
    var i: i64 = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn abs_s(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn exp_s(x: f64) -> f64 with Mut, Div, Panic {
    if x > 20.0 { return exp_s(10.0) * exp_s(x - 10.0) }
    if x < 0.0 - 20.0 { return 0.0 }
    var s: f64 = 1.0
    var term: f64 = 1.0
    var i: i64 = 1
    while i <= 20 { term = term * x / (i as f64); s = s + term; i = i + 1 }
    s
}

fn tanh_s(x: f64) -> f64 with Mut, Div, Panic {
    if x > 10.0 { return 1.0 }
    if x < 0.0 - 10.0 { return 0.0 - 1.0 }
    let e2 = exp_s(2.0 * x)
    (e2 - 1.0) / (e2 + 1.0)
}

