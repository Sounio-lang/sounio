// Example: Source-level kernel compilation via HLIR→GPU lowering pipeline
//
// Demonstrates the syntax for kernel functions that will be lowered through
// hlir_to_gpu.sio using gpu.thread_id.x, gpu.block_id.x, gpu.sync_threads(),
// and the standard 1D global index pattern.
//
// Pipeline: Source → HLIR (SSA) → hlir_to_gpu → GpuKernelIr → PTX/Metal/SPIR-V
//
// GPU builtins available in kernel fn bodies:
//   gpu.thread_id.x  → GpuGetTid  axis=0
//   gpu.thread_id.y  → GpuGetTid  axis=1
//   gpu.block_id.x   → GpuGetBid  axis=0
//   gpu.block_dim.x  → GpuGetNtid axis=0
//   gpu.sync_threads → GpuBarrierSync
//
// Usage:
//   souc check examples/kernel_source_level.sio

kernel fn vec_scale(n: i64) with GPU, Div, Mut, Panic {
    var i: i64 = 0
    while i < n {
        i = i + 1
    }
}

fn main() -> i32 with IO {
    0
}
