// Kretikos GPU Compiler — Bare-Metal Kernel Example
//
// This example demonstrates total control over GPU thread indexing.
// Every thread computes its own global ID using bare-metal builtins.
// No hidden runtime. No opaque abstractions. You see every instruction.
//
// Kretikos (Κρητικός) = Cretan. Like Ariadne's thread through the Labyrinth,
// these builtins give you a direct line to every warp, every block, every thread.
//
// Bare-metal builtins available in kernel fn bodies:
//   gpu_thread_id_x()  → thread index within block (x axis)
//   gpu_thread_id_y()  → thread index within block (y axis)
//   gpu_thread_id_z()  → thread index within block (z axis)
//   gpu_block_id_x()   → block index within grid (x axis)
//   gpu_block_id_y()   → block index within grid (y axis)
//   gpu_block_id_z()   → block index within grid (z axis)
//   gpu_block_dim_x()  → number of threads per block (x axis)
//   gpu_block_dim_y()  → number of threads per block (y axis)
//   gpu_block_dim_z()  → number of threads per block (z axis)
//   gpu_sync_threads() → intra-block barrier (all threads wait)
//
// Compile and run:
//   souc examples/kernel_source_level.sio /tmp/kretikos_demo.elf
//   /tmp/kretikos_demo.elf
//
// Build PTX (requires GPU profile compiler):
//   souc-linux-x86_64-gpu build examples/kernel_source_level.sio --backend gpu -o /tmp/kretikos_demo.ptx

// ============================================================================
// Kernel: verify_indexing
//
// Each thread computes its global ID and verifies the math is correct.
// In CPU fallback mode, the kernel runs once with thread_id=0, block_id=0.
// On real GPU hardware, every thread executes this independently in parallel.
// ============================================================================
kernel fn verify_indexing(n: i64) with GPU, Panic {
    let tid_x = gpu_thread_id_x()
    let tid_y = gpu_thread_id_y()
    let tid_z = gpu_thread_id_z()
    let bid_x = gpu_block_id_x()
    let bid_y = gpu_block_id_y()
    let bid_z = gpu_block_id_z()
    let bdim_x = gpu_block_dim_x()
    let bdim_y = gpu_block_dim_y()
    let bdim_z = gpu_block_dim_z()

    // Classic CUDA global index formula, extended to 3D
    // global_id = ((bid_z * bdim_y + bid_y) * bdim_x + bid_x) * (bdim_x * bdim_y * bdim_z) + (tid_z * bdim_y + tid_y) * bdim_x + tid_x
    // Simplified for the common 1D case:
    let global_id = bid_x * bdim_x + tid_x

    // Bounds check: threads beyond the problem size exit early
    // This is the standard CUDA "guard" pattern
    if global_id >= n {
        return
    }

    // Verify thread IDs are non-negative (always true on real hardware)
    if tid_x < 0 { return }
    if tid_y < 0 { return }
    if tid_z < 0 { return }
    if bid_x < 0 { return }
    if bid_y < 0 { return }
    if bid_z < 0 { return }

    // In a real kernel, this thread would now process element [global_id]
    // of the input/output arrays. No driver hiding the indexing. No runtime
    // inserting hidden bounds checks. You control every load and store.
}

// ============================================================================
// Kernel: scale_element
//
// Demonstrates the full bare-metal pattern:
// 1. Compute global thread ID
// 2. Check bounds
// 3. Perform work (here: just arithmetic on scalar params)
// 4. Sync threads before any cross-thread communication
// ============================================================================
kernel fn scale_element(scale: f64, n: i64) with GPU, Div {
    let tid = gpu_thread_id_x()
    let bid = gpu_block_id_x()
    let bdim = gpu_block_dim_x()
    let i = bid * bdim + tid

    if i >= n {
        return
    }

    // Each thread computes scale * (i + 1) for its assigned element
    let value = scale * ((i + 1) as f64)

    // In production code, value would be stored to an output array:
    //   out[i] = value
    // Kretikos gives you direct control over the store instruction.

    // Barrier: ensure all threads reach this point before proceeding
    gpu_sync_threads()
}

// ============================================================================
// Main: launch kernels and report
// ============================================================================
fn main() -> i32 with IO, GPU {
    let n: i64 = 1024
    let grid = (16, 1, 1)
    let block = (64, 1, 1)

    // Launch verify_indexing kernel
    perform GPU.launch(verify_indexing, grid, block)(n)
    perform GPU.sync()

    // Launch scale_element kernel
    perform GPU.launch(scale_element, grid, block)(2.5, n)
    perform GPU.sync()

    println("Kretikos GPU Compiler — bare-metal demo complete")
    println("Launched 2 kernels with full thread indexing control")
    println("Grid: 16 blocks × 64 threads = 1024 total threads")
    println("In CPU fallback: kernel runs once (serial execution)")
    println("On GPU hardware: each thread runs independently in parallel")

    0
}
