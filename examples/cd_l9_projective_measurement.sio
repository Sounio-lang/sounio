//@ run-pass
//! examples/cd_l9_projective_measurement.sio
//!
//! Cayley-Dickson level 9 projective measurement (dim 512).
//!
//!   ℝ → ℂ → ℍ → 𝕆 → 𝕊 → 𝕋 → 𝕀 → L7 → L8 → L9
//!  d 1   2   4   8   16   32   64  128  256  512
//!
//! Sixth rung of the projective-measurement ladder (siblings: 16b6ad3ea
//! L4, 729bce515 L5, e072bc74e L6, c680f083b L7, f686a4a4c L8).
//! Requires the k≤9 CDElement from 3bed334a8 (c widened to 512).
//!
//! Two separate claims, kept methodologically distinct:
//!   (A) Tower-lifted zero-divisors double their kernel each rung —
//!       PREDICTIONS, asserted.  A miss is a 512-D Gauss/codegen bug
//!       (or a broken doubling assumption), not new algebra.
//!   (B) The conjectured native-erasure curve at a 6th point — the L9
//!       native family e_3 + e_(half+2) = e_3 + e_258 is MEASURED, never
//!       asserted, no index hunting.  Conjecture (c680f083b):
//!         ker_native(L_n) = 2^(n-1) - 4,
//!       so ker_native(L9) = 2^8 - 4 = 252, rank = 260.  A miss is a
//!       refutation/refinement, reported AS the result.
//!
//! Lifted predictions (Schafer L_{(a,0)} doubling of the parent kernel):
//!   (1) A1 = e_3 + e_10   sedenion ×5 lifts  ker→128  rank 384
//!   (2) A2 = e_3 + e_18   pathion  ×4 lifts  ker→192  rank 320
//!   (3) A3 = e_3 + e_34   chingon  ×3 lifts  ker→224  rank 288
//!   (4) A4 = e_3 + e_66   routon   ×2 lifts  ker→240  rank 272
//!   (5) A5 = e_3 + e_130  L8-native ×1 lift  ker→248  rank 264
//!         (parents at L7/L8 were measured; doubling is structural so
//!          the lifted values are still asserted.)
//!   (6) A6 = e_3 + e_258  L9-native              measured     ?
//!   (X) X  = e_1          control                 rank 512
//!
//! No Heisenberg claim: for these zero-divisor generators L_A is real-linear
//! and non-unitary (singular); σ_x σ_p ≥ ℏ/2 is a theorem about unitary
//! evolution.  (The unit control e_1 gives an orthogonal L_{e_1}.)

use algebra::cayley_dickson::{cd_mul, cd_basis, cd_zero, CDElement}

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

// Build the 512x512 matrix where column k = L_z(e_k).  Row-major M[512*i+k].
fn build_left_mult_matrix_512(z: CDElement, out: &![f64; 262144]) with Mut, Div, Panic {
    var k: i64 = 0
    while k < 512 {
        let ek = cd_basis(9, k as i32)
        let prod = cd_mul(z, ek)
        var i: i64 = 0
        while i < 512 {
            (*out)[(512 * i + k) as usize] = prod.c[i as usize]
            i = i + 1
        }
        k = k + 1
    }
}

// Gauss elimination with partial pivoting on a 512x512 in-place matrix.
fn rank_512x512(m: &![f64; 262144], tol: f64) -> i64 with Mut, Div, Panic {
    var rank: i64 = 0
    var row: i64 = 0
    var col: i64 = 0
    while col < 512 && row < 512 {
        var pivot_row: i64 = 0 - 1
        var best: f64 = tol
        var r: i64 = row
        while r < 512 {
            let av = abs_f64((*m)[(512 * r + col) as usize])
            if av > best { best = av; pivot_row = r }
            r = r + 1
        }
        if pivot_row < 0 {
            col = col + 1
        } else {
            if pivot_row != row {
                var j: i64 = 0
                while j < 512 {
                    let a = (*m)[(512 * row + j) as usize]
                    let b = (*m)[(512 * pivot_row + j) as usize]
                    (*m)[(512 * row + j) as usize] = b
                    (*m)[(512 * pivot_row + j) as usize] = a
                    j = j + 1
                }
            }
            let piv = (*m)[(512 * row + col) as usize]
            var rr: i64 = row + 1
            while rr < 512 {
                let factor = (*m)[(512 * rr + col) as usize] / piv
                var j: i64 = col
                while j < 512 {
                    let nv = (*m)[(512 * rr + j) as usize]
                              - factor * (*m)[(512 * row + j) as usize]
                    (*m)[(512 * rr + j) as usize] = nv
                    j = j + 1
                }
                rr = rr + 1
            }
            rank = rank + 1
            row = row + 1
            col = col + 1
        }
    }
    rank
}

// Compute rank(L_A) for A = e_lo + e_hi at level 9.
fn measure(label: i64, idx_lo: i64, idx_hi: i64) -> i64 with IO, Mut, Div, Panic {
    var A: CDElement = cd_zero(9)
    A.c[idx_lo as usize] = 1.0
    A.c[idx_hi as usize] = 1.0
    var M: [f64; 262144] = [0.0; 262144]
    build_left_mult_matrix_512(A, &!M)
    let r = rank_512x512(&!M, 1.0e-10)
    let k = 512 - r
    print("  case "); print(label); print(": A = e_")
    print(idx_lo); print(" + e_"); print(idx_hi); print("  rank=")
    print(r); print("  dim ker="); print(k)
    println("")
    r
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("================================================================")
    println("  Cayley-Dickson L9 Projective Measurement on R^512")
    println("================================================================")
    println("  L_A(h) := cd_mul(A, h)   on   R^512")
    println("")

    // (1) sedenion ZD lifted five rungs: assert.
    let r1 = measure(1, 3, 10)
    if r1 != 384 { println("  FAIL: sedenion-5x-lifted expected rank 384"); return 1 }

    // (2) pathion-native ZD lifted four rungs: assert.
    let r2 = measure(2, 3, 18)
    if r2 != 320 { println("  FAIL: pathion-4x-lifted expected rank 320"); return 1 }

    // (3) chingon-native ZD lifted three rungs: assert.
    let r3 = measure(3, 3, 34)
    if r3 != 288 { println("  FAIL: chingon-3x-lifted expected rank 288"); return 1 }

    // (4) routon-native ZD lifted two rungs: assert.
    let r4 = measure(4, 3, 66)
    if r4 != 272 { println("  FAIL: routon-2x-lifted expected rank 272"); return 1 }

    // (5) L8-native ZD lifted one rung: assert.
    let r5 = measure(5, 3, 130)
    if r5 != 264 { println("  FAIL: L8-native-1x-lifted expected rank 264"); return 1 }

    // (6) L9-native ZD e_3 + e_258 — MEASURE ONLY, do not assert.
    let r6 = measure(6, 3, 258)
    if r6 == 512 { println("  FAIL: e_3 + e_258 should be a zero-divisor at L9"); return 1 }

    // (X) control: invertible imaginary unit e_1 — assert full rank.
    let X = cd_basis(9, 1)
    var Mc: [f64; 262144] = [0.0; 262144]
    build_left_mult_matrix_512(X, &!Mc)
    let rx = rank_512x512(&!Mc, 1.0e-10)
    print("  case X: A = e_1  rank="); print(rx); println("  (expected 512)")
    if rx != 512 { println("  FAIL: e_1 should be invertible at L9"); return 1 }
    println("")

    println("================================================================")
    println("  Summary (erasure = dim ker / 512):")
    let k6 = 512 - r6
    print("    sedenion-5x-lifted (e_3+e_10):  ker=128/512 = 25.0000%   [asserted]"); println("")
    print("    pathion-4x-lifted  (e_3+e_18):  ker=192/512 = 37.5000%   [asserted]"); println("")
    print("    chingon-3x-lifted  (e_3+e_34):  ker=224/512 = 43.7500%   [asserted]"); println("")
    print("    routon-2x-lifted   (e_3+e_66):  ker=240/512 = 46.8750%   [asserted]"); println("")
    print("    L8-native-1x-lift  (e_3+e_130): ker=248/512 = 48.4375%   [asserted]"); println("")
    print("    L9-native          (e_3+e_258): ker="); print(k6); print("/512  [measured]"); println("")
    println("================================================================")
    println("  Native-erasure ladder (one representative family per rung):")
    println("    L4  ker 4   / 16  = 25.00000%   (= 2^3 - 4)")
    println("    L5  ker 12  / 32  = 37.50000%   (= 2^4 - 4)")
    println("    L6  ker 28  / 64  = 43.75000%   (= 2^5 - 4)")
    println("    L7  ker 60  / 128 = 46.87500%   (= 2^6 - 4)")
    println("    L8  ker 124 / 256 = 48.43750%   (= 2^7 - 4)")
    print("    L9  ker "); print(k6); print(" / 512 = ")
    if k6 == 252 {
        println("49.21875%  (= 2^8 - 4)  [conjecture HOLDS]")
    } else {
        println("?          [conjecture REFUTED/REFINED — see ker above]")
    }
    println("================================================================")
    println("  Conjecture (observational; not a theorem; 6 points if HOLDS):")
    println("    ker_native(L_n) = 2^(n-1) - 4   for the e_3 + e_(2^(n-1)+2)")
    println("    family, n >= 4.  Erasure -> 1/2 from below as n grows.")
    println("  No Heisenberg claim: L_A real-linear, non-unitary (ZD generators).")
    println("================================================================")
    0
}
