//! Simplest possible QNN test

use std::qnn

fn main() {
    // Create a simple quaternionic linear layer
    let layer = qnn::quat_linear_new(4, 8)

    // Initialize weights with Xavier initialization
    let w = qnn::quat_xavier_init(4, 8, 42)
    let b = qnn::quat_xavier_init(1, 8, 43)

    // Create test input
    var input: [Quat]
    let i: i32 = 0
    while i < 4 {
        input[i] = quat(1.0, 0.5, 0.3, 0.2)
        i = i + 1
    }

    // Forward pass
    let output = qnn::quat_linear_forward(&layer, &w, &input, &b)

    // Activation
    var activated: [Quat]
    qnn::quat_relu_batch(&output, &!activated)
}
