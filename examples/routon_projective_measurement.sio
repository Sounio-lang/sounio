//@ run-pass
//! examples/routon_projective_measurement.sio
//!
//! Routon Projective Measurement (Cayley-Dickson level 7, dim 128).
//!
//!   ℝ → ℂ → ℍ → 𝕆 → 𝕊 → 𝕋 → 𝕀 → routons
//!   L0  L1  L2  L3  L4   L5   L6    L7
//!  d 1   2   4   8   16   32   64   128
//!
//! Fourth rung of the projective-measurement ladder (siblings:
//! 16b6ad3ea sedenion L4, 729bce515 pathion L5, e072bc74e chingon L6).
//!
//! Two distinct questions:
//!   (A) Do tower-lifted zero-divisors keep doubling their kernel each
//!       rung?  These are PREDICTIONS — asserted, not measured.  A miss
//!       is a 128-D codegen/Gauss bug, not new algebra.
//!   (B) Does the conjectured native-erasure curve hold at a 4th point?
//!       The L7 native family e_3 + e_(half+2) = e_3 + e_66 is MEASURED,
//!       never asserted.  Conjecture (e072bc74e) predicts
//!         ker_native(L_n) = 2^(n-1) - 4   (= half-dim minus 4),
//!       so ker_native(L7) = 64 - 4 = 60, rank = 68.  If e_3 + e_66
//!       comes back ≠ 60 that is a refutation/refinement of the
//!       conjecture and is reported AS the result — no index hunting.
//!
//! Lifted predictions (Schafer L_{(a,0)} doubling of the parent kernel):
//!   (1) A1 = e_3 + e_10  sedenion ZD  ×3 lifts  ker 4→8→16→32  rank 96
//!   (2) A2 = e_3 + e_18  pathion ZD   ×2 lifts  ker 12→24→48    rank 80
//!   (3) A3 = e_3 + e_34  chingon ZD   ×1 lift   ker 28→56       rank 72
//!   (4) A4 = e_3 + e_66  routon-native            measured       ?
//!   (X) X  = e_1         control                  rank 128
//!
//! No Heisenberg claim: for these zero-divisor generators L_A is real-linear
//! and non-unitary (singular); σ_x σ_p ≥ ℏ/2 is a theorem about unitary
//! evolution.  (The unit control e_1 gives an orthogonal L_{e_1}.)

use algebra::cayley_dickson::{cd_mul, cd_basis, cd_zero, CDElement}

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

// Build the 128x128 matrix where column k = L_z(e_k).  Row-major M[128*i+k].
fn build_left_mult_matrix_128(z: CDElement, out: &![f64; 16384]) with Mut, Div, Panic {
    var k: i64 = 0
    while k < 128 {
        let ek = cd_basis(7, k as i32)
        let prod = cd_mul(z, ek)
        var i: i64 = 0
        while i < 128 {
            (*out)[(128 * i + k) as usize] = prod.c[i as usize]
            i = i + 1
        }
        k = k + 1
    }
}

// Gauss elimination with partial pivoting on a 128x128 in-place matrix.
fn rank_128x128(m: &![f64; 16384], tol: f64) -> i64 with Mut, Div, Panic {
    var rank: i64 = 0
    var row: i64 = 0
    var col: i64 = 0
    while col < 128 && row < 128 {
        var pivot_row: i64 = 0 - 1
        var best: f64 = tol
        var r: i64 = row
        while r < 128 {
            let av = abs_f64((*m)[(128 * r + col) as usize])
            if av > best { best = av; pivot_row = r }
            r = r + 1
        }
        if pivot_row < 0 {
            col = col + 1
        } else {
            if pivot_row != row {
                var j: i64 = 0
                while j < 128 {
                    let a = (*m)[(128 * row + j) as usize]
                    let b = (*m)[(128 * pivot_row + j) as usize]
                    (*m)[(128 * row + j) as usize] = b
                    (*m)[(128 * pivot_row + j) as usize] = a
                    j = j + 1
                }
            }
            let piv = (*m)[(128 * row + col) as usize]
            var rr: i64 = row + 1
            while rr < 128 {
                let factor = (*m)[(128 * rr + col) as usize] / piv
                var j: i64 = col
                while j < 128 {
                    let nv = (*m)[(128 * rr + j) as usize]
                              - factor * (*m)[(128 * row + j) as usize]
                    (*m)[(128 * rr + j) as usize] = nv
                    j = j + 1
                }
                rr = rr + 1
            }
            rank = rank + 1
            row = row + 1
            col = col + 1
        }
    }
    rank
}

// Compute rank(L_A) for A = e_lo + e_hi at level 7.
fn measure(label: i64, idx_lo: i64, idx_hi: i64) -> i64 with IO, Mut, Div, Panic {
    var A: CDElement = cd_zero(7)
    A.c[idx_lo as usize] = 1.0
    A.c[idx_hi as usize] = 1.0
    var M: [f64; 16384] = [0.0; 16384]
    build_left_mult_matrix_128(A, &!M)
    let r = rank_128x128(&!M, 1.0e-10)
    let k = 128 - r
    print("  case "); print(label); print(": A = e_")
    print(idx_lo); print(" + e_"); print(idx_hi); print("  rank=")
    print(r); print("  dim ker="); print(k)
    println("")
    r
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("================================================================")
    println("  Routon Projective Measurement on R^128  (Cayley-Dickson L7)")
    println("================================================================")
    println("  L_A(h) := cd_mul(A, h)   on   R^128")
    println("")

    // (1) sedenion ZD lifted three rungs (L4 -> L5 -> L6 -> L7): assert.
    let r1 = measure(1, 3, 10)
    if r1 != 96 { println("  FAIL: sedenion-3x-lifted expected rank 96"); return 1 }

    // (2) pathion-native ZD lifted twice (L5 -> L6 -> L7): assert.
    let r2 = measure(2, 3, 18)
    if r2 != 80 { println("  FAIL: pathion-2x-lifted expected rank 80"); return 1 }

    // (3) chingon-native ZD lifted once (L6 -> L7): assert.
    let r3 = measure(3, 3, 34)
    if r3 != 72 { println("  FAIL: chingon-1x-lifted expected rank 72"); return 1 }

    // (4) routon-native ZD e_3 + e_66 — MEASURE ONLY, do not assert.
    let r4 = measure(4, 3, 66)
    if r4 == 128 { println("  FAIL: e_3 + e_66 should be a zero-divisor at L7"); return 1 }

    // (X) control: invertible imaginary unit e_1 — assert full rank.
    let X = cd_basis(7, 1)
    var Mc: [f64; 16384] = [0.0; 16384]
    build_left_mult_matrix_128(X, &!Mc)
    let rx = rank_128x128(&!Mc, 1.0e-10)
    print("  case X: A = e_1  rank="); print(rx); println("  (expected 128)")
    if rx != 128 { println("  FAIL: e_1 should be invertible at L7"); return 1 }
    println("")

    println("================================================================")
    println("  Summary (erasure = dim ker / 128):")
    let k4 = 128 - r4
    print("    sedenion-3x-lifted (e_3+e_10): ker=32/128 = 25.0%    [asserted]"); println("")
    print("    pathion-2x-lifted  (e_3+e_18): ker=48/128 = 37.5%    [asserted]"); println("")
    print("    chingon-1x-lifted  (e_3+e_34): ker=56/128 = 43.75%   [asserted]"); println("")
    print("    routon-native      (e_3+e_66): ker="); print(k4); print("/128   [measured]"); println("")
    println("================================================================")
    println("  Native-erasure ladder (one representative family per rung):")
    println("    L4  ker 4   / 16  = 25.000%   (= 2^3  - 4)")
    println("    L5  ker 12  / 32  = 37.500%   (= 2^4  - 4)")
    println("    L6  ker 28  / 64  = 43.750%   (= 2^5  - 4)")
    print("    L7  ker "); print(k4); print(" / 128 = ")
    if k4 == 60 {
        println("46.875%   (= 2^6 - 4)  [conjecture HOLDS]")
    } else {
        println("?         [conjecture REFUTED/REFINED — see ker above]")
    }
    println("================================================================")
    println("  Conjecture (observational; not a theorem):")
    println("    ker_native(L_n) = 2^(n-1) - 4   for the e_3 + e_(2^(n-1)+2)")
    println("    family, n >= 4.  Erasure -> 1/2 from below as n grows.")
    println("  No Heisenberg claim: L_A real-linear, non-unitary (ZD generators).")
    println("================================================================")
    0
}
