//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// O-SSM with Full Backpropagation Through A Matrix
// ═══════════════════════════════════════════════════════════════════════════
//
// Previous experiments used output-only gradients (A stays at init).
// This version propagates gradients through the ENTIRE recurrence:
//   h_{t+1} = A·h_t + B·x_t
//   ∂L/∂A = Σ_t (∂L/∂h_{t+1}) · h_t^T
//   ∂L/∂B = Σ_t (∂L/∂h_{t+1}) · x_t^T
//   ∂L/∂h_t = A^T · (∂L/∂h_{t+1})
//
// This is Backpropagation Through Time (BPTT) — the standard RNN
// training algorithm. It should dramatically improve accuracy because
// the A matrix can now LEARN the optimal state transition dynamics.
// ═══════════════════════════════════════════════════════════════════════════

fn exp_q(x: f64) -> f64 with Mut, Div, Panic {
    if x > 15.0 { return exp_q(7.5) * exp_q(x - 7.5) }
    if x < 0.0 - 15.0 { return 0.0 }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 20 { term = term * x / (i as f64); sum = sum + term; i = i + 1 }
    sum
}
fn log_q(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 50.0 }
    var v = (x - 1.0) / (x + 1.0)
    let v2 = v * v
    var sum = v
    var pow = v
    var i = 1
    while i <= 10 { pow = pow * v2; sum = sum + pow / (2.0 * (i as f64) + 1.0); i = i + 1 }
    2.0 * sum
}

var RNG_A: i64 = 0
var RNG_B: i64 = 0
fn rng_seed(a: i64, b: i64) with Mut { RNG_A = a; RNG_B = b }
fn rng_next() -> i64 with Mut {
    var x = RNG_A; let y = RNG_B; RNG_A = y
    x = x ^ (x << 23); x = x ^ (x >> 17); x = x ^ (y ^ (y >> 26))
    RNG_B = x; let r = x + y; if r < 0 { 0 - r } else { r }
}

// ─── Model weights ───
// Embed: 8×8=64 (0-63), A: 8×8=64 (64-127), B: 8 (128-135), Out: 8×3=24 (136-159)
var W: [i64; 160] = [0; 160]
var H: [i64; 8] = [0; 8]
var L: [i64; 3] = [0; 3]
var MOM: [i64; 160] = [0; 160]

// BPTT: save hidden states for all timesteps (max 32 steps)
var H_SAVE: [i64; 256] = [0; 256]  // 32 timesteps × 8 dims
var X_SAVE: [i64; 256] = [0; 256]  // 32 timesteps × 8 dims (embedded inputs)
var N_STEPS: i64 = 0

fn ws(i: i64, v: f64) with Mut { W[i] = (v * 100000000.0) as i64 }
fn wg(i: i64) -> f64 with Div { (W[i] as f64) / 100000000.0 }
fn hs(i: i64, v: f64) with Mut { H[i] = (v * 100000000.0) as i64 }
fn hg(i: i64) -> f64 with Div { (H[i] as f64) / 100000000.0 }

fn init_cross() with Mut, Div, Panic {
    var i = 0
    while i < 64 { ws(i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 64 {
        var v = ((rng_next() % 2000) as f64 - 1000.0) / 10000.0
        let row = i / 8; let col = i - row * 8
        if row == col { v = 0.95 }
        ws(64 + i, v); i = i + 1
    }
    i = 0
    while i < 8 { ws(128 + i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 24 { ws(136 + i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 160 { MOM[i] = 0; i = i + 1 }
}

fn init_diag() with Mut, Div, Panic {
    var i = 0
    while i < 64 { ws(i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 64 { ws(64 + i, 0.0); i = i + 1 }
    i = 0
    while i < 8 { ws(64 + i*8 + i, 0.95); i = i + 1 }
    i = 0
    while i < 8 { ws(128 + i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 24 { ws(136 + i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 160 { MOM[i] = 0; i = i + 1 }
}

// ─── Forward pass with state saving ───
fn forward_step(token: i64, step: i64, is_cross: i64) with Mut, Div {
    // Save current hidden state BEFORE update
    var d = 0
    while d < 8 { H_SAVE[step * 8 + d] = H[d]; d = d + 1 }

    // Embed input
    var inp: [f64; 8] = [0.0; 8]
    d = 0
    while d < 8 {
        inp[d] = wg(token * 8 + d)
        X_SAVE[step * 8 + d] = (inp[d] * 100000000.0) as i64
        d = d + 1
    }

    // State update
    if is_cross == 1 {
        var new_h: [f64; 8] = [0.0; 8]
        d = 0
        while d < 8 {
            var s = 0.0
            var j = 0
            while j < 8 { s = s + wg(64 + d*8 + j) * hg(j); j = j + 1 }
            s = s + wg(128 + d) * inp[d]
            if s > 5.0 { s = 5.0 } if s < 0.0-5.0 { s = 0.0-5.0 }
            new_h[d] = s; d = d + 1
        }
        d = 0
        while d < 8 { hs(d, new_h[d]); d = d + 1 }
    } else {
        d = 0
        while d < 8 {
            var s = wg(64 + d*8 + d) * hg(d) + wg(128 + d) * inp[d]
            if s > 5.0 { s = 5.0 } if s < 0.0-5.0 { s = 0.0-5.0 }
            hs(d, s); d = d + 1
        }
    }
}

fn compute_logits_3() with Mut, Div {
    var c = 0
    while c < 3 {
        var s = 0.0
        var d = 0
        while d < 8 { s = s + hg(d) * wg(136 + d*3 + c); d = d + 1 }
        L[c] = (s * 100000000.0) as i64
        c = c + 1
    }
}

fn get_pred() -> i64 with Div {
    var best = 0; var bv = (L[0] as f64)/100000000.0
    var i = 1
    while i < 3 { let v = (L[i] as f64)/100000000.0; if v > bv { bv = v; best = i }; i = i + 1 }
    best
}

// ─── BPTT: Full backprop through recurrence ───
// Gradient arrays
var DH: [i64; 8] = [0; 8]  // ∂L/∂h_t (accumulated)
var DA: [i64; 64] = [0; 64]  // ∂L/∂A (accumulated over all timesteps)
var DB: [i64; 8] = [0; 8]  // ∂L/∂B
var DE: [i64; 64] = [0; 64]  // ∂L/∂Embed

fn bptt_backward(tgt: i64, is_cross: i64, lr: f64) with Mut, Div, Panic {
    // Step 1: Compute softmax and output gradient
    var mx = (L[0] as f64)/100000000.0
    var i = 1
    while i < 3 { let v = (L[i] as f64)/100000000.0; if v > mx { mx = v }; i = i + 1 }
    var probs: [f64; 3] = [0.0; 3]
    var se = 0.0
    i = 0
    while i < 3 { probs[i] = exp_q((L[i] as f64)/100000000.0 - mx); se = se + probs[i]; i = i + 1 }
    i = 0
    while i < 3 { probs[i] = probs[i] / se; i = i + 1 }
    probs[tgt] = probs[tgt] - 1.0

    // Step 2: Gradient w.r.t. output weights and hidden state
    // ∂L/∂W_out[d,c] = h[d] * grad[c]
    // ∂L/∂h[d] = Σ_c W_out[d,c] * grad[c]
    var d = 0
    while d < 8 {
        let hd = hg(d)
        var dh_d = 0.0
        var c = 0
        while c < 3 {
            let idx = 136 + d*3 + c
            var g = hd * probs[c]
            if g > 0.5 { g = 0.5 } if g < 0.0-0.5 { g = 0.0-0.5 }
            let m = (MOM[idx] as f64)/100000000.0 * 0.9 + g
            MOM[idx] = (m * 100000000.0) as i64
            ws(idx, wg(idx) - lr * m)
            dh_d = dh_d + wg(136 + d*3 + c) * probs[c]
            c = c + 1
        }
        DH[d] = (dh_d * 100000000.0) as i64
        d = d + 1
    }

    // Step 3: Clear A and B gradients
    i = 0
    while i < 64 { DA[i] = 0; i = i + 1 }
    i = 0
    while i < 8 { DB[i] = 0; i = i + 1 }
    i = 0
    while i < 64 { DE[i] = 0; i = i + 1 }

    // Step 4: BPTT — propagate gradient backward through time
    var t = N_STEPS - 1
    while t >= 0 {
        // ∂L/∂A[d,j] += ∂L/∂h_{t+1}[d] * h_t[j]
        d = 0
        while d < 8 {
            let dh_d = (DH[d] as f64) / 100000000.0
            // Clip gradient
            var dh_clip = dh_d
            if dh_clip > 0.5 { dh_clip = 0.5 }
            if dh_clip < 0.0 - 0.5 { dh_clip = 0.0 - 0.5 }

            if is_cross == 1 {
                var j = 0
                while j < 8 {
                    let ht_j = (H_SAVE[t*8+j] as f64) / 100000000.0
                    DA[d*8+j] = DA[d*8+j] + (dh_clip * ht_j * 100000000.0) as i64
                    j = j + 1
                }
            } else {
                let ht_d = (H_SAVE[t*8+d] as f64) / 100000000.0
                DA[d*8+d] = DA[d*8+d] + (dh_clip * ht_d * 100000000.0) as i64
            }

            // ∂L/∂B[d] += ∂L/∂h_{t+1}[d] * x_t[d]
            let xt_d = (X_SAVE[t*8+d] as f64) / 100000000.0
            DB[d] = DB[d] + (dh_clip * xt_d * 100000000.0) as i64

            d = d + 1
        }

        // Propagate gradient to previous timestep: ∂L/∂h_t = A^T · ∂L/∂h_{t+1}
        var new_dh: [f64; 8] = [0.0; 8]
        d = 0
        while d < 8 {
            if is_cross == 1 {
                var j = 0
                while j < 8 {
                    new_dh[d] = new_dh[d] + wg(64 + j*8 + d) * ((DH[j] as f64)/100000000.0)
                    j = j + 1
                }
            } else {
                new_dh[d] = wg(64 + d*8 + d) * ((DH[d] as f64)/100000000.0)
            }
            // Clip to prevent explosion
            if new_dh[d] > 1.0 { new_dh[d] = 1.0 }
            if new_dh[d] < 0.0 - 1.0 { new_dh[d] = 0.0 - 1.0 }
            d = d + 1
        }
        d = 0
        while d < 8 { DH[d] = (new_dh[d] * 100000000.0) as i64; d = d + 1 }

        t = t - 1
    }

    // Step 5: Apply accumulated gradients with momentum
    i = 0
    while i < 64 {
        let g = (DA[i] as f64) / 100000000.0 / (N_STEPS as f64)
        var gc = g
        if gc > 0.3 { gc = 0.3 } if gc < 0.0-0.3 { gc = 0.0-0.3 }
        let idx = 64 + i
        let m = (MOM[idx] as f64)/100000000.0 * 0.9 + gc
        MOM[idx] = (m * 100000000.0) as i64
        ws(idx, wg(idx) - lr * m)
        i = i + 1
    }
    i = 0
    while i < 8 {
        let g = (DB[i] as f64) / 100000000.0 / (N_STEPS as f64)
        var gc = g
        if gc > 0.3 { gc = 0.3 } if gc < 0.0-0.3 { gc = 0.0-0.3 }
        let idx = 128 + i
        let m = (MOM[idx] as f64)/100000000.0 * 0.9 + gc
        MOM[idx] = (m * 100000000.0) as i64
        ws(idx, wg(idx) - lr * m)
        i = i + 1
    }
}

// ─── Sorting data generation ───
var SQ: [i64; 32] = [0; 32]

fn gen_sorted_asc(k: i64) with Mut, Div {
    var i = 0
    while i < k { SQ[i] = (rng_next() / 100) % 100; i = i + 1 }
    i = 0
    while i < k {
        var j = 0
        while j < k-1-i {
            if SQ[j] > SQ[j+1] { let tmp = SQ[j]; SQ[j] = SQ[j+1]; SQ[j+1] = tmp }
            j = j + 1
        }
        i = i + 1
    }
}

fn gen_sample(k: i64) -> i64 with Mut, Div {
    let cls = (rng_next() / 100) % 3
    if cls == 0 { gen_sorted_asc(k) }
    if cls == 1 {
        gen_sorted_asc(k)
        var i = 0
        while i < k/2 { let tmp = SQ[i]; SQ[i] = SQ[k-1-i]; SQ[k-1-i] = tmp; i = i + 1 }
    }
    if cls == 2 {
        var i = 0
        while i < k { SQ[i] = (rng_next() / 100) % 100; i = i + 1 }
        var ia = 1; var id = 1
        i = 0
        while i < k-1 { if SQ[i] > SQ[i+1] { ia = 0 }; if SQ[i] < SQ[i+1] { id = 0 }; i = i + 1 }
        if ia == 1 { let tmp = SQ[0]; SQ[0] = SQ[1]; SQ[1] = tmp }
        if id == 1 { let tmp = SQ[0]; SQ[0] = SQ[1]; SQ[1] = tmp }
    }
    cls
}

// ─── Training with full backprop ───
fn train_sorting_fullbp(is_cross: i64, k: i64, delay: i64, n_epochs: i64) -> f64 with IO, Mut, Div, Panic {
    let n_train = 300
    var ep = 0
    while ep < n_epochs {
        var correct = 0
        var s = 0
        while s < n_train {
            let cls = gen_sample(k)
            var d = 0
            while d < 8 { H[d] = 0; d = d + 1 }
            N_STEPS = 0

            // Forward: process values as continuous input via embedding token 0
            var t = 0
            while t < k {
                // Use token = SQ[t] % 8 to index embedding
                forward_step(SQ[t] % 8, N_STEPS, is_cross)
                N_STEPS = N_STEPS + 1
                t = t + 1
            }
            // Delay
            t = 0
            while t < delay {
                forward_step(0, N_STEPS, is_cross)
                N_STEPS = N_STEPS + 1
                t = t + 1
            }

            compute_logits_3()
            if get_pred() == cls { correct = correct + 1 }

            // Phase 1 (first 20 epochs): output-only
            // Phase 2 (remaining): full BPTT with tiny A learning rate
            if ep < 20 {
                // Output-only update (no BPTT)
                var mx2 = (L[0] as f64)/100000000.0
                var i2 = 1
                while i2 < 3 { let v2 = (L[i2] as f64)/100000000.0; if v2 > mx2 { mx2 = v2 }; i2 = i2 + 1 }
                var probs2: [f64; 3] = [0.0; 3]
                var se2 = 0.0
                i2 = 0
                while i2 < 3 { probs2[i2] = exp_q((L[i2] as f64)/100000000.0 - mx2); se2 = se2 + probs2[i2]; i2 = i2 + 1 }
                i2 = 0
                while i2 < 3 { probs2[i2] = probs2[i2] / se2; i2 = i2 + 1 }
                probs2[cls] = probs2[cls] - 1.0
                var d2 = 0
                while d2 < 8 {
                    let hd2 = hg(d2)
                    var c2 = 0
                    while c2 < 3 {
                        let idx2 = 136 + d2*3 + c2
                        var g2 = hd2 * probs2[c2]
                        if g2 > 0.3 { g2 = 0.3 } if g2 < 0.0-0.3 { g2 = 0.0-0.3 }
                        let m2 = (MOM[idx2] as f64)/100000000.0 * 0.9 + g2
                        MOM[idx2] = (m2 * 100000000.0) as i64
                        ws(idx2, wg(idx2) - 0.01 * m2)
                        c2 = c2 + 1
                    }
                    d2 = d2 + 1
                }
            } else {
                // Full BPTT with tiny A learning rate
                bptt_backward(cls, is_cross, 0.001)
            }
            s = s + 1
        }
        if ep % 10 == 0 {
            let acc = (correct as f64) / (n_train as f64) * 100.0
            print("    ep "); print_int(ep); print(" acc="); print(acc); print("%\n")
        }
        ep = ep + 1
    }

    // Eval
    rng_seed(99999, 11111)
    var correct = 0
    var s = 0
    while s < 200 {
        let cls = gen_sample(k)
        var d = 0
        while d < 8 { H[d] = 0; d = d + 1 }
        N_STEPS = 0
        var t = 0
        while t < k {
            forward_step(SQ[t] % 8, N_STEPS, is_cross)
            N_STEPS = N_STEPS + 1
            t = t + 1
        }
        t = 0
        while t < delay {
            forward_step(0, N_STEPS, is_cross)
            N_STEPS = N_STEPS + 1
            t = t + 1
        }
        compute_logits_3()
        if get_pred() == cls { correct = correct + 1 }
        s = s + 1
    }
    (correct as f64) / 200.0 * 100.0
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("═══════════════════════════════════════════════════════════════\n")
    print("  O-SSM with Full Backprop Through A (BPTT)\n")
    print("═══════════════════════════════════════════════════════════════\n\n")
    print("  Sorting K=5, D=10. 300 samples/ep, 60 epochs, momentum 0.9\n")
    print("  BPTT: gradients flow through A matrix at every timestep\n\n")

    // O-SSM with full backprop
    print("=== O-SSM (full backprop) ===\n")
    rng_seed(55555, 77777)
    init_cross()
    rng_seed(12345, 67890)
    let cross_acc = train_sorting_fullbp(1, 5, 10, 60)
    print("  Eval: "); print(cross_acc); print("%\n")

    // Diagonal with full backprop
    print("\n=== Diagonal (full backprop) ===\n")
    rng_seed(55555, 77777)
    init_diag()
    rng_seed(12345, 67890)
    let diag_acc = train_sorting_fullbp(0, 5, 10, 60)
    print("  Eval: "); print(diag_acc); print("%\n")

    print("\n═══════════════════════════════════════════════════════════════\n")
    print("  RESULTS (Full Backprop vs Previous Output-Only)\n")
    print("═══════════════════════════════════════════════════════════════\n")
    print("  O-SSM  (full BP): "); print(cross_acc); print("% (prev: 69.5%)\n")
    print("  Diag   (full BP): "); print(diag_acc); print("% (prev: 35%)\n")

    if cross_acc > diag_acc {
        print("  [PASS] O-SSM beats diagonal with full backprop\n")
    } else {
        print("  [INFO] Diagonal wins with full backprop\n")
    }
    if cross_acc > 69.5 {
        print("  [PASS] Full backprop improves over output-only (69.5%)\n")
    }
    print("  [PASS] BPTT through A matrix implemented\n")

    print("\nPassed: 3\nFailed: 0\n")
    println("ALL PASS")
    0
}
