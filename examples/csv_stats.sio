//@ run-pass
// Compute column statistics from inline data

fn mean(data: &[f64; 256], len: i64) -> f64 with Mut, Panic, Div {
    var sum = 0.0
    var i: i64 = 0
    while i < len { sum = sum + data[i]; i = i + 1 }
    sum / (len as f64)
}

fn variance(data: &[f64; 256], len: i64) -> f64 with Mut, Panic, Div {
    let m = mean(data, len)
    var ss = 0.0
    var i: i64 = 0
    while i < len {
        let d = data[i] - m
        ss = ss + d * d
        i = i + 1
    }
    ss / (len as f64)
}

fn cs_sqrt(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var g = x
    var i: i64 = 0
    while i < 50 { g = 0.5 * (g + x / g); i = i + 1 }
    g
}

fn cs_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i32 with IO, Mut, Panic, Div {
    var data: [f64; 256] = [0.0; 256]
    data[0] = 10.0
    data[1] = 20.0
    data[2] = 30.0
    data[3] = 40.0
    data[4] = 50.0
    let len: i64 = 5

    let m = mean(&data, len)
    let v = variance(&data, len)
    let sd = cs_sqrt(v)

    assert(cs_abs(m - 30.0) < 0.001)
    assert(cs_abs(v - 200.0) < 0.001)
    assert(cs_abs(sd - 14.142) < 0.01)
    println("CSV stats: PASS")
    0
}
