fn main() with IO {
    // build 1e-20 by division so no literal-parsing path is involved
    var tiny: f128 = 1.0
    var i = 0
    while i < 20 { tiny = tiny / 10.0; i = i + 1 }
    let one: f128 = 1.0
    let back: f128 = (one + tiny) - one
    if back == 0.0 { println("ARITHMETIC IS f64: (1+1e-20)-1 == 0 with division-built tiny") }
    else { println("ARITHMETIC IS f128: nonzero") }
    // eps probe: smallest e with 1+e != 1, by halving
    var e: f128 = 1.0
    var n = 0
    while (one + e) - one != 0.0 && n < 200 { e = e / 2.0; n = n + 1 }
    println("halvings until 1+e == 1:")
    println(n)
}
