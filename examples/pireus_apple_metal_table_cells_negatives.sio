//@ run-pass
//!
//! Fail-closed witnesses for the Pireus PDF table-cell projection.

use document::pdf_text::{
    sounio_pdf_text_projection_empty,
}
use document::pdf_table::{
    SOUNIO_PDF_TABLE_ERR_BASE,
    SOUNIO_PDF_TABLE_ERR_STATE,
    sounio_pdf_table_geometry_empty,
    sounio_pdf_table_cell_projection_empty,
    sounio_pdf_table_project_geometry,
    sounio_pdf_table_project_cells,
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var missing = sounio_pdf_table_geometry_empty()
    let missing_error = sounio_pdf_table_project_geometry(
        "/definitely/not/a/pireus-corpus.pdf", &!missing)
    if missing_error != SOUNIO_PDF_TABLE_ERR_BASE {
        print("FAIL missing-corpus\n")
        return 1
    }

    var geometry = sounio_pdf_table_geometry_empty()
    var text = sounio_pdf_text_projection_empty()
    var cells = sounio_pdf_table_cell_projection_empty()
    geometry.error = SOUNIO_PDF_TABLE_ERR_BASE
    let invalid_geometry = sounio_pdf_table_project_cells(
        &geometry, &text, &!cells)
    if invalid_geometry != SOUNIO_PDF_TABLE_ERR_STATE {
        print("FAIL invalid-geometry\n")
        return 2
    }

    geometry = sounio_pdf_table_geometry_empty()
    geometry.pages = 1
    cells = sounio_pdf_table_cell_projection_empty()
    let page_mismatch = sounio_pdf_table_project_cells(
        &geometry, &text, &!cells)
    if page_mismatch != SOUNIO_PDF_TABLE_ERR_STATE {
        print("FAIL page-mismatch\n")
        return 3
    }

    geometry = sounio_pdf_table_geometry_empty()
    geometry.filled_rectangles = 4097
    cells = sounio_pdf_table_cell_projection_empty()
    let excess_cells = sounio_pdf_table_project_cells(
        &geometry, &text, &!cells)
    if excess_cells != SOUNIO_PDF_TABLE_ERR_STATE {
        print("FAIL cell-capacity\n")
        return 4
    }

    print("PIREUS_CELL_NEGATIVES missing=DENY invalid_geometry=DENY page_mismatch=DENY capacity=DENY\n")
    0
}
