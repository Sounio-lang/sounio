// Struct as function parameter + field access in native-v2 driver.
// Expected: prints "12", exits 0.

struct Point { x: i64, y: i64 }

fn double_sum(p: Point) -> i64 {
    (p.x + p.y) * 2
}

fn main() -> i64 with IO {
    let p = Point { x: 3, y: 3 }
    let result = double_sum(p)
    print_int(result)
    print_char(10)
    0
}
