// Smoke case for stage1-smoke regress-check of the step-4 array-init handler.
// Exercises `var arr: [T; N] = [v0, v1, ...]` tail-literal init, which the
// baseline driver does not yet support (silently skipped by self-compile
// smoke today). Step C's bisect enables this; if stage1 spins on it, smoke
// catches the regression the fixed-point gate cannot see.
fn main() -> i64 with IO, Mut {
    var arr: [i64; 4] = [10, 20, 30, 40]
    var i: i64 = 0
    var total: i64 = 0
    while i < 4 {
        total = total + arr[i]
        i = i + 1
    }
    print_int(total)
    print_char(10)
    0
}
