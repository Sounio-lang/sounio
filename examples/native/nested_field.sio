// Nested struct field access (a.b.c chains) in native-v2 driver.
// Expected: prints "9", exits 0.

struct Inner { z: i64 }
struct Outer { a: i64, inner: Inner }

fn main() -> i64 with IO {
    let inner = Inner { z: 5 }
    let outer = Outer { a: 4, inner: inner }
    let s = outer.a + outer.inner.z
    print_int(s)
    print_char(10)
    0
}
