fn apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }
fn apply2(f: fn(i64, i64) -> i64, a: i64, b: i64) -> i64 { f(a, b) }

fn choose_scale(which: i64) -> fn(i64) -> i64 with Mut, Panic, Div {
    if which == 0 { |x: i64| x * 2 }
    else { |x: i64| x * 3 }
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let inc = |x: i64| x + 1
    let add = |x: i64, y: i64| x + y
    let r1 = apply(inc, 41)
    let r2 = apply(|x: i64| x * 2, 21)
    let r3 = apply2(add, 20, 22)
    let scale = choose_scale(1)
    let r4 = scale(14)
    if r1 != 42 { return 1 }
    if r2 != 42 { return 2 }
    if r3 != 42 { return 3 }
    if r4 != 42 { return 4 }
    print_int(42)
    print_char(10)
    0
}
