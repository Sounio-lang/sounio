// Function returning a struct (multi-value via rax:rdx) in native-v2 driver.
// Expected: prints "8", exits 0.

struct Point { x: i64, y: i64 }

fn make_point(a: i64, b: i64) -> Point {
    Point { x: a, y: b }
}

fn main() -> i64 with IO {
    let p = make_point(3, 5)
    let s = p.x + p.y
    print_int(s)
    print_char(10)
    0
}
