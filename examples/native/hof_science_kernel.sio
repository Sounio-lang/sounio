fn square(x: i64) -> i64 { x * x }
fn residual7(x: i64) -> i64 { x - 7 }
fn loss7(x: i64) -> i64 {
    let d = x - 7
    d * d
}

fn integrate_left_i64(f: fn(i64) -> i64, start: i64, step: i64, n: i64) -> i64 with Mut, Panic, Div {
    var acc: i64 = 0
    var i: i64 = 0
    while i < n {
        let x = start + i * step
        acc = acc + f(x) * step
        i = i + 1
    }
    acc
}

fn first_nonnegative_i64(f: fn(i64) -> i64, lo: i64, hi: i64) -> i64 with Mut, Panic, Div {
    var x = lo
    while x <= hi {
        if f(x) >= 0 { return x }
        x = x + 1
    }
    hi
}

fn scan_min_i64(f: fn(i64) -> i64, lo: i64, hi: i64) -> i64 with Mut, Panic, Div {
    var best = lo
    var best_val = f(lo)
    var x = lo + 1
    while x <= hi {
        let v = f(x)
        if v < best_val {
            best = x
            best_val = v
        }
        x = x + 1
    }
    best
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let area = integrate_left_i64(square, 0, 1, 4)
    let root = first_nonnegative_i64(residual7, 0, 10)
    let optimum = scan_min_i64(loss7, 0, 10)
    if area != 14 { return 1 }
    if root != 7 { return 2 }
    if optimum != 7 { return 3 }
    print_int(area + root + optimum)
    print_char(10)
    0
}
