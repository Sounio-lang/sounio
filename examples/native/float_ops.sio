// Float operations comprehensive test.
// Tests: f64 add, sub, mul, div, and comparisons via exit code.
//
// Expected: exit code 0.

fn main() -> i64 with IO {
    // Test 1: addition  3.0 + 2.0 = 5.0
    let add_result = 3.0 + 2.0
    if add_result != 5.0 { return 1 }

    // Test 2: subtraction  10.0 - 3.0 = 7.0
    let sub_result = 10.0 - 3.0
    if sub_result != 7.0 { return 2 }

    // Test 3: multiplication  4.0 * 2.5 = 10.0
    let mul_result = 4.0 * 2.5
    if mul_result != 10.0 { return 3 }

    // Test 4: division  15.0 / 3.0 = 5.0
    let div_result = 15.0 / 3.0
    if div_result != 5.0 { return 4 }

    // Test 5: chained ops  (2.0 + 3.0) * 4.0 = 20.0
    let a = 2.0 + 3.0
    let b = a * 4.0
    if b != 20.0 { return 5 }

    // Test 6: equality comparison
    let x = 1.5 + 1.5
    let y = 3.0
    if x != y { return 6 }

    // Test 7: subtraction to zero
    let z = 7.5 - 7.5
    if z != 0.0 { return 7 }

    0
}
