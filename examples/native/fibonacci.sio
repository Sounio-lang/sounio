// A2: Recursive fibonacci — tests function calls, if/else, comparison, recursion.
//
// Expected: prints "55", exits 0.

fn print_int(n: i64) -> i64 with IO { 0 }
fn print_char(c: i64) -> i64 with IO { 0 }

fn fib(n: i64) -> i64 {
    if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }
}

fn main() -> i64 with IO {
    print_int(fib(10))
    print_char(10)
    0
}
