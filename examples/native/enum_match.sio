// Enum variant construction + match dispatch in native-v2 driver.
// Expected: prints "2", exits 0.

enum Color { Red, Green, Blue }

fn color_code(c: i64) -> i64 {
    if c == Color::Red { 1 }
    else if c == Color::Green { 2 }
    else { 3 }
}

fn main() -> i64 with IO {
    let c = Color::Green
    let code = color_code(c)
    print_int(code)
    print_char(10)
    0
}
