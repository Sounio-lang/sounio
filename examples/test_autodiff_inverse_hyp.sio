// Test autodiff with inverse trig and hyperbolic functions
// asin(x): d/dx asin(x) = 1/sqrt(1-x²)
// acos(x): d/dx acos(x) = -1/sqrt(1-x²)
// sinh(x): d/dx sinh(x) = cosh(x)
// cosh(x): d/dx cosh(x) = sinh(x)

// --- Autodiff preamble ---
fn exp_f64(x: f64) -> f64 {
    if x > 20.0 { return exp_f64(x / 2.0) * exp_f64(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / exp_f64(0.0 - x) }
    var sum = 1.0; var term = 1.0
    term = term * x / 1.0; sum = sum + term; term = term * x / 2.0; sum = sum + term
    term = term * x / 3.0; sum = sum + term; term = term * x / 4.0; sum = sum + term
    term = term * x / 5.0; sum = sum + term; term = term * x / 6.0; sum = sum + term
    term = term * x / 7.0; sum = sum + term; term = term * x / 8.0; sum = sum + term
    term = term * x / 9.0; sum = sum + term; term = term * x / 10.0; sum = sum + term
    return sum
}
fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y); y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y); y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y); y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y); y = 0.5 * (y + x / y)
    return y
}
fn sin_f64(x: f64) -> f64 {
    let pi = 3.141592653589793
    var y = x
    while y > pi { y = y - 2.0 * pi }
    while y < 0.0 - pi { y = y + 2.0 * pi }
    let x2 = y * y; var sum = y; var term = y
    term = term * (0.0 - x2) / (2.0 * 3.0); sum = sum + term
    term = term * (0.0 - x2) / (4.0 * 5.0); sum = sum + term
    term = term * (0.0 - x2) / (6.0 * 7.0); sum = sum + term
    return sum
}
fn atan_f64(x: f64) -> f64 {
    let pi = 3.141592653589793
    if x < 0.0 { return 0.0 - atan_f64(0.0 - x) }
    if x > 2.0 { return pi / 2.0 - atan_f64(1.0 / x) }
    if x > 0.5 {
        let y = (x - 1.0) / (x + 1.0)
        let y2 = y * y; var sum = y; var term = y
        term = term * (0.0 - y2); sum = sum + term / 3.0
        term = term * (0.0 - y2); sum = sum + term / 5.0
        term = term * (0.0 - y2); sum = sum + term / 7.0
        term = term * (0.0 - y2); sum = sum + term / 9.0
        return pi / 4.0 + sum
    }
    let x2 = x * x; var sum = x; var term = x
    term = term * (0.0 - x2); sum = sum + term / 3.0
    term = term * (0.0 - x2); sum = sum + term / 5.0
    term = term * (0.0 - x2); sum = sum + term / 7.0
    term = term * (0.0 - x2); sum = sum + term / 9.0
    term = term * (0.0 - x2); sum = sum + term / 11.0
    return sum
}
fn asin_f64(x: f64) -> f64 {
    let denom = sqrt_f64(1.0 - x * x)
    if denom < 0.000001 {
        let pi = 3.141592653589793
        if x > 0.0 { return pi / 2.0 }
        return 0.0 - pi / 2.0
    }
    return atan_f64(x / denom)
}
fn acos_f64(x: f64) -> f64 {
    let pi = 3.141592653589793
    return pi / 2.0 - asin_f64(x)
}
fn sinh_f64(x: f64) -> f64 {
    return (exp_f64(x) - exp_f64(0.0 - x)) / 2.0
}
fn cosh_f64(x: f64) -> f64 {
    return (exp_f64(x) + exp_f64(0.0 - x)) / 2.0
}
struct Dual { val: f64, dot: f64 }
fn dual(val: f64, dot: f64) -> Dual { return Dual { val: val, dot: dot } }
fn dual_value(d: Dual) -> f64 { return d.val }
fn dual_deriv(d: Dual) -> f64 { return d.dot }
fn dual_asin(a: Dual) -> Dual {
    let denom = sqrt_f64(1.0 - a.val * a.val)
    return Dual { val: asin_f64(a.val), dot: a.dot / denom }
}
fn dual_acos(a: Dual) -> Dual {
    let denom = sqrt_f64(1.0 - a.val * a.val)
    return Dual { val: acos_f64(a.val), dot: 0.0 - a.dot / denom }
}
fn dual_sinh(a: Dual) -> Dual {
    return Dual { val: sinh_f64(a.val), dot: a.dot * cosh_f64(a.val) }
}
fn dual_cosh(a: Dual) -> Dual {
    return Dual { val: cosh_f64(a.val), dot: a.dot * sinh_f64(a.val) }
}
// --- End preamble ---

fn main() {
    println("=== Autodiff: asin(x) at x=0.5 ===")

    let x: f64 = 0.5
    let x_dual = dual(x, 1.0)

    let result = dual_asin(x_dual)

    let value = dual_value(result)
    let derivative = dual_deriv(result)

    // asin(0.5) = pi/6 ~ 0.5236
    // d/dx asin(x) at x=0.5 = 1/sqrt(1-0.25) = 1/sqrt(0.75) ~ 1.1547

    println("f(x) = asin(x) at x=0.5:")
    println("  Value f(0.5) = ")
    println(value)
    println("  Derivative f'(0.5) = ")
    println(derivative)

    println("Expected: value ~ 0.5236, derivative ~ 1.1547")

    println("")
    println("=== Autodiff: acos(x) at x=0.5 ===")

    let y: f64 = 0.5
    let y_dual = dual(y, 1.0)

    let result2 = dual_acos(y_dual)

    let value2 = dual_value(result2)
    let derivative2 = dual_deriv(result2)

    // acos(0.5) = pi/3 ~ 1.0472
    // d/dx acos(x) at x=0.5 = -1/sqrt(1-0.25) = -1/sqrt(0.75) ~ -1.1547

    println("g(x) = acos(x) at x=0.5:")
    println("  Value g(0.5) = ")
    println(value2)
    println("  Derivative g'(0.5) = ")
    println(derivative2)

    println("Expected: value ~ 1.0472, derivative ~ -1.1547")

    println("")
    println("=== Autodiff: sinh(x) at x=1 ===")

    let z: f64 = 1.0
    let z_dual = dual(z, 1.0)

    let result3 = dual_sinh(z_dual)

    let value3 = dual_value(result3)
    let derivative3 = dual_deriv(result3)

    // sinh(1) ~ 1.1752
    // d/dx sinh(x) at x=1 = cosh(1) ~ 1.5431

    println("h(x) = sinh(x) at x=1:")
    println("  Value h(1) = ")
    println(value3)
    println("  Derivative h'(1) = ")
    println(derivative3)

    println("Expected: value ~ 1.1752, derivative ~ 1.5431")

    println("")
    println("=== Autodiff: cosh(x) at x=1 ===")

    let w: f64 = 1.0
    let w_dual = dual(w, 1.0)

    let result4 = dual_cosh(w_dual)

    let value4 = dual_value(result4)
    let derivative4 = dual_deriv(result4)

    // cosh(1) ~ 1.5431
    // d/dx cosh(x) at x=1 = sinh(1) ~ 1.1752

    println("i(x) = cosh(x) at x=1:")
    println("  Value i(1) = ")
    println(value4)
    println("  Derivative i'(1) = ")
    println(derivative4)

    println("Expected: value ~ 1.5431, derivative ~ 1.1752")
}
