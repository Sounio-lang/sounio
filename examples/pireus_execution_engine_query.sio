//@ run-pass
//!
//! Sounio semantic-authority witness for multi-engine Pireus machines.

use hardware::pireus::target_profile::{
    PIREUS_TARGET_DARWIN_XEON, PIREUS_TARGET_APPLE_SILICON,
    PIREUS_TARGET_DGX_SPARK,
    PIREUS_MACHINE_R740, PIREUS_MACHINE_DL380, PIREUS_MACHINE_5860,
    PIREUS_MACHINE_T560, PIREUS_MACHINE_R770,
}
use hardware::pireus::execution_engine::{
    pireus_execution_engine_store,
    pireus_query_cluster_machines, pireus_query_machine_engines,
    pireus_query_observed_engines_by, pireus_query_observed_engines_kind_isa,
    pireus_query_multi_engine_machines, pireus_query_target_blueprints,
    pireus_query_observed_engines_for_target,
    pireus_query_blueprints_by_interface,
    PIREUS_ENGINE_HAS_KIND, PIREUS_ENGINE_IMPLEMENTS_ISA,
    PIREUS_ENGINE_SUPPORTS_INTERFACE, PIREUS_ENGINE_HAS_DRIVER_PROFILE,
    PIREUS_ENGINE_KIND_CPU, PIREUS_ENGINE_KIND_GPU,
    PIREUS_ENGINE_ISA_X86_64, PIREUS_ENGINE_ISA_NVIDIA_SM75,
    PIREUS_ENGINE_ISA_NVIDIA_SM86, PIREUS_ENGINE_ISA_NVIDIA_SM89,
    PIREUS_ENGINE_ISA_NVIDIA_SM121,
    PIREUS_INTERFACE_CUDA, PIREUS_INTERFACE_METAL,
    PIREUS_DRIVER_NVIDIA_595_71_05,
}
use ontology::query::{triple_store_count, sparql_result_count}

fn main() -> i32 with IO, Mut, Panic, Epistemic {
    var failures: i64 = 0
    var store = pireus_execution_engine_store()
    let triples = triple_store_count(&store)

    let machines = pireus_query_cluster_machines(&store)
    let cpu = pireus_query_observed_engines_by(
        &store, PIREUS_ENGINE_HAS_KIND, PIREUS_ENGINE_KIND_CPU)
    let gpu = pireus_query_observed_engines_by(
        &store, PIREUS_ENGINE_HAS_KIND, PIREUS_ENGINE_KIND_GPU)
    let multi = pireus_query_multi_engine_machines(&store)
    let machine_count = sparql_result_count(&machines)
    let cpu_count = sparql_result_count(&cpu)
    let gpu_count = sparql_result_count(&gpu)
    let multi_count = sparql_result_count(&multi)

    let r740 = pireus_query_machine_engines(&store, PIREUS_MACHINE_R740)
    let dl380 = pireus_query_machine_engines(&store, PIREUS_MACHINE_DL380)
    let n5860 = pireus_query_machine_engines(&store, PIREUS_MACHINE_5860)
    let t560 = pireus_query_machine_engines(&store, PIREUS_MACHINE_T560)
    let r770 = pireus_query_machine_engines(&store, PIREUS_MACHINE_R770)
    let r740_count = sparql_result_count(&r740)
    let dl380_count = sparql_result_count(&dl380)
    let n5860_count = sparql_result_count(&n5860)
    let t560_count = sparql_result_count(&t560)
    let r770_count = sparql_result_count(&r770)

    let x86 = pireus_query_observed_engines_by(
        &store, PIREUS_ENGINE_IMPLEMENTS_ISA, PIREUS_ENGINE_ISA_X86_64)
    let sm75 = pireus_query_observed_engines_by(
        &store, PIREUS_ENGINE_IMPLEMENTS_ISA, PIREUS_ENGINE_ISA_NVIDIA_SM75)
    let sm86 = pireus_query_observed_engines_by(
        &store, PIREUS_ENGINE_IMPLEMENTS_ISA, PIREUS_ENGINE_ISA_NVIDIA_SM86)
    let sm89 = pireus_query_observed_engines_by(
        &store, PIREUS_ENGINE_IMPLEMENTS_ISA, PIREUS_ENGINE_ISA_NVIDIA_SM89)
    let sm121 = pireus_query_observed_engines_by(
        &store, PIREUS_ENGINE_IMPLEMENTS_ISA, PIREUS_ENGINE_ISA_NVIDIA_SM121)
    let x86_count = sparql_result_count(&x86)
    let sm75_count = sparql_result_count(&sm75)
    let sm86_count = sparql_result_count(&sm86)
    let sm89_count = sparql_result_count(&sm89)
    let sm121_count = sparql_result_count(&sm121)
    var distinct_observed_isa: i64 = 0
    if x86_count > 0 { distinct_observed_isa = distinct_observed_isa + 1 }
    if sm75_count > 0 { distinct_observed_isa = distinct_observed_isa + 1 }
    if sm86_count > 0 { distinct_observed_isa = distinct_observed_isa + 1 }
    if sm89_count > 0 { distinct_observed_isa = distinct_observed_isa + 1 }
    if sm121_count > 0 { distinct_observed_isa = distinct_observed_isa + 1 }

    let cuda = pireus_query_observed_engines_by(
        &store, PIREUS_ENGINE_SUPPORTS_INTERFACE, PIREUS_INTERFACE_CUDA)
    let metal_observed = pireus_query_observed_engines_by(
        &store, PIREUS_ENGINE_SUPPORTS_INTERFACE, PIREUS_INTERFACE_METAL)
    let metal_as_isa = pireus_query_observed_engines_by(
        &store, PIREUS_ENGINE_IMPLEMENTS_ISA, PIREUS_INTERFACE_METAL)
    let gpu_x86 = pireus_query_observed_engines_kind_isa(
        &store, PIREUS_ENGINE_KIND_GPU, PIREUS_ENGINE_ISA_X86_64)
    let driver = pireus_query_observed_engines_by(
        &store, PIREUS_ENGINE_HAS_DRIVER_PROFILE,
        PIREUS_DRIVER_NVIDIA_595_71_05)
    let cuda_count = sparql_result_count(&cuda)
    let metal_observed_count = sparql_result_count(&metal_observed)
    let metal_as_isa_count = sparql_result_count(&metal_as_isa)
    let gpu_x86_count = sparql_result_count(&gpu_x86)
    let driver_count = sparql_result_count(&driver)

    let darwin_blueprints = pireus_query_target_blueprints(
        &store, PIREUS_TARGET_DARWIN_XEON)
    let apple_blueprints = pireus_query_target_blueprints(
        &store, PIREUS_TARGET_APPLE_SILICON)
    let dgx_blueprints = pireus_query_target_blueprints(
        &store, PIREUS_TARGET_DGX_SPARK)
    let apple_metal = pireus_query_blueprints_by_interface(
        &store, PIREUS_TARGET_APPLE_SILICON, PIREUS_INTERFACE_METAL)
    let dgx_cuda = pireus_query_blueprints_by_interface(
        &store, PIREUS_TARGET_DGX_SPARK, PIREUS_INTERFACE_CUDA)
    let darwin_blueprint_count = sparql_result_count(&darwin_blueprints)
    let apple_blueprint_count = sparql_result_count(&apple_blueprints)
    let dgx_blueprint_count = sparql_result_count(&dgx_blueprints)
    let apple_metal_count = sparql_result_count(&apple_metal)
    let dgx_cuda_count = sparql_result_count(&dgx_cuda)

    let darwin_observed = pireus_query_observed_engines_for_target(
        &store, PIREUS_TARGET_DARWIN_XEON)
    let apple_observed = pireus_query_observed_engines_for_target(
        &store, PIREUS_TARGET_APPLE_SILICON)
    let dgx_observed = pireus_query_observed_engines_for_target(
        &store, PIREUS_TARGET_DGX_SPARK)
    let darwin_observed_count = sparql_result_count(&darwin_observed)
    let apple_observed_count = sparql_result_count(&apple_observed)
    let dgx_observed_count = sparql_result_count(&dgx_observed)

    if triples != 290 { failures = failures + 1 }
    if machine_count != 5 || cpu_count != 5 || gpu_count != 4 ||
        multi_count != 3 { failures = failures + 1 }
    if r740_count != 3 || dl380_count != 1 || n5860_count != 2 ||
        t560_count != 1 || r770_count != 2 { failures = failures + 1 }
    if x86_count != 5 || sm75_count != 1 || sm86_count != 1 ||
        sm89_count != 2 || sm121_count != 0 || distinct_observed_isa != 4 {
        failures = failures + 1
    }
    if cuda_count != 4 || metal_observed_count != 0 ||
        metal_as_isa_count != 0 || gpu_x86_count != 0 || driver_count != 4 {
        failures = failures + 1
    }
    if darwin_blueprint_count != 2 || apple_blueprint_count != 2 ||
        dgx_blueprint_count != 2 || apple_metal_count != 1 ||
        dgx_cuda_count != 1 { failures = failures + 1 }
    if darwin_observed_count != 9 || apple_observed_count != 0 ||
        dgx_observed_count != 0 { failures = failures + 1 }

    print("SOUNIO_AUTHORITY schema=pireus-execution-engine.v0 role=SEMANTIC_AUTHORITY\n")
    print("PIREUS_ENGINE_STORE triples="); print_int(triples); print("\n")
    print("PIREUS_DARWIN machines="); print_int(machine_count)
    print(" engines="); print_int(cpu_count + gpu_count)
    print(" cpu="); print_int(cpu_count)
    print(" gpu="); print_int(gpu_count)
    print(" multi_engine_machines="); print_int(multi_count); print("\n")
    print("PIREUS_MACHINE_ENGINES r740="); print_int(r740_count)
    print(" dl380="); print_int(dl380_count)
    print(" n5860="); print_int(n5860_count)
    print(" t560="); print_int(t560_count)
    print(" r770="); print_int(r770_count); print("\n")
    print("PIREUS_ENGINE_ISA x86_64="); print_int(x86_count)
    print(" sm75="); print_int(sm75_count)
    print(" sm86="); print_int(sm86_count)
    print(" sm89="); print_int(sm89_count)
    print(" sm121_observed="); print_int(sm121_count)
    print(" distinct_observed="); print_int(distinct_observed_isa); print("\n")
    print("PIREUS_ENGINE_INTERFACE cuda_observed="); print_int(cuda_count)
    print(" metal_observed="); print_int(metal_observed_count)
    print(" driver_595_71_05="); print_int(driver_count); print("\n")
    print("PIREUS_BLUEPRINTS darwin="); print_int(darwin_blueprint_count)
    print(" apple="); print_int(apple_blueprint_count)
    print(" dgx="); print_int(dgx_blueprint_count)
    print(" apple_metal="); print_int(apple_metal_count)
    print(" dgx_cuda="); print_int(dgx_cuda_count); print("\n")
    print("PIREUS_TARGET_ENGINES darwin_observed="); print_int(darwin_observed_count)
    print(" apple_observed="); print_int(apple_observed_count)
    print(" dgx_observed="); print_int(dgx_observed_count); print("\n")
    print("PIREUS_ENGINE_NEGATIVE metal_as_isa="); print_int(metal_as_isa_count)
    print(" gpu_x86="); print_int(gpu_x86_count); print("\n")
    print("PIREUS_ENGINE_SUMMARY failures="); print_int(failures); print("\n")

    if failures == 0 { 0 } else { 1 }
}
