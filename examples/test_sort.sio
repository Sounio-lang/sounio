//! Test program for sorting algorithms

use algo::sort;

fn main() with Alloc, Panic, Div, IO {
    println("Testing sorting algorithms...")

    // Test quicksort
    var arr1 = [9, 3, 7, 1, 5, 8, 2, 4, 6]
    sort::quicksort_i64(&!arr1, 9)
    if sort::is_sorted_i64(&arr1, 9) {
        println("✓ Quicksort i64 passed")
    } else {
        println("✗ Quicksort i64 failed")
    }

    // Test mergesort
    var arr2 = [5, 2, 9, 1, 7, 3, 8, 4, 6]
    sort::mergesort_i64(&!arr2, 9)
    if sort::is_sorted_i64(&arr2, 9) {
        println("✓ Mergesort i64 passed")
    } else {
        println("✗ Mergesort i64 failed")
    }

    // Test heapsort
    var arr3 = [4, 8, 2, 9, 1, 6, 3, 7, 5]
    sort::heapsort_i64(&!arr3, 9)
    if sort::is_sorted_i64(&arr3, 9) {
        println("✓ Heapsort i64 passed")
    } else {
        println("✗ Heapsort i64 failed")
    }

    // Test f64 quicksort
    var arr4 = [9.5, 3.2, 7.8, 1.1, 5.4]
    sort::quicksort_f64(&!arr4, 5)
    if sort::is_sorted_f64(&arr4, 5) {
        println("✓ Quicksort f64 passed")
    } else {
        println("✗ Quicksort f64 failed")
    }

    // Test edge cases
    var single = [42]
    sort::quicksort_i64(&!single, 1)
    if sort::is_sorted_i64(&single, 1) {
        println("✓ Single element passed")
    } else {
        println("✗ Single element failed")
    }

    var reversed = [5, 4, 3, 2, 1]
    sort::heapsort_i64(&!reversed, 5)
    if sort::is_sorted_i64(&reversed, 5) {
        println("✓ Reverse sorted passed")
    } else {
        println("✗ Reverse sorted failed")
    }

    println("All sorting tests completed!")
}
