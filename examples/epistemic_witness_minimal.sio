// Epistemic witness: minimal program exercising Knowledge<T> as a native type annotation.
//
// Purpose: provides a non-trivial witness for the Epistemic Monotonicity Theorem.
// native_compile_driver counts all tokens with text "Knowledge" as u_c_scaled.
// This program has 3 such tokens (two parameters + one return type), so u_c_scaled = 3.
//
// Note: bodies use only scalar arithmetic — no measure() builtin required.
// This is intentional: the gate tests token counting, not full GUM lowering.
// Full GUM lowering (measure() + .value/.uncertainty) requires epistemic_smoke_native.sio
// and a future extension to the native frontend.

fn ep_ratio(dose: Knowledge<f64>, volume: Knowledge<f64>) -> Knowledge<f64> {
    dose
}

fn main() -> i32 {
    0
}
