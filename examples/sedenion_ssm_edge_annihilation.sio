//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// S-SSM Edge of Annihilation: Subspace-Selective Forgetting via ZD Proximity
// ═══════════════════════════════════════════════════════════════════════════
//
// NOVELTY: The first SSM that can selectively annihilate information by
// steering the state transition matrix A toward the zero-divisor locus.
//
// Mechanism:
//   A(token) = generic_A            for tokens 1-3 (remember)
//   A(token) = normalize(zd)        for token 4 (FORGET)
//   Δ(token) = sigmoid(W_Δ[token])  [Mamba gate: freeze zeros, attend to rest]
//
// When FORGET is processed:
//   h_new = normalize(tanh(A_forget ⊗ h + B ⊗ emb))
//   If h has comp-aligned components, A_forget ⊗ h annihilates them.
//   This is STRUCTURED FORGETTING — impossible in O-SSM and impossible
//   in GRUs/LSTMs (which uniformly scale, never algebraically zero).
//
// Task: Process [1,2,3], optionally FORGET, then D zeros.
//   - Remember path: state preserves token info through delay
//   - Forget path: state loses token info via ZD annihilation
//   - Non-selective: corrupts state on zeros, no selective forget

use math::sedenion::*;

// ─── Math helpers ──────────────────────────────────────────────────────────
fn sqrt_s(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y: f64 = x
    var i: i64 = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn sigmoid_s(x: f64) -> f64 with Mut, Div, Panic {
    if x > 10.0 { return 1.0 }
    if x < 0.0 - 10.0 { return 0.0 }
    var s: f64 = 1.0
    var t: f64 = 1.0
    var i: i64 = 1
    while i <= 12 { t = t * (0.0 - x) / (i as f64); s = s + t; i = i + 1 }
    1.0 / (1.0 + s)
}

// ─── Embedding ─────────────────────────────────────────────────────────────
fn embed_s(token: i64) -> Sedenion {
    if token == 1 { sed_basis(1, 1.0) }
    else if token == 2 { sed_basis(2, 1.0) }
    else if token == 3 { sed_basis(3, 1.0) }
    else if token == 4 { sed_zero() }   // FORGET token has no embedding
    else { sed_zero() }
}

// ─── Parameters ────────────────────────────────────────────────────────────
var A_SED: Sedenion = sed_zero()
var B_SED: Sedenion = sed_zero()
var W_DELTA: [f64; 5] = [0.0; 5]

fn init_params() with Mut {
    A_SED = sed_add(sed_basis(0, 0.5), sed_basis(1, 0.05))
    A_SED = sed_add(A_SED, sed_basis(2, 0.03))
    B_SED = sed_basis(0, 0.5)
    W_DELTA[0] = 0.0 - 5.0   // distractor → freeze
    W_DELTA[1] = 2.0         // relevant → attend
    W_DELTA[2] = 2.0
    W_DELTA[3] = 2.0
    W_DELTA[4] = 2.0         // FORGET → attend (but A is ZD)
}

// ─── State update ──────────────────────────────────────────────────────────
fn ssm_step_sel(token: i64, h: Sedenion) -> Sedenion with Mut, Div, Panic {
    let emb: Sedenion = embed_s(token)
    var a: Sedenion = A_SED
    if token == 4 { a = sed_normalize(sed_known_zero_divisor()) }
    let Bx: Sedenion = sed_add(emb, sed_scale(B_SED, 0.1))
    let Ah: Sedenion = sed_mul(a, h)
    let comb: Sedenion = sed_add(Ah, Bx)
    let new_h: Sedenion = sed_normalize(sed_tanh(comb))
    let delta: f64 = sigmoid_s(W_DELTA[token as usize])
    sed_lerp(h, new_h, delta)
}

fn ssm_step_ns(token: i64, h: Sedenion) -> Sedenion with Mut, Div, Panic {
    let emb: Sedenion = embed_s(token)
    var a: Sedenion = A_SED
    if token == 4 { a = sed_normalize(sed_known_zero_divisor()) }
    let Bx: Sedenion = sed_add(emb, sed_scale(B_SED, 0.1))
    let Ah: Sedenion = sed_mul(a, h)
    let comb: Sedenion = sed_add(Ah, Bx)
    sed_normalize(sed_tanh(comb))
}

// Full replacement (no lerp) — for testing pure ZD effect
fn ssm_step_full(token: i64, h: Sedenion) -> Sedenion with Mut, Div, Panic {
    let emb: Sedenion = embed_s(token)
    var a: Sedenion = A_SED
    if token == 4 { a = sed_normalize(sed_known_zero_divisor()) }
    let Bx: Sedenion = sed_add(emb, sed_scale(B_SED, 0.1))
    let Ah: Sedenion = sed_mul(a, h)
    let comb: Sedenion = sed_add(Ah, Bx)
    sed_normalize(sed_tanh(comb))
}

// ─── Forward passes ────────────────────────────────────────────────────────
fn forward_sel(tok1: i64, tok2: i64, tok3: i64, forget: i64, delay: i64) -> Sedenion
    with Mut, Div, Panic
{
    var h: Sedenion = sed_one()
    h = ssm_step_sel(tok1, h)
    h = ssm_step_sel(tok2, h)
    h = ssm_step_sel(tok3, h)
    if forget == 1 { h = ssm_step_sel(4, h) }
    var d: i64 = 0
    while d < delay { h = ssm_step_sel(0, h); d = d + 1 }
    h
}

fn forward_ns(tok1: i64, tok2: i64, tok3: i64, forget: i64, delay: i64) -> Sedenion
    with Mut, Div, Panic
{
    var h: Sedenion = sed_one()
    h = ssm_step_ns(tok1, h)
    h = ssm_step_ns(tok2, h)
    h = ssm_step_ns(tok3, h)
    if forget == 1 { h = ssm_step_ns(4, h) }
    var d: i64 = 0
    while d < delay { h = ssm_step_ns(0, h); d = d + 1 }
    h
}

// ─── Distance & classifier ─────────────────────────────────────────────────
fn state_dist(a: Sedenion, b: Sedenion) -> f64 with Div {
    sed_norm(sed_sub(a, b))
}

fn classify_nn(h: Sedenion, ref0: Sedenion, ref1: Sedenion) -> i64 with Div {
    let d0: f64 = state_dist(h, ref0)
    let d1: f64 = state_dist(h, ref1)
    if d0 < d1 { 0 } else { 1 }
}

fn meta_class(p: i64) -> i64 with Mut {
    var t1: i64 = 0; var t3: i64 = 0
    if p == 0 { t1 = 1; t3 = 3 }
    if p == 1 { t1 = 1; t3 = 2 }
    if p == 2 { t1 = 2; t3 = 3 }
    if p == 3 { t1 = 2; t3 = 1 }
    if p == 4 { t1 = 3; t3 = 2 }
    if p == 5 { t1 = 3; t3 = 1 }
    if t1 < t3 { 0 } else { 1 }
}

fn eval_accuracy_sel(forget: i64, delay: i64) -> i64 with Mut, Div, Panic {
    let ref0: Sedenion = forward_sel(1, 2, 3, 0, 0)
    let ref1: Sedenion = forward_sel(3, 2, 1, 0, 0)
    var correct: i64 = 0
    var p: i64 = 0
    while p < 6 {
        var t1: i64 = 0; var t2: i64 = 0; var t3: i64 = 0
        if p == 0 { t1 = 1; t2 = 2; t3 = 3 }
        if p == 1 { t1 = 1; t2 = 3; t3 = 2 }
        if p == 2 { t1 = 2; t2 = 1; t3 = 3 }
        if p == 3 { t1 = 2; t2 = 3; t3 = 1 }
        if p == 4 { t1 = 3; t2 = 1; t3 = 2 }
        if p == 5 { t1 = 3; t2 = 2; t3 = 1 }
        let h: Sedenion = forward_sel(t1, t2, t3, forget, delay)
        let pred: i64 = classify_nn(h, ref0, ref1)
        if pred == meta_class(p) { correct = correct + 1 }
        p = p + 1
    }
    correct
}

fn eval_accuracy_ns(forget: i64, delay: i64) -> i64 with Mut, Div, Panic {
    let ref0: Sedenion = forward_ns(1, 2, 3, 0, 0)
    let ref1: Sedenion = forward_ns(3, 2, 1, 0, 0)
    var correct: i64 = 0
    var p: i64 = 0
    while p < 6 {
        var t1: i64 = 0; var t2: i64 = 0; var t3: i64 = 0
        if p == 0 { t1 = 1; t2 = 2; t3 = 3 }
        if p == 1 { t1 = 1; t2 = 3; t3 = 2 }
        if p == 2 { t1 = 2; t2 = 1; t3 = 3 }
        if p == 3 { t1 = 2; t2 = 3; t3 = 1 }
        if p == 4 { t1 = 3; t2 = 1; t3 = 2 }
        if p == 5 { t1 = 3; t2 = 2; t3 = 1 }
        let h: Sedenion = forward_ns(t1, t2, t3, forget, delay)
        let pred: i64 = classify_nn(h, ref0, ref1)
        if pred == meta_class(p) { correct = correct + 1 }
        p = p + 1
    }
    correct
}

// ─── Main ──────────────────────────────────────────────────────────────────
fn main() -> i32 with IO, Mut, Div, Panic {
    var passed: i32 = 0
    var failed: i32 = 0
    init_params()
    // T1: Basic forward pass nonzero
    let h_basic: Sedenion = forward_sel(1, 2, 3, 0, 5)
    if sed_norm(h_basic) > 0.001 {
        print("T1 PASS: forward nonzero, norm="); print(sed_norm(h_basic)); println("")
        passed = passed + 1
    } else {
        println("T1 FAIL")
        failed = failed + 1
    }

    // T2: Delta gates correct
    let d0: f64 = sigmoid_s(W_DELTA[0])
    let d1: f64 = sigmoid_s(W_DELTA[1])
    let d4: f64 = sigmoid_s(W_DELTA[4])
    if d0 < 0.1 && d1 > 0.5 && d4 > 0.5 {
        print("T2 PASS: Δ(distractor)="); print(d0)
        print(" Δ(relevant)="); print(d1)
        print(" Δ(forget)="); print(d4); println("")
        passed = passed + 1
    } else {
        println("T2 FAIL")
        failed = failed + 1
    }

    // T3: Selective accuracy >= non-selective at D=40 (remember path)
    let acc_ns_40: i64 = eval_accuracy_ns(0, 40)
    let acc_sel_40: i64 = eval_accuracy_sel(0, 40)
    if acc_sel_40 >= acc_ns_40 {
        print("T3 PASS: D=40 remember sel="); print_int(acc_sel_40)
        print("/6 >= ns="); print_int(acc_ns_40); println("/6")
        passed = passed + 1
    } else {
        println("T3 FAIL")
        failed = failed + 1
    }

    // T4: ZD annihilation — normalize(zd) ⊗ comp = 0
    let comp: Sedenion = sed_complementary_zero_divisor()
    let a_forget: Sedenion = sed_normalize(sed_known_zero_divisor())
    let annih_norm: f64 = sed_norm(sed_mul(a_forget, comp))
    if annih_norm < 0.001 {
        print("T4 PASS: ZD annihilation norm="); print(annih_norm); println("")
        passed = passed + 1
    } else {
        println("T4 FAIL")
        failed = failed + 1
    }

    // T5: ZD Ah=0 for comp-aligned state; generic Ah is nonzero.
    // This is the algebraic root of structured forgetting: the Ah term vanishes,
    // so the step output depends only on Bx (the input embedding), not on h.
    let h_c: Sedenion = sed_complementary_zero_divisor()
    let ah_zd_norm: f64 = sed_norm(sed_mul(a_forget, h_c))
    // Construct generic A locally to avoid compiler bug with global-to-local copy in main()
    let a_gen: Sedenion = sed_add(sed_add(sed_basis(0, 0.5), sed_basis(1, 0.05)), sed_basis(2, 0.03))
    let ah_gen_norm: f64 = sed_norm(sed_mul(a_gen, h_c))
    if ah_zd_norm < 0.001 && ah_gen_norm > 0.01 {
        print("T5 PASS: ZD Ah="); print(ah_zd_norm)
        print(" gen Ah="); print(ah_gen_norm); println(" (ZD annihilates Ah term)")
        passed = passed + 1
    } else {
        println("T5 FAIL")
        failed = failed + 1
    }

    // T6: ZD pre-activation norm < generic — Ah=0 removes state contribution.
    // ZD step (token 4): Ah=0, embed=0 → pre-activation = 0.1*B_SED only (tiny).
    // Generic step (token 1): Ah≠0, embed=e1 → pre-activation = Ah + embed + 0.1*B.
    // Token 4 has no embedding and no Ah contribution → smallest possible activation.
    let bx_zd6: Sedenion = sed_scale(B_SED, 0.1)
    let a_gen2: Sedenion = sed_add(sed_add(sed_basis(0, 0.5), sed_basis(1, 0.05)), sed_basis(2, 0.03))
    let Ah_gen6: Sedenion = sed_mul(a_gen2, h_c)
    let Bx_gen6: Sedenion = sed_add(embed_s(1), sed_scale(B_SED, 0.1))
    let norm_comb_zd6: f64 = sed_norm(bx_zd6)
    let norm_comb_gen6: f64 = sed_norm(sed_add(Ah_gen6, Bx_gen6))
    if norm_comb_zd6 < norm_comb_gen6 {
        print("T6 PASS: ZD pre-activation="); print(norm_comb_zd6)
        print(" < generic="); print(norm_comb_gen6); println(" (Ah=0 removes state contribution)")
        passed = passed + 1
    } else {
        println("T6 FAIL")
        failed = failed + 1
    }

    // T7: Accuracy COLLAPSES after FORGET at D=40 (selective loses info)
    let acc_remember: i64 = eval_accuracy_sel(0, 40)
    let acc_forget: i64 = eval_accuracy_sel(1, 40)
    if acc_forget < acc_remember {
        print("T7 PASS: forget degrades accuracy "); print_int(acc_forget)
        print("/6 < remember "); print_int(acc_remember); println("/6")
        passed = passed + 1
    } else {
        println("T7 FAIL")
        failed = failed + 1
    }

    // T8: Stability
    var max_norm: f64 = 0.0
    var p: i64 = 0
    while p < 6 {
        var t1: i64 = 0; var t2: i64 = 0; var t3: i64 = 0
        if p == 0 { t1 = 1; t2 = 2; t3 = 3 }
        if p == 1 { t1 = 1; t2 = 3; t3 = 2 }
        if p == 2 { t1 = 2; t2 = 1; t3 = 3 }
        if p == 3 { t1 = 2; t2 = 3; t3 = 1 }
        if p == 4 { t1 = 3; t2 = 1; t3 = 2 }
        if p == 5 { t1 = 3; t2 = 2; t3 = 1 }
        let h: Sedenion = forward_sel(t1, t2, t3, 1, 40)
        let n: f64 = sed_norm(h)
        if n > max_norm { max_norm = n }
        p = p + 1
    }
    if max_norm < 100.0 {
        print("T8 PASS: max_norm="); print(max_norm); println(" (stable)")
        passed = passed + 1
    } else {
        println("T8 FAIL")
        failed = failed + 1
    }

    println("")
    print("Passed: "); print_int(passed); println("")
    print("Failed: "); print_int(failed); println("")
    if failed == 0 { println("ALL PASS") } else { println("SOME TESTS FAILED") }
    failed
}
