// Demo for stdlib/fractal/dimension.sio
//
// This file demonstrates usage of the fractal::dimension module.
// Module source: stdlib/fractal/dimension.sio

// ============================================================================

fn main() -> i32 {
    print("Fractal Dimension module loaded\n")

    // Test with a simple example
    var test_series: Vec<f64> = vec![]
    for i in 0..100 {
        let x = (i as f64) / 10.0
        test_series.push(x * x)
    }

    let result = higuchi_dimension(&test_series, 10)
    print("Higuchi test: D = ")
    print(result.dimension)
    print(", R² = ")
    print(result.r_squared)
    print("\n")

    0
}
