/// Compute optimal grid dimensions for a kernel
pub fn compute_grid_size(total_elements: u64, block_size: u32) -> u32 {
    let blocks = (total_elements + (block_size as u64) - 1) / (block_size as u64)
    blocks as u32
}

/// Synchronize GPU execution
