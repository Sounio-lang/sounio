// Demo for stdlib/fractal/multifractal.sio
//
// This file demonstrates usage of the fractal::multifractal module.
// Module source: stdlib/fractal/multifractal.sio

    0.0
}

fn main() -> i32 {
    print("Multifractal module loaded\n")

    // Simple test
    var test_grid = MeasureGrid {
        data: vec![],
        size_x: 8,
        size_y: 8,
        size_z: 8,
    }

    // Fill with random-ish pattern
    for i in 0..512 {
        test_grid.data.push((i % 7 + 1) as f64)
    }

    var scales: Vec<u32> = vec![]
    scales.push(2)
    scales.push(4)

    let spectrum = multifractal_spectrum(&test_grid, -2.0, 2.0, 5, &scales)
    print("Spectrum width: ")
    print(spectrum.spectrum_width)
    print("\n")

    0
}
