    if !sub17.ok { print("SILICON FAIL\n"); exit(1) }
    if !sub18.ok { print("SILICON FAIL\n"); exit(1) }
    if !fsrc.ok { print("SILICON FAIL\n"); exit(1) }
    if !movk.ok { print("SILICON FAIL\n"); exit(1) }
    if !amp.ok { print("SILICON FAIL\n"); exit(1) }
    if !dmul.ok { print("SILICON FAIL\n"); exit(1) }
    if !vol.ok { print("SILICON FAIL\n"); exit(1) }
    if vol.nbytes != 2472 { print("SILICON FAIL\n"); exit(1) }
    if !fdest.ok { print("SILICON FAIL\n"); exit(1) }
    let got = img_u32(img.ptr, 1428)
    print("BYTES=")
