// Images are built here. ptxas is not invoked.
// Mov immediate 0x01020304, FFMA addend 5.0 and SHFL delta 4
// were not copied from a second specimen file. The byte checks
// run before the driver. LOAD/STAMP run when libcuda is present.

use hetero::cuda_exec::{
    ce_alloc, ce_arg, ce_d2h, ce_function, ce_h2d, ce_launch_raw, ce_module_image, ce_open, ce_sync,
}
use hetero::silicon::image::{si_bar, si_cache, si_fma, si_fma_dest0, si_ldg, si_shfl, si_stamp, si_sub}
use hetero::silicon::sched::{arch_agx, arch_rdna, arch_sm89}

fn img_byte(data: *mut u8, off: i64) -> i64 with Div {
    (read_i64(data as *mut i64, off / 8) >> ((off % 8) * 8)) & 255
}

fn img_u32(data: *mut u8, off: i64) -> i64 with Div {
    img_byte(data, off) + img_byte(data, off + 1) * 256 + img_byte(data, off + 2) * 65536 + img_byte(data, off + 3) * 16777216
}

fn lane_xor4(i: i64) -> i64 {
    if (i & 4) == 0 { return i + 4 }
    i - 4
}

fn main() with IO, Mut, Panic, Div, Alloc {
    let arch = arch_sm89()
    let imm: i64 = 16909060
    let addend: i64 = 1084227584
    let img = si_stamp(arch, imm)
    let fma = si_fma(arch, addend)
    let sh = si_shfl(arch, 4)
    let bar_insn = si_bar(arch, 1, 0)
    let bar_both = si_bar(arch, 1, 1)
    let ldg = si_ldg(arch, 48)
    let cache = si_cache(arch, 62)
    let sub0 = si_sub(arch, 0)
    let sub1 = si_sub(arch, 1)
    let sub2 = si_sub(arch, 2)
    let sub3 = si_sub(arch, 3)
    let sub4 = si_sub(arch, 4)
    let sub5 = si_sub(arch, 5)
    let sub6 = si_sub(arch, 6)
    let fdest = si_fma_dest0(arch, addend)
    let rdna = si_stamp(arch_rdna(), imm)
    let agx = si_stamp(arch_agx(), imm)
    print("RDNA ok=")
    print_int(if rdna.ok { 1 } else { 0 })
    print("\n")
    print("AGX ok=")
    print_int(if agx.ok { 1 } else { 0 })
    print("\n")
    if rdna.ok { print("SILICON FAIL\n"); exit(1) }
    if agx.ok { print("SILICON FAIL\n"); exit(1) }
    if !img.ok { print("SILICON FAIL\n"); exit(1) }
    if !fma.ok { print("SILICON FAIL\n"); exit(1) }
    if !sh.ok { print("SILICON FAIL\n"); exit(1) }
    if !ldg.ok { print("SILICON FAIL\n"); exit(1) }
    if !cache.ok { print("SILICON FAIL\n"); exit(1) }
    if !sub0.ok { print("SILICON FAIL\n"); exit(1) }
    if !sub1.ok { print("SILICON FAIL\n"); exit(1) }
    if !sub2.ok { print("SILICON FAIL\n"); exit(1) }
    if !sub3.ok { print("SILICON FAIL\n"); exit(1) }
    if !sub4.ok { print("SILICON FAIL\n"); exit(1) }
    if !sub5.ok { print("SILICON FAIL\n"); exit(1) }
    if !sub6.ok { print("SILICON FAIL\n"); exit(1) }
    if !fdest.ok { print("SILICON FAIL\n"); exit(1) }
    let got = img_u32(img.ptr, 1428)
    print("BYTES=")
    print_int(got)
    print("\n")
    if got != imm { print("SILICON FAIL\n"); exit(1) }
    let fbits = img_u32(fma.ptr, 1508)
    print("FMA_BITS=")
    print_int(fbits)
    print("\n")
    if fbits != addend { print("SILICON FAIL\n"); exit(1) }
    let sbyte = img_byte(sh.ptr, 1478)
    print("SHFL_BYTE=")
    print_int(sbyte)
    print("\n")
    if sbyte != 128 { print("SILICON FAIL\n"); exit(1) }
    let bbyte = img_byte(bar_insn.ptr, 1430)
    print("BAR_BYTE=")
    print_int(bbyte)
    print("\n")
    if bbyte != 64 { print("SILICON FAIL\n"); exit(1) }
    let mbyte = img_byte(bar_both.ptr, 2506)
    print("BAR_META=")
    print_int(mbyte)
    print("\n")
    if mbyte != 32 { print("SILICON FAIL\n"); exit(1) }
    if img_byte(bar_insn.ptr, 2506) != 16 { print("SILICON FAIL\n"); exit(1) }
    let ldisp = img_u32(ldg.ptr, 1652)
    print("LDG_IMM=")
    print_int(ldisp)
    print("\n")
    if ldisp != 48 { print("SILICON FAIL\n"); exit(1) }
    let cbyte = img_byte(cache.ptr, 1754)
    print("CACHE_BYTE=")
    print_int(cbyte)
    print("\n")
    if cbyte != 62 { print("SILICON FAIL\n"); exit(1) }
    print("SUB_DST=")
    print_int(img_byte(sub0.ptr, 1538))
    print("\n")
    if img_byte(sub0.ptr, 1538) != 7 { print("SILICON FAIL\n"); exit(1) }
    if img_byte(sub0.ptr, 1543) != 128 { print("SILICON FAIL\n"); exit(1) }
    if img_byte(sub1.ptr, 1543) != 0 { print("SILICON FAIL\n"); exit(1) }
    if img_byte(sub1.ptr, 1545) != 225 { print("SILICON FAIL\n"); exit(1) }
    if img_byte(sub2.ptr, 1538) != 0 { print("SILICON FAIL\n"); exit(1) }
    if img_byte(sub2.ptr, 1543) != 128 { print("SILICON FAIL\n"); exit(1) }
    if img_byte(sub3.ptr, 1540) != 0 { print("SILICON FAIL\n"); exit(1) }
    if img_byte(sub3.ptr, 1538) != 7 { print("SILICON FAIL\n"); exit(1) }
    print("SRC_BYTE=")
    print_int(img_byte(sub3.ptr, 1540))
    print("\n")
    if img_byte(sub4.ptr, 1556) != 0 { print("SILICON FAIL\n"); exit(1) }
    print("STG_BYTE=")
    print_int(img_byte(sub4.ptr, 1556))
    print("\n")
    if img_byte(sub5.ptr, 1493) != 0 { print("SILICON FAIL\n"); exit(1) }
    print("OFF_BYTE=")
    print_int(img_byte(sub5.ptr, 1493))
    print("\n")
    if img_byte(sub6.ptr, 1555) != 2 { print("SILICON FAIL\n"); exit(1) }
    if img_byte(sub6.ptr, 1556) != 7 { print("SILICON FAIL\n"); exit(1) }
    print("ADDR_BYTE=")
    print_int(img_byte(sub6.ptr, 1555))
    print("\n")
    if img_byte(fdest.ptr, 1506) != 0 { print("SILICON FAIL\n"); exit(1) }
    if img_u32(fdest.ptr, 1508) != addend { print("SILICON FAIL\n"); exit(1) }
    print("FDEST_BYTE=")
    print_int(img_byte(fdest.ptr, 1506))
    print("\n")
    let exec = ce_open()
    if !exec.ok { print("NOCUDA\n"); exit(2) }

    let m = ce_module_image(&exec, img.ptr, img.nbytes)
    if m == 0 { print("SILICON FAIL\n"); exit(1) }
    let f = ce_function(&exec, m, "stamp")
    if f == 0 { print("SILICON FAIL\n"); exit(1) }
    let d = ce_alloc(&exec, 4)
    let params = heap_alloc(8)
    write_i64(params as *mut i64, 0, ce_arg(d) as i64)
    if ce_launch_raw(&exec, f, 1, 1, params) != 0 { print("SILICON FAIL\n"); exit(1) }
    if ce_sync(&exec) != 0 { print("SILICON FAIL\n"); exit(1) }
    let host = heap_alloc(8)
    write_i64(host as *mut i64, 0, 0)
    if ce_d2h(&exec, host, d, 4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let stamped = read_i64(host as *mut i64, 0) & 4294967295
    print("STAMP=")
    print_int(stamped)
    print("\n")
    if stamped != imm { print("SILICON FAIL\n"); exit(1) }

    let mf = ce_module_image(&exec, fma.ptr, fma.nbytes)
    print("FMA_LOAD=")
    print_int(if mf != 0 { 1 } else { 0 })
    print("\n")
    if mf == 0 { print("SILICON FAIL\n"); exit(1) }
    let ff = ce_function(&exec, mf, "stamp")
    if ff == 0 { print("SILICON FAIL\n"); exit(1) }
    let df = ce_alloc(&exec, 4)
    let pf = heap_alloc(8)
    write_i64(pf as *mut i64, 0, ce_arg(df) as i64)
    if ce_launch_raw(&exec, ff, 1, 1, pf) != 0 { print("SILICON FAIL\n"); exit(1) }
    if ce_sync(&exec) != 0 { print("SILICON FAIL\n"); exit(1) }
    let hf = heap_alloc(8)
    write_i64(hf as *mut i64, 0, 0)
    if ce_d2h(&exec, hf, df, 4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let fgot = read_i64(hf as *mut i64, 0) & 4294967295
    print("FMA=")
    print_int(fgot)
    print("\n")
    if fgot != 1088421888 { print("SILICON FAIL\n"); exit(1) }

    let ms = ce_module_image(&exec, sh.ptr, sh.nbytes)
    print("SHFL_LOAD=")
    print_int(if ms != 0 { 1 } else { 0 })
    print("\n")
    if ms == 0 { print("SILICON FAIL\n"); exit(1) }
    let fs = ce_function(&exec, ms, "stamp")
    if fs == 0 { print("SILICON FAIL\n"); exit(1) }
    let ds = ce_alloc(&exec, 128)
    let ps = heap_alloc(8)
    write_i64(ps as *mut i64, 0, ce_arg(ds) as i64)
    if ce_launch_raw(&exec, fs, 1, 32, ps) != 0 { print("SILICON FAIL\n"); exit(1) }
    if ce_sync(&exec) != 0 { print("SILICON FAIL\n"); exit(1) }
    let hs = heap_alloc(128)
    var z: i64 = 0
    while z < 16 { write_i64(hs as *mut i64, z, 0); z = z + 1 }
    if ce_d2h(&exec, hs, ds, 128) != 0 { print("SILICON FAIL\n"); exit(1) }
    var lane: i64 = 0
    while lane < 32 {
        let word = lane / 2
        let half = lane % 2
        let packed = read_i64(hs as *mut i64, word)
        var gotl = packed & 4294967295
        if half == 1 { gotl = (packed >> 32) & 4294967295 }
        if gotl != lane_xor4(lane) {
            print("SHFL_FAIL lane=")
            print_int(lane)
            print(" got=")
            print_int(gotl)
            print("\n")
            exit(1)
        }
        lane = lane + 1
    }
    print("SHFL=4\n")

    let mb1 = ce_module_image(&exec, bar_both.ptr, bar_both.nbytes)
    print("BAR_META_LOAD=")
    print_int(if mb1 != 0 { 1 } else { 0 })
    print("\n")
    if mb1 == 0 { print("SILICON FAIL\n"); exit(1) }
    let fb1 = ce_function(&exec, mb1, "stamp")
    if fb1 == 0 { print("SILICON FAIL\n"); exit(1) }
    let db1 = ce_alloc(&exec, 4)
    let pb1 = heap_alloc(8)
    write_i64(pb1 as *mut i64, 0, ce_arg(db1) as i64)
    let lst1 = ce_launch_raw(&exec, fb1, 1, 1, pb1)
    print("BAR_META_LAUNCH=")
    print_int(lst1 as i64)
    print("\n")
    if lst1 != 0 { print("SILICON FAIL\n"); exit(1) }
    if ce_sync(&exec) != 0 { print("SILICON FAIL\n"); exit(1) }
    let hb1 = heap_alloc(8)
    write_i64(hb1 as *mut i64, 0, 0)
    if ce_d2h(&exec, hb1, db1, 4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let bg1 = read_i64(hb1 as *mut i64, 0) & 4294967295
    print("BAR1=")
    print_int(bg1)
    print("\n")
    if bg1 != 16909060 { print("SILICON FAIL\n"); exit(1) }


    let ml = ce_module_image(&exec, ldg.ptr, ldg.nbytes)
    print("LDG_LOAD=")
    print_int(if ml != 0 { 1 } else { 0 })
    print("\n")
    if ml == 0 { print("SILICON FAIL\n"); exit(1) }
    let fl = ce_function(&exec, ml, "stamp")
    if fl == 0 { print("SILICON FAIL\n"); exit(1) }
    let din = ce_alloc(&exec, 64)
    let dout = ce_alloc(&exec, 16)
    if din == 0 { print("SILICON FAIL\n"); exit(1) }
    if dout == 0 { print("SILICON FAIL\n"); exit(1) }
    let hin = heap_alloc(64)
    var wi: i64 = 0
    while wi < 8 {
        let lo = 100 + wi * 2
        let hiw = 101 + wi * 2
        write_i64(hin as *mut i64, wi, lo + hiw * 4294967296)
        wi = wi + 1
    }
    if ce_h2d(&exec, din, hin, 64) != 0 { print("SILICON FAIL\n"); exit(1) }
    let pl = heap_alloc(16)
    write_i64(pl as *mut i64, 0, ce_arg(din) as i64)
    write_i64(pl as *mut i64, 1, ce_arg(dout) as i64)
    if ce_launch_raw(&exec, fl, 1, 1, pl) != 0 { print("SILICON FAIL\n"); exit(1) }
    if ce_sync(&exec) != 0 { print("SILICON FAIL\n"); exit(1) }
    let hol = heap_alloc(16)
    write_i64(hol as *mut i64, 0, 0)
    write_i64(hol as *mut i64, 1, 0)
    if ce_d2h(&exec, hol, dout, 16) != 0 { print("SILICON FAIL\n"); exit(1) }
    let lw0 = read_i64(hol as *mut i64, 0)
    let lw1 = read_i64(hol as *mut i64, 1)
    let l0 = lw0 & 4294967295
    let l1 = (lw0 >> 32) & 4294967295
    let l2 = lw1 & 4294967295
    let l3 = (lw1 >> 32) & 4294967295
    print("LDG=")
    print_int(l0)
    print(" ")
    print_int(l1)
    print(" ")
    print_int(l2)
    print(" ")
    print_int(l3)
    print("\n")
    if l0 != 112 { print("SILICON FAIL\n"); exit(1) }
    if l1 != 113 { print("SILICON FAIL\n"); exit(1) }
    if l2 != 114 { print("SILICON FAIL\n"); exit(1) }
    if l3 != 115 { print("SILICON FAIL\n"); exit(1) }

    let mc = ce_module_image(&exec, cache.ptr, cache.nbytes)
    print("CACHE_LOAD=")
    print_int(if mc != 0 { 1 } else { 0 })
    print("\n")
    if mc == 0 { print("SILICON FAIL\n"); exit(1) }
    let fc = ce_function(&exec, mc, "stamp")
    if fc == 0 { print("SILICON FAIL\n"); exit(1) }
    let cin = ce_alloc(&exec, 4)
    let cout = ce_alloc(&exec, 4)
    let hcin = heap_alloc(8)
    write_i64(hcin as *mut i64, 0, 42)
    if ce_h2d(&exec, cin, hcin, 4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let pc = heap_alloc(16)
    write_i64(pc as *mut i64, 0, ce_arg(cin) as i64)
    write_i64(pc as *mut i64, 1, ce_arg(cout) as i64)
    let cl = ce_launch_raw(&exec, fc, 1, 1, pc)
    print("CACHE_LAUNCH=")
    print_int(cl as i64)
    print("\n")
    if cl != 0 { print("SILICON FAIL\n"); exit(1) }
    let csyn = ce_sync(&exec)
    print("CACHE_SYNC=")
    print_int(csyn as i64)
    print("\n")
    if csyn != 0 { print("SILICON FAIL\n"); exit(1) }
    let hcout = heap_alloc(8)
    write_i64(hcout as *mut i64, 0, 0)
    if ce_d2h(&exec, hcout, cout, 4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let cgot = read_i64(hcout as *mut i64, 0) & 4294967295
    print("CACHE=")
    print_int(cgot)
    print("\n")
    if cgot != 42 { print("SILICON FAIL\n"); exit(1) }

    let hin2 = heap_alloc(8)
    write_i64(hin2 as *mut i64, 0, 10 + 3 * 4294967296)
    let din2 = ce_alloc(&exec, 8)
    let dout2 = ce_alloc(&exec, 4)
    if ce_h2d(&exec, din2, hin2, 8) != 0 { print("SILICON FAIL\n"); exit(1) }
    let m0 = ce_module_image(&exec, sub0.ptr, sub0.nbytes)
    print("SUB_LOAD=")
    print_int(if m0 != 0 { 1 } else { 0 })
    print("\n")
    if m0 == 0 { print("SILICON FAIL\n"); exit(1) }
    let f0 = ce_function(&exec, m0, "stamp")
    if f0 == 0 { print("SILICON FAIL\n"); exit(1) }
    let p0 = heap_alloc(16)
    write_i64(p0 as *mut i64, 0, ce_arg(din2) as i64)
    write_i64(p0 as *mut i64, 1, ce_arg(dout2) as i64)
    if ce_launch_raw(&exec, f0, 1, 1, p0) != 0 { print("SILICON FAIL\n"); exit(1) }
    if ce_sync(&exec) != 0 { print("SILICON FAIL\n"); exit(1) }
    let ho0 = heap_alloc(8)
    write_i64(ho0 as *mut i64, 0, 0)
    if ce_d2h(&exec, ho0, dout2, 4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let s0 = read_i64(ho0 as *mut i64, 0) & 4294967295
    print("SUB=")
    print_int(s0)
    print("\n")
    if s0 != 7 { print("SILICON FAIL\n"); exit(1) }

    let m1 = ce_module_image(&exec, sub1.ptr, sub1.nbytes)
    if m1 == 0 { print("SILICON FAIL\n"); exit(1) }
    let f1 = ce_function(&exec, m1, "stamp")
    if f1 == 0 { print("SILICON FAIL\n"); exit(1) }
    let dout1 = ce_alloc(&exec, 4)
    let p1 = heap_alloc(16)
    write_i64(p1 as *mut i64, 0, ce_arg(din2) as i64)
    write_i64(p1 as *mut i64, 1, ce_arg(dout1) as i64)
    if ce_launch_raw(&exec, f1, 1, 1, p1) != 0 { print("SILICON FAIL\n"); exit(1) }
    if ce_sync(&exec) != 0 { print("SILICON FAIL\n"); exit(1) }
    let ho1 = heap_alloc(8)
    write_i64(ho1 as *mut i64, 0, 0)
    if ce_d2h(&exec, ho1, dout1, 4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let s1 = read_i64(ho1 as *mut i64, 0) & 4294967295
    print("SUB_SWAP=")
    print_int(s1)
    print("\n")
    if s1 != 4294967289 { print("SILICON FAIL\n"); exit(1) }

    let m2 = ce_module_image(&exec, sub2.ptr, sub2.nbytes)
    print("SUB_DEST_LOAD=")
    print_int(if m2 != 0 { 1 } else { 0 })
    print("\n")
    if m2 == 0 { print("SILICON FAIL\n"); exit(1) }
    let f2 = ce_function(&exec, m2, "stamp")
    if f2 == 0 { print("SILICON FAIL\n"); exit(1) }
    let dout3 = ce_alloc(&exec, 4)
    let p2 = heap_alloc(16)
    write_i64(p2 as *mut i64, 0, ce_arg(din2) as i64)
    write_i64(p2 as *mut i64, 1, ce_arg(dout3) as i64)
    let dl = ce_launch_raw(&exec, f2, 1, 1, p2)
    print("SUB_DEST_LAUNCH=")
    print_int(dl as i64)
    print("\n")
    if dl != 0 { print("SILICON FAIL\n"); exit(1) }
    let dsyn = ce_sync(&exec)
    print("SUB_DEST_SYNC=")
    print_int(dsyn as i64)
    print("\n")
    if dsyn != 0 { print("SILICON FAIL\n"); exit(1) }
    let ho2 = heap_alloc(8)
    write_i64(ho2 as *mut i64, 0, 0)
    if ce_d2h(&exec, ho2, dout3, 4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let s2 = read_i64(ho2 as *mut i64, 0) & 4294967295
    print("SUB_DEST=")
    print_int(s2)
    print("\n")
    if s2 != 3 { print("SILICON FAIL\n"); exit(1) }

    let m3 = ce_module_image(&exec, sub3.ptr, sub3.nbytes)
    print("SRC_LOAD=")
    print_int(if m3 != 0 { 1 } else { 0 })
    print("\n")
    if m3 == 0 { print("SILICON FAIL\n"); exit(1) }
    let f3 = ce_function(&exec, m3, "stamp")
    if f3 == 0 { print("SILICON FAIL\n"); exit(1) }
    let dout_s = ce_alloc(&exec, 4)
    let p3 = heap_alloc(16)
    write_i64(p3 as *mut i64, 0, ce_arg(din2) as i64)
    write_i64(p3 as *mut i64, 1, ce_arg(dout_s) as i64)
    if ce_launch_raw(&exec, f3, 1, 1, p3) != 0 { print("SILICON FAIL\n"); exit(1) }
    let syn3 = ce_sync(&exec)
    print("SRC_SYNC=")
    print_int(syn3 as i64)
    print("\n")
    if syn3 != 0 { print("SILICON FAIL\n"); exit(1) }
    let ho3 = heap_alloc(8)
    write_i64(ho3 as *mut i64, 0, 0)
    if ce_d2h(&exec, ho3, dout_s, 4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let s3 = read_i64(ho3 as *mut i64, 0) & 4294967295
    print("SRC=")
    print_int(s3)
    print("\n")
    if s3 != 0 { print("SILICON FAIL\n"); exit(1) }

    let m4 = ce_module_image(&exec, sub4.ptr, sub4.nbytes)
    print("STG_LOAD=")
    print_int(if m4 != 0 { 1 } else { 0 })
    print("\n")
    if m4 == 0 { print("SILICON FAIL\n"); exit(1) }
    let f4 = ce_function(&exec, m4, "stamp")
    if f4 == 0 { print("SILICON FAIL\n"); exit(1) }
    let dout_t = ce_alloc(&exec, 4)
    let p4 = heap_alloc(16)
    write_i64(p4 as *mut i64, 0, ce_arg(din2) as i64)
    write_i64(p4 as *mut i64, 1, ce_arg(dout_t) as i64)
    if ce_launch_raw(&exec, f4, 1, 1, p4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let syn4 = ce_sync(&exec)
    print("STG_SYNC=")
    print_int(syn4 as i64)
    print("\n")
    if syn4 != 0 { print("SILICON FAIL\n"); exit(1) }
    let ho4 = heap_alloc(8)
    write_i64(ho4 as *mut i64, 0, 0)
    if ce_d2h(&exec, ho4, dout_t, 4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let s4 = read_i64(ho4 as *mut i64, 0) & 4294967295
    print("STG=")
    print_int(s4)
    print("\n")
    if s4 != 10 { print("SILICON FAIL\n"); exit(1) }

    let m5 = ce_module_image(&exec, sub5.ptr, sub5.nbytes)
    print("OFF_LOAD=")
    print_int(if m5 != 0 { 1 } else { 0 })
    print("\n")
    if m5 == 0 { print("SILICON FAIL\n"); exit(1) }
    let f5 = ce_function(&exec, m5, "stamp")
    if f5 == 0 { print("SILICON FAIL\n"); exit(1) }
    let dout_o = ce_alloc(&exec, 4)
    let p5 = heap_alloc(16)
    write_i64(p5 as *mut i64, 0, ce_arg(din2) as i64)
    write_i64(p5 as *mut i64, 1, ce_arg(dout_o) as i64)
    if ce_launch_raw(&exec, f5, 1, 1, p5) != 0 { print("SILICON FAIL\n"); exit(1) }
    let syn5 = ce_sync(&exec)
    print("OFF_SYNC=")
    print_int(syn5 as i64)
    print("\n")
    if syn5 != 0 { print("SILICON FAIL\n"); exit(1) }
    let ho5 = heap_alloc(8)
    write_i64(ho5 as *mut i64, 0, 0)
    if ce_d2h(&exec, ho5, dout_o, 4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let s5 = read_i64(ho5 as *mut i64, 0) & 4294967295
    print("OFF=")
    print_int(s5)
    print("\n")
    if s5 != 0 { print("SILICON FAIL\n"); exit(1) }

    let hin6 = heap_alloc(8)
    write_i64(hin6 as *mut i64, 0, 10 + 3 * 4294967296)
    let din6 = ce_alloc(&exec, 8)
    let dout6 = ce_alloc(&exec, 4)
    let hz = heap_alloc(8)
    write_i64(hz as *mut i64, 0, 0)
    if ce_h2d(&exec, din6, hin6, 8) != 0 { print("SILICON FAIL\n"); exit(1) }
    if ce_h2d(&exec, dout6, hz, 4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let m6 = ce_module_image(&exec, sub6.ptr, sub6.nbytes)
    print("ADDR_LOAD=")
    print_int(if m6 != 0 { 1 } else { 0 })
    print("\n")
    if m6 == 0 { print("SILICON FAIL\n"); exit(1) }
    let f6 = ce_function(&exec, m6, "stamp")
    if f6 == 0 { print("SILICON FAIL\n"); exit(1) }
    let p6 = heap_alloc(16)
    write_i64(p6 as *mut i64, 0, ce_arg(din6) as i64)
    write_i64(p6 as *mut i64, 1, ce_arg(dout6) as i64)
    if ce_launch_raw(&exec, f6, 1, 1, p6) != 0 { print("SILICON FAIL\n"); exit(1) }
    let syn6 = ce_sync(&exec)
    print("ADDR_SYNC=")
    print_int(syn6 as i64)
    print("\n")
    if syn6 != 0 { print("SILICON FAIL\n"); exit(1) }
    let ho_in = heap_alloc(8)
    let ho_out = heap_alloc(8)
    write_i64(ho_in as *mut i64, 0, 0)
    write_i64(ho_out as *mut i64, 0, 0)
    if ce_d2h(&exec, ho_in, din6, 8) != 0 { print("SILICON FAIL\n"); exit(1) }
    if ce_d2h(&exec, ho_out, dout6, 4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let packed = read_i64(ho_in as *mut i64, 0)
    let ain = packed & 4294967295
    let ain1 = (packed >> 32) & 4294967295
    let aout = read_i64(ho_out as *mut i64, 0) & 4294967295
    print("ADDR_IN=")
    print_int(ain)
    print("\n")
    print("ADDR_IN1=")
    print_int(ain1)
    print("\n")
    print("ADDR_OUT=")
    print_int(aout)
    print("\n")
    if ain != 7 { print("SILICON FAIL\n"); exit(1) }
    if ain1 != 3 { print("SILICON FAIL\n"); exit(1) }
    if aout != 0 { print("SILICON FAIL\n"); exit(1) }

    let md = ce_module_image(&exec, fdest.ptr, fdest.nbytes)
    print("FDEST_LOAD=")
    print_int(if md != 0 { 1 } else { 0 })
    print("\n")
    if md == 0 { print("SILICON FAIL\n"); exit(1) }
    let fd = ce_function(&exec, md, "stamp")
    if fd == 0 { print("SILICON FAIL\n"); exit(1) }
    let dd = ce_alloc(&exec, 4)
    let pd = heap_alloc(8)
    write_i64(pd as *mut i64, 0, ce_arg(dd) as i64)
    if ce_launch_raw(&exec, fd, 1, 1, pd) != 0 { print("SILICON FAIL\n"); exit(1) }
    let synd = ce_sync(&exec)
    print("FDEST_SYNC=")
    print_int(synd as i64)
    print("\n")
    if synd != 0 { print("SILICON FAIL\n"); exit(1) }
    let hod = heap_alloc(8)
    write_i64(hod as *mut i64, 0, 0)
    if ce_d2h(&exec, hod, dd, 4) != 0 { print("SILICON FAIL\n"); exit(1) }
    let fdv = read_i64(hod as *mut i64, 0) & 4294967295
    print("FDEST=")
    print_int(fdv)
    print("\n")
    if fdv != 1073741824 { print("SILICON FAIL\n"); exit(1) }

    print("SILICON PASS\n")
    exit(0)
}
