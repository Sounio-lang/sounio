//@ run-pass
//@ expect-stdout: FO_PK_IMPORT_AUC_THALF_DRIVER_PASS

// R5 import ↔ method parity — multi-mod epistemic::fo vs Pk methods.
//
// Freezes (same seeds as R5 method driver):
//   AUC=80, Var=114.6, E₂=80.688
//   kel=0.1, Var=5.2e-5
//   t½=6.931471, Var=0.249835
//
// Not clinical guidance. Gate greps science table.

use epistemic::fo::{fo_auc, fo_kel, fo_thalf, fo_clearance}

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn clearance(self: &Pk, eta: f64) -> f64 {
        self.cl0 * exp(eta)
    }
    fn volume(self: &Pk, eta: f64) -> f64 {
        self.v0 * exp(eta)
    }
    fn auc(self: &Pk, f: f64, dose: f64, eta: f64) -> f64 {
        (f * dose) / self.clearance(eta)
    }
    fn kel(self: &Pk, eta: f64) -> f64 {
        self.clearance(eta) / self.volume(eta)
    }
    fn thalf(self: &Pk, eta: f64) -> f64 {
        0.6931471805599453 / self.kel(eta)
    }
}

fn make_pk(cl0: f64, v0: f64) -> Pk {
    Pk { cl0: cl0, v0: v0 }
}

fn main() with IO, Mut, Div, Epistemic {
    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)

    let f = kF.value
    let dose = kDose.value
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let pk = Pk { cl0: cl0, v0: v0 }

    // Import multi-mod
    let v_auc_imp = variance_of(fo_auc(f, dose, cl0, eta))
    let e2_auc_imp = second_order_mean(fo_auc(f, dose, cl0, eta))
    let v_kel_imp = variance_of(fo_kel(cl0, v0, eta))
    let v_thalf_imp = variance_of(fo_thalf(cl0, v0, eta))
    let v_cl_imp = variance_of(fo_clearance(cl0, eta))

    // Method
    let v_auc_meth = variance_of(pk.auc(f, dose, eta))
    let e2_auc_meth = second_order_mean(pk.auc(f, dose, eta))
    let v_kel_meth = variance_of(pk.kel(eta))
    let v_thalf_meth = variance_of(pk.thalf(eta))

    // Call-result
    let v_auc_call = variance_of(make_pk(cl0, v0).auc(f, dose, eta))
    let v_thalf_call = variance_of(make_pk(cl0, v0).thalf(eta))

    // Site / peel
    let v_auc_site = variance_of((f * dose) / fo_clearance(cl0, eta))
    let v_thalf_peel = variance_of(0.6931471805599453 * v0 / cl0)

    print("=== FO_PK_IMPORT_AUC_THALF science table ===\n")
    print("v_auc_imp="); print_f64(v_auc_imp); print("\n")
    print("v_auc_meth="); print_f64(v_auc_meth); print("\n")
    print("v_auc_call="); print_f64(v_auc_call); print("\n")
    print("v_auc_site="); print_f64(v_auc_site); print("\n")
    print("e2_auc_imp="); print_f64(e2_auc_imp); print("\n")
    print("e2_auc_meth="); print_f64(e2_auc_meth); print("\n")
    print("v_kel_imp="); print_f64(v_kel_imp); print("\n")
    print("v_kel_meth="); print_f64(v_kel_meth); print("\n")
    print("v_thalf_imp="); print_f64(v_thalf_imp); print("\n")
    print("v_thalf_meth="); print_f64(v_thalf_meth); print("\n")
    print("v_thalf_call="); print_f64(v_thalf_call); print("\n")
    print("v_thalf_peel="); print_f64(v_thalf_peel); print("\n")
    print("v_cl_imp="); print_f64(v_cl_imp); print("\n")
    print("FO_PK_IMPORT_AUC_THALF_DRIVER_PASS\n")
}
