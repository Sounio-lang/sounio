//@ run-pass
//@ expect-stdout: FO_PK_STRUCT_AUCT_DRIVER_PASS

// R12 — Steady-state AUC over dosing interval AUC_τ = F·Dose/CL = Css·τ.
//
// Links R1 Css and R5 single-dose AUC under multi-dose linear PK:
//   AUC_τ,ss = F·Dose/CL  (same algebra as fo_auc)
//   AUC_τ,ss = Css·τ      (identity when τ fixed)
//
// Freezes (F=0.8±0.05, Dose=500±10, CL0=5±0.3, η=0±0.1, τ=12):
//   AUC_τ = 80, Var = 114.6, E₂ = 80.688  (= Css·τ FO)
//   Css   = 6.666666, Var = 0.795833
//
// Not clinical guidance.

struct Pk {
    cl0: f64
}

impl Pk {
    fn css(self: &Pk, f: f64, dose: f64, tau: f64, eta: f64) -> f64 {
        (f * dose / tau) / (self.cl0 * exp(eta))
    }
    fn auc_tau(self: &Pk, f: f64, dose: f64, eta: f64) -> f64 {
        (f * dose) / (self.cl0 * exp(eta))
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let f = kF.value
    let dose = kDose.value
    let cl0 = kCL0.value
    let eta = kEta.value
    let tau = 12.0
    let pk = Pk { cl0: cl0 }

    let auct_pt = pk.auc_tau(f, dose, eta)
    let css_pt = pk.css(f, dose, tau, eta)

    let v_auct = variance_of(pk.auc_tau(f, dose, eta))
    let e2_auct = second_order_mean(pk.auc_tau(f, dose, eta))
    let v_css_tau = variance_of(pk.css(f, dose, tau, eta) * tau)
    let e2_css_tau = second_order_mean(pk.css(f, dose, tau, eta) * tau)
    let v_css = variance_of(pk.css(f, dose, tau, eta))

    print("=== FO_PK_STRUCT_AUCT science table ===\n")
    print("auct_point="); print_f64(auct_pt); print("\n")
    print("v_auct="); print_f64(v_auct); print("\n")
    print("e2_auct="); print_f64(e2_auct); print("\n")
    print("v_css_tau="); print_f64(v_css_tau); print("\n")
    print("e2_css_tau="); print_f64(e2_css_tau); print("\n")
    print("css_point="); print_f64(css_pt); print("\n")
    print("v_css="); print_f64(v_css); print("\n")
    print("FO_PK_STRUCT_AUCT_DRIVER_PASS\n")
}
