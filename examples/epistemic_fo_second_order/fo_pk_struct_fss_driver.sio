//@ run-pass
//@ expect-stdout: FO_PK_STRUCT_FSS_DRIVER_PASS

// R8 — Fraction of steady state after n doses + doses to 90% SS.
//
//   f_ss(n) = 1 − exp(−n·kel·τ)     (shared η cancels in kel)
//   n₉₀     = ln(10)/(kel·τ)        (intervals to 90% of Css)
//
// Freezes (CL0=5±0.3, V0=50±2, η=0±0.1, τ=12, n=3):
//   f_ss(3) = 0.972676, Var = 0.000050, E₂ = 0.971912
//   n₉₀     = 1.918820, Var = 0.019145 (= peel ln10·V0/(CL0·τ))
//
// Not clinical guidance. Gate greps science table.

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn fss(self: &Pk, n: f64, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        1.0 - exp(0.0 - n * kel * tau)
    }
    fn n90(self: &Pk, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        2.302585092994046 / (kel * tau)
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let tau = 12.0
    let n3 = 3.0
    let pk = Pk { cl0: cl0, v0: v0 }

    let fss_pt = pk.fss(n3, tau, eta)
    let n90_pt = pk.n90(tau, eta)

    let v_fss = variance_of(pk.fss(n3, tau, eta))
    let e2_fss = second_order_mean(pk.fss(n3, tau, eta))
    let v_fss_peel = variance_of(1.0 - exp(0.0 - n3 * (cl0 / v0) * tau))
    let v_n90 = variance_of(pk.n90(tau, eta))
    let v_n90_peel = variance_of(2.302585092994046 * v0 / (cl0 * tau))

    print("=== FO_PK_STRUCT_FSS science table ===\n")
    print("fss3_point="); print_f64(fss_pt); print("\n")
    print("v_fss3="); print_f64(v_fss); print("\n")
    print("e2_fss3="); print_f64(e2_fss); print("\n")
    print("v_fss3_peel="); print_f64(v_fss_peel); print("\n")
    print("n90_point="); print_f64(n90_pt); print("\n")
    print("v_n90="); print_f64(v_n90); print("\n")
    print("v_n90_peel="); print_f64(v_n90_peel); print("\n")
    print("FO_PK_STRUCT_FSS_DRIVER_PASS\n")
}
