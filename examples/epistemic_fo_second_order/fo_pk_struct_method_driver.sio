//@ run-pass
//@ expect-stdout: FO_PK_STRUCT_METHOD_DRIVER_PASS

// Dissertation-shaped PK science driver — method FO stack after Madaros FO 42/42.
//
// Model (oral steady-state):
//   rate = F · Dose / τ
//   CL   = CL0 · exp(η)
//   Css  = rate / CL
//   exposure = CL · V  with V = V0 · exp(η_v)
//
// Surfaces (Madaros FO trust ≥42):
//   struct-lit methods · call-result methods · let-alias · nested methods
//   free-fn parity · shared peel η · distinct measures + correlate(ρ=1)
//
// Analytic refs (F=0.8±0.05, Dose=500±10, τ=12, CL0=5±0.3, V0=50±2, η=0±0.1):
//   Css point ≈ 6.666667, Var(CL)=0.34, Var(Css)=0.795833, E₂=6.724, ΣH≈7.292592
//   exposure CL0·V0·exp(·): shared η → Var=2825; independent η → 1575; ρ=1 → 2825
//   (f=CL0·V0·e^{2η}: s_cl=50,s_v=5,s_η=500 → 225+100+2500=2825;
//    independent η1,η2: s_η1=s_η2=250 → 225+100+625+625=1575)
//
// Acceptance: gate greps science-table numbers (in-function bool chains after
// heavy FO currently SEGV under Madaros — residual; table is the witness).
// Not clinical guidance.

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn clearance(self: &Pk, eta: f64) -> f64 {
        self.cl0 * exp(eta)
    }
    fn volume(self: &Pk, eta: f64) -> f64 {
        self.v0 * exp(eta)
    }
    fn rate(self: &Pk, f: f64, dose: f64, tau: f64) -> f64 {
        (f * dose) / tau
    }
    fn css(self: &Pk, f: f64, dose: f64, tau: f64, eta: f64) -> f64 {
        self.rate(f, dose, tau) / self.clearance(eta)
    }
    fn exposure(self: &Pk, eta_cl: f64, eta_v: f64) -> f64 {
        self.clearance(eta_cl) * self.volume(eta_v)
    }
}

fn make_pk(cl0: f64, v0: f64) -> Pk {
    Pk { cl0: cl0, v0: v0 }
}

fn free_css(f: f64, dose: f64, tau: f64, cl0: f64, eta: f64) -> f64 {
    ((f * dose) / tau) / (cl0 * exp(eta))
}

fn main() with IO, Mut, Div, Epistemic {
    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)

    let f = kF.value
    let dose = kDose.value
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let tau = 12.0

    let pk = Pk { cl0: cl0, v0: v0 }

    let css_pt = pk.css(f, dose, tau, eta)
    let v_css_lit = variance_of(pk.css(f, dose, tau, eta))
    let m2_css_lit = second_order_mean(pk.css(f, dose, tau, eta))
    let h_css_lit = hessian_diag_of(pk.css(f, dose, tau, eta))
    let v_cl_lit = variance_of(pk.clearance(eta))
    let v_css_call = variance_of(make_pk(cl0, v0).css(f, dose, tau, eta))
    let m2_css_call = second_order_mean(make_pk(cl0, v0).css(f, dose, tau, eta))
    let pk_alias = make_pk(cl0, v0)
    let v_css_alias = variance_of(pk_alias.css(f, dose, tau, eta))
    let v_css_free = variance_of(free_css(f, dose, tau, cl0, eta))
    let v_css_site = variance_of(pk.rate(f, dose, tau) / pk.clearance(eta))
    let v_exp_shared = variance_of(pk.exposure(eta, eta))
    let e_cl: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let e_v: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let eta_cl = e_cl.value
    let eta_v = e_v.value
    let v_exp_indep = variance_of(pk.exposure(eta_cl, eta_v))
    let _r = correlate(eta_cl, eta_v, 1.0)
    let v_exp_rho1 = variance_of(pk.exposure(eta_cl, eta_v))

    print("=== FO_PK_STRUCT_METHOD science table ===\n")
    print("css_point="); print_f64(css_pt); print("\n")
    print("v_css_lit="); print_f64(v_css_lit); print("\n")
    print("v_css_call="); print_f64(v_css_call); print("\n")
    print("v_css_alias="); print_f64(v_css_alias); print("\n")
    print("v_css_free="); print_f64(v_css_free); print("\n")
    print("v_css_site="); print_f64(v_css_site); print("\n")
    print("m2_css_lit="); print_f64(m2_css_lit); print("\n")
    print("m2_css_call="); print_f64(m2_css_call); print("\n")
    print("h_css_lit="); print_f64(h_css_lit); print("\n")
    print("bias_css="); print_f64(m2_css_lit - css_pt); print("\n")
    print("v_cl_lit="); print_f64(v_cl_lit); print("\n")
    print("v_exp_shared="); print_f64(v_exp_shared); print("\n")
    print("v_exp_indep="); print_f64(v_exp_indep); print("\n")
    print("v_exp_rho1="); print_f64(v_exp_rho1); print("\n")
    print("FO_PK_STRUCT_METHOD_DRIVER_PASS\n")
}
