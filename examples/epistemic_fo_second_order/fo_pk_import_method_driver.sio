//@ run-pass
//@ expect-stdout: FO_PK_IMPORT_METHOD_DRIVER_PASS

// Import + method FO parity — multi-mod stdlib helpers vs Pk struct methods.
//
// Closes the science loop after FO 42/42 and the method/ρ/multidose drivers:
// the same oral Css model must agree whether FO walks
//   • imported pure helpers  (use epistemic::fo::{fo_css,…})
//   • dissertation Pk methods (struct-lit / call-result / free parity)
//
// Model: Css = (F·Dose/τ)/(CL0·exp(η))
// Frozen refs (F=0.8±0.05, Dose=500±10, τ=12, CL0=5±0.3, η=0±0.1):
//   Var(Css)=0.795833, E₂=6.724, Var(CL)=0.34, Var(rate)=4.784722
//
// Not clinical guidance. Gate greps the science table.

use epistemic::fo::{fo_css, fo_clearance, fo_infusion_rate}

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn clearance(self: &Pk, eta: f64) -> f64 {
        self.cl0 * exp(eta)
    }
    fn rate(self: &Pk, f: f64, dose: f64, tau: f64) -> f64 {
        (f * dose) / tau
    }
    fn css(self: &Pk, f: f64, dose: f64, tau: f64, eta: f64) -> f64 {
        self.rate(f, dose, tau) / self.clearance(eta)
    }
}

fn make_pk(cl0: f64, v0: f64) -> Pk {
    Pk { cl0: cl0, v0: v0 }
}

fn main() with IO, Mut, Div, Epistemic {
    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)

    let f = kF.value
    let dose = kDose.value
    let cl0 = kCL0.value
    let eta = kEta.value
    let tau = 12.0
    let v0 = 50.0

    let pk = Pk { cl0: cl0, v0: v0 }

    // ── Imported multi-mod path ──
    let css_imp = fo_css(f, dose, tau, cl0, eta)
    let v_css_imp = variance_of(fo_css(f, dose, tau, cl0, eta))
    let m2_css_imp = second_order_mean(fo_css(f, dose, tau, cl0, eta))
    let v_cl_imp = variance_of(fo_clearance(cl0, eta))
    let v_rate_imp = variance_of(fo_infusion_rate(f, dose, tau))

    // ── Pk method path (struct-lit) ──
    let css_meth = pk.css(f, dose, tau, eta)
    let v_css_meth = variance_of(pk.css(f, dose, tau, eta))
    let m2_css_meth = second_order_mean(pk.css(f, dose, tau, eta))
    let v_cl_meth = variance_of(pk.clearance(eta))
    let v_rate_meth = variance_of(pk.rate(f, dose, tau))

    // ── Call-result method path ──
    let v_css_call = variance_of(make_pk(cl0, v0).css(f, dose, tau, eta))
    let m2_css_call = second_order_mean(make_pk(cl0, v0).css(f, dose, tau, eta))
    let v_cl_call = variance_of(make_pk(cl0, v0).clearance(eta))

    // ── Nested site (methods composed at call site) ──
    let v_css_site = variance_of(pk.rate(f, dose, tau) / pk.clearance(eta))
    // Import composed at call site
    let v_css_imp_site = variance_of(
        fo_infusion_rate(f, dose, tau) / fo_clearance(cl0, eta)
    )

    print("=== FO_PK_IMPORT_METHOD science table ===\n")
    print("css_imp="); print_f64(css_imp); print("\n")
    print("css_meth="); print_f64(css_meth); print("\n")
    print("v_css_imp="); print_f64(v_css_imp); print("\n")
    print("v_css_meth="); print_f64(v_css_meth); print("\n")
    print("v_css_call="); print_f64(v_css_call); print("\n")
    print("v_css_site="); print_f64(v_css_site); print("\n")
    print("v_css_imp_site="); print_f64(v_css_imp_site); print("\n")
    print("m2_css_imp="); print_f64(m2_css_imp); print("\n")
    print("m2_css_meth="); print_f64(m2_css_meth); print("\n")
    print("m2_css_call="); print_f64(m2_css_call); print("\n")
    print("v_cl_imp="); print_f64(v_cl_imp); print("\n")
    print("v_cl_meth="); print_f64(v_cl_meth); print("\n")
    print("v_cl_call="); print_f64(v_cl_call); print("\n")
    print("v_rate_imp="); print_f64(v_rate_imp); print("\n")
    print("v_rate_meth="); print_f64(v_rate_meth); print("\n")
    print("FO_PK_IMPORT_METHOD_DRIVER_PASS\n")
}
