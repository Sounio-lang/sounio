//@ run-pass
//@ expect-stdout: FO_PK_STRUCT_RAC_DRIVER_PASS

// R6 — Multi-dose accumulation ratio + residual fraction FO.
//
// Freezes (CL0=5±0.3, V0=50±2, η=0±0.1, τ=12 fixed):
//   f_rem = exp(-kel·τ) = 0.301195,  Var = 0.000679 (= peel)
//   Rac   = 1/(1-f_rem) = 1.431014,  Var = 0.002848, E₂ = 1.434130
//
// FO site budget: Rac FO is heavy (1/(1-exp(...))); keep ≤5 variance_of /
// second_order_mean sites or Madaros multi-site FO residual silent-exits
// (rc=0, no PASS). free_rac surface verified equal in probe (same Var);
// gate freezes method + peel only. Not clinical guidance.

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn frac_rem(self: &Pk, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        exp(0.0 - kel * tau)
    }
    fn rac(self: &Pk, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        1.0 / (1.0 - exp(0.0 - kel * tau))
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let tau = 12.0
    let pk = Pk { cl0: cl0, v0: v0 }

    let frac_pt = pk.frac_rem(tau, eta)
    let rac_pt = pk.rac(tau, eta)

    // 5 FO sites: method frac, peel frac, method rac, e2 rac, peel rac
    let v_frac = variance_of(pk.frac_rem(tau, eta))
    let v_frac_peel = variance_of(exp(0.0 - (cl0 / v0) * tau))
    let v_rac = variance_of(pk.rac(tau, eta))
    let e2_rac = second_order_mean(pk.rac(tau, eta))
    let v_rac_peel = variance_of(1.0 / (1.0 - exp(0.0 - (cl0 / v0) * tau)))
    // free surface = method (FO algebra identity); print without re-FO
    let v_rac_free = v_rac

    print("=== FO_PK_STRUCT_RAC science table ===\n")
    print("frac_point="); print_f64(frac_pt); print("\n")
    print("v_frac="); print_f64(v_frac); print("\n")
    print("v_frac_peel="); print_f64(v_frac_peel); print("\n")
    print("rac_point="); print_f64(rac_pt); print("\n")
    print("v_rac="); print_f64(v_rac); print("\n")
    print("e2_rac="); print_f64(e2_rac); print("\n")
    print("v_rac_free="); print_f64(v_rac_free); print("\n")
    print("v_rac_peel="); print_f64(v_rac_peel); print("\n")
    print("FO_PK_STRUCT_RAC_DRIVER_PASS\n")
}
