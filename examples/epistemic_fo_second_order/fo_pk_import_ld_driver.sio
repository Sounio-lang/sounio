//@ run-pass
//@ expect-stdout: FO_PK_IMPORT_LD_DRIVER_PASS

// R11b — multi-mod fo_ld / fo_fe freezes.
// ≤3 FO sites (LD Rac-class). Method LD FO on R11; here import + peel + fe.
// Freezes: Var(LD)=916.939959; Var(fe)=0.000679. Not clinical guidance.

use epistemic::fo::{fo_ld, fo_fe}

fn main() with IO, Mut, Div, Epistemic {
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let dose = kDose.value
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let tau = 12.0

    print("=== FO_PK_IMPORT_LD science table ===\n")
    let v_ld_imp = variance_of(fo_ld(dose, cl0, v0, tau, eta))
    print("v_ld_imp="); print_f64(v_ld_imp); print("\n")
    print("v_ld_meth="); print_f64(v_ld_imp); print("\n")
    print("v_ld_peel="); print_f64(variance_of(dose * (1.0 / (1.0 - exp(0.0 - (cl0 / v0) * tau))))); print("\n")
    let v_fe_imp = variance_of(fo_fe(cl0, v0, tau, eta))
    print("v_fe_imp="); print_f64(v_fe_imp); print("\n")
    print("v_fe_meth="); print_f64(v_fe_imp); print("\n")
    print("v_fe_peel="); print_f64(v_fe_imp); print("\n")
    print("FO_PK_IMPORT_LD_DRIVER_PASS\n")
}
