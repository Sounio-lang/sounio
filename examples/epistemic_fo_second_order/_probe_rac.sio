struct Pk {
    cl0: f64
    v0: f64
}
impl Pk {
    fn frac_rem(self: &Pk, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        exp(0.0 - kel * tau)
    }
    fn rac(self: &Pk, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        1.0 / (1.0 - exp(0.0 - kel * tau))
    }
}
fn make_pk(cl0: f64, v0: f64) -> Pk {
    Pk { cl0: cl0, v0: v0 }
}
fn free_frac(cl0: f64, v0: f64, tau: f64, eta: f64) -> f64 {
    let kel = (cl0 * exp(eta)) / (v0 * exp(eta))
    exp(0.0 - kel * tau)
}
fn free_rac(cl0: f64, v0: f64, tau: f64, eta: f64) -> f64 {
    let kel = (cl0 * exp(eta)) / (v0 * exp(eta))
    1.0 / (1.0 - exp(0.0 - kel * tau))
}
fn main() with IO, Mut, Div, Epistemic {
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let tau = 12.0
    let pk = Pk { cl0: cl0, v0: v0 }
    print("a\n")
    let v_frac = variance_of(pk.frac_rem(tau, eta))
    print("b\n")
    let v_frac_call = variance_of(make_pk(cl0, v0).frac_rem(tau, eta))
    print("c\n")
    let v_frac_free = variance_of(free_frac(cl0, v0, tau, eta))
    print("d\n")
    let v_frac_peel = variance_of(exp(0.0 - (cl0 / v0) * tau))
    print("e\n")
    let v_rac = variance_of(pk.rac(tau, eta))
    print("f\n")
    let e2_rac = second_order_mean(pk.rac(tau, eta))
    print("g\n")
    let v_rac_call = variance_of(make_pk(cl0, v0).rac(tau, eta))
    print("h\n")
    print_f64(v_frac); print(" "); print_f64(v_rac); print(" "); print_f64(e2_rac); print("\n")
    print("PASS\n")
}
