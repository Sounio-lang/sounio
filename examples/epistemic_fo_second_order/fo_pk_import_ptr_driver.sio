//@ run-pass
//@ expect-stdout: FO_PK_IMPORT_PTR_DRIVER_PASS

// R9b — multi-mod fo_ptr / fo_dof ↔ method / peel.
// Freezes: Var(PTR)=Var(DOF)=0.082541. Not clinical guidance.

use epistemic::fo::{fo_ptr, fo_dof}

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn ptr(self: &Pk, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        exp(kel * tau)
    }
    fn dof(self: &Pk, tau: f64, eta: f64) -> f64 {
        exp(((self.cl0 * exp(eta)) / (self.v0 * exp(eta))) * tau) - 1.0
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let tau = 12.0
    let pk = Pk { cl0: cl0, v0: v0 }

    let v_ptr_imp = variance_of(fo_ptr(cl0, v0, tau, eta))
    let v_ptr_meth = variance_of(pk.ptr(tau, eta))
    let v_ptr_peel = variance_of(exp((cl0 / v0) * tau))
    let v_dof_imp = variance_of(fo_dof(cl0, v0, tau, eta))
    let v_dof_meth = variance_of(pk.dof(tau, eta))
    let v_dof_peel = variance_of(exp((cl0 / v0) * tau) - 1.0)

    print("=== FO_PK_IMPORT_PTR science table ===\n")
    print("v_ptr_imp="); print_f64(v_ptr_imp); print("\n")
    print("v_ptr_meth="); print_f64(v_ptr_meth); print("\n")
    print("v_ptr_peel="); print_f64(v_ptr_peel); print("\n")
    print("v_dof_imp="); print_f64(v_dof_imp); print("\n")
    print("v_dof_meth="); print_f64(v_dof_meth); print("\n")
    print("v_dof_peel="); print_f64(v_dof_peel); print("\n")
    print("FO_PK_IMPORT_PTR_DRIVER_PASS\n")
}
