//@ run-pass
//@ expect-stdout: FO_PK_IMPORT_CMAX_DRIVER_PASS

// R7b — multi-mod fo_cmax / fo_cmin / fo_ptf freezes.
// ≤3 FO sites (4th silent-exits on Rac-class). E₂ from R7 method driver.
// Freezes: Cmax Var=2.050059; Cmin Var=0.306096; PTF=0.007488.
// Not clinical guidance.

use epistemic::fo::{fo_cmax, fo_cmin, fo_ptf}

fn main() with IO, Mut, Div, Epistemic {
    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let f = kF.value
    let dose = kDose.value
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let tau = 12.0

    print("=== FO_PK_IMPORT_CMAX science table ===\n")
    print("v_cmax_imp="); print_f64(variance_of(fo_cmax(f, dose, cl0, v0, tau, eta))); print("\n")
    print("v_cmin_imp="); print_f64(variance_of(fo_cmin(f, dose, cl0, v0, tau, eta))); print("\n")
    print("v_ptf_imp="); print_f64(variance_of(fo_ptf(cl0, v0, tau, eta))); print("\n")
    print("FO_PK_IMPORT_CMAX_DRIVER_PASS\n")
}
