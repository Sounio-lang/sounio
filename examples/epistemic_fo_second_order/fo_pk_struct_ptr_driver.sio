//@ run-pass
//@ expect-stdout: FO_PK_STRUCT_PTR_DRIVER_PASS

// R9 — Peak–trough ratio + degree of fluctuation FO.
//
//   PTR = Cmax/Cmin = exp(kel·τ) = 1/f_rem
//   DOF = (Cmax−Cmin)/Cmin = PTR − 1
//
// Freezes (CL0=5±0.3, V0=50±2, η=0±0.1, τ=12):
//   PTR = 3.320113, Var = 0.082541, E₂ = 3.338918
//   DOF = 2.320113, Var = 0.082541 (= PTR peel class)
//
// Shared η cancels. Not clinical guidance.

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn ptr(self: &Pk, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        exp(kel * tau)
    }
    fn dof(self: &Pk, tau: f64, eta: f64) -> f64 {
        exp(((self.cl0 * exp(eta)) / (self.v0 * exp(eta))) * tau) - 1.0
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let tau = 12.0
    let pk = Pk { cl0: cl0, v0: v0 }

    let ptr_pt = pk.ptr(tau, eta)
    let dof_pt = pk.dof(tau, eta)

    let v_ptr = variance_of(pk.ptr(tau, eta))
    let e2_ptr = second_order_mean(pk.ptr(tau, eta))
    let v_ptr_peel = variance_of(exp((cl0 / v0) * tau))
    let v_dof = variance_of(pk.dof(tau, eta))
    let v_dof_peel = variance_of(exp((cl0 / v0) * tau) - 1.0)

    print("=== FO_PK_STRUCT_PTR science table ===\n")
    print("ptr_point="); print_f64(ptr_pt); print("\n")
    print("v_ptr="); print_f64(v_ptr); print("\n")
    print("e2_ptr="); print_f64(e2_ptr); print("\n")
    print("v_ptr_peel="); print_f64(v_ptr_peel); print("\n")
    print("dof_point="); print_f64(dof_pt); print("\n")
    print("v_dof="); print_f64(v_dof); print("\n")
    print("v_dof_peel="); print_f64(v_dof_peel); print("\n")
    print("FO_PK_STRUCT_PTR_DRIVER_PASS\n")
}
