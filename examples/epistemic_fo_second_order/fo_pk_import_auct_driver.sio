//@ run-pass
//@ expect-stdout: FO_PK_IMPORT_AUCT_DRIVER_PASS

// R12b — multi-mod fo_auc_tau / fo_css_tau / fo_auc ↔ method.
// Freezes: Var(AUC_τ)=114.6 = Var(Css·τ); E₂=80.688. Not clinical guidance.

use epistemic::fo::{fo_auc_tau, fo_css_tau, fo_auc}

struct Pk {
    cl0: f64
}

impl Pk {
    fn auc_tau(self: &Pk, f: f64, dose: f64, eta: f64) -> f64 {
        (f * dose) / (self.cl0 * exp(eta))
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let f = kF.value
    let dose = kDose.value
    let cl0 = kCL0.value
    let eta = kEta.value
    let tau = 12.0
    let pk = Pk { cl0: cl0 }

    let v_auct_imp = variance_of(fo_auc_tau(f, dose, cl0, eta))
    let v_auct_meth = variance_of(pk.auc_tau(f, dose, eta))
    let v_css_tau = variance_of(fo_css_tau(f, dose, tau, cl0, eta))
    let v_auc_alias = variance_of(fo_auc(f, dose, cl0, eta))
    let e2_auct_imp = second_order_mean(fo_auc_tau(f, dose, cl0, eta))

    print("=== FO_PK_IMPORT_AUCT science table ===\n")
    print("v_auct_imp="); print_f64(v_auct_imp); print("\n")
    print("v_auct_meth="); print_f64(v_auct_meth); print("\n")
    print("v_css_tau="); print_f64(v_css_tau); print("\n")
    print("v_auc_alias="); print_f64(v_auc_alias); print("\n")
    print("e2_auct_imp="); print_f64(e2_auct_imp); print("\n")
    print("FO_PK_IMPORT_AUCT_DRIVER_PASS\n")
}
