//@ run-pass
//@ expect-stdout: FO_PK_STRUCT_AUC_THALF_DRIVER_PASS

// R5 — Oral AUC and elimination half-life FO (Pk methods + surfaces).
//
// Extends R1–R4 Css science to two further PK endpoints under the same seeds:
//   AUC = F·Dose / (CL0·e^η)                    (single-dose / total exposure)
//   kel = CL/V with shared η → η cancels
//   t½  = ln(2)/kel = ln(2)·V0/CL0             (FO from CL0, V0 only)
//
// Freezes (F=0.8±0.05, Dose=500±10, CL0=5±0.3, V0=50±2, η=0±0.1):
//   AUC point = 80,        Var(AUC) = 114.6,   E₂ = 80.688
//   kel point = 0.1,       Var(kel) = 5.2e-5
//   t½  point = 6.931471,  Var(t½)  = 0.249835  (= peel ln2·V0/CL0)
//
// Surfaces: struct-lit methods, make_pk call-result, free-fn / site peel.
// Not clinical guidance. Gate greps science-table numbers.

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn clearance(self: &Pk, eta: f64) -> f64 {
        self.cl0 * exp(eta)
    }
    fn volume(self: &Pk, eta: f64) -> f64 {
        self.v0 * exp(eta)
    }
    // Oral AUC = F·Dose/CL
    fn auc(self: &Pk, f: f64, dose: f64, eta: f64) -> f64 {
        (f * dose) / self.clearance(eta)
    }
    // Elimination rate CL/V (shared η cancels)
    fn kel(self: &Pk, eta: f64) -> f64 {
        self.clearance(eta) / self.volume(eta)
    }
    // Half-life t½ = ln(2)/kel
    fn thalf(self: &Pk, eta: f64) -> f64 {
        0.6931471805599453 / self.kel(eta)
    }
}

fn make_pk(cl0: f64, v0: f64) -> Pk {
    Pk { cl0: cl0, v0: v0 }
}

fn free_auc(f: f64, dose: f64, cl0: f64, eta: f64) -> f64 {
    (f * dose) / (cl0 * exp(eta))
}

fn free_thalf(cl0: f64, v0: f64, eta: f64) -> f64 {
    0.6931471805599453 / ((cl0 * exp(eta)) / (v0 * exp(eta)))
}

fn main() with IO, Mut, Div, Epistemic {
    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)

    let f = kF.value
    let dose = kDose.value
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value

    let pk = Pk { cl0: cl0, v0: v0 }

    // ── AUC ──
    let auc_pt = pk.auc(f, dose, eta)
    let v_auc = variance_of(pk.auc(f, dose, eta))
    let e2_auc = second_order_mean(pk.auc(f, dose, eta))
    let v_auc_call = variance_of(make_pk(cl0, v0).auc(f, dose, eta))
    let e2_auc_call = second_order_mean(make_pk(cl0, v0).auc(f, dose, eta))
    let v_auc_free = variance_of(free_auc(f, dose, cl0, eta))
    let v_auc_site = variance_of((f * dose) / (cl0 * exp(eta)))

    // ── kel + t½ (shared-η cancel) ──
    let kel_pt = pk.kel(eta)
    let v_kel = variance_of(pk.kel(eta))
    let thalf_pt = pk.thalf(eta)
    let v_thalf = variance_of(pk.thalf(eta))
    let v_thalf_call = variance_of(make_pk(cl0, v0).thalf(eta))
    let v_thalf_free = variance_of(free_thalf(cl0, v0, eta))
    let v_thalf_peel = variance_of(0.6931471805599453 * v0 / cl0)

    print("=== FO_PK_STRUCT_AUC_THALF science table ===\n")
    print("auc_point="); print_f64(auc_pt); print("\n")
    print("v_auc="); print_f64(v_auc); print("\n")
    print("e2_auc="); print_f64(e2_auc); print("\n")
    print("v_auc_call="); print_f64(v_auc_call); print("\n")
    print("e2_auc_call="); print_f64(e2_auc_call); print("\n")
    print("v_auc_free="); print_f64(v_auc_free); print("\n")
    print("v_auc_site="); print_f64(v_auc_site); print("\n")
    print("kel_point="); print_f64(kel_pt); print("\n")
    print("v_kel="); print_f64(v_kel); print("\n")
    print("thalf_point="); print_f64(thalf_pt); print("\n")
    print("v_thalf="); print_f64(v_thalf); print("\n")
    print("v_thalf_call="); print_f64(v_thalf_call); print("\n")
    print("v_thalf_free="); print_f64(v_thalf_free); print("\n")
    print("v_thalf_peel="); print_f64(v_thalf_peel); print("\n")
    print("FO_PK_STRUCT_AUC_THALF_DRIVER_PASS\n")
}
