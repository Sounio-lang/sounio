//@ run-pass
//@ expect-stdout: FO_PK_IMPORT_FSS_DRIVER_PASS

// R8b — multi-mod fo_fss / fo_n90 ↔ method / peel.
// Freezes match R8. Not clinical guidance.

use epistemic::fo::{fo_fss, fo_n90}

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn fss(self: &Pk, n: f64, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        1.0 - exp(0.0 - n * kel * tau)
    }
    fn n90(self: &Pk, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        2.302585092994046 / (kel * tau)
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let tau = 12.0
    let n3 = 3.0
    let pk = Pk { cl0: cl0, v0: v0 }

    let v_fss_imp = variance_of(fo_fss(cl0, v0, n3, tau, eta))
    let v_fss_meth = variance_of(pk.fss(n3, tau, eta))
    let v_fss_peel = variance_of(1.0 - exp(0.0 - n3 * (cl0 / v0) * tau))
    let v_n90_imp = variance_of(fo_n90(cl0, v0, tau, eta))
    let v_n90_meth = variance_of(pk.n90(tau, eta))
    let v_n90_peel = variance_of(2.302585092994046 * v0 / (cl0 * tau))

    print("=== FO_PK_IMPORT_FSS science table ===\n")
    print("v_fss3_imp="); print_f64(v_fss_imp); print("\n")
    print("v_fss3_meth="); print_f64(v_fss_meth); print("\n")
    print("v_fss3_peel="); print_f64(v_fss_peel); print("\n")
    print("v_n90_imp="); print_f64(v_n90_imp); print("\n")
    print("v_n90_meth="); print_f64(v_n90_meth); print("\n")
    print("v_n90_peel="); print_f64(v_n90_peel); print("\n")
    print("FO_PK_IMPORT_FSS_DRIVER_PASS\n")
}
