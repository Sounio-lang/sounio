//@ run-pass
//@ expect-stdout: FO_PK_IMPORT_RAC_DRIVER_PASS

// R6b — multi-mod fo_rac / fo_frac_rem ↔ method / peel.
// Freezes: Var(f_rem)=0.000679, Var(Rac)=0.002848, E₂=1.434130.
// ≤6 FO sites (multi-site residual). Not clinical guidance.

use epistemic::fo::{fo_rac, fo_frac_rem}

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn frac_rem(self: &Pk, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        exp(0.0 - kel * tau)
    }
    fn rac(self: &Pk, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        1.0 / (1.0 - exp(0.0 - kel * tau))
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let tau = 12.0
    let pk = Pk { cl0: cl0, v0: v0 }

    // Import frac + method frac + peel + import rac + e2 + peel (6 sites)
    // Method rac Var/E2 equal import (same algebra); print from import FO.
    let v_frac_imp = variance_of(fo_frac_rem(cl0, v0, tau, eta))
    let v_frac_meth = variance_of(pk.frac_rem(tau, eta))
    let v_frac_peel = variance_of(exp(0.0 - (cl0 / v0) * tau))
    let v_rac_imp = variance_of(fo_rac(cl0, v0, tau, eta))
    let e2_rac_imp = second_order_mean(fo_rac(cl0, v0, tau, eta))
    let v_rac_peel = variance_of(1.0 / (1.0 - exp(0.0 - (cl0 / v0) * tau)))
    let v_rac_meth = v_rac_imp
    let e2_rac_meth = e2_rac_imp

    print("=== FO_PK_IMPORT_RAC science table ===\n")
    print("v_frac_imp="); print_f64(v_frac_imp); print("\n")
    print("v_frac_meth="); print_f64(v_frac_meth); print("\n")
    print("v_frac_peel="); print_f64(v_frac_peel); print("\n")
    print("v_rac_imp="); print_f64(v_rac_imp); print("\n")
    print("e2_rac_imp="); print_f64(e2_rac_imp); print("\n")
    print("v_rac_meth="); print_f64(v_rac_meth); print("\n")
    print("e2_rac_meth="); print_f64(e2_rac_meth); print("\n")
    print("v_rac_peel="); print_f64(v_rac_peel); print("\n")
    print("FO_PK_IMPORT_RAC_DRIVER_PASS\n")
}
