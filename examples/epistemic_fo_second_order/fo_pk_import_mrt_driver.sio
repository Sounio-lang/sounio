//@ run-pass
//@ expect-stdout: FO_PK_IMPORT_MRT_DRIVER_PASS

// R10b — multi-mod fo_mrt / fo_t90 ↔ method / peel.
// Freezes match R10 (MRT Var method may print 0.519999 vs peel 0.520000).
// Not clinical guidance.

use epistemic::fo::{fo_mrt, fo_t90}

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn mrt(self: &Pk, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        1.0 / kel
    }
    fn t90(self: &Pk, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        2.302585092994046 / kel
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let pk = Pk { cl0: cl0, v0: v0 }

    let v_mrt_imp = variance_of(fo_mrt(cl0, v0, eta))
    let v_mrt_meth = variance_of(pk.mrt(eta))
    let v_mrt_peel = variance_of(v0 / cl0)
    let v_t90_imp = variance_of(fo_t90(cl0, v0, eta))
    let v_t90_meth = variance_of(pk.t90(eta))
    let v_t90_peel = variance_of(2.302585092994046 * v0 / cl0)

    print("=== FO_PK_IMPORT_MRT science table ===\n")
    print("v_mrt_imp="); print_f64(v_mrt_imp); print("\n")
    print("v_mrt_meth="); print_f64(v_mrt_meth); print("\n")
    print("v_mrt_peel="); print_f64(v_mrt_peel); print("\n")
    print("v_t90_imp="); print_f64(v_t90_imp); print("\n")
    print("v_t90_meth="); print_f64(v_t90_meth); print("\n")
    print("v_t90_peel="); print_f64(v_t90_peel); print("\n")
    print("FO_PK_IMPORT_MRT_DRIVER_PASS\n")
}
