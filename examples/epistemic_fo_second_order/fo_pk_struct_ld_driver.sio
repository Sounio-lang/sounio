//@ run-pass
//@ expect-stdout: FO_PK_STRUCT_LD_DRIVER_PASS

// R11 — Loading dose LD = Dose·Rac + fraction eliminated per interval.
//
// Freezes (Dose=500±10, CL0=5±0.3, V0=50±2, η=0±0.1, τ=12):
//   LD = 715.507200, Var = 916.939959, E₂ = 717.065032
//   fe = 0.698804,   Var = 0.000679 (= R6 f_rem Var)
//
// FO budget: LD is Rac-class heavy — ≤3 FO sites (interleave prints).
// Peel LD aliased from method FO; fe method + peel. Not clinical guidance.

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn ld(self: &Pk, dose: f64, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        let rac = 1.0 / (1.0 - exp(0.0 - kel * tau))
        dose * rac
    }
    fn fe(self: &Pk, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        1.0 - exp(0.0 - kel * tau)
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let dose = kDose.value
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let tau = 12.0
    let pk = Pk { cl0: cl0, v0: v0 }

    print("=== FO_PK_STRUCT_LD science table ===\n")
    print("ld_point="); print_f64(pk.ld(dose, tau, eta)); print("\n")
    let v_ld = variance_of(pk.ld(dose, tau, eta))
    print("v_ld="); print_f64(v_ld); print("\n")
    print("e2_ld="); print_f64(second_order_mean(pk.ld(dose, tau, eta))); print("\n")
    print("v_ld_peel="); print_f64(v_ld); print("\n")
    print("fe_point="); print_f64(pk.fe(tau, eta)); print("\n")
    print("v_fe="); print_f64(variance_of(pk.fe(tau, eta))); print("\n")
    print("v_fe_peel="); print_f64(variance_of(1.0 - exp(0.0 - (cl0 / v0) * tau))); print("\n")
    print("FO_PK_STRUCT_LD_DRIVER_PASS\n")
}
