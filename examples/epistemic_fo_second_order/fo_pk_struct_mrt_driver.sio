//@ run-pass
//@ expect-stdout: FO_PK_STRUCT_MRT_DRIVER_PASS

// R10 — Mean residence time + time to 90% steady state (hours).
//
//   MRT = 1/kel = V/CL          (shared η cancels)
//   t90 = ln(10)/kel = n90·τ    (hours to 90% of Css)
//
// Freezes (CL0=5±0.3, V0=50±2, η=0±0.1):
//   MRT = 10.000000, Var ≈ 0.520000 (method 0.519999 / peel 0.520000 ULP)
//   E₂[MRT] = 10.035999
//   t90 = 23.025850, Var = 2.756987, E₂ = 23.108743
//
// Links R5 t½ (= ln2·MRT) and R8 n90 (= t90/τ). Not clinical guidance.

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn mrt(self: &Pk, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        1.0 / kel
    }
    fn t90(self: &Pk, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        2.302585092994046 / kel
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let pk = Pk { cl0: cl0, v0: v0 }

    let mrt_pt = pk.mrt(eta)
    let t90_pt = pk.t90(eta)

    let v_mrt = variance_of(pk.mrt(eta))
    let e2_mrt = second_order_mean(pk.mrt(eta))
    let v_mrt_peel = variance_of(v0 / cl0)
    let v_t90 = variance_of(pk.t90(eta))
    let e2_t90 = second_order_mean(pk.t90(eta))
    let v_t90_peel = variance_of(2.302585092994046 * v0 / cl0)

    print("=== FO_PK_STRUCT_MRT science table ===\n")
    print("mrt_point="); print_f64(mrt_pt); print("\n")
    print("v_mrt="); print_f64(v_mrt); print("\n")
    print("e2_mrt="); print_f64(e2_mrt); print("\n")
    print("v_mrt_peel="); print_f64(v_mrt_peel); print("\n")
    print("t90_point="); print_f64(t90_pt); print("\n")
    print("v_t90="); print_f64(v_t90); print("\n")
    print("e2_t90="); print_f64(e2_t90); print("\n")
    print("v_t90_peel="); print_f64(v_t90_peel); print("\n")
    print("FO_PK_STRUCT_MRT_DRIVER_PASS\n")
}
