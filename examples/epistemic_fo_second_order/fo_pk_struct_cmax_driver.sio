//@ run-pass
//@ expect-stdout: FO_PK_STRUCT_CMAX_DRIVER_PASS

// R7 — Multi-dose peak / trough Css + peak–trough fluctuation FO.
//
// Freezes (F=0.8±0.05, Dose=500±10, CL0=5±0.3, V0=50±2, η=0±0.1, τ=12):
//   Cmax = 11.448115, Var = 2.050059, E₂ = 11.539124
//   Cmin = 3.448115   (point here; Var = 0.306096 on R7b import FO)
//   PTF  = 1.200000,  Var = 0.007488 (= peel CL0/V0·τ)
//
// FO budget: ≤3 sites when Cmax is Rac-class heavy (4th silent-exits).
// Sites: light PTF peel, Cmax var, Cmax E₂. Cmin Var live on import driver.
// Not clinical guidance.

struct Pk {
    cl0: f64
    v0: f64
}

impl Pk {
    fn cmax(self: &Pk, f: f64, dose: f64, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        let rac = 1.0 / (1.0 - exp(0.0 - kel * tau))
        (f * dose) / (self.v0 * exp(eta)) * rac
    }
    fn cmin(self: &Pk, f: f64, dose: f64, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        let frem = exp(0.0 - kel * tau)
        (f * dose) / (self.v0 * exp(eta)) * (frem / (1.0 - frem))
    }
    fn ptf(self: &Pk, tau: f64, eta: f64) -> f64 {
        let kel = (self.cl0 * exp(eta)) / (self.v0 * exp(eta))
        kel * tau
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let f = kF.value
    let dose = kDose.value
    let cl0 = kCL0.value
    let v0 = kV0.value
    let eta = kEta.value
    let tau = 12.0
    let pk = Pk { cl0: cl0, v0: v0 }

    // light FO first
    let v_ptf = variance_of((cl0 / v0) * tau)
    print("=== FO_PK_STRUCT_CMAX science table ===\n")
    print("ptf_point="); print_f64(pk.ptf(tau, eta)); print("\n")
    print("v_ptf="); print_f64(v_ptf); print("\n")
    print("v_ptf_peel="); print_f64(v_ptf); print("\n")
    print("cmax_point="); print_f64(pk.cmax(f, dose, tau, eta)); print("\n")
    let v_cmax = variance_of(pk.cmax(f, dose, tau, eta))
    print("v_cmax="); print_f64(v_cmax); print("\n")
    print("e2_cmax="); print_f64(second_order_mean(pk.cmax(f, dose, tau, eta))); print("\n")
    print("v_cmax_peel="); print_f64(v_cmax); print("\n")
    print("cmin_point="); print_f64(pk.cmin(f, dose, tau, eta)); print("\n")
    print("FO_PK_STRUCT_CMAX_DRIVER_PASS\n")
}
