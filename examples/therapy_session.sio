//! examples/therapy_session.sio
//!
//! Practitioner-facing worked example: A therapy session modeled as
//! Pask conversation with Bateson learning levels.
//!
//! Scenario: Therapist (T) believes the problem is value-70.
//!           Client (C) believes the problem is value-20.
//!           Through conversation they build shared understanding.
//!           When conversation stalls, the system detects it and
//!           prescribes learning level changes.

use cybernetic::conversation::{
    Conversation, conversation_new, set_models, converse, agreement,
    has_converged, shared_understanding, model_accuracy
}
use cybernetic::bateson::{
    LearningContext, LearningEvent, bateson_new, learn,
    level_one_update, level_two_switch, level_three_restructure
}
use cybernetic::second_order::{diagnose_conversation}

// ============================================================================
// Helpers
// ============================================================================

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn print_round_status(round: i64, agr: f64, shared: f64) with IO {
    print("  Round ")
    print_int(round)
    print(": agreement=")
    if agr > 0.9 {
        print("HIGH")
    } else if agr > 0.5 {
        print("MODERATE")
    } else {
        print("LOW")
    }
    print(" shared_understanding=")
    if shared > 60.0 {
        print("HIGH")
    } else if shared > 40.0 {
        print("MIDDLE")
    } else {
        print("LOW")
    }
    println("")
}

fn print_diagnosis(level: i64) with IO {
    print("  Diagnosis: ")
    if level == 0 {
        println("Conversation is FINE (no intervention needed)")
    } else if level == 1 {
        println("Needs L1 — parameter adjustment (fine-tuning understanding)")
    } else if level == 2 {
        println("Needs L2 — model switch (reframe the problem)")
    } else {
        println("Needs L3 — epistemological restructuring (fundamental shift)")
    }
}

// ============================================================================
// MAIN
// ============================================================================

fn main() with IO, Mut, Div, Panic {
    println("======================================================")
    println("  PRACTITIONER EXAMPLE: Therapy Session")
    println("  Pask conversation + Bateson learning levels")
    println("======================================================")
    println("")

    // ---- Phase 1: Initial conversation (T=70, C=20) ----
    println("Phase 1: Initial Conversation")
    println("  Therapist model: problem severity = 70")
    println("  Client model:    problem severity = 20")
    println("  (Large initial disagreement)")
    println("")

    var conv = conversation_new(1, 2, 100)
    conv = set_models(conv, 70.0, 2.0, 20.0, 2.0)

    var round: i64 = 0
    while round < 20 {
        conv = converse(conv)
        round = round + 1
        // Print every 5 rounds
        if round % 5 == 0 {
            let agr = agreement(conv)
            let shared = shared_understanding(conv)
            print_round_status(round, agr, shared)
        }
    }

    let agr1 = agreement(conv)
    let shared1 = shared_understanding(conv)
    println("")
    print("  Phase 1 result: agreement is ")
    if agr1 > 0.5 { println("building") } else { println("still low") }
    println("")

    // ---- Phase 2: Conversation stalls — diagnose and intervene ----
    println("Phase 2: Stall Detection and Learning Intervention")
    println("")

    // Run a few more rounds to see if we stall
    var stall_round: i64 = 0
    var prev_agr = agreement(conv)
    var stalled = false
    while stall_round < 10 {
        conv = converse(conv)
        stall_round = stall_round + 1
        let cur_agr = agreement(conv)
        let improvement = abs_f(cur_agr - prev_agr)
        if improvement < 0.001 {
            print("  Stall detected at round ")
            print_int(round + stall_round)
            println(": improvement < 0.001")
            stalled = true
            break
        }
        prev_agr = cur_agr
    }

    // Diagnose the conversation
    let diagnosis = diagnose_conversation(conv)
    print_diagnosis(diagnosis)
    println("")

    // Apply learning based on diagnosis
    var ctx = bateson_new()
    if diagnosis >= 1 {
        println("  Applying Bateson learning to the stalled participant...")

        // Simulate learning events based on diagnosis level
        var learn_round: i64 = 0
        while learn_round < 5 {
            let stimulus = learn_round % 8
            let outcome = if diagnosis == 1 { 0.8 } else { 0.3 }
            let evt = learn(ctx, stimulus, outcome)
            ctx = evt.context
            learn_round = learn_round + 1
        }

        print("  Learning level engaged: L")
        print_int(diagnosis)
        println("")

        // If L2 was needed, attempt model switch
        if diagnosis >= 2 {
            let switch_evt = level_two_switch(ctx, 0.01)
            ctx = switch_evt.context
            if switch_evt.model_switched {
                println("  L2: Model switched successfully (new frame of reference)")
            } else {
                println("  L2: Staying with current model (no better model available)")
            }
        }
    }
    println("")

    // ---- Phase 3: Resume conversation with updated model ----
    println("Phase 3: Resume Conversation After Intervention")
    println("")

    // After learning, the therapist adjusts approach (simulate by
    // nudging the therapist's belief slightly toward the client's)
    let current_shared = shared_understanding(conv)
    // Re-set with slightly modified positions to simulate learning effect
    var p_new = 70.0
    var q_new = 20.0
    // If L2 was triggered, therapist makes a bigger adjustment
    if diagnosis >= 2 {
        p_new = current_shared + 5.0
        q_new = current_shared - 5.0
    } else if diagnosis >= 1 {
        p_new = current_shared + 10.0
        q_new = current_shared - 10.0
    }

    var conv2 = conversation_new(1, 2, 100)
    conv2 = set_models(conv2, p_new, 1.0, q_new, 1.0)

    var r2: i64 = 0
    while r2 < 30 {
        conv2 = converse(conv2)
        r2 = r2 + 1
        if r2 % 10 == 0 {
            let agr = agreement(conv2)
            let shared = shared_understanding(conv2)
            print_round_status(r2, agr, shared)
        }
    }

    let final_agr = agreement(conv2)
    let final_shared = shared_understanding(conv2)
    let final_accuracy = model_accuracy(conv2)
    println("")

    // ---- Phase 4: Clinical summary ----
    println("======================================================")
    println("  CLINICAL SUMMARY")
    println("======================================================")
    println("")

    let total_rounds = round + stall_round + r2
    print("  Total conversation rounds: ")
    print_int(total_rounds)
    println("")

    print("  Final agreement: ")
    if final_agr > 0.9 {
        println("EXCELLENT (>0.9)")
    } else if final_agr > 0.7 {
        println("GOOD (>0.7)")
    } else if final_agr > 0.5 {
        println("MODERATE (>0.5)")
    } else {
        println("POOR (<0.5)")
    }

    print("  Shared understanding: ")
    if final_shared > 55.0 {
        println("converged toward therapist view")
    } else if final_shared > 35.0 {
        println("converged to middle ground")
    } else {
        println("converged toward client view")
    }

    print("  Model accuracy: ")
    if final_accuracy < 1.0 {
        println("EXCELLENT — participants understand each other well")
    } else if final_accuracy < 5.0 {
        println("GOOD — reasonable mutual understanding")
    } else {
        println("NEEDS WORK — models of each other are still imprecise")
    }

    print("  Intervention needed: L")
    print_int(diagnosis)
    if diagnosis == 0 {
        println(" (none)")
    } else if diagnosis == 1 {
        println(" (fine-tuning)")
    } else if diagnosis == 2 {
        println(" (reframe)")
    } else {
        println(" (restructure)")
    }

    println("")

    // Verify key properties
    assert(final_agr > 0.5)
    assert(final_shared > 10.0)
    assert(final_shared < 90.0)
    assert(total_rounds > 30)

    println("  All clinical assertions PASSED")
    println("")
    println("======================================================")
    println("  Session complete.")
    println("======================================================")
}
