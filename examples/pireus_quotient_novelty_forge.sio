//@ run-pass
//!
//! Frozen Sounio authority executable for Quotient Novelty Forge v5.

use hardware::pireus::quotient_novelty_forge::{
    PireusQuotientDigest,
    PIREUS_QUOTIENT_OK,
    PIREUS_QUOTIENT_PROFILE_COUNT,
    PIREUS_QUOTIENT_CHILD_COUNT,
    pireus_quotient_novelty_request,
    pireus_quotient_novelty_evaluate,
    pireus_quotient_novelty_frozen_mismatch_code,
}

fn bit(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(digest: &PireusQuotientDigest) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(digest.words[word])
        word = word + 1
    }
}

fn print_hash(words: &[i64; 8]) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(words[word])
        word = word + 1
    }
}

fn print_class_digest(words: &[i64; 1152], slot: i64)
with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(words[slot * 8 + word])
        word = word + 1
    }
}

fn print_profile_digest(words: &[i64; 24], profile: i64)
with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(words[profile * 8 + word])
        word = word + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_quotient_novelty_request()
    let result = pireus_quotient_novelty_evaluate(&request)

    print("SOUNIO_AUTHORITY schema=pireus-quotient-novelty-forge.v5")
    print(" role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE\n")

    print("PIREUS_QUOTIENT_LINEAGE parent_live_match=")
    print_int(bit(result.lineage.parent_live_match))
    print(" parent_digest_match=")
    print_int(bit(result.lineage.parent_digest_match))
    print(" parent_scope_match=")
    print_int(bit(result.lineage.parent_scope_match))
    print(" complete="); print_int(bit(result.lineage.complete)); print("\n")
    print("PIREUS_QUOTIENT_PARENT field=source value=")
    print_hash(&result.lineage.parent_source_sha256)
    print("\nPIREUS_QUOTIENT_PARENT field=semantics value=")
    print_hash(&result.lineage.parent_semantics_sha256)
    print("\nPIREUS_QUOTIENT_PARENT field=freeze value=")
    print_hash(&result.lineage.parent_freeze_sha256)
    print("\nPIREUS_QUOTIENT_PARENT field=transcript value=")
    print_hash(&result.lineage.parent_transcript_sha256)
    print("\nPIREUS_QUOTIENT_PARENT field=parity_open value=")
    print_hash(&result.lineage.parent_parity_receipt_sha256)
    print("\n")

    print("PIREUS_QUOTIENT_PARENT_RECOVERY checks=")
    print_int(result.parent.reconstruction_checks)
    print(" failures=")
    print_int(result.parent.reconstruction_failures)
    print(" sign_checks="); print_int(result.parent.sign_range_checks)
    print(" sign_failures="); print_int(result.parent.sign_range_failures)
    print(" complete="); print_int(bit(result.parent.complete)); print("\n")

    print("PIREUS_QUOTIENT_NORMALIZER gauge_bits=")
    print_int(result.normalizer.gauge_bits)
    print(" canonical_words=")
    print_int(result.normalizer.canonical_words)
    print(" pivot_checks="); print_int(result.normalizer.pivot_checks)
    print(" pivot_failures="); print_int(result.normalizer.pivot_failures)
    print(" roundtrip_words="); print_int(result.normalizer.roundtrip_words)
    print(" roundtrip_cells=")
    print_int(result.normalizer.roundtrip_cell_checks)
    print(" roundtrip_failures=")
    print_int(result.normalizer.roundtrip_failures)
    print(" unique_failures=")
    print_int(result.normalizer.unique_failures)
    print(" complete="); print_int(bit(result.normalizer.complete)); print("\n")

    print("PIREUS_QUOTIENT_ACTIONS matrix_encodings=")
    print_int(result.actions.matrix_encodings_scanned)
    print(" invertible="); print_int(result.actions.invertible_matrices)
    print(" considered="); print_int(result.actions.actions_considered)
    print(" admitted="); print_int(result.actions.admitted_actions)
    print(" admitted_no_swap=")
    print_int(result.actions.admitted_no_swap)
    print(" admitted_swap="); print_int(result.actions.admitted_swap)
    print(" rejected="); print_int(result.actions.rejected_actions)
    print(" identity="); print_int(bit(result.actions.identity_present))
    print(" identity_vector_checks=")
    print_int(result.actions.identity_vector_checks)
    print(" identity_vector_failures=")
    print_int(result.actions.identity_vector_failures)
    print(" action_code_checks="); print_int(result.actions.action_code_checks)
    print(" action_code_failures=")
    print_int(result.actions.action_code_failures)
    print(" parent_cells="); print_int(result.actions.parent_cell_checks)
    print(" parent_failures=")
    print_int(result.actions.parent_replay_failures)
    print(" inverse_checks="); print_int(result.actions.inverse_checks)
    print(" inverse_failures="); print_int(result.actions.inverse_failures)
    print(" closure_checks="); print_int(result.actions.closure_checks)
    print(" closure_failures="); print_int(result.actions.closure_failures)
    print(" composition_vector_checks=")
    print_int(result.actions.composition_vector_checks)
    print(" composition_vector_failures=")
    print_int(result.actions.composition_vector_failures)
    print(" gauge_equivariance_checks=")
    print_int(result.actions.gauge_equivariance_checks)
    print(" gauge_equivariance_failures=")
    print_int(result.actions.gauge_equivariance_failures)
    print(" complete="); print_int(bit(result.actions.complete)); print("\n")

    print("PIREUS_QUOTIENT_RELATIONS q0_pairs=")
    print_int(result.atlas.q0_pair_checks)
    print(" q1_pairs="); print_int(result.atlas.q1_pair_checks)
    print(" q2_action_children=")
    print_int(result.atlas.q2_action_child_checks)
    print(" q2_targets="); print_int(result.atlas.q2_target_checks)
    print(" reflexive_checks="); print_int(result.atlas.reflexive_checks)
    print(" reflexive_failures=")
    print_int(result.atlas.reflexive_failures)
    print(" symmetric_checks="); print_int(result.atlas.symmetric_checks)
    print(" symmetric_failures=")
    print_int(result.atlas.symmetric_failures)
    print(" transitive_checks="); print_int(result.atlas.transitive_checks)
    print(" transitive_failures=")
    print_int(result.atlas.transitive_failures)
    print(" refinement_checks=")
    print_int(result.atlas.refinement_checks)
    print(" refinement_failures=")
    print_int(result.atlas.refinement_failures)
    print(" partition_checks=")
    print_int(result.atlas.partition_checks)
    print(" partition_failures=")
    print_int(result.atlas.partition_failures)
    print(" witness_cells="); print_int(result.atlas.witness_cell_checks)
    print(" witness_failures="); print_int(result.atlas.witness_failures)
    print(" separation_checks=")
    print_int(result.atlas.separation_checks)
    print(" separation_failures=")
    print_int(result.atlas.separation_failures)
    print(" complete="); print_int(bit(result.atlas.complete)); print("\n")

    var profile: i64 = 0
    while profile < PIREUS_QUOTIENT_PROFILE_COUNT {
        print("PIREUS_QUOTIENT_PROFILE id="); print_int(profile)
        print(" classes="); print_int(result.atlas.class_counts[profile])
        print(" min_size=")
        print_int(result.atlas.minimum_class_sizes[profile])
        print(" max_size=")
        print_int(result.atlas.maximum_class_sizes[profile])
        print(" size_sum="); print_int(result.atlas.class_size_sums[profile])
        print(" digest=")
        print_profile_digest(&result.atlas.profile_digest_words, profile)
        print("\n")
        var class_id: i64 = 0
        while class_id < result.atlas.class_counts[profile] {
            let slot = profile * PIREUS_QUOTIENT_CHILD_COUNT + class_id
            print("PIREUS_QUOTIENT_CLASS profile="); print_int(profile)
            print(" id="); print_int(class_id)
            print(" representative=")
            print_int(result.atlas.class_representatives[slot])
            print(" member_mask=")
            print_int(result.atlas.class_member_masks[slot])
            print(" members=")
            print_int(result.atlas.class_member_counts[slot])
            print(" digest=")
            print_class_digest(&result.atlas.class_digest_words, slot)
            print("\n")
            class_id = class_id + 1
        }
        var child: i64 = 0
        while child < PIREUS_QUOTIENT_CHILD_COUNT {
            let slot = profile * PIREUS_QUOTIENT_CHILD_COUNT + child
            print("PIREUS_QUOTIENT_WITNESS profile="); print_int(profile)
            print(" child="); print_int(child)
            print(" class="); print_int(result.atlas.child_class_ids[slot])
            print(" representative=")
            print_int(result.atlas.child_representatives[slot])
            print(" matrix="); print_int(result.atlas.witness_matrices[slot])
            print(" swap="); print_int(result.atlas.witness_swaps[slot])
            print(" gauge="); print_int(result.atlas.witness_gauges[slot])
            print("\n")
            child = child + 1
        }
        profile = profile + 1
    }

    print("PIREUS_QUOTIENT_RECEIPT action_universe=")
    print_int(bit(result.receipt.declared_action_universe_complete))
    print(" gauge_normalizer=")
    print_int(bit(result.receipt.gauge_normalizer_exact))
    print(" parent_stabilizer=")
    print_int(bit(result.receipt.parent_gauge_stabilizer_complete))
    print(" q0="); print_int(bit(result.receipt.extensional_quotient_exact))
    print(" q1=")
    print_int(bit(result.receipt.basis_sign_gauge_quotient_exact))
    print(" q2=")
    print_int(bit(result.receipt.parent_linear_swap_gauge_quotient_exact))
    print(" atlas=")
    print_int(bit(result.receipt.canonical_novelty_atlas_complete))
    print(" typed_novelty=")
    print_int(bit(result.receipt.parent_relative_operator_novelty_typed))
    print(" no_selection=")
    print_int(bit(result.receipt.no_child_selected))
    print(" target_unresolved=")
    print_int(bit(result.receipt.target_envelopes_unresolved))
    print(" semantics_frozen=")
    print_int(bit(result.receipt.semantics_frozen))
    print(" parity_open=")
    print_int(bit(result.receipt.material_parity_open))
    print(" claim_ready="); print_int(bit(result.receipt.claim_ready))
    print("\n")

    print("PIREUS_QUOTIENT_MATERIAL observations=0 discharges=0")
    print(" receipts=0 lowerings=0 costs=0 performance=0 unresolved=1920\n")
    print("PIREUS_QUOTIENT_NEGATIVES passed=")
    print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")

    print("PIREUS_QUOTIENT_DIGEST lineage=")
    print_digest(&result.lineage_digest)
    print(" normalizer="); print_digest(&result.normalizer_digest)
    print(" actions="); print_digest(&result.action_digest)
    print(" atlas="); print_digest(&result.atlas_digest)
    print(" receipt="); print_digest(&result.receipt_digest)
    print(" forge="); print_digest(&result.forge_digest)
    print("\n")

    print("PIREUS_QUOTIENT_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(result.failures)
    print(" valid="); print_int(bit(result.valid)); print("\n")

    let frozen_mismatch_code =
        pireus_quotient_novelty_frozen_mismatch_code(&result)
    let frozen_match = frozen_mismatch_code == 0
    print(" frozen_match="); print_int(bit(frozen_match)); print("\n")
    print(" frozen_mismatch_code=")
    print_int(frozen_mismatch_code)
    print("\n")

    if result.valid && result.error == PIREUS_QUOTIENT_OK &&
        result.failures == 0 && frozen_match { 0 } else { 1 }
}
