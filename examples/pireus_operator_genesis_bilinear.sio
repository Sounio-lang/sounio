//@ run-pass
//!
//! First Sounio-produced transcript for the full bilinear Operator Genesis
//! grammar. This executable intentionally has no frozen expected result.

use hardware::pireus::operator_genesis_bilinear::{
    BilinearGenesisDigest,
    PIREUS_BILINEAR_OK,
    pireus_operator_genesis_bilinear_request,
    pireus_operator_genesis_bilinear_evaluate,
    pireus_operator_genesis_bilinear_matches_frozen_semantics,
    pireus_operator_genesis_bilinear_frozen_mismatch_code,
}

fn bit(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(digest: &BilinearGenesisDigest) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(digest.words[word])
        word = word + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_operator_genesis_bilinear_request()
    let result = pireus_operator_genesis_bilinear_evaluate(&request)

    print("SOUNIO_AUTHORITY schema=pireus-operator-genesis-bilinear.v2 role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE\n")
    print("PIREUS_BILINEAR_GRAMMAR matrices=")
    print_int(result.grammar.matrices_scanned)
    print(" quadratic_codes="); print_int(result.grammar.quadratic_codes)
    print(" bucket_min="); print_int(result.grammar.minimum_bucket_size)
    print(" bucket_max="); print_int(result.grammar.maximum_bucket_size)
    print(" bucket_failures="); print_int(result.grammar.bucket_failures)
    print(" reconstruction_failures=")
    print_int(result.grammar.reconstruction_failures)
    print(" gauge_fiber_checks=")
    print_int(result.grammar.gauge_fiber_checks)
    print(" gauge_fiber_failures=")
    print_int(result.grammar.gauge_fiber_failures)
    print(" cocycle_failures="); print_int(result.grammar.cocycle_failures)
    print(" complete="); print_int(bit(result.grammar.complete)); print("\n")

    print("PIREUS_BILINEAR_GROUP matrices="); print_int(result.group.matrix_count)
    print(" bfs="); print_int(result.group.bfs_count)
    print(" set_mismatches="); print_int(result.group.set_mismatches)
    print(" actions="); print_int(result.group.actions_considered)
    print(" complete="); print_int(bit(result.group.complete)); print("\n")

    print("PIREUS_BILINEAR_STABILIZER admitted=")
    print_int(result.stabilizer.admitted_actions)
    print(" no_swap="); print_int(result.stabilizer.admitted_no_swap)
    print(" swap="); print_int(result.stabilizer.admitted_swap)
    print(" rejected="); print_int(result.stabilizer.rejected_actions)
    print(" affine_checks="); print_int(result.stabilizer.affine_inverse_checks)
    print(" affine_failures=")
    print_int(result.stabilizer.affine_inverse_failures)
    print(" complete="); print_int(bit(result.stabilizer.complete)); print("\n")

    print("PIREUS_BILINEAR_PARTITION classes=")
    print_int(result.classes.class_count)
    print(" quadratic_total="); print_int(result.classes.quadratic_total)
    print(" raw_total="); print_int(result.classes.raw_total)
    print(" edges="); print_int(result.classes.equivalence_edges)
    print(" v1_classes="); print_int(result.classes.v1_classes)
    print(" signature_failures=")
    print_int(result.classes.signature_consistency_failures)
    print(" associator_failures=")
    print_int(result.classes.associator_base_failures)
    print(" incidence_failures=")
    print_int(result.classes.corpus_incidence_failures)
    print(" complete="); print_int(bit(result.classes.complete)); print("\n")

    var class_id: i64 = 0
    while class_id < result.classes.class_count {
        print("PIREUS_BILINEAR_CLASS id="); print_int(class_id)
        print(" representative_q=")
        print_int(result.classes.class_representative_q[class_id])
        print(" minimum_matrix=")
        print_int(result.classes.class_minimum_matrix[class_id])
        print(" q_size=")
        print_int(result.classes.class_quadratic_sizes[class_id])
        print(" raw_size="); print_int(result.classes.class_raw_sizes[class_id])
        print(" squares=")
        print_int(result.classes.class_square_negatives[class_id])
        print(" commutator=")
        print_int(result.classes.class_commutator_defects[class_id])
        print(" associator=")
        print_int(result.classes.class_associator_defects[class_id])
        print(" v1="); print_int(bit(result.classes.class_v1_represented[class_id]))
        print(" corpus_mask=")
        print_int(result.classes.class_corpus_masks[class_id])
        print("\n")
        class_id = class_id + 1
    }

    var corpus: i64 = 0
    while corpus < 3 {
        print("PIREUS_BILINEAR_CORPUS id="); print_int(corpus + 1)
        print(" membership_hits=")
        print_int(result.corpus.membership_hits[corpus])
        print(" q_codes=")
        print_int(result.corpus.incident_quadratic_codes[corpus])
        print(" classes="); print_int(result.corpus.incident_classes[corpus])
        print(" squares="); print_int(result.corpus.square_negatives[corpus])
        print(" commutator=")
        print_int(result.corpus.commutator_defects[corpus])
        print(" associator=")
        print_int(result.corpus.associator_defects[corpus]); print("\n")
        corpus = corpus + 1
    }

    print("PIREUS_BILINEAR_SELECTED present=")
    print_int(bit(result.selected.present))
    print(" class="); print_int(result.selected.class_id)
    print(" q="); print_int(result.selected.quadratic_code)
    print(" matrix="); print_int(result.selected.bilinear_matrix)
    print(" q_size="); print_int(result.selected.class_quadratic_size)
    print(" raw_size="); print_int(result.selected.class_raw_size)
    print(" squares="); print_int(result.selected.square_negatives)
    print(" commutator="); print_int(result.selected.commutator_defects)
    print(" associator="); print_int(result.selected.associator_defects)
    print(" nearest_corpus="); print_int(result.selected.nearest_corpus_id)
    print(" delta_assoc="); print_int(result.selected.associator_delta)
    print(" delta_comm="); print_int(result.selected.commutator_delta)
    print(" delta_square="); print_int(result.selected.square_delta)
    print(" v1="); print_int(bit(result.selected.represented_in_v1))
    print(" corpus_equivalent=")
    print_int(bit(result.selected.equivalent_to_corpus)); print("\n")

    print("PIREUS_BILINEAR_WITNESS present=")
    print_int(bit(result.witness.present))
    print(" corpus="); print_int(result.witness.corpus_id)
    print(" component="); print_int(result.witness.component)
    print(" candidate="); print_int(result.witness.candidate_value)
    print(" corpus_value="); print_int(result.witness.corpus_value); print("\n")

    print("PIREUS_BILINEAR_RECEIPT grammar_exhausted=")
    print_int(bit(result.receipt.expanded_bilinear_grammar_exhausted))
    print(" quotient_exact=")
    print_int(bit(result.receipt.bilinear_gauge_quotient_exact))
    print(" equivalence_exact=")
    print_int(bit(result.receipt.declared_family_equivalence_exact))
    print(" corpus_exact="); print_int(bit(result.receipt.corpus_incidence_exact))
    print(" relative_semantic_novelty=")
    print_int(bit(result.receipt.relative_semantic_novelty))
    print(" grammar_extension_novelty=")
    print_int(bit(result.receipt.relative_grammar_extension_novelty))
    print(" algebraic_novelty=")
    print_int(bit(result.receipt.relative_algebraic_novelty))
    print(" global_novelty="); print_int(bit(result.receipt.global_novelty))
    print(" frozen="); print_int(bit(result.receipt.receipt_frozen))
    print(" claim_ready="); print_int(bit(result.receipt.claim_ready)); print("\n")

    print("PIREUS_BILINEAR_DIGEST grammar=")
    print_digest(&result.grammar_digest)
    print(" quotient="); print_digest(&result.quotient_digest)
    print(" matrix="); print_digest(&result.matrix_digest)
    print(" stabilizer="); print_digest(&result.stabilizer_digest)
    print(" partition="); print_digest(&result.partition_digest)
    print(" corpus="); print_digest(&result.corpus_digest)
    print(" search="); print_digest(&result.search_digest)
    print(" selected="); print_digest(&result.selected_digest)
    print(" receipt="); print_digest(&result.receipt_digest); print("\n")

    print("PIREUS_BILINEAR_NEGATIVES passed=")
    print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")
    print("PIREUS_BILINEAR_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(result.failures)
    print(" frozen_match=")
    print_int(bit(
        pireus_operator_genesis_bilinear_matches_frozen_semantics(&result)))
    print(" frozen_mismatch_code=")
    print_int(pireus_operator_genesis_bilinear_frozen_mismatch_code(&result))
    print(" valid="); print_int(bit(result.valid)); print("\n")

    if result.valid && result.error == PIREUS_BILINEAR_OK &&
        result.failures == 0 &&
        pireus_operator_genesis_bilinear_matches_frozen_semantics(&result) {
        0
    } else { 1 }
}
