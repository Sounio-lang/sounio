//@ run-pass
//!
//! First Sounio-produced TwistedXor16 operator-genesis search transcript.

use hardware::pireus::operator_genesis::{
    PireusGenesisDigest,
    PIREUS_GENESIS_OK,
    pireus_operator_genesis_request,
    pireus_operator_genesis_evaluate,
    pireus_operator_genesis_matches_frozen_semantics,
    pireus_operator_genesis_frozen_mismatch_code,
}

fn bool_as_i64(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(digest: &PireusGenesisDigest) with IO, Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if i > 0 { print(":") }
        print_int(digest.words[i])
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_operator_genesis_request()
    let result = pireus_operator_genesis_evaluate(&request)

    print("SOUNIO_AUTHORITY schema=pireus-operator-genesis.v0 role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE\n")
    print("PIREUS_GENESIS_SPACE bits="); print_int(result.space.bits)
    print(" dimension="); print_int(result.space.dimension)
    print(" coefficient_values="); print_int(result.space.coefficient_values)
    print(" destination_xor=")
    print_int(bool_as_i64(result.space.destination_is_xor))
    print(" ascending_i=")
    print_int(bool_as_i64(result.space.accumulation_is_ascending_i))
    print(" valid="); print_int(bool_as_i64(result.space.valid)); print("\n")

    print("PIREUS_GENESIS_GRAMMAR seed="); print_int(result.grammar.seed)
    print(" candidates="); print_int(result.grammar.candidate_count)
    print(" exhaustive="); print_int(bool_as_i64(result.grammar.exhaustive))
    print(" stochastic="); print_int(bool_as_i64(result.grammar.stochastic))
    print(" base_twist_table_bound=")
    print_int(bool_as_i64(result.grammar.base_twist_table_bound))
    print("\n")

    print("PIREUS_GENESIS_GROUP coordinate_permutations=")
    print_int(result.group.coordinate_permutations)
    print(" operand_exchange_actions=")
    print_int(result.group.operand_exchange_actions)
    print(" actions="); print_int(result.group.action_count)
    print(" unique_actions="); print_int(result.group.unique_action_count)
    print(" closure_failures="); print_int(result.group.closure_failures)
    print(" inverse_failures="); print_int(result.group.inverse_failures)
    print(" verified_group=")
    print_int(bool_as_i64(result.group.verified_group))
    print(" gl4_complete="); print_int(bool_as_i64(result.group.gl4_complete))
    print(" sign_gauge_complete=")
    print_int(bool_as_i64(result.group.sign_gauge_complete))
    print(" isotopy_complete=")
    print_int(bool_as_i64(result.group.isotopy_complete)); print("\n")

    var ordinal: i64 = 0
    while ordinal < result.search.candidates_evaluated {
        print("PIREUS_GENESIS_CANDIDATE ordinal="); print_int(ordinal)
        print(" mask="); print_int(result.search.candidate_masks[ordinal])
        print(" score="); print_int(result.search.candidate_scores[ordinal])
        print(" canonical_action=")
        print_int(result.search.candidate_canonical_actions[ordinal])
        print(" nearest_corpus=")
        print_int(result.search.candidate_nearest_corpus[ordinal])
        print(" nearest_action=")
        print_int(result.search.candidate_nearest_actions[ordinal])
        print(" equivalent=")
        print_int(bool_as_i64(result.search.candidate_equivalent[ordinal]))
        print("\n")
        ordinal = ordinal + 1
    }

    let selected = &result.search.selected
    print("PIREUS_GENESIS_SELECTED ordinal=")
    print_int(selected.generation_ordinal)
    print(" mask="); print_int(selected.phase_mask)
    print(" score="); print_int(selected.score)
    print(" canonical_action="); print_int(selected.canonical_action)
    print(" nearest_corpus="); print_int(selected.nearest_corpus_id)
    print(" nearest_action="); print_int(selected.nearest_corpus_action)
    print(" comparisons="); print_int(selected.comparisons_completed)
    print(" relative_novelty=")
    print_int(bool_as_i64(selected.relative_novelty_witnessed)); print("\n")

    print("PIREUS_GENESIS_WITNESS present=")
    print_int(bool_as_i64(result.witness.present))
    print(" corpus="); print_int(result.witness.corpus_id)
    print(" action="); print_int(result.witness.corpus_action)
    print(" i="); print_int(result.witness.i)
    print(" j="); print_int(result.witness.j)
    print(" candidate="); print_int(result.witness.candidate_value)
    print(" corpus_value="); print_int(result.witness.corpus_value)
    print(" hamming_distance="); print_int(result.witness.hamming_distance)
    print(" comparisons="); print_int(result.witness.comparisons_completed)
    print(" expected="); print_int(result.witness.comparisons_expected)
    print("\n")

    print("PIREUS_GENESIS_FINGERPRINT positive=")
    print_int(result.fingerprint.positive_count)
    print(" negative="); print_int(result.fingerprint.negative_count)
    print(" other="); print_int(result.fingerprint.other_count)
    print(" commutator_defects=")
    print_int(result.fingerprint.commutator_defect_count)
    print(" associator_defects=")
    print_int(result.fingerprint.associator_defect_count); print("\n")
    var displacement: i64 = 0
    while displacement < 16 {
        print("PIREUS_GENESIS_DISPLACEMENT d="); print_int(displacement)
        print(" negatives=")
        print_int(result.fingerprint.displacement_negative_counts[displacement])
        print("\n")
        displacement = displacement + 1
    }

    print("PIREUS_GENESIS_RECEIPT grammar_hash_bound=")
    print_int(bool_as_i64(result.receipt.grammar_hash_bound))
    print(" corpus_hash_bound=")
    print_int(bool_as_i64(result.receipt.corpus_hash_bound))
    print(" group_hash_bound=")
    print_int(bool_as_i64(result.receipt.group_hash_bound))
    print(" relative_semantic_novelty=")
    print_int(bool_as_i64(result.receipt.relative_semantic_novelty))
    print(" relative_algebraic_novelty=")
    print_int(bool_as_i64(result.receipt.relative_algebraic_novelty))
    print(" declared_action_inequivalence=")
    print_int(bool_as_i64(result.receipt.declared_action_inequivalence))
    print(" algebra_isomorphism_complete=")
    print_int(bool_as_i64(result.receipt.algebra_isomorphism_complete))
    print(" source_hash_bound=")
    print_int(bool_as_i64(result.receipt.source_hash_bound))
    print(" semantics_hash_bound=")
    print_int(bool_as_i64(result.receipt.semantics_hash_bound))
    print(" frozen="); print_int(bool_as_i64(result.receipt.receipt_frozen))
    print(" admitted=")
    print_int(bool_as_i64(result.receipt.receipt_admitted))
    print(" parity_open="); print_int(bool_as_i64(result.receipt.parity_open))
    print(" claim_ready="); print_int(bool_as_i64(result.receipt.claim_ready))
    print(" global_novelty=")
    print_int(bool_as_i64(result.receipt.global_novelty))
    print(" scientific_novelty=")
    print_int(bool_as_i64(result.receipt.scientific_novelty)); print("\n")

    print("PIREUS_GENESIS_DIGEST space="); print_digest(&result.space_digest)
    print(" grammar="); print_digest(&result.grammar_digest)
    print(" group="); print_digest(&result.group_digest)
    print(" corpus="); print_digest(&result.corpus_digest)
    print(" search="); print_digest(&result.search_digest)
    print(" candidate="); print_digest(&result.candidate_digest)
    print(" canonical="); print_digest(&result.canonical_digest)
    print(" fingerprint="); print_digest(&result.fingerprint_digest)
    print(" witness="); print_digest(&result.witness_digest)
    print(" receipt="); print_digest(&result.receipt_digest); print("\n")

    print("PIREUS_GENESIS_NEGATIVES passed=")
    print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")
    print("PIREUS_GENESIS_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(result.failures)
    print(" frozen_match=")
    print_int(bool_as_i64(
        pireus_operator_genesis_matches_frozen_semantics(&result)))
    print(" frozen_mismatch_code=")
    print_int(pireus_operator_genesis_frozen_mismatch_code(&result))
    print(" valid="); print_int(bool_as_i64(result.valid)); print("\n")

    if result.valid && result.error == PIREUS_GENESIS_OK &&
        result.failures == 0 { 0 } else { 1 }
}
