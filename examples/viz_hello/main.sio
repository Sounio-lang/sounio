// examples/viz_hello/main.sio — smallest Visual IR Canvas example

use display::canvas::{Canvas, canvas_clear}
use viz::ir::{viz_scene_new, viz_layout_rect, viz_style_rgb, viz_add_line_chart}
use viz::viz_canvas::{viz_canvas_render_scene}

fn hello_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pix = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pix, width: w, height: h }
}

fn hello_read(c: &Canvas, x: i64, y: i64) -> i64 {
    read_i64(c.pixels, y * c.width + x)
}

fn main() with IO, Alloc, Mut, Div {
    var c = hello_canvas(160, 120)
    canvas_clear(&!c, 0, 0, 0)
    var scene = viz_scene_new()
    var xs: [f64; 1024] = [0.0; 1024]
    var ys: [f64; 1024] = [0.0; 1024]
    var i: i64 = 0
    while i < 6 {
        xs[i as usize] = i as f64
        ys[i as usize] = i as f64
        i = i + 1
    }
    viz_add_line_chart(&!scene, &xs, &ys, 6, viz_layout_rect(10, 10, 120, 80), viz_style_rgb(255, 180, 80))
    viz_canvas_render_scene(&scene, &!c)
    assert(hello_read(&c, 10, 10) != 0)
    heap_free(c.pixels as *mut i8)
    println("VIZ_HELLO_READY")
}
