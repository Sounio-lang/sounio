// One Knowledge value divided by itself. First-order sensitivity of
// x/x is zero, so the printed variance is 0. This is not a covariance
// matrix: a second, independent measurement of the same quantity would
// not cancel. See tests/run-pass/gum_fo_correlation_and_call_variance_2776.sio.
//
//   export SOUNIO_STDLIB_PATH="$(pwd)/stdlib"
//   ./bin/souc run examples/units/same_value_quotient.sio

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let distance: Knowledge<f64> = measure(10.0, uncertainty: 0.1)
    let quotient = distance.value / distance.value
    print("var_same_over_same=")
    print_f64(variance_of(quotient))
    print("\n")
    return 0
}
