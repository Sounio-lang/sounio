// Same measurements as velocity_with_uncertainty.sio, then an addition
// of metres to seconds. `./bin/souc check` is expected to fail.
// On Madaros the diagnostic is error[E041].
//
//   export SOUNIO_STDLIB_PATH="$(pwd)/stdlib"
//   ./bin/souc check examples/units/metres_plus_seconds.sio

unit velocity = m / s

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let distance: Knowledge<m> = measure(100.0, uncertainty: 0.5)
    let elapsed: Knowledge<s> = measure(10.0, uncertainty: 0.1)
    let bad = distance.value + elapsed.value
    print_f64(bad)
    print("\n")
    return 0
}
