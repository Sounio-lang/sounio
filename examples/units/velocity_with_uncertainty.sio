// Distance 100.0 m with standard uncertainty 0.5 m, time 10.0 s with
// standard uncertainty 0.1 s. Velocity is distance / time.
//
// Independent first-order propagation (JCGM 100:2008, §5.1.2) gives
// var(v) = (u_d / t)^2 + (d * u_t / t^2)^2 = 0.0125.
//
//   export SOUNIO_STDLIB_PATH="$(pwd)/stdlib"
//   ./bin/souc run examples/units/velocity_with_uncertainty.sio
//
// The Knowledge<m> / Knowledge<s> form below is the Madaros program.
// On the committed lean_single engine the same file is refused
// ("unit mismatch in call argument"). Plain `m / s` without Knowledge
// does run on that engine; this file does not split the two.

unit velocity = m / s

fn sqrt_f64(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    if guess < 0.001 { guess = 0.001 }
    var i = 0
    while i < 40 {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    return guess
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let distance: Knowledge<m> = measure(100.0, uncertainty: 0.5)
    let elapsed: Knowledge<s> = measure(10.0, uncertainty: 0.1)
    let speed: velocity = distance.value / elapsed.value
    let variance = variance_of(speed)
    let std_unc = sqrt_f64(variance)
    print("speed=")
    print_f64(speed)
    print("\n")
    print("variance=")
    print_f64(variance)
    print("\n")
    print("std_unc=")
    print_f64(std_unc)
    print("\n")
    return 0
}
