//@ run-pass
//!
//! First Sounio semantic-authority witness for the pinned open Arm AARCHMRS
//! TBL/TBX slice. Counts are computed here from the complete hashed stream;
//! no parity language or disposable script supplies an expected result.

use hardware::pireus::aarchmrs_import::{
    pireus_aarchmrs_import_chunks,
    pireus_aarchmrs_expected_sha256,
    pireus_aarchmrs_negative_duplicate_field,
    pireus_aarchmrs_negative_unknown_shape,
    pireus_aarchmrs_negative_malformed_json,
    pireus_aarchmrs_negative_empty_digest,
    pireus_aarchmrs_inventory_store,
    pireus_aarchmrs_query_forms_by,
    PIREUS_AARCHMRS_OK,
    PIREUS_ARM_OP_TBL_ADVSIMD, PIREUS_ARM_OP_TBX_ADVSIMD,
    PIREUS_ARM_OP_TBL_Z_ZZ, PIREUS_ARM_OP_TBX_Z_ZZ,
    PIREUS_ARM_HAS_CORPUS, PIREUS_ARM_HAS_OPERATION_ID,
    PIREUS_ARM_HAS_VECTOR_SHAPE, PIREUS_ARM_HAS_TABLE_CARDINALITY,
    PIREUS_ARM_HAS_RAW_FAMILY,
    PIREUS_ARM_CORPUS_AARCHMRS_FAT_2025_12,
    PIREUS_ARM_OP_IRI_TBL_ADVSIMD, PIREUS_ARM_OP_IRI_TBX_ADVSIMD,
    PIREUS_ARM_OP_IRI_TBL_Z_ZZ, PIREUS_ARM_OP_IRI_TBX_Z_ZZ,
    PIREUS_ARM_VECTOR_IRI_FIXED_128, PIREUS_ARM_VECTOR_IRI_SCALABLE,
    PIREUS_ARM_TABLES_IRI_1, PIREUS_ARM_TABLES_IRI_2,
    PIREUS_ARM_TABLES_IRI_3, PIREUS_ARM_TABLES_IRI_4,
    PIREUS_ARM_FAMILY_IRI_TBL, PIREUS_ARM_FAMILY_IRI_TBX,
}
use ontology::query::{triple_store_count, sparql_result_count}

fn arm_bool_i64(value: bool) -> i64 { if value { 1 } else { 0 } }

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 1 {
        print("usage: pireus_aarchmrs_tbl_import <chunk-prefix>\n")
        return 2
    }
    let prefix = get_arg(0)
    let inv = pireus_aarchmrs_import_chunks(prefix)
    var failures: i64 = 0
    if inv.error != PIREUS_AARCHMRS_OK { failures = failures + 1 }
    if !inv.digest_match { failures = failures + 1 }
    if inv.count <= 0 { failures = failures + 1 }
    if inv.tbl_count + inv.tbx_count != inv.count {
        failures = failures + 1
    }
    if inv.fixed_count + inv.scalable_count != inv.count {
        failures = failures + 1
    }

    var op_tbl_advsimd: i64 = 0
    var op_tbx_advsimd: i64 = 0
    var op_tbl_z: i64 = 0
    var op_tbx_z: i64 = 0
    var tables_1: i64 = 0
    var tables_2: i64 = 0
    var tables_3: i64 = 0
    var tables_4: i64 = 0
    var i: i64 = 0
    while i < inv.count {
        let form = inv.forms[i as usize]
        if form.operation_id_kind == PIREUS_ARM_OP_TBL_ADVSIMD {
            op_tbl_advsimd = op_tbl_advsimd + 1
        }
        if form.operation_id_kind == PIREUS_ARM_OP_TBX_ADVSIMD {
            op_tbx_advsimd = op_tbx_advsimd + 1
        }
        if form.operation_id_kind == PIREUS_ARM_OP_TBL_Z_ZZ {
            op_tbl_z = op_tbl_z + 1
        }
        if form.operation_id_kind == PIREUS_ARM_OP_TBX_Z_ZZ {
            op_tbx_z = op_tbx_z + 1
        }
        if form.table_registers == 1 { tables_1 = tables_1 + 1 }
        if form.table_registers == 2 { tables_2 = tables_2 + 1 }
        if form.table_registers == 3 { tables_3 = tables_3 + 1 }
        if form.table_registers == 4 { tables_4 = tables_4 + 1 }
        i = i + 1
    }
    if op_tbl_advsimd + op_tbx_advsimd + op_tbl_z + op_tbx_z != inv.count {
        failures = failures + 1
    }
    if tables_1 + tables_2 + tables_3 + tables_4 != inv.count {
        failures = failures + 1
    }

    var store = pireus_aarchmrs_inventory_store(&inv)
    let triples = triple_store_count(&store)
    let q_all = pireus_aarchmrs_query_forms_by(
        &store, PIREUS_ARM_HAS_CORPUS,
        PIREUS_ARM_CORPUS_AARCHMRS_FAT_2025_12)
    let q_tbl_adv = pireus_aarchmrs_query_forms_by(
        &store, PIREUS_ARM_HAS_OPERATION_ID,
        PIREUS_ARM_OP_IRI_TBL_ADVSIMD)
    let q_tbx_adv = pireus_aarchmrs_query_forms_by(
        &store, PIREUS_ARM_HAS_OPERATION_ID,
        PIREUS_ARM_OP_IRI_TBX_ADVSIMD)
    let q_tbl_z = pireus_aarchmrs_query_forms_by(
        &store, PIREUS_ARM_HAS_OPERATION_ID,
        PIREUS_ARM_OP_IRI_TBL_Z_ZZ)
    let q_tbx_z = pireus_aarchmrs_query_forms_by(
        &store, PIREUS_ARM_HAS_OPERATION_ID,
        PIREUS_ARM_OP_IRI_TBX_Z_ZZ)
    let q_fixed = pireus_aarchmrs_query_forms_by(
        &store, PIREUS_ARM_HAS_VECTOR_SHAPE,
        PIREUS_ARM_VECTOR_IRI_FIXED_128)
    let q_scalable = pireus_aarchmrs_query_forms_by(
        &store, PIREUS_ARM_HAS_VECTOR_SHAPE,
        PIREUS_ARM_VECTOR_IRI_SCALABLE)
    let q_tables_1 = pireus_aarchmrs_query_forms_by(
        &store, PIREUS_ARM_HAS_TABLE_CARDINALITY,
        PIREUS_ARM_TABLES_IRI_1)
    let q_tables_2 = pireus_aarchmrs_query_forms_by(
        &store, PIREUS_ARM_HAS_TABLE_CARDINALITY,
        PIREUS_ARM_TABLES_IRI_2)
    let q_tables_3 = pireus_aarchmrs_query_forms_by(
        &store, PIREUS_ARM_HAS_TABLE_CARDINALITY,
        PIREUS_ARM_TABLES_IRI_3)
    let q_tables_4 = pireus_aarchmrs_query_forms_by(
        &store, PIREUS_ARM_HAS_TABLE_CARDINALITY,
        PIREUS_ARM_TABLES_IRI_4)
    let q_family_tbl = pireus_aarchmrs_query_forms_by(
        &store, PIREUS_ARM_HAS_RAW_FAMILY, PIREUS_ARM_FAMILY_IRI_TBL)
    let q_family_tbx = pireus_aarchmrs_query_forms_by(
        &store, PIREUS_ARM_HAS_RAW_FAMILY, PIREUS_ARM_FAMILY_IRI_TBX)

    let all_count = sparql_result_count(&q_all)
    let q_tbl_adv_count = sparql_result_count(&q_tbl_adv)
    let q_tbx_adv_count = sparql_result_count(&q_tbx_adv)
    let q_tbl_z_count = sparql_result_count(&q_tbl_z)
    let q_tbx_z_count = sparql_result_count(&q_tbx_z)
    let q_fixed_count = sparql_result_count(&q_fixed)
    let q_scalable_count = sparql_result_count(&q_scalable)
    let q_tables_1_count = sparql_result_count(&q_tables_1)
    let q_tables_2_count = sparql_result_count(&q_tables_2)
    let q_tables_3_count = sparql_result_count(&q_tables_3)
    let q_tables_4_count = sparql_result_count(&q_tables_4)
    let q_family_tbl_count = sparql_result_count(&q_family_tbl)
    let q_family_tbx_count = sparql_result_count(&q_family_tbx)

    if all_count != inv.count { failures = failures + 1 }
    if q_tbl_adv_count != op_tbl_advsimd ||
        q_tbx_adv_count != op_tbx_advsimd ||
        q_tbl_z_count != op_tbl_z || q_tbx_z_count != op_tbx_z {
        failures = failures + 1
    }
    if q_fixed_count != inv.fixed_count ||
        q_scalable_count != inv.scalable_count {
        failures = failures + 1
    }
    if q_tables_1_count != tables_1 || q_tables_2_count != tables_2 ||
        q_tables_3_count != tables_3 || q_tables_4_count != tables_4 {
        failures = failures + 1
    }
    if q_family_tbl_count != inv.tbl_count ||
        q_family_tbx_count != inv.tbx_count {
        failures = failures + 1
    }

    let negative_duplicate = pireus_aarchmrs_negative_duplicate_field()
    let negative_shape = pireus_aarchmrs_negative_unknown_shape()
    let negative_json = pireus_aarchmrs_negative_malformed_json()
    let negative_digest = pireus_aarchmrs_negative_empty_digest()
    if !negative_duplicate || !negative_shape || !negative_json ||
        !negative_digest {
        failures = failures + 1
    }

    print("SOUNIO_AUTHORITY schema=pireus-aarchmrs-tbl.v0 role=SEMANTIC_AUTHORITY\n")
    print("PIREUS_ARM_CORPUS archive=AARCHMRS_OPENSOURCE_A_profile_FAT-2025-12.tar.gz")
    print(" file=Instructions.json bytes="); print_int(inv.total_bytes)
    print(" chunks="); print_int(inv.chunk_count)
    print(" error="); print_int(inv.error)
    print(" sha256="); print(pireus_aarchmrs_expected_sha256())
    print(" digest_match="); print_int(arm_bool_i64(inv.digest_match)); print("\n")
    print("PIREUS_ARM_META architecture=vFATAp1-A build=518 ref=2025-12_rel schema=2.7.4\n")
    print("PIREUS_ARM_JSON objects="); print_int(inv.json_objects)
    print(" strings="); print_int(inv.json_strings)
    print(" max_depth="); print_int(inv.max_depth)
    print(" instruction_objects="); print_int(inv.instruction_objects); print("\n")
    print("PIREUS_ARM_FORMS total="); print_int(inv.count)
    print(" tbl="); print_int(inv.tbl_count)
    print(" tbx="); print_int(inv.tbx_count); print("\n")
    print("PIREUS_ARM_OPERATION tbl_advsimd="); print_int(op_tbl_advsimd)
    print(" tbx_advsimd="); print_int(op_tbx_advsimd)
    print(" tbl_z_zz="); print_int(op_tbl_z)
    print(" tbx_z_zz="); print_int(op_tbx_z); print("\n")
    print("PIREUS_ARM_VECTOR fixed_128="); print_int(inv.fixed_count)
    print(" scalable="); print_int(inv.scalable_count); print("\n")
    print("PIREUS_ARM_TABLE_REGISTERS one="); print_int(tables_1)
    print(" two="); print_int(tables_2)
    print(" three="); print_int(tables_3)
    print(" four="); print_int(tables_4); print("\n")
    print("PIREUS_ARM_ONTOLOGY triples="); print_int(triples)
    print(" forms="); print_int(all_count); print("\n")
    print("PIREUS_ARM_NEGATIVE duplicate_field=")
    print_int(arm_bool_i64(negative_duplicate))
    print(" selected_shape="); print_int(arm_bool_i64(negative_shape))
    print(" malformed_json="); print_int(arm_bool_i64(negative_json))
    print(" digest="); print_int(arm_bool_i64(negative_digest)); print("\n")
    print("PIREUS_ARM_SEMANTIC_ROLE_ASSIGNMENTS count=0\n")
    print("PIREUS_ARM_SUMMARY failures="); print_int(failures); print("\n")

    if failures == 0 { 0 } else { 1 }
}
