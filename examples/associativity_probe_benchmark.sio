//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// Associativity Probe: Direct Octonionic Composition — THE Definitive Test
// ═══════════════════════════════════════════════════════════════════════════
//
// Ground truth is ALGEBRAICALLY non-associative.
// Input: [a, b, c, mode] where mode=LEFT→(e_a⊗e_b)⊗e_c, mode=RIGHT→e_a⊗(e_b⊗e_c)
// Output: ±e_k (16 classes: sign × basis index)
//
// For ~50% of triples, LEFT ≠ RIGHT (non-zero associator).
// H-SSM (associative) is structurally blind to bracketing.
// O-SSM (non-associative) can in principle represent the difference.
//
// This is THE experiment. If O-SSM separates on non-associative triples
// and H-SSM cannot, non-associativity IS the mechanism.

fn exp_q(x: f64) -> f64 with Mut, Div, Panic {
    if x > 15.0 { return exp_q(7.5) * exp_q(x - 7.5) }
    if x < 0.0 - 15.0 { return 0.0 }
    var sum = 1.0; var term = 1.0; var i = 1
    while i <= 20 { term = term * x / (i as f64); sum = sum + term; i = i + 1 }
    sum
}

var RNG_A: i64 = 0; var RNG_B: i64 = 0
fn rng_seed(a: i64, b: i64) with Mut { RNG_A = a; RNG_B = b }
fn rng_next() -> i64 with Mut {
    var x = RNG_A; let y = RNG_B; RNG_A = y
    x = x ^ (x << 23); x = x ^ (x >> 17); x = x ^ (y ^ (y >> 26))
    RNG_B = x; let r = x + y; if r < 0 { 0 - r } else { r }
}

// ═══════════════════════════════════════════════════════════════════════════
// Fano Plane Multiplication Table
// ═══════════════════════════════════════════════════════════════════════════
// 7 lines: (1,2,4), (2,3,5), (3,4,6), (4,5,7), (5,6,1), (6,7,2), (7,1,3)
// For (a,b,c): e_a*e_b = +e_c, e_b*e_a = -e_c (cyclic+anti-commutative)
// e_0 is identity. e_i*e_i = -e_0 for i>0.

fn oct_sign(i: i64, j: i64) -> i64 {
    if i == 0 { return 1 } if j == 0 { return 1 }
    if i == j { return 0 - 1 }
    // (1,2,4)
    if i==1 { if j==2 { return 1 } if j==4 { return 0-1 } if j==3 { return 1 } if j==5 { return 1 } if j==6 { return 0-1 } if j==7 { return 0-1 } }
    if i==2 { if j==1 { return 0-1 } if j==3 { return 1 } if j==4 { return 1 } if j==5 { return 0-1 } if j==6 { return 1 } if j==7 { return 0-1 } }
    if i==3 { if j==1 { return 0-1 } if j==2 { return 0-1 } if j==4 { return 1 } if j==5 { return 1 } if j==6 { return 0-1 } if j==7 { return 1 } }
    if i==4 { if j==1 { return 1 } if j==2 { return 0-1 } if j==3 { return 0-1 } if j==5 { return 1 } if j==6 { return 1 } if j==7 { return 0-1 } }
    if i==5 { if j==1 { return 0-1 } if j==2 { return 1 } if j==3 { return 0-1 } if j==4 { return 0-1 } if j==6 { return 1 } if j==7 { return 1 } }
    if i==6 { if j==1 { return 1 } if j==2 { return 0-1 } if j==3 { return 1 } if j==4 { return 0-1 } if j==5 { return 0-1 } if j==7 { return 1 } }
    if i==7 { if j==1 { return 1 } if j==2 { return 1 } if j==3 { return 0-1 } if j==4 { return 1 } if j==5 { return 0-1 } if j==6 { return 0-1 } }
    0
}

fn oct_basis(i: i64, j: i64) -> i64 {
    if i == 0 { return j } if j == 0 { return i }
    if i == j { return 0 }
    // (1,2,4)
    if i==1 { if j==2 { return 4 } if j==4 { return 2 } if j==3 { return 7 } if j==5 { return 6 } if j==6 { return 5 } if j==7 { return 3 } }
    if i==2 { if j==1 { return 4 } if j==3 { return 5 } if j==4 { return 1 } if j==5 { return 3 } if j==6 { return 7 } if j==7 { return 6 } }
    if i==3 { if j==1 { return 7 } if j==2 { return 5 } if j==4 { return 6 } if j==5 { return 2 } if j==6 { return 4 } if j==7 { return 1 } }
    if i==4 { if j==1 { return 2 } if j==2 { return 1 } if j==3 { return 6 } if j==5 { return 7 } if j==6 { return 3 } if j==7 { return 5 } }
    if i==5 { if j==1 { return 6 } if j==2 { return 3 } if j==3 { return 2 } if j==4 { return 7 } if j==6 { return 1 } if j==7 { return 4 } }
    if i==6 { if j==1 { return 5 } if j==2 { return 7 } if j==3 { return 4 } if j==4 { return 3 } if j==5 { return 1 } if j==7 { return 2 } }
    if i==7 { if j==1 { return 3 } if j==2 { return 6 } if j==3 { return 1 } if j==4 { return 5 } if j==5 { return 4 } if j==6 { return 2 } }
    0
}

// Multiply signed basis: (sign_a, idx_a) * (idx_b) → (sign_out, idx_out)
// Returns encoded as sign*16 + idx (sign: 0=positive, 1=negative)
fn oct_signed_mul(s_a: i64, idx_a: i64, idx_b: i64) -> i64 with Mut {
    let raw_sign = oct_sign(idx_a, idx_b)
    let raw_basis = oct_basis(idx_a, idx_b)
    // Combine signs: s_a flips if negative
    var final_sign = raw_sign
    if s_a < 0 { final_sign = 0 - final_sign }
    // Encode: positive → class 0..7, negative → class 8..15
    if final_sign >= 0 { raw_basis } else { 8 + raw_basis }
}

// ═══════════════════════════════════════════════════════════════════════════
// Ground Truth Generator
// ═══════════════════════════════════════════════════════════════════════════

var PROBE_TOKENS: [i64; 4] = [0; 4]
var PROBE_LABEL: i64 = 0
var PROBE_IS_ASSOC: i64 = 0  // 1 if LEFT==RIGHT for this triple

fn generate_assoc_probe() with Mut, Div {
    let a = (rng_next() / 100) % 8
    let b = (rng_next() / 100) % 8
    let c = (rng_next() / 100) % 8
    let mode = (rng_next() / 100) % 2  // 0=LEFT=(ab)c, 1=RIGHT=a(bc)

    PROBE_TOKENS[0] = a
    PROBE_TOKENS[1] = b
    PROBE_TOKENS[2] = c
    PROBE_TOKENS[3] = mode + 8  // offset to distinguish from basis indices

    // Compute LEFT: (e_a * e_b) * e_c
    let ab_sign = oct_sign(a, b)
    let ab_idx = oct_basis(a, b)
    let left_label = oct_signed_mul(ab_sign, ab_idx, c)

    // Compute RIGHT: e_a * (e_b * e_c)
    let bc_sign = oct_sign(b, c)
    let bc_idx = oct_basis(b, c)
    let right_label = oct_signed_mul(bc_sign, a, bc_idx)

    if mode == 0 { PROBE_LABEL = left_label }
    if mode == 1 { PROBE_LABEL = right_label }

    // Check if this triple is associative (LEFT == RIGHT)
    if left_label == right_label { PROBE_IS_ASSOC = 1 } else { PROBE_IS_ASSOC = 0 }
}

// ═══════════════════════════════════════════════════════════════════════════
// Model Weights
// ═══════════════════════════════════════════════════════════════════════════
// Embed: 10 tokens × 8 dims = 80 (tokens 0-7 = basis, 8-9 = LEFT/RIGHT)
// A: 8 params (104→84)
// B: 8 params
// Out: 8 × 16 = 128 params (16 classes)
// Total: 80 + 8 + 8 + 128 = 224

var W: [i64; 224] = [0; 224]
var H: [i64; 8] = [0; 8]
var L: [i64; 16] = [0; 16]
var MOM: [i64; 224] = [0; 224]

// BPTT storage: 4 timesteps × 8 dims = 32
var H_SAVE: [i64; 64] = [0; 64]
var X_SAVE: [i64; 64] = [0; 64]
var N_STEPS: i64 = 0
var DA: [i64; 64] = [0; 64]
var DB: [i64; 8] = [0; 8]
var DH: [i64; 8] = [0; 8]

fn ws(i: i64, v: f64) with Mut { W[i] = (v * 100000000.0) as i64 }
fn wg(i: i64) -> f64 with Div { (W[i] as f64) / 100000000.0 }
fn hs(i: i64, v: f64) with Mut { H[i] = (v * 100000000.0) as i64 }
fn hg(i: i64) -> f64 with Div { (H[i] as f64) / 100000000.0 }

// Offsets
// Embed: 0..79 (10 tokens × 8 dims)
// A: 80..87
// B: 88..95
// Out: 96..223 (8 × 16)

fn init_embed_b_out() with Mut, Div {
    var i = 0
    while i < 80 { ws(i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 8 { ws(88 + i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 128 { ws(96 + i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 224 { MOM[i] = 0; i = i + 1 }
}

fn init_A_oct() with Mut, Div {
    ws(80, 0.95)
    var i = 1
    while i < 8 { ws(80 + i, ((rng_next() % 200) as f64 - 100.0) / 1000.0); i = i + 1 }
}

fn init_A_quat() with Mut, Div {
    ws(80, 0.95)
    ws(81, ((rng_next() % 100) as f64 - 50.0) / 500.0)
    ws(82, ((rng_next() % 100) as f64 - 50.0) / 500.0)
    ws(83, ((rng_next() % 100) as f64 - 50.0) / 500.0)
    ws(84, 0.95)
    ws(85, ((rng_next() % 100) as f64 - 50.0) / 500.0)
    ws(86, ((rng_next() % 100) as f64 - 50.0) / 500.0)
    ws(87, ((rng_next() % 100) as f64 - 50.0) / 500.0)
}

fn init_A_diag() with Mut {
    var i = 0
    while i < 8 { ws(80 + i, 0.95); i = i + 1 }
}

fn init_A_s4diag() with Mut, Div, Panic {
    var i = 0
    while i < 8 { ws(80 + i, 0.0); i = i + 1 }
    // Store as pairs: (re, im) for 4 complex eigenvalues
    // For S4-DIAG we store the diagonal values directly
    // Since A is only 8 params, store as 4 complex pairs
    var k = 0
    while k < 4 {
        let a = 0.0 - 0.5
        let b = 3.14159265 * (2.0 * (k as f64) + 1.0) / 2.0
        let ea = exp_q(a)
        var bmod = b
        while bmod > 3.14159265 { bmod = bmod - 6.28318530 }
        while bmod < 0.0 - 3.14159265 { bmod = bmod + 6.28318530 }
        let b2 = bmod * bmod
        let cos_b = 1.0 - b2/2.0 + b2*b2/24.0 - b2*b2*b2/720.0
        let sin_b = bmod - bmod*b2/6.0 + bmod*b2*b2/120.0 - bmod*b2*b2*b2/5040.0
        ws(80 + k*2, ea * cos_b)
        ws(80 + k*2 + 1, ea * sin_b)
        k = k + 1
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Forward Steps (Native Algebra)
// ═══════════════════════════════════════════════════════════════════════════

fn oct_step(token: i64) with Mut, Div {
    let a0 = wg(80); let a1 = wg(81); let a2 = wg(82); let a3 = wg(83)
    let a4 = wg(84); let a5 = wg(85); let a6 = wg(86); let a7 = wg(87)
    let h0 = hg(0); let h1 = hg(1); let h2 = hg(2); let h3 = hg(3)
    let h4 = hg(4); let h5 = hg(5); let h6 = hg(6); let h7 = hg(7)
    // Cayley product
    var n0 = a0*h0 - a1*h1 - a2*h2 - a3*h3 - a4*h4 - a5*h5 - a6*h6 - a7*h7
    var n1 = a0*h1 + a1*h0 + a2*h3 - a3*h2 + a4*h5 - a5*h4 - a6*h7 + a7*h6
    var n2 = a0*h2 + a2*h0 - a1*h3 + a3*h1 + a4*h6 - a6*h4 + a5*h7 - a7*h5
    var n3 = a0*h3 + a3*h0 + a1*h2 - a2*h1 + a4*h7 - a7*h4 - a5*h6 + a6*h5
    var n4 = a0*h4 + a4*h0 - a1*h5 + a5*h1 - a2*h6 + a6*h2 - a3*h7 + a7*h3
    var n5 = a0*h5 + a5*h0 + a1*h4 - a4*h1 - a2*h7 + a7*h2 + a3*h6 - a6*h3
    var n6 = a0*h6 + a6*h0 + a1*h7 - a7*h1 + a2*h4 - a4*h2 - a3*h5 + a5*h3
    var n7 = a0*h7 + a7*h0 - a1*h6 + a6*h1 - a2*h5 + a5*h2 + a3*h4 - a4*h3
    n0 = n0 + wg(88+0)*wg(token*8+0); n1 = n1 + wg(88+1)*wg(token*8+1)
    n2 = n2 + wg(88+2)*wg(token*8+2); n3 = n3 + wg(88+3)*wg(token*8+3)
    n4 = n4 + wg(88+4)*wg(token*8+4); n5 = n5 + wg(88+5)*wg(token*8+5)
    n6 = n6 + wg(88+6)*wg(token*8+6); n7 = n7 + wg(88+7)*wg(token*8+7)
    if n0>5.0{n0=5.0} if n0<0.0-5.0{n0=0.0-5.0} if n1>5.0{n1=5.0} if n1<0.0-5.0{n1=0.0-5.0}
    if n2>5.0{n2=5.0} if n2<0.0-5.0{n2=0.0-5.0} if n3>5.0{n3=5.0} if n3<0.0-5.0{n3=0.0-5.0}
    if n4>5.0{n4=5.0} if n4<0.0-5.0{n4=0.0-5.0} if n5>5.0{n5=5.0} if n5<0.0-5.0{n5=0.0-5.0}
    if n6>5.0{n6=5.0} if n6<0.0-5.0{n6=0.0-5.0} if n7>5.0{n7=5.0} if n7<0.0-5.0{n7=0.0-5.0}
    hs(0,n0); hs(1,n1); hs(2,n2); hs(3,n3); hs(4,n4); hs(5,n5); hs(6,n6); hs(7,n7)
}

fn quat_step(token: i64) with Mut, Div {
    let qw=wg(80); let qx=wg(81); let qy=wg(82); let qz=wg(83)
    let hw=hg(0); let hx=hg(1); let hy=hg(2); let hz=hg(3)
    var n0=qw*hw-qx*hx-qy*hy-qz*hz; var n1=qw*hx+qx*hw+qy*hz-qz*hy
    var n2=qw*hy-qx*hz+qy*hw+qz*hx; var n3=qw*hz+qx*hy-qy*hx+qz*hw
    n0=n0+wg(88+0)*wg(token*8+0); n1=n1+wg(88+1)*wg(token*8+1)
    n2=n2+wg(88+2)*wg(token*8+2); n3=n3+wg(88+3)*wg(token*8+3)
    if n0>5.0{n0=5.0} if n0<0.0-5.0{n0=0.0-5.0} if n1>5.0{n1=5.0} if n1<0.0-5.0{n1=0.0-5.0}
    if n2>5.0{n2=5.0} if n2<0.0-5.0{n2=0.0-5.0} if n3>5.0{n3=5.0} if n3<0.0-5.0{n3=0.0-5.0}
    let qw2=wg(84); let qx2=wg(85); let qy2=wg(86); let qz2=wg(87)
    let hw2=hg(4); let hx2=hg(5); let hy2=hg(6); let hz2=hg(7)
    var n4=qw2*hw2-qx2*hx2-qy2*hy2-qz2*hz2; var n5=qw2*hx2+qx2*hw2+qy2*hz2-qz2*hy2
    var n6=qw2*hy2-qx2*hz2+qy2*hw2+qz2*hx2; var n7=qw2*hz2+qx2*hy2-qy2*hx2+qz2*hw2
    n4=n4+wg(88+4)*wg(token*8+4); n5=n5+wg(88+5)*wg(token*8+5)
    n6=n6+wg(88+6)*wg(token*8+6); n7=n7+wg(88+7)*wg(token*8+7)
    if n4>5.0{n4=5.0} if n4<0.0-5.0{n4=0.0-5.0} if n5>5.0{n5=5.0} if n5<0.0-5.0{n5=0.0-5.0}
    if n6>5.0{n6=5.0} if n6<0.0-5.0{n6=0.0-5.0} if n7>5.0{n7=5.0} if n7<0.0-5.0{n7=0.0-5.0}
    hs(0,n0); hs(1,n1); hs(2,n2); hs(3,n3); hs(4,n4); hs(5,n5); hs(6,n6); hs(7,n7)
}

fn diag_step(token: i64) with Mut, Div {
    var d = 0
    while d < 8 {
        var s = wg(80+d)*hg(d) + wg(88+d)*wg(token*8+d)
        if s>5.0{s=5.0} if s<0.0-5.0{s=0.0-5.0}
        hs(d, s); d = d + 1
    }
}

fn s4diag_step(token: i64) with Mut, Div {
    // S4-DIAG: 4 complex rotation pairs
    var k = 0
    while k < 4 {
        let re_a = wg(80 + k*2); let im_a = wg(80 + k*2 + 1)
        let re_h = hg(k*2); let im_h = hg(k*2 + 1)
        var re_n = re_a*re_h - im_a*im_h + wg(88 + k*2)*wg(token*8 + k*2)
        var im_n = re_a*im_h + im_a*re_h + wg(88 + k*2 + 1)*wg(token*8 + k*2 + 1)
        if re_n>5.0{re_n=5.0} if re_n<0.0-5.0{re_n=0.0-5.0}
        if im_n>5.0{im_n=5.0} if im_n<0.0-5.0{im_n=0.0-5.0}
        hs(k*2, re_n); hs(k*2+1, im_n)
        k = k + 1
    }
}

// ─── Forward with state saving (for BPTT) ───
fn save_h(step: i64) with Mut {
    var d = 0
    while d < 8 { H_SAVE[step*8+d] = H[d]; d = d + 1 }
}
fn save_x(step: i64, token: i64) with Mut, Div {
    var d = 0
    while d < 8 { X_SAVE[step*8+d] = (wg(token*8+d)*100000000.0) as i64; d = d + 1 }
}

fn model_step(token: i64, model_id: i64) with Mut, Div {
    if model_id == 0 { oct_step(token) }
    if model_id == 1 { quat_step(token) }
    if model_id == 2 { diag_step(token) }
    if model_id == 3 { s4diag_step(token) }
}

fn model_step_save(token: i64, model_id: i64, step: i64) with Mut, Div {
    save_h(step); save_x(step, token); model_step(token, model_id)
}

// ═══════════════════════════════════════════════════════════════════════════
// Logits, Prediction, Update (16 classes)
// ═══════════════════════════════════════════════════════════════════════════

fn compute_logits() with Mut, Div {
    var c = 0
    while c < 16 {
        var s = 0.0; var d = 0
        while d < 8 { s = s + hg(d) * wg(96 + d*16 + c); d = d + 1 }
        L[c] = (s * 100000000.0) as i64; c = c + 1
    }
}

fn get_pred() -> i64 with Mut, Div {
    var best = 0; var bv = (L[0] as f64) / 100000000.0; var i = 1
    while i < 16 { let v = (L[i] as f64)/100000000.0; if v > bv { bv = v; best = i }; i = i + 1 }
    best
}

var PROBS: [f64; 16] = [0.0; 16]

fn update_out(tgt: i64, lr: f64) with Mut, Div, Panic {
    var mx = (L[0] as f64) / 100000000.0; var i = 1
    while i < 16 { let v = (L[i] as f64)/100000000.0; if v > mx { mx = v }; i = i + 1 }
    var se = 0.0; i = 0
    while i < 16 { PROBS[i] = exp_q((L[i] as f64)/100000000.0 - mx); se = se + PROBS[i]; i = i + 1 }
    i = 0
    while i < 16 { PROBS[i] = PROBS[i] / se; i = i + 1 }
    PROBS[tgt] = PROBS[tgt] - 1.0
    var d = 0
    while d < 8 {
        let hd = hg(d); var c = 0
        while c < 16 {
            let idx = 96 + d*16 + c
            var g = hd * PROBS[c]
            if g > 0.3 { g = 0.3 } if g < 0.0 - 0.3 { g = 0.0 - 0.3 }
            let m = (MOM[idx] as f64) / 100000000.0 * 0.9 + g
            MOM[idx] = (m * 100000000.0) as i64
            ws(idx, wg(idx) - lr * m)
            c = c + 1
        }
        d = d + 1
    }
}

// ─── BPTT output gradient (16 classes) ───
fn bptt_output_grad(tgt: i64, lr_out: f64) with Mut, Div, Panic {
    var mx = (L[0] as f64) / 100000000.0; var i = 1
    while i < 16 { let v = (L[i] as f64)/100000000.0; if v > mx { mx = v }; i = i + 1 }
    var se = 0.0; i = 0
    while i < 16 { PROBS[i] = exp_q((L[i] as f64)/100000000.0 - mx); se = se + PROBS[i]; i = i + 1 }
    i = 0
    while i < 16 { PROBS[i] = PROBS[i] / se; i = i + 1 }
    PROBS[tgt] = PROBS[tgt] - 1.0
    var d = 0
    while d < 8 {
        let hd = hg(d); var dh_d = 0.0; var c = 0
        while c < 16 {
            let idx = 96 + d*16 + c
            var g = hd * PROBS[c]
            if g>0.5{g=0.5} if g<0.0-0.5{g=0.0-0.5}
            let m = (MOM[idx] as f64) / 100000000.0 * 0.9 + g
            MOM[idx] = (m * 100000000.0) as i64
            ws(idx, wg(idx) - lr_out * m)
            dh_d = dh_d + wg(96+d*16+c) * PROBS[c]
            c = c + 1
        }
        DH[d] = (dh_d * 100000000.0) as i64
        d = d + 1
    }
}

// ─── BPTT: propagate backward through A ───
// For Cayley (O-SSM): dh = oct_conjugate * dh (conjugate = negate e1..e7)
fn bptt_prop_oct() with Mut, Div {
    let a0=wg(80); let a1=wg(81); let a2=wg(82); let a3=wg(83)
    let a4=wg(84); let a5=wg(85); let a6=wg(86); let a7=wg(87)
    let d0=(DH[0] as f64)/100000000.0; let d1=(DH[1] as f64)/100000000.0
    let d2=(DH[2] as f64)/100000000.0; let d3=(DH[3] as f64)/100000000.0
    let d4=(DH[4] as f64)/100000000.0; let d5=(DH[5] as f64)/100000000.0
    let d6=(DH[6] as f64)/100000000.0; let d7=(DH[7] as f64)/100000000.0
    // oct_conj(A) * dh: conjugate = (a0, -a1, ..., -a7)
    var n0 = a0*d0 + a1*d1 + a2*d2 + a3*d3 + a4*d4 + a5*d5 + a6*d6 + a7*d7
    var n1 = 0.0-a1*d0 + a0*d1 - a2*d3 + a3*d2 - a4*d5 + a5*d4 + a6*d7 - a7*d6
    var n2 = 0.0-a2*d0 + a0*d2 + a1*d3 - a3*d1 - a4*d6 + a6*d4 - a5*d7 + a7*d5
    var n3 = 0.0-a3*d0 + a0*d3 - a1*d2 + a2*d1 - a4*d7 + a7*d4 + a5*d6 - a6*d5
    var n4 = 0.0-a4*d0 + a0*d4 + a1*d5 - a5*d1 + a2*d6 - a6*d2 + a3*d7 - a7*d3
    var n5 = 0.0-a5*d0 + a0*d5 - a1*d4 + a4*d1 + a2*d7 - a7*d2 - a3*d6 + a6*d3
    var n6 = 0.0-a6*d0 + a0*d6 - a1*d7 + a7*d1 - a2*d4 + a4*d2 + a3*d5 - a5*d3
    var n7 = 0.0-a7*d0 + a0*d7 + a1*d6 - a6*d1 + a2*d5 - a5*d2 - a3*d4 + a4*d3
    if n0>1.0{n0=1.0} if n0<0.0-1.0{n0=0.0-1.0} if n1>1.0{n1=1.0} if n1<0.0-1.0{n1=0.0-1.0}
    if n2>1.0{n2=1.0} if n2<0.0-1.0{n2=0.0-1.0} if n3>1.0{n3=1.0} if n3<0.0-1.0{n3=0.0-1.0}
    if n4>1.0{n4=1.0} if n4<0.0-1.0{n4=0.0-1.0} if n5>1.0{n5=1.0} if n5<0.0-1.0{n5=0.0-1.0}
    if n6>1.0{n6=1.0} if n6<0.0-1.0{n6=0.0-1.0} if n7>1.0{n7=1.0} if n7<0.0-1.0{n7=0.0-1.0}
    DH[0]=(n0*100000000.0) as i64; DH[1]=(n1*100000000.0) as i64
    DH[2]=(n2*100000000.0) as i64; DH[3]=(n3*100000000.0) as i64
    DH[4]=(n4*100000000.0) as i64; DH[5]=(n5*100000000.0) as i64
    DH[6]=(n6*100000000.0) as i64; DH[7]=(n7*100000000.0) as i64
}

fn bptt_prop_quat() with Mut, Div {
    // Half 1: quaternion conjugate
    let aw=wg(80); let ax=wg(81); let ay=wg(82); let az=wg(83)
    let d0=(DH[0] as f64)/100000000.0; let d1=(DH[1] as f64)/100000000.0
    let d2=(DH[2] as f64)/100000000.0; let d3=(DH[3] as f64)/100000000.0
    var n0 = aw*d0 + ax*d1 + ay*d2 + az*d3
    var n1 = 0.0-ax*d0 + aw*d1 + az*d2 - ay*d3
    var n2 = 0.0-ay*d0 - az*d1 + aw*d2 + ax*d3
    var n3 = 0.0-az*d0 + ay*d1 - ax*d2 + aw*d3
    if n0>1.0{n0=1.0} if n0<0.0-1.0{n0=0.0-1.0} if n1>1.0{n1=1.0} if n1<0.0-1.0{n1=0.0-1.0}
    if n2>1.0{n2=1.0} if n2<0.0-1.0{n2=0.0-1.0} if n3>1.0{n3=1.0} if n3<0.0-1.0{n3=0.0-1.0}
    DH[0]=(n0*100000000.0) as i64; DH[1]=(n1*100000000.0) as i64
    DH[2]=(n2*100000000.0) as i64; DH[3]=(n3*100000000.0) as i64
    // Half 2
    let aw2=wg(84); let ax2=wg(85); let ay2=wg(86); let az2=wg(87)
    let d4=(DH[4] as f64)/100000000.0; let d5=(DH[5] as f64)/100000000.0
    let d6=(DH[6] as f64)/100000000.0; let d7=(DH[7] as f64)/100000000.0
    var n4 = aw2*d4 + ax2*d5 + ay2*d6 + az2*d7
    var n5 = 0.0-ax2*d4 + aw2*d5 + az2*d6 - ay2*d7
    var n6 = 0.0-ay2*d4 - az2*d5 + aw2*d6 + ax2*d7
    var n7 = 0.0-az2*d4 + ay2*d5 - ax2*d6 + aw2*d7
    if n4>1.0{n4=1.0} if n4<0.0-1.0{n4=0.0-1.0} if n5>1.0{n5=1.0} if n5<0.0-1.0{n5=0.0-1.0}
    if n6>1.0{n6=1.0} if n6<0.0-1.0{n6=0.0-1.0} if n7>1.0{n7=1.0} if n7<0.0-1.0{n7=0.0-1.0}
    DH[4]=(n4*100000000.0) as i64; DH[5]=(n5*100000000.0) as i64
    DH[6]=(n6*100000000.0) as i64; DH[7]=(n7*100000000.0) as i64
}

fn bptt_prop_diag() with Mut, Div {
    var d = 0
    while d < 8 {
        var nd = wg(80+d) * ((DH[d] as f64)/100000000.0)
        if nd>1.0{nd=1.0} if nd<0.0-1.0{nd=0.0-1.0}
        DH[d] = (nd*100000000.0) as i64; d = d + 1
    }
}

// ─── BPTT accum + apply (shared for all models) ───
fn bptt_accum(t: i64) with Mut, Div {
    var d = 0
    while d < 8 {
        var dh_clip = (DH[d] as f64) / 100000000.0
        if dh_clip>0.5{dh_clip=0.5} if dh_clip<0.0-0.5{dh_clip=0.0-0.5}
        // dA: For all models, accumulate dh ⊗ h as flat 8 entries
        let ht_d = (H_SAVE[t*8+d] as f64) / 100000000.0
        DA[d] = DA[d] + (dh_clip * ht_d * 100000000.0) as i64
        let xt_d = (X_SAVE[t*8+d] as f64) / 100000000.0
        DB[d] = DB[d] + (dh_clip * xt_d * 100000000.0) as i64
        d = d + 1
    }
}

fn bptt_apply(lr_A: f64) with Mut, Div {
    let inv_t = 1.0 / (N_STEPS as f64)
    var i = 0
    while i < 8 {
        let g = (DA[i] as f64) / 100000000.0 * inv_t
        var gc = g; if gc>0.3{gc=0.3} if gc<0.0-0.3{gc=0.0-0.3}
        let idx = 80 + i
        let m = (MOM[idx] as f64) / 100000000.0 * 0.9 + gc
        MOM[idx] = (m * 100000000.0) as i64
        ws(idx, wg(idx) - lr_A * m)
        // B
        let gb = (DB[i] as f64) / 100000000.0 * inv_t
        var gbc = gb; if gbc>0.3{gbc=0.3} if gbc<0.0-0.3{gbc=0.0-0.3}
        let bidx = 88 + i
        let mb = (MOM[bidx] as f64) / 100000000.0 * 0.9 + gbc
        MOM[bidx] = (mb * 100000000.0) as i64
        ws(bidx, wg(bidx) - lr_A * mb)
        i = i + 1
    }
}

fn bptt_backward(tgt: i64, model_id: i64, lr_A: f64, lr_out: f64) with Mut, Div, Panic {
    bptt_output_grad(tgt, lr_out)
    var i = 0
    while i < 64 { DA[i] = 0; i = i + 1 }
    i = 0
    while i < 8 { DB[i] = 0; i = i + 1 }
    var t = N_STEPS - 1
    while t >= 0 {
        bptt_accum(t)
        if model_id == 0 { bptt_prop_oct() }
        if model_id == 1 { bptt_prop_quat() }
        if model_id == 2 { bptt_prop_diag() }
        if model_id == 3 { bptt_prop_diag() }  // S4 uses diagonal backward
        t = t - 1
    }
    bptt_apply(lr_A)
}

// ═══════════════════════════════════════════════════════════════════════════
// Training + Evaluation
// ═══════════════════════════════════════════════════════════════════════════

fn train_and_eval(model_id: i64) with IO, Mut, Div, Panic {
    let n_train = 500

    // Phase 1: output-only, 100 epochs
    var ep = 0
    while ep < 100 {
        var s = 0
        while s < n_train {
            generate_assoc_probe()
            var d = 0
            while d < 8 { H[d] = 0; d = d + 1 }
            var t = 0
            while t < 4 { model_step(PROBE_TOKENS[t], model_id); t = t + 1 }
            compute_logits()
            update_out(PROBE_LABEL, 0.01)
            s = s + 1
        }
        ep = ep + 1
    }

    // Phase 2: BPTT, 50 epochs
    rng_seed(54321, 98765)
    ep = 0
    while ep < 50 {
        var s = 0
        while s < n_train {
            generate_assoc_probe()
            var d = 0
            while d < 8 { H[d] = 0; d = d + 1 }
            N_STEPS = 0
            var t = 0
            while t < 4 { model_step_save(PROBE_TOKENS[t], model_id, N_STEPS); N_STEPS = N_STEPS + 1; t = t + 1 }
            compute_logits()
            bptt_backward(PROBE_LABEL, model_id, 0.001, 0.005)
            s = s + 1
        }
        ep = ep + 1
    }
}

// Structured evaluation: overall, assoc-triples, non-assoc-triples
var EVAL_OVERALL: i64 = 0
var EVAL_ASSOC_CORRECT: i64 = 0
var EVAL_ASSOC_TOTAL: i64 = 0
var EVAL_NONASSOC_CORRECT: i64 = 0
var EVAL_NONASSOC_TOTAL: i64 = 0

fn eval_model(model_id: i64) with IO, Mut, Div, Panic {
    rng_seed(99999, 11111)
    EVAL_OVERALL = 0
    EVAL_ASSOC_CORRECT = 0; EVAL_ASSOC_TOTAL = 0
    EVAL_NONASSOC_CORRECT = 0; EVAL_NONASSOC_TOTAL = 0
    var s = 0
    while s < 1000 {
        generate_assoc_probe()
        var d = 0
        while d < 8 { H[d] = 0; d = d + 1 }
        var t = 0
        while t < 4 { model_step(PROBE_TOKENS[t], model_id); t = t + 1 }
        compute_logits()
        let pred = get_pred()
        if pred == PROBE_LABEL { EVAL_OVERALL = EVAL_OVERALL + 1 }
        if PROBE_IS_ASSOC == 1 {
            EVAL_ASSOC_TOTAL = EVAL_ASSOC_TOTAL + 1
            if pred == PROBE_LABEL { EVAL_ASSOC_CORRECT = EVAL_ASSOC_CORRECT + 1 }
        } else {
            EVAL_NONASSOC_TOTAL = EVAL_NONASSOC_TOTAL + 1
            if pred == PROBE_LABEL { EVAL_NONASSOC_CORRECT = EVAL_NONASSOC_CORRECT + 1 }
        }
        s = s + 1
    }
}

fn print_eval_line() with IO, Mut, Div {
    let overall_pct = (EVAL_OVERALL as f64) / 1000.0 * 100.0
    var assoc_pct = 0.0
    if EVAL_ASSOC_TOTAL > 0 { assoc_pct = (EVAL_ASSOC_CORRECT as f64) / (EVAL_ASSOC_TOTAL as f64) * 100.0 }
    var nonassoc_pct = 0.0
    if EVAL_NONASSOC_TOTAL > 0 { nonassoc_pct = (EVAL_NONASSOC_CORRECT as f64) / (EVAL_NONASSOC_TOTAL as f64) * 100.0 }
    let delta = nonassoc_pct - assoc_pct

    print(overall_pct); print("%    ")
    print(assoc_pct); print("% ("); print_int(EVAL_ASSOC_TOTAL); print(")  ")
    print(nonassoc_pct); print("% ("); print_int(EVAL_NONASSOC_TOTAL); print(")  ")
    if delta >= 0.0 { print("+") }
    print(delta); print("%\n")
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("═══════════════════════════════════════════════════════════════\n")
    print("  Associativity Probe: Direct Octonionic Composition Test\n")
    print("═══════════════════════════════════════════════════════════════\n\n")
    print("  Ground truth: oct_basis_mul using Fano plane\n")
    print("  Input: [a, b, c, mode] → ±e_k (16 classes)\n")
    print("  mode=LEFT: (e_a⊗e_b)⊗e_c  mode=RIGHT: e_a⊗(e_b⊗e_c)\n")
    print("  ~50% of triples have non-zero associator\n\n")

    // Verification: print 10 examples
    print("  Verification (10 examples):\n")
    rng_seed(42, 137)
    var na_count = 0; var total_verify = 0
    while total_verify < 10 {
        generate_assoc_probe()
        let a = PROBE_TOKENS[0]; let b = PROBE_TOKENS[1]; let c = PROBE_TOKENS[2]
        let mode = PROBE_TOKENS[3] - 8
        print("    e"); print_int(a); print("*e"); print_int(b); print("*e"); print_int(c)
        if mode == 0 { print(" LEFT  ") } else { print(" RIGHT ") }
        print("→ class "); print_int(PROBE_LABEL)
        if PROBE_IS_ASSOC == 1 { print(" [assoc]") } else { print(" [NON-ASSOC]"); na_count = na_count + 1 }
        print("\n")
        total_verify = total_verify + 1
    }

    // Count non-associative fraction over 1000 samples
    rng_seed(99999, 11111)
    var na_total = 0; var check = 0
    while check < 1000 {
        generate_assoc_probe()
        if PROBE_IS_ASSOC == 0 { na_total = na_total + 1 }
        check = check + 1
    }
    let na_frac = (na_total as f64) / 1000.0 * 100.0
    print("\n  Non-associative fraction: "); print(na_frac); print("% of 1000 samples\n\n")

    // ─── Train and Eval ───
    print("  Training: P1=100ep output-only + P2=50ep BPTT, 500/ep\n\n")

    // O-SSM
    print("  Training O-SSM (Cayley)...\n")
    rng_seed(55555, 77777); init_embed_b_out(); init_A_oct()
    rng_seed(12345, 67890)
    train_and_eval(0)
    eval_model(0)
    var ossm_overall = EVAL_OVERALL
    var ossm_assoc_c = EVAL_ASSOC_CORRECT; var ossm_assoc_t = EVAL_ASSOC_TOTAL
    var ossm_na_c = EVAL_NONASSOC_CORRECT; var ossm_na_t = EVAL_NONASSOC_TOTAL

    // H-SSM
    print("  Training H-SSM (Hamilton)...\n")
    rng_seed(55555, 77777); init_embed_b_out(); init_A_quat()
    rng_seed(12345, 67890)
    train_and_eval(1)
    eval_model(1)
    var hssm_overall = EVAL_OVERALL
    var hssm_assoc_c = EVAL_ASSOC_CORRECT; var hssm_assoc_t = EVAL_ASSOC_TOTAL
    var hssm_na_c = EVAL_NONASSOC_CORRECT; var hssm_na_t = EVAL_NONASSOC_TOTAL

    // Naive
    print("  Training Naive (diagonal)...\n")
    rng_seed(55555, 77777); init_embed_b_out(); init_A_diag()
    rng_seed(12345, 67890)
    train_and_eval(2)
    eval_model(2)
    var naive_overall = EVAL_OVERALL
    var naive_assoc_c = EVAL_ASSOC_CORRECT; var naive_assoc_t = EVAL_ASSOC_TOTAL
    var naive_na_c = EVAL_NONASSOC_CORRECT; var naive_na_t = EVAL_NONASSOC_TOTAL

    // S4-DIAG
    print("  Training S4-DIAG (HiPPO)...\n")
    rng_seed(55555, 77777); init_embed_b_out(); init_A_s4diag()
    rng_seed(12345, 67890)
    train_and_eval(3)
    eval_model(3)

    // ─── Results ───
    print("\n═══════════════════════════════════════════════════════════════\n")
    print("  RESULTS: Associativity Probe\n")
    print("═══════════════════════════════════════════════════════════════\n\n")
    print("  Model     Overall   Assoc-triples    Non-assoc-triples  Delta\n")
    print("  ───────   ───────   ─────────────    ─────────────────  ─────\n")

    // O-SSM
    EVAL_OVERALL = ossm_overall
    EVAL_ASSOC_CORRECT = ossm_assoc_c; EVAL_ASSOC_TOTAL = ossm_assoc_t
    EVAL_NONASSOC_CORRECT = ossm_na_c; EVAL_NONASSOC_TOTAL = ossm_na_t
    print("  O-SSM    "); print_eval_line()

    EVAL_OVERALL = hssm_overall
    EVAL_ASSOC_CORRECT = hssm_assoc_c; EVAL_ASSOC_TOTAL = hssm_assoc_t
    EVAL_NONASSOC_CORRECT = hssm_na_c; EVAL_NONASSOC_TOTAL = hssm_na_t
    print("  H-SSM    "); print_eval_line()

    EVAL_OVERALL = naive_overall
    EVAL_ASSOC_CORRECT = naive_assoc_c; EVAL_ASSOC_TOTAL = naive_assoc_t
    EVAL_NONASSOC_CORRECT = naive_na_c; EVAL_NONASSOC_TOTAL = naive_na_t
    print("  Naive    "); print_eval_line()

    // S4-DIAG is still in globals from last eval
    print("  S4-DIAG  "); print_eval_line()

    print("\n  Random baseline: 6.25% (1/16 classes)\n")

    // Verdict
    var ossm_na_pct = 0.0
    if ossm_na_t > 0 { ossm_na_pct = (ossm_na_c as f64) / (ossm_na_t as f64) * 100.0 }
    var hssm_na_pct = 0.0
    if hssm_na_t > 0 { hssm_na_pct = (hssm_na_c as f64) / (hssm_na_t as f64) * 100.0 }
    let na_gap = ossm_na_pct - hssm_na_pct

    print("\n  ═══ VERDICT ═══\n")
    print("  O-SSM non-assoc accuracy: "); print(ossm_na_pct); print("%\n")
    print("  H-SSM non-assoc accuracy: "); print(hssm_na_pct); print("%\n")
    print("  Gap (O-SSM - H-SSM): "); if na_gap >= 0.0 { print("+") }; print(na_gap); print("pp\n")

    if na_gap > 3.0 {
        print("\n  ✓ O-SSM separates on non-associative triples.\n")
        print("  → Non-associativity IS the mechanism when the task requires it.\n")
    } else {
        if na_gap > 0.0 - 3.0 {
            print("\n  ~ No significant separation on non-associative triples.\n")
            print("  → Non-associativity doesn't help even when the ground truth is non-associative.\n")
        } else {
            print("\n  ✗ H-SSM outperforms on non-associative triples.\n")
            print("  → Non-associativity hurts even on intrinsically non-associative tasks.\n")
        }
    }

    println("ALL PASS")
    0
}
