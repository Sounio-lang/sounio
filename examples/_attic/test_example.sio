use test::*

// ==================== Basic Tests ====================

fn test_arithmetic() {
    assert_eq(2 + 2, 4)
    assert_eq(10 - 3, 7)
    assert_eq(6 * 7, 42)
}

fn test_boolean_logic() {
    assert_true(true)
    assert_false(false)
    assert_true(true && true)
    assert_false(true && false)
    assert_true(true || false)
}

fn test_comparison() {
    assert_ne(1, 2)
    assert_eq(5, 5)
}

// ==================== Floating Point Tests ====================

fn test_float_exact() {
    assert_eq(1.0 + 1.0, 2.0)
}

fn test_float_approx() {
    // 0.1 + 0.2 is not exactly 0.3 due to floating point representation
    let result = 0.1 + 0.2
    assert_approx(result, 0.3)
}

fn test_float_epsilon() {
    assert_approx_eps(1.0, 1.0001, 0.001)
}

fn test_in_range() {
    assert_in_range(5, 1, 10)
    assert_in_range(1, 1, 10)  // inclusive
    assert_in_range(10, 1, 10) // inclusive
}

// ==================== Option/Result Tests ====================

fn test_option_some() {
    let opt: Option<i32> = Some(42)
    assert_some(opt)
    assert_some_eq(opt, 42)
}

fn test_option_none() {
    let opt: Option<i32> = None
    assert_none(opt)
}

fn test_result_ok() {
    let res: Result<i32, string> = Ok(42)
    assert_ok(res)
    assert_ok_eq(res, 42)
}

fn test_result_err() {
    let res: Result<i32, string> = Err("error")
    assert_err(res)
}

// ==================== Collection Tests ====================

fn test_vec_operations() {
    let v = vec![1, 2, 3, 4, 5]

    assert_not_empty(&v)
    assert_len(&v, 5)
    assert_contains(&v, &3)
    assert_not_contains(&v, &10)
}

fn test_empty_vec() {
    let v: Vec<i32> = Vec.new()
    assert_empty(&v)
}

fn test_slice_equality() {
    let a = [1, 2, 3]
    let b = [1, 2, 3]
    assert_eq_elements(&a, &b)
}

// ==================== String Tests ====================

fn test_string_contains() {
    let s = "Hello, World!"
    assert_str_contains(&s, "World")
    assert_str_contains(&s, "Hello")
}

fn test_string_prefix_suffix() {
    let s = "Hello, World!"
    assert_starts_with(&s, "Hello")
    assert_ends_with(&s, "World!")
}

