//@ run-pass
//@ expect-stdout: EPISTEMIC ADAPTIVE PASSED
// Gen 17 D4: R15 Bayesian Runtime Update
//
// Demonstrates runtime confidence degradation via the R15 side table.
// Compile with: gen17.elf epistemic_adaptive.sio /tmp/a.elf --r15-monitor
// Run:          /tmp/a.elf
//
// The R15 side table is initialized to 1000 at startup (_start).
// update_conf(gate_id, new_conf) writes to the side table.
// read_conf(gate_id) reads from the side table.
// When conf < 950, the CMP/JGE/UD2 check traps on next call through that gate.
//
// This example validates: initial=1000 → update to 900 → reads back 900.
// (It does NOT trigger the UD2 trap, as this is a pass test.)

fn abs_i64(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    return x
}

fn main() -> i32 with IO, Mut {
    println("=== Gen 17 D4: R15 Epistemic Runtime Monitor ===")
    println("")

    // -----------------------------------------------------------------------
    // Gate 0: initially confidence = 1000 (set by _start trampoline)
    // -----------------------------------------------------------------------
    let initial = read_conf(0)
    print("Gate 0 initial confidence: ")
    print_int(initial)
    println("")

    // -----------------------------------------------------------------------
    // Degrade gate 0 below threshold — simulates a sensor going stale
    // -----------------------------------------------------------------------
    update_conf(0, 900)
    let after_degrade = read_conf(0)
    print("Gate 0 after degradation:  ")
    print_int(after_degrade)
    println("")

    // -----------------------------------------------------------------------
    // Restore gate 0 to full confidence (sensor refreshed)
    // -----------------------------------------------------------------------
    update_conf(0, 1000)
    let after_restore = read_conf(0)
    print("Gate 0 after restore:      ")
    print_int(after_restore)
    println("")

    // -----------------------------------------------------------------------
    // Test gate 1: write specific epistemic confidence (MEAS_CONF=970 = asserted)
    // -----------------------------------------------------------------------
    update_conf(1, 970)
    let gate1_conf = read_conf(1)
    print("Gate 1 asserted confidence: ")
    print_int(gate1_conf)
    println("")

    // -----------------------------------------------------------------------
    // Validation
    // -----------------------------------------------------------------------
    println("")
    if initial != 1000 {
        print("EPISTEMIC ADAPTIVE FAILED: initial conf=")
        print_int(initial)
        println(" (expected 1000)")
        return 1
    }
    if after_degrade != 900 {
        print("EPISTEMIC ADAPTIVE FAILED: degraded conf=")
        print_int(after_degrade)
        println(" (expected 900)")
        return 1
    }
    if after_restore != 1000 {
        print("EPISTEMIC ADAPTIVE FAILED: restored conf=")
        print_int(after_restore)
        println(" (expected 1000)")
        return 1
    }
    if gate1_conf != 970 {
        print("EPISTEMIC ADAPTIVE FAILED: gate1 conf=")
        print_int(gate1_conf)
        println(" (expected 970)")
        return 1
    }

    println("Epistemic runtime monitor validated:")
    println("  read_conf(0) = 1000 at startup (PLATINUM)")
    println("  update_conf(0, 900) degrades below threshold (900 < 950)")
    println("  update_conf(0, 1000) restores to PLATINUM")
    println("  update_conf(1, 970) = GOLD (literature-quality, MEAS_CONF=970)")
    println("")
    println("EPISTEMIC ADAPTIVE PASSED")
    return 0
}
