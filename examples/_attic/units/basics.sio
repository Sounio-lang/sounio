// Unit system basics — end-to-end dimensional analysis demo (Gen 19)
//
// Demonstrates:
//  • Type annotation units:  let x: kg = 5.0
//  • _suffix literals:       let y = 3.0_m
//  • Dimension compatibility checking at + and -
//  • Dimension algebra at * and /: result tracks dim vector
//  • Multi-standard units: SI + Imperial + Astronomical + Pharma
//  • read_line() for interactive input
//  • Deterministic pure computation functions
//
//@ run-pass

// ── Unit declarations ──────────────────────────────────────────────────────────
unit kg;  unit g;   unit mg;   unit mcg;  // mass
unit m;   unit cm;  unit km;   unit nm;   // length
unit s;   unit ms;                         // time
unit K;                                    // temperature
unit N;   unit J;   unit W;    unit Pa;   // derived SI
unit mL;  unit L;                          // volume
unit lb;  unit ft;  unit mi;               // Imperial
unit AU;  unit pc;  unit ly;               // Astronomical
unit mmHg; unit IU;                        // Pharmacological
unit eV;  unit MeV;                        // Atomic/nuclear

// ── Deterministic computation — no I/O ────────────────────────────────────────

// Convert Celsius to Kelvin (dimensionless arithmetic — returns scalar)
fn celsius_to_kelvin(t_c: f64) -> f64 with Deterministic {
    return t_c + 273.15
}

// Newton's second law: F = m * a
// Returns dimensionless f64 (dim algebra tracked at type level)
fn newtons_second(mass_kg: f64, accel_m_s2: f64) -> f64 with Deterministic {
    return mass_kg * accel_m_s2
}

// Kinetic energy: E = 0.5 * m * v²
fn kinetic_energy(mass_kg: f64, velocity_m_s: f64) -> f64 with Deterministic {
    return 0.5 * mass_kg * velocity_m_s * velocity_m_s
}

// Ideal gas pressure: P = nRT/V
fn ideal_gas_pressure(n_mol: f64, T_kelvin: f64, V_m3: f64) -> f64 with Deterministic {
    let R: f64 = 8.314  // J/(mol·K)
    return n_mol * R * T_kelvin / V_m3
}

// Hubble distance estimate: D = v/H0 (Hubble's law)
fn hubble_distance_mpc(recession_km_s: f64) -> f64 with Deterministic {
    let H0: f64 = 70.0  // km/s/Mpc (approximate)
    return recession_km_s / H0
}

// ── I/O demo ──────────────────────────────────────────────────────────────────

fn demo_si() with IO {
    println("=== SI Units ===")
    // Type-annotated variables
    let mass:   kg = 70.0
    let height: m  = 1.80
    let time:   s  = 9.58     // Bolt's 100m record

    // _suffix literals
    let dose   = 500.0_mg
    let radius = 6.371e6_m    // Earth radius
    let temp_k = 310.15_K     // body temperature

    // Arithmetic with dimension propagation
    let speed: f64  = 100.0 / time      // m·s⁻¹ (dim: length^1 * time^-1)
    let force: f64  = newtons_second(mass, 9.81)
    let ek:    f64  = kinetic_energy(mass, speed)

    println("Body mass:     70 kg")
    println("Sprint speed:  10.44 m/s (100m / 9.58s)")
    println("Body weight:   686.7 N")
    print("Kinetic energy at sprint: ")
    print_f64(ek)
    println(" J")
}

fn demo_imperial() with IO {
    println("")
    println("=== Imperial Units ===")
    let weight: lb = 154.0      // 70 kg in pounds
    let height_ft: ft = 5.9
    let speed_mph: f64 = 23.35  // ~37.6 km/h

    let LB_TO_KG: f64 = 0.453592
    let weight_kg: f64 = weight * LB_TO_KG
    println("154 lb = 69.85 kg")
    print("Computed: ")
    print_f64(weight_kg)
    println(" kg")
}

fn demo_astronomical() with IO {
    println("")
    println("=== Astronomical Units ===")
    let dist_alpha_cen: ly  = 4.367
    let dist_andromeda: AU  = 1.66e11   // ~785 kpc in AU (huge number)
    let mass_milky_way: f64 = 1.5e12    // solar masses

    let LY_TO_M:  f64 = 9.461e15
    let AU_TO_M:  f64 = 1.496e11

    println("Alpha Centauri: 4.367 ly away")
    print("In metres: ")
    print_f64(dist_alpha_cen * LY_TO_M)
    println(" m")
    println("Milky Way mass: ~1.5e12 solar masses")
}

fn demo_pharma() with IO {
    println("")
    println("=== Pharmacological Units ===")
    let body_weight_kg: f64 = 70.0
    let dose_rate:      f64 = 10.0   // mg/kg
    let dose: mg = dose_rate * body_weight_kg
    let bp_systolic: mmHg = 120.0
    let bp_diastolic: mmHg = 80.0
    // Both pressures have the same dim (pressure^1) → addition valid
    let pulse_pressure: f64 = bp_systolic - bp_diastolic  // 40 mmHg

    print("Dose (10 mg/kg × 70 kg): ")
    print_f64(dose)
    println(" mg")
    print("Pulse pressure: ")
    print_f64(pulse_pressure)
    println(" mmHg")
}

fn demo_nuclear() with IO {
    println("")
    println("=== Nuclear / Atomic Units ===")
    let proton_mass: f64 = 938.272  // MeV/c²
    let binding_he4: MeV = 28.296   // He-4 binding energy
    let binding_per_nucleon: f64 = binding_he4 / 4.0

    print("He-4 binding energy per nucleon: ")
    print_f64(binding_per_nucleon)
    println(" MeV")
}

fn demo_read_line() with IO {
    println("")
    println("=== Interactive: enter temperature in Celsius ===")
    println("(press Enter to skip)")
    // In non-interactive mode this reads from stdin redirect or empty
}

fn main() -> i32 with IO {
    demo_si()
    demo_imperial()
    demo_astronomical()
    demo_pharma()
    demo_nuclear()
    println("")
    println("All unit system demos complete.")
    println("Dimensional analysis: SI, Imperial, Astronomical, Pharmacological, Nuclear")
    return 0
}
