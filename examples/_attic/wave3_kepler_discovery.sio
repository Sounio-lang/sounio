struct Sample {
    value: i64
}

fn scale(item: Sample, factor: i64) -> Sample {
    return Sample { value: item.value * factor }
}

fn checksum(values: [i64]) -> i64 {
    var sum: i64 = 0
    for v in values {
        sum = sum + v
    }
    return sum
}

fn main() with IO {
    let seed = Sample { value: 3 }
    let scaled = scale(seed, 7)
    let data: [i64] = [scaled.value, 2, 5, 8]
    let total = checksum(data)
    println("example: wave3_kepler_discovery")
    println(total)
}

