// Demo for stdlib/fmri/preprocess.sio
//
// This file demonstrates usage of the fmri::preprocess module.
// Module source: stdlib/fmri/preprocess.sio

// ============================================================================

fn test_fd_calc() -> bool {
    // Test FD calculation logic
    let dx = 0.5
    let dy = 0.3
    let dz = 0.2
    let fd = dx + dy + dz
    abs_f64(fd - 1.0) < 0.01
}

fn test_demean() -> bool {
    let val1 = 10.0
    let val2 = 20.0
    let mean = (val1 + val2) / 2.0
    abs_f64(mean - 15.0) < 0.01
}

fn main() -> i32 {
    print("Testing fmri::preprocess module...\n")

    if !test_fd_calc() {
        print("FAIL: fd_calc\n")
        return 1
    }
    print("PASS: fd_calc\n")

    if !test_demean() {
        print("FAIL: demean\n")
        return 2
    }
    print("PASS: demean\n")

    print("All fmri::preprocess tests PASSED\n")
    0
}
