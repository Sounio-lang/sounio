// ─── Analysis: primary + per-confounder adjustment ───────────────────────────

fn main() -> i32 with IO, Mut, Div, Panic {
    println("═══════════════════════════════════════════════════════")
    println("  PPCR-grade cohort-confounding test for η²=0.421 finding")
    println("  Pre-specified 4 demographic confounders")
    println("  Filter: temporal ≥ 5 (sufficient per-triple precision)")
    println("═══════════════════════════════════════════════════════")
    println("")

    let N_ROWS: i64 = 35
    let TEMP_MIN: i64 = 5

    // Storage for filtered valid rows.
    var v_m:   [i64; 40] = [0; 40]
    var v_y:   [f64; 40] = [0.0; 40]    // |asymmetry|
    var v_age: [f64; 40] = [0.0; 40]
    var v_fem: [f64; 40] = [0.0; 40]
    var v_hcp: [f64; 40] = [0.0; 40]
    var v_us:  [f64; 40] = [0.0; 40]
    var N: i64 = 0

    var i: i64 = 0
    while i < N_ROWS {
        let a: i64 = row_a(i)
        let b: i64 = row_b(i)
        let c: i64 = row_c(i)
        let m: i64 = assoc_dir(a, b, c)
        let t: i64 = row_temporal(i)
        let age: f64 = row_meanage(i)
        if m >= 0 {
            if t >= TEMP_MIN {
                if age > 0.0 {
                    v_m[N]   = m
                    v_y[N]   = row_asym(i)
                    v_age[N] = age
                    v_fem[N] = row_fracfemale(i)
                    v_hcp[N] = row_frachcp(i)
                    v_us[N]  = row_fracus(i)
                    N = N + 1
                }
            }
        }
        i = i + 1
    }
    print("Valid rows (non-assoc, temporal≥5, age_valid): "); print_int(N); println("")
    println("")

    // ─── eta²(y | m) helper ─────────────────────────────────────────────────
    // Accepts an arbitrary [f64; 40] values array; computes between/total SS.
    var eta_work: [f64; 40] = [0.0; 40]   // scratch

    // Primary η²(y | m)
    let eta_primary: f64 = eta_sq(v_y, v_m, N)
    print("PRIMARY:  η²(|asymmetry| | m) = "); print(eta_primary); println("")
    println("")

    // For each confounder: η²(C|m), |ρ(C,y)|
    println("=== Confounder screen (pre-specified) ===")
    println("  Var   η²(C|m)   ρ(C,y)   Qualifies?  (η²>0.10 AND |ρ|>0.15)")
    println("  ---   -------   ------   ----------")

    let eta_age: f64 = eta_sq(v_age, v_m, N)
    let r_age:   f64 = pearson(v_age, v_y, N)
    let q_age:   bool = qualify(eta_age, r_age)
    print_conf("age ", eta_age, r_age, q_age)

    let eta_fem: f64 = eta_sq(v_fem, v_m, N)
    let r_fem:   f64 = pearson(v_fem, v_y, N)
    let q_fem:   bool = qualify(eta_fem, r_fem)
    print_conf("fem ", eta_fem, r_fem, q_fem)

    let eta_hcp: f64 = eta_sq(v_hcp, v_m, N)
    let r_hcp:   f64 = pearson(v_hcp, v_y, N)
    let q_hcp:   bool = qualify(eta_hcp, r_hcp)
    print_conf("hcp ", eta_hcp, r_hcp, q_hcp)

    let eta_us:  f64 = eta_sq(v_us, v_m, N)
    let r_us:    f64 = pearson(v_us, v_y, N)
    let q_us:    bool = qualify(eta_us, r_us)
    print_conf("us  ", eta_us, r_us, q_us)

    println("")

    // Residualize y on each qualifying confounder separately, compute η² on residual.
    println("=== Single-confounder adjustment (partial η²) ===")
    println("  Adj var  partial η²(residual | m)  Δ from primary")
    println("  -------  ------------------------  --------------")
    var pe_age: f64 = eta_primary
    var pe_fem: f64 = eta_primary
    var pe_hcp: f64 = eta_primary
    var pe_us:  f64 = eta_primary
    if q_age {
        residualize_to_global(v_y, v_age, N)
        pe_age = eta_sq(RES_OUT, v_m, N)
    }
    if q_fem {
        residualize_to_global(v_y, v_fem, N)
        pe_fem = eta_sq(RES_OUT, v_m, N)
    }
    if q_hcp {
        residualize_to_global(v_y, v_hcp, N)
        pe_hcp = eta_sq(RES_OUT, v_m, N)
    }
    if q_us {
        residualize_to_global(v_y, v_us, N)
        pe_us = eta_sq(RES_OUT, v_m, N)
    }
    print_partial("age ", pe_age, eta_primary, q_age)
    print_partial("fem ", pe_fem, eta_primary, q_fem)
    print_partial("hcp ", pe_hcp, eta_primary, q_hcp)
    print_partial("us  ", pe_us,  eta_primary, q_us)
    println("")

    // Sequential multivariate adjustment via V_RES global (Sounio passes arrays
    // by value, so we use globals to persist results across residualize calls).
    var k1: i64 = 0
    while k1 < N { V_RES[k1] = v_y[k1]; k1 = k1 + 1 }
    if q_age {
        residualize_to_global(V_RES, v_age, N)
        var u: i64 = 0
        while u < N { V_RES[u] = RES_OUT[u]; u = u + 1 }
    }
    if q_fem {
        residualize_to_global(V_RES, v_fem, N)
        var u: i64 = 0
        while u < N { V_RES[u] = RES_OUT[u]; u = u + 1 }
    }
    if q_hcp {
        residualize_to_global(V_RES, v_hcp, N)
        var u: i64 = 0
        while u < N { V_RES[u] = RES_OUT[u]; u = u + 1 }
    }
    if q_us {
        residualize_to_global(V_RES, v_us, N)
        var u: i64 = 0
        while u < N { V_RES[u] = RES_OUT[u]; u = u + 1 }
    }
    let eta_multi: f64 = eta_sq(V_RES, v_m, N)

    println("=== Multivariate sequential adjustment ===")
    print("  Simultaneous adjustment for qualifying confounders: η² = ")
    print(eta_multi); println("")
    print("  Δ from primary = "); print(eta_multi - eta_primary); println("")
    println("")

    // Pre-specified interpretation
    println("───────────────────────────────────────────────────────")
    print("  Primary η² = "); print(eta_primary); println("")
    print("  Adjusted (multivariate) η² = "); print(eta_multi); println("")
    if eta_multi >= 0.30 {
        println("  VERDICT: ROBUST — demographic confounding does not explain the finding")
    } else {
        if eta_multi >= 0.15 {
            println("  VERDICT: PARTIALLY ATTRIBUTABLE — confounding explains some but not all")
        } else {
            println("  VERDICT: ACCOUNTED FOR — finding collapses under demographic adjustment")
        }
    }
    println("───────────────────────────────────────────────────────")
    println("")

    // Assertions
    var passed: i32 = 0
    var failed: i32 = 0

    if N >= 8 {
        print("T1 PASS: N="); print_int(N); println(" valid rows")
        passed = passed + 1
    } else {
        print("T1 FAIL: N="); print_int(N); println("")
        failed = failed + 1
    }

    if eta_primary > 0.25 {
        print("T2 PASS: primary η²="); print(eta_primary); println(" > 0.25 (reproduces prior)")
        passed = passed + 1
    } else {
        print("T2 FAIL: primary η²="); print(eta_primary); println("")
        failed = failed + 1
    }

    // T3 REPORT: pre-specified verdict outcome (any of 3 is a valid result)
    print("T3 REPORT: multivariate-adjusted η² = "); print(eta_multi); println("")
    passed = passed + 1

    // T4 REPORT: how many confounders qualified
    var nq: i64 = 0
    if q_age { nq = nq + 1 }
    if q_fem { nq = nq + 1 }
    if q_hcp { nq = nq + 1 }
    if q_us  { nq = nq + 1 }
    print("T4 REPORT: "); print_int(nq); println("/4 confounders qualified by pre-spec threshold")
    passed = passed + 1

    // T5 — sanity: residuals variance should be ≤ original y variance
    let var_y: f64 = variance(v_y, N)
    let var_res: f64 = variance(V_RES, N)
    if var_res <= var_y + 0.01 {
        print("T5 PASS: var(residuals)="); print(var_res)
        print(" ≤ var(y)=");                print(var_y); println("")
        passed = passed + 1
    } else {
        println("T5 FAIL: residual variance exceeds original")
        failed = failed + 1
    }

    println("")
    print("Passed: "); print_int(passed); println("")
    print("Failed: "); print_int(failed); println("")
    if failed == 0 { println("ALL PASS") } else { println("SOME TESTS FAILED") }
    failed
}

// ─── Helpers ──────────────────────────────────────────────────────────────────

fn variance(vals: [f64; 40], n: i64) -> f64 with Div {
    var s: f64 = 0.0
    var i: i64 = 0
    while i < n { s = s + vals[i]; i = i + 1 }
    let mean: f64 = s / (n as f64)
    var ss: f64 = 0.0
    i = 0
    while i < n {
        let d: f64 = vals[i] - mean
        ss = ss + d * d
        i = i + 1
    }
    ss / (n as f64)
}

fn eta_sq(vals: [f64; 40], groups: [i64; 40], n: i64) -> f64 with Mut, Div {
    // Total mean
    var s: f64 = 0.0
    var i: i64 = 0
    while i < n { s = s + vals[i]; i = i + 1 }
    let mean: f64 = s / (n as f64)
    // Total SS
    var ss_tot: f64 = 0.0
    i = 0
    while i < n {
        let d: f64 = vals[i] - mean
        ss_tot = ss_tot + d * d
        i = i + 1
    }
    if ss_tot < 0.00001 { return 0.0 }
    // Group SS: Σ n_g (mean_g − mean)²
    var ss_bet: f64 = 0.0
    var g: i64 = 0
    while g < 8 {
        var s_g: f64 = 0.0
        var n_g: i64 = 0
        var j: i64 = 0
        while j < n {
            if groups[j] == g {
                s_g = s_g + vals[j]
                n_g = n_g + 1
            }
            j = j + 1
        }
        if n_g > 0 {
            let mg: f64 = s_g / (n_g as f64)
            let d:  f64 = mg - mean
            ss_bet = ss_bet + (n_g as f64) * d * d
        }
        g = g + 1
    }
    ss_bet / ss_tot
}

fn pearson(x: [f64; 40], y: [f64; 40], n: i64) -> f64 with Mut, Div, Panic {
    var sx: f64 = 0.0
    var sy: f64 = 0.0
    var i: i64 = 0
    while i < n {
        sx = sx + x[i]; sy = sy + y[i]; i = i + 1
    }
    let mx: f64 = sx / (n as f64)
    let my: f64 = sy / (n as f64)
    var num: f64 = 0.0
    var sxx: f64 = 0.0
    var syy: f64 = 0.0
    i = 0
    while i < n {
        let dx: f64 = x[i] - mx
        let dy: f64 = y[i] - my
        num = num + dx * dy
        sxx = sxx + dx * dx
        syy = syy + dy * dy
        i = i + 1
    }
    let denom: f64 = sqrt_s(sxx * syy)
    if denom < 0.00001 { return 0.0 }
    num / denom
}

fn qualify(eta: f64, rho: f64) -> bool {
    let e_ok: bool = eta > 0.10
    let r_ok: bool = abs_s(rho) > 0.15
    if e_ok { if r_ok { true } else { false } } else { false }
}

fn print_conf(name: str, eta: f64, rho: f64, q: bool) with IO {
    print("  "); print(name); print("    ")
    print(eta); print("    ")
    print(rho); print("    ")
    if q { print("YES") } else { print("no ") }
    println("")
}

fn print_partial(name: str, partial: f64, primary: f64, q: bool) with IO {
    print("  "); print(name); print("    ")
    print(partial); print("                  ")
    print(partial - primary)
    if q == false { print("  (n/a — did not qualify)") }
    println("")
}

// Residualize writes into global RES_OUT — Sounio passes arrays by value, so
// function-scoped `out` parameters don't propagate back to the caller.
var RES_OUT: [f64; 40] = [0.0; 40]
var V_RES:   [f64; 40] = [0.0; 40]

fn residualize_to_global(y: [f64; 40], x: [f64; 40], n: i64)
    with Mut, Div, Panic {
    var sx: f64 = 0.0
    var sy: f64 = 0.0
    var i: i64 = 0
    while i < n { sx = sx + x[i]; sy = sy + y[i]; i = i + 1 }
    let mx: f64 = sx / (n as f64)
    let my: f64 = sy / (n as f64)
    var num: f64 = 0.0
    var den: f64 = 0.0
    i = 0
    while i < n {
        let dx: f64 = x[i] - mx
        let dy: f64 = y[i] - my
        num = num + dx * dy
        den = den + dx * dx
        i = i + 1
    }
    var slope: f64 = 0.0
    if den > 0.0000001 { slope = num / den }
    let inter: f64 = my - slope * mx
    i = 0
    while i < n {
        RES_OUT[i] = y[i] - (inter + slope * x[i])
        i = i + 1
    }
}
