// Demo for stdlib/darwin_pbpk/core/rodgers_rowland.sio
//
// This file demonstrates usage of the Rodgers-Rowland Kp prediction model
// for calculating tissue partition coefficients based on drug physicochemistry.
// Module source: stdlib/darwin_pbpk/core/rodgers_rowland.sio

use darwin_pbpk::core::rodgers_rowland::{DrugProperties, predict_all_kp, predict_vdss}

// ============================================================================
// EXAMPLE DRUGS
// ============================================================================

// Example 1: Metformin (hydrophilic base)
// Metformin is a hydrophilic biguanide with minimal protein binding
// Expected behavior: Limited tissue distribution (Kp < 2 for most tissues)
// except kidney and liver due to active transport
fn example_metformin() {
    // Metformin: hydrophilic base
    let metformin = DrugProperties::new(
        "Metformin",
        -1.43,  // logP (hydrophilic)
        12.4,   // pKa (strong base)
        true,   // is_base
        1.0,    // fu_plasma (not protein bound)
        1.08    // blood:plasma ratio
    )

    let kps = predict_all_kp(&metformin)
    let vdss = predict_vdss(&metformin, 70.0) // 70 kg patient

    println("Metformin Kp predictions:")
    println("  Liver Kp: ")
    println(kps.kp_liver)
    println("  Kidney Kp: ")
    println(kps.kp_kidney)
    println("  Muscle Kp: ")
    println(kps.kp_muscle)
    println("  Vdss: ")
    println(vdss)
    println(" L")
}

// Example 2: Propranolol (lipophilic base)
// Propranolol is a lipophilic beta-blocker with high protein binding
// Expected behavior: Wide tissue distribution (Kp > 1 for most tissues)
// especially in lipid-rich tissues like adipose and brain
fn example_propranolol() {
    // Propranolol: lipophilic base
    let propranolol = DrugProperties::new(
        "Propranolol",
        3.48,   // logP (lipophilic)
        9.42,   // pKa (weak base)
        true,   // is_base
        0.07,   // fu_plasma (highly protein bound)
        0.89    // blood:plasma ratio
    )

    let kps = predict_all_kp(&propranolol)
    let vdss = predict_vdss(&propranolol, 70.0)

    println("Propranolol Kp predictions:")
    println("  Liver Kp: ")
    println(kps.kp_liver)
    println("  Brain Kp: ")
    println(kps.kp_brain)
    println("  Adipose Kp: ")
    println(kps.kp_adipose)
    println("  Vdss: ")
    println(vdss)
    println(" L")
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 {
    println("Rodgers-Rowland PBPK Partition Coefficient Module")
    println("==================================================")
    println("")

    example_metformin()
    println("")
    example_propranolol()
    println("")
    println("Analysis complete!")

    0
}
