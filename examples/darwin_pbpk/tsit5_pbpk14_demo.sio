//@ run-pass
//@ expect-stdout: TSIT5 PBPK14 DEMO OK

// Demo for stdlib/darwin_pbpk/tsit5_pbpk14.sio: a 100 mg IV bolus into the
// 14-compartment PBPK model, integrated for 8 h with the adaptive Tsit5
// solver, followed by a mass-balance readout.

use darwin_pbpk::tsit5_pbpk14::*

fn main() -> i32 with IO, Mut, Div, Panic {
    println("=== Sounio 14-Compartment PBPK Solver ===")
    println("")

    let pk_prm = default_pbpk_params()
    let ode_cfg = default_ode_config()

    let dose = 100.0
    let t_end = 8.0

    println("Simulation: 100 mg IV bolus, 8 h")
    print("  CL_hepatic = "); print_f64(pk_prm.cl_hepatic); println(" L/h")
    print("  CL_renal   = "); print_f64(pk_prm.cl_renal);   println(" L/h")
    println("")

    let sol = solve_pbpk14(dose, t_end, pk_prm, ode_cfg)

    println("Solver:")
    print("  success        = "); if sol.success { println("true") } else { println("false") }
    print("  steps          = "); print_int(sol.nsteps);  println("")
    print("  function evals = "); print_int(sol.nfeval);  println("")
    print("  rejected steps = "); print_int(sol.nreject); println("")
    print("  t_final        = "); print_f64(sol.t_final); println(" h")
    println("")

    println("Final concentrations (mg/L):")
    print("  blood   = "); print_f64(sol.state_final.blood);   println("")
    print("  liver   = "); print_f64(sol.state_final.liver);   println("")
    print("  kidney  = "); print_f64(sol.state_final.kidney);  println("")
    print("  brain   = "); print_f64(sol.state_final.brain);   println("")
    print("  muscle  = "); print_f64(sol.state_final.muscle);  println("")
    print("  adipose = "); print_f64(sol.state_final.adipose); println("")
    println("")

    // Mass balance: the drug left in the body after 8 h, against the dose.
    let final_mass = pbpk_state_total_mass(sol.state_final, pk_prm)
    let mass_eliminated = dose - final_mass
    let pct_eliminated = 100.0 * mass_eliminated / dose
    println("Mass balance:")
    print("  dose         = "); print_f64(dose);            println(" mg")
    print("  in body      = "); print_f64(final_mass);      println(" mg")
    print("  eliminated   = "); print_f64(mass_eliminated); println(" mg")
    print("  % eliminated = "); print_f64(pct_eliminated);  println("")
    println("")

    // Physical bounds only, not a fitted expectation: with non-zero
    // clearance some drug must be eliminated, and never more than the dose.
    if sol.success && sol.t_final >= t_end && pct_eliminated > 0.0 && pct_eliminated < 100.0 {
        println("TSIT5 PBPK14 DEMO OK")
        return 0
    }
    println("TSIT5 PBPK14 DEMO FAILED")
    1
}
