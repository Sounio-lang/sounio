// Sounio Example: Run Sedenion Benchmark with PAC Learning
//
// Simple runner for the sedenion neural network benchmark
// that demonstrates parameter efficiency and PAC learning bounds

use snn::benchmark

fn main() with IO, Prob {
    print("Running sedenion benchmark with PAC learning...")

    let config = benchmark::default_hsi_config()
    let result = benchmark::run_kill_switch_benchmark(config)

    let output = benchmark::format_result(result)
    print(output)

    if result.kill_switch_passed {
        print("✓ BENCHMARK PASSED")
    } else {
        print("✗ BENCHMARK FAILED")
    }
}
