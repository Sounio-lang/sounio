//@ check-only
// Eixo B: compare GUM (Jacobian inside CRN RHS) vs Monte Carlo endpoint for species A.

use chemistry::kinetics
use chemistry::stoichiometry

fn main() -> i32 with IO, Mut, Div, Panic {
    let _stoi = stoichiometry::moles_from_mass(18.0, 18.0)
    let init: [f64; 4] = [1.0, 0.0, 0.0, 0.0]
    let inits: [f64; 4] = [0.01, 0.0, 0.0, 0.0]
    let ks: [f64; 3] = [0.1, 0.05, 0.2]
    let us: [f64; 3] = [0.001, 0.0005, 0.002]
    let steps: i64 = 20

    let (gum_a, gum_u, mc_a, mc_u) = kinetics::compare_gum_mc_crn_epistemic(&init, &inits, &ks, &us, 0.1, steps, 100, 42)
    let ratio = kinetics::gum_mc_ratio_a(&init, &inits, &ks, &us, 0.1, steps, 100, 42)

    println("CRN epistemic A: GUM {} +/- {}", gum_a, gum_u)
    println("CRN epistemic A: MC  {} +/- {}", mc_a, mc_u)
    println("SD ratio GUM/MC: {}", ratio)
    println("Witness ok: {}", kinetics::test_gum_mc_agreement_witness())
    return 0
}