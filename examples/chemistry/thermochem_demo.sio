//@ check-only
// Thermochemistry: Hess, ΔG = ΔH − TΔS, Kirchhoff, van't Hoff link to equilibrium K(T).

use chemistry::thermochem
use chemistry::equilibrium

fn main() -> i32 with IO, Mut, Div, Panic {
    let (dh, udh) = thermochem::water_formation_enthalpy()
    let (ds, uds) = thermochem::water_formation_entropy()
    let (dg, udg) = thermochem::delta_g_from_h_s(dh, udh, ds, uds, 298.15, 0.5)
    let (k298, uk) = equilibrium::k_from_delta_g(dg, udg, 298.15, 0.5)

    println("H2O formation ΔH = {} +/- {} J/mol", dh, udh)
    println("ΔG(298 K) = {} +/- {} J/mol", dg, udg)
    println("K(298 K) from ΔG = {} +/- {}", k298, uk)

    let (ln_ratio, _) = thermochem::vanthoff_ln_k_ratio(dh, udh, 298.15, 350.0, 0.5, 0.5)
    println("van't Hoff ln(K350/K298) = {}", ln_ratio)
    return 0
}