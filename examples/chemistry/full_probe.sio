// examples/chemistry/full_probe.sio
//
// RECONSTRUCTION (2026-09-01) -- this is NOT the original artefact.
// The preprint cites examples/chemistry/full_probe.sio. No blob under that
// name exists in any tree reachable from any ref of this repository (see
// benchmarks/chemistry/RESULTS.md section 4). Written from the described
// protocol, not recovered.
//
// PURPOSE: the Sounio column of the FULL-mechanism parity table. Until this
// probe, RESULTS.md section 6 could only report replica-vs-Cantera for the
// 53-species/325-reaction mechanism, because no Sounio full-mechanism
// trajectory had been run at those checkpoints.
//
// Protocol (identical to gri30_full_python_replica.py and
// gri30_full_cantera_parity.py):
//   2% H2 / 1% O2 / 97% N2, 1 atm, T = 1500 K, isothermal, constant volume,
//   additive H-atom seed 1e-11 mol/cm3, RK4 dt = 2e-9.
//   Checkpoints t = 4e-6 s (2000 steps) and t = 2e-5 s (10000 steps).
//
// dt NOTE: the full mechanism carries NNH <=> N2 + H at k ~ 3.3e8 /s at
// 1500 K, so the H/O module's dt = 1e-8 is outside the RK4 stability limit
// (k*dt > 4 against a limit of ~2.785) and the trajectory diverges within
// ~20 steps. dt = 2e-9 gives k*dt ~ 0.84.
//
// Species indices follow gri30_full_mechanism.json order:
//   0 H2, 1 H, 2 O, 3 O2, 4 OH, 5 H2O, 6 HO2, 7 H2O2, 34 NNH, 47 N2
// NNH is reported because it is the delta-n = +1 species whose
// quasi-equilibrium population is the one place a standard-state error
// in Kc would become observable (RESULTS.md section 3.2).
//
// Run:
//   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib SOUNIO_SOUC_ENGINE=lean_single
//   ./bin/souc run examples/chemistry/full_probe.sio
use chemistry::gri30_full::*

fn pi64(x: i64) with IO, Mut, Div, Panic {
    if x < 0 { print("-"); pi64a(0 - x) } else { pi64a(x) }
}
fn pi64a(x: i64) with IO, Mut, Div, Panic {
    if x >= 10 { pi64a(x / 10); digit(x % 10) } else { digit(x) }
}
fn digit(d: i64) with IO, Mut, Div, Panic {
    if d == 0 { print("0") } else if d == 1 { print("1") } else if d == 2 { print("2") } else if d == 3 { print("3") } else if d == 4 { print("4") } else if d == 5 { print("5") } else if d == 6 { print("6") } else if d == 7 { print("7") } else if d == 8 { print("8") } else { print("9") }
}
fn pv(label: string, v: f64, scale: f64, exponent: i64) with IO, Mut, Div, Panic {
    print(label); pi64((v * scale) as i64); print("e"); pi64(exponent); println("")
}

fn init_state() -> [f64; 53] with Mut {
    let t_k: f64 = 1500.0
    let mtot: f64 = 1.0 / (82.057 * t_k)
    var c0: [f64; 53] = [0.0; 53]
    c0[0] = mtot * 0.02
    c0[3] = mtot * 0.01
    c0[47] = mtot * 0.97
    c0[1] = 1.0e-11
    c0
}

fn report(label: string, y: &[f64; 53]) with IO, Mut, Div, Panic {
    println(label)
    pv("  H2   ", y[0], 1.0e22, -22 as i64)
    pv("  H    ", y[1], 1.0e26, -26 as i64)
    pv("  O    ", y[2], 1.0e27, -27 as i64)
    pv("  O2   ", y[3], 1.0e22, -22 as i64)
    pv("  OH   ", y[4], 1.0e27, -27 as i64)
    pv("  H2O  ", y[5], 1.0e27, -27 as i64)
    pv("  HO2  ", y[6], 1.0e28, -28 as i64)
    pv("  H2O2 ", y[7], 1.0e31, -31 as i64)
    pv("  N2   ", y[47], 1.0e21, -21 as i64)
    pv("  NNH  ", y[34], 1.0e33, -33 as i64)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("FULL-MECHANISM PROBE (RECONSTRUCTION 2026-09-01)")
    println("GRI-Mech 3.0 complete: 53 species, 325 reactions")
    print("  nsp="); pi64(g30f_nsp()); print(" nrxn="); pi64(g30f_nrxn()); println("")
    println("T=1500K, isothermal, dt=2e-9, mol/cm3, mantissa e exponent")
    println("")

    let c0 = init_state()
    let a = simulate_gri30_full(&c0, 1500.0, 2.0e-9, 2000 as i64)
    report("t = 4e-6 s (2000 steps):", &a)
    println("")
    println("  replica reference    Cantera 3.2 reference")
    println("  H2   1.62485959583121780e-07   1.62485959581675630e-07")
    println("  H    1.05531109518200342e-11   1.05531114324938578e-11")
    println("  O    1.24300232843104601e-12   1.24300281422727476e-12")
    println("  O2   8.12421326765154836e-08   8.12421326755489925e-08")
    println("  OH   1.09368254389978098e-12   1.09368302264047293e-12")
    println("  H2O  1.83313117067441303e-12   1.83313213645402558e-12")
    println("  HO2  1.20494092398029042e-13   1.20494094065092846e-13")
    println("  H2O2 2.04379663825074701e-16   2.04379695675438026e-16")
    println("  NNH  1.57674597495852050e-17   1.57674604674652226e-17")
    println("")

    let b = simulate_gri30_full(&c0, 1500.0, 2.0e-9, 10000 as i64)
    report("t = 2e-5 s (10000 steps):", &b)
    println("")
    println("  replica reference    Cantera 3.2 reference")
    println("  H2   1.62447037642099308e-07   1.62447037611745645e-07")
    println("  H    3.26593676725774637e-11   3.26593842363430721e-11")
    println("  O    4.72236112196927923e-12   4.72236467598050302e-12")
    println("  O2   8.12251664034333963e-08   8.12251663896467307e-08")
    println("  OH   4.02166906116787291e-12   4.02167237572375348e-12")
    println("  H2O  2.78622581424163930e-11   2.78622784602024649e-11")
    println("  HO2  8.65149682729337221e-13   8.65149874546233508e-13")
    println("  H2O2 3.55244440868556859e-15   3.55244557601469086e-15")
    println("  NNH  4.87947004733045173e-17   4.87947252189819014e-17")
    println("PROBE DONE")
    0
}
