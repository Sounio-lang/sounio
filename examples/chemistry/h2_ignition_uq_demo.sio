// examples/chemistry/h2_ignition_uq_demo.sio
//
// Hydrogen combustion demo: complete GRI-Mech 3.0 H/O sub-mechanism
// (10 species, 29 reactions, NASA-7 detailed balance) with NATIVE 1-sigma
// uncertainty bands — the thing Cantera cannot do without an external
// Monte Carlo wrapper.
//
// Protocol (identical to benchmarks/chemistry/gri30_h2_cantera_parity.py):
//   2% H2 / 1% O2 / 97% N2, 1 atm, isothermal, H-atom seed 1e-11 mol/cm3.
//
// Prints:
//   1. species concentrations + native 1-sigma at t = 1e-4 s, T = 1500 K
//      (parity checkpoint vs Cantera 3.2 and the Python replica)
//   2. isothermal ignition delays (max d[H2O]/dt) for T = 1400..1800 K
//   3. constant-volume adiabatic checkpoint with NASA-7 internal-energy coupling
//
// Run:
//   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib SOUNIO_SOUC_ENGINE=lean_single
//   ./bin/souc run examples/chemistry/h2_ignition_uq_demo.sio
use chemistry::gri30_h2::*

fn pi64(x: i64) with IO, Mut, Div, Panic {
    if x < 0 { print("-"); pi64a(0 - x) } else { pi64a(x) }
}
fn pi64a(x: i64) with IO, Mut, Div, Panic {
    if x >= 10 { pi64a(x / 10); digit(x % 10) } else { digit(x) }
}
fn digit(d: i64) with IO, Mut, Div, Panic {
    if d == 0 { print("0") } else if d == 1 { print("1") } else if d == 2 { print("2") } else if d == 3 { print("3") } else if d == 4 { print("4") } else if d == 5 { print("5") } else if d == 6 { print("6") } else if d == 7 { print("7") } else if d == 8 { print("8") } else { print("9") }
}
fn pv(label: string, v: f64, scale: f64, exponent: i64) with IO, Mut, Div, Panic {
    print(label); pi64((v * scale) as i64); print("e"); pi64(exponent); println("")
}
fn pshare(fraction: f64) with IO, Mut, Div, Panic {
    // Mantissa/exponent form retains precision without a decimal formatter:
    // 250000e-4% is 25.0000%.
    pi64((fraction * 1.0e6) as i64); print("e-4%")
}

fn print_uq_top3(species_name: string, species: i64, u: f64, contribution: &[f64; 310]) with IO, Mut, Div, Panic {
    let top = g30_h2_uq_top3(contribution, species);
    let total = u * u;
    println("");
    print("UQ DRIVERS "); println(species_name);
    var k: i64 = 0;
    while k < 3 {
        let source = top[k];
        print("  "); print(g30_h2_uq_source_label(source)); print("  share=");
        if total > 0.0 { pshare(contribution[species*31+source] / total) } else { print("0e-4%") }
        println("");
        k = k + 1;
    }
}

fn demo_init(t: f64) -> [f64; 10] with Mut, Div, Panic {
    let m = 101325.0 / (8.31446261815324 * t) * 1.0e-6;
    var c0: [f64; 10] = [0.0; 10];
    c0[0] = m * 0.02;
    c0[3] = m * 0.01;
    c0[8] = m * 0.97;
    c0[1] = 1.0e-11;
    c0
}

fn adiabatic_init(t: f64) -> [f64; 10] with Mut, Div, Panic {
    let m = 101325.0 / (8.314462618 * t) * 1.0e-6;
    var c0: [f64; 10] = [0.0; 10];
    c0[0] = m * 0.02;
    c0[3] = m * 0.01;
    c0[8] = m * 0.97;
    c0[1] = 1.0e-11;
    c0
}

// isothermal ignition delay (max d[H2O]/dt), seconds; early exit past the front
fn ignition_delay(t: f64, dt: f64, max_steps: i64) -> f64 with Mut, Div, Panic {
    let kc = g30_kc_all(t);
    var y = demo_init(t);
    var yt: [f64; 10] = [0.0; 10];
    var prev_h2o = y[5];
    var best_rate = 0.0;
    var best_t = 0.0;
    var s: i64 = 0;
    var i: i64 = 0;
    var done = false;
    while s < max_steps && !done {
        let k1 = g30_dc_kc(t, &y, &kc);
        i = 0; while i < 10 { yt[i] = y[i] + 0.5 * dt * k1[i]; i = i + 1; }
        let k2 = g30_dc_kc(t, &yt, &kc);
        i = 0; while i < 10 { yt[i] = y[i] + 0.5 * dt * k2[i]; i = i + 1; }
        let k3 = g30_dc_kc(t, &yt, &kc);
        i = 0; while i < 10 { yt[i] = y[i] + dt * k3[i]; i = i + 1; }
        let k4 = g30_dc_kc(t, &yt, &kc);
        i = 0; while i < 10 { y[i] = y[i] + (dt / 6.0) * (k1[i] + 2.0 * k2[i] + 2.0 * k3[i] + k4[i]); i = i + 1; }
        s = s + 1;
        let rate = (y[5] - prev_h2o) / dt;
        prev_h2o = y[5];
        let tnow = (s as f64) * dt;
        if rate > best_rate { best_rate = rate; best_t = tnow - 0.5 * dt }
        if best_t > 0.0 && rate < 0.05 * best_rate && tnow > 2.0 * best_t { done = true }
    }
    best_t
}

fn run_delay_sweep() with IO, Mut, Div, Panic {
    println("IGNITION DELAYS (isothermal, seed H=1e-11 mol/cm3, 2%H2/1%O2/97%N2, 1 atm; integer ps)");
    print("  T= 1400K  t_ign="); pi64((ignition_delay(1400.0, 1.0e-8, 30000 as i64) * 1.0e12) as i64); println(" ps");
    print("  T= 1500K  t_ign="); pi64((ignition_delay(1500.0, 1.0e-8, 30000 as i64) * 1.0e12) as i64); println(" ps");
    print("  T= 1600K  t_ign="); pi64((ignition_delay(1600.0, 1.0e-8, 30000 as i64) * 1.0e12) as i64); println(" ps");
    print("  T= 1700K  t_ign="); pi64((ignition_delay(1700.0, 1.0e-8, 30000 as i64) * 1.0e12) as i64); println(" ps");
    print("  T= 1800K  t_ign="); pi64((ignition_delay(1800.0, 1.0e-8, 30000 as i64) * 1.0e12) as i64); println(" ps");
}

fn main() -> i32 with Mut, Div, Panic, IO {
    let t = 1500.0;
    let c0 = demo_init(t);
    var u0: [f64; 10] = [0.0; 10];
    u0[0] = 0.01 * c0[0];
    u0[3] = 0.01 * c0[3];
    var y: [f64; 10] = [0.0; 10]
    var u: [f64; 10] = [0.0; 10]
    var contribution: [f64; 310] = [0.0; 310]
    simulate_gri30_h2_epistemic_attributed_into(&c0, &u0, t, 1.0e-8, 10000 as i64, &!y, &!u, &!contribution)
    println("SOUNIO GRI-Mech 3.0 H/O (10 species, 29 reactions) + NATIVE 1-sigma UQ");
    println("T=1500K t=1e-4s checkpoint (mantissa e exponent, mol/cm3):");
    pv("  H2   v=", y[0], 1.0e18, -18); pv("       u=", u[0], 1.0e18, -18);
    pv("  H    v=", y[1], 1.0e18, -18); pv("       u=", u[1], 1.0e18, -18);
    pv("  O    v=", y[2], 1.0e18, -18); pv("       u=", u[2], 1.0e18, -18);
    pv("  O2   v=", y[3], 1.0e18, -18); pv("       u=", u[3], 1.0e18, -18);
    pv("  OH   v=", y[4], 1.0e18, -18); pv("       u=", u[4], 1.0e18, -18);
    pv("  H2O  v=", y[5], 1.0e18, -18); pv("       u=", u[5], 1.0e18, -18);
    pv("  HO2  v=", y[6], 1.0e21, -21); pv("       u=", u[6], 1.0e21, -21);
    pv("  H2O2 v=", y[7], 1.0e24, -24); pv("       u=", u[7], 1.0e24, -24);
    println("Variance budget: independent first-order GUM source shares (not quantiles):");
    print_uq_top3("H", 1 as i64, u[1], &contribution);
    print_uq_top3("OH", 4 as i64, u[4], &contribution);
    print_uq_top3("H2O", 5 as i64, u[5], &contribution);
    print_uq_top3("H2O2", 7 as i64, u[7], &contribution);
    let ca = adiabatic_init(t);
    let (ya, ta) = simulate_gri30_h2_adiabatic(&ca, t, 1.0e-8, 10000 as i64);
    println("CONSTANT-VOLUME ADIABATIC (Cantera 3.2.0 checkpoint):");
    pv("  T      = ", ta, 1.0e6, -6);
    pv("  H2O    = ", ya[5], 1.0e18, -18);
    run_delay_sweep();
    println("DEMO DONE");
    0
}
