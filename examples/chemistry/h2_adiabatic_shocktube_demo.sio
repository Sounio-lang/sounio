// examples/chemistry/h2_adiabatic_shocktube_demo.sio
//
// Hydrogen combustion in the shock-tube regime: ADIABATIC (constant-U,V)
// ignition-delay curve for the complete GRI-Mech 3.0 H/O sub-mechanism
// (10 species, 29 reactions, NASA-7 thermo, detailed balance). Sensible
// energy conservation couples the temperature to the kinetics:
//   dT/dt = -T * sum(h_rt-1)*omega / sum c*(cp_r-1),  u_mix = const.
//
// Protocol (identical to benchmarks/chemistry/gri30_h2_adiabatic_cantera.py
// and gri30_h2_adiabatic_replica.py):
//   2% H2 / 1% O2 / 97% N2, 1 atm initial, H-atom seed 1e-11 mol/cm3
//   (chain-initiation surrogate, same protocol as the isothermal work).
//
// Delay definition (house): mid-step time of max d[H2O]/dt (primary) and
// max dT/dt (secondary) from the fixed-step RK4 trajectory, dt = 1e-8 s.
// Points below the second explosion limit stay metastable on the 3 ms
// horizon and print "no-ign" — that IS the crossover physics.
//
// Run:
//   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib
//   ./bin/souc run examples/chemistry/h2_adiabatic_shocktube_demo.sio
use chemistry::gri30_h2::*

fn pi64(x: i64) with IO, Mut, Div, Panic {
    if x < 0 { print("-"); pi64a(0 - x) } else { pi64a(x) }
}
fn pi64a(x: i64) with IO, Mut, Div, Panic {
    if x >= 10 { pi64a(x / 10); digit(x % 10) } else { digit(x) }
}
fn digit(d: i64) with IO, Mut, Div, Panic {
    if d == 0 { print("0") } else if d == 1 { print("1") } else if d == 2 { print("2") } else if d == 3 { print("3") } else if d == 4 { print("4") } else if d == 5 { print("5") } else if d == 6 { print("6") } else if d == 7 { print("7") } else if d == 8 { print("8") } else { print("9") }
}

// one sweep line: 1000/T (scaled 1e4), both delays in microseconds
fn sweep_point(t0: f64) with IO, Mut, Div, Panic {
    // uniform 3 ms horizon: the early-exit certificate needs t > 2*peak, so a
    // shorter horizon can false-negative slow-but-real ignitions
    let (th, tt) = g30_adiabatic_delay(t0, 1.0e-8, 300000 as i64)
    print("  1000/T=0.");
    pi64((1000.0 * 10000.0 / t0) as i64);
    print("  T0=");
    pi64(t0 as i64);
    print("K  t_h2o=");
    if th > 0.0 {
        pi64((th * 1.0e6) as i64);
        print(" us  t_dT=");
        pi64((tt * 1.0e6) as i64);
        println(" us")
    } else {
        println("no-ign(3ms)  t_dT=no-ign")
    }
}

fn run_sweep() with IO, Mut, Div, Panic {
    println("ADIABATIC (UV) IGNITION DELAYS — GRI-Mech 3.0 H/O, RK4 dt=1e-8");
    println("2%H2/1%O2/97%N2, 1 atm initial, seed H=1e-11 mol/cm3");
    sweep_point(1000.0);
    sweep_point(1100.0);
    sweep_point(1200.0);
    sweep_point(1300.0);
    sweep_point(1400.0);
    sweep_point(1500.0);
    sweep_point(1600.0);
    sweep_point(1700.0);
    sweep_point(1800.0);
    sweep_point(1900.0);
    sweep_point(2000.0)
}

fn main() -> i32 with Mut, Div, Panic, IO {
    run_sweep();
    println("DEMO DONE");
    0
}
