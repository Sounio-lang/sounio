// examples/chemistry/h2_probe2.sio
//
// RECONSTRUCTION (2026-09-01) -- this is NOT the original artefact.
// The preprint cites examples/chemistry/h2_probe2.sio. No blob under that name
// exists in any tree reachable from any ref of this repository, and there are
// no stashes, worktrees or dangling objects holding it (see
// benchmarks/chemistry/RESULTS.md section 4). Written from the described
// protocol, not recovered.
//
// PURPOSE: dt-convergence of the DETERMINISTIC H/O trajectory, to separate
// RK4 truncation error from cross-language arithmetic difference.
//
// The Sounio-vs-Cantera deviation at the pre-front checkpoint is 2.2e-07 to
// 2.7e-06 (RESULTS.md section 1), while Sounio-vs-replica is 3.3e-12 to
// 2.6e-10. This probe establishes how much of the former is truncation at
// dt = 1e-8 by halving the step: if the trajectory moves by the same order
// when dt is halved, the gap to CVODE is truncation.
//
// Protocol: as h2_precision_probe.sio, at dt = 1e-8 (10000 steps) and
// dt = 5e-9 (20000 steps), both to t = 1e-4 s.
//
// Run:
//   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib SOUNIO_SOUC_ENGINE=lean_single
//   ./bin/souc run examples/chemistry/h2_probe2.sio
use chemistry::gri30_h2::*

fn pi64(x: i64) with IO, Mut, Div, Panic {
    if x < 0 { print("-"); pi64a(0 - x) } else { pi64a(x) }
}
fn pi64a(x: i64) with IO, Mut, Div, Panic {
    if x >= 10 { pi64a(x / 10); digit(x % 10) } else { digit(x) }
}
fn digit(d: i64) with IO, Mut, Div, Panic {
    if d == 0 { print("0") } else if d == 1 { print("1") } else if d == 2 { print("2") } else if d == 3 { print("3") } else if d == 4 { print("4") } else if d == 5 { print("5") } else if d == 6 { print("6") } else if d == 7 { print("7") } else if d == 8 { print("8") } else { print("9") }
}
fn pv(label: string, v: f64, scale: f64, exponent: i64) with IO, Mut, Div, Panic {
    print(label); pi64((v * scale) as i64); print("e"); pi64(exponent); println("")
}

fn probe(dt: f64, steps: i64) -> [f64; 10] with Mut, Div, Panic {
    let t_k: f64 = 1500.0
    let mtot: f64 = 1.0 / (82.057 * t_k)
    var c0: [f64; 10] = [0.0; 10]
    c0[0] = mtot * 0.02
    c0[3] = mtot * 0.01
    c0[8] = mtot * 0.97
    c0[1] = 1.0e-11
    var s0: [f64; 10] = [0.0; 10]
    let r = simulate_gri30_h2_epistemic(&c0, &s0, t_k, dt, steps)
    r.0
}

fn report(label: string, y: &[f64; 10]) with IO, Mut, Div, Panic {
    println(label)
    pv("  H2   ", y[0], 1.0e22, -22 as i64)
    pv("  H    ", y[1], 1.0e24, -24 as i64)
    pv("  O    ", y[2], 1.0e24, -24 as i64)
    pv("  O2   ", y[3], 1.0e22, -22 as i64)
    pv("  OH   ", y[4], 1.0e24, -24 as i64)
    pv("  H2O  ", y[5], 1.0e23, -23 as i64)
    pv("  HO2  ", y[6], 1.0e26, -26 as i64)
    pv("  H2O2 ", y[7], 1.0e28, -28 as i64)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("H2 PROBE 2: dt-CONVERGENCE (RECONSTRUCTION 2026-09-01)")
    println("GRI-Mech 3.0 H/O, T=1500K, t=1e-4 s, mol/cm3, mantissa e exponent")
    println("")
    let a = probe(1.0e-8, 10000 as i64)
    report("dt = 1e-8 (10000 steps):", &a)
    println("")
    let b = probe(5.0e-9, 20000 as i64)
    report("dt = 5e-9 (20000 steps):", &b)
    println("")
    println("Cantera 3.2 CVODE reference (rtol 1e-12, atol 1e-22), mol/cm3:")
    println("  H2   1.452026406661632e-07")
    println("  H    9.781464042547194e-09")
    println("  O    1.452399552929886e-09")
    println("  O2   7.399896700947298e-08")
    println("  OH   1.224599671250092e-09")
    println("  H2O  1.177931597531644e-08")
    println("  HO2  1.705120796024241e-11")
    println("  H2O2 1.624679943884135e-13")
    println("PROBE DONE")
    0
}
