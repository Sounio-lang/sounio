// examples/chemistry/kinetics_demo.sio
// Foundations E2E: Arrhenius, metabolic network, CRN Euler + epistemic GUM

use chemistry::kinetics;

fn main() -> i32 with IO, Mut, Div, Panic {
    let (k, uk) = kinetics::arrhenius(1e13, 1e11, 103000.0, 1000.0, 300.0, 1.0)
    println("Arrhenius (Ea~103 kJ/mol, 300 K): k={} +/- {}", k, uk)

    let (a, b, c) = kinetics::real_metabolic_network(24.0)
    println("Metabolic A/B/C @24h: {}/{}/{}", a, b, c)

    let c1 = kinetics::first_order_conc(1.0, 0.1, 10.0)
    println("First-order C(t=10 h): {}", c1)

    let init: [f64; 4] = [1.0, 0.0, 0.0, 0.0]
    let ks: [f64; 3] = [0.1, 0.05, 0.2]
    let out = kinetics::simulate_crn_euler(&init, &ks, 0.1, 20)
    println("CRN [A] after Euler: {}", out[0])

    let inits: [f64; 4] = [0.01, 0.0, 0.0, 0.0]
    let us: [f64; 3] = [0.001, 0.0005, 0.002]
    let (ca, _, _, _, ua, _, _, _) = kinetics::simulate_crn_epistemic(&init, &inits, &ks, &us, 0.1, 20)
    println("Epistemic CRN [A]: {} +/- {}", ca, ua)

    println("KINETICS DEMO: foundations (arrhenius + metabolic + CRN + epistemic) REAL")
    return 0
}