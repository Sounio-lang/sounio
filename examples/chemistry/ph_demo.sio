// examples/chemistry/ph_demo.sio
// Real E2E pH + titration + MM (biochem rate) with GUM

use chemistry::acids;
use epistemic::knowledge::Epistemic;

fn main() -> i32 with IO, Mut, Div, Panic {
    let h = Epistemic::measured(1e-7, 0.1e-7);
    let (phv, uph) = acids::ph(h.val(), h.std());
    println("pH neutral water epistemic: {} +/- {}", phv, uph);

    let (phbuf, _) = acids::henderson_hasselbalch(4.76, 0.02, 1.0, 0.05);
    println("Acetate buffer pH: {}", phbuf);

    // Titration + MM enzyme rate (real biochem)
    let ph_t = acids::titration_ph(0.1, 0.1, 0.05, 0.1);
    println("Titration pH point: {}", ph_t);

    let (mmr, ummr) = acids::mm_rate(1.0, 0.1, 5.0, 0.2, 1.0, 0.05);
    println("MM rate (Vmax/Km style): {} +/- {}", mmr, ummr);

    println("ACIDS: pH GUM + titration + MM REAL");
    return 0
}