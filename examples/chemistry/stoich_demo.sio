// examples/chemistry/stoich_demo.sio
// Real E2E stoich + limiting + equilibrium (GUM helpers + chemistry::equilibrium)

use chemistry::equilibrium;
use epistemic::knowledge::Epistemic;

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn moles_from_mass(mass: f64, um: f64, mm: f64, umm: f64) -> (f64, f64) {
    if mm <= 0.0 { return (0.0, 0.0) }
    let n = mass / mm
    let un = abs_f64(n) * (um / abs_f64(mass) + umm / abs_f64(mm))
    (n, un)
}

fn percent_yield(actual: f64, uact: f64, theoretical: f64, utheo: f64) -> (f64, f64) {
    if theoretical <= 0.0 { return (0.0, 0.0) }
    let py = 100.0 * actual / theoretical
    let upy = abs_f64(py) * (uact / abs_f64(actual) + utheo / abs_f64(theoretical))
    (py, upy)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let m = Epistemic::measured(18.0, 0.1);
    let mm = 18.015;
    let (n, un) = moles_from_mass(m.val(), m.std(), mm, 0.001);
    println("moles water 18g epistemic: {} +/- {}", n, un);

    let (py, _) = percent_yield(0.85, 0.02, 1.0, 0.0);
    println("percent yield: {}", py);

    // A + B ⇌ C equilibrium extent (stoich + limiting flavor)
    let (x, ux) = equilibrium::solve_ab_c_equil(1.0, 0.01, 0.5, 0.01, 2.0, 0.05);
    println("A+B->C extent (limiting B): {} +/- {}", x, ux);

    let (_, _, b, _) = equilibrium::solve_simple_equil(1.0, 0.01, 0.5, 0.02);
    println("A<->B equilibrium [B]: {}", b);

    println("STOICH: moles + yield + equil limiting REAL");
    return 0
}