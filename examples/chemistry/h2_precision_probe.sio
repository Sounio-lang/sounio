// examples/chemistry/h2_precision_probe.sio
//
// RECONSTRUCTION (2026-09-01) -- this is NOT the original artefact.
// The preprint cites examples/chemistry/h2_precision_probe.sio. No blob under
// that name exists in any tree reachable from any ref of this repository, and
// there are no stashes, worktrees or dangling objects holding it (see
// benchmarks/chemistry/RESULTS.md section 4). This file was written from the
// protocol described in the preprint, not recovered.
//
// PURPOSE: emit the H/O pre-front checkpoint at higher precision than
// examples/chemistry/h2_ignition_uq_demo.sio does. The demo prints 10-12
// significant digits, and at that resolution Sounio and the Python replica
// agree to the last printed digit (3.3e-12 .. 2.6e-10), so the demo cannot
// tell whether the residual is real or a printing artefact. This probe prints
// the mantissa scaled to 15 digits so the comparison is limited by the
// arithmetic rather than by the formatter.
//
// Protocol (identical to gri30_h2_python_replica.py and gri30_h2_cantera_parity.py):
//   2% H2 / 1% O2 / 97% N2, 1 atm, T = 1500 K, isothermal,
//   additive H-atom seed 1e-11 mol/cm3, RK4 dt = 1e-8, 10000 steps.
//
// Run:
//   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib SOUNIO_SOUC_ENGINE=lean_single
//   ./bin/souc run examples/chemistry/h2_precision_probe.sio
use chemistry::gri30_h2::*

fn pi64(x: i64) with IO, Mut, Div, Panic {
    if x < 0 { print("-"); pi64a(0 - x) } else { pi64a(x) }
}
fn pi64a(x: i64) with IO, Mut, Div, Panic {
    if x >= 10 { pi64a(x / 10); digit(x % 10) } else { digit(x) }
}
fn digit(d: i64) with IO, Mut, Div, Panic {
    if d == 0 { print("0") } else if d == 1 { print("1") } else if d == 2 { print("2") } else if d == 3 { print("3") } else if d == 4 { print("4") } else if d == 5 { print("5") } else if d == 6 { print("6") } else if d == 7 { print("7") } else if d == 8 { print("8") } else { print("9") }
}
fn pv(label: string, v: f64, scale: f64, exponent: i64) with IO, Mut, Div, Panic {
    print(label); pi64((v * scale) as i64); print("e"); pi64(exponent); println("")
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("H2 PRECISION PROBE (RECONSTRUCTION 2026-09-01)")
    println("GRI-Mech 3.0 H/O, T=1500K, dt=1e-8, 10000 steps, t=1e-4 s")
    println("mantissa scaled to 15 significant digits, mol/cm3")

    let t_k: f64 = 1500.0
    let mtot: f64 = 101325.0 / (8.31446261815324 * t_k) * 1.0e-6
    var c0: [f64; 10] = [0.0; 10]
    c0[0] = mtot * 0.02
    c0[3] = mtot * 0.01
    c0[8] = mtot * 0.97
    c0[1] = 1.0e-11

    var s0: [f64; 10] = [0.0; 10]
    s0[0] = 0.01 * c0[0]
    s0[3] = 0.01 * c0[3]

    let r = simulate_gri30_h2_epistemic(&c0, &s0, t_k, 1.0e-8, 10000 as i64)
    let y = r.0
    let u = r.1

    println("")
    println("DETERMINISTIC (v) and 1-SIGMA BAND (u):")
    pv("  H2   v=", y[0], 1.0e22, -22 as i64)
    pv("  H2   u=", u[0], 1.0e22, -22 as i64)
    pv("  H    v=", y[1], 1.0e24, -24 as i64)
    pv("  H    u=", u[1], 1.0e24, -24 as i64)
    pv("  O    v=", y[2], 1.0e24, -24 as i64)
    pv("  O    u=", u[2], 1.0e24, -24 as i64)
    pv("  O2   v=", y[3], 1.0e22, -22 as i64)
    pv("  O2   u=", u[3], 1.0e22, -22 as i64)
    pv("  OH   v=", y[4], 1.0e24, -24 as i64)
    pv("  OH   u=", u[4], 1.0e24, -24 as i64)
    pv("  H2O  v=", y[5], 1.0e23, -23 as i64)
    pv("  H2O  u=", u[5], 1.0e23, -23 as i64)
    pv("  HO2  v=", y[6], 1.0e26, -26 as i64)
    pv("  HO2  u=", u[6], 1.0e26, -26 as i64)
    pv("  H2O2 v=", y[7], 1.0e28, -28 as i64)
    pv("  H2O2 u=", u[7], 1.0e28, -28 as i64)
    println("")
    println("Reference (Python replica, same RK4 and dt), mol/cm3:")
    println("  H2   1.45202409180648259e-07")
    println("  H    9.78118787162766235e-09")
    println("  O    1.45235755728164051e-09")
    println("  O2   7.39988119297947390e-08")
    println("  OH   1.22456521149193150e-09")
    println("  H2O  1.17789779335583026e-08")
    println("  HO2  1.70510868870023519e-11")
    println("  H2O2 1.62463513786769239e-13")
    println("PROBE DONE")
    0
}
