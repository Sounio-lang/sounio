// examples/chemistry/h2_flame_speed_demo.sio
//
// Laminar flame speed of a 1-D premixed freely-propagating H2/air flame at
// phi=1, T_u=300 K, p=1 atm — the third leg of the combustion trilogy
// (isothermal kinetics -> adiabatic shock tube -> flame speed).
//
// Model (stdlib/chemistry/flame1d.sio): low-Mach 1-D flame, unity Lewis
// number (one shared diffusivity D(T) fit to Cantera's lambda/(rho cp)
// along its own unity-Lewis free flame), GRI-Mech 3.0 H/O sub-mechanism
// (10 species, 29 reactions), Godunov split between stage-clamped RK4
// isobaric chemistry (dt_c ~ 1e-8 s) and FTCS transport (dt_m = 5e-7 s,
// dx = 40 um), flame frame with prescribed mass flux rho_u*S_L_G.
//
// The match target is the SAME-transport Cantera 3.2.0 reference
// (benchmarks/chemistry/flame1d_cantera.py, 29-reaction sub-mechanism,
// transport_model="unity-Lewis-number"): S_L = 1.6543 m/s.
// Mixture-averaged transport gives ~2.33 m/s — preferential H2 diffusion
// is real physics, but it is CONTEXT ONLY here, never the match target.
//
// Run (lean_single; ~1 h, 800 macro-steps = 0.4 ms):
//   SOUNIO_SOUC_ENGINE=lean_single ./bin/souc run examples/chemistry/h2_flame_speed_demo.sio
use chemistry::flame1d::*;

fn main() -> i32 with Mut, Div, Panic, IO {
    println("H2/AIR LAMINAR FLAME SPEED — phi=1, 300 K, 1 atm, unity Lewis");
    println("GRI-Mech 3.0 H/O (10 sp, 29 rxn), dx=40um dt_m=5e-7 t_end=0.4ms");
    println("Cantera unity-Lewis reference: S_L = 1.6543 m/s");
    let (sl, sl_int, drift) = fl1d_run(50 as i64);
    print("RESULT S_L(slope)=");
    fl1d_pi64((sl * 1.0e4) as i64);
    print("e-4m/s S_L(integral)=");
    fl1d_pi64((sl_int * 1.0e4) as i64);
    print("e-4m/s vs Cantera 16543e-4m/s");
    println("");
    println("DEMO DONE");
    0
}
