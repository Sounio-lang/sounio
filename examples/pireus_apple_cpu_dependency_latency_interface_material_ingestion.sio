//@ run-pass
//!
//! Sounio authority stream for an Apple CPU material envelope.

use hardware::pireus::apple_cpu_dependency_latency_interface_material_ingestion::{
    PIREUS_APPLE_MATERIAL_INGEST_TRANSPORT_FAILURE,
    PIREUS_APPLE_MATERIAL_INGEST_FACTS_UNSEALED,
    PIREUS_APPLE_MATERIAL_INGEST_SEALED_CLASSIFIED,
    pireus_apple_material_ingest_file,
    pireus_apple_material_ingest_sealed_files,
    pireus_apple_material_ingestion_classification_allowed,
    pireus_apple_material_ingestion_sealed_matches_frozen_classifier,
    pireus_apple_material_ingestion_transport_matches_frozen_semantics,
}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    if arg_count() != 1 && arg_count() != 3 {
        print("usage: pireus_apple_cpu_dependency_latency_interface_material_ingestion <envelope> | <receipt> <summary> <samples>\n")
        return 2
    }
    let result = if arg_count() == 1 {
        pireus_apple_material_ingest_file(get_arg(0))
    } else {
        pireus_apple_material_ingest_sealed_files(
            get_arg(0), get_arg(1), get_arg(2))
    }
    let classification_allowed =
        pireus_apple_material_ingestion_classification_allowed(&result)
    print("SOUNIO_SEMANTIC_AUTHORITY schema=pireus.apple-cpu-interface-material-ingestion.v1 stage=PARITY_OPEN\n")
    print("PIREUS_APPLE_MATERIAL_INGEST valid=")
    print_int(yes(result.valid))
    print(" status="); print_int(result.status)
    print(" transport_failure="); print_int(yes(result.transport_failure))
    print(" material_facts="); print_int(yes(result.material_facts_present))
    print(" parity_receipt_valid=")
    print_int(yes(result.parity_receipt_valid))
    print(" observation_ready=")
    print_int(yes(result.material_observation_ready))
    print(" classification_requested=")
    print_int(yes(result.classification_requested))
    print(" classification_allowed=")
    print_int(yes(classification_allowed))
    print(" child_verdict=")
    print_int(yes(result.semantic_verdict_emitted_by_child))
    print(" cost_present="); print_int(yes(result.cost_present))
    print(" claim_ready="); print_int(yes(result.claim_ready))
    print(" authority_verdict="); print_int(result.authority_verdict)
    print(" candidates="); print_int(result.candidate_count)
    print(" terminal="); print_int(result.complete_terminal_count)
    print(" feasible="); print_int(result.feasible_count)
    print(" refusals="); print_int(result.refusal_count)
    print(" ineligible="); print_int(result.cycle_ineligible_count)
    print(" feasible_candidate="); print_int(result.feasible_candidate_id)
    print(" manifest_closed="); print_int(yes(result.manifest_closed))
    print("\n")

    let recognized = result.status ==
            PIREUS_APPLE_MATERIAL_INGEST_TRANSPORT_FAILURE ||
        result.status == PIREUS_APPLE_MATERIAL_INGEST_FACTS_UNSEALED ||
        result.status == PIREUS_APPLE_MATERIAL_INGEST_SEALED_CLASSIFIED
    let frozen_transport = if result.status ==
            PIREUS_APPLE_MATERIAL_INGEST_TRANSPORT_FAILURE {
        pireus_apple_material_ingestion_transport_matches_frozen_semantics(
            &result)
    } else { true }
    let frozen_sealed = if result.status ==
            PIREUS_APPLE_MATERIAL_INGEST_SEALED_CLASSIFIED {
        pireus_apple_material_ingestion_sealed_matches_frozen_classifier(
            &result)
    } else { true }
    let admission = if result.status ==
        PIREUS_APPLE_MATERIAL_INGEST_SEALED_CLASSIFIED {
        classification_allowed
    } else { !classification_allowed }
    if result.valid && recognized && admission && frozen_transport &&
        frozen_sealed { 0 } else { 1 }
}
