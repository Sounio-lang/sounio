//@ run-pass
//!
//! Sounio authority stream for an Apple CPU material envelope.

use hardware::pireus::apple_cpu_dependency_latency_interface_material_ingestion::{
    PIREUS_APPLE_MATERIAL_INGEST_TRANSPORT_FAILURE,
    PIREUS_APPLE_MATERIAL_INGEST_FACTS_UNSEALED,
    pireus_apple_material_ingest_file,
    pireus_apple_material_ingestion_classification_allowed,
}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    if arg_count() != 1 {
        print("usage: pireus_apple_cpu_dependency_latency_interface_material_ingestion <envelope>\n")
        return 2
    }
    let result = pireus_apple_material_ingest_file(get_arg(0))
    let classification_allowed =
        pireus_apple_material_ingestion_classification_allowed(&result)
    print("SOUNIO_SEMANTIC_AUTHORITY schema=pireus.apple-cpu-interface-material-ingestion.v0 stage=PARITY_OPEN\n")
    print("PIREUS_APPLE_MATERIAL_INGEST valid=")
    print_int(yes(result.valid))
    print(" status="); print_int(result.status)
    print(" transport_failure="); print_int(yes(result.transport_failure))
    print(" material_facts="); print_int(yes(result.material_facts_present))
    print(" parity_receipt_valid=")
    print_int(yes(result.parity_receipt_valid))
    print(" observation_ready=")
    print_int(yes(result.material_observation_ready))
    print(" classification_requested=")
    print_int(yes(result.classification_requested))
    print(" classification_allowed=")
    print_int(yes(classification_allowed))
    print(" child_verdict=")
    print_int(yes(result.semantic_verdict_emitted_by_child))
    print(" cost_present="); print_int(yes(result.cost_present))
    print(" claim_ready="); print_int(yes(result.claim_ready))
    print(" authority_verdict="); print_int(result.authority_verdict)
    print("\n")

    let recognized = result.status ==
            PIREUS_APPLE_MATERIAL_INGEST_TRANSPORT_FAILURE ||
        result.status == PIREUS_APPLE_MATERIAL_INGEST_FACTS_UNSEALED
    if result.valid && recognized && !classification_allowed { 0 } else { 1 }
}
