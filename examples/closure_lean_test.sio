// closure_lean_test.sio — Sprint 234 Track A gate
//
// Verifies ExprClosure lambda-lifting in the lean emitter.
// Expected exit code: 6   (verified result)
//
// Test: |x: i64| x + 1 applied to 5 = 6
//
// Stage:
//   lean_emitter compiles THIS FILE → closure_lean_test.elf
//   closure_lean_test.elf exits with 6

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn main() -> i64 with Mut, Panic, Div {
    // Single-param closure
    let inc = |x: i64| x + 1
    let result = apply(inc, 5)
    result
}
