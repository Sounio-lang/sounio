// examples/stats_viz/descriptive_boxplot_demo.sio
//
// Estatística descritiva + histograma PNG (stdlib graphics puro).
// Compile: ./artifacts/self-hosted/souc-self-hosted-x86_64 examples/stats_viz/descriptive_boxplot_demo.sio /tmp/box.elf
// Run:     chmod +x /tmp/box.elf && /tmp/box.elf

use graphics::surface::{surface_new, surface_clear, surface_draw_rect}
use graphics::drawing::{color_white, color_black, color_blue}
use graphics::export::{export_png}

extern "C" {
    fn sqrt(x: f64) -> f64
}

fn mean(data: &[f64; 256], n: i64) -> f64 with Div {
    var sum = 0.0
    var i: i64 = 0
    while i < n {
        sum = sum + data[i as usize]
        i = i + 1
    }
    sum / (n as f64)
}

fn std_dev(data: &[f64; 256], n: i64) -> f64 with Div {
    let m = mean(data, n)
    var sum_sq = 0.0
    var i: i64 = 0
    while i < n {
        let d = data[i as usize] - m
        sum_sq = sum_sq + d * d
        i = i + 1
    }
    sqrt(sum_sq / ((n - 1) as f64))
}

fn draw_histogram_png(data: &[f64; 256], n: i64, bins: i64, path: string) -> bool with IO, Mut, Panic, Div {
    if n <= 0 || bins <= 0 { return false }
    var vmin = data[0]
    var vmax = data[0]
    var i: i64 = 1
    while i < n {
        let idx = i as usize
        if data[idx] < vmin { vmin = data[idx] }
        if data[idx] > vmax { vmax = data[idx] }
        i = i + 1
    }
    let span = vmax - vmin
    var counts: [i64; 32] = [0; 32]
    i = 0
    while i < n {
        var b = ((data[i as usize] - vmin) / span * (bins as f64)) as i64
        if b >= bins { b = bins - 1 }
        if b < 0 { b = 0 }
        counts[b as usize] = counts[b as usize] + 1
        i = i + 1
    }
    var cmax: i64 = 1
    var b: i64 = 0
    while b < bins {
        if counts[b as usize] > cmax { cmax = counts[b as usize] }
        b = b + 1
    }
    var s = surface_new(480, 300)
    s = surface_clear(s, color_white())
    let margin: i64 = 30
    let plot_w: i64 = 420
    let plot_h: i64 = 240
    let bar_w = plot_w / bins
    b = 0
    while b < bins {
        let cnt = counts[b as usize]
        var h = (cnt * plot_h) / cmax
        if h < 1 && cnt > 0 { h = 1 }
        let x = margin + b * bar_w
        let y = margin + plot_h - h
        s = surface_draw_rect(s, x, y, bar_w - 2, h, color_blue())
        b = b + 1
    }
    s = surface_draw_rect(s, margin, margin, 1, plot_h, color_black())
    s = surface_draw_rect(s, margin, margin + plot_h, plot_w, 1, color_black())
    export_png(&s, path)
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let n: i64 = 24
    var data: [f64; 256] = [0.0; 256]

    var i: i64 = 0
    while i < 12 {
        data[i as usize] = 10.0 + 2.0 * ((i as f64) / 12.0)
        i = i + 1
    }
    while i < 24 {
        data[i as usize] = 18.0 + 4.0 * (((i - 12) as f64) / 12.0)
        i = i + 1
    }

    let m = mean(&data, n)
    let s = std_dev(&data, n)

    println("=== Estatística descritiva ===")
    println("mean=")
    println(m)
    println("std_dev=")
    println(s)

    let png_ok = draw_histogram_png(&data, n, 8, "/tmp/sounio_descriptive_hist.png")
    println("PNG /tmp/sounio_descriptive_hist.png ok=")
    println(if png_ok { 1 } else { 0 })

    let ok_mean = m > 14.0 && m < 16.0
    if ok_mean && png_ok {
        println("DESCRIPTIVE_BOXPLOT_DEMO_PASS")
        0
    } else {
        println("DESCRIPTIVE_BOXPLOT_DEMO_FAIL")
        1
    }
}
