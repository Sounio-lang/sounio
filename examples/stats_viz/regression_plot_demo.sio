// examples/stats_viz/regression_plot_demo.sio
//
// Regressão linear OLS + banda epistémica (PNG + terminal).
// Compile: ./artifacts/self-hosted/souc-self-hosted-x86_64 examples/stats_viz/regression_plot_demo.sio /tmp/reg_plot.elf
// Run:     chmod +x /tmp/reg_plot.elf && /tmp/reg_plot.elf

use stats::regression::linear::{linear_regression_new}
use graphics::surface::{surface_new, surface_clear}
use graphics::drawing::{color_white}
use graphics::epistemic::{plot_epistemic_band_raster, epistemic_band_config_default}
use graphics::view
use graphics::export::{export_png}

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i64 with IO, Mut, Div, Panic {
    var xs: [f64; 100] = [0.0; 100]
    var ys: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < 20 {
        let idx = i as usize
        xs[idx] = i as f64
        let noise = if i % 3 == 0 { 0.4 } else if i % 3 == 1 { 0.0 - 0.3 } else { 0.1 }
        ys[idx] = 2.0 + 1.5 * (i as f64) + noise
        i = i + 1
    }

    let model = linear_regression_new()
        .with_data(xs, ys, 20)
        .fit_simple()

    println("=== Regressão linear OLS ===")
    println("beta0=")
    println(model.coefficients[0])
    println("beta1=")
    println(model.coefficients[1])
    println("R2=")
    println(model.r_squared)

    var xs_plot: [f64; 256] = [0.0; 256]
    var center: [f64; 256] = [0.0; 256]
    var lower: [f64; 256] = [0.0; 256]
    var upper: [f64; 256] = [0.0; 256]
    i = 0
    while i < 20 {
        let idx = i as usize
        xs_plot[idx] = xs[idx]
        let yhat = model.coefficients[0] + model.coefficients[1] * xs[idx]
        center[idx] = yhat
        lower[idx] = yhat - 0.8
        upper[idx] = yhat + 0.8
        i = i + 1
    }

    var s = surface_new(480, 320)
    s = surface_clear(s, color_white())
    let cfg = epistemic_band_config_default()
    s = plot_epistemic_band_raster(s, &xs_plot, &center, &lower, &upper, 20, cfg)

    println("\n--- Terminal preview ---")
    view::show(&s)

    let png_ok = export_png(&s, "/tmp/sounio_regression_band.png")
    println("PNG ok=")
    println(if png_ok { 1 } else { 0 })

    // Nota: OLS stdlib ainda em maturação — este demo valida o pipeline stats→plot.
    if png_ok {
        println("REGRESSION_PLOT_DEMO_PASS")
        0
    } else {
        println("REGRESSION_PLOT_DEMO_FAIL")
        1
    }
}
