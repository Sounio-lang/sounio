//! Test program for zstd compression module
//!
//! Demonstrates basic usage of the zstd compression functions.

// Note: This would use `use compress::zstd::*;` when modules work
// For now, assume functions are available

fn main() with IO, Alloc, Panic {
    println("Testing Zstandard Compression")
    println("==============================")

    // Test 1: Simple compression/decompression
    println("")
    println("Test 1: Basic round-trip")
    let message = [72, 101, 108, 108, 111, 44, 32, 90, 115, 116, 100, 33]  // "Hello, Zstd!"
    let original_len: usize = 12

    println("Original size: 12 bytes")

    // Compress at level 3 (default)
    let compressed = zstd_compress(&message, original_len, 3)
    match compressed {
        Some(comp_data) => {
            println("Compressed size:")
            println(comp_data.len())

            // Decompress
            let decompressed = zstd_decompress(&comp_data, comp_data.len())
            match decompressed {
                Some(orig) => {
                    println("Decompressed size:")
                    println(orig.len())

                    // Verify
                    var match_ok = true
                    if orig.len() == original_len {
                        var i: usize = 0
                        while i < original_len {
                            if orig[i] != message[i] {
                                match_ok = false
                                break
                            }
                            i = i + 1
                        }
                    } else {
                        match_ok = false
                    }

                    if match_ok {
                        println("✓ Round-trip successful!")
                    } else {
                        println("✗ Data mismatch!")
                    }
                }
                None => {
                    println("✗ Decompression failed")
                }
            }
        }
        None => {
            println("✗ Compression failed")
        }
    }

    // Test 2: Different compression levels
    println("")
    println("Test 2: Compression levels")
    let data = [65, 65, 65, 65, 65, 65, 65, 65, 65, 65, 65, 65]  // "AAAAAAAAAAAA"
    let data_len: usize = 12

    let fast = zstd_compress(&data, data_len, 1)
    match fast {
        Some(f) => {
            println("Level 1 (fast):")
            println(f.len())
        }
        None => {
            println("Level 1 failed")
        }
    }

    let balanced = zstd_compress(&data, data_len, 3)
    match balanced {
        Some(b) => {
            println("Level 3 (default):")
            println(b.len())
        }
        None => {
            println("Level 3 failed")
        }
    }

    let best = zstd_compress(&data, data_len, 19)
    match best {
        Some(b) => {
            println("Level 19 (best):")
            println(b.len())
        }
        None => {
            println("Level 19 failed")
        }
    }

    // Test 3: Error handling
    println("")
    println("Test 3: Error handling")

    let invalid_level = zstd_compress(&data, data_len, 100)
    match invalid_level {
        Some(_) => {
            println("✗ Should have rejected invalid level")
        }
        None => {
            println("✓ Correctly rejected level 100")
        }
    }

    let bad_compressed = [255, 255, 255, 255]
    let invalid_decomp = zstd_decompress(&bad_compressed, 4)
    match invalid_decomp {
        Some(_) => {
            println("✗ Should have rejected invalid data")
        }
        None => {
            println("✓ Correctly rejected bad data")
        }
    }

    println("")
    println("All tests complete!")
}
