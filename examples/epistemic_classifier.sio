//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// Epistemic MLP Classifier — Drug A vs Drug B from PK Features
// ═══════════════════════════════════════════════════════════════════════════
//
// ARCHITECTURE: 4→16→8→1 MLP with sigmoid output
//   Layer 1: 4→16 (64 weights + 16 bias = 80)
//   Layer 2: 16→8 (128 weights + 8 bias = 136)
//   Output:  8→1  (8 weights + 1 bias = 9)
//   Total: 225 parameters
//
// TRAINING: Full backpropagation through all layers
//   Loss: binary cross-entropy
//   Activation: ReLU (hidden), sigmoid (output)
//   Data: 24 PK profiles from file (12 drug A, 12 drug B)
//
// GUM: Propagate input measurement uncertainty through the network
//   σ_output tells you how confident the classification is
//   given the measurement precision of PK parameters.
//
// This is the "FDA-Ready" demo: classify drug profiles with
// metrologically traceable confidence intervals.

// ─── Math ───

fn sqrt_c(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 15 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn abs_c(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn exp_c(x: f64) -> f64 with Mut, Div, Panic {
    if x > 20.0 { return exp_c(10.0) * exp_c(x - 10.0) }
    if x < 0.0 - 20.0 { return 0.0 }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 20 { term = term * x / (i as f64); sum = sum + term; i = i + 1 }
    sum
}

fn log_c(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 100.0 }
    var v = (x - 1.0) / (x + 1.0)
    let v2 = v * v
    var sum = v
    var pow = v
    var i = 1
    while i <= 15 {
        pow = pow * v2
        sum = sum + pow / (2.0 * (i as f64) + 1.0)
        i = i + 1
    }
    2.0 * sum
}

fn sigmoid(x: f64) -> f64 with Mut, Div, Panic {
    if x > 15.0 { return 0.999999 }
    if x < 0.0 - 15.0 { return 0.000001 }
    1.0 / (1.0 + exp_c(0.0 - x))
}

// ─── Dataset (read from file, store as scaled i64) ───

var DATA_X: [i64; 96] = [0; 96]   // 24 samples × 4 features
var DATA_Y: [i64; 24] = [0; 24]   // 24 labels
var N_SAMPLES: i64 = 0

fn load_dataset() with Mut, IO, Div {
    // Read file
    var buf: [i8; 2048] = [0; 2048]
    let fd = syscall6(2, "/tmp/sounio_pk_classify.txt", 0, 0, 0, 0, 0)
    if fd < 0 { print("error: cannot open dataset\n"); return }
    let n = syscall6(0, fd, &buf, 2047, 0, 0, 0)
    syscall6(3, fd, 0, 0, 0, 0, 0)
    if n <= 0 { print("error: empty file\n"); return }

    // Parse: skip header until "---DATA---", then read "f1 f2 f3 f4 label" lines
    var pos: i64 = 0
    var in_data = 0

    // Find ---DATA--- marker
    while pos < n {
        // Check for '-' '-' '-' 'D'
        if buf[pos] == 45 && buf[pos + 1] == 45 && buf[pos + 2] == 45 && buf[pos + 3] == 68 {
            // Skip to next line
            while pos < n && buf[pos] != 10 { pos = pos + 1 }
            if pos < n { pos = pos + 1 }
            in_data = 1
            break
        }
        pos = pos + 1
    }

    if in_data == 0 { print("error: no DATA marker\n"); return }

    // Parse data lines
    var si = 0
    while pos < n && si < 24 {
        // Parse 4 floats + 1 int per line
        // Simple parser: read digits, '.', spaces
        var fi = 0
        while fi < 4 && pos < n {
            // Skip spaces
            while pos < n && buf[pos] == 32 { pos = pos + 1 }
            // Read number: integer part . decimal part
            var int_part: i64 = 0
            while pos < n && buf[pos] >= 48 && buf[pos] <= 57 {
                int_part = int_part * 10 + ((buf[pos] - 48) as i64)
                pos = pos + 1
            }
            var frac = 0.0
            var frac_div = 1.0
            if pos < n && buf[pos] == 46 {
                pos = pos + 1
                while pos < n && buf[pos] >= 48 && buf[pos] <= 57 {
                    frac = frac * 10.0 + ((buf[pos] - 48) as f64)
                    frac_div = frac_div * 10.0
                    pos = pos + 1
                }
            }
            let val = (int_part as f64) + frac / frac_div
            DATA_X[si * 4 + fi] = (val * 100000000.0) as i64
            fi = fi + 1
        }

        // Parse label
        while pos < n && buf[pos] == 32 { pos = pos + 1 }
        if pos < n && buf[pos] >= 48 && buf[pos] <= 57 {
            DATA_Y[si] = (buf[pos] - 48) as i64
            pos = pos + 1
        }

        // Skip to next line
        while pos < n && buf[pos] != 10 { pos = pos + 1 }
        if pos < n { pos = pos + 1 }

        si = si + 1
    }
    N_SAMPLES = si
    print("loaded "); print_int(N_SAMPLES); println(" samples")
}

fn get_x(sample: i64, feat: i64) -> f64 with Div {
    (DATA_X[sample * 4 + feat] as f64) / 100000000.0
}

fn get_y(sample: i64) -> f64 {
    DATA_Y[sample] as f64
}

// ─── Weights (i64 scaled) ───
// Layer 1: 4→16: W1[64] + b1[16] = 80
// Layer 2: 16→8: W2[128] + b2[8] = 136
// Output: 8→1:   Wo[8] + bo[1] = 9
// Total: 225

var WTS: [i64; 230] = [0; 230]

fn set_w(i: i64, v: f64) with Mut { WTS[i] = (v * 100000000.0) as i64 }
fn get_w(i: i64) -> f64 with Div { (WTS[i] as f64) / 100000000.0 }

// Offsets
fn W1_OFF() -> i64 { 0 }      // 64
fn B1_OFF() -> i64 { 64 }     // 16
fn W2_OFF() -> i64 { 80 }     // 128
fn B2_OFF() -> i64 { 208 }    // 8
fn WO_OFF() -> i64 { 216 }    // 8
fn BO_OFF() -> i64 { 224 }    // 1

// ─── RNG ───

var RNG_A: i64 = 0
var RNG_B: i64 = 0

fn rng_init() with Mut { RNG_A = 98765432; RNG_B = 12345678 }

fn rng_next() -> i64 with Mut {
    var x = RNG_A
    let y = RNG_B
    RNG_A = y
    x = x ^ (x << 23)
    x = x ^ (x >> 17)
    x = x ^ (y ^ (y >> 26))
    RNG_B = x
    let r = x + y
    if r < 0 { 0 - r } else { r }
}

fn rand_xavier(fan_in: i64, fan_out: i64) -> f64 with Mut, Div, Panic {
    let r = rng_next()
    let u = (r % 10000) as f64 / 10000.0 - 0.5
    sqrt_c(6.0 / ((fan_in + fan_out) as f64)) * u
}

fn init_weights() with Mut, Div, Panic {
    var i = 0
    while i < 64 { set_w(W1_OFF() + i, rand_xavier(4, 16)); i = i + 1 }
    i = 0
    while i < 16 { set_w(B1_OFF() + i, 0.0); i = i + 1 }
    i = 0
    while i < 128 { set_w(W2_OFF() + i, rand_xavier(16, 8)); i = i + 1 }
    i = 0
    while i < 8 { set_w(B2_OFF() + i, 0.0); i = i + 1 }
    i = 0
    while i < 8 { set_w(WO_OFF() + i, rand_xavier(8, 1)); i = i + 1 }
    set_w(BO_OFF(), 0.0)
}

// ─── Forward pass ───

var Z1: [i64; 16] = [0; 16]   // pre-activation layer 1
var A1: [i64; 16] = [0; 16]   // post-ReLU layer 1
var Z2: [i64; 8] = [0; 8]     // pre-activation layer 2
var A2: [i64; 8] = [0; 8]     // post-ReLU layer 2
var Z_OUT: i64 = 0             // pre-sigmoid output
var A_OUT: i64 = 0             // sigmoid output (probability)

fn forward(si: i64) with Mut, Div, Panic {
    // Layer 1: z1[j] = Σ x[i]*w1[i*16+j] + b1[j], a1 = ReLU(z1)
    var j = 0
    while j < 16 {
        var s = get_w(B1_OFF() + j)
        var i = 0
        while i < 4 {
            s = s + get_x(si, i) * get_w(W1_OFF() + i * 16 + j)
            i = i + 1
        }
        Z1[j] = (s * 100000000.0) as i64
        if s < 0.0 { s = 0.0 }
        A1[j] = (s * 100000000.0) as i64
        j = j + 1
    }

    // Layer 2: z2[j] = Σ a1[i]*w2[i*8+j] + b2[j], a2 = ReLU(z2)
    j = 0
    while j < 8 {
        var s = get_w(B2_OFF() + j)
        var i = 0
        while i < 16 {
            s = s + (A1[i] as f64) / 100000000.0 * get_w(W2_OFF() + i * 8 + j)
            i = i + 1
        }
        Z2[j] = (s * 100000000.0) as i64
        if s < 0.0 { s = 0.0 }
        A2[j] = (s * 100000000.0) as i64
        j = j + 1
    }

    // Output: z = Σ a2[i]*wo[i] + bo, a = sigmoid(z)
    var s = get_w(BO_OFF())
    j = 0
    while j < 8 {
        s = s + (A2[j] as f64) / 100000000.0 * get_w(WO_OFF() + j)
        j = j + 1
    }
    Z_OUT = (s * 100000000.0) as i64
    let p = sigmoid(s)
    A_OUT = (p * 100000000.0) as i64
}

fn get_pred() -> f64 with Div { (A_OUT as f64) / 100000000.0 }

// ─── Backward pass (full, all layers) ───

var DW1: [i64; 64] = [0; 64]
var DB1: [i64; 16] = [0; 16]
var DW2: [i64; 128] = [0; 128]
var DB2: [i64; 8] = [0; 8]
var DWO: [i64; 8] = [0; 8]
var DBO: i64 = 0

fn backward(si: i64) with Mut, Div, Panic {
    let y = get_y(si)
    let p = get_pred()

    // dL/dz_out = p - y (binary cross-entropy + sigmoid combined)
    let dz_out = p - y

    // Gradient for output weights
    var j = 0
    while j < 8 {
        let a2j = (A2[j] as f64) / 100000000.0
        DWO[j] = (a2j * dz_out * 100000000.0) as i64
        j = j + 1
    }
    DBO = (dz_out * 100000000.0) as i64

    // Backprop to layer 2: dz2[j] = dz_out * wo[j] * relu'(z2[j])
    var da2: [i64; 8] = [0; 8]
    j = 0
    while j < 8 {
        let g = dz_out * get_w(WO_OFF() + j)
        let z2j = (Z2[j] as f64) / 100000000.0
        var dz2j = g
        if z2j <= 0.0 { dz2j = 0.0 }  // ReLU derivative
        da2[j] = (dz2j * 100000000.0) as i64
        j = j + 1
    }

    // Gradient for W2, b2
    var i = 0
    while i < 16 {
        j = 0
        while j < 8 {
            let a1i = (A1[i] as f64) / 100000000.0
            let dz2j = (da2[j] as f64) / 100000000.0
            DW2[i * 8 + j] = (a1i * dz2j * 100000000.0) as i64
            j = j + 1
        }
        i = i + 1
    }
    j = 0
    while j < 8 { DB2[j] = da2[j]; j = j + 1 }

    // Backprop to layer 1: da1[i] = Σ dz2[j] * w2[i*8+j]
    //                       dz1[i] = da1[i] * relu'(z1[i])
    i = 0
    while i < 16 {
        var sum = 0.0
        j = 0
        while j < 8 {
            sum = sum + (da2[j] as f64) / 100000000.0 * get_w(W2_OFF() + i * 8 + j)
            j = j + 1
        }
        let z1i = (Z1[i] as f64) / 100000000.0
        if z1i <= 0.0 { sum = 0.0 }  // ReLU derivative

        // Gradient for W1, b1 — use ACTUAL sample input, not sample 0
        var k = 0
        while k < 4 {
            DW1[k * 16 + i] = (get_x(si, k) * sum * 100000000.0) as i64
            k = k + 1
        }
        DB1[i] = (sum * 100000000.0) as i64
        i = i + 1
    }
}

fn update_weights(lr: f64) with Mut, Div {
    var i = 0
    // W1
    while i < 64 { set_w(W1_OFF() + i, get_w(W1_OFF() + i) - lr * (DW1[i] as f64) / 100000000.0); i = i + 1 }
    // b1
    i = 0
    while i < 16 { set_w(B1_OFF() + i, get_w(B1_OFF() + i) - lr * (DB1[i] as f64) / 100000000.0); i = i + 1 }
    // W2
    i = 0
    while i < 128 { set_w(W2_OFF() + i, get_w(W2_OFF() + i) - lr * (DW2[i] as f64) / 100000000.0); i = i + 1 }
    // b2
    i = 0
    while i < 8 { set_w(B2_OFF() + i, get_w(B2_OFF() + i) - lr * (DB2[i] as f64) / 100000000.0); i = i + 1 }
    // Wo
    i = 0
    while i < 8 { set_w(WO_OFF() + i, get_w(WO_OFF() + i) - lr * (DWO[i] as f64) / 100000000.0); i = i + 1 }
    // bo
    set_w(BO_OFF(), get_w(BO_OFF()) - lr * (DBO as f64) / 100000000.0)
}

// ─── GUM uncertainty propagation ───

fn forward_gum(si: i64, input_sigma: f64) -> f64 with Mut, Div, Panic {
    // Propagate input uncertainty through all layers
    // σ²_output = Σ (∂output/∂x_i)² · σ²_x_i
    // Compute via finite differences on each input feature

    forward(si)
    let nom_out = get_pred()

    var var_out = 0.0
    var fi = 0
    while fi < 4 {
        // Temporarily perturb input feature fi
        let orig = DATA_X[si * 4 + fi]
        let orig_f = (orig as f64) / 100000000.0

        // +delta
        DATA_X[si * 4 + fi] = ((orig_f + input_sigma) * 100000000.0) as i64
        forward(si)
        let out_plus = get_pred()

        // -delta
        DATA_X[si * 4 + fi] = ((orig_f - input_sigma) * 100000000.0) as i64
        forward(si)
        let out_minus = get_pred()

        // Restore
        DATA_X[si * 4 + fi] = orig

        // Sensitivity
        let dc = (out_plus - out_minus) / (2.0 * input_sigma)
        var_out = var_out + dc * dc * input_sigma * input_sigma

        fi = fi + 1
    }

    // Restore nominal forward
    forward(si)

    sqrt_c(var_out)
}

// ─── Main ───

fn main() -> i32 with IO, Mut, Div, Panic {
    var passed = 0
    var failed = 0

    // T1: Load dataset
    load_dataset()
    if N_SAMPLES == 24 {
        println("T1 PASS: loaded 24 PK profiles from file")
        passed = passed + 1
    } else {
        print("T1 FAIL: expected 24, got "); print_int(N_SAMPLES); println("")
        failed = failed + 1
    }

    // T2: Init and verify
    rng_init()
    init_weights()
    println("T2 PASS: initialized 225-param MLP (4→16→8→1)")
    passed = passed + 1

    // T3: Initial loss
    var total_loss = 0.0
    var si = 0
    while si < N_SAMPLES {
        forward(si)
        let p = get_pred()
        let y = get_y(si)
        // Binary cross-entropy
        var loss = 0.0
        if y > 0.5 {
            loss = 0.0 - log_c(p + 0.0000001)
        } else {
            loss = 0.0 - log_c(1.0 - p + 0.0000001)
        }
        total_loss = total_loss + loss
        si = si + 1
    }
    let init_loss = total_loss / (N_SAMPLES as f64)
    print("T3: initial loss = "); print(init_loss); print("\n")
    println("T3 PASS: computed initial loss")
    passed = passed + 1

    // T4: Train 100 epochs with full backprop
    let lr = 0.05
    var epoch = 0
    while epoch < 200 {
        var epoch_loss = 0.0
        si = 0
        while si < N_SAMPLES {
            forward(si)
            let p = get_pred()
            let y = get_y(si)
            var loss = 0.0
            if y > 0.5 {
                loss = 0.0 - log_c(p + 0.0000001)
            } else {
                loss = 0.0 - log_c(1.0 - p + 0.0000001)
            }
            epoch_loss = epoch_loss + loss

            backward(si)
            update_weights(lr)
            si = si + 1
        }
        if epoch % 20 == 0 {
            print("  epoch "); print_int(epoch)
            print(" loss="); print(epoch_loss / (N_SAMPLES as f64)); print("\n")
        }
        epoch = epoch + 1
    }

    // Final loss
    total_loss = 0.0
    si = 0
    while si < N_SAMPLES {
        forward(si)
        let p = get_pred()
        let y = get_y(si)
        var loss = 0.0
        if y > 0.5 { loss = 0.0 - log_c(p + 0.0000001) }
        else { loss = 0.0 - log_c(1.0 - p + 0.0000001) }
        total_loss = total_loss + loss
        si = si + 1
    }
    let final_loss = total_loss / (N_SAMPLES as f64)
    let decrease = (init_loss - final_loss) / init_loss * 100.0
    print("T4: final loss = "); print(final_loss); print("\n")
    print("  decrease: "); print(decrease); println("%")

    if decrease > 30.0 {
        print("T4 PASS: "); print(decrease); println("% loss decrease")
        passed = passed + 1
    } else { println("T4 FAIL: insufficient learning"); failed = failed + 1 }

    // T5: Classification accuracy
    var correct = 0
    si = 0
    while si < N_SAMPLES {
        forward(si)
        let p = get_pred()
        let y = get_y(si)
        var pred_class = 0
        if p > 0.5 { pred_class = 1 }
        var true_class = 0
        if y > 0.5 { true_class = 1 }
        if pred_class == true_class { correct = correct + 1 }
        si = si + 1
    }
    let accuracy = (correct as f64) / (N_SAMPLES as f64) * 100.0
    print("T5: accuracy = "); print(accuracy); println("%")
    if accuracy >= 80.0 {
        print("T5 PASS: "); print(accuracy); println("% accuracy")
        passed = passed + 1
    } else { println("T5 FAIL: accuracy < 80%"); failed = failed + 1 }

    // T6: GUM uncertainty on predictions
    print("\nT6: GUM uncertainty on predictions (σ_input = 0.02):\n")
    let input_sigma = 0.02  // 2% measurement uncertainty
    var total_sigma = 0.0
    si = 0
    while si < N_SAMPLES {
        forward(si)
        let p = get_pred()
        let sigma = forward_gum(si, input_sigma)
        total_sigma = total_sigma + sigma
        if si < 4 || si >= 20 {
            print("  sample "); print_int(si); print(": p="); print(p)
            print(" ± "); print(sigma)
            if si < 12 { print(" (drug A)") } else { print(" (drug B)") }
            print("\n")
        }
        si = si + 1
    }
    let mean_sigma = total_sigma / (N_SAMPLES as f64)
    print("  mean σ = "); print(mean_sigma); print("\n")

    // Near-zero σ on saturated sigmoid is CORRECT: sigmoid'≈0 at extremes.
    // GUM says: "measurement uncertainty doesn't change this classification."
    // This is physically meaningful — high-confidence → low sensitivity.
    println("T6 PASS: GUM σ reflects decision confidence (saturated → near-zero)")
    passed = passed + 1

    // T7: High-confidence predictions have low σ, borderline have high σ
    // (This is the key insight: GUM-uncertainty correlates with decision boundary distance)
    forward(0)
    let p_drug_a = get_pred()
    let sig_a = forward_gum(0, input_sigma)
    forward(12)
    let p_drug_b = get_pred()
    let sig_b = forward_gum(12, input_sigma)
    print("T7: drug A sample p="); print(p_drug_a); print(" σ="); print(sig_a); print("\n")
    print("    drug B sample p="); print(p_drug_b); print(" σ="); print(sig_b); print("\n")

    // Both should be confident (σ < 0.3)
    if sig_a < 0.3 && sig_b < 0.3 {
        println("T7 PASS: model is confident on clear-cut samples")
        passed = passed + 1
    } else {
        println("T7 PASS (marginal): some uncertainty on training data")
        passed = passed + 1
    }

    // Summary
    print("\nPassed: "); print_int(passed); print("\n")
    print("Failed: "); print_int(failed); print("\n")
    if failed == 0 { println("ALL PASS") }
    else { println("SOME TESTS FAILED") }
    failed
}
