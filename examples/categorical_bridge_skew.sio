//@ run-pass
// CATEGORICAL BRIDGE — Part 1: Skew Associator Classification
//
// In a skew monoidal category (Lack-Street 2012), the associator
//   alpha: (A ⊗ B) ⊗ C → A ⊗ (B ⊗ C)
// is a morphism but NOT necessarily an isomorphism.
//
// For Cayley-Dickson algebras, the associator of basis elements is:
//   [e_i, e_j, e_k] = (e_i · e_j) · e_k - e_i · (e_j · e_k)
//                    = (alpha - beta) · e_{i⊕j⊕k}
// where alpha = σ(i,j)·σ(i⊕j,k) and beta = σ(j,k)·σ(i,j⊕k).
//
// FANO TRIPLES (alpha = beta): the associator is ZERO.
//   The associator morphism IS an isomorphism (both directions exist).
//   Parenthesization doesn't matter. The Tamari rotation is invertible.
//
// NON-FANO TRIPLES (alpha ≠ beta): the associator is ±2.
//   The associator morphism is DIRECTED — it goes one way only.
//   Parenthesization DOES matter. The Tamari rotation is one-way.
//   This is "skew" in the categorical sense.
//
// For octonions (k=3): exactly 175 Fano + 168 non-Fano = 343.
// 168 = |PSL(2,7)|, the automorphism group of the Fano plane PG(2,2).
//
// References:
//   Lack & Street (2012), "Skew monoidales, skew warpings and quantum categories"
//   Szlachányi (2012), "Skew-monoidal categories and bialgebroids"
//   Tamari (1962), "The algebra of bracketings and their enumeration"
//   Agourakis (2026), "The 168 Theorem"

fn cd_sigma_rec(a: i32, b: i32, bits: i32) -> i32 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_rec(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_rec(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_rec(a_lo, b_lo, bits - 1) }
        else { return 0 - cd_sigma_rec(a_lo, b_lo, bits - 1) }
    }
    if b_lo == 0 { return 0 - cd_sigma_rec(b_lo, a_lo, bits - 1) }
    cd_sigma_rec(b_lo, a_lo, bits - 1)
}

fn cd_sigma(a: i32, b: i32) -> i32 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if a == b { return 0 - 1 }
    cd_sigma_rec(a, b, 3)
}

fn main() -> i32 with Mut, Panic, Div, IO {
    println("=== CATEGORICAL BRIDGE Part 1: Skew Associator Classification ===")
    println("")
    println("Classifying all 7^3 = 343 ordered triples of imaginary octonion basis elements.")
    println("For each triple (i,j,k):")
    println("  alpha = sigma(i,j) * sigma(i^j, k)   [left parenthesization sign]")
    println("  beta  = sigma(j,k) * sigma(i, j^k)   [right parenthesization sign]")
    println("  wave  = alpha - beta                  [associator coefficient]")
    println("")

    var fano_count: i32 = 0
    var non_fano_count: i32 = 0
    var wave_plus2: i32 = 0
    var wave_minus2: i32 = 0
    var wave_other: i32 = 0

    // Count and classify all 343 triples
    var i: i32 = 1
    while i <= 7 {
        var j: i32 = 1
        while j <= 7 {
            var k: i32 = 1
            while k <= 7 {
                let alpha = cd_sigma(i, j) * cd_sigma(i ^ j, k)
                let beta = cd_sigma(j, k) * cd_sigma(i, j ^ k)
                let wave = alpha - beta

                if wave == 0 {
                    fano_count = fano_count + 1
                } else {
                    non_fano_count = non_fano_count + 1
                    if wave == 2 { wave_plus2 = wave_plus2 + 1 }
                    else if wave == 0 - 2 { wave_minus2 = wave_minus2 + 1 }
                    else { wave_other = wave_other + 1 }
                }

                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    println("=== RESULTS ===")
    println("")
    println("Fano triples (wave = 0, associator INVERTIBLE):")
    println(fano_count)
    println("Non-Fano triples (wave != 0, associator DIRECTED):")
    println(non_fano_count)
    println("")
    println("Non-Fano breakdown:")
    println("  wave = +2 (skew-right):")
    println(wave_plus2)
    println("  wave = -2 (skew-left):")
    println(wave_minus2)
    println("  wave = other (should be 0!):")
    println(wave_other)
    println("")

    // === ASSERTIONS ===

    // Theorem A (Binary Norm): wave ∈ {0, +2, -2} for all triples
    assert(wave_other == 0)

    // The 168 Theorem: exactly 175 Fano + 168 non-Fano = 343
    assert(fano_count == 175)
    assert(non_fano_count == 168)
    assert(fano_count + non_fano_count == 343)

    // Perfect balance: +2 and -2 appear equally often
    assert(wave_plus2 == wave_minus2)
    assert(wave_plus2 == 84)

    println("=== ALL ASSERTIONS PASSED ===")
    println("")
    println("INTERPRETATION:")
    println("  175 Fano triples → associator is ISOMORPHISM (both directions)")
    println("    Tamari rotation: ((a*b)*c) <-> (a*(b*c)) is invertible")
    println("    In the skew monoidal category: assocR has an inverse assocL")
    println("")
    println("  168 non-Fano triples → associator is DIRECTED MORPHISM (one way only)")
    println("    Tamari rotation: ((a*b)*c) -> (a*(b*c)) exists but NOT the reverse")
    println("    In the skew monoidal category: assocR exists but assocL does NOT")
    println("    This is GENUINE SKEWNESS — the category is not monoidal, only skew-monoidal")
    println("")
    println("  168 = |PSL(2,7)| = automorphism group of the Fano plane PG(2,2)")
    println("  The Fano plane is the BOUNDARY between invertible and directed associators.")
    println("")
    println("This is Fano-Selective Invertibility:")
    println("  The invertibility of the associator depends on the GEOMETRY of the triple,")
    println("  determined by the Fano plane of the projective geometry PG(2,2).")

    0
}
