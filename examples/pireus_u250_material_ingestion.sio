//@ run-pass
//!
//! Sounio authority classification of one sealed U250 material observation.

use hardware::pireus::u250_material_ingestion::{
    pireus_u250_material_ingest_files,
    pireus_u250_material_ingestion_matches_expected,
}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    if arg_count() != 2 {
        print("usage: pireus_u250_material_ingestion <raw-probe> <receipt>\n")
        return 2
    }
    let result = pireus_u250_material_ingest_files(get_arg(0), get_arg(1))
    print("SOUNIO_SEMANTIC_AUTHORITY schema=pireus.u250-material-ingestion.v1 stage=PARITY_OPEN\n")
    print("PIREUS_U250_MATERIAL_INGEST valid=")
    print_int(yes(result.valid))
    print(" status="); print_int(result.status)
    print(" raw_probe_valid="); print_int(yes(result.raw_probe_valid))
    print(" parity_receipt_valid=")
    print_int(yes(result.parity_receipt_valid))
    print(" classification_requested=")
    print_int(yes(result.classification_requested))
    print(" classification_allowed=")
    print_int(yes(result.classification_allowed))
    print(" child_verdict=")
    print_int(yes(result.semantic_verdict_emitted_by_child))
    print(" declared="); print_int(result.declared_card_count)
    print(" slots="); print_int(result.material_slot_count)
    print(" discovered="); print_int(result.discovered_card_count)
    print(" admitted="); print_int(result.admitted_card_count)
    print(" rejected="); print_int(result.rejected_card_count)
    print(" missing="); print_int(result.missing_card_count)
    print(" inventory_complete="); print_int(yes(result.inventory_complete))
    print(" material_parity_ready=")
    print_int(yes(result.material_parity_ready))
    print(" parity_open="); print_int(yes(result.parity_open))
    print(" claim_ready="); print_int(yes(result.claim_ready))
    print(" failures="); print_int(result.failures)
    print("\n")
    if pireus_u250_material_ingestion_matches_expected(&result) {
        0
    } else { 1 }
}
