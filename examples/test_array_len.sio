// Test array_len and array_ptr builtins

fn main() {
    println("=== Testing array_len builtin ===")

    // Create arrays of different sizes
    let arr1 = [1.0, 2.0, 3.0]
    let arr2 = [10.0, 20.0]
    let arr3 = [100.0, 200.0, 300.0, 400.0, 500.0]

    // Get array pointers as i64
    let ptr1 = arr1 as i64
    let ptr2 = arr2 as i64
    let ptr3 = arr3 as i64

    // Test array_len
    let len1 = array_len(ptr1)
    let len2 = array_len(ptr2)
    let len3 = array_len(ptr3)

    println("Array 1 length: ")
    println(len1)
    println("Expected: 3")

    println("Array 2 length: ")
    println(len2)
    println("Expected: 2")

    println("Array 3 length: ")
    println(len3)
    println("Expected: 5")

    println("")
    println("=== Testing array_ptr builtin ===")

    // Get pointer to data (skipping length header)
    let data1 = array_ptr(ptr1)
    println("Data pointer offset from array: ")
    let offset = data1 - ptr1
    println(offset)
    println("Expected: 8 (size of length header)")

    println("")
    println("All tests passed!")
}
