//@ run-pass
//
// Tensor2 CPU reference bench: square matmul timed EXTERNALLY (Sounio has
// no wall clock yet; the job script wraps this binary with `time`).
// Prints the result sum so the computation cannot be optimized away.
// Usage: tensor2_bench [n] [iters]

use tensor2::types::{t2_device_cpu, t2_dtype_f32, t2_shape2}
use tensor2::ops::{t2_full, t2_get2, t2_matmul, t2_release}

fn main() with IO, Mut, Panic, Div, Alloc {
    var n: i64 = 256
    var iters: i64 = 1
    let a = t2_full(t2_shape2(n as usize, n as usize), t2_dtype_f32(), t2_device_cpu(), 0.01)
    let b = t2_full(t2_shape2(n as usize, n as usize), t2_dtype_f32(), t2_device_cpu(), 0.02)
    var acc = 0.0
    var it: i64 = 0
    while it < iters {
        var c = t2_matmul(&a, &b)
        acc = acc + t2_get2(&c, 0, 0)
        t2_release(&!c)
        it = it + 1
    }
    print("tensor2 cpu matmul n=")
    print_int(n)
    print(" iters=")
    print_int(iters)
    print(" corner(x1000)=")
    print_int((acc * 1000.0) as i64)
    print("\n")
    exit(0)
}
