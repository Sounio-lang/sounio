//! Test runner for reverse-mode AD (stdlib/autodiff/tape.sio)

extern "C" {
    fn printf(fmt: &u8, ...);
}

fn run_tape_tests() -> i32 with Mut, Panic, Div;

fn main() with IO, Mut, Panic, Div {
    printf("=== Reverse-Mode AD Test Suite ===\\n" as &u8)
    printf("\\n" as &u8)

    let passed = run_tape_tests()
    printf("Tests passed: %d" as &u8, passed)
    printf(" / 8\\n" as &u8)
    printf("\\n" as &u8)

    if passed == 8 {
        printf("SUCCESS: All reverse-mode AD tests passed!\\n" as &u8)
    } else {
        printf("FAILURE: Some tests failed\\n" as &u8)
    }
}
