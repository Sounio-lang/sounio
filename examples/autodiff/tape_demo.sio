//! Reverse-Mode Automatic Differentiation Demo
//!
//! Shows tape-based backpropagation for efficient gradient computation.
//! Reverse-mode AD is optimal for ML: one backward pass gives gradients
//! for all inputs, vs forward-mode which requires one pass per input.

extern "C" {
    fn printf(fmt: &u8, ...);
}

// Import tape operations
struct TapeNode {
    value: f64,
    adjoint: f64,
    op: i64,
    parent1: i64,
    parent2: i64,
    aux: f64
}

struct Tape {
    n0: TapeNode, n1: TapeNode, n2: TapeNode, n3: TapeNode, n4: TapeNode,
    n5: TapeNode, n6: TapeNode, n7: TapeNode, n8: TapeNode, n9: TapeNode,
    n10: TapeNode, n11: TapeNode, n12: TapeNode, n13: TapeNode, n14: TapeNode,
    n15: TapeNode, n16: TapeNode, n17: TapeNode, n18: TapeNode, n19: TapeNode,
    size: i64
}

struct Var {
    idx: i64,
    val: f64
}

fn new_tape() -> Tape;
fn tape_new_var(tape: Tape, val: f64) -> Tape;
fn tape_last_var(tape: Tape) -> Var;
fn tape_add(tape: Tape, a: Var, b: Var) -> Tape;
fn tape_sub(tape: Tape, a: Var, b: Var) -> Tape;
fn tape_mul(tape: Tape, a: Var, b: Var) -> Tape;
fn tape_div(tape: Tape, a: Var, b: Var) -> Tape;
fn tape_sin(tape: Tape, a: Var) -> Tape;
fn tape_cos(tape: Tape, a: Var) -> Tape;
fn tape_exp(tape: Tape, a: Var) -> Tape;
fn tape_ln(tape: Tape, a: Var) -> Tape;
fn tape_tanh(tape: Tape, a: Var) -> Tape;
fn tape_sigmoid(tape: Tape, a: Var) -> Tape;
fn backward(tape: Tape, output: Var) -> Tape;
fn get_grad(tape: Tape, v: Var) -> f64;
fn abs_f64(x: f64) -> f64;
fn cos_f64(x: f64) -> f64;

fn main() with IO {
    printf("=== Reverse-Mode Automatic Differentiation Demo ===\\n" as &u8)
    printf("\\n" as &u8)

    // Example 1: f(x) = x² at x=3
    printf("Example 1: f(x) = x² at x=3\\n" as &u8)
    var t1 = new_tape()
    t1 = tape_new_var(t1, 3.0)
    let x1 = tape_last_var(t1)
    t1 = tape_mul(t1, x1, x1)
    let y1 = tape_last_var(t1)
    t1 = backward(t1, y1)
    printf("  f(3) = %f" as &u8, y1.val)
    printf(", df/dx = %f\\n" as &u8, get_grad(t1, x1))
    printf("  Expected: f = 9, df/dx = 6\\n" as &u8)
    printf("\\n" as &u8)

    // Example 2: f(x,y) = x·y at (3,5)
    printf("Example 2: f(x,y) = x·y at (3,5)\\n" as &u8)
    var t2 = new_tape()
    t2 = tape_new_var(t2, 3.0)
    let x2 = tape_last_var(t2)
    t2 = tape_new_var(t2, 5.0)
    let y2 = tape_last_var(t2)
    t2 = tape_mul(t2, x2, y2)
    let z2 = tape_last_var(t2)
    t2 = backward(t2, z2)
    printf("  f(3,5) = %f\\n" as &u8, z2.val)
    printf("  df/dx = %f" as &u8, get_grad(t2, x2))
    printf(", df/dy = %f\\n" as &u8, get_grad(t2, y2))
    printf("  Expected: f = 15, df/dx = 5, df/dy = 3\\n" as &u8)
    printf("\\n" as &u8)

    // Example 3: f(x,y) = x·y + sin(x) at (2,3)
    printf("Example 3: f(x,y) = x·y + sin(x) at (2,3)\\n" as &u8)
    var t3 = new_tape()
    t3 = tape_new_var(t3, 2.0)
    let x3 = tape_last_var(t3)
    t3 = tape_new_var(t3, 3.0)
    let y3 = tape_last_var(t3)
    t3 = tape_mul(t3, x3, y3)
    let xy = tape_last_var(t3)
    t3 = tape_sin(t3, x3)
    let sinx = tape_last_var(t3)
    t3 = tape_add(t3, xy, sinx)
    let f3 = tape_last_var(t3)
    t3 = backward(t3, f3)
    printf("  f(2,3) = %f\\n" as &u8, f3.val)
    printf("  df/dx = %f" as &u8, get_grad(t3, x3))
    printf(", df/dy = %f\\n" as &u8, get_grad(t3, y3))
    printf("  Expected: df/dx = y + cos(x) ≈ 2.58, df/dy = x = 2\\n" as &u8)
    printf("\\n" as &u8)

    // Example 4: Neural network layer: σ(w·x + b)
    printf("Example 4: Neural net layer σ(w·x + b) at w=0.5, x=2, b=0.1\\n" as &u8)
    var t4 = new_tape()
    t4 = tape_new_var(t4, 0.5)
    let w4 = tape_last_var(t4)
    t4 = tape_new_var(t4, 2.0)
    let x4 = tape_last_var(t4)
    t4 = tape_new_var(t4, 0.1)
    let b4 = tape_last_var(t4)
    t4 = tape_mul(t4, w4, x4)
    let wx = tape_last_var(t4)
    t4 = tape_add(t4, wx, b4)
    let wxb = tape_last_var(t4)
    t4 = tape_sigmoid(t4, wxb)
    let out4 = tape_last_var(t4)
    t4 = backward(t4, out4)
    printf("  σ(w·x + b) = %f\\n" as &u8, out4.val)
    printf("  dσ/dw = %f" as &u8, get_grad(t4, w4))
    printf(", dσ/dx = %f" as &u8, get_grad(t4, x4))
    printf(", dσ/db = %f\\n" as &u8, get_grad(t4, b4))
    printf("\\n" as &u8)

    // Example 5: f(x) = exp(ln(x)) = x at x=3
    printf("Example 5: f(x) = exp(ln(x)) at x=3\\n" as &u8)
    var t5 = new_tape()
    t5 = tape_new_var(t5, 3.0)
    let x5 = tape_last_var(t5)
    t5 = tape_ln(t5, x5)
    let lnx = tape_last_var(t5)
    t5 = tape_exp(t5, lnx)
    let f5 = tape_last_var(t5)
    t5 = backward(t5, f5)
    printf("  f(3) = %f" as &u8, f5.val)
    printf(", df/dx = %f\\n" as &u8, get_grad(t5, x5))
    printf("  Expected: f = 3, df/dx = 1\\n" as &u8)
    printf("\\n" as &u8)

    // Example 6: Division f(x,y) = x/y at (6,2)
    printf("Example 6: f(x,y) = x/y at (6,2)\\n" as &u8)
    var t6 = new_tape()
    t6 = tape_new_var(t6, 6.0)
    let x6 = tape_last_var(t6)
    t6 = tape_new_var(t6, 2.0)
    let y6 = tape_last_var(t6)
    t6 = tape_div(t6, x6, y6)
    let f6 = tape_last_var(t6)
    t6 = backward(t6, f6)
    printf("  f(6,2) = %f\\n" as &u8, f6.val)
    printf("  df/dx = %f" as &u8, get_grad(t6, x6))
    printf(", df/dy = %f\\n" as &u8, get_grad(t6, y6))
    printf("  Expected: f = 3, df/dx = 0.5, df/dy = -1.5\\n" as &u8)
    printf("\\n" as &u8)

    // Validation
    let err1 = abs_f64(get_grad(t1, x1) - 6.0)
    let err2_x = abs_f64(get_grad(t2, x2) - 5.0)
    let err2_y = abs_f64(get_grad(t2, y2) - 3.0)
    let err3_x = abs_f64(get_grad(t3, x3) - (3.0 + cos_f64(2.0)))
    let err3_y = abs_f64(get_grad(t3, y3) - 2.0)
    let err5 = abs_f64(get_grad(t5, x5) - 1.0)
    let err6_x = abs_f64(get_grad(t6, x6) - 0.5)
    let err6_y = abs_f64(get_grad(t6, y6) - (0.0 - 1.5))

    let all_pass = err1 < 0.01 && err2_x < 0.01 && err2_y < 0.01 && err3_x < 0.05 && err3_y < 0.01 && err5 < 0.01 && err6_x < 0.01 && err6_y < 0.01

    printf("========================================\\n" as &u8)
    if all_pass {
        printf("✓ ALL EXAMPLES VALIDATED\\n" as &u8)
        printf("Reverse-mode AD working correctly!\\n" as &u8)
    } else {
        printf("✗ VALIDATION FAILED\\n" as &u8)
        printf("Gradient errors detected\\n" as &u8)
    }
    printf("========================================\\n" as &u8)
}
