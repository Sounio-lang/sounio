// examples/erdos/168_chromatic_flip.sio
//
// B probe: chromatic-flip detector — ZD surgery as a chromatic-number control signal.
//
// For each of the 84 ZD surgeries applied to the 14-vertex sedenion probe:
//   1. Run 2-coloring SAT (14 vars, 2 clauses per edge).
//   2. Run 3-coloring SAT (42 vars, 4 clauses per vertex + 3 per edge).
//   Both use NO random background — pure graph structure only.
//
//   From the two results, infer χ (chromatic number):
//     2col SAT  → χ ≤ 2 (bipartite)
//     2col UNSAT, 3col SAT  → χ = 3
//     3col UNSAT            → χ ≥ 4
//
// Falsifiable prediction:
//   At least one ZD surgery changes χ relative to the base (idx=0) graph.
//   If ZD algebra controls chromatic number, different fibers (lo=1..7) should
//   show systematically different χ distributions.
//
// Connection:
//   docs/research/locus-coeruleus-surgical-controller-sounio-note.md §5(c)
//   Goal: B → A → C  (B = chromatic flip, A = Moser spindle UNSAT, C = guided χ≥5 search)

use hypercomplex_graph::erdos_unit_distance::*
use theorem::smt::*

fn pri(x: i32) with IO, Div, Panic {
    if x < 0 { print("-"); pri(0 - x); return }
    if x == 0 { print("0"); return }
    if x >= 10 { pri(x / 10) }
    let d = x - (x / 10) * 10
    if d == 0 { print("0") } if d == 1 { print("1") } if d == 2 { print("2") }
    if d == 3 { print("3") } if d == 4 { print("4") } if d == 5 { print("5") }
    if d == 6 { print("6") } if d == 7 { print("7") } if d == 8 { print("8") }
    if d == 9 { print("9") }
}

fn add2(ctx: &!SmtContext, a: i32, b: i32) with Mut, Div {
    var lits: [i32; 8] = [0; 8]
    lits[0] = a; lits[1] = b
    smt_add_clause(ctx, &lits, 2)
}

fn add3(ctx: &!SmtContext, a: i32, b: i32, c: i32) with Mut, Div {
    var lits: [i32; 8] = [0; 8]
    lits[0] = a; lits[1] = b; lits[2] = c
    smt_add_clause(ctx, &lits, 3)
}

// 2-coloring: 14 vars (var v = "vertex v has color 0").
// Per edge (u,v): (¬u∨¬v) ∧ (u∨v)  — both must differ.
fn add_2col_edges(ctx: &!SmtContext) with Mut, Div {
    var u: i64 = 0
    while u < 14 {
        var v: i64 = u + 1
        while v < 14 {
            if get_adj14_edge(u, v) == 1 {
                let ul = (u as i32) * 2
                let vl = (v as i32) * 2
                add2(ctx, ul + 1, vl + 1)   // ¬u ∨ ¬v  (can't both be color 0)
                add2(ctx, ul,     vl)         // u ∨ v    (can't both be color 1)
            }
            v = v + 1
        }
        u = u + 1
    }
}

// 3-coloring: 42 vars (var = vertex*3 + color).
fn add_3col_base(ctx: &!SmtContext) with Mut, Div {
    var v: i32 = 0
    while v < 14 {
        add3(ctx, (v*3+0)*2, (v*3+1)*2, (v*3+2)*2)   // at-least-one
        add2(ctx, (v*3+0)*2+1, (v*3+1)*2+1)            // at-most-one
        add2(ctx, (v*3+0)*2+1, (v*3+2)*2+1)
        add2(ctx, (v*3+1)*2+1, (v*3+2)*2+1)
        v = v + 1
    }
}

fn add_3col_edges(ctx: &!SmtContext) with Mut, Div {
    var u: i64 = 0
    while u < 14 {
        var v: i64 = u + 1
        while v < 14 {
            if get_adj14_edge(u, v) == 1 {
                var c: i32 = 0
                while c < 3 {
                    let uv = (u as i32) * 3 + c
                    let vv = (v as i32) * 3 + c
                    add2(ctx, uv*2+1, vv*2+1)
                    c = c + 1
                }
            }
            v = v + 1
        }
        u = u + 1
    }
}

// chi_bracket: 0 = χ≤2 (bipartite), 1 = χ=3, 2 = χ≥4
// Encoded as: r2col=0 → bipartite; r2col≠0 && r3col=0 → χ=3; r3col≠0 → χ≥4
// (Convention from Phase 0: r=1 means SAT with 0 conflicts → solver found coloring.
//  We treat r=1,confl=0 as SAT; any other outcome = UNSAT proxy.)
fn chi_bracket(r2: i32, c2: i32, r3: i32, c3: i32) -> i32 {
    // r=1 AND confl=0 → trivially SAT (coloring found immediately)
    // r=1 AND confl>0 → SAT after search
    // r≠1 OR (we infer UNSAT from confl+hardness pattern) → treat as UNSAT
    // From Phase 0: SAT = r==1. Use that convention.
    if r2 == 1 { return 0 }               // 2-colorable → bipartite
    if r3 == 1 { return 1 }               // 3-colorable, not 2-colorable → χ=3
    return 2                               // neither → χ≥4
}

fn main() with IO, Mut, Div, Panic {
    build_prims()
    init_probe14_pub()

    print("=== B: Chromatic-flip detector — ZD surgery vs χ ===\n")
    print("14-vertex sedenion probe, 84 ZD surgeries.\n")
    print("2-col: 14 vars, 2 cls/edge. 3-col: 42 vars, 4 cls/v + 3 cls/edge. No background.\n\n")
    print("idx lo hi e  r2 c2  r3 c3  chi\n")
    print("--- -- -- -- -- --  -- --  ---\n")

    // Per-fiber chi-bracket counts (fibers lo=1..7 → 3 brackets each)
    var fiber_chi: [i32; 21] = [0; 21]   // 7 fibers * 3 brackets = 21 slots
    // fiber f, bracket b → fiber_chi[f*3 + b]

    // Global chi counts
    var n_chi2: i32 = 0
    var n_chi3: i32 = 0
    var n_chi4: i32 = 0

    // Pass 1: collect first idx per edge count (for summary)
    var edge_chi: [i32; 20] = [0; 20]   // majority bracket per edge count (simple sum proxy)
    var edge_cnt: [i32; 20] = [0; 20]

    var idx: i64 = 0
    while idx < 84 {
        let lo = get_prim_lo(idx)
        let hi = get_prim_hi(idx)

        build_twisted_adj14_pub(idx)
        let e = count_edges14_pub() as i32

        // 2-coloring
        var ctx2 = smt_new()
        add_2col_edges(&! ctx2)
        smt_set_score_mode(&! ctx2, 3)
        smt_set_no_ple(&! ctx2, 1)
        let r2 = smt_solve(&! ctx2)
        let c2 = smt_get_conflicts(&ctx2)

        // 3-coloring (rebuild adj since ctx2 done)
        build_twisted_adj14_pub(idx)
        var ctx3 = smt_new()
        add_3col_base(&! ctx3)
        add_3col_edges(&! ctx3)
        smt_set_score_mode(&! ctx3, 3)
        smt_set_no_ple(&! ctx3, 1)
        let r3 = smt_solve(&! ctx3)
        let c3 = smt_get_conflicts(&ctx3)

        let chi = chi_bracket(r2, c2, r3, c3)

        // Accumulate
        let fi = ((lo - 1) * 3 + (chi as i64)) as usize
        fiber_chi[fi] = fiber_chi[fi] + 1
        if chi == 0 { n_chi2 = n_chi2 + 1 }
        if chi == 1 { n_chi3 = n_chi3 + 1 }
        if chi == 2 { n_chi4 = n_chi4 + 1 }
        if e < 20 {
            edge_chi[e as usize] = edge_chi[e as usize] + chi
            edge_cnt[e as usize] = edge_cnt[e as usize] + 1
        }

        pri(idx as i32); print(" ")
        pri(lo as i32); print("  ")
        pri(hi as i32); print("  ")
        pri(e); print("  ")
        pri(r2); print("  ")
        pri(c2); print("   ")
        pri(r3); print("  ")
        pri(c3); print("   ")
        pri(chi); print("\n")

        idx = idx + 1
    }

    print("\n=== Chi bracket totals ===\n")
    print("χ≤2 (bipartite): "); pri(n_chi2); print("\n")
    print("χ=3:             "); pri(n_chi3); print("\n")
    print("χ≥4:             "); pri(n_chi4); print("\n")

    print("\n=== By fiber (lo=1..7) ===\n")
    print("lo  χ≤2  χ=3  χ≥4\n")
    print("--  ---  ---  ---\n")
    var fi2: i32 = 0
    while fi2 < 7 {
        pri(fi2 + 1); print("    ")
        pri(fiber_chi[(fi2 * 3 + 0) as usize]); print("    ")
        pri(fiber_chi[(fi2 * 3 + 1) as usize]); print("    ")
        pri(fiber_chi[(fi2 * 3 + 2) as usize]); print("\n")
        fi2 = fi2 + 1
    }

    print("\n=== By edge count ===\n")
    print("e   mean_chi  n\n")
    var e2: i32 = 0
    while e2 < 20 {
        if edge_cnt[e2 as usize] > 0 {
            pri(e2); print("   ")
            pri(edge_chi[e2 as usize]); print("  n=")
            pri(edge_cnt[e2 as usize]); print("\n")
        }
        e2 = e2 + 1
    }

    print("\n--- Verdict ---\n")
    if n_chi3 > 0 {
        print("FLIP DETECTED: "); pri(n_chi3); print(" surgery graphs have χ=3 (not bipartite).\n")
        print("ZD surgery CAN push the 14-vertex probe beyond bipartite structure.\n")
        if n_chi4 > 0 {
            print("STRONG FLIP: "); pri(n_chi4); print(" graphs have χ≥4.\n")
            print("ZD surgery algebra reaches the non-3-colorable regime.\n")
        }
        print("Check fiber table: systematic fiber→χ pattern = ZD algebra controls χ.\n")
    } else if n_chi4 > 0 {
        print("STRONG FLIP (no χ=3): "); pri(n_chi4); print(" graphs have χ≥4 directly.\n")
    } else {
        print("NULL: all 84 surgery graphs are bipartite (χ≤2).\n")
        print("The 14-vertex probe vertex set is too constrained for chromatic flips.\n")
        print("Next: design probe B2 — embed Moser spindle (χ=4) in sedenion space.\n")
        print("See: examples/erdos/168_moser_spindle_probe.sio (A probe)\n")
    }
}
