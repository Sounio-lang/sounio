fn pri(x: i64) with IO, Div, Panic {
    if x < 0 { print("NEG"); return }
    if x == 0 { print("0"); return }
    if x >= 10 { pri(x / 10) }
    let d = x - (x / 10) * 10
    if d == 0 { print("0") } if d == 1 { print("1") } if d == 2 { print("2") }
    if d == 3 { print("3") } if d == 4 { print("4") } if d == 5 { print("5") }
    if d == 6 { print("6") } if d == 7 { print("7") } if d == 8 { print("8") }
    if d == 9 { print("9") }
}

fn noop4(a: i64, b: i64, c: i64, d: i64) with IO, Div, Panic {
    print("noop\n")
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let k: i64 = 5
    noop4(0, 0, 0, k)
    noop4(1, 1, 1, k)
    noop4(2, 2, 2, k)
    noop4(3, 3, 3, k)
    noop4(4, 4, 4, k)

    var dom: [i64; 6] = [31, 31, 31, 31, 31, 31]
    dom[0] = 1
    dom[1] = 2
    dom[2] = 4
    dom[3] = 8
    dom[4] = 16

    var changed: i64 = 1
    var conflict: i64 = 0
    var trail: i64 = 0
    var pass: i64 = 0
    while changed == 1 && conflict == 0 && pass < 8 {
        changed = 0
        pass = pass + 1
        var e: i64 = 0
        while e < 15 && conflict == 0 {
            // edge list for K6: simplified loop body
            if e == 0 { if dom[0] == 1 { dom[1] = dom[1] & 30; trail = trail + 1; if dom[1] == 0 { conflict = 1; } } }
            if e == 1 { if dom[0] == 1 { dom[2] = dom[2] & 29; trail = trail + 1; if dom[2] == 0 { conflict = 1; } } }
            if e == 2 { if dom[0] == 1 { dom[3] = dom[3] & 27; trail = trail + 1; if dom[3] == 0 { conflict = 1; } } }
            if e == 3 { if dom[0] == 1 { dom[4] = dom[4] & 23; trail = trail + 1; if dom[4] == 0 { conflict = 1; } } }
            if e == 4 { if dom[0] == 1 { dom[5] = dom[5] & 15; trail = trail + 1; if dom[5] == 0 { conflict = 1; } } }
            e = e + 1
        }
    }

    print("pass="); pri(pass); print(" trail="); pri(trail); print(" conflict="); pri(conflict); print("\n")
    pri(dom[0]); print(","); pri(dom[1]); print(","); pri(dom[2]); print(",")
    pri(dom[3]); print(","); pri(dom[4]); print(","); pri(dom[5]); print("\n")
    let zero: i32 = 0
    return zero
}
