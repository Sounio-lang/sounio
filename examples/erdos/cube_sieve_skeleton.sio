// examples/erdos/cube_sieve_skeleton.sio
//
// Executable manifest/proper-smoke skeleton for future cube-and-conquer graph-colouring searches.
//
// This file is deliberately NOT a geometry theorem and NOT a SAT certificate.  It emits
// deterministic cube records in the same variable convention as the Lean colouring CNF:
//
//   lean_var(v,c) = v*k + c       // zero-based Nat variable used by colourCNF
//   dimacs_lit(v,c) = lean_var+1  // conventional positive DIMACS literal
//
// Each emitted cube explicitly carries `proof_artifact_sha256=NONE` until a DRAT/LRAT
// artifact exists.  This skeleton never emits a promotable result: the executable
// promotion gate below always reports `REJECT_NONE_PROOF_ARTIFACT`.
//
// Soundness boundary:
//   this manifest can be generated locally; candidate search may run on GPU/cluster hardware;
//   a promoted result still needs an exact geometry witness plus DRAT/LRAT checked by Lean.

fn pri(x: i64) with IO, Div, Panic {
    if x < 0 { print("NEG_UNSUPPORTED"); return }
    if x == 0 { print("0"); return }
    if x >= 10 { pri(x / 10) }
    let d = x - (x / 10) * 10
    if d == 0 { print("0") } if d == 1 { print("1") } if d == 2 { print("2") }
    if d == 3 { print("3") } if d == 4 { print("4") } if d == 5 { print("5") }
    if d == 6 { print("6") } if d == 7 { print("7") } if d == 8 { print("8") }
    if d == 9 { print("9") }
}

fn lean_var(v: i64, c: i64, k: i64) -> i64 {
    return v * k + c
}

fn dimacs_lit(v: i64, c: i64, k: i64) -> i64 {
    return lean_var(v, c, k) + 1
}

fn colour_valid(c: i64, k: i64) -> i64 {
    if c < 0 { return 0 }
    if c >= k { return 0 }
    return 1
}

fn colour_domain_supported(k: i64) -> i64 {
    if k < 0 { return 0 }
    if k >= 62 { return 0 }
    return 1
}

fn bounded_variable_encoding_supported(v: i64, c: i64, k: i64) -> i64 {
    if v < 0 { return 0 }
    if colour_valid(c, k) == 0 { return 0 }
    if colour_domain_supported(k) == 0 { return 0 }
    if v >= 1000000 { return 0 }
    return 1
}

fn emit_assignment(v: i64, c: i64, k: i64) with IO, Div, Panic {
    print("    precolour vertex="); pri(v)
    print(" colour="); pri(c)
    print(" colour_valid="); pri(colour_valid(c, k))
    print(" bounded_encoding_supported="); pri(bounded_variable_encoding_supported(v, c, k))
    print(" lean_var="); pri(lean_var(v, c, k))
    print(" dimacs_lit="); pri(dimacs_lit(v, c, k))
    print("\n")
}

fn in_bounds(v: i64, n: i64) -> i64 {
    if v < 0 { return 0 }
    if v >= n { return 0 }
    return 1
}

fn endpoints_distinct_in_bounds(n: i64, a: i64, b: i64, c: i64) -> i64 {
    if in_bounds(a, n) == 0 { return 0 }
    if in_bounds(b, n) == 0 { return 0 }
    if in_bounds(c, n) == 0 { return 0 }
    if a == b { return 0 }
    if a == c { return 0 }
    if b == c { return 0 }
    return 1
}

fn edge_present(graph_id: i64, u: i64, v: i64) -> i64 {
    // graph_id=0: K6 complete graph smoke, vertices 0..5.
    if graph_id == 0 {
        if in_bounds(u, 6) == 0 { return 0 }
        if in_bounds(v, 6) == 0 { return 0 }
        if u == v { return 0 }
        return 1
    }

    // graph_id=1: hard-coded G529 reference triangle used by the reflected k=4 lane.
    // This is not a general G529 adjacency oracle.
    if graph_id == 1 {
        if u == 0 && v == 1 { return 1 }
        if u == 1 && v == 0 { return 1 }
        if u == 0 && v == 5 { return 1 }
        if u == 5 && v == 0 { return 1 }
        if u == 1 && v == 5 { return 1 }
        if u == 5 && v == 1 { return 1 }
    }
    return 0
}

fn k6_edge_u(e: i64) -> i64 {
    if e < 0 { return 0 - 1 }
    if e >= 15 { return 0 - 1 }
    if e == 0 { return 0 } if e == 1 { return 0 } if e == 2 { return 0 }
    if e == 3 { return 0 } if e == 4 { return 0 } if e == 5 { return 1 }
    if e == 6 { return 1 } if e == 7 { return 1 } if e == 8 { return 1 }
    if e == 9 { return 2 } if e == 10 { return 2 } if e == 11 { return 2 }
    if e == 12 { return 3 } if e == 13 { return 3 } if e == 14 { return 4 }
    return 0
}

fn k6_edge_v(e: i64) -> i64 {
    if e < 0 { return 0 - 1 }
    if e >= 15 { return 0 - 1 }
    if e == 0 { return 1 } if e == 1 { return 2 } if e == 2 { return 3 }
    if e == 3 { return 4 } if e == 4 { return 5 } if e == 5 { return 2 }
    if e == 6 { return 3 } if e == 7 { return 4 } if e == 8 { return 5 }
    if e == 9 { return 3 } if e == 10 { return 4 } if e == 11 { return 5 }
    if e == 12 { return 4 } if e == 13 { return 5 } if e == 14 { return 5 }
    return 0
}

fn triangle_edges_sane(graph_id: i64, n: i64, a: i64, b: i64, c: i64) -> i64 {
    if endpoints_distinct_in_bounds(n, a, b, c) == 0 { return 0 }
    if edge_present(graph_id, a, b) == 0 { return 0 }
    if edge_present(graph_id, a, c) == 0 { return 0 }
    if edge_present(graph_id, b, c) == 0 { return 0 }
    return 1
}

fn emit_triangle_cube(cube_id: i64, graph_id: i64, n: i64, k: i64, a: i64, b: i64, c: i64)
    with IO, Div, Panic {
    print("cube id="); pri(cube_id)
    print(" graph_id="); pri(graph_id)
    print(" n="); pri(n)
    print(" k="); pri(k)
    print(" triangle=("); pri(a); print(","); pri(b); print(","); pri(c); print(")\n")
    if k >= 3 { print("  k_sanity=1\n") } else { print("  k_sanity=0\n") }
    print("  domain_mask_supported_k_lt_62="); pri(colour_domain_supported(k)); print("\n")
    print("  endpoints_distinct_in_bounds="); pri(endpoints_distinct_in_bounds(n, a, b, c)); print("\n")
    print("  triangle_edge_sanity="); pri(triangle_edges_sane(graph_id, n, a, b, c)); print("\n")
    print("  proof_artifact_sha256=NONE\n")
    print("  proof_required=DRAT_OR_LRAT_CHECKED_IN_LEAN\n")
    emit_assignment(a, 0, k)
    emit_assignment(b, 1, k)
    emit_assignment(c, 2, k)
}

fn all_colours(k: i64) -> i64 with Mut {
    // This smoke packs domains into signed i64 masks and is scoped to k < 62.
    if k < 0 { return 0 }
    if k >= 62 { return 0 }
    var mask: i64 = 0
    var c: i64 = 0
    while c < k {
        mask = mask | (1 << c)
        c = c + 1
    }
    return mask
}

fn dom_empty(d: i64) -> i64 {
    if d == 0 { return 1 }
    return 0
}

fn dom_singleton(d: i64) -> i64 {
    if d == 0 { return 0 }
    if (d & (d - 1)) == 0 { return 1 }
    return 0
}

fn dom_remove(d: i64, c: i64, k: i64) -> i64 with Mut {
    return d & (all_colours(k) ^ (1 << c))
}

fn dom_color(d: i64) -> i64 with Mut {
    if d == 0 { return 0 }
    var c: i64 = 0
    var x = d
    while (x & 1) == 0 {
        x = x >> 1
        c = c + 1
    }
    return c
}

fn emit_rup_remove_step(step: i64, src: i64, dst: i64, colour: i64, before: i64, after: i64, k: i64)
    with IO, Div, Panic {
    print("    trail_step="); pri(step)
    print(" op=remove")
    print(" reason=edge("); pri(src); print(","); pri(dst); print(")")
    print(" source_singleton_colour="); pri(colour)
    print(" target_vertex="); pri(dst)
    print(" before_domain="); pri(before)
    print(" after_domain="); pri(after)
    print(" removed_dimacs_lit="); pri(dimacs_lit(dst, colour, k))
    print("\n")
}

fn emit_rup_binary_reason(src: i64, dst: i64, colour: i64, k: i64) with IO, Div, Panic {
    print("      rup_reason_clause=-"); pri(dimacs_lit(src, colour, k))
    print(" -"); pri(dimacs_lit(dst, colour, k)); print(" 0\n")
}

fn emit_rup_unit_fact(v: i64, colour: i64, k: i64) with IO, Div, Panic {
    print("      rup_fact_clause="); pri(dimacs_lit(v, colour, k)); print(" 0\n")
}

fn emit_cube_assignment(idx: i64, v: i64, colour: i64, k: i64) with IO, Div, Panic {
    print("    cube_assignment index="); pri(idx)
    print(" vertex="); pri(v)
    print(" colour="); pri(colour)
    print("\n")
    emit_assignment(v, colour, k)
    emit_rup_unit_fact(v, colour, k)
}

fn emit_k6_cube_negation_clause(k: i64) with IO, Div, Panic {
    print("  rup_clause_scope=complete_graph_cube_vertices_0_to_4_colours_0_to_4\n")
    print("  rup_clause_negated_cube=")
    print("-"); pri(dimacs_lit(0, 0, k)); print(" ")
    print("-"); pri(dimacs_lit(1, 1, k)); print(" ")
    print("-"); pri(dimacs_lit(2, 2, k)); print(" ")
    print("-"); pri(dimacs_lit(3, 3, k)); print(" ")
    print("-"); pri(dimacs_lit(4, 4, k)); print(" 0\n")
}

fn emit_complete_graph_cube_propagation_smoke() with IO, Mut, Div, Panic {
    let n: i64 = 6
    let k: i64 = 5
    print("section=complete_graph_cube_propagation_smoke\n")
    print("  purpose=producer smoke for domain propagation plus RUP-trail metadata\n")
    print("  graph_family=complete_graph\n")
    print("  graph_id=0\n")
    print("  n="); pri(n); print("\n")
    print("  k="); pri(k); print("\n")
    print("  cube_assignment_count=5\n")
    print("  claim=simulated_cube_plus_K6_edges_conflict_by_domain_propagation_only\n")
    print("  verified_claim=none\n")
    print("  geometry_claim=none\n")
    print("  proof_artifact_sha256=NONE\n")
    print("  proof_required=compose_this_trail_to_DRAT_OR_LRAT_AND_CHECK_IN_LEAN\n")
    emit_cube_assignment(0, 0, 0, k)
    emit_cube_assignment(1, 1, 1, k)
    emit_cube_assignment(2, 2, 2, k)
    emit_cube_assignment(3, 3, 3, k)
    emit_cube_assignment(4, 4, 4, k)
    emit_k6_cube_negation_clause(k)

    var dom: [i64; 6] = [31, 31, 31, 31, 31, 31]
    dom[0] = 1
    dom[1] = 2
    dom[2] = 4
    dom[3] = 8
    dom[4] = 16

    var changed: i64 = 1
    var conflict: i64 = 0
    var conflict_v: i64 = 0 - 1
    var trail: i64 = 0
    var pass: i64 = 0
    // K6/k=5 has only six 5-bit domains; eight passes is a defensive smoke bound.
    while changed == 1 && conflict == 0 && pass < 8 {
        changed = 0
        pass = pass + 1
        var e: i64 = 0
        while e < 15 && conflict == 0 {
            let u = k6_edge_u(e)
            let v = k6_edge_v(e)
            if dom_singleton(dom[u]) == 1 {
                let c = dom_color(dom[u])
                let before = dom[v]
                let after = dom_remove(before, c, k)
                if after != before {
                    dom[v] = after
                    trail = trail + 1
                    changed = 1
                    emit_rup_remove_step(trail, u, v, c, before, after, k)
                    emit_rup_binary_reason(u, v, c, k)
                    if dom_empty(after) == 1 {
                        conflict = 1
                        conflict_v = v
                    }
                }
            }
            if conflict == 0 && dom_singleton(dom[v]) == 1 {
                let c2 = dom_color(dom[v])
                let before2 = dom[u]
                let after2 = dom_remove(before2, c2, k)
                if after2 != before2 {
                    dom[u] = after2
                    trail = trail + 1
                    changed = 1
                    emit_rup_remove_step(trail, v, u, c2, before2, after2, k)
                    emit_rup_binary_reason(v, u, c2, k)
                    if dom_empty(after2) == 1 {
                        conflict = 1
                        conflict_v = u
                    }
                }
            }
            e = e + 1
        }
    }

    print("  propagation_passes="); pri(pass); print("\n")
    if conflict == 0 && pass >= 8 {
        print("  termination_guard_tripped=1\n")
    } else {
        print("  termination_guard_tripped=0\n")
    }
    print("  trail_len="); pri(trail); print("\n")
    print("  conflict="); pri(conflict); print("\n")
    print("  conflict_vertex="); pri(conflict_v); print("\n")
    print("  final_domains=")
    pri(dom[0]); print(","); pri(dom[1]); print(","); pri(dom[2]); print(",")
    pri(dom[3]); print(","); pri(dom[4]); print(","); pri(dom[5]); print("\n\n")
}

fn emit_k6_no5_smoke() with IO, Div, Panic {
    print("section=k6_no5_smoke\n")
    print("  purpose=format smoke only; complete graph K6 is not a planar unit-distance witness here\n")
    print("  expected_sat_status=no-5-colouring UNSAT after SAT/DRAT toolchain, not proved by this file\n")
    emit_triangle_cube(0, 0, 6, 5, 0, 1, 2)
    print("  clique_lower_bound=6\n")
    print("  geometry_claim=none\n\n")
}

fn emit_g529_reference_probe() with IO, Div, Panic {
    print("section=g529_reference_probe\n")
    print("  purpose=manifest-format reference for existing G529 triangle-precolour lane\n")
    print("  claim=chi>=5 reference only; not a chi>=6 candidate\n")
    print("  graph_scope=single_known_triangle_probe_not_general_g529_adjacency\n")
    emit_triangle_cube(1, 1, 529, 4, 0, 1, 5)
    print("  geometry_claim=existing G529 lane only\n\n")
}

fn proof_ready() -> i64 {
    // Intentionally closed in the skeleton. Replace this with parsed proof metadata once
    // a DRAT/LRAT artifact and exact geometry witness are present.
    return 0
}

fn emit_promotion_gate() with IO {
    if proof_ready() == 0 {
        print("promotion_gate=REJECT_NONE_PROOF_ARTIFACT\n")
        print("promotable=0\n")
        return
    }
    print("promotion_gate=READY\n")
    print("promotable=1\n")
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("cube_sieve_skeleton v0\n")
    print("trust_boundary=search_untrusted__drat_lrat_lean_verified_required\n")
    print("output=deterministic_cube_manifest\n\n")
    emit_k6_no5_smoke()
    emit_g529_reference_probe()
    emit_complete_graph_cube_propagation_smoke()
    emit_promotion_gate()
    print("status=manifest_emitted_unpromotable\n")
    return 0
}
