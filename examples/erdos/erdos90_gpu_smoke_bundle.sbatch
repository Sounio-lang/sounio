chmod +x kaxi_ptx_runner

echo "[$(date -Iseconds)] CPU oracle"
./smoke.elf > smoke.log 2>&1
grep -q "KAXI_SMOKE_DONE" smoke.log
MEM_WORDS="$(grep '^KAXI_SMOKE_MEM_WORDS=' smoke.log | sed 's/^KAXI_SMOKE_MEM_WORDS=//')"
CPU_MAX="$(grep '^KAXI_SMOKE_CPU_MAX=' smoke.log | sed 's/^KAXI_SMOKE_CPU_MAX=//')"
INIT_BIN="init_mem.bin"
if [[ ! -f "$INIT_BIN" ]]; then
    echo "error: $INIT_BIN not produced by CPU oracle" >&2
    exit 1
fi
BIN_BYTES="$(stat -c%s "$INIT_BIN" 2>/dev/null || stat -f%z "$INIT_BIN")"
echo "INIT_BIN=$INIT_BIN bytes=$BIN_BYTES MEM_WORDS=$MEM_WORDS CPU_MAX=$CPU_MAX"

echo "[$(date -Iseconds)] GPU launch"
GPU_RC=0
./kaxi_ptx_runner erdos90_hc_smoke.ptx \
    --mode basic --threads 8 --mem-words "$MEM_WORDS" \
    --init-file "$INIT_BIN" --type i64 --print-count "$MEM_WORDS" \
    > gpu.log 2>&1 || GPU_RC=$?

echo "[$(date -Iseconds)] runner rc=$GPU_RC"
cat gpu.log || true

grep -q 'sounio_kaxi_runtime status=pass' gpu.log

echo "[$(date -Iseconds)] GPU PASS"

STAGE="/orangefs/training/erdos90_gpu_smoke_${SLURM_JOB_ID:-local}"
mkdir -p "$STAGE"
cp smoke.log gpu.log "$STAGE/"
echo "staged to $STAGE"

cd /
rm -rf "$WORK"
