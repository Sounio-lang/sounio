#!/usr/bin/env bash
#SBATCH --job-name=erdos90-gpu-smoke
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=01:00:00
#SBATCH --chdir=/tmp
#SBATCH --output=/tmp/erdos90_gpu_smoke_%j.out
#SBATCH --partition=gpu-orangefs
#
# Self-contained GPU smoke for erdos90_hc_smoke K-AXI pattern.
set -euo pipefail

WORK="${SLURM_TMPDIR:-/tmp}/erdos90_gpu_$$"
mkdir -p "$WORK"
cd "$WORK"

base64 -d <<'ELF64' > smoke.elf
