// examples/erdos/168_k4_full_check.sio
//
// Probe B (K=4): Exhaustive check — ALL C(16,4)=1820 positive 4-component
// integer sedenion difference vectors × 84 ZD surgeries.
//
// Parity-of-coincidences theorem predicts 0 edges:
//   norm^2=2 requires k_coin = 2*k_cancel - (K-1) = 2*k_cancel - 3 (odd).
//   But coincidences come in XOR-symmetric pairs (always even). Contradiction.
//
// Result: 0 edges — complete bipartiteness theorem holds for K=4.

use hypercomplex_graph::erdos_unit_distance::*

fn pri(x: i32) with IO, Div, Panic {
    if x < 0 { print("-"); pri(0 - x); return }
    if x == 0 { print("0"); return }
    if x >= 10 { pri(x / 10) }
    let d = x - (x / 10) * 10
    if d == 0 { print("0") } if d == 1 { print("1") } if d == 2 { print("2") }
    if d == 3 { print("3") } if d == 4 { print("4") } if d == 5 { print("5") }
    if d == 6 { print("6") } if d == 7 { print("7") } if d == 8 { print("8") }
    if d == 9 { print("9") }
}

fn main() with IO, Mut, Div, Panic {
    build_prims()
    zero_probe14()

    print("=== Probe B (K=4): C(16,4)=1820 diffs x 84 surgeries ===\n")
    print("Parity-of-coincidences theorem predicts: 0 edges for even K.\n\n")

    let target: f64 = 2.0
    let tol: f64 = 1.0e-9

    var total_checked: i64 = 0
    var total_edges: i64 = 0
    var combos_with_edge: i64 = 0

    var p0: i64 = 0
    while p0 <= 12 {
        var p1: i64 = p0 + 1
        while p1 <= 13 {
            var p2: i64 = p1 + 1
            while p2 <= 14 {
                var p3: i64 = p2 + 1
                while p3 <= 15 {
                    set_probe14_coord(1, p0, 1.0)
                    set_probe14_coord(1, p1, 1.0)
                    set_probe14_coord(1, p2, 1.0)
                    set_probe14_coord(1, p3, 1.0)

                    var edge_count: i64 = 0
                    var sidx: i64 = 0
                    while sidx < 84 {
                        let nsq = twisted_norm_sq_pair(0, 1, sidx)
                        let diff = nsq - target
                        let adiff = if diff < 0.0 { 0.0 - diff } else { diff }
                        if adiff <= tol { edge_count = edge_count + 1 }
                        sidx = sidx + 1
                    }
                    total_edges = total_edges + edge_count
                    if edge_count > 0 {
                        combos_with_edge = combos_with_edge + 1
                        print("EDGE: ("); pri(p0 as i32); print(","); pri(p1 as i32)
                        print(","); pri(p2 as i32); print(","); pri(p3 as i32)
                        print(") surgeries="); pri(edge_count as i32); print("\n")
                    }

                    set_probe14_coord(1, p0, 0.0)
                    set_probe14_coord(1, p1, 0.0)
                    set_probe14_coord(1, p2, 0.0)
                    set_probe14_coord(1, p3, 0.0)

                    total_checked = total_checked + 1
                    p3 = p3 + 1
                }
                p2 = p2 + 1
            }
            p1 = p1 + 1
        }
        p0 = p0 + 1
    }

    print("\n=== K=4 results ===\n")
    print("Combos checked: "); pri(total_checked as i32); print("  (expect 1820)\n")
    print("Total edge-surgery pairs: "); pri(total_edges as i32); print("\n")
    print("Combos with any edge: "); pri(combos_with_edge as i32); print("\n")

    if combos_with_edge == 0 {
        print("\nCONFIRMED: No K=4 diff gives twisted norm^2=2 for any surgery.\n")
        print("Parity-of-coincidences theorem holds for K=4.\n")
    } else {
        print("\nUNEXPECTED: K=4 edges found. Check algebraic argument.\n")
    }
}
