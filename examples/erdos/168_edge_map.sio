// examples/erdos/168_edge_map.sio
//
// Diagnostic: exhaustive map of twisted norm for ALL single-component and
// two-component integer sedenion difference vectors.
//
// Question: For diff = eₚ (unit, |diff|²=1) or diff = eₚ ± eᵩ (two components,
// |diff|²=2), which (diff, surgery_idx) pairs give twisted norm |diff·prim|² = 2?
//
// This maps the full "adjacency alphabet" available for constructing graphs.
//
// Key hypotheses:
//   H1: |diff|²=1 → twisted norm=2 for ALL 84 surgeries (explains init_probe14 edges)
//   H2: |diff|²=2 → twisted norm∈{0,2,4} depending on prim (some give 2 → potential edges)
//
// If H2 shows twisted norm=2 for SOME (eₚ±eᵩ, surgery) pairs, we can build a
// vertex set using those specific diff-target pairs and check bipartiteness.
//
// Uses PROBE14 machinery: set v0=(0,...,0), v1=diff, compute twisted adj.

use hypercomplex_graph::erdos_unit_distance::*

fn pri(x: i32) with IO, Div, Panic {
    if x < 0 { print("-"); pri(0 - x); return }
    if x == 0 { print("0"); return }
    if x >= 10 { pri(x / 10) }
    let d = x - (x / 10) * 10
    if d == 0 { print("0") } if d == 1 { print("1") } if d == 2 { print("2") }
    if d == 3 { print("3") } if d == 4 { print("4") } if d == 5 { print("5") }
    if d == 6 { print("6") } if d == 7 { print("7") } if d == 8 { print("8") }
    if d == 9 { print("9") }
}

fn main() with IO, Mut, Div, Panic {
    build_prims()

    print("=== Edge map: which (diff, surgery) give twisted norm=2? ===\n\n")

    // H1: single-component diff eₖ for k=1..15. |diff|²=1.
    // Set v0=0, v1=eₖ. Check count_edges_n(2) for all 84 surgeries.
    print("--- H1: diff = eₖ (|diff|²=1) ---\n")
    print("k   surgeries_with_edge  (should be 84 if always-edge)\n")

    var k: i32 = 1
    while k < 16 {
        zero_probe14()
        // v0 = 0, v1 = eₖ
        set_probe14_coord(1, k as i64, 1.0)

        var edge_count: i32 = 0
        var idx: i64 = 0
        while idx < 84 {
            zero_probe14()
            set_probe14_coord(1, k as i64, 1.0)
            build_twisted_adj14_pub(idx)
            if get_adj14_edge(0, 1) == 1 { edge_count = edge_count + 1 }
            idx = idx + 1
        }
        pri(k); print("   "); pri(edge_count); print("\n")
        k = k + 1
    }

    print("\n--- H2: diff = eₚ + eᵩ (|diff|²=2, p≠q) ---\n")
    print("Reporting (p, q, n_edges, first_surgery_idx with edge)\n")

    var p: i32 = 0
    while p < 16 {
        var q: i32 = p + 1
        while q < 16 {
            zero_probe14()
            // v0=0, v1=eₚ+eᵩ
            set_probe14_coord(1, p as i64, 1.0)
            set_probe14_coord(1, q as i64, 1.0)

            var n_edge: i32 = 0
            var first_idx: i32 = -1
            var idx: i64 = 0
            while idx < 84 {
                zero_probe14()
                set_probe14_coord(1, p as i64, 1.0)
                set_probe14_coord(1, q as i64, 1.0)
                build_twisted_adj14_pub(idx)
                if get_adj14_edge(0, 1) == 1 {
                    n_edge = n_edge + 1
                    if first_idx < 0 { first_idx = idx as i32 }
                }
                idx = idx + 1
            }

            if n_edge > 0 {
                print("p="); pri(p); print(" q="); pri(q)
                print(" n_edges="); pri(n_edge)
                print(" first_idx="); pri(first_idx)
                let lo = get_prim_lo(first_idx as i64)
                let hi = get_prim_hi(first_idx as i64)
                let neg = get_prim_neg(first_idx as i64)
                print(" prim=(lo="); pri(lo as i32); print(",hi="); pri(hi as i32); print(",neg="); pri(neg as i32); print(")\n")
            }

            q = q + 1
        }
        p = p + 1
    }

    print("\n--- H3: diff = eₚ - eᵩ (|diff|²=2, stored as +eₚ, v0=+eᵩ) ---\n")
    print("(check eₚ - eᵩ: v0=eᵩ, v1=eₚ, same as H2 by translation invariance)\n")
    print("(Translation: for any a,b,c: (b-a)·prim = same as (eₚ-eᵩ)·prim.)\n")
    print("H3 = H2 by symmetry (diff eₚ+eᵩ vs eₚ-eᵩ covers all two-component combos).\n")
    print("But sign matters. Check diff = eₚ - eᵩ via v0=eᵩ, v1=eₚ:\n")

    p = 0
    while p < 16 {
        var q: i32 = 0
        while q < 16 {
            if p != q {
                var n_edge: i32 = 0
                var first_idx: i32 = -1
                var idx: i64 = 0
                while idx < 84 {
                    zero_probe14()
                    // v0=eᵩ, v1=eₚ → diff = v0-v1 = eᵩ-eₚ (or v1-v0 = eₚ-eᵩ, same adjacency)
                    set_probe14_coord(0, q as i64, 1.0)
                    set_probe14_coord(1, p as i64, 1.0)
                    build_twisted_adj14_pub(idx)
                    if get_adj14_edge(0, 1) == 1 {
                        n_edge = n_edge + 1
                        if first_idx < 0 { first_idx = idx as i32 }
                    }
                    idx = idx + 1
                }
                if n_edge > 0 {
                    print("p="); pri(p); print(" q="); pri(q)
                    print(" (diff=eₚ-eᵩ) n_edges="); pri(n_edge)
                    print(" first_idx="); pri(first_idx); print("\n")
                }
            }
            q = q + 1
        }
        p = p + 1
    }

    print("\nDone. Summary:\n")
    print("Any (p,q) with n_edges>0 in H2/H3 → can use eₚ+eᵩ or eₚ,eₚ+eᵩ as vertex pair.\n")
    print("If 2-component diffs also give edges → may enable non-bipartite configurations.\n")
}
