// examples/erdos/168_moser_a.sio
//
// A probe: Moser spindle UNSAT regime detector.
//
// The Moser spindle is the smallest unit-distance graph with χ=4.
// Its 3-coloring formula is PROVABLY UNSAT (no valid 3-coloring exists).
// This resolves the OVERREACH from the A1 math-review:
//   A1's graphs were 3-colorable (χ≤3, SAT). This probe uses χ=4 → always UNSAT.
//
// Background on B null:
//   B attempts (168_chromatic_flip.sio, 168_c5_flip.sio, 168_cross_half_flip.sio)
//   all showed algebraic bipartiteness. Theorem:
//     In the integer sedenion lattice, |eᵢ-eⱼ|² ∈ {1,2,4,...} (even multiples of 1/2 are
//     impossible for integer coefficients). The parity invariant (even vs odd number of
//     nonzero components) is preserved by unit-distance adjacency, forcing bipartiteness.
//     ZD surgery on the integer lattice CANNOT produce non-bipartite unit-distance graphs.
//   → B via unit-distance is algebraically blocked. B-theorem documented.
//
// A probe design:
//   Graph: Moser spindle, 7 vertices, 11 edges, χ=4.
//   Edge list (0-indexed): 0-1, 0-2, 1-2, 1-3, 2-3, 0-4, 0-5, 4-5, 4-6, 5-6, 3-6
//   Formula: 3-coloring (21 vars, 28 base + 33 edge = 61 coloring clauses) → ALWAYS UNSAT.
//   Background: per-ZD-surgery seed (lo, hi, neg → seed), adds 40 background clauses.
//   Total: 101 clauses / 21 vars = 4.81 (above 3-SAT threshold, but UNSAT from coloring).
//
// Falsifiable prediction:
//   ZD fiber (lo=1..7) predicts CDCL refutation hardness for the Moser UNSAT proof.
//   Between-fiber variance > within-fiber variance → fiber controls refutation difficulty.
//
// Connection:
//   docs/research/locus-coeruleus-surgical-controller-sounio-note.md §5(c) (goal A)
//   B-theorem: sedenion integer lattice unit-distance is always bipartite.
//
// NOTE: 3-coloring of Moser spindle is UNSAT by theorem (χ=4). No empirical UNSAT
//       assumption here — this is provable by exhaustive case analysis (see proof sketch
//       in comments below).

use theorem::smt::*

var lcg_state: i64 = 0

fn lcg_next() -> i64 with Mut {
    lcg_state = (lcg_state * 1664525 + 1013904223) & 0x7FFFFFFF
    return lcg_state
}

fn lrand(n: i64) -> i64 with Mut {
    return lcg_next() % n
}

fn pri(x: i32) with IO, Div, Panic {
    if x < 0 { print("-"); pri(0 - x); return }
    if x == 0 { print("0"); return }
    if x >= 10 { pri(x / 10) }
    let d = x - (x / 10) * 10
    if d == 0 { print("0") } if d == 1 { print("1") } if d == 2 { print("2") }
    if d == 3 { print("3") } if d == 4 { print("4") } if d == 5 { print("5") }
    if d == 6 { print("6") } if d == 7 { print("7") } if d == 8 { print("8") }
    if d == 9 { print("9") }
}

fn prf(x: f64) with IO, Mut, Div, Panic {
    if x < 0.0 { print("-"); prf(0.0 - x); return }
    let ip = x as i32
    pri(ip); print(".")
    let f0 = (x - (ip as f64)) * 10.0; let d0 = f0 as i32
    let f1 = (f0 - (d0 as f64)) * 10.0; let d1 = f1 as i32
    pri(d0); pri(d1)
}

fn add2(ctx: &!SmtContext, a: i32, b: i32) with Mut, Div {
    var lits: [i32; 8] = [0; 8]
    lits[0] = a; lits[1] = b
    smt_add_clause(ctx, &lits, 2)
}

fn add3(ctx: &!SmtContext, a: i32, b: i32, c: i32) with Mut, Div {
    var lits: [i32; 8] = [0; 8]
    lits[0] = a; lits[1] = b; lits[2] = c
    smt_add_clause(ctx, &lits, 3)
}

// 3-coloring base (at-least-one + at-most-one) for n vertices.
// var = vertex*3 + color, literal = var*2 (pos) or var*2+1 (neg).
fn add_3col_base7(ctx: &!SmtContext) with Mut, Div {
    var v: i32 = 0
    while v < 7 {
        add3(ctx, (v*3+0)*2, (v*3+1)*2, (v*3+2)*2)
        add2(ctx, (v*3+0)*2+1, (v*3+1)*2+1)
        add2(ctx, (v*3+0)*2+1, (v*3+2)*2+1)
        add2(ctx, (v*3+1)*2+1, (v*3+2)*2+1)
        v = v + 1
    }
}

// Moser spindle edge clauses.
// 11 edges: 0-1, 0-2, 1-2, 1-3, 2-3, 0-4, 0-5, 4-5, 4-6, 5-6, 3-6
// χ=4 proof sketch: 0=R → {1,2,4,5}≠R; 1≠2 → say 1=G,2=B;
//   1-3: 3≠G, 2-3: 3≠B → 3=R; 0-4: 4≠R, 0-5: 5≠R, 4-5: 4≠5;
//   if 4=G,5=B: 4-6:6≠G, 5-6:6≠B, 3-6:6≠R → no color for 6. UNSAT. □
fn add_moser_edges(ctx: &!SmtContext) with Mut, Div {
    // edge_clause: for edge (u,v), each color c: ¬(u=c) ∨ ¬(v=c)
    var i: i32 = 0
    // Edges: encoded as pairs (u,v) — unroll manually (10 pairs × 3 colors = 30 calls)
    // Edge 0-1
    while i < 3 { add2(ctx, (0*3+i)*2+1, (1*3+i)*2+1); i = i+1 }
    i = 0
    // Edge 0-2
    while i < 3 { add2(ctx, (0*3+i)*2+1, (2*3+i)*2+1); i = i+1 }
    i = 0
    // Edge 1-2
    while i < 3 { add2(ctx, (1*3+i)*2+1, (2*3+i)*2+1); i = i+1 }
    i = 0
    // Edge 1-3
    while i < 3 { add2(ctx, (1*3+i)*2+1, (3*3+i)*2+1); i = i+1 }
    i = 0
    // Edge 2-3
    while i < 3 { add2(ctx, (2*3+i)*2+1, (3*3+i)*2+1); i = i+1 }
    i = 0
    // Edge 0-4
    while i < 3 { add2(ctx, (0*3+i)*2+1, (4*3+i)*2+1); i = i+1 }
    i = 0
    // Edge 0-5
    while i < 3 { add2(ctx, (0*3+i)*2+1, (5*3+i)*2+1); i = i+1 }
    i = 0
    // Edge 4-5
    while i < 3 { add2(ctx, (4*3+i)*2+1, (5*3+i)*2+1); i = i+1 }
    i = 0
    // Edge 4-6
    while i < 3 { add2(ctx, (4*3+i)*2+1, (6*3+i)*2+1); i = i+1 }
    i = 0
    // Edge 5-6
    while i < 3 { add2(ctx, (5*3+i)*2+1, (6*3+i)*2+1); i = i+1 }
    i = 0
    // Edge 3-6 (the bridge that forces χ=4)
    while i < 3 { add2(ctx, (3*3+i)*2+1, (6*3+i)*2+1); i = i+1 }
}

// Background 3-SAT clauses over the 21 coloring vars. LCG must be seeded before call.
fn add_background_moser(ctx: &!SmtContext) with Mut, Div {
    var i: i32 = 0
    while i < 40 {
        let v0 = (lrand(21)) as i32
        let s0 = (lrand(2)) as i32
        let v1 = (lrand(21)) as i32
        let s1 = (lrand(2)) as i32
        let v2 = (lrand(21)) as i32
        let s2 = (lrand(2)) as i32
        add3(ctx, v0*2+s0, v1*2+s1, v2*2+s2)
        i = i + 1
    }
}

// ZD primitive tables (same as erdos_unit_distance stdlib, inlined to avoid import)
// lo ∈ {1..7}, hi ∈ {9..15}, neg ∈ {0,1}
// 84 prims: for each lo in 1..7, each hi in {lo+8, lo+9, ..., 15} with (lo^hi)≠8,
// and each neg in {0,1}. Here we just use idx*127+1 style seed as before.
// BUT: for ZD-surgery seeding, use the ALGEBRAIC seed: (lo*16+hi)*2+neg.
// We encode lo and hi from the prim table built by build_prims().
// Since we're not importing the stdlib here, we'll use a simpler seed:
//   seed = idx * 127 + 1  (same as A1 probe)
// AND a ZD-informed seed:
//   zd_seed = ((lo*7 + (hi-9)) * 2 + neg) where lo=1..7, hi=9..15, neg=0..1
// We compute these from the prim table.

// For simplicity without importing the stdlib, use a hardcoded prim structure.
// The 84 prims follow the pattern: lo ∈ {1..7}, hi ∈ {9..15} with lo XOR hi ≠ 8,
// and neg ∈ {0,1}. Count: 7 fibers × 6 hi-values × 2 neg = 84.
// lo XOR hi ≠ 8: for lo=1, exclude hi=9 (1^9=8); for lo=2, exclude hi=10 (2^10=8); etc.
// So each fiber has hi ∈ {9..15} minus {lo+8} = 6 values.

// Build prim lo/hi/neg for idx ∈ 0..83:
// idx = fiber_idx * 12 + hi_idx * 2 + neg
// fiber_idx ∈ 0..6 → lo = fiber_idx+1
// hi_idx ∈ 0..5 → hi = 9 + (hi_idx if hi_idx < lo+8-9 else hi_idx+1)
// (skipping the hi = lo+8)
// Actually: build the same prim table inline.

var PRIM_LO2: [i32; 84] = [0; 84]
var PRIM_HI2: [i32; 84] = [0; 84]
var PRIM_NEG2: [i32; 84] = [0; 84]

fn build_prims2() with Mut {
    var idx: i32 = 0
    var lo: i32 = 1
    while lo <= 7 {
        let skip_hi = lo + 8    // lo XOR skip_hi = 8
        var hi: i32 = 9
        while hi <= 15 {
            if hi != skip_hi {
                PRIM_LO2[idx as usize] = lo
                PRIM_HI2[idx as usize] = hi
                PRIM_NEG2[idx as usize] = 0
                idx = idx + 1
                PRIM_LO2[idx as usize] = lo
                PRIM_HI2[idx as usize] = hi
                PRIM_NEG2[idx as usize] = 1
                idx = idx + 1
            }
            hi = hi + 1
        }
        lo = lo + 1
    }
}

fn main() with IO, Mut, Div, Panic {
    build_prims2()

    print("=== A: Moser spindle UNSAT regime probe ===\n")
    print("Moser spindle: 7v, 11e, χ=4. 3-coloring ALWAYS UNSAT.\n")
    print("21 vars. 28 base + 33 edge (=61 coloring, UNSAT) + 40 bg = 101 cls.\n")
    print("Background seeded by ZD prim: seed = (lo*16+hi)*2+neg.\n")
    print("Prediction: ZD fiber correlates with CDCL refutation hardness.\n\n")
    print("idx lo hi ng r  confl trust  hard\n")
    print("--- -- -- -- -  ----- -----  ----\n")

    var sum_hard_by_lo: [f64; 8] = [0.0; 8]
    var cnt_by_lo:      [i32; 8] = [0; 8]
    var sum_h2_by_lo:   [f64; 8] = [0.0; 8]   // for variance

    var idx: i32 = 0
    while idx < 84 {
        let lo  = PRIM_LO2[idx as usize]
        let hi  = PRIM_HI2[idx as usize]
        let neg = PRIM_NEG2[idx as usize]

        // ZD-algebraic seed: unique per primitive, reflects fiber structure
        let seed = (lo * 16 + hi) * 2 + neg
        lcg_state = seed as i64

        var ctx = smt_new()
        add_background_moser(&! ctx)
        add_3col_base7(&! ctx)
        add_moser_edges(&! ctx)

        smt_set_score_mode(&! ctx, 3)
        smt_set_no_ple(&! ctx, 1)
        let r = smt_solve(&! ctx)

        let confl = smt_get_conflicts(&ctx)
        let trust = smt_get_explore_trust(&ctx)
        let hard  = smt_get_regime_hardness(&ctx)

        if lo >= 1 && lo <= 7 {
            sum_hard_by_lo[lo as usize] = sum_hard_by_lo[lo as usize] + hard
            sum_h2_by_lo[lo as usize]   = sum_h2_by_lo[lo as usize]   + hard * hard
            cnt_by_lo[lo as usize]      = cnt_by_lo[lo as usize] + 1
        }

        pri(idx); print(" ")
        pri(lo); print("  ")
        pri(hi); print("  ")
        pri(neg); print("  ")
        pri(r); print("  ")
        pri(confl); print("  ")
        prf(trust); print("  ")
        prf(hard); print("\n")

        idx = idx + 1
    }

    print("\n=== By fiber (lo=1..7, 12 prims each) ===\n")
    print("lo  mean_hard  var_hard  n\n")
    print("--  ---------  --------  --\n")

    var grand_sum: f64 = 0.0
    var grand_n: i32 = 0
    var lo2: i32 = 1
    while lo2 <= 7 {
        let n   = cnt_by_lo[lo2 as usize]
        let s   = sum_hard_by_lo[lo2 as usize]
        let s2  = sum_h2_by_lo[lo2 as usize]
        let mean = s / (n as f64)
        let variance = s2 / (n as f64) - mean * mean
        grand_sum = grand_sum + s
        grand_n   = grand_n   + n
        pri(lo2); print("   ")
        prf(mean); print("     ")
        prf(variance); print("     ")
        pri(n); print("\n")
        lo2 = lo2 + 1
    }

    let gm = grand_sum / (grand_n as f64)
    print("\nGrand mean hardness: "); prf(gm); print("\n")

    // Verdict: fiber clustering by within/between variance
    var min_mean: f64 = 999.0
    var max_mean: f64 = 0.0
    var lo3: i32 = 1
    while lo3 <= 7 {
        let n = cnt_by_lo[lo3 as usize]
        let mean = sum_hard_by_lo[lo3 as usize] / (n as f64)
        if mean < min_mean { min_mean = mean }
        if mean > max_mean { max_mean = mean }
        lo3 = lo3 + 1
    }

    print("\n--- Verdict ---\n")
    print("Formula: UNSAT guaranteed (χ(Moser spindle)=4, theorem, not assumption).\n")
    print("Max fiber mean: "); prf(max_mean)
    print("  Min: "); prf(min_mean); print("\n")

    if min_mean > 0.001 {
        let ratio = max_mean / min_mean
        print("Max/min ratio: "); prf(ratio); print("\n")
        if ratio > 1.5 {
            print("CONFIRMED: fiber hardness spread >1.5x.\n")
            print("ZD fiber (lo) correlates with CDCL refutation hardness of Moser UNSAT proof.\n")
            print("The algebraic fiber structure modulates epistemic difficulty.\n")
        } else {
            print("WEAK: spread <1.5x — fiber does not strongly discriminate refutation hardness.\n")
            print("Possible cause: 40-clause background too noisy relative to 61-clause UNSAT core.\n")
            print("Try: fewer background clauses, or larger UNSAT graph (Golomb/Wheel).\n")
        }
    } else {
        print("NULL: min fiber mean near zero — CDCL found trivial refutation regardless of fiber.\n")
        print("61-clause UNSAT core dominates; 40-clause background insufficient for variation.\n")
        print("Try: reduce UNSAT clause count (smaller χ=4 graph) or increase background.\n")
    }
}
