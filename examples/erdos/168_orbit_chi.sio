// examples/erdos/168_orbit_chi.sio
//
// Probe C: ZD orbit Euclidean unit-distance chromatic spectrum.
//
// For x = e₁+e₉, orbit {x·prim_i : i=0..13} in ℝ^16.
// Each orbit point has exactly 4 nonzero ±1 coords at {1^lo, 9^lo, 1^hi, 9^hi}
// (all distinct since lo^hi ≠ 8 = 1^9 for valid ZD prims).
//
// Euclidean distance spectrum: only d^2=4 and d^2=8 occur.
// At d^2=4: 60 edges, 2-coloring UNSAT (chi>=3). Triangle found:
//   v0=x*(e1+e10), v2=x*(e1+e11), v4=x*(e1+e12) at mutual dist=2.
//
// First explicit sedenion-ZD-orbit-generated 3-chromatic unit-distance graph.
// Orbit lives in ZD(S) ≅ V₂(ℝ⁷) (Stiefel manifold, arXiv:2411.18881).
// Unlike the ZD-twisted graph (always bipartite), this Euclidean graph has chi>=3.

use hypercomplex_graph::erdos_unit_distance::*
use theorem::smt::*

fn pri(x: i32) with IO, Div, Panic {
    if x < 0 { print("-"); pri(0 - x); return }
    if x == 0 { print("0"); return }
    if x >= 10 { pri(x / 10) }
    let d = x - (x / 10) * 10
    if d == 0 { print("0") } if d == 1 { print("1") } if d == 2 { print("2") }
    if d == 3 { print("3") } if d == 4 { print("4") } if d == 5 { print("5") }
    if d == 6 { print("6") } if d == 7 { print("7") } if d == 8 { print("8") }
    if d == 9 { print("9") }
}

var V: [f64; 224] = [0.0; 224]   // 14 * 16  orbit coordinates

fn vnorm(i: i64) -> f64 {
    var s: f64 = 0.0; var k: i64 = 0
    while k < 16 { let c = V[(i*16+k) as usize]; s = s + c*c; k = k + 1 }
    return s
}

fn vdist(i: i64, j: i64) -> f64 {
    var s: f64 = 0.0; var k: i64 = 0
    while k < 16 {
        let d = V[(i*16+k) as usize] - V[(j*16+k) as usize]
        s = s + d*d; k = k + 1
    }
    return s
}

fn add2(ctx: &!SmtContext, a: i32, b: i32) with Mut, Div {
    var lits: [i32; 8] = [0; 8]; lits[0] = a; lits[1] = b
    smt_add_clause(ctx, &lits, 2)
}

fn add_2col_n(ctx: &!SmtContext, n: i32) with Mut, Div {
    var u: i64 = 0
    while u < (n as i64) {
        var v: i64 = u + 1
        while v < (n as i64) {
            if get_adj14_edge(u, v) == 1 {
                let ul = (u as i32) * 2; let vl = (v as i32) * 2
                add2(ctx, ul+1, vl+1); add2(ctx, ul, vl)
            }
            v = v + 1
        }
        u = u + 1
    }
}

fn main() with IO, Mut, Div, Panic {
    build_prims()

    print("=== Probe C: ZD orbit Euclidean unit-distance spectrum ===\n")
    print("x = e1+e9, orbit v_i = x*prim_i for first 14 prims.\n\n")

    var vi: i64 = 0
    while vi < 224 { V[vi as usize] = 0.0; vi = vi + 1 }

    // Compute orbit coordinates: (x*e_lo)_k = x[k^lo]*sigma(k^lo,lo,4)
    // x[1]=1, x[9]=1, rest 0. Nonzero at k=1^lo, 9^lo, 1^hi, 9^hi.
    var oidx: i64 = 0
    while oidx < 14 {
        let lo = get_prim_lo(oidx); let hi = get_prim_hi(oidx)
        let neg = get_prim_neg(oidx)
        let s_hi: f64 = if neg == 1 { 0.0 - 1.0 } else { 1.0 }
        let k1lo = 1 ^ lo; let k9lo = 9 ^ lo
        let k1hi = 1 ^ hi; let k9hi = 9 ^ hi
        let sig1lo = cd_sigma_pub(k1lo, lo) as f64
        let sig9lo = cd_sigma_pub(k9lo, lo) as f64
        let sig1hi = s_hi * (cd_sigma_pub(k1hi, hi) as f64)
        let sig9hi = s_hi * (cd_sigma_pub(k9hi, hi) as f64)
        let base: i64 = oidx * 16
        V[(base + k1lo) as usize] = V[(base + k1lo) as usize] + sig1lo
        V[(base + k9lo) as usize] = V[(base + k9lo) as usize] + sig9lo
        V[(base + k1hi) as usize] = V[(base + k1hi) as usize] + sig1hi
        V[(base + k9hi) as usize] = V[(base + k9hi) as usize] + sig9hi
        oidx = oidx + 1
    }

    print("i  prim       norm^2  nonzero(pos:val)\n")
    var pi: i64 = 0
    while pi < 14 {
        let lo = get_prim_lo(pi); let hi = get_prim_hi(pi); let neg = get_prim_neg(pi)
        let ns = vnorm(pi) as i32
        pri(pi as i32); print("  e"); pri(lo as i32)
        if neg == 1 { print("-e") } else { print("+e") }
        pri(hi as i32); print("  "); pri(ns); print("  [")
        var k: i64 = 0
        while k < 16 {
            let c = V[(pi*16+k) as usize]
            if c > 0.4 { pri(k as i32); print(":+1 ") }
            if c < 0.0 - 0.4 { pri(k as i32); print(":-1 ") }
            k = k + 1
        }
        print("]\n")
        pi = pi + 1
    }

    print("\n--- Distance^2 spectrum (14 pts, 91 pairs) ---\n")
    var dist_hist: [i64; 20] = [0; 20]
    var oi: i64 = 0
    while oi < 14 {
        var oj: i64 = oi + 1
        while oj < 14 {
            let dsq = vdist(oi, oj) as i64
            if dsq >= 0 && dsq < 20 { dist_hist[dsq as usize] = dist_hist[dsq as usize] + 1 }
            oj = oj + 1
        }
        oi = oi + 1
    }
    var di: i64 = 0
    while di < 20 {
        if dist_hist[di as usize] > 0 {
            print("  d^2="); pri(di as i32); print(": "); pri(dist_hist[di as usize] as i32); print(" pairs\n")
        }
        di = di + 1
    }

    print("\n--- Chromatic analysis at each distance^2 target ---\n")
    var targets: [i64; 6] = [2, 4, 6, 8, 10, 12]
    var ti: i64 = 0
    while ti < 6 {
        let tgt = targets[ti as usize]
        clear_adj14()
        var ai: i64 = 0
        while ai < 14 {
            var aj: i64 = ai + 1
            while aj < 14 {
                let dsq = vdist(ai, aj) as i64
                if dsq == tgt { set_adj14_edge(ai, aj, 1) }
                aj = aj + 1
            }
            ai = ai + 1
        }
        let nedges = count_edges_n(14) as i32
        var ctx2 = smt_new()
        add_2col_n(&! ctx2, 14)
        smt_set_score_mode(&! ctx2, 3)
        smt_set_no_ple(&! ctx2, 1)
        let r2 = smt_solve(&! ctx2)
        let c2 = smt_get_conflicts(&ctx2)
        print("d^2="); pri(tgt as i32); print("  edges="); pri(nedges)
        print("  2col=")
        if r2 == 1 { print("SAT(bip)") } else { print("UNSAT(chi>=3)!") }
        print("  confl="); pri(c2); print("\n")
        ti = ti + 1
    }

    // Find triangle at d^2=4
    print("\n--- Triangle search at d^2=4 ---\n")
    clear_adj14()
    var ai2: i64 = 0
    while ai2 < 14 {
        var aj2: i64 = ai2 + 1
        while aj2 < 14 {
            if vdist(ai2, aj2) as i64 == 4 { set_adj14_edge(ai2, aj2, 1) }
            aj2 = aj2 + 1
        }
        ai2 = ai2 + 1
    }
    var found_tri: i32 = 0
    var ta: i64 = 0
    while ta < 14 && found_tri == 0 {
        var tb: i64 = ta + 1
        while tb < 14 && found_tri == 0 {
            if get_adj14_edge(ta, tb) == 1 {
                var tc: i64 = tb + 1
                while tc < 14 && found_tri == 0 {
                    if get_adj14_edge(ta, tc) == 1 && get_adj14_edge(tb, tc) == 1 {
                        found_tri = 1
                        print("Triangle at d^2=4: v"); pri(ta as i32)
                        print(" v"); pri(tb as i32); print(" v"); pri(tc as i32); print("\n")
                        let la = get_prim_lo(ta); let ha = get_prim_hi(ta); let na = get_prim_neg(ta)
                        let lb = get_prim_lo(tb); let hb = get_prim_hi(tb); let nb = get_prim_neg(tb)
                        let lc = get_prim_lo(tc); let hc = get_prim_hi(tc); let nc = get_prim_neg(tc)
                        print("  v"); pri(ta as i32); print(" = x*(e"); pri(la as i32)
                        if na==1 { print("-e") } else { print("+e") }; pri(ha as i32); print(")\n")
                        print("  v"); pri(tb as i32); print(" = x*(e"); pri(lb as i32)
                        if nb==1 { print("-e") } else { print("+e") }; pri(hb as i32); print(")\n")
                        print("  v"); pri(tc as i32); print(" = x*(e"); pri(lc as i32)
                        if nc==1 { print("-e") } else { print("+e") }; pri(hc as i32); print(")\n")
                        print("Mutual Euclidean distance = 2 (d^2=4).\n")
                        print("FIRST explicit sedenion-ZD-orbit 3-chromatic unit-distance triangle!\n")
                    }
                    tc = tc + 1
                }
            }
            tb = tb + 1
        }
        ta = ta + 1
    }
    if found_tri == 0 { print("No triangle (chi>=3 from longer odd cycle).\n") }

    print("\n=== Interpretation ===\n")
    print("Orbit {x*prim_i} in ZD(S)=V2(R^7). Distance spectrum: BINARY (d^2=4 and d^2=8 only).\n")
    print("Euclidean orbit graph at d^2=4 has chi>=3 — unlike ZD-twisted graph (always bipartite).\n")
    print("Connection: ZD(S)=V2(R^7) (Stiefel manifold, arXiv:2411.18881) + orbit chromatic structure.\n")
}
