// examples/erdos/erdos90_repcount_engine.sio
//
// Independent EXACT-arithmetic sanity check of the COMBINATORIAL CORE behind the
// OpenAI (2026) disproof of Erdős's planar unit-distance conjecture
// (Erdős #90; Lean formalization: github.com/logical-intelligence/erdos-unit-distance).
//
// We do NOT verify the disproof (its engine is class field theory: infinite
// Golod–Shafarevich pro-3 towers, far outside finite computation). We verify the
// elementary, classical fact the construction lifts to number-field towers.
//
// In the Lean `AdmissibleDatum`, the field is K = L(i) (the plane) and the t chosen
// rational primes satisfy `q_mod4 : q b % 4 = 1` and split completely. The exponent
// excess is `γ = t·log 2 − log H > 0`: each split prime q ≡ 1 (mod 4) DOUBLES the
// number of algebraic elements of a given norm (factor 2), while the class number
// (the loss) is bounded by H^f. In the base plane K = ℚ(i) = ℤ[i] this is exactly
// Gauss's sum-of-two-squares count:
//
//     for squarefree N = q_1 · … · q_t with each q_i prime ≡ 1 (mod 4):
//         r₂(N) := #{ (a,b) ∈ ℤ² : a² + b² = N } = 4 · 2^t.
//
// The 4 is the Gaussian units {±1,±i}; the 2^t is the "t·log 2" engine of γ.
// A single prime ≡ 3 (mod 4) factor sends r₂ to 0 — which is precisely why the
// construction REQUIRES q ≡ 1 (mod 4). All integer arithmetic, no floats.

fn isqrt(n: i64) -> i64 with Mut {
    var r = 0
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r
}

// r₂(N) = number of ordered, signed integer pairs (a,b) with a² + b² = N.
fn r2(n: i64) -> i64 with Mut {
    let s = isqrt(n)
    var cnt = 0
    var a = 0 - s
    while a <= s {
        var b = 0 - s
        while b <= s {
            if a * a + b * b == n { cnt = cnt + 1 }
            b = b + 1
        }
        a = a + 1
    }
    return cnt
}

// 4 · 2^t
fn expected(t: i64) -> i64 with Mut {
    var p = 4
    var i = 0
    while i < t { p = p * 2  i = i + 1 }
    return p
}

fn report(label_n: i64, n: i64, t: i64) with IO, Mut {
    let got = r2(n)
    let exp = expected(t)
    print("  N="); print_int(n); print("  r2="); print_int(got)
    print("  (4*2^"); print_int(t); print("="); print_int(exp); print(") ")
    if got == exp { print("[OK]\n") } else { print("[*]\n") }
}

fn main() -> i32 with IO, Mut {
    print("=== r2(N) doubling engine for primes q ≡ 1 (mod 4) — Erdős #90 core ===\n\n")

    print("Single primes ≡ 1 (mod 4): r2 = 8 = 4·2^1\n")
    report(0, 5, 1)        // 5
    report(0, 13, 1)       // 13
    report(0, 17, 1)       // 17
    report(0, 29, 1)       // 29

    print("\nProducts of distinct primes ≡ 1 (mod 4): r2 doubles per prime (= t·log2)\n")
    report(0, 5, 1)                       // 5            t=1 -> 8
    report(0, 5 * 13, 2)                  // 65           t=2 -> 16
    report(0, 5 * 13 * 17, 3)             // 1105         t=3 -> 32
    report(0, 5 * 13 * 17 * 29, 4)        // 32045        t=4 -> 64

    print("\nWhy q ≡ 1 (mod 4) is REQUIRED: a prime ≡ 3 (mod 4) factor kills r2\n")
    print("  r2(3)  = "); print_int(r2(3));  print("  (3 ≡ 3 mod 4)\n")
    print("  r2(7)  = "); print_int(r2(7));  print("  (7 ≡ 3 mod 4)\n")
    print("  r2(15) = "); print_int(r2(3 * 5)); print("  (3·5: the 3 kills the 5's reps)\n")
    print("  r2(21) = "); print_int(r2(3 * 7)); print("\n")

    print("\nInterpretation: γ = t·log2 − log H. The exact 2^t growth above is the\n")
    print("t·log2 engine. OpenAI's construction keeps it alive across an INFINITE\n")
    print("class field tower (K_j = L_j(i), deg → ∞) with class number ≤ H^f, so when\n")
    print("t·log2 > log H the unit-distance count beats n^(1+o(1)): νn(n) ≥ n^(1+δ).\n")
    print("This file verifies only the finite arithmetic core, not the tower.\n")
    return 0
}
