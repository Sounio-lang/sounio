// examples/erdos/cdcl_proof.sio
//
// CDCL with 1-UIP clause learning + DRUP proof emission — the scalable successor
// to the chronological DPLL emitter (dpll_scale_wall.sio). The learned clause from
// 1-UIP conflict analysis is a resolution consequence of existing clauses, hence
// RUP; emitting the sequence of learned clauses (ending in the empty clause) is a
// valid DRUP proof — exactly how production SAT solvers produce DRAT.
//
// Correctness net: every emitted proof is replayed by our independent native RUP
// checker AND by external drat-trim. A bug in the CDCL bookkeeping cannot produce
// a "VERIFIED" — the checker would reject it.
//
// Honest scope: the pigeonhole family K_n/(n-1)-col is exponential for *general*
// resolution (Haken 1985), so CDCL does not crack it either — but it learns, so it
// reaches further than tree-resolution DPLL before the wall, and on STRUCTURED
// instances (the de Grey unit-distance regime) clause learning is the mechanism
// that makes 4-colouring UNSAT tractable. This file builds and certifies that
// engine so the pipeline is ready when de Grey's graph data is available.
//
// All integer arithmetic; flat global arrays; DIMACS-style signed literals.

// ---- clause DB (originals + learned clauses appended) ----
var nvars: i32 = 0
var nclauses: i32 = 0
var cstart: [i32; 262144] = [0; 262144]
var clen: [i32; 262144] = [0; 262144]
var clits: [i64; 2097152] = [0; 2097152]

// ---- assignment / trail ----
var assign: [i32; 2048] = [0; 2048]     // 0 unknown, 1 true, -1 false (var 1-indexed)
var vlevel: [i32; 2048] = [0; 2048]
var reason: [i32; 2048] = [0; 2048]     // clause idx that implied v, or -1 (decision/none)
var trail_lit: [i64; 2048] = [0; 2048]  // assigned literals, in order (true literal)
var trail_len: i32 = 0
var trail_lim: [i32; 2048] = [0; 2048]  // trail_lim[L] = first trail index of level L
var cur_level: i32 = 0

// ---- conflict analysis scratch ----
var seen: [i32; 2048] = [0; 2048]
var LEARNT: [i64; 2048] = [0; 2048]
var llen: i32 = 0

// ---- DRUP proof ----
var P_n: i32 = 0
var P_start: [i32; 262144] = [0; 262144]
var P_len: [i32; 262144] = [0; 262144]
var P_lits: [i64; 2097152] = [0; 2097152]

var n_conflicts: i64 = 0
var CONFLICT_CAP: i64 = 5000000

fn lit_var(l: i64) -> i32 with Panic {
    if l < 0 { return (0 - l) as i32 }
    return l as i32
}

fn db_add(arr: &[i64; 2048], n: i32) -> i32 with Mut, Panic {
    if nclauses >= 262144 { return 0 - 1 }
    let idx = nclauses
    var start: i32 = 0
    if idx > 0 { start = cstart[idx - 1] + clen[idx - 1] }
    if (start as i64) + (n as i64) > 2097152 { return 0 - 1 }
    cstart[idx] = start
    clen[idx] = n
    var i: i32 = 0
    while i < n {
        clits[start + i] = arr[i]
        let v = lit_var(arr[i])
        if v > nvars { nvars = v }
        i = i + 1
    }
    nclauses = idx + 1
    return idx
}

// value of a literal under current assignment: 1 true, -1 false, 0 unknown.
fn litval(l: i64) -> i32 with Mut, Panic {
    let v = lit_var(l)
    var a = assign[v]
    if l < 0 { a = 0 - a }
    return a
}

fn enqueue(lit: i64, rs: i32) with Mut, Panic {
    let v = lit_var(lit)
    if lit < 0 { assign[v] = 0 - 1 } else { assign[v] = 1 }
    vlevel[v] = cur_level
    reason[v] = rs
    trail_lit[trail_len] = lit
    trail_len = trail_len + 1
}

// Full-scan unit propagation. Returns conflicting clause index, or -1 at fixpoint.
fn propagate() -> i32 with Mut, Panic {
    var changed: i32 = 1
    while changed == 1 {
        changed = 0
        var c: i32 = 0
        while c < nclauses {
            let st = cstart[c]
            let ln = clen[c]
            var sat: i32 = 0
            var unassigned: i32 = 0
            var last_lit: i64 = 0
            var k: i32 = 0
            while k < ln {
                let l = clits[st + k]
                let val = litval(l)
                if val == 1 { sat = 1 }
                if val == 0 { unassigned = unassigned + 1  last_lit = l }
                k = k + 1
            }
            if sat == 0 {
                if unassigned == 0 { return c }
                if unassigned == 1 {
                    enqueue(last_lit, c)
                    changed = 1
                }
            }
            c = c + 1
        }
    }
    return 0 - 1
}

fn emit_proof_clause() with Mut, Panic {
    let idx = P_n
    var start: i32 = 0
    if idx > 0 { start = P_start[idx - 1] + P_len[idx - 1] }
    P_start[idx] = start
    P_len[idx] = llen
    var i: i32 = 0
    while i < llen { P_lits[start + i] = LEARNT[i]  i = i + 1 }
    P_n = idx + 1
}

fn emit_empty() with Mut, Panic {
    let idx = P_n
    var start: i32 = 0
    if idx > 0 { start = P_start[idx - 1] + P_len[idx - 1] }
    P_start[idx] = start
    P_len[idx] = 0
    P_n = idx + 1
}

// 1-UIP conflict analysis. Fills LEARNT[0..llen] (LEARNT[0] = asserting UIP literal),
// emits it as a DRUP lemma, returns the backjump level.
fn analyze(confl: i32) -> i32 with Mut, Panic {
    var pathC: i32 = 0
    llen = 1                 // reserve LEARNT[0] for the UIP literal
    var p: i64 = 0           // 0 = undefined (no variable is 0)
    var ci: i32 = confl
    var index: i32 = trail_len - 1

    var go: i32 = 1
    while go == 1 {
        let st = cstart[ci]
        let ln = clen[ci]
        var k: i32 = 0
        while k < ln {
            let q = clits[st + k]
            let vq = lit_var(q)
            var skip: i32 = 0
            if p != 0 { if vq == lit_var(p) { skip = 1 } }
            if skip == 0 {
                if seen[vq] == 0 {
                    if vlevel[vq] > 0 {
                        seen[vq] = 1
                        if vlevel[vq] >= cur_level {
                            pathC = pathC + 1
                        } else {
                            LEARNT[llen] = q
                            llen = llen + 1
                        }
                    }
                }
            }
            k = k + 1
        }
        while seen[lit_var(trail_lit[index])] == 0 { index = index - 1 }
        p = trail_lit[index]
        seen[lit_var(p)] = 0
        pathC = pathC - 1
        if pathC <= 0 {
            go = 0
        } else {
            // invariant: pathC>0 means p is NOT the UIP, so p was unit-propagated
            // (the lone current-level decision is deepest and resolved last) =>
            // reason[var(p)] is a real clause index, never -1.
            ci = reason[lit_var(p)]
            index = index - 1
        }
    }
    LEARNT[0] = 0 - p

    var btlevel: i32 = 0
    var j: i32 = 1
    while j < llen {
        let lv = vlevel[lit_var(LEARNT[j])]
        if lv > btlevel { btlevel = lv }
        j = j + 1
    }
    j = 1
    while j < llen { seen[lit_var(LEARNT[j])] = 0  j = j + 1 }

    emit_proof_clause()
    return btlevel
}

fn backjump(btlevel: i32) with Mut, Panic {
    // invariant: the UIP is the unique current-level literal in LEARNT, so every
    // other learnt literal sits at a level < cur_level => btlevel < cur_level and
    // trail_lim[btlevel+1] (<= trail_lim[cur_level]) was set during the descent.
    let target = trail_lim[btlevel + 1]
    var i: i32 = trail_len - 1
    while i >= target {
        let v = lit_var(trail_lit[i])
        assign[v] = 0
        reason[v] = 0 - 1
        vlevel[v] = 0
        i = i - 1
    }
    trail_len = target
    cur_level = btlevel
}

fn pick_unassigned() -> i32 with Mut, Panic {
    var v: i32 = 1
    while v <= nvars {
        if assign[v] == 0 { return v }
        v = v + 1
    }
    return 0
}

// Returns 1 = SAT, 0 = UNSAT (DRUP proof in P_*), 2 = conflict cap hit.
fn solve_cdcl() -> i32 with Mut, Panic {
    cur_level = 0
    trail_lim[0] = 0
    var loops: i32 = 1
    while loops == 1 {
        let confl = propagate()
        if confl >= 0 {
            n_conflicts = n_conflicts + 1
            if n_conflicts > CONFLICT_CAP { return 2 }
            if cur_level == 0 {
                emit_empty()
                return 0
            }
            let bt = analyze(confl)
            let lidx = db_add(&LEARNT, llen)
            backjump(bt)
            enqueue(LEARNT[0], lidx)
        } else {
            let x = pick_unassigned()
            if x == 0 { return 1 }
            cur_level = cur_level + 1
            trail_lim[cur_level] = trail_len
            enqueue(x as i64, 0 - 1)
        }
    }
    return 2
}

// ---- independent RUP checker (replays P_* against the original formula) ----

var ramount: i32 = 0   // unused placeholder to keep section separable

fn reset_assign_full() with Mut, Panic {
    var i: i32 = 0
    while i <= nvars { assign[i] = 0  i = i + 1 }
}

fn rup_add_lemma(pst: i32, pln: i32) with Mut, Panic {
    if nclauses >= 262144 { return }
    let idx = nclauses
    var start: i32 = 0
    if idx > 0 { start = cstart[idx - 1] + clen[idx - 1] }
    if (start as i64) + (pln as i64) > 2097152 { return }
    cstart[idx] = start
    clen[idx] = pln
    var i: i32 = 0
    while i < pln { clits[start + i] = P_lits[pst + i]  i = i + 1 }
    nclauses = idx + 1
}

// Verify the DRUP proof against clauses [0, orig_nc). Returns 1 = VERIFIED UNSAT.
fn verify(orig_nc: i32) -> i32 with Mut, Panic {
    nclauses = orig_nc
    var pi: i32 = 0
    while pi < P_n {
        let pst = P_start[pi]
        let pln = P_len[pi]
        reset_assign_full()
        var taut: i32 = 0
        var k: i32 = 0
        while k < pln {
            let l = P_lits[pst + k]
            let v = lit_var(l)
            var want: i32 = 0 - 1
            if l < 0 { want = 1 }
            if assign[v] != 0 { if assign[v] != want { taut = 1 } }
            assign[v] = want
            k = k + 1
        }
        var ok: i32 = 0
        if taut == 1 { ok = 1 } else {
            let cf = propagate_noenq()
            if cf == 1 { ok = 1 }
        }
        if ok == 0 { return 0 - 1 }
        if pln == 0 { return 1 }
        rup_add_lemma(pst, pln)
        pi = pi + 1
    }
    return 0
}

// Propagation for the RUP checker: assigns implied units (level 0), returns 1 on
// conflict. Independent of trail/levels — pure clause logic.
fn propagate_noenq() -> i32 with Mut, Panic {
    var changed: i32 = 1
    while changed == 1 {
        changed = 0
        var c: i32 = 0
        while c < nclauses {
            let st = cstart[c]
            let ln = clen[c]
            var sat: i32 = 0
            var un: i32 = 0
            var last: i64 = 0
            var k: i32 = 0
            while k < ln {
                let l = clits[st + k]
                let v = lit_var(l)
                var a = assign[v]
                if l < 0 { a = 0 - a }
                if a == 1 { sat = 1 }
                if a == 0 { un = un + 1  last = l }
                k = k + 1
            }
            if sat == 0 {
                if un == 0 { return 1 }
                if un == 1 {
                    let v = lit_var(last)
                    if last < 0 { assign[v] = 0 - 1 } else { assign[v] = 1 }
                    changed = 1
                }
            }
            c = c + 1
        }
    }
    return 0
}

// ---- inline decimal + DIMACS/DRAT ----
fn print_digit(d: i64) with IO {
    if d == 0 { print("0") } else if d == 1 { print("1") } else if d == 2 { print("2") }
    else if d == 3 { print("3") } else if d == 4 { print("4") } else if d == 5 { print("5") }
    else if d == 6 { print("6") } else if d == 7 { print("7") } else if d == 8 { print("8") }
    else { print("9") }
}
fn print_dec(n: i64) with IO, Mut, Div, Panic {
    if n == 0 { print("0") return }
    var x = n
    if x < 0 { print("-") x = 0 - x }
    var buf: [i64; 24] = [0; 24]
    var len: i32 = 0
    while x > 0 { buf[len] = x % 10  x = x / 10  len = len + 1 }
    var i: i32 = len - 1
    while i >= 0 { print_digit(buf[i])  i = i - 1 }
}
fn emit_dimacs(orig_nc: i32) with IO, Mut, Div, Panic {
    print("p cnf ")  print_dec(nvars as i64)  print(" ")  print_dec(orig_nc as i64)  print("\n")
    var c: i32 = 0
    while c < orig_nc {
        let st = cstart[c]
        let ln = clen[c]
        var k: i32 = 0
        while k < ln { print_dec(clits[st + k])  print(" ")  k = k + 1 }
        print("0\n")
        c = c + 1
    }
}
fn emit_drat() with IO, Mut, Div, Panic {
    var pi: i32 = 0
    while pi < P_n {
        let pst = P_start[pi]
        let pln = P_len[pi]
        var k: i32 = 0
        while k < pln { print_dec(P_lits[pst + k])  print(" ")  k = k + 1 }
        print("0\n")
        pi = pi + 1
    }
}

fn reset_all() with Mut, Panic {
    var i: i32 = 0
    while i <= nvars { assign[i] = 0  vlevel[i] = 0  reason[i] = 0  seen[i] = 0  i = i + 1 }
    nvars = 0
    nclauses = 0
    trail_len = 0
    cur_level = 0
    P_n = 0
    n_conflicts = 0
}

// K_n with k colors (= pigeonhole PHP(n,k) when k=n-1). UNSAT iff k < n.
fn build_clique(n: i64, k: i64) with Mut, Div, Panic {
    var arr: [i64; 2048] = [0; 2048]
    var v: i64 = 0
    while v < n {
        var c: i64 = 0
        while c < k { arr[c as usize] = v*k + c + 1  c = c + 1 }
        let _ = db_add(&arr, k as i32)
        v = v + 1
    }
    var a: i64 = 0
    while a < n {
        var b: i64 = a + 1
        while b < n {
            var c: i64 = 0
            while c < k {
                arr[0] = 0 - (a*k + c + 1)
                arr[1] = 0 - (b*k + c + 1)
                let _ = db_add(&arr, 2)
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
}

fn run_case(n: i64) with IO, Mut, Div, Panic {
    reset_all()
    build_clique(n, n - 1)
    let orig_nc = nclauses
    print("K_")  print_dec(n)  print("/")  print_dec(n - 1)  print("-col  vars=")
    print_dec(nvars as i64)  print("  clauses=")  print_dec(orig_nc as i64)
    let r = solve_cdcl()
    if r == 2 {
        print("  conflicts>")  print_dec(CONFLICT_CAP)  print("  => CAP\n")
        return
    }
    if r == 1 { print("  SAT (UNEXPECTED)\n")  return }
    let conf = n_conflicts
    let lemmas = P_n
    reset_assign_full()
    let vr = verify(orig_nc)
    print("  conflicts=")  print_dec(conf)  print("  DRUP-lemmas=")  print_dec(lemmas as i64)
    if vr == 1 { print("  native RUP: VERIFIED\n") } else { print("  native RUP: FAILED("); print_dec(vr as i64); print(")\n") }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("=== CDCL (1-UIP) + DRUP emission — pigeonhole K_n/(n-1)-col ===\n")
    print("(CDCL learns, so it reaches further than tree-resolution DPLL before the\n")
    print(" Haken wall; structured instances are where learning gives big speedups)\n\n")

    run_case(4)
    run_case(5)
    run_case(6)
    run_case(7)
    run_case(8)
    run_case(9)
    run_case(10)

    print("\n-- certificate for external drat-trim: K_7 / 6-coloring --\n")
    reset_all()
    build_clique(7, 6)
    let onc = nclauses
    let s = solve_cdcl()
    if s == 0 {
        nclauses = onc
        print("%%DIMACS%%\n")
        emit_dimacs(onc)
        print("%%DRAT%%\n")
        emit_drat()
        print("%%END%%\n")
    }
    return 0
}
