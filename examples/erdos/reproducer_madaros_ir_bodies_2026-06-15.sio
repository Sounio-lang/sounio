// Minimal reproducer for BLK-20260615-erdos-madaros-ir-bodies
//
// Trigger: a recursive function followed by >= 8 sequential `if` statements
//          causes Madaros to fail with:
//              native_v2_compile: front-half failed: ir_bodies_failed
//
// Compiler: ./bin/souc (Madares v0.80.0, default engine)
// Command:  ./bin/souc compile reproducer_madaros_ir_bodies_2026-06-15.sio -o /tmp/out.elf
//
// Observed:
//   - With 7 sequential ifs: compiles successfully.
//   - With 8+ sequential ifs: ir_bodies_failed.
//   - Replacing the chain with else-if causes a segmentation fault in madaros.

fn pri(x: i64) with IO, Div, Panic {
    if x < 0 { print("NEG"); return }
    if x == 0 { print("0"); return }
    if x >= 10 { pri(x / 10) }
    let d = x - (x / 10) * 10
    if d == 0 { print("0") }
    if d == 1 { print("1") }
    if d == 2 { print("2") }
    if d == 3 { print("3") }
    if d == 4 { print("4") }
    if d == 5 { print("5") }
    if d == 6 { print("6") }
    if d == 7 { print("7") }
}

fn main() -> i32 with IO, Div, Panic {
    pri(42)
    print("\n")
    return 0
}
