// examples/erdos/moser_spindle_q16.sio
//
// Track 3 P1: Moser spindle over Q(√3, √11) in exact field-tower arithmetic.
//
// The Moser spindle is the smallest 4-chromatic unit-distance graph:
// 7 vertices, 11 edges, χ=4. Its joining angle satisfies cos θ = 5/6
// (= ω₃, the de Grey field generator), so coordinates live in Q(√3, √11).
//
// Two "diamonds" (K₄ minus one edge) joined at origin, rotated by θ where
// cos θ = 5/6, sin θ = √11/6. Scale by 12 → unit distance = dist²==144.
//
// Self-contained Q16 arithmetic (degrey_fieldtower pattern).

module erdos::moser_spindle_q16

struct Q16 { c: [i64; 16] }

fn bcoeff(mask: i64) -> i64 with Mut {
    var p = 1
    if (mask & 1) != 0 { p = p * 3 }
    if (mask & 2) != 0 { p = p * 5 }
    if (mask & 4) != 0 { p = p * 7 }
    if (mask & 8) != 0 { p = p * 11 }
    return p
}

fn q16_rat(v: i64) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    r.c[0] = v
    return r
}

fn q16_mono(idx: i64, v: i64) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    r.c[idx as usize] = v
    return r
}

fn q16_add(x: Q16, y: Q16) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    var i = 0
    while i < 16 {
        r.c[i as usize] = x.c[i as usize] + y.c[i as usize]
        i = i + 1
    }
    return r
}

fn q16_sub(x: Q16, y: Q16) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    var i = 0
    while i < 16 {
        r.c[i as usize] = x.c[i as usize] - y.c[i as usize]
        i = i + 1
    }
    return r
}

fn q16_mul(x: Q16, y: Q16) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    var i = 0
    while i < 16 {
        var j = 0
        while j < 16 {
            let coeff = bcoeff(i & j)
            let idx = (i ^ j) as usize
            r.c[idx] = r.c[idx] + x.c[i as usize] * y.c[j as usize] * coeff
            j = j + 1
        }
        i = i + 1
    }
    return r
}

fn q16_sq(x: Q16) -> Q16 with Mut, Panic { return q16_mul(x, x) }

fn q16_is_rat(x: Q16, v: i64) -> i64 with Mut, Panic {
    if x.c[0] != v { return 0 }
    var i = 1
    while i < 16 {
        if x.c[i as usize] != 0 { return 0 }
        i = i + 1
    }
    return 1
}

fn dist2(px: Q16, py: Q16, qx: Q16, qy: Q16) -> Q16 with Mut, Panic {
    let dx = q16_sub(px, qx)
    let dy = q16_sub(py, qy)
    return q16_add(q16_sq(dx), q16_sq(dy))
}

// ============================================================================
// Moser spindle coordinates (scaled ×12, unit distance = dist²==144)
// Basis indices: 0=rational, 1=√3, 8=√11, 9=√33=√3·√11
//
//   v0 = (0, 0)
//   v1 = (12, 0)
//   v2 = (6, 6√3)
//   v3 = (18, 6√3)
//   v4 = (10, 2√11)
//   v5 = (5−√33, √11+5√3)
//   v6 = (15−√33, 3√11+5√3)
// ============================================================================

fn vx(i: i64) -> Q16 with Mut, Panic {
    if i == 0 { return q16_rat(0) }
    if i == 1 { return q16_rat(12) }
    if i == 2 { return q16_rat(6) }
    if i == 3 { return q16_rat(18) }
    if i == 4 { return q16_rat(10) }
    if i == 5 { return q16_sub(q16_rat(5), q16_mono(9, 1)) }
    return q16_sub(q16_rat(15), q16_mono(9, 1))
}

fn vy(i: i64) -> Q16 with Mut, Panic {
    if i == 0 { return q16_rat(0) }
    if i == 1 { return q16_rat(0) }
    if i == 2 { return q16_mono(1, 6) }
    if i == 3 { return q16_mono(1, 6) }
    if i == 4 { return q16_mono(8, 2) }
    if i == 5 { return q16_add(q16_mono(8, 1), q16_mono(1, 5)) }
    return q16_add(q16_mono(8, 3), q16_mono(1, 5))
}

fn is_unit(i: i64, j: i64) -> i64 with Mut, Panic {
    let d = dist2(vx(i), vy(i), vx(j), vy(j))
    return q16_is_rat(d, 144)
}

var ADJ: [i64; 49] = [0; 49]
var COL: [i64; 7] = [0; 7]

fn build_adj() with Mut, Panic {
    var i = 0
    while i < 49 { ADJ[i as usize] = 0; i = i + 1 }
    var a = 0
    while a < 7 {
        var b = a + 1
        while b < 7 {
            if is_unit(a, b) == 1 {
                ADJ[(a * 7 + b) as usize] = 1
                ADJ[(b * 7 + a) as usize] = 1
            }
            b = b + 1
        }
        a = a + 1
    }
}

fn count_edges() -> i64 with Mut, Panic {
    var c = 0
    var a = 0
    while a < 7 {
        var b = a + 1
        while b < 7 {
            if ADJ[(a * 7 + b) as usize] == 1 { c = c + 1 }
            b = b + 1
        }
        a = a + 1
    }
    return c
}

fn colorable(n: i64, k: i64) -> i64 with Mut, Panic {
    var i = 0
    while i < n { COL[i as usize] = 0; i = i + 1 }
    var done = 0
    while done == 0 {
        var ok = 1
        var a = 0
        while a < n {
            var b = a + 1
            while b < n {
                if ADJ[(a * n + b) as usize] == 1 {
                    if COL[a as usize] == COL[b as usize] { ok = 0 }
                }
                b = b + 1
            }
            a = a + 1
        }
        if ok == 1 { return 1 }
        var c = 0
        var carry = 1
        while c < n && carry == 1 {
            COL[c as usize] = COL[c as usize] + 1
            if COL[c as usize] < k { carry = 0 }
            else { COL[c as usize] = 0 }
            c = c + 1
        }
        if carry == 1 { done = 1 }
    }
    return 0
}

fn chromatic_number(n: i64) -> i64 with Mut, Panic {
    var k = 1
    while k <= n {
        if colorable(n, k) == 1 { return k }
        k = k + 1
    }
    return n
}

fn main() with IO, Mut, Panic, Div {
    build_adj()
    let edges = count_edges()
    let chi = chromatic_number(7)
    print("=== Moser spindle over Q(sqrt3, sqrt11) — exact arithmetic ===\n")
    print("vertices: 7  edges: "); print_int(edges); print("\n")
    print("chromatic_number: "); print_int(chi); print("\n")
    if chi == 4 {
        print("CONFIRMED: chi=4 — field tower reaches Moser spindle level\n")
        print("Joining angle: cos(theta)=5/6 (omega_3), sin(theta)=sqrt11/6\n")
        print("This is the building block de Grey composed to reach chi=5.\n")
    } else {
        print("UNEXPECTED: chi="); print_int(chi); print(" (expected 4)\n")
    }
}
