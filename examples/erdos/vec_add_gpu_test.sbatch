#!/usr/bin/env bash
#SBATCH --job-name=vec-add-gpu-test
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=2
#SBATCH --mem=4G
#SBATCH --time=00:10:00
#SBATCH --chdir=/tmp
#SBATCH --output=/tmp/vec_add_gpu_test_%j.out
#SBATCH --partition=gpu-orangefs
set -euo pipefail
WORK="${SLURM_TMPDIR:-/tmp}/vec_add_$$"
mkdir -p "$WORK"; cd "$WORK"
base64 -d <<'PTX64' > vec_add.ptx
