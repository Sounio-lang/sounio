// examples/erdos/168_kgraph_coloring_test.sio
//
// SAT k-coloring encoding validation on known complete graphs.
// K_n requires exactly n colors: k-coloring UNSAT for k<n, SAT for k>=n.
//
// Tests: K3, K4, K5, K6 -- validates encoding correctness.
// FIXED ENCODING: variables start at index 1 (not 0), so literal 0 never appears.

use hypercomplex_graph::erdos_unit_distance::*
use theorem::smt::*

fn pri(x: i32) with IO, Div, Panic {
    if x < 0 { print("-"); pri(0 - x); return }
    if x == 0 { print("0"); return }
    if x >= 10 { pri(x / 10) }
    let d = x - (x / 10) * 10
    if d == 0 { print("0") } if d == 1 { print("1") } if d == 2 { print("2") }
    if d == 3 { print("3") } if d == 4 { print("4") } if d == 5 { print("5") }
    if d == 6 { print("6") } if d == 7 { print("7") } if d == 8 { print("8") }
    if d == 9 { print("9") }
}

fn set_kn(n: i32) with Mut {
    clear_adj14()
    var i: i64 = 0
    while i < (n as i64) {
        var j: i64 = i + 1
        while j < (n as i64) { set_adj14_edge(i, j, 1); j = j + 1 }
        i = i + 1
    }
}

fn cl2(ctx: &!SmtContext, a: i32, b: i32) with Mut, Div {
    var lits: [i32; 8] = [0; 8]; lits[0] = a; lits[1] = b
    smt_add_clause(ctx, &lits, 2)
}

// k-coloring on n vertices using ADJ14 (1-indexed variables to avoid literal 0)
fn add_kcol(ctx: &!SmtContext, n: i32, k: i32) with Mut, Div {
    let ni = n as i64; let ki = k as i64
    // At-least-one per vertex (k positive literals per clause)
    var v: i64 = 0
    while v < ni {
        var lits: [i32; 8] = [0; 8]
        var c: i64 = 0
        while c < ki {
            lits[c as usize] = ((v*ki + c + 1)*2 + 1) as i32
            c = c + 1
        }
        smt_add_clause(ctx, &lits, k)
        v = v + 1
    }
    // At-most-one per vertex (pairwise negative clauses)
    v = 0
    while v < ni {
        var ci1: i64 = 0
        while ci1 < ki {
            var ci2: i64 = ci1 + 1
            while ci2 < ki {
                let nl1 = ((v*ki + ci1 + 1)*2) as i32
                let nl2 = ((v*ki + ci2 + 1)*2) as i32
                cl2(ctx, nl1, nl2)
                ci2 = ci2 + 1
            }
            ci1 = ci1 + 1
        }
        v = v + 1
    }
    // Edge constraints
    var u: i64 = 0
    while u < ni {
        var w: i64 = u + 1
        while w < ni {
            if get_adj14_edge(u, w) == 1 {
                var c: i64 = 0
                while c < ki {
                    let nl1 = ((u*ki + c + 1)*2) as i32
                    let nl2 = ((w*ki + c + 1)*2) as i32
                    cl2(ctx, nl1, nl2)
                    c = c + 1
                }
            }
            w = w + 1
        }
        u = u + 1
    }
}

fn test_kn(n: i32) with IO, Mut, Div, Panic {
    set_kn(n)
    print("K"); pri(n); print(": ")
    var k: i32 = 2
    while k <= n + 1 {
        var ctx = smt_new()
        add_kcol(&! ctx, n, k)
        smt_set_score_mode(&! ctx, 3)
        smt_set_no_ple(&! ctx, 1)
        let r = smt_solve(&! ctx)
        pri(k); print("-col=")
        if r == 1 { print("SAT") } else { print("UNSAT") }
        print("  ")
        k = k + 1
    }
    print("\n")
}

fn main() with IO, Mut, Div, Panic {
    build_prims()
    print("=== k-coloring encoding validation (1-indexed variables, no literal 0) ===\n")
    print("Expected: K_n requires exactly n colors.\n\n")
    test_kn(3)
    test_kn(4)
    test_kn(5)
    test_kn(6)
    print("\nCorrect results: K3: 2=UNSAT 3=SAT; K4: 3=UNSAT 4=SAT; K5: 4=UNSAT 5=SAT; K6: 5=UNSAT 6=SAT\n")
}
