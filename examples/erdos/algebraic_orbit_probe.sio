// examples/erdos/algebraic_orbit_probe.sio
//
// Track 3 (pivoted) P0: verify that field-tower coordinates escape the
// integer bipartite obstruction.
//
// The hexagonal wheel W_6 (center + 6 hexagon vertices) is a unit-distance
// graph with chromatic number 3. If the Q(√3) arithmetic reconstructs it
// and gives χ=3 (not 2), the construction has escaped bipartiteness.
//
// Uses local Q16 variables (not global struct arrays) — matches the
// degrey_fieldtower working pattern.

module erdos::algebraic_orbit_probe

struct Q16 { c: [i64; 16] }

fn bcoeff(mask: i64) -> i64 with Mut {
    var p = 1
    if (mask & 1) != 0 { p = p * 3 }
    if (mask & 2) != 0 { p = p * 5 }
    if (mask & 4) != 0 { p = p * 7 }
    if (mask & 8) != 0 { p = p * 11 }
    return p
}

fn q16_zero() -> Q16 { return Q16 { c: [0; 16] } }

fn q16_rat(v: i64) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    r.c[0] = v
    return r
}

fn q16_mono(idx: i64, v: i64) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    r.c[idx as usize] = v
    return r
}

fn q16_add(x: Q16, y: Q16) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    var i = 0
    while i < 16 {
        r.c[i as usize] = x.c[i as usize] + y.c[i as usize]
        i = i + 1
    }
    return r
}

fn q16_sub(x: Q16, y: Q16) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    var i = 0
    while i < 16 {
        r.c[i as usize] = x.c[i as usize] - y.c[i as usize]
        i = i + 1
    }
    return r
}

fn q16_mul(x: Q16, y: Q16) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    var i = 0
    while i < 16 {
        var j = 0
        while j < 16 {
            let coeff = bcoeff(i & j)
            let idx = (i ^ j) as usize
            r.c[idx] = r.c[idx] + x.c[i as usize] * y.c[j as usize] * coeff
            j = j + 1
        }
        i = i + 1
    }
    return r
}

fn q16_sq(x: Q16) -> Q16 with Mut, Panic { return q16_mul(x, x) }

fn q16_is_rat(x: Q16, v: i64) -> i64 with Mut, Panic {
    if x.c[0] != v { return 0 }
    var i = 1
    while i < 16 {
        if x.c[i as usize] != 0 { return 0 }
        i = i + 1
    }
    return 1
}

fn dist2(px: Q16, py: Q16, qx: Q16, qy: Q16) -> Q16 with Mut, Panic {
    let dx = q16_sub(px, qx)
    let dy = q16_sub(py, qy)
    return q16_add(q16_sq(dx), q16_sq(dy))
}

// ============================================================================
// W_6 coordinate accessors (returns the x or y Q16 coordinate for vertex i)
// Scaled by 2: unit distance = dist²==4.
//   v0 = (0,0), v1 = (2,0), v2 = (-1,sqrt3), v3 = (-1,-sqrt3),
//   v4 = (-2,0), v5 = (1,-sqrt3), v6 = (1,sqrt3)
// ============================================================================

fn wx(i: i64) -> Q16 with Mut, Panic {
    if i == 0 { return q16_rat(0) }
    if i == 1 { return q16_rat(2) }
    if i == 2 { return q16_rat(0 - 1) }
    if i == 3 { return q16_rat(0 - 1) }
    if i == 4 { return q16_rat(0 - 2) }
    if i == 5 { return q16_rat(1) }
    return q16_rat(1)
}

fn wy(i: i64) -> Q16 with Mut, Panic {
    if i == 0 { return q16_rat(0) }
    if i == 1 { return q16_rat(0) }
    if i == 2 { return q16_mono(1, 1) }
    if i == 3 { return q16_mono(1, 0 - 1) }
    if i == 4 { return q16_rat(0) }
    if i == 5 { return q16_mono(1, 0 - 1) }
    return q16_mono(1, 1)
}

fn is_unit(i: i64, j: i64) -> i64 with Mut, Panic {
    let d = dist2(wx(i), wy(i), wx(j), wy(j))
    return q16_is_rat(d, 4)
}

// Brute-force k-colorability using a flat i64 adjacency matrix.
var ADJ: [i64; 49] = [0; 49]
var COL: [i64; 7] = [0; 7]

fn build_adj() with Mut, Panic {
    var i = 0
    while i < 49 { ADJ[i as usize] = 0; i = i + 1 }
    var a = 0
    while a < 7 {
        var b = a + 1
        while b < 7 {
            if is_unit(a, b) == 1 {
                ADJ[(a * 7 + b) as usize] = 1
                ADJ[(b * 7 + a) as usize] = 1
            }
            b = b + 1
        }
        a = a + 1
    }
}

fn count_edges() -> i64 with Mut, Panic {
    var c = 0
    var a = 0
    while a < 7 {
        var b = a + 1
        while b < 7 {
            if ADJ[(a * 7 + b) as usize] == 1 { c = c + 1 }
            b = b + 1
        }
        a = a + 1
    }
    return c
}

fn colorable(n: i64, k: i64) -> i64 with Mut, Panic {
    var i = 0
    while i < n { COL[i as usize] = 0; i = i + 1 }
    var done = 0
    while done == 0 {
        var ok = 1
        var a = 0
        while a < n {
            var b = a + 1
            while b < n {
                if ADJ[(a * n + b) as usize] == 1 {
                    if COL[a as usize] == COL[b as usize] { ok = 0 }
                }
                b = b + 1
            }
            a = a + 1
        }
        if ok == 1 { return 1 }
        var c = 0
        var carry = 1
        while c < n && carry == 1 {
            COL[c as usize] = COL[c as usize] + 1
            if COL[c as usize] < k { carry = 0 }
            else { COL[c as usize] = 0 }
            c = c + 1
        }
        if carry == 1 { done = 1 }
    }
    return 0
}

fn chromatic_number(n: i64) -> i64 with Mut, Panic {
    var k = 1
    while k <= n {
        if colorable(n, k) == 1 { return k }
        k = k + 1
    }
    return n
}

fn main() with IO, Mut, Panic, Div {
    // Sanity: check dist²(v0,v1) and dist²(v0,v2) are both 4
    let d01 = is_unit(0, 1)
    let d02 = is_unit(0, 2)
    let d12 = is_unit(1, 2)
    print("dist2(v0,v1)==4: "); print_int(d01)
    print("  dist2(v0,v2)==4: "); print_int(d02)
    print("  dist2(v1,v2)==4: "); print_int(d12)
    print("\n")

    build_adj()
    let edges = count_edges()
    let chi = chromatic_number(7)
    print("=== Algebraic orbit P0: hexagonal wheel W_6 over Q(sqrt3) ===\n")
    print("vertices: 7  edges: "); print_int(edges); print("\n")
    print("chromatic_number: "); print_int(chi); print("\n")
    if chi >= 3 {
        print("CONFIRMED: field-tower coords escape bipartite obstruction (chi>=3)\n")
    } else {
        print("UNEXPECTED: chi<3 — check distance computation\n")
    }
}
