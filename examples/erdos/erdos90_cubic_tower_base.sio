// examples/erdos/erdos90_cubic_tower_base.sio
//
// EXPLICIT, EXACT-ARITHMETIC certification of the NUMBER-FIELD BASE LAYER of the
// OpenAI (2026) disproof of Erdős's planar unit-distance conjecture
// (Erdős #90; Lean: github.com/logical-intelligence/erdos-unit-distance).
//
// Their proof is existential and conditional. Two of its load-bearing Lean
// theorems are arithmetic facts about the totally-real cubic subfield
// L ⊂ ℚ(ζ_r) used as the base of the Golod–Shafarevich pro-3 tower:
//
//   `cubic_subfield_prime_ramification_data` :  for prime r ≡ 1 (mod 3),
//        r is TOTALLY ramified in L (e=3, f=1, g=1) and EVERY other prime
//        q ≠ r is unramified in L.
//   `differentIdeal_cubic_subfield_eq_prime_sq` :  differentIdeal ℤ 𝓞_L = P²
//        (tame ramification, e−1 = 2), hence  disc(L) = N(P²) = r².
//
// Lean states these for ALL such r as abstract ideal-theoretic facts. Here we
// make them CONCRETE and machine-checkable: we GENERATE the cubic field from
// scratch via Gauss periods, then certify the ramification data as exact
// integers. This is the explicit witness the infinitary proof never writes down.
//
//   Gauss: for prime r ≡ 1 (mod 3), write 4r = L² + 27·M² with L ≡ 1 (mod 3).
//   The period polynomial of the cubic subfield is
//        f(x) = x³ + x² − ((r−1)/3)·x − (r·(L+3) − 1)/27.
//
//   Polynomial vs FIELD discriminant: disc(f) = disc(L) · s², where s = [𝓞_L : ℤ[α]]
//   is the index of the period order. Since L is cyclic cubic of conductor r,
//   disc(L) = r² (conductor–discriminant formula), hence disc(f) = (r·s)².
//   Certificate 1:  disc(f)/r² is a PERFECT SQUARE s²  ⇒  disc(L) = disc(f)/s² = r²,
//                   i.e. r is the unique ramified prime (every q ≠ r unramified).
//   Certificate 2:  f(x) ≡ (x − k)³  (mod r)  (with r ∤ s, Dedekind)  ⇒  r totally ramified.
//
// All i64 integer arithmetic, no floats, no external libraries.

fn isqrt(n: i64) -> i64 with Mut {
    if n < 0 { return 0 }
    var r = 0
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r
}

fn pmod(x: i64, m: i64) -> i64 with Div {
    return ((x % m) + m) % m
}

// Discriminant of monic cubic x³ + A·x² + B·x + C.
fn cubic_disc(a: i64, b: i64, c: i64) -> i64 {
    return 18 * a * b * c - 4 * a * a * a * c + a * a * b * b - 4 * b * b * b - 27 * c * c
}

// Certify the cubic subfield L ⊂ ℚ(ζ_r) for a prime r ≡ 1 (mod 3).
fn certify(r: i64) -> i64 with IO, Mut, Div, Panic {
    if pmod(r, 3) != 1 {
        print("  r="); print_int(r); print("  SKIP (r not ≡ 1 mod 3)\n")
        return 0
    }

    // Solve 4r = L² + 27·M² (Gauss); the period polynomial needs L ≡ 1 (mod 3).
    let four_r = 4 * r
    var m = 1
    var mfound = 0
    var labs = 0 - 1
    while 27 * m * m < four_r {
        let rem = four_r - 27 * m * m
        let s = isqrt(rem)
        if s * s == rem { labs = s  mfound = m  m = four_r }   // found; force loop exit
        m = m + 1
    }
    if labs < 0 {
        print("  r="); print_int(r); print("  FAIL (no 4r = L²+27M²)\n")
        return 0
    }
    var lval = labs
    if pmod(lval, 3) != 1 { lval = 0 - lval }

    // Period polynomial f(x) = x³ + A·x² + B·x + C, with A = 1.
    let a = 1
    let b = 0 - (r - 1) / 3
    let c = 0 - (r * (lval + 3) - 1) / 27

    // Certificate 1: disc(f) = (r·s)², i.e. disc(f)/r² is a perfect square s².
    // Then the FIELD discriminant is disc(f)/s² = r² (s = period-order index).
    let disc = cubic_disc(a, b, c)
    let r2 = r * r
    var pass1 = 0
    var sidx = 0
    if disc > 0 {
        if disc % r2 == 0 {
            let quo = disc / r2
            let s = isqrt(quo)
            if s * s == quo { pass1 = 1  sidx = s }
        }
    }

    // Certificate 2: f(x) ≡ (x − k)³ (mod r), i.e. r totally ramified.
    // (x − k)³ = x³ − 3k·x² + 3k²·x − k³.  Match A,B,C mod r.
    // From −3k ≡ A = 1 (mod r): for r ≡ 1 (mod 3), inv(3) = (2r+1)/3, k = r − inv3.
    let inv3 = (2 * r + 1) / 3
    let k = pmod(0 - inv3, r)
    let mA = pmod(0 - 3 * k, r)              // expect ≡ A = 1
    let mB = pmod(3 * k * k, r)              // expect ≡ B
    let mC = pmod(0 - k * k % r * k, r)      // expect ≡ C
    var pass2 = 0
    if mA == pmod(a, r) {
        if mB == pmod(b, r) {
            if mC == pmod(c, r) { pass2 = 1 }
        }
    }

    print("  r="); print_int(r)
    print("  4r=L²+27M²: L="); print_int(lval); print(" M="); print_int(mfound)
    print("  | f = x^3 + x^2 + ("); print_int(b); print(")x + ("); print_int(c); print(")\n")
    print("        disc(f)="); print_int(disc)
    print("  = r^2 * "); print_int(sidx); print("^2   (index s="); print_int(sidx)
    print(", field disc = disc/s^2 = r^2 = "); print_int(r2); print(")")
    if pass1 == 1 { print("  [field disc=r^2 OK]") } else { print("  [disc NOT r^2*square]") }
    if pass2 == 1 { print("  [f≡(x-k)^3 mod r: r totally ramified OK]\n") }
    else { print("  [total-ramification CHECK FAILED]\n") }

    if pass1 == 1 {
        if pass2 == 1 { return 1 }
    }
    return 0
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("=== Cubic tower-base certifier for the OpenAI 2026 Erdős #90 disproof ===\n")
    print("Explicit witness for Lean theorems `cubic_subfield_prime_ramification_data`\n")
    print("and `differentIdeal_cubic_subfield_eq_prime_sq` (disc = r^2), per prime r ≡ 1 (mod 3).\n\n")

    var primes: [i64; 11] = [0; 11]
    primes[0 as usize] = 7
    primes[1 as usize] = 13
    primes[2 as usize] = 19
    primes[3 as usize] = 31
    primes[4 as usize] = 37
    primes[5 as usize] = 43
    primes[6 as usize] = 61
    primes[7 as usize] = 67
    primes[8 as usize] = 73
    primes[9 as usize] = 79
    primes[10 as usize] = 97

    var passed = 0
    var i = 0
    while i < 11 {
        let ok = certify(primes[i as usize])
        passed = passed + ok
        i = i + 1
    }

    print("\nCertified ")
    print_int(passed)
    print(" / 11 cubic base fields (disc = r^2 AND r totally ramified).\n")
    print("\nWhat this is: the explicit, exact-arithmetic shadow of the abstract ramification\n")
    print("Lean lemmas. What it is NOT: the tower's infinitude (Golod–Shafarevich, d^2 < 4r)\n")
    print("or the geometric exponent γ > 0 — those need genuine class field theory, not\n")
    print("finite computation. Sounio certifies here exactly the layer that IS computable.\n")

    if passed == 11 { return 0 }
    return 1
}
