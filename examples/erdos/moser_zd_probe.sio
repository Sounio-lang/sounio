// examples/erdos/moser_zd_probe.sio
//
// First executable Erdős #508/#704 artifact (resolution effort).
//
// Lifts a 7-vertex integer probe into sedenion (16D) coordinates, builds its
// classical unit-distance conflict graph, then applies each of the 84 verified
// primitive zero-divisor "surgeries" (right-multiplication by e_lo ± e_hi) and
// computes the exact chromatic number of every twisted graph.
//
// The question this probe answers, reproducibly: does ZD surgery break the
// bipartite structure of an integer unit-distance graph (force chi >= 3)?
//
// All algebra mirrors the verified bridge (84 primitives / 168 ZD classes) in
// formal/lean4/SounioZeroDivisorBridge.lean. See the module for the honest
// mathematical frame and source-of-truth references.

use hypercomplex_graph::erdos_unit_distance::*

fn main() -> i32 with IO, Mut, Panic, Div {
    let raised = erdos_run_demo()
    if raised > 0 {
        print("RESULT: some ZD surgery raised the chromatic number.\n")
    } else {
        print("RESULT: no ZD surgery raised chromatic number on this probe ")
        print("(honest null — see doc for next-iteration levers).\n")
    }
    return 0
}
