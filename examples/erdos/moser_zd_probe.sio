// examples/erdos/moser_zd_probe.sio
//
// First executable Erdős #508/#704 artifact (resolution effort).
//
// Lifts a 7-vertex integer probe into sedenion (16D) coordinates, builds its
// classical unit-distance conflict graph, then runs TWO zero-divisor surgery
// families and computes the exact chromatic number of every twisted graph:
//   (1) linear  — right-multiplication by each of the 84 primitives e_lo ± e_hi;
//   (2) associator — (p·u)·v over the 168 ZD pairs (u·v=0), genuine
//       non-associativity since assoc(p,u,v) = (p·u)·v.
//
// The question, reproducibly: does ZD surgery break the bipartite structure of
// an integer unit-distance graph (force chi >= 3)?
//
// All algebra mirrors the verified bridge (84 primitives / 168 ZD classes) in
// formal/lean4/SounioZeroDivisorBridge.lean. See the module for the honest
// mathematical frame and source-of-truth references.

use hypercomplex_graph::erdos_unit_distance::*

fn main() -> i32 with IO, Mut, Panic, Div {
    let lin = erdos_run_demo()           // (1) 84 linear surgeries, 7-vertex probe
    print("\n")
    let assoc = erdos_run_assoc_demo()   // (2) 168 associator surgeries, 7-vertex probe
    print("\n")
    let scale = erdos_run_scale_search() // (3) both families on weight-<=2 families (137 + 273), BFS
    print("\n")
    let left = erdos_run_left_search()   // (4) LEFT-multiplication v·d on both families
    print("\n")
    // (5) NON-distance: associator conflict graph — the lever that breaks the ceiling
    let conf = erdos_run_assoc_conflict_search()
    let _ = assoc_conflict_witness(0)    // concrete triangle {e1,e2,e3} + greedy chi bound
    print("\n")
    // (6) sparse rigorous gap: triangle-free (omega=2) non-bipartite (chi>=3) => chi>omega
    let _ = erdos_run_sparse_gap(0, 8)
    print("\n")
    // (7) REALIZABLE attempt: Euclidean unit-distance graph on 84 primitives (in R^16)
    let r6 = erdos_run_realizable_gap(6)
    let r2 = erdos_run_realizable_gap(2)
    print("\n")
    print("=== SUMMARY ===\n")
    print("distance-based surgery (right/associator-distance/left): bipartite (chi<=2), ")
    print("by a two-sided total-parity invariant (proved in Lean).\n")
    if conf > 0 {
        print("NON-distance associator conflict graph: chi>=3 (")
        print_int(conf); print("/84 primitives), parity ceiling BROKEN — ")
        print("non-associativity is essential. Triangle witness {e1,e2,e3} proved in Lean.\n")
    }
    print("Sparse regime (chi>omega) reached rigorously: induced C5 (omega=2, chi=3) ")
    print("in the T=8 conflict graph, certified in Lean. Honest scope: Nivel-2 algebraic ")
    print("separation, NOT yet a geometric Erdos bound (a C5 is a trivial unit pentagon).\n")
    if r6 == 0 && r2 == 0 {
        print("REALIZABLE bridge: NULL. Euclidean unit-distance graphs on the 84 ")
        print("primitives are bipartite/clique-driven (no sparse chi>omega). The gap ")
        print("lives only in the non-realizable associator relation — the precise ")
        print("obstruction to a geometric Erdos bound.\n")
    }
    return 0
}
