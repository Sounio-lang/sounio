// examples/erdos/168_cross_half_flip.sio
//
// B probe (attempt 3): cross-half chromatic-flip detector.
//
// All pairs of distinct sedenion basis elements have |eᵢ - eⱼ|² = 2 (target) — they
// form K_n in the untwisted adjacency. Under ZD surgery, the twisted norm |diff·prim|²
// varies, creating sparse graphs with structure determined by the algebra.
//
// The 14-vertex probe used only FIRST-HALF basis elements (e₀..e₇ and sums). Those graphs
// were always bipartite — the first-half algebra preserves a 2-coloring under surgery.
//
// This probe uses BOTH halves: {e₁, e₂, e₃, e₈, e₉, e₁₀} (3 first-half + 3 second-half).
// Cross-half interactions under ZD surgery (rmul by e_lo ± e_hi where lo∈first, hi∈second)
// may produce odd cycles, breaking bipartiteness.
//
// Vertices (sedenion component index in PROBE14):
//   v0 = e₁  (component index 1)
//   v1 = e₂  (component index 2)
//   v2 = e₃  (component index 3)
//   v3 = e₈  (component index 8)
//   v4 = e₉  (component index 9)
//   v5 = e₁₀ (component index 10)
//
// All 15 pairs have exact integer coordinates → floating-point errors ~machine epsilon.
// 2-coloring SAT on 6 vertices detects odd cycles (χ≥3).
//
// Falsifiable prediction:
//   Some ZD surgery (involving cross-half prim e_lo ± e_hi) creates an odd cycle
//   among these 6 vertices, while other surgeries produce bipartite graphs.
//   → ZD algebra controls χ on this probe.

use hypercomplex_graph::erdos_unit_distance::*
use theorem::smt::*

fn pri(x: i32) with IO, Div, Panic {
    if x < 0 { print("-"); pri(0 - x); return }
    if x == 0 { print("0"); return }
    if x >= 10 { pri(x / 10) }
    let d = x - (x / 10) * 10
    if d == 0 { print("0") } if d == 1 { print("1") } if d == 2 { print("2") }
    if d == 3 { print("3") } if d == 4 { print("4") } if d == 5 { print("5") }
    if d == 6 { print("6") } if d == 7 { print("7") } if d == 8 { print("8") }
    if d == 9 { print("9") }
}

fn add2(ctx: &!SmtContext, a: i32, b: i32) with Mut, Div {
    var lits: [i32; 8] = [0; 8]
    lits[0] = a; lits[1] = b
    smt_add_clause(ctx, &lits, 2)
}

fn add3(ctx: &!SmtContext, a: i32, b: i32, c: i32) with Mut, Div {
    var lits: [i32; 8] = [0; 8]
    lits[0] = a; lits[1] = b; lits[2] = c
    smt_add_clause(ctx, &lits, 3)
}

// 2-coloring of first n vertices: UNSAT ↔ odd cycle ↔ χ≥3
fn add_2col_n(ctx: &!SmtContext, n: i32) with Mut, Div {
    var u: i64 = 0
    while u < (n as i64) {
        var v: i64 = u + 1
        while v < (n as i64) {
            if get_adj14_edge(u, v) == 1 {
                let ul = (u as i32) * 2
                let vl = (v as i32) * 2
                add2(ctx, ul + 1, vl + 1)
                add2(ctx, ul,     vl)
            }
            v = v + 1
        }
        u = u + 1
    }
}

// 3-coloring of first n vertices
fn add_3col_n(ctx: &!SmtContext, n: i32) with Mut, Div {
    var v: i32 = 0
    while v < n {
        add3(ctx, (v*3+0)*2, (v*3+1)*2, (v*3+2)*2)
        add2(ctx, (v*3+0)*2+1, (v*3+1)*2+1)
        add2(ctx, (v*3+0)*2+1, (v*3+2)*2+1)
        add2(ctx, (v*3+1)*2+1, (v*3+2)*2+1)
        v = v + 1
    }
    var u: i64 = 0
    while u < (n as i64) {
        var w: i64 = u + 1
        while w < (n as i64) {
            if get_adj14_edge(u, w) == 1 {
                var c: i32 = 0
                while c < 3 {
                    let uv = (u as i32) * 3 + c
                    let wv = (w as i32) * 3 + c
                    add2(ctx, uv*2+1, wv*2+1)
                    c = c + 1
                }
            }
            w = w + 1
        }
        u = u + 1
    }
}

fn setup_cross_half() with Mut {
    zero_probe14()
    // v0 = e₁: component 1 = 1.0
    set_probe14_coord(0, 1, 1.0)
    // v1 = e₂: component 2 = 1.0
    set_probe14_coord(1, 2, 1.0)
    // v2 = e₃: component 3 = 1.0
    set_probe14_coord(2, 3, 1.0)
    // v3 = e₈: component 8 = 1.0
    set_probe14_coord(3, 8, 1.0)
    // v4 = e₉: component 9 = 1.0
    set_probe14_coord(4, 9, 1.0)
    // v5 = e₁₀: component 10 = 1.0
    set_probe14_coord(5, 10, 1.0)
}

fn main() with IO, Mut, Div, Panic {
    build_prims()
    setup_cross_half()

    print("=== B: Cross-half chromatic-flip detector ===\n")
    print("Vertices: {e1,e2,e3} (first half) + {e8,e9,e10} (second half).\n")
    print("All pairs exact integer coords: |eᵢ-eⱼ|²=2 before surgery.\n")
    print("Surgery target |diff·prim|²=2. 2-col SAT detects χ≥3.\n\n")

    // Sanity: check idx=0 adjacency
    build_twisted_adj14_pub(0)
    let e_sanity = count_edges_n(6) as i32
    print("idx=0 edges on 6 verts: "); pri(e_sanity); print("\n")
    print("adj row0: ")
    var si: i64 = 0
    while si < 6 { pri(get_adj14_edge(0, si) as i32); si = si + 1 }
    print("\n\n")

    print("idx lo hi e  r2 c2  r3 c3  chi  edges\n")
    print("--- -- -- -  -- --  -- --  ---  -----\n")

    var n_bip:  i32 = 0
    var n_chi3: i32 = 0
    var n_chi4: i32 = 0
    var fiber_chi: [i32; 21] = [0; 21]

    var idx: i64 = 0
    while idx < 84 {
        let lo = get_prim_lo(idx)
        let hi = get_prim_hi(idx)

        setup_cross_half()
        build_twisted_adj14_pub(idx)
        let e = count_edges_n(6) as i32

        // 2-coloring
        setup_cross_half()
        build_twisted_adj14_pub(idx)
        var ctx2 = smt_new()
        add_2col_n(&! ctx2, 6)
        smt_set_score_mode(&! ctx2, 3)
        smt_set_no_ple(&! ctx2, 1)
        let r2 = smt_solve(&! ctx2)
        let c2 = smt_get_conflicts(&ctx2)

        // 3-coloring (only if 2-col UNSAT, to determine χ=3 vs χ≥4)
        setup_cross_half()
        build_twisted_adj14_pub(idx)
        var ctx3 = smt_new()
        add_3col_n(&! ctx3, 6)
        smt_set_score_mode(&! ctx3, 3)
        smt_set_no_ple(&! ctx3, 1)
        let r3 = smt_solve(&! ctx3)
        let c3 = smt_get_conflicts(&ctx3)

        // chi bracket
        var chi: i32 = 0
        if r2 == 1 { chi = 0 }
        else { if r3 == 1 { chi = 1 } else { chi = 2 } }

        let fi = ((lo - 1) * 3 + (chi as i64)) as usize
        fiber_chi[fi] = fiber_chi[fi] + 1
        if chi == 0 { n_bip  = n_bip  + 1 }
        if chi == 1 { n_chi3 = n_chi3 + 1 }
        if chi == 2 { n_chi4 = n_chi4 + 1 }

        pri(idx as i32); print(" ")
        pri(lo as i32); print("  ")
        pri(hi as i32); print("  ")
        pri(e); print("  ")
        pri(r2); print("  ")
        pri(c2); print("   ")
        pri(r3); print("  ")
        pri(c3); print("   ")
        pri(chi); print("    ")
        var ea: i64 = 0
        while ea < 6 {
            var eb: i64 = ea + 1
            while eb < 6 {
                if get_adj14_edge(ea, eb) == 1 {
                    print("("); pri(ea as i32); print(","); pri(eb as i32); print(")")
                }
                eb = eb + 1
            }
            ea = ea + 1
        }
        print("\n")

        idx = idx + 1
    }

    print("\n=== Chi bracket totals ===\n")
    print("χ≤2: "); pri(n_bip);  print("\n")
    print("χ=3: "); pri(n_chi3); print("\n")
    print("χ≥4: "); pri(n_chi4); print("\n")

    print("\n=== By fiber ===\n")
    print("lo  χ≤2  χ=3  χ≥4\n")
    var fi2: i32 = 0
    while fi2 < 7 {
        pri(fi2 + 1); print("    ")
        pri(fiber_chi[(fi2*3+0) as usize]); print("    ")
        pri(fiber_chi[(fi2*3+1) as usize]); print("    ")
        pri(fiber_chi[(fi2*3+2) as usize]); print("\n")
        fi2 = fi2 + 1
    }

    print("\n--- Verdict ---\n")
    if n_bip > 0 && (n_chi3 + n_chi4) > 0 {
        print("FLIP DETECTED: "); pri(n_bip); print(" bipartite, ")
        pri(n_chi3); print(" χ=3, "); pri(n_chi4); print(" χ≥4.\n")
        print("ZD surgery algebra controls χ on the cross-half sedenion probe.\n")
        print("Cross-half (e1,e2,e3 vs e8,e9,e10) interactions break bipartiteness.\n")
    } else if n_bip == 84 {
        print("NULL (all bipartite): cross-half basis elements also bipartite under all surgeries.\n")
        print("The sedenion basis-element graphs are algebraically bipartite regardless of half.\n")
        print("→ Move to A: embed Moser spindle using NON-BASIS sedenion vectors.\n")
    } else {
        print("NULL (no bipartite): surgery always produces odd cycles. No χ variation.\n")
    }
}
