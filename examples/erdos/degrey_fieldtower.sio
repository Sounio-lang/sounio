// examples/erdos/degrey_fieldtower.sio
//
// EXACT ARITHMETIC over Q(√3, √5, √7, √11) — the degree-16 field of de Grey's
// FULL 1581-vertex 5-chromatic graph (Erdős #508).
//
// Resolved field tower (Polymath16 wiki; de Grey 2018, arXiv:1804.02385):
// de Grey's graph G derives from N = Z[ω_1, ω_3, ω_4, ω_16], with
// ω_t = exp(i·arccos(1 − 1/2t)),  sin(ω_t) = √(4t−1)/(2t):
//   ω_1  → √3/2     (60°)
//   ω_3  → √11/6    (arccos 5/6)
//   ω_4  → √15/8    (arccos 7/8)   ⟹ needs √5  (√15 = √3·√5)
//   ω_16 → √63/32   (arccos 31/32) ⟹ needs √7  (√63 = 3√7)
// So the full χ≥5 certificate lives in Q(√3,√5,√7,√11). This file extends the
// Q(√3,√11) spindle kernel to that whole tower.
//
// REPRESENTATION (generalises the 4-tuple Q(√3,√11)). The 2^4 = 16 monomials
// √(∏ S), for S ⊆ {3,5,7,11}, form a Q-basis. Index a basis element by a 4-bit
// mask: bit0=√3, bit1=√5, bit2=√7, bit3=√11. A field element is an integer
// 16-tuple. The multiplication table is pure XOR with a rational coefficient:
//   √(∏S) · √(∏T) = (∏_{p∈S∩T} p) · √(∏(S△T)),
// i.e. basis i times basis j lands in basis (i XOR j) with coefficient =
// product of the primes selected by (i AND j). (Same XOR algebra as the
// Cayley–Dickson e_a·e_b = ±e_{a^b}, here with positive square-root coeffs.)
//
// Self-contained.

struct Q16 { c: [i64; 16] }

// product of primes selected by mask bits (bit0=3,bit1=5,bit2=7,bit3=11)
fn bcoeff(mask: i64) -> i64 with Mut {
    var p = 1
    if (mask & 1) != 0 { p = p * 3 }
    if (mask & 2) != 0 { p = p * 5 }
    if (mask & 4) != 0 { p = p * 7 }
    if (mask & 8) != 0 { p = p * 11 }
    return p
}

fn q16_zero() -> Q16 { return Q16 { c: [0; 16] } }

fn q16_rat(v: i64) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    r.c[0] = v
    return r
}

// single basis monomial: coefficient v on basis index idx
fn q16_mono(idx: i64, v: i64) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    r.c[idx as usize] = v
    return r
}

fn q16_add(x: Q16, y: Q16) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    var i = 0
    while i < 16 {
        r.c[i as usize] = x.c[i as usize] + y.c[i as usize]
        i = i + 1
    }
    return r
}

fn q16_sub(x: Q16, y: Q16) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    var i = 0
    while i < 16 {
        r.c[i as usize] = x.c[i as usize] - y.c[i as usize]
        i = i + 1
    }
    return r
}

// (∏S)·(∏T): result basis i^j, coefficient ∏ primes in i&j. O(16²).
fn q16_mul(x: Q16, y: Q16) -> Q16 with Mut, Panic {
    var r = Q16 { c: [0; 16] }
    var i = 0
    while i < 16 {
        var j = 0
        while j < 16 {
            let coeff = bcoeff(i & j)
            let idx = (i ^ j) as usize
            r.c[idx] = r.c[idx] + x.c[i as usize] * y.c[j as usize] * coeff
            j = j + 1
        }
        i = i + 1
    }
    return r
}

fn q16_sq(x: Q16) -> Q16 with Mut, Panic { return q16_mul(x, x) }

// is x exactly the rational v (all surd components zero)?
fn q16_is_rat(x: Q16, v: i64) -> i64 with Mut, Panic {
    if x.c[0 as usize] != v { return 0 }
    var i = 1
    while i < 16 {
        if x.c[i as usize] != 0 { return 0 }
        i = i + 1
    }
    return 1
}

fn print_q16(x: Q16) with IO, Mut, Panic {
    // labels for the 16 basis monomials
    print_int(x.c[0 as usize])
    var i = 1
    while i < 16 {
        let v = x.c[i as usize]
        if v != 0 {
            print(" + "); print_int(v); print("*b"); print_int(i)
        }
        i = i + 1
    }
    print("\n")
}

// squared distance between (px,py) and (qx,qy), all Q16
fn dist2(px: Q16, py: Q16, qx: Q16, qy: Q16) -> Q16 with Mut, Panic {
    let dx = q16_sub(px, qx)
    let dy = q16_sub(py, qy)
    return q16_add(q16_sq(dx), q16_sq(dy))
}

fn check(name_ok: i64) -> i64 { return name_ok }

fn main() -> i32 with IO, Mut, Panic {
    print("=== Exact arithmetic over Q(√3,√5,√7,√11) — de Grey's degree-16 field ===\n")
    print("basis index bits: bit0=√3 bit1=√5 bit2=√7 bit3=√11; b3=√15 b5=√21 b6=√35 b12=√77 ...\n\n")

    var pass = 0
    var total = 0

    // --- arithmetic self-tests ---
    print("Arithmetic self-tests:\n")

    // (√15)² = 15  : √15 = b3 (bits 0,1)
    let t1 = q16_sq(q16_mono(3, 1))
    total = total + 1
    print("  (√15)² = "); print_q16(t1)
    if q16_is_rat(t1, 15) == 1 { pass = pass + 1; print("    [OK == 15]\n") } else { print("    [FAIL]\n") }

    // √15 · √35 = 5√21  : √15=b3(0,1), √35=b6(1,2) -> i^j=b5(0,2)=√21, coeff(i&j=b1=√5)=5
    let t2 = q16_mul(q16_mono(3, 1), q16_mono(6, 1))
    total = total + 1
    print("  √15 · √35 = "); print_q16(t2)
    // expect 5 on b5
    var t2ok = 1
    if t2.c[5 as usize] != 5 { t2ok = 0 }
    var k = 0
    while k < 16 { if k != 5 { if t2.c[k as usize] != 0 { t2ok = 0 } }  k = k + 1 }
    if t2ok == 1 { pass = pass + 1; print("    [OK == 5√21 (5 on b5)]\n") } else { print("    [FAIL]\n") }

    // (√3 + √5)² = 8 + 2√15
    let t3 = q16_sq(q16_add(q16_mono(1, 1), q16_mono(2, 1)))
    total = total + 1
    print("  (√3 + √5)² = "); print_q16(t3)
    var t3ok = 1
    if t3.c[0 as usize] != 8 { t3ok = 0 }
    if t3.c[3 as usize] != 2 { t3ok = 0 }
    k = 0
    while k < 16 { if k != 0 { if k != 3 { if t3.c[k as usize] != 0 { t3ok = 0 } } }  k = k + 1 }
    if t3ok == 1 { pass = pass + 1; print("    [OK == 8 + 2√15]\n") } else { print("    [FAIL]\n") }

    print("\nRotation realizations de Grey's full graph needs:\n")

    // ω_4 isosceles triangle (sides 2, base 1, apex arccos 7/8), scale ×4 (unit² = 16).
    // O=(0,0); P1=(8,0); P2=(7, √15).  Base |P1−P2|² must equal 16, using √5 (via √15).
    let ox = q16_zero();  let oy = q16_zero()
    let p1x = q16_rat(8); let p1y = q16_zero()
    let p2x = q16_rat(7); let p2y = q16_mono(3, 1)   // √15
    let d_base4 = dist2(p1x, p1y, p2x, p2y)
    total = total + 1
    print("  ω_4 base (needs √5): dist² = "); print_q16(d_base4)
    if q16_is_rat(d_base4, 16) == 1 { pass = pass + 1; print("    [OK == 16 = (unit·4)²; √15 cancels]\n") } else { print("    [FAIL]\n") }

    // ω_16 isosceles triangle (sides 4, base 1, apex arccos 31/32), scale ×8 (unit² = 64).
    // O=(0,0); P1=(32,0); P2=(31, 3√7).  Base must equal 64, using √7.
    let q1x = q16_rat(32); let q1y = q16_zero()
    let q2x = q16_rat(31); let q2y = q16_mono(4, 3)   // 3√7  (√7 = b4)
    let d_base16 = dist2(q1x, q1y, q2x, q2y)
    total = total + 1
    print("  ω_16 base (needs √7): dist² = "); print_q16(d_base16)
    if q16_is_rat(d_base16, 64) == 1 { pass = pass + 1; print("    [OK == 64 = (unit·8)²; √63 cancels]\n") } else { print("    [FAIL]\n") }

    print("\n");  print_int(pass);  print(" / ");  print_int(total);  print(" checks passed\n")
    if pass == total {
        print("Q(√3,√5,√7,√11) kernel OPERATIONAL: the exact arithmetic foundation for\n")
        print("de Grey's full 5-chromatic graph (Z[ω_1,ω_3,ω_4,ω_16]) now exists in Sounio.\n")
        print("Next: realize de Grey's minimized graphs (G_2/G_3 ⊂ Z[ω_1,ω_3,ω_4]) and\n")
        print("certify χ≥5 with the native SAT solver (cap already raised to 256 vars).\n")
    }
    return 0
}
