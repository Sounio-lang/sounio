#!/usr/bin/env bash
#SBATCH --job-name=erdos90-rr10000-bundle
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=24:00:00
#SBATCH --chdir=/tmp
#SBATCH --output=/tmp/erdos90_rr10000_bundle_%j.out
#SBATCH --partition=gpu-orangefs
#
# Self-contained bundle: decodes souc-lean-single and the optimizer source,
# compiles on the compute node, runs the sweep to rr=10000, and stages the log.
set -euo pipefail

WORK="${SLURM_TMPDIR:-/tmp}/erdos90_bundle_$$"
mkdir -p "$WORK"
cd "$WORK"

# Decode compiler
base64 -d <<'SOUC64' > souc-lean-single-x86_64

chmod +x souc-lean-single-x86_64

# Decode source
base64 -d <<'SRC64' > erdos90_optimize.sio


echo "[$(date -Iseconds)] build"
./souc-lean-single-x86_64 erdos90_optimize.sio erdos90_optimize.elf
chmod +x erdos90_optimize.elf

echo "[$(date -Iseconds)] run"
./erdos90_optimize.elf > optimize_rr10000.log 2>&1
echo "[$(date -Iseconds)] done rc=$?"

MAX_COUNT="$(grep -oE 'count=[0-9]+' optimize_rr10000.log | cut -d= -f2 | sort -n | tail -1 || true)"
MAX_N="$(grep -B1 "count=$MAX_COUNT" optimize_rr10000.log | grep -oE 'n=[0-9]+' | tail -1 | cut -d= -f2 || true)"
echo "SUMMARY n=$MAX_N count=$MAX_COUNT"

STAGE="/orangefs/training/erdos90_rr10000_${SLURM_JOB_ID:-local}"
mkdir -p "$STAGE"
cp optimize_rr10000.log "$STAGE/"
cp erdos90_optimize.elf "$STAGE/" || true
echo "staged to $STAGE"

cd /
rm -rf "$WORK"
