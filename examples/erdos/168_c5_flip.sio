// examples/erdos/168_c5_flip.sio
//
// B probe (attempt 2): C₅ chromatic-flip detector.
//
// C₅ (5-cycle) is the smallest unit-distance graph with χ=3.
// It has a regular-pentagon unit-distance embedding in R²:
//   circumradius R = 1/(2·sin(π/5)) ≈ 0.850650808
//   vₖ = R·(cos(2πk/5), sin(2πk/5)) embedded as e₁,e₂ sedenion components
//   adjacent pairs (k, k+1 mod 5) have |vₖ - v_{k+1}|² = 1
//   diagonal pairs have |vₖ - v_{k+2}|² = golden-ratio² ≈ 2.618
//
// For each of the 84 ZD surgeries:
//   Build twisted adjacency on 5 vertices (using PROBE14 with zero_probe14 + set_probe14_coord).
//   Run 2-coloring SAT: UNSAT ↔ odd cycle ↔ χ≥3.
//   Record: how many surgeries preserve χ≥3 vs collapse to bipartite (χ≤2)?
//
// Falsifiable prediction:
//   At least one surgery changes χ — ZD right-multiplication scrambles
//   the sedenion norm in ways that break or create odd cycles.
//
// Also records full edge-structure per surgery for graph-isomorphism analysis.

use hypercomplex_graph::erdos_unit_distance::*
use theorem::smt::*

fn pri(x: i32) with IO, Div, Panic {
    if x < 0 { print("-"); pri(0 - x); return }
    if x == 0 { print("0"); return }
    if x >= 10 { pri(x / 10) }
    let d = x - (x / 10) * 10
    if d == 0 { print("0") } if d == 1 { print("1") } if d == 2 { print("2") }
    if d == 3 { print("3") } if d == 4 { print("4") } if d == 5 { print("5") }
    if d == 6 { print("6") } if d == 7 { print("7") } if d == 8 { print("8") }
    if d == 9 { print("9") }
}

fn prf2(x: f64) with IO, Mut, Div, Panic {
    if x < 0.0 { print("-"); prf2(0.0 - x); return }
    let ip = x as i32
    pri(ip); print(".")
    let f = (x - (ip as f64)) * 1000.0
    let d = f as i32
    if d < 100 { print("0") }
    if d < 10  { print("0") }
    pri(d)
}

fn add2(ctx: &!SmtContext, a: i32, b: i32) with Mut, Div {
    var lits: [i32; 8] = [0; 8]
    lits[0] = a; lits[1] = b
    smt_add_clause(ctx, &lits, 2)
}

// 2-coloring of first N_VERTS vertices.
// Variable v ∈ {0..N_VERTS-1}: var v = TRUE → color A.
// Per edge (u,v): (¬u∨¬v) ∧ (u∨v)
fn add_2col(ctx: &!SmtContext, n: i32) with Mut, Div {
    var u: i64 = 0
    while u < (n as i64) {
        var v: i64 = u + 1
        while v < (n as i64) {
            if get_adj14_edge(u, v) == 1 {
                let ul = (u as i32) * 2
                let vl = (v as i32) * 2
                add2(ctx, ul + 1, vl + 1)
                add2(ctx, ul,     vl)
            }
            v = v + 1
        }
        u = u + 1
    }
}

// Set up the C₅ regular-pentagon unit-distance embedding.
// R = 1/(2·sin(π/5)) ≈ 0.850650808
// vₖ uses sedenion components: index 1 (e₁) and 2 (e₂).
// cos/sin at 72° intervals (pre-computed to 9 significant figures):
//   k=0: cos=1.0,        sin=0.0
//   k=1: cos=0.309017,   sin=0.951057
//   k=2: cos=-0.809017,  sin=0.587785
//   k=3: cos=-0.809017,  sin=-0.587785
//   k=4: cos=0.309017,   sin=-0.951057
fn setup_c5() with Mut {
    zero_probe14()
    let r: f64 = 0.850650808
    // v0
    set_probe14_coord(0, 1, r * 1.0)
    set_probe14_coord(0, 2, r * 0.0)
    // v1
    set_probe14_coord(1, 1, r * 0.309017)
    set_probe14_coord(1, 2, r * 0.951057)
    // v2
    set_probe14_coord(2, 1, r * 0.0 - r * 0.809017)
    set_probe14_coord(2, 2, r * 0.587785)
    // v3
    set_probe14_coord(3, 1, r * 0.0 - r * 0.809017)
    set_probe14_coord(3, 2, r * 0.0 - r * 0.587785)
    // v4
    set_probe14_coord(4, 1, r * 0.309017)
    set_probe14_coord(4, 2, r * 0.0 - r * 0.951057)
}

fn main() with IO, Mut, Div, Panic {
    build_prims()
    setup_c5()

    // Verify base structure before any surgery by checking with a known-good surgery.
    // We want to understand the target distance for C₅ edges under surgery.
    // prim_norm_sq() = 2.0 (each ZD prim e_lo ± e_hi has norm² = 2).
    // For C₅ adjacent vertices: |diff|² = 1.  After rmul: |diff·prim|² depends on algebra.
    // For C₅ diagonal vertices: |diff|² ≈ 2.618.  After rmul: different value.
    // The adjacency check is: |diff·prim|² == prim_norm_sq() = 2.

    print("=== B: C5 chromatic-flip detector — ZD surgery on 5-cycle ===\n")
    print("C5 (5-cycle, χ=3) embedded in e1,e2 sedenion components.\n")
    print("R = 0.850651, adjacent |diff|²=1, diagonal |diff|²≈2.618.\n")
    print("Surgery target: |diff·prim|² = 2 (prim_norm_sq).\n\n")

    // First: sanity check on all 5 vertex pairs pre-surgery.
    // (idx=0 surgery, just to see what the twisted adj looks like)
    build_twisted_adj14_pub(0)
    let e0 = count_edges_n(5)
    print("idx=0 edge count on 5 verts: "); pri(e0 as i32); print("\n")
    print("adj matrix (5x5): ")
    var si: i64 = 0
    while si < 5 {
        var sj: i64 = 0
        while sj < 5 {
            pri(get_adj14_edge(si, sj) as i32)
            sj = sj + 1
        }
        print(" ")
        si = si + 1
    }
    print("\n\n")

    print("idx lo hi e  r2 c2  chi  edges\n")
    print("--- -- -- -  -- --  ---  -----\n")

    var n_bip:  i32 = 0   // χ≤2
    var n_chi3: i32 = 0   // χ=3
    var n_chi4: i32 = 0   // χ≥4

    // Per-fiber chi distribution: 7 fibers × 3 brackets
    var fiber_chi: [i32; 21] = [0; 21]

    var idx: i64 = 0
    while idx < 84 {
        let lo = get_prim_lo(idx)
        let hi = get_prim_hi(idx)

        // Always re-setup C₅ vertices (build_twisted_adj14_pub reads PROBE14)
        setup_c5()
        build_twisted_adj14_pub(idx)
        let e = count_edges_n(5) as i32

        // 2-coloring on 5 vertices
        var ctx2 = smt_new()
        add_2col(&! ctx2, 5)
        smt_set_score_mode(&! ctx2, 3)
        smt_set_no_ple(&! ctx2, 1)
        let r2 = smt_solve(&! ctx2)
        let c2 = smt_get_conflicts(&ctx2)

        // chi bracket from 2-coloring alone:
        // r2==1 (SAT) → bipartite (χ≤2); r2≠1 → χ≥3
        // For χ=3 vs χ≥4, we'd need 3-coloring, but with 5 vertices χ≤5 trivially.
        // With 5 vertices, χ=4 requires K₄ subgraph, unlikely from 5 verts and ZD surgery.
        // Classify: r2=1 → bipartite; r2≠1 → odd-cycle (χ≥3, treat as χ=3 for 5-vertex graphs)
        var chi: i32 = 0
        if r2 == 1 { chi = 0 } else { chi = 1 }

        let fi = ((lo - 1) * 3 + (chi as i64)) as usize
        fiber_chi[fi] = fiber_chi[fi] + 1

        if chi == 0 { n_bip  = n_bip  + 1 }
        if chi == 1 { n_chi3 = n_chi3 + 1 }

        // Print edge list for this surgery (5 verts, upper triangle)
        pri(idx as i32); print(" ")
        pri(lo as i32); print("  ")
        pri(hi as i32); print("  ")
        pri(e); print("  ")
        pri(r2); print("  ")
        pri(c2); print("   ")
        pri(chi); print("    ")
        var ea: i64 = 0
        while ea < 5 {
            var eb: i64 = ea + 1
            while eb < 5 {
                if get_adj14_edge(ea, eb) == 1 {
                    print("("); pri(ea as i32); print(","); pri(eb as i32); print(")")
                }
                eb = eb + 1
            }
            ea = ea + 1
        }
        print("\n")

        idx = idx + 1
    }

    print("\n=== Chi bracket totals ===\n")
    print("χ≤2 (bipartite):  "); pri(n_bip);  print("\n")
    print("χ≥3 (odd cycle):  "); pri(n_chi3); print("\n")

    print("\n=== By fiber (lo=1..7) ===\n")
    print("lo  bip  odd\n")
    var fi2: i32 = 0
    while fi2 < 7 {
        pri(fi2 + 1); print("   ")
        pri(fiber_chi[(fi2 * 3 + 0) as usize]); print("    ")
        pri(fiber_chi[(fi2 * 3 + 1) as usize]); print("\n")
        fi2 = fi2 + 1
    }

    print("\n--- Verdict ---\n")
    if n_bip > 0 && n_chi3 > 0 {
        print("FLIP CONFIRMED: ZD surgery splits C5 into bipartite (")
        pri(n_bip); print(") vs odd-cycle ("); pri(n_chi3); print(") instances.\n")
        print("ZD algebra determines whether the twisted 5-vertex unit-distance\n")
        print("graph has an odd cycle — a direct chromatic number consequence.\n")
        print("Check fiber table: fiber→chi pattern = algebraic fiber controls χ.\n")
    } else if n_bip == 84 {
        print("NULL (all bipartite): ZD surgery always destroys the C5 odd cycle.\n")
        print("The C5 sedenion embedding collapses to bipartite under all 84 surgeries.\n")
        print("Interpretation: the e1,e2 subspace may be algebraically bipartite.\n")
        print("Next: Moser spindle (7v, χ=4) in higher sedenion components. → A probe.\n")
    } else if n_chi3 == 84 {
        print("NULL (all odd): ZD surgery always preserves C5 odd-cycle structure.\n")
        print("No variation in χ — surgery does not control χ on this probe.\n")
        print("Next: try larger vertex set spanning more sedenion fibers.\n")
    }
}
