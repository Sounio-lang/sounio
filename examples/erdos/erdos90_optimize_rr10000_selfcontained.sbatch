#!/usr/bin/env bash
#SBATCH --job-name=erdos90-rr10000-sc
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=24:00:00
#SBATCH --output=erdos90_rr10000_sc_%j.out
#
# Self-contained sbatch: embeds the prebuilt ELF and source via base64.
# No shared filesystem dependency except the output directory.
set -euo pipefail

WORK="${SLURM_TMPDIR:-/tmp}/erdos90_$$"
mkdir -p "$WORK"
cd "$WORK"

# Decode embedded ELF
base64 -d <<'ELF64' > erdos90_optimize.elf
