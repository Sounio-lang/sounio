ELF64
chmod +x erdos90_optimize.elf

echo "[$(date -Iseconds)] run sweep"
./erdos90_optimize.elf > optimize_rr10000.log 2>&1
echo "[$(date -Iseconds)] done rc=$?"

MAX_COUNT="$(grep -oE 'count=[0-9]+' optimize_rr10000.log | cut -d= -f2 | sort -n | tail -1 || true)"
MAX_N="$(grep -B1 "count=$MAX_COUNT" optimize_rr10000.log | grep -oE 'n=[0-9]+' | tail -1 | cut -d= -f2 || true)"
echo "SUMMARY n=$MAX_N count=$MAX_COUNT"

# Copy log back to a writable shared location if available.
if [[ -d /orangefs/training ]]; then
  STAGE="/orangefs/training/erdos90_rr10000_${SLURM_JOB_ID:-local}"
  mkdir -p "$STAGE"
  cp optimize_rr10000.log "$STAGE/"
  echo "staged to $STAGE"
fi

cd /
rm -rf "$WORK"
