// examples/erdos/168_c5_flip_loose.sio
//
// Probe A: C₅ chromatic-flip with loose tolerance (ε=1e-3).
// Original 168_c5_flip.sio used ε=1e-9 → 0 edges (fp error ~1e-5 > tolerance).
// With ε=1e-3: adjacent C₅ edges register. Result: ALL 84 surgeries preserve χ=3.
// The C₅ odd cycle is universally robust under ZD surgery (irrational coords).

use hypercomplex_graph::erdos_unit_distance::*
use theorem::smt::*

fn pri(x: i32) with IO, Div, Panic {
    if x < 0 { print("-"); pri(0 - x); return }
    if x == 0 { print("0"); return }
    if x >= 10 { pri(x / 10) }
    let d = x - (x / 10) * 10
    if d == 0 { print("0") } if d == 1 { print("1") } if d == 2 { print("2") }
    if d == 3 { print("3") } if d == 4 { print("4") } if d == 5 { print("5") }
    if d == 6 { print("6") } if d == 7 { print("7") } if d == 8 { print("8") }
    if d == 9 { print("9") }
}

fn add2(ctx: &!SmtContext, a: i32, b: i32) with Mut, Div {
    var lits: [i32; 8] = [0; 8]
    lits[0] = a; lits[1] = b
    smt_add_clause(ctx, &lits, 2)
}

fn add_2col(ctx: &!SmtContext, n: i32) with Mut, Div {
    var u: i64 = 0
    while u < (n as i64) {
        var v: i64 = u + 1
        while v < (n as i64) {
            if get_adj14_edge(u, v) == 1 {
                let ul = (u as i32) * 2
                let vl = (v as i32) * 2
                add2(ctx, ul + 1, vl + 1)
                add2(ctx, ul,     vl)
            }
            v = v + 1
        }
        u = u + 1
    }
}

fn setup_c5() with Mut {
    zero_probe14()
    let r: f64 = 0.850650808
    set_probe14_coord(0, 1, r * 1.0)
    set_probe14_coord(0, 2, r * 0.0)
    set_probe14_coord(1, 1, r * 0.309017)
    set_probe14_coord(1, 2, r * 0.951057)
    set_probe14_coord(2, 1, r * 0.0 - r * 0.809017)
    set_probe14_coord(2, 2, r * 0.587785)
    set_probe14_coord(3, 1, r * 0.0 - r * 0.809017)
    set_probe14_coord(3, 2, r * 0.0 - r * 0.587785)
    set_probe14_coord(4, 1, r * 0.309017)
    set_probe14_coord(4, 2, r * 0.0 - r * 0.951057)
}

fn main() with IO, Mut, Div, Panic {
    build_prims()
    setup_c5()

    print("=== Probe A: C5 chromatic-flip with loose tolerance (eps=1e-3) ===\n")
    print("C5 embedded in e1,e2. Adjacent |diff|^2=1 (fp error ~1e-5).\n")
    print("Loose tolerance 1e-3 registers C5 edges despite fp rounding.\n\n")

    build_twisted_adj14_loose_pub(0)
    let e0 = count_edges_n(5) as i32
    print("idx=0 edges (loose): "); pri(e0); print("\n\n")

    print("idx lo hi edges r2 confl chi edgelist\n")

    var n_bip:  i32 = 0
    var n_chi3: i32 = 0
    var fib_bip:  [i32; 7] = [0; 7]
    var fib_chi3: [i32; 7] = [0; 7]

    var idx: i64 = 0
    while idx < 84 {
        let lo = get_prim_lo(idx)
        let hi = get_prim_hi(idx)
        setup_c5()
        build_twisted_adj14_loose_pub(idx)
        let e = count_edges_n(5) as i32

        var ctx2 = smt_new()
        add_2col(&! ctx2, 5)
        smt_set_score_mode(&! ctx2, 3)
        smt_set_no_ple(&! ctx2, 1)
        let r2 = smt_solve(&! ctx2)
        let c2 = smt_get_conflicts(&ctx2)

        var chi: i32 = 2
        if r2 != 1 { chi = 3 }

        let fi = (lo - 1) as usize
        if chi == 2 { fib_bip[fi]  = fib_bip[fi]  + 1; n_bip  = n_bip  + 1 }
        if chi == 3 { fib_chi3[fi] = fib_chi3[fi] + 1; n_chi3 = n_chi3 + 1 }

        pri(idx as i32); print(" "); pri(lo as i32); print("  "); pri(hi as i32); print("  ")
        pri(e); print("  "); pri(r2); print("  "); pri(c2); print("  "); pri(chi); print("  ")
        var ea: i64 = 0
        while ea < 5 {
            var eb: i64 = ea + 1
            while eb < 5 {
                if get_adj14_edge(ea, eb) == 1 {
                    print("("); pri(ea as i32); print(","); pri(eb as i32); print(")")
                }
                eb = eb + 1
            }
            ea = ea + 1
        }
        print("\n")
        idx = idx + 1
    }

    print("\n=== Summary ===\n")
    print("chi=2 (bipartite):  "); pri(n_bip);  print(" / 84\n")
    print("chi>=3 (odd cycle): "); pri(n_chi3); print(" / 84\n")

    print("\n=== By fiber (lo=1..7) ===\n")
    var fi2: i32 = 0
    while fi2 < 7 {
        pri(fi2 + 1); print("  bip="); pri(fib_bip[fi2 as usize])
        print("  chi3="); pri(fib_chi3[fi2 as usize]); print("\n")
        fi2 = fi2 + 1
    }

    print("\n--- Verdict ---\n")
    if n_chi3 == 84 {
        print("All 84 surgeries preserve the C5 odd cycle (chi=3).\n")
        print("ZD surgery does NOT destroy the C5 chromatic structure.\n")
        print("The C5 (irrational e1,e2 embedding) is a universal ZD-surgery invariant.\n")
        print("(Integer lattice remains bipartite by the complete bipartiteness theorem.)\n")
    } else if n_bip > 0 && n_chi3 > 0 {
        print("FLIP: some surgeries preserve chi=3, others collapse to bipartite.\n")
    } else {
        print("All bipartite: loose tolerance insufficient.\n")
    }
}
