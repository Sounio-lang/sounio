{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chi6_solver_candidate_package.v1.schema.json",
  "title": "Sounio chi6 solver candidate source package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "edge_path",
    "edge_sha256",
    "coords_path",
    "coords_sha256",
    "coordinate_domain",
    "n",
    "m",
    "k",
    "split_vertices",
    "producer_command",
    "claim_scope",
    "promotion_gate"
  ],
  "properties": {
    "schema": {
      "const": "chi6_solver_candidate_package.v1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "edge_path": {
      "type": "string"
    },
    "edge_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coords_path": {
      "type": "string"
    },
    "coords_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coordinate_domain": {
      "const": "rational_xy"
    },
    "n": {
      "type": "integer",
      "minimum": 2
    },
    "m": {
      "type": "integer",
      "minimum": 1
    },
    "k": {
      "const": 5
    },
    "split_vertices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "producer_command": {
      "type": "string",
      "minLength": 1
    },
    "claim_scope": {
      "const": "solver_candidate_source_only"
    },
    "promotion_gate": {
      "const": "requires_cube_cover_lrat_lean_exact_geometry_and_real_bridge"
    }
  }
}
