{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chi6_external_dimacs_edge_package.v1.schema.json",
  "title": "Sounio chi6 external DIMACS edge package metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "source_edge_path",
    "source_edge_sha256",
    "packaged_edge_path",
    "packaged_edge_sha256",
    "n",
    "m",
    "k",
    "split_vertices",
    "argv",
    "packaged_at_unix",
    "provenance_scope",
    "promotion_gate"
  ],
  "properties": {
    "schema": {
      "const": "chi6_external_dimacs_edge_package.v1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "source_edge_path": {
      "type": "string"
    },
    "source_edge_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packaged_edge_path": {
      "type": "string"
    },
    "packaged_edge_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "n": {
      "type": "integer",
      "minimum": 1
    },
    "m": {
      "type": "integer",
      "minimum": 1
    },
    "k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 61
    },
    "split_vertices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "packaged_at_unix": {
      "type": "integer",
      "minimum": 0
    },
    "provenance_scope": {
      "const": "edge_packaging_only"
    },
    "promotion_gate": {
      "const": "requires_lrat_lean_and_exact_euclidean_geometry"
    }
  }
}
