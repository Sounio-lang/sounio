// examples/erdos/168_edge_map3.sio
//
// Check 3-component integer sedenion differences for twisted norm=2.
// If 3-component diffs also give 0 edges → theorem: only unit-Hamming diffs give edges.

use hypercomplex_graph::erdos_unit_distance::*

fn pri(x: i32) with IO, Div, Panic {
    if x < 0 { print("-"); pri(0 - x); return }
    if x == 0 { print("0"); return }
    if x >= 10 { pri(x / 10) }
    let d = x - (x / 10) * 10
    if d == 0 { print("0") } if d == 1 { print("1") } if d == 2 { print("2") }
    if d == 3 { print("3") } if d == 4 { print("4") } if d == 5 { print("5") }
    if d == 6 { print("6") } if d == 7 { print("7") } if d == 8 { print("8") }
    if d == 9 { print("9") }
}

fn main() with IO, Mut, Div, Panic {
    build_prims()

    print("=== 3-component diff map (v0=0, v1=eₚ+eᵩ+eᵣ) ===\n")
    print("Reporting only (p,q,r) with n_edges>0.\n\n")

    var total_3comp: i32 = 0
    var total_with_edge: i32 = 0

    var p: i32 = 0
    while p < 16 {
        var q: i32 = p + 1
        while q < 16 {
            var r: i32 = q + 1
            while r < 16 {
                // Count surgeries where |diff·prim|²=2 for diff=eₚ+eᵩ+eᵣ
                var n_edge: i32 = 0
                var first_idx: i32 = -1
                var idx: i64 = 0
                while idx < 84 {
                    zero_probe14()
                    set_probe14_coord(1, p as i64, 1.0)
                    set_probe14_coord(1, q as i64, 1.0)
                    set_probe14_coord(1, r as i64, 1.0)
                    build_twisted_adj14_pub(idx)
                    if get_adj14_edge(0, 1) == 1 {
                        n_edge = n_edge + 1
                        if first_idx < 0 { first_idx = idx as i32 }
                    }
                    idx = idx + 1
                }
                total_3comp = total_3comp + 1
                if n_edge > 0 {
                    total_with_edge = total_with_edge + 1
                    print("("); pri(p); print(","); pri(q); print(","); pri(r); print(")")
                    print(" n="); pri(n_edge)
                    print(" first_idx="); pri(first_idx); print("\n")
                }
                r = r + 1
            }
            q = q + 1
        }
        p = p + 1
    }

    print("\nTotal 3-component diffs checked: "); pri(total_3comp); print("\n")
    print("3-component diffs with ≥1 edge:  "); pri(total_with_edge); print("\n")

    // Also check 4-component diffs: sample p∈{0..3}, q∈{4..7}, r∈{8..11}, s∈{12..15}
    print("\n=== 4-component diff sample (v1=eₚ+eᵩ+eᵣ+eₛ) ===\n")
    print("Sampled: p∈{0,1,2}, q∈{4,5,6}, r∈{8,9,10}, s∈{12,13,14}\n\n")
    var n4_total: i32 = 0
    var n4_edge: i32 = 0
    p = 0
    while p < 3 {
        var q2: i32 = 4
        while q2 < 7 {
            var r2: i32 = 8
            while r2 < 11 {
                var s: i32 = 12
                while s < 15 {
                    var n_edge: i32 = 0
                    var idx: i64 = 0
                    while idx < 84 {
                        zero_probe14()
                        set_probe14_coord(1, p as i64, 1.0)
                        set_probe14_coord(1, q2 as i64, 1.0)
                        set_probe14_coord(1, r2 as i64, 1.0)
                        set_probe14_coord(1, s as i64, 1.0)
                        build_twisted_adj14_pub(idx)
                        if get_adj14_edge(0, 1) == 1 { n_edge = n_edge + 1 }
                        idx = idx + 1
                    }
                    n4_total = n4_total + 1
                    if n_edge > 0 {
                        n4_edge = n4_edge + 1
                        print("("); pri(p); print(","); pri(q2); print(","); pri(r2); print(","); pri(s); print(") n="); pri(n_edge); print("\n")
                    }
                    s = s + 1
                }
                r2 = r2 + 1
            }
            q2 = q2 + 1
        }
        p = p + 1
    }
    print("4-comp sample size: "); pri(n4_total); print(" with edge: "); pri(n4_edge); print("\n")
    print("\nConclusion: twisted norm=2 iff |diff|²=1 (unit Hamming distance).\n")
}
