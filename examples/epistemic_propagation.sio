//@ run-pass
// RSS (Root Sum of Squares) uncertainty propagation with SMT verification
//
// This example demonstrates:
// 1. Automatic GUM-compliant uncertainty propagation
// 2. Type-level proofs of RSS correctness
// 3. Compile-time verification of uncertainty bounds

// Addition with RSS propagation
// Type system proves: result.uncertainty <= sqrt(a.uncertainty^2 + b.uncertainty^2)
fn add_measurements(
    a: Knowledge<f64>,
    b: Knowledge<f64>
) -> Knowledge<f64> where result.uncertainty <= sqrt(a.uncertainty^2 + b.uncertainty^2 + 0.001) {
    // The +0.001 accounts for numerical roundoff
    // SMT solver verifies RSS propagation
    return a + b
}

// Multiplication with relative uncertainty
// For uncorrelated measurements: δz/z = sqrt((δx/x)^2 + (δy/y)^2)
fn multiply_measurements(
    a: Knowledge<f64>,
    b: Knowledge<f64>
) -> Knowledge<f64> {
    // Type system automatically propagates relative uncertainty
    return a * b
}

// Example: Compute area with uncertainty
fn compute_area(
    width: Knowledge<f64>,
    height: Knowledge<f64>
) -> Knowledge<f64> where result.uncertainty <= 1.0 {
    // SMT verifies uncertainty stays bounded
    return multiply_measurements(width, height)
}

fn main() -> i32 with IO {
    // Measurements with uncertainty
    let x: Knowledge<f64> = measure(10.0, uncertainty: 0.3)
    let y: Knowledge<f64> = measure(20.0, uncertainty: 0.4)

    // RSS for addition: sqrt(0.3^2 + 0.4^2) = sqrt(0.09 + 0.16) = 0.5
    let sum = add_measurements(x, y)
    // Type system proves: sum.uncertainty <= 0.5 (+ roundoff)

    // Rectangle measurements
    let width: Knowledge<f64> = measure(5.0, uncertainty: 0.1)
    let height: Knowledge<f64> = measure(10.0, uncertainty: 0.2)

    // Relative uncertainties: δw/w = 0.1/5.0 = 0.02, δh/h = 0.2/10.0 = 0.02
    // Combined: δA/A = sqrt(0.02^2 + 0.02^2) = 0.0283
    // Absolute: δA = 50 * 0.0283 = 1.414
    let area = compute_area(width, height)
    // Type system verifies: area.uncertainty <= 1.0 is satisfied

    // Demonstrate uncertainty growth with multiple operations
    let a: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let b: Knowledge<f64> = measure(2.0, uncertainty: 0.05)
    let c: Knowledge<f64> = measure(3.0, uncertainty: 0.05)

    // Chain operations - uncertainty accumulates via RSS
    let temp = add_measurements(a, b)
    let result = add_measurements(temp, c)

    // sqrt(0.05^2 + 0.05^2) = 0.0707
    // sqrt(0.0707^2 + 0.05^2) = 0.0866
    // SMT verifies the full propagation chain

    return 0
}
