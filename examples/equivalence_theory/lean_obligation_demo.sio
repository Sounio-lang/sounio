// Uses several Equivalence Theory features so the emitter has obligations to write.
fn diff1_cmp(a: Invariant<f64, Diff1>, b: Invariant<f64, Diff1, FrameA>) -> bool { a == a }
fn homeo_cmp(a: Invariant<f64, Homeo>, b: Invariant<f64, Homeo>) -> bool { a == b }
fn lorenz_step(x: f64, y: f64, dt: f64) -> f64 with Chaotic, Mut, Div, Panic { x + dt * (y - x) }
