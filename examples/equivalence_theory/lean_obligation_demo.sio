// Demo for `madaros emit-lean-obligations`. Each function below is a distinct
// Equivalence Theory call-site; the emitter records one Lean obligation per distinct
// (groups, frame relation, outcome) configuration. NOTE: this file intentionally
// includes REJECTED comparisons (cross-frame Diff1, BiLip) so the emitter exercises
// both obligation polarities — it is an emit demo, not a clean-checking program.

// cross-frame Diff1 → rejected: comparableDefault Group.Diff1 Group.Diff1 = false
fn diff1_cross_frame(a: Invariant<f64, Diff1, FrameA>, b: Invariant<f64, Diff1, FrameB>) -> bool { a == b }

// same-frame Diff1 → accepted: framesComparable Group.Diff1 Group.Diff1 Group.DiffInf = true
fn diff1_same_frame(a: Invariant<f64, Diff1, FrameA>, b: Invariant<f64, Diff1, FrameA>) -> bool { a == b }

// Homeo → accepted under the conservative default: comparableDefault Group.Homeo Group.Homeo = true
fn homeo_cmp(a: Invariant<f64, Homeo>, b: Invariant<f64, Homeo>) -> bool { a == b }

// BiLip → rejected under the conservative default: comparableDefault Group.BiLip Group.BiLip = false
fn bilip_cmp(a: Invariant<f64, BiLip>, b: Invariant<f64, BiLip>) -> bool { a == b }

// a chaotic integration step → the chaos obligation
fn lorenz_step(x: f64, y: f64, dt: f64) -> f64 with Chaotic, Mut, Div, Panic { x + dt * (y - x) }
