// Test array repeat syntax [value; count]

fn main() -> i32 with Panic {
    // Create an array with 5 zeros
    let zeros: [i32; 5] = [0; 5]

    // Create an array with 3 ones
    let ones: [i32; 3] = [1; 3]

    // Create a larger array
    let big: [f64; 10] = [3.14; 10]

    // Return first element as i32
    zeros[0]
}
