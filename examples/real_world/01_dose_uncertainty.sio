/// Real-World Example 1: Pharmaceutical Dose Calculation with Uncertainty
///
/// Demonstrates: Epistemic types, GUM uncertainty propagation, safety bounds
///
/// Problem: Calculate drug dosage accounting for patient weight measurement
/// uncertainty and ensure therapeutic window safety.
///
/// Expected Output:
///   Patient Weight: 70.0 kg (σ=2.0)
///   Dose/kg: 10.0 mg/kg (σ=0.5)
///   Total Dose: 700.0 mg (σ=20.6)
///   95% CI: [659.6, 740.4] mg
///   SAFE: Dose within therapeutic window with 95% confidence

// ============================================================================
// NUMERIC HELPERS
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 10 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    return y
}

// ============================================================================
// EPISTEMIC VALUE STRUCT
// ============================================================================

struct EpistemicValue {
    value: f64,
    variance: f64,
    conf_alpha: f64,
    conf_beta: f64
}

fn epistemic_new(value: f64, variance: f64) -> EpistemicValue {
    return EpistemicValue {
        value: value,
        variance: variance,
        conf_alpha: 1.0,
        conf_beta: 1.0
    }
}

fn epistemic_std(k: EpistemicValue) -> f64 {
    return sqrt_f64(k.variance)
}

// ============================================================================
// VARIANCE PROPAGATION
// ============================================================================

/// X * Y: Var(XY) ≈ Y²Var(X) + X²Var(Y) (delta method)
fn epistemic_mul(x: EpistemicValue, y: EpistemicValue) -> EpistemicValue {
    let new_variance = y.value * y.value * x.variance + x.value * x.value * y.variance
    return EpistemicValue {
        value: x.value * y.value,
        variance: new_variance,
        conf_alpha: x.conf_alpha + y.conf_alpha - 1.0,
        conf_beta: x.conf_beta + y.conf_beta - 1.0
    }
}

/// 95% CI lower bound
fn epistemic_ci95_lo(k: EpistemicValue) -> f64 {
    return k.value - 1.96 * sqrt_f64(k.variance)
}

/// 95% CI upper bound
fn epistemic_ci95_hi(k: EpistemicValue) -> f64 {
    return k.value + 1.96 * sqrt_f64(k.variance)
}

// ============================================================================
// MAIN: DOSE CALCULATION WITH UNCERTAINTY
// ============================================================================

fn main() -> i32 {
    println("=== Pharmaceutical Dose Calculation with Uncertainty ===")
    println("")

    // Patient weight with measurement uncertainty
    // Measurement: 70kg ± 2kg (standard deviation)
    // Variance = σ² = 4.0
    let weight = epistemic_new(70.0, 4.0)

    println("Patient Weight:")
    println("  Mean: 70.0 kg")
    println("  Std Dev: 2.0 kg")
    println("")

    // Dose per kg with clinical uncertainty
    // Clinical guideline: 10 mg/kg ± 0.5 mg/kg
    // Variance = 0.25
    let dose_per_kg = epistemic_new(10.0, 0.25)

    println("Dose per kg:")
    println("  Mean: 10.0 mg/kg")
    println("  Std Dev: 0.5 mg/kg")
    println("")

    // Calculate total dose - uncertainty propagates automatically via GUM
    // Using delta method: Var(XY) = Y²Var(X) + X²Var(Y)
    let total_dose = epistemic_mul(weight, dose_per_kg)

    let dose_std = epistemic_std(total_dose)

    println("Total Dose (GUM propagation):")
    println("  Mean: 700.0 mg")
    print("  Std Dev: ")
    println(dose_std)
    print("  Variance: ")
    println(total_dose.variance)
    println("")

    // Calculate 95% confidence interval
    let ci_lo = epistemic_ci95_lo(total_dose)
    let ci_hi = epistemic_ci95_hi(total_dose)

    println("95% Confidence Interval:")
    print("  Lower: ")
    println(ci_lo)
    print("  Upper: ")
    println(ci_hi)
    println("")

    // Therapeutic window: 600-800 mg
    let therapeutic_min = 600.0
    let therapeutic_max = 800.0

    println("Therapeutic Window: 600.0 - 800.0 mg")
    println("")

    // Safety check: Is 95% CI within therapeutic window?
    if ci_lo >= therapeutic_min && ci_hi <= therapeutic_max {
        println("RESULT: SAFE")
        println("  Dose within therapeutic window with 95% confidence")
        println("  All reasonable dose values are safe and effective")
    } else {
        println("RESULT: CAUTION")
        println("  Dose uncertainty overlaps safety bounds")
        if ci_lo < therapeutic_min {
            println("  Risk: Underdosing possible (CI below min)")
        }
        if ci_hi > therapeutic_max {
            println("  Risk: Overdosing possible (CI above max)")
        }
        println("  Recommendation: Reduce uncertainty or adjust dose")
    }
    println("")

    // Verification: Check variance propagation formula
    // Expected: Var(XY) = Y²Var(X) + X²Var(Y)
    //         = 100*4 + 4900*0.25 = 400 + 1225 = 1625
    let expected_variance = 100.0 * 4.0 + 4900.0 * 0.25
    let variance_error = abs_f64(total_dose.variance - expected_variance)

    println("Verification (Delta Method):")
    print("  Expected variance: ")
    println(expected_variance)
    print("  Computed variance: ")
    println(total_dose.variance)
    print("  Error: ")
    println(variance_error)

    if variance_error < 0.01 {
        println("  PASS: Variance propagation correct")
    } else {
        println("  FAIL: Variance propagation error")
    }
    println("")

    println("=== GUM-Compliant Uncertainty Propagation Demonstrated ===")

    return 0
}
