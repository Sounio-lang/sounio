/// Real-World Example 5: PK/PD Data Analysis with Uncertainty (native-compatible)
///
/// Demonstrates:
/// - One-compartment oral PK concentration model (analytical form)
/// - First-order uncertainty propagation (GUM-style) for derived parameters
/// - Pass/fail scientific checks that run in both interpreter and native compile paths

// ============================================================================
// NUMERIC HELPERS
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 10 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    return y
}

fn exp_f64(x: f64) -> f64 {
    // Guard non-finite / extreme arguments to avoid runaway recursion/loops in native mode.
    if x != x { return 0.0 }
    if x > 80.0 { return 5.54062238439351e34 } // exp(80)
    if x < 0.0 - 80.0 { return 1.804851387845415e-35 } // exp(-80)

    var xx = x
    var scale = 1.0

    while xx > 10.0 {
        xx = xx - 10.0
        scale = scale * 22026.465794806718 // exp(10)
    }
    while xx < 0.0 - 10.0 {
        xx = xx + 10.0
        scale = scale * 0.00004539992976248485 // exp(-10)
    }

    var result = 1.0
    var term = 1.0
    var nf = 1.0
    var n = 1
    while n < 20 {
        term = term * xx / nf
        result = result + term
        n = n + 1
        nf = nf + 1.0
    }
    return result * scale
}

fn ln_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 - 999999.0 }
    if x == 1.0 { return 0.0 }
    let y = (x - 1.0) / (x + 1.0)
    var result = 0.0
    var term = y
    var i = 1
    while i < 30 {
        result = result + term / (i * 1.0)
        term = term * y * y
        i = i + 2
    }
    return 2.0 * result
}

// ============================================================================
// PK MODEL
// ============================================================================

/// One-compartment oral absorption model (analytical solution):
/// C(t) = (ka * D / Vd) * (e^(-ke*t) - e^(-ka*t)) / (ka - ke), where ke = CL / Vd
fn pk_concentration(t: f64, dose: f64, ka: f64, vd: f64, cl: f64) -> f64 {
    let ke = cl / vd
    let exp_ke = exp_f64(0.0 - ke * t)
    let exp_ka = exp_f64(0.0 - ka * t)
    return (ka * dose / vd) * (exp_ke - exp_ka) / (ka - ke)
}

fn pk_find_tmax_scan(dose: f64, ka: f64, vd: f64, cl: f64) -> f64 {
    // Robust numeric peak search fallback: 0..24h with 0.01h step.
    var best_t = 0.0
    var best_c = pk_concentration(0.0, dose, ka, vd, cl)
    var t = 0.0
    while t <= 24.0 {
        let c = pk_concentration(t, dose, ka, vd, cl)
        if c > best_c {
            best_c = c
            best_t = t
        }
        t = t + 0.01
    }
    return best_t
}

// ============================================================================
// MAIN: NATIVE-COMPATIBLE REAL PK/PD TEST
// ============================================================================

fn main() -> i32 with IO, Panic {
    print("=== PKPD real test (native-compatible) ===\n")

    // Midazolam-like parameters (mean and variance)
    // CL = 27 +/- 3 L/h  => var = 9
    // Vd = 77 +/- 8 L    => var = 64
    // ka = 3.8 +/- 0.6 1/h => var = 0.36
    let cl_v = 27.0
    let cl_var = 9.0
    let vd_v = 77.0
    let vd_var = 64.0
    let ka_v = 3.8
    let ka_var = 0.36
    let _ka_std = sqrt_f64(ka_var)

    // Derived 1: half-life t_half = 0.693 * Vd / CL
    // Var(Vd/CL) ~= Var(Vd)/CL^2 + Vd^2 Var(CL)/CL^4
    let cl_sq = cl_v * cl_v
    let cl_quad = cl_sq * cl_sq
    let vd_sq = vd_v * vd_v
    let ratio_v = vd_v / cl_v
    let ratio_var = vd_var / cl_sq + vd_sq * cl_var / cl_quad
    let t_half_v = 0.693 * ratio_v
    let t_half_var = 0.693 * 0.693 * ratio_var

    // Derived 2: elimination constant ke = CL / Vd
    // Var(CL/Vd) ~= Var(CL)/Vd^2 + CL^2 Var(Vd)/Vd^4
    let vd_sq_ke = vd_v * vd_v
    let vd_quad_ke = vd_sq_ke * vd_sq_ke
    let ke_v = cl_v / vd_v
    let _ke_var = cl_var / vd_sq_ke + cl_v * cl_v * vd_var / vd_quad_ke

    // Concentration profile
    let dose = 7.5
    let c1 = pk_concentration(0.5, dose, ka_v, vd_v, cl_v)
    let _c2 = pk_concentration(1.0, dose, ka_v, vd_v, cl_v)
    let _c3 = pk_concentration(2.0, dose, ka_v, vd_v, cl_v)
    let _c4 = pk_concentration(4.0, dose, ka_v, vd_v, cl_v)
    let c5 = pk_concentration(8.0, dose, ka_v, vd_v, cl_v)

    // Analytic t_max = ln(ka/ke)/(ka-ke), with numeric fallback if unstable.
    let ka_ke_ratio = ka_v / ke_v
    let t_max_raw = ln_f64(ka_ke_ratio) / (ka_v - ke_v)
    let t_max = if t_max_raw <= 0.0 || t_max_raw > 24.0 {
        pk_find_tmax_scan(dose, ka_v, vd_v, cl_v)
    } else {
        t_max_raw
    }
    let c_max = pk_concentration(t_max, dose, ka_v, vd_v, cl_v)

    // ------------------------------------------------------------------------
    // SCIENTIFIC CHECKS (pass/fail)
    // ------------------------------------------------------------------------

    // Check A: half-life near literature envelope (1.97 +/- 0.31 h)
    let lit_t_half = 1.97
    let lit_std = 0.31
    let t_half_diff = t_half_v - lit_t_half
    if !(t_half_diff < lit_std && t_half_diff > 0.0 - lit_std) {
        print("FAIL: half-life outside literature envelope\n")
        return 1
    }
    print("PASS: half-life within literature envelope\n")

    // Check B: variance propagation identity for t_half
    let expected_t_half_var = 0.693 * 0.693 * (vd_var / cl_sq + vd_sq * cl_var / cl_quad)
    let var_diff = abs_f64(t_half_var - expected_t_half_var)
    if var_diff > 0.001 {
        print("FAIL: variance propagation mismatch\n")
        return 2
    }
    print("PASS: variance propagation identity holds\n")

    // Check C: physically sensible concentration profile
    if c1 <= 0.0 || c5 <= 0.0 || c1 <= c5 {
        print("FAIL: concentration profile sanity check failed\n")
        return 3
    }
    print("PASS: concentration profile sanity check\n")

    // Check D: positive peak time and peak concentration
    if t_max <= 0.0 || c_max <= 0.0 {
        print("FAIL: peak metrics invalid\n")
        return 4
    }
    print("PASS: peak metrics valid\n")

    print("PKPD_REAL_TEST: PASS\n")
    return 0
}
