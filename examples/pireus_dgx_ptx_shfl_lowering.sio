//@ run-pass
//!
//! First Sounio authority stream for the DGX PTX `shfl.sync.bfly` candidate.

use hardware::pireus::dgx_ptx_shfl_lowering::{
    PIREUS_DGX_PTX_OK,
    pireus_dgx_ptx_shfl_evaluate,
}

fn bool_i64(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(words: &[i64; 8]) with IO, Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if i > 0 { print(":") }
        print_int(words[i])
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 8 {
        print("usage: pireus_dgx_ptx_shfl_lowering <garden> <lowering-source> <lowering-semantics> <lowering-receipt> <ptx-source> <ptx-semantics> <ptx-receipt> <chunk-prefix>\n")
        return 2
    }
    let result = pireus_dgx_ptx_shfl_evaluate(
        get_arg(0), get_arg(1), get_arg(2), get_arg(3), get_arg(4),
        get_arg(5), get_arg(6), get_arg(7))
    var failures = result.failures
    if !result.valid || result.error != PIREUS_DGX_PTX_OK {
        failures = failures + 1
    }

    print("SOUNIO_AUTHORITY schema=pireus-dgx-ptx-shfl-xor-lowering.v1 role=SEMANTIC_AUTHORITY\n")
    print("PIREUS_DGX_PARENTS garden=")
    print_int(bool_i64(result.parents.garden_match))
    print(" lowering_source=")
    print_int(bool_i64(result.parents.lowering_source_match))
    print(" lowering_semantics=")
    print_int(bool_i64(result.parents.lowering_semantics_match))
    print(" lowering_receipt=")
    print_int(bool_i64(result.parents.lowering_receipt_match))
    print(" ptx_source="); print_int(bool_i64(result.parents.ptx_source_match))
    print(" ptx_semantics=")
    print_int(bool_i64(result.parents.ptx_semantics_match))
    print(" ptx_receipt="); print_int(bool_i64(result.parents.ptx_receipt_match))
    print(" ptx_corpus=")
    print_int(bool_i64(result.parents.ptx_corpus_binding_match))
    print(" chunk_one="); print_int(bool_i64(result.parents.ptx_chunk_one_match))
    print(" valid="); print_int(bool_i64(result.parents.valid)); print("\n")

    print("PIREUS_DGX_PTX_CORPUS bytes=")
    print_int(result.semantics.corpus_bytes)
    print(" chunks="); print_int(result.semantics.corpus_chunks)
    print(" digest_match=")
    print_int(bool_i64(result.semantics.corpus_digest_match))
    print(" prmt_parent_sections=")
    print_int(result.semantics.prmt_parent_sections); print("\n")

    print("PIREUS_DGX_PTX_SECTION selected=")
    print_int(result.semantics.selected_sections)
    print(" syntax_blocks="); print_int(result.semantics.syntax_blocks)
    print(" semantics_blocks="); print_int(result.semantics.semantics_blocks)
    print(" instruction_b32=")
    print_int(bool_i64(result.semantics.instruction_b32))
    print(" modes_up_down_bfly_idx=")
    print_int(bool_i64(result.semantics.modes_up_down_bfly_idx))
    print(" complete="); print_int(bool_i64(result.semantics.complete)); print("\n")

    print("PIREUS_DGX_PTX_SEMANTICS membermask_bits=")
    print_int(result.semantics.membermask_width_bits)
    print(" lane_bits="); print_int(result.semantics.lane_width_bits)
    print(" bval_bits="); print_int(result.semantics.bval_width_bits)
    print(" cval_bits="); print_int(result.semantics.cval_width_bits)
    print(" segmask_bits="); print_int(result.semantics.segmask_width_bits)
    print(" wait_rule="); print_int(bool_i64(result.semantics.wait_membermask_rule))
    print(" active_rule="); print_int(bool_i64(result.semantics.source_active_rule))
    print(" max_rule="); print_int(bool_i64(result.semantics.max_lane_rule))
    print(" min_rule="); print_int(bool_i64(result.semantics.min_lane_rule))
    print(" bfly_rule="); print_int(bool_i64(result.semantics.bfly_xor_rule))
    print(" fallback=")
    print_int(bool_i64(result.semantics.own_lane_fallback_rule))
    print(" copy="); print_int(bool_i64(result.semantics.source_copy_rule)); print("\n")

    print("PIREUS_DGX_PTX_UNDEFINED inactive_source=")
    print_int(bool_i64(result.semantics.inactive_source_undefined))
    print(" nonmember_source=")
    print_int(bool_i64(result.semantics.nonmember_source_undefined))
    print(" executing_nonmember=")
    print_int(bool_i64(result.semantics.executing_nonmember_undefined))
    print(" introduced_ptx="); print_int(result.semantics.introduced_ptx_major)
    print("."); print_int(result.semantics.introduced_ptx_minor)
    print(" target_sm_min="); print_int(result.semantics.target_sm_min); print("\n")

    print("PIREUS_DGX_GEOMETRY warp_lane_bits=")
    print_int(result.candidate.warp_lane_bits)
    print(" warp_lanes="); print_int(result.candidate.warp_lanes)
    print(" admitted_lanes="); print_int(result.candidate.admitted_logical_lanes)
    print(" membermask_bits="); print_int(result.candidate.membermask_bits)
    print(" membermask_low="); print_int(result.candidate.membermask_low)
    print(" bval_bits="); print_int(result.candidate.bval_bits)
    print(" cval="); print_int(result.candidate.cval)
    print(" segmask="); print_int(result.candidate.segmask)
    print(" packed_c="); print_int(result.candidate.packed_c)
    print(" payload_bits="); print_int(result.candidate.payload_bits_per_instruction)
    print(" f64_components="); print_int(result.candidate.f64_components)
    print(" abstract_shfl_sync=")
    print_int(result.candidate.abstract_shfl_sync_instructions)
    print(" identity_shfl_sync=")
    print_int(result.candidate.identity_shfl_sync_instructions)
    print(" nontrivial_shfl_sync=")
    print_int(result.candidate.nontrivial_shfl_sync_instructions); print("\n")

    print("PIREUS_DGX_COVERAGE displacements=")
    print_int(result.candidate.displacement_count)
    print(" logical_cells="); print_int(result.candidate.logical_cells)
    print(" matched_cells="); print_int(result.candidate.matched_cells)
    print(" mismatched_cells="); print_int(result.candidate.mismatched_cells)
    print(" in_range="); print_int(result.candidate.in_range_cells)
    print(" fallback_cells="); print_int(result.candidate.own_lane_fallback_cells)
    print(" active_sources="); print_int(result.candidate.active_source_cells)
    print(" member_sources="); print_int(result.candidate.member_source_cells)
    print(" max_source="); print_int(result.candidate.max_source_lane); print("\n")

    print("PIREUS_DGX_PAYLOAD component_cells=")
    print_int(result.candidate.payload_component_cells)
    print(" symbolic_bits="); print_int(result.candidate.symbolic_payload_bits)
    print(" matched_bits="); print_int(result.candidate.matched_payload_bits)
    print(" index_coverage=")
    print_int(bool_i64(result.candidate.logical_index_coverage))
    print(" payload_addresses_preserved=")
    print_int(bool_i64(
        result.candidate.symbolic_payload_address_preservation))
    print(" xor_permute_candidate=")
    print_int(bool_i64(result.candidate.xor_permute_candidate))
    print(" unresolved_other_nodes=")
    print_int(result.candidate.unresolved_other_nodes)
    print(" exact_tree_refused=")
    print_int(bool_i64(result.candidate.exact_tree_reduction_refused)); print("\n")

    print("PIREUS_DGX_DIGEST candidate=")
    print_digest(&result.candidate.digest.words); print("\n")
    print("PIREUS_DGX_NEGATIVES passed=")
    print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")
    print("PIREUS_DGX_BOUNDARY canonical=")
    print_int(bool_i64(result.dgx_canonical))
    print(" observed="); print_int(bool_i64(result.dgx_observed))
    print(" ptx_sass_equivalences="); print_int(result.ptx_sass_equivalence_count)
    print(" material_receipts="); print_int(result.dgx_material_receipt_count)
    print(" compiler_emissions="); print_int(result.compiler_emission_count)
    print(" costs="); print_int(result.cost_record_count)
    print(" parity_open="); print_int(bool_i64(result.parity_open))
    print(" claim_ready="); print_int(bool_i64(result.claim_ready)); print("\n")
    print("PIREUS_DGX_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(failures); print("\n")

    if failures == 0 { 0 } else { 1 }
}
