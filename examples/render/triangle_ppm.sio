//@ run-pass
// Software-rasterized triangle output as PPM P3
//
// Run: souc run examples/render/triangle_ppm.sio > triangle.ppm
// View: display triangle.ppm  (or open in any image viewer)
//
// Barycentric coordinate interpolation with per-vertex colors:
//   v0 (top, red), v1 (bottom-left, green), v2 (bottom-right, blue)

struct Vertex2D { x: f64, y: f64, z: f64, r: f64, g: f64, b: f64 }

fn edge_fn(ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64) -> f64 {
    (cx - ax) * (by - ay) - (cy - ay) * (bx - ax)
}

fn min_i64(a: i64, b: i64) -> i64 { if a < b { a } else { b } }
fn max_i64(a: i64, b: i64) -> i64 { if a > b { a } else { b } }
fn min_f64(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
fn max_f64(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

fn clamp_byte(v: i64) -> i64 {
    if v < 0 { return 0 }
    if v > 255 { return 255 }
    v
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let w: i64 = 128
    let h: i64 = 128

    // Framebuffer (128x128 = 16384 pixels)
    var fb_r: [i64; 16384] = [20; 16384]
    var fb_g: [i64; 16384] = [20; 16384]
    var fb_b: [i64; 16384] = [30; 16384]

    // Triangle vertices in pixel coordinates
    let v0 = Vertex2D { x: 64.0, y: 10.0, z: 0.0, r: 1.0, g: 0.0, b: 0.0 }
    let v1 = Vertex2D { x: 20.0, y: 110.0, z: 0.0, r: 0.0, g: 1.0, b: 0.0 }
    let v2 = Vertex2D { x: 108.0, y: 110.0, z: 0.0, r: 0.0, g: 0.0, b: 1.0 }

    let area = edge_fn(v0.x, v0.y, v1.x, v1.y, v2.x, v2.y)

    // Rasterize
    var py: i64 = 0
    while py < h {
        var px: i64 = 0
        while px < w {
            let cx = (px as f64) + 0.5
            let cy = (py as f64) + 0.5

            let w0 = edge_fn(v1.x, v1.y, v2.x, v2.y, cx, cy)
            let w1 = edge_fn(v2.x, v2.y, v0.x, v0.y, cx, cy)
            let w2 = edge_fn(v0.x, v0.y, v1.x, v1.y, cx, cy)

            let inside = if area > 0.0 {
                w0 >= 0.0 && w1 >= 0.0 && w2 >= 0.0
            } else {
                w0 <= 0.0 && w1 <= 0.0 && w2 <= 0.0
            }

            if inside {
                let b0 = w0 / area
                let b1 = w1 / area
                let b2 = w2 / area

                let r = b0 * v0.r + b1 * v1.r + b2 * v2.r
                let g = b0 * v0.g + b1 * v1.g + b2 * v2.g
                let b_col = b0 * v0.b + b1 * v1.b + b2 * v2.b

                let idx = py * w + px
                fb_r[idx] = clamp_byte((r * 255.0) as i64)
                fb_g[idx] = clamp_byte((g * 255.0) as i64)
                fb_b[idx] = clamp_byte((b_col * 255.0) as i64)
            }
            px = px + 1
        }
        py = py + 1
    }

    // Emit PPM P3
    print("P3\n")
    print_int(w)
    print(" ")
    print_int(h)
    print("\n255\n")
    var i: i64 = 0
    while i < w * h {
        print_int(fb_r[i])
        print(" ")
        print_int(fb_g[i])
        print(" ")
        print_int(fb_b[i])
        print("\n")
        i = i + 1
    }

    0
}
