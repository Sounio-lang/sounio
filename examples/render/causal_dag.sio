//@ run-pass
// Causal DAG rendering — graph visualization with do-calculus annotations
//
// Renders a causal graph (Bayesian network) with:
// - Nodes as circles with labels
// - Directed edges as arrows
// - Intervention targets highlighted
// - d-separation paths marked

struct Vec2 { x: f64, y: f64 }
struct Color { r: f64, g: f64, b: f64, a: f64 }

struct GraphNode {
    x: f64,
    y: f64,
    label_char: i64,
    is_intervention: bool,
}

struct GraphEdge {
    from_idx: i64,
    to_idx: i64,
    is_blocked: bool,
}

fn node(x: f64, y: f64, label: i64, intervened: bool) -> GraphNode {
    GraphNode { x: x, y: y, label_char: label, is_intervention: intervened }
}

fn edge(from: i64, to: i64) -> GraphEdge {
    GraphEdge { from_idx: from, to_idx: to, is_blocked: false }
}

fn node_color(n: GraphNode) -> Color {
    if n.is_intervention {
        Color { r: 1.0, g: 0.3, b: 0.1, a: 1.0 }   // red for do(X)
    } else {
        Color { r: 0.2, g: 0.6, b: 1.0, a: 1.0 }   // blue for observed
    }
}

fn main() -> i32 with IO {
    // Classic front-door criterion DAG: X → M → Y, X ← U → Y
    let x = node(100.0, 200.0, 88, true)    // X (intervened)
    let m = node(300.0, 200.0, 77, false)   // M (mediator)
    let y = node(500.0, 200.0, 89, false)   // Y (outcome)

    let e1 = edge(0, 1)  // X → M
    let e2 = edge(1, 2)  // M → Y

    let cx = node_color(x)
    let cm = node_color(m)
    // Sprint 35: render nodes as circles, edges as arrows, output PPM
    0
}
