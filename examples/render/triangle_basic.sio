//@ run-pass
// Basic triangle rendering — foundation for the Sounio render pipeline
//
// Sprint 34: Types only. Sprint 35 adds software rasterizer (PPM output).
// Sprint 36 adds GPU backends (SPIR-V/Metal/WGSL).

struct Vec3 { x: f64, y: f64, z: f64 }
struct Color { r: f64, g: f64, b: f64, a: f64 }
struct Vertex { pos: Vec3, col: Color }
struct Triangle { v0: Vertex, v1: Vertex, v2: Vertex }

fn vertex(x: f64, y: f64, z: f64, r: f64, g: f64, b: f64) -> Vertex {
    Vertex {
        pos: Vec3 { x: x, y: y, z: z },
        col: Color { r: r, g: g, b: b, a: 1.0 },
    }
}

fn make_triangle() -> Triangle {
    Triangle {
        v0: vertex(0.0, 0.5, 0.0, 1.0, 0.0, 0.0),
        v1: vertex(0.0 - 0.5, 0.0 - 0.5, 0.0, 0.0, 1.0, 0.0),
        v2: vertex(0.5, 0.0 - 0.5, 0.0, 0.0, 0.0, 1.0),
    }
}

fn main() -> i32 with IO {
    let tri = make_triangle()
    // Sprint 35: render_triangle(tri, config) -> PPM file
    0
}
