//@ run-pass
// Uncertainty field rendered as PPM — epistemic heatmap
//
// Run: souc run examples/render/uncertainty_ppm.sio > uncertainty.ppm
//
// 16x16 grid of "measurements" with varying uncertainty.
// Color: temperature map (blue→red). Alpha/brightness modulated by uncertainty.

fn clamp_byte(v: i64) -> i64 {
    if v < 0 { return 0 }
    if v > 255 { return 255 }
    v
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let w: i64 = 128
    let h: i64 = 128

    var fb_r: [i64; 16384] = [10; 16384]
    var fb_g: [i64; 16384] = [10; 16384]
    var fb_b: [i64; 16384] = [15; 16384]

    // Render 16x16 grid of uncertainty cells
    let cell_w: i64 = 8
    let cell_h: i64 = 8

    var gy: i64 = 0
    while gy < 16 {
        var gx: i64 = 0
        while gx < 16 {
            // Simulated measurement: value increases left-to-right
            let value = (gx as f64) / 15.0
            // Uncertainty increases top-to-bottom
            let eps = (gy as f64) / 15.0

            // Temperature colormap modulated by confidence
            let confidence = 1.0 - eps * 0.7
            let r_f = value * confidence
            let g_f = 0.15 * confidence
            let b_f = (1.0 - value) * confidence

            let r_byte = clamp_byte((r_f * 255.0) as i64)
            let g_byte = clamp_byte((g_f * 255.0) as i64)
            let b_byte = clamp_byte((b_f * 255.0) as i64)

            // Fill cell
            var cy: i64 = 0
            while cy < cell_h {
                var cx: i64 = 0
                while cx < cell_w {
                    let px = gx * cell_w + cx
                    let py = gy * cell_h + cy
                    let idx = py * w + px
                    fb_r[idx] = r_byte
                    fb_g[idx] = g_byte
                    fb_b[idx] = b_byte
                    cx = cx + 1
                }
                cy = cy + 1
            }
            gx = gx + 1
        }
        gy = gy + 1
    }

    // Emit PPM
    print("P3\n")
    print_int(w)
    print(" ")
    print_int(h)
    print("\n255\n")
    var i: i64 = 0
    while i < w * h {
        print_int(fb_r[i])
        print(" ")
        print_int(fb_g[i])
        print(" ")
        print_int(fb_b[i])
        print("\n")
        i = i + 1
    }

    0
}
