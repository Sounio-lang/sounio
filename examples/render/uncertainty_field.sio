//@ run-pass
// Uncertainty field visualization — epistemic rendering showcase
//
// Renders a 2D grid of Knowledge<f64> values as a color-mapped heatmap
// where color intensity = value and blur/alpha = uncertainty.
// This is Sounio's novel contribution: type-directed uncertainty rendering.

struct Color { r: f64, g: f64, b: f64, a: f64 }

fn uncertainty_to_alpha(eps: f64) -> f64 with Div {
    // Higher uncertainty → more transparent
    let clamped = if eps > 1.0 { 1.0 } else { eps }
    1.0 - clamped * 0.7
}

fn value_to_color(v: f64, eps: f64) -> Color with Div {
    // Temperature colormap: blue (cold) → red (hot)
    // Alpha modulated by uncertainty
    let t = if v > 1.0 { 1.0 } else { if v < 0.0 { 0.0 } else { v } }
    Color {
        r: t,
        g: 0.2,
        b: 1.0 - t,
        a: uncertainty_to_alpha(eps),
    }
}

fn main() -> i32 with IO, Div {
    // Grid of measurements with varying uncertainty
    let c1 = value_to_color(0.8, 0.1)   // high value, low uncertainty → bright red, opaque
    let c2 = value_to_color(0.3, 0.9)   // low value, high uncertainty → dim blue, transparent
    let c3 = value_to_color(0.5, 0.5)   // medium both → purple, semi-transparent
    // Sprint 35: render grid cells as colored rectangles to PPM
    0
}
