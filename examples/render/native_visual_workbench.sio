// Native Visual Workbench
//
// A headless receipt for Sounio's Visual IR, event reducer, deterministic
// replay, Canvas backend, selection highlights, and native inspector. The
// synthetic panels exercise renderer infrastructure; they are not empirical
// or clinical results, and the receipt does not claim browser interactivity.
//
// Generate:
//   SOUNIO_SOUC_ENGINE=lean_single bin/souc run examples/render/native_visual_workbench.sio > /tmp/sounio-native-workbench.ppm

use display::canvas::{Canvas, canvas_clear}
use display::event::{Event}
use viz::inspector::{viz_inspector_draw, viz_inspector_draw_node_highlights}
use viz::ir::{viz_scene_new}
use viz::viz_app::{viz_app_new}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_replay::{viz_replay_trace_events}
use viz::workbench::{viz_workbench_build_scene, viz_workbench_default_events}

fn make_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pixels = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pixels, width: w, height: h }
}

fn emit_ppm(c: &Canvas) with IO, Mut {
    println("P3")
    print_int(c.width)
    print(" ")
    print_int(c.height)
    print("\n255\n")
    var i: i64 = 0
    while i < c.width * c.height {
        let px = read_i64(c.pixels, i)
        print_int((px >> 16) & 255)
        print(" ")
        print_int((px >> 8) & 255)
        print(" ")
        print_int(px & 255)
        print("\n")
        i = i + 1
    }
}

fn main() with IO, Alloc, Mut, Div, Panic {
    var scene = viz_scene_new()
    let ids = viz_workbench_build_scene(&!scene)
    var app = viz_app_new(10, 13, 18)
    var canvas = make_canvas(480, 320)
    var events: [Event; 32] = [Event { kind: 0, key: 0, x: 0, y: 0, mods: 0 }; 32]
    let event_count = viz_workbench_default_events(&!events)
    let replay = viz_replay_trace_events(&!app, &!scene, &!canvas, &events, event_count)

    assert(replay.count == event_count + 1)
    assert(scene.selected_node == ids.toggle)
    assert(scene.active_tab == 3)
    assert(scene.time == 5.0)
    assert(scene.nodes[ids.toggle as usize].value == 1.0)

    canvas_clear(&!canvas, app.bg_r, app.bg_g, app.bg_b)
    viz_canvas_render_scene(&scene, &!canvas)
    viz_inspector_draw_node_highlights(&scene, &!canvas)
    viz_inspector_draw(&scene, &!canvas, 306, 16, 156, 146)
    emit_ppm(&canvas)
    heap_free(canvas.pixels as *mut i8)
}
