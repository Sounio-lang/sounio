// Causal Intervention Frontier
//
// This renderer receipt shows native graph surgery and a backdoor witness for
// one fixed DAG. Z and latent U both cause X and Y; X also causes Y. Adjusting
// for observed Z leaves the U backdoor open. do(X=1) removes Z->X and U->X.
// No causal effect is estimated, and this is not a general ID algorithm.
//
// Generate:
//   SOUNIO_SOUC_ENGINE=lean_single bin/souc run examples/render/causal_intervention_frontier.sio > /tmp/sounio-causal-frontier.ppm

use causal::categorical::{
    CatCausalDAG,
    cat_causal_dag_new,
    cat_dag_add_edge,
    cat_dag_set_observed,
    cat_do_intervention,
}
use display::canvas::{Canvas}
use viz::causal_canvas::{causal_render_confounding_receipt}

fn make_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pixels = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pixels, width: w, height: h }
}

fn causal_receipt_dag() -> CatCausalDAG with Mut, Div, Panic {
    // Node order: observed Z, latent U, treatment X, outcome Y.
    var dag = cat_causal_dag_new(4)
    cat_dag_set_observed(&!dag, 1, false)
    cat_dag_add_edge(&!dag, 0, 2)
    cat_dag_add_edge(&!dag, 0, 3)
    cat_dag_add_edge(&!dag, 1, 2)
    cat_dag_add_edge(&!dag, 1, 3)
    cat_dag_add_edge(&!dag, 2, 3)
    dag
}

fn emit_ppm(c: &Canvas) with IO, Mut, Div {
    print("P3\n")
    print_int(c.width)
    print(" ")
    print_int(c.height)
    print("\n255\n")
    var idx: i64 = 0
    while idx < c.width * c.height {
        let packed = read_i64(c.pixels, idx)
        print_int((packed >> 16) & 255)
        print(" ")
        print_int((packed >> 8) & 255)
        print(" ")
        print_int(packed & 255)
        print("\n")
        idx = idx + 1
    }
}

fn main() with IO, Alloc, Mut, Div, Panic {
    let observed = causal_receipt_dag()
    let intervened = cat_do_intervention(&observed, 2, 1.0)
    var canvas = make_canvas(480, 300)
    causal_render_confounding_receipt(&observed, &intervened, &!canvas)
    emit_ppm(&canvas)
    heap_free(canvas.pixels as *mut i8)
}
