// Synthetic epistemic field study rendered entirely by Sounio.
//
// This is a renderer receipt, not an empirical measurement. The left panel
// displays a deterministic two-source scalar field. The right panel displays
// its explicitly constructed standard-uncertainty channel.
//
// Generate:
//   SOUNIO_SOUC_ENGINE=lean_single bin/souc run examples/render/epistemic_field_atelier.sio > /tmp/sounio-epistemic-field.ppm

use display::canvas::{Canvas}
use viz::field_canvas::{field_render_value_uncertainty}
use viz::physchem::{ScalarField2D, scalar_field_empty}

fn make_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pixels = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pixels, width: w, height: h }
}

fn paint_background(c: &!Canvas) with Mut, Div {
    var y: i64 = 0
    while y < c.height {
        var x: i64 = 0
        while x < c.width {
            let r = 7 + (y * 9) / c.height
            let g = 11 + (y * 13) / c.height
            let b = 20 + (y * 22) / c.height
            write_i64(c.pixels, y * c.width + x, b | (g << 8) | (r << 16))
            x = x + 1
        }
        y = y + 1
    }
}

fn synthetic_field() -> ScalarField2D with Mut, Div {
    var field = scalar_field_empty(64, 64)
    var row: i64 = 0
    while row < 64 {
        var col: i64 = 0
        while col < 64 {
            let x = ((col as f64) - 31.5) / 31.5
            let y = ((row as f64) - 31.5) / 31.5
            let dx1 = x + 0.34
            let dy1 = y + 0.12
            let dx2 = x - 0.31
            let dy2 = y - 0.22
            let d1 = dx1 * dx1 + dy1 * dy1
            let d2 = dx2 * dx2 + dy2 * dy2
            let value = 1.0 / (0.16 + d1) - 0.74 / (0.20 + d2)
            let nearest = if d1 < d2 { d1 } else { d2 }
            let sigma = 0.06 + 0.58 * nearest / (0.20 + nearest)
            let idx = row * 64 + col
            field.values[idx as usize] = value
            field.variances[idx as usize] = sigma * sigma
            if idx == 0 || value < field.min_value { field.min_value = value }
            if idx == 0 || value > field.max_value { field.max_value = value }
            col = col + 1
        }
        row = row + 1
    }
    field
}

fn emit_ppm(c: &Canvas) with IO, Mut {
    println("P3")
    print_int(c.width); print(" "); print_int(c.height); print("\n255\n")
    var i: i64 = 0
    while i < c.width * c.height {
        let px = read_i64(c.pixels, i)
        print_int((px >> 16) & 0xFF); print(" ")
        print_int((px >> 8) & 0xFF); print(" ")
        print_int(px & 0xFF); print("\n")
        i = i + 1
    }
}

fn main() with IO, Alloc, Mut, Div {
    var canvas = make_canvas(480, 300)
    paint_background(&!canvas)
    let field = synthetic_field()
    field_render_value_uncertainty(&field, &!canvas, 22, 42, 208, 208, 20)
    emit_ppm(&canvas)
    heap_free(canvas.pixels as *mut i8)
}
