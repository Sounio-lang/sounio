// Typography Annotation Atelier
//
// A deterministic receipt for the opt-in LTR, integer-scaled bitmap font.
// It names the four renderer receipts without changing their source images.
//
// Generate:
//   SOUNIO_SOUC_ENGINE=lean_single bin/souc run examples/render/typography_annotation_atelier.sio > /tmp/sounio-typography.ppm

use display::canvas::{
    Canvas,
    canvas_draw_rect,
    canvas_draw_text_scaled,
    canvas_fill_gradient_v,
    canvas_fill_rect,
}

fn make_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pixels = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pixels, width: w, height: h }
}

fn ta_put8(
    buf: &![i8; 256], at: i64,
    a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64,
) -> i64 with Mut {
    let chars = [a, b, c, d, e, f, g, h]
    var i: i64 = 0
    var out = at
    while i < 8 && out < 256 {
        if chars[i as usize] != 0 {
            buf[out as usize] = chars[i as usize] as i8
            out = out + 1
        }
        i = i + 1
    }
    out
}

fn ta_draw_header(c: &!Canvas) with Mut {
    var text: [i8; 256] = [0; 256]
    var n = ta_put8(&!text, 0, 83, 79, 85, 78, 73, 79, 32, 47)
    n = ta_put8(&!text, n, 32, 86, 73, 83, 85, 65, 76, 32)
    n = ta_put8(&!text, n, 82, 69, 67, 69, 73, 80, 84, 83)
    canvas_draw_text_scaled(c, &text, n, 20, 24, 2, 0, 232, 240, 246)
}

fn ta_draw_card(
    c: &!Canvas,
    x: i64, y: i64,
    title: &[i8; 256], title_len: i64,
    detail: &[i8; 256], detail_len: i64,
    r: i64, g: i64, b: i64,
) with Mut {
    canvas_fill_rect(c, x, y, 210, 65, 12, 19, 29)
    canvas_draw_rect(c, x, y, 210, 65, 48, 65, 82)
    canvas_fill_rect(c, x, y, 4, 65, r, g, b)
    canvas_draw_text_scaled(c, title, title_len, x + 16, y + 13, 1, 1, 226, 235, 242)
    canvas_draw_text_scaled(c, detail, detail_len, x + 16, y + 38, 1, 0, r, g, b)
}

fn ta_draw_cards(c: &!Canvas) with Mut {
    var title: [i8; 256] = [0; 256]
    var detail: [i8; 256] = [0; 256]
    var tn = ta_put8(&!title, 0, 67, 79, 86, 69, 82, 65, 71, 69)
    tn = ta_put8(&!title, tn, 32, 67, 82, 89, 83, 84, 65, 76)
    var dn = ta_put8(&!detail, 0, 68, 69, 80, 84, 72, 32, 47, 32)
    dn = ta_put8(&!detail, dn, 67, 79, 86, 69, 82, 65, 71, 69)
    ta_draw_card(c, 20, 76, &title, tn, &detail, dn, 105, 225, 224)

    title = [0; 256]
    detail = [0; 256]
    tn = ta_put8(&!title, 0, 77, 79, 76, 69, 67, 85, 76, 65)
    tn = ta_put8(&!title, tn, 82, 32, 77, 65, 84, 69, 82, 73)
    tn = ta_put8(&!title, tn, 65, 76, 0, 0, 0, 0, 0, 0)
    dn = ta_put8(&!detail, 0, 65, 79, 32, 47, 32, 84, 79, 80)
    dn = ta_put8(&!detail, dn, 79, 76, 79, 71, 89, 0, 0, 0)
    ta_draw_card(c, 250, 76, &title, tn, &detail, dn, 238, 178, 62)

    title = [0; 256]
    detail = [0; 256]
    tn = ta_put8(&!title, 0, 69, 80, 73, 83, 84, 69, 77, 73)
    tn = ta_put8(&!title, tn, 67, 32, 70, 82, 79, 78, 84, 73)
    tn = ta_put8(&!title, tn, 69, 82, 0, 0, 0, 0, 0, 0)
    dn = ta_put8(&!detail, 0, 86, 65, 76, 85, 69, 32, 47, 32)
    dn = ta_put8(&!detail, dn, 85, 78, 67, 69, 82, 84, 65, 73)
    dn = ta_put8(&!detail, dn, 78, 84, 89, 0, 0, 0, 0, 0)
    ta_draw_card(c, 20, 151, &title, tn, &detail, dn, 250, 128, 184)

    title = [0; 256]
    detail = [0; 256]
    tn = ta_put8(&!title, 0, 67, 65, 85, 83, 65, 76, 32, 82)
    tn = ta_put8(&!title, tn, 69, 70, 85, 83, 65, 76, 0, 0)
    dn = ta_put8(&!detail, 0, 68, 79, 32, 88, 32, 47, 32, 76)
    dn = ta_put8(&!detail, dn, 65, 84, 69, 78, 84, 32, 85, 0)
    ta_draw_card(c, 250, 151, &title, tn, &detail, dn, 220, 231, 238)
}

fn ta_draw_specimen(c: &!Canvas) with Mut {
    var text: [i8; 256] = [0; 256]
    var n = ta_put8(&!text, 0, 76, 84, 82, 32, 49, 88, 32, 32)
    n = ta_put8(&!text, n, 70, 32, 82, 32, 74, 32, 50, 32)
    n = ta_put8(&!text, n, 51, 32, 55, 32, 40, 32, 41, 32)
    n = ta_put8(&!text, n, 123, 32, 125, 32, 47, 0, 0, 0)
    canvas_draw_text_scaled(c, &text, n, 20, 245, 1, 0, 157, 178, 196)
    canvas_fill_rect(c, 20, 274, 110, 3, 105, 225, 224)
    canvas_fill_rect(c, 130, 274, 110, 3, 238, 178, 62)
    canvas_fill_rect(c, 240, 274, 110, 3, 250, 128, 184)
    canvas_fill_rect(c, 350, 274, 110, 3, 220, 231, 238)
}

fn emit_ppm(c: &Canvas) with IO, Mut {
    println("P3")
    print_int(c.width)
    print(" ")
    print_int(c.height)
    print("\n255\n")
    var i: i64 = 0
    while i < c.width * c.height {
        let px = read_i64(c.pixels, i)
        print_int((px >> 16) & 255)
        print(" ")
        print_int((px >> 8) & 255)
        print(" ")
        print_int(px & 255)
        print("\n")
        i = i + 1
    }
}

fn main() with IO, Alloc, Mut, Div {
    var canvas = make_canvas(480, 300)
    canvas_fill_gradient_v(&!canvas, 0, 0, 480, 300, 7, 12, 20, 11, 19, 30)
    canvas_fill_rect(&!canvas, 20, 61, 440, 3, 105, 225, 224)
    ta_draw_header(&!canvas)
    ta_draw_cards(&!canvas)
    ta_draw_specimen(&!canvas)
    emit_ppm(&canvas)
    heap_free(canvas.pixels as *mut i8)
}
