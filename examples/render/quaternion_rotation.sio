//@ run-pass
// Quaternion rotation visualization — hypercomplex geometry rendering
//
// Renders a 3D object rotated by a quaternion, showing the rotation
// path on the unit sphere. Demonstrates Sounio's hypercomplex type support.

struct Vec3 { x: f64, y: f64, z: f64 }

struct Quaternion {
    w: f64,
    x: f64,
    y: f64,
    z: f64,
}

fn quat_from_axis_angle(ax: f64, ay: f64, az: f64, angle: f64) -> Quaternion with Div {
    // half_angle = angle / 2; sin_ha ≈ angle/2 for small angles (placeholder)
    let ha = angle * 0.5
    let sha = ha  // sin approximation for small angles
    let cha = 1.0 - ha * ha * 0.5  // cos approximation
    Quaternion { w: cha, x: ax * sha, y: ay * sha, z: az * sha }
}

fn quat_multiply(a: Quaternion, b: Quaternion) -> Quaternion {
    Quaternion {
        w: a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z,
        x: a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
        y: a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
        z: a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
    }
}

fn quat_rotate_point(q: Quaternion, p: Vec3) -> Vec3 {
    // p' = q * p * q^-1 (simplified for unit quaternion)
    let qp = Quaternion { w: 0.0, x: p.x, y: p.y, z: p.z }
    let q_conj = Quaternion { w: q.w, x: 0.0 - q.x, y: 0.0 - q.y, z: 0.0 - q.z }
    let tmp = quat_multiply(q, qp)
    let result = quat_multiply(tmp, q_conj)
    Vec3 { x: result.x, y: result.y, z: result.z }
}

fn main() -> i32 with IO, Div {
    // Rotate a point around Y axis by 45 degrees (≈0.785 rad)
    let q = quat_from_axis_angle(0.0, 1.0, 0.0, 0.785)
    let point = Vec3 { x: 1.0, y: 0.0, z: 0.0 }
    let rotated = quat_rotate_point(q, point)
    // Sprint 35: render original + rotated point, draw rotation arc
    0
}
