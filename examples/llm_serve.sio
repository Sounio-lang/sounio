//@ run-pass
//
// llm serve: OpenAI-compatible HTTP server over the native Sounio
// Llama forward. Loads the model once, then answers GET /health,
// GET /v1/models and POST /v1/completions until killed.
// Usage: llm_serve [model-dir] [port] [model-name] [gemm-ptx] [cvt-ptx] [gemv-ptx]
// With the three PTX paths, decode projections use the resident GEMV.

use hetero::runtime::{rt_load_gemv, rt_open_full}
use llm::bpe::{bpe_load}
use llm::llama::{llama_load}
use llm::llama_dev::{dev_open}
use llm::serve::{llm_serve, llm_serve_rt}

fn atoi(s: string) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < str_len(s) {
        let c = str_char_at(s, i)
        if c >= 48 && c <= 57 { v = v * 10 + (c - 48) }
        i = i + 1
    }
    v
}

fn main() with IO, Mut, Panic, Div, Alloc {
    var dir = "/workspace/llm-models/SmolLM2-135M"
    if arg_count() > 0 { dir = get_arg(0) }
    var port: i64 = 8090
    if arg_count() > 1 { port = atoi(get_arg(1)) }
    var name = "smollm2-135m"
    if arg_count() > 2 { name = get_arg(2) }

    print("llm serve loading ")
    print(dir)
    print("\n")
    let bp = bpe_load(dir ++ "/tokenizer.json")
    let m = llama_load(dir)
    print("loaded=")
    print_int(if m.loaded { 1 } else { 0 })
    print(" bpe=")
    print_int(if bp.ok { 1 } else { 0 })
    print("\n")
    if !m.loaded || !bp.ok { print("SERVE FAIL load\n"); exit(1) }
    if arg_count() > 5 {
        var rt = rt_open_full(get_arg(3), "gemm_tiled_f32", get_arg(4))
        let gok = rt_load_gemv(&!rt, get_arg(5))
        print("gpu=")
        print_int(if rt.ready && gok { 1 } else { 0 })
        print("\n")
        if !rt.ready || !gok { print("SERVE FAIL gpu\n"); exit(1) }
        if arg_count() > 8 {
            let opened = dev_open(&m, &rt, get_arg(6), get_arg(7), get_arg(8))
            print("dev=")
            print_int(opened)
            print("\n")
            if opened == 0 { print("SERVE FAIL dev\n"); exit(1) }
        }
        let r = llm_serve_rt(&m, &bp, port, name, &rt)
        print("SERVE EXIT ")
        print_int(r)
        print("\n")
        exit(0)
    }
    let r = llm_serve(&m, &bp, port, name)
    print("SERVE EXIT ")
    print_int(r)
    print("\n")
    exit(0)
}
