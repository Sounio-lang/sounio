//@ run-pass
//@ expect-stdout: ALL PASS

// examples/ontology/biomedical/snomed_elplus_demo.sio
//
// Demo of the role-aware EL+ closure over a curated SNOMED fragment.
// The classic EL+ inference invisible to the old BFS:
//   Pericarditis  ≤  ∃finding_site.Pericardium
//   Pericardium   ≤  ∃part_of.Heart
//   Endocardium   ≤  ∃part_of.Heart
//   part_of ∘ part_of ≤ part_of
//   finding_site ⊑ part_of
//
// With the role layer, both Pericarditis and Endocardium subsume to
// "∃part_of.Heart" (heart finding), and the closure derives it.
//
// NOTE: this demo uses local arrays (not the SNOMEDElplus struct) because
// the large struct miscompiles on the current Madaros lane (see
// docs/compiler/KNOWN_LIMITATIONS.md).

use ontology::elplus::{elplus_role_closure, elplus_seed, elplus_fixpoint, elplus_conflict, elplus_derive_conflicts}

fn main() -> i32 with IO, Mut, Div, Panic {
    var n_fail = 0

    // Concept ids (illustrative; real SNOMED codes are longer but we use i64 keys).
    let TOP = 0
    let PERICARDITIS = 1
    let ENDOCARDIUM = 2
    let PERICARDIUM = 3
    let HEART = 4
    let FINDING_SITE = 5
    let PART_OF = 6

    // Interned concepts: 7 atoms + 2 existentials = 9 concepts.
    let EX_FINDING_PERI = 7   // ∃finding_site.Pericardium
    let EX_PART_HEART = 8     // ∃part_of.Heart

    var ckind: [i64; 64] = [0; 64]
    var carg1: [i64; 64] = [0; 64]
    var carg2: [i64; 64] = [0; 64]
    var exid: [i64; 512] = [0; 512]
    var rclos: [bool; 64] = [false; 64]
    var s: [bool; 4096] = [false; 4096]
    var redges: [bool; 32768] = [false; 32768]
    var ch1: [i64; 8] = [0; 8]
    var ch2: [i64; 8] = [0; 8]
    var ch3: [i64; 8] = [0; 8]
    var disj: [i64; 64] = [0; 64]

    // Fill concept tables.
    ckind[TOP] = 1
    var a: i64 = 1
    while a <= 6 {
        ckind[a] = 0
        carg1[a] = a
        a = a + 1
    }
    ckind[EX_FINDING_PERI] = 3
    carg1[EX_FINDING_PERI] = FINDING_SITE
    carg2[EX_FINDING_PERI] = PERICARDIUM
    ckind[EX_PART_HEART] = 3
    carg1[EX_PART_HEART] = PART_OF
    carg2[EX_PART_HEART] = HEART

    // exid[role * 64 + filler] = concept id.
    exid[FINDING_SITE * 64 + PERICARDIUM] = EX_FINDING_PERI
    exid[PART_OF * 64 + HEART] = EX_PART_HEART

    // Role closure: finding_site ⊑ part_of.
    elplus_role_closure(&!rclos, 2)
    rclos[FINDING_SITE * 64 + PART_OF] = true

    // Seed: stated inclusions.
    elplus_seed(&!s, 9, TOP)
    s[PERICARDITIS * 64 + PERICARDIUM] = true
    s[PERICARDIUM * 64 + HEART] = true
    s[ENDOCARDIUM * 64 + HEART] = true
    s[PERICARDITIS * 64 + EX_FINDING_PERI] = true
    s[PERICARDIUM * 64 + EX_PART_HEART] = true
    s[ENDOCARDIUM * 64 + EX_PART_HEART] = true

    // Composition: part_of ∘ part_of ≤ part_of.
    ch1[0] = PART_OF
    ch2[0] = PART_OF
    ch3[0] = PART_OF

    // Fixpoint.
    let rounds = elplus_fixpoint(&!s, &!redges, &ckind, &carg1, &carg2, &exid, &rclos, &ch1, &ch2, &ch3, 1, 9, 9, 2)
    println(rounds)

    // 1. Pericarditis ⊑* Heart (via Pericardium).
    if !s[PERICARDITIS * 64 + HEART] {
        println("FAIL: Pericarditis should subsume Heart")
        n_fail = n_fail + 1
    }

    // 2. Pericarditis ⊑* ∃part_of.Heart (via finding_site ⊑ part_of).
    if !s[PERICARDITIS * 64 + EX_PART_HEART] {
        println("FAIL: Pericarditis should subsume ∃part_of.Heart")
        n_fail = n_fail + 1
    }

    // 3. Endocardium ⊑* ∃part_of.Heart (direct).
    if !s[ENDOCARDIUM * 64 + EX_PART_HEART] {
        println("FAIL: Endocardium should subsume ∃part_of.Heart")
        n_fail = n_fail + 1
    }

    // 4. Pericardium ⊑* ∃part_of.Heart (direct).
    if !s[PERICARDIUM * 64 + EX_PART_HEART] {
        println("FAIL: Pericardium should subsume ∃part_of.Heart")
        n_fail = n_fail + 1
    }

    // 5. Endocardium should NOT subsume ∃part_of.∃part_of.Heart (spurious nested).
    let ex_hh = 9
    ckind[ex_hh] = 2
    carg1[ex_hh] = PART_OF
    carg2[ex_hh] = EX_PART_HEART
    if s[ENDOCARDIUM * 64 + ex_hh] {
        println("FAIL: spurious nested ∃part_of.∃part_of.Heart for Endocardium")
        n_fail = n_fail + 1
    }

    // 6. Role targets: Pericardium and Endocardium have part_of-target Heart.
    if !redges[(PART_OF * 64 + PERICARDIUM) * 64 + HEART] {
        println("FAIL: Pericardium should have part_of-target Heart")
        n_fail = n_fail + 1
    }
    if !redges[(PART_OF * 64 + ENDOCARDIUM) * 64 + HEART] {
        println("FAIL: Endocardium should have part_of-target Heart")
        n_fail = n_fail + 1
    }

    if n_fail == 0 {
        println("ALL PASS")
        return 0
    }
    println("FAILURES:")
    println(n_fail)
    return 1
}
