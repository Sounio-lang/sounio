//@ run-pass
//@ expect-stdout: ADAPTER ALL PASS

// examples/ontology/biomedical/snomed_elplus_adapter_demo.sio
//
// Struct-adapter counterpart of snomed_elplus_demo.sio: the same
// classic EL+ inference (Baader et al.), driven through the
// SNOMEDElplus high-level API.
//
// Clinical fragment:
//   Pericarditis  ≤  ∃finding_site.Pericardium
//   Pericardium   ≤  ∃part_of.Heart
//   Endocardium   ≤  ∃part_of.Heart
//   Pericardium   ≤  Heart            (is-a)
//   finding_site  ⊑  part_of          (role hierarchy)
//   part_of ∘ part_of  ≤  part_of     (role composition)
//
// Derived (by the inlined 8-rule EL+ fixpoint in close()):
//   Pericarditis  ⊑*  Heart               (transitivity via Pericardium)
//   Pericarditis  ⊑*  ∃part_of.Heart      (role hierarchy: finding_site⊑part_of
//                                          + filler subsumption)
//   Endocardium   ⊑*  ∃part_of.Heart      (stated role edge)

use ontology::biomedical::snomed::{snomed_elplus_new, snomed_elplus_add_isa, snomed_elplus_add_rel, snomed_relationship_new, snomed_elplus_add_role_sub, snomed_elplus_add_role_chain, snomed_elplus_close, snomed_subsumes_elplus, snomed_subsumes_ex_elplus, snomed_elplus_nc, REL_FINDING_SITE, REL_PART_OF}

fn main() -> i32 with IO, Mut, Div, Panic {
    var n_fail: i64 = 0

    let TOP_SCTID: i64 = 138875005
    let PERICARDITIS: i64 = 195967001
    let PERICARDIUM: i64 = 76853006
    let ENDOCARDIUM: i64 = 17334004
    let HEART: i64 = 80248007

    var el = snomed_elplus_new(TOP_SCTID)

    el.snomed_elplus_add_isa(PERICARDITIS, PERICARDIUM)
    el.snomed_elplus_add_isa(PERICARDIUM, HEART)
    el.snomed_elplus_add_isa(ENDOCARDIUM, HEART)

    let rel_fsp = snomed_relationship_new(PERICARDITIS, REL_FINDING_SITE, PERICARDIUM)
    el.snomed_elplus_add_rel(&rel_fsp)
    let rel_poh_p = snomed_relationship_new(PERICARDIUM, REL_PART_OF, HEART)
    el.snomed_elplus_add_rel(&rel_poh_p)
    let rel_poh_e = snomed_relationship_new(ENDOCARDIUM, REL_PART_OF, HEART)
    el.snomed_elplus_add_rel(&rel_poh_e)

    el.snomed_elplus_add_role_sub(REL_FINDING_SITE, REL_PART_OF)
    el.snomed_elplus_add_role_chain(REL_PART_OF, REL_PART_OF, REL_PART_OF)

    let rounds = el.snomed_elplus_close()
    print("rounds=")
    println(rounds)
    print("nc=")
    println(el.snomed_elplus_nc())

    // Is-a transitivity (CR2).
    let t1 = el.snomed_subsumes_elplus(PERICARDITIS, HEART)
    if !t1 { print("FAIL: Pericarditis should subsume Heart\n"); n_fail = n_fail + 1 }

    let t2 = el.snomed_subsumes_elplus(PERICARDIUM, HEART)
    if !t2 { print("FAIL: Pericardium should subsume Heart\n"); n_fail = n_fail + 1 }

    let t3 = el.snomed_subsumes_elplus(HEART, PERICARDITIS)
    if t3 { print("FAIL: Heart should NOT subsume Pericarditis\n"); n_fail = n_fail + 1 }

    let t4 = el.snomed_subsumes_elplus(PERICARDITIS, TOP_SCTID)
    if !t4 { print("FAIL: Pericarditis should subsume TOP\n"); n_fail = n_fail + 1 }

    // Role-layer: existential subsumption (CR4 + CR3 on r, then RtoS).
    // Pericarditis ≤ ∃finding_site.Pericardium (stated) + finding_site⊑part_of
    //   → Pericarditis ≤ ∃part_of.Pericardium (CR4 on r)
    // Pericardium ≤ Heart (is-a) + above
    //   → Pericarditis ≤ ∃part_of.Heart (Rmono on r)
    let t5 = el.snomed_subsumes_ex_elplus(PERICARDITIS, REL_PART_OF, HEART)
    if !t5 { print("FAIL: Pericarditis should subsume ex.part_of.Heart\n"); n_fail = n_fail + 1 }

    let t6 = el.snomed_subsumes_ex_elplus(ENDOCARDIUM, REL_PART_OF, HEART)
    if !t6 { print("FAIL: Endocardium should subsume ex.part_of.Heart\n"); n_fail = n_fail + 1 }

    if n_fail == 0 {
        print("ADAPTER ALL PASS\n")
        return 0
    }
    print("ADAPTER FAILURES: ")
    println(n_fail)
    return 1
}
