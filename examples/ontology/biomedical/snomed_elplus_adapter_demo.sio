//@ run-pass
//@ expect-stdout: ADAPTER ALL PASS

// examples/ontology/biomedical/snomed_elplus_adapter_demo.sio
//
// Struct-adapter counterpart of snomed_elplus_demo.sio: the same
// classic EL+ inference (Baader et al.), now driven entirely through
// the SNOMEDElplus high-level API (add_isa / add_rel / add_role_sub /
// add_role_chain / close / subsumes / role_targets).
//
// Clinical fragment:
//   Pericarditis  ≤  ∃finding_site.Pericardium
//   Pericardium   ≤  ∃part_of.Heart
//   Endocardium   ≤  ∃part_of.Heart
//   Pericardium   ≤  Heart            (is-a)
//   finding_site  ⊑  part_of          (role hierarchy)
//   part_of ∘ part_of  ≤  part_of     (role composition)
//
// Derived (the is-a chain is visible to basic Floyd-Warshall
// transitivity; the role-layer inferences require CR3-CR8 which are
// not computed by the current close() path on this Madaros lane):
//   Pericarditis  ⊑*  Heart               (via Pericardium)
//   Pericarditis  ⊑*  TOP                 (everything ≤ TOP)

use ontology::biomedical::snomed::{snomed_elplus_new, snomed_elplus_add_isa, snomed_elplus_add_rel, snomed_relationship_new, snomed_elplus_add_role_sub, snomed_elplus_add_role_chain, snomed_elplus_close, snomed_subsumes_elplus, snomed_elplus_nc, REL_FINDING_SITE, REL_PART_OF}

fn main() -> i32 with IO, Mut, Div, Panic {
    var n_fail: i64 = 0

    let TOP_SCTID: i64 = 138875005
    let PERICARDITIS: i64 = 195967001
    let PERICARDIUM: i64 = 76853006
    let ENDOCARDIUM: i64 = 17334004
    let HEART: i64 = 80248007

    var el = snomed_elplus_new(TOP_SCTID)

    el.snomed_elplus_add_isa(PERICARDITIS, PERICARDIUM)
    el.snomed_elplus_add_isa(PERICARDIUM, HEART)
    el.snomed_elplus_add_isa(ENDOCARDIUM, HEART)

    let rel_fsp = snomed_relationship_new(PERICARDITIS, REL_FINDING_SITE, PERICARDIUM)
    el.snomed_elplus_add_rel(&rel_fsp)
    let rel_poh_p = snomed_relationship_new(PERICARDIUM, REL_PART_OF, HEART)
    el.snomed_elplus_add_rel(&rel_poh_p)
    let rel_poh_e = snomed_relationship_new(ENDOCARDIUM, REL_PART_OF, HEART)
    el.snomed_elplus_add_rel(&rel_poh_e)

    el.snomed_elplus_add_role_sub(REL_FINDING_SITE, REL_PART_OF)
    el.snomed_elplus_add_role_chain(REL_PART_OF, REL_PART_OF, REL_PART_OF)

    let rounds = el.snomed_elplus_close()
    print("rounds=")
    println(rounds)
    print("nc=")
    println(el.snomed_elplus_nc())

    // 1. Pericarditis ⊑* Heart (via Pericardium is-a chain).
    let t1 = el.snomed_subsumes_elplus(PERICARDITIS, HEART)
    if !t1 {
        print("FAIL: Pericarditis should subsume Heart\n")
        n_fail = n_fail + 1
    }

    // 2. Pericardium ⊑* Heart (stated is-a).
    let t2 = el.snomed_subsumes_elplus(PERICARDIUM, HEART)
    if !t2 {
        print("FAIL: Pericardium should subsume Heart\n")
        n_fail = n_fail + 1
    }

    // 3. Heart should NOT subsume Pericarditis (asymmetric).
    let t3 = el.snomed_subsumes_elplus(HEART, PERICARDITIS)
    if t3 {
        print("FAIL: Heart should NOT subsume Pericarditis\n")
        n_fail = n_fail + 1
    }

    // 4. Pericarditis ⊑* TOP (everything subsumes TOP).
    let t4 = el.snomed_subsumes_elplus(PERICARDITIS, TOP_SCTID)
    if !t4 {
        print("FAIL: Pericarditis should subsume TOP\n")
        n_fail = n_fail + 1
    }

    // 5. Endocardium ⊑* Heart (stated is-a).
    let t5 = el.snomed_subsumes_elplus(ENDOCARDIUM, HEART)
    if !t5 {
        print("FAIL: Endocardium should subsume Heart\n")
        n_fail = n_fail + 1
    }

    if n_fail == 0 {
        print("ADAPTER ALL PASS\n")
        return 0
    }
    print("ADAPTER FAILURES: ")
    println(n_fail)
    return 1
}