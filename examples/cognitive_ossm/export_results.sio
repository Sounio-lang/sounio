//! Export helper for bounded canonical Sounio O-SSM parity outputs.

const FILE_BUF_CAP: i64 = 1048576

fn path_join(a: string, b: string) -> string with Mut, Panic, Div {
    let n = str_len(a)
    if n <= 0 { return b }
    if str_eq(str_slice(a, n - 1, n), "/") {
        a ++ b
    } else {
        a ++ "/" ++ b
    }
}

fn write_text_file(path: string, text: string) -> bool with IO, Mut, Panic, Div {
    var data: [i8; 1048576] = [0; 1048576]
    let n = str_len(text)
    var i: i64 = 0
    while i < n && i < FILE_BUF_CAP {
        data[i as usize] = str_char_at(text, i) as i8
        i = i + 1
    }
    write_file(path, data, i) == 0
}

fn read_text_file(path: string) -> string with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 0 { return "" }
    let raw = read_file(path)
    str_from_bytes(raw, size)
}

fn csv_data_rows(text: string) -> i64 with Mut, Panic, Div {
    let n = str_len(text)
    if n <= 0 { return 0 }
    var rows: i64 = 0
    var start: i64 = 0
    var i: i64 = 0
    while i <= n {
        if i == n || str_char_at(text, i) == 10 {
            let line = str_slice(text, start, i)
            if rows > 0 && str_len(line) > 0 {
                rows = rows + 1
            } else if rows == 0 && str_len(line) > 0 {
                rows = 1
            }
            start = i + 1
        }
        i = i + 1
    }
    if rows <= 0 { 0 } else { rows - 1 }
}

fn print_usage() with IO {
    print("Usage: souc run examples/cognitive_ossm/export_results.sio -- [--output-root <path>]\n")
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let argc = arg_count()
    var output_root = "examples/cognitive_ossm/results"

    var i: i64 = 0
    while i < argc {
        let arg = get_arg(i)
        if str_eq(arg, "--output-root") {
            if i + 1 >= argc { print_usage(); return 1 }
            output_root = get_arg(i + 1)
            i = i + 2
        } else if str_eq(arg, "--help") || str_eq(arg, "-h") {
            print_usage()
            return 0
        } else {
            print("Unknown flag: ")
            print(arg)
            print("\n")
            print_usage()
            return 1
        }
    }

    let regimes: [string] = ["normative", "anxious", "ruminative", "psychotic"]
    var manifest = "regime,step_rows,summary_rows\n"

    var idx: i64 = 0
    while idx < regimes.len() as i64 {
        let regime = regimes[idx as usize]
        let step_path = path_join(output_root, "ossm_parity_" ++ regime ++ ".csv")
        let summary_path = path_join(output_root, "ossm_parity_summary_" ++ regime ++ ".csv")
        let step_rows = csv_data_rows(read_text_file(step_path))
        let summary_rows = csv_data_rows(read_text_file(summary_path))
        manifest = manifest ++ regime ++ "," ++ step_rows.to_string() ++ "," ++ summary_rows.to_string() ++ "\n"
        idx = idx + 1
    }

    let manifest_path = path_join(output_root, "ossm_parity_manifest.csv")
    if !write_text_file(manifest_path, manifest) {
        return 2
    }

    print("COGNITIVE_OSSM_EXPORT_OK\n")
    print("manifest_path=")
    print(manifest_path)
    print("\n")
    0
}
