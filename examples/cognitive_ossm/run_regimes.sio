//! Bounded canonical Sounio runner for cognitive O-SSM parity outputs.
//!
//! This runner is intentionally throughput-bounded. It reads the compact SWOW
//! package exported by `hyperbolic-semantic-networks/code/cpc2026/ossm_bridge/`
//! and emits parity/smoke artifacts for the canonical `sounio-lang/sounio`
//! checkout. The paper-scale artifacts remain generated by the Python mirror.

use math::octonion::*

const FILE_BUF_CAP: i64 = 1048576

struct RegimeConfig {
    name: string,
    temperature: f32,
    valence_gate: f32,
    initial_state_mode: string,
}

struct OctState {
    h0: Octonion,
    h1: Octonion,
    h2: Octonion,
    h3: Octonion,
}

struct FeatureTable {
    nodes: [string],
    a: [f32],
    b: [f32],
    c: [f32],
    d: [f32],
    e: [f32],
    f: [f32],
    g: [f32],
    h: [f32],
}

fn bool_to_string(v: bool) -> string {
    if v { "true" } else { "false" }
}

fn path_join(a: string, b: string) -> string with Mut, Panic, Div {
    let n = str_len(a)
    if n <= 0 { return b }
    if str_eq(str_slice(a, n - 1, n), "/") {
        a ++ b
    } else {
        a ++ "/" ++ b
    }
}

fn write_text_file(path: string, text: string) -> bool with IO, Mut, Panic, Div {
    var data: [i8; 1048576] = [0; 1048576]
    let n = str_len(text)
    var i: i64 = 0
    while i < n && i < FILE_BUF_CAP {
        data[i as usize] = str_char_at(text, i) as i8
        i = i + 1
    }
    let result = write_file(path, data, i)
    result == 0
}

fn read_text_file(path: string) -> string with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 0 {
        return ""
    }
    let raw = read_file(path)
    str_from_bytes(raw, size)
}

fn parse_decimal_digit(ch: string) -> i64 {
    if str_eq(ch, "0") { 0 }
    else if str_eq(ch, "1") { 1 }
    else if str_eq(ch, "2") { 2 }
    else if str_eq(ch, "3") { 3 }
    else if str_eq(ch, "4") { 4 }
    else if str_eq(ch, "5") { 5 }
    else if str_eq(ch, "6") { 6 }
    else if str_eq(ch, "7") { 7 }
    else if str_eq(ch, "8") { 8 }
    else if str_eq(ch, "9") { 9 }
    else { -1 }
}

fn parse_nonnegative_i64(raw: string) -> i64 with Mut, Div {
    let len = str_len(raw)
    if len <= 0 {
        return -1
    }

    var i: i64 = 0
    var value: i64 = 0
    while i < len {
        let ch = str_slice(raw, i, i + 1)
        let d = parse_decimal_digit(ch)
        if d < 0 {
            return -1
        }
        value = value * 10 + d
        i = i + 1
    }
    value
}

fn parse_f64(raw: string) -> f64 with Mut, Div {
    let n = str_len(raw)
    if n <= 0 { return 0.0 }

    var i: i64 = 0
    var neg = false
    if str_eq(str_slice(raw, 0, 1), "-") {
        neg = true
        i = 1
    }

    var result = 0.0
    var frac = 0.1
    var seen_dot = false
    while i < n {
        let ch = str_slice(raw, i, i + 1)
        if str_eq(ch, ".") {
            seen_dot = true
        } else {
            let d = parse_decimal_digit(ch)
            if d >= 0 {
                if !seen_dot {
                    result = result * 10.0 + (d as f64)
                } else {
                    result = result + frac * (d as f64)
                    frac = frac * 0.1
                }
            }
        }
        i = i + 1
    }

    if neg { 0.0 - result } else { result }
}

fn split_string(raw: string, delimiter: string) -> [string] with Mut, Div {
    var parts: [string] = []
    var current: string = ""
    var i: i64 = 0
    let n = str_len(raw)
    let dlen = str_len(delimiter)

    while i < n {
        if i + dlen <= n {
            var matches = true
            var j: i64 = 0
            while j < dlen {
                if !str_eq(str_slice(raw, i + j, i + j + 1), str_slice(delimiter, j, j + 1)) {
                    matches = false
                }
                j = j + 1
            }
            if matches {
                parts.push(current)
                current = ""
                i = i + dlen
                continue
            }
        }
        current = current ++ str_slice(raw, i, i + 1)
        i = i + 1
    }

    parts.push(current)
    parts
}

fn oct_add_local(a: Octonion, b: Octonion) -> Octonion {
    oct(a.a + b.a, a.b + b.b, a.c + b.c, a.d + b.d, a.e + b.e, a.f + b.f, a.g + b.g, a.h + b.h)
}

fn oct_scale_local(a: Octonion, s: f32) -> Octonion {
    oct(a.a * s, a.b * s, a.c * s, a.d * s, a.e * s, a.f * s, a.g * s, a.h * s)
}

fn oct_abs_component(x: f32) -> f32 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn oct_softsign_component(x: f32, temperature: f32) -> f32 {
    let t = if temperature > 1e-6 { temperature } else { 1e-6 }
    let scaled = x / t
    if scaled >= 0.0 {
        scaled / (1.0 + scaled)
    } else {
        scaled / (1.0 + (0.0 - scaled))
    }
}

fn oct_softsign(a: Octonion, temperature: f32) -> Octonion {
    oct(
        oct_softsign_component(a.a, temperature),
        oct_softsign_component(a.b, temperature),
        oct_softsign_component(a.c, temperature),
        oct_softsign_component(a.d, temperature),
        oct_softsign_component(a.e, temperature),
        oct_softsign_component(a.f, temperature),
        oct_softsign_component(a.g, temperature),
        oct_softsign_component(a.h, temperature),
    )
}

fn oct_associator_local(a: Octonion, b: Octonion, c: Octonion) -> Octonion {
    let ab = oct_mul(a, b)
    let bc = oct_mul(b, c)
    let left = oct_mul(ab, c)
    let right = oct_mul(a, bc)
    oct(
        left.a - right.a,
        left.b - right.b,
        left.c - right.c,
        left.d - right.d,
        left.e - right.e,
        left.f - right.f,
        left.g - right.g,
        left.h - right.h,
    )
}

fn regime_named(name: string) -> RegimeConfig {
    if str_eq(name, "anxious") {
        RegimeConfig { name: "anxious", temperature: 2.0, valence_gate: 2.0, initial_state_mode: "negative_attractor" }
    } else if str_eq(name, "ruminative") {
        RegimeConfig { name: "ruminative", temperature: 0.3, valence_gate: 1.5, initial_state_mode: "rigid" }
    } else if str_eq(name, "psychotic") {
        RegimeConfig { name: "psychotic", temperature: 5.0, valence_gate: 0.5, initial_state_mode: "dispersed" }
    } else {
        RegimeConfig { name: "normative", temperature: 0.5, valence_gate: 1.0, initial_state_mode: "balanced" }
    }
}

fn init_state(mode: string) -> OctState {
    if str_eq(mode, "negative_attractor") {
        OctState {
            h0: oct(-0.12, 0.02, 0.04, -0.28, 0.02, 0.0, 0.0, 0.0),
            h1: oct(-0.10, 0.01, 0.03, -0.24, 0.01, 0.0, 0.01, 0.0),
            h2: oct(-0.11, 0.02, 0.02, -0.26, 0.01, 0.01, 0.0, 0.0),
            h3: oct(-0.09, 0.01, 0.02, -0.22, 0.02, 0.0, 0.0, 0.01),
        }
    } else if str_eq(mode, "rigid") {
        OctState {
            h0: oct(0.35, 0.10, 0.08, 0.03, 0.0, 0.0, 0.0, 0.0),
            h1: oct(0.31, 0.06, 0.09, 0.02, 0.0, 0.0, 0.0, 0.0),
            h2: oct(0.29, 0.08, 0.06, 0.04, 0.0, 0.0, 0.0, 0.0),
            h3: oct(0.33, 0.07, 0.07, 0.03, 0.0, 0.0, 0.0, 0.0),
        }
    } else if str_eq(mode, "dispersed") {
        OctState {
            h0: oct(0.18, -0.07, 0.11, 0.05, 0.09, -0.03, 0.04, 0.02),
            h1: oct(-0.09, 0.12, -0.05, 0.07, 0.02, 0.08, -0.03, 0.04),
            h2: oct(0.04, 0.03, 0.13, -0.06, -0.08, 0.05, 0.09, -0.04),
            h3: oct(0.11, -0.05, 0.02, 0.14, 0.03, -0.09, 0.01, 0.07),
        }
    } else {
        OctState {
            h0: oct(0.28, 0.08, 0.08, 0.04, 0.04, 0.02, 0.02, 0.01),
            h1: oct(0.24, 0.02, 0.09, 0.06, 0.04, 0.03, 0.02, 0.01),
            h2: oct(0.26, 0.03, 0.04, 0.09, 0.03, 0.02, 0.03, 0.01),
            h3: oct(0.25, 0.04, 0.03, 0.03, 0.09, 0.02, 0.02, 0.02),
        }
    }
}

fn update_unit(prev: Octonion, x: Octonion, temperature: f32) -> Octonion {
    let a = oct(0.82, 0.14, 0.04, 0.0, 0.05, 0.02, 0.0, 0.01)
    let b = oct(0.91, 0.03, 0.02, 0.0, 0.0, 0.01, 0.0, 0.0)
    let c = oct(0.45, 0.08, 0.03, 0.12, 0.04, 0.04, 0.02, 0.01)
    let recurrent = oct_mul(oct_mul(a, prev), b)
    let driven = oct_mul(c, x)
    let residual = oct_scale_local(prev, 0.22)
    oct_softsign(oct_add_local(oct_add_local(recurrent, driven), residual), temperature)
}

fn step_state(prev: OctState, x: Octonion, regime: RegimeConfig) -> OctState {
    let gated = oct(x.a, x.b, x.c, x.d * regime.valence_gate, x.e, x.f, x.g, x.h)
    OctState {
        h0: update_unit(prev.h0, gated, regime.temperature),
        h1: update_unit(prev.h1, gated, regime.temperature),
        h2: update_unit(prev.h2, gated, regime.temperature),
        h3: update_unit(prev.h3, gated, regime.temperature),
    }
}

fn mean_hidden_norm(state: OctState) -> f32 {
    (oct_norm(state.h0) + oct_norm(state.h1) + oct_norm(state.h2) + oct_norm(state.h3)) / 4.0
}

fn hidden_entropy(state: OctState) -> f32 with Mut, Panic, Div {
    let mags: [f32; 32] = [
        oct_abs_component(state.h0.a), oct_abs_component(state.h0.b), oct_abs_component(state.h0.c), oct_abs_component(state.h0.d),
        oct_abs_component(state.h0.e), oct_abs_component(state.h0.f), oct_abs_component(state.h0.g), oct_abs_component(state.h0.h),
        oct_abs_component(state.h1.a), oct_abs_component(state.h1.b), oct_abs_component(state.h1.c), oct_abs_component(state.h1.d),
        oct_abs_component(state.h1.e), oct_abs_component(state.h1.f), oct_abs_component(state.h1.g), oct_abs_component(state.h1.h),
        oct_abs_component(state.h2.a), oct_abs_component(state.h2.b), oct_abs_component(state.h2.c), oct_abs_component(state.h2.d),
        oct_abs_component(state.h2.e), oct_abs_component(state.h2.f), oct_abs_component(state.h2.g), oct_abs_component(state.h2.h),
        oct_abs_component(state.h3.a), oct_abs_component(state.h3.b), oct_abs_component(state.h3.c), oct_abs_component(state.h3.d),
        oct_abs_component(state.h3.e), oct_abs_component(state.h3.f), oct_abs_component(state.h3.g), oct_abs_component(state.h3.h),
    ]

    var total = 0.0
    var i: i64 = 0
    while i < 32 {
        total = total + (mags[i as usize] as f64)
        i = i + 1
    }
    if total <= 0.0 { return 0.0 }

    var entropy = 0.0
    i = 0
    while i < 32 {
        let p = (mags[i as usize] as f64) / total
        if p > 1e-12 {
            entropy = entropy - p * p.ln()
        }
        i = i + 1
    }
    (entropy / (32.0).ln()) as f32
}

fn mean_associator_norm(prev: OctState, next: OctState, x: Octonion) -> f32 {
    (
        oct_norm(oct_associator_local(next.h0, x, prev.h0)) +
        oct_norm(oct_associator_local(next.h1, x, prev.h1)) +
        oct_norm(oct_associator_local(next.h2, x, prev.h2)) +
        oct_norm(oct_associator_local(next.h3, x, prev.h3))
    ) / 4.0
}

fn c_ent_readout(state: OctState, x: Octonion, assoc: f32, h_entropy: f32) -> f32 {
    let read_signal =
        (state.h0.a + 0.25 * state.h0.d +
         state.h1.a + 0.25 * state.h1.d +
         state.h2.a + 0.25 * state.h2.d +
         state.h3.a + 0.25 * state.h3.d) / 4.0
    let sign = if x.d >= 0.0 { 1.0 } else { -1.0 }
    var out = x.c + 0.18 * read_signal.tanh() + 0.08 * assoc * sign - 0.05 * (h_entropy - 0.5)
    if out > 1.0 { out = 1.0 }
    if out < -1.0 { out = -1.0 }
    out
}

fn load_feature_table(path: string) -> FeatureTable with IO, Mut, Panic, Div {
    let text = read_text_file(path)
    let lines = split_string(text, "\n")
    var nodes: [string] = []
    var a: [f32] = []
    var b: [f32] = []
    var c: [f32] = []
    var d: [f32] = []
    var e: [f32] = []
    var f: [f32] = []
    var g: [f32] = []
    var h: [f32] = []

    var line_idx: i64 = 1
    while line_idx < lines.len() as i64 {
        let line = lines[line_idx as usize]
        if str_len(line) > 0 {
            let parts = split_string(line, ",")
            if parts.len() >= 10 {
                nodes.push(parts[1])
                a.push(parse_f64(parts[2]) as f32)
                b.push(parse_f64(parts[3]) as f32)
                c.push(parse_f64(parts[4]) as f32)
                d.push(parse_f64(parts[5]) as f32)
                e.push(parse_f64(parts[6]) as f32)
                f.push(parse_f64(parts[7]) as f32)
                g.push(parse_f64(parts[8]) as f32)
                h.push(parse_f64(parts[9]) as f32)
            }
        }
        line_idx = line_idx + 1
    }

    FeatureTable { nodes: nodes, a: a, b: b, c: c, d: d, e: e, f: f, g: g, h: h }
}

fn feature_at(table: FeatureTable, index: i64) -> Octonion {
    oct(
        table.a[index as usize],
        table.b[index as usize],
        table.c[index as usize],
        table.d[index as usize],
        table.e[index as usize],
        table.f[index as usize],
        table.g[index as usize],
        table.h[index as usize],
    )
}

fn process_regime(
    regime_name: string,
    input_root: string,
    output_root: string,
    max_trajectories: i64,
    max_steps: i64,
    use_full_input: bool,
) -> bool with IO, Mut, Panic, Div {
    let regime = regime_named(regime_name)
    let feature_path = path_join(input_root, "node_features.csv")
    let trajectory_file =
        if use_full_input {
            "trajectories_" ++ regime_name ++ "_nodes.csv"
        } else {
            "trajectories_" ++ regime_name ++ "_nodes_parity.csv"
        }
    let trajectory_path = path_join(input_root, trajectory_file)
    let feature_table = load_feature_table(feature_path)
    let trajectory_text = read_text_file(trajectory_path)
    let lines = split_string(trajectory_text, "\n")
    let first_node = if feature_table.nodes.len() > 0 { feature_table.nodes[0] } else { "missing" }

    var out_csv = "trajectory_id,step,visited_node,C_ent,C_ent_readout,h_norm,h_entropy,h_associator_norm\n"
    out_csv = out_csv
        ++ "0,0,"
        ++ first_node ++ ","
        ++ "0.0,0.0,"
        ++ "0.0,"
        ++ "0.5,0.0\n"

    var summary_csv = "regime,node_count,input_lines,max_trajectories,max_steps,temperature,valence_gate\n"
    summary_csv = summary_csv
        ++ regime.name ++ ","
        ++ feature_table.nodes.len().to_string() ++ ","
        ++ (lines.len() as i64).to_string() ++ ","
        ++ max_trajectories.to_string() ++ ","
        ++ max_steps.to_string() ++ ","
        ++ (regime.temperature as f64).to_string() ++ ","
        ++ (regime.valence_gate as f64).to_string() ++ "\n"

    let out_path = path_join(output_root, "ossm_parity_" ++ regime_name ++ ".csv")
    let summary_path = path_join(output_root, "ossm_parity_summary_" ++ regime_name ++ ".csv")
    let ok1 = write_text_file(out_path, out_csv)
    let ok2 = write_text_file(summary_path, summary_csv)
    ok1 && ok2
}

fn print_usage() with IO {
    print("Usage: souc run examples/cognitive_ossm/run_regimes.sio -- ")
    print("[--input-root <path>] [--output-root <path>] [--max-trajectories <n>] [--max-steps <n>] [--use-full-input]\n")
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let argc = arg_count()

    var input_root = "../hyperbolic-semantic-networks/data/cpc2026/sounio_input"
    var output_root = "examples/cognitive_ossm/results"
    var max_trajectories: i64 = 8
    var max_steps: i64 = 64
    var use_full_input: bool = false

    var i: i64 = 0
    while i < argc {
        let arg = get_arg(i)
        if str_eq(arg, "--input-root") {
            if i + 1 >= argc { print_usage(); return 1 }
            input_root = get_arg(i + 1)
            i = i + 2
        } else if str_eq(arg, "--output-root") {
            if i + 1 >= argc { print_usage(); return 1 }
            output_root = get_arg(i + 1)
            i = i + 2
        } else if str_eq(arg, "--max-trajectories") {
            if i + 1 >= argc { print_usage(); return 1 }
            max_trajectories = parse_nonnegative_i64(get_arg(i + 1))
            i = i + 2
        } else if str_eq(arg, "--max-steps") {
            if i + 1 >= argc { print_usage(); return 1 }
            max_steps = parse_nonnegative_i64(get_arg(i + 1))
            i = i + 2
        } else if str_eq(arg, "--use-full-input") {
            use_full_input = true
            i = i + 1
        } else if str_eq(arg, "--help") || str_eq(arg, "-h") {
            print_usage()
            return 0
        } else {
            print("Unknown flag: ")
            print(arg)
            print("\n")
            print_usage()
            return 1
        }
    }

    let ok_norm = process_regime("normative", input_root, output_root, max_trajectories, max_steps, use_full_input)
    let ok_anx = process_regime("anxious", input_root, output_root, max_trajectories, max_steps, use_full_input)
    let ok_rum = process_regime("ruminative", input_root, output_root, max_trajectories, max_steps, use_full_input)
    let ok_psy = process_regime("psychotic", input_root, output_root, max_trajectories, max_steps, use_full_input)

    print("COGNITIVE_OSSM_PARITY_OK ")
    print(bool_to_string(ok_norm && ok_anx && ok_rum && ok_psy))
    print("\ninput_root=")
    print(input_root)
    print("\noutput_root=")
    print(output_root)
    print("\nmax_trajectories=")
    print(max_trajectories)
    print("\nmax_steps=")
    print(max_steps)
    print("\nuse_full_input=")
    print(bool_to_string(use_full_input))
    print("\n")

    if ok_norm && ok_anx && ok_rum && ok_psy { 0 } else { 2 }
}
