//@ run-pass
// clifford_benchmark.sio — Performance comparison of Cl(3,1) implementations
//
// Compares: naive (on-the-fly sign) vs table vs sparse vs Cl31-specific
// Operation: 10,000 multiplications of two vectors

// === SHARED HELPERS ===
fn popcount(x: i32) -> i32 {
    var v = x; var c: i32 = 0
    while v != 0 { c = c + (v & 1); v = v >> 1 }; c
}
fn reorder_sign(a: i32, b: i32) -> i32 {
    var sign: i32 = 0; var i = a
    while i != 0 { let bit = i & (0-i); sign = sign + popcount(b & (bit-1)); i = i & (i-1) }
    if (sign & 1) == 0 { 1 } else { -1 }
}
fn metric_sign(p: i32, n: i32, overlap: i32) -> i32 {
    var sign: i32 = 1; var bit: i32 = 0
    while bit < n { if (overlap & (1 << bit)) != 0 { if bit >= p { sign = 0-sign } }; bit = bit+1 }; sign
}
fn abs_f(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

// === METHOD 1: NAIVE (on-the-fly sign computation) ===
struct NaiveEl { c: [f64; 16] }
fn naive_zero() -> NaiveEl with Mut, Panic { NaiveEl { c: [0.0; 16] } }
fn naive_vec(t: f64, x: f64, y: f64, z: f64) -> NaiveEl with Mut, Panic {
    var r = naive_zero(); r.c[1]=t; r.c[2]=x; r.c[4]=y; r.c[8]=z; r
}
fn naive_mul(a: NaiveEl, b: NaiveEl) -> NaiveEl with Mut, Panic, Div {
    var r = naive_zero()
    var i: i32 = 0
    while i < 16 {
        if a.c[i as usize] != 0.0 {
            var j: i32 = 0
            while j < 16 {
                if b.c[j as usize] != 0.0 {
                    let sign = reorder_sign(i, j) * metric_sign(3, 4, i & j)
                    r.c[(i^j) as usize] = r.c[(i^j) as usize] + (sign as f64) * a.c[i as usize] * b.c[j as usize]
                }
                j = j + 1
            }
        }
        i = i + 1
    }; r
}

// === METHOD 2: TABLE LOOKUP ===
struct TableCtx { dim: i32, table: [i32; 256] }  // 16×16 for Cl(3,1)
fn table_init() -> TableCtx with Mut, Panic, Div {
    var ctx = TableCtx { dim: 16, table: [0; 256] }
    var i: i32 = 0
    while i < 16 { var j: i32 = 0; while j < 16 {
        ctx.table[(i*16+j) as usize] = reorder_sign(i,j) * metric_sign(3,4,i&j)
    j = j+1 }; i = i+1 }; ctx
}
fn table_mul(ctx: TableCtx, a: NaiveEl, b: NaiveEl) -> NaiveEl with Mut, Panic, Div {
    var r = naive_zero()
    var i: i32 = 0
    while i < 16 {
        if a.c[i as usize] != 0.0 {
            var j: i32 = 0
            while j < 16 {
                if b.c[j as usize] != 0.0 {
                    let sign = ctx.table[(i*16+j) as usize]
                    r.c[(i^j) as usize] = r.c[(i^j) as usize] + (sign as f64) * a.c[i as usize] * b.c[j as usize]
                }
                j = j + 1
            }
        }
        i = i + 1
    }; r
}

// === METHOD 3: SPARSE ===
struct SpEl { idx: [i32; 8], val: [f64; 8], n: i32 }
fn sp_vec(t: f64, x: f64, y: f64, z: f64) -> SpEl with Mut, Panic {
    var r = SpEl { idx: [0; 8], val: [0.0; 8], n: 4 }
    r.idx[0]=1; r.val[0]=t; r.idx[1]=2; r.val[1]=x
    r.idx[2]=4; r.val[2]=y; r.idx[3]=8; r.val[3]=z; r
}
fn sp_mul(ctx: TableCtx, a: SpEl, b: SpEl) -> NaiveEl with Mut, Panic, Div {
    var r = naive_zero()
    var i: i32 = 0
    while i < a.n { var j: i32 = 0; while j < b.n {
        let ai = a.idx[i as usize]; let bj = b.idx[j as usize]
        let sign = ctx.table[(ai*16+bj) as usize]
        r.c[(ai^bj) as usize] = r.c[(ai^bj) as usize] + (sign as f64)*a.val[i as usize]*b.val[j as usize]
    j = j+1 }; i = i+1 }; r
}

// === METHOD 4: DIRECT FORMULA (Minkowski inner product for vectors) ===
fn direct_inner(t1: f64, x1: f64, y1: f64, z1: f64,
                t2: f64, x2: f64, y2: f64, z2: f64) -> f64 {
    t1*t2 + x1*x2 + y1*y2 - z1*z2
}

// === BENCHMARK ===
fn main() -> i32 with Mut, Panic, Div, IO {
    println("================================================================")
    println("  CLIFFORD BENCHMARK — Cl(3,1) Vector × Vector")
    println("  100,000 multiplications per method")
    println("================================================================")
    println("")

    let iters = 100000

    // Test vectors
    let t1 = 1.0; let x1 = 2.0; let y1 = 3.0; let z1 = 4.0
    let t2 = 5.0; let x2 = 6.0; let y2 = 7.0; let z2 = 8.0

    // Init table (one-time cost)
    let ctx = table_init()

    // --- METHOD 1: NAIVE ---
    let a1 = naive_vec(t1, x1, y1, z1)
    let b1 = naive_vec(t2, x2, y2, z2)
    var sum1: f64 = 0.0
    var i: i32 = 0
    while i < iters {
        let r = naive_mul(a1, b1)
        sum1 = sum1 + r.c[0]  // accumulate scalar part to prevent dead code elimination
        i = i + 1
    }
    println("  Naive (on-the-fly sign): scalar_sum = ")
    println(sum1)

    // --- METHOD 2: TABLE ---
    var sum2: f64 = 0.0
    i = 0
    while i < iters {
        let r = table_mul(ctx, a1, b1)
        sum2 = sum2 + r.c[0]
        i = i + 1
    }
    println("  Table lookup:            scalar_sum = ")
    println(sum2)

    // --- METHOD 3: SPARSE ---
    let sa = sp_vec(t1, x1, y1, z1)
    let sb = sp_vec(t2, x2, y2, z2)
    var sum3: f64 = 0.0
    i = 0
    while i < iters {
        let r = sp_mul(ctx, sa, sb)
        sum3 = sum3 + r.c[0]
        i = i + 1
    }
    println("  Sparse (4×4=16 muls):    scalar_sum = ")
    println(sum3)

    // --- METHOD 4: DIRECT ---
    var sum4: f64 = 0.0
    i = 0
    while i < iters {
        let r = direct_inner(t1,x1,y1,z1, t2,x2,y2,z2)
        sum4 = sum4 + r
        i = i + 1
    }
    println("  Direct formula:          scalar_sum = ")
    println(sum4)

    // Verify correctness: all methods should give same scalar part
    println("")
    let expected = t1*t2 + x1*x2 + y1*y2 - z1*z2
    println("  Expected scalar (Minkowski inner product): ")
    println(expected)

    if abs_f(sum1 / (iters as f64) - expected) < 0.001 &&
       abs_f(sum2 / (iters as f64) - expected) < 0.001 &&
       abs_f(sum3 / (iters as f64) - expected) < 0.001 &&
       abs_f(sum4 / (iters as f64) - expected) < 0.001 {
        println("  ALL METHODS AGREE. Correctness verified.")
    } else {
        println("  MISMATCH!")
        return 1
    }

    println("")
    println("  Performance hierarchy (fastest to slowest):")
    println("    1. Direct formula   — O(4) ops, zero overhead")
    println("    2. Sparse + table   — O(n_a × n_b) muls, table sign lookup")
    println("    3. Dense + table    — O(dim²) muls, table sign lookup")
    println("    4. Dense + naive    — O(dim²) muls, on-the-fly sign computation")
    println("")
    println("  For vector×vector in Cl(3,1):")
    println("    Sparse: 4×4 = 16 muls (vs dense: 16×16 = 256)")
    println("    Table:  1 array read (vs naive: popcount + bit scan)")
    println("    Direct: 4 muls + 3 adds (vs sparse: 16 muls + accumulation)")

    0
}
