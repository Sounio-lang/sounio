//@ run-pass
//!
//! First Sounio semantic-authority executable for the Pireus operation DAG.
//! No operation result, digest, witness count, or expected matcher in this file
//! predates this execution.

use hardware::pireus::xor_convolution_operation::{
    PireusXorOperationDigest,
    pireus_xor_operation_evaluate,
}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_hex_word(word: i64) with IO, Mut {
    var shift: i64 = 28
    while shift >= 0 {
        let nibble = (word >> shift) & 15
        if nibble < 10 { print_char(48 + nibble) }
        else { print_char(87 + nibble) }
        shift = shift - 4
    }
}

fn print_digest(digest: &PireusXorOperationDigest) with IO, Mut {
    var i: i64 = 0
    while i < 8 {
        print_hex_word(digest.words[i])
        i = i + 1
    }
}

fn print_hash(words: &[i64; 8]) with IO, Mut {
    var i: i64 = 0
    while i < 8 {
        print_hex_word(words[i])
        i = i + 1
    }
}

fn print_negative(name: string, passed: bool) with IO, Mut {
    print("PIREUS_XOR_NEGATIVE name="); print(name)
    print(" passed="); print_int(yes(passed)); print("\n")
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let result = pireus_xor_operation_evaluate()

    print("PIREUS_XOR_OPERATION bits="); print_int(result.bits)
    print(" dimension="); print_int(result.dimension)
    print(" valid="); print_int(yes(result.valid))
    print(" error="); print_int(result.error)
    print(" xor_parent_frozen="); print_int(yes(result.xor_parent_frozen))
    print(" graph_parent_frozen="); print_int(yes(result.graph_parent_frozen))
    print(" xor_parent_match="); print_int(yes(result.xor_parent_match))
    print(" graph_parent_receipt_valid=")
    print_int(yes(result.graph_parent_receipt_valid))
    print("\n")

    print("PIREUS_XOR_GRAPH overlay_graph=")
    print_int(result.graph.overlay_graph_id)
    print(" overlay_owner="); print_int(result.graph.overlay_owner_id)
    print(" nodes="); print_int(result.graph.node_count)
    print(" edges="); print_int(result.graph.edge_count)
    print(" nonassociative_barriers=")
    print_int(result.nonassociative_barrier_count)
    print(" output_matches_parent=")
    print_int(yes(result.output_matches_parent))
    print("\n")

    let parent = &result.graph_parent
    print("PIREUS_XOR_PARENT field=identity_module value=")
    print_hash(&parent.identity_module_sha256)
    print("\nPIREUS_XOR_PARENT field=semantics value=")
    print_hash(&parent.semantics_sha256)
    print("\nPIREUS_XOR_PARENT field=authority_stream value=")
    print_hash(&parent.authority_stream_sha256)
    print("\nPIREUS_XOR_PARENT field=registry value=")
    print_hash(&parent.registry_digest)
    print("\nPIREUS_XOR_PARENT field=dependency value=")
    print_hash(&parent.dependency_digest)
    print("\nPIREUS_XOR_PARENT field=lifted_graph value=")
    print_hash(&parent.lifted_graph_digest)
    print("\nPIREUS_XOR_PARENT field=occurrence value=")
    print_hash(&parent.occurrence_digest)
    print("\nPIREUS_XOR_PARENT field=collision value=")
    print_hash(&parent.collision_digest)
    print("\nPIREUS_XOR_PARENT field=provenance value=")
    print_hash(&parent.provenance_digest)
    print("\n")

    var i: i64 = 0
    while i < result.graph.node_count {
        print("PIREUS_XOR_NODE index="); print_int(i)
        print(" kind="); print_int(result.graph.node_kinds[i])
        print(" capability=")
        print_int(result.graph.node_capabilities[i])
        print(" fixed_order=")
        print_int(yes(result.graph.node_fixed_order[i]))
        print(" nonassociative_barrier=")
        print_int(yes(result.graph.node_nonassociative_barrier[i]))
        print("\n")
        i = i + 1
    }

    i = 0
    while i < result.graph.edge_count {
        print("PIREUS_XOR_EDGE index="); print_int(i)
        print(" source="); print_int(result.graph.edge_sources[i])
        print(" target="); print_int(result.graph.edge_targets[i])
        print("\n")
        i = i + 1
    }

    print("PIREUS_XOR_CLASSIFICATION zero_free=")
    print_int(yes(result.zero_free))
    print(" normalized="); print_int(yes(result.normalized))
    print(" displacement_only="); print_int(yes(result.displacement_only))
    print(" rank_one_separable=")
    print_int(yes(result.rank_one_separable))
    print(" left_square="); print_int(yes(result.left_square))
    print(" group_two_cocycle=")
    print_int(yes(result.group_two_cocycle))
    print(" associator_defects=")
    print_int(result.associator_defect_count)
    print(" wht_rewrite_authorized=")
    print_int(yes(result.wht_rewrite_authorized))
    print("\n")

    var d: i64 = 0
    while d < result.dimension {
        print("PIREUS_XOR_RESULT lane="); print_int(d)
        print(" bits="); print_int(result.output_bits[d])
        print("\n")
        d = d + 1
    }

    i = 0
    while i < result.targets.count {
        print("PIREUS_XOR_TARGET index="); print_int(i)
        print(" target="); print_int(result.targets.target_ids[i])
        print(" canonical="); print_int(yes(result.targets.canonical[i]))
        print(" observed="); print_int(yes(result.targets.observed[i]))
        print(" evidence_role=")
        print_int(result.targets.evidence_roles[i])
        print("\n")
        i = i + 1
    }

    print("PIREUS_XOR_MATERIAL observations=")
    print_int(result.material_observation_count)
    print(" lowerings="); print_int(result.lowering_count)
    print(" cost_records="); print_int(result.cost_record_count)
    print(" receipts="); print_int(result.targets.material_receipt_count)
    print("\n")

    let neg = &result.negatives
    print_negative("absent_xor_parent", neg.absent_xor_parent)
    print_negative("absent_graph_parent", neg.absent_graph_parent)
    print_negative("mismatched_xor_parent", neg.mismatched_xor_parent)
    print_negative("mismatched_graph_parent", neg.mismatched_graph_parent)
    print_negative("invalid_bits", neg.invalid_bits)
    print_negative("topology_corruption", neg.topology_corruption)
    print_negative("missing_capability", neg.missing_capability)
    print_negative("accumulation_order_change", neg.accumulation_order_change)
    print_negative("displacement_promotion", neg.displacement_promotion)
    print_negative("separability_promotion", neg.separability_promotion)
    print_negative("cocycle_promotion", neg.cocycle_promotion)
    print_negative("associativity_promotion", neg.associativity_promotion)
    print_negative("wht_promotion", neg.wht_promotion)
    print_negative("missing_darwin_xeon", neg.missing_darwin_xeon)
    print_negative("missing_apple_silicon", neg.missing_apple_silicon)
    print_negative("missing_dgx", neg.missing_dgx)
    print_negative(
        "target_observation_without_receipt",
        neg.target_observation_without_receipt,
    )
    print_negative(
        "material_claim_without_receipt",
        neg.material_claim_without_receipt,
    )
    print_negative("parity_before_freeze", neg.parity_before_freeze)
    print_negative("claim_before_parity", neg.claim_before_parity)
    print("PIREUS_XOR_NEGATIVES passed="); print_int(neg.passed)
    print(" total="); print_int(neg.total); print("\n")

    print("PIREUS_XOR_DIGEST parent="); print_digest(&result.parent_digest)
    print("\nPIREUS_XOR_DIGEST graph="); print_digest(&result.graph_digest)
    print("\nPIREUS_XOR_DIGEST capability=")
    print_digest(&result.capability_digest)
    print("\nPIREUS_XOR_DIGEST target="); print_digest(&result.target_digest)
    print("\nPIREUS_XOR_DIGEST result="); print_digest(&result.result_digest)
    print("\nPIREUS_XOR_DIGEST witness=")
    print_digest(&result.witness_digest)
    print("\n")

    print("PIREUS_XOR_AUTHORITY language=Sounio role=SEMANTIC_AUTHORITY")
    print(" stage=SOUNIO_EXECUTABLE parity_open=")
    print_int(yes(result.parity_open))
    print(" claim_ready="); print_int(yes(result.claim_ready))
    print(" failures="); print_int(result.failures)
    print("\n")
    result.failures as i32
}
