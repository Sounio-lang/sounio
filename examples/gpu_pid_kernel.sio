// Minimal GPU kernel exercising thread-index intrinsics.
// Computes a global thread id: pid = blockIdx.x * blockDim.x + threadIdx.x
kernel fn pid_kernel(out: &mut [u32], n: u32) {
    let pid: u32 = gpu_block_id_x() * gpu_block_dim_x() + gpu_thread_id_x()
    if pid < n {
        out[pid as usize] = pid
    }
}
