//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// S-SSM Free A: BPTT on all 16 components of A — does A stay on G₂?
// ═══════════════════════════════════════════════════════════════════════════
//
// sedenion_ssm_bptt.sio trained one scalar α along the G₂ curve
//   A(α) = normalize(lerp(a_generic, zd_n, α)).
// This file lets A move freely in ℝ¹⁶. Two questions:
//
//   (a) Does the unconstrained model beat the α-constrained one?  If yes,
//       the manifold is too tight.  If no, the manifold is optimal — i.e.,
//       the G₂ curve really is where the minimum lives.
//
//   (b) Does gradient flow pull A back to the G₂ curve even without being
//       told to?  Residual G₂ distance = min over α of ‖A_learned − A(α)‖.
//
// Two inits:
//   (1) A_init = A(0.2)   — on manifold, matches BPTT-α optimum
//   (2) A_init = far from manifold (random unit sedenion)
//
// Backward is unchanged from sedenion_ssm_bptt.sio (already gives grad_A
// accumulated through 64 steps). Update rule: A ← A − lr_a · grad_A.

use math::sedenion::*;

// ─── Math helpers ─────────────────────────────────────────────────────────────

fn sqrt_s(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y: f64 = x
    var i: i64 = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn abs_s(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn exp_s(x: f64) -> f64 with Mut, Div, Panic {
    if x > 20.0 { return exp_s(10.0) * exp_s(x - 10.0) }
    if x < 0.0 - 20.0 { return 0.0 }
    var s: f64 = 1.0
    var term: f64 = 1.0
    var i: i64 = 1
    while i <= 20 {
        term = term * x / (i as f64)
        s = s + term
        i = i + 1
    }
    s
}

fn tanh_s(x: f64) -> f64 with Mut, Div, Panic {
    if x > 10.0 { return 1.0 }
    if x < 0.0 - 10.0 { return 0.0 - 1.0 }
    let e2: f64 = exp_s(2.0 * x)
    (e2 - 1.0) / (e2 + 1.0)
}

fn sin_s(x: f64) -> f64 with Mut, Div, Panic {
    let pi2: f64 = 6.28318530718
    var xr: f64 = x
    while xr > 3.14159265359 { xr = xr - pi2 }
    while xr < 0.0 - 3.14159265359 { xr = xr + pi2 }
    let x2: f64 = xr * xr
    let x3: f64 = x2 * xr
    let x5: f64 = x3 * x2
    let x7: f64 = x5 * x2
    let x9: f64 = x7 * x2
    xr - x3 / 6.0 + x5 / 120.0 - x7 / 5040.0 + x9 / 362880.0
}

// ─── RNG ──────────────────────────────────────────────────────────────────────

var RNG_A: i64 = 0
var RNG_B: i64 = 0

fn rng_seed(a: i64, b: i64) with Mut { RNG_A = a; RNG_B = b }

fn rng_next() -> i64 with Mut {
    var x: i64 = RNG_A
    let y: i64 = RNG_B
    RNG_A = y
    x = x ^ (x << 23)
    x = x ^ (x >> 17)
    x = x ^ (y ^ (y >> 26))
    RNG_B = x
    let r: i64 = x + y
    if r < 0 { 0 - r } else { r }
}

fn rand_pm() -> f64 with Mut, Div {
    ((rng_next() % 2000) as f64 - 1000.0) / 1000.0
}

// ─── Target / input ───────────────────────────────────────────────────────────

var TARGET: [f64; 80] = [0.0; 80]
var INPUT:  [f64; 80] = [0.0; 80]

fn init_task() with Mut, Div, Panic {
    var t: i64 = 0
    while t < 80 {
        let v: f64 = sin_s((t as f64) * 6.28318530718 / 20.0)
        TARGET[t] = v
        INPUT[t]  = v * 0.5
        t = t + 1
    }
}

// ─── Fixed-point storage for A and C (×1e8) ──────────────────────────────────

var WA: [i64; 16] = [0; 16]
var WC: [i64; 16] = [0; 16]

fn ag_f(i: i64) -> f64 with Div { (WA[i] as f64) / 100000000.0 }
fn as_f(i: i64, v: f64) with Mut { WA[i] = (v * 100000000.0) as i64 }
fn cg(i: i64) -> f64 with Div { (WC[i] as f64) / 100000000.0 }
fn cs(i: i64, v: f64) with Mut { WC[i] = (v * 100000000.0) as i64 }

fn get_a() -> Sedenion with Div {
    Sedenion {
        e0:  ag_f(0),  e1:  ag_f(1),  e2:  ag_f(2),  e3:  ag_f(3),
        e4:  ag_f(4),  e5:  ag_f(5),  e6:  ag_f(6),  e7:  ag_f(7),
        e8:  ag_f(8),  e9:  ag_f(9),  e10: ag_f(10), e11: ag_f(11),
        e12: ag_f(12), e13: ag_f(13), e14: ag_f(14), e15: ag_f(15)
    }
}

fn set_a(s: Sedenion) with Mut {
    as_f(0,  s.e0);  as_f(1,  s.e1);  as_f(2,  s.e2);  as_f(3,  s.e3)
    as_f(4,  s.e4);  as_f(5,  s.e5);  as_f(6,  s.e6);  as_f(7,  s.e7)
    as_f(8,  s.e8);  as_f(9,  s.e9);  as_f(10, s.e10); as_f(11, s.e11)
    as_f(12, s.e12); as_f(13, s.e13); as_f(14, s.e14); as_f(15, s.e15)
}

fn get_c() -> Sedenion with Div {
    Sedenion {
        e0:  cg(0),  e1:  cg(1),  e2:  cg(2),  e3:  cg(3),
        e4:  cg(4),  e5:  cg(5),  e6:  cg(6),  e7:  cg(7),
        e8:  cg(8),  e9:  cg(9),  e10: cg(10), e11: cg(11),
        e12: cg(12), e13: cg(13), e14: cg(14), e15: cg(15)
    }
}

fn init_c() with Mut { var i: i64 = 0; while i < 16 { WC[i] = 0; i = i + 1 } }

// ─── Hidden state trajectory + activation norm ────────────────────────────────

var H0:  [f64; 64] = [0.0; 64]
var H1:  [f64; 64] = [0.0; 64]
var H2:  [f64; 64] = [0.0; 64]
var H3:  [f64; 64] = [0.0; 64]
var H4:  [f64; 64] = [0.0; 64]
var H5:  [f64; 64] = [0.0; 64]
var H6:  [f64; 64] = [0.0; 64]
var H7:  [f64; 64] = [0.0; 64]
var H8:  [f64; 64] = [0.0; 64]
var H9:  [f64; 64] = [0.0; 64]
var H10: [f64; 64] = [0.0; 64]
var H11: [f64; 64] = [0.0; 64]
var H12: [f64; 64] = [0.0; 64]
var H13: [f64; 64] = [0.0; 64]
var H14: [f64; 64] = [0.0; 64]
var H15: [f64; 64] = [0.0; 64]

var ACT_NORM: [f64; 64] = [0.0; 64]

fn save_h(t: i64, h: Sedenion, an: f64) with Mut {
    H0[t]  = h.e0;  H1[t]  = h.e1;  H2[t]  = h.e2;  H3[t]  = h.e3
    H4[t]  = h.e4;  H5[t]  = h.e5;  H6[t]  = h.e6;  H7[t]  = h.e7
    H8[t]  = h.e8;  H9[t]  = h.e9;  H10[t] = h.e10; H11[t] = h.e11
    H12[t] = h.e12; H13[t] = h.e13; H14[t] = h.e14; H15[t] = h.e15
    ACT_NORM[t] = an
}

fn load_h(t: i64) -> Sedenion {
    Sedenion {
        e0:  H0[t],  e1:  H1[t],  e2:  H2[t],  e3:  H3[t],
        e4:  H4[t],  e5:  H5[t],  e6:  H6[t],  e7:  H7[t],
        e8:  H8[t],  e9:  H9[t],  e10: H10[t], e11: H11[t],
        e12: H12[t], e13: H13[t], e14: H14[t], e15: H15[t]
    }
}

fn load_act(t: i64) -> Sedenion with Div { sed_scale(load_h(t), ACT_NORM[t]) }

// ─── Forward ──────────────────────────────────────────────────────────────────

fn ssm_forward(a: Sedenion, b: Sedenion) with Mut, Div, Panic {
    var h: Sedenion = sed_one()
    var t: i64 = 0
    while t < 64 {
        let x: f64 = INPUT[t]
        let ah: Sedenion = sed_mul(a, h)
        let bx: Sedenion = sed_scale(b, x)
        let raw: Sedenion = sed_add(ah, bx)
        let act: Sedenion = sed_tanh(raw)
        let n: f64 = sed_norm(act)
        var nn: f64 = n
        if n < 0.0000001 { nn = 0.0000001 }
        let hn: Sedenion = sed_scale(act, 1.0 / nn)
        h = hn
        save_h(t, h, nn)
        t = t + 1
    }
}

fn train_mse() -> f64 with Div, Panic {
    let c: Sedenion = get_c()
    var sum: f64 = 0.0
    var t: i64 = 0
    while t < 64 {
        let h: Sedenion = load_h(t)
        let y: f64 = sed_dot(h, c)
        let err: f64 = y - TARGET[t]
        sum = sum + err * err
        t = t + 1
    }
    sum / 64.0
}

// ─── Backward (unchanged from bptt.sio) ───────────────────────────────────────

var GC: [f64; 16] = [0.0; 16]

fn dnormalize(g: Sedenion, h_unit: Sedenion, act_norm: f64) -> Sedenion with Div, Panic {
    let dp: f64 = sed_dot(h_unit, g)
    let proj: Sedenion = sed_scale(h_unit, dp)
    let diff: Sedenion = sed_add(g, sed_scale(proj, 0.0 - 1.0))
    var nn: f64 = act_norm
    if nn < 0.0000001 { nn = 0.0000001 }
    sed_scale(diff, 1.0 / nn)
}

fn tanh_backward(g: Sedenion, act: Sedenion) -> Sedenion {
    Sedenion {
        e0:  g.e0  * (1.0 - act.e0  * act.e0),
        e1:  g.e1  * (1.0 - act.e1  * act.e1),
        e2:  g.e2  * (1.0 - act.e2  * act.e2),
        e3:  g.e3  * (1.0 - act.e3  * act.e3),
        e4:  g.e4  * (1.0 - act.e4  * act.e4),
        e5:  g.e5  * (1.0 - act.e5  * act.e5),
        e6:  g.e6  * (1.0 - act.e6  * act.e6),
        e7:  g.e7  * (1.0 - act.e7  * act.e7),
        e8:  g.e8  * (1.0 - act.e8  * act.e8),
        e9:  g.e9  * (1.0 - act.e9  * act.e9),
        e10: g.e10 * (1.0 - act.e10 * act.e10),
        e11: g.e11 * (1.0 - act.e11 * act.e11),
        e12: g.e12 * (1.0 - act.e12 * act.e12),
        e13: g.e13 * (1.0 - act.e13 * act.e13),
        e14: g.e14 * (1.0 - act.e14 * act.e14),
        e15: g.e15 * (1.0 - act.e15 * act.e15)
    }
}

fn backward(a: Sedenion) -> Sedenion with Mut, Div, Panic {
    let c: Sedenion = get_c()
    var i: i64 = 0
    while i < 16 { GC[i] = 0.0; i = i + 1 }
    var grad_a: Sedenion = Sedenion {
        e0:0.0, e1:0.0, e2:0.0, e3:0.0, e4:0.0, e5:0.0, e6:0.0, e7:0.0,
        e8:0.0, e9:0.0, e10:0.0, e11:0.0, e12:0.0, e13:0.0, e14:0.0, e15:0.0
    }
    var grad_h_upstream: Sedenion = Sedenion {
        e0:0.0, e1:0.0, e2:0.0, e3:0.0, e4:0.0, e5:0.0, e6:0.0, e7:0.0,
        e8:0.0, e9:0.0, e10:0.0, e11:0.0, e12:0.0, e13:0.0, e14:0.0, e15:0.0
    }
    let a_conj: Sedenion = sed_conj(a)
    var t: i64 = 63
    while t >= 0 {
        let h_t: Sedenion = load_h(t)
        let y_t: f64 = sed_dot(h_t, c)
        let err: f64 = (y_t - TARGET[t]) * 2.0 / 64.0
        GC[0]  = GC[0]  + err * h_t.e0
        GC[1]  = GC[1]  + err * h_t.e1
        GC[2]  = GC[2]  + err * h_t.e2
        GC[3]  = GC[3]  + err * h_t.e3
        GC[4]  = GC[4]  + err * h_t.e4
        GC[5]  = GC[5]  + err * h_t.e5
        GC[6]  = GC[6]  + err * h_t.e6
        GC[7]  = GC[7]  + err * h_t.e7
        GC[8]  = GC[8]  + err * h_t.e8
        GC[9]  = GC[9]  + err * h_t.e9
        GC[10] = GC[10] + err * h_t.e10
        GC[11] = GC[11] + err * h_t.e11
        GC[12] = GC[12] + err * h_t.e12
        GC[13] = GC[13] + err * h_t.e13
        GC[14] = GC[14] + err * h_t.e14
        GC[15] = GC[15] + err * h_t.e15
        let from_output: Sedenion = sed_scale(c, err)
        let grad_h_t: Sedenion = sed_add(from_output, grad_h_upstream)
        let act_t: Sedenion = load_act(t)
        let grad_act: Sedenion = dnormalize(grad_h_t, h_t, ACT_NORM[t])
        let grad_raw: Sedenion = tanh_backward(grad_act, act_t)
        var h_prev: Sedenion = sed_one()
        if t > 0 { h_prev = load_h(t - 1) }
        let grad_a_step: Sedenion = sed_mul(grad_raw, sed_conj(h_prev))
        grad_a = sed_add(grad_a, grad_a_step)
        grad_h_upstream = sed_mul(a_conj, grad_raw)
        t = t - 1
    }
    grad_a
}

// ─── Update helpers ───────────────────────────────────────────────────────────

fn update_c(lr: f64) with Mut, Div {
    var i: i64 = 0
    while i < 16 { cs(i, cg(i) - lr * GC[i]); i = i + 1 }
}

fn update_a(grad_a: Sedenion, lr: f64) with Mut, Div {
    as_f(0,  ag_f(0)  - lr * grad_a.e0)
    as_f(1,  ag_f(1)  - lr * grad_a.e1)
    as_f(2,  ag_f(2)  - lr * grad_a.e2)
    as_f(3,  ag_f(3)  - lr * grad_a.e3)
    as_f(4,  ag_f(4)  - lr * grad_a.e4)
    as_f(5,  ag_f(5)  - lr * grad_a.e5)
    as_f(6,  ag_f(6)  - lr * grad_a.e6)
    as_f(7,  ag_f(7)  - lr * grad_a.e7)
    as_f(8,  ag_f(8)  - lr * grad_a.e8)
    as_f(9,  ag_f(9)  - lr * grad_a.e9)
    as_f(10, ag_f(10) - lr * grad_a.e10)
    as_f(11, ag_f(11) - lr * grad_a.e11)
    as_f(12, ag_f(12) - lr * grad_a.e12)
    as_f(13, ag_f(13) - lr * grad_a.e13)
    as_f(14, ag_f(14) - lr * grad_a.e14)
    as_f(15, ag_f(15) - lr * grad_a.e15)
}

// ─── G₂ residual scan: find nearest A(α) on the interpolation curve ───────────

var RES_BEST_DIST:  f64 = 0.0
var RES_BEST_ALPHA: f64 = 0.0

fn make_a_alpha(a_generic: Sedenion, zd_n: Sedenion, alpha: f64) -> Sedenion with Div, Panic {
    sed_normalize(sed_lerp(a_generic, zd_n, alpha))
}

fn g2_residual(a_cur: Sedenion, a_generic: Sedenion, zd_n: Sedenion) with Mut, Div, Panic {
    // Scan α from -0.2 to 1.2 at step 0.02 (71 points)
    var best_d: f64 = 999.0
    var best_a: f64 = 0.0
    var i: i64 = 0
    while i <= 70 {
        let alpha: f64 = 0.0 - 0.2 + (i as f64) * 0.02
        let a_g2: Sedenion = make_a_alpha(a_generic, zd_n, alpha)
        let diff: Sedenion = sed_add(a_cur, sed_scale(a_g2, 0.0 - 1.0))
        let d: f64 = sed_norm(diff)
        if d < best_d { best_d = d; best_a = alpha }
        i = i + 1
    }
    RES_BEST_DIST  = best_d
    RES_BEST_ALPHA = best_a
}

// ─── Random-unit initializer ──────────────────────────────────────────────────

fn random_unit_sedenion() -> Sedenion with Mut, Div, Panic {
    let s: Sedenion = Sedenion {
        e0: rand_pm(), e1: rand_pm(), e2: rand_pm(), e3: rand_pm(),
        e4: rand_pm(), e5: rand_pm(), e6: rand_pm(), e7: rand_pm(),
        e8: rand_pm(), e9: rand_pm(), e10: rand_pm(), e11: rand_pm(),
        e12: rand_pm(), e13: rand_pm(), e14: rand_pm(), e15: rand_pm()
    }
    sed_normalize(s)
}

// ─── Training driver ──────────────────────────────────────────────────────────

var FINAL_MSE: f64 = 0.0
var FINAL_A_NORM: f64 = 0.0
var FINAL_GRAD_A_NORM: f64 = 0.0

fn train_free_a(b: Sedenion, epochs: i64, lr_a: f64, lr_c: f64) with Mut, Div, Panic {
    init_c()
    var ep: i64 = 0
    var last_grad: Sedenion = Sedenion {
        e0:0.0, e1:0.0, e2:0.0, e3:0.0, e4:0.0, e5:0.0, e6:0.0, e7:0.0,
        e8:0.0, e9:0.0, e10:0.0, e11:0.0, e12:0.0, e13:0.0, e14:0.0, e15:0.0
    }
    while ep < epochs {
        let a_cur: Sedenion = get_a()
        ssm_forward(a_cur, b)
        let grad_a: Sedenion = backward(a_cur)
        last_grad = grad_a
        update_a(grad_a, lr_a)
        update_c(lr_c)
        ep = ep + 1
    }
    let a_final: Sedenion = get_a()
    ssm_forward(a_final, b)
    FINAL_MSE = train_mse()
    FINAL_A_NORM = sed_norm(a_final)
    FINAL_GRAD_A_NORM = sed_norm(last_grad)
}

// ─── Main ─────────────────────────────────────────────────────────────────────

fn main() -> i32 with IO, Mut, Div, Panic {
    rng_seed(31415926, 27182818)
    init_task()

    let zd: Sedenion = sed_known_zero_divisor()
    let zd_n: Sedenion = sed_normalize(zd)
    let ag_raw: Sedenion = sed_add(sed_basis(0, 1.0), sed_basis(1, 1.0))
    let a_generic: Sedenion = sed_normalize(ag_raw)
    let b: Sedenion = sed_one()

    println("═══════════════════════════════════════════════════════")
    println("  S-SSM FREE A: BPTT on all 16 components of A")
    println("  Init 1: A = make_a(0.2) (on G2 curve)")
    println("  Init 2: A = random unit sedenion (off G2 curve)")
    println("  lr_a=0.001  lr_c=1.0  epochs=200")
    println("═══════════════════════════════════════════════════════")
    println("")

    // ── Run 1: init at G₂-curve optimum ──────────────────────────────────────
    println("=== Run 1: init A = make_a(0.2) ===")
    let a_init_1: Sedenion = make_a_alpha(a_generic, zd_n, 0.2)
    set_a(a_init_1)
    g2_residual(get_a(), a_generic, zd_n)
    let init1_start_dist: f64 = RES_BEST_DIST
    print("  start G2 residual = "); print(init1_start_dist); println("")
    train_free_a(b, 200, 0.001, 1.0)
    let mse_1: f64 = FINAL_MSE
    let norm_1: f64 = FINAL_A_NORM
    let grad_end_1: f64 = FINAL_GRAD_A_NORM
    g2_residual(get_a(), a_generic, zd_n)
    let res_1: f64 = RES_BEST_DIST
    let alpha_1: f64 = RES_BEST_ALPHA
    print("  final MSE="); print(mse_1)
    print("  ||A||=");     print(norm_1); println("")
    print("  G2 residual="); print(res_1)
    print("  nearest α=");   print(alpha_1); println("")
    print("  |grad_A|_end="); print(grad_end_1); println("")
    println("")

    // ── Run 2: init at random unit sedenion ──────────────────────────────────
    println("=== Run 2: init A = random unit sedenion ===")
    rng_seed(987654321, 123456789)  // different seed for reproducibility
    let a_init_2: Sedenion = random_unit_sedenion()
    set_a(a_init_2)
    g2_residual(get_a(), a_generic, zd_n)
    let init2_start_dist: f64 = RES_BEST_DIST
    let init2_start_alpha: f64 = RES_BEST_ALPHA
    print("  start G2 residual = "); print(init2_start_dist)
    print(" (at α=");                 print(init2_start_alpha); println(")")
    train_free_a(b, 200, 0.001, 1.0)
    let mse_2: f64 = FINAL_MSE
    let norm_2: f64 = FINAL_A_NORM
    let grad_end_2: f64 = FINAL_GRAD_A_NORM
    g2_residual(get_a(), a_generic, zd_n)
    let res_2: f64 = RES_BEST_DIST
    let alpha_2: f64 = RES_BEST_ALPHA
    print("  final MSE="); print(mse_2)
    print("  ||A||=");     print(norm_2); println("")
    print("  G2 residual="); print(res_2)
    print("  nearest α=");   print(alpha_2); println("")
    print("  |grad_A|_end="); print(grad_end_2); println("")
    println("")

    // ── Comparison ───────────────────────────────────────────────────────────
    println("───────────────────────────────────────────────────────")
    println("  Reference: BPTT on scalar α from init=0.1 → MSE=0.154")
    print("  Run 1 (on-manifold init) : MSE=");  print(mse_1)
    print("  residual=");                         print(res_1); println("")
    print("  Run 2 (random-init)      : MSE=");  print(mse_2)
    print("  residual=");                         print(res_2); println("")

    let run2_moved: f64 = init2_start_dist - res_2
    print("  Run 2 moved toward manifold by Δd="); print(run2_moved); println("")
    if res_2 < init2_start_dist {
        println("  INTERPRETATION: random A is PULLED toward G2 curve by gradient flow.")
    } else {
        println("  INTERPRETATION: random A did NOT move closer to G2 curve.")
    }
    println("───────────────────────────────────────────────────────")
    println("")

    // ── Assertions ───────────────────────────────────────────────────────────
    var passed: i32 = 0
    var failed: i32 = 0

    // T1: Run 1 (on-manifold init) achieves low MSE
    if mse_1 < 0.20 {
        print("T1 PASS: on-manifold init MSE="); print(mse_1); println(" < 0.20")
        passed = passed + 1
    } else {
        print("T1 FAIL: on-manifold init MSE="); print(mse_1); println("")
        failed = failed + 1
    }

    // T2: Run 1 stays near the G₂ curve (residual remains small)
    if res_1 < 0.3 {
        print("T2 PASS: on-manifold Run 1 G2 residual="); print(res_1)
        println(" < 0.3 (stayed near curve)")
        passed = passed + 1
    } else {
        print("T2 FAIL: Run 1 drifted, residual="); print(res_1); println("")
        failed = failed + 1
    }

    // T3: Run 2 (random init) finishes with finite MSE (not diverged)
    if mse_2 < 2.0 {
        if mse_2 >= 0.0 {
            print("T3 PASS: random-init MSE="); print(mse_2); println(" finite")
            passed = passed + 1
        } else {
            print("T3 FAIL: MSE negative="); print(mse_2); println("")
            failed = failed + 1
        }
    } else {
        print("T3 FAIL: random-init MSE diverged="); print(mse_2); println("")
        failed = failed + 1
    }

    // T4: Run 2 random init moves toward manifold during training (attractor
    //     test). Strict: residual decreases from start to finish.
    if res_2 < init2_start_dist {
        print("T4 PASS: random A pulled toward G2, Δd=")
        print(run2_moved); println("")
        passed = passed + 1
    } else {
        print("T4 FAIL: random A residual grew, start=")
        print(init2_start_dist); print(" end="); print(res_2); println("")
        failed = failed + 1
    }

    // T5: both final A norms are near 1 (tanh+normalize forward contract
    //     keeps hidden state on the sphere; A itself is unconstrained but
    //     should drift only modestly).
    let norm_dev_1: f64 = abs_s(norm_1 - 1.0)
    let norm_dev_2: f64 = abs_s(norm_2 - 1.0)
    if norm_dev_1 < 0.5 {
        if norm_dev_2 < 0.5 {
            print("T5 PASS: both ||A|| in [0.5, 1.5]. ||A_1||="); print(norm_1)
            print(" ||A_2||="); print(norm_2); println("")
            passed = passed + 1
        } else {
            println("T5 FAIL: Run 2 ||A|| drifted far from 1")
            failed = failed + 1
        }
    } else {
        println("T5 FAIL: Run 1 ||A|| drifted far from 1")
        failed = failed + 1
    }

    // T6: both final gradients small (both runs reached critical points)
    var small_grad: bool = true
    if grad_end_1 >= 2.0 { small_grad = false }
    if grad_end_2 >= 2.0 { small_grad = false }
    if small_grad {
        print("T6 PASS: both |grad_A|_end < 2. ")
        print("|g1|="); print(grad_end_1)
        print(" |g2|="); print(grad_end_2); println("")
        passed = passed + 1
    } else {
        println("T6 FAIL: some |grad_A|_end >= 2")
        failed = failed + 1
    }

    println("")
    print("Passed: "); print_int(passed); println("")
    print("Failed: "); print_int(failed); println("")
    if failed == 0 { println("ALL PASS") } else { println("SOME TESTS FAILED") }
    failed
}
