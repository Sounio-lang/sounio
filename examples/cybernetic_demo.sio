//! examples/cybernetic_demo.sio
//!
//! End-to-end demonstration of second-order cybernetics in Sounio.
//!
//! Demonstrates all nine modules:
//! 1. Distinction — Spencer-Brown calculus
//! 2. Eigenform — fixed points of observation
//! 3. Observer — observer-inclusion with blind spots
//! 4. Autopoiesis — self-producing systems
//! 5. Coupling — structural co-evolution
//! 6. Conversation — Pask's conversational eigenforms
//! 7. Variety — Ashby's Law of Requisite Variety
//! 8. Bateson — Learning Levels (L0-L3)
//! 9. Languaging — Maturana's action coordination

use cybernetic::distinction::{
    UNMARKED, MARKED, AUTONOMOUS,
    form_void, form_marked, form_reenter,
    form_mark, form_cross, eval_form, forms_equal,
    solve_reentry
}
use cybernetic::eigenform::{
    find_eigenform, is_eigenform, compute_eigenbehavior, meta_eigenform
}
use cybernetic::observer::{
    Observer, Observation, observer_new,
    make_observation, observe_observer,
    blind_spot, observer_agreement
}
use cybernetic::autopoiesis::{
    system_new, add_component, produce_cycle, perturb,
    is_alive, generation, structural_drift
}
use cybernetic::coupling::{
    coupling_new, couple_step, congruence, prediction_error
}
use cybernetic::conversation::{
    conversation_new, set_models, converse, agreement, has_converged,
    shared_understanding
}
use cybernetic::variety::{
    variety_new, record_env_state, compute_variety, has_requisite_variety
}
use cybernetic::bateson::{
    bateson_new, level_one_update, level_two_switch, detect_double_bind
}
use cybernetic::languaging::{
    languaging_new, languaging_step, has_consensual_domain, domain_size
}

// ============================================================================
// DEMO 1: Laws of Form — Drawing Distinctions
// ============================================================================

fn demo_distinction() with IO, Mut, Div {
    println("=== DEMO 1: Laws of Form (Spencer-Brown 1969) ===")
    println("")

    // The void: no distinction drawn
    let void = form_void()
    println("void = UNMARKED")
    assert(eval_form(void) == UNMARKED)

    // Draw a distinction: the most primitive act of cognition
    let mark = form_marked()
    println("mark = MARKED")
    assert(eval_form(mark) == MARKED)

    // Axiom 1 — Calling: marking what is already marked = same mark
    let double_mark = form_mark(mark)
    println("mark(mark) = MARKED  [Calling: idempotent]")
    assert(forms_equal(mark, double_mark))

    // Axiom 2 — Crossing: entering and leaving a distinction cancels
    let crossed = form_cross(mark)
    println("cross(mark) = UNMARKED  [Crossing: toggle]")
    assert(eval_form(crossed) == UNMARKED)

    let double_cross = form_cross(crossed)
    println("cross(cross(mark)) = MARKED  [Double crossing]")
    assert(eval_form(double_cross) == MARKED)

    // Varela's extension: self-indicating form J = cross(J)
    let j = form_reenter()
    println("J (re-entry) = AUTONOMOUS  [Varela 1975: third value]")
    assert(eval_form(j) == AUTONOMOUS)

    // Self-reference solved by iteration → oscillation → autonomy
    let solved = solve_reentry(MARKED, 100)
    println("solve f=cross(f): oscillation detected → AUTONOMOUS")
    assert(solved == AUTONOMOUS)

    println("")
    println("Laws of Form: PASS")
    println("")
}

// ============================================================================
// DEMO 2: Eigenform — Objects as Tokens for Eigenbehaviors
// ============================================================================

fn averaging_observer(x: f64) -> f64 {
    (x + 20.0) / 2.0
}

fn demo_eigenform() with IO, Mut, Div, Panic {
    println("=== DEMO 2: Eigenform (von Foerster 1976, Kauffman 2003) ===")
    println("")

    // Find eigenform of averaging observer
    // Fixed point: x* = (x* + 20) / 2 → x* = 20
    let result = find_eigenform(averaging_observer, 0.0, 0.001, 100)
    println("Averaging observer: eigenform converged")
    assert(result.converged)
    assert(abs_f64_demo(result.value - 20.0) < 0.01)

    // Verify it IS an eigenform
    let check = is_eigenform(averaging_observer, result.value, 0.01)
    println("  is_eigenform(20.0) = true")
    assert(check)

    // Full eigenbehavior with stability analysis
    let eb = compute_eigenbehavior(averaging_observer, 0.0, 0.001, 100, 1)
    println("  convergence_rate < 1 (contractive)")
    assert(eb.convergence_rate < 1.0)
    println("  stability_radius > 0 (robust)")
    assert(eb.stability_radius > 0.0)

    // Meta-eigenform: eigenform of the eigenform-finding process
    let meta = meta_eigenform(averaging_observer, 0.0, 0.001, 100)
    println("  meta-eigenform converged (second-order stable)")
    assert(meta.converged)

    println("")
    println("Eigenform theory: PASS")
    println("")
}

// ============================================================================
// DEMO 3: Observer-Inclusion — No View from Nowhere
// ============================================================================

fn demo_observer() with IO, Mut, Div, Panic {
    println("=== DEMO 3: Observer-Inclusion (von Foerster, Luhmann) ===")
    println("")

    // Create an observer with moderate drift
    var obs = observer_new(1, 0.01)
    println("Observer created: drift_rate = 0.01")

    // Observe a system value — returns Observation struct
    let r1 = make_observation(obs, 98.6, 0.5)
    println("Observation 1: value = 98.6, total_var > measurement_var")
    assert(r1.variance >= 0.5)

    // Observe again — drift accumulates
    let r2 = make_observation(r1.observer, 98.6, 0.5)
    println("Observation 2: drift accumulated, variance increased")
    assert(r2.variance > r1.variance)

    // Observer's blind spot grows
    let bs1 = blind_spot(r1.observer)
    let bs2 = blind_spot(r2.observer)
    println("Blind spot grew: observation changes the observer")
    assert(bs2 > bs1)

    // Meta-observation: a second observer watches the first
    let meta_obs = observer_new(2, 0.001)
    let r3 = observe_observer(meta_obs, r2.observer)
    println("Meta-observation: uncertainty about uncertainty")
    assert(r3.variance > r2.observer.state_variance)

    // Agreement between two observers
    let agr = observer_agreement(r2.observer, r3.observer)
    println("Observer agreement computed")

    println("")
    println("Observer-inclusion: PASS")
    println("")
}

// ============================================================================
// DEMO 4: Autopoiesis — Self-Producing System
// ============================================================================

fn demo_autopoiesis() with IO, Mut, Div, Panic {
    println("=== DEMO 4: Autopoiesis (Maturana/Varela 1972) ===")
    println("")

    // Create system with 50% boundary permeability
    var sys = system_new(0.5)

    // Build a circular production network:
    // Component 0 produces Component 1
    // Component 1 produces Component 2
    // Component 2 produces Component 0 (circular closure!)
    sys = add_component(sys, -1, 1, 10.0, 0.1)
    sys = add_component(sys, 0, 2, 5.0, 0.2)
    sys = add_component(sys, 1, 0, 8.0, 0.15)
    println("Circular production network: 0->1->2->0")

    // Run production cycles
    var i = 0
    while i < 10 {
        sys = produce_cycle(sys)
        i = i + 1
    }
    println("10 production cycles completed")
    assert(is_alive(sys))
    assert(generation(sys) == 10)

    // Perturb from environment
    sys = perturb(sys, 3.0, 0.5)
    println("Environmental perturbation applied")

    // System still alive — structure changed, organization preserved
    sys = produce_cycle(sys)
    assert(is_alive(sys))
    println("System alive after perturbation (organization invariant)")

    let drift = structural_drift(sys)
    println("Structural drift accumulated")
    assert(drift > 0.0)

    println("")
    println("Autopoiesis: PASS")
    println("")
}

// ============================================================================
// DEMO 5: Structural Coupling — Co-evolution
// ============================================================================

fn demo_coupling() with IO, Mut, Div, Panic {
    println("=== DEMO 5: Structural Coupling (Maturana/Varela) ===")
    println("")

    var c = coupling_new(1, 2)

    // Simulate coupling: both systems output values that gradually align
    var i = 0
    var a_val = 10.0
    var b_val = 90.0
    while i < 100 {
        a_val = a_val + (b_val - a_val) * 0.05
        b_val = b_val + (a_val - b_val) * 0.05
        c = couple_step(c, a_val, b_val)
        i = i + 1
    }

    let cong = congruence(c)
    println("After 100 coupling steps: congruence computed")
    assert(cong > 0.5)

    let err = prediction_error(c)
    println("Prediction error decreased (co-adaptation)")
    assert(err < 10.0)

    println("")
    println("Structural coupling: PASS")
    println("")
}

// ============================================================================
// DEMO 6: Conversation — Knowledge Through Dialogue
// ============================================================================

fn demo_conversation() with IO, Mut, Div, Panic {
    println("=== DEMO 6: Conversation Theory (Pask 1975) ===")
    println("")

    var conv = conversation_new(1, 2, 42)
    conv = set_models(conv, 10.0, 1.0, 90.0, 1.0)
    println("P starts at 10.0, Q starts at 90.0")

    var rounds = 0
    while rounds < 100 {
        conv = converse(conv)
        if has_converged(conv) {
            break
        }
        rounds = rounds + 1
    }

    let agr = agreement(conv)
    println("Conversation converged")
    assert(agr > 0.8)

    let shared_val = shared_understanding(conv)
    println("Shared understanding (eigenform of conversation) reached")
    assert(shared_val > 10.0)
    assert(shared_val < 90.0)

    println("")
    println("Conversation theory: PASS")
    println("")
}

// ============================================================================
// DEMO 7: Variety — Ashby's Law
// ============================================================================

fn demo_variety() with IO, Mut, Div, Panic {
    println("=== DEMO 7: Variety (Ashby 1956) ===")
    println("")

    var vs = variety_new()
    var i = 0
    while i < 50 {
        vs = record_env_state(vs, i % 6)
        i = i + 1
    }
    vs = compute_variety(vs)
    println("Environment variety computed")
    assert(vs.env_variety > 5.0)

    println("has_requisite_variety check")
    let has_variety = has_requisite_variety(vs)
    println("")
    println("Variety: PASS")
    println("")
}

// ============================================================================
// DEMO 8: Bateson — Learning Levels
// ============================================================================

fn demo_bateson() with IO, Mut, Div, Panic {
    println("=== DEMO 8: Learning Levels (Bateson 1972) ===")
    println("")

    var ctx = bateson_new()
    println("Learning context created at L0")

    let event1 = level_one_update(ctx, 5, 1.0)
    println("L1 learning event triggered")
    ctx = event1.context

    let event2 = level_two_switch(ctx, 0.0)
    println("L2 model switch attempted")

    let is_db = detect_double_bind(ctx)
    println("Double bind detection: ok")

    println("")
    println("Learning Levels: PASS")
    println("")
}

// ============================================================================
// DEMO 9: Languaging — Action Coordination
// ============================================================================

fn demo_languaging() with IO, Mut, Div, Panic {
    println("=== DEMO 9: Languaging (Maturana 1988) ===")
    println("")

    var pair = languaging_new(8)
    println("Languaging pair created with 8 actions")

    var i = 0
    while i < 50 {
        pair = languaging_step(pair, i % 3, (i + 1) % 3)
        i = i + 1
    }

    let has_domain = has_consensual_domain(pair, 5)
    println("Consensual domain formed")

    let dom_size = domain_size(pair)
    println("Domain size tracked")

    println("")
    println("Languaging: PASS")
    println("")
}

// ============================================================================
// MAIN
// ============================================================================

fn main() with IO, Mut, Div, Panic {
    println("=============================================================")
    println("  Second-Order Cybernetics in Sounio — Full Demo")
    println("")
    println("  Spencer-Brown / von Foerster / Maturana & Varela")
    println("  Luhmann / Kauffman / Pask / Ashby / Bateson")
    println("=============================================================")
    println("")

    demo_distinction()
    demo_eigenform()
    demo_observer()
    demo_autopoiesis()
    demo_coupling()
    demo_conversation()
    demo_variety()
    demo_bateson()
    demo_languaging()

    println("=============================================================")
    println("  ALL 9 DEMOS PASSED — Second-order cybernetics operational")
    println("=============================================================")
}

// ============================================================================
// HELPERS
// ============================================================================

fn abs_f64_demo(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}
