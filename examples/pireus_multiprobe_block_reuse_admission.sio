//@ run-pass
//!
//! Sounio fixture for reuse admission without block-work replay.

use hardware::pireus::multiprobe_block_reuse_admission::{
    PIREUS_MBC_REUSE_OK,
    pireus_mbc_reuse_fixture_request,
    pireus_mbc_reuse_admission_decide,
    pireus_mbc_reuse_admission_negative_surface,
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_mbc_reuse_fixture_request()
    let decision = pireus_mbc_reuse_admission_decide(&request)
    let negatives = pireus_mbc_reuse_admission_negative_surface()
    if !decision.fixture_eligible || decision.error != PIREUS_MBC_REUSE_OK ||
        decision.work_replayed || decision.actual_cache_hit ||
        decision.material_receipt_admitted ||
        negatives[0] != 19 || negatives[1] != 19 { return 1 }
    print("SOUNIO_AUTHORITY schema=pireus-multiprobe-block-reuse-admission.v14")
    print(" role=SEMANTIC_AUTHORITY parent_semantics_sha256=")
    print("f7b7e81c546bf54a2a92ec374f50465dfb2e0874d52b77fc6ac70484587dc20c")
    print(" stage=SEMANTICS_FROZEN\n")
    print("PIREUS_MBC_REUSE_FIXTURE_ADMISSION fixture_only=1 fixture_eligible=1")
    print(" work_replayed=0 actual_cache_hit=0 actual_reuse_admitted=0")
    print(" material_receipt_admitted=0")
    print(" negative_passed=19 negative_total=19 claim_ready=0\n")
    0
}
