// Test the grad builtin function for autodiff
// grad(f, x) computes f'(x) where f: fn(Dual) -> Dual

fn square(x: dual) -> dual {
    dual_mul(x, x)
}

fn main() {
    println("=== Testing grad builtin ===")

    // Test 1: f(x) = x^2, f'(x) = 2x
    // At x=3: f'(3) = 6
    let deriv1 = grad(square, 3.0)
    println("f(x) = x^2 at x=3:")
    println("  f'(3) = ")
    println(deriv1)
    println("  Expected: 6.0")

    println("")

    // Test 2: f(x) = x^2 at x=5
    // f'(5) = 10
    let deriv2 = grad(square, 5.0)
    println("f(x) = x^2 at x=5:")
    println("  f'(5) = ")
    println(deriv2)
    println("  Expected: 10.0")
}
