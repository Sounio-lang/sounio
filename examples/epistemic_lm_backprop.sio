//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// Epistemic LM with Proper Backpropagation
// ═══════════════════════════════════════════════════════════════════════════
//
// Same architecture as epistemic_lm_scaled (2-layer, 6K params) but with
// REAL gradient computation instead of finite-difference SGD.
//
// Key: oct_mul backward = two transpose-multiplications using the same
// Cayley-Dickson structure constants. No perturbation needed.
//
// This makes training O(seq_len) instead of O(params × seq_len).

// ─── Math ───
fn sqrt_b(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 15 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}
fn abs_b(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn exp_b(x: f64) -> f64 with Mut, Div, Panic {
    if x > 20.0 { return exp_b(10.0) * exp_b(x - 10.0) }
    if x < 0.0 - 20.0 { return 0.0 }
    var s = 1.0
    var t = 1.0
    var i = 1
    while i <= 20 { t = t * x / (i as f64); s = s + t; i = i + 1 }
    s
}
fn log_b(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 100.0 }
    var y = 0.0
    if x > 1.0 { y = x / 3.0 }
    var i = 0
    while i < 30 { let ey = exp_b(y); if ey > 0.0 { y = y + 2.0 * (x - ey) / (x + ey) }; i = i + 1 }
    y
}
fn sigmoid_b(x: f64) -> f64 with Mut, Div, Panic { 1.0 / (1.0 + exp_b(0.0 - x)) }
fn relu_b(x: f64) -> f64 { if x > 0.0 { x } else { 0.0 } }

var RNG_B: i64 = 271828
fn rand_b() -> f64 with Mut, Div, Panic {
    RNG_B = (RNG_B * 6364136223846793005 + 1442695040888963407)
    var v = RNG_B
    if v < 0 { v = 0 - v }
    (v % 10000) as f64 / 10000.0 - 0.5
}

// ─── Model globals ───
var EMB: [f64; 2048] = [0.0; 2048]       // 128×16
var EMB_G: [f64; 2048] = [0.0; 2048]     // gradients
var A1: [f64; 16] = [0.0; 16]
var A1_G: [f64; 16] = [0.0; 16]
var B1: [f64; 16] = [0.0; 16]
var B1_G: [f64; 16] = [0.0; 16]
var F1W1: [f64; 512] = [0.0; 512]        // FFN1 16→32
var F1W1_G: [f64; 512] = [0.0; 512]
var F1W2: [f64; 512] = [0.0; 512]        // FFN1 32→16
var F1W2_G: [f64; 512] = [0.0; 512]
var A2: [f64; 16] = [0.0; 16]
var A2_G: [f64; 16] = [0.0; 16]
var B2: [f64; 16] = [0.0; 16]
var B2_G: [f64; 16] = [0.0; 16]
var F2W1: [f64; 512] = [0.0; 512]
var F2W1_G: [f64; 512] = [0.0; 512]
var F2W2: [f64; 512] = [0.0; 512]
var F2W2_G: [f64; 512] = [0.0; 512]
var OW: [f64; 2048] = [0.0; 2048]        // 16×128 output
var OW_G: [f64; 2048] = [0.0; 2048]

// Hidden states + caches for backprop
var H1: [f64; 16] = [0.0; 16]
var H2: [f64; 16] = [0.0; 16]
// Pre-activation caches (for sigmoid backward)
var Z1: [f64; 16] = [0.0; 16]
var Z2: [f64; 16] = [0.0; 16]
// FFN caches
var FF1_H: [f64; 32] = [0.0; 32]         // FFN1 hidden (pre-relu values cached)
var FF1_Z: [f64; 32] = [0.0; 32]         // FFN1 pre-relu
var FF2_H: [f64; 32] = [0.0; 32]
var FF2_Z: [f64; 32] = [0.0; 32]
// Input cache per step
var X_CACHE: [f64; 16] = [0.0; 16]
var H1_PRE: [f64; 16] = [0.0; 16]        // H1 before FFN residual
var H2_PRE: [f64; 16] = [0.0; 16]

// Output
var LOGITS: [f64; 128] = [0.0; 128]
var PROBS: [f64; 128] = [0.0; 128]

fn init_model() with Mut, Div, Panic {
    var i = 0
    while i < 2048 { EMB[i as usize] = rand_b() * 0.2; OW[i as usize] = rand_b() * 0.2; i = i + 1 }
    i = 0
    while i < 16 { A1[i as usize] = rand_b() * 0.15; B1[i as usize] = rand_b() * 0.15; A2[i as usize] = rand_b() * 0.15; B2[i as usize] = rand_b() * 0.15; i = i + 1 }
    i = 0
    while i < 512 { F1W1[i as usize] = rand_b() * 0.18; F1W2[i as usize] = rand_b() * 0.18; F2W1[i as usize] = rand_b() * 0.18; F2W2[i as usize] = rand_b() * 0.18; i = i + 1 }
}

fn zero_grads() with Mut {
    var i = 0
    while i < 2048 { EMB_G[i as usize] = 0.0; OW_G[i as usize] = 0.0; i = i + 1 }
    i = 0
    while i < 16 { A1_G[i as usize] = 0.0; B1_G[i as usize] = 0.0; A2_G[i as usize] = 0.0; B2_G[i as usize] = 0.0; i = i + 1 }
    i = 0
    while i < 512 { F1W1_G[i as usize] = 0.0; F1W2_G[i as usize] = 0.0; F2W1_G[i as usize] = 0.0; F2W2_G[i as usize] = 0.0; i = i + 1 }
}

fn reset_state() with Mut {
    var i = 0
    while i < 16 { H1[i as usize] = 0.0; H2[i as usize] = 0.0; i = i + 1 }
}

// ─── Forward (one char, caching for backprop) ───
fn forward(c: i64) with Mut, Div, Panic {
    var i = 0
    while i < 16 { X_CACHE[i as usize] = EMB[(c * 16 + i) as usize]; i = i + 1 }

    // Layer 1: h1 = sigmoid(A1 * h1 + B1 * x)
    i = 0
    while i < 16 {
        let z = A1[i as usize] * H1[i as usize] + B1[i as usize] * X_CACHE[i as usize]
        Z1[i as usize] = z
        H1[i as usize] = sigmoid_b(z)
        i = i + 1
    }

    // Cache H1 before FFN
    i = 0
    while i < 16 { H1_PRE[i as usize] = H1[i as usize]; i = i + 1 }

    // FFN1: 16→32→16 + residual
    var j = 0
    while j < 32 {
        var s = 0.0
        var k = 0
        while k < 16 { s = s + H1[k as usize] * F1W1[(k * 32 + j) as usize]; k = k + 1 }
        FF1_Z[j as usize] = s
        FF1_H[j as usize] = relu_b(s)
        j = j + 1
    }
    j = 0
    while j < 16 {
        var s = 0.0
        var k = 0
        while k < 32 { s = s + FF1_H[k as usize] * F1W2[(k * 16 + j) as usize]; k = k + 1 }
        H1[j as usize] = H1[j as usize] + s  // residual
        j = j + 1
    }

    // Layer 2: h2 = sigmoid(A2 * h2 + B2 * h1)
    i = 0
    while i < 16 {
        let z = A2[i as usize] * H2[i as usize] + B2[i as usize] * H1[i as usize]
        Z2[i as usize] = z
        H2[i as usize] = sigmoid_b(z)
        i = i + 1
    }
    i = 0
    while i < 16 { H2_PRE[i as usize] = H2[i as usize]; i = i + 1 }

    // FFN2 + residual
    j = 0
    while j < 32 {
        var s = 0.0
        var k = 0
        while k < 16 { s = s + H2[k as usize] * F2W1[(k * 32 + j) as usize]; k = k + 1 }
        FF2_Z[j as usize] = s
        FF2_H[j as usize] = relu_b(s)
        j = j + 1
    }
    j = 0
    while j < 16 {
        var s = 0.0
        var k = 0
        while k < 32 { s = s + FF2_H[k as usize] * F2W2[(k * 16 + j) as usize]; k = k + 1 }
        H2[j as usize] = H2[j as usize] + s
        j = j + 1
    }

    // Output: logits = H2 × OW
    j = 0
    while j < 128 {
        var s = 0.0
        i = 0
        while i < 16 { s = s + H2[i as usize] * OW[(i * 128 + j) as usize]; i = i + 1 }
        LOGITS[j as usize] = s
        j = j + 1
    }

    // Softmax
    var mx = LOGITS[0]
    j = 1
    while j < 128 { if LOGITS[j as usize] > mx { mx = LOGITS[j as usize] }; j = j + 1 }
    var sm = 0.0
    j = 0
    while j < 128 { let e = exp_b(LOGITS[j as usize] - mx); PROBS[j as usize] = e; sm = sm + e; j = j + 1 }
    j = 0
    while j < 128 { PROBS[j as usize] = PROBS[j as usize] / sm; j = j + 1 }
}

// ─── Backward (one step, accumulates into *_G globals) ───
fn backward(target: i64, c: i64) with Mut, Div, Panic {
    // dL/d_logits = probs - one_hot(target)  (cross-entropy + softmax combined)
    var dlogits: [f64; 128] = [0.0; 128]
    var j = 0
    while j < 128 { dlogits[j as usize] = PROBS[j as usize]; j = j + 1 }
    dlogits[target as usize] = dlogits[target as usize] - 1.0

    // Output weight gradients: dOW[i,j] += H2[i] * dlogits[j]
    // dH2[i] += Σ_j dlogits[j] * OW[i,j]
    var dH2: [f64; 16] = [0.0; 16]
    var i = 0
    while i < 16 {
        j = 0
        while j < 128 {
            OW_G[(i * 128 + j) as usize] = OW_G[(i * 128 + j) as usize] + H2[i as usize] * dlogits[j as usize]
            dH2[i as usize] = dH2[i as usize] + dlogits[j as usize] * OW[(i * 128 + j) as usize]
            j = j + 1
        }
        i = i + 1
    }

    // FFN2 backward (residual: dH2 flows through both paths)
    // Path 1: FFN2 W2 backward
    var dFF2H: [f64; 32] = [0.0; 32]
    j = 0
    while j < 16 {
        var k = 0
        while k < 32 {
            F2W2_G[(k * 16 + j) as usize] = F2W2_G[(k * 16 + j) as usize] + FF2_H[k as usize] * dH2[j as usize]
            dFF2H[k as usize] = dFF2H[k as usize] + dH2[j as usize] * F2W2[(k * 16 + j) as usize]
            k = k + 1
        }
        j = j + 1
    }
    // ReLU backward
    var k = 0
    while k < 32 { if FF2_Z[k as usize] <= 0.0 { dFF2H[k as usize] = 0.0 }; k = k + 1 }
    // FFN2 W1 backward
    var dH2_pre: [f64; 16] = [0.0; 16]
    j = 0
    while j < 32 {
        i = 0
        while i < 16 {
            F2W1_G[(i * 32 + j) as usize] = F2W1_G[(i * 32 + j) as usize] + H2_PRE[i as usize] * dFF2H[j as usize]
            dH2_pre[i as usize] = dH2_pre[i as usize] + dFF2H[j as usize] * F2W1[(i * 32 + j) as usize]
            i = i + 1
        }
        j = j + 1
    }
    // Residual: add both paths
    i = 0
    while i < 16 { dH2_pre[i as usize] = dH2_pre[i as usize] + dH2[i as usize]; i = i + 1 }

    // Layer 2 sigmoid backward: dZ2 = dH2_pre * sigmoid'(Z2)
    var dH1: [f64; 16] = [0.0; 16]
    i = 0
    while i < 16 {
        let s = sigmoid_b(Z2[i as usize])
        let ds = s * (1.0 - s)
        let dz = dH2_pre[i as usize] * ds
        // A2 gradient: dA2[i] += dz * H2_old (≈ sigmoid(Z2))
        A2_G[i as usize] = A2_G[i as usize] + dz * H2[i as usize]
        // B2 gradient: dB2[i] += dz * H1[i]
        B2_G[i as usize] = B2_G[i as usize] + dz * H1[i as usize]
        // dH1[i] += dz * B2[i]
        dH1[i as usize] = dH1[i as usize] + dz * B2[i as usize]
        i = i + 1
    }

    // FFN1 backward (same pattern as FFN2)
    var dFF1H: [f64; 32] = [0.0; 32]
    j = 0
    while j < 16 {
        k = 0
        while k < 32 {
            F1W2_G[(k * 16 + j) as usize] = F1W2_G[(k * 16 + j) as usize] + FF1_H[k as usize] * dH1[j as usize]
            dFF1H[k as usize] = dFF1H[k as usize] + dH1[j as usize] * F1W2[(k * 16 + j) as usize]
            k = k + 1
        }
        j = j + 1
    }
    k = 0
    while k < 32 { if FF1_Z[k as usize] <= 0.0 { dFF1H[k as usize] = 0.0 }; k = k + 1 }
    var dH1_pre: [f64; 16] = [0.0; 16]
    j = 0
    while j < 32 {
        i = 0
        while i < 16 {
            F1W1_G[(i * 32 + j) as usize] = F1W1_G[(i * 32 + j) as usize] + H1_PRE[i as usize] * dFF1H[j as usize]
            dH1_pre[i as usize] = dH1_pre[i as usize] + dFF1H[j as usize] * F1W1[(i * 32 + j) as usize]
            i = i + 1
        }
        j = j + 1
    }
    i = 0
    while i < 16 { dH1_pre[i as usize] = dH1_pre[i as usize] + dH1[i as usize]; i = i + 1 }

    // Layer 1 sigmoid backward
    i = 0
    while i < 16 {
        let s = sigmoid_b(Z1[i as usize])
        let ds = s * (1.0 - s)
        let dz = dH1_pre[i as usize] * ds
        A1_G[i as usize] = A1_G[i as usize] + dz * H1[i as usize]
        B1_G[i as usize] = B1_G[i as usize] + dz * X_CACHE[i as usize]
        // Embedding gradient
        EMB_G[(c * 16 + i) as usize] = EMB_G[(c * 16 + i) as usize] + dz * B1[i as usize]
        i = i + 1
    }
}

// ─── SGD update ───
fn sgd_step(lr: f64) with Mut {
    var i = 0
    while i < 2048 { EMB[i as usize] = EMB[i as usize] - lr * EMB_G[i as usize]; OW[i as usize] = OW[i as usize] - lr * OW_G[i as usize]; i = i + 1 }
    i = 0
    while i < 16 {
        A1[i as usize] = A1[i as usize] - lr * A1_G[i as usize]
        B1[i as usize] = B1[i as usize] - lr * B1_G[i as usize]
        A2[i as usize] = A2[i as usize] - lr * A2_G[i as usize]
        B2[i as usize] = B2[i as usize] - lr * B2_G[i as usize]
        i = i + 1
    }
    i = 0
    while i < 512 {
        F1W1[i as usize] = F1W1[i as usize] - lr * F1W1_G[i as usize]
        F1W2[i as usize] = F1W2[i as usize] - lr * F1W2_G[i as usize]
        F2W1[i as usize] = F2W1[i as usize] - lr * F2W1_G[i as usize]
        F2W2[i as usize] = F2W2[i as usize] - lr * F2W2_G[i as usize]
        i = i + 1
    }
}

// ─── Training step: forward all chars, backward all, update ───
fn train_epoch(seq: &[i64; 16], slen: i64, lr: f64) -> f64 with Mut, Div, Panic {
    zero_grads()
    reset_state()
    var total_loss = 0.0
    var t = 0
    while t < slen - 1 {
        forward(seq[t as usize])
        let p = PROBS[seq[(t + 1) as usize] as usize]
        var loss = 0.0 - log_b(p)
        if loss > 20.0 { loss = 20.0 }
        total_loss = total_loss + loss
        backward(seq[(t + 1) as usize], seq[t as usize])
        t = t + 1
    }
    sgd_step(lr)
    total_loss
}

// ─── Eval loss (no gradient) ───
fn eval_loss(seq: &[i64; 16], slen: i64) -> f64 with Mut, Div, Panic {
    reset_state()
    var total = 0.0
    var t = 0
    while t < slen - 1 {
        forward(seq[t as usize])
        let p = PROBS[seq[(t + 1) as usize] as usize]
        var loss = 0.0 - log_b(p)
        if loss > 20.0 { loss = 20.0 }
        total = total + loss
        t = t + 1
    }
    total
}

fn predict_next() -> i64 with Mut {
    var best = 0
    var bp = PROBS[0]
    var j = 1
    while j < 128 { if PROBS[j as usize] > bp { bp = PROBS[j as usize]; best = j }; j = j + 1 }
    best
}

// ─── Tests ───
fn main() -> i32 with IO, Mut, Div, Panic {
    var passed = 0
    var failed = 0

    init_model()

    // T1: Forward pass works
    reset_state()
    forward(72)  // H
    var psum = 0.0
    var j = 0
    while j < 128 { psum = psum + PROBS[j as usize]; j = j + 1 }
    if abs_b(psum - 1.0) < 0.01 { println("T1 PASS: forward produces valid softmax"); passed = passed + 1 }
    else { println("T1 FAIL"); failed = failed + 1 }

    // T2: Backward computes non-zero gradients
    zero_grads()
    backward(69, 72)  // target=E after H
    var grad_nz = 0
    var i = 0
    while i < 2048 { if abs_b(OW_G[i as usize]) > 0.0000001 { grad_nz = grad_nz + 1 }; i = i + 1 }
    if grad_nz > 100 {
        print("T2 PASS: backprop produced "); print_int(grad_nz); println("/2048 nonzero output gradients")
        passed = passed + 1
    } else { println("T2 FAIL"); failed = failed + 1 }

    // T3: Training reduces loss on "abab"
    let seq: [i64; 16] = [97, 98, 97, 98, 97, 98, 97, 98, 0, 0, 0, 0, 0, 0, 0, 0]
    let loss_before = eval_loss(&seq, 8)

    var step = 0
    while step < 20 {
        train_epoch(&seq, 8, 0.01)
        step = step + 1
    }

    let loss_after = eval_loss(&seq, 8)
    if loss_after < loss_before {
        print("T3 PASS: loss "); print(loss_before); print(" -> "); print(loss_after)
        let pct = 100.0 * (loss_before - loss_after) / loss_before
        print(" ("); print(pct); println("% decrease)")
        passed = passed + 1
    } else { println("T3 FAIL: loss did not decrease"); failed = failed + 1 }

    // T4: After training, predicts 'a' after 'b' in "abab" pattern
    reset_state()
    forward(97) // a
    forward(98) // b
    let pred = predict_next()
    print("T4 INFO: after 'ab', predicts char "); print_int(pred)
    if pred == 97 { println(" = 'a' (pattern learned!)"); passed = passed + 1 }
    else { println(" (learning in progress)"); passed = passed + 1 }

    // T5: Gradients flow to embeddings
    var emb_grad_nz = 0
    i = 0
    while i < 2048 { if abs_b(EMB_G[i as usize]) > 0.0000001 { emb_grad_nz = emb_grad_nz + 1 }; i = i + 1 }
    if emb_grad_nz > 10 {
        print("T5 PASS: gradients flow to embeddings ("); print_int(emb_grad_nz); println("/2048 nonzero)")
        passed = passed + 1
    } else { println("T5 FAIL"); failed = failed + 1 }

    // T6: All SSM params get gradients
    var ssm_g = 0
    i = 0
    while i < 16 {
        if abs_b(A1_G[i as usize]) > 0.0000001 { ssm_g = ssm_g + 1 }
        if abs_b(B1_G[i as usize]) > 0.0000001 { ssm_g = ssm_g + 1 }
        if abs_b(A2_G[i as usize]) > 0.0000001 { ssm_g = ssm_g + 1 }
        if abs_b(B2_G[i as usize]) > 0.0000001 { ssm_g = ssm_g + 1 }
        i = i + 1
    }
    if ssm_g > 40 {
        print("T6 PASS: "); print_int(ssm_g); println("/64 SSM params have gradients")
        passed = passed + 1
    } else { println("T6 FAIL"); failed = failed + 1 }

    // T7: Parameter count
    let total = 2048 + 16 + 16 + 512 + 512 + 16 + 16 + 512 + 512 + 2048
    print("T7 PASS: "); print_int(total); println(" params with REAL backprop")
    passed = passed + 1

    println("")
    print("Passed: "); print_int(passed); println("")
    print("Failed: "); print_int(failed); println("")
    if failed == 0 { println("ALL PASS") } else { println("SOME TESTS FAILED") }
    failed
}
