//@ run-pass
// oct_connectome_demo.sio — First-ever computation of associator fields
// on octonion-labeled graphs across multiple topologies.
//
// This demo produces DATA that has never been computed before.
// We're looking for patterns in how non-associativity distributes
// across different graph structures.
//
// THEOREM (proven in formal/OctonionGraph.lean):
//   ||path_product|| is invariant under reparenthesization.
//
// QUESTION: What controls the DIRECTION? How does graph topology
//   affect the associator field?
//
// Graph topologies tested:
//   1. Path P_n (linear chain)
//   2. Cycle C_n (closed loop)
//   3. Complete K_n (fully connected)
//   4. Star S_n (hub-and-spoke)
//   5. Basis-labeled K_n (deterministic, algebraically structured)

// ============================================================================
// MATH HELPERS
// ============================================================================

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn sqrt_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var r = x
    var i = 0
    while i < 20 { r = 0.5 * (r + x / r); i = i + 1 }
    r
}

// ============================================================================
// OCTONION (inlined)
// ============================================================================

struct Oct { e: [f64; 8] }

fn oct_zero() -> Oct { Oct { e: [0.0; 8] } }

fn oct_real(r: f64) -> Oct with Mut, Panic {
    var o = Oct { e: [0.0; 8] }
    o.e[0] = r
    o
}

fn oct_unit(idx: i64) -> Oct with Mut, Panic {
    var o = Oct { e: [0.0; 8] }
    if idx >= 0 && idx < 8 { o.e[idx as usize] = 1.0 }
    o
}

fn oct_sub(a: Oct, b: Oct) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    var i: i64 = 0
    while i < 8 { r.e[i as usize] = a.e[i as usize] - b.e[i as usize]; i = i + 1 }
    r
}

fn oct_scale(o: Oct, s: f64) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    var i: i64 = 0
    while i < 8 { r.e[i as usize] = o.e[i as usize] * s; i = i + 1 }
    r
}

fn oct_conjugate(o: Oct) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    r.e[0] = o.e[0]
    var i: i64 = 1
    while i < 8 { r.e[i as usize] = 0.0 - o.e[i as usize]; i = i + 1 }
    r
}

fn oct_norm_sq(o: Oct) -> f64 with Mut, Panic, Div {
    var s: f64 = 0.0
    var i: i64 = 0
    while i < 8 { s = s + o.e[i as usize] * o.e[i as usize]; i = i + 1 }
    s
}

fn oct_norm(o: Oct) -> f64 with Mut, Panic, Div { sqrt_f64(oct_norm_sq(o)) }

fn oct_fano_index(i: i64, j: i64) -> i64 with Mut, Panic, Div {
    if i == j { return 0 }
    var t: [i64; 21] = [0; 21]
    t[0]=1;t[1]=2;t[2]=4; t[3]=2;t[4]=3;t[5]=5; t[6]=3;t[7]=4;t[8]=6
    t[9]=4;t[10]=5;t[11]=7; t[12]=5;t[13]=6;t[14]=1; t[15]=6;t[16]=7;t[17]=2
    t[18]=7;t[19]=1;t[20]=3
    var k: i64 = 0
    while k < 7 {
        let a=t[(k*3) as usize]; let b=t[(k*3+1) as usize]; let c=t[(k*3+2) as usize]
        if (i==a&&j==b)||(i==b&&j==c)||(i==c&&j==a) {
            if i==a&&j==b {return c}; if i==b&&j==c {return a}; return b
        }
        if (i==b&&j==a)||(i==c&&j==b)||(i==a&&j==c) {
            if i==b&&j==a {return c}; if i==c&&j==b {return a}; return b
        }
        k=k+1
    }
    0
}

fn oct_fano_sign(i: i64, j: i64) -> f64 with Mut, Panic, Div {
    if i==j {return -1.0}; if i==0||j==0 {return 1.0}
    var t: [i64; 21] = [0; 21]
    t[0]=1;t[1]=2;t[2]=4; t[3]=2;t[4]=3;t[5]=5; t[6]=3;t[7]=4;t[8]=6
    t[9]=4;t[10]=5;t[11]=7; t[12]=5;t[13]=6;t[14]=1; t[15]=6;t[16]=7;t[17]=2
    t[18]=7;t[19]=1;t[20]=3
    var k: i64 = 0
    while k < 7 {
        let a=t[(k*3) as usize]; let b=t[(k*3+1) as usize]; let c=t[(k*3+2) as usize]
        if (i==a&&j==b)||(i==b&&j==c)||(i==c&&j==a) {return 1.0}
        if (i==b&&j==a)||(i==c&&j==b)||(i==a&&j==c) {return -1.0}
        k=k+1
    }
    0.0
}

fn oct_mul(a: Oct, b: Oct) -> Oct with Mut, Panic, Div {
    var result = oct_zero()
    var i: i64 = 0
    while i < 8 {
        var j: i64 = 0
        while j < 8 {
            let coeff = a.e[i as usize] * b.e[j as usize]
            if i==0&&j==0 { result.e[0] = result.e[0] + coeff }
            else if i==0 { result.e[j as usize] = result.e[j as usize] + coeff }
            else if j==0 { result.e[i as usize] = result.e[i as usize] + coeff }
            else if i==j { result.e[0] = result.e[0] - coeff }
            else {
                let k = oct_fano_index(i, j)
                let sign = oct_fano_sign(i, j)
                result.e[k as usize] = result.e[k as usize] + sign * coeff
            }
            j=j+1
        }
        i=i+1
    }
    result
}

fn oct_associator(a: Oct, b: Oct, c: Oct) -> Oct with Mut, Panic, Div {
    let ab = oct_mul(a, b)
    let bc = oct_mul(b, c)
    oct_sub(oct_mul(ab, c), oct_mul(a, bc))
}

// ============================================================================
// OCTGRAPH (inlined, max 16 nodes to keep memory manageable)
// ============================================================================

struct OctGraph {
    n: i32
    adj: [i32; 256]        // 16x16
    lab0: [f64; 256]
    lab1: [f64; 256]
    lab2: [f64; 256]
    lab3: [f64; 256]
    lab4: [f64; 256]
    lab5: [f64; 256]
    lab6: [f64; 256]
    lab7: [f64; 256]
}

fn og_new(n: i32) -> OctGraph {
    OctGraph {
        n: n, adj: [0; 256],
        lab0: [0.0; 256], lab1: [0.0; 256], lab2: [0.0; 256], lab3: [0.0; 256],
        lab4: [0.0; 256], lab5: [0.0; 256], lab6: [0.0; 256], lab7: [0.0; 256],
    }
}

fn og_idx(u: i32, v: i32) -> i32 { u * 16 + v }

fn og_get_label(g: OctGraph, u: i32, v: i32) -> Oct with Mut, Panic {
    let idx = og_idx(u, v) as usize
    var o = Oct { e: [0.0; 8] }
    o.e[0]=g.lab0[idx]; o.e[1]=g.lab1[idx]; o.e[2]=g.lab2[idx]; o.e[3]=g.lab3[idx]
    o.e[4]=g.lab4[idx]; o.e[5]=g.lab5[idx]; o.e[6]=g.lab6[idx]; o.e[7]=g.lab7[idx]
    o
}

fn og_set_edge(g: OctGraph, u: i32, v: i32, label: Oct) -> OctGraph with Mut, Panic, Div {
    var r = g
    let idx = og_idx(u, v) as usize
    r.adj[idx] = 1
    r.lab0[idx]=label.e[0]; r.lab1[idx]=label.e[1]; r.lab2[idx]=label.e[2]; r.lab3[idx]=label.e[3]
    r.lab4[idx]=label.e[4]; r.lab5[idx]=label.e[5]; r.lab6[idx]=label.e[6]; r.lab7[idx]=label.e[7]
    r
}

fn og_add_undir(g: OctGraph, u: i32, v: i32, label: Oct) -> OctGraph with Mut, Panic, Div {
    var r = og_set_edge(g, u, v, label)
    r = og_set_edge(r, v, u, oct_conjugate(label))
    r
}

// ============================================================================
// LCG RNG
// ============================================================================

fn lcg_next(s: i64) -> i64 { s * 6364136223846793005 + 1442695040888963407 }

fn lcg_f64(s: i64) -> f64 with Div, Panic {
    let v = if s < 0 { 0 - s } else { s }
    (v as f64) / 9223372036854775807.0
}

fn random_unit_oct(seed: i64) -> Oct with Mut, Panic, Div {
    var o = Oct { e: [0.0; 8] }
    var s = seed
    var i: i64 = 0
    while i < 8 {
        s = lcg_next(s)
        o.e[i as usize] = 2.0 * lcg_f64(s) - 1.0
        i = i + 1
    }
    let n = oct_norm(o)
    if n < 1e-12 { return oct_real(1.0) }
    oct_scale(o, 1.0 / n)
}

// ============================================================================
// GRAPH GENERATORS
// ============================================================================

fn make_path(n: i32, seed: i64) -> OctGraph with Mut, Panic, Div {
    var g = og_new(n)
    var s = seed
    var i: i32 = 0
    while i < n - 1 {
        s = lcg_next(s)
        g = og_add_undir(g, i, i + 1, random_unit_oct(s))
        i = i + 1
    }
    g
}

fn make_cycle(n: i32, seed: i64) -> OctGraph with Mut, Panic, Div {
    var g = make_path(n, seed)
    var s = seed
    var i: i32 = 0
    while i < n + 5 { s = lcg_next(s); i = i + 1 }
    g = og_add_undir(g, n - 1, 0, random_unit_oct(s))
    g
}

fn make_complete(n: i32, seed: i64) -> OctGraph with Mut, Panic, Div {
    var g = og_new(n)
    var s = seed
    var u: i32 = 0
    while u < n {
        var v: i32 = u + 1
        while v < n {
            s = lcg_next(s)
            g = og_add_undir(g, u, v, random_unit_oct(s))
            v = v + 1
        }
        u = u + 1
    }
    g
}

fn make_star(n: i32, seed: i64) -> OctGraph with Mut, Panic, Div {
    var g = og_new(n)
    var s = seed
    var i: i32 = 1
    while i < n {
        s = lcg_next(s)
        g = og_add_undir(g, 0, i, random_unit_oct(s))
        i = i + 1
    }
    g
}

fn make_basis_complete(n: i32) -> OctGraph with Mut, Panic, Div {
    var g = og_new(n)
    var u: i32 = 0
    while u < n {
        var v: i32 = u + 1
        while v < n {
            let basis_idx = ((u + v) % 7 + 1) as i64
            g = og_add_undir(g, u, v, oct_unit(basis_idx))
            v = v + 1
        }
        u = u + 1
    }
    g
}

// ============================================================================
// ASSOCIATOR FIELD STATISTICS
// ============================================================================

struct AssocStats {
    count: i32
    mean_norm: f64
    max_norm: f64
    energy: f64         // sum of ||[a,b,c]||^2
    zero_count: i32     // how many associators are zero (alternativity channels)
}

fn compute_assoc_stats(g: OctGraph) -> AssocStats with Mut, Panic, Div {
    var count: i32 = 0
    var sum_norm: f64 = 0.0
    var max_n: f64 = 0.0
    var sum_sq: f64 = 0.0
    var zeros: i32 = 0

    var u: i32 = 0
    while u < g.n {
        var v: i32 = 0
        while v < g.n {
            if g.adj[og_idx(u, v) as usize] == 1 && u != v {
                var w: i32 = 0
                while w < g.n {
                    if g.adj[og_idx(v, w) as usize] == 1 && v != w && w != u {
                        var x: i32 = 0
                        while x < g.n {
                            if g.adj[og_idx(w, x) as usize] == 1 && w != x && x != v {
                                let a = og_get_label(g, u, v)
                                let b = og_get_label(g, v, w)
                                let c = og_get_label(g, w, x)
                                let assoc = oct_associator(a, b, c)
                                let n = oct_norm(assoc)

                                count = count + 1
                                sum_norm = sum_norm + n
                                sum_sq = sum_sq + n * n
                                if n > max_n { max_n = n }
                                if n < 1e-9 { zeros = zeros + 1 }
                            }
                            x = x + 1
                        }
                    }
                    w = w + 1
                }
            }
            v = v + 1
        }
        u = u + 1
    }

    let mean = if count > 0 { sum_norm / (count as f64) } else { 0.0 }
    AssocStats {
        count: count,
        mean_norm: mean,
        max_norm: max_n,
        energy: sum_sq,
        zero_count: zeros,
    }
}

// ============================================================================
// NORM INVARIANCE CHECK ACROSS PATHS
// ============================================================================

fn check_norm_invariance(g: OctGraph) -> bool with Mut, Panic, Div {
    // Test on all length-4 paths starting from node 0
    var all_ok = true
    var v1: i32 = 0
    while v1 < g.n {
        if g.adj[og_idx(0, v1) as usize] == 1 && v1 != 0 {
            var v2: i32 = 0
            while v2 < g.n {
                if g.adj[og_idx(v1, v2) as usize] == 1 && v2 != v1 && v2 != 0 {
                    var v3: i32 = 0
                    while v3 < g.n {
                        if g.adj[og_idx(v2, v3) as usize] == 1 && v3 != v2 && v3 != v1 {
                            // Path: 0 -> v1 -> v2 -> v3 (3 edges)
                            let e1 = og_get_label(g, 0, v1)
                            let e2 = og_get_label(g, v1, v2)
                            let e3 = og_get_label(g, v2, v3)

                            // Left: (e1*e2)*e3
                            let left = oct_mul(oct_mul(e1, e2), e3)
                            // Right: e1*(e2*e3)
                            let right = oct_mul(e1, oct_mul(e2, e3))

                            let norm_l = oct_norm(left)
                            let norm_r = oct_norm(right)

                            if abs_f64(norm_l - norm_r) > 1e-6 {
                                all_ok = false
                            }
                        }
                        v3 = v3 + 1
                    }
                }
                v2 = v2 + 1
            }
        }
        v1 = v1 + 1
    }
    all_ok
}

// ============================================================================
// PRINT HELPERS
// ============================================================================

fn print_f64_approx(x: f64) with IO, Mut, Panic, Div {
    // Print f64 with 4 decimal places (manual formatting)
    if x < 0.0 { print("-"); print_f64_approx(0.0 - x); return }
    let integer_part = x as i64
    let frac = x - (integer_part as f64)
    let frac_scaled = (frac * 10000.0 + 0.5) as i64
    print(integer_part)
    print(".")
    if frac_scaled < 10 { print("000") }
    else if frac_scaled < 100 { print("00") }
    else if frac_scaled < 1000 { print("0") }
    print(frac_scaled)
}

fn print_stats(name: i32, stats: AssocStats) with IO, Mut, Panic, Div {
    // name is encoded: 1=Path, 2=Cycle, 3=Complete, 4=Star, 5=Basis
    if name == 1 { print("  Path P_8        ") }
    else if name == 2 { print("  Cycle C_8       ") }
    else if name == 3 { print("  Complete K_6    ") }
    else if name == 4 { print("  Star S_8        ") }
    else if name == 5 { print("  Basis K_6       ") }
    else { print("  ???             ") }

    print("| triples=")
    print(stats.count)
    print(" | mean=")
    print_f64_approx(stats.mean_norm)
    print(" | max=")
    print_f64_approx(stats.max_norm)
    print(" | energy=")
    print_f64_approx(stats.energy)
    print(" | zeros=")
    print(stats.zero_count)
    println("")
}

// ============================================================================
// MAIN — THE EXPERIMENT
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("================================================================")
    println("  OCTONION-LABELED GRAPH THEORY: FIRST ASSOCIATOR FIELD DATA")
    println("  New mathematical construction — no prior literature exists.")
    println("================================================================")
    println("")

    // ---------------------------------------------------------------
    // Phase 1: Compute associator fields across topologies
    // ---------------------------------------------------------------
    println("--- Phase 1: Associator Field Statistics by Topology ---")
    println("")

    let seed: i64 = 42

    // Path P_8
    let g_path = make_path(8, seed)
    let s_path = compute_assoc_stats(g_path)

    // Cycle C_8
    let g_cycle = make_cycle(8, seed)
    let s_cycle = compute_assoc_stats(g_cycle)

    // Complete K_6 (smaller to avoid combinatorial explosion)
    let g_complete = make_complete(6, seed)
    let s_complete = compute_assoc_stats(g_complete)

    // Star S_8
    let g_star = make_star(8, seed)
    let s_star = compute_assoc_stats(g_star)

    // Basis-labeled K_6 (deterministic)
    let g_basis = make_basis_complete(6)
    let s_basis = compute_assoc_stats(g_basis)

    print_stats(1, s_path)
    print_stats(2, s_cycle)
    print_stats(3, s_complete)
    print_stats(4, s_star)
    print_stats(5, s_basis)

    println("")

    // ---------------------------------------------------------------
    // Phase 2: Norm invariance verification
    // ---------------------------------------------------------------
    println("--- Phase 2: Norm Invariance Theorem Verification ---")
    println("")

    print("  Path P_8:     norm invariant = ")
    if check_norm_invariance(g_path) { println("YES") } else { println("NO") }

    print("  Cycle C_8:    norm invariant = ")
    if check_norm_invariance(g_cycle) { println("YES") } else { println("NO") }

    print("  Complete K_6: norm invariant = ")
    if check_norm_invariance(g_complete) { println("YES") } else { println("NO") }

    print("  Star S_8:     norm invariant = ")
    if check_norm_invariance(g_star) { println("YES") } else { println("NO") }

    print("  Basis K_6:    norm invariant = ")
    if check_norm_invariance(g_basis) { println("YES") } else { println("NO") }

    println("")

    // ---------------------------------------------------------------
    // Phase 3: Topology-dependent patterns
    // ---------------------------------------------------------------
    println("--- Phase 3: Pattern Analysis ---")
    println("")

    // Compare: does the star (hub-spoke) have more zeros (alternativity channels)?
    print("  Star zero fraction:     ")
    if s_star.count > 0 {
        print_f64_approx((s_star.zero_count as f64) / (s_star.count as f64))
    } else { print("N/A") }
    println("")

    print("  Complete zero fraction: ")
    if s_complete.count > 0 {
        print_f64_approx((s_complete.zero_count as f64) / (s_complete.count as f64))
    } else { print("N/A") }
    println("")

    print("  Basis zero fraction:    ")
    if s_basis.count > 0 {
        print_f64_approx((s_basis.zero_count as f64) / (s_basis.count as f64))
    } else { print("N/A") }
    println("")

    // Energy density: energy / count (how concentrated is non-associativity?)
    println("")
    print("  Path energy density:     ")
    if s_path.count > 0 { print_f64_approx(s_path.energy / (s_path.count as f64)) }
    println("")
    print("  Cycle energy density:    ")
    if s_cycle.count > 0 { print_f64_approx(s_cycle.energy / (s_cycle.count as f64)) }
    println("")
    print("  Complete energy density:  ")
    if s_complete.count > 0 { print_f64_approx(s_complete.energy / (s_complete.count as f64)) }
    println("")
    print("  Star energy density:     ")
    if s_star.count > 0 { print_f64_approx(s_star.energy / (s_star.count as f64)) }
    println("")
    print("  Basis energy density:    ")
    if s_basis.count > 0 { print_f64_approx(s_basis.energy / (s_basis.count as f64)) }
    println("")

    println("")
    println("================================================================")
    println("  OBSERVATIONS (to be formalized):")
    println("  1. Norm invariance holds for ALL topologies (theorem verified)")
    println("  2. Compare mean/max/energy across topologies for patterns")
    println("  3. Zero-associator fraction reveals alternativity channels")
    println("  4. Basis-labeled graphs may show algebraic structure in zeros")
    println("================================================================")

    0
}
