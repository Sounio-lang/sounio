//@ run-pass
//!
//! First Sounio authority stream for Apple CPU cycle-interface feasibility.

use hardware::pireus::xor_selector_material_admission::{
    PireusXorMaterialFilePaths,
}
use hardware::pireus::apple_cpu_dependency_latency_request::{
    PireusAppleCpuLatencyParentPaths,
}
use hardware::pireus::apple_cpu_dependency_latency_interface_feasibility::{
    PireusAppleInterfaceDigest, PireusAppleInterfaceParentPaths,
    PIREUS_APPLE_INTERFACE_OK,
    PIREUS_APPLE_INTERFACE_PARENT_FILE_COUNT,
    PIREUS_APPLE_INTERFACE_FAMILY_COUNT,
    pireus_apple_interface_parent_file_matches,
    pireus_apple_cpu_dependency_latency_interface_feasibility_evaluate,
    pireus_apple_cpu_dependency_latency_interface_feasibility_matches_frozen_semantics,
}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(digest: &PireusAppleInterfaceDigest)
with IO, Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if i > 0 { print(":") }
        print_int(digest.words[i as usize])
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 38 {
        print("usage: pireus_apple_cpu_dependency_latency_interface_feasibility <interface-garden> <request-source> <request-semantics> <request-receipt> <request-evidence> <pdf> <xed> <darwin-receipt> <darwin-evidence> <apple-receipt> <apple-evidence> <dgx-receipt> <dgx-evidence> <request-garden> <target-cost-source> <target-cost-semantics> <target-cost-receipt> <target-cost-evidence> <material-source> <material-semantics> <material-receipt> <material-evidence> <cost-parent-garden> <cost-parent-admission-source> <cost-parent-admission-semantics> <cost-parent-admission-receipt> <cost-parent-admission-evidence> <engine-source> <engine-semantics> <engine-receipt> <operation-source> <operation-semantics> <operation-receipt> <material-parent-garden> <apple-material-receipt> <apple-material-evidence> <dgx-material-receipt> <dgx-material-evidence>\n")
        return 2
    }
    let material_files = PireusXorMaterialFilePaths {
        darwin_receipt: get_arg(7), darwin_evidence: get_arg(8),
        apple_receipt: get_arg(9), apple_evidence: get_arg(10),
        dgx_receipt: get_arg(11), dgx_evidence: get_arg(12),
    }
    let request_parents = PireusAppleCpuLatencyParentPaths {
        garden: get_arg(13),
        target_cost_source: get_arg(14),
        target_cost_semantics: get_arg(15),
        target_cost_receipt: get_arg(16),
        target_cost_evidence: get_arg(17),
        material_source: get_arg(18),
        material_semantics: get_arg(19),
        material_receipt: get_arg(20),
        material_evidence: get_arg(21),
        cost_parent_garden: get_arg(22),
        cost_parent_admission_source: get_arg(23),
        cost_parent_admission_semantics: get_arg(24),
        cost_parent_admission_receipt: get_arg(25),
        cost_parent_admission_evidence: get_arg(26),
        cost_parent_engine_source: get_arg(27),
        cost_parent_engine_semantics: get_arg(28),
        cost_parent_engine_receipt: get_arg(29),
        cost_parent_operation_source: get_arg(30),
        cost_parent_operation_semantics: get_arg(31),
        cost_parent_operation_receipt: get_arg(32),
        material_parent_garden: get_arg(33),
        material_parent_apple_receipt: get_arg(34),
        material_parent_apple_evidence: get_arg(35),
        material_parent_dgx_receipt: get_arg(36),
        material_parent_dgx_evidence: get_arg(37),
    }
    let parents = PireusAppleInterfaceParentPaths {
        garden: get_arg(0),
        request_source: get_arg(1),
        request_semantics: get_arg(2),
        request_receipt: get_arg(3),
        request_evidence: get_arg(4),
        request_parents: request_parents,
    }
    let result =
        pireus_apple_cpu_dependency_latency_interface_feasibility_evaluate(
            get_arg(5), get_arg(6), &material_files, &parents)
    var failures = result.failures
    if !result.valid || result.error != PIREUS_APPLE_INTERFACE_OK {
        failures = failures + 1
    }
    let frozen =
        pireus_apple_cpu_dependency_latency_interface_feasibility_matches_frozen_semantics(
            &result)
    if !frozen { failures = failures + 1 }

    print("SOUNIO_SEMANTIC_AUTHORITY schema=pireus.apple-cpu-interface-feasibility.v0 stage=SEMANTICS_FROZEN\n")
    print("PIREUS_APPLE_INTERFACE_FROZEN match=")
    print_int(yes(frozen)); print("\n")
    print("PIREUS_APPLE_INTERFACE_PARENTS files=")
    print_int(PIREUS_APPLE_INTERFACE_PARENT_FILE_COUNT)
    print(" matched="); print_int(result.parent_file_match_count)
    print(" request_live="); print_int(yes(result.request_parent_live))
    print(" valid="); print_int(yes(result.parent_files_valid)); print("\n")
    var i: i64 = 0
    while i < PIREUS_APPLE_INTERFACE_PARENT_FILE_COUNT {
        print("PIREUS_APPLE_INTERFACE_PARENT_FILE index="); print_int(i)
        print(" match=")
        print_int(yes(pireus_apple_interface_parent_file_matches(
            result.parent_file_match_mask, i)))
        print("\n")
        i = i + 1
    }

    print("PIREUS_APPLE_INTERFACE_REQUEST request_id=")
    print_int(result.request_ref.request_id)
    print(" target="); print_int(result.request_ref.target_id)
    print(" machine="); print_int(result.request_ref.machine_id)
    print(" engine="); print_int(result.request_ref.engine_id)
    print(" kind="); print_int(result.request_ref.engine_kind)
    print(" isa="); print_int(result.request_ref.isa_id)
    print(" subject_kind="); print_int(result.request_ref.subject_kind)
    print(" subject_node="); print_int(result.request_ref.subject_node)
    print(" quantity="); print_int(result.request_ref.quantity)
    print(" unit="); print_int(result.request_ref.unit)
    print(" scope="); print_int(result.request_ref.scope)
    print(" statistic="); print_int(result.request_ref.statistic)
    print(" samples="); print_int(result.request_ref.requested_samples)
    print(" warmups="); print_int(result.request_ref.requested_warmups)
    print(" environment=")
    print_int(result.request_ref.required_environment_mask); print("\n")

    print("PIREUS_APPLE_INTERFACE_REQUIREMENT native_unit=")
    print_int(result.requirement.required_native_unit)
    print(" counter_domain=")
    print_int(result.requirement.required_counter_domain)
    print(" read_boundary=")
    print_int(result.requirement.required_read_boundary)
    print(" multiplexing=")
    print_int(result.requirement.required_multiplexing)
    print(" core_binding=")
    print_int(result.requirement.required_core_binding)
    print(" width_evidenced=")
    print_int(yes(result.requirement.required_counter_width_evidenced))
    print(" wrap_evidenced=")
    print_int(yes(result.requirement.required_wrap_rule_evidenced))
    print(" privilege_evidenced=")
    print_int(yes(result.requirement.required_privilege_evidenced))
    print(" event_evidenced=")
    print_int(yes(result.requirement.required_event_semantics_evidenced))
    print(" valid="); print_int(yes(result.requirement_valid)); print("\n")

    print("PIREUS_APPLE_INTERFACE_MANIFEST families=")
    print_int(result.manifest.family_count)
    print(" expected="); print_int(PIREUS_APPLE_INTERFACE_FAMILY_COUNT)
    print(" closed="); print_int(yes(result.manifest.closed))
    print(" valid="); print_int(yes(result.manifest_valid)); print("\n")
    i = 0
    while i < result.manifest.family_count {
        print("PIREUS_APPLE_INTERFACE_FAMILY index="); print_int(i)
        print(" id="); print_int(result.manifest.families[i as usize])
        print("\n")
        i = i + 1
    }

    print("PIREUS_APPLE_INTERFACE_ASSESSMENT request_id=")
    print_int(result.assessment.request_id)
    print(" machine="); print_int(result.assessment.machine_id)
    print(" engine="); print_int(result.assessment.engine_id)
    print(" family_count="); print_int(result.assessment.family_count)
    print(" material_candidates=")
    print_int(result.assessment.material_candidate_count)
    print(" authorization=")
    print_int(result.assessment.execution_authorization_id)
    print(" value_present=")
    print_int(yes(result.assessment.value_present))
    print(" valid="); print_int(yes(result.assessment_valid)); print("\n")

    print("PIREUS_APPLE_INTERFACE_DECISION stage=")
    print_int(result.decision.stage)
    print(" verdict="); print_int(result.decision.verdict)
    print(" candidates="); print_int(result.decision.candidate_count)
    print(" terminal="); print_int(result.decision.complete_terminal_count)
    print(" feasible="); print_int(result.decision.feasible_count)
    print(" refusals="); print_int(result.decision.refusal_count)
    print(" ineligible="); print_int(result.decision.cycle_ineligible_count)
    print(" feasible_id="); print_int(result.decision.feasible_candidate_id)
    print(" closed="); print_int(yes(result.decision.manifest_closed))
    print(" valid="); print_int(yes(result.decision_valid)); print("\n")

    print("PIREUS_APPLE_INTERFACE_BOUNDARY observations=")
    print_int(yes(result.observations.evidence_received))
    print(" classification_requested=")
    print_int(yes(result.observations.classification_requested))
    print(" candidate_manifest=")
    print_int(result.observations.candidate_manifest_ref)
    print(" declared_candidates=")
    print_int(result.observations.declared_candidate_count)
    print(" manifest_closed=")
    print_int(yes(result.observations.manifest_closed))
    print(" remote_execution="); print_int(yes(result.remote_execution))
    print(" environment_bound="); print_int(yes(result.environment_bound))
    print(" harness_frozen="); print_int(yes(result.harness_frozen))
    print(" measurand_validated="); print_int(yes(result.measurand_validated))
    print(" execution_authorized=")
    print_int(yes(result.authorization.present))
    print(" value_present="); print_int(yes(result.cost.present))
    print(" parity_open="); print_int(yes(result.parity_open))
    print(" claim_ready="); print_int(yes(result.claim_ready)); print("\n")

    print("PIREUS_APPLE_INTERFACE_ONTOLOGY triples=")
    print_int(result.ontology_triple_count)
    print(" valid="); print_int(yes(result.ontology_valid)); print("\n")
    print("PIREUS_APPLE_INTERFACE_NEGATIVES passed=")
    print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")
    print("PIREUS_APPLE_INTERFACE_PARENT_MANIFEST_DIGEST words=")
    print_digest(&result.parent_manifest_digest); print("\n")
    print("PIREUS_APPLE_INTERFACE_ONTOLOGY_DIGEST words=")
    print_digest(&result.ontology_digest); print("\n")
    print("PIREUS_APPLE_INTERFACE_RESULT_DIGEST words=")
    print_digest(&result.result_digest); print("\n")
    print("PIREUS_APPLE_INTERFACE_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(failures); print("\n")
    if failures == 0 { 0 } else { 1 }
}
