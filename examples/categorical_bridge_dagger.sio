//@ run-pass
// CATEGORICAL BRIDGE — Part 3: Dagger Decomposition (84/84 Duality)
//
// In a dagger category (Abramsky-Coecke 2004), every morphism f: A → B
// has a "dagger" f†: B → A satisfying:
//   (f†)† = f          (involution)
//   (g ∘ f)† = f† ∘ g† (contravariance)
//   id† = id           (identity preservation)
//
// For the skew associator of Cayley-Dickson basis triples:
//   The DAGGER of triple (i, j, k) is the REVERSED triple (k, j, i).
//   If (i,j,k) has wave = +2 (forward arrow), then (k,j,i) has wave = -2 (backward).
//   If (i,j,k) is Fano (wave = 0), then (k,j,i) is also Fano (wave = 0).
//
// This gives a perfect decomposition:
//   84 forward-arrow triples  (wave = +2)
//   84 backward-arrow triples (wave = -2)
//   175 Fano triples          (wave = 0, fixed points of the dagger)
//   Total: 84 + 84 + 175 = 343
//
// The 84/84 duality is PERFECT — the dagger is an exact involution
// on the set of non-Fano triples, with no fixed points.
//
// References:
//   Selinger (2007), "Dagger Compact Closed Categories and Completely Positive Maps"
//   Karvonen (2019), "The Way of the Dagger" (PhD thesis, Edinburgh)
//   Heunen & Karvonen (2016), "Monads on Dagger Categories"

fn cd_sigma_rec(a: i32, b: i32, bits: i32) -> i32 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_rec(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_rec(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_rec(a_lo, b_lo, bits - 1) }
        else { return 0 - cd_sigma_rec(a_lo, b_lo, bits - 1) }
    }
    if b_lo == 0 { return 0 - cd_sigma_rec(b_lo, a_lo, bits - 1) }
    cd_sigma_rec(b_lo, a_lo, bits - 1)
}

fn cd_sigma(a: i32, b: i32) -> i32 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if a == b { return 0 - 1 }
    cd_sigma_rec(a, b, 3)
}

fn wave(i: i32, j: i32, k: i32) -> i32 with Mut, Panic, Div {
    let alpha = cd_sigma(i, j) * cd_sigma(i ^ j, k)
    let beta = cd_sigma(j, k) * cd_sigma(i, j ^ k)
    alpha - beta
}

fn main() -> i32 with Mut, Panic, Div, IO {
    println("=== CATEGORICAL BRIDGE Part 3: Dagger Decomposition ===")
    println("")

    var fano: i32 = 0
    var forward: i32 = 0
    var backward: i32 = 0

    // Test 1: Classify all 343 triples
    var i: i32 = 1
    while i <= 7 {
        var j: i32 = 1
        while j <= 7 {
            var k: i32 = 1
            while k <= 7 {
                let w = wave(i, j, k)
                if w == 0 { fano = fano + 1 }
                else if w == 2 { forward = forward + 1 }
                else { backward = backward + 1 }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    println("Classification:")
    println("  Fano (wave=0, dagger fixed points):")
    println(fano)
    println("  Forward arrows (wave=+2):")
    println(forward)
    println("  Backward arrows (wave=-2):")
    println(backward)
    println("")

    assert(fano == 175)
    assert(forward == 84)
    assert(backward == 84)
    assert(fano + forward + backward == 343)

    // Test 2: Dagger involution — dag(i,j,k) = (k,j,i)
    // For every forward triple, the dagger must be backward (and vice versa)
    var dagger_correct: i32 = 0
    var dagger_wrong: i32 = 0

    var i2: i32 = 1
    while i2 <= 7 {
        var j2: i32 = 1
        while j2 <= 7 {
            var k2: i32 = 1
            while k2 <= 7 {
                let w_orig = wave(i2, j2, k2)
                let w_dag = wave(k2, j2, i2)  // dagger = reverse

                if w_orig == 2 {
                    // Forward → dagger should be backward
                    if w_dag == 0 - 2 { dagger_correct = dagger_correct + 1 }
                    else { dagger_wrong = dagger_wrong + 1 }
                } else if w_orig == 0 - 2 {
                    // Backward → dagger should be forward
                    if w_dag == 2 { dagger_correct = dagger_correct + 1 }
                    else { dagger_wrong = dagger_wrong + 1 }
                } else {
                    // Fano → dagger should also be Fano
                    if w_dag == 0 { dagger_correct = dagger_correct + 1 }
                    else { dagger_wrong = dagger_wrong + 1 }
                }

                k2 = k2 + 1
            }
            j2 = j2 + 1
        }
        i2 = i2 + 1
    }

    println("Dagger involution test (dag(i,j,k) = (k,j,i)):")
    println("  Correct:")
    println(dagger_correct)
    println("  Wrong:")
    println(dagger_wrong)
    println("")

    assert(dagger_wrong == 0)
    assert(dagger_correct == 343)

    // Test 3: Double dagger = identity — dag(dag(i,j,k)) = (i,j,k)
    // wave(i,j,k) should equal wave(i,j,k) after dag(dag(...))
    // dag(dag(i,j,k)) = dag(k,j,i) = (i,j,k) — trivially true by definition
    // But let's verify computationally that wave is preserved
    var double_dag_ok: i32 = 0
    var double_dag_fail: i32 = 0

    var i3: i32 = 1
    while i3 <= 7 {
        var j3: i32 = 1
        while j3 <= 7 {
            var k3: i32 = 1
            while k3 <= 7 {
                let w_orig = wave(i3, j3, k3)
                // dag(dag(i,j,k)) = dag(k,j,i) = (i,j,k)
                let w_double = wave(i3, j3, k3)  // should be identical

                if w_orig == w_double { double_dag_ok = double_dag_ok + 1 }
                else { double_dag_fail = double_dag_fail + 1 }

                k3 = k3 + 1
            }
            j3 = j3 + 1
        }
        i3 = i3 + 1
    }

    assert(double_dag_fail == 0)

    // Test 4: No non-Fano triple is its own dagger
    // If wave(i,j,k) ≠ 0, then (i,j,k) ≠ (k,j,i) as directed triples
    var self_dual_nonfano: i32 = 0

    var i4: i32 = 1
    while i4 <= 7 {
        var j4: i32 = 1
        while j4 <= 7 {
            var k4: i32 = 1
            while k4 <= 7 {
                let w = wave(i4, j4, k4)
                if w != 0 {
                    // This triple is non-Fano
                    // Is it equal to its dagger (k,j,i)?
                    if i4 == k4 {
                        // (i,j,k) = (k,j,i) only when i=k
                        // But then wave should be... let's check
                        let w_dag = wave(k4, j4, i4)
                        if w == w_dag { self_dual_nonfano = self_dual_nonfano + 1 }
                    }
                }
                k4 = k4 + 1
            }
            j4 = j4 + 1
        }
        i4 = i4 + 1
    }

    println("Non-Fano triples that are their own dagger (wave preserved):")
    println(self_dual_nonfano)
    println("")
    assert(self_dual_nonfano == 0)

    println("=== ALL ASSERTIONS PASSED ===")
    println("")
    println("DAGGER DECOMPOSITION OF 343 TRIPLES:")
    println("")
    println("  175 FANO triples — fixed points of the dagger")
    println("    dag(i,j,k) = (k,j,i) has wave = 0 (same as original)")
    println("    These are SELF-DUAL: the dagger doesn't change them")
    println("    Categorically: these morphisms are UNITARY (f† = f⁻¹)")
    println("")
    println("  84 FORWARD arrows (wave = +2)")
    println("  84 BACKWARD arrows (wave = -2)")
    println("    The dagger maps each forward arrow to its backward dual")
    println("    No non-Fano triple is self-dual (no fixed points)")
    println("    The dagger is a FREE INVOLUTION on the 168 non-Fano triples")
    println("")
    println("  PERFECT SYMMETRY:")
    println("    The number of forward arrows EQUALS the number of backward arrows")
    println("    The algebra has no preferred direction")
    println("    If there is an arrow of time, it comes from the OBSERVER's choice")
    println("    of which mode (synthesis/checking) is called 'forward'")

    0
}
