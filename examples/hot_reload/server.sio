// examples/hot_reload/server.sio
// Hot reload example: HTTP server with preserved state
//
// Run: sou hot server.sio
// Then edit this file and watch it reload without losing connections!

use io
use string

// Server state (preserved across reloads)
struct ServerState {
    connections: i64,
    requests: i64,
    start_time: i64,
    version: i64,
}

// Global state (in real implementation, this would be managed by runtime)
var state = ServerState {
    connections: 0,
    requests: 0,
    start_time: 0,
    version: 1,
}

fn main() with IO {
    println("╔══════════════════════════════════════════════════════════════╗")
    println("║           🔥 HOT RELOAD SERVER EXAMPLE 🔥                    ║")
    println("║                                                              ║")
    println("║  Try editing this file while running!                        ║")
    println("║  State will be preserved across reloads.                     ║")
    println("╚══════════════════════════════════════════════════════════════╝")
    println("")
    
    // Initialize or restore state
    if state.start_time == 0 {
        state.start_time = now()
        println("🚀 Server starting fresh (v" + int_to_string(state.version) + ")")
    } else {
        state.version = state.version + 1
        println("🔄 Server reloaded (v" + int_to_string(state.version) + ")")
    }
    
    println("")
    println("State:")
    println("  Connections: " + int_to_string(state.connections))
    println("  Requests:    " + int_to_string(state.requests))
    println("  Uptime:      " + format_uptime(now() - state.start_time))
    println("")
    
    // Simulate request handling loop
    println("Handling requests... (Press Ctrl+C to stop)")
    println("")
    
    var counter: i64 = 0
    while true {
        // Simulate request
        sleep(1000)  // 1 second
        counter = counter + 1
        state.requests = state.requests + 1
        
        println("[" + int_to_string(counter) + "] Request #" + 
                int_to_string(state.requests) + " handled (v" + 
                int_to_string(state.version) + ")")
        
        // TODO: In real implementation, state would be automatically
        // serialized and restored on reload by the hot reload runtime
    }
}

// Helper: Current timestamp
fn now() -> i64 with IO {
    // Placeholder - would use actual system time
    0
}

// Helper: Sleep for milliseconds
fn sleep(ms: i64) with IO {
    // Placeholder - would use actual sleep
    ()
}

// Helper: Format uptime
fn format_uptime(seconds: i64) -> string {
    if seconds < 60 {
        int_to_string(seconds) + "s"
    } else if seconds < 3600 {
        int_to_string(seconds / 60) + "m " + int_to_string(seconds % 60) + "s"
    } else {
        int_to_string(seconds / 3600) + "h " + 
        int_to_string((seconds % 3600) / 60) + "m"
    }
}

// Helper: Convert int to string
fn int_to_string(n: i64) -> string with Mut, Panic, Div {
    if n == 0 {
        "0"
    } else {
        let negative = n < 0
        var num = if negative { -n } else { n }
        var result = ""
        while num > 0 {
            let digit = num % 10
            let ch = 48 + digit
            result = char_from_i64(ch) + result
            num = num / 10
        }
        if negative { "-" + result } else { result }
    }
}

fn char_from_i64(n: i64) -> string with Mut, Panic {
    str_substr("0123456789", n, 1)
}
