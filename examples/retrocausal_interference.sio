//@ run-pass
// THE RETROCAUSAL INTERFERENCE PATTERN
//
// The arrow of time is a standing wave formed by:
//   Forward wave:  alpha(i,j,k) = sigma(i,j) * sigma(i^j, k)   (past→future)
//   Backward wave: beta(i,j,k)  = sigma(j,k) * sigma(i, j^k)   (future→past)
//   Associator:    alpha - beta  (the interference)
//
// At Fano nodes:     alpha = beta  → interference = 0  → transaction complete
// At non-Fano:       alpha = -beta → interference = ±2 → transaction incomplete
//
// This program makes the standing wave VISIBLE.

fn cd_sigma(a: i32, b: i32) -> i32 with Mut, Panic, Div {
    // Full recursive CD sign function (same as T_7 verification)
    if a == 0 || b == 0 { return 1 }
    if a == b { return 0 - 1 }  // e_i * e_i = -1 for all imaginary units

    // Recurse using CD doubling: bits=3 for octonions
    cd_sigma_rec(a, b, 3)
}

fn cd_sigma_rec(a: i32, b: i32, bits: i32) -> i32 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_rec(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_rec(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_rec(a_lo, b_lo, bits - 1) }
        else { return 0 - cd_sigma_rec(a_lo, b_lo, bits - 1) }
    }
    // both hi
    if b_lo == 0 { return 0 - cd_sigma_rec(b_lo, a_lo, bits - 1) }
    else { return cd_sigma_rec(b_lo, a_lo, bits - 1) }
}

fn main() -> i32 with Mut, Panic, Div, IO {
    println("=== THE RETROCAUSAL INTERFERENCE PATTERN ===")
    println("")
    println("For each triple (i,j,k), i,j,k in {1..7}:")
    println("  alpha = past->future phase")
    println("  beta  = future->past phase")
    println("  wave  = alpha - beta (the interference)")
    println("")
    println("Legend: [+] = complete transaction (wave=0)")
    println("        [>] = arrow forward (wave=+2, past dominates)")
    println("        [<] = arrow backward (wave=-2, future dominates)")
    println("")

    var complete: i32 = 0
    var arrow_fwd: i32 = 0
    var arrow_bwd: i32 = 0

    // For phi=e1, psi=e2 fixed: show the interference for each observable direction
    println("--- Observer pair: phi=e1, psi=e2 ---")
    println("  Observable  alpha  beta  wave  status")

    var k: i32 = 1
    while k <= 7 {
        let alpha = cd_sigma(1, k) * cd_sigma(1 ^ k, 2)
        let beta = cd_sigma(k, 2) * cd_sigma(1, k ^ 2)
        let wave = alpha - beta

        println(k)
        println(alpha)
        println(beta)
        println(wave)

        if wave == 0 {
            println("  COMPLETE")
        } else if wave > 0 {
            println("  ARROW >>")
        } else {
            println("  ARROW <<")
        }

        k = k + 1
    }

    println("")
    println("--- Full 343 triples: interference statistics ---")
    println("")

    var i: i32 = 1
    while i <= 7 {
        var j: i32 = 1
        while j <= 7 {
            var kk: i32 = 1
            while kk <= 7 {
                let alpha = cd_sigma(i, j) * cd_sigma(i ^ j, kk)
                let beta = cd_sigma(j, kk) * cd_sigma(i, j ^ kk)
                let wave = alpha - beta

                if wave == 0 { complete = complete + 1 }
                else if wave > 0 { arrow_fwd = arrow_fwd + 1 }
                else { arrow_bwd = arrow_bwd + 1 }

                kk = kk + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    println("Complete transactions (wave=0, time-symmetric):")
    println(complete)
    println("Arrow forward (wave=+2, past dominates):")
    println(arrow_fwd)
    println("Arrow backward (wave=-2, future dominates):")
    println(arrow_bwd)
    println("")

    // KEY CHECK: is the pattern symmetric between forward and backward?
    if arrow_fwd == arrow_bwd {
        println("FORWARD = BACKWARD: The arrow is symmetric!")
        println("  84 forward + 84 backward = 168 total arrows")
        println("")
        println("This means: for every triple where past dominates,")
        println("there is a DUAL triple where future dominates.")
        println("The octonionic arrow of time is BALANCED.")
        println("Half the non-associative measurements favor the past.")
        println("Half favor the future.")
        println("")
        println("The standing wave has equal amplitude in both directions.")
        println("Time has no preferred arrow IN THE ALGEBRA.")
        println("The asymmetry (if any) must come from BOUNDARY CONDITIONS,")
        println("not from the algebraic structure.")
    } else {
        println("ASYMMETRIC: forward != backward")
        println(arrow_fwd)
        println(arrow_bwd)
    }

    println("")
    println("=== VERIFICATION ===")
    assert(complete == 175)
    assert(arrow_fwd + arrow_bwd == 168)
    println("175 + 168 = 343. Verified.")
    println("")

    // THE DEEPEST CHECK: the forward/backward duality
    // For each (i,j,k) with wave=+2, is (k,j,i) wave=-2?
    var dual_holds: i32 = 0
    var dual_fails: i32 = 0

    var ii: i32 = 1
    while ii <= 7 {
        var jj: i32 = 1
        while jj <= 7 {
            var kk2: i32 = 1
            while kk2 <= 7 {
                let alpha1 = cd_sigma(ii, jj) * cd_sigma(ii ^ jj, kk2)
                let beta1 = cd_sigma(jj, kk2) * cd_sigma(ii, jj ^ kk2)
                let wave1 = alpha1 - beta1

                if wave1 == 2 {
                    // Check the reversed triple
                    let alpha2 = cd_sigma(kk2, jj) * cd_sigma(kk2 ^ jj, ii)
                    let beta2 = cd_sigma(jj, ii) * cd_sigma(kk2, jj ^ ii)
                    let wave2 = alpha2 - beta2

                    if wave2 == 0 - 2 {
                        dual_holds = dual_holds + 1
                    } else {
                        dual_fails = dual_fails + 1
                    }
                }
                kk2 = kk2 + 1
            }
            jj = jj + 1
        }
        ii = ii + 1
    }

    println("=== TIME-REVERSAL DUALITY ===")
    println("For each forward-arrow triple (i,j,k):")
    println("  Does the reversed triple (k,j,i) have backward arrow?")
    println("")
    println("Duality holds:")
    println(dual_holds)
    println("Duality fails:")
    println(dual_fails)

    if dual_fails == 0 {
        println("")
        println("PERFECT DUALITY.")
        println("Every forward arrow has a backward dual.")
        println("Time reversal swaps the parenthesization direction.")
        println("The standing wave is EXACTLY symmetric.")
        println("")
        println("The arrow of time is not intrinsic to the algebra.")
        println("It emerges from the CHOICE of which parenthesization")
        println("is called 'forward' and which 'backward.'")
        println("The algebra itself is time-reversal invariant.")
        println("The arrow is in the observer, not in the observed.")
    }

    0
}
