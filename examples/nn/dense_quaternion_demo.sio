// Demo for stdlib/nn/dense_quaternion.sio
//
// This file demonstrates usage of the nn::dense_quaternion module.
// Module source: stdlib/nn/dense_quaternion.sio

// ============================================================================

fn main() -> i32 {
    println("=== Dense Quaternion Layer Tests ===")
    println("")
    
    let mut ok = true
    
    // Test 1: Basic layer creation
    println("Test 1: Layer creation")
    let layer = dense_quaternion_new(2, 3, ActivationFunction::ReLU)
    let info = dense_quaternion_info(layer)
    println("  Input size: ")
    println(info.input_size)
    println("  Output size: ")
    println(info.output_size)
    println("  Total parameters: ")
    println(info.total_params)
    
    if info.input_size != 2 || info.output_size != 3 {
        ok = false; println("  FAIL: layer dimensions")
    }
    println("")
    
    // Test 2: Forward pass
    println("Test 2: Forward pass")
    let input = vec![
        quaternion_exact(1.0, 0.5, 0.0, 0.1),
        quaternion_exact(0.0, 1.0, 0.5, 0.0)
    ]
    let output = dense_quaternion_forward(layer, input)
    println("  Output length: ")
    println(output.len())
    
    if output.len() != 3 {
        ok = false; println("  FAIL: output size")
    }
    println("")
    
    // Test 3: MLP creation
    println("Test 3: MLP creation")
    let architecture = vec![2, 4, 3, 1]
    let mlp = quaternion_mlp_new(architecture)
    println("  Architecture: [2, 4, 3, 1]")
    println("  Number of layers: ")
    println(mlp.layer_count)
    
    if mlp.layer_count != 3 {
        ok = false; println("  FAIL: MLP layer count")
    }
    println("")
    
    // Test 4: MLP forward pass
    println("Test 4: MLP forward pass")
    let mlp_input = vec![
        quaternion_exact(1.0, 0.0, 0.0, 0.0),
        quaternion_exact(0.0, 1.0, 0.0, 0.0)
    ]
    let mlp_output = quaternion_mlp_predict(mlp, mlp_input)
    println("  MLP output length: ")
    println(mlp_output.len())
    
    if mlp_output.len() != 1 {
        ok = false; println("  FAIL: MLP output size")
    }
    println("")
    
    // Test 5: Loss functions
    println("Test 5: Loss functions")
    let pred = vec![quaternion_exact(1.0, 0.5, 0.0, 0.0)]
    let targ = vec![quaternion_exact(0.8, 0.3, 0.1, 0.0)]
    let mse = quaternion_mse_loss(pred, targ)
    let mae = quaternion_mae_loss(pred, targ)
    
    println("  MSE loss: ")
    println(mse)
    println("  MAE loss: ")
    println(mae)
    
    if mse < 0.0 || mae < 0.0 {
        ok = false; println("  FAIL: negative losses")
    }
    println("")
    
    if ok {
        println("ALL DENSE QUATERNION TESTS PASSED")
        return 0
    } else {
        println("SOME DENSE QUATERNION TESTS FAILED")
        return 1
    }
}