// Demo for stdlib/nn/optimizers_quaternion.sio
//
// This file demonstrates usage of the nn::optimizers_quaternion module.
// Module source: stdlib/nn/optimizers_quaternion.sio

// ============================================================================

fn main() -> i32 {
    println("=== Quaternion Optimizer Tests ===")
    println("")
    
    var ok = true
    
    // Test 1: Adam optimizer creation
    println("Test 1: Adam optimizer creation")
    let param_count = 100
    let optimizer = adam_quaternion_default(param_count)
    
    println("  Learning rate: ")
    println(optimizer.learning_rate)
    println("  Beta1: ")
    println(optimizer.beta1)
    println("  Beta2: ")
    println(optimizer.beta2)
    
    if optimizer.param_count != param_count {
        ok = false; println("  FAIL: parameter count")
    }
    println("")
    
    // Test 2: PBPK loss functions
    println("Test 2: PBPK spatial loss")
    let pred_spatial = vec![
        vec![quaternion_exact(1.0, 0.0, 0.0, 0.0), quaternion_exact(0.5, 0.0, 0.0, 0.0)],
        vec![quaternion_exact(0.8, 0.0, 0.0, 0.0), quaternion_exact(0.3, 0.0, 0.0, 0.0)]
    ]
    let targ_spatial = vec![
        vec![quaternion_exact(1.1, 0.0, 0.0, 0.0), quaternion_exact(0.4, 0.0, 0.0, 0.0)],
        vec![quaternion_exact(0.9, 0.0, 0.0, 0.0), quaternion_exact(0.2, 0.0, 0.0, 0.0)]
    ]
    
    let spatial_loss = pbpk_spatial_loss(pred_spatial, targ_spatial)
    println("  PBPK spatial loss: ")
    println(spatial_loss)
    
    if spatial_loss < 0.0 {
        ok = false; println("  FAIL: negative loss")
    }
    println("")
    
    // Test 3: PBPK temporal loss
    println("Test 3: PBPK temporal loss")
    let pred_temporal = vec![
        vec![
            quaternion_exact(0.0, 0.0, 0.0, 0.0),
            quaternion_exact(0.5, 0.0, 0.0, 0.0),
            quaternion_exact(0.8, 0.0, 0.0, 0.0),
            quaternion_exact(1.0, 0.0, 0.0, 0.0)
        ]
    ]
    let targ_temporal = vec![
        vec![
            quaternion_exact(0.0, 0.0, 0.0, 0.0),
            quaternion_exact(0.4, 0.0, 0.0, 0.0),
            quaternion_exact(0.9, 0.0, 0.0, 0.0),
            quaternion_exact(1.1, 0.0, 0.0, 0.0)
        ]
    ]
    
    let temporal_loss = pbpk_temporal_loss(pred_temporal, targ_temporal)
    println("  PBPK temporal loss: ")
    println(temporal_loss)
    
    if temporal_loss < 0.0 {
        ok = false; println("  FAIL: negative loss")
    }
    println("")
    
    // Test 4: Combined loss
    println("Test 4: Combined PBPK loss")
    let combined_loss = pbpk_combined_loss(pred_spatial, targ_spatial, 0.7, 0.3)
    println("  Combined loss (0.7 spatial, 0.3 temporal): ")
    println(combined_loss)
    
    if combined_loss < 0.0 {
        ok = false; println("  FAIL: negative combined loss")
    }
    println("")
    
    if ok {
        println("ALL OPTIMIZER TESTS PASSED")
        return 0
    } else {
        println("SOME OPTIMIZER TESTS FAILED")
        return 1
    }
}