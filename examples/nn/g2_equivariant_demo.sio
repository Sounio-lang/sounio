// Demo for stdlib/nn/g2_equivariant.sio
//
// This file demonstrates G2-equivariant neural network layers.
// Module source: stdlib/nn/g2_equivariant.sio
//
// G2-equivariant layers preserve the exceptional Lie group G2 symmetry,
// which is important for physics-informed machine learning and octonion
// neural networks.

// Test that G2-equivariant activations preserve norm multiplicativity
fn demo_g2_equivariance() -> i32 with Panic {
    // Create test octonions
    let o1 = oct(1.0, 0.5, 0.3, 0.2, 0.1, 0.15, 0.25, 0.05)
    let o2 = oct(0.5, 0.6, 0.4, 0.3, 0.2, 0.1, 0.1, 0.1)

    // Unit rotation (normalized)
    let u = oct_normalize_safe(oct(0.5, 0.3, 0.2, 0.1, 0.1, 0.2, 0.3, 0.4), 0.0001)

    // Apply G2 rotation
    let o1_rot = oct_rotate(u, o1)
    let o2_rot = oct_rotate(u, o2)

    // Verify norms preserved
    let norm1_orig = oct_norm(o1)
    let norm1_rot = oct_norm(o1_rot)
    let diff1 = norm1_orig - norm1_rot
    let abs_diff1 = if diff1 < 0.0 { -diff1 } else { diff1 }

    // Verify magnitude ReLU preserves direction
    let o1_relu = oct_relu_g2(o1, 0.1)
    let norm_relu = oct_norm(o1_relu)
    let norm_orig = oct_norm(o1)

    // ReLU should preserve or zero
    let valid: i32 = if abs_diff1 < 0.001 { 0 } else { 1 }
    valid
}

fn main() -> i32 with Panic {
    demo_g2_equivariance()
}
