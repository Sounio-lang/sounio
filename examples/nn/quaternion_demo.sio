// Demo for stdlib/nn/quaternion.sio
//
// This file demonstrates usage of the nn::quaternion module.
// Module source: stdlib/nn/quaternion.sio

// ============================================================================

fn main() -> i32 {
    println("=== Quaternion Neural Network Tests ===")
    println("")
    
    var ok = true
    
    // Test 1: Basic quaternion operations
    println("Test 1: Basic operations")
    let q1 = quaternion_exact(1.0, 0.0, 0.0, 0.0)  // Identity
    let q2 = quaternion_exact(0.0, 1.0, 0.0, 0.0)  // Pure i
    let q3 = quaternion_mul(q1, q2)
    
    println("  q1 * q2 = (")
    println(quaternion_get_w(q3))
    println(", ")
    println(quaternion_get_x(q3))
    println(", ")
    println(quaternion_get_y(q3))
    println(", ")
    println(quaternion_get_z(q3))
    println(")")
    
    if abs_f64(quaternion_get_x(q3) - 1.0) > 0.001 { ok = false; println("  FAIL: multiplication") }
    println("")
    
    // Test 2: Norm calculation
    println("Test 2: Norm calculation")
    let q4 = quaternion_exact(1.0, 1.0, 1.0, 1.0)
    let norm = quaternion_norm(q4)
    let expected_norm = sqrt_f64(4.0)
    println("  ||q|| = ")
    println(norm.value)
    println("  expected = ")
    println(expected_norm)
    if abs_f64(norm.value - expected_norm) > 0.01 { ok = false; println("  FAIL: norm") }
    println("")
    
    // Test 3: Rotation
    println("Test 3: Vector rotation")
    let q_rot = quaternion_from_axis_angle(3.14159 / 2.0, 0.0, 0.0, 1.0)  // 90° around z
    let (rx, ry, rz) = quaternion_rotate_vector(q_rot, 1.0, 0.0, 0.0)     // Rotate (1,0,0)
    println("  Rotating (1,0,0) by 90° around z-axis = (")
    println(rx.value)
    println(", ")
    println(ry.value)
    println(", ")
    println(rz.value)
    println(")")
    // Should be approximately (0, 1, 0)
    if abs_f64(rx.value) > 0.1 || abs_f64(ry.value - 1.0) > 0.1 || abs_f64(rz.value) > 0.1 {
        ok = false; println("  FAIL: rotation")
    }
    println("")
    
    // Test 4: Uncertainty propagation
    println("Test 4: Uncertainty propagation")
    let q_uncertain = quaternion_uncertain(1.0, 0.1, 0.9, 0.0, 0.0, 0.9, 0.0, 0.0, 0.9, 0.0, 0.0, 0.9)
    let q_double = quaternion_add(q_uncertain, q_uncertain)
    println("  w uncertainty doubled: ")
    println(q_double.w.std_u)
    if q_double.w.std_u < q_uncertain.w.std_u { ok = false; println("  FAIL: uncertainty propagation") }
    println("")
    
    // Test 5: Activation functions
    println("Test 5: Activation functions")
    let q_neg = quaternion_exact(-1.0, -0.5, 0.0, 0.5)
    let q_relu = quaternion_relu(q_neg)
    println("  ReLU(-1, -0.5, 0, 0.5) = (")
    println(quaternion_get_w(q_relu))
    println(", ")
    println(quaternion_get_x(q_relu))
    println(", ")
    println(quaternion_get_y(q_relu))
    println(", ")
    println(quaternion_get_z(q_relu))
    println(")")
    if quaternion_get_w(q_relu) > 0.001 || quaternion_get_x(q_relu) > 0.001 {
        ok = false; println("  FAIL: ReLU should zero negative components")
    }
    println("")
    
    if ok {
        println("ALL QUATERNION TESTS PASSED")
        return 0
    } else {
        println("SOME QUATERNION TESTS FAILED")
        return 1
    }
}
