// Test autodiff with transcendental functions
// f(x) = sin(x^2)
// f'(x) = cos(x^2) * 2x  [chain rule]
// At x = 1: f(1) = sin(1) ≈ 0.8414
//           f'(1) = cos(1) * 2 ≈ 1.0806

fn main() {
    println("=== Autodiff: derivative of sin(x^2) at x=1 ===")

    let x: f64 = 1.0

    // Create dual number with seed
    let x_dual = dual(x, 1.0)

    // Compute x^2
    let x2 = dual_mul(x_dual, x_dual)

    // Compute sin(x^2)
    let result = dual_sin(x2)

    let value = dual_value(result)
    let derivative = dual_deriv(result)

    println("f(x) = sin(x^2) at x=1:")
    println("  Value f(1) = ")
    println(value)
    println("  Derivative f'(1) = ")
    println(derivative)

    println("Expected: value ≈ 0.8414, derivative ≈ 1.0806")
}
