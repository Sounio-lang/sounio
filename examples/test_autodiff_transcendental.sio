// Test autodiff with transcendental functions
// f(x) = sin(x^2)
// f'(x) = cos(x^2) * 2x  [chain rule]
// At x = 1: f(1) = sin(1) ≈ 0.8414
//           f'(1) = cos(1) * 2 ≈ 1.0806

// --- Autodiff preamble ---
fn sin_f64(x: f64) -> f64 {
    let pi = 3.141592653589793
    var y = x
    while y > pi { y = y - 2.0 * pi }
    while y < 0.0 - pi { y = y + 2.0 * pi }
    let x2 = y * y; var sum = y; var term = y
    term = term * (0.0 - x2) / (2.0 * 3.0); sum = sum + term
    term = term * (0.0 - x2) / (4.0 * 5.0); sum = sum + term
    term = term * (0.0 - x2) / (6.0 * 7.0); sum = sum + term
    term = term * (0.0 - x2) / (8.0 * 9.0); sum = sum + term
    term = term * (0.0 - x2) / (10.0 * 11.0); sum = sum + term
    return sum
}
fn cos_f64(x: f64) -> f64 {
    let pi = 3.141592653589793
    var y = x
    while y > pi { y = y - 2.0 * pi }
    while y < 0.0 - pi { y = y + 2.0 * pi }
    let x2 = y * y; var sum = 1.0; var term = 1.0
    term = term * (0.0 - x2) / (1.0 * 2.0); sum = sum + term
    term = term * (0.0 - x2) / (3.0 * 4.0); sum = sum + term
    term = term * (0.0 - x2) / (5.0 * 6.0); sum = sum + term
    term = term * (0.0 - x2) / (7.0 * 8.0); sum = sum + term
    term = term * (0.0 - x2) / (9.0 * 10.0); sum = sum + term
    return sum
}
struct Dual { val: f64, dot: f64 }
fn dual(val: f64, dot: f64) -> Dual { return Dual { val: val, dot: dot } }
fn dual_value(d: Dual) -> f64 { return d.val }
fn dual_deriv(d: Dual) -> f64 { return d.dot }
fn dual_mul(a: Dual, b: Dual) -> Dual {
    return Dual { val: a.val * b.val, dot: a.dot * b.val + a.val * b.dot }
}
fn dual_sin(a: Dual) -> Dual {
    return Dual { val: sin_f64(a.val), dot: a.dot * cos_f64(a.val) }
}
// --- End preamble ---

fn main() {
    println("=== Autodiff: derivative of sin(x^2) at x=1 ===")

    let x: f64 = 1.0

    // Create dual number with seed
    let x_dual = dual(x, 1.0)

    // Compute x^2
    let x2 = dual_mul(x_dual, x_dual)

    // Compute sin(x^2)
    let result = dual_sin(x2)

    let value = dual_value(result)
    let derivative = dual_deriv(result)

    println("f(x) = sin(x^2) at x=1:")
    println("  Value f(1) = ")
    println(value)
    println("  Derivative f'(1) = ")
    println(derivative)

    println("Expected: value ≈ 0.8414, derivative ≈ 1.0806")
}
