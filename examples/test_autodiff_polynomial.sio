// Test autodiff: derivative of polynomial f(x) = x^3 + 2x^2 - 5x + 3
// f'(x) = 3x^2 + 4x - 5
// At x = 2: f(2) = 8 + 8 - 10 + 3 = 9
//           f'(2) = 12 + 8 - 5 = 15

fn main() {
    println("=== Autodiff: derivative of x^3 + 2x^2 - 5x + 3 at x=2 ===")

    let x: f64 = 2.0

    // Create dual number with seed
    let x_dual = dual(x, 1.0)

    // x^2
    let x2 = dual_mul(x_dual, x_dual)

    // x^3 = x * x^2
    let x3 = dual_mul(x_dual, x2)

    // 2x^2 (need to wrap 2.0 as dual with deriv=0)
    let two = dual(2.0, 0.0)
    let two_x2 = dual_mul(two, x2)

    // 5x
    let five = dual(5.0, 0.0)
    let five_x = dual_mul(five, x_dual)

    // 3 (constant)
    let three = dual(3.0, 0.0)

    // f(x) = x^3 + 2x^2 - 5x + 3
    let term1 = dual_add(x3, two_x2)
    let term2 = dual_sub(term1, five_x)
    let result = dual_add(term2, three)

    let value = dual_value(result)
    let derivative = dual_deriv(result)

    println("f(x) = x^3 + 2x^2 - 5x + 3 at x=2:")
    println("  Value f(2) = ")
    println(value)
    println("  Derivative f'(2) = ")
    println(derivative)

    println("Expected: value=9, derivative=15")
}
