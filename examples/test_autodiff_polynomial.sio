// Test autodiff: derivative of polynomial f(x) = x^3 + 2x^2 - 5x + 3
// f'(x) = 3x^2 + 4x - 5
// At x = 2: f(2) = 8 + 8 - 10 + 3 = 9
//           f'(2) = 12 + 8 - 5 = 15

// --- Autodiff preamble ---
fn exp_f64(x: f64) -> f64 {
    if x > 20.0 { return exp_f64(x / 2.0) * exp_f64(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / exp_f64(0.0 - x) }
    var sum = 1.0; var term = 1.0
    term = term * x / 1.0; sum = sum + term; term = term * x / 2.0; sum = sum + term
    term = term * x / 3.0; sum = sum + term; term = term * x / 4.0; sum = sum + term
    term = term * x / 5.0; sum = sum + term; term = term * x / 6.0; sum = sum + term
    term = term * x / 7.0; sum = sum + term; term = term * x / 8.0; sum = sum + term
    term = term * x / 9.0; sum = sum + term; term = term * x / 10.0; sum = sum + term
    return sum
}
fn ln_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 - 1000000.0 }
    var val = x; var k = 0.0; let e = 2.718281828459045
    while val > e { val = val / e; k = k + 1.0 }
    while val < 1.0 / e { val = val * e; k = k - 1.0 }
    let u = (val - 1.0) / (val + 1.0); let u2 = u * u
    var sum = u; var term = u
    term = term * u2; sum = sum + term / 3.0; term = term * u2; sum = sum + term / 5.0
    term = term * u2; sum = sum + term / 7.0; term = term * u2; sum = sum + term / 9.0
    return 2.0 * sum + k
}
fn pow_f64(x: f64, n: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    return exp_f64(n * ln_f64(x))
}
struct Dual { val: f64, dot: f64 }
fn dual(val: f64, dot: f64) -> Dual { return Dual { val: val, dot: dot } }
fn dual_value(d: Dual) -> f64 { return d.val }
fn dual_deriv(d: Dual) -> f64 { return d.dot }
fn dual_add(a: Dual, b: Dual) -> Dual { return Dual { val: a.val + b.val, dot: a.dot + b.dot } }
fn dual_sub(a: Dual, b: Dual) -> Dual { return Dual { val: a.val - b.val, dot: a.dot - b.dot } }
fn dual_mul(a: Dual, b: Dual) -> Dual {
    return Dual { val: a.val * b.val, dot: a.dot * b.val + a.val * b.dot }
}
// --- End preamble ---

fn main() {
    println("=== Autodiff: derivative of x^3 + 2x^2 - 5x + 3 at x=2 ===")

    let x: f64 = 2.0

    // Create dual number with seed
    let x_dual = dual(x, 1.0)

    // x^2
    let x2 = dual_mul(x_dual, x_dual)

    // x^3 = x * x^2
    let x3 = dual_mul(x_dual, x2)

    // 2x^2 (need to wrap 2.0 as dual with deriv=0)
    let two = dual(2.0, 0.0)
    let two_x2 = dual_mul(two, x2)

    // 5x
    let five = dual(5.0, 0.0)
    let five_x = dual_mul(five, x_dual)

    // 3 (constant)
    let three = dual(3.0, 0.0)

    // f(x) = x^3 + 2x^2 - 5x + 3
    let term1 = dual_add(x3, two_x2)
    let term2 = dual_sub(term1, five_x)
    let result = dual_add(term2, three)

    let value = dual_value(result)
    let derivative = dual_deriv(result)

    println("f(x) = x^3 + 2x^2 - 5x + 3 at x=2:")
    println("  Value f(2) = ")
    println(value)
    println("  Derivative f'(2) = ")
    println(derivative)

    println("Expected: value=9, derivative=15")
}
