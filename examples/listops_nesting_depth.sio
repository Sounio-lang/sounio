//@ run-pass
//@ expect-stdout: ALL PASS

// ListOps Nesting Depth: Compare 0-nesting (flat) vs 1-nesting vs 2-nesting
// See if O-SSM advantage scales with nesting complexity

fn exp_q(x: f64) -> f64 with Mut, Div, Panic {
    if x > 15.0 { return exp_q(7.5) * exp_q(x - 7.5) }
    if x < 0.0 - 15.0 { return 0.0 }
    var sum = 1.0; var term = 1.0; var i = 1
    while i <= 20 { term = term * x / (i as f64); sum = sum + term; i = i + 1 }
    sum
}

var RNG_A: i64 = 0; var RNG_B: i64 = 0
fn rng_seed(a: i64, b: i64) with Mut { RNG_A = a; RNG_B = b }
fn rng_next() -> i64 with Mut {
    var x = RNG_A; let y = RNG_B; RNG_A = y
    x = x ^ (x << 23); x = x ^ (x >> 17); x = x ^ (y ^ (y >> 26))
    RNG_B = x; let r = x + y; if r < 0 { 0 - r } else { r }
}

var SEQ: [i64; 32] = [0; 32]; var SEQ_POS: i64 = 0

fn min_val(a: i64, b: i64) -> i64 { if a < b { a } else { b } }
fn max_val(a: i64, b: i64) -> i64 { if a > b { a } else { b } }
fn compute_med3(a: i64, b: i64, c: i64) -> i64 {
    if a <= b { if b <= c { b } else { if a <= c { c } else { a } } }
    else { if a <= c { a } else { if b <= c { c } else { b } } }
}

fn apply_op(op: i64, vals: i64, v0: i64, v1: i64, v2: i64) -> i64 with Mut {
    if op == 10 {
        var r = v0
        if vals >= 2 { r = min_val(r, v1) }
        if vals >= 3 { r = min_val(r, v2) }
        r
    } else {
        if op == 11 {
            var r = v0
            if vals >= 2 { r = max_val(r, v1) }
            if vals >= 3 { r = max_val(r, v2) }
            r
        } else {
            if vals >= 3 { compute_med3(v0, v1, v2) } else { if vals >= 2 { min_val(v0, v1) } else { v0 } }
        }
    }
}

fn gen_flat_expr() -> i64 with Mut, Div {
    let op = (rng_next() / 100) % 3 + 10
    let nargs = (rng_next() / 100) % 2 + 2
    SEQ[SEQ_POS] = op; SEQ_POS = SEQ_POS + 1
    var v0 = (rng_next() / 100) % 10
    var v1 = (rng_next() / 100) % 10
    var v2 = 0
    SEQ[SEQ_POS] = v0; SEQ_POS = SEQ_POS + 1
    SEQ[SEQ_POS] = v1; SEQ_POS = SEQ_POS + 1
    if nargs == 3 { v2 = (rng_next() / 100) % 10; SEQ[SEQ_POS] = v2; SEQ_POS = SEQ_POS + 1 }
    apply_op(op, nargs, v0, v1, v2)
}

fn gen_sample_by_depth(target_len: i64, depth: i64) -> i64 with Mut, Div {
    SEQ_POS = 0
    var result = 0
    if depth == 0 {
        result = gen_flat_expr()
    } else {
        let outer_op = (rng_next() / 100) % 3 + 10
        let outer_nargs = (rng_next() / 100) % 2 + 2
        SEQ[SEQ_POS] = outer_op; SEQ_POS = SEQ_POS + 1
        var vals: [i64; 3] = [0; 3]
        var ai = 0
        while ai < outer_nargs {
            let nest = (rng_next() / 100) % 3
            if nest == 0 { vals[ai] = gen_flat_expr() }
            else { let d = (rng_next() / 100) % 10; SEQ[SEQ_POS] = d; SEQ_POS = SEQ_POS + 1; vals[ai] = d }
            ai = ai + 1
        }
        result = apply_op(outer_op, outer_nargs, vals[0], vals[1], vals[2])
    }
    var actual_len = SEQ_POS
    while actual_len < target_len { SEQ[actual_len] = 0; actual_len = actual_len + 1 }
    if SEQ_POS > target_len { SEQ_POS = target_len } else { SEQ_POS = target_len }
    result
}

var W: [i64; 256] = [0; 256]; var H: [i64; 8] = [0; 8]; var L: [i64; 10] = [0; 10]; var MOM: [i64; 256] = [0; 256]

fn ws(i: i64, v: f64) with Mut { W[i] = (v * 100000000.0) as i64 }
fn wg(i: i64) -> f64 with Div { (W[i] as f64) / 100000000.0 }
fn hs(i: i64, v: f64) with Mut { H[i] = (v * 100000000.0) as i64 }
fn hg(i: i64) -> f64 with Div { (H[i] as f64) / 100000000.0 }

fn init_model(is_cross: i64) with Mut, Div, Panic {
    var i = 0
    while i < 104 { ws(i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 64 {
        var v = ((rng_next() % 2000) as f64 - 1000.0) / 10000.0
        let row = i / 8; let col = i - row * 8
        if row == col { v = 0.95 }
        if is_cross == 0 { if row != col { v = 0.0 } }
        ws(104 + i, v); i = i + 1
    }
    i = 0
    while i < 8 { ws(168 + i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 80 { ws(176 + i, ((rng_next() % 2000) as f64 - 1000.0) / 3000.0); i = i + 1 }
    i = 0
    while i < 256 { MOM[i] = 0; i = i + 1 }
}

fn model_step(token: i64, is_cross: i64) with Mut, Div {
    if is_cross == 1 {
        var new_h: [f64; 8] = [0.0; 8]; var d = 0
        while d < 8 {
            let inp = wg(token * 8 + d)
            var s = 0.0; var j = 0
            while j < 8 { s = s + wg(104 + d * 8 + j) * hg(j); j = j + 1 }
            s = s + wg(168 + d) * inp
            if s > 5.0 { s = 5.0 } if s < 0.0 - 5.0 { s = 0.0 - 5.0 }
            new_h[d] = s; d = d + 1
        }
        d = 0
        while d < 8 { hs(d, new_h[d]); d = d + 1 }
    } else {
        var d = 0
        while d < 8 {
            var s = wg(104 + d) * hg(d) + wg(168 + d) * wg(token * 8 + d)
            if s > 5.0 { s = 5.0 } if s < 0.0 - 5.0 { s = 0.0 - 5.0 }
            hs(d, s); d = d + 1
        }
    }
}

fn compute_logits() with Mut, Div {
    var c = 0
    while c < 10 {
        var s = 0.0; var d = 0
        while d < 8 { s = s + hg(d) * wg(176 + d * 10 + c); d = d + 1 }
        L[c] = (s * 100000000.0) as i64; c = c + 1
    }
}

fn get_pred() -> i64 with Mut, Div {
    var best = 0; var bv = (L[0] as f64) / 100000000.0; var i = 1
    while i < 10 { let v = (L[i] as f64)/100000000.0; if v > bv { bv = v; best = i }; i = i + 1 }
    best
}

fn update_out(tgt: i64, lr: f64) with Mut, Div, Panic {
    var mx = (L[0] as f64) / 100000000.0; var i = 1
    while i < 10 { let v = (L[i] as f64)/100000000.0; if v > mx { mx = v }; i = i + 1 }
    var probs: [f64; 10] = [0.0; 10]; var se = 0.0; i = 0
    while i < 10 { probs[i] = exp_q((L[i] as f64)/100000000.0 - mx); se = se + probs[i]; i = i + 1 }
    i = 0
    while i < 10 { probs[i] = probs[i] / se; i = i + 1 }
    probs[tgt] = probs[tgt] - 1.0
    var d = 0
    while d < 8 {
        let hd = hg(d); var c = 0
        while c < 10 {
            let idx = 176 + d * 10 + c
            var g = hd * probs[c]
            if g > 0.3 { g = 0.3 } if g < 0.0 - 0.3 { g = 0.0 - 0.3 }
            let m = (MOM[idx] as f64) / 100000000.0 * 0.9 + g
            MOM[idx] = (m * 100000000.0) as i64
            ws(idx, wg(idx) - lr * m)
            c = c + 1
        }
        d = d + 1
    }
}

fn run_depth(is_cross: i64, depth: i64) -> f64 with IO, Mut, Div, Panic {
    let n_train = 150; let n_epochs = 25
    var ep = 0
    while ep < n_epochs {
        var s = 0
        while s < n_train {
            let label = gen_sample_by_depth(12, depth)
            var tgt = label % 10
            if tgt < 0 { tgt = tgt + 10 }
            var d = 0
            while d < 8 { H[d] = 0; d = d + 1 }
            var t = 0
            while t < SEQ_POS { model_step(SEQ[t], is_cross); t = t + 1 }
            compute_logits()
            if get_pred() == tgt { }
            update_out(tgt, 0.01)
            s = s + 1
        }
        ep = ep + 1
    }
    rng_seed(99999, 11111)
    var correct = 0; var s = 0
    while s < 100 {
        let label = gen_sample_by_depth(12, depth)
        var tgt = label % 10
        if tgt < 0 { tgt = tgt + 10 }
        var d = 0
        while d < 8 { H[d] = 0; d = d + 1 }
        var t = 0
        while t < SEQ_POS { model_step(SEQ[t], is_cross); t = t + 1 }
        compute_logits()
        if get_pred() == tgt { correct = correct + 1 }
        s = s + 1
    }
    (correct as f64) / 100.0 * 100.0
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("ListOps Nesting Depth: 0 vs 1 vs 2-nesting\n\n")

    var depths: [i64; 3] = [0, 1, 2]
    var d_idx = 0
    while d_idx < 3 {
        let depth = depths[d_idx]
        print("Depth="); print_int(depth); print(": ")

        rng_seed(55555, 77777); init_model(1)
        rng_seed(12345, 67890)
        let acc_o = run_depth(1, depth)
        print("O-SSM="); print(acc_o); print("% ")

        rng_seed(55555, 77777); init_model(0)
        rng_seed(12345, 67890)
        let acc_d = run_depth(0, depth)
        print("Diag="); print(acc_d); print("%\n")

        d_idx = d_idx + 1
    }

    println("ALL PASS")
    0
}
