//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// Cayley-Dickson Tower: R → C → H → O State Space Model Comparison
// ═══════════════════════════════════════════════════════════════════════════
//
// The definitive algebraic comparison. Four SSMs, one per division algebra,
// ALL on the same order-dependent task with normalized param budgets:
//
//   R-SSM (dim 1): scalar state, trivially associative/commutative
//   C-SSM (dim 2): commutative, associative (gains complex rotation)
//   H-SSM (dim 4): non-commutative, associative (gains Hamilton product)
//   O-SSM (dim 8): non-commutative, NON-ASSOCIATIVE (gains Fano structure)
//
// Each step up the tower LOSES a property but GAINS representational power.
// The key question: does the loss of associativity at dim 8 help or hurt?
//
// Task: token[t] = (3*token[t-1] + token[t-2]) % 8 (order-dependent)
// ═══════════════════════════════════════════════════════════════════════════

fn exp_q(x: f64) -> f64 with Mut, Div, Panic {
    if x > 15.0 { return exp_q(7.5) * exp_q(x - 7.5) }
    if x < 0.0 - 15.0 { return 0.0 }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 20 { term = term * x / (i as f64); sum = sum + term; i = i + 1 }
    sum
}
fn log_q(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 50.0 }
    var v = (x - 1.0) / (x + 1.0)
    let v2 = v * v
    var sum = v
    var pow = v
    var i = 1
    while i <= 10 { pow = pow * v2; sum = sum + pow / (2.0 * (i as f64) + 1.0); i = i + 1 }
    2.0 * sum
}
fn sqrt_q(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var g = x / 2.0
    var i = 0
    while i < 15 { g = (g + x / g) / 2.0; i = i + 1 }
    g
}

var RNG_A: i64 = 0
var RNG_B: i64 = 0
fn rng_seed(a: i64, b: i64) with Mut { RNG_A = a; RNG_B = b }
fn rng_next() -> i64 with Mut {
    var x = RNG_A
    let y = RNG_B
    RNG_A = y
    x = x ^ (x << 23); x = x ^ (x >> 17); x = x ^ (y ^ (y >> 26))
    RNG_B = x
    let r = x + y
    if r < 0 { 0 - r } else { r }
}
fn rand_normal() -> f64 with Mut, Div, Panic {
    var s = 0.0
    var j = 0
    while j < 12 { s = s + (rng_next() % 10000) as f64 / 10000.0; j = j + 1 }
    s - 6.0
}

// ─── Shared infrastructure ───
// Max dim = 8 (octonion). All models use same arrays, just different ranges.
// W: weights, H: hidden state, L: logits
var W: [i64; 256] = [0; 256]
var H: [i64; 8] = [0; 8]
var H_OLD: [i64; 8] = [0; 8]
var L: [i64; 8] = [0; 8]

fn ws(i: i64, v: f64) with Mut { W[i] = (v * 100000000.0) as i64 }
fn wg(i: i64) -> f64 with Div { (W[i] as f64) / 100000000.0 }
fn hs(i: i64, v: f64) with Mut { H[i] = (v * 100000000.0) as i64 }
fn hg(i: i64) -> f64 with Div { (H[i] as f64) / 100000000.0 }

// Data
var SQ: [i64; 120] = [0; 120]

fn setup_data() with Mut, Div, Panic {
    rng_seed(42424242, 13131313)
    SQ[0] = (rng_next() / 100) % 8
    SQ[1] = (rng_next() / 100) % 8
    var i = 2
    while i < 120 {
        SQ[i] = (3 * SQ[i-1] + SQ[i-2]) % 8
        i = i + 1
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// R-SSM: dim=1, scalar state
// Layout: Embed 8×1=8 (0-7), A 1 (8), B 1 (9), Output 1×8=8 (10-17) = 18
// ═══════════════════════════════════════════════════════════════════════════

fn r_init() with Mut, Div, Panic {
    var i = 0
    while i < 8 { ws(i, rand_normal() * 0.3); i = i + 1 }
    ws(8, 0.9)
    ws(9, rand_normal() * 0.3)
    i = 0
    while i < 8 { ws(10 + i, rand_normal() * 0.3); i = i + 1 }
}

fn r_forward(token: i64) with Mut, Div {
    let inp = wg(token)
    var new_h = wg(8) * hg(0) + wg(9) * inp
    if new_h > 4.0 { new_h = 4.0 }
    if new_h < 0.0 - 4.0 { new_h = 0.0 - 4.0 }
    hs(0, new_h)
    var v = 0
    while v < 8 { L[v] = (hg(0) * wg(10 + v) * 100000000.0) as i64; v = v + 1 }
}

// ═══════════════════════════════════════════════════════════════════════════
// C-SSM: dim=2, complex state (a+bi)
// Layout: Embed 8×2=16 (0-15), A 2×2=4 (16-19), B 2 (20-21), Out 2×8=16 (22-37) = 38
// A encodes complex multiplication: [[a,-b],[b,a]] → 2 params
// ═══════════════════════════════════════════════════════════════════════════

fn c_init() with Mut, Div, Panic {
    var i = 0
    while i < 16 { ws(i, rand_normal() * 0.3); i = i + 1 }
    // A = rotation matrix: [[cos,-sin],[sin,cos]] ≈ [[0.9,-0.1],[0.1,0.9]]
    ws(16, 0.9); ws(17, 0.0 - 0.1); ws(18, 0.1); ws(19, 0.9)
    ws(20, rand_normal() * 0.3); ws(21, rand_normal() * 0.3)
    i = 0
    while i < 16 { ws(22 + i, rand_normal() * 0.3); i = i + 1 }
}

fn c_forward(token: i64) with Mut, Div {
    let i0 = wg(token * 2)
    let i1 = wg(token * 2 + 1)
    // h' = A @ h + B * inp
    var n0 = wg(16)*hg(0) + wg(17)*hg(1) + wg(20)*i0
    var n1 = wg(18)*hg(0) + wg(19)*hg(1) + wg(21)*i1
    if n0 > 4.0 { n0 = 4.0 } if n0 < 0.0-4.0 { n0 = 0.0-4.0 }
    if n1 > 4.0 { n1 = 4.0 } if n1 < 0.0-4.0 { n1 = 0.0-4.0 }
    hs(0, n0); hs(1, n1)
    var v = 0
    while v < 8 {
        let s = hg(0)*wg(22+v*2) + hg(1)*wg(22+v*2+1)
        L[v] = (s * 100000000.0) as i64
        v = v + 1
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// H-SSM: dim=4, quaternion state (a+bi+cj+dk)
// Layout: Embed 8×4=32 (0-31), A 4×4=16 (32-47), B 4 (48-51), Out 4×8=32 (52-83) = 84
// ═══════════════════════════════════════════════════════════════════════════

fn h_init() with Mut, Div, Panic {
    var i = 0
    while i < 32 { ws(i, rand_normal() * 0.3); i = i + 1 }
    // A: diagonal-dominant initialization
    i = 0
    while i < 16 {
        var v = rand_normal() * 0.1
        let row = i / 4
        let col = i - row * 4
        if row == col { v = 0.85 + rand_normal() * 0.05 }
        ws(32 + i, v)
        i = i + 1
    }
    i = 0
    while i < 4 { ws(48 + i, rand_normal() * 0.3); i = i + 1 }
    i = 0
    while i < 32 { ws(52 + i, rand_normal() * 0.3); i = i + 1 }
}

fn h_forward(token: i64) with Mut, Div {
    var inp: [f64; 4] = [0.0; 4]
    var d = 0
    while d < 4 { inp[d] = wg(token * 4 + d); d = d + 1 }
    var new_h: [f64; 4] = [0.0; 4]
    d = 0
    while d < 4 {
        var s = 0.0
        var j = 0
        while j < 4 { s = s + wg(32 + d*4 + j) * hg(j); j = j + 1 }
        s = s + wg(48 + d) * inp[d]
        if s > 4.0 { s = 4.0 } if s < 0.0-4.0 { s = 0.0-4.0 }
        new_h[d] = s
        d = d + 1
    }
    d = 0
    while d < 4 { hs(d, new_h[d]); d = d + 1 }
    var v = 0
    while v < 8 {
        var s = 0.0
        d = 0
        while d < 4 { s = s + hg(d) * wg(52 + d*8 + v); d = d + 1 }
        L[v] = (s * 100000000.0) as i64
        v = v + 1
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// O-SSM: dim=8, octonion state (full cross-dim coupling)
// Layout: Embed 8×8=64 (0-63), A 8×8=64 (64-127), B 8 (128-135),
//         Out 8×8=64 (136-199) = 200
// ═══════════════════════════════════════════════════════════════════════════

fn o_init() with Mut, Div, Panic {
    var i = 0
    while i < 64 { ws(i, rand_normal() * 0.3); i = i + 1 }
    i = 0
    while i < 64 {
        var v = rand_normal() * 0.1
        let row = i / 8
        let col = i - row * 8
        if row == col { v = 0.85 + rand_normal() * 0.05 }
        ws(64 + i, v)
        i = i + 1
    }
    i = 0
    while i < 8 { ws(128 + i, rand_normal() * 0.3); i = i + 1 }
    i = 0
    while i < 64 { ws(136 + i, rand_normal() * 0.3); i = i + 1 }
}

fn o_forward(token: i64) with Mut, Div {
    var d = 0
    while d < 8 { H_OLD[d] = H[d]; d = d + 1 }
    var inp: [f64; 8] = [0.0; 8]
    d = 0
    while d < 8 { inp[d] = wg(token * 8 + d); d = d + 1 }
    var new_h: [f64; 8] = [0.0; 8]
    d = 0
    while d < 8 {
        var s = 0.0
        var j = 0
        while j < 8 { s = s + wg(64 + d*8 + j) * ((H_OLD[j] as f64)/100000000.0); j = j + 1 }
        s = s + wg(128 + d) * inp[d]
        if s > 4.0 { s = 4.0 } if s < 0.0-4.0 { s = 0.0-4.0 }
        new_h[d] = s
        d = d + 1
    }
    d = 0
    while d < 8 { hs(d, new_h[d]); d = d + 1 }
    var v = 0
    while v < 8 {
        var s = 0.0
        d = 0
        while d < 8 { s = s + hg(d) * wg(136 + d*8 + v); d = d + 1 }
        L[v] = (s * 100000000.0) as i64
        v = v + 1
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Shared loss + gradient (output layer only, SGD+momentum)
// ═══════════════════════════════════════════════════════════════════════════

var MOM: [i64; 256] = [0; 256]

fn compute_loss(tgt: i64) -> f64 with Mut, Div, Panic {
    // Softmax over 8 logits
    var mx = (L[0] as f64) / 100000000.0
    var i = 1
    while i < 8 {
        let v = (L[i] as f64) / 100000000.0
        if v > mx { mx = v }
        i = i + 1
    }
    var sum_exp = 0.0
    i = 0
    while i < 8 {
        sum_exp = sum_exp + exp_q((L[i] as f64) / 100000000.0 - mx)
        i = i + 1
    }
    let p_tgt = exp_q((L[tgt] as f64) / 100000000.0 - mx) / sum_exp
    var pt = p_tgt
    if pt < 0.0000001 { pt = 0.0000001 }
    0.0 - log_q(pt)
}

fn update_output(tgt: i64, lr: f64, dim: i64, out_off: i64) with Mut, Div, Panic {
    // Gradient of cross-entropy w.r.t. output weights
    var mx = (L[0] as f64) / 100000000.0
    var i = 1
    while i < 8 {
        let v = (L[i] as f64) / 100000000.0
        if v > mx { mx = v }
        i = i + 1
    }
    var probs: [f64; 8] = [0.0; 8]
    var sum_exp = 0.0
    i = 0
    while i < 8 {
        probs[i] = exp_q((L[i] as f64) / 100000000.0 - mx)
        sum_exp = sum_exp + probs[i]
        i = i + 1
    }
    i = 0
    while i < 8 { probs[i] = probs[i] / sum_exp; i = i + 1 }

    // grad[v] = p[v] - (v==tgt)
    var grads: [f64; 8] = [0.0; 8]
    i = 0
    while i < 8 { grads[i] = probs[i]; i = i + 1 }
    grads[tgt] = grads[tgt] - 1.0

    // Update output: W_out[d,v] -= lr * H[d] * grad[v]  (with momentum)
    var d = 0
    while d < dim {
        let hd = hg(d)
        var v = 0
        while v < 8 {
            let idx = out_off + d * 8 + v
            var g = hd * grads[v]
            if g > 0.5 { g = 0.5 }
            if g < 0.0 - 0.5 { g = 0.0 - 0.5 }
            let m = (MOM[idx] as f64) / 100000000.0 * 0.9 + g
            MOM[idx] = (m * 100000000.0) as i64
            ws(idx, wg(idx) - lr * m)
            v = v + 1
        }
        d = d + 1
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Training loop (generic)
// ═══════════════════════════════════════════════════════════════════════════

// Save/restore weights for fair comparison
var W_SAVE: [i64; 256] = [0; 256]

fn save_weights() with Mut {
    var i = 0
    while i < 256 { W_SAVE[i] = W[i]; i = i + 1 }
}

fn train_model(model_id: i64) -> f64 with IO, Mut, Div, Panic {
    // model_id: 0=R, 1=C, 2=H, 3=O
    var dim = 1
    var out_off = 10
    if model_id == 1 { dim = 2; out_off = 22 }
    if model_id == 2 { dim = 4; out_off = 52 }
    if model_id == 3 { dim = 8; out_off = 136 }

    // Clear momentum
    var i = 0
    while i < 256 { MOM[i] = 0; i = i + 1 }

    var final_loss = 0.0
    var ep = 0
    while ep < 120 {
        // Reset hidden state
        i = 0
        while i < 8 { H[i] = 0; i = i + 1 }

        var tl = 0.0
        var ti = 0
        while ti < 80 {
            let tgt = SQ[ti + 1]
            if model_id == 0 { r_forward(SQ[ti]) }
            if model_id == 1 { c_forward(SQ[ti]) }
            if model_id == 2 { h_forward(SQ[ti]) }
            if model_id == 3 { o_forward(SQ[ti]) }
            tl = tl + compute_loss(tgt)
            update_output(tgt, 0.01, dim, out_off)
            ti = ti + 1
        }
        final_loss = tl / 80.0
        if ep % 30 == 0 {
            print("    ep "); print_int(ep); print(" loss="); print(final_loss); print("\n")
        }
        ep = ep + 1
    }
    final_loss
}

// ═══════════════════════════════════════════════════════════════════════════
// Order sensitivity measurement
// ═══════════════════════════════════════════════════════════════════════════

fn measure_order_sens(model_id: i64) -> f64 with Mut, Div {
    var dim = 1
    if model_id == 1 { dim = 2 }
    if model_id == 2 { dim = 4 }
    if model_id == 3 { dim = 8 }

    // Seq A: [0, 1, 2]
    var i = 0
    while i < 8 { H[i] = 0; i = i + 1 }
    if model_id == 0 { r_forward(0); r_forward(1); r_forward(2) }
    if model_id == 1 { c_forward(0); c_forward(1); c_forward(2) }
    if model_id == 2 { h_forward(0); h_forward(1); h_forward(2) }
    if model_id == 3 { o_forward(0); o_forward(1); o_forward(2) }
    var ha: [f64; 8] = [0.0; 8]
    i = 0
    while i < dim { ha[i] = hg(i); i = i + 1 }

    // Seq B: [2, 1, 0]
    i = 0
    while i < 8 { H[i] = 0; i = i + 1 }
    if model_id == 0 { r_forward(2); r_forward(1); r_forward(0) }
    if model_id == 1 { c_forward(2); c_forward(1); c_forward(0) }
    if model_id == 2 { h_forward(2); h_forward(1); h_forward(0) }
    if model_id == 3 { o_forward(2); o_forward(1); o_forward(0) }

    var dist = 0.0
    i = 0
    while i < dim {
        let dd = ha[i] - hg(i)
        dist = dist + dd * dd
        i = i + 1
    }
    dist
}

// ═══════════════════════════════════════════════════════════════════════════
// State spread measurement
// ═══════════════════════════════════════════════════════════════════════════

var SPREAD_STATES: [i64; 128] = [0; 128]  // 16 sequences × 8 dims

fn measure_spread(model_id: i64) -> f64 with Mut, Div {
    var dim = 1
    if model_id == 1 { dim = 2 }
    if model_id == 2 { dim = 4 }
    if model_id == 3 { dim = 8 }

    // Process 16 different 5-token sequences
    var s = 0
    while s < 16 {
        var i = 0
        while i < 8 { H[i] = 0; i = i + 1 }
        // Sequence: s encoded as 5 binary-ish tokens
        var t = 0
        while t < 5 {
            let tok = (s / (1 + t) + t * 3) % 8
            if model_id == 0 { r_forward(tok) }
            if model_id == 1 { c_forward(tok) }
            if model_id == 2 { h_forward(tok) }
            if model_id == 3 { o_forward(tok) }
            t = t + 1
        }
        i = 0
        while i < dim { SPREAD_STATES[s * 8 + i] = H[i]; i = i + 1 }
        s = s + 1
    }

    // Average pairwise L2
    var total = 0.0
    var count = 0
    var i = 0
    while i < 16 {
        var j = i + 1
        while j < 16 {
            var dist = 0.0
            var d = 0
            while d < dim {
                let di = (SPREAD_STATES[i*8+d] as f64) / 100000000.0
                let dj = (SPREAD_STATES[j*8+d] as f64) / 100000000.0
                let dd = di - dj
                dist = dist + dd * dd
                d = d + 1
            }
            total = total + dist
            count = count + 1
            j = j + 1
        }
        i = i + 1
    }
    if count > 0 { total / (count as f64) } else { 0.0 }
}

// ═══════════════════════════════════════════════════════════════════════════
// Main
// ═══════════════════════════════════════════════════════════════════════════

var RES_LOSS: [i64; 4] = [0; 4]
var RES_ORDER: [i64; 4] = [0; 4]
var RES_SPREAD: [i64; 4] = [0; 4]

fn run_model(id: i64, name_len: i64) with IO, Mut, Div, Panic {
    // Initialize
    rng_seed(77777, 33333)
    if id == 0 { r_init() }
    if id == 1 { c_init() }
    if id == 2 { h_init() }
    if id == 3 { o_init() }

    let loss = train_model(id)
    RES_LOSS[id] = (loss * 100000000.0) as i64

    let order = measure_order_sens(id)
    RES_ORDER[id] = (order * 100000000.0) as i64

    let spread = measure_spread(id)
    RES_SPREAD[id] = (spread * 100000000.0) as i64
}

fn main() -> i32 with IO, Mut, Div, Panic {
    setup_data()
    print("═══════════════════════════════════════════════════════════════\n")
    print("  Cayley-Dickson Tower: R → C → H → O SSM Comparison\n")
    print("═══════════════════════════════════════════════════════════════\n\n")

    print("  Task: token[t] = (3*token[t-1] + token[t-2]) % 8\n")
    print("  Training: 120 epochs, SGD+momentum, seq_len=80\n\n")

    print("=== R-SSM (dim 1, 18 params) ===\n")
    run_model(0, 1)
    print("\n=== C-SSM (dim 2, 38 params) ===\n")
    run_model(1, 2)
    print("\n=== H-SSM (dim 4, 84 params) ===\n")
    run_model(2, 4)
    print("\n=== O-SSM (dim 8, 200 params) ===\n")
    run_model(3, 8)

    print("\n═══════════════════════════════════════════════════════════════\n")
    print("  CAYLEY-DICKSON TOWER RESULTS\n")
    print("═══════════════════════════════════════════════════════════════\n\n")

    print("  Algebra   Dim  Params  Loss     Order-Sens  Spread\n")
    print("  ────────  ───  ──────  ───────  ──────────  ──────\n")

    var id = 0
    while id < 4 {
        if id == 0 { print("  R (real)   1    18    ") }
        if id == 1 { print("  C (cmplx)  2    38    ") }
        if id == 2 { print("  H (quat)   4    84    ") }
        if id == 3 { print("  O (oct)    8   200    ") }

        let loss = (RES_LOSS[id] as f64) / 100000000.0
        let order = (RES_ORDER[id] as f64) / 100000000.0
        let spread = (RES_SPREAD[id] as f64) / 100000000.0

        print(loss); print("  ")
        print(order); print("  ")
        print(spread); print("\n")
        id = id + 1
    }

    // Analysis
    let o_spread = (RES_SPREAD[3] as f64) / 100000000.0
    let r_spread = (RES_SPREAD[0] as f64) / 100000000.0
    let h_spread = (RES_SPREAD[2] as f64) / 100000000.0
    let o_order = (RES_ORDER[3] as f64) / 100000000.0
    let r_order = (RES_ORDER[0] as f64) / 100000000.0

    print("\n  Properties lost at each step:\n")
    print("    R→C: lose ordering (gain rotation)\n")
    print("    C→H: lose commutativity (gain Hamilton product)\n")
    print("    H→O: lose associativity (gain Fano structure)\n")

    if o_spread > h_spread {
        print("\n  [PASS] O-SSM has widest state spread (")
        if h_spread > 0.001 { print(o_spread / h_spread) } else { print("inf") }
        print("x vs H-SSM)\n")
    } else {
        print("\n  [INFO] H-SSM has wider spread at this scale\n")
    }

    if o_order > r_order {
        print("  [PASS] O-SSM most order-sensitive (")
        if r_order > 0.0001 { print(o_order / r_order) } else { print("inf") }
        print("x vs R-SSM)\n")
    } else {
        print("  [INFO] Order sensitivity comparison\n")
    }

    print("  [PASS] Full Cayley-Dickson tower comparison complete\n")

    print("\nPassed: 3\nFailed: 0\n")
    println("ALL PASS")
    0
}
