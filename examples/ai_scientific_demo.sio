import stdlib.pbpk::*;
import stdlib.epistemic::*;
import stdlib.nn::*;
import stdlib.causal::*;

fn main() -> i32 {
    println("🤖 Sounio AI Scientific Computing Demo");
    println("=====================================");
    
    // 1. Demonstração de geração de código biomédico
    demonstrate_biomedical_generation();
    
    // 2. Demonstração de raciocínio matemático
    demonstrate_mathematical_reasoning();
    
    // 3. Demonstração de algoritmos científicos
    demonstrate_scientific_algorithms();
    
    // 4. Demonstração de propagação epistêmica
