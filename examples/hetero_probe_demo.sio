//@ run-pass
//
// Hetero CUDA probe demo: enumerate NVIDIA devices through dlopen/dlsym
// call-through and print measured DeviceCaps facts. On a machine without
// CUDA this prints "cuda: unavailable" and still passes - the probe must
// never crash a CPU-only user (docs/design/heterogeneous-gpu-framework.md).
// Module source: stdlib/hetero/probe_cuda.sio

use hetero::probe_cuda::{
    cuda_probe_close, cuda_probe_open, cuda_probe_print_name, cuda_probe_sm,
    cuda_probe_total_mem,
}

fn main() with IO, Mut, Panic, Div, Alloc {
    let probe = cuda_probe_open()
    if !probe.available {
        print("cuda: unavailable (CPU-only machine, probe OK)\n")
        print("PROBE DONE\n")
        exit(0)
    }
    print("cuda devices=")
    print_int(probe.device_count as i64)
    print("\n")
    var i: i32 = 0
    while i < probe.device_count {
        print("device ")
        print_int(i as i64)
        print(": ")
        cuda_probe_print_name(&probe, i)
        print(" sm=")
        print_int(cuda_probe_sm(&probe, i) as i64)
        print(" vram_gib=")
        print_int(cuda_probe_total_mem(&probe, i) / 1073741824)
        print("\n")
        i = i + 1
    }
    cuda_probe_close(&probe)
    print("PROBE DONE\n")
    exit(0)
}
