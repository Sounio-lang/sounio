// Sprint 131: Epistemic computing smoke test — native x86-64 ELF target
// Target: self-hosted compiler (souc run main.sio -- --native-compile this_file.sio)
// Exercises: measure() → Knowledge struct → GUM arithmetic → print_f64
// GUM: JCGM 100:2008 §5.1.2 (add/sub) and §5.1.3 (mul/div)
//
// NOTE: This file requires the self-hosted compiler pipeline, not the JIT.
// The JIT frontend does not recognize measure() as a builtin.

// GUM addition: z = a + b
// z.value = a.value + b.value
// z.variance = a.variance + b.variance  (JCGM 100:2008 §5.1.2)
// z.confidence = min(a.confidence, b.confidence)
fn knowledge_add(a: Knowledge<f64>, b: Knowledge<f64>) -> Knowledge<f64> with Mut, Panic, Div {
    let av = a.value
    let bv = b.value
    let sum_val = av + bv
    let sum_var = a.variance + b.variance
    let ca = a.confidence
    let cb = b.confidence
    let conf = if ca < cb { ca } else { cb }
    measure(sum_val,  sqrt(sum_var))
}

// GUM subtraction: z = a - b
// z.value = a.value - b.value
// z.variance = a.variance + b.variance  (partials squared cancel sign)
// z.confidence = min(a.confidence, b.confidence)
fn knowledge_sub(a: Knowledge<f64>, b: Knowledge<f64>) -> Knowledge<f64> with Mut, Panic, Div {
    let av = a.value
    let bv = b.value
    let diff_val = av - bv
    let diff_var = a.variance + b.variance
    let ca = a.confidence
    let cb = b.confidence
    let conf = if ca < cb { ca } else { cb }
    measure(diff_val,  sqrt(diff_var))
}

// GUM multiplication: z = a * b
// z.value = a.value * b.value
// z.variance = a.value² * b.variance + b.value² * a.variance  (JCGM §5.1.3)
// z.confidence = min(a.confidence, b.confidence)
fn knowledge_mul(a: Knowledge<f64>, b: Knowledge<f64>) -> Knowledge<f64> with Mut, Panic, Div {
    let av = a.value
    let bv = b.value
    let prod_val = av * bv
    let av2 = av * av
    let bv2 = bv * bv
    let prod_var = av2 * b.variance + bv2 * a.variance
    let ca = a.confidence
    let cb = b.confidence
    let conf = if ca < cb { ca } else { cb }
    measure(prod_val,  sqrt(prod_var))
}

// GUM division: z = a / b
// z.value = a.value / b.value
// z.variance = (1/b.value²) * a.variance + (a.value²/b.value⁴) * b.variance
// z.confidence = min(a.confidence, b.confidence)
fn knowledge_div(a: Knowledge<f64>, b: Knowledge<f64>) -> Knowledge<f64> with Mut, Panic, Div {
    let av = a.value
    let bv = b.value
    let quot_val = av / bv
    let bv2 = bv * bv
    let bv4 = bv2 * bv2
    let quot_var = a.variance / bv2 + (av * av) * b.variance / bv4
    let ca = a.confidence
    let cb = b.confidence
    let conf = if ca < cb { ca } else { cb }
    measure(quot_val,  sqrt(quot_var))
}

// Demo: compute area of rectangle with uncertain dimensions
fn main() -> i32 with IO, Mut, Panic, Div {
    // Length = 10.5 ± 0.1 m
    let length = measure(10.5,  0.1)
    // Width = 5.2 ± 0.05 m
    let width = measure(5.2,  0.05)

    // Area = length * width (GUM §5.1.3)
    let area = knowledge_mul(length, width)

    // Print results
    print_f64(area.value)
    print_f64(area.variance)

    0
}
