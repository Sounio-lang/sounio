// Sprint 131: Epistemic computing smoke test — native x86-64 ELF target
// Target: self-hosted compiler (souc run main.sio -- --native-compile this_file.sio)
// Exercises: measure() → Knowledge struct → GUM arithmetic → print_f64
// GUM: JCGM 100:2008 §5.1.2 (add/sub) and §5.1.3 (mul/div)
//
// NOTE: This file requires the self-hosted compiler pipeline, not the JIT.
// The JIT frontend does not recognize measure() as a builtin.
//
// Since the compiler emits inline GUM codegen for Knowledge<f64> arithmetic,
// these operations use native `+`, `-`, `*`, `/` directly rather than manual
// propagation.  The compiler enforces E170: .value requires `with Epistemic`.

// Demo: compute area of rectangle with uncertain dimensions
fn main() -> i32 with IO, Epistemic, Mut, Panic, Div {
    // Length = 10.5 ± 0.1 m
    let length = measure(10.5, uncertainty: 0.1)
    // Width = 5.2 ± 0.05 m
    let width = measure(5.2, uncertainty: 0.05)

    // Area = length * width
    // Compiler emits inline GUM §5.1.3:
    //   value = length.value * width.value
    //   variance = length.value² * width.variance + width.value² * length.variance
    //   confidence = min(length.confidence, width.confidence)
    let area = length * width

    // Perimeter = 2*(length + width)
    // Compiler emits inline GUM §5.1.2 for add, then §5.1.3 for scalar mul
    let half_perim = length + width

    // Print results (requires `with Epistemic` for .value access)
    print("area value: ")
    print_f64(area.value)
    print("\n")
    print("area variance: ")
    print_f64(area.variance)
    print("\n")
    print("area uncertainty: ")
    print_f64(area.uncertainty)
    print("\n")

    print("half-perimeter value: ")
    print_f64(half_perim.value)
    print("\n")
    print("half-perimeter uncertainty: ")
    print_f64(half_perim.uncertainty)
    print("\n")

    0
}
