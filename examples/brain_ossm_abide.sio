// Brain O-SSM ABIDE Cross-Site CV
//
// Honest current contract:
// - input is a frozen TSV manifest at
//   /orangefs/training/sounio/abide-data/abide_roi_manifest.tsv
// - each row is one subject
// - core header: subject_id, label, site, f0..fN
// - flat feature count must be divisible by 8
// - optional leading `# key=value` metadata comment lines are tolerated
// - labels are binary ASD vs control
// - evaluation is grouped by real site holdout (leave-one-site-out)
//
// This benchmark is intentionally narrower than the long-term vision
// (raw NIfTI -> ROI time series -> temporal O-SSM). It provides the first
// runnable real-data path without overstating current ingestion maturity.

var FEATURES: [f64; 1048576] = [0.0; 1048576] // 2048 * 512 (64 steps * 8 dims)
var LABELS: [i64; 2048] = [0; 2048]         // 1=ASD, 0=Control
var SITE_KEYS: [i64; 2048] = [0; 2048]
var SUBJECT_SITE_TEXT: [i64; 65536] = [0; 65536] // 2048 * 32
var SUBJECT_SITE_LEN: [i64; 2048] = [0; 2048]
var UNIQUE_SITES: [i64; 64] = [0; 64]
var UNIQUE_SITE_TEXT: [i64; 2048] = [0; 2048] // 64 * 32
var UNIQUE_SITE_LEN: [i64; 64] = [0; 64]
var UNIQUE_SITE_COUNT: i64 = 0
var SUBJECT_COUNT: i64 = 0
var MANIFEST_SEQ_LEN: i64 = 8
var MANIFEST_INPUT_DIM: i64 = 8
var MANIFEST_FEATURE_COUNT: i64 = 64
var CFG_TRAIN_FRACTION_BP: i64 = 1000000
var CFG_DROP_CHANNEL_FRAC_BP: i64 = 0
var CFG_NOISE_STD_BP: i64 = 0
var CFG_GLOBAL_TRAIN_EPOCHS: i64 = 90
var CFG_GLOBAL_TRAIN_LR_BP: i64 = 20000
var CFG_GLOBAL_CORE_LR_SCALE_BP: i64 = 350000
var CFG_OCT_TRAIN_EPOCHS: i64 = 0
var CFG_OCT_TRAIN_LR_BP: i64 = 0
var CFG_OCT_CORE_LR_SCALE_BP: i64 = 0
var CFG_OCT_WARMUP_EPOCHS: i64 = 0
var CFG_OCT_PROFILE_ID: i64 = 0
var CFG_OCT_TRAIN_MODE: i64 = 0
var CFG_OCT_INIT_PRESET: i64 = 0
var CFG_OCT_ASSOC_REG_BP: i64 = 0
var CFG_OCT_ASSOC_TARGET_BP: i64 = 0
var CFG_OCT_ASSOC_SCHEDULE_MODE: i64 = 0
var CFG_OCT_ASSOC_SCHEDULE_START_BP: i64 = 0
var CFG_OCT_ASSOC_SCHEDULE_MID_BP: i64 = 0
var CFG_OCT_ASSOC_SCHEDULE_END_BP: i64 = 0
var CFG_OCT_ASSOC_DRIFT_REG_BP: i64 = 0
var CFG_OCT_HEAD_TRUST_REGION_BP: i64 = 0
var CFG_OCT_HEAD_RENORM: i64 = 1
var CFG_OCT_ASSOCIATIVE_PROJECTION: i64 = 0
var CFG_OCT_INPUT_PROJ_MODE: i64 = 0
var CFG_OCT_PROJ_LR_SCALE_BP: i64 = 600000
var CFG_OCT_PROJ_STRUCTURED_SCALE_BP: i64 = 350000
var CFG_OCT_PROJ_DELTA_SCALE_BP: i64 = 180000
var CFG_OCT_PROJ_HYBRID_SCALE_BP: i64 = 120000
var CFG_H_TRAIN_EPOCHS: i64 = 0
var CFG_H_TRAIN_LR_BP: i64 = 0
var CFG_H_CORE_LR_SCALE_BP: i64 = 0
var CFG_H_WARMUP_EPOCHS: i64 = 0
var CFG_H_INIT_PRESET: i64 = 0
var CFG_H_INPUT_PROJ_MODE: i64 = 0
var CFG_H_PROJ_LR_SCALE_BP: i64 = 600000
var CFG_TRACE_HIDDEN_STATE: i64 = 0
var TRAIN_MASK: [i64; 2048] = [0; 2048]
var DROP_MASK: [i64; 64] = [0; 64]
var FOLD_NOISE_KEY: i64 = 0
var TRAIN_FEATURE_MEAN: [f64; 512] = [0.0; 512]
var TRAIN_FEATURE_STD: [f64; 512] = [1.0; 512]

var RNG_A: i64 = 0
var RNG_B: i64 = 0

var W: [i64; 704] = [0; 704]   // hidden + assoc + summary skips + flat skip + input encoder + bias
var MOM: [i64; 704] = [0; 704]
var H: [i64; 16] = [0; 16]
var A: [f64; 16] = [0.0; 16]
var A_MOM: [i64; 16] = [0; 16]
var ASSOC_ACC: [i64; 2] = [0; 2]
var LOGIT: f64 = 0.0

var TMP_OCT: [f64; 8] = [0.0; 8]
var TMP_GRAD: [f64; 8] = [0.0; 8]
var TMP_DELTA: [f64; 8] = [0.0; 8]
var LAST_INPUT_MEAN: [f64; 8] = [0.0; 8]
var FIRST_INPUT_STEP: [f64; 8] = [0.0; 8]
var LAST_INPUT_STEP: [f64; 8] = [0.0; 8]
var LAST_INPUT_FLAT: [f64; 512] = [0.0; 512]
var RAW_INPUT_MEAN: [f64; 8] = [0.0; 8]
var RAW_FIRST_INPUT_STEP: [f64; 8] = [0.0; 8]
var RAW_LAST_INPUT_STEP: [f64; 8] = [0.0; 8]
var RAW_INPUT_FLAT: [f64; 512] = [0.0; 512]
var ENC_INPUT_MEAN: [f64; 8] = [0.0; 8]
var ENC_FIRST_INPUT_STEP: [f64; 8] = [0.0; 8]
var ENC_LAST_INPUT_STEP: [f64; 8] = [0.0; 8]
var ENC_INPUT_FLAT: [f64; 512] = [0.0; 512]
var LAST_ACC_BP: i64 = 0
var LAST_BAL_BP: i64 = 0
var LAST_ASSOC_BP: i64 = 0
var LAST_TEST_N: i64 = 0
var LAST_EVAL_OK: i64 = 0
var LAST_SITE_BAL_BP: [i64; 64] = [0; 64]
var LAST_SITE_ACC_BP: [i64; 64] = [0; 64]
var LAST_SITE_ASSOC_BP: [i64; 64] = [0; 64]
var LAST_SITE_TEST_N: [i64; 64] = [0; 64]
var LAST_SITE_VALID: [i64; 64] = [0; 64]
var O_SITE_BAL_SUM_BP: [i64; 64] = [0; 64]
var O_SITE_ASSOC_SUM_BP: [i64; 64] = [0; 64]
var O_SITE_VALID_CT: [i64; 64] = [0; 64]
var O_SITE_TEST_N_SUM: [i64; 64] = [0; 64]
var H_SITE_BAL_SUM_BP: [i64; 64] = [0; 64]
var H_SITE_ASSOC_SUM_BP: [i64; 64] = [0; 64]
var H_SITE_VALID_CT: [i64; 64] = [0; 64]
var H_SITE_TEST_N_SUM: [i64; 64] = [0; 64]
var PROJ_W: [i64; 64] = [0; 64]
var PROJ_B: [i64; 8] = [0; 8]
var PROJ_W_MOM: [i64; 64] = [0; 64]
var PROJ_B_MOM: [i64; 8] = [0; 8]
var PREV_ASSOC_ACC: [i64; 2] = [0; 2]
var TRAIN_EPOCH_CURSOR: i64 = 0
var TRAIN_EPOCH_TOTAL: i64 = 0

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn abs_i64(x: i64) -> i64 {
    if x < 0 { 0 - x } else { x }
}

fn clip_f64(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { lo } else if x > hi { hi } else { x }
}

fn squash_pos_f64(x: f64) -> f64 with Div {
    if x <= 0.0 { return 0.0 }
    x / (1.0 + x)
}

fn head_count() -> i64 { 2 }
fn head_width() -> i64 { 8 }
fn hidden_dim() -> i64 { 16 }
fn assoc_offset() -> i64 { 16 }
fn input_mean_offset() -> i64 { 18 }
fn input_delta_offset() -> i64 { 26 }
fn step_delta_offset() -> i64 { 34 }
fn input_flat_offset() -> i64 { 42 }
fn encoder_scale_offset() -> i64 { 554 }
fn encoder_bias_offset() -> i64 { 562 }
fn bias_offset() -> i64 { 570 }
fn head_base(head: i64) -> i64 { head * head_width() }
fn feature_cap() -> i64 { 512 }

fn bp_to_f64(v: i64) -> f64 with Div {
    (v as f64) / 1000000.0
}

fn f64_to_bp(v: f64) -> i64 {
    if v <= 0.0 { return 0 }
    let scaled = v * 1000000.0 + 0.5
    if scaled > 1000000.0 { 1000000 } else { scaled as i64 }
}

fn scaled_keep_count(total: i64, bp: i64) -> i64 with Mut, Div {
    if total <= 0 { return 0 }
    if bp >= 1000000 { return total }
    var keep = (total * bp + 500000) / 1000000
    if keep < 1 { keep = 1 }
    if keep > total { keep = total }
    keep
}

fn cfg_train_epochs(is_oct: i64) -> i64 {
    if is_oct == 1 && CFG_OCT_TRAIN_EPOCHS > 0 {
        return CFG_OCT_TRAIN_EPOCHS
    }
    if is_oct == 0 && CFG_H_TRAIN_EPOCHS > 0 {
        return CFG_H_TRAIN_EPOCHS
    }
    CFG_GLOBAL_TRAIN_EPOCHS
}

fn cfg_train_lr(is_oct: i64) -> f64 with Div {
    if is_oct == 1 && CFG_OCT_TRAIN_LR_BP > 0 {
        return bp_to_f64(CFG_OCT_TRAIN_LR_BP)
    }
    if is_oct == 0 && CFG_H_TRAIN_LR_BP > 0 {
        return bp_to_f64(CFG_H_TRAIN_LR_BP)
    }
    bp_to_f64(CFG_GLOBAL_TRAIN_LR_BP)
}

fn cfg_core_lr_scale(is_oct: i64) -> f64 with Div {
    if is_oct == 1 && CFG_OCT_CORE_LR_SCALE_BP > 0 {
        return bp_to_f64(CFG_OCT_CORE_LR_SCALE_BP)
    }
    if is_oct == 0 && CFG_H_CORE_LR_SCALE_BP > 0 {
        return bp_to_f64(CFG_H_CORE_LR_SCALE_BP)
    }
    bp_to_f64(CFG_GLOBAL_CORE_LR_SCALE_BP)
}

fn cfg_warmup_epochs(is_oct: i64) -> i64 {
    if is_oct == 1 { CFG_OCT_WARMUP_EPOCHS } else { CFG_H_WARMUP_EPOCHS }
}

fn cfg_oct_profile_id() -> i64 {
    CFG_OCT_PROFILE_ID
}

fn cfg_assoc_reg(is_oct: i64) -> f64 with Div {
    if is_oct == 1 { (CFG_OCT_ASSOC_REG_BP as f64) / 1000000.0 } else { 0.0 }
}

fn cfg_assoc_target(is_oct: i64) -> f64 with Div {
    if is_oct == 1 { (CFG_OCT_ASSOC_TARGET_BP as f64) / 1000000.0 } else { 0.0 }
}

fn cfg_input_proj_mode(is_oct: i64) -> i64 {
    if is_oct == 1 { CFG_OCT_INPUT_PROJ_MODE } else { CFG_H_INPUT_PROJ_MODE }
}

fn cfg_proj_lr_scale(is_oct: i64) -> f64 with Div {
    if is_oct == 1 { bp_to_f64(CFG_OCT_PROJ_LR_SCALE_BP) } else { bp_to_f64(CFG_H_PROJ_LR_SCALE_BP) }
}

fn cfg_oct_train_mode() -> i64 {
    CFG_OCT_TRAIN_MODE
}

fn cfg_assoc_schedule_mode() -> i64 {
    CFG_OCT_ASSOC_SCHEDULE_MODE
}

fn cfg_assoc_schedule_start() -> f64 with Div {
    bp_to_f64(CFG_OCT_ASSOC_SCHEDULE_START_BP)
}

fn cfg_assoc_schedule_mid() -> f64 with Div {
    bp_to_f64(CFG_OCT_ASSOC_SCHEDULE_MID_BP)
}

fn cfg_assoc_schedule_end() -> f64 with Div {
    bp_to_f64(CFG_OCT_ASSOC_SCHEDULE_END_BP)
}

fn cfg_assoc_drift_reg() -> f64 with Div {
    bp_to_f64(CFG_OCT_ASSOC_DRIFT_REG_BP)
}

fn cfg_head_trust_region() -> f64 with Div {
    bp_to_f64(CFG_OCT_HEAD_TRUST_REGION_BP)
}

fn cfg_head_renorm() -> i64 {
    CFG_OCT_HEAD_RENORM
}

fn cfg_proj_structured_scale() -> f64 with Div {
    bp_to_f64(CFG_OCT_PROJ_STRUCTURED_SCALE_BP)
}

fn cfg_proj_delta_scale() -> f64 with Div {
    bp_to_f64(CFG_OCT_PROJ_DELTA_SCALE_BP)
}

fn cfg_proj_hybrid_scale() -> f64 with Div {
    bp_to_f64(CFG_OCT_PROJ_HYBRID_SCALE_BP)
}

fn oct_profile_name(id: i64) -> string {
    if id == 1 { "o_g2_transfer" }
    else if id == 2 { "o_assoc_stable" }
    else if id == 3 { "o_alg_v1" }
    else if id == 4 { "o_alg_v1_mandel" }
    else { "o_default" }
}

fn oct_train_mode_name(id: i64) -> string {
    if id == 3 { "o_alg_v1" }
    else if id == 4 { "o_alg_v1_mandel" }
    else if id == 2 { "o_assoc_stable" }
    else if id == 1 { "o_g2_transfer" }
    else { "o_default" }
}

fn assoc_schedule_mode_name(id: i64) -> string {
    if id == 1 { "tri_band" }
    else { "fixed" }
}

fn proj_mode_name(mode: i64) -> string {
    if mode == 1 { "learned_linear" }
    else if mode == 2 { "residual_linear" }
    else if mode == 3 { "mandelbrot_d2_residual" }
    else if mode == 4 { "mandelbrot_d2_hybrid" }
    else { "identity" }
}

fn lerp_f64(a: f64, b: f64, t: f64) -> f64 {
    a + (b - a) * t
}

fn trust_region_clip(step: f64, radius: f64) -> f64 with Div {
    if radius <= 0.0 { return step }
    clip_f64(step, 0.0 - radius, radius)
}

fn md2_squash(v: f64) -> f64 with Div {
    if v >= 0.0 {
        v / (1.0 + v)
    } else {
        v / (1.0 + (0.0 - v))
    }
}

fn mandelbrot_d2_feature(seed: f64, delta: f64) -> f64 with Mut, Div, Panic {
    var z = clip_f64(0.55 * seed + 0.20 * delta, 0.0 - 2.0, 2.0)
    let c = clip_f64(0.35 * seed + 0.25 * delta, 0.0 - 2.0, 2.0)
    var dz = 1.0 + 0.10 * delta
    var ddz = 0.0
    var it: i64 = 0
    while it < 3 {
        ddz = 2.0 * (dz * dz + z * ddz)
        dz = 2.0 * z * dz + 1.0 + 0.15 * delta
        z = z * z + c
        z = clip_f64(z, 0.0 - 4.0, 4.0)
        dz = clip_f64(dz, 0.0 - 6.0, 6.0)
        ddz = clip_f64(ddz, 0.0 - 8.0, 8.0)
        it = it + 1
    }
    clip_f64(md2_squash(ddz), 0.0 - 1.5, 1.5)
}

fn scheduled_assoc_target() -> f64 with Div {
    if cfg_assoc_schedule_mode() <= 0 || TRAIN_EPOCH_TOTAL <= 1 {
        return cfg_assoc_target(1)
    }
    let denom = if TRAIN_EPOCH_TOTAL > 1 { TRAIN_EPOCH_TOTAL - 1 } else { 1 }
    let prog = clip_f64((TRAIN_EPOCH_CURSOR as f64) / (denom as f64), 0.0, 1.0)
    if prog <= 0.5 {
        lerp_f64(cfg_assoc_schedule_start(), cfg_assoc_schedule_mid(), prog / 0.5)
    } else {
        lerp_f64(cfg_assoc_schedule_mid(), cfg_assoc_schedule_end(), (prog - 0.5) / 0.5)
    }
}

fn scaled_optional_count(total: i64, bp: i64) -> i64 with Mut, Div {
    if total <= 0 || bp <= 0 { return 0 }
    if bp >= 1000000 { return total }
    var keep = (total * bp + 500000) / 1000000
    if keep < 0 { keep = 0 }
    if keep > total { keep = total }
    keep
}

fn exp_q(x: f64) -> f64 with Mut, Div, Panic {
    if x > 15.0 { return exp_q(7.5) * exp_q(x - 7.5) }
    if x < 0.0 - 15.0 { return 0.0 }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 20 {
        term = term * x / (i as f64)
        sum = sum + term
        i = i + 1
    }
    sum
}

fn sqrt_q(x: f64) -> f64 with Mut, Div, Panic {
    if x != x { return 0.0 }
    if x <= 0.0 { return 0.0 }
    var g = x
    var i = 0
    while i < 16 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    if g != g { return 0.0 }
    g
}

fn sigmoid_q(x: f64) -> f64 with Mut, Div, Panic {
    if x >= 0.0 {
        1.0 / (1.0 + exp_q(0.0 - x))
    } else {
        let ex = exp_q(x)
        ex / (1.0 + ex)
    }
}

fn rng_seed(a: i64, b: i64) with Mut {
    RNG_A = a
    RNG_B = b
}

fn rng_next() -> i64 with Mut {
    var x = RNG_A
    let y = RNG_B
    RNG_A = y
    x = x ^ (x << 23)
    x = x ^ (x >> 17)
    x = x ^ (y ^ (y >> 26))
    RNG_B = x
    let r = x + y
    if r < 0 { 0 - r } else { r }
}

fn randf() -> f64 with Mut, Div {
    ((rng_next() % 20000) as f64 - 10000.0) / 10000.0
}

fn i64_to_string(v: i64) -> string with Mut, Panic, Div {
    if v == 0 { return "0" }
    var n = v
    var neg = false
    if n < 0 {
        neg = true
        n = 0 - n
    }
    var rev: [i8; 32] = [0; 32]
    var rev_len: i64 = 0
    while n > 0 && rev_len < 31 {
        let digit = n % 10
        rev[rev_len as usize] = (48 + digit) as i8
        rev_len = rev_len + 1
        n = n / 10
    }
    var out: [i8; 64] = [0; 64]
    var out_len: i64 = 0
    if neg {
        out[out_len as usize] = 45 as i8
        out_len = out_len + 1
    }
    var i = rev_len - 1
    while i >= 0 {
        out[out_len as usize] = rev[i as usize]
        out_len = out_len + 1
        if i == 0 { break }
        i = i - 1
    }
    str_from_bytes(out, out_len)
}

fn read_text_file(path: string) -> string with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 0 { return "" }
    let raw = read_file(path)
    str_from_bytes(raw, size)
}

fn load_run_config(path: string) -> i64 with IO, Mut, Panic, Div {
    CFG_TRAIN_FRACTION_BP = 1000000
    CFG_DROP_CHANNEL_FRAC_BP = 0
    CFG_NOISE_STD_BP = 0
    CFG_GLOBAL_TRAIN_EPOCHS = 90
    CFG_GLOBAL_TRAIN_LR_BP = 20000
    CFG_GLOBAL_CORE_LR_SCALE_BP = 350000
    CFG_OCT_TRAIN_EPOCHS = 0
    CFG_OCT_TRAIN_LR_BP = 0
    CFG_OCT_CORE_LR_SCALE_BP = 0
    CFG_OCT_WARMUP_EPOCHS = 0
    CFG_OCT_PROFILE_ID = 0
    CFG_OCT_TRAIN_MODE = 0
    CFG_OCT_INIT_PRESET = 0
    CFG_OCT_ASSOC_REG_BP = 0
    CFG_OCT_ASSOC_TARGET_BP = 0
    CFG_OCT_ASSOC_SCHEDULE_MODE = 0
    CFG_OCT_ASSOC_SCHEDULE_START_BP = 0
    CFG_OCT_ASSOC_SCHEDULE_MID_BP = 0
    CFG_OCT_ASSOC_SCHEDULE_END_BP = 0
    CFG_OCT_ASSOC_DRIFT_REG_BP = 0
    CFG_OCT_HEAD_TRUST_REGION_BP = 0
    CFG_OCT_HEAD_RENORM = 1
    CFG_OCT_ASSOCIATIVE_PROJECTION = 0
    CFG_OCT_INPUT_PROJ_MODE = 0
    CFG_OCT_PROJ_LR_SCALE_BP = 600000
    CFG_OCT_PROJ_STRUCTURED_SCALE_BP = 350000
    CFG_OCT_PROJ_DELTA_SCALE_BP = 180000
    CFG_OCT_PROJ_HYBRID_SCALE_BP = 120000
    CFG_H_TRAIN_EPOCHS = 0
    CFG_H_TRAIN_LR_BP = 0
    CFG_H_CORE_LR_SCALE_BP = 0
    CFG_H_WARMUP_EPOCHS = 0
    CFG_H_INIT_PRESET = 0
    CFG_H_INPUT_PROJ_MODE = 0
    CFG_H_PROJ_LR_SCALE_BP = 600000
    let n = file_size(path)
    if n <= 0 { return 0 }
    let raw = read_file(path)
    let bytes = raw.as_bytes()
    var pos: i64 = 0
    while pos < n {
        while pos < n && (bytes[pos as usize] == 10 || bytes[pos as usize] == 13) {
            pos = pos + 1
        }
        if pos >= n { break }
        var line_end = pos
        while line_end < n && bytes[line_end as usize] != 10 && bytes[line_end as usize] != 13 {
            line_end = line_end + 1
        }
        let line = str_slice(raw, pos, line_end)
        let line_n = str_len(line)
        if starts_with(line, "oct_profile_id=") {
            CFG_OCT_PROFILE_ID = parse_i64_basic(str_slice(line, 15, line_n))
            pos = line_end
            continue
        }
        if starts_with(line, "oct_train_mode=") {
            CFG_OCT_TRAIN_MODE = parse_i64_basic(str_slice(line, 15, line_n))
            pos = line_end
            continue
        }
        if starts_with(line, "oct_assoc_schedule_mode=") {
            CFG_OCT_ASSOC_SCHEDULE_MODE = parse_i64_basic(str_slice(line, 24, line_n))
            pos = line_end
            continue
        }
        if starts_with(line, "oct_assoc_schedule_start=") {
            CFG_OCT_ASSOC_SCHEDULE_START_BP = f64_to_bp(parse_f64_basic(str_slice(line, 25, line_n)))
            pos = line_end
            continue
        }
        if starts_with(line, "oct_assoc_schedule_mid=") {
            CFG_OCT_ASSOC_SCHEDULE_MID_BP = f64_to_bp(parse_f64_basic(str_slice(line, 23, line_n)))
            pos = line_end
            continue
        }
        if starts_with(line, "oct_assoc_schedule_end=") {
            CFG_OCT_ASSOC_SCHEDULE_END_BP = f64_to_bp(parse_f64_basic(str_slice(line, 23, line_n)))
            pos = line_end
            continue
        }
        if starts_with(line, "oct_assoc_drift_reg=") {
            CFG_OCT_ASSOC_DRIFT_REG_BP = f64_to_bp(parse_f64_basic(str_slice(line, 20, line_n)))
            pos = line_end
            continue
        }
        if starts_with(line, "oct_head_trust_region=") {
            CFG_OCT_HEAD_TRUST_REGION_BP = f64_to_bp(parse_f64_basic(str_slice(line, 22, line_n)))
            pos = line_end
            continue
        }
        if starts_with(line, "oct_head_renorm=") {
            CFG_OCT_HEAD_RENORM = parse_i64_basic(str_slice(line, 16, line_n))
            pos = line_end
            continue
        }
        if starts_with(line, "oct_associative_projection=") {
            CFG_OCT_ASSOCIATIVE_PROJECTION = parse_i64_basic(str_slice(line, 27, line_n))
            pos = line_end
            continue
        }
        if starts_with(line, "oct_input_proj_mode=") {
            CFG_OCT_INPUT_PROJ_MODE = parse_i64_basic(str_slice(line, 20, line_n))
            pos = line_end
            continue
        }
        if starts_with(line, "h_input_proj_mode=") {
            CFG_H_INPUT_PROJ_MODE = parse_i64_basic(str_slice(line, 18, line_n))
            pos = line_end
            continue
        }
        if starts_with(line, "oct_proj_lr_scale=") {
