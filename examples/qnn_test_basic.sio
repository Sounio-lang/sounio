//! Basic Quat type test without imports

fn main() {
    // Test basic Quat type and quat() constructor
    let q1 = quat(1.0, 0.0, 0.0, 0.0)
    let q2 = quat(0.0, 1.0, 0.0, 0.0)

    // Access components
    let w = q1.w
    let x = q1.x
    let y = q1.y
    let z = q1.z

    // Test QuatLinear type exists
    let layer: QuatLinear = QuatLinear {
        input_features: 4,
        output_features: 8
    }

    // Test intrinsic calls
    let weights = quat_init_xavier(4, 8, 42)
    let bias = quat_init_xavier(1, 8, 43)
}
