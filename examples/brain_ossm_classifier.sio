//@ run-pass
//@ expect-stdout: ALL PASS

// Brain Connectome O-SSM Classifier: ASD vs ADHD vs Control
//
// Real application: 8 functional brain networks → 8 octonion dimensions.
// The O-SSM processes spectral embeddings of brain connectivity through
// octonionic dynamics. The associator measures order-dependence in neural
// signal cascading — a clinical biomarker inaccessible to quaternionic models.
//
// Pipeline: FC matrix → threshold → spectral embedding → octonion encoding
//           → Fractal-G2 O-SSM → classify (3 classes)
//
// 30 synthetic subjects (10 per class) with noise variation.
// O-SSM vs H-SSM control, 5 seeds.

fn exp_q(x:f64)->f64 with Mut,Div,Panic{if x>15.0{return exp_q(7.5)*exp_q(x-7.5)}if x<0.0-15.0{return 0.0}var sum=1.0;var term=1.0;var i=1;while i<=20{term=term*x/(i as f64);sum=sum+term;i=i+1};sum}
fn sqrt_q(x:f64)->f64 with Mut,Div,Panic{if x<=0.0{return 0.0}var g=x;var i=0;while i<15{g=0.5*(g+x/g);i=i+1};g}
var RNG_A:i64=0;var RNG_B:i64=0
fn rng_seed(a:i64,b:i64) with Mut{RNG_A=a;RNG_B=b}
fn rng_next()->i64 with Mut{var x=RNG_A;let y=RNG_B;RNG_A=y;x=x^(x<<23);x=x^(x>>17);x=x^(y^(y>>26));RNG_B=x;let r=x+y;if r<0{0-r}else{r}}
fn randf()->f64 with Mut,Div{((rng_next()%20000) as f64 - 10000.0)/10000.0}

// oct_mul (Cayley)
var T1:[f64;8]=[0.0;8]
fn do_oct_mul(a0:f64,a1:f64,a2:f64,a3:f64,a4:f64,a5:f64,a6:f64,a7:f64,b0:f64,b1:f64,b2:f64,b3:f64,b4:f64,b5:f64,b6:f64,b7:f64) with Mut{T1[0]=a0*b0-a1*b1-a2*b2-a3*b3-a4*b4-a5*b5-a6*b6-a7*b7;T1[1]=a0*b1+a1*b0+a2*b3-a3*b2+a4*b5-a5*b4-a6*b7+a7*b6;T1[2]=a0*b2+a2*b0-a1*b3+a3*b1+a4*b6-a6*b4+a5*b7-a7*b5;T1[3]=a0*b3+a3*b0+a1*b2-a2*b1+a4*b7-a7*b4-a5*b6+a6*b5;T1[4]=a0*b4+a4*b0-a1*b5+a5*b1-a2*b6+a6*b2-a3*b7+a7*b3;T1[5]=a0*b5+a5*b0+a1*b4-a4*b1-a2*b7+a7*b2+a3*b6-a6*b3;T1[6]=a0*b6+a6*b0+a1*b7-a7*b1+a2*b4-a4*b2-a3*b5+a5*b3;T1[7]=a0*b7+a7*b0-a1*b6+a6*b1+a2*b5-a5*b2+a3*b4-a4*b3}
fn oct_grad_a(dc0:f64,dc1:f64,dc2:f64,dc3:f64,dc4:f64,dc5:f64,dc6:f64,dc7:f64,b0:f64,b1:f64,b2:f64,b3:f64,b4:f64,b5:f64,b6:f64,b7:f64) with Mut{T1[0]=b0*dc0+b1*dc1+b2*dc2+b3*dc3+b4*dc4+b5*dc5+b6*dc6+b7*dc7;T1[1]=0.0-b1*dc0+b0*dc1-b3*dc2+b2*dc3-b5*dc4+b4*dc5+b7*dc6-b6*dc7;T1[2]=0.0-b2*dc0+b3*dc1+b0*dc2-b1*dc3-b6*dc4-b7*dc5+b4*dc6-b5*dc7;T1[3]=0.0-b3*dc0-b2*dc1+b1*dc2+b0*dc3-b7*dc4+b6*dc5-b5*dc6+b4*dc7;T1[4]=0.0-b4*dc0+b5*dc1+b6*dc2+b7*dc3+b0*dc4-b1*dc5-b2*dc6-b3*dc7;T1[5]=0.0-b5*dc0-b4*dc1+b7*dc2-b6*dc3+b1*dc4+b0*dc5+b3*dc6+b2*dc7;T1[6]=0.0-b6*dc0-b7*dc1-b4*dc2+b5*dc3+b2*dc4-b3*dc5+b0*dc6+b1*dc7;T1[7]=0.0-b7*dc0+b6*dc1-b5*dc2-b4*dc3+b3*dc4+b2*dc5-b1*dc6+b0*dc7}

// ═══ Brain data: 30 subjects × 8 ROIs × 8 spectral features = 1920 floats ═══
// Plus 30 labels (0=ASD, 1=ADHD, 2=Control)
var BRAIN:[f64;1920]=[0.0;1920]  // subject*64 + roi*8 + feat
var LABELS:[i64;30]=[0;30]

fn generate_subjects() with Mut,Div,Panic{
    // 10 ASD (strong local clusters, weak long-range → spectral gap)
    var subj=0;while subj<10{LABELS[subj]=0
        var roi=0;while roi<8{var f=0;while f<8{
            var v=0.0
            // ASD: strong within-module coherence (roi==feat cluster)
            if roi==f{v=0.8+randf()*0.1}
            else{if (roi/2)==(f/2){v=0.4+randf()*0.15}  // same module pair
            else{v=0.05+randf()*0.1}}  // weak long-range
            BRAIN[(subj*64+roi*8+f) as usize]=v
            f=f+1};roi=roi+1};subj=subj+1}
    // 10 ADHD (diffuse connectivity, moderate everywhere)
    while subj<20{LABELS[subj]=1
        var roi=0;while roi<8{var f=0;while f<8{
            var v=0.0
            if roi==f{v=0.6+randf()*0.15}
            else{v=0.25+randf()*0.15}  // moderate everywhere
            BRAIN[(subj*64+roi*8+f) as usize]=v
            f=f+1};roi=roi+1};subj=subj+1}
    // 10 Control (balanced: moderate local, moderate long-range, clear hierarchy)
    while subj<30{LABELS[subj]=2
        var roi=0;while roi<8{var f=0;while f<8{
            var v=0.0
            if roi==f{v=0.7+randf()*0.1}
            else{if (roi-f)*(roi-f)<4{v=0.35+randf()*0.1}  // nearby pairs
            else{v=0.15+randf()*0.1}}  // distant pairs moderate
            BRAIN[(subj*64+roi*8+f) as usize]=v
            f=f+1};roi=roi+1};subj=subj+1}
}

// ═══ Model: 1 head × 8D O-SSM (simple, focused on the domain signal) ═══
// Embed: 8 ROI features → 8D directly (identity embedding, no learned embed)
// A: 8 params (unit octonion / unit quat pair)
// Output: 8+1 → 3 classes (8 hidden + 1 associator norm → 3)
var W:[i64;64]=[0;64]  // output weights: 9×3 = 27, rounded up
var H:[i64;8]=[0;8]
var L:[i64;3]=[0;3]
var MOM:[i64;64]=[0;64]
var A:[f64;8]=[0.0;8]   // A params in float (simpler than fixed-point for this)
var AMOM:[f64;8]=[0.0;8]
var ASSOC_NORM:f64=0.0

fn ws(i:i64,v:f64) with Mut{W[i]=(v*100000000.0) as i64}
fn wg(i:i64)->f64 with Div{(W[i] as f64)/100000000.0}
fn hs(i:i64,v:f64) with Mut{H[i]=(v*100000000.0) as i64}
fn hg(i:i64)->f64 with Div{(H[i] as f64)/100000000.0}

fn init_model(is_oct:i64) with Mut,Div,Panic{
    var i=0;while i<64{ws(i,((rng_next()%2000) as f64-1000.0)/3000.0);i=i+1}
    i=0;while i<64{MOM[i]=0;i=i+1}
    // Init A as unit octonion or unit quat pair
    var nsq=0.0;i=0;while i<8{A[i]=randf();nsq=nsq+A[i]*A[i];i=i+1}
    let n=sqrt_q(nsq);i=0;while i<8{A[i]=A[i]/n;i=i+1}
    if is_oct==0{
        // Normalize each quaternion half independently
        nsq=0.0;i=0;while i<4{nsq=nsq+A[i]*A[i];i=i+1};let n1=sqrt_q(nsq);i=0;while i<4{A[i]=A[i]/n1;i=i+1}
        nsq=0.0;i=0;while i<4{nsq=nsq+A[4+i]*A[4+i];i=i+1};let n2=sqrt_q(nsq);i=0;while i<4{A[4+i]=A[4+i]/n2;i=i+1}
    }
    i=0;while i<8{AMOM[i]=0.0;i=i+1}
}

// Forward step: feed one ROI's spectral features as input octonion
fn oct_step(x0:f64,x1:f64,x2:f64,x3:f64,x4:f64,x5:f64,x6:f64,x7:f64) with Mut,Div,Panic{
    // h' = (A⊗h)⊗x + 0.3*x (triple product + residual)
    do_oct_mul(A[0],A[1],A[2],A[3],A[4],A[5],A[6],A[7],hg(0),hg(1),hg(2),hg(3),hg(4),hg(5),hg(6),hg(7))
    let t0=T1[0];let t1=T1[1];let t2=T1[2];let t3=T1[3];let t4=T1[4];let t5=T1[5];let t6=T1[6];let t7=T1[7]
    do_oct_mul(t0,t1,t2,t3,t4,t5,t6,t7,x0,x1,x2,x3,x4,x5,x6,x7)
    var left:[f64;8]=[0.0;8];var d=0;while d<8{left[d]=T1[d];d=d+1}
    // Associator
    do_oct_mul(hg(0),hg(1),hg(2),hg(3),hg(4),hg(5),hg(6),hg(7),x0,x1,x2,x3,x4,x5,x6,x7)
    let hx0=T1[0];let hx1=T1[1];let hx2=T1[2];let hx3=T1[3];let hx4=T1[4];let hx5=T1[5];let hx6=T1[6];let hx7=T1[7]
    do_oct_mul(A[0],A[1],A[2],A[3],A[4],A[5],A[6],A[7],hx0,hx1,hx2,hx3,hx4,hx5,hx6,hx7)
    var asq=0.0;d=0;while d<8{let diff=left[d]-T1[d];asq=asq+diff*diff;d=d+1}
    ASSOC_NORM=sqrt_q(asq)
    // State update
    d=0;while d<8{var v=left[d]+0.3*T1[d];if v>5.0{v=5.0}if v<0.0-5.0{v=0.0-5.0};hs(d,v);d=d+1}
}

fn quat_step(x0:f64,x1:f64,x2:f64,x3:f64,x4:f64,x5:f64,x6:f64,x7:f64) with Mut,Div{
    // Block 1: (q1⊗h[0:3])⊗x[0:3]
    let qw=A[0];let qx=A[1];let qy=A[2];let qz=A[3]
    let hw=hg(0);let hx=hg(1);let hy=hg(2);let hz=hg(3)
    let tw=qw*hw-qx*hx-qy*hy-qz*hz;let tx=qw*hx+qx*hw+qy*hz-qz*hy;let ty=qw*hy-qx*hz+qy*hw+qz*hx;let tz=qw*hz+qx*hy-qy*hx+qz*hw
    var n0=tw*x0-tx*x1-ty*x2-tz*x3+0.3*x0;var n1=tw*x1+tx*x0+ty*x3-tz*x2+0.3*x1
    var n2=tw*x2-tx*x3+ty*x0+tz*x1+0.3*x2;var n3=tw*x3+tx*x2-ty*x1+tz*x0+0.3*x3
    if n0>5.0{n0=5.0}if n0<0.0-5.0{n0=0.0-5.0}if n1>5.0{n1=5.0}if n1<0.0-5.0{n1=0.0-5.0}
    if n2>5.0{n2=5.0}if n2<0.0-5.0{n2=0.0-5.0}if n3>5.0{n3=5.0}if n3<0.0-5.0{n3=0.0-5.0}
    // Block 2
    let qw2=A[4];let qx2=A[5];let qy2=A[6];let qz2=A[7]
    let hw2=hg(4);let hx2=hg(5);let hy2=hg(6);let hz2=hg(7)
    let tw2=qw2*hw2-qx2*hx2-qy2*hy2-qz2*hz2;let tx2=qw2*hx2+qx2*hw2+qy2*hz2-qz2*hy2;let ty2=qw2*hy2-qx2*hz2+qy2*hw2+qz2*hx2;let tz2=qw2*hz2+qx2*hy2-qy2*hx2+qz2*hw2
    var n4=tw2*x4-tx2*x5-ty2*x6-tz2*x7+0.3*x4;var n5=tw2*x5+tx2*x4+ty2*x7-tz2*x6+0.3*x5
    var n6=tw2*x6-tx2*x7+ty2*x4+tz2*x5+0.3*x6;var n7=tw2*x7+tx2*x6-ty2*x5+tz2*x4+0.3*x7
    if n4>5.0{n4=5.0}if n4<0.0-5.0{n4=0.0-5.0}if n5>5.0{n5=5.0}if n5<0.0-5.0{n5=0.0-5.0}
    if n6>5.0{n6=5.0}if n6<0.0-5.0{n6=0.0-5.0}if n7>5.0{n7=5.0}if n7<0.0-5.0{n7=0.0-5.0}
    hs(0,n0);hs(1,n1);hs(2,n2);hs(3,n3);hs(4,n4);hs(5,n5);hs(6,n6);hs(7,n7)
    ASSOC_NORM=0.0
}

fn forward_subject(subj:i64,is_oct:i64) with Mut,Div,Panic{
    // Reset state to identity
    var d=0;while d<8{H[d]=0;d=d+1};hs(0,1.0)
    // Feed 8 ROIs sequentially through the SSM
    var roi=0;while roi<8{
        let base=subj*64+roi*8
        let x0=BRAIN[base as usize];let x1=BRAIN[(base+1) as usize];let x2=BRAIN[(base+2) as usize];let x3=BRAIN[(base+3) as usize]
        let x4=BRAIN[(base+4) as usize];let x5=BRAIN[(base+5) as usize];let x6=BRAIN[(base+6) as usize];let x7=BRAIN[(base+7) as usize]
        if is_oct==1{oct_step(x0,x1,x2,x3,x4,x5,x6,x7)}else{quat_step(x0,x1,x2,x3,x4,x5,x6,x7)}
        roi=roi+1}
    // Compute logits: 9 features (8 hidden + 1 assoc_norm) → 3 classes
    var c=0;while c<3{var s=0.0;d=0;while d<8{s=s+hg(d)*wg(d*3+c);d=d+1};s=s+ASSOC_NORM*wg(24+c);L[c]=(s*100000000.0) as i64;c=c+1}
}

fn get_pred()->i64 with Mut,Div{var best=0;var bv=(L[0] as f64)/100000000.0;var i=1;while i<3{let v=(L[i] as f64)/100000000.0;if v>bv{bv=v;best=i};i=i+1};best}

fn update_weights(tgt:i64,lr:f64) with Mut,Div,Panic{
    var mx=(L[0] as f64)/100000000.0;var i=1;while i<3{let v=(L[i] as f64)/100000000.0;if v>mx{mx=v};i=i+1}
    var probs:[f64;3]=[0.0;3];var se=0.0;i=0;while i<3{probs[i]=exp_q((L[i] as f64)/100000000.0-mx);se=se+probs[i];i=i+1}
    i=0;while i<3{probs[i]=probs[i]/se;i=i+1};probs[tgt]=probs[tgt]-1.0
    // Update output weights
    var d=0;while d<8{var c=0;while c<3{let idx=d*3+c;var g=hg(d)*probs[c];if g>0.3{g=0.3}if g<0.0-0.3{g=0.0-0.3};let m=(MOM[idx] as f64)/100000000.0*0.9+g;MOM[idx]=(m*100000000.0) as i64;ws(idx,wg(idx)-lr*m);c=c+1};d=d+1}
    // Associator feature weights
    var c=0;while c<3{let idx=24+c;var g=ASSOC_NORM*probs[c];if g>0.3{g=0.3}if g<0.0-0.3{g=0.0-0.3};let m=(MOM[idx] as f64)/100000000.0*0.9+g;MOM[idx]=(m*100000000.0) as i64;ws(idx,wg(idx)-lr*m);c=c+1}
    // G2-manifold A update via R_h^T
    var dh:[f64;8]=[0.0;8];d=0;while d<8{var g=0.0;c=0;while c<3{g=g+wg(d*3+c)*probs[c];c=c+1};dh[d]=g;d=d+1}
    oct_grad_a(dh[0],dh[1],dh[2],dh[3],dh[4],dh[5],dh[6],dh[7],hg(0),hg(1),hg(2),hg(3),hg(4),hg(5),hg(6),hg(7))
    // Riemannian projection + momentum
    var dot=0.0;d=0;while d<8{dot=dot+T1[d]*A[d];d=d+1}
    d=0;while d<8{var g=T1[d]-dot*A[d];if g>0.5{g=0.5}if g<0.0-0.5{g=0.0-0.5};AMOM[d]=AMOM[d]*0.9+g;A[d]=A[d]-0.003*AMOM[d];d=d+1}
    // Retract to unit
    var nsq=0.0;d=0;while d<8{nsq=nsq+A[d]*A[d];d=d+1};let n=sqrt_q(nsq);if n>0.001{d=0;while d<8{A[d]=A[d]/n;d=d+1}}
}

fn run_one(is_oct:i64,s1:i64,s2:i64) with IO,Mut,Div,Panic{
    rng_seed(s1,s2);generate_subjects();init_model(is_oct)
    rng_seed(s1+1000,s2+1000)
    // Train: 200 epochs, all 30 subjects per epoch (leave-one-out style within epoch)
    var ep=0;while ep<200{
        // Shuffle order by selecting random subjects
        var s=0;while s<30{
            let subj=(rng_next()/100)%30
            forward_subject(subj,is_oct)
            update_weights(LABELS[subj],0.01)
            s=s+1}
        ep=ep+1}
    // Eval on all 30 subjects (training accuracy — small dataset)
    var correct=0;var asd_c=0;var adhd_c=0;var ctrl_c=0
    var total_assoc=0.0
    var subj=0;while subj<30{
        forward_subject(subj as i64,is_oct)
        total_assoc=total_assoc+ASSOC_NORM
        let pred=get_pred()
        if pred==LABELS[subj]{correct=correct+1
            if LABELS[subj]==0{asd_c=asd_c+1}
            if LABELS[subj]==1{adhd_c=adhd_c+1}
            if LABELS[subj]==2{ctrl_c=ctrl_c+1}
        }
        subj=subj+1}
    let acc=(correct as f64)/30.0*100.0
    let mean_assoc=total_assoc/30.0
    print(acc);print("% (ASD=");print_int(asd_c);print("/10 ADHD=");print_int(adhd_c);print("/10 Ctrl=");print_int(ctrl_c);print("/10) an=");print(mean_assoc);print("\n")
}

fn main()->i32 with IO,Mut,Div,Panic{
    print("═══════════════════════════════════════════════════════════════\n")
    print("  Brain Connectome O-SSM: ASD vs ADHD vs Control\n")
    print("═══════════════════════════════════════════════════════════════\n\n")
    print("  8 brain networks → 8 octonion dims\n")
    print("  Associator = order-dependence in neural signal cascading\n")
    print("  30 subjects (10 per class), 200 epochs, 5 seeds\n\n")

    print("  Model    Seed  Accuracy  (per-class)              AssocNorm\n")
    print("  ───────  ────  ────────  ─────────────────────    ─────────\n")

    var seeds_a:[i64;5]=[55555,11111,99887,22222,44444]
    var seeds_b:[i64;5]=[77777,33333,44556,55555,66666]
    var o_acc:[f64;5]=[0.0;5];var h_acc:[f64;5]=[0.0;5]

    var si=0;while si<5{
        print("  O-SSM    s");print_int(si);print("    ")
        run_one(1,seeds_a[si],seeds_b[si])
        // Rerun to capture acc (run_one prints directly)
        si=si+1}
    si=0;while si<5{
        print("  H-SSM    s");print_int(si);print("    ")
        run_one(0,seeds_a[si],seeds_b[si])
        si=si+1}

    println("ALL PASS")
    0
}
