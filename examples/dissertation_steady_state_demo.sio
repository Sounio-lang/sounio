//@ run-pass
//@ expect-stdout: SS DEMO OK

// Multi-dose rapamycin steady-state demo.
// 2 mg oral q24h × 7 days. Expect C_trough to climb, then plateau
// once cumulative absorption balances elimination (rapamycin t½ ~60 h
// in vivo, ~21 h in the distribution-capped dissertation model).

use darwin_pbpk::absorption::{rapamycin_absorption_params}
use darwin_pbpk::bbb::bbb_rapamycin::{bbb_rapamycin_params}
use darwin_pbpk::drugs::rapamycin::{rapamycin_mean_params}
use darwin_pbpk::scenarios::steady_state_runner::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let sys_prm = rapamycin_mean_params()
    let bbb_prm = bbb_rapamycin_params()
    let abs_prm = rapamycin_absorption_params()

    let regimen = rapamycin_qd_regimen(7)   // 7 doses, q24h, 2 mg each

    let report = run_oral_multidose(sys_prm, bbb_prm, abs_prm, regimen, 0.02)

    println("--- 7-day oral rapamycin 2 mg q24h ---")
    print("doses_run      = "); print_f64(report.n_doses_run as f64); println("")
    if report.reached_ss {
        print("SS reached @ dose #"); print_f64(report.dose_of_ss as f64); println("")
        print("C_max_ss       = "); print_f64(report.c_max_ss);       println(" mg/L")
        print("C_trough_ss    = "); print_f64(report.c_trough_ss);    println(" mg/L")
        print("AUC_tau_ss_u   = "); print_f64(report.auc_tau_ss);     println(" mg·h/L")
        print("AUC_icf_tau_u  = "); print_f64(report.auc_icf_tau_ss); println(" mg·h/L")
    } else {
        println("SS not reached within 7 doses (expected for t½ ~60 h)")
    }
    print("t_to_90pct_h   = "); print_f64(report.t_to_90pct_h); println("")

    // Per-dose C_trough should grow monotonically during accumulation
    println("")
    println("--- Per-dose diagnostic ---")
    println("dose,C_max,C_trough,AUC_tau")
    var i: i32 = 0
    while i < report.n_doses_run {
        let idx = i as usize
        print_f64((i + 1) as f64);                  print(",")
        print_f64(report.c_max_per_dose[idx]);      print(",")
        print_f64(report.c_trough_per_dose[idx]);   print(",")
        print_f64(report.auc_tau_per_dose[idx])
        println("")
        i = i + 1
    }

    println("SS DEMO OK")
    0
}
