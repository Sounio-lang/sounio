//@ run-pass
//! examples/sedenion_projective_measurement.sio
//!
//! Sedenion Projective Measurement — physically defensible reading of the
//! sedenion zero-divisor structure.
//!
//! The canonical sedenion zero-divisor A = e3 + e10 defines a real-linear
//! operator on the 16-dimensional state space R^16 ≅ S by
//!     L_A : R^16 -> R^16,   L_A(h) := sed_mul(A, h).
//! L_A is bilinear in h, hence linear, so its kernel and image are honest
//! real subspaces.
//!
//! By Moreno's classification (formalised in SounioZeroDivisorBridge.lean),
//! the kernel of L_A is the 4-dimensional subspace
//!     ker L_A = span { e4 + e13,  e5 - e12,  e6 - e15,  e7 + e14 },
//! and rank(L_A) = 12. Hence L_A is non-invertible: it is the algebraic
//! skeleton of a NON-UNITARY, rank-12 operation on R^16 — the structural
//! shape of a projective measurement / decoherence channel that exactly
//! erases a 4D subspace of information. This is NOT a Heisenberg violation:
//! sigma_x sigma_p >= hbar/2 is a theorem about unitary evolution, which
//! L_A is not.
//!
//! Control: L_X for X = e1 has rank 16 (e1 is an imaginary unit, hence
//! invertible). This confirms that the rank deficit is specific to the
//! zero-divisor structure of A, not to the linear-operator machinery.

use algebra::sedenion::{
    sed_basis, sed_mul, sed_norm_sq, sed_canonical_zd_z
}

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

// Build M[i, k] = (L_Z e_k)[i] = sed_mul(z, e_k)[i].  Row-major: M[16*i+k].
fn build_left_mult_matrix(z: &[f64; 16], out: &![f64; 256]) with Mut, Div, Panic {
    var ek: [f64; 16] = [0.0; 16]
    var prod: [f64; 16] = [0.0; 16]
    var k: i64 = 0
    while k < 16 {
        sed_basis(k, &!ek)
        sed_mul(z, &ek, &!prod)
        var i: i64 = 0
        while i < 16 {
            (*out)[(16 * i + k) as usize] = prod[i as usize]
            i = i + 1
        }
        k = k + 1
    }
}

// Gauss elimination with partial pivoting; returns the numerical rank.
// The matrix `m` is destroyed in place. Tolerance is absolute on pivots.
fn rank_16x16(m: &![f64; 256], tol: f64) -> i64 with Mut, Div, Panic {
    var rank: i64 = 0
    var row: i64 = 0
    var col: i64 = 0
    while col < 16 && row < 16 {
        var pivot_row: i64 = 0 - 1
        var best: f64 = tol
        var r: i64 = row
        while r < 16 {
            let v = (*m)[(16 * r + col) as usize]
            let av = abs_f64(v)
            if av > best { best = av; pivot_row = r }
            r = r + 1
        }
        if pivot_row < 0 {
            col = col + 1
        } else {
            if pivot_row != row {
                var j: i64 = 0
                while j < 16 {
                    let a = (*m)[(16 * row + j) as usize]
                    let b = (*m)[(16 * pivot_row + j) as usize]
                    (*m)[(16 * row + j) as usize] = b
                    (*m)[(16 * pivot_row + j) as usize] = a
                    j = j + 1
                }
            }
            let piv = (*m)[(16 * row + col) as usize]
            var rr: i64 = row + 1
            while rr < 16 {
                let factor = (*m)[(16 * rr + col) as usize] / piv
                var j: i64 = col
                while j < 16 {
                    let nv = (*m)[(16 * rr + j) as usize] - factor * (*m)[(16 * row + j) as usize]
                    (*m)[(16 * rr + j) as usize] = nv
                    j = j + 1
                }
                rr = rr + 1
            }
            rank = rank + 1
            row = row + 1
            col = col + 1
        }
    }
    rank
}

// Verify L_A(v) = 0 for a candidate v.  Returns ||L_A v||^2.
fn anni_norm_sq(A: &[f64; 16], v: &[f64; 16]) -> f64 with Mut, Div, Panic {
    var P: [f64; 16] = [0.0; 16]
    sed_mul(A, v, &!P)
    sed_norm_sq(&P)
}

// L2 inner product on R^16 (used for the orthogonal CPTP-like channel).
fn dot16(a: &[f64; 16], b: &[f64; 16]) -> f64 with Mut, Div, Panic {
    var s: f64 = 0.0
    var i: i64 = 0
    while i < 16 { s = s + a[i as usize] * b[i as usize]; i = i + 1 }
    s
}


fn main() -> i32 with IO, Mut, Div, Panic {
    println("================================================================")
    println("  Sedenion Projective Measurement on R^16")
    println("================================================================")
    println("  A := e3 + e10   (canonical sedenion zero-divisor)")
    println("  L_A(h) := sed_mul(A, h)   on  R^16 ~ S")
    println("")

    // (1) rank(L_A) on the canonical ZD
    var A: [f64; 16] = [0.0; 16]
    sed_canonical_zd_z(&!A)
    var M: [f64; 256] = [0.0; 256]
    build_left_mult_matrix(&A, &!M)
    let rank_A = rank_16x16(&!M, 1.0e-10)
    let ker_dim = 16 - rank_A
    print("  rank(L_A)     = "); print(rank_A); println("   (measured)")
    print("  dim ker(L_A)  = "); print(ker_dim); println("   (measured)")
    if rank_A == 16 { println("  FAIL: A is supposed to be a zero-divisor"); return 1 }
    println("  [OK] L_A is non-invertible: A is a genuine sedenion ZD.")
    println("")

    // (2) Explicit 4D kernel basis (per Moreno, formalised in
    //     SounioZeroDivisorBridge.annihilatorsOfA).
    var w1: [f64; 16] = [0.0; 16]
    w1[4] = 1.0; w1[13] = 1.0                 // w1 = e4 + e13
    var w2: [f64; 16] = [0.0; 16]
    w2[5] = 1.0; w2[12] = 0.0 - 1.0           // w2 = e5 - e12
    var w3: [f64; 16] = [0.0; 16]
    w3[6] = 1.0; w3[15] = 0.0 - 1.0           // w3 = e6 - e15
    var w4: [f64; 16] = [0.0; 16]
    w4[7] = 1.0; w4[14] = 1.0                 // w4 = e7 + e14
    let n1 = anni_norm_sq(&A, &w1)
    let n2 = anni_norm_sq(&A, &w2)
    let n3 = anni_norm_sq(&A, &w3)
    let n4 = anni_norm_sq(&A, &w4)
    print("  ||L_A (e4 + e13)||^2 = "); println(n1)
    print("  ||L_A (e5 - e12)||^2 = "); println(n2)
    print("  ||L_A (e6 - e15)||^2 = "); println(n3)
    print("  ||L_A (e7 + e14)||^2 = "); println(n4)
    if n1 > 1.0e-20 { println("  FAIL: e4+e13 should be in ker(L_A)"); return 1 }
    if n2 > 1.0e-20 { println("  FAIL: e5-e12 should be in ker(L_A)"); return 1 }
    if n3 > 1.0e-20 { println("  FAIL: e6-e15 should be in ker(L_A)"); return 1 }
    if n4 > 1.0e-20 { println("  FAIL: e7+e14 should be in ker(L_A)"); return 1 }
    // Pairwise orthogonality (each pair has disjoint support).
    let c12 = dot16(&w1, &w2)
    let c13 = dot16(&w1, &w3)
    let c14 = dot16(&w1, &w4)
    let c23 = dot16(&w2, &w3)
    let c24 = dot16(&w2, &w4)
    let c34 = dot16(&w3, &w4)
    if abs_f64(c12) + abs_f64(c13) + abs_f64(c14) +
       abs_f64(c23) + abs_f64(c24) + abs_f64(c34) > 1.0e-20 {
        println("  FAIL: kernel basis should be pairwise orthogonal"); return 1
    }
    println("  [OK] {e4+e13, e5-e12, e6-e15, e7+e14} is an orthogonal basis of ker(L_A).")
    println("")

    // (3) Control: X = e1 (imaginary unit, NOT a zero-divisor) -> rank 16.
    var X: [f64; 16] = [0.0; 16]
    sed_basis(1, &!X)
    var Mc: [f64; 256] = [0.0; 256]
    build_left_mult_matrix(&X, &!Mc)
    let rank_X = rank_16x16(&!Mc, 1.0e-10)
    print("  rank(L_X) for X = e1 = "); print(rank_X); println("   (expected 16)")
    if rank_X != 16 { println("  FAIL: e1 should be invertible"); return 1 }
    println("  [OK] Non-ZD generator preserves all 16 real dimensions.")
    println("")

    // (4) CPTP-like erasure channel  E(rho) = P_ker(rho) (+) P_im(rho).
    //     Apply to a test vector rho_0 = uniform variance on R^16.
    //     The projection onto ker uses the orthogonal basis {w1, w2, w3, w4}:
    //       P_ker(rho) = sum_k <rho, w_k>/<w_k, w_k> * w_k.
    var rho: [f64; 16] = [0.0; 16]
    var ki: i64 = 0
    while ki < 16 { rho[ki as usize] = 1.0; ki = ki + 1 }
    let nrm1 = dot16(&w1, &w1)
    let nrm2 = dot16(&w2, &w2)
    let nrm3 = dot16(&w3, &w3)
    let nrm4 = dot16(&w4, &w4)
    let c1 = dot16(&rho, &w1) / nrm1
    let c2 = dot16(&rho, &w2) / nrm2
    let c3 = dot16(&rho, &w3) / nrm3
    let c4 = dot16(&rho, &w4) / nrm4
    var rho_ker: [f64; 16] = [0.0; 16]
    var i: i64 = 0
    while i < 16 {
        rho_ker[i as usize] = c1 * w1[i as usize] + c2 * w2[i as usize]
                            + c3 * w3[i as usize] + c4 * w4[i as usize]
        i = i + 1
    }
    let mass_ker = dot16(&rho_ker, &rho_ker)
    let mass_tot = dot16(&rho, &rho)
    let mass_im = mass_tot - mass_ker
    print("  ||rho||^2          = "); println(mass_tot)
    print("  ||P_ker rho||^2    = "); println(mass_ker)
    print("  ||P_im  rho||^2    = "); println(mass_im)
    if mass_ker <= 0.0 { println("  FAIL: channel did not project on kernel"); return 1 }
    println("  [OK] CPTP-like channel splits rho into im/ker components.")
    println("")

    println("================================================================")
    println("  Reading: L_A is a rank-12 NON-UNITARY operator on R^16 with a")
    println("  4D kernel. Four real dimensions of state-space information are")
    println("  exactly erased by left multiplication by the sedenion ZD A.")
    println("  This is the algebraic skeleton of a projective measurement /")
    println("  decoherence channel. The Heisenberg uncertainty principle is")
    println("  a theorem about unitary evolution and is NOT touched here.")
    println("================================================================")
    0
}
