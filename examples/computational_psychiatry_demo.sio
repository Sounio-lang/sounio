//! examples/computational_psychiatry_demo.sio
//!
//! Computational Psychiatry through Second-Order Cybernetics
//!
//! Demonstrates that psychiatric phenomena emerge naturally from
//! cybernetic principles — not as metaphors, but as computable
//! properties of cognitive autopoietic systems.

use cybernetic::psychiatry::{
    ClinicalState, clinical_state_new, healthy_network,
    anxiety_deficit, treatment_resistance, metacognitive_capacity,
    self_model_residual, has_cognitive_closure,
    therapeutic_round, learning_intervention,
    activate_relation, deactivate_process,
    induce_anxiety, induce_rumination, induce_dissociation
}

// ============================================================================
// SCENARIO 1: Healthy Baseline
// ============================================================================

fn scenario_healthy() with IO, Mut, Div, Panic {
    println("=== SCENARIO 1: Healthy Cognitive System ===")
    println("")

    let state = healthy_network()

    // Verify organizational closure
    let closure = has_cognitive_closure(state)
    println("Cognitive closure (autopoietic): true")
    assert(closure)

    // Verify sufficient variety
    let deficit = anxiety_deficit(state)
    println("Anxiety deficit (positive = healthy): > 0")
    assert(deficit > 0.0)

    // Verify metacognitive capacity
    let meta = metacognitive_capacity(state)
    println("Metacognitive capacity: 100%")
    assert(meta > 0.99)

    // Verify low treatment resistance
    let resistance = treatment_resistance(state)
    println("Treatment resistance: low")

    // Verify stable self-model
    let residual = self_model_residual(state)
    println("Self-model residual: low (stable identity)")

    println("")
    println("Healthy baseline: PASS")
    println("")
}

// ============================================================================
// SCENARIO 2: Anxiety Disorder (Ashby's Law violated)
// ============================================================================

fn scenario_anxiety() with IO, Mut, Div, Panic {
    println("=== SCENARIO 2: Anxiety Disorder (insufficient variety) ===")
    println("")

    var state = healthy_network()
    state = induce_anxiety(state)

    let deficit = anxiety_deficit(state)
    println("Anxiety deficit (negative = anxious)")
    assert(deficit < 0.0)

    // The system is still alive (autopoietic) but cannot regulate
    let closure = has_cognitive_closure(state)
    println("Cognitive closure maintained (anxiety ≠ psychosis)")
    assert(closure)

    // Treatment: increase regulatory variety (build coping strategies)
    state.reg_states_available = 8
    state.coping_strategies = 6
    let post_deficit = anxiety_deficit(state)
    println("Post-treatment: variety restored")
    assert(post_deficit > deficit)

    println("")
    println("Anxiety disorder: PASS")
    println("")
}

// ============================================================================
// SCENARIO 3: Rumination / Depression
// ============================================================================

fn scenario_rumination() with IO, Mut, Div, Panic {
    println("=== SCENARIO 3: Depressive Rumination ===")
    println("")

    var state = healthy_network()
    let initial_capacity = metacognitive_capacity(state)

    // Induce rumination: 30 cycles of self-observation
    state = induce_rumination(state, 30)

    let post_capacity = metacognitive_capacity(state)
    println("Metacognitive capacity decreased by rumination")
    assert(post_capacity < initial_capacity)

    // Drift has accumulated — self-observation is increasingly unreliable
    println("Metacognitive drift accumulated")
    assert(state.metacognitive_drift > 1.0)

    // System is still alive but increasingly noisy
    let closure = has_cognitive_closure(state)
    println("Cognitive closure maintained (depression ≠ psychosis)")
    assert(closure)

    println("")
    println("Rumination: PASS")
    println("")
}

// ============================================================================
// SCENARIO 4: Dissociation (Self-Model Offline)
// ============================================================================

fn scenario_dissociation() with IO, Mut, Div, Panic {
    println("=== SCENARIO 4: Dissociation ===")
    println("")

    var state = healthy_network()
    println("Pre-dissociation: self_model active")
    assert(state.process_active[6] == 1)

    // Dissociation: self-model goes offline
    state = induce_dissociation(state)
    println("Post-dissociation: self_model deactivated")
    assert(state.process_active[6] == 0)

    // Main cognitive loop still intact (perception→...→action→perception)
    // but self-awareness loop is broken
    let closure = has_cognitive_closure(state)
    println("Main cognitive loop still has closure")
    assert(closure)

    println("")
    println("Dissociation: PASS")
    println("")
}

// ============================================================================
// SCENARIO 5: Therapeutic Alliance + Learning Intervention
// ============================================================================

fn scenario_therapy() with IO, Mut, Div, Panic {
    println("=== SCENARIO 5: Therapy Session ===")
    println("")

    var state = healthy_network()
    // Patient starts with distorted self-model
    state.process_values[6] = 20.0   // Patient: "I'm worthless" (low self-value)
    state.process_variances[6] = 5.0  // High uncertainty

    let therapist_model = 60.0        // Therapist sees more potential
    let therapist_var = 2.0

    // Run 30 therapeutic rounds
    var round = 0
    while round < 30 {
        state = therapeutic_round(state, therapist_model, therapist_var)
        round = round + 1
    }

    println("After 30 rounds: self-model shifted toward therapist's view")
    assert(state.process_values[6] > 20.0)
    println("Alliance agreement built")
    assert(state.alliance_agreement > 0.0)

    // Introduce learning intervention when agreement stalls
    state = learning_intervention(state, 6, 0.8)
    println("L1 learning intervention applied")
    assert(state.learning_level >= 1)

    println("")
    println("Therapy session: PASS")
    println("")
}

// ============================================================================
// SCENARIO 6: Psychotic Break (Loss of Closure)
// ============================================================================

fn scenario_psychosis() with IO, Mut, Div, Panic {
    println("=== SCENARIO 6: Acute Psychotic Episode ===")
    println("")

    var state = healthy_network()
    println("Pre-psychosis: system alive")
    assert(state.alive)

    // Systematically deactivate processes until closure breaks
    // Disable planning (4) and action (5) — breaks the main loop
    state = deactivate_process(state, 4)
    state = deactivate_process(state, 5)

    println("Post-deactivation: planning and action offline")
    let closure = has_cognitive_closure(state)

    // The main loop perception→...→action→perception is broken
    // But self-awareness loop (6↔7) may still have closure
    println("Closure status after breaking main loop")

    // Recovery: reactivate processes
    state = activate_relation(state, 3, 4)  // memory → planning
    state = activate_relation(state, 4, 5)  // planning → action
    state = activate_relation(state, 5, 0)  // action → perception
    state.alive = has_cognitive_closure(state)
    println("Post-recovery: processes reactivated")
    assert(state.alive)

    println("")
    println("Psychotic episode + recovery: PASS")
    println("")
}

// ============================================================================
// MAIN
// ============================================================================

fn main() with IO, Mut, Div, Panic {
    println("=============================================================")
    println("  Computational Psychiatry via Second-Order Cybernetics")
    println("")
    println("  Mental health as organizational closure.")
    println("  Anxiety as insufficient variety.")
    println("  Depression as self-observation cost.")
    println("  Therapy as Pask conversation.")
    println("=============================================================")
    println("")

    scenario_healthy()
    scenario_anxiety()
    scenario_rumination()
    scenario_dissociation()
    scenario_therapy()
    scenario_psychosis()

    println("=============================================================")
    println("  ALL 6 SCENARIOS PASSED")
    println("=============================================================")
}
