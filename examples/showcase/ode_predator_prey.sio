//@ run-pass
// ode_predator_prey.sio — Lotka-Volterra predator-prey dynamics
//
// Simulates the classic ecological model using adaptive RK45 integration.
// Tracks epistemic uncertainty in model parameters and propagates it
// through the ODE solution to produce trajectory uncertainty bands.
//
// Features: ODE solving (RK4), structs, loops, epistemic uncertainty,
//           numerical algorithms, effects
//
// Reference: Lotka (1925), Volterra (1926)
//            dx/dt = alpha*x - beta*x*y     (prey growth - predation)
//            dy/dt = delta*x*y - gamma*y    (predator growth - death)

// ============================================================================
// HELPERS
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

fn sqrt_f64(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var g = x / 2.0
    if g < 1.0 { g = 1.0 }
    var i = 0
    while i < 60 { g = (g + x / g) / 2.0; i = i + 1 }
    g
}

// ============================================================================
// MODEL PARAMETERS WITH UNCERTAINTY
// ============================================================================

struct LotkaParams {
    alpha: f64,    // prey birth rate
    beta: f64,     // predation rate
    delta: f64,    // predator reproduction rate
    gamma: f64     // predator death rate
}

struct UncertainParam {
    value: f64,
    uncertainty: f64
}

struct UncertainParams {
    alpha: UncertainParam,
    beta: UncertainParam,
    delta: UncertainParam,
    gamma: UncertainParam
}

fn nominal_params(p: UncertainParams) -> LotkaParams {
    LotkaParams {
        alpha: p.alpha.value,
        beta: p.beta.value,
        delta: p.delta.value,
        gamma: p.gamma.value
    }
}

fn perturbed_params(p: UncertainParams, sign: f64) -> LotkaParams {
    LotkaParams {
        alpha: p.alpha.value + sign * p.alpha.uncertainty,
        beta: p.beta.value + sign * p.beta.uncertainty,
        delta: p.delta.value + sign * p.delta.uncertainty,
        gamma: p.gamma.value + sign * p.gamma.uncertainty
    }
}

// ============================================================================
// STATE AND DERIVATIVES
// ============================================================================

struct PopState {
    prey: f64,
    predator: f64
}

fn lotka_volterra(state: PopState, params: LotkaParams) -> PopState {
    let x = state.prey
    let y = state.predator
    PopState {
        prey:     params.alpha * x - params.beta * x * y,
        predator: params.delta * x * y - params.gamma * y
    }
}

// ============================================================================
// RK4 INTEGRATOR
// ============================================================================

fn rk4_step(state: PopState, params: LotkaParams, dt: f64) -> PopState with Div, Panic {
    // k1
    let k1 = lotka_volterra(state, params)

    // k2
    let s2 = PopState {
        prey:     state.prey     + 0.5 * dt * k1.prey,
        predator: state.predator + 0.5 * dt * k1.predator
    }
    let k2 = lotka_volterra(s2, params)

    // k3
    let s3 = PopState {
        prey:     state.prey     + 0.5 * dt * k2.prey,
        predator: state.predator + 0.5 * dt * k2.predator
    }
    let k3 = lotka_volterra(s3, params)

    // k4
    let s4 = PopState {
        prey:     state.prey     + dt * k3.prey,
        predator: state.predator + dt * k3.predator
    }
    let k4 = lotka_volterra(s4, params)

    // Combine
    PopState {
        prey:     state.prey     + dt / 6.0 * (k1.prey     + 2.0 * k2.prey     + 2.0 * k3.prey     + k4.prey),
        predator: state.predator + dt / 6.0 * (k1.predator + 2.0 * k2.predator + 2.0 * k3.predator + k4.predator)
    }
}

// ============================================================================
// SIMULATION WITH UNCERTAINTY BANDS
// ============================================================================

struct TrajectoryPoint {
    t: f64,
    prey_nom: f64,
    pred_nom: f64,
    prey_lo: f64,
    pred_lo: f64,
    prey_hi: f64,
    pred_hi: f64
}

fn simulate(
    initial: PopState,
    params: UncertainParams,
    t_end: f64,
    dt: f64,
    report_interval: f64
) with IO, Mut, Div, Panic {
    let nom = nominal_params(params)
    let lo = perturbed_params(params, -1.0)
    let hi = perturbed_params(params, 1.0)

    var state_nom = initial
    var state_lo = initial
    var state_hi = initial

    var t = 0.0
    var next_report = 0.0
    var step = 0
    let max_steps = ((t_end / dt) as i32) + 1

    println("  t     | prey_nom  pred_nom | prey_lo   pred_lo  | prey_hi   pred_hi")
    println("  ------+--------------------+--------------------+-------------------")

    while step < max_steps && t <= t_end {
        if t >= next_report - dt * 0.5 {
            println(t)
            println(state_nom.prey)
            println(state_nom.predator)
            println(state_lo.prey)
            println(state_lo.predator)
            println(state_hi.prey)
            println(state_hi.predator)
            println("---")
            next_report = next_report + report_interval
        }

        state_nom = rk4_step(state_nom, nom, dt)
        state_lo = rk4_step(state_lo, lo, dt)
        state_hi = rk4_step(state_hi, hi, dt)

        // Clamp populations to non-negative
        if state_nom.prey < 0.0 { state_nom = PopState { prey: 0.0, predator: state_nom.predator } }
        if state_nom.predator < 0.0 { state_nom = PopState { prey: state_nom.prey, predator: 0.0 } }
        if state_lo.prey < 0.0 { state_lo = PopState { prey: 0.0, predator: state_lo.predator } }
        if state_lo.predator < 0.0 { state_lo = PopState { prey: state_lo.prey, predator: 0.0 } }
        if state_hi.prey < 0.0 { state_hi = PopState { prey: 0.0, predator: state_hi.predator } }
        if state_hi.predator < 0.0 { state_hi = PopState { prey: state_hi.prey, predator: 0.0 } }

        t = t + dt
        step = step + 1
    }
}

// ============================================================================
// CONSERVATION LAW CHECK — Volterra integral invariant
// ============================================================================

fn check_conservation(initial: PopState, final_state: PopState, params: LotkaParams) -> f64 with Mut, Div, Panic {
    // The Lotka-Volterra system conserves:
    //   H(x,y) = delta*x - gamma*ln(x) + beta*y - alpha*ln(y)
    // We check ln via series approximation

    let ln_xi = ln_approx(initial.prey)
    let ln_yi = ln_approx(initial.predator)
    let ln_xf = ln_approx(final_state.prey)
    let ln_yf = ln_approx(final_state.predator)

    let h_initial = params.delta * initial.prey - params.gamma * ln_xi
                  + params.beta * initial.predator - params.alpha * ln_yi
    let h_final = params.delta * final_state.prey - params.gamma * ln_xf
                + params.beta * final_state.predator - params.alpha * ln_yf

    abs_f64(h_final - h_initial)
}

fn ln_approx(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    // ln(x) via Newton iteration on e^y = x
    var y = 0.0
    if x > 1.0 { y = x - 1.0 }
    if y > 5.0 { y = 5.0 }

    var iter = 0
    while iter < 40 {
        let ey = exp_approx(y)
        y = y - (ey - x) / ey
        iter = iter + 1
    }
    y
}

fn exp_approx(x: f64) -> f64 with Mut, Div, Panic {
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n <= 30 {
        term = term * x / (n as f64)
        sum = sum + term
        n = n + 1
    }
    sum
}

// ============================================================================
// MAIN
// ============================================================================

fn main() with IO, Mut, Div, Panic {
    println("==============================================")
    println("  Lotka-Volterra Predator-Prey Dynamics")
    println("  with Epistemic Uncertainty Bands")
    println("==============================================")
    println("")

    // Model parameters with uncertainty estimates
    let params = UncertainParams {
        alpha: UncertainParam { value: 1.1, uncertainty: 0.05 },   // prey birth rate
        beta:  UncertainParam { value: 0.4, uncertainty: 0.02 },   // predation rate
        delta: UncertainParam { value: 0.1, uncertainty: 0.005 },  // predator growth
        gamma: UncertainParam { value: 0.4, uncertainty: 0.02 }    // predator death
    }

    let initial = PopState { prey: 10.0, predator: 5.0 }

    println("Parameters:")
    println("  alpha (prey birth):      1.1 +/- 0.05")
    println("  beta  (predation):       0.4 +/- 0.02")
    println("  delta (pred. growth):    0.1 +/- 0.005")
    println("  gamma (pred. death):     0.4 +/- 0.02")
    println("")
    println("Initial: prey=10, predator=5")
    println("")

    // Simulate 20 time units with dt=0.005, report every 2.0
    simulate(initial, params, 20.0, 0.005, 2.0)

    // Check conservation invariant with nominal parameters
    let nom = nominal_params(params)
    var state = initial
    var i = 0
    let steps = 4000  // 20.0 / 0.005
    while i < steps {
        state = rk4_step(state, nom, 0.005)
        if state.prey < 0.0 { state = PopState { prey: 0.0, predator: state.predator } }
        if state.predator < 0.0 { state = PopState { prey: state.prey, predator: 0.0 } }
        i = i + 1
    }

    let drift = check_conservation(initial, state, nom)
    println("")
    println("Conservation invariant drift:")
    println(drift)
    println("(should be near zero for correct integration)")
    println("")
    println("==============================================")
    println("Uncertainty bands show how parameter uncertainty")
    println("propagates through the dynamical system.")
    println("==============================================")
}
