struct PrimeStats {
    count: i64,
    sum: i64,
    last: i64,
    previous: i64,
    twin_count: i64,
    gap_sum: i64,
    max_gap: i64,
}

fn stats_score(stats: PrimeStats) -> i64 {
    stats.count + stats.last + stats.twin_count
}

fn new_stats() -> PrimeStats {
    PrimeStats {
        count: 0,
        sum: 0,
        last: 0,
        previous: 0,
        twin_count: 0,
        gap_sum: 0,
        max_gap: 0,
    }
}

fn observe_prime(stats: PrimeStats, n: i64) -> PrimeStats with Mut {
    var next = stats
    if next.count > 0 {
        let gap = n - next.last
        next.gap_sum = next.gap_sum + gap
        if gap > next.max_gap {
            next.max_gap = gap
        }
        if gap == 2 {
            next.twin_count = next.twin_count + 1
        }
        next.previous = next.last
    }
    next.count = next.count + 1
    next.sum = next.sum + n
    next.last = n
    next
}

fn validate_stats(stats: PrimeStats) -> i64 {
    if stats.count != 25 { return 201 }
    if stats.sum != 1060 { return 202 }
    if stats.last != 97 { return 203 }
    if stats.previous != 89 { return 204 }
    if stats.twin_count != 8 { return 205 }
    if stats.gap_sum != 95 { return 206 }
    if stats.max_gap != 8 { return 207 }
    if stats_score(stats) != 130 { return 208 }
    return 0
}

fn validate_sieve_cells(composite: [i64; 101]) -> i64 {
    if composite[4] != 1 { return 211 }
    if composite[49] != 1 { return 212 }
    if composite[91] != 1 { return 213 }
    if composite[2] != 0 { return 214 }
    if composite[97] != 0 { return 215 }
    return 0
}

fn main() -> i64 with Mut, Panic, Div {
    var composite: [i64; 101] = [0; 101]

    composite[0] = 1
    composite[1] = 1

    var p: i64 = 2
    while p * p <= 100 {
        if composite[p as usize] == 0 {
            var multiple: i64 = p * p
            while multiple <= 100 {
                composite[multiple as usize] = 1
                multiple = multiple + p
            }
        }
        p = p + 1
    }

    let cell_status = validate_sieve_cells(composite)
    if cell_status != 0 { return cell_status }

    var n: i64 = 2
    var stats = new_stats()
    while n <= 100 {
        if composite[n as usize] == 0 {
            stats = observe_prime(stats, n)
        }
        n = n + 1
    }

    let stats_status = validate_stats(stats)
    if stats_status != 0 { return stats_status }

    stats.count
}
