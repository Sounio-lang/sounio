enum Op {
    Load,
    Add,
    Mul,
    Store,
    Halt,
}

struct Instr {
    op: Op,
    arg: i64,
}

struct Machine {
    acc: i64,
    ip: i64,
    halted: i64,
    checksum: i64,
    mem: [i64; 4],
}

fn instr(op: Op, arg: i64) -> Instr {
    Instr { op: op, arg: arg }
}

fn empty_machine() -> Machine {
    Machine {
        acc: 0,
        ip: 0,
        halted: 0,
        checksum: 0,
        mem: [0; 4],
    }
}

fn step(m: Machine, ins: Instr) -> Machine with Mut {
    var next = m
    match ins.op {
        Op::Load => {
            next.acc = ins.arg
            next.checksum = next.checksum + 11
            next.ip = next.ip + 1
            next
        },
        Op::Add => {
            next.acc = next.acc + ins.arg
            next.checksum = next.checksum + 13
            next.ip = next.ip + 1
            next
        },
        Op::Mul => {
            next.acc = next.acc * ins.arg
            next.checksum = next.checksum + 17
            next.ip = next.ip + 1
            next
        },
        Op::Store => {
            next.mem[ins.arg as usize] = next.acc
            next.checksum = next.checksum + 19 + ins.arg
            next.ip = next.ip + 1
            next
        },
        Op::Halt => {
            next.halted = 1
            next.checksum = next.checksum + 23
            next
        },
    }
}

fn main() -> i64 with Mut, Panic, Div {
    var program: [Instr; 8] = [instr(Op::Halt, 0); 8]
    program[0] = instr(Op::Load, 6)
    program[1] = instr(Op::Mul, 7)
    program[2] = instr(Op::Store, 0)
    program[3] = instr(Op::Load, 20)
    program[4] = instr(Op::Add, 22)
    program[5] = instr(Op::Store, 1)
    program[6] = instr(Op::Halt, 0)

    var machine = empty_machine()
    var fuel: i64 = 0
    while machine.halted == 0 && fuel < 8 {
        machine = step(machine, program[machine.ip as usize])
        fuel = fuel + 1
    }

    if machine.halted != 1 { return 211 }
    if machine.acc != 42 { return 212 }
    if machine.mem[0] != 42 { return 213 }
    if machine.mem[1] != 42 { return 214 }
    if machine.ip != 6 { return 215 }
    if fuel != 7 { return 216 }
    if machine.checksum != 114 { return 217 }

    machine.acc
}
