//@ run-pass
// concurrent_pipeline.sio — Data processing pipeline
//
// Demonstrates a multi-stage data processing pipeline where each stage
// transforms data and tracks processing metrics. Simulates concurrent
// pipeline stages with bounded buffers and backpressure.
//
// Features: structs, arrays, pipeline pattern, effects, metrics tracking
//
// In a full Sounio async program, each stage would run as a separate
// task with channel-based communication. This example simulates the
// pattern synchronously.

// ============================================================================
// HELPERS
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn sqrt_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var g = x / 2.0
    if g < 1.0 { g = 1.0 }
    var i = 0
    while i < 60 { g = (g + x / g) / 2.0; i = i + 1 }
    g
}

// ============================================================================
// DATA TYPES
// ============================================================================

struct DataItem {
    id: i32,
    value: f64,
    processed: bool,
    quality: f64  // 0.0 to 1.0
}

struct StageMetrics {
    items_processed: i32,
    items_filtered: i32,
    total_time_ms: f64,
    avg_quality: f64
}

fn empty_metrics() -> StageMetrics {
    StageMetrics {
        items_processed: 0,
        items_filtered: 0,
        total_time_ms: 0.0,
        avg_quality: 0.0
    }
}

// ============================================================================
// PIPELINE STAGES
// ============================================================================

// Stage 1: Validate — filter out invalid data
fn stage_validate(items: [DataItem], count: i32) -> [DataItem] with Mut, Panic, Div {
    var out = items  // copy
    var i = 0
    while i < count {
        let item = items[i]
        // Validate: value must be in reasonable range
        if item.value < -1000.0 || item.value > 1000.0 {
            out[i] = DataItem {
                id: item.id,
                value: item.value,
                processed: false,
                quality: 0.0
            }
        } else {
            out[i] = DataItem {
                id: item.id,
                value: item.value,
                processed: true,
                quality: 0.5  // base quality after validation
            }
        }
        i = i + 1
    }
    out
}

// Stage 2: Normalize — scale values to [0, 1]
fn stage_normalize(items: [DataItem], count: i32) -> [DataItem] with Mut, Panic, Div {
    // Find min/max of valid items
    var min_val = 1e10
    var max_val = -1e10
    var i = 0
    while i < count {
        if items[i].processed {
            if items[i].value < min_val { min_val = items[i].value }
            if items[i].value > max_val { max_val = items[i].value }
        }
        i = i + 1
    }

    let range = max_val - min_val
    var out = items
    i = 0
    while i < count {
        if items[i].processed && range > 0.001 {
            let normalized = (items[i].value - min_val) / range
            out[i] = DataItem {
                id: items[i].id,
                value: normalized,
                processed: true,
                quality: 0.7  // higher quality after normalization
            }
        }
        i = i + 1
    }
    out
}

// Stage 3: Enrich — add derived features
fn stage_enrich(items: [DataItem], count: i32) -> [DataItem] with Mut, Panic, Div {
    var out = items
    var i = 0
    while i < count {
        if items[i].processed {
            // Squared transform (feature engineering)
            let enriched_val = items[i].value * items[i].value
            out[i] = DataItem {
                id: items[i].id,
                value: enriched_val,
                processed: true,
                quality: 0.85
            }
        }
        i = i + 1
    }
    out
}

// Stage 4: Score — compute final quality score
fn stage_score(items: [DataItem], count: i32) -> [DataItem] with Mut, Panic, Div {
    // Compute mean and stddev of processed values
    var sum = 0.0
    var sum_sq = 0.0
    var n = 0
    var i = 0
    while i < count {
        if items[i].processed {
            sum = sum + items[i].value
            sum_sq = sum_sq + items[i].value * items[i].value
            n = n + 1
        }
        i = i + 1
    }

    let mean = if n > 0 { sum / (n as f64) } else { 0.0 }
    let variance = if n > 1 { (sum_sq - sum * sum / (n as f64)) / ((n - 1) as f64) } else { 0.0 }
    let stddev = sqrt_f64(abs_f64(variance))

    var out = items
    i = 0
    while i < count {
        if items[i].processed {
            // Quality based on distance from mean (z-score)
            let z = if stddev > 0.001 { abs_f64(items[i].value - mean) / stddev } else { 0.0 }
            let quality = if z < 1.0 { 0.95 }
                         else if z < 2.0 { 0.80 }
                         else if z < 3.0 { 0.60 }
                         else { 0.30 }
            out[i] = DataItem {
                id: items[i].id,
                value: items[i].value,
                processed: true,
                quality: quality
            }
        }
        i = i + 1
    }
    out
}

// ============================================================================
// PIPELINE RUNNER
// ============================================================================

fn compute_metrics(items: [DataItem], count: i32) -> StageMetrics with Mut, Panic, Div {
    var processed = 0
    var filtered = 0
    var quality_sum = 0.0
    var i = 0
    while i < count {
        if items[i].processed {
            processed = processed + 1
            quality_sum = quality_sum + items[i].quality
        } else {
            filtered = filtered + 1
        }
        i = i + 1
    }
    let avg_q = if processed > 0 { quality_sum / (processed as f64) } else { 0.0 }
    StageMetrics {
        items_processed: processed,
        items_filtered: filtered,
        total_time_ms: 0.0,
        avg_quality: avg_q
    }
}

fn print_metrics(name: i32, m: StageMetrics) with IO, Panic {
    println("  Stage:")
    println(name)
    println("    Processed:")
    println(m.items_processed)
    println("    Filtered:")
    println(m.items_filtered)
    println("    Avg quality:")
    println(m.avg_quality)
    println("")
}

// ============================================================================
// MAIN
// ============================================================================

fn main() with IO, Mut, Panic, Div {
    println("==============================================")
    println("  Sounio Concurrent Pipeline")
    println("  Multi-Stage Data Processing")
    println("==============================================")
    println("")

    // Generate input data
    let raw_data = [
        DataItem { id: 0,  value: 42.5,    processed: false, quality: 0.0 },
        DataItem { id: 1,  value: -17.3,   processed: false, quality: 0.0 },
        DataItem { id: 2,  value: 99.9,    processed: false, quality: 0.0 },
        DataItem { id: 3,  value: 0.5,     processed: false, quality: 0.0 },
        DataItem { id: 4,  value: -5000.0, processed: false, quality: 0.0 },  // invalid
        DataItem { id: 5,  value: 73.2,    processed: false, quality: 0.0 },
        DataItem { id: 6,  value: 15.8,    processed: false, quality: 0.0 },
        DataItem { id: 7,  value: 88.1,    processed: false, quality: 0.0 }
    ]
    let count = 8

    println("Input: 8 data items (1 invalid)")
    println("")

    // Stage 1: Validate
    println("Stage 1: Validate")
    let validated = stage_validate(raw_data, count)
    let m1 = compute_metrics(validated, count)
    print_metrics(1, m1)

    // Stage 2: Normalize
    println("Stage 2: Normalize")
    let normalized = stage_normalize(validated, count)
    let m2 = compute_metrics(normalized, count)
    print_metrics(2, m2)

    // Stage 3: Enrich
    println("Stage 3: Enrich")
    let enriched = stage_enrich(normalized, count)
    let m3 = compute_metrics(enriched, count)
    print_metrics(3, m3)

    // Stage 4: Score
    println("Stage 4: Score")
    let scored = stage_score(enriched, count)
    let m4 = compute_metrics(scored, count)
    print_metrics(4, m4)

    // Final output
    println("=== Final Results ===")
    println("")
    var i = 0
    while i < count {
        if scored[i].processed {
            println("Item")
            println(scored[i].id)
            println("  Value:")
            println(scored[i].value)
            println("  Quality:")
            println(scored[i].quality)
        }
        i = i + 1
    }

    println("")
    println("==============================================")
    println("Pipeline processed data through 4 stages with")
    println("quality tracking at each step.")
    println("==============================================")
}
