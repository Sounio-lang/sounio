//@ run-pass
//!
//! First Sounio authority stream for target-local material receipt admission.

use hardware::pireus::xor_selector_material_admission::{
    PIREUS_XOR_ADMISSION_OK,
    PireusXorAdmissionDigest,
    PireusXorMaterialFilePaths,
    PireusXorMaterialAdmissionRecord,
    pireus_xor_material_file_matches,
    pireus_xor_material_admission_record_digest,
    pireus_xor_selector_material_admission_evaluate,
    pireus_xor_selector_material_admission_matches_frozen_semantics,
}

fn bool_as_i64(value: bool) -> i64 { if value { 1 } else { 0 } }

fn print_digest(digest: &PireusXorAdmissionDigest) with IO, Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if i > 0 { print(":") }
        print_int(digest.words[i])
        i = i + 1
    }
}

fn print_record(record: &PireusXorMaterialAdmissionRecord)
with IO, Mut, Panic, Div {
    print("PIREUS_XOR_ADMISSION_TARGET id="); print_int(record.target_id)
    print(" binding_error="); print_int(record.binding_error)
    print(" receipt_admitted=")
    print_int(bool_as_i64(record.receipt_admitted))
    print(" coordinate_exact=")
    print_int(bool_as_i64(record.coordinate_exact))
    print(" payload_exact=")
    print_int(bool_as_i64(record.payload_exact))
    print(" output_exact=")
    print_int(bool_as_i64(record.output_exact))
    print(" admitted_nodes="); print_int(record.admitted_node_count)
    print(" unresolved_nodes="); print_int(record.unresolved_node_count)
    print(" refused_nodes="); print_int(record.refused_node_count)
    print(" unnamed_resolved_nodes=")
    print_int(record.unnamed_resolved_node_count)
    print(" whole_operation=")
    print_int(bool_as_i64(record.whole_operation_covered))
    print(" encoding_status="); print_int(record.operand_encoding_status)
    print(" static_selector_sites="); print_int(record.static_selector_sites)
    print(" secondary_selector_sites=")
    print_int(record.secondary_selector_sites)
    print(" result_reproducible=")
    print_int(bool_as_i64(record.result_reproducible))
    print(" binary_reproducible=")
    print_int(bool_as_i64(record.binary_reproducible))
    print("\n")
    var node: i64 = 0
    while node < 5 {
        print("PIREUS_XOR_ADMISSION_NODE target="); print_int(record.target_id)
        print(" index="); print_int(node)
        print(" status="); print_int(record.node_status[node])
        print("\n")
        node = node + 1
    }
    print("PIREUS_XOR_ADMISSION_TARGET_DIGEST id=")
    print_int(record.target_id); print(" words=")
    let digest = pireus_xor_material_admission_record_digest(record)
    print_digest(&digest); print("\n")
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 8 {
        print("usage: pireus_xor_selector_material_admission <intel-sdm-vol-2c.pdf> <avx512-foundation-isa.xed.txt> <darwin-receipt> <darwin-evidence> <apple-receipt> <apple-evidence> <dgx-receipt> <dgx-evidence>\n")
        return 2
    }
    let material_paths = PireusXorMaterialFilePaths {
        darwin_receipt: get_arg(2),
        darwin_evidence: get_arg(3),
        apple_receipt: get_arg(4),
        apple_evidence: get_arg(5),
        dgx_receipt: get_arg(6),
        dgx_evidence: get_arg(7),
    }
    let result = pireus_xor_selector_material_admission_evaluate(
        get_arg(0), get_arg(1), &material_paths)
    var failures = result.failures
    if !result.valid || result.error != PIREUS_XOR_ADMISSION_OK {
        failures = failures + 1
    }
    if !pireus_xor_selector_material_admission_matches_frozen_semantics(
        &result) {
        failures = failures + 1
    }

    print("SOUNIO_AUTHORITY schema=pireus-xor-selector-material-admission.v1 role=SEMANTIC_AUTHORITY\n")
    print("PIREUS_XOR_ADMISSION_PARENTS garden_commit=b5311535:8687f2d6:60d3bc55:96f07a37:aa4929fb lowering_live=")
    print_int(bool_as_i64(result.parents.lowering_live_match))
    print(" valid="); print_int(bool_as_i64(result.parents.valid)); print("\n")
    print("PIREUS_XOR_ADMISSION_FILES count=6 matched=")
    print_int(result.material_file_match_count)
    print(" valid="); print_int(bool_as_i64(result.material_files_valid))
    print("\n")
    var file: i64 = 0
    while file < 6 {
        print("PIREUS_XOR_ADMISSION_FILE index="); print_int(file)
        print(" match=")
        print_int(bool_as_i64(pireus_xor_material_file_matches(
            result.material_file_match_mask, file)))
        print("\n")
        file = file + 1
    }

    print_record(&result.darwin)
    print_record(&result.apple)
    print_record(&result.dgx)

    print("PIREUS_XOR_ADMISSION_COUNTS receipts=")
    print_int(result.receipt_count)
    print(" admitted_receipts="); print_int(result.admitted_receipt_count)
    print(" admitted_nodes="); print_int(result.admitted_node_count)
    print(" unresolved_nodes="); print_int(result.unresolved_node_count)
    print(" refused_nodes="); print_int(result.refused_node_count)
    print(" selector_targets="); print_int(result.selector_target_count)
    print(" whole_operation_targets=")
    print_int(result.whole_operation_target_count)
    print(" incomplete_targets="); print_int(result.incomplete_target_count)
    print(" unnamed_node_claims="); print_int(result.unnamed_node_claim_count)
    print(" encoding_differences="); print_int(result.encoding_difference_count)
    print("\n")

    print("PIREUS_XOR_ADMISSION_DIGEST words=")
    print_digest(&result.admission_digest); print("\n")
    print("PIREUS_XOR_ADMISSION_NEGATIVES passed=")
    print_int(result.negatives.passed)
    print(" total="); print_int(result.negatives.total); print("\n")
    print("PIREUS_XOR_ADMISSION_BOUNDARY material_observations=")
    print_int(result.material_observation_count)
    print(" compiler_emission_observations=")
    print_int(result.compiler_emission_observation_count)
    print(" cost_records="); print_int(result.cost_record_count)
    print(" generic_instruction_cost=")
    print_int(bool_as_i64(result.generic_instruction_cost))
    print(" cross_isa_equivalence=")
    print_int(bool_as_i64(result.cross_isa_equivalence))
    print(" transform_authorized=")
    print_int(bool_as_i64(result.transform_authorized))
    print(" parity_open="); print_int(bool_as_i64(result.parity_open))
    print(" claim_ready="); print_int(bool_as_i64(result.claim_ready))
    print("\n")
    print("PIREUS_XOR_ADMISSION_SUMMARY error="); print_int(result.error)
    print(" failures="); print_int(failures); print("\n")

    if failures == 0 { 0 } else { 1 }
}
