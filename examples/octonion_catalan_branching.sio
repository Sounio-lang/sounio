//@ run-pass
//@ expect-stdout: ALL PASS

// ═══════════════════════════════════════════════════════════════════════════
// Catalan Parenthesization Branching in Non-Associative Products
// ═══════════════════════════════════════════════════════════════════════════
//
// For n factors, the number of distinct parenthesizations is the Catalan
// number C(n-1). For associative algebras, all give the same result.
// For octonions, different parenthesizations give DIFFERENT results
// (in general).
//
// C(1)=1, C(2)=2, C(3)=5, C(4)=14, C(5)=42, C(6)=132, C(7)=429
//
// We compute: for n basis octonions, how many DISTINCT products arise
// from different parenthesizations? This measures the "branching factor"
// of non-associativity.
//
// For O-SSM: a sequence of n inputs gives C(n-1) possible state
// evolution histories. The trained model picks ONE (left-to-right),
// but the others exist as "phantom trajectories."
// ═══════════════════════════════════════════════════════════════════════════

var MULT: [i64; 64] = [0; 64]
var SIGN: [i64; 64] = [0; 64]

fn init_table() with Mut {
    var i = 0
    while i < 8 {
        MULT[0*8+i] = i; SIGN[0*8+i] = 1
        MULT[i*8+0] = i; SIGN[i*8+0] = 1
        i = i + 1
    }
    i = 1
    while i < 8 { MULT[i*8+i] = 0; SIGN[i*8+i] = 0-1; i = i + 1 }
    var FA: [i64; 7] = [1,2,3,4,5,6,7]
    var FB: [i64; 7] = [2,3,4,5,6,7,1]
    var FC: [i64; 7] = [4,5,6,7,1,2,3]
    var t = 0
    while t < 7 {
        let a = FA[t]; let b = FB[t]; let c = FC[t]
        MULT[a*8+b]=c; SIGN[a*8+b]=1; MULT[b*8+a]=c; SIGN[b*8+a]=0-1
        MULT[b*8+c]=a; SIGN[b*8+c]=1; MULT[c*8+b]=a; SIGN[c*8+b]=0-1
        MULT[c*8+a]=b; SIGN[c*8+a]=1; MULT[a*8+c]=b; SIGN[a*8+c]=0-1
        t = t + 1
    }
}

var RES_IDX: i64 = 0
var RES_SGN: i64 = 0
fn basis_mul(i_idx: i64, i_sgn: i64, j_idx: i64, j_sgn: i64) with Mut {
    RES_IDX = MULT[i_idx*8+j_idx]
    RES_SGN = i_sgn * j_sgn * SIGN[i_idx*8+j_idx]
}

// ─── n=3: Two parenthesizations (a·b)·c vs a·(b·c) ───
// Results stored as idx*2+sign_bit
var RESULTS_3: [i64; 16] = [0; 16]

fn encode(idx: i64, sgn: i64) -> i64 {
    var s = 0
    if sgn < 0 { s = 1 }
    idx * 2 + s
}

fn count3(a: i64, b: i64, c: i64) -> i64 with Mut {
    // Left: (a·b)·c
    basis_mul(a, 1, b, 1)
    let t1_idx = RES_IDX; let t1_sgn = RES_SGN
    basis_mul(t1_idx, t1_sgn, c, 1)
    let left = encode(RES_IDX, RES_SGN)

    // Right: a·(b·c)
    basis_mul(b, 1, c, 1)
    let t2_idx = RES_IDX; let t2_sgn = RES_SGN
    basis_mul(a, 1, t2_idx, t2_sgn)
    let right = encode(RES_IDX, RES_SGN)

    if left == right { 1 } else { 2 }
}

// ─── n=4: Five parenthesizations ───
// ((ab)c)d, (a(bc))d, (ab)(cd), a((bc)d), a(b(cd))
var R4: [i64; 5] = [0; 5]

fn count4(a: i64, b: i64, c: i64, d: i64) -> i64 with Mut {
    // P1: ((a·b)·c)·d
    basis_mul(a, 1, b, 1)
    let ab_i = RES_IDX; let ab_s = RES_SGN
    basis_mul(ab_i, ab_s, c, 1)
    let abc_i = RES_IDX; let abc_s = RES_SGN
    basis_mul(abc_i, abc_s, d, 1)
    R4[0] = encode(RES_IDX, RES_SGN)

    // P2: (a·(b·c))·d
    basis_mul(b, 1, c, 1)
    let bc_i = RES_IDX; let bc_s = RES_SGN
    basis_mul(a, 1, bc_i, bc_s)
    let abc2_i = RES_IDX; let abc2_s = RES_SGN
    basis_mul(abc2_i, abc2_s, d, 1)
    R4[1] = encode(RES_IDX, RES_SGN)

    // P3: (a·b)·(c·d)
    basis_mul(a, 1, b, 1)
    let ab2_i = RES_IDX; let ab2_s = RES_SGN
    basis_mul(c, 1, d, 1)
    let cd_i = RES_IDX; let cd_s = RES_SGN
    basis_mul(ab2_i, ab2_s, cd_i, cd_s)
    R4[2] = encode(RES_IDX, RES_SGN)

    // P4: a·((b·c)·d)
    basis_mul(b, 1, c, 1)
    let bc2_i = RES_IDX; let bc2_s = RES_SGN
    basis_mul(bc2_i, bc2_s, d, 1)
    let bcd_i = RES_IDX; let bcd_s = RES_SGN
    basis_mul(a, 1, bcd_i, bcd_s)
    R4[3] = encode(RES_IDX, RES_SGN)

    // P5: a·(b·(c·d))
    basis_mul(c, 1, d, 1)
    let cd2_i = RES_IDX; let cd2_s = RES_SGN
    basis_mul(b, 1, cd2_i, cd2_s)
    let bcd2_i = RES_IDX; let bcd2_s = RES_SGN
    basis_mul(a, 1, bcd2_i, bcd2_s)
    R4[4] = encode(RES_IDX, RES_SGN)

    // Count distinct
    var distinct = 0
    var i = 0
    while i < 5 {
        var is_dup = 0
        var j = 0
        while j < i {
            if R4[i] == R4[j] { is_dup = 1 }
            j = j + 1
        }
        if is_dup == 0 { distinct = distinct + 1 }
        i = i + 1
    }
    distinct
}

// ─── Statistics over all triples / quadruples ───
fn survey_n3() with Mut, IO {
    var total_distinct1 = 0  // associative (1 result)
    var total_distinct2 = 0  // non-associative (2 results)

    var a = 1
    while a < 8 {
        var b = 1
        while b < 8 {
            if b != a {
                var c = 1
                while c < 8 {
                    if c != a { if c != b {
                        let d = count3(a, b, c)
                        if d == 1 { total_distinct1 = total_distinct1 + 1 }
                        else { total_distinct2 = total_distinct2 + 1 }
                    }}
                    c = c + 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }

    print("  n=3: C(2)=2 parenthesizations\n")
    print("  Triples giving 1 result (associative): "); print_int(total_distinct1); print("\n")
    print("  Triples giving 2 results (non-associative): "); print_int(total_distinct2); print("\n")
    print("  Total ordered triples: "); print_int(total_distinct1 + total_distinct2); print("\n")
    print("  Branching fraction: "); print_int((total_distinct2 * 100) / (total_distinct1 + total_distinct2)); print("%\n")
}

fn survey_n4() with Mut, IO {
    // Sample: all quadruples with distinct elements from {1..7}
    // 7×6×5×4 = 840 quadruples
    var hist: [i64; 6] = [0; 6]  // hist[d] = count of quadruples with d distinct results

    var a = 1
    while a < 8 {
        var b = 1
        while b < 8 {
            if b != a {
                var c = 1
                while c < 8 {
                    if c != a { if c != b {
                        var d = 1
                        while d < 8 {
                            if d != a { if d != b { if d != c {
                                let nd = count4(a, b, c, d)
                                if nd >= 1 {
                                    if nd <= 5 { hist[nd] = hist[nd] + 1 }
                                }
                            }}}
                            d = d + 1
                        }
                    }}
                    c = c + 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }

    print("  n=4: C(3)=5 parenthesizations\n")
    print("  Distribution of distinct results:\n")
    var total = 0
    var i = 1
    while i <= 5 {
        print("    "); print_int(i); print(" distinct: "); print_int(hist[i]); print("\n")
        total = total + hist[i]
        i = i + 1
    }
    print("  Total quadruples: "); print_int(total); print("\n")

    // Average branching
    var weighted = 0
    i = 1
    while i <= 5 { weighted = weighted + i * hist[i]; i = i + 1 }
    print("  Mean distinct results: "); print_int(weighted / total); print(".")
    print_int(((weighted * 10) / total) % 10); print("\n")
}

// ─── Catalan numbers ───
fn catalan(n: i64) -> i64 with Mut {
    // C(0)=1, C(n) = sum C(i)*C(n-1-i) for i=0..n-1
    if n <= 1 { return 1 }
    var sum = 0
    var i = 0
    while i < n {
        sum = sum + catalan(i) * catalan(n - 1 - i)
        i = i + 1
    }
    sum
}

fn main() -> i32 with IO, Mut {
    print("═══════════════════════════════════════════════════════════════\n")
    print("  Catalan Parenthesization Branching\n")
    print("═══════════════════════════════════════════════════════════════\n\n")

    init_table()

    print("--- Catalan Numbers ---\n")
    var n = 1
    while n <= 8 {
        print("  C("); print_int(n); print(") = "); print_int(catalan(n)); print("\n")
        n = n + 1
    }

    print("\n--- n=3 Survey (all distinct ordered triples from {e1..e7}) ---\n")
    survey_n3()

    print("\n--- n=4 Survey (all distinct ordered quadruples) ---\n")
    survey_n4()

    print("\n═══════════════════════════════════════════════════════════════\n")
    print("  SIGNIFICANCE FOR O-SSM:\n")
    print("  A sequence of n tokens creates C(n-1) phantom trajectories.\n")
    print("  For n=10: C(9) = 4862 phantom states\n")
    print("  For n=20: C(19) = 1767263190 phantom states\n")
    print("  The trained O-SSM selects ONE (left-to-right scan),\n")
    print("  but the phantom space encodes the full non-associative\n")
    print("  structure — potentially exploitable via attention.\n")
    print("═══════════════════════════════════════════════════════════════\n\n")

    // Check Catalan numbers are correct
    var pass = 0
    if catalan(1) == 1 { pass = pass + 1 }
    if catalan(2) == 2 { pass = pass + 1 }
    if catalan(3) == 5 { pass = pass + 1 }
    if catalan(4) == 14 { pass = pass + 1 }
    if catalan(5) == 42 { pass = pass + 1 }

    print("Passed: "); print_int(pass); print("\nFailed: "); print_int(5 - pass); print("\n")
    if pass == 5 { println("ALL PASS") }
    else { println("SOME FAILED") }
    0
}
