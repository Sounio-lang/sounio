// examples/kmc/kmc_c2x2_order.sio
//
// M5b: DOES THE Q INVARIANT BLOCK c(2x2) ORDER, AND WHERE DOES MEAN FIELD
//      PREDICT A PHASE THAT IS NOT THERE?
//
// Along the symmetric line K = q^4, w = 1/q, this model is exactly the
// zero-field Ising antiferromagnet at beta*J = ln(q)/4 (c2x2_exact_anchors.sio
// derives and checks the mapping). Two questions:
//
//   1. MEAN FIELD, QUALITATIVELY. Two-sublattice mean field orders for
//      q > e = 2.72; Onsager says q > 5.83. At q = 3, 4, 5 mean field
//      predicts a checkerboard with |m| = 0.50, 0.81, 0.89 that does not
//      exist. The ergodic simulation should show |M| falling with lattice
//      size there, and the pair density sitting on Onsager, not on mean field.
//
//   2. THE INVARIANT, PHYSICALLY. Dimer moves alone pin Q = occ_black -
//      occ_white at 0. A single c(2x2) domain has |Q| = N/2. So without
//      diffusion the surface cannot form one ordered domain at all -- only
//      antiphase domains whose walls cost bonds. In EQUILIBRIUM within the
//      Q=0 class that costs only two straight walls, an O(1/L) excess, so
//      the thermodynamic limit could be untouched, as it was in 1D. The
//      question is whether the DYNAMICS reaches that, or stays in a mosaic
//      of small domains. The control is the same run with Metropolis hops
//      switched on, which breaks the invariant: if the difference is a model
//      artefact of forbidding diffusion, the control shows it.
//
// OBSERVABLES, all time-averaged by expected residence time 1/R:
//   theta         coverage; exactly 1/2 on the symmetric line
//   pair density  pairs/(2N); exact infinite-lattice value (1 - c_Onsager)/4
//   |M|           2|Q|/N, the global staggered order; Yang's M in the limit.
//                 Identically 0 without diffusion, so it cannot see domains.
//   block |M|     the same quantity inside each 4x4 block, averaged over
//                 blocks. Sees local order whatever the global Q is -- this
//                 is what distinguishes "disordered" from "ordered in
//                 antiphase domains" when Q is pinned.
//
// THE ENGINE IS NEW, SO IT IS VALIDATED BEFORE IT IS BELIEVED.
//
//   - Incremental rates. A move at sites a,c changes the rate only of bonds
//     with an endpoint within one step of a or c -- at most 40 of 2N -- and
//     a Fenwick tree selects in O(log N). Both are speed optimisations and
//     neither is trusted: every 50,000 steps every rate is recomputed from
//     scratch and compared to the incremental one for EXACT equality (same
//     function, same inputs, so any difference is a missed update, not
//     rounding), and occupancy, bond count and Q are recounted from the
//     lattice. The Fenwick tree is then rebuilt, which also removes
//     floating-point drift in its partial sums.
//   - The Fenwick tree has its own self-test before anything runs: prefix
//     sums and index searches against a linear scan on 5000 random queries.
//   - The whole engine, both dynamics, is then run on 4x4 at q = 3
//     (disordered) and q = 8 (deep in the ordered phase) and compared to
//     EXACT enumeration of the same lattice, computed in this file from the
//     weights rather than copied, with the class of each dynamics taken
//     from the search in c2x2_exact_anchors.sio. Nothing past PART B runs
//     if that fails.
//
// RUNTIME: about 10.5 minutes on one core (measured, Madaros v0.80.0). That
// is over the 5-minute line in /workspace/SOUNIO_HEAVY_CPU_POLICY.md, so
// this file belongs on Slurm cpu-ops, not in the interactive workspace. Its
// first run was done in the workspace anyway, before the policy was read;
// that is recorded here so it is not repeated.

fn abs_f(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn abs_i(x: i64) -> i64 { if x < 0 { 0 - x } else { x } }

fn sqrt_newton(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var g = x
    if g < 1.0 { g = 1.0 }
    var i: i64 = 0
    while i < 200 { g = 0.5 * (g + x / g)  i = i + 1 }
    g
}

fn rng_step(s: i64) -> i64 { s * 6364136223846793005 + 1442695040888963407 }
fn rng_unit(s: i64) -> f64 with Div, Panic {
    let u: i64 = s & 4611686018427387903
    let hi: i64 = u / 4294967296
    (hi as f64) / 1073741824.0
}

// --- Onsager / Yang / mean field, in x = sqrt(q) (see c2x2_exact_anchors) --

fn exp_f(x: f64) -> f64 with Mut, Div, Panic {
    var y = x
    var k: i64 = 0
    while abs_f(y) > 0.5 { y = y / 2.0  k = k + 1 }
    var sum: f64 = 1.0
    var term: f64 = 1.0
    var i: i64 = 1
    while i < 30 { term = term * y / (i as f64)  sum = sum + term  i = i + 1 }
    while k > 0 { sum = sum * sum  k = k - 1 }
    sum
}
fn ln_f(a: f64) -> f64 with Mut, Div, Panic {
    var y: f64 = 0.0
    var i: i64 = 0
    while i < 100 { let e = exp_f(y)  y = y + 2.0 * (a - e) / (a + e)  i = i + 1 }
    y
}
fn tanh_f(x: f64) -> f64 with Mut, Div, Panic {
    let e2 = exp_f(2.0 * x)
    (e2 - 1.0) / (e2 + 1.0)
}
fn agm(a0: f64, b0: f64) -> f64 with Mut, Div, Panic {
    var a = a0
    var b = b0
    var i: i64 = 0
    while i < 60 { let an = 0.5 * (a + b)  let bn = sqrt_newton(a * b)  a = an  b = bn  i = i + 1 }
    a
}
fn onsager_nn(x: f64) -> f64 with Mut, Div, Panic {
    let pi = 3.141592653589793
    let sh = (x - 1.0 / x) / 2.0
    let ch = (x + 1.0 / x) / 2.0
    let th = sh / ch
    let kk = 2.0 * sh / (ch * ch)
    let coef = 2.0 * th * th - 1.0
    var brk: f64 = 1.0
    if abs_f(coef) > 0.000000000001 {
        brk = 1.0 + (2.0 / pi) * coef * (pi / (2.0 * agm(1.0, sqrt_newton(1.0 - kk * kk))))
    }
    (ch / sh) * brk / 2.0
}
fn yang_m(x: f64) -> f64 with Mut, Div, Panic {
    let sh = (x - 1.0 / x) / 2.0
    if sh <= 1.0 { return 0.0 }
    sqrt_newton(sqrt_newton(sqrt_newton(1.0 - 1.0 / (sh * sh * sh * sh))))
}
fn mf_m(kj: f64) -> f64 with Mut, Div, Panic {
    if 4.0 * kj <= 1.0 { return 0.0 }
    var lo: f64 = 0.000000001
    var hi: f64 = 1.0
    var i: i64 = 0
    while i < 200 {
        let mid = 0.5 * (lo + hi)
        if tanh_f(4.0 * kj * mid) - mid > 0.0 { lo = mid } else { hi = mid }
        i = i + 1
    }
    0.5 * (lo + hi)
}

// --- lattice tables -----------------------------------------------------------

fn nb_k(i: i64, k: i64, l: i64) -> i64 with Mut, Div, Panic {
    let r = i / l
    let c = i - r * l
    if k == 0 { let c2 = if c + 1 == l { 0 } else { c + 1 }  return r * l + c2 }
    if k == 1 { let r2 = if r + 1 == l { 0 } else { r + 1 }  return r2 * l + c }
    if k == 2 { let c3 = if c == 0 { l - 1 } else { c - 1 }  return r * l + c3 }
    let r3 = if r == 0 { l - 1 } else { r - 1 }
    r3 * l + c
}

fn nocc_except(x: i64, y: i64, occ: &[i64; 1024], nbr: &[i64; 4096]) -> i64 with Mut, Div, Panic {
    var c: i64 = 0
    let x4 = x * 4
    var k: i64 = 0
    while k < 4 {
        let z = nbr[(x4 + k) as usize]
        if z != y { c = c + occ[z as usize] }
        k = k + 1
    }
    c
}

// The rate of the single event a bond supports in the current state:
// 00 adsorption (1), 11 desorption (q^(delta-4)), 10/01 Metropolis hop.
fn rate_of(b: i64, occ: &[i64; 1024], nbr: &[i64; 4096], ba: &[i64; 2048], bb: &[i64; 2048],
           qp: &[f64; 17], hops: bool) -> f64 with Mut, Div, Panic {
    let x: i64 = ba[b as usize]
    let y: i64 = bb[b as usize]
    let sx: i64 = occ[x as usize]
    let sy: i64 = occ[y as usize]
    if sx == 0 && sy == 0 { return 1.0 }
    let nx = nocc_except(x, y, occ, nbr)
    let ny = nocc_except(y, x, occ, nbr)
    if sx == 1 && sy == 1 { return qp[(8 + 1 + nx + ny - 4) as usize] }
    if !hops { return 0.0 }
    var d: i64 = 0
    if sx == 1 { d = ny - nx } else { d = nx - ny }
    if d <= 0 { 1.0 } else { qp[(8 - d) as usize] }
}

// --- Fenwick tree (1-based internally, bond b stored at b+1) -------------

fn fw_add(tree: &![f64; 2049], m: i64, b: i64, delta: f64) with Mut, Div, Panic {
    var i = b + 1
    while i <= m { tree[i as usize] = tree[i as usize] + delta  i = i + (i & (0 - i)) }
}
fn fw_build(tree: &![f64; 2049], m: i64, rate: &[f64; 2048]) with Mut, Div, Panic {
    var i: i64 = 0
    while i <= m { tree[i as usize] = 0.0  i = i + 1 }
    var j: i64 = 1
    while j <= m {
        tree[j as usize] = tree[j as usize] + rate[(j - 1) as usize]
        let p = j + (j & (0 - j))
        if p <= m { tree[p as usize] = tree[p as usize] + tree[j as usize] }
        j = j + 1
    }
}
fn fw_prefix(tree: &[f64; 2049], b: i64) -> f64 with Mut, Div, Panic {
    var s: f64 = 0.0
    var i = b + 1
    while i > 0 { s = s + tree[i as usize]  i = i - (i & (0 - i)) }
    s
}
// smallest bond b with prefix(b) > u
fn fw_find(tree: &[f64; 2049], m: i64, top: i64, u: f64) -> i64 with Mut, Div, Panic {
    var pos: i64 = 0
    var rem = u
    var step = top
    while step > 0 {
        let nx = pos + step
        if nx <= m {
            let t: f64 = tree[nx as usize]
            if t <= rem { pos = nx  rem = rem - t }
        }
        step = step / 2
    }
    pos
}

fn fenwick_selftest() -> bool with Mut, Div, Panic {
    let m: i64 = 1537
    var rate: [f64; 2048] = [0.0; 2048]
    var tree: [f64; 2049] = [0.0; 2049]
    var s: i64 = 987654321
    var i: i64 = 0
    while i < m {
        s = rng_step(s)
        let u = rng_unit(s)
        // a third of entries exactly zero, as forbidden events are in the engine
        if u < 0.33 { rate[i as usize] = 0.0 } else { rate[i as usize] = u * 100.0 }
        i = i + 1
    }
    fw_build(&! tree, m, &rate)
    var top: i64 = 1
    while top * 2 <= m { top = top * 2 }
    var ok = true
    var run: f64 = 0.0
    var j: i64 = 0
    while j < m {
        run = run + rate[j as usize]
        if abs_f(fw_prefix(&tree, j) - run) > 0.000001 { ok = false }
        j = j + 1
    }
    var qn: i64 = 0
    while qn < 5000 {
        s = rng_step(s)
        let u = rng_unit(s) * run
        let got = fw_find(&tree, m, top, u)
        var lin: i64 = 0
        var acc: f64 = 0.0
        var found = false
        while lin < m && !found {
            acc = acc + rate[lin as usize]
            if acc > u { found = true } else { lin = lin + 1 }
        }
        if got != lin { ok = false }
        qn = qn + 1
    }
    // a point update must show up in every later prefix
    fw_add(&! tree, m, 700, 5.0)
    if abs_f(fw_prefix(&tree, 699) - fw_prefix(&tree, 698) - rate[699]) > 0.000001 { ok = false }
    if abs_f(fw_prefix(&tree, 700) - fw_prefix(&tree, 699) - rate[700] - 5.0) > 0.000001 { ok = false }
    ok
}

// --- exact 4x4 reference, from the weights ----------------------------------

// out[0] theta, out[1] pair density, out[2] <|M|>
fn exact4(q: i64, hops: bool, out: &![f64; 4]) with Mut, Div, Panic {
    let l: i64 = 4
    let n: i64 = 16
    let qf = q as f64
    var qp: [f64; 129] = [0.0; 129]
    qp[64] = 1.0
    var e: i64 = 1
    while e <= 64 { qp[(64 + e) as usize] = qp[(63 + e) as usize] * qf  qp[(64 - e) as usize] = qp[(65 - e) as usize] / qf  e = e + 1 }
    var z: f64 = 0.0
    var at: f64 = 0.0
    var ap: f64 = 0.0
    var am: f64 = 0.0
    var occ: [i64; 16] = [0; 16]
    var s: i64 = 0
    while s < 65536 {
        var v = s
        var oc: i64 = 0
        var qq: i64 = 0
        var i: i64 = 0
        while i < n {
            let bit = v - (v / 2) * 2
            occ[i as usize] = bit
            v = v / 2
            if bit == 1 {
                oc = oc + 1
                let r = i / l
                let c = i - r * l
                if (r + c) - ((r + c) / 2) * 2 == 0 { qq = qq + 1 } else { qq = qq - 1 }
            }
            i = i + 1
        }
        var inclass = false
        if hops { inclass = oc - (oc / 2) * 2 == 0 } else { inclass = qq == 0 }
        if inclass {
            var pr: i64 = 0
            var i2: i64 = 0
            while i2 < n {
                if occ[i2 as usize] == 1 {
                    if occ[nb_k(i2, 0, l) as usize] == 1 { pr = pr + 1 }
                    if occ[nb_k(i2, 1, l) as usize] == 1 { pr = pr + 1 }
                }
                i2 = i2 + 1
            }
            let wg = qp[(64 + 2 * oc - pr) as usize]
            z = z + wg
            at = at + wg * (oc as f64) / 16.0
            ap = ap + wg * (pr as f64) / 32.0
            am = am + wg * (abs_i(qq) as f64) / 8.0
        }
        s = s + 1
    }
    out[0] = at / z
    out[1] = ap / z
    out[2] = am / z
}

// --- the engine --------------------------------------------------------------
//
// out[0..7]  theta, SE, pair density, SE, |M|, SE, block |M|, SE
// out[8]     incremental-vs-full rate mismatches (must be 0)
// out[9]     1 if every recount of occupancy, bonds and Q matched
// out[10]    selections that landed on a zero-rate bond (must be 0)
// out[11]    1 if the lattice fit the arrays
// out[12]    max |Q| over the run
fn kmc_run(l: i64, q: i64, hops: bool, seed0: i64, n_burn: i64, n_batch: i64,
           batch_len: i64, out: &![f64; 16]) with Mut, Div, Panic {
    let n = l * l
    let m = 2 * n
    var k0: i64 = 0
    while k0 < 16 { out[k0 as usize] = 0.0  k0 = k0 + 1 }
    if n > 1024 || l - (l / 4) * 4 != 0 { return }
    out[11] = 1.0

    var occ: [i64; 1024] = [0; 1024]
    var sgn: [i64; 1024] = [0; 1024]
    var blk: [i64; 1024] = [0; 1024]
    var nbr: [i64; 4096] = [0; 4096]
    var inc: [i64; 4096] = [0; 4096]
    var ba: [i64; 2048] = [0; 2048]
    var bb: [i64; 2048] = [0; 2048]
    var rate: [f64; 2048] = [0.0; 2048]
    var chk: [f64; 2048] = [0.0; 2048]
    var stamp: [i64; 2048] = [0; 2048]
    var tree: [f64; 2049] = [0.0; 2049]
    var qp: [f64; 17] = [0.0; 17]
    var bq: [i64; 64] = [0; 64]
    var bsum: [f64; 64] = [0.0; 64]
    var bsum2: [f64; 64] = [0.0; 64]
    var bm: [f64; 256] = [0.0; 256]

    let qf = q as f64
    qp[8] = 1.0
    var e: i64 = 1
    while e <= 8 { qp[(8 + e) as usize] = qp[(7 + e) as usize] * qf  qp[(8 - e) as usize] = qp[(9 - e) as usize] / qf  e = e + 1 }

    let lb = l / 4
    let nblk = lb * lb
    var i: i64 = 0
    while i < n {
        let r = i / l
        let c = i - r * l
        if (r + c) - ((r + c) / 2) * 2 == 0 { sgn[i as usize] = 1 } else { sgn[i as usize] = 0 - 1 }
        blk[i as usize] = (r / 4) * lb + c / 4
        var k: i64 = 0
        while k < 4 { nbr[(i * 4 + k) as usize] = nb_k(i, k, l)  k = k + 1 }
        ba[i as usize] = i
        bb[i as usize] = nb_k(i, 0, l)
        ba[(n + i) as usize] = i
        bb[(n + i) as usize] = nb_k(i, 1, l)
        i = i + 1
    }
    // incident bonds: own right, own down, left neighbour's right, up neighbour's down
    var i2: i64 = 0
    while i2 < n {
        inc[(i2 * 4) as usize] = i2
        inc[(i2 * 4 + 1) as usize] = n + i2
        inc[(i2 * 4 + 2) as usize] = nbr[(i2 * 4 + 2) as usize]
        inc[(i2 * 4 + 3) as usize] = n + nbr[(i2 * 4 + 3) as usize]
        i2 = i2 + 1
    }

    var b0: i64 = 0
    while b0 < m { rate[b0 as usize] = rate_of(b0, &occ, &nbr, &ba, &bb, &qp, hops)  b0 = b0 + 1 }
    fw_build(&! tree, m, &rate)
    var total: f64 = fw_prefix(&tree, m - 1)
    var top: i64 = 1
    while top * 2 <= m { top = top * 2 }

    var s: i64 = seed0
    var occ_n: i64 = 0
    var pairs_n: i64 = 0
    var qcur: i64 = 0
    var max_q: i64 = 0
    var mismatches: i64 = 0
    var book_ok = true
    var bad_picks: i64 = 0

    var numt: f64 = 0.0
    var nump: f64 = 0.0
    var numm: f64 = 0.0
    var numb: f64 = 0.0
    var den: f64 = 0.0
    var denb: f64 = 0.0
    var batch: i64 = 0
    var in_batch: i64 = 0
    let samp = n / 8

    let total_steps = n_burn + n_batch * batch_len
    var step: i64 = 0
    while step < total_steps {
        // --- accumulate the current state, weighted by 1/R ---
        if step >= n_burn {
            let inv = 1.0 / total
            numt = numt + inv * (occ_n as f64) / (n as f64)
            nump = nump + inv * (pairs_n as f64) / (m as f64)
            numm = numm + inv * (abs_i(qcur) as f64) * 2.0 / (n as f64)
            den = den + inv
            if in_batch - (in_batch / samp) * samp == 0 {
                var bi: i64 = 0
                while bi < nblk { bq[bi as usize] = 0  bi = bi + 1 }
                var si: i64 = 0
                while si < n {
                    if occ[si as usize] == 1 { bq[blk[si as usize] as usize] = bq[blk[si as usize] as usize] + sgn[si as usize] }
                    si = si + 1
                }
                var mb: f64 = 0.0
                var bj: i64 = 0
                while bj < nblk { mb = mb + (abs_i(bq[bj as usize]) as f64) / 8.0  bj = bj + 1 }
                numb = numb + inv * mb / (nblk as f64)
                denb = denb + inv
            }
            in_batch = in_batch + 1
            if in_batch == batch_len {
                bm[(batch * 4) as usize] = numt / den
                bm[(batch * 4 + 1) as usize] = nump / den
                bm[(batch * 4 + 2) as usize] = numm / den
                bm[(batch * 4 + 3) as usize] = numb / denb
                numt = 0.0  nump = 0.0  numm = 0.0  numb = 0.0  den = 0.0  denb = 0.0
                in_batch = 0
                batch = batch + 1
            }
        }

        // --- select ---
        s = rng_step(s)
        let u = rng_unit(s) * total
        var pick = fw_find(&tree, m, top, u)
        if pick >= m { pick = m - 1 }
        if rate[pick as usize] <= 0.0 {
            bad_picks = bad_picks + 1
            var alt: i64 = 0
            while alt < m && rate[alt as usize] <= 0.0 { alt = alt + 1 }
            pick = alt
        }

        // --- execute ---
        let x: i64 = ba[pick as usize]
        let y: i64 = bb[pick as usize]
        let sx: i64 = occ[x as usize]
        let sy: i64 = occ[y as usize]
        let nx = nocc_except(x, y, &occ, &nbr)
        let ny = nocc_except(y, x, &occ, &nbr)
        if sx == 0 && sy == 0 {
            occ[x as usize] = 1  occ[y as usize] = 1
            occ_n = occ_n + 2  pairs_n = pairs_n + 1 + nx + ny
            qcur = qcur + sgn[x as usize] + sgn[y as usize]
        } else if sx == 1 && sy == 1 {
            occ[x as usize] = 0  occ[y as usize] = 0
            occ_n = occ_n - 2  pairs_n = pairs_n - 1 - nx - ny
            qcur = qcur - sgn[x as usize] - sgn[y as usize]
        } else if sx == 1 {
            occ[x as usize] = 0  occ[y as usize] = 1
            pairs_n = pairs_n + ny - nx
            qcur = qcur - sgn[x as usize] + sgn[y as usize]
        } else {
            occ[y as usize] = 0  occ[x as usize] = 1
            pairs_n = pairs_n + nx - ny
            qcur = qcur + sgn[x as usize] - sgn[y as usize]
        }
        if abs_i(qcur) > max_q { max_q = abs_i(qcur) }

        // --- update every bond whose rate can have changed ---
        let tag = step + 1
        var w0: i64 = 0
        while w0 < 10 {
            var site: i64 = 0
            if w0 == 0 { site = x } else if w0 == 1 { site = y }
            else if w0 < 6 { site = nbr[(x * 4 + w0 - 2) as usize] }
            else { site = nbr[(y * 4 + w0 - 6) as usize] }
            var kk: i64 = 0
            while kk < 4 {
                let bnd: i64 = inc[(site * 4 + kk) as usize]
                if stamp[bnd as usize] != tag {
                    stamp[bnd as usize] = tag
                    let nr = rate_of(bnd, &occ, &nbr, &ba, &bb, &qp, hops)
                    let dr = nr - rate[bnd as usize]
                    if dr != 0.0 {
                        fw_add(&! tree, m, bnd, dr)
                        total = total + dr
                        rate[bnd as usize] = nr
                    }
                }
                kk = kk + 1
            }
            w0 = w0 + 1
        }

        // --- periodic full verification and drift removal ---
        if (step + 1) - ((step + 1) / 50000) * 50000 == 0 {
            var cb: i64 = 0
            while cb < m {
                chk[cb as usize] = rate_of(cb, &occ, &nbr, &ba, &bb, &qp, hops)
                if chk[cb as usize] != rate[cb as usize] { mismatches = mismatches + 1 }
                cb = cb + 1
            }
            var ro: i64 = 0
            var rp: i64 = 0
            var rq: i64 = 0
            var ci: i64 = 0
            while ci < n {
                if occ[ci as usize] == 1 {
                    ro = ro + 1
                    rq = rq + sgn[ci as usize]
                    rp = rp + occ[nbr[(ci * 4) as usize] as usize] + occ[nbr[(ci * 4 + 1) as usize] as usize]
                }
                ci = ci + 1
            }
            if ro != occ_n || rp != pairs_n || rq != qcur { book_ok = false }
            var cr: i64 = 0
            while cr < m { rate[cr as usize] = chk[cr as usize]  cr = cr + 1 }
            fw_build(&! tree, m, &rate)
            total = fw_prefix(&tree, m - 1)
        }
        step = step + 1
    }

    var ob: i64 = 0
    while ob < 4 {
        var mean: f64 = 0.0
        var bk: i64 = 0
        while bk < n_batch { mean = mean + bm[(bk * 4 + ob) as usize]  bk = bk + 1 }
        mean = mean / (n_batch as f64)
        var ss: f64 = 0.0
        var bk2: i64 = 0
        while bk2 < n_batch { let d = bm[(bk2 * 4 + ob) as usize] - mean  ss = ss + d * d  bk2 = bk2 + 1 }
        out[(2 * ob) as usize] = mean
        out[(2 * ob + 1) as usize] = sqrt_newton(ss / ((n_batch as f64) * ((n_batch as f64) - 1.0)))
        ob = ob + 1
    }
    out[8] = mismatches as f64
    if book_ok { out[9] = 1.0 }
    out[10] = bad_picks as f64
    out[12] = max_q as f64
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("c(2x2) ORDER, THE Q INVARIANT, AND MEAN FIELD ON THE SYMMETRIC LINE K = q^4")
    println("")
    var all_ok = true

    // --- PART A ----------------------------------------------------------
    print("-- PART A: Fenwick tree against a linear scan (5000 queries, a third zero-rate): ")
    let fw_ok = fenwick_selftest()
    if fw_ok { println("ok") } else { println("FAILED") }
    if !fw_ok { all_ok = false }
    println("")

    // --- PART B ----------------------------------------------------------
    println("-- PART B: the engine on 4x4 against exact enumeration of the same lattice --")
    println("   q  dynamics     quantity       KMC                  exact      |diff|/SE")
    var out: [f64; 16] = [0.0; 16]
    var ex: [f64; 4] = [0.0; 4]
    var vq: [i64; 2] = [3, 8]
    var iv: i64 = 0
    while iv < 2 {
        let q: i64 = vq[iv as usize]
        var dm: i64 = 0
        while dm < 2 {
            let hops = dm == 1
            exact4(q, hops, &! ex)
            kmc_run(4, q, hops, 777 + q * 31 + dm, 200000, 20, 150000, &! out)
            var ob: i64 = 0
            while ob < 3 {
                let kv: f64 = out[(2 * ob) as usize]
                let se: f64 = out[(2 * ob + 1) as usize]
                let xv: f64 = ex[ob as usize]
                print("   ") print(q)
                if hops { print("  with hops    ") } else { print("  dimer only   ") }
                if ob == 0 { print("theta          ") }
                if ob == 1 { print("pair density   ") }
                if ob == 2 { print("|M|            ") }
                print_f64(kv) print(" +- ") print_f64(se)
                print("   ") print_f64(xv)
                var ok = true
                if se > 0.0 {
                    print("   ") print_f64(abs_f(kv - xv) / se)
                    ok = abs_f(kv - xv) < 3.0 * se
                } else {
                    print("   (identically ") print_f64(kv) print(")")
                    ok = abs_f(kv - xv) < 0.000000001
                }
                if ok { println("   ok") } else { println("   FAILED") }
                if !ok { all_ok = false }
                ob = ob + 1
            }
            let mism: f64 = out[8]
            let bad: f64 = out[10]
            let maxq: f64 = out[12]
            let book = out[9] > 0.5
            print("      rate mismatches ") print_f64(mism)
            print("   recounts ")
            if book { print("match") } else { print("DRIFTED") }
            print("   zero-rate picks ") print_f64(bad)
            print("   max|Q| ") print_f64(maxq)
            let q_ok = hops || maxq == 0.0
            if !q_ok { print("   Q MOVED WITHOUT HOPS") }
            println("")
            if mism != 0.0 || !book || bad != 0.0 || !q_ok { all_ok = false }
            dm = dm + 1
        }
        iv = iv + 1
    }
    println("")
    if !all_ok {
        println("validation failed -- not running the sweep")
        println("M5B_C2X2_ORDER_FAILED")
        return 0
    }

    // --- PART C ----------------------------------------------------------
    println("-- PART C: the sweep --")
    println("   exact (L=inf): pair density from Onsager, |M| from Yang; MF: two-sublattice")
    println("")
    var qs: [i64; 6] = [2, 3, 4, 5, 6, 8]
    var ls: [i64; 2] = [16, 32]
    var iq: i64 = 0
    while iq < 6 {
        let q: i64 = qs[iq as usize]
        let x = sqrt_newton(q as f64)
        let kj = ln_f(q as f64) / 4.0
        let p_ex = (1.0 - onsager_nn(x)) / 4.0
        let m_ex = yang_m(x)
        let m_mf = mf_m(kj)
        print("q=") print(q)
        print("  beta*J=") print_f64(kj)
        print("   exact: pairs ") print_f64(p_ex) print("  |M| ") print_f64(m_ex)
        print("   MF: pairs ") print_f64((1.0 - m_mf * m_mf) / 4.0) print("  |m| ") print_f64(m_mf)
        println("")
        println("     L   dynamics     pair density         |M|                  block |M|")
        var il: i64 = 0
        while il < 2 {
            let l: i64 = ls[il as usize]
            let n = l * l
            var dm: i64 = 1
            while dm >= 0 {
                let hops = dm == 1
                kmc_run(l, q, hops, 424242 + q * 1009 + l * 17 + dm, 400 * n, 20, 150 * n, &! out)
                let pd: f64 = out[2]
                let pse: f64 = out[3]
                let mg: f64 = out[4]
                let mse: f64 = out[5]
                let mb: f64 = out[6]
                let mbse: f64 = out[7]
                print("    ") print(l)
                if hops { print("  with hops    ") } else { print("  dimer only   ") }
                print_f64(pd) print(" +- ") print_f64(pse)
                print("   ") print_f64(mg) print(" +- ") print_f64(mse)
                print("   ") print_f64(mb) print(" +- ") print_f64(mbse)
                println("")
                let mism2: f64 = out[8]
                let bad2: f64 = out[10]
                let maxq2: f64 = out[12]
                if mism2 != 0.0 || out[9] < 0.5 || bad2 != 0.0 || (!hops && maxq2 != 0.0) {
                    println("      ENGINE CHECK FAILED ON THIS RUN")
                    all_ok = false
                }
                dm = dm - 1
            }
            il = il + 1
        }
        println("")
        iq = iq + 1
    }

    if all_ok { println("M5B_C2X2_ORDER_OK") } else { println("M5B_C2X2_ORDER_FAILED") }
    0
}
