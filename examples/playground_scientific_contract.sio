// Playground scientific contract
//
// This example treats Sounio as the language of the scientific/provenance lane.
// The goal is not to render UI, but to make workflow acceptance explicit:
// dataset selected, artifact linked, review checkpoint present, and confidence
// above the publication threshold.

struct TruthState {
    observed_confidence: i64,   // ×10³
    remembered_confidence: i64, // ×10³
}

struct ScientificContract {
    dataset_selected: i64,
    artifact_linked: i64,
    review_checkpoint: i64,
    confidence: i64, // ×10³
}

fn remembered_contract() -> ScientificContract {
    return ScientificContract {
        dataset_selected: 1,
        artifact_linked: 1,
        review_checkpoint: 1,
        confidence: 930,
    }
}

fn observed_contract() -> ScientificContract {
    return ScientificContract {
        dataset_selected: 1,
        artifact_linked: 1,
        review_checkpoint: 1,
        confidence: 980,
    }
}

fn stronger_truth(a: TruthState, b: TruthState) -> TruthState {
    let observed = if a.observed_confidence > b.observed_confidence {
        a.observed_confidence
    } else {
        b.observed_confidence
    }

    let remembered = if a.remembered_confidence > b.remembered_confidence {
        a.remembered_confidence
    } else {
        b.remembered_confidence
    }

    return TruthState {
        observed_confidence: observed,
        remembered_confidence: remembered,
    }
}

fn meets_publication_gate(contract: ScientificContract) -> i64 {
    if contract.dataset_selected != 1 { return 0 }
    if contract.artifact_linked != 1 { return 0 }
    if contract.review_checkpoint != 1 { return 0 }
    if contract.confidence < 900 { return 0 }
    return 1
}

fn main() -> i64 with IO {
    let remembered = remembered_contract()
    let observed = observed_contract()
    let truth = stronger_truth(
        TruthState {
            observed_confidence: 0,
            remembered_confidence: remembered.confidence,
        },
        TruthState {
            observed_confidence: observed.confidence,
            remembered_confidence: 0,
        }
    )

    print("playground scientific contract\n")
    print("publication gate: ")
    print_int(meets_publication_gate(observed))
    print("\n")
    print("remembered confidence: ")
    print_int(truth.remembered_confidence)
    print("\n")
    print("observed confidence: ")
    print_int(truth.observed_confidence)
    print("\n")

    return 0
}
