//@ run-pass
// drug_cascade_168_demo.sio
//
// Is the brain non-associative?
// The 168 theorem applied to psychiatric drug cascades.

// ============================================================================
// INLINE: Fano plane + classification (self-contained for JIT)
// ============================================================================

fn fano_lines() -> [i32; 21] with Mut, Panic {
    var t: [i32; 21] = [0; 21]
    t[0]=1;t[1]=2;t[2]=4; t[3]=2;t[4]=3;t[5]=5; t[6]=3;t[7]=4;t[8]=6
    t[9]=4;t[10]=5;t[11]=7; t[12]=5;t[13]=6;t[14]=1; t[15]=6;t[16]=7;t[17]=2
    t[18]=7;t[19]=1;t[20]=3
    t
}

fn is_on_fano_line(a: i32, b: i32, c: i32) -> bool with Mut, Panic, Div {
    if a == b || b == c || a == c { return true }
    let t = fano_lines()
    var line: i32 = 0
    while line < 7 {
        let p=t[(line*3) as usize]; let q=t[(line*3+1) as usize]; let r=t[(line*3+2) as usize]
        let ha = a==p||a==q||a==r; let hb = b==p||b==q||b==r; let hc = c==p||c==q||c==r
        if ha && hb && hc { return true }
        line = line + 1
    }
    false
}

fn classify(a: i32, b: i32, c: i32) -> i32 with Mut, Panic, Div {
    if a==b||b==c||a==c { return 0 }
    if is_on_fano_line(a,b,c) { return 1 }
    return 2
}

fn drug_name(d: i32) with IO {
    if d==1 { print("SSRI") }
    else if d==2 { print("SNRI") }
    else if d==3 { print("Benzo") }
    else if d==4 { print("TypAP") }
    else if d==5 { print("AtyAP") }
    else if d==6 { print("MoodS") }
    else if d==7 { print("Stim") }
    else { print("???") }
}

fn class_name(c: i32) with IO {
    if c==0 { print("TRIVIAL     ") }
    else if c==1 { print("ASSOCIATIVE ") }
    else { print("NON-ASSOC   ") }
}

fn line_name(l: i32) with IO {
    if l==0 { print("monoamine triad") }
    else if l==1 { print("anxiolytic-AP bridge") }
    else if l==2 { print("sedation-stabilization") }
    else if l==3 { print("dopamine spectrum") }
    else if l==4 { print("maintenance triad") }
    else if l==5 { print("activation axis") }
    else if l==6 { print("anxiety management") }
    else { print("(none)") }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    println("================================================================")
    println("  IS THE BRAIN NON-ASSOCIATIVE?")
    println("  The 168 Theorem Applied to Psychiatric Drug Cascades")
    println("================================================================")
    println("")

    // ---------------------------------------------------------------
    // Part 1: The 168 partition
    // ---------------------------------------------------------------
    println("--- PART 1: The 168 Partition ---")
    println("")

    var trivial: i32 = 0
    var assoc: i32 = 0
    var nonassoc: i32 = 0

    var i: i32 = 1
    while i <= 7 {
        var j: i32 = 1
        while j <= 7 {
            var k: i32 = 1
            while k <= 7 {
                let c = classify(i, j, k)
                if c == 0 { trivial = trivial + 1 }
                else if c == 1 { assoc = assoc + 1 }
                else { nonassoc = nonassoc + 1 }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    println("  Of 343 ordered drug triples (i,j,k):")
    print("    Trivial (repeated class):       "); println(trivial)
    print("    Associative (Fano line):         "); println(assoc)
    print("    NON-ASSOCIATIVE (order matters): "); println(nonassoc)
    print("    Total:                           "); println(trivial + assoc + nonassoc)
    println("")
    print("  168 = |PSL(2,7)| = "); println(nonassoc)
    if nonassoc == 168 { println("  VERIFIED.") }
    println("")

    // ---------------------------------------------------------------
    // Part 2: The 7 Fano lines (associative corridors)
    // ---------------------------------------------------------------
    println("--- PART 2: The 7 Fano Lines (Associative Drug Triads) ---")
    println("")

    let t = fano_lines()
    var line: i32 = 0
    while line < 7 {
        let p=t[(line*3) as usize]; let q=t[(line*3+1) as usize]; let r=t[(line*3+2) as usize]
        print("  Line "); print(line + 1); print(": ")
        drug_name(p); print(" - "); drug_name(q); print(" - "); drug_name(r)
        print("  ("); line_name(line); println(")")
        line = line + 1
    }
    println("")
    println("  Drugs on the SAME line: order doesn't matter.")
    println("  Drugs on DIFFERENT lines: order MATTERS.")
    println("")

    // ---------------------------------------------------------------
    // Part 3: Clinical cascade analysis
    // ---------------------------------------------------------------
    println("--- PART 3: Clinical Cascade Analysis ---")
    println("")

    // STAR*D cascade: SSRI → SNRI → AtypicalAP → MoodStab
    println("  STAR*D depression sequence: SSRI → SNRI → AtyAP → MoodS")
    let s1 = classify(1, 2, 5)  // SSRI, SNRI, AtypicalAP
    let s2 = classify(2, 5, 6)  // SNRI, AtypicalAP, MoodStab
    print("    (SSRI,SNRI,AtyAP):   "); class_name(s1)
    if s1 == 1 { print(" — on line: "); line_name(0) }
    println("")
    print("    (SNRI,AtyAP,MoodS):  "); class_name(s2)
    println("")

    var star_d_na: i32 = 0
    if s1 == 2 { star_d_na = star_d_na + 1 }
    if s2 == 2 { star_d_na = star_d_na + 1 }
    print("    Non-associative triples: "); print(star_d_na); println("/2")
    println("")

    // Alternative: Benzo → SSRI → AtypicalAP → MoodStab
    println("  Alternative: Benzo → SSRI → AtyAP → MoodS")
    let a1 = classify(3, 1, 5)  // Benzo, SSRI, AtypicalAP
    let a2 = classify(1, 5, 6)  // SSRI, AtypicalAP, MoodStab
    print("    (Benzo,SSRI,AtyAP):  "); class_name(a1); println("")
    print("    (SSRI,AtyAP,MoodS):  "); class_name(a2)
    if a2 == 1 { print(" — on line: "); line_name(4) }
    println("")

    var alt_na: i32 = 0
    if a1 == 2 { alt_na = alt_na + 1 }
    if a2 == 2 { alt_na = alt_na + 1 }
    print("    Non-associative triples: "); print(alt_na); println("/2")
    println("")

    // Schizophrenia: TypAP → AtyAP → MoodS → Benzo → SSRI
    println("  Schizophrenia: TypAP → AtyAP → MoodS → Benzo → SSRI")
    let z1 = classify(4, 5, 6); let z2 = classify(5, 6, 3); let z3 = classify(6, 3, 1)
    print("    (TypAP,AtyAP,MoodS): "); class_name(z1); println("")
    print("    (AtyAP,MoodS,Benzo): "); class_name(z2); println("")
    print("    (MoodS,Benzo,SSRI):  "); class_name(z3)
    if z3 == 1 { print(" — on line: "); line_name(4) }
    println("")

    var sch_na: i32 = 0
    if z1 == 2 { sch_na = sch_na + 1 }
    if z2 == 2 { sch_na = sch_na + 1 }
    if z3 == 2 { sch_na = sch_na + 1 }
    print("    Non-associative triples: "); print(sch_na); println("/3")
    println("")

    // ADHD + anxiety: Stim → SSRI → Benzo
    println("  ADHD+anxiety: Stim → SSRI → Benzo")
    let h1 = classify(7, 1, 3)
    print("    (Stim,SSRI,Benzo):   "); class_name(h1)
    if h1 == 1 { print(" — on line: "); line_name(6) }
    println("")
    println("")

    // ---------------------------------------------------------------
    // Part 4: Predictions
    // ---------------------------------------------------------------
    println("--- PART 4: Predictions ---")
    println("")
    println("  1. STAR*D vs Alternative cascade:")
    if star_d_na != alt_na {
        println("     DIFFERENT non-associative content.")
        println("     The 168 theorem predicts different clinical outcomes")
        println("     purely from the order of drug classes.")
    } else {
        println("     Same non-associative content.")
        println("     The order difference is within an associative corridor.")
    }
    println("")
    println("  2. ADHD+anxiety (Stim→SSRI→Benzo):")
    if h1 == 1 {
        println("     ASSOCIATIVE — these three share Fano line 7.")
        println("     Prediction: the order of introduction should NOT matter.")
        println("     Clinically testable: does Stim-first vs SSRI-first")
        println("     produce equivalent outcomes for ADHD+anxiety?")
    } else {
        println("     NON-ASSOCIATIVE — order should matter.")
    }
    println("")
    println("  3. The binary property ||[A,B,C]|| in {0,2} predicts:")
    println("     Drug cascade effects are BIMODAL.")
    println("     Either order completely matters or completely doesn't.")
    println("     No partial order-dependence should exist.")
    println("     This is FALSIFIABLE against clinical trial data.")
    println("")
    println("================================================================")
    println("  The question: Is the brain non-associative?")
    println("  The test: Do the 168 order-dependent drug triples")
    println("            match clinical order-dependence data?")
    println("  The tool: Sounio — the only language that can compute")
    println("            associators with epistemic tracking on the")
    println("            same object that carries the clinical data.")
    println("================================================================")

    0
}
