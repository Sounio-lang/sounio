// examples/real_sounio_native_knowledge_demo.sio
//
// Second capability demonstration: usage of the compiler-native epistemic type.
//
// This file shows the feature that actually distinguishes Sounio from every
// other language: `Knowledge<T>` with built-in GUM uncertainty propagation,
// `measure(...)` constructor, automatic delta-method codegen, and the
// `Epistemic` / `Confidence(N)` effect system.
//
// Goal: short, clean, and obviously correct. This is the style you want in
// real dissertation/clinical code.

/// Simple 1-compartment oral dose calculation with epistemic inputs.
/// CL and target concentration are both uncertain (Knowledge<f64>).
fn oral_dose(
    cl: Knowledge<f64>,
    target_conc: Knowledge<f64>,
    f_oral: f64,
    tau_h: f64
) -> Knowledge<f64> with Epistemic {
    // Dose (mg) = (CL * target * tau) / F
    // All operations on Knowledge propagate variance automatically via the
    // compiler's GUM codegen (JCGM 100:2008 delta method in SSA).
    (cl * target_conc * tau_h) / f_oral
}

fn main() with IO, Epistemic {
    print("=== real sounio native Knowledge<T> demo ===\n")

    // Real-world-ish example: post-genotyping CL estimate for an adult.
    // 40 L/h ± 1.6 (CV ~4%), high confidence.
    let cl: Knowledge<f64> = measure(40.0, uncertainty: 1.6)

    // Target Ctrough = 5 ng/mL = 0.005 mg/L, with modest uncertainty.
    let target: Knowledge<f64> = measure(0.005, uncertainty: 0.0002)

    let f_oral = 0.65
    let tau = 24.0

    let dose = oral_dose(cl, target, f_oral, tau)

    // The compiler has already propagated the uncertainty through *, /, etc.
    print("Dose (mg) best estimate: ")
    print_f64(dose.value)
    print("\n")

    print("Dose uncertainty (GUM):  ")
    print_f64(dose.uncertainty)
    print("\n")

    // Relative uncertainty on the dose
    let rel_u = dose.uncertainty / dose.value
    print("Relative uncertainty:    ")
    print_f64(rel_u * 100.0)
    print(" %\n")

    // Sanity: the value should be around (40 * 0.005 * 24) / 0.65 ≈ 7.38 mg
    // We just check that it is positive and the uncertainty is reasonable.
    if dose.value > 0.0 && dose.uncertainty > 0.0 && dose.uncertainty < 1.0 {
        print("\nNATIVE KNOWLEDGE DEMO: PASS\n")
    } else {
        print("\nNATIVE KNOWLEDGE DEMO: FAIL\n")
    }
}
