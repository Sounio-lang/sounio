//@ run-pass
// algebra_demo.sio — How a mathematician uses Sounio
//
// "I want to work in the octonions. Show me the associator structure."
// "Now switch to sedenions. Do zero divisors appear?"
// "What's T_k for k=3,4,5?"

// Inline the CD algebra (self-contained demo)
fn cd_sigma(a: i32, b: i32, bits: i32) -> i32 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return -1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma(a_lo, 0, bits - 1) }
        return 0 - cd_sigma(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma(0, a_lo, bits - 1) }
    cd_sigma(b_lo, a_lo, bits - 1)
}

struct CD {
    c: [f64; 64],
    bits: i32,
}

fn cd_zero(k: i32) -> CD with Mut, Panic { CD { c: [0.0; 64], bits: k } }

fn cd_basis(k: i32, idx: i32) -> CD with Mut, Panic {
    var r = cd_zero(k)
    r.c[idx as usize] = 1.0
    r
}

fn cd_mul(a: CD, b: CD) -> CD with Mut, Panic, Div {
    let n = 1 << a.bits
    var r = cd_zero(a.bits)
    var i: i32 = 0
    while i < n {
        if a.c[i as usize] != 0.0 {
            var j: i32 = 0
            while j < n {
                if b.c[j as usize] != 0.0 {
                    let idx = i ^ j
                    let sign = cd_sigma(i, j, a.bits)
                    r.c[idx as usize] = r.c[idx as usize]
                        + (sign as f64) * a.c[i as usize] * b.c[j as usize]
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    r
}

fn cd_norm_sq(a: CD) -> f64 with Mut, Panic, Div {
    let n = 1 << a.bits
    var s: f64 = 0.0
    var i: i32 = 0
    while i < n { s = s + a.c[i as usize] * a.c[i as usize]; i = i + 1 }
    s
}

fn cd_sub(a: CD, b: CD) -> CD with Mut, Panic, Div {
    let n = 1 << a.bits
    var r = cd_zero(a.bits)
    var i: i32 = 0
    while i < n { r.c[i as usize] = a.c[i as usize] - b.c[i as usize]; i = i + 1 }
    r
}

fn cd_add(a: CD, b: CD) -> CD with Mut, Panic, Div {
    let n = 1 << a.bits
    var r = cd_zero(a.bits)
    var i: i32 = 0
    while i < n { r.c[i as usize] = a.c[i as usize] + b.c[i as usize]; i = i + 1 }
    r
}

fn abs_f(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i32 with Mut, Panic, Div, IO {
    println("================================================================")
    println("  SOUNIO ALGEBRA DEMO — Cayley-Dickson Tower")
    println("  Choose your algebra. Compute. Explore.")
    println("================================================================")

    // ---------------------------------------------------------------
    // QUATERNIONS (k=2, dim 4): associative, non-commutative
    // ---------------------------------------------------------------
    println("")
    println("=== QUATERNIONS (k=2, dim 4) ===")
    let k = 2
    let i_q = cd_basis(k, 1)   // i
    let j_q = cd_basis(k, 2)   // j
    let k_q = cd_basis(k, 3)   // k

    let ij = cd_mul(i_q, j_q)  // i*j = k
    let ji = cd_mul(j_q, i_q)  // j*i = -k

    // Check: i*j = -j*i (anti-commutative)
    let sum = cd_add(ij, ji)
    let anticomm = cd_norm_sq(sum) < 0.001
    println("  i*j + j*i = 0 (anti-commutative): ")
    if anticomm { println("  YES") } else { println("  NO") }

    // Check associativity: (i*j)*k = i*(j*k)
    let left = cd_mul(cd_mul(i_q, j_q), k_q)
    let right = cd_mul(i_q, cd_mul(j_q, k_q))
    let assoc = cd_sub(left, right)
    let is_assoc = cd_norm_sq(assoc) < 0.001
    println("  (i*j)*k = i*(j*k) (associative): ")
    if is_assoc { println("  YES — quaternions are associative") } else { println("  NO") }

    // ---------------------------------------------------------------
    // OCTONIONS (k=3, dim 8): non-associative, alternative
    // ---------------------------------------------------------------
    println("")
    println("=== OCTONIONS (k=3, dim 8) ===")
    let k3 = 3
    let e1 = cd_basis(k3, 1)
    let e2 = cd_basis(k3, 2)
    let e4 = cd_basis(k3, 4)

    // Find an associative and a non-associative triple in the BINARY labeling
    // (Note: the binary labeling's Fano lines differ from the standard labeling)
    let e3 = cd_basis(k3, 3)
    let e5 = cd_basis(k3, 5)

    // Test (1,2,3): 1 XOR 2 = 3 → these share a "line" in Z_2^3
    let left2 = cd_mul(cd_mul(e1, e2), e3)
    let right2 = cd_mul(e1, cd_mul(e2, e3))
    let assoc2 = cd_sub(left2, right2)
    let nsq2 = cd_norm_sq(assoc2)
    println("  [e1, e2, e3]: ||assoc||^2 = ")
    println(nsq2)
    if abs_f(nsq2) < 0.001 {
        println("  → ASSOCIATIVE")
    } else {
        println("  → NON-ASSOCIATIVE (norm = 2)")
    }

    // Test (1,2,5)
    let left3 = cd_mul(cd_mul(e1, e2), e5)
    let right3 = cd_mul(e1, cd_mul(e2, e5))
    let assoc3 = cd_sub(left3, right3)
    let nsq3 = cd_norm_sq(assoc3)
    println("  [e1, e2, e5]: ||assoc||^2 = ")
    println(nsq3)
    if abs_f(nsq3) < 0.001 {
        println("  → ASSOCIATIVE")
    } else {
        println("  → NON-ASSOCIATIVE (norm = 2)")
    }

    println("  (Binary labeling: Fano lines differ from standard labeling)")

    // Count T_3
    var t3: i32 = 0
    var ii: i32 = 1
    while ii <= 7 {
        var jj: i32 = 1
        while jj <= 7 {
            var kk: i32 = 1
            while kk <= 7 {
                let a = cd_sigma(ii, jj, 3) * cd_sigma(ii ^ jj, kk, 3)
                let b = cd_sigma(jj, kk, 3) * cd_sigma(ii, jj ^ kk, 3)
                if a != b { t3 = t3 + 1 }
                kk = kk + 1
            }
            jj = jj + 1
        }
        ii = ii + 1
    }
    println("  T_3 = ")
    println(t3)
    println("  (= 168 = |PSL(2,7)|)")

    // ---------------------------------------------------------------
    // SEDENIONS (k=4, dim 16): zero divisors appear!
    // ---------------------------------------------------------------
    println("")
    println("=== SEDENIONS (k=4, dim 16) ===")
    let k4 = 4

    // Known zero divisor: (e3 + e10)(e6 - e15) = 0
    let zd_a = cd_add(cd_basis(k4, 3), cd_basis(k4, 10))
    let zd_b = cd_sub(cd_basis(k4, 6), cd_basis(k4, 15))
    let zd_prod = cd_mul(zd_a, zd_b)

    println("  (e3 + e10)(e6 - e15) norm^2 = ")
    println(cd_norm_sq(zd_prod))
    println("  → 0 = ZERO DIVISOR (both factors nonzero, product = 0)")

    println("  ||e3 + e10||^2 = ")
    println(cd_norm_sq(zd_a))
    println("  ||e6 - e15||^2 = ")
    println(cd_norm_sq(zd_b))
    println("  Both nonzero → division algebra BROKEN at sedenions")

    // Count T_4
    var t4: i32 = 0
    ii = 1
    while ii <= 15 {
        var jj2: i32 = 1
        while jj2 <= 15 {
            var kk2: i32 = 1
            while kk2 <= 15 {
                let a = cd_sigma(ii, jj2, 4) * cd_sigma(ii ^ jj2, kk2, 4)
                let b = cd_sigma(jj2, kk2, 4) * cd_sigma(ii, jj2 ^ kk2, 4)
                if a != b { t4 = t4 + 1 }
                kk2 = kk2 + 1
            }
            jj2 = jj2 + 1
        }
        ii = ii + 1
    }
    println("  T_4 = ")
    println(t4)
    println("  (= 1848 = 11 × 168)")

    // ---------------------------------------------------------------
    // SUMMARY
    // ---------------------------------------------------------------
    println("")
    println("================================================================")
    println("  TOWER SUMMARY")
    println("================================================================")
    println("  k=1 (C):   commutative, associative, division")
    println("  k=2 (H):   non-commutative, associative, division")
    println("  k=3 (O):   non-commutative, NON-ASSOCIATIVE, division, T=168")
    println("  k=4 (S):   non-commutative, non-associative, ZERO DIVISORS, T=1848")
    println("")
    println("  At each step, a property is lost.")
    println("  The 168 quantum is preserved: T_k is always a multiple of 168.")
    println("  ||[a,b,c]|| in {0, 2} for ALL k (proven).")
    println("")
    println("  To explore higher algebras:")
    println("    let k = 5  // trigintaduonions, dim 32")
    println("    let a = cd_basis(k, 1)")
    println("    let b = cd_basis(k, 17)")
    println("    let c = cd_mul(a, b)")

    0
}
