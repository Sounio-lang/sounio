// Exact unit-distance certifier over K = Q(sqrt3, sqrt5, sqrt11), NATIVE Sounio.
// 8-dim field, XOR-graded:  e_i * e_j = prime_product(i AND j) * e_{i XOR j}
// basis bits: bit0=sqrt3, bit1=sqrt5, bit2=sqrt11.
// Moser spindle, coords scaled x12 => a unit edge has exact squared length 144.
// Prints the number of exact unit-distance edges (must be 11) and returns it.

fn prime_product(mask: i64) -> i64 {
    var r: i64 = 1
    if (mask & 1) != 0 { r = r * 3 }
    if (mask & 2) != 0 { r = r * 5 }
    if (mask & 4) != 0 { r = r * 11 }
    r
}

fn main() -> i64 with IO, Mut {
    // 7 points, 16 comps each: comps 0..7 = x (field), 8..15 = y (field). flat.
    var c: [i64; 112] = [0; 112]
    // B = (sqrt3/2, 1/2)*12 = (6 sqrt3, 6):  idx1=sqrt3, idx0=1
    c[16 + 1] = 6
    c[16 + 8 + 0] = 6
    // C = (6 sqrt3, -6)
    c[32 + 1] = 6
    c[32 + 8 + 0] = 0 - 6
    // D = (sqrt3,0)*12 = (12 sqrt3, 0)
    c[48 + 1] = 12
    // E = ((5sqrt3 - sqrt11)/12,(sqrt33+5)/12)*12 = (5 sqrt3 - sqrt11, 5 + sqrt33)
    //   sqrt11 = idx4, sqrt33 = idx5
    c[64 + 1] = 5
    c[64 + 4] = 0 - 1
    c[64 + 8 + 0] = 5
    c[64 + 8 + 5] = 1
    // F = (5 sqrt3 + sqrt11, sqrt33 - 5)
    c[80 + 1] = 5
    c[80 + 4] = 1
    c[80 + 8 + 0] = 0 - 5
    c[80 + 8 + 5] = 1
    // G = (5sqrt3/6, sqrt33/6)*12 = (10 sqrt3, 2 sqrt33)
    c[96 + 1] = 10
    c[96 + 8 + 5] = 2

    var count: i64 = 0
    var i: i64 = 0
    while i < 7 {
        var j: i64 = i + 1
        while j < 7 {
            var prod: [i64; 8] = [0; 8]
            var ii: i64 = 0
            while ii < 8 {
                var jj: i64 = 0
                while jj < 8 {
                    let dxi = c[i*16 + ii] - c[j*16 + ii]
                    let dxj = c[i*16 + jj] - c[j*16 + jj]
                    let dyi = c[i*16 + 8 + ii] - c[j*16 + 8 + ii]
                    let dyj = c[i*16 + 8 + jj] - c[j*16 + 8 + jj]
                    let f = prime_product(ii & jj)
                    let idx = ii ^ jj
                    prod[idx] = prod[idx] + (dxi*dxj + dyi*dyj) * f
                    jj = jj + 1
                }
                ii = ii + 1
            }
            var isunit: i64 = 1
            if prod[0] != 144 { isunit = 0 }
            var m: i64 = 1
            while m < 8 {
                if prod[m] != 0 { isunit = 0 }
                m = m + 1
            }
            count = count + isunit
            j = j + 1
        }
        i = i + 1
    }
    println(count)
    count
}
