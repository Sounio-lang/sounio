// Test autodiff with remaining hyperbolic functions
// tanh(x): d/dx tanh(x) = sech²(x) = 1 - tanh²(x)
// asinh(x): d/dx asinh(x) = 1/sqrt(x² + 1)
// acosh(x): d/dx acosh(x) = 1/sqrt(x² - 1) for x > 1
// atanh(x): d/dx atanh(x) = 1/(1 - x²) for |x| < 1

// --- Autodiff preamble ---
fn exp_f64(x: f64) -> f64 {
    if x > 20.0 { return exp_f64(x / 2.0) * exp_f64(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / exp_f64(0.0 - x) }
    var sum = 1.0; var term = 1.0
    term = term * x / 1.0; sum = sum + term; term = term * x / 2.0; sum = sum + term
    term = term * x / 3.0; sum = sum + term; term = term * x / 4.0; sum = sum + term
    term = term * x / 5.0; sum = sum + term; term = term * x / 6.0; sum = sum + term
    term = term * x / 7.0; sum = sum + term; term = term * x / 8.0; sum = sum + term
    term = term * x / 9.0; sum = sum + term; term = term * x / 10.0; sum = sum + term
    term = term * x / 11.0; sum = sum + term; term = term * x / 12.0; sum = sum + term
    return sum
}
fn ln_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 - 1000000.0 }
    var val = x; var k = 0.0; let e = 2.718281828459045
    while val > e { val = val / e; k = k + 1.0 }
    while val < 1.0 / e { val = val * e; k = k - 1.0 }
    let u = (val - 1.0) / (val + 1.0); let u2 = u * u
    var sum = u; var term = u
    term = term * u2; sum = sum + term / 3.0; term = term * u2; sum = sum + term / 5.0
    term = term * u2; sum = sum + term / 7.0; term = term * u2; sum = sum + term / 9.0
    term = term * u2; sum = sum + term / 11.0; term = term * u2; sum = sum + term / 13.0
    return 2.0 * sum + k
}
fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y); y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y); y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y); y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y); y = 0.5 * (y + x / y)
    return y
}
fn tanh_f64(x: f64) -> f64 {
    let e2x = exp_f64(2.0 * x)
    return (e2x - 1.0) / (e2x + 1.0)
}
fn asinh_f64(x: f64) -> f64 { return ln_f64(x + sqrt_f64(x * x + 1.0)) }
fn acosh_f64(x: f64) -> f64 {
    if x < 1.0 { return 0.0 }
    return ln_f64(x + sqrt_f64(x * x - 1.0))
}
fn atanh_f64(x: f64) -> f64 { return (ln_f64(1.0 + x) - ln_f64(1.0 - x)) / 2.0 }
struct Dual { val: f64, dot: f64 }
fn dual(val: f64, dot: f64) -> Dual { return Dual { val: val, dot: dot } }
fn dual_value(d: Dual) -> f64 { return d.val }
fn dual_deriv(d: Dual) -> f64 { return d.dot }
fn dual_tanh(a: Dual) -> Dual {
    let t = tanh_f64(a.val)
    return Dual { val: t, dot: a.dot * (1.0 - t * t) }
}
fn dual_asinh(a: Dual) -> Dual {
    let denom = sqrt_f64(a.val * a.val + 1.0)
    return Dual { val: asinh_f64(a.val), dot: a.dot / denom }
}
fn dual_acosh(a: Dual) -> Dual {
    let denom = sqrt_f64(a.val * a.val - 1.0)
    return Dual { val: acosh_f64(a.val), dot: a.dot / denom }
}
fn dual_atanh(a: Dual) -> Dual {
    let denom = 1.0 - a.val * a.val
    return Dual { val: atanh_f64(a.val), dot: a.dot / denom }
}
// --- End preamble ---

fn main() {
    println("=== Autodiff: tanh(x) at x=0 ===")

    let x: f64 = 0.0
    let x_dual = dual(x, 1.0)

    let result = dual_tanh(x_dual)

    let value = dual_value(result)
    let derivative = dual_deriv(result)

    // tanh(0) = 0
    // d/dx tanh(x) at x=0 = 1 - tanh²(0) = 1 - 0 = 1

    println("f(x) = tanh(x) at x=0:")
    println("  Value f(0) = ")
    println(value)
    println("  Derivative f'(0) = ")
    println(derivative)

    println("Expected: value = 0, derivative = 1")

    println("")
    println("=== Autodiff: tanh(x) at x=1 ===")

    let x2: f64 = 1.0
    let x2_dual = dual(x2, 1.0)

    let result2 = dual_tanh(x2_dual)

    let value2 = dual_value(result2)
    let derivative2 = dual_deriv(result2)

    // tanh(1) ~ 0.7616
    // d/dx tanh(x) at x=1 = 1 - tanh²(1) ~ 1 - 0.58 ~ 0.42

    println("f(x) = tanh(x) at x=1:")
    println("  Value f(1) = ")
    println(value2)
    println("  Derivative f'(1) = ")
    println(derivative2)

    println("Expected: value ~ 0.7616, derivative ~ 0.42")

    println("")
    println("=== Autodiff: asinh(x) at x=0 ===")

    let y: f64 = 0.0
    let y_dual = dual(y, 1.0)

    let result3 = dual_asinh(y_dual)

    let value3 = dual_value(result3)
    let derivative3 = dual_deriv(result3)

    // asinh(0) = 0
    // d/dx asinh(x) at x=0 = 1/sqrt(0 + 1) = 1

    println("g(x) = asinh(x) at x=0:")
    println("  Value g(0) = ")
    println(value3)
    println("  Derivative g'(0) = ")
    println(derivative3)

    println("Expected: value = 0, derivative = 1")

    println("")
    println("=== Autodiff: asinh(x) at x=1 ===")

    let y2: f64 = 1.0
    let y2_dual = dual(y2, 1.0)

    let result4 = dual_asinh(y2_dual)

    let value4 = dual_value(result4)
    let derivative4 = dual_deriv(result4)

    // asinh(1) ~ 0.8814
    // d/dx asinh(x) at x=1 = 1/sqrt(1 + 1) = 1/sqrt(2) ~ 0.7071

    println("g(x) = asinh(x) at x=1:")
    println("  Value g(1) = ")
    println(value4)
    println("  Derivative g'(1) = ")
    println(derivative4)

    println("Expected: value ~ 0.8814, derivative ~ 0.7071")

    println("")
    println("=== Autodiff: acosh(x) at x=2 ===")

    let z: f64 = 2.0
    let z_dual = dual(z, 1.0)

    let result5 = dual_acosh(z_dual)

    let value5 = dual_value(result5)
    let derivative5 = dual_deriv(result5)

    // acosh(2) ~ 1.3170
    // d/dx acosh(x) at x=2 = 1/sqrt(4 - 1) = 1/sqrt(3) ~ 0.5774

    println("h(x) = acosh(x) at x=2:")
    println("  Value h(2) = ")
    println(value5)
    println("  Derivative h'(2) = ")
    println(derivative5)

    println("Expected: value ~ 1.3170, derivative ~ 0.5774")

    println("")
    println("=== Autodiff: atanh(x) at x=0.5 ===")

    let w: f64 = 0.5
    let w_dual = dual(w, 1.0)

    let result6 = dual_atanh(w_dual)

    let value6 = dual_value(result6)
    let derivative6 = dual_deriv(result6)

    // atanh(0.5) ~ 0.5493
    // d/dx atanh(x) at x=0.5 = 1/(1 - 0.25) = 1/0.75 ~ 1.3333

    println("i(x) = atanh(x) at x=0.5:")
    println("  Value i(0.5) = ")
    println(value6)
    println("  Derivative i'(0.5) = ")
    println(derivative6)

    println("Expected: value ~ 0.5493, derivative ~ 1.3333")
}
