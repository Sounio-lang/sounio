//@ run-pass
// binary_norm_proof.sio
//
// THEOREM: For ALL Cayley-Dickson algebras (any dimension 2^k, k >= 3),
// the associator norm on basis elements satisfies:
//
//     ||[e_i, e_j, e_k]|| ∈ {0, 2}
//
// PROOF (implemented as verified computation):
//
// In any Cayley-Dickson algebra, basis multiplication follows:
//     e_i · e_j = σ(i,j) · e_{i⊕j}
// where σ(i,j) ∈ {+1, -1} is the Cayley-Dickson sign function
// and ⊕ is bitwise XOR over Z_2^k.
//
// The associator decomposes as:
//     [e_i, e_j, e_k] = (α - β) · e_{i⊕j⊕k}
// where:
//     α = σ(i,j) · σ(i⊕j, k)       (left parenthesization sign)
//     β = σ(j,k) · σ(i, j⊕k)       (right parenthesization sign)
//
// Since α, β ∈ {+1, -1}, we have (α - β) ∈ {-2, 0, +2}.
// Therefore ||[e_i, e_j, e_k]|| ∈ {0, 2}.  □
//
// This proof does NOT depend on the dimension. It works for octonions,
// sedenions, trigintaduonions, and every Cayley-Dickson algebra.
//
// The Sounio implementation below:
//   1. Implements the Cayley-Dickson sign function σ(i,j) recursively
//   2. Verifies the theorem at multiple dimensions by computing α and β
//      for all basis triples and checking that α - β ∈ {-2, 0, +2}
//   3. Counts nonzero associators to verify T_k at each dimension
//
// This is a PROOF, not just a computation. The proof's validity follows
// from the algebraic structure of σ (it always returns ±1) and the
// associativity of XOR (guaranteed by Z_2^k). The verification at
// specific dimensions serves as a cross-check, not as the proof itself.

// ============================================================================
// THE CAYLEY-DICKSON SIGN FUNCTION σ(a, b)
//
// For basis elements e_a, e_b in the 2^k-dimensional CD algebra:
//     e_a · e_b = σ(a,b) · e_{a⊕b}
//
// σ is defined recursively via the Cayley-Dickson doubling:
//   If a, b < 2^(k-1): use the (k-1)-dimensional σ
//   If a < 2^(k-1), b >= 2^(k-1): σ = σ_upper rule
//   etc.
//
// Concretely, for the standard CD construction (a,b)(c,d) = (ac-d*b, da+bc*):
//   - The sign depends on the bit pattern of a and b
//   - It can be computed via a recursive formula
// ============================================================================

/// Cayley-Dickson sign function: e_a * e_b = sigma(a,b) * e_{a XOR b}
/// Returns +1 or -1.
/// Works for ANY dimension (any number of bits).
fn cd_sigma(a: i32, b: i32, bits: i32) -> i32 with Mut, Panic, Div {
    // Base case: dimension 2 (complex numbers)
    // e_0 = 1 (identity), e_1 = i
    // e_0 * e_0 = e_0 (+1), e_0 * e_1 = e_1 (+1)
    // e_1 * e_0 = e_1 (+1), e_1 * e_1 = -e_0 (-1)
    if a == 0 || b == 0 { return 1 }  // identity: e_0 * anything = itself
    if bits <= 1 {
        // a=1, b=1: e_1^2 = -1
        return -1
    }

    let half = 1 << (bits - 1)

    // Split into upper/lower halves
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)  // a mod half
    let b_lo = b & (half - 1)  // b mod half

    // Cayley-Dickson doubling: (a1, a2)(b1, b2) = (a1*b1 - conj(b2)*a2, b2*a1 + a2*conj(b1))
    // The sign depends on which "half" each element is in.
    //
    // Case analysis (a_hi, b_hi):
    //   (0,0): both in lower half → σ_{k-1}(a, b)
    //   (0,1): a lower, b upper → σ comes from "b2*a1" term → σ_{k-1}(b_lo, a_lo)
    //   (1,0): a upper, b lower → σ comes from "a2*conj(b1)" term
    //          conj(b_lo) flips sign for b_lo != 0
    //          → σ_{k-1}(a_lo, b_lo) * (if b_lo == 0 { 1 } else { -1 })
    //   (1,1): both upper → σ comes from "-conj(b2)*a2" term
    //          → -σ_{k-1}(b_lo, a_lo) * (if b_lo == 0 { 1 } else { -1 })
    //
    // This is the recursive structure. Let me implement it directly.

    if a_hi == 0 && b_hi == 0 {
        // Both in lower half: recurse
        return cd_sigma(a_lo, b_lo, bits - 1)
    }
    if a_hi == 0 && b_hi == 1 {
        // a lower, b upper: from "da" term (b2 * a1)
        return cd_sigma(b_lo, a_lo, bits - 1)
    }
    if a_hi == 1 && b_hi == 0 {
        // a upper, b lower: from "b*conj(c)" term (a2 * conj(b1))
        if b_lo == 0 {
            return cd_sigma(a_lo, b_lo, bits - 1)
        } else {
            return 0 - cd_sigma(a_lo, b_lo, bits - 1)
        }
    }
    // a_hi == 1 && b_hi == 1
    // Both upper: from "-conj(d)*b" term
    if b_lo == 0 {
        return 0 - cd_sigma(b_lo, a_lo, bits - 1)
    } else {
        return cd_sigma(b_lo, a_lo, bits - 1)
    }
}

// ============================================================================
// THE PROOF: verify α - β ∈ {-2, 0, +2} for all basis triples
// ============================================================================

/// Compute α = σ(i,j) · σ(i⊕j, k)  (left parenthesization)
fn alpha(i: i32, j: i32, k: i32, bits: i32) -> i32 with Mut, Panic, Div {
    cd_sigma(i, j, bits) * cd_sigma(i ^ j, k, bits)
}

/// Compute β = σ(j,k) · σ(i, j⊕k)  (right parenthesization)
fn beta(i: i32, j: i32, k: i32, bits: i32) -> i32 with Mut, Panic, Div {
    cd_sigma(j, k, bits) * cd_sigma(i, j ^ k, bits)
}

/// Verify the binary norm theorem at dimension 2^bits.
/// Returns (nonzero_count, total_checked, all_binary).
fn verify_at_dim(bits: i32) -> [i32; 3] with Mut, Panic, Div, IO {
    let n = (1 << bits) - 1  // number of imaginary basis elements
    var nonzero: i32 = 0
    var total: i32 = 0
    var all_binary = 1  // 1 = true

    var i: i32 = 1
    while i <= n {
        var j: i32 = 1
        while j <= n {
            var k: i32 = 1
            while k <= n {
                let a = alpha(i, j, k, bits)
                let b = beta(i, j, k, bits)
                let diff = a - b

                // THE PROOF: α, β ∈ {+1, -1} → diff ∈ {-2, 0, +2}
                // Verify this holds:
                if diff != 0 && diff != 2 && diff != -2 {
                    all_binary = 0
                    println("  VIOLATION at (")
                    println(i)
                    println(j)
                    println(k)
                    println("): diff = ")
                    println(diff)
                }

                total = total + 1
                if diff != 0 { nonzero = nonzero + 1 }

                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    var result: [i32; 3] = [0; 3]
    result[0] = nonzero
    result[1] = total
    result[2] = all_binary
    result
}

// ============================================================================
// MAIN — The Proof, Verified at Multiple Dimensions
// ============================================================================

fn main() -> i32 with Mut, Panic, Div, IO {
    println("================================================================")
    println("  BINARY NORM THEOREM — PROOF + VERIFICATION")
    println("  ||[e_i, e_j, e_k]|| in {0, 2} for ALL Cayley-Dickson algebras")
    println("================================================================")
    println("")
    println("  PROOF:")
    println("  1. e_i * e_j = sigma(i,j) * e_{i XOR j},  sigma in {+1,-1}")
    println("  2. alpha = sigma(i,j) * sigma(i^j, k)     [left paren]")
    println("  3. beta  = sigma(j,k) * sigma(i, j^k)     [right paren]")
    println("  4. alpha, beta in {+1,-1} (products of +/-1)")
    println("  5. [e_i,e_j,e_k] = (alpha - beta) * e_{i^j^k}")
    println("  6. alpha - beta in {-2, 0, +2}")
    println("  7. ||[e_i,e_j,e_k]|| in {0, 2}.  QED.")
    println("")
    println("  The proof is dimension-independent.")
    println("  Below: cross-check by exhaustive verification at dim 8, 16, 32.")
    println("")

    // Predicted T_k values from the formula
    // T_3 = 168, T_4 = 1848, T_5 = 15960

    // ---------------------------------------------------------------
    // DIM 8 (octonions, bits=3)
    // ---------------------------------------------------------------
    println("--- Dimension 8 (octonions, 7^3 = 343 triples) ---")
    let r3 = verify_at_dim(3)
    println("  Nonzero: ")
    println(r3[0])
    println("  Binary:  ")
    if r3[2] == 1 { println("YES") } else { println("NO") }
    if r3[0] == 168 && r3[2] == 1 {
        println("  PASS: T_3 = 168, binary holds.")
    } else {
        println("  FAIL")
        return 1
    }

    // ---------------------------------------------------------------
    // DIM 16 (sedenions, bits=4)
    // ---------------------------------------------------------------
    println("")
    println("--- Dimension 16 (sedenions, 15^3 = 3375 triples) ---")
    let r4 = verify_at_dim(4)
    println("  Nonzero: ")
    println(r4[0])
    println("  Binary:  ")
    if r4[2] == 1 { println("YES") } else { println("NO") }
    if r4[0] == 1848 && r4[2] == 1 {
        println("  PASS: T_4 = 1848, binary holds.")
    } else {
        println("  FAIL")
        return 1
    }

    // ---------------------------------------------------------------
    // DIM 32 (trigintaduonions, bits=5)
    // ---------------------------------------------------------------
    println("")
    println("--- Dimension 32 (trigintaduonions, 31^3 = 29791 triples) ---")
    let r5 = verify_at_dim(5)
    println("  Nonzero: ")
    println(r5[0])
    println("  Binary:  ")
    if r5[2] == 1 { println("YES") } else { println("NO") }
    if r5[0] == 15960 && r5[2] == 1 {
        println("  PASS: T_5 = 15960, binary holds.")
    } else {
        println("  FAIL")
        return 1
    }

    println("")
    println("================================================================")
    println("  ALL DIMENSIONS VERIFIED. BINARY NORM THEOREM HOLDS.")
    println("  The proof is algebraic (steps 1-7 above).")
    println("  The verification is computational (exhaustive at dim 8,16,32).")
    println("  Together: the theorem is proven for ALL k >= 3.")
    println("================================================================")

    0
}
