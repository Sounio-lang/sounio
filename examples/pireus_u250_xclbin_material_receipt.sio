//@ run-pass
//!
//! Sounio admission of recovered U250 xclbin material.

use hardware::pireus::u250_material_ingestion::{
    pireus_u250_material_ingest_files,
}
use hardware::pireus::u250_execution_engine::{
    pireus_u250_execution_engine_request,
    pireus_u250_execution_engine_project,
}
use hardware::pireus::u250_fpga_kernel_artifact::{
    pireus_u250_fpga_kernel_artifact_request,
    pireus_u250_fpga_kernel_artifact_project,
    pireus_u250_query_artifact_bits,
}
use hardware::pireus::u250_xclbin_material_receipt::{
    pireus_u250_xclbin_material_request,
    pireus_u250_xclbin_material_project,
    pireus_u250_xclbin_material_ingest_file,
    pireus_u250_xclbin_waiting_matches_expected,
    pireus_u250_xclbin_parity_matches_expected,
    pireus_u250_xclbin_material_store,
    pireus_u250_query_material_receipts,
    pireus_u250_query_material_bank_bindings,
}
use ontology::query::{triple_store_count, sparql_result_count}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 2 && arg_count() != 3 {
        print("usage: pireus_u250_xclbin_material_receipt <raw-card-probe> <card-receipt> [xclbin-probe]\n")
        return 2
    }
    let material = pireus_u250_material_ingest_files(get_arg(0), get_arg(1))
    let engine_request = pireus_u250_execution_engine_request()
    let engine = pireus_u250_execution_engine_project(
        &material, &engine_request)
    let artifact_request = pireus_u250_fpga_kernel_artifact_request()
    let artifact = pireus_u250_fpga_kernel_artifact_project(
        &engine, &artifact_request)
    let result = if arg_count() == 3 {
        pireus_u250_xclbin_material_ingest_file(&artifact, get_arg(2))
    } else {
        let request = pireus_u250_xclbin_material_request()
        pireus_u250_xclbin_material_project(&artifact, &request)
    }
    var store = pireus_u250_xclbin_material_store(
        &engine, &artifact, &result)
    let bits = pireus_u250_query_artifact_bits(&store)
    let receipts = pireus_u250_query_material_receipts(&store)
    let banks = pireus_u250_query_material_bank_bindings(&store)

    print("SOUNIO_SEMANTIC_AUTHORITY schema=pireus.u250-xclbin-material-receipt.v0 stage=")
    if result.artifact_parity_open { print("PARITY_OPEN\n") }
    else { print("SOUNIO_EXECUTABLE\n") }
    print("PIREUS_U250_XCLBIN_MATERIAL valid=")
    print_int(yes(result.valid))
    print(" status="); print_int(result.status)
    print(" observed="); print_int(yes(result.material_observed))
    print(" bits="); print_int(yes(result.bitstream_present))
    print(" digest="); print_int(yes(result.bitstream_digest_present))
    print(" metadata="); print_int(yes(result.metadata_present))
    print(" identity="); print_int(yes(result.identity_matches))
    print(" abi="); print_int(yes(result.abi_matches))
    print(" banks="); print_int(yes(result.material_bank_mapping_matches))
    print(" size_bytes="); print_int(result.artifact_size_bytes)
    print(" requested_mhz="); print_int(result.requested_frequency_mhz)
    print(" achieved_tenths_mhz=")
    print_int(result.achieved_frequency_tenths_mhz)
    print(" arguments="); print_int(result.abi_argument_count)
    print(" interfaces="); print_int(result.interface_binding_count)
    print(" bank_bindings="); print_int(result.material_bank_binding_count)
    print(" parity_open="); print_int(yes(result.artifact_parity_open))
    print(" execution_observed=")
    print_int(yes(result.kernel_execution_observed))
    print(" correctness_present=")
    print_int(yes(result.kernel_correctness_present))
    print(" lowering_authorized=")
    print_int(yes(result.lowering_authorized))
    print(" performance_present=")
    print_int(yes(result.performance_present))
    print(" claim_ready="); print_int(yes(result.claim_ready))
    print(" failures="); print_int(result.failures)
    print("\n")
    print("PIREUS_U250_XCLBIN_GRAPH triples=")
    print_int(triple_store_count(&store))
    print(" bits_edges="); print_int(sparql_result_count(&bits))
    print(" receipt_edges="); print_int(sparql_result_count(&receipts))
    print(" bank_edges="); print_int(sparql_result_count(&banks))
    print("\n")

    if arg_count() == 3 {
        if pireus_u250_xclbin_parity_matches_expected(&result) &&
            triple_store_count(&store) == 442 &&
            sparql_result_count(&bits) == 1 &&
            sparql_result_count(&receipts) == 1 &&
            sparql_result_count(&banks) == 5 { 0 } else { 1 }
    } else {
        if pireus_u250_xclbin_waiting_matches_expected(&result) &&
            triple_store_count(&store) == 420 &&
            sparql_result_count(&bits) == 0 &&
            sparql_result_count(&receipts) == 0 &&
            sparql_result_count(&banks) == 0 { 0 } else { 1 }
    }
}
