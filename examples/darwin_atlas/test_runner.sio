// =============================================================================
// Test Runner
// =============================================================================

pub fn run_all_tests() -> (usize, usize) {
    var passed: usize = 0
    var failed: usize = 0

    // Test operators
    if test_shift_identity() {
        passed = passed + 1
    } else {
        failed = failed + 1
    }

    if test_reverse_involution() {
        passed = passed + 1
    } else {
        failed = failed + 1
    }

    // Test quaternion
    if test_quaternion_double_cover() {
        passed = passed + 1
    } else {
        failed = failed + 1
    }

    // Test symmetry
    if test_orbit_properties() {
        passed = passed + 1
    } else {
        failed = failed + 1
    }

    // Test metric
    if test_metric_triangle() {
        passed = passed + 1
    } else {
        failed = failed + 1
    }

    (passed, failed)
}

fn main() {
    let results = run_all_tests()
    let passed = results.0
    let failed = results.1

    // Results would be printed via IO effect when available
    // For now, return success if all tests pass
    if failed == 0 {
        // All tests passed
    }
}
