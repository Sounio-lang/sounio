module main

use pbpk::rapamycin_pop_timing::{
    pt_e_ncrit_uniform, pt_e_ncrit_load, pt_e_ncrit_advance,
    pt_e_nlast_uniform, pt_e_nlast_load, pt_e_nlast_loss,
    pt_e_span_uniform, pt_e_span_load, pt_e_span_delta,
    pt_ind_ncrit_contrib, pt_ind_ncrit_frac,
    pt_cert_n7_uniform, pt_cert_n7_load, pt_cert_n7_gain,
    pt_ncrit_spread_uniform, pt_ncrit_spread_load,
    pt_std_span_contrib, pt_slow_span_contrib, pt_fast_span_contrib,
    pt_inh_span_contrib, pt_ind_span_contrib
}

fn main() with Mut, Div, Panic, IO {
    print("=== Population-weighted expected timing ===\n")
    print("E[n_crit_uniform]: "); print_f64(pt_e_ncrit_uniform()); print("\n")
    print("E[n_crit_load]:    "); print_f64(pt_e_ncrit_load());    print("\n")
    print("E[n_crit_advance]: "); print_f64(pt_e_ncrit_advance()); print("\n")
    print("\n")
    print("E[n_last_uniform]: "); print_f64(pt_e_nlast_uniform()); print("\n")
    print("E[n_last_load]:    "); print_f64(pt_e_nlast_load());    print("\n")
    print("E[n_last_loss]:    "); print_f64(pt_e_nlast_loss());    print("\n")
    print("\n")
    print("E[span_uniform]:   "); print_f64(pt_e_span_uniform()); print("\n")
    print("E[span_load]:      "); print_f64(pt_e_span_load());    print("\n")
    print("E[span_delta]:     "); print_f64(pt_e_span_delta());   print("\n")
    print("\n")
    print("=== ind contribution to E[n_crit] ===\n")
    print("ind contrib (abs): "); print_f64(pt_ind_ncrit_contrib()); print("\n")
    print("ind contrib (frac):"); print_f64(pt_ind_ncrit_frac());    print("\n")
    print("\n")
    print("=== Pop cert N=7 ===\n")
    print("uniform: "); print_f64(pt_cert_n7_uniform()); print("\n")
    print("loading: "); print_f64(pt_cert_n7_load());    print("\n")
    print("gain:    "); print_f64(pt_cert_n7_gain());    print("\n")
    print("\n")
    print("=== ncrit spread ===\n")
    print("uniform: "); print_f64(pt_ncrit_spread_uniform()); print("\n")
    print("loading: "); print_f64(pt_ncrit_spread_load());    print("\n")
    print("\n")
    print("=== E[span] contributions per stratum ===\n")
    print("std:  "); print_f64(pt_std_span_contrib());  print("\n")
    print("slow: "); print_f64(pt_slow_span_contrib()); print("\n")
    print("fast: "); print_f64(pt_fast_span_contrib()); print("\n")
    print("inh:  "); print_f64(pt_inh_span_contrib());  print("\n")
    print("ind:  "); print_f64(pt_ind_span_contrib());  print("\n")
}
