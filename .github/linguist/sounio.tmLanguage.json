{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sounio",
  "scopeName": "source.sounio",
  "fileTypes": ["sio"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#effects" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#function-def" },
    { "include": "#struct-def" },
    { "include": "#enum-def" },
    { "include": "#module-def" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sounio",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sounio",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sounio",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sounio",
              "match": "\\\\(?:[nrt\\\\\"0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "comment": "Floating-point with optional f32/f64 suffix",
          "name": "constant.numeric.float.sounio",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9_]+)?(?:f32|f64)?\\b"
        },
        {
          "comment": "Hex integer",
          "name": "constant.numeric.hex.sounio",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*(?:u8|u16|u32|u64|i8|i16|i32|i64|usize)?\\b"
        },
        {
          "comment": "Binary integer",
          "name": "constant.numeric.binary.sounio",
          "match": "\\b0b[01][01_]*(?:u8|u16|u32|u64|i8|i16|i32|i64|usize)?\\b"
        },
        {
          "comment": "Octal integer",
          "name": "constant.numeric.octal.sounio",
          "match": "\\b0o[0-7][0-7_]*(?:u8|u16|u32|u64|i8|i16|i32|i64|usize)?\\b"
        },
        {
          "comment": "Decimal integer with optional type suffix",
          "name": "constant.numeric.integer.sounio",
          "match": "\\b[0-9][0-9_]*(?:u8|u16|u32|u64|i8|i16|i32|i64|usize|f32|f64)?\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "comment": "Control flow keywords",
          "name": "keyword.control.sounio",
          "match": "\\b(?:if|else|while|for|in|match|return|break|continue|loop)\\b"
        },
        {
          "comment": "Declaration keywords",
          "name": "keyword.declaration.sounio",
          "match": "\\b(?:fn|let|var|struct|enum|impl|type|module|use|pub|extern|unit|linear|with)\\b"
        },
        {
          "comment": "Other keywords",
          "name": "keyword.other.sounio",
          "match": "\\b(?:as|assert|self|Self)\\b"
        }
      ]
    },

    "effects": {
      "patterns": [
        {
          "comment": "Effect annotations",
          "name": "support.type.effect.sounio",
          "match": "\\b(?:IO|Mut|Div|Panic|Alloc|Async|GPU|Prob)\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "comment": "Primitive types",
          "name": "storage.type.primitive.sounio",
          "match": "\\b(?:i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|usize|isize)\\b"
        },
        {
          "comment": "Standard library types",
          "name": "storage.type.stdlib.sounio",
          "match": "\\b(?:Vec|IntVec|FloatVec|IntOption|FloatOption|IntResult|FloatResult|Knowledge|Box|Rc|Arc|String)\\b"
        },
        {
          "comment": "User-defined type (uppercase start)",
          "name": "entity.name.type.sounio",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "comment": "Mutable reference operator &!",
          "name": "keyword.operator.borrow-mut.sounio",
          "match": "&!"
        },
        {
          "comment": "Arrow operators",
          "name": "keyword.operator.arrow.sounio",
          "match": "->|=>"
        },
        {
          "comment": "Path separator",
          "name": "keyword.operator.path.sounio",
          "match": "::"
        },
        {
          "comment": "Concatenation operator",
          "name": "keyword.operator.concat.sounio",
          "match": "\\+\\+"
        },
        {
          "comment": "Range operators",
          "name": "keyword.operator.range.sounio",
          "match": "\\.\\.\\.|\\.\\."
        },
        {
          "comment": "Comparison operators",
          "name": "keyword.operator.comparison.sounio",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "comment": "Logical operators",
          "name": "keyword.operator.logical.sounio",
          "match": "&&|\\|\\||!"
        },
        {
          "comment": "Assignment",
          "name": "keyword.operator.assignment.sounio",
          "match": "="
        },
        {
          "comment": "Arithmetic operators",
          "name": "keyword.operator.arithmetic.sounio",
          "match": "[+\\-*/%]"
        },
        {
          "comment": "Bitwise operators",
          "name": "keyword.operator.bitwise.sounio",
          "match": "&|\\||\\^|<<|>>"
        },
        {
          "comment": "Reference operator",
          "name": "keyword.operator.borrow.sounio",
          "match": "&"
        }
      ]
    },

    "function-def": {
      "patterns": [
        {
          "comment": "Function definition",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.declaration.function.sounio" },
            "2": { "name": "entity.name.function.sounio" }
          }
        }
      ]
    },

    "struct-def": {
      "patterns": [
        {
          "comment": "Struct definition (including linear)",
          "match": "\\b(?:(linear)\\s+)?(struct)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.linear.sounio" },
            "2": { "name": "keyword.declaration.struct.sounio" },
            "3": { "name": "entity.name.type.struct.sounio" }
          }
        }
      ]
    },

    "enum-def": {
      "patterns": [
        {
          "comment": "Enum definition",
          "match": "\\b(enum)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.enum.sounio" },
            "2": { "name": "entity.name.type.enum.sounio" }
          }
        }
      ]
    },

    "module-def": {
      "patterns": [
        {
          "comment": "Module definition",
          "match": "\\b(module)\\s+([a-zA-Z_][a-zA-Z0-9_:]*)",
          "captures": {
            "1": { "name": "keyword.declaration.module.sounio" },
            "2": { "name": "entity.name.namespace.sounio" }
          }
        },
        {
          "comment": "Use/import declaration",
          "match": "\\b(use)\\s+([a-zA-Z_][a-zA-Z0-9_:]*)",
          "captures": {
            "1": { "name": "keyword.declaration.use.sounio" },
            "2": { "name": "entity.name.namespace.sounio" }
          }
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "comment": "Boolean constants",
          "name": "constant.language.boolean.sounio",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    }
  }
}
