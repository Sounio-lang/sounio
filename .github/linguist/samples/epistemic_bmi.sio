//@ run-pass
// Epistemic BMI example with first-order uncertainty propagation.

struct KnowledgeF64 {
    value: f64,
    uncertainty: f64
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 {
        return -x
    }
    return x
}

fn bmi(weight_kg: f64, height_m: f64) -> f64 {
    return weight_kg / (height_m * height_m)
}

fn propagate_bmi(weight: KnowledgeF64, height: KnowledgeF64) -> KnowledgeF64 {
    let nominal = bmi(weight.value, height.value)

    // First-order sensitivities:
    // dBMI/dw = 1 / h^2
    // dBMI/dh = -2w / h^3
    let d_dw = 1.0 / (height.value * height.value)
    let d_dh = -2.0 * weight.value / (height.value * height.value * height.value)

    // Conservative linear uncertainty bound.
    let propagated = abs_f64(d_dw) * weight.uncertainty + abs_f64(d_dh) * height.uncertainty

    return KnowledgeF64 {
        value: nominal,
        uncertainty: propagated
    }
}

fn main() with IO {
    let weight = KnowledgeF64 {
        value: 72.0,
        uncertainty: 0.6
    }

    let height = KnowledgeF64 {
        value: 1.78,
        uncertainty: 0.01
    }

    let result = propagate_bmi(weight, height)

    println("example: epistemic_bmi")
    println("BMI value")
    println(result.value)
    println("BMI uncertainty (first-order bound)")
    println(result.uncertainty)
}
