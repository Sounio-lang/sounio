# Sounio is the primary language — teach Linguist about .sio files
*.sio linguist-language=Sounio
*.sio linguist-detectable

# Lean mathlib dependencies are vendored
formal/lake/packages/** linguist-vendored

# Generated artifacts
artifacts/** linguist-generated

# Scripts are infrastructure
scripts/** linguist-vendored

# Preserve the official UCI D9 fixture bytes and CRLF record delimiters.
tests/fixtures/psychiatric_d9/uci_drug_consumption_373.data binary

# Generated docs/governance artifacts: regenerate on merge instead of a textual
# 3-way merge (they derive from the doc set and conflict on nearly every merge
# from an active main). Activate the driver once per clone with:
#   bash scripts/dev/install-git-merge-drivers.sh
docs/governance/DOCS_ACCEPTANCE_REPORT.md merge=governance-regen
docs/governance/DOCS_AUTHORITY_MATRIX.md  merge=governance-regen
docs/governance/topic-registry.v1.json    merge=governance-regen
