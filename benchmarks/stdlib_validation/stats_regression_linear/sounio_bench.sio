//@ run-pass
// Benchmark: stats::regression::linear OLS epistemic vs SciPy linregress
// Dados fixos n=20, y ≈ 2 + 3x + noise pequena
// Output JSON: {"intercept", "slope", "r_squared"}
pub use stats::regression::linear::*;
pub use stats::shared::*; // assumido

fn main() -> i32 with IO {
    let n: i64 = 20;
    var x: [f64; 100] = [0.0; 100];
    var y: [f64; 100] = [0.0; 100];
    var i: i64 = 0;
    while i < n {
        x[i as usize] = i as f64;
        y[i as usize] = 2.0 + 3.0 * (i as f64) + 0.05 * ((i % 2) as f64 - 0.5);
        i = i + 1;
    }
    let model = fit_linear_regression_epistemic(x, y, n);
    print("{\\"intercept\\": ");
    print(model.value.coefficients[0]);
    print(", \\"slope\\": ");
    print(model.value.coefficients[1]);
    print(", \\"r_squared\\": ");
    print(model.value.r_squared);
    print("}");
    0
}
