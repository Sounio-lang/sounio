//@ run-pass
// Benchmark: epistemic_matrix matmul GUM propagation
pub use linalg::epistemic_matrix::*;

fn main() -> i32 with IO {
    // 2x2 matrices with unc = 1e-6, conf=0.95
    var a = ematrix_zeros(2, 2);
    ematrix_set(&a, 0, 0, 1.0, 1e-6, 0.95);
    ematrix_set(&a, 0, 1, 0.5, 1e-6, 0.95);
    ematrix_set(&a, 1, 0, 0.5, 1e-6, 0.95);
    ematrix_set(&a, 1, 1, 2.0, 1e-6, 0.95);
    var b = ematrix_zeros(2, 2);
    ematrix_set(&b, 0, 0, 3.0, 1e-6, 0.95);
    ematrix_set(&b, 0, 1, 1.0, 1e-6, 0.95);
    ematrix_set(&b, 1, 0, 1.0, 1e-6, 0.95);
    ematrix_set(&b, 1, 1, 4.0, 1e-6, 0.95);
    let c = ematrix_mul(&a, &b);
    print("{{\\"c00_val\\": ");
    print(ematrix_get_val(&c, 0, 0));
    print(", \\"c00_unc\\": ");
    print(ematrix_get_unc(&c, 0, 0));
    print(", \\"c00_conf\\": ");
    print(ematrix_get_conf(&c, 0, 0));
    print("}}"); // exemplo c00
    0
}
