//@ run-pass
// Benchmark: gum.sio NIST Supp1 Ex4-like R = V/I propagation
pub use epistemic::gum::*;

fn main() -> i32 with IO {
    // V = 10.00 +/- 0.02 rectangular (half=0.02)
    let u_v = type_b_uniform(0.02);
    let v_res = gum_simple(10.0, u_v.std_uncertainty);
    // I = 1.005 +/- 0.003 rectangular
    let u_i = type_b_uniform(0.003);
    let i_res = gum_simple(1.005, u_i.std_uncertainty);
    // R = V / I
    let r_res = gum_div(v_res, i_res);
    print("{{\\"r_value\\": ");
    print(r_res.value);
    print(", \\"r_std_unc\\": ");
    print(r_res.std_uncertainty);
    print(", \\"r_exp_unc95\\": ");
    print(r_res.expanded_uncertainty_95);
    print("}}");
    0
}
