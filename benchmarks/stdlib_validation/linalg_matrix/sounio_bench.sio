//@ run-pass
// Benchmark: linalg matrix matmul Mat4 + SVD vs NumPy
// Test matrix 4x4 from benchmarks/comparison
pub use linalg::decomp::*;
pub use linalg::matrix::*;

fn main() -> i32 with IO {
    let a_data: [f64; 16] = [4.0, 1.0, 2.0, 1.0, 1.0, 3.0, 1.0, 2.0, 2.0, 1.0, 5.0, 1.0, 1.0, 2.0, 1.0, 4.0];
    let a = Matrix8 { data: a_data, rows: 4, cols: 4 };
    let aa = mat8_multiply(a, a);
    let svd = svd_decompose(a);
    print("{{\\"matmul_00\\": ");
    print(mat8_get(aa, 0, 0));
    print(", \\"matmul_11\\": ");
    print(mat8_get(aa, 1, 1));
    print(", \\"matmul_22\\": ");
    print(mat8_get(aa, 2, 2));
    print(", \\"matmul_33\\": ");
    print(mat8_get(aa, 3, 3));
    print(", \\"svd_sigma0\\": ");
    print(svd.sigma[0]);
    print(", \\"svd_sigma1\\": ");
    print(svd.sigma[1]);
    print(", \\"svd_sigma2\\": ");
    print(svd.sigma[2]);
    print(", \\"svd_sigma3\\": ");
    print(svd.sigma[3]);
    print("}}");
    0
}
