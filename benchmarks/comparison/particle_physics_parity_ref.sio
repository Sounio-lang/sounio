//@ run-pass
// particle_physics_parity_ref.sio
//
// Sounio reference for parity gate against Python.
// Prints PARITY|gate=...|sio=... lines for each validated quantity.
//
// Sounio println(f64) does NOT emit a trailing newline;
// println(&str) DOES. We use print(&str) + println(f64) + println("")
// to produce one complete line per record.

use particle_physics::amplitude::*;
use particle_physics::rge::*;
use particle_physics::sm_params::*;

fn main() -> i32 with Mut, Div, Panic {
    let gev2_to_pb = 0.389379e9

    // Gate 1: σ(e+e- -> mu+mu-) at 10 GeV in pb
    let s10 = 100.0
    let sigma_pb = eemm_qed_total_cross_section(s10) * gev2_to_pb
    print("PARITY|gate=eemm_10GeV_pb|sio=")
    println(sigma_pb)
    println("")

    // Gate 2: Γ(Z -> e+e-)
    let g_ee = z_decay_width_ee()
    print("PARITY|gate=z_width_ee|sio=")
    println(g_ee)
    println("")

    // Gate 3: Γ(Z -> mu+mu-)
    let g_mumu = z_decay_width_mumu()
    print("PARITY|gate=z_width_mumu|sio=")
    println(g_mumu)
    println("")

    // Gate 4: Γ(Z -> hadrons)
    let g_had = z_decay_width_hadrons()
    print("PARITY|gate=z_width_had|sio=")
    println(g_had)
    println("")

    // Gate 5: Γ(Z total)
    let g_tot = z_total_width()
    print("PARITY|gate=z_width_total|sio=")
    println(g_tot)
    println("")

    // Gate 6: α_s at 10 GeV
    let alpha_mz = alpha_s_mz().val()
    let mz = mass_z().val()
    let alpha_10_ep = alpha_s_running(10.0, alpha_mz, mz)
    let alpha_10 = alpha_10_ep.val()
    print("PARITY|gate=alpha_s_10GeV|sio=")
    println(alpha_10)
    println("")

    // Gate 7: R-ratio at 10 GeV
    let r10 = r_ratio(s10)
    print("PARITY|gate=r_ratio_10GeV|sio=")
    println(r10)
    println("")

    println("PARTICLE_PHYSICS_PARITY_DONE")
    return 0
}
