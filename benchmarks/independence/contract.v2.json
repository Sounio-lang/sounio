{
  "schema": "sounio.independence.contract.v2",
  "release_target": "no-rust-build-run-linux-macos",
  "sprint_window": {
    "name": "omega-sprint-1",
    "start": "2026-02-23",
    "end": "2026-05-24",
    "hard_rollover": true
  },
  "target_platforms": [
    "linux-cuda",
    "macos-metal"
  ],
  "baseline_adapters": [
    {
      "name": "cuda-cutlass",
      "kind": "cuda-cpp",
      "entrypoint": "benchmarks/independence/adapters/cuda_cutlass.sh"
    },
    {
      "name": "triton",
      "kind": "triton",
      "entrypoint": "benchmarks/independence/adapters/triton.sh"
    },
    {
      "name": "pytorch-inductor",
      "kind": "inductor",
      "entrypoint": "benchmarks/independence/adapters/inductor.sh"
    }
  ],
  "baseline_substitution_policy": {
    "allow_substitute_if_unavailable": true,
    "require_justification": true
  },
  "kernel_sets": {
    "l2_official": [
      "gemm",
      "attention",
      "epistemic_elementwise",
      "monte_carlo"
    ],
    "microbench": [
      "gemm",
      "conv2d",
      "attention",
      "qnn-hypercomplex-gemm",
      "octonion-matmul"
    ],
    "end_to_end": [
      "benchmarks/cl44_vs_octonion.sio",
      "benchmarks/pbpk/causal_intervention.sio",
      "benchmarks/fmri/causal_connectivity.sio"
    ],
    "quantum_parallel": [
      "vqe",
      "qaoa"
    ]
  },
  "numeric_tolerance": {
    "f16": {
      "rtol": 0.01,
      "atol": 0.001
    },
    "f32": {
      "rtol": 0.0001,
      "atol": 1e-06
    },
    "f64": {
      "rtol": 1e-09,
      "atol": 1e-12
    },
    "hypercomplex": {
      "rtol": 0.0005,
      "atol": 1e-07
    }
  },
  "performance_gate": {
    "metric": "geomean_speedup",
    "threshold": 1.2,
    "aggregation": "median",
    "minimum_samples": 50,
    "no_regression_floor": 0.95,
    "target_plus20": true
  },
  "compile_time_budget": {
    "max_overhead": 0.25
  },
  "epistemic_power_accumulator_bound": {
    "delta_32_formula": "4*(F%8)+2*(P%16)+(Q%32)",
    "delta_32_max_exclusive": 96,
    "max_gap_numerator": 89,
    "max_gap_denominator": 32,
    "max_gap_lt": 3,
    "formal_proof": {
      "lean_module": "formal/omega_mathlib/OmegaMathlib/AccumulatorBounds.lean",
      "theorem": "OmegaMathlib.accumulator_bound"
    }
  },
  "bit_exact": {
    "required": true,
    "samples": 50,
    "aggregation": "median"
  },
  "runtime_normalization_by_family": {
    "dense_linear": { "floor_speedup": 0.95, "cap_speedup": 3.0 },
    "attention": { "floor_speedup": 0.95, "cap_speedup": 3.0 },
    "epistemic_elementwise": { "floor_speedup": 0.95, "cap_speedup": 2.5 },
    "monte_carlo": { "floor_speedup": 0.95, "cap_speedup": 2.5 },
    "quantum_parallel": { "floor_speedup": 0.95, "cap_speedup": 2.0 }
  },
  "quantum_conformance": {
    "ks_pvalue_min": 0.05,
    "coverage_target": 0.95,
    "coverage_range": [0.90, 0.98],
    "min_shots": 50
  }
}
