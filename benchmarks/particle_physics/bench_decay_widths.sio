//@ run-pass
// bench_decay_widths: Z and Higgs decay width benchmark.
// Validates total widths against PDG reference values.

use particle_physics::amplitude::*;
use particle_physics::sm_params::*;
use particle_physics::decay::*;

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn check_near_rel(a: f64, b: f64, rtol: f64) -> bool {
    if b == 0.0 { return abs_f64(a) < rtol }
    abs_f64(a - b) / abs_f64(b) < rtol
}

fn main() -> i32 with Mut, Div, Panic {
    var fail = 0

    // ------------------------------------------------------------------
    // Z boson partial widths
    // ------------------------------------------------------------------
    let g_ee = z_decay_width_ee()
    let g_mumu = z_decay_width_mumu()
    let g_had = z_decay_width_hadrons()
    let g_tot = z_total_width()

    // lepton universality: Γ_ee ≈ Γ_μμ
    if !check_near_rel(g_ee, g_mumu, 0.01) {
        println("FAIL: Z lepton universality")
        fail = fail + 1
    }

    // PDG: Γ_Z(total) ≈ 2.495 GeV (tree-level within ~15%)
    if !check_near_rel(g_tot, 2.495, 0.15) {
        println("FAIL: Z total width")
        fail = fail + 1
    }

    // Sum of known partials should not exceed total
    let g_sum = g_ee + g_mumu + g_had
    if g_sum > g_tot * 1.2 {
        println("FAIL: partial widths exceed total")
        fail = fail + 1
    }

    // Branching ratios
    let br_ee = branching_ratio(g_ee, g_tot)
    let br_had = branching_ratio(g_had, g_tot)
    if br_ee < 0.03 || br_ee > 0.04 {
        println("FAIL: BR(Z->ee)")
        fail = fail + 1
    }
    if br_had < 0.65 || br_had > 0.75 {
        println("FAIL: BR(Z->had)")
        fail = fail + 1
    }

    // ------------------------------------------------------------------
    // Higgs boson partial widths
    // ------------------------------------------------------------------
    let mh = mass_h().val()
    let gamma_h_bb = h_decay_width_ff(mh, mass_bottom().val(), 3.0)
    let gamma_h_tautau = h_decay_width_ff(mh, mass_tau().val(), 1.0)
    let gamma_h_gg = h_decay_width_gg(mh)
    let gamma_h_gamgam = h_decay_width_gammagamma(mh)
    let gamma_h_tot = h_total_width()

    // b-bbar dominates
    if gamma_h_bb <= gamma_h_tautau {
        println("FAIL: H->bb not dominant")
        fail = fail + 1
    }

    // Total width ≈ 4.1 MeV (tree-level within factor 2)
    if !check_near_rel(gamma_h_tot, 0.0041, 1.0) {
        println("FAIL: H total width")
        fail = fail + 1
    }

    // Sum of explicit channels <= total (within reason)
    let gamma_h_sum = gamma_h_bb + gamma_h_tautau + gamma_h_gg + gamma_h_gamgam
    if gamma_h_sum > gamma_h_tot * 2.0 {
        println("FAIL: Higgs partial sum exceeds total")
        fail = fail + 1
    }

    if fail == 0 {
        println("BENCH|name=decay_widths|status=PASS")
    } else {
        println("BENCH|name=decay_widths|status=FAIL")
    }
    return fail
}
