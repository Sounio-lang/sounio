//@ run-pass
// bench_cross_section: Tree-level e+e- -> mu+mu- cross-section benchmark.
// Validates 1/s scaling and parity-relevant energy points.

use particle_physics::amplitude::*;
use particle_physics::cross_section::*;
use particle_physics::sm_params::*;

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn check_near_rel(a: f64, b: f64, rtol: f64) -> bool {
    if b == 0.0 { return abs_f64(a) < rtol }
    abs_f64(a - b) / abs_f64(b) < rtol
}

fn main() -> i32 with Mut, Div, Panic {
    var fail = 0
    let alpha = alpha_em().val()
    let pi = 3.141592653589793

    // ------------------------------------------------------------------
    // Benchmark: σ(e+e- -> mu+mu-) at reference energies
    // ------------------------------------------------------------------
    let energies: [f64; 5] = [10.0, 50.0, 91.2, 200.0, 500.0]
    var i: i64 = 0
    while i < 5 {
        let s = energies[i] * energies[i]
        let sigma = eemm_qed_total_cross_section(s)
        let sigma_pb = eemm_qed_total_cross_section_pb(s)
        let expected = 4.0 * pi * alpha * alpha / (3.0 * s)
        let expected_pb = expected * 0.389379e9

        if !check_near_rel(sigma, expected, 1e-6) {
            println("FAIL: QED cross-section consistency")
            fail = fail + 1
        }

        // Reference: ~870 pb at 10 GeV
        if energies[i] == 10.0 {
            if !check_near_rel(sigma_pb, 870.0, 0.1) {
                println("FAIL: sigma_pb at 10 GeV")
                fail = fail + 1
            } else {
                println("BENCH|gate=eemm_10GeV_pb|value=")
                // Note: cannot format numbers in println, just emit marker
            }
        }

        // 1/s scaling: sigma(2E) / sigma(E) ≈ 1/4
        if i > 0 {
            let s_prev = energies[i - 1] * energies[i - 1]
            let sigma_prev = eemm_qed_total_cross_section(s_prev)
            let ratio = sigma / sigma_prev
            let expected_ratio = s_prev / s
            if !check_near_rel(ratio, expected_ratio, 1e-6) {
                println("FAIL: 1/s scaling")
                fail = fail + 1
            }
        }

        i = i + 1
    }

    // ------------------------------------------------------------------
    // Benchmark: R-ratio energies
    // ------------------------------------------------------------------
    let r10 = r_ratio(100.0)
    if !check_near_rel(r10, 11.0 / 3.0, 1e-6) {
        println("FAIL: R-ratio at 10 GeV")
        fail = fail + 1
    }

    if fail == 0 {
        println("BENCH|name=cross_section|status=PASS")
    } else {
        println("BENCH|name=cross_section|status=FAIL")
    }
    return fail
}
