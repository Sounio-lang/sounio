//@ run-pass
// bench_rge_running: QCD coupling running benchmark.
// Validates monotonicity and flavor-threshold behavior.

use particle_physics::rge::*;
use particle_physics::sm_params::*;

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn check_near_rel(a: f64, b: f64, rtol: f64) -> bool {
    if b == 0.0 { return abs_f64(a) < rtol }
    abs_f64(a - b) / abs_f64(b) < rtol
}

fn main() -> i32 with Mut, Div, Panic {
    var fail = 0
    let alpha_mz = alpha_s_mz().val()
    let mz = mass_z().val()

    // ------------------------------------------------------------------
    // Monotonicity: α_s increases as μ decreases
    // ------------------------------------------------------------------
    let scales: [f64; 6] = [200.0, 91.19, 50.0, 10.0, 5.0, 2.0]
    var prev_alpha: f64 = 0.0
    var i: i64 = 0
    while i < 6 {
        let mu = scales[i]
        let alpha_ep = alpha_s_running(mu, alpha_mz, mz)
        let alpha = alpha_ep.val()

        if i > 0 && alpha <= prev_alpha {
            println("FAIL: alpha_s not monotonically increasing")
            fail = fail + 1
        }
        prev_alpha = alpha
        i = i + 1
    }

    // ------------------------------------------------------------------
    // Reference: α_s(10 GeV) ≈ 0.179 (within 5%)
    // ------------------------------------------------------------------
    let alpha_10_ep = alpha_s_running(10.0, alpha_mz, mz)
    let alpha_10 = alpha_10_ep.val()
    if !check_near_rel(alpha_10, 0.179, 0.05) {
        println("FAIL: alpha_s at 10 GeV")
        fail = fail + 1
    }

    // ------------------------------------------------------------------
    // Flavor thresholds
    // ------------------------------------------------------------------
    let nf_200 = active_flavors(200.0)
    let nf_10 = active_flavors(10.0)
    let nf_2 = active_flavors(2.0)

    // u,d,s = 3 base; +c above m_c, +b above m_b, +t above m_t
    if nf_200 != 6 {
        println("FAIL: active flavors at 200 GeV")
        fail = fail + 1
    }
    if nf_10 != 5 {
        println("FAIL: active flavors at 10 GeV")
        fail = fail + 1
    }
    if nf_2 != 4 {
        println("FAIL: active flavors at 2 GeV")
        fail = fail + 1
    }

    // ------------------------------------------------------------------
    // QED running: α_EM should decrease as μ decreases
    // ------------------------------------------------------------------
    let alpha_em_mz = alpha_em().val()
    let alpha_em_10_ep = alpha_em_running(10.0, alpha_em_mz, mz)
    let alpha_em_10 = alpha_em_10_ep.val()
    let alpha_em_200_ep = alpha_em_running(200.0, alpha_em_mz, mz)
    let alpha_em_200 = alpha_em_200_ep.val()

    if alpha_em_10 <= alpha_em_200 {
        println("FAIL: alpha_EM running direction")
        fail = fail + 1
    }

    if fail == 0 {
        println("BENCH|name=rge_running|status=PASS")
    } else {
        println("BENCH|name=rge_running|status=FAIL")
    }
    return fail
}
