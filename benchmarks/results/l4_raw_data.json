  "workload": {
    "name": "epistemic_gemm",
    "description": "Matrix multiply with 4 epistemic shadow registers per Knowledge<f32> value: value (f32), epsilon (f32), validity predicate (u32), provenance (u32). GUM-compliant uncertainty propagation in the instruction stream.",
    "shadow_registers_per_element": 4,
    "gum_propagation_rules": {
      "add_sub": "epsilon_c = sqrt(epsilon_a^2 + epsilon_b^2)",
      "mul": "epsilon_c = |a| * epsilon_b + |b| * epsilon_a",
      "div": "near-zero guard with validity predicate kill",
      "fma": "combined quadrature"
    },
    "grid_formula": "(M/64, N/64, 1)",
    "block_size": "(16, 16, 1)",
    "timing_method": "CUDA event elapsed time",
    "gflops_formula": "2 * M * N * K / (ms * 1e-3) / 1e9",
    "dispatch_script": "scripts/cuda_gemm_dispatch.py"
  },
