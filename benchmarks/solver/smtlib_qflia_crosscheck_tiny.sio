//@ run-pass
//@ description: Tiny Sounio QF_LIA fixture emitter matching external SMT-LIB smoke instances

use theorem::smt::*

fn lcg_next(state: &!i64) -> i64 with Mut, Div {
    let a: i64 = 1103515245
    let c: i64 = 12345
    let m: i64 = 2147483648
    var next = (*state * a + c) % m
    if next < 0 { next = next + m }
    *state = next
    return next
}

fn result_code_to_expected(result: i32) -> i32 {
    if result == 1 { return 1 as i32 } // SAT
    if result == 0 { return 0 as i32 } // UNSAT
    return (0 - 1) as i32
}

fn print_csv_i64(v: i64, last: i32) with IO {
    print_int(v)
    if last == 0 { print(",") } else { print("\n") }
}

fn emit_row(instance_id: i32, seed: i64, expected_code: i32, result: i32) with IO {
    print_csv_i64(instance_id as i64, 0)
    print_csv_i64(seed, 0)
    print_csv_i64(expected_code as i64, 0)
    print_csv_i64(result as i64, 0)
    print_csv_i64(result_code_to_expected(result) as i64, 0)
    if result_code_to_expected(result) == expected_code {
        print_csv_i64(1, 1)
    } else {
        print_csv_i64(0, 1)
    }
}

fn solve_box_sat() -> i32 with Mut, Div {
    var ctx = smt_new()
    var c0: [i64; 16] = [0; 16]
    c0[0] = 0 - 1 // x >= 0
    smt_add_lia(&! ctx, &c0, 0)
    var c1: [i64; 16] = [0; 16]
    c1[0] = 1 // x <= 5
    smt_add_lia(&! ctx, &c1, 5)
    var c2: [i64; 16] = [0; 16]
    c2[1] = 1
    c2[0] = 0 - 1 // y - x <= 1
    smt_add_lia(&! ctx, &c2, 1)
    var c3: [i64; 16] = [0; 16]
    c3[0] = 1
    c3[1] = 0 - 1 // x - y <= -1
    smt_add_lia(&! ctx, &c3, 0 - 1)
    return smt_solve(&! ctx) as i32
}

fn solve_bound_pair(lo: i64, hi: i64) -> i32 with Mut, Div {
    var ctx = smt_new()
    var lower: [i64; 16] = [0; 16]
    lower[0] = 0 - 1 // x >= lo
    smt_add_lia(&! ctx, &lower, 0 - lo)
    var upper: [i64; 16] = [0; 16]
    upper[0] = 1 // x <= hi
    smt_add_lia(&! ctx, &upper, hi)
    return smt_solve(&! ctx) as i32
}

fn main() -> i32 with IO, Mut, Div {
    println("# schema=sounio.solver.smtlib_qflia_crosscheck_tiny.v1")
    println("# expected_code: 1=SAT, 0=UNSAT")
    println("# result_code: 1=SAT, 0=UNSAT, -1=LIA_ERROR, -2=BUDGET_EXCEEDED")
    println("instance_id,seed,expected_code,result_code,sounio_result_code,matches_expected")

    emit_row(1, 0, 1, solve_box_sat())
    emit_row(2, 0, 0, solve_bound_pair(3, 2))

    var state: i64 = 9000
    var idx: i32 = 0
    while idx < 4 {
        state = lcg_next(&! state)
        let lo = state % 8
        state = lcg_next(&! state)
        let gap = (state % 3) + 1
        let hi = lo - gap
        emit_row(idx + 3, 9000 + (idx as i64), 0, solve_bound_pair(lo, hi))
        idx = idx + 1
    }
    return 0
}
