//@ run-pass
//@ description: beta=0 vs beta>0 paired ablation on overconstrained UNSAT 3-SAT, with inline DIMACS for z3-gating

use theorem::smt::*

fn lcg_next(state: &!i64) -> i64 with Mut, Div {
    let a: i64 = 1103515245
    let c: i64 = 12345
    let m: i64 = 2147483648
    var next = (*state * a + c) % m
    if next < 0 { next = next + m }
    *state = next
    return next
}

// Generate random 3-SAT into ctx. If emit==1, ALSO print each clause as DIMACS
// (single source of truth: the printed formula is exactly what is solved).
fn gen(ctx: &!SmtContext, n_vars: i32, n_clauses: i32, seed: i64, emit: i32) with IO, Mut, Div {
    var st: i64 = seed
    var c: i32 = 0
    while c < n_clauses {
        var lits: [i32; 8] = [0 as i32; 8]
        var picked: [i32; 3] = [0 as i32; 3]
        let m: i64 = 2147483648
        var k: i32 = 0
        while k < 3 {
            var v: i32 = 0
            var ok: i32 = 0
            while ok == 0 {
                let raw = lcg_next(&! st)
                // multiply-shift: use HIGH bits (low LCG bits are non-random)
                v = ((raw * (n_vars as i64)) / m) as i32
                ok = 1
                var j: i32 = 0
                while j < k {
                    if picked[j] == v { ok = 0 }
                    j = j + 1
                }
            }
            picked[k] = v
            let praw = lcg_next(&! st)
            let pol = ((praw * 2) / m) as i32
            lits[k] = v * 2 + pol
            if emit == 1 {
                if pol == 1 { print("-") }
                print_int((v + 1) as i64)
                print(" ")
            }
            k = k + 1
        }
        if emit == 1 { println("0") }
        smt_add_clause(ctx, &lits, 3)
        c = c + 1
    }
}

// Solve one (seed, beta) cell. beta_x10: 0 -> 0.0, 10 -> 1.0.
fn solve_cell(n_vars: i32, n_clauses: i32, seed: i64, beta_x10: i32) with IO, Mut, Div {
    var ctx = smt_new()
    gen(&! ctx, n_vars, n_clauses, seed, 0)
    smt_set_no_ple(&! ctx, 1)
    smt_set_score_mode(&! ctx, 5)
    var scale: f64 = 0.0
    if beta_x10 == 10 { scale = 1.0 }
    smt_set_disc_beta_scale(&! ctx, scale)
    let result = smt_solve(&! ctx)
    print("RESULT seed="); print_int(seed)
    print(" beta="); print_int(beta_x10 as i64)
    print(" result="); print_int(result as i64)
    print(" decisions="); print_int(smt_get_decisions(&ctx) as i64)
    print(" conflicts="); print_int(smt_get_conflicts(&ctx) as i64)
    println("")
}

fn main() -> i32 with IO, Mut, Div {
    let n_vars: i32 = 50
    let n_clauses: i32 = 300   // alpha 6.0, overconstrained -> conflict-bearing UNSAT regime
    println("# schema=sounio.solver.beta_ablation.v1")
    println("# regime=overconstrained_unsat alpha=6.0 score_mode=5 phase_mode=0 restart_budget=0")
    println("# format: per instance an INSTANCE header, its DIMACS clauses, then two RESULT lines (beta=0, beta=10)")
    var s: i32 = 0
    while s < 40 {
        let seed: i64 = 3000 + (s as i64)
        // DIMACS block (emit once; identical formula for both beta cells)
        print("INSTANCE seed="); print_int(seed)
        print(" n="); print_int(n_vars as i64)
        print(" m="); print_int(n_clauses as i64); println("")
        print("p cnf "); print_int(n_vars as i64); print(" "); print_int(n_clauses as i64); println("")
        var ctx_emit = smt_new()
        gen(&! ctx_emit, n_vars, n_clauses, seed, 1)
        // two solve cells on fresh contexts (same seed -> identical clauses)
        solve_cell(n_vars, n_clauses, seed, 0)
        solve_cell(n_vars, n_clauses, seed, 10)
        s = s + 1
    }
    return 0
}
