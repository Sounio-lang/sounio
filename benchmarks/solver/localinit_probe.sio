//@ run-pass
//@ description: does large LOCAL array zero-init actually zero at runtime, after the stack was dirtied?

// Dirty the stack with a same-size local array full of nonzero values.
fn dirty() -> i64 with Mut {
    var d: [i32; 1024] = [0 as i32; 1024]
    var i: i32 = 0
    while i < 1024 {
        d[i] = 987654 as i32
        i = i + 1
    }
    var s: i64 = 0
    i = 0
    while i < 1024 {
        s = s + (d[i] as i64)
        i = i + 1
    }
    return s
}

// Declare a freshly zero-initialized local array and sum it. MUST be 0.
fn check() -> i64 with Mut {
    var x: [i32; 1024] = [0 as i32; 1024]
    var s: i64 = 0
    var i: i32 = 0
    while i < 1024 {
        s = s + (x[i] as i64)
        i = i + 1
    }
    return s
}

fn main() -> i32 with IO, Mut {
    let d = dirty()       // leave 987654*1024 worth of nonzero on the stack
    let z = check()       // fresh zero-init array sum — must be 0
    print("dirty_sum="); print_int(d)
    print(" fresh_zero_sum="); print_int(z)
    if z == 0 {
        println("  => local zero-init OK")
    } else {
        println("  => LOCAL ZERO-INIT LEAK (codegen bug)")
    }
    return 0
}
