//@ run-pass
//@ description: hardness pilot — uniform 3-SAT n=50 m=__M__, BASE (mean) only, seed __SEED__

use theorem::smt::*

fn lcg_next(state: &!i64) -> i64 with Mut, Div {
    let a: i64 = 1103515245
    let c: i64 = 12345
    let m: i64 = 2147483648
    var next = (*state * a + c) % m
    if next < 0 { next = next + m }
    *state = next
    return next
}

fn gen(ctx: &!SmtContext, n_vars: i32, n_clauses: i32, seed: i64) with Mut, Div {
    var st: i64 = seed
    let m: i64 = 2147483648
    var c: i32 = 0
    while c < n_clauses {
        var lits: [i32; 8] = [0 as i32; 8]
        var picked: [i32; 3] = [0 as i32; 3]
        var k: i32 = 0
        while k < 3 {
            var v: i32 = 0
            var ok: i32 = 0
            while ok == 0 {
                let raw = lcg_next(&! st)
                v = ((raw * (n_vars as i64)) / m) as i32
                ok = 1
                var j: i32 = 0
                while j < k {
                    if picked[j] == v { ok = 0 }
                    j = j + 1
                }
            }
            picked[k] = v
            let praw = lcg_next(&! st)
            let pol = ((praw * 2) / m) as i32
            lits[k] = v * 2 + pol
            k = k + 1
        }
        smt_add_clause(ctx, &lits, 3)
        c = c + 1
    }
}

fn main() -> i32 with IO, Mut, Div {
    let seed: i64 = __SEED__
    var ctx = smt_new()
    gen(&! ctx, 50, __M__, seed)
    smt_set_no_ple(&! ctx, 1)
    smt_set_score_mode(&! ctx, 1)
    smt_set_phase_mode(&! ctx, 0)
    let result = smt_solve(&! ctx)
    print("PILOT seed="); print_int(seed)
    print(" m=__M__ result="); print_int(result as i64)
    print(" conflicts="); print_int(smt_get_conflicts(&ctx) as i64)
    println("")
    return 0
}
