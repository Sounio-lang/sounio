//@ run-pass
//@ description: Single-instance correctness probe — emit byte-identical DIMACS while solving, for z3 crosscheck

use theorem::smt::*

fn lcg_next(state: &!i64) -> i64 with Mut, Div {
    let a: i64 = 1103515245
    let c: i64 = 12345
    let m: i64 = 2147483648
    var next = (*state * a + c) % m
    if next < 0 { next = next + m }
    *state = next
    return next
}

// Builds ctx AND prints the SAME clause as DIMACS (single source of truth).
// DIMACS var = v+1; sign negative iff polarity bit = 1.
fn gen_and_emit(ctx: &!SmtContext, n_vars: i32, n_clauses: i32, seed: i64) with IO, Mut, Div {
    var st: i64 = seed
    var c: i32 = 0
    while c < n_clauses {
        var lits: [i32; 8] = [0 as i32; 8]
        var picked: [i32; 3] = [0 as i32; 3]
        var k: i32 = 0
        while k < 3 {
            var v: i32 = 0
            var ok: i32 = 0
            while ok == 0 {
                let raw = lcg_next(&! st)
                v = (raw % (n_vars as i64)) as i32
                ok = 1
                var j: i32 = 0
                while j < k {
                    if picked[j] == v { ok = 0 }
                    j = j + 1
                }
            }
            picked[k] = v
            let praw = lcg_next(&! st)
            let pol = (praw % 2) as i32
            lits[k] = v * 2 + pol
            // DIMACS literal: (v+1) positive, -(v+1) negative
            if pol == 1 { print("-") }
            print_int((v + 1) as i64)
            print(" ")
            k = k + 1
        }
        println("0")
        smt_add_clause(ctx, &lits, 3)
        c = c + 1
    }
}

fn main() -> i32 with IO, Mut, Div {
    let n_vars: i32 = 50
    let n_clauses: i32 = 213   // alpha 4.26
    let seed: i64 = 1000
    print("p cnf "); print_int(n_vars as i64); print(" "); print_int(n_clauses as i64); println("")
    var ctx = smt_new()
    gen_and_emit(&! ctx, n_vars, n_clauses, seed)
    smt_set_no_ple(&! ctx, 1)
    smt_set_score_mode(&! ctx, 5)
    smt_set_disc_beta_scale(&! ctx, 0.0)
    let result = smt_solve(&! ctx)
    print("c SOUNIO result="); print_int(result as i64)
    print(" decisions="); print_int(smt_get_decisions(&ctx) as i64)
    print(" conflicts="); print_int(smt_get_conflicts(&ctx) as i64)
    println(" [0=UNSAT 1=SAT 2=CENSORED]")
    return 0
}
