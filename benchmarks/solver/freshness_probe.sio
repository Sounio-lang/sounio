//@ run-pass
//@ description: control — same instance, same beta, solved repeatedly; identical => smt_new isolates, differ => history leak

use theorem::smt::*

fn lcg_next(state: &!i64) -> i64 with Mut, Div {
    let a: i64 = 1103515245
    let c: i64 = 12345
    let m: i64 = 2147483648
    var next = (*state * a + c) % m
    if next < 0 { next = next + m }
    *state = next
    return next
}

fn gen(ctx: &!SmtContext, n_vars: i32, n_clauses: i32, seed: i64) with Mut, Div {
    var st: i64 = seed
    let m: i64 = 2147483648
    var c: i32 = 0
    while c < n_clauses {
        var lits: [i32; 8] = [0 as i32; 8]
        var picked: [i32; 3] = [0 as i32; 3]
        var k: i32 = 0
        while k < 3 {
            var v: i32 = 0
            var ok: i32 = 0
            while ok == 0 {
                let raw = lcg_next(&! st)
                v = ((raw * (n_vars as i64)) / m) as i32
                ok = 1
                var j: i32 = 0
                while j < k {
                    if picked[j] == v { ok = 0 }
                    j = j + 1
                }
            }
            picked[k] = v
            let praw = lcg_next(&! st)
            let pol = ((praw * 2) / m) as i32
            lits[k] = v * 2 + pol
            k = k + 1
        }
        smt_add_clause(ctx, &lits, 3)
        c = c + 1
    }
}

fn solve_once(seed: i64) -> i32 with Mut, Div {
    var ctx = smt_new()
    gen(&! ctx, 50, 300, seed)
    smt_set_no_ple(&! ctx, 1)
    smt_set_score_mode(&! ctx, 5)
    smt_set_disc_beta_scale(&! ctx, 0.0)
    let _r = smt_solve(&! ctx)
    return smt_get_conflicts(&ctx)
}

fn main() -> i32 with IO, Mut, Div {
    println("# same instance (seed 3001), beta=0, solved 6x in a row; identical => fresh ctx isolates")
    var i: i32 = 0
    while i < 6 {
        let c = solve_once(3001)
        print("iter="); print_int(i as i64); print(" conflicts="); print_int(c as i64); println("")
        i = i + 1
    }
    return 0
}
