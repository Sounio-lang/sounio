// Sprint 42 probe: certification status at scheduled monitoring visits
// Clinical schedule: N=7 (week 1), N=14 (week 2), N=28 (month 1)
// Five strata at their correct doses

module main

use pbpk::rapamycin_assay::{as_trough_mg_l}
use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

fn zf(d: f64, n: i64, ke: f64, f: f64,
      ka_v: f64, fv: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> f64
    with Mut, Div, Panic {
    let c  = as_trough_mg_l(d, n, ke, f)
    let uc = eu_u_c(d, n, ke, f, ka_v, fv, ke_v, k12_v, k21_v)
    (c - trough_floor_mg_l()) / uc
}
fn zc(d: f64, n: i64, ke: f64, f: f64,
      ka_v: f64, fv: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> f64
    with Mut, Div, Panic {
    let c  = as_trough_mg_l(d, n, ke, f)
    let uc = eu_u_c(d, n, ke, f, ka_v, fv, ke_v, k12_v, k21_v)
    (trough_ceil_mg_l() - c) / uc
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn report_visit(d: f64, ke: f64, f: f64,
                ka_v: f64, fv: f64, ke_v: f64, k12_v: f64, k21_v: f64)
    with Mut, Div, Panic, IO {
    let visits = [7, 14, 28]
    var i = 0
    while i < 3 {
        let n = visits[i]
        let c = as_trough_mg_l(d, n, ke, f)
        let uc = eu_u_c(d, n, ke, f, ka_v, fv, ke_v, k12_v, k21_v)
        let zfl = (c - trough_floor_mg_l()) / uc
        let zce = (trough_ceil_mg_l() - c) / uc
        print("  N="); pi(n); print(": c="); print_f64(c)
        print(" zf="); print_f64(zfl); print(" zc="); print_f64(zce)
        if zfl >= 2.0 && zce >= 2.0 { print(" CERT") }
        else if zfl < 0.0 { print(" SUB") }
        else if zce < 0.0 { print(" TOX") }
        else if zfl < 2.0 { print(" UNCERT(floor)") }
        else { print(" UNCERT(ceil)") }
        print("\n")
        i = i + 1
    }
}

fn main() with Mut, Div, Panic, IO {
    let ka  = ob_ka_var_std()
    let fv  = ob_f_var_std()
    let ke  = ob_ke_var_std()
    let k12 = ob_k12_var_std()
    let k21 = ob_k21_var_std()
    let ke_inh = ob_ke_var_inh()
    let ke_ind = ob_ke_var_ind()

    print("=== std D=5mg ke=0.01118 F=0.141 ===\n")
    report_visit(5.0,0.01118,0.141, ka,fv,ke,k12,k21)

    print("=== slow D=5mg ke=0.00838 F=0.188 ===\n")
    report_visit(5.0,0.00838,0.188, ka,fv,ke,k12,k21)

    print("=== fast D=5mg ke=0.01677 F=0.094 ===\n")
    report_visit(5.0,0.01677,0.094, ka,fv,ke,k12,k21)

    print("=== inh D=1.5mg ke=0.002236 F=0.282 ===\n")
    report_visit(1.5,0.002236,0.282, ka,fv,ke_inh,k12,k21)

    print("=== ind D=34mg ke=0.05590 F=0.047 ===\n")
    report_visit(34.0,0.05590,0.047, ka,fv,ke_ind,k12,k21)

    // Extra: N=3 and N=4 for early visits; N=21 for slow
    print("\n=== Additional N for key strata ===\n")
    print("slow N=3:  zf="); print_f64(zf(5.0,3,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,3,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")
    print("slow N=21: zf="); print_f64(zf(5.0,21,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,21,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")
    print("fast N=7:  zf="); print_f64(zf(5.0,7,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,7,0.01677,0.094,ka,fv,ke,k12,k21)); print("\n")
    print("ind N=26:  zf="); print_f64(zf(34.0,26,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" zc="); print_f64(zc(34.0,26,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")
    print("ind N=28:  zf="); print_f64(zf(34.0,28,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" zc="); print_f64(zc(34.0,28,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")
    print("inh N=7:   zf="); print_f64(zf(1.5,7,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" zc="); print_f64(zc(1.5,7,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")

    // Minimum sigma margin at each monitoring visit across strata
    print("\n=== sigma-margin = min(zf, zc) at each visit ===\n")
    var visits_idx = 0
    let visits2 = [7, 14, 28]
    while visits_idx < 3 {
        let n = visits2[visits_idx]
        print("N="); pi(n); print(":\n")

        let sf_std = zf(5.0,n,0.01118,0.141,ka,fv,ke,k12,k21)
        let sc_std = zc(5.0,n,0.01118,0.141,ka,fv,ke,k12,k21)
        let m_std = if sf_std < sc_std { sf_std } else { sc_std }
        print("  std  margin="); print_f64(m_std); print("\n")

        let sf_sl = zf(5.0,n,0.00838,0.188,ka,fv,ke,k12,k21)
        let sc_sl = zc(5.0,n,0.00838,0.188,ka,fv,ke,k12,k21)
        let m_sl = if sf_sl < sc_sl { sf_sl } else { sc_sl }
        print("  slow margin="); print_f64(m_sl); print("\n")

        let sf_fa = zf(5.0,n,0.01677,0.094,ka,fv,ke,k12,k21)
        let sc_fa = zc(5.0,n,0.01677,0.094,ka,fv,ke,k12,k21)
        let m_fa = if sf_fa < sc_fa { sf_fa } else { sc_fa }
        print("  fast margin="); print_f64(m_fa); print("\n")

        let sf_ih = zf(1.5,n,0.002236,0.282,ka,fv,ke_inh,k12,k21)
        let sc_ih = zc(1.5,n,0.002236,0.282,ka,fv,ke_inh,k12,k21)
        let m_ih = if sf_ih < sc_ih { sf_ih } else { sc_ih }
        print("  inh  margin="); print_f64(m_ih); print("\n")

        let sf_in = zf(34.0,n,0.05590,0.047,ka,fv,ke_ind,k12,k21)
        let sc_in = zc(34.0,n,0.05590,0.047,ka,fv,ke_ind,k12,k21)
        let m_in = if sf_in < sc_in { sf_in } else { sc_in }
        print("  ind  margin="); print_f64(m_in); print("\n")

        visits_idx = visits_idx + 1
    }
}
