module main

use pbpk::rapamycin_fast_adjusted::{
    fa_margin_n1,  fa_margin_n3,  fa_margin_n7,
    fa_margin_n14, fa_margin_n21, fa_margin_n28,
    fa_margin_n42, fa_margin_n56, fa_margin_n84,
    fa_n_crit,     fa_n_last_cert, fa_n_peak,
    fa_margin_peak, fa_ncrit_lead,
    fa_cert_span,  fa_peak_lag
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== Fast stratum D=9.5mg trajectory ===\n")
    print("N=1:  "); print_f64(fa_margin_n1());  print("\n")
    print("N=3:  "); print_f64(fa_margin_n3());  print("\n")
    print("N=7:  "); print_f64(fa_margin_n7());  print("\n")
    print("N=14: "); print_f64(fa_margin_n14()); print("\n")
    print("N=21: "); print_f64(fa_margin_n21()); print("\n")
    print("N=28: "); print_f64(fa_margin_n28()); print("\n")
    print("N=42: "); print_f64(fa_margin_n42()); print("\n")
    print("N=56: "); print_f64(fa_margin_n56()); print("\n")
    print("N=84: "); print_f64(fa_margin_n84()); print("\n")

    print("\n=== Scanners ===\n")
    print("n_crit:      "); pi(fa_n_crit());      print("\n")
    print("n_last_cert: "); pi(fa_n_last_cert()); print("\n")
    print("n_peak:      "); pi(fa_n_peak());      print("\n")
    print("margin_peak: "); print_f64(fa_margin_peak()); print("\n")

    print("\n=== Derived metrics ===\n")
    print("ncrit_lead:  "); pi(fa_ncrit_lead());  print("\n")
    print("cert_span:   "); pi(fa_cert_span());   print("\n")
    print("peak_lag:    "); pi(fa_peak_lag());    print("\n")
}
